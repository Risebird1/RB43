<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the Risebird unit-test suites.

    dotnet test RisebirdPortal.sln -s coverage.runsettings

  Produces Cobertura XML under each test project's TestResults/<guid>/ folder.
  Use ./coverage.ps1 to run it and print a per-project summary.

  INFORMATIONAL ONLY - Risebird.Repository.

  This project is NOT part of the coverage gate. About 94% of it is Dapper executing stored
  procedures against a SqlConnection constructed in place, with no injectable seam, so unit
  tests cannot enter it and its unit-test ceiling is roughly 7% by construction. What this
  measures is the non-SQL surface: Search/ and Indexing/.

  Real coverage for the SQL repositories needs integration tests against a live SQL Server -
  see COVERAGE_PLAN.md.

    dotnet test Risebird.Repository.Tests -s coverage.repository.runsettings
-->
<RunSettings>
  <RunConfiguration>
    <!-- Test hosts run in parallel across projects; assemblies stay single-threaded so the
         reflection sweep's shared AutoMocker state cannot interleave. -->
    <MaxCpuCount>0</MaxCpuCount>
    <ResultsDirectory>TestResults</ResultsDirectory>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>

          <Include>
            [Risebird.Repository]*
          </Include>

          <Exclude>
            [Risebird.*.Tests]*
            [Risebird.Entities]*
            [Risebird.Business]*
            [Risebird.CommonHelper]*
            [Risebird.Web]*
            [Risebird.Services]*
            [Risebird.AzureTimerFunctions]*
            [Risebird.MicroService]*
          </Exclude>

          <!-- Generated and non-executable members skew the denominator. -->
          <ExcludeByAttribute>
            Obsolete,
            GeneratedCodeAttribute,
            CompilerGeneratedAttribute,
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>

          <ExcludeByFile>
            **/obj/**,
            **/bin/**,
            **/*.Designer.cs,
            **/*.g.cs,
            **/*.g.i.cs
          </ExcludeByFile>

          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
