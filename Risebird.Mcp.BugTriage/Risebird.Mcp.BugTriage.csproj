<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Risebird.Mcp.BugTriage</RootNamespace>
    <AssemblyName>Risebird.Mcp.BugTriage</AssemblyName>
    <UserSecretsId>risebird-mcp-bugtriage</UserSecretsId>
    <!-- The MCP SDK uses source generators that need the tool metadata preserved. -->
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <!--
    Versions are explicit here rather than centrally managed: Directory.Packages.props in this folder
    opts the project out of the solution's central package management, because the MCP SDK needs the
    10.0.10 servicing band of Microsoft.Extensions.* that the solution pins to 10.0.0. See that file.
  -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Azure.Monitor.Query" Version="1.7.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
