    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "relay.gpt-5.4-mini"
        },
        "responses": {
          "values": [
            {
              "content": "=You are an AI assistant that extracts structured interviewer availability data from emails. Given the email subject, body, sender information, and optionally a resume attachment, extract the following 13 fields. Return ONLY valid JSON with these exact keys:\n{\n  \"job_title\": \"The job title or role mentioned in the subject or body. If not found, use 'N/A'.\",\n  \"name\": \"The sender's full name, extracted from the From field or email signature.\",\n  \"email\": \"The sender's email address.\",\n  \"phone\": \"Phone number found in the body, signature, or resume. If not found, use 'N/A'.\",\n  \"mag_name\": \"The magazine name, project name, or publication referenced in the email. If not found, use 'N/A'.\",\n  \"irf_id\": \"Any IRF ID, reference number, or skill channel ID mentioned. If not found, use 'N/A'.\",\n  \"has_login_credentials\": \"'Yes' if the email mentions login credentials, portal access, or account details. Otherwise 'No'.\",\n  \"slots_per_day\": \"The number of interview slots the interviewer can take per day (e.g. '2', '3'). If not specified, use 'N/A'.\",\n  \"time_frame\": \"One or more of these time windows: '6-10 AM', '10 AM-2 PM', '2-6 PM', '6-10 PM', '10 PM-12 AM'. Comma-separated if multiple. If not specified, use 'N/A'.\",\n  \"availability_intent\": \"A summary of the interviewer's stated availability — dates, times, days of week, or general availability windows. Be specific.\",\n  \"mail_body_intent\": \"A one-line summary of the email's purpose (e.g. 'Sharing availability for next week', 'Requesting slot change', 'Confirming availability').\",\n  \"concerns_or_not_interested\": \"Any hesitations, concerns, conditions, or expressions of disinterest. If none, use 'None'.\",\n  \"resume_fitment\": \"If a resume is attached, assess fitment: 'Strong Fit', 'Moderate Fit', 'Weak Fit'. If no resume, use 'N/A'.\"\n}\nRules:\n- Extract phone numbers in their original format (include country code if present)\n- For time_frame, only use the exact window labels listed above\n- For resume_fitment, base your assessment on the resume's relevance to the job title mentioned\n- Always return valid JSON, nothing else\n\n---\nEmail Subject: {{ $json.subject }}\nEmail From: {{ $json.from }}\nEmail Body: {{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        }
      },
      "id": "24eaa4ec-59b9-4093-9c71-4f5f89827905",
      "name": "Extract Availability (AI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        224,
        192
