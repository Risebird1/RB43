    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet text = '';\ntry {\n  if (raw.output && raw.output[0] && raw.output[0].content && raw.output[0].content[0]) {\n    text = raw.output[0].content[0].text;\n  }\n} catch (e) {}\nif (!text) { text = raw.text || raw.content || raw.message || ''; }\nlet parsed = {};\nif (typeof text === 'object' && text !== null) {\n  parsed = text;\n} else {\n  try { parsed = JSON.parse(text); } catch (e) {\n    const m = String(text).match(/\\{[\\s\\S]*\\}/);\n    if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) {} }\n  }\n}\nconst fields = ['job_title','name','email','phone','mag_name','irf_id','has_login_credentials','slots_per_day','time_frame','availability_intent','mail_body_intent','concerns_or_not_interested','resume_fitment'];\nfor (const f of fields) { if (parsed[f] === undefined || parsed[f] === null) parsed[f] = 'N/A'; }\nconst triggerItem = $('Gmail Trigger').first();\nconst binChannel = triggerItem.binary || {};\nconst jsonBin = (triggerItem.json && triggerItem.json.binary) || {};\nparsed._attachment_count = Object.keys(binChannel).length || Object.keys(jsonBin).length;\nreturn [{ json: parsed }];"
      },
      "id": "b9abc0cf-3499-4141-89ae-889956a15307",
      "name": "Parse AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-att",
              "leftValue": "={{ $json._attachment_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
