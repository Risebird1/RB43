    {
      "parameters": {
        "jsCode": "const trigger = $('Gmail Trigger').first();\nconst binary = (trigger.binary && Object.keys(trigger.binary).length)\n  ? trigger.binary\n  : ((trigger.json && trigger.json.binary) || {});\nconst out = [];\nfor (const key of Object.keys(binary)) {\n  const b = binary[key];\n  out.push({\n    json: { fileName: b.fileName || key },\n    binary: { data: b },\n  });\n}\nreturn out;"
      },
