<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://risebirdmicroservicededicated.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ResourceId>/subscriptions/05d4ebe3-b5c7-4725-b618-8bb535cf2c8c/resourceGroups/RisebirdPortal/providers/Microsoft.Web/sites/RisebirdMicroServiceDedicated</ResourceId>
    <UserName>$RisebirdMicroServiceDedicated</UserName>
    <_SavePWD>true</_SavePWD>
    <PublishUrl>https://risebirdmicroservicededicated.scm.azurewebsites.net/</PublishUrl>
    <TargetFramework>net6.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
  </PropertyGroup>
</Project>