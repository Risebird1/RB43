<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UserName>$risebirdmicroservices</UserName>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://risebirdmicroservices.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ResourceId>/subscriptions/05d4ebe3-b5c7-4725-b618-8bb535cf2c8c/resourceGroups/RisebirdPortal/providers/Microsoft.Web/sites/risebirdmicroservices</ResourceId>
    <_SavePWD>True</_SavePWD>
    <PublishUrl>https://risebirdmicroservices.scm.azurewebsites.net/</PublishUrl>
  </PropertyGroup>
</Project>