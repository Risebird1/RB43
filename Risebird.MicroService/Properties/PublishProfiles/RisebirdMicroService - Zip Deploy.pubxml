<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UserName>$RisebirdMicroService</UserName>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://risebirdmicroservice.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ResourceId>/subscriptions/05d4ebe3-b5c7-4725-b618-8bb535cf2c8c/resourcegroups/DemoGroup/providers/Microsoft.Web/sites/RisebirdMicroService</ResourceId>
    <_SavePWD>True</_SavePWD>
    <PublishUrl>https://risebirdmicroservice.scm.azurewebsites.net/</PublishUrl>
    <TargetFramework>netcoreapp2.2</TargetFramework>
    <SelfContained>false</SelfContained>
    <SkipExtraFilesOnServer>False</SkipExtraFilesOnServer>
    <SCMUrl>https://risebirdmicroservice.scm.azurewebsites.net/</SCMUrl>
  </PropertyGroup>
</Project>