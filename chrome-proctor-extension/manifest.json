{
  "manifest_version": 3,
  "name": "Risebird Proctoring Assistant",
  "description": "Risebird Proctoring for AI Interview: join; tab/window monitoring; DNR-blocked sites; screenshots; violation logging. Risebird API.",
  "version": "1.3.1",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "windows",
    "webNavigation",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core_proctoring_rules",
        "enabled": true,
        "path": "rules/restricted-sites.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.risebird.io/AIInterview/*",
        "https://*.risebird.io/AIInterview/*",
        "http://localhost/AIInterview/*",
        "https://localhost/AIInterview/*",
        "http://127.0.0.1/AIInterview/*",
        "https://127.0.0.1/AIInterview/*",
        "http://localhost:44329/AIInterview/*",
        "https://localhost:44329/AIInterview/*"
      ],
      "js": ["content-monitor.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Proctoring Controls"
  }
}
