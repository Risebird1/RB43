                                                                  },
                                                                  {
                                                                      "id":  "ca81a8e2-ba64-4cb1-a0c9-b17f96dba7f3",
                                                                      "intent_instructions":  "Select IMMEDIATELY when the candidate asks not to be called again, says they are not interested in this role, asks to remove their number, says stop calling or unsubscribe, or says they are not looking for a job. Never for \u0027call me later\u0027, \u0027not now\u0027, busy or in a meeting.",
                                                                      "intent_name":  "Opted Out",
                                                                      "intent_speech":  {
                                                                                            "intent_speech_text":  "Understood. We won\u0027t call you again about this role. Sorry for the trouble. Goodbye.",
                                                                                            "speech_enabled":  true
                                                                                        }
                                                                  }
                                                              ],
                                                  "extract_variables":  [
                                                                            {
                                                                                "variable_instructions":  "The confirmed interview date. Must be set to the actual calendar date — use the value of tomorrow_date if the candidate chose tomorrow, or day_after_tomorrow_date if they chose the day after. Never set this to the word \u0027tomorrow\u0027 or \u0027dayaftertomorrow\u0027.",
                                                                                "variable_name":  "interview_date"
                                                                            },
                                                                            {
                                                                                "variable_instructions":  "The time the candidate confirmed. Must be in HH:MM AM/PM format, for example \"10:00 AM\" or \"02:30 PM\".\n",
                                                                                "variable_name":  "interview_time"
                                                                            },
                                                                            {
                                                                                "variable_instructions":  "Must be exactly \"true\" if the candidate explicitly said yes or confirmed. Otherwise \"false\".\n",
                                                                                "variable_name":  "candidate_confirmed"
                                                                            },
                                                                            {
                                                                                "id":  "bd9637f1-514c-4bf3-be62-82e18803cfe8",
                                                                                "variable_instructions":  "Based on the full conversation, assess the candidate\u0027s disposition towards the interview. Set to exactly one of: \"interested\" (candidate willingly confirmed or was clearly open), \"uninterested\" (candidate declined, was dismissive, or said they are not interested), \"cant_say\" (call dropped, no answer, unclear, or the candidate was non-committal).\n",
                                                                                "variable_name":  "candidate_disposition"
                                                                            },
