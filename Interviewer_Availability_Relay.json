          {
            "stepId": "3wfaft",
            "stepType": "ai.prompt.object",
            "stepNr": "Step 2",
            "title": "Prompt GPT 5.4 mini",
            "inputs": [
              {
                "input": "model",
                "description": "relay models use AI credits, user has no API keys configured",
                "type": "string",
                "enum": [
                  "relay.claude-sonnet-5",
                  "relay.claude-haiku-4-5",
                  "relay.claude-opus-4-8",
                  "relay.claude-fable-5",
                  "relay.gemini-3.1-flash-lite",
                  "relay.gemini-3.5-flash",
                  "relay.gemini-3.1-pro",
                  "relay.gpt-5.4-mini",
                  "relay.gpt-5.4-nano",
                  "relay.gpt-5.5-pro",
                  "relay.gpt-5.6-sol",
                  "relay.gpt-5.6-terra",
                  "relay.gpt-5.6-luna",
                  "relay.grok-4.3"
                ],
                "title": "Model",
                "value": "relay.gpt-5.4-mini"
              },
              {
                "input": "prompt",
                "title": "User prompt",
                "type": "string",
                "value": "You are an AI assistant that extracts structured interviewer availability data from emails.\n\nGiven the email subject, body, sender information, and optionally a resume attachment, extract the following 13 fields. Return ONLY valid JSON with these exact keys:\n\n{\n  \"job_title\": \"The job title or role mentioned in the subject or body. If not found, use 'N/A'.\",\n  \"name\": \"The sender's full name, extracted from the From field or email signature.\",\n  \"email\": \"The sender's email address.\",\n  \"phone\": \"Phone number found in the body, signature, or resume. If not found, use 'N/A'.\",\n  \"mag_name\": \"The magazine name, project name, or publication referenced in the email. If not found, use 'N/A'.\",\n  \"irf_id\": \"Any IRF ID, reference number, or skill channel ID mentioned. If not found, use 'N/A'.\",\n  \"has_login_credentials\": \"'Yes' if the email mentions login credentials, portal access, or account details. Otherwise 'No'.\",\n  \"slots_per_day\": \"The number of interview slots the interviewer can take per day (e.g. '2', '3'). If not specified, use 'N/A'.\",\n  \"time_frame\": \"One or more of these time windows: '6-10 AM', '10 AM-2 PM', '2-6 PM', '6-10 PM', '10 PM-12 AM'. Comma-separated if multiple. If not specified, use 'N/A'.\",\n  \"availability_intent\": \"A summary of the interviewer's stated availability — dates, times, days of week, or general availability windows. Be specific.\",\n  \"mail_body_intent\": \"A one-line summary of the email's purpose (e.g. 'Sharing availability for next week', 'Requesting slot change', 'Confirming availability').\",\n  \"concerns_or_not_interested\": \"Any hesitations, concerns, conditions, or expressions of disinterest. If none, use 'None'.\",\n  \"resume_fitment\": \"If a resume is attached, assess fitment: 'Strong Fit', 'Moderate Fit', 'Weak Fit'. If no resume, use 'N/A'.\"\n}\n\nRules:\n- Extract phone numbers in their original format (include country code if present)\n- For time_frame, only use the exact window labels listed above\n- For resume_fitment, base your assessment on the resume's relevance to the job title mentioned\n- Always return valid JSON, nothing else"
              },
              {
                "input": "codeSandbox",
                "description": "Recommendation: OFF, The task involves understanding and extracting specific information from email content and resume text. This is a comprehension task, not one requiring programmatic data transformation or file manipulation. The AI can process this content directly in its context.",
                "type": "string",
                "enum": [
                  "AUTO",
                  "OFF",
                  "ON"
                ],
                "value": "AUTO"
              },
              {
                "input": "webAccess",
                "description": "Recommendation: OFF, The task is to extract structured data from an email and optional resume attachment. No instructions require accessing external websites or current web information. The email content and attachment will be provided directly to the AI.",
                "type": "string",
                "enum": [
                  "AUTO",
                  "OFF",
                  "ON"
                ],
                "value": "AUTO"
              },
              {
                "input": "review",
