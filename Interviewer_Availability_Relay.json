            "stepId": "trigger",
            "stepType": "gmail.mailReceived",
            "title": "Email received",
            "description": "Checks connection periodically and starts run for detected events. Event is automatically detected, concrete implementation depends on integration. Filters are optional and can be used to further limit which events should trigger runs. Can only trigger once per Email.",
            "connection": "kavita_kaushik@risebird.io (owned by Harshit Jajoo)",
            "inputs": [
              {
                "input": "filter",
                "$ref": "relay/filter",
                "value": {
                  "or": [
                    {
                      "and": [
                        {
                          "field": "Is unread",
                          "operator": "equal",
                          "value": null
                        }
                      ]
                    },
                    {
                      "and": [
                        {
                          "field": "From",
                          "operator": "notContains",
                          "value": "mailer-daemon@googlemail.com"
                        },
                        {
                          "field": "From",
                          "operator": "notContains",
                          "value": "mailer-daemon@google.com"
                        },
                        {
                          "field": "From",
                          "operator": "notContains",
                          "value": "noreply@google.com"
                        },
                        {
                          "field": "From",
                          "operator": "notContains",
                          "value": "postmaster@google.com"
                        },
                        {
                          "field": "From",
                          "operator": "notContains",
                          "value": "workspace-noreply@google.com"
                        }
