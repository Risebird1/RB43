<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://risebirdazuretimerfunctions.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ResourceId>/subscriptions/05d4ebe3-b5c7-4725-b618-8bb535cf2c8c/resourceGroups/RisebirdPortal/providers/Microsoft.Web/sites/RisebirdAzureTimerFunctions</ResourceId>
    <UserName>$RisebirdAzureTimerFunctions</UserName>
    <_SavePWD>true</_SavePWD>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishUrl>https://risebirdazuretimerfunctions.scm.azurewebsites.net/</PublishUrl>
  </PropertyGroup>
</Project>