{
  // Retention for the AI screening intake's leftover uploads (AIScreeningBlobPurgeJob, 02:40 UTC).
  //
  // An intake that is abandoned leaves its job description in the "resumes" container and its
  // voice instruction in "audios". The draft itself expires out of the cache after a day; the
  // uploads used to stay indefinitely.
  "AIScreening": {
    "BlobPurge": {
      // Off by default. Nothing is examined or deleted while this is false.
      "Enabled": false,
      // Reports instead of deleting. Leave it true for at least one night after enabling, read the
      // candidate list the job logs, and only then set it false. The job descriptions live in the
      // same container as real candidate resumes uploaded through AccountController, so the list is
      // worth a human's eyes before anything is removed.
      "DryRun": true,
      // Days a blob survives after it was last written. Must comfortably exceed
      // AIScreening:DraftLifetimeHours so an intake still in progress is never touched.
      "RetentionDays": 7
    }
  },
