  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Risebird.Mcp.BugTriage\Risebird.Mcp.BugTriage.csproj" />
  </ItemGroup>

</Project>
