  // Partner API (api/SkillChannel/CreateAndSchedule).
  "SkillChannel": {
    // When a partner posts a job title whose Assessment Group has no template, generate one from
    // the Assessment Group's name instead of refusing the request with "Missing template".
    //
    // Off by default, because it changes what an external partner receives: today such a request
    // is refused and somebody builds the template by hand; with this on, the request succeeds
    // against an AI-generated rubric nobody has reviewed, and candidates are scheduled into it.
    //
    // Two things to know before switching it on. The generation is an OpenAI call made inside the
    // partner's HTTP request, so that request gets slower - check it against the partner's client
    // timeout. And two requests arriving together for the same untemplated Assessment Group will
    // each generate one; the newest wins for both, which is untidy rather than broken.
    "GenerateMissingTemplateFromAssessmentGroup": false
  },
