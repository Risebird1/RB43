    // interviewId + candidateEmail pair itself instead. Sent as the x-proctoring-admin-key header.
    "AdminApiKey": "",
    "DefaultTokenTtlMinutes": 180,
    // ECDSA P-256 production signing key (base64url D/X/Y). Leave empty to fall back to an
    // ephemeral per-process dev key (logged at startup, invalidates all tokens on restart).
    // Generated 2026-09-10 for launch-token signing — D is the private scalar, keep it out of
    // anywhere the desktop client or a candidate could see it. The public half (X/Y, curve
    // nistP256/P-256) is what goes into the desktop client's DevSigningKeyPath JSON to verify.
    "SigningKey": {
      "D": "UpnJhdAZ2nZx84gNHT70Zj3Rpo9vRqLm0St8d8Mdbic",
      "X": "_LwPvKhwMPjiHePEJ83YGjFVUh4wjqZCkfzXVTDgF1g",
