@{
    ViewBag.Title = "Upload Video";
}

<h2 class="title">@ViewBag.Title</h2>

@using (Html.BeginForm())
{<div class="upload-wrap">
        <div class="col-md-8 pull-left">
            <div class="form-group text-left">
                <label class="selectFile" for="selectFile">Select Video File</label>
                <input type="file" id="selectFile" accept=".mp4,.avi" />
            </div>


        </div>
        <div class="col-md-3 pull-left">
            <div class="form-group text-left">
                <input type="button" id="fileUpload" name="fileUpload" value="Upload" class="upload btn" onclick="beginUpload()" />
                <label id="txtuploading" class="upload btn" style="display:none"></label>
            </div>
        </div>

        <div class="col-md-12 pull-left">
            <div class="form-group" style="position:relative">
                <label class="selectFile pull-left">Video Url:</label>
                <label id="videourl" style="overflow:hidden"></label><button class="copy-btn" onclick="copyToClipboard('#videourl')">
                    <p class="special-text">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                        <span id="special_text" class="special-text__tooltip">
                            Copy Link
                        </span>
                    </p>
                </button>
            </div>
        </div>
    </div>

}

<script>
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
    function beginUpload() {
        var fileControl = document.getElementById("selectFile");
        var fileChunk = new FormData();
        if (fileControl.files.length > 0) {
            for (var i = 0; i < fileControl.files.length; i++) {
                fileChunk.append('file', fileControl.files[i]);
            }
        }
        $("#fileUpload").hide();
        document.getElementById("txtuploading").style.display = "block";
        $("#txtuploading").text("UPLOADING...");
        $.ajax({
            type: "POST",
            url: "/Home/UploadFiles",
            data: fileChunk,
            contentType: false,
            enctype: 'multipart/form-data',
            processData: false,
            success: function (data) {
                $("#txtuploading").text("COMPLETED");
                $("#videourl").text(data);
            }
        });
        //ajax call
    }
</script>
