<div id="loadingOverlay">
    <div class="spinner-content">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        <div class="loading-text">Loading records...</div>
    </div>
</div>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="content client">
            <div class="container-fluid py-4">

                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h4 class="fw-bold mb-0"><i class="fas fa-calendar-check text-primary me-2"></i>Interviewer Email Availability</h4>
                        <p class="text-muted mb-0 mt-1">Interviewer availability emails processed via Relay.app</p>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <a href="@Url.Action("BatchCall", "InterviewerAvailability")" class="btn btn-sm btn-info text-white" title="Batch availability calls by MAG"><i class="fas fa-phone-volume me-1"></i>Batch Call</a>
                        <button type="button" class="btn btn-sm ia-page-refresh" onclick="location.reload()" title="Reload this page"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                    </div>
                </div>

                @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

                @{ int cardOpen = ViewBag.OpenCount != null ? (int)ViewBag.OpenCount : 0;
                   int cardIP = ViewBag.InProgressCount != null ? (int)ViewBag.InProgressCount : 0;
                   int cardVerified = ViewBag.VerifiedCount != null ? (int)ViewBag.VerifiedCount : 0;
                   int cardClosed = ViewBag.ClosedCount != null ? (int)ViewBag.ClosedCount : 0; }
                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 ia-stat"><div class="stat-value text-primary">@totalCount</div><div class="stat-label">@(hasFilters ? "Matched" : "Total")</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 ia-stat"><div class="stat-value text-warning">@cardOpen</div><div class="stat-label">Open</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 ia-stat"><div class="stat-value text-info">@cardIP</div><div class="stat-label">In Progress</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 ia-stat"><div class="stat-value text-success">@cardVerified</div><div class="stat-label">Verified</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 ia-stat"><div class="stat-value" style="color:#6c757d;">@cardClosed</div><div class="stat-label">Closed</div></div></div>
                </div>

                <form asp-action="Index" asp-controller="InterviewerAvailability" method="get" id="filterForm">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex align-items-center gap-2" style="flex-wrap:wrap;width:100%;">
                                <select name="status" class="form-select ia-filter-control" style="flex:1 1 0;min-width:110px;max-width:140px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All statuses</option>
                                    @if (selStatus == "Open") { <option value="Open" selected>Open</option> } else { <option value="Open">Open</option> }
                                    @if (selStatus == "InProgress") { <option value="InProgress" selected>In Progress</option> } else { <option value="InProgress">In Progress</option> }
                                    @if (selStatus == "Verified") { <option value="Verified" selected>Verified</option> } else { <option value="Verified">Verified</option> }
                                    @if (selStatus == "Closed") { <option value="Closed" selected>Closed</option> } else { <option value="Closed">Closed</option> }
                                </select>
                                <select name="resumeFitment" class="form-select ia-filter-control" style="flex:1 1 0;min-width:110px;max-width:140px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All fitment</option>
                                    @if (selFitment == "Strong Fit") { <option value="Strong Fit" selected>Strong Fit</option> } else { <option value="Strong Fit">Strong Fit</option> }
                                    @if (selFitment == "Moderate Fit") { <option value="Moderate Fit" selected>Moderate Fit</option> } else { <option value="Moderate Fit">Moderate Fit</option> }
                                    @if (selFitment == "Weak Fit") { <option value="Weak Fit" selected>Weak Fit</option> } else { <option value="Weak Fit">Weak Fit</option> }
                                    @if (selFitment == "N/A") { <option value="N/A" selected>N/A</option> } else { <option value="N/A">N/A</option> }
                                </select>
                                <select name="source" class="form-select ia-filter-control" style="flex:1 1 0;min-width:110px;max-width:140px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All sources</option>
                                    @if (selSource == "Relay") { <option value="Relay" selected>Relay</option> } else { <option value="Relay">Relay</option> }
                                    @if (selSource == "BatchCall") { <option value="BatchCall" selected>Batch Call</option> } else { <option value="BatchCall">Batch Call</option> }
                                    @if (selSource == "IRFAutoCall") { <option value="IRFAutoCall" selected>IRF Auto-Call</option> } else { <option value="IRFAutoCall">IRF Auto-Call</option> }
                                    @if (selSource == "Campaign") { <option value="Campaign" selected>Campaign</option> } else { <option value="Campaign">Campaign</option> }
                                </select>
                                <select name="autoClosed" class="form-select ia-filter-control" style="flex:1 1 0;min-width:110px;max-width:140px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">Auto-closed?</option>
                                    @if (selAutoClosed == "yes") { <option value="yes" selected>Yes</option> } else { <option value="yes">Yes</option> }
                                    @if (selAutoClosed == "no") { <option value="no" selected>No</option> } else { <option value="no">No</option> }
                                </select>
                                <select name="activeStatus" class="form-select ia-filter-control" style="flex:1 1 0;min-width:110px;max-width:140px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All interviewers</option>
                                    @if (selActiveStatus == "active") { <option value="active" selected>Active</option> } else { <option value="active">Active</option> }
                                    @if (selActiveStatus == "inactive") { <option value="inactive" selected>Inactive</option> } else { <option value="inactive">Inactive</option> }
                                </select>
                                <input type="text" name="senderEmail" class="form-control ia-filter-control" placeholder="Sender email..." style="flex:1 1 0;min-width:130px;" value="@selEmail" />
                                <input type="date" name="dateFrom" class="form-control ia-filter-control" style="flex:1 1 0;min-width:120px;" value="@selDateFrom" onchange="document.getElementById('filterForm').submit()" />
                                <span class="text-muted flex-shrink-0" style="font-size:11px;">–</span>
                                <input type="date" name="dateTo" class="form-control ia-filter-control" style="flex:1 1 0;min-width:120px;" value="@selDateTo" onchange="document.getElementById('filterForm').submit()" />
                                <button style="background:#07363c4f !important;border:0px;padding:7px 10px;" type="submit" class="btn btn-primary btn-sm flex-shrink-0"><i class="fas fa-filter me-1"></i>Apply</button>
                                <a style="padding:7px 10px!important;border:0px;background:#da7c7c !important;color:#fff" asp-action="Index" asp-controller="InterviewerAvailability" class="btn btn-sm btn-outline-secondary flex-shrink-0"><i class="fas fa-times me-1"></i>Clear</a>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                <span>@(hasFilters ? "No records match the selected filters." : "No interviewer availability emails yet. Once Relay.app routes an email, it will appear here.")</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive ia-scroll">
                                <table id="iaTable" class="table table-hover table-sm mb-0 align-top">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="col-num">#</th><th class="col-date">Received</th><th class="col-email">Email</th>
                                            <th class="col-name">Name</th><th class="col-phone">Phone</th><th class="col-job">Job Title</th>
                                            <th class="col-employed">Employed</th><th class="col-company">Company</th>
                                            <th class="col-intent-summary">Intent</th><th class="col-source" style="min-width:75px;">Source</th><th style="width:70px;white-space:nowrap;">Active</th><th class="col-status">Status</th><th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model)
                                        {
                                            string rStatus = r.Status?.ToLower() ?? "open";
                                            string statusCss = rStatus switch { "open" => "status-open", "inprogress" => "status-inprogress", "verified" => "status-verified", "closed" => "status-closed", _ => "bg-light border" };

                                            <tr id="row-@r.Id">
                                                <td class="col-num text-muted" style="font-size:12px">@r.Id</td>
                                                <td class="col-date" style="font-size:12px">@(r.ReceivedAt.HasValue ? r.ReceivedAt.Value.ToString("dd MMM yy, HH:mm") : "—")</td>
                                                <td class="col-email">
                                                    <a href="mailto:@r.SenderEmail" class="text-decoration-none ia-email-ellipsis" title="@r.SenderEmail">@r.SenderEmail</a>
                                                    @if (r.InterviewerProfileId.HasValue) { <span class="badge bg-success" style="font-size:9px;" title="Known interviewer">RB</span> }
                                                </td>
                                                <td class="col-name">
                                                    <span class="fw-semibold" style="font-size:12px;white-space:break-spaces;">@(r.InterviewerName ?? r.InterviewerNickName ?? "—")</span>
                                                    @if (r.Experience.HasValue) { <br /><span class="text-muted" style="font-size:10px;">@r.Experience yr exp</span> }
                                                </td>
                                                <td class="col-phone" style="font-size:12px;">
                                                    @{ string displayPhone = !string.IsNullOrEmpty(r.UserMobileNumber) ? r.UserMobileNumber : r.Phone; }
                                                    @(displayPhone ?? "—")
                                                </td>
                                                <td class="col-job" style="font-size:12px;">
                                                    <span style="white-space: break-spaces;"> @(r.JobTitle ?? "—")</span>
                                                    @if (!string.IsNullOrEmpty(r.MagName)) { <br /><span class="text-muted" style="font-size:10px;">@r.MagName</span> }
                                                </td>
                                                <td class="col-employed" style="font-size:12px;">
                                                    @if (r.IsEmployed == true)
                                                    { <span class="employed-yes"><i class="fas fa-check-circle"></i> Yes</span> }
                                                    else if (r.IsEmployed == false)
                                                    { <span class="employed-no"><i class="fas fa-times-circle"></i> No</span> }
                                                    else
                                                    { <span class="text-muted">—</span> }
                                                </td>
                                                <td class="col-company" style="font-size:12px;" title="@(r.CompanyName ?? "")">@(r.CompanyName ?? "—")</td>
                                                <td class="col-intent-summary">
                                                    @if (!string.IsNullOrWhiteSpace(r.MailBodyIntent)) { <span class="intent-badge bg-light border" style="font-size:10px;">@r.MailBodyIntent</span> }
                                                    @if (!string.IsNullOrWhiteSpace(r.AvailabilityIntent)) { <div class="mail-preview-text mt-1" style="-webkit-line-clamp:2;">@r.AvailabilityIntent</div> }
                                                </td>
                                                <td class="col-source" style="font-size:11px;">
                                                    @{
                                                        string srcVal = r.Source ?? "";
                                                        bool isCampaign = srcVal.StartsWith("Campaign", StringComparison.OrdinalIgnoreCase);
                                                        string srcBadge = isCampaign ? "background:#fef3c7;color:#92400e;" : srcVal switch {
                                                            "Relay" => "background:#e0f2fe;color:#0369a1;",
                                                            "BatchCall" => "background:#d1fae5;color:#065f46;",
                                                            "IRFAutoCall" => "background:#ede9fe;color:#5b21b6;",
                                                            _ => "background:#f3f4f6;color:#6b7280;"
                                                        };
                                                        string srcLabel = isCampaign ? "Campaign" : srcVal switch {
                                                            "Relay" => "Relay",
                                                            "BatchCall" => "Batch Call",
                                                            "IRFAutoCall" => "IRF Auto-Call",
                                                            _ => string.IsNullOrEmpty(srcVal) ? "—" : srcVal
                                                        };
                                                    }
                                                    <span style="@srcBadge font-size:10px;padding:2px 6px;border-radius:4px;font-weight:600;white-space:nowrap;">@srcLabel</span>
                                                    @if (r.IsAutoClosed == true)
                                                    {
                                                        <br /><span style="font-size:9px;color:#059669;font-weight:600;" title="Auto-closed by @(r.AutoClosedBy ?? "System")@(r.AutoClosedAt.HasValue ? " at " + r.AutoClosedAt.Value.ToString("dd MMM yy, HH:mm") : "")"><i class="fas fa-bolt"></i> Auto-closed</span>
                                                    }
                                                </td>
                                                <td style="font-size:11px;text-align:center;">
                                                    @if (r.IsInterviewerActive)
                                                    {
                                                        <span style="color:#059669;font-weight:600;" title="Interviewer is active"><i class="fas fa-check-circle"></i> Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color:#dc2626;font-weight:600;" title="Inactive — @(r.InactivationType ?? "Unknown")"><i class="fas fa-times-circle"></i> No</span>
                                                    }
                                                </td>
                                                <td class="col-status">
                                                    <span class="intent-badge @statusCss" style="word-break:normal;">@(r.Status ?? "Open")</span>
                                                    @if (r.ResumeAIAnalysisCompleted == true)
                                                    {
                                                        string aiVerdictText = "AI";
                                                        string aiScoreText = "";
                                                        string aiBadgeClass = "text-info";
                                                        try
                                                        {
                                                            if (!string.IsNullOrWhiteSpace(r.ResumeAIAnalysisResult))
                                                            {
                                                                var aiData = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(r.ResumeAIAnalysisResult);
                                                                string verdict = aiData?.verdict;
                                                                string score = aiData?.fitmentScore?.ToString();
                                                                if (!string.IsNullOrEmpty(verdict))
                                                                {
                                                                    bool isYes = verdict.IndexOf("yes", StringComparison.OrdinalIgnoreCase) >= 0;
                                                                    aiBadgeClass = isYes ? "text-success" : "text-danger";
                                                                    aiVerdictText = isYes ? "Yes" : "No";
                                                                }
                                                                if (!string.IsNullOrEmpty(score)) aiScoreText = score;
                                                            }
                                                        }
                                                        catch { }
                                                        <br /><span style="font-size:9px;" class="@aiBadgeClass" title="AI Verdict: @aiVerdictText@(aiScoreText != "" ? " | Score: " + aiScoreText : "")"><i class="fas fa-robot"></i> @aiVerdictText@(aiScoreText != "" ? " · " + aiScoreText : "")</span>
                                                    }
                                                    @if (r.AssessmentGroupId.HasValue) { <span style="font-size:9px;" class="text-primary"><i class="fas fa-users"></i> AG</span> }
                                                </td>
                                                <td class="col-actions">
                                                    <div class="action-btns d-flex align-items-center flex-wrap gap-1">
                                                        <button type="button" title="Manage — review, verify &amp; assign"
                                                                class="btn btn-primary btn-manage-record"
                                                                data-record-id="@r.Id">
                                                            <i class="fas fa-bars me-1"></i>Manage
                                                        </button>
                                                        @if (r.InterviewerProfileId.HasValue && canDrop)
                                                        {
                                                            <button type="button" title="Drop profile — mark interviewer unavailable"
                                                                    class="btn btn-warning btn-sm btn-drop-profile"
                                                                    data-record-id="@r.Id"
                                                                    aria-label="Drop profile">
                                                                <i class="fas fa-user-slash"></i>
                                                            </button>
                                                        }
                                                        @if (r.UserId.HasValue && canDrop)
                                                        {
                                                            @if (r.IsInterviewerActive)
                                                            {
                                                                <button type="button" title="Inactivate interviewer"
                                                                        class="btn btn-sm btn-inactivate-interviewer"
                                                                        style="background:#dc3545;color:#fff;border:none;padding:2px 6px;"
                                                                        data-record-id="@r.Id"
                                                                        data-interviewer-name="@(r.InterviewerName ?? r.InterviewerNickName ?? r.SenderEmail)">
                                                                    <i class="fas fa-user-times" style="font-size:11px;"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" title="Reactivate interviewer"
                                                                        class="btn btn-sm btn-reactivate-interviewer"
                                                                        style="background:#28a745;color:#fff;border:none;padding:2px 6px;"
                                                                        data-record-id="@r.Id"
                                                                        data-interviewer-name="@(r.InterviewerName ?? r.InterviewerNickName ?? r.SenderEmail)">
                                                                    <i class="fas fa-user-check" style="font-size:11px;"></i>
                                                                </button>
                                                            }
                                                        }
                                                        @if (canDelete)
                                                        {
                                                            <button type="button" title="Delete this record"
                                                                    class="btn btn-danger btn-sm btn-delete-record"
                                                                    data-record-id="@r.Id">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                        <div class="text-muted" style="font-size:12px;">
                            Showing @first–@last of @totalCount records
                            <span class="ms-3">Page size:
                                @foreach (var sz in new[] { 10, 25, 50, 100 })
                                { if (pageSize == sz) { <strong class="ms-1">@sz</strong> } else { <a href="javascript:void(0)" class="ms-1 text-decoration-none" onclick="changePageSize(@sz)">@sz</a> } }
                            </span>
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@pageUrl(page - 1)">Prev</a></li>
                                @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++) { <li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@pageUrl(p)">@p</a></li> }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")"><a class="page-link" href="@pageUrl(page + 1)">Next</a></li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Anti-forgery token for AJAX calls -->
<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- Manage Modal -->
<div class="modal fade" id="manageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header mgm-header">
                <div class="modal-title-wrap pe-2">
                    <h5 class="modal-title"><i class="fas fa-clipboard-check me-2"></i>Manage Availability Record</h5>
                </div>
                <div class="d-flex align-items-start gap-2 ms-auto flex-shrink-0">
                    <div style="position: relative;top: 17px;right:30px;">
                        <span class="lbl">Record no.</span>
                        <span  id="mgmRecordNo">#—</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <div class="mgm-status-strip px-3 px-md-4 py-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap mgm-status-badge-wrap">
                    <strong class="text-muted" style="font-size:12.5px;">Status</strong>
                    <span class="badge" id="mgmStatusBadge">Open</span>
                    <span class="badge" id="mgmSourceBadge" style="font-size:10px;display:none;"></span>
                    <span class="badge bg-success" id="mgmAutoClosedBadge" style="font-size:10px;display:none;"><i class="fas fa-bolt me-1"></i>Auto-closed</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap mgm-status-btns" id="mgmStatusActions">
                    <span class="text-muted" style="font-size:12px;">Change to</span>
                    <button type="button" class="btn btn-outline-primary btn-sm btn-mgm-status" data-status="InProgress"><i class="fas fa-hourglass-half me-1"></i>In Progress</button>
                    <button type="button" class="btn btn-outline-danger btn-sm btn-mgm-status" data-status="Closed"><i class="fas fa-times-circle me-1"></i>Close</button>
                    <button type="button" class="btn btn-outline-warning btn-sm btn-mgm-status" data-status="Open"><i class="fas fa-redo me-1"></i>Reopen</button>
                </div>
            </div>

            <div class="modal-body pt-3" id="mgmBody">
                <div class="text-center py-4 text-muted" id="mgmLoading"><i class="fas fa-spinner fa-spin me-2"></i>Loading record details...</div>

                <div id="mgmEmailContext" style="display:none;">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mgm-meta">
                                <span><strong>From:</strong> <span id="mgmFrom"></span></span><br/>
                                <span><strong>Received:</strong> <span id="mgmReceived"></span></span><br/>
                                <span><strong>Phone:</strong> <span id="mgmPhone"></span></span><br/>
                                <span><strong>IRF Ref:</strong> <span id="mgmIrf"></span></span><br/>
                                <span><strong>Credentials:</strong> <span id="mgmCredentials"></span></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mgm-meta">
                                <span><strong>Name:</strong> <span id="mgmName"></span></span><br/>
                                <span><strong>Job Title:</strong> <span id="mgmJobTitle"></span></span><br/>
                                <span><strong>MAG:</strong>
                                    <span class="mag-edit-wrap">
                                        <span id="mgmMag"></span>
                                        <button type="button" class="mag-edit-btn" id="btnEditMag" title="Change MAG"><i class="fas fa-pencil-alt"></i></button>
                                        <div class="mag-dropdown-container" id="magDropdownContainer">
                                            <input type="text" class="mag-dropdown-search" id="magSearchInput" placeholder="Search MAG..." autocomplete="off" />
                                            <ul class="mag-dropdown-list" id="magDropdownList"></ul>
                                        </div>
                                    </span>
                                </span><br/>
                                
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span style="font-size:13px!important;" class="label"><i class="fas fa-briefcase me-1"></i>Employed:</span>
                                <span style="line-height:25px;" class="value" id="mgmEmployed">—</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span style="font-size:13px!important;" class="label"><i class="fas fa-building me-1"></i>Company:</span>
                                <span style="line-height:25px;" class="value" id="mgmCompany">—</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4"><div class="mgm-section-title">Mail Body Intent</div><div class="intent-badge bg-light border" id="mgmMailIntent"></div></div>
                        <div class="col-md-4"><div class="mgm-section-title">Availability Intent</div><div style="font-size:12px;" id="mgmAvailIntent"></div></div>
                        <div class="col-md-4"><div class="mgm-section-title">Concerns</div><div style="font-size:12px;" id="mgmConcerns"></div></div>
                    </div>
                    <div class="mb-3"><div class="mgm-section-title">Full Email Body</div><div class="mgm-mail-body" id="mgmMailBody"></div></div>
                    <hr/>

                    <h6 class="fw-bold mb-3" style="font-size:13px;"><i class="fas fa-tasks me-2 text-primary"></i>Verification &amp; Assignment Pipeline</h6>

                    <div class="mgm-action-card pending" id="step1Card">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number pending" id="step1Number">1</span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;"><strong style="font-size:13px;">Resume Fitment Analysis</strong><div class="text-muted mt-1" style="font-size:11.5px;" id="step1Subtitle">Runs the resume through AI to evaluate fitment for the specialization</div></div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                        <a href="#" target="_blank" class="btn btn-outline-secondary btn-sm mgm-btn-view-resume" id="btnViewResume" style="display:none;"><i class="fas fa-file-alt me-1"></i>View Resume</a>
                                        <button type="button" class="btn btn-outline-success btn-sm" id="btnUploadResume" style="font-size:11px;"><i class="fas fa-upload me-1"></i>Upload Resume</button>
                                        <button type="button" class="btn btn-info btn-sm mgm-action-btn text-white" id="btnAnalyzeResume"><i class="fas fa-robot me-1"></i>Analyze Resume</button>
                                    </div>
                                </div>
                                <div id="resumeUploadArea" style="display:none;" class="mt-2 p-2 border rounded bg-light">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="file" id="resumeFileInput" accept=".pdf,.doc,.docx" class="form-control form-control-sm" style="max-width:300px;font-size:11px;" />
                                        <button type="button" class="btn btn-sm btn-success" id="btnConfirmUpload" style="font-size:11px;padding:3px 10px;"><i class="fas fa-cloud-upload-alt me-1"></i>Upload</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCancelUpload" style="font-size:11px;padding:3px 8px;">Cancel</button>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size:10px;">Accepts PDF, DOC, DOCX files.</div>
                                    <div id="uploadProgress" style="display:none;" class="mt-1"><i class="fas fa-spinner fa-spin me-1"></i><span style="font-size:11px;">Uploading...</span></div>
                                    <div id="uploadResult" style="display:none;" class="mt-1"></div>
                                </div>
                                <div class="mgm-result-block" id="step1Result" style="display:none;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mgm-action-card pending disabled" id="step2Card">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number pending" id="step2Number">2</span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;"><strong style="font-size:13px;">Assign to Assessment Group</strong><div class="text-muted mt-1" style="font-size:11.5px;" id="step2Subtitle">Maps interviewer to the assessment group and sends notification</div></div>
                                    <div class="d-flex align-items-center flex-shrink-0">
                                        <button type="button" class="btn btn-success btn-sm mgm-action-btn" id="btnAssignAG"><i class="fas fa-user-plus me-1"></i>Assign to AG</button>
                                    </div>
                                </div>
                                <div class="mgm-result-block" id="step2Result" style="display:none;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer mgm-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-refresh-manage" id="btnRefreshManage"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-history" id="btnViewHistory"><i class="fas fa-history me-1"></i>History</button>
                    <button type="button" class="btn btn-sm btn-info text-white" id="btnCallInterviewer" style="display:none;"><i class="fas fa-phone-alt me-1"></i>Call Interviewer</button>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span id="plivoCallBadge" style="display:none;font-size:11px;"></span>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- History Modal -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header hm-header border-0 align-items-start">
                <div class="min-w-0 flex-grow-1 pe-2">
                    <p class="hm-eyebrow">Audit trail</p>
                    <h2 class="hm-title mb-0"><i class="fas fa-history me-2"></i>Record history</h2>
                    <small class="text-muted" id="historyModalSubject"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body hm-body pt-3">
                <div class="text-center py-4" id="historyLoading"><i class="fas fa-spinner fa-spin me-2"></i>Loading history...</div>
                <ul class="history-timeline mb-0" id="historyList" style="display:none"></ul>
                <div class="text-center py-4" id="historyEmpty" style="display:none"><i class="fas fa-inbox me-2"></i>No history recorded yet.</div>
            </div>
            <div class="modal-footer hm-footer border-0">
                <button type="button" class="hm-footer-btn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var currentRecordId = null, currentRecord = null;
    var canDelete = @(canDelete ? "true" : "false");
    var verificationToken = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val() || '';

    function showLoading() { document.getElementById('loadingOverlay').classList.add('show'); }
    document.getElementById('filterForm').addEventListener('submit', showLoading);
    document.querySelectorAll('.pagination .page-link').forEach(function (l) { l.addEventListener('click', showLoading); });
    function changePageSize(size) { showLoading(); var f = document.getElementById('filterForm'); f.querySelector('[name="pageSize"]').value = size; f.querySelector('[name="page"]').value = 1; f.submit(); }

    $(document).on('click', '.btn-manage-record', function () { openManageModal($(this).data('record-id')); });

    $(document).on('click', '.btn-delete-record', function () {
        var id = $(this).data('record-id');
        if (!confirm('Are you sure you want to delete record #' + id + '? This action cannot be undone.')) return;
        $.ajax({
            url: '@Url.Action("DeleteRecord", "InterviewerAvailability")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: id },
            success: function (res) {
                if (res.success) { $('#row-' + id).fadeOut(300, function () { $(this).remove(); }); }
                else { alert(res.error || 'Could not delete record.'); }
            },
            error: function () { alert('Delete request failed.'); }
        });
    });

    $(document).on('click', '.btn-drop-profile', function () {
        var id = $(this).data('record-id');
        if (!confirm('Drop profile for record #' + id + '? This will mark the interviewer as unavailable (Isavailable = 4) and close this record.')) return;
        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
        $.ajax({
            url: '@Url.Action("DropProfile", "InterviewerAvailability")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: id },
            success: function (res) {
                if (res.success) {
                    btn.replaceWith('<span class="badge bg-secondary ia-badge-dropped">Dropped</span>');
                    var row = $('#row-' + id);
                    row.find('.col-status .intent-badge').first().removeClass('status-open status-inprogress status-verified').addClass('status-closed').text('Closed');
                } else { alert(res.error || 'Could not drop profile.'); btn.prop('disabled', false).html('<i class="fas fa-user-slash"></i>'); }
            },
            error: function () { alert('Drop profile request failed.'); btn.prop('disabled', false).html('<i class="fas fa-user-slash"></i>'); }
        });
    });

    $(document).on('click', '.btn-inactivate-interviewer', function () {
        var id = $(this).data('record-id');
        var name = $(this).data('interviewer-name');
        Swal.fire({
            title: 'Inactivate Interviewer',
            html: 'Are you sure you want to inactivate <strong>' + name + '</strong>?<br/><br/><textarea id="ia-inactivate-comment" class="form-control" rows="2" placeholder="Reason for inactivation..."></textarea>',
            icon: 'warning', showCancelButton: true,
            confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, inactivate', cancelButtonText: 'Cancel',
            preConfirm: function () {
                var c = document.getElementById('ia-inactivate-comment').value;
                if (!c || !c.trim()) { Swal.showValidationMessage('Please enter a reason'); return false; }
                return c;
            }
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '@Url.Action("InactivateInterviewerFromEA", "InterviewerAvailability")', type: 'POST',
                data: { __RequestVerificationToken: verificationToken, eaId: id, comment: result.value },
                success: function (res) {
                    if (res.success) { Swal.fire('Done', 'Interviewer inactivated.', 'success').then(function () { location.reload(); }); }
                    else { Swal.fire('Error', res.error || 'Failed.', 'error'); }
                },
                error: function () { Swal.fire('Error', 'Request failed.', 'error'); }
            });
        });
    });

    $(document).on('click', '.btn-reactivate-interviewer', function () {
        var id = $(this).data('record-id');
        var name = $(this).data('interviewer-name');
        Swal.fire({
            title: 'Reactivate Interviewer',
            text: 'Are you sure you want to reactivate ' + name + '?',
            icon: 'question', showCancelButton: true,
            confirmButtonColor: '#28a745', cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, reactivate', cancelButtonText: 'Cancel'
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.ajax({
                url: '@Url.Action("ReactivateInterviewerFromEA", "InterviewerAvailability")', type: 'POST',
                data: { __RequestVerificationToken: verificationToken, eaId: id },
                success: function (res) {
                    if (res.success) { Swal.fire('Done', 'Interviewer reactivated.', 'success').then(function () { location.reload(); }); }
                    else { Swal.fire('Error', res.error || 'Failed.', 'error'); }
                },
                error: function () { Swal.fire('Error', 'Request failed.', 'error'); }
            });
        });
    });

    function openManageModal(id) {
        currentRecordId = id; currentRecord = null;
        $('#mgmRecordNo').text('#' + id); $('#mgmLoading').show(); $('#mgmEmailContext').hide(); resetPipeline();
        new bootstrap.Modal(document.getElementById('manageModal')).show();
        loadRecordDetails(id);
    }

    function loadRecordDetails(id) {
        $.ajax({
            url: '@Url.Action("GetRecordDetails", "InterviewerAvailability")', type: 'GET', data: { id: id },
            timeout: 30000,
            success: function (res) {
                $('#mgmLoading').hide();
                if (!res.success) { $('#mgmEmailContext').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>' + (res.error || 'Unknown error') + '</div>').show(); return; }
                currentRecord = res.record; populateModal(res.record); $('#mgmEmailContext').show();
            },
            error: function (xhr, status) {
                $('#mgmLoading').hide();
                var msg = status === 'timeout' ? 'Request timed out. Please try again.' : 'Failed to load record details.';
                $('#mgmEmailContext').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>' + msg + ' <button class="btn btn-sm btn-outline-danger ms-2" onclick="loadRecordDetails(' + id + ');$(\'#mgmLoading\').show();$(\'#mgmEmailContext\').hide();">Retry</button></div>').show();
            }
        });
    }

    function populateModal(r) {
        $('#mgmFrom').text(r.senderEmail || '—'); $('#mgmReceived').text(r.receivedAt || '—');
        var phoneDisplay = r.userMobileNumber ? r.userMobileNumber.toString() : (r.phone || '—');
        $('#mgmPhone').text(phoneDisplay); $('#mgmIrf').text(r.irfReference || '—'); $('#mgmCredentials').text(r.hasLoginCredentials || '—');
        $('#mgmName').text(r.interviewerName || r.interviewerNickName || '—'); $('#mgmJobTitle').text(r.jobTitle || '—');
        $('#mgmMag').text((r.magName || '—') + (r.assessmentGroupName ? ' \u2192 ' + r.assessmentGroupName : ''));
        
        $('#mgmMailIntent').text(r.mailBodyIntent || '—'); $('#mgmAvailIntent').text(r.availabilityIntent || '—');
        $('#mgmConcerns').text(r.concernsOrNotInterested || 'None'); $('#mgmMailBody').text(r.mailContent || '');
        updateStatusBadge(r.status || 'Open');

        var srcBadge = $('#mgmSourceBadge');
        if (r.source) {
            var srcMap = { 'Relay': { bg: '#e0f2fe', fg: '#0369a1', label: 'Relay' }, 'BatchCall': { bg: '#d1fae5', fg: '#065f46', label: 'Batch Call' }, 'IRFAutoCall': { bg: '#ede9fe', fg: '#5b21b6', label: 'IRF Auto-Call' }, 'Campaign': { bg: '#fef3c7', fg: '#92400e', label: 'Campaign' } };
            var si = srcMap[r.source] || (r.source && r.source.indexOf('Campaign') === 0 ? { bg: '#fef3c7', fg: '#92400e', label: 'Campaign' } : { bg: '#f3f4f6', fg: '#6b7280', label: r.source });
            srcBadge.css({ background: si.bg, color: si.fg }).text(si.label).show();
        } else { srcBadge.hide(); }

        if (r.isAutoClosed === true) {
            var acTitle = 'Auto-closed by ' + (r.autoClosedBy || 'System');
            if (r.autoClosedAt) acTitle += ' at ' + r.autoClosedAt;
            $('#mgmAutoClosedBadge').attr('title', acTitle).show();
        } else { $('#mgmAutoClosedBadge').hide(); }

        if (r.isEmployed === true) { $('#mgmEmployed').html('<span class="employed-yes"><i class="fas fa-check-circle me-1"></i>Yes</span>'); }
        else if (r.isEmployed === false) { $('#mgmEmployed').html('<span class="employed-no"><i class="fas fa-times-circle me-1"></i>No</span>'); }
        else { $('#mgmEmployed').text('—'); }
        $('#mgmCompany').text(r.companyName || '—');

        var resumeUrl = r.resumeLink; if (!resumeUrl || resumeUrl === 'None') resumeUrl = r.profileResumeLink;
        if (resumeUrl && resumeUrl !== 'None') { $('#btnViewResume').attr('href', 'https://docs.google.com/gview?url=' + encodeURIComponent(resumeUrl) + '&embedded=false').show(); } else { $('#btnViewResume').hide(); }
        syncPipeline(r);
    }

    function updateStatusBadge(s) {
        var b = $('#mgmStatusBadge'); b.text(s).removeClass('bg-warning bg-primary bg-success bg-secondary bg-danger text-dark');
        switch ((s || '').toLowerCase()) { case 'open': b.addClass('bg-warning text-dark'); break; case 'inprogress': b.addClass('bg-primary'); break; case 'verified': b.addClass('bg-success'); break; case 'closed': b.addClass('bg-secondary'); break; default: b.addClass('bg-light text-dark'); }
    }

    var iaDefaultSubtitles = {
        1: 'Runs the resume through AI to evaluate fitment for the specialization',
        2: 'Maps interviewer to the assessment group and sends notification'
    };

    function resetPipeline() {
        ['step1Card','step2Card'].forEach(function(id){ $('#'+id).removeClass('completed failed disabled').addClass('pending'); });
        ['step1Number','step2Number'].forEach(function(id){ $('#'+id).removeClass('completed failed running').addClass('pending'); });
        $('#step2Card').addClass('disabled');
        $('#step1Result, #step2Result').hide().empty();
        $('#step1Subtitle').html(iaDefaultSubtitles[1]);
        $('#step2Subtitle').html(iaDefaultSubtitles[2]);
        $('#btnAnalyzeResume').prop('disabled',false).html('<i class="fas fa-robot me-1"></i>Analyze Resume');
        $('#btnAssignAG').prop('disabled',false).html('<i class="fas fa-user-plus me-1"></i>Assign to AG');
        $('#btnUploadResume').show();
        $('#resumeUploadArea').hide();
        $('#resumeFileInput').val('');
        $('#uploadProgress, #uploadResult').hide();
        $('#magDropdownContainer').removeClass('open');
    }

    function aiPassed(r) {
        if (r.resumeAIAnalysisCompleted !== true) return false;
        try {
            var p = JSON.parse(r.resumeAIAnalysisResult);
            return p && p.verdict && p.verdict.toLowerCase().indexOf('yes') !== -1;
        } catch(e) { return false; }
    }

    function syncPipeline(r) {
        var verdictPositive = false;
        var step1Done = false;
        if (r.resumeAIAnalysisCompleted === true) {
            var html = r.resumeAIAnalysisResult || 'Analysis complete.';
            try {
                var p = JSON.parse(r.resumeAIAnalysisResult);
                html = '<strong>Verdict:</strong> ' + (p.verdict||'—') + ' | <strong>Score:</strong> ' + (p.fitmentScore||'—') + '<br/>' + (p.completeFitmentAnalysis||'');
                verdictPositive = p && p.verdict && p.verdict.toLowerCase().indexOf('yes') !== -1;
            } catch(e){}
            if (verdictPositive) {
                markStep(1, 'completed', html);
                step1Done = true;
            } else {
                markStep(1, 'failed', html + '<br/><span class="text-danger" style="font-size:11px;"><strong>Fitment negative — next step is blocked.</strong></span>');
                $('#btnAnalyzeResume').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Analyzed');
                $('#step1Subtitle').html('<span class="text-danger" style="font-size:11px;">Fitment analysis negative</span>');
            }
        } else if (!r.hasResumeLink && !r.hasProfileResumeLink) {
            $('#step1Subtitle').html('No resume available for analysis. <strong>Upload a resume to proceed.</strong>');
            $('#btnAnalyzeResume').prop('disabled', true);
            $('#resumeUploadArea').show();
        }

        if (r.assessmentGroupId && r.assessmentGroupId > 0) {
            markStep(2, 'completed', 'Assigned to ' + (r.assessmentGroupName || 'AG #' + r.assessmentGroupId) + (r.assessmentGroupAssignedAt ? ' on ' + r.assessmentGroupAssignedAt : ''));
        } else if (r.resumeAIAnalysisCompleted === true && !verdictPositive) {
            $('#step2Subtitle').html('<span class="text-danger">Resume fitment analysis was negative. Cannot assign AG.</span>');
            $('#step2Card').addClass('disabled');
            $('#btnAssignAG').prop('disabled', true);
        } else if (!r.interviewerProfileId) {
            $('#step2Subtitle').html('<span class="text-danger">Sender is not a known interviewer in the system. Cannot assign AG.</span>');
            $('#btnAssignAG').prop('disabled', true);
        } else if (!r.resolvedAssessmentGroupId) {
            $('#step2Subtitle').html('<span class="text-warning">No assessment group found for MAG: <strong>' + (r.magName || '—') + '</strong>. Check MAG name or use the edit button to change it.</span>');
            $('#btnAssignAG').prop('disabled', true);
        }

        // Explicit step enablement
        if (step1Done) { $('#step2Card').removeClass('disabled'); }
    }

    function markStep(step, state, message) {
        var card = $('#step'+step+'Card'), num = $('#step'+step+'Number'), result = $('#step'+step+'Result');
        card.removeClass('pending completed failed disabled'); num.removeClass('pending completed failed running');
        if (state === 'completed') {
            card.addClass('completed'); num.addClass('completed');
            if (step===1) { $('#btnAnalyzeResume').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Analyzed'); $('#btnUploadResume').hide(); $('#resumeUploadArea').hide(); $('#step1Subtitle').html('<span class="text-success" style="font-size:11px;">AI analysis completed</span>'); }
            if (step===2) { $('#btnAssignAG').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Assigned'); $('#step2Subtitle').html('<span class="text-success" style="font-size:11px;">Assessment group assigned</span>'); }
        } else if (state === 'failed') { card.addClass('failed'); num.addClass('failed'); }
        else if (state === 'running') { num.addClass('running'); }
        if (message) result.html(message).show();
        if (step===1 && state==='completed') $('#step2Card').removeClass('disabled');
    }

    $(document).on('click', '.btn-mgm-status', function () {
        var status = $(this).data('status'); if (!currentRecordId) return;
        $.ajax({ url: '@Url.Action("UpdateStatusModal", "InterviewerAvailability")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, status: status },
            success: function (res) { if (res.success) { updateStatusBadge(res.status); if (currentRecord) currentRecord.status = res.status; } }
        });
    });

    // Resume Upload
    $('#btnUploadResume').on('click', function () { $('#resumeUploadArea').toggle(); });
    $('#btnCancelUpload').on('click', function () { $('#resumeUploadArea').hide(); $('#resumeFileInput').val(''); $('#uploadResult').hide(); });

    $('#btnConfirmUpload').on('click', function () {
        if (!currentRecordId) return;
        var fileInput = document.getElementById('resumeFileInput');
        if (!fileInput.files || fileInput.files.length === 0) { alert('Please select a file.'); return; }

        var formData = new FormData();
        formData.append('id', currentRecordId);
        formData.append('resumeFile', fileInput.files[0]);
        formData.append('__RequestVerificationToken', verificationToken);

        $('#uploadProgress').show(); $('#uploadResult').hide();
        $('#btnConfirmUpload').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("UploadResume", "InterviewerAvailability")',
            type: 'POST', data: formData, processData: false, contentType: false, timeout: 120000,
            success: function (res) {
                $('#uploadProgress').hide(); $('#btnConfirmUpload').prop('disabled', false);
                if (res.success) {
                    $('#uploadResult').html('<span class="text-success" style="font-size:11px;"><i class="fas fa-check-circle me-1"></i>Uploaded successfully.</span>').show();
                    $('#btnViewResume').attr('href', 'https://docs.google.com/gview?url=' + encodeURIComponent(res.resumeLink) + '&embedded=false').show();
                    $('#btnAnalyzeResume').prop('disabled', false);
                    $('#step1Subtitle').text('Resume uploaded. Click Analyze Resume to proceed.');
                    if (currentRecord) { currentRecord.resumeLink = res.resumeLink; currentRecord.hasResumeLink = true; }
                    setTimeout(function(){ $('#resumeUploadArea').hide(); }, 2000);
                } else {
                    $('#uploadResult').html('<span class="text-danger" style="font-size:11px;"><i class="fas fa-times-circle me-1"></i>' + (res.error || 'Upload failed.') + '</span>').show();
                }
            },
            error: function () {
                $('#uploadProgress').hide(); $('#btnConfirmUpload').prop('disabled', false);
                $('#uploadResult').html('<span class="text-danger" style="font-size:11px;"><i class="fas fa-times-circle me-1"></i>Upload request failed.</span>').show();
            }
        });
    });

    $('#btnAnalyzeResume').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Analyzing...'); $('#step1Number').removeClass('pending').addClass('running');
        $('#step1Subtitle').text('AI analysis in progress \u2014 this may take 30\u201360 seconds...');
        $.ajax({ url: '@Url.Action("AnalyzeResume", "InterviewerAvailability")', type: 'POST', timeout: 180000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    var h='<strong>Verdict:</strong> '+(res.verdict||'—')+' | <strong>Score:</strong> '+(res.fitmentScore||'—');
                    if(res.completeFitmentAnalysis) h+='<br/><div class="mt-1" style="white-space:pre-wrap;">'+res.completeFitmentAnalysis+'</div>';
                    if(currentRecord){currentRecord.resumeAIAnalysisCompleted=true;currentRecord.resumeAIAnalysisResult=res.analysisResult;}
                    if (res.isPositiveVerdict) {
                        markStep(1,'completed',h);
                        updateStatusBadge('Verified');
                    } else {
                        markStep(1,'failed', h + '<br/><span class="text-danger" style="font-size:11px;"><strong>Fitment negative — next step is blocked.</strong></span>');
                        btn.prop('disabled',true).html('<i class="fas fa-check me-1"></i>Analyzed');
                        $('#step1Subtitle').html('<span class="text-danger" style="font-size:11px;">Fitment analysis negative</span>');
                        $('#step2Subtitle').html('<span class="text-danger">Resume fitment analysis was negative. Cannot assign AG.</span>');
                        $('#step2Card').addClass('disabled');
                        $('#btnAssignAG').prop('disabled', true);
                    }
                } else {
                    var errHtml = res.error || 'Analysis failed.';
                    if (res.needsUpload) {
                        errHtml += ' <br/><em style="font-size:11px;">Use the Upload Resume button to upload a valid PDF.</em>';
                        $('#resumeUploadArea').show();
                    }
                    markStep(1,'failed',errHtml);
                    btn.prop('disabled',false).html('<i class="fas fa-robot me-1"></i>Retry');
                    $('#step1Subtitle').html(iaDefaultSubtitles[1]);
                }
            },
            error: function (xhr, status) {
                var msg = status === 'timeout' ? 'Request timed out. The analysis may still be running — try refreshing in a minute.' : 'Request failed. Please try again.';
                markStep(1,'failed',msg);
                btn.prop('disabled',false).html('<i class="fas fa-robot me-1"></i>Retry');
                $('#step1Subtitle').html(iaDefaultSubtitles[1]);
            }
        });
    });

    $('#btnAssignAG').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Assigning...'); $('#step2Number').removeClass('pending').addClass('running');
        $('#step2Subtitle').text('Assigning to assessment group...');
        $.ajax({ url: '@Url.Action("AssignAssessmentGroup", "InterviewerAvailability")', type: 'POST', timeout: 60000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) { markStep(2,'completed',res.message||'Assessment group assigned.'); updateStatusBadge('Closed'); }
                else { markStep(2,'failed',res.error||'Assignment failed.'); btn.prop('disabled',false).html('<i class="fas fa-user-plus me-1"></i>Retry'); $('#step2Subtitle').html(iaDefaultSubtitles[2]); }
            },
            error: function () { markStep(2,'failed','Request failed.'); btn.prop('disabled',false).html('<i class="fas fa-user-plus me-1"></i>Retry'); $('#step2Subtitle').html(iaDefaultSubtitles[2]); }
        });
    });

    $('#btnRefreshManage').on('click', function () { if (currentRecordId) { $('#mgmLoading').show(); $('#mgmEmailContext').hide(); resetPipeline(); loadRecordDetails(currentRecordId); } });

    /* ── MAG searchable dropdown ───────────────────────────────────── */
    var allMags = [];
    var magsLoaded = false;

    function loadMags(callback) {
        if (magsLoaded) { if (callback) callback(); return; }
        $.ajax({
            url: '@Url.Action("GetAllMags", "InterviewerAvailability")', type: 'GET',
            success: function (res) {
                if (res.success && res.data) { allMags = res.data; magsLoaded = true; }
                if (callback) callback();
            }
        });
    }

    $('#btnEditMag').on('click', function (e) {
        e.stopPropagation();
        var $dd = $('#magDropdownContainer');
        if ($dd.hasClass('open')) { $dd.removeClass('open'); return; }
        loadMags(function () {
            renderMagList('');
            $dd.addClass('open');
            $('#magSearchInput').val('').focus();
        });
    });

    $(document).on('click', function (e) {
        if (!$(e.target).closest('.mag-edit-wrap').length) $('#magDropdownContainer').removeClass('open');
    });

    $('#magSearchInput').on('input', function () { renderMagList($(this).val()); });

    function renderMagList(filter) {
        var $list = $('#magDropdownList').empty();
        var lf = (filter || '').toLowerCase();
        var currentMag = currentRecord ? (currentRecord.magName || '') : '';
        $.each(allMags, function (_, m) {
            var display = m.magName + (m.assessmentGroupName ? ' → ' + m.assessmentGroupName : '');
            if (lf && display.toLowerCase().indexOf(lf) === -1) return;
            var $li = $('<li>').text(display).data('mag', m);
            if (m.magName === currentMag) $li.addClass('selected');
            $list.append($li);
        });
    }

    $(document).on('click', '#magDropdownList li', function () {
        var m = $(this).data('mag');
        if (!m || !currentRecordId) return;
        var oldMag = currentRecord ? (currentRecord.magName || '') : '';
        if (m.magName === oldMag) { $('#magDropdownContainer').removeClass('open'); return; }

        $.ajax({
            url: '@Url.Action("SaveMagOverride", "InterviewerAvailability")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, oldValue: oldMag, newValue: m.magName },
            success: function (res) {
                if (res.success) {
                    $('#mgmMag').text(m.magName + (m.assessmentGroupName ? ' \u2192 ' + m.assessmentGroupName : ''));
                    if (currentRecord) { currentRecord.magName = m.magName; currentRecord.resolvedAssessmentGroupId = m.assessmentGroupId; currentRecord.assessmentGroupName = m.assessmentGroupName; }
                    if (m.assessmentGroupId > 0) {
                        $('#step2Subtitle').html('Maps interviewer to the assessment group and sends notification');
                        if (!$('#step2Card').hasClass('completed') && aiPassed(currentRecord)) { $('#btnAssignAG').prop('disabled', false); $('#step2Card').removeClass('disabled'); }
                    }
                } else { alert(res.error || 'Failed to update MAG.'); }
                $('#magDropdownContainer').removeClass('open');
            }
        });
    });

    /* ── History modal ───────────────────────────────────────────────── */
    var eventLabels = {
        'StatusChange': { icon: 'fas fa-sync-alt', color: '#6c757d', label: 'Status changed' },
        'ResumeUpload': { icon: 'fas fa-upload', color: '#0dcaf0', label: 'Resume uploaded' },
        'ResumeAnalysis': { icon: 'fas fa-robot', color: '#fd7e14', label: 'Resume analyzed' },
        'AGAssignment': { icon: 'fas fa-user-plus', color: '#6f42c1', label: 'Assigned to AG' },
        'ProfileDropped': { icon: 'fas fa-user-slash', color: '#dc3545', label: 'Profile dropped' },
        'RecordCreated': { icon: 'fas fa-plus-circle', color: '#20c997', label: 'Record created' },
        'MagChange': { icon: 'fas fa-pencil-alt', color: '#e67e22', label: 'MAG changed' }
    };

    function openHistoryModal(recordId) {
        if (!recordId) return;
        $('#historyModalSubject').text('Record #' + recordId);
        $('#historyLoading').show(); $('#historyList').hide().empty(); $('#historyEmpty').hide();

        var modalEl = document.getElementById('historyModal');
        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        $(modalEl).one('shown.bs.modal', function () {
            var backs = document.querySelectorAll('.modal-backdrop.show');
            if (backs.length > 1) backs[backs.length - 1].style.zIndex = '1075';
        });
        modal.show();

        $.ajax({
            url: '@Url.Action("GetHistory", "InterviewerAvailability")',
            type: 'GET', data: { id: recordId },
            success: function (data) {
                $('#historyLoading').hide();
                if (!data || data.length === 0) { $('#historyEmpty').show(); return; }
                var $ul = $('#historyList');
                $.each(data, function (_, h) {
                    var cfg = eventLabels[h.eventType] || eventLabels['StatusChange'];
                    var dotCls = h.eventType.toLowerCase();
                    if (h.eventType === 'StatusChange') dotCls = (h.toValue || 'open').toLowerCase();

                    var arrow;
                    if (h.eventType === 'RecordCreated') {
                        arrow = '<span class="text-muted">Record created as </span><strong>' + h.toValue + '</strong>';
                    } else if (h.eventType === 'ResumeUpload') {
                        arrow = '<span class="text-muted">Uploaded: </span><strong>' + h.toValue + '</strong>';
                    } else if (h.fromValue === '—' || !h.fromValue) {
                        arrow = '<strong>' + h.toValue + '</strong>';
                    } else {
                        arrow = '<strong>' + h.fromValue + '</strong>'
                            + ' <i class="fas fa-long-arrow-alt-right mx-1 text-muted" style="font-size:10px"></i> '
                            + '<strong>' + h.toValue + '</strong>';
                    }

                    $ul.append(
                        '<li><span class="ht-dot ' + dotCls + '"></span>'
                        + '<div class="ht-body"><div class="ht-transition">'
                        + '<i class="' + cfg.icon + ' me-2" style="font-size:11px;color:' + cfg.color + '" title="' + cfg.label + '"></i>'
                        + arrow + '</div>'
                        + '<div class="ht-meta"><i class="fas fa-user me-1"></i>' + h.changedBy
                        + ' &nbsp;&middot;&nbsp; <i class="fas fa-clock me-1"></i>' + h.changedAt
                        + '</div></div></li>'
                    );
                });
                $ul.show();
            },
            error: function () {
                $('#historyLoading').hide();
                $('#historyEmpty').text('Could not load history. Please try again.').show();
            }
        });
    }

    $('#btnViewHistory').on('click', function () { openHistoryModal(currentRecordId); });

    // ── Plivo Call ──────────────────────────────────────────────────────────
    function syncPlivoCallUI(r) {
        var $btn = $('#btnCallInterviewer'), $badge = $('#plivoCallBadge');
        var hasPhone = r && (r.userMobileNumber || r.phone);
        if (!hasPhone) { $btn.hide(); $badge.hide(); return; }

        $btn.show();
        if (r.plivoCallStatus) {
            var s = r.plivoCallStatus;
            var retryable = ['trigger-failed','no_answer','busy_rejected','failed','no-answer','busy'];
            if (retryable.indexOf(s) >= 0) {
                $btn.prop('disabled', false).html('<i class="fas fa-redo me-1"></i>Retry Call');
                $badge.html('<span class="badge bg-warning text-dark">' + s + '</span>').show();
            } else if (s === 'completed' || s === 'answered') {
                $btn.prop('disabled', true).html('<i class="fas fa-check me-1"></i>Called');
                var intentBadge = '';
                if (r.plivoIntent === 'available') intentBadge = ' <span class="badge bg-success ms-1">Available</span>';
                else if (r.plivoIntent === 'not_available') intentBadge = ' <span class="badge bg-danger ms-1">Not Available</span>';
                else if (r.plivoIntent === 'unsubscribe') intentBadge = ' <span class="badge bg-warning text-dark ms-1">Unsubscribe</span>';
                else if (r.plivoIntent) intentBadge = ' <span class="badge bg-secondary ms-1">' + r.plivoIntent + '</span>';
                $badge.html('<span class="badge bg-success">' + s + '</span>' + intentBadge + (r.plivoCallDuration ? ' <span class="text-muted ms-1">' + r.plivoCallDuration + 's</span>' : '')).show();
            } else if (s === 'triggered' || s === 'initiated') {
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Calling...');
                $badge.html('<span class="badge bg-info">' + s + '</span>').show();
            } else {
                $btn.prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Interviewer');
                $badge.html('<span class="badge bg-secondary">' + s + '</span>').show();
            }
        } else {
            $btn.prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Interviewer');
            $badge.hide();
        }
    }

    // Hook into populateModal
    var _origPopulateModal = populateModal;
    populateModal = function(r) {
        _origPopulateModal(r);
        syncPlivoCallUI(r);
    };

    $('#btnCallInterviewer').on('click', function () {
        if (!currentRecordId || !currentRecord) return;
        var name = currentRecord.interviewerName || currentRecord.interviewerNickName || 'this interviewer';
        if (!confirm('Trigger an availability check call to ' + name + '?')) return;

        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Calling...');
        $('#plivoCallBadge').html('<span class="badge bg-info">initiating...</span>').show();

        $.ajax({
            url: '@Url.Action("InitiatePlivoCall", "InterviewerAvailability")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    $btn.html('<i class="fas fa-check me-1"></i>Triggered');
                    $('#plivoCallBadge').html('<span class="badge bg-info">triggered</span>' + (res.conversationId ? ' <span class="text-muted" style="font-size:10px;">' + res.conversationId + '</span>' : '')).show();
                    if (currentRecord) { currentRecord.plivoCallStatus = 'triggered'; currentRecord.plivoConversationId = res.conversationId; }
                } else {
                    $btn.prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Interviewer');
                    alert('Call failed: ' + (res.error || 'Unknown error'));
                    if (res.alreadyCalled) syncPlivoCallUI(currentRecord);
                }
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Interviewer');
                alert('Request failed. Please try again.');
            }
        });
    });
</script>
}
