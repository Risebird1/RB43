@model List<Risebird.Entities.ViewModel.InterviewerEmailAvailabilityVM>
@{
    ViewData["Title"] = "Interviewer Email Availability";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int page = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 25;
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    string selStatus = ViewBag.Status as string ?? string.Empty;
    string selEmail = ViewBag.SenderEmail as string ?? string.Empty;
    string selFitment = ViewBag.ResumeFitment as string ?? string.Empty;
    string selDateFrom = ViewBag.DateFrom as string ?? string.Empty;
    string selDateTo = ViewBag.DateTo as string ?? string.Empty;
    string selSource = ViewBag.Source as string ?? string.Empty;
    string selAutoClosed = ViewBag.AutoClosed as string ?? string.Empty;
    string selActiveStatus = ViewBag.ActiveStatus as string ?? string.Empty;
    string profileName = ViewBag.ProfileName as string ?? string.Empty;
    bool canDelete = profileName == "Admin" || profileName == "SupportAdmin";
    bool canDrop = canDelete || profileName == "HR" || profileName == "SeniorHR"
                || profileName == "InterviewerManagement" || profileName == "SeniorInterviewerManagement";

    bool hasFilters = !string.IsNullOrEmpty(selStatus) || !string.IsNullOrEmpty(selEmail)
                   || !string.IsNullOrEmpty(selFitment) || !string.IsNullOrEmpty(selDateFrom)
                   || !string.IsNullOrEmpty(selDateTo) || !string.IsNullOrEmpty(selSource)
                   || !string.IsNullOrEmpty(selAutoClosed) || !string.IsNullOrEmpty(selActiveStatus);

    int first = totalCount == 0 ? 0 : (page - 1) * pageSize + 1;
    int last = Math.Min(page * pageSize, totalCount);

    string pageUrl(int p)
    {
        var q = $"?page={p}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(selStatus)) q += $"&status={Uri.EscapeDataString(selStatus)}";
        if (!string.IsNullOrEmpty(selEmail)) q += $"&senderEmail={Uri.EscapeDataString(selEmail)}";
        if (!string.IsNullOrEmpty(selFitment)) q += $"&resumeFitment={Uri.EscapeDataString(selFitment)}";
        if (!string.IsNullOrEmpty(selDateFrom)) q += $"&dateFrom={Uri.EscapeDataString(selDateFrom)}";
        if (!string.IsNullOrEmpty(selDateTo)) q += $"&dateTo={Uri.EscapeDataString(selDateTo)}";
        if (!string.IsNullOrEmpty(selSource)) q += $"&source={Uri.EscapeDataString(selSource)}";
        if (!string.IsNullOrEmpty(selAutoClosed)) q += $"&autoClosed={Uri.EscapeDataString(selAutoClosed)}";
        if (!string.IsNullOrEmpty(selActiveStatus)) q += $"&activeStatus={Uri.EscapeDataString(selActiveStatus)}";
        return Url.Action("Index", "InterviewerAvailability") + q;
    }
}

