@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Project/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/Project/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}

<script>
    function ClientChanged(clientId) {
        var accountId = '@Model.id';
        $.ajax({
            type: "GET",
            url: "/Account/GetEditFilteredProjects",
            data: { 'clientId': clientId, 'accountId': accountId },
            success: function (data) {
                if (data == null || data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No data for this Client.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').html('');
                $('#tableID').html(data);
                $('#tableID').css("margin-left", "");



            }
        });

    }

</script>

