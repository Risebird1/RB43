    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
              

                    <div class="mdc-card-wrapper__text-section">

                        @using (Html.BeginForm("Edit", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid" }))
                        {
                            @*<div class="loader text-center">
                <img src="~/Newassets/img/lazyload.gif" />
            </div>*@


                            <div class="row">

                                <div class="card-header">
                                    <h4 class="card-title">Edit Account</h4>
                                </div>
                                <div style="width: 100%;">&nbsp;</div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 px-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.AccountOwnerId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.AccountOwnerId, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                        @Html.ValidationMessageFor(model => model.AccountOwnerId, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ClientId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.DropDownList("ClientId", Model.ClientList, new { @class = "form-control", @onchange = "ClientChanged(this.value)" })
                                        @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })

                                    </div>

                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EndClient, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.EndClient, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                        @Html.ValidationMessageFor(model => model.EndClient, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 px-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.Location, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                        @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                            </div>
                         
                            @*<div class="row">
                <div class="col-md-3 col-sm-3 px-1">
                    <div class="form-group">
                        <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="Name">Client Name</label>
                        @Html.DropDownList("ClientId", (SelectList)ViewBag.Clients, new { @class = "form-control", @onchange = "ClientChanged(this.value)", @style = "margin-left:11px" })
                    </div>
                </div>
            </div>*@
                    <div id="tableID">
                        <div class="table-responsive-sm">
                            <table class="table table-bordered mbn" id="ProjectList">
                                <thead>
                                    <tr>
                                        @*<th>IRF Id</th>*@
                                        <th width="40%" class="text-center" style="font-size:15px!important;">Project Name</th>
                                        <th width="30%" class="text-center" style="font-size:15px!important;">Client</th>
                                        <th class="text-center" style="font-size:15px!important;">Add</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.AccountProjectMappings.Count(); i++)
                                    {
                                        <tr>
                                            @*<td>
                                @Html.TextBoxFor(m => m.ProjectIRFMappings[i].IRFId, new { @class = "form-control", @readonly = "readonly"})

                            </td>*@
                                            <td class="text-center"> <a style="color:#007bff;" id="@("irflink_"+i)" target="_blank" title="Project" href='@Url.Action("Edit", "Project", new { id = Model.AccountProjectMappings[i].ProjectId })'> @Model.AccountProjectMappings[i].ProjectName</a> </td>
                                            @*<td>@Model.ProjectIRFMappings[i].PrimarySkills</td>*@
                                            <td class="text-center">@Model.AccountProjectMappings[i].Client</td>
                                            <td class="text-center">

                                                <div class="mdc-form-field" style="margin-bottom: 10px;">
                                                    <div class="mdc-checkbox">
                                                        @Html.CheckBoxFor(m => m.AccountProjectMappings[i].IsAdded, new { @class = "mdc-checkbox__native-control" @*, @style = "margin-left:25%"*@})


                                                        <div class="mdc-checkbox__background">
                                                            <svg class="mdc-checkbox__checkmark"
                                                                 viewBox="0 0 24 24">
                                                                <path class="mdc-checkbox__checkmark-path"
                                                                      fill="none"
                                                                      d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                            </svg>
                                                            <div class="mdc-checkbox__mixedmark"></div>
                                                        </div>
                                                        <div class="mdc-checkbox__ripple"></div>


                                                    </div>
                                                </div>



                                            </td>
                                            @Html.HiddenFor(m => m.AccountProjectMappings[i].ProjectId)

                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>

                        @Html.HiddenFor(m => m.id)

                        <div class="card-footer ">
                            <div class="row">

                                <div class="col-md-12 mc-button-area">
                                    @Html.ActionLink("Back to List", "Index", "Account", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Save</button>
                                </div>
                            </div>
                        </div>

                        }



                    </div>




                            <!-- end content-->
                        </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

