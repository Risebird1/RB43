@*@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.MeetingVM>
@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Project Interview Meetings";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=6" />

<link href="~/Newassets/css/project.css?v=7" rel="stylesheet" />
<input type="hidden" value="@ViewBag.IRFId" id="hidirfid" />
<script>
    var Header = "<a href='/Project/Index'>Projects</a>&nbsp; / &nbsp; Project Interview Meetings";
    $('#txtpageHeader').empty().html(Header);
</script>
<div class="main-panel" id="main-panel">
   
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bg-white">
            <div class="col-md-12">
                <div class="mdc-card card bg-white">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar" style="margin-bottom:10px">
                                <div class="row">
                                    <div class="card-header">
                                        <div class="pull-left">
                                            <h4 class="card-title">
                                                Interview Meetings list for <b>@ViewBag.ProjectName</b>
                                            </h4>
                                        </div>

                                        <div class="pull-right">
                                            <div id="meeting_filter" class="dataTables_filter pull-left" style="margin-right:10px;">

                                                <div class="searchCon" style="border:0px!important;">

                                                    @*<button onclick="searchResult()" type="button" id="search">&nbsp</button>*@
                                                    <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.Searchvalue">

                                                    <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                                                    @*<button style="display:none;" type="button" id="x">x</button>*@

                                                </div>
                                            </div>
                                            @Html.ActionLink("Back", "Index", "Project", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        </div>


                                    </div>


                                </div>


                            </div>
                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th id='start' style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;" id='start'>Interview Date</th>
                                                            <th>IRF</th>
                                                            <th>Candidate Name</th>
                                                            <th>Report Link</th>
                                                            <th>Resume</th>
                                                            <th>Contact</th>
                                                            <th>Client HR</th>
                                                            <th>Confirmation</th>
                                                            <th>Meeting</th>
                                                            <th>Selection</th>

                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;">Interview Date</th>
                                                            <th>IRF</th>
                                                            <th>Candidate Name</th>
                                                            <th>Report Link</th>
                                                            <th>Resume</th>
                                                            <th>Contact</th>
                                                            <th>Client HR</th>
                                                            <th>Confirmation</th>
                                                            <th>Meeting </th>
                                                            <th>Selection</th>

                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyProjectInterviewMeeting">
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr id="@item.imid" data-changes="1">
                                                                <td style="width:10px;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                <td> @item.interviewDate </td>
                                                                <td>@item.IRFId</td>


                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                {

                                                                    @if (item.candidateName.Length > 18)
                                                                    {


                                                                        <td class="cadName">
                                                                            <a onclick="" data-tooltip="@item.candidateName"> @item.candidateName.Substring(0, 18)... </a>
                                                                        </td>
                                                                    }

                                                                    else
                                                                    {
                                                                        <td class="cadName">
                                                                            <a onclick=""> @item.candidateName </a>
                                                                        </td>
                                                                    }

                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }



                                                                <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId= item.irfIntId})'>Report</a> </td>
                                                                @if (item.resumeLink != null && item.resumeLink != "")
                                                                {
                                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }
                                                                @if (item.MobileNumber != null)
                                                                {
                                                                    <td>@item.MobileNumber</td>

                                                                }
                                                                else
                                                                {
                                                                    <td>No Contact</td>
                                                                }

                                                                @if (item.ClientHrContact != null && item.ClientHrContact != "")
                                                                {


                                                                    @if (item.ClientHrContact.Length > 18)
                                                                    {


                                                                        <td class="cadEmail">
                                                                            <a onclick="" data-tooltip="@item.ClientHrContact"> @item.ClientHrContact.Substring(0, 18)... </a>
                                                                        </td>
                                                                    }

                                                                    else
                                                                    {
                                                                        <td class="cadEmail">
                                                                            <a onclick=""> @item.ClientHrContact </a>
                                                                        </td>
                                                                    }





                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }

                                                                @if (item.confirmationStatus != null && item.confirmationStatus != "")
                                                                {
                                                                    <td> @item.confirmationStatus</td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                @if (item.MeetingStatusStatusDesc != null && item.MeetingStatusStatusDesc != "")
                                                                {

                                                                    <td> @item.MeetingStatusStatusDesc </td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }

                                                                @if (item.intervieweStatusStatDesc != null && item.intervieweStatusStatDesc != "")
                                                                {

                                                                    <td> @item.intervieweStatusStatDesc </td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }

                                                            </tr>

                                                            <tr class="collapse @item.imid">
                                                                <td colspan="999" class="child-section">
                                                                    <table class="table table-striped">
                                                                        <tr>
                                                                            <th>Current Employer</th>
                                                                            <th>Expected Salary</th>
                                                                            <th>Expected Joining Time</th>
                                                                            <th>Preferred Location</th>
                                                                            <th>Staffing Agency</th>
                                                                        </tr>
                                                                        <tr>
                                                                            @if (item.currentEmployerName != null && item.currentEmployerName != "")
                                                                            {
                                                                                <td> @item.currentEmployerName </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                            }
                                                                            @if (item.expectedPerHourRate != null && item.expectedPerHourRate != "")
                                                                            {

                                                                                <td> @item.expectedPerHourRate </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                            }
                                                                            @if (item.joiningTime != null && item.joiningTime != "")
                                                                            {
                                                                                <td> @item.joiningTime </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                            }
                                                                            @if (item.preferredLocation != null && item.preferredLocation != "")
                                                                            {
                                                                                <td> @item.preferredLocation </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>

                                                                            }
                                                                            @if (item.staffingAgency != null && item.staffingAgency != "")
                                                                            {

                                                                                <td>@item.staffingAgency</td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                            }
                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>


                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right " id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("ProjectInterviewMeetings", new { Page = Page }))
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>

<script>
    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
            $("#" + id).attr("data-changes", "1");
        }
    }

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }

    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });




    });


    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/Project/ProjectInterviewMeetingsJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }


    function bindtableData(data) {
        var irfid = $("#hidirfid").val();
        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="10" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }
        for (var i = 0; i < data.length; i++) {
            html += '  <tr id="' + data[i].imid + '" data-changes="1">';
            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].imid + '" data-target=".' + data[i].imid + '" class="detail-row" onclick="changeicon(' + data[i].imid + ')">&nbsp;</td>';
            html += '  <td> ' + new Date(data[i].interviewDate).toLocaleString() + ' </td>';
            html += ' <td>' + data[i].irfId + '</td>';


            if (data[i].candidateName != null && data[i].candidateName != "") {

                if (data[i].candidateName.length > 18) {


                    html += '  <td class="cadName"><a onclick="" data-tooltip="' + data[i].candidateName + '' + data[i].candidateName + '"> ' + data[i].candidateName.substring(0, 18) + '... </a>  </td>';


                }

                else {
                    html += '  <td class="cadName">  <a onclick="">' + data[i].candidateName + ' </a></td>';


                }

            }
            else {
                html += '    <td></td>';
            }

            html += '   <td> <a id="reportId" target="_blank" title="Report Link" href="/IRF/AddReport?interviewId=' + data[i].imid + '&irfId=' + irfid + '">Report</a> </td>';


            if (data[i].resumeLink != null && data[i].resumeLink != "") {
                html += '    <td> <a id="resumeId" target="_blank" title="Resume" href="' + data[i].resumeLink + '">Resume</a></td>';
            }
            else {
                html += '  <td>No Resume</td>';
            }
            if (data[i].mobileNumber != null) {
                html += ' <td>' + data[i].mobileNumber + '</td>';

            }
            else {
                html += '    <td>No Contact</td>';
            }



            if (data[i].clientHrContact != null && data[i].clientHrContact != "") {

                if (data[i].clientHrContact.length > 18) {


                    html += '  <td class="cadEmail"><a onclick="" data-tooltip="' + data[i].clientHrContact + '' + data[i].clientHrContact + '"> ' + data[i].clientHrContact.substring(0, 18) + '... </a>  </td>';


                }

                else {
                    html += '  <td class="cadEmail">  <a onclick="">' + data[i].clientHrContact + ' </a></td>';


                }

            }
            else {
                html += '    <td></td>';
            }


            if (data[i].meetingStatusStatusDesc != null && data[i].meetingStatusStatusDesc != "") {

                html += '  <td>' + data[i].meetingStatusStatusDesc + ' </td>';
            }
            else {
                html += '  <td></td>';
            }

            if (data[i].intervieweStatusStatDesc != null && data[i].intervieweStatusStatDesc != "") {

                html += '    <td>' + data[i].intervieweStatusStatDesc + ' </td>';
            }
            else {
                html += '  <td></td>';
            }

            if (data[i].confirmationStatus != null && data[i].confirmationStatus != "") {
                html += '   <td>' + data[i].confirmationStatus + '</td>';
            }
            else {
                html += '   <td></td>';
            }

            html += ' </tr>';


            html += ' <tr class="collapse ' + data[i].imid + '">';
            html += '  <td colspan="999" class="child-section">';
            html += '  <table class="table table-striped">';
            html += '   <tr>';
            html += '   <th>Current Employer</th>';
            html += ' <th>Expected Salary</th>';
            html += '   <th>Expected Joining Time</th>';
            html += '  <th>Preferred Location</th>';
            html += '  <th>Staffing Agency</th>';
            html += '  </tr>';
            html += '  <tr>';
            if (data[i].currentEmployerName != null && data[i].currentEmployerName != "") {
                html += ' <td>' + data[i].currentEmployerName + ' </td>';
            }
            else {
                html += '    <td></td>';
            }
            if (data[i].expectedPerHourRate != null && data[i].expectedPerHourRate != "") {

                html += '   <td> ' + data[i].expectedPerHourRate + ' </td>';
            }
            else {
                html += '    <td></td>';
            }
            if (data[i].joiningTime != null && data[i].joiningTime != "") {
                html += '  <td> ' + data[i].joiningTime + ' </td>';
            }
            else {
                html += '  <td></td>';
            }
            if (data[i].preferredLocation != null && data[i].preferredLocation != "") {
                html += '  <td> ' + data[i].preferredLocation + ' </td>';
            }
            else {
                html += '    <td></td>';

            }
            if (data[i].staffingAgency != null && data[i].staffingAgency != "") {


                html += '   <td>' + data[i].staffingAgency + '</td>';

            }
            else {
                html += '  <td></td>';
            }


            html += ' </tr>';
            html += '</table>';
            html += '</td>';
            html += ' </tr>';
          


            
}

$("#tblbodyProjectInterviewMeeting").empty().html(html);
}


function bindPages(pagecount, startpage, endpage, totalcount) {
var html = '';
html += '<div class="pagination-container">';
html += '<ul class="pagination">';
for (var i = 1; i <= pagecount; i++) {
if (i == 1) {
    html += '   <li class="active"><span>1</span></li>';
} else if (i <= 10) {
    html += '<li><a href="/Project/ProjectInterviewMeetings?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
} else if (i == 11) {
    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
    html += '<li class="PagedList-skipToNext"><a href="/Project/ProjectInterviewMeetings?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
    html += '<li class="PagedList-skipToLast"><a href="/Project/ProjectInterviewMeetings?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
} else {
    break;
}
if (pagecount <= 10 && i == pagecount && i != 1) {
    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
    html += '<li class="PagedList-skipToNext"><a href="/Project/ProjectInterviewMeetings?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
    html += '<li class="PagedList-skipToLast"><a href="/Project/ProjectInterviewMeetings?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
}
}
html += '</ul>';
html += '</div>';
$("#divmeetingpages").empty().html(html);
var pagestartdetails = '';
pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
$("#divmeetingentries").empty().html(pagestartdetails);

}
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<loading></loading>

