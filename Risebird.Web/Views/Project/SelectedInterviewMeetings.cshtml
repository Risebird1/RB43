@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "Project Selected Candidate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/Project/Index">Projects</a>
                <a class="navbar-brand">
                  /  &nbsp; Interview Selected Meetings
                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content selectedinterview">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                  
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="row">
                               <div class="card-header">
                                        <div class="pull-left">
                                            <h4 class="card-title">
                                                Selected Candidate list for <b>@ViewBag.ProjectName</b></h4>
                                        </div>

                                        <div class="pull-right">
                                            @Html.ActionLink("Back", "Index", "Project", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        </div>
                                    </div>

                                  
                                </div>

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>IRF</th>
                                                <th>Candidate Name</th>
                                                <th>Report Link</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Client HR</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Salary</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                                <th>Approval Status</th>
                                                <th>Approval Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Final Selection Status</th>
                                                <th>Final Selection Comments</th>
                                                <th class="no-sort"></th>
                                                @if (ViewBag.ProfileName == "client")
                                                {
                                                    <th>Action</th>

                                                }
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>IRF</th>
                                                <th>Candidate Name</th>
                                                <th>Report Link</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Client HR</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Salary</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                                <th>Approval Status</th>
                                                <th>Approval Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Final Selection Status</th>
                                                <th>Final Selection Comments</th>
                                                <th class="no-sort"></th>
                                                @if (ViewBag.ProfileName == "client")
                                                {
                                                    <th>Action</th>
                                                }
                                            </tr>
                                        </tfoot>
                                        <tbody>


                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                <tr id=@item.imid>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.IRFId </td>
                                                    <td> @item.candidateName </td>
                                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId=item.irfIntId, IsSelected = true})'>Report</a> </td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }

                                                    @if (item.MobileNumber != null)
                                                    {
                                                        <td>@item.MobileNumber</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No Contact</td>
                                                    }
                                                    <td> @item.ClientHrContact </td>
                                                    <td> @item.confirmationStatus</td>
                                                    <td> @item.MeetingStatusStatusDesc </td>
                                                    <td> @item.intervieweStatusStatDesc </td>
                                                    <td> @item.currentEmployerName </td>
                                                    <td> @item.expectedPerHourRate </td>
                                                    <td> @item.joiningTime </td>
                                                    <td> @item.preferredLocation </td>
                                                    <td>@item.staffingAgency</td>
                                                    <td>
                                                        @item.NextLevelApprovalStat
                                                    </td>
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in cmt-w">
                                                            <div class="talktext">
                                                                <textarea class="scrollbar" style="height: 40px; width:100%;">@item.ApprovalComments</textarea>
                                                                </div></div>
                                                    </td>
                                                    <td></td>

                                                    <td>
                                                        @item.FinalSelectionStat
                                                    </td>
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in cmt-w">
                                                            <div class="talktext">
                                                                <textarea class="scrollbar" style="height: 40px; width:100%;">@item.FinalComments</textarea>
                                                                </div></div>
                                                    </td>
                                                    <td></td>
                                                    @if (ViewBag.ProfileName == "client")
                                                    {
                                                        <td class="text-right">
                                                            <span title="Client Feedback" onclick="ModalButtonClick(@jsonObject)" id="@("myBtn_"+item.imid)" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-thumbs-up"></i></span>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">

                <div class="modal-content">
                   

                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg>

                            </span>
                        </div>
                        <h5 class="modal-title pull-left">Client Feedback </h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span  aria-hidden="true" id="feedbackPopUp" style="cursor:pointer;">&times;</span>
                    </button>


                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div class="form-group">
                                    <label for="approveDropdown"><b>Approved For Next Round</b></label>
                                    <select class="form-control" id="approveDropdown" name="approveDropdown"></select>
                                </div>

                            </div>

                            <div class="col-md-6 col-sm-6 pr-1">
                                <div id="approvalComments" class="form-group">
                                    <label>Approval Comments</label>
                                    <textarea name="appComments" class="form-control text-box single-line" id="appComments" style="margin-left:6px;border: 1px solid black;height:46px"></textarea><br>

                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div class="form-group">
                                    <label for="selectionDropdown"><b>Final Selection</b></label>
                                    <select class="form-control" id="selectionDropdown" name="selectionDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div id="selectionComments" class="form-group">
                                    <label>Final Comments</label>

                                    <textarea name="selecComments" class="form-control text-box single-line" id="selecComments" style="margin-left:6px;border: 1px solid black;height:46px"></textarea><br>

                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div class="form-group">

                                    <label for="offerDropdown"><b>Offer Status</b></label>
                                    <select class="form-control" id="offerDropdown" name="offerDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div id="offerComments" class="form-group">
                                    <label>Offer Comments</label>
                                    <textarea name="offComments" class="form-control text-box single-line" id="offComments" style="margin-left:6px;border: 1px solid black;height:46px"></textarea><br>

                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div class="form-group">

                                    <label for="joiningDropdown"><b>Joining Status</b></label>
                                    <select class="form-control" id="joiningDropdown" name="joiningDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div id="joiningComments" class="form-group">
                                    <label>Joining Comments</label>
                                    <textarea name="joinComments" class="form-control text-box single-line" id="joinComments" style="margin-left:6px;border: 1px solid black;height:46px"></textarea><br>

                                </div>
                            </div>
                        </div>

                        <div class="">
                            <input type="button" onclick="SavePopUp()" class="btn btn-fill btn-primary" id="btnUpload" value="Save">
                        </div>
                    </div>
                   
                </div>

            </div>
        </div>


            <!-- end row -->
        </div>

</div>


<script>
    $(document).ready(function () {
        //FilterInterviews("All");// on page load default dropdownlist value set
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meeting').DataTable();
    });
</script>

<script>
    var imid = "";
    var span = document.getElementById("feedbackPopUp");
    var comm = '';
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    // When the user clicks anywhere outside of the modal, close it
    //window.onclick = function (event) {
    //    var modal = document.getElementById("myModal");
    //    if (event.target == modal) {
    //        modal.style.display = "none";
    //    }
    //}
</script>
<script>
    function ModalButtonClick(item) {
        imid = item.imid;

        // Get the modal
        var modal = document.getElementById("myModal");

        // When the user clicks the button, open the modal
        modal.style.display = "block";

        //document.getElementById("IsApproved").checked = item.IsApproved;
        document.getElementById("appComments").value = item.ApprovalComments;

        document.getElementById("selecComments").value = item.FinalComments;

        document.getElementById("joinComments").value = item.JoiningComments;

        document.getElementById("offComments").value = item.OfferComments;


        $.ajax({
            type: "GET",
            url: "/Interview/getApprovalStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#approveDropdown").html(s);
                if (item.IsApproved != null) {
                    $("#approveDropdown").val(item.IsApproved);
                }
                else {
                    $("#approveDropdown").val("-1");

                }
            }
        });

        $.ajax({
            type: "GET",
            url: "/Interview/getSelectionStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#selectionDropdown").html(s);
                if (item.IsSelected != null) {
                    $("#selectionDropdown").val(item.IsSelected);
                }
                else {
                    $("#selectionDropdown").val("-1");
                }


            }
        });

        $.ajax({
            type: "GET",
            url: "/Interview/getOfferStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#offerDropdown").html(s);
                if (item.OfferStatus != null) {
                    $("#offerDropdown").val(item.OfferStatus);
                }
                else {
                    $("#offerDropdown").val("-1");
                }

            }
        });

        $.ajax({
            type: "GET",
            url: "/Interview/getJoiningStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#joiningDropdown").html(s);
                if (item.JoiningStatus != null) {
                    $("#joiningDropdown").val(item.JoiningStatus);
                }
                else {
                    $("#joiningDropdown").val("-1");
                }

            }
        });

    }

    function ApprovalChanged() {
        var commentId = 'approvalComments';
        document.getElementById("appComments").value = comm;

        var isChecked = document.getElementById("IsApproved").checked;

        if (isChecked == false) {

            document.getElementById(commentId).style.display = "block";
        }
        else {
            document.getElementById(commentId).style.display = "none";
        }
    }

    function SavePopUp() {

        var approvalComment = document.getElementById("appComments").value;
        var isApproved = document.getElementById("approveDropdown").value;

        var selectionComment = document.getElementById("selecComments").value;
        var isSelected = document.getElementById("selectionDropdown").value;

        var joiningComment = document.getElementById("joinComments").value;
        var joiningStatus = document.getElementById("joiningDropdown").value;

        var offerComment = document.getElementById("offComments").value;
        var offerStatus = document.getElementById("offerDropdown").value;
        var id = imid;

        $.ajax({
            type: "GET",
            url: "/Interview/SaveClientFeedback",
            data: { 'imid': id, 'isApproved': isApproved, 'approvalComment': approvalComment, 'isSelected': isSelected, 'selectionComment': selectionComment, 'joiningStatus': joiningStatus, 'joiningComment': joiningComment, 'offerStatus': offerStatus, 'offerComment': offerComment },
            success: function (data) {

                location.reload(true);

            }
        });
    }

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function FilterInterviews(filterValue) {
        var id = '@ViewBag.IRFintId';
        var irfId ='@ViewBag.IRF'
        $.ajax({
            type: "GET",
            url: "/IRF/GetFilteredSelectedMeetings",
            data: { 'filterValue': filterValue, 'id': id, 'irfId': irfId},
            success: function (data) {
                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>


