                                </div>
                                @* <div class="col-md-4 col-sm-4 px-1">
                            <div class="form-group">
                            <div class="mandate">
                            @Html.LabelFor(model => model.ProjectOwnerId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                            </div>

                            @Html.EditorFor(model => model.ProjectOwnerId, new { htmlAttributes = new { @class = "form-control text-box single-line"} })
                            @Html.ValidationMessageFor(model => model.ProjectOwnerId, "", new { @class = "text-danger" })

                            </div>
                            </div> *@
                                <div class="col-md-4 col-sm-4 pl-1">
