                                            @Html.LabelFor(model => model.ClientId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                        </div>

                                        @Html.DropDownList("ClientId", Model.ClientList, new { @class = "form-control select-css", @onchange = "ClientChanged()" })
                                        @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pl-1">
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.SkillSetsevaluate, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                        </div>
                                        @{
                                            var skillsetsevaluated = new List<SelectListItem>();
                                            skillsetsevaluated.Add(new SelectListItem() { Value = "1", Text = "1" });
                                            skillsetsevaluated.Add(new SelectListItem() { Value = "2", Text = "2" });
                                        }
                                        @Html.DropDownListFor(model => model.SkillSetsevaluate, skillsetsevaluated, new { @class = "form-control select-css", @onchange = "ClientChanged()" })
                                        @Html.ValidationMessageFor(model => model.SkillSetsevaluate, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                            </div>
                            <div class="row mt-15">
                                @*  <div class="col-md-4 col-sm-4 pr-1">
                            <div class="form-group">
                            <div class="mandate">
                            @Html.LabelFor(model => model.EndClient, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                            </div>

                            @Html.EditorFor(model => model.EndClient, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                            @Html.ValidationMessageFor(model => model.EndClient, "", new { @class = "text-danger" })

                            </div>
                            </div>
                            <div class="col-md-4 col-sm-4 px-1">
                            <div class="form-group">
                            <div class="mandate">
                            @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                            </div>

                            @Html.EditorFor(model => model.Location, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                            @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })

                            </div>
                            </div> *@
                            </div>


                            <div style="width:100%">&nbsp;</div>
                            <div id="tableID">
                                
                            </div>


                            <div class="card-footer ">

                                <div class="row">
                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back", "Index", "Project", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>

                        }



                    </div>




                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

<script>
    function saveBtn() {
        $("#btnUpload").attr("disabled", "disabled");
    }
</script>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Project/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        window.location.href = '/Project/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}

<script>
    $(document).ready(function () {
        ClientChanged();
    });
    function ClientChanged() {
        var clientId = $("#ClientId").val();
        var SkillSetsevaluate = $("#SkillSetsevaluate").val();
        $.ajax({
            type: "GET",
            url: "/Project/GetFilteredIRF",
            data: { 'clientId': clientId, 'SkillSetsevaluate': SkillSetsevaluate },
            success: function (data) {
                if (data == null || data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No data for this Client.');
                    $('#tableID').css("text-align", "center");
                    return;
                }
                $('#tableID').html('');
                $('#tableID').html(data);
                $('#tableID').css("margin-left", "");
            }
        });

    }

</script>
