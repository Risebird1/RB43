@if (Model.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@Model.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@Model.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function () //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/Project/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@Model.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        //window.location.href = '/Project/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}



<script type="text/javascript">
    function DeleteProject(dataID) {

        var IdProject = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: "It will be Archived!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, archive it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    var Id = dataID;
                    $.ajax({
                        url: '/Project/DeleteProject?id=' + Id,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error archiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Archived!',
                    type: 'success',
                    html: '<p>The project has been Archived.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Project/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your file has not been archived :)',
                    'error'
                )
            }
        })
    }


    function AddComments(id) {

        var url = '/IRF/SampleQuestions?id=' + id;
        window.location.href = url;
    };
    function SelectedInterviewMeetings(id, IRFid) {

        var url = '/IRF/SelectedInterviewMeetings?id=' + id + '&irfId=' + IRFid;
        window.location.href = url;
    };

    function EditProject(id) {

        var url = '/Project/Edit?id=' + id;
        window.location.href = url;
    };
    function stats(id, name) {

        var url = '/Project/Stats?id=' + id + '&name=' + name;
        window.location.href = url;
    };
    function UnArchiveProject(id) {

        var url = '/Project/UnArchiveProject?id=' + id;
        window.location.href = url;
    };
</script>
