    function ResetFilter() {

             $.ajax({
            type: "POST",
            url: "/Project/Index",
                 success: function (data) {
                    window.location.href = "/Project/ResetProjectFilter";
                 }
                });
    }
        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var projectID =  @Html.Raw(Json.Serialize(ProjectID));
            var clientName =  @Html.Raw(Json.Serialize(ClientName));
            var archiveStatus =  @Html.Raw(Json.Serialize(ArchiveStatus));
            var location =  @Html.Raw(Json.Serialize(Location));


            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#ProjectID").val(projectID);
            $("#ClientName").val(clientName);
            $("#ArchiveStatus").val(archiveStatus);
            $("#Location").val(location);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
                 url: "/Project/Index",
            data: form,
                 success: function (data) {
                 }
                });
    }

</script>
