@model Risebird.Entities.ViewModel.ProjectViewModel
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] ProjectID = new string[] { };
    string[] ArchiveStatus = new string[] { };
    string[] ClientName = new string[] { };
    string[] Location = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("Projectfilters") != null)
{
    filter = JsonConvert.DeserializeObject<ProjectFilter>(HttpContextAccessor.HttpContext.Session.GetString("Projectfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    ProjectID = filter.ProjectID != null ? filter.ProjectID : new string[] { };
    ArchiveStatus = filter.ArchiveStatus != null ? filter.ArchiveStatus : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    Location = filter.Location != null ? filter.Location : new string[] { };

}
