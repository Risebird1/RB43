<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Projects
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">

                        <div class="row">
                            @if (Model.IsClientUser == false)
                            {

                                <!--        Here you can write extra buttons/actions for the toolbar              -->


                                <div class="card-header">
                                    <div class="pull-left">
                                        <h4 class="card-title">Projects</h4>
                                    </div>


                                    <div class="pull-right">
                                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" style="margin-top: 2px;" data-toggle="modal" data-target="#filterModal">
                                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                            <div class="mdc-button__ripple"></div>
                                        </button>



                                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add Project" onclick="location.href='@Url.Action("Add", "Project")'" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Add Project</font></span>
                                        </button>
                                    </div>

                                </div>


                            }

                        </div>



                        <div class="row">
                            @if (Model.ProjectList != null && Model.ProjectList.Count() != 0)
                            {
                                @foreach (var item in Model.ProjectList)
                                {
                                    <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                        <div class="card-content-holder border card-blue">

                                            <div class="card-header">
                                                <div class="row">
                                                    <div >

                                                        <h6> @item.Name</h6>

                                                    </div>

                                                </div>
                                            </div>
                                            <div class="card-body ">

                                                <div class="statistics statistics-horizontal">
                                                    <div class="info info-horizontal">
                                                        <div class="row">
                                                            <div class="col-md-12">
                                                                <div class="group inner list-group-item-text">

                                                                    <span>Total IRFs:</span> <p>@item.TotalIRF</p>
                                                                    <span>Client:</span> <p> @item.Client </p>
                                                                    <span>End Client:</span> <p> @item.EndClient</p>
                                                                    <span>Location:</span> <p> @item.Location</p>

                                                                </div>
                                                            </div>

                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer ">
                                                <div class="stats text-center">
                                                    @if (!@item.IsClientUser)
                                                    {



                                                        <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                            <span onclick="javascript:EditProject('@item.id');" title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                        </button>




                                                    }



                                                    <button class="mdc-fab app-fab--absolute item2" aria-label="Meetings">
                                                        <span onclick="location.href='@Url.Action("ProjectInterviewMeetings", "Project", new {id = item.id})'" title="Meetings" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z" /></svg></span>
                                                    </button>




                                                    <button class="mdc-fab app-fab--absolute item3" aria-label="Selected Meetings">
                                                        <span onclick="location.href='@Url.Action("SelectedInterviewMeetings", "Project", new {id = item.id})'" title="Selected Meetings" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg></span>
                                                    </button>

                                                    <button class="mdc-fab app-fab--absolute item5" aria-label="Stats">
                                                        <span onclick="javascript:stats('@item.id','@item.Name');" title="Stats" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" /></svg></span>
                                                    </button>




                                                    @if (!@item.IsClientUser)
                                                    {
                                                        if (!item.IsDeleted)
                                                        {

                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Archive">
                                                                <span  onclick="javascript:DeleteProject('@item.id');" title="Archive" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" /></svg></span>
                                                            </button>


                                                        }
                                                        else
                                                        {

                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="UnArchive">
                                                                <span onclick="javascript:UnArchiveProject('@item.id');" title="UnArchive" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20.55 5.22l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.15.55L3.46 5.22C3.17 5.57 3 6.01 3 6.5V19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.49-.17-.93-.45-1.28zM12 9.5l5.5 5.5H14v2h-4v-2H6.5L12 9.5zM5.12 5l.82-1h12l.93 1H5.12z" /></svg></span>
                                                            </button>


                                                        }

                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                        </div>


                        <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg" role="document">
                                <div class="modal-content">
                                    <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                        <h5 class="modal-title" id="filterModalLabel"> Filter</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <form action="@Url.Action("Index","Project")" method="post" id="form">

                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                            Start Date
                                                        </label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                            End Date
                                                        </label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="ProjectID">ProjectID</label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <select id="ProjectID" name="ProjectID" class="form-control multiselect" multiple="multiple">
                                                                @foreach (var item in Model.ProjectList.Select(x => x.Name).Distinct().ToList())
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
