@model Risebird.Entities.ViewModel.Project
@{
    ViewData["Title"] = "Edit Project";
    ViewBag.PageHeader = "Edit Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">
  
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bg-white">
            <div class="col-md-12">
                <div class="mdc-card card bg-white">


                    <div class="mdc-card-wrapper__text-section">

                        @using (Html.BeginForm("Edit", "Project", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid" }))
                        {


                            <div class="row">

                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Interview Comments</h4></div>
                                </div>

                                <div style="width: 100%;">&nbsp;</div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span></div>

                                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                <div class="col-md-4 col-sm-4 px-1">
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.ProjectOwnerId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                        </div>

                                        @Html.EditorFor(model => model.ProjectOwnerId, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                        @Html.ValidationMessageFor(model => model.ProjectOwnerId, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pl-1">
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.ClientId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span></div>

                                            @Html.DropDownList("ClientId", Model.ClientList, new { @class = "form-control select-css", @onchange = "ClientChanged(this.value)" })
                                            @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })

                                        </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.EndClient, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                        </div>


                                        @Html.EditorFor(model => model.EndClient, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                        @Html.ValidationMessageFor(model => model.EndClient, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span></div>

                                            @Html.EditorFor(model => model.Location, new { htmlAttributes = new { @class = "form-control text-box single-line"@*, @onblur = "checkUniqueness(this.value)"*@ } })
                                            @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })

                                        </div>
                                </div>
                            </div>


                            <div id="tableID">
                                <div class="table-responsive-sm">
                                    <table cellpadding="0" cellspacing="0" class="table table-bordered mbn" id="IRFList">
                                        <thead>
                                            <tr>
                                                <th class="text-center" style="font-size:15px!important;">IRF Name</th>
                                                <th class="text-center" style="font-size:15px!important;">Primary Skills</th>
                                                <th class="text-center" style="font-size:15px!important;">Client</th>
                                                <th class="text-center" style="font-size:15px!important;">Add</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.ProjectIRFMappings.Count(); i++)
                                            {
                                                <tr>

                                                    <td class="text-center"> <a style="color:#007bff;" id="@("irflink_"+i)" target="_blank" title="IRF" href='@Url.Action("EditIRF", "IRF", new { id = Model.ProjectIRFMappings[i].IRFId })'> @Model.ProjectIRFMappings[i].IRFName</a> </td>
                                                    <td class="text-center" width="30%">@Model.ProjectIRFMappings[i].PrimarySkills</td>
                                                    <td class="text-center" width="20%">@Model.ProjectIRFMappings[i].Client</td>
                                                    <td class="text-center" width="20%">


                                                        <div class="mdc-form-field" style="margin-bottom: 10px;">
                                                            <div class="mdc-checkbox">
                                                                @Html.CheckBoxFor(m => m.ProjectIRFMappings[i].IsAdded, new { @class = "mdc-checkbox__native-control" @*, @style = "margin-left:25%"*@})


                                                                <div class="mdc-checkbox__background">
                                                                    <svg class="mdc-checkbox__checkmark"
                                                                         viewBox="0 0 24 24">
                                                                        <path class="mdc-checkbox__checkmark-path"
                                                                              fill="none"
                                                                              d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                                    </svg>
                                                                    <div class="mdc-checkbox__mixedmark"></div>
                                                                </div>
                                                                <div class="mdc-checkbox__ripple"></div>


                                                            </div>
                                                        </div>



                                                    </td>
                                                    @Html.HiddenFor(m => m.ProjectIRFMappings[i].IRFId)
                                                    @Html.HiddenFor(m => m.ProjectIRFMappings[i].ClientId)

                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @Html.HiddenFor(m => m.id)
                            <div class="card-footer ">
                                <div class="row">
                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "Index", "Project", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Save</button>
                                    </div>
                                </div>

                            </div>



                        }



                    </div>


                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>




@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Project/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/Project/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}

<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
    function ClientChanged(clientId) {
        var projectId = '@Model.id';
        $.ajax({
            type: "GET",
            url: "/Project/GetEditFilteredIRF",
            data: { 'clientId': clientId, 'projectId': projectId },
            success: function (data) {
                if (data == null || data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No data for this Client.');
                    $('#tableID').css("text-align", "center");
                    return;
                }
                $('#tableID').html('');
                $('#tableID').html(data);
                $('#tableID').css("margin-left", "");



            }
        });

    }

</script>

