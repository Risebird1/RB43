@model Risebird.Entities.ViewModel.QCInterviewerVM
@{
    ViewData["Title"] = "QCInterviewerAdd";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">

                <a class="navbar-brand breadcrumscolor" href="/User/QCInterviewers">QCInterviewers</a>
                <a class="navbar-brand">Add</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    @using (Html.BeginForm("AddQCInterviewer", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {

        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-12 edit-build nova-cont">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Add Quality Controller</h4>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PrimarySkills, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6">
                                            @Html.DropDownListFor(m => m.SelectedSkillIds, new SelectList(Model.PrimarySkills, "Value", "Text", Model.SelectedSkillIds), new { @class = "form-control", @multiple = "multiple" })
                                            @Html.ValidationMessageFor(model => model.SelectedSkillIds, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Slots, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.Slots, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                            @Html.ValidationMessageFor(model => model.Slots, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.SuccessRate, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.SuccessRate, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NoOfInterview, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.NoOfInterview, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        Upload Resume
                                        <input id="Resume" name="Resume" value="Upload" type="radio" checked="checked"  onclick="RadioChanged(this.value)">
                                        Add a link
                                        <input id="Resume" name="Resume" value="Link" type="radio" onclick="RadioChanged(this.value)">
                                    </div>

                                    <div style="display:none" id="linkDiv">
                                        @Html.LabelFor(model => model.ResumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.ResumeLink, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ResumeLink, "", new { @class = "text-danger" })
                                    </div>

                                    <div id= "uploadDiv">
                                        @Html.LabelFor(model => model.File, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6">
                                            @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-sm-12">

                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col-sm-12">
                                <div class="pull-right">
                                    <input type="submit" id="btnUpload" value="Save QCInterviewer" class="btn btn btn-primary" />
                                </div>
                                <div>
                                    @Html.ActionLink("Back", "QCInterviewers", "User", new { @class = "btn btn-fill btn-label", @role = "button" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    
</div>

<script type="text/javascript">
    var j = jQuery.noConflict();
    j(document).ready(function () {
        j('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });
</script>
<script>
    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("ResumeLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("File").value = '';

        }

    }
</script>


