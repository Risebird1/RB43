@model IEnumerable<Risebird.Entities.ViewModel.CandidateTimelineVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Candidate Timeline";
    ViewBag.PageHeader = "Candidate Timeline";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;

    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };



}

@if (HttpContextAccessor.HttpContext.Session.GetString("CandidateTimeLineFilter") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("CandidateTimeLineFilter"));
      ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
 }

<link href="~/Newassets/css/interviewer.css?v=2024" rel="stylesheet" type="text/css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
   

    <div class="pt30 videocon">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left risetubeheader">
                    <h4 class="card-title"></h4>

                    <div class="mobile-view"> <h4 class="card-title risetubeid">Journey</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <div class="newsletter">

                            <div class="content">
                                <div class="input-group card-title-space" id="myForm">
                                    <div class="searchbox">
                                        <input type="email" id="txtsearch" value="@ViewBag.searchvalue" class="form-control txtsearch1" placeholder="Please enter Skills (or) Name of Candidate" AutoCompleteType="Disabled">
                                        <span class="input-group-btn">
                                            <button class="btn btn3" id="btnSearch" type="submit"><svg style="fill: #fff;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" /></svg></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded btn4 card-title-space" data-toggle="modal" data-target="#filterModal">

                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>




                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content video client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("CandidateTimeline","User")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">

                                                    <div class="col-md-6 col-sm-6 border-rv">


                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                Client
                                                                HR
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.HREmail).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>



                                                    </div>
                                                    <div class="col-md-6 col-sm-6">


                                                        <div class="form-group">
                                                            <label class="control-label  col-md-12 col-sm-12 desp-label" for="ConfirmationStatus">
                                                                Confirmation Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.CurrentStatus).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>





                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">


                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>


                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>


                                                                </div>

                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <table class="table table-striped" cellspacing="0" width="100%" style="border:0px!important">

                                <thead>
                                    <tr>

                                        <td style="border-top:0px;">
                                            <table class="journey" cellspacing="0" width="100%">
                                                <tr>

                                                    <th class="text-left">Candidate Name</th>
                                                    <th class="text-left">HR Email</th>
                                                    <th>Schedule Status</th>

                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>

                                                    <th>Current Status</th>
                                                    <th>Report</th>


                                                </tr>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td class="text-left pl15">
                                                            <p>@item.CandidateName</p>

                                                        </td>
                                                        <td class="text-left" style="width:20%">@item.HREmail</td>
                                                        <td style="padding:10px 0px;">
                                                            <div class="timeline-section-tl">
                                                                

                                                                @foreach (var status in item.RisebirdAttempt)
                                                                {<div class="tl-round round1" style="background-color: #35353599;"></div><div class="circle-wrap">

    <div class="circle" id="circle0" style="left: 0%;">
        <div class="popupSpan">

            <div class="event2Bubble">
                <div class="eventTime">
                    <div class="DayDigit">@status.Date</div>
                    <div class="Day">
                        @status.Day
                        <div class="MonthYear">@status.StatusDate</div>
                    </div>
                </div>
                <div class="eventTitle">@status.Status</div>
            </div>
        </div>
    </div>
</div>
                                                                        }
                                                                   
                                                                </div>
                                                        </td>

                                                        <td style="padding:10px 0px;">
                                                            <div class="timeline-section-tl">
                                                                <div class="tl-round round1" style="background-color: #35353599;"></div>
                                                                <div class="circle-wrap">
                                                                    @foreach (var status in item.MeetingStatus)
                                                                    {
                                                                        @if (status.Status == "Schedule")
                                                                        {
                                                                            <div class="circle schedule" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="popupSpan">
                                                                                        <div class="event2Bubble">
                                                                                            <div class="eventTime">
                                                                                                <div class="DayDigit">@status.Date</div>
                                                                                                <div class="Day">
                                                                                                    @status.Day
                                                                                                    <div class="MonthYear">@status.StatusDate</div>
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="eventTitle">@status.Status</div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        else if (status.Status == "Completed")
                                                                        {
                                                                            <div class="circle completed" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="popupSpan">
                                                                                        <div class="event2Bubble">
                                                                                            <div class="eventTime">
                                                                                                <div class="DayDigit">@status.Date</div>
                                                                                                <div class="Day">
                                                                                                    @status.Day
                                                                                                    <div class="MonthYear">@status.StatusDate</div>
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="eventTitle">@status.Status</div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                        else
                                                                        {
                                                                            <div class="circle pending" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="popupSpan">
                                                                                        <div class="event2Bubble">
                                                                                            <div class="eventTime">
                                                                                                <div class="DayDigit">@status.Date</div>
                                                                                                <div class="Day">
                                                                                                    @status.Day
                                                                                                    <div class="MonthYear">@status.StatusDate</div>
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="eventTitle">@status.Status</div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>}

                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td style="padding:10px 0px;">
                                                            <div class="timeline-section-tl">
                                                                <div class="tl-round round1" style="background-color: #35353599;"></div>
                                                                <div class="circle-wrap">
                                                                    @foreach (var status in item.InterviewStatus)
                                                                    {
                                                                        @if (status.Status == "BorderLine")
                                                                        {

                                                                            <div class="circle borderline" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">

                                                                                    <div class="event2Bubble">
                                                                                        <div class="eventTime">
                                                                                            <div class="DayDigit">@status.Date</div>
                                                                                            <div class="Day">
                                                                                                @status.Day
                                                                                                <div class="MonthYear">@status.StatusDate</div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="eventTitle">@status.Status</div>
                                                                                    </div>

                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        else if (status.Status == "Selected")
                                                                        {
                                                                            <div class="circle selected" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="event2Bubble">
                                                                                        <div class="eventTime">
                                                                                            <div class="DayDigit">@status.Date</div>
                                                                                            <div class="Day">
                                                                                                @status.Day
                                                                                                <div class="MonthYear">@status.StatusDate</div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="eventTitle">@status.Status</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        else if (status.Status == "NoShow")
                                                                        {
                                                                            <div class="circle noshow" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="event2Bubble">
                                                                                        <div class="eventTime">
                                                                                            <div class="DayDigit">@status.Date</div>
                                                                                            <div class="Day">
                                                                                                @status.Day
                                                                                                <div class="MonthYear">@status.StatusDate</div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="eventTitle">@status.Status</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                        else if (status.Status == "Dropped")
                                                                        {
                                                                            <div class="circle dropped" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="event2Bubble">
                                                                                        <div class="eventTime">
                                                                                            <div class="DayDigit">@status.Date</div>
                                                                                            <div class="Day">
                                                                                                @status.Day
                                                                                                <div class="MonthYear">@status.StatusDate</div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="eventTitle">@status.Status</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }



                                                                        else
                                                                        {
                                                                            <div class="circle rejected" id="circle0" style="left: 0%;">
                                                                                <div class="popupSpan">
                                                                                    <div class="event2Bubble">
                                                                                        <div class="eventTime">
                                                                                            <div class="DayDigit">@status.Date</div>
                                                                                            <div class="Day">
                                                                                                @status.Day
                                                                                                <div class="MonthYear">@status.StatusDate</div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="eventTitle">@status.Status</div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>}



                                                                    }
                                                                </div>
</div>
                                                            <div class="timeline-section-tl" style="background:none; border:none">
                                                                <div class="tl-round round1" style="background-color:#35353599;"></div>
                                                            </div>

                                                        </td>

                                                        <td>
                                                            @if (item.CurrentStatus == "Selected")
                                                            {

                                                                <p class="select"><strong>@item.CurrentStatus</strong></p>

                                                            }

                                                            else
                                                            { <p class="reject"><strong>@item.CurrentStatus</strong></p>}
                                                        </td>
                                                        <td>
                                                            @if (item.Report == "Available")
                                                            {

                                                                <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                    <span onclick="location.href = '" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z"></path></svg></span>
                                                                </button>}

                                                            else
                                                            {
                                                                <p>Not Available</p>

                                                            }

                                                        </td>





                                                    </tr>

                                                }






                                            </table>

                                        </td>

                                    </tr>

                                </thead>

                            </table>
                        </div>




                    </div>
                </div>

            </div>
        </div>


    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

        $("#ClientHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ConfirmationStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

    })


             function ResetFilter() {
             window.location.href = "/User/ResetInterviewFilter";
       
    }
        function ApplySessionFilter() {
                var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
            var confirmationStatus =  @Html.Raw(Json.Serialize(ConfirmationStatus));
            
            $("#ClientHR").val(clientHR);
            $("#ConfirmationStatus").val(confirmationStatus);
        var form = $("#form").serialize();
           
    }


</script>