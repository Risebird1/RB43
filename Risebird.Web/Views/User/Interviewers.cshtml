@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    i.hover {
        cursor: pointer;
    }
</style>
<style type="text/css">
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        background-color: black;
        z-index: 99;
        opacity: 0.8;
        filter: alpha(opacity=80);
        -moz-opacity: 0.8;
        min-height: 100%;
        width: 100%;
    }

    th, td {
        white-space: nowrap;
    }

    div.dataTables_wrapper {
        width: 800px;
        margin: 0 auto;
    }

    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
        height: 100px;*/
        display: none;
        position: fixed;
        background-color: White;
        z-index: 999;
        opacity: 0.5;
        filter: alpha(opacity = 50);
    }
</style>

<!-- START BREADCRUMB -->
<ul class="breadcrumb">
    <li class="active"><strong>Interviewers</strong></li>
</ul>
<!-- END BREADCRUMB -->
<!-- PAGE TITLE -->
<div class="page-title">
    <h4><span class="fa fa-users"></span> Interviewers</h4>
</div>
<!-- END PAGE TITLE -->
<!-- PAGE CONTENT WRAPPER -->
<div class="page-content-wrap">

    <div class="row">
        <div class="loader" align="center">
            <img src="~/img/owl/AjaxLoader.gif" style="width: 160px; height:80px; " />
        </div>
        <div class="col-md-12 dataloading">
            <!-- START DEFAULT DATATABLE -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <ul class="panel-controls">
                        <li>
                            <button class="btn btn-default" onclick="window.location.href = '@Url.Action("AddInterviewer","User")'"><span class="fa fa-plus-circle"> Add Interviewer</span></button>
                        </li>
                    </ul>
                </div>
                <div class="panel-body">
                    <table class="table datatable" id="idrisebirduser">
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email Id</th>
                                <th>Mobile Number</th>
                                <th>Primary Skills</th>
                                <th>Resume Link</th>
                                <th>Approved</th>
                                <th>No Of Interview</th>
                                <th>SuccessRate</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr id=@item.id>

                                    <td>@item.FirstName</td>
                                    <td>@item.LastName</td>
                                    <td>@item.EmailId</td>
                                    <td>@item.MobileNumber</td>
                                    <td><textarea cols="55" >@item.PrimarySkill</textarea></td>
                                    <td><a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a></td>
                                    @if (@item.IsApproved == true)
                                    {
                                        <td>Approved</td>
                                    }
                                    else
                                    {
                                        <td>Not Approved</td>
                                    }

                                    <td>@item.NoOfInterview</td>
                                    <td>@item.SuccessRate</td>
                                    <td>
                                        <i type="submit" onclick="location.href='@Url.Action("EditInterviewer", "User", new { id = item.id})'" class="fa fa-pencil-square-o" style="color:green;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Edit" data-original-title="Tooltip on bottom"></i>
                                        <i class="fa fa-trash-o hover" style="color:red;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Delete" data-original-title="Tooltip on bottom" onclick="javascript:DeleteEntityfromEnvironment('@item.id');"></i>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END DEFAULT DATATABLE -->
        </div>
    </div>
</div>
<!-- PAGE CONTENT WRAPPER -->
<loading></loading>
@if (ViewBag.Message != null && ViewBag.Message.Contains("Successfully"))
{
    <script type="text/javascript">
        window.onload = function ()
        {
                                sweetAlert({
                                    title: "Risebird Interviewers",
                                    text:'@ViewBag.Message',
                                    type: "success"
                                });
         };
    </script>
}
@if (ViewBag.Message != null && (ViewBag.Message.Contains("Failed")))
{
    <script type="text/javascript">
            window.onload = function ()
            {
                    sweetAlert({
                        title: "Risebird Interviewers",
                    text: '@ViewBag.Message',
                   type: "error"
                   });
           };
    </script>
}
<script type="text/javascript">
    $(document).ready(function () {
        $('#idenvironment').DataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [-1] /*sort false 1st one, start by the right */
            }],
            "order": []   /* Disable initial sort */
        });
    });

    function DeleteEntityfromEnvironment(clientUserId) {

        var confirmMessageBox = confirm('Are you sure you wish to delete this record ?');
        if (confirmMessageBox) {
            if (clientUserId != '') {
                $.ajax({
                    url: '/User/DeleteInterviewer',
                    data: { 'id': clientUserId },
                    type: 'get',
                    success: function (data) {
                        window.location = data.url;
                    }
                });
            }
        }
    }
</script>
