}
function bindPages(pagecount, startpage, endpage, totalcount) {
var html = '';
html += '<div class="pagination-container">';
html += '<ul class="pagination">';
for (var i = 1; i <= pagecount; i++) {
    if (i == 1) {
        html += '   <li class="active"><span>1</span></li>';
    } else if (i <= 10) {
        html += '<li><a href="/User/Interviewers?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
    } else if (i == 11) {
        html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
        html += '<li class="PagedList-skipToNext"><a href="/User/Interviewers?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
        html += '<li class="PagedList-skipToLast"><a href="/User/Interviewers?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
    } else {
        break;
    }
    if (pagecount <= 10 && i == pagecount && i != 1) {
        html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
        html += '<li class="PagedList-skipToNext"><a href="/User/Interviewers?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
        html += '<li class="PagedList-skipToLast"><a href="/User/Interviewers?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
    }
}
html += '</ul>';
html += '</div>';
$("#divmeetingpages").empty().html(html);
var pagestartdetails = '';
pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
$("#divmeetingentries").empty().html(pagestartdetails);

}
</script>






<script>
    var interviewer = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callInterviewer(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        if (phoneNumber != null && phoneNumber.length >= 9) {
            Twilio.Device.connect(params);
        }
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + interviewer + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function CallButtonClickJson(id,phoneNumber ) {

        var name = $('#hidname' + id).val();

        CallButtonClick(name, phoneNumber);

    }
    function CallButtonClick(name, phoneNumber) {
        interviewer = name;
        // Get the modal
        var modal = document.getElementById("myCallModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + interviewer + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callInterviewer(phoneNumber);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }


</script>

<script>


    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });

   
      

    });
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>



<script>
    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $('.' + id).addClass("in");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
                $('.' + id).removeClass("in");
            $("#" + id).attr("data-changes", "1");
        }
    }

    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>