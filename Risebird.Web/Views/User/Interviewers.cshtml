                    html += '<td class="cadName"><a onclick="" data-tooltip="' + data[i].firstName + '"> ' + data[i].firstName.substring(0, 20) + '... </a></td>';
                }
                else {
                    html += '  <td class="cadName"><a onclick=""> ' + data[i].firstName + ' </a></td>';
                }
            }
            else {
                html += '<td></td>';
            }
            if (data[i].lastName != null && data[i].lastName != "") {
                if (data[i].lastName.length > 20) {
                    html += '<td class="cadLast"><a onclick="" data-tooltip="' + data[i].lastName + '"> ' + data[i].lastName.substring(0, 20) + '... </a></td>';
                }
                else {
                    html += '  <td class="cadLast"><a onclick=""> ' + data[i].lastName + ' </a></td>';
                }
            }
            else {
                html += '<td></td>';
            }
            //html += '  <td>' + data[i].emailId + '<input id="hidemail' + data[i].id + '" type="hidden" value="' + data[i].emailId + '"/></td>';



            if (data[i].emailId != null && data[i].emailId != "") {
                if (data[i].emailId.length > 23) {
                    html += '<td class="cadEmail"><a onclick="" data-tooltip="' + data[i].emailId + '">' + data[i].emailId + '<input id="hidemail' + data[i].id + '" type="hidden" value="' + data[i].emailId + '"/></a></td>';
                }
                else {
                    html += '  <td class="cadEmail"><a onclick="">' + data[i].emailId + '<input id="hidemail' + data[i].id + '" type="hidden" value="' + data[i].emailId + '"/> </a></td>';
                }
            }
            else {
                html += '<td></td>';
            }




            html += '<td class="interview-com">';
            html += ' <div id="section">';
            if (data[i].primarySkill != null && data[i].primarySkill != "") {
                if (data[i].primarySkill.length > 40) {
                    html += '  <div class="article">';
                    html += '  <p style="margin-bottom:0px;">' + data[i].primarySkill.substring(0, 40) + '</p>';
                    html += '   <p class="moretext_' + data[i].id + ' moretext">' + data[i].primarySkill.substring(40, data[i].primarySkill.length - 40) + '</p>';
                    html += '</div>';
                }
                else {
                    html += '<div class="article"><p>' + data[i].primarySkill.substring(0, data[i].primarySkill.length) + '</p></div>';
                }
            }
            else {
                html += '<div></div>';
            }
            html += ' <a onclick="moreless(' + data[i].id + ')" class="moreless-button" value="Readmore" id="read_' + data[i].id + '" href="#">Read more</a>';
            html += '</div>';
            html += ' </td>';

            html += '  <td>' + data[i].mobileNumber + '</td>';

            html += '  <td><a id="resumeId" target="_blank" title="Resume" href=' + data[i].resumeLink + '>Resume</a></td>';
            html += '   <td class="text-center action">';
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Edit">';
            html += ' <a href = "/User/EditInterviewer/' + data[i].id + '" title="Click here to edit interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></a>';
            html += '  </button>';
            html += ' <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">';
            html += '  <span onclick="javascript:DeleteEntityfromEnvironmentJson(' + data[i].id + ');" title="Click here to delete interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg></span>';
            html += ' </button>';
            html += '  <button class="mdc-fab app-fab--absolute" aria-label="Edit">';
            html += ' <a href = "/User/AssessmentForApproval?EmailAddress= ' + data[i].emailId + '&id= ' + data[i].id + '" title="Assessments" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" /></svg></a>';
