                                                                    }
                                                                    else
                                                                    {
                                                                        <td>Not Approved</td>
                                                                    }

                                                                    <td class="text-center">@item.NoOfInterview</td>
                                                                    <td class="text-center">@item.SuccessRate</td>







                                                                    <td>

                                                                        @item.Slots

                                                                    </td>
                                                                </tr>

                                                            </table>
                                                        </td>
                                                        </tr>






                                                            }
                                                </tbody>
                                        </table>
                                    </div>
                                </div>

                               <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                        Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                    </div>

                                    <div class="col-sm-12 col-md-7 dataTables_paginate pull-right" id="divmeetingpages">
                                        @Html.PagedListPager(Model, Page => Url.Action("Interviewers", new { Page = Page }))
                                    </div>

                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

        <div id="myCallModal" class="modal modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">


                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">


                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left">Call Interviewer!</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                    </button>






                    <div class="modal-body">

                        <h5 class="modal-title text-center " id="callingLabel">Calling...</h5>


                        <div class="">
                            <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 20px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>

<script>
    function dropDwnToolTips(id) {

        if (id.value == 0) {
            id.title = "";
        }
        else {
            id.title = id.value
        }
    }


</script>

<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/User/Interviewers';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/User/Interviewers';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script>
    function DeleteEntityfromEnvironmentJson(userId) {
        var emailId = $('#hidemail' + userId).val();
        DeleteEntityfromEnvironment(userId, emailId);

    }

    function DeleteEntityfromEnvironment(userId, EmailId) {

        swal.fire({
            title: 'Are you sure you want to delete interviewer' + EmailId + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/User/DeleteInterviewer',
                        data: { 'id': userId },
                        type: 'get',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>Your file has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/User/Interviewers";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>

<script type="text/javascript">
    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>




<script>

    function searchResult() {

        $.ajax({
            type: "POST",
            url: "/User/InterviewersJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }
    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="9" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {
            
            html += '<input type="hidden" id="hidname' + data[i].id + '" value="'+data[i].firstName+'"/><tr id=' + data[i].id + ' data-changes="1">';

