@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <script>
        function dropDwnToolTips(id) {

            if (id.value == 0) {
                id.title = "";
            }
            else {
                id.title = id.value
            }
        }


    </script>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent   bg-primary navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interviewers</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="row">

                                    <div class="card-header">
                                        <div class="pull-left"> <h4 class="card-title">Interviewers</h4></div>

                                        <div class="pull-right">

                                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interviewer" onclick="location.href='@Url.Action("AddInterviewer","User")'" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Add Interviewer</font></span>
                                            </button>

                                        </div>
                                    </div>



                                </div>

                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <table id="interviewer" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email Id</th>
                                            <th>Mobile Number</th>
                                            <th>Primary Skills</th>
                                            <th>Resume Link</th>
                                            <th>Approved</th>
                                            <th>Slots</th>
                                            <th>No Of Interview</th>
                                            <th>SuccessRate</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                            <th style="text-align:center">Call</th>

                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email Id</th>
                                            <th>Mobile Number</th>
                                            <th>Primary Skills</th>
                                            <th>Resume Link</th>
                                            <th>Approved</th>
                                            <th>Slots</th>
                                            <th>No Of Interview</th>
                                            <th>SuccessRate</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                            <th style="text-align:center">Call</th>

                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr id=@item.id>
                                                <td>@item.FirstName</td>
                                                <td>@item.LastName</td>
                                                <td>@item.EmailId</td>
                                                <td>@item.MobileNumber</td>
                                                <td>
                                                    <div class="talk-bubble tri-right border-bubble right-in cmt-w">
                                                        <div class="talktext">
                                                            <a href="#" data-tooltip="@item.PrimarySkill">  <textarea>@item.PrimarySkill</textarea></a>
</div>
                                                    </div>
                                                </td>
                                                <td class="text-center"><a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a></td>

                                                @if (@item.IsApproved == true)
                                                {
                                                    <td>Approved</td>
                                                }
                                                else
                                                {
                                                    <td>Not Approved</td>
                                                }
                                                <td>
                                                    <div class="talk-bubble tri-right border-bubble right-in">
                                                        <div class="talktext">
                                                            <textarea>@item.Slots</textarea>

                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center">@item.NoOfInterview</td>
                                                <td class="text-center">@item.SuccessRate</td>
                                                <td class="text-center action">

                                                    <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                        <span onclick="location.href = '@Url.Action("EditInterviewer", "User", new { id = item.id})'" title="Click here to edit interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                    </button>



                                                    <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                        <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.EmailId');" title="Click here to delete interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg></span>
                                                    </button>






                                                </td>
                                                <td>
                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                    {
                                                        <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the interviewer." onclick="CallButtonClick('@item.FirstName', '@item.MobileNumber')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt"> Call Interviewer</span></span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

        <div id="myCallModal" class="modal modal-wrap" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */">
            <!-- Modal content -->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-size:20px;">Call Interviewer!</h5>
                    <span class="close" id="callPopUp">&times;</span>
                </div>
                <div class="modal-body" style="padding: 2px 16px;">
                    <div class="row">
                        <label id="callingLabel" style="    margin-top: 30px;
    /* text-align: center; */
    font-size: 20px;
    text-align: center;
    margin: 20px auto;
    display: block"><b>Calling...</b></label>
                    </div>

                    <div class="">
                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 0px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">
                    </div>
                </div>
                <div class="modal-footer" style="background:#fff;"></div>
            </div>

        </div>

    </div>

</div>



<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/User/Interviewers';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/User/Interviewers';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


