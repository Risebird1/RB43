    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Interviewers</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <table id="interviewer" class="table table-striped table-bordered" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Email Id</th>
                                    <th>Mobile Number</th>
                                    <th>Primary Skills</th>
                                    <th>Resume Link</th>
                                    <th>Approved</th>
                                    <th>No Of Interview</th>
                                    <th>SuccessRate</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Email Id</th>
                                    <th>Mobile Number</th>
                                    <th>Primary Skills</th>
                                    <th>Resume Link</th>
                                    <th>Approved</th>
                                    <th>No Of Interview</th>
                                    <th>SuccessRate</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                <tr id=@item.id>
                                    <td>@item.FirstName</td>
                                    <td>@item.LastName</td>
                                    <td>@item.EmailId</td>
                                    <td>@item.MobileNumber</td>
                                    <td><textarea>@item.PrimarySkill</textarea></td>
                                    <td class="text-center"><a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a></td>
                                    @if (@item.IsApproved == true)
                                    {
                                        <td>Approved</td>
                                    }
                                    else
                                    {
                                        <td>Not Approved</td>
                                    }

                                    <td>@item.NoOfInterview</td>
                                    <td>@item.SuccessRate</td>
                                    <td class="text-right">
                                        <span onclick="location.href = '@Url.Action("EditInterviewer", "User", new { id = item.id})'" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                        <span onclick="javascript:DeleteEntityfromEnvironment('@item.id');" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-trash-o"></i></span>
