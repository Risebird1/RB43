    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interviewers</h4></div>
                </div>

                <div class="pull-right">

                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="float: left;">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interviewer" onclick="location.href='@Url.Action("AddInterviewer","User")'" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Add Interviewer</font></span>
                    </button>

                    @if (ViewBag.profile == "Admin")
                    {
                        <i type="submit" class="far fa-file-excel excel-file export five pull-left" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("InterviewwersExporttoExcel", "User")'"></i>

                    }

                    <div id="meeting_filter" class="dataTables_filter pull-left">

                        <div class="searchCon">

                            <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                            <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.Searchvalue">

                            <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                            @*<button style="display:none;" type="button" id="x">x</button>*@

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>




    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="clearfix"></div>
                                <div class="col-sm-12 nopad">
                                    <div class="table-responsive">
                                        <table id="interviewer" class="table table-striped table-bordered interviewertable" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th style="border-right: 0px !important;"></th>
                                                    <th id='start'>First Name</th>
                                                    <th>Last Name</th>
                                                    <th>Email Id</th>

                                                    <th>Primary Skills</th>

                                                    <th>Mobile Number</th>
                                                    <th>Resume</th>
                                                    <th class="disabled-sorting text-right">Actions</th>
                                                    <th style="text-align:center">Call</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th style="border-right: 0px !important;"></th>
                                                    <th>First Name</th>
                                                    <th>Last Name</th>

                                                    <th>Email Id</th>

                                                    <th>Primary Skills</th>
                                                    <th>Mobile Number</th>
                                                    <th>Resume</th>

                                                    <th class="disabled-sorting text-right">Actions</th>
                                                    <th style="text-align:center">Call</th>

                                                </tr>
                                            </tfoot>
                                            <tbody id="tblbodyInterviewers">
                                                @foreach (var item in Model)
                                                {
                                                <tr id=@item.id data-changes="1">
                                                    <td style="width:10px;" data-toggle="collapse" id="@item.id" data-target=".@item.id" class="detail-row" onclick="changeicon('@item.id')">&nbsp;</td>


                                                    @if (item.FirstName != null && item.FirstName != "")
                                                    {


                                                        @if (item.FirstName.Length > 20)
                                                        {


                                                            <td class="cadName">
                                                                <a onclick="" data-tooltip="@item.FirstName"> @item.FirstName.Substring(0, 20)... </a>
                                                            </td>
                                                        }


                                                        else
                                                        {
                                                            <td class="cadName">
                                                                <a onclick=""> @item.FirstName </a>
                                                            </td>
                                                        }

                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }








                                                    @if (item.LastName != null && item.LastName != "")
                                                    {


                                                        @if (item.LastName.Length > 20)
                                                        {


                                                            <td class="cadLast">
                                                                <a onclick="" data-tooltip="@item.LastName"> @item.LastName.Substring(0, 20)... </a>
                                                            </td>
                                                        }


                                                        else
                                                        {
                                                            <td class="cadLast">
                                                                <a onclick=""> @item.LastName </a>
                                                            </td>
                                                        }

                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }




                                                    @if (item.EmailId != null && item.EmailId != "")
                                                    {

                                                        @if (item.EmailId.Length > 23)
                                                        {


                                                            <td class="cadEmail">
                                                                <a onclick="" data-tooltip="@item.EmailId"> @item.EmailId.Substring(0, 23)... </a>
                                                            </td>
                                                        }


                                                        else
                                                        {
                                                            <td class="cadEmail">
                                                                <a onclick=""> @item.EmailId </a>
                                                            </td>
                                                        }

                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }




                                                    <td class="interview-com">


                                                        <div id="section">
                                                            @if (item.PrimarySkill != null && item.PrimarySkill != "")
                                                            {
                                                                @if (item.PrimarySkill.Length > 40)
                                                                {
                                                                    <div class="article">
                                                                        <p style="margin-bottom:0px;">
                                                                            @item.PrimarySkill.Substring(0, 40)
                                                                        </p>
                                                                        <p class="moretext_@item.id moretext">
                                                                            @item.PrimarySkill.Substring(40, @item.PrimarySkill.Length - 40)
                                                                        </p>
                                                                    </div>
                                                                    <a onclick="moreless(@item.id)" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                                }
                                                                else
                                                                {
                                                                    <div class="article">

                                                                        <p>
                                                                            @item.PrimarySkill.Substring(0, @item.PrimarySkill.Length )
                                                                        </p>
                                                                    </div>}
                                                            }
                                                            else
                                                            { <div></div>}


                                                        </div>




                                                    </td>

                                                    <td>@item.MobileNumber</td>
                                                    <td class="text-center"><a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a></td>


                                                    <td class="text-center action">

                                                        <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                            <span onclick="location.href = '@Url.Action("EditInterviewer", "User", new { id = item.id})'" title="Click here to edit interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                        </button>
                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                            <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.EmailId');" title="Click here to delete interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg></span>
                                                        </button>
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                            <span onclick="location.href = '@Url.Action("AssessmentForApproval", "Interviewer", new { EmailAddress = item.EmailId , id = item.id })'" title="Assessments" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" /></svg></span>
                                                        </button>
                                                    </td>
                                                    <td>
