@model Risebird.Entities.Data.ResumeEvaluator
@{
    ViewData["Title"] = "Update Resume Evaluator";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/User/ResumeEvaluators'>Resume Evaluators</a>&nbsp;/&nbsp;Update Resume Evaluator";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
   
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bg-white">
            <div class="col-md-12">
                <div class="mdc-card card bg-white">

                    <div class="mdc-card-wrapper__text-section">
                        @using (Html.BeginForm("EditResumeEvaluator", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            @Html.AntiForgeryToken()

                            <div class="row">

                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Update Resume Evaluator</h4></div>
                                </div>
                                <div style="width: 100%;">&nbsp;</div>
                                <div class="form-horizontal w-full">
                                    <div class="col-md-6 col-sm-6 pr-1 pull-left rightpad">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span></div>

                                                @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })

                                            </div>
                                    </div>

                                    <div class="col-md-6 col-sm-6 pl-1 pull-left">
                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                            </div>


                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 pr-1 pull-left rightpad">
                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span></div>

                                                @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })

                                            </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 pl-1 pull-left">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    @Html.HiddenFor(m => m.UserId)

                                </div>

                            </div>
                            <div class="card-footer ">
                                <div class="row">

                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "ResumeEvaluators", "User", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save">Save</button>
                                    </div>
                                </div>
                            </div>

                        }
                    </div>



                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>


<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
    </script>


