@model IEnumerable<Risebird.Entities.ViewModel.ClientUserVM>
@{
    ViewData["Title"] = "Client Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Client Users</a>
            </div>           
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Client Users</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <div class="text-right">
                                <button type="button" style="margin-top:-108px;" class="btn btn-primary"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add client user" onclick="location.href='@Url.Action("AddClientUser","User")'" data-original-title="Tooltip on top"> Add Client User</span></button>
                            </div>
                        </div>
                        <table id="clientduser" class="table table-striped table-bordered" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th hidden></th>
                                    <th hidden></th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Email Id</th>
                                    <th>Client name</th>
                                    <th>Role</th>
                                    <th>Mobile Number</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th hidden></th>
                                    <th hidden></th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Email Id</th>
                                    <th>Client name</th>
                                    <th>Role</th>
                                    <th>Mobile Number</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                <tr id=@item.id>
                                    <td hidden>@item.id</td>
                                    <td hidden>@item.idProfile</td>
                                    <td>@item.FirstName</td>
                                    <td>@item.LastName</td>
                                    <td>@item.EmailId</td>
                                    <td>@item.ClientName</td>
                                    <td>@item.Role</td>
                                    <td>@item.MobileNumber</td>
                                    <td class="text-right">
                                        <span onclick="location.href = '@Url.Action("EditClientUser", "User", new { id = item.id})'" title="Click here to edit client user" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                        <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.EmailId');" title="Click here to edit client user" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-trash-alt"></i></span>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>




<script>
    $(document).ready(function () {




        $('#clientduser').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });


        var table = $('#clientduser').DataTable();


    });

    function DeleteEntityfromEnvironment(clientUserId, EmailId) {

        var confirmMessageBox = confirm('Are you sure you want to delete client user ' + EmailId + ' ?');
        if (confirmMessageBox) {
            if (clientUserId != '') {
                $.ajax({
                    url: '/User/DeleteClientUser',
                    data: { 'id': clientUserId },
                    type: 'get',
                    success: function (data) {
                        window.location = data.url;
                    }
                });
            }
        }
    }
</script>
