@model Risebird.Entities.ViewModel.ClientUserVM
@{
    ViewData["Title"] = "ClientUserUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">

                <a class="navbar-brand breadcrumscolor" href="/User/ClientUsers">Client User</a>
                <a class="navbar-brand">Update</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    @using (Html.BeginForm("EditClientUser", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {

        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-12 edit-build nova-cont">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Update Client User</h4>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Clients, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6">
                                            @Html.DropDownListFor(x => Model.SelectedClient, Model.Clients, "Select Client", htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ClientRoles, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6">
                                            @Html.DropDownListFor(x => Model.SelectedClientRole, Model.ClientRoles, "Select Client Role", htmlAttributes: new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="form-group col-sm-12">
                                        <div class="pull-right">
                                            <input type="submit" id="btnUpload" value="Update Client User" class="btn btn btn-primary" />
                                        </div>
                                        <div>
                                            @Html.ActionLink("Back to List", "Clientusers", "User", new { @class = "btn btn-link" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>
    <style>
        .fa-spinner {
            font-size: 18px;
            position: relative;
            top: 6px;
            left: 4px;
        }

        .webkitEnabled {
            -webkit-appearance: menulist;
        }
    </style>


