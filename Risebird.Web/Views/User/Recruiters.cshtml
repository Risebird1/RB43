@*@model IEnumerable<Risebird.Entities.Data.Recruiter>*@
@model X.PagedList.IPagedList<Risebird.Entities.Data.Recruiter>
@using X.PagedList.Mvc.Core;
@{
   ViewData["Title"] = "Recruiters";
   ViewBag.PageHeader = "Recruiter";
   Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel recruiter" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Recruiter</h4></div>
                </div>
                <div class="pull-right client-ms">
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space pull-left" style="margin-right:10px;">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add Recruiter" onclick="location.href='@Url.Action("AddRecruiter","User")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Risebird User</font></span>
                    </button>

                    <div id="meeting_filter" class="dataTables_filter pull-left">

                        <div class="searchCon">

                            <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                            <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeypress="searchResultEnter(event)" value="@ViewBag.Searchvalue">

                            <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                            @*<button style="display:none;" type="button" id="x">x</button>*@

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <table id="recruiterTable" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email Id</th>
                                            <th>Domain</th>
                                            <th>Mobile Number</th>
                                            <th class="disabled-sorting text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email Id</th>
                                            <th>Domain</th>
                                            <th>Mobile Number</th>
                                            <th class="disabled-sorting  text-center">Actions</th>
                                        </tr>
                                    </tfoot>
                                    <tbody id="tblbodyRecruiters">
                                        @foreach (var item in Model)
                                        {
                                            <tr id=@item.id>
                                                <td>@item.FirstName</td>
                                                @if (item.LastName != null && item.LastName != "")
                                                {

                                                    <td>@item.LastName</td>
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                                @if (item.EmailId != null && item.EmailId != "")
                                                {
                                                    <td>@item.EmailId</td>
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }

                                                <td>@item.Domain</td>
                                                @if (item.MobileNumber != null && item.MobileNumber != "")
                                                {
                                                    <td>@item.MobileNumber</td>
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }




                                                <td class="text-center action">

                                                    <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit Recruiter">
                                                        <span onclick="location.href = '@Url.Action("EditRecruiter", "User", new { id = item.id})'" title="Click here to edit Recruiter" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                    </button>


                                                    <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete Risebird User">
                                                        <span onclick="javascript:DeleteEntityfromEnvironment('@item.UserId','@item.EmailId');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                    </button>


                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>


                                <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                    Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                </div>

                                <div class="col-sm-12 col-md-7 dataTables_paginate pull-right" id="divmeetingpages">
                                    @Html.PagedListPager(Model, Page => Url.Action("Recruiters", new { Page = Page }))
                                </div>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}




<script>

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }


    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });

    });
    function DeleteEntityfromEnvironmentJson(userId) {
        var emailId = $('#hidemail' + userId).val();
        DeleteEntityfromEnvironment(userId, emailId);

    }
    function DeleteEntityfromEnvironment(userId, EmailId) {

        swal.fire({
            title: 'Are you sure you want to delete Recruiter ' + EmailId + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/User/DeleteRecruiter',
                        data: { 'id': userId },
                        type: 'get',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>Recruiter has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/User/Recruiters";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>
<script>

    function searchResult() {

        $.ajax({
            type: "POST",
            url: "/User/RecruitersJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }
    function searchResultEnter(e) {
        var code = (e.keyCode ? e.keyCode : e.which);
        if (code == 13) {
            searchResult();
        }
    }
    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="9" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {
            html += ' <tr id=' + data[i].id + '>';
            html += ' <td>' + data[i].firstName + '</td>';
            if (data[i].lastName != null && data[i].lastName != "") {
                html += ' <td>' + data[i].lastName + '</td>';
            }
            else { html += '<td></td>'; }
            if (data[i].emailId != null && data[i].emailId != "") {
                html += ' <td>' + data[i].emailId + '<input id="hidemail' + data[i].id + '" type="hidden" value="' + data[i].emailId + '"/></td>';
            }
            else {
                html += '<td></td>';
            }
            html += ' <td>' + data[i].domain + '</td>';
            if (data[i].mobileNumber != null && data[i].mobileNumber != "") {
                html += '  <td>' + data[i].mobileNumber + '</td>';
            }
            else {
                html += '<td></td>';
            }

            html += '   <td class="text-center action">';
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit Recruiter">';
            html += ' <a href ="/User/EditRecruiter?id=' + data[i].id + '" title="Click here to edit Recruiter" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>';
            html += '  </button>';


            html += '    <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete Risebird User">';

            html += '<span onclick="javascript:DeleteEntityfromEnvironmentJson(' + data[i].id + ');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>';

            html += '   </button>';


            html += '   </td>';
            html += '  </tr>';


        }
        $("#tblbodyRecruiters").empty().html(html);
    }
    function bindPages(pagecount, startpage, endpage, totalcount) {
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/HR/MyInterviews?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/HR/MyInterviews?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/HR/MyInterviews?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/HR/MyInterviews?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/HR/MyInterviews?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#recruiterTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#recruiterTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#recruiterTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>