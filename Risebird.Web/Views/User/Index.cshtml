@model IEnumerable<Risebird.Entities.Data.UserList>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Data
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Users";
    ViewBag.PageHeader = "Risebird Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string[] Profile = new string[] { };
    bool[] IsActive = new bool[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("RiseBirdUserfilters") != null)
{
    filter = JsonConvert.DeserializeObject<SelectedPriorityViewFilter>(HttpContextAccessor.HttpContext.Session.GetString("RiseBirdUserfilters"));
    Profile = filter.Profile != null ? filter.Profile : new string[] { };
    IsActive = filter.IsActive != null ? filter.IsActive : new bool[] { };
}

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Risebird Users</h4></div>
                </div>

                <div class="pull-right">

                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("Add","User")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Risebird User</font></span>
                    </button>
                    <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                        <span class="mdc-button__label"><span class="fa fa-filter" data-bs-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                        <div class="mdc-button__ripple"></div>
                    </button>


                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">


                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("Index","User")" method="post" id="form">
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv ">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IsActive">
                                                                Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IsActive" name="IsActive" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                    <option value="true">Active</option>
                                                                    <option value="false">InActive</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group col-md-12">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Profile">
                                                                    Profile
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Profile" name="Profile" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in (List<Profile>)ViewBag.profiles)
                                                                        {
                                                                            @if (item.Name != null && item.Name != "")
                                                                            {
                                                                                <option value="@item.Name">@item.Name</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="col-md-12 col-sm-12">
                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>
                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <table id="risebirduser" class="table table-striped table-bordered dt-responsive dataTable dtr-inline" cellspacing="0" width="100%">
                                <thead>
                                    <tr>

                                        <th id='start'>First Name</th>
                                        <th>Last Name</th>
                                        <th>Email Id</th>
                                        <th>Profile Name</th>
                                        <th>Mobile Number</th>
                                        <th>Status</th>
                                        <th>Password</th>
                                        <th class="disabled-sorting text-center">Actions</th>
                                        <th hidden></th>
                                        <th hidden></th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>

                                        <th>First Name</th>
                                        <th>Last Name</th>
                                        <th>Email Id</th>
                                        <th>Profile Name</th>
                                        <th>Mobile Number</th>
                                        <th>Status</th>
                                        <th>Password</th>
                                        <th class="disabled-sorting text-center">Actions</th>
                                        <th hidden></th>
                                        <th hidden></th>
                                    </tr>
                                </tfoot>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id=@item.Id>
                                            <td>@item.FirstName</td>
                                            <td>@item.LastName</td>
                                            <td>@item.EmailId</td>
                                            <td>@item.profileName</td>
                                            <td>@item.MobileNumber</td>
                                            @if (item.IsActive)
                                            {
                                                <td style="color:green">Active</td>
                                            }
                                            else
                                            {
                                                <td style="color:grey">Inactive</td>
                                            }
                                            <td>
                                                <div class="mobile-view">
                                                    <div>
                                                        <span> @item.UserPassword</span>
                                                    </div>
                                                </div>
                                                <div class="desktop-view">
                                                    <div style="position:relative">
                                                        <div class="secret-pass passshow" id="password-field_@item.Id" type="password">@item.UserPassword</div>
                                                        @if (item.UserPassword != null && item.UserPassword != "")
                                                        {<span class="secret" id="secret_@item.Id" style="top:0px;">********</span>
                                                            <span toggle="#password-field_@item.Id" class="fa fa-fw fa-eye field-icon toggle-password" id="toggle-password_@item.Id" onclick="showhidepass(@item.Id)"></span>
                                                        }
                                                        else
                                                        { <span toggle="#password-field_@item.Id" class="toggle-password" id="toggle-password_@item.Id"></span>}
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center action">
                                                @if (@HttpContextAccessor.HttpContext.Session.GetString("email") != null)
                                                {

                                                    var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
                                                    var email = emailid.Trim('"');
                                                    @if (email != item.EmailId)
                                                    {
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit risebird user">
                                                            <span onclick="location.href = '@Url.Action("Edit", "User", new { id = item.Id })'" title="Click here to edit risebird user" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                        </button>
                                                        @if (ViewBag.profileName == "Admin")
                                                        {
                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete risebird user">
                                                                <span onclick="javascript:DeleteEntityfromEnvironment('@item.Id','@item.EmailId');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                            </button>
                                                        }
                                                    }
                                                }

                                            </td>
                                            <td hidden>@item.Id</td>
                                            <td hidden>@item.IdProfile</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>




@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/User/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/User/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


