@model IEnumerable<Risebird.Entities.Data.UserList>
@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- START BREADCRUMB -->
<ul class="breadcrumb">
    <li class="active"><strong>Risebird Users</strong></li>
</ul>
<!-- END BREADCRUMB -->
<!-- PAGE TITLE -->
<div class="page-title">
    <h2><span class="fa fa-users"></span> Risebird Users</h2>
</div>
<!-- END PAGE TITLE -->
<!-- PAGE CONTENT WRAPPER -->
<div class="page-content-wrap">
    <div class="row">
        <div class="col-md-12">
            <!-- START DEFAULT DATATABLE -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <ul class="panel-controls">
                        <li>
                            <button class="btn btn-default" onclick="window.location.href = '@Url.Action("Add","User")'"><span class="fa fa-plus-circle"> Add User</span></button>
                        </li>
                    </ul>
                </div>
                <div class="panel-body">
                    <table class="table datatable" id="idrisebirduser">
                        <thead>
                            <tr>
                                <th hidden>&nbsp;</th>
                                <th hidden>&nbsp;</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email Id</th>
                                <th>Mobile Number</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                            <tr>
                                <td hidden>@item.Id</td>
                                <td hidden>@item.IdProfile</td>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.EmailId</td>
                                <td>@item.MobileNumber</td>
                               
                                <td>
                                    <i type="submit" onclick="location.href='@Url.Action("Edit", "User", new { id = item.Id})'" class="fa fa-pencil-square-o" style="color:green;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Edit" data-original-title="Tooltip on bottom"></i>
                                    <i class="fa fa-trash-o hover" style="color:red;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Delete" data-original-title="Tooltip on bottom" onclick="javascript:DeleteEntityfromEnvironment('@item.Id');"></i>
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END DEFAULT DATATABLE -->
        </div>
    </div>
</div>
<!-- PAGE CONTENT WRAPPER -->
<loading></loading>
@if (ViewBag.Message != null && ViewBag.Message.Contains("Successfully"))
{
    <script type="text/javascript">
        window.onload = function ()
        {
                                sweetAlert({
                                    title: "Risebird Users",
                                    text:'@ViewBag.Message',
                                    type: "success"
                                });
         };
    </script>
}
@if (ViewBag.Message != null && (ViewBag.Message.Contains("Failed")))
{
    <script type="text/javascript">
            window.onload = function ()
            {
                    sweetAlert({
                        title: "Risebird Users",
                    text: '@ViewBag.Message',
                   type: "error"
                   });
           };
    </script>
}
<script type="text/javascript">$(document).ready(function ()
    {
        $('#idenvironment').DataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [-1] /*sort false 1st one, start by the right */
            }],
            "order": []   /* Disable initial sort */
        });
    });

    function DeleteEntityfromEnvironment(userId) {

        var confirmMessageBox = confirm('Are you sure you want to delete "user name"?');
        if (confirmMessageBox) {
            if (userId != '') {
                $.ajax({
                    url: '/User/Delete',
                    data: { 'id': userId },
                    type: 'get',
                    success: function (data) {
                        window.location = data.url;
                    }
                });
            }
        }
    }

    </script>
