    $(document).ready(function () {

        $('#risebirduser').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
               // $(".dataTables_filter input:eq(0)").after("<button style=display:none; type=button id=x>x</button>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") { $("#x").hide(); }
                    else { $("#x").show(); }
                });
            }

        });





    });



    $(document).ready(function () {

        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });







    $(document).ready(function () {


        //oTable = $('#example').dataTable();

        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter").val('');
            $(this).hide();
        });

    });




    function DeleteEntityfromEnvironment(userId, EmailId) {


        swal.fire({
            title: 'Are you sure you want to delete user ' + EmailId + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/User/Delete',
                        data: { 'id': userId },
                        type: 'get',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>Your record has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/User/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>
<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#risebirduser").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#risebirduser").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#risebirduser").show();
        }, 2000);
    };
    //// script for loader ends here
</script>