@model Risebird.Entities.ViewModel.InterviewerVM
@{
    ViewData["Title"] = "InterviewerUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/User/Interviewers">Interviewers</a>
                <a class="navbar-brand">Update Interviewer</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Update Interviewer</h4>
                    </div>
                    <div class="card-body">
                        @using (Html.BeginForm("EditInterviewer", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-horizontal">
                                        <div class="col-md-6 col-sm-6 pr-1">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                                @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.PrimarySkill, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.PrimarySkill, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                                @Html.ValidationMessageFor(model => model.SelectedSkillIds, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Slots, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.Slots, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                                @Html.ValidationMessageFor(model => model.Slots, "", new { @class = "text-danger" })

                                            </div>
                                           
                                            <div class="form-group">
                                                Upload File
                                                <input id="Resume" name="Resume" value="Upload" type="radio" onclick="RadioChanged(this.value)">
                                                Add a link
                                                <input id="Resume" name="Resume" value="Link" type="radio" onclick="RadioChanged(this.value)">
                                                None
                                                <input id="Resume" name="Resume" value="None" checked="checked" type="radio" onclick="RadioChanged(this.value)">
                                            </div>
                                            <div class="form-group" style="display:none" id="linkDiv">
                                                @Html.LabelFor(model => model.ResumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                                @Html.EditorFor(model => model.ResumeLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                                @Html.ValidationMessageFor(model => model.ResumeLink, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="" style="display:none" id="uploadDiv">
                                                @Html.LabelFor(model => model.File, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                            </div>
                                            
                                            <div class="">
                                                @{
                                                    if (Model.ResumeLink != null)
                                                    {
                                                        <a id="videoId" target="_blank" title="Resume" href=@Model.ResumeLink.ToString().Replace(" ","%20")>Uploaded Resume</a>
                                                    }
                                                }
                                            </div>
                                            

                                            
                                        </div>
                                        <div class="card-footer ">
                                            <div class="row">
                                                <label class="col-md-2"></label>
                                                <div class="col-md-9">
                                                    @Html.ActionLink("Back to List", "Interviewers", "User", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                                    <button type="submit" class="btn btn-fill btn-primary" id="btnUpload" value="Save">Save</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>



                        }
                    </div>



                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>
<style>
    .fa-spinner {
        font-size: 18px;
        position: relative;
        top: 6px;
        left: 4px;
    }

    .webkitEnabled {
        -webkit-appearance: menulist;
    }

    .dropdown-menu > .active > a, .dropdown-menu > .active > a:hover, .dropdown-menu > .active > a:focus {
        color: #000 !important;
        text-decoration: none;
        background-color: #fff !important;
        outline: 0;
    }
</style>
<script type="text/javascript">
    var j = jQuery.noConflict();
    j(document).ready(function () {
        j('.listbox').multiselect({
            includeSelectAllOption: true
        });
    });
</script>
<script>
    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            //document.getElementById("ResumeLink").value = '';

        }
        else if (val == 'Link') {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("File").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("File").value = '';
            //document.getElementById("ResumeLink").value = '';
        }

    }

</script>


