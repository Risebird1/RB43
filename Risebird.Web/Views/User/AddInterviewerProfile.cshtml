                                                            @*<input class="form-control text-box single-line" id="InterviewerEducationDetails_0__specialization" name="InterviewerEducationDetails[0].Specialization" type="text" value="">*@

                                                            @Html.TextBox("InterviewerEducationDetails[0].Specialization", null, new { @class = "form-control text-box single-line", })
                                                        </td>
