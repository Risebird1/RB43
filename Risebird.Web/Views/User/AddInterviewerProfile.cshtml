    <script>
        //====== Age CalculationFunctiopn======//

        $(document).ready(function () {
            $("#DOB").change(function () {
                var BirthDate = $("#DOB").val();
                var dob = new Date(BirthDate);
                var today = new Date();
                var age = Math.floor((today - dob) / (365.25 * 24 * 60 * 60 * 1000));
                document.getElementById("txt_Age").value = age.toString();
            });
        });
    </script>
    <script>



        function addProjectTableRow() {
            var x = document.getElementById('projectTable');
            var rowLen = x.rows.length;
            
            if (rowLen > 3) {
                alert("Cannot add more than 3 Projects Details.");
               
                return;
            }
            else {
                var new_row = x.rows[1].cloneNode(true);
                x.appendChild(new_row);
            }
          

        }

        function deleteProjectTableRow(row) {
            var x = document.getElementById('projectTable');
            // get the total number of rows
            var rowLen = x.rows.length;
            //console.log("Row Length to delete:: " + rowLen);
            if (rowLen == 2) {
                alert('Must have atleast one Row');
                return false;
            }
            else {
                var i = row.parentNode.parentNode.rowIndex;
                document.getElementById('projectTable').deleteRow(i);
            }
        }

