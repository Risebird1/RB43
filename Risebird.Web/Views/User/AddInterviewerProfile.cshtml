@model Risebird.Entities.ViewModel.InterviewerProfileVM

@{
    ViewData["Title"] = "Add Interviewer Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>


<script src="sweetalert2.all.min.js"></script>
<script src="sweetalert2.min.js"></script>
<link rel="stylesheet" href="sweetalert2.min.css">

<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .table-responsive {
        overflow: hidden;
    }
</style>
<!-- Style added by Vishwanath for AddInterviewerProfile-->>
<style>
    .table-responsive {
        width: 98%;
    }

    .tableHeaderClass {
        text-align: center;
    }

    .fieldHeader {
        text-align: center;
    }
</style>
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Add Interviewer Profile form</a>
                <a class="navbar-brand">Add Interviewer Profile </a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">

                        @using (Html.BeginForm("AddInterviewerProfile", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.AntiForgeryToken()
                            <!-- Add Interviewer personal Details Start-->
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Personal Details</h2>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">

                                    <div class="form-group" style="display:none">

                                        @Html.Hidden("UserId", Model.UserId)

                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="emailID">Email ID</label>
                        <input class="form-control text-box single-line" id="emailID" name="emailID" type="text" value="">*@

                                        @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })

                                        @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="mobile">Mobile</label>
                        <input class="form-control text-box single-line" id="mobile" name="mobile" type="text" value="">*@

                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })

                                        @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="yearOfExp">Year of Experience</label>
                        <input class="form-control text-box single-line" id="yearOfExp" name="yearOfExp" type="text" value="">*@

                                        @Html.LabelFor(model => model.Experience, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })

                                        @Html.EditorFor(model => model.Experience, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.Experience, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="isLeadInterviewer">Is Lead Interviewer</label>
                        <input class="form-control text-box single-line" id="isLeadInterviewer" name="isLeadInterviewer" type="text" value="">*@

                                        @Html.LabelFor(model => model.IsLeadInterviewer, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })

                                        @Html.EditorFor(model => model.IsLeadInterviewer, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text", @Value = "false" } })
                                        @Html.ValidationMessageFor(model => model.IsLeadInterviewer, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-md-4 col-sm-4 pr-1">

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="lastName">Last Name</label>
                        <input class="form-control text-box single-line" id="lastName" name="lastName" type="text" value="">*@

                                        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="alternateEmail">Alternate Email</label>
                        <input class="form-control text-box single-line" id="alternateEmail" name="alternateEmail" type="text" value="">*@

                                        @Html.LabelFor(model => model.AltEmailId, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.AltEmailId, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AltEmailId, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="alterMobile">Alternate Mobile</label>
                        <input class="form-control text-box single-line" id="alterMobile" name="alterMobile" type="text" value="">*@

                                        @Html.LabelFor(model => model.AltMobileNumber, htmlAttributes: new { @class = "control-label col-md-8 col-sm-8 col-lg-8 desp-label" })
                                        @Html.EditorFor(model => model.AltMobileNumber, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AltMobileNumber, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="domain">Prefered Domain</label>
                        <input class="form-control text-box single-line" id="domain" name="domain" type="text" value="">*@

                                        @Html.LabelFor(model => model.PreferredDomain, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.PreferredDomain, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.PreferredDomain, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="isActive">Is Active</label>
                        <input class="form-control text-box single-line" id="isActive" name="isActive" type="text" value="">*@

                                        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text", @Value = "false" } })
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="nickName">Nick Name</label>
                        <input class="form-control text-box single-line" id="nickName" name="nickName" type="text" value="">*@

                                        @Html.LabelFor(model => model.NickName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.NickName, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.NickName, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="location">Current Location</label>
                        <input class="form-control text-box single-line" id="location" name="location" type="text" value="">*@

                                        @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.Location, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })


                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="role">Current Role</label>
                        <input class="form-control text-box single-line" id="role" name="role" type="text" value="">*@

                                        @Html.LabelFor(model => model.CurrentRole, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.CurrentRole, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.CurrentRole, "", new { @class = "text-danger" })

                                    </div>


                                    <div class="form-group">

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="isApproved">Is Approved</label>
                        <input class="form-control text-box single-line" id="isApproved" name="isApproved" type="text" value="">*@

                                        @Html.LabelFor(model => model.IsApproved, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.IsApproved, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text", @Value = "false" } })
                                        @Html.ValidationMessageFor(model => model.IsApproved, "", new { @class = "text-danger" })


                                    </div>

                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="resume">Upload Resume</label>*@


                                        Upload Resume
                                        <input id="Resume" name="Resume" value="Upload" type="radio" checked="checked" onclick="RadioChanged(this.value)">
                                        |  Coded Resume
                                        <input id="Resume" name="Resume" value="Link" type="radio" onclick="RadioChanged(this.value)">
                                    </div>
                                    <div style="display:none" id="linkDiv">
                                        @*@Html.LabelFor(model => model.ResumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                        @Html.EditorFor(model => model.ResumeLink, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ResumeLink, "", new { @class = "text-danger" })*@

                                        @Html.LabelFor(model => model.ResumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.ResumeLink, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })

                                    </div>
                                    <div class="" id="uploadDiv">
                                        @Html.LabelFor(model => model.File, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })


                                    </div>

                                </div>
                            </div>
                            <!-- INterviewer personal Details End-->

                            <!-- Interviewer Skill Details Start-->
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Interviewer Skill Details </h2>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive">
                                        <table class="table table-bordered mbn" id="skillTable">
                                            <thead class="tableHeaderClass">
                                                <tr>
                                                    <th width="45%" class="table_heading">Skill Name </th>
                                                    <th width="45%" class="table_heading">Level</th>
                                                    <th width="10%" class="table_heading"> Action</th>

                                                </tr>
                                            </thead>
                                            <tbody class="tableBody">

                                                @if (Model.InterviewerSkill == null || Model.InterviewerSkill.Count() == 0)
                                                {
                                                    <tr>
                                                        <td>
                                                            @*<input class="form-control text-box single-line" id="InterviewerSkill_0__id" name="InterviewerSkill[0].SkillName" type="text" value="" placeholder="Skill name shoule be drop down">*@
                                                            @Html.DropDownList("InterviewerSkill[0].SkillId", (SelectList)Model.SkillTypeList, new { @class = "form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.SkillTypeList, "", new { @class = "text-danger" })
                                                        </td>
                                                        <td>
                                                            @*<input class="form-control text-box single-line" id="InterviewerSkill_0__Level" name="InterviewerSkill[0].Level" type="text" value="" placeholder="Skill level shoule be drop down" />*@
                                                            @Html.DropDownList("InterviewerSkill[0].Level", (SelectList)Model.LevelList, new { @class = "form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.Level, "", new { @class = "text-danger" })
                                                        </td>
                                                        <td>
                                                            <span id="btnPlus" onclick="addRowSkillDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                            <span id="btnMinus" onclick="deleteRowSkillDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>
                                                        </td>

                                                    </tr>
                                                }
                                                else
                                                {
                                                    for (int i = 0; i < Model.InterviewerSkill.Count(); i++)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @*<input class="form-control text-box single-line" id="InterviewerSkill_0__id" name="InterviewerSkill[0].SkillName" type="text" value="" placeholder="Skill name shoule be drop down">*@
                                                                @Html.DropDownListFor(m => m.InterviewerSkill[i].SkillName, (SelectList)Model.SkillTypeList, new { @class = "form-control text-box single-line" })
                                                                @Html.ValidationMessageFor(model => model.SkillTypeList, "", new { @class = "text-danger" })
                                                            </td>
                                                            <td>
                                                                @*<input class="form-control text-box single-line" id="InterviewerSkill_0__Level" name="InterviewerSkill[0].Level" type="text" value="" placeholder="Skill level shoule be drop down" />*@
                                                                @Html.DropDownListFor(m => m.InterviewerSkill[i].Level, (SelectList)Model.LevelList, new { @class = "form-control text-box single-line" })
                                                                @Html.ValidationMessageFor(model => model.Level, "", new { @class = "text-danger" })
                                                            </td>
                                                            <td>
                                                                <span id="btnPlus" onclick="addRowSkillDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="deleteRowSkillDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>
                                                            </td>

                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                        <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:815px"></label>

                                    </div>
                                </div>
                            </div>

                            <!--Interviewer Skill Details end -->

                            <!-- Interviewer Certificate Details Start-->

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Interviewer Certificate Details</h2>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive">
                                        <table class="table table-bordered mbn" id="certificateTable">
                                            <thead class="tableHeaderClass">
                                                <tr>
                                                    <th width="45%" class="table_heading">Certificate ID </th>
                                                    <th width="45%" class="table_heading">Certificate Name</th>
                                                    <th width="10%" class="table_heading">Action</th>

                                                </tr>
                                            </thead>
                                            <tbody class="tableBody">
                                                @if (Model.InterviewerCertificateDetails == null || Model.InterviewerCertificateDetails.Count() == 0)
                                                {
                                                    <tr>
                                                        <td>
                                                            @*<input class="form-control text-box single-line" id="InterviewerEducationDetails_0__CertificateID" name="InterviewerCertificateDetails[0].CertificateID" type="text" value="">*@
                                                            @Html.TextBox("InterviewerCertificateDetails[0].CertificateID", null, new { @class = "form-control text-box single-line", })
                                                        </td>
                                                        <td>
                                                            @*<input class="form-control text-box single-line" id="InterviewerEducationDetails_0__CertificateName" name="InterviewerCertificateDetails[0].CertificateName" type="text" value="">*@

                                                            @Html.TextBox("InterviewerCertificateDetails[0].CertificateName", null, new { @class = "form-control text-box single-line", })
                                                        </td>

                                                        <td>
                                                            <span id="btnPlus" onclick="addRowCertificateDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                            <span id="btnMinus" onclick="deleteRowCertificateDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>

                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    for (int i = 0; i < Model.InterviewerCertificateDetails.Count(); i++)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @*<input class="form-control text-box single-line" id="InterviewerEducationDetails_0__CertificateID" name="InterviewerCertificateDetails[i].CertificateID" type="text" value="">*@

                                                                @Html.TextBoxFor(m => m.InterviewerCertificateDetails[i].CertificateID, null, new { @class = "form-control text-box single-line", })
                                                            </td>
                                                            <td>
                                                                @*<input class="form-control text-box single-line" id="InterviewerEducationDetails_0__CertificateName" name="InterviewerCertificateDetails[i].CertificateName" type="text" value="">*@

                                                                @Html.TextBoxFor(m => m.InterviewerCertificateDetails[i].CertificateName, null, new { @class = "form-control text-box single-line", })
                                                            </td>

                                                            <td>
                                                                <span id="btnPlus" onclick="addRowCertificateDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="deleteRowCertificateDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>

                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                        <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:815px"></label>

                                    </div>
                                </div>

                            </div>

                            <!--Interviewer Certificate  Details end -->

                            <!-- Educational Details Start-->
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Educational Details</h2>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive">
                                        <table class="table table-bordered mbn" id="educationTable">
                                            <thead class="tableHeaderClass">
                                                <tr>
                                                    <th width="25%" class="table_heading">Educational Type </th>
                                                    <th width="25%" class="table_heading">College Type</th>
                                                    <th width="20%" class="table_heading">Specialization</th>
                                                    <th width="20%" class="table_heading">Score</th>
                                                    <th width="10%" class="table_heading">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody class="tableBody">
                                                @if (Model.InterviewerEducationDetails == null || Model.InterviewerEducationDetails.Count() == 0)
                                                {
                                                    <tr>
                                                        <td>
                                                            @*<input class="form-control text-box single-line" id="educationType" name="educationType" type="text" value="" placeholder="Education type drop down">*@
                                                            @Html.DropDownList("InterviewerEducationDetails[0].Graduation", (SelectList)Model.GraduationTypeList, new { @class = "form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.GraduationType, "", new { @class = "text-danger" })
                                                        </td>
                                                        <td>

                                                            @*<input class="form-control text-box single-line" id="collegeType" name="collegeType" type="text" value="" placeholder="College type drop down">*@

                                                            @Html.DropDownList("InterviewerEducationDetails[0].CollegeType", (SelectList)Model.CollegeTypeList, new { @class = "form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.CollegeType, "", new { @class = "text-danger" })
                                                        </td>
                                                        <td>
