                                            @Html.EditorFor(model => model.IsApproved, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                            @Html.ValidationMessageFor(model => model.IsApproved, "", new { @class = "text-danger" })


