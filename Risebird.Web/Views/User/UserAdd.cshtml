@model Risebird.Entities.Data.UserList
@{
    ViewData["Title"] = "UserAdd";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/User/Index'>Risebird User</a>&nbsp;/&nbsp;Add User";
    $('#txtpageHeader').empty().html(Header);
</script>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">

    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bg-white">
            <div class="col-md-12">
                <div class="mdc-card card bg-white">

                    <div class="mdc-card-wrapper__text-section">

                        @using (Html.BeginForm("Add", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Add User</h4></div>
                                </div>
                                <div style="width: 100%;">&nbsp;</div>

                                <div class="form-horizontal w-full">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <div class="col-md-4 col-sm-4 pr-1 pull-left">
                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.UserProfiles, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                <span class="red">*</span>
                                            </div>

                                            @Html.DropDownListFor(x => Model.IdProfile, Model.UserProfiles, "Select Profile", htmlAttributes: new { @class = "select-css form-control webkitEnabled", @onchange = "ClientblockActive()" })
                                            @Html.ValidationMessageFor(model => model.IdProfile, "", new { @class = "text-danger" })

                                        </div>
                                    </div>


                                    <div class="col-md-4 col-sm-4 px-1 pull-left">
                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                <span class="red">*</span>
                                            </div>

                                            @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })

                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-4 pl-1 pull-left">
                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })   <span class="red">*</span>
                                            </div>

                                            @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })

                                        </div>
                                    </div>


                                    <div class="col-md-4 col-sm-4 pr-1 pull-left rightpad">

                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                            </div>

                                            @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })

                                        </div>

                                    </div>


                                    <div class="col-md-4 col-sm-4 pl-1 pull-left rightpad">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                            @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 pl-1 pull-left">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.WhatsappNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(model => model.WhatsappNumber, new { @class = "form-control text-box single-line", @type = "number", @maxlength = "10", @minlength = "10", @placeholder = "Please enter Whatsapp no. without country code.Ex: 999999999" })
                                            @Html.ValidationMessageFor(model => model.WhatsappNumber, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-4 pr-1 pull-left" id="divclientname" style="display:none">
                                        <div class="form-group">
                                            <div class="mandate">
                                                @Html.Label("Clients", "Clients", htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            </div>
                                            <select id="ClientsArray" name="ClientsArray" class="form-control multiselect" multiple="multiple">
                                                @foreach (var item in Model.ClientList.ToList())
                                                {
                                                    @if (item != null)
                                                    {
                                                        @if (item.Selected)
                                                        {
                                                            <option value="@item.Value" selected>@item.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                            @Html.ValidationMessageFor(model => model.ClientsArray, "", new { @id = "err_clients", @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer ">
                                <div class="row">

                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "Index", "User", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                        @*<button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onclick="return CheckvalidationforProfile();" id="btnUpload" value="Submit">Submit</button>*@
                                    </div>
                                </div>
                            </div>


                        }
                    </div>
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

<script>
    $(document).ready(function () {
        ClientblockActive();
        $("#ClientsArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
    });
    function ClientblockActive() {
        if ($("#IdProfile").val() == "31") {
            document.getElementById("divclientname").style.display = "block";
        } else {
            document.getElementById("divclientname").style.display = "none";
        }
    }
</script>
