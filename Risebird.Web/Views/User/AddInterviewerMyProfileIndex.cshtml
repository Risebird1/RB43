@model Risebird.Entities.ViewModel.InterviewerProfileVM

@{
    ViewData["Title"] = "Add Interviewer Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Add Interviewer Profile form</a>
                <a class="navbar-brand">Add Interviewer My Profile </a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>

    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">

                        @using (Html.BeginForm("AddInterviewerMyProfile", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <!-- Add Interviewer personal Details Start-->
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Personal Details</h2>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group" style="display:none">
                                        @Html.Hidden("UserId", Model.UserId)
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                    </div>
                                   
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.AltEmailId, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.AltEmailId, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AltEmailId, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.AltMobileNumber, htmlAttributes: new { @class = "control-label col-md-8 col-sm-8 col-lg-8 desp-label" })
                                        @Html.EditorFor(model => model.AltMobileNumber, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AltMobileNumber, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.City, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.City, new { htmlAttributes = new { id = "txt_City", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="" id="uploadDiv">
                                        @Html.LabelFor(model => model.ResumeFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.TextBoxFor(model => model.ResumeFile, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                    </div>
                                    <div>
                                        @if (Model.ResumeLink != null)
                                        {
                                            <a id="resumeId" target="_blank" title="Resume" href=@Model.ResumeLink>Resume  </a>
                                        }
                                    </div>
                                    @Html.HiddenFor(m => m.ResumeLink, Model.ResumeLink)
                                </div>
                                <!-- INterviewer personal Details End-->
                                <!-- Availability Details start-->
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Availability Details</h2>
                                        </div>
                                    </div>
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered mbn" id="availabilityDetailsTable">
                                                <thead class="tableHeaderClass">
                                                    <tr>
                                                        <th width="20%" class="table_heading">Slot</th>
                                                        <th width="20%" class="table_heading">Week Day</th>
                                                        <th width="20%" class="table_heading">Start Date</th>
                                                        <th width="20%" class="table_heading">End Date</th>
                                                        <th width="10%" class="table_heading">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.InterviewerAvailabilityDetails == null || Model.InterviewerAvailabilityDetails.Count() == 0)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DropDownList("InterviewerAvailabilityDetails[0].SlotTime", (SelectList)Model.DayTimeSlotList, new { @class = "form-control text-box single-line" })
                                                            </td>
                                                            <td>
                                                                @Html.DropDownList("InterviewerAvailabilityDetails[0].SlotDay", (SelectList)Model.DaySlotList, new { @class = "form-control text-box single-line" })
                                                            </td>
                                                            <td>
                                                                @Html.TextBox("InterviewerAvailabilityDetails[0].StartDate", null, new { id = "txt_StartDate", @class = "form-control text-box single-line", type = "date" })
                                                            </td>
                                                            <td>
                                                                @Html.TextBox("InterviewerAvailabilityDetails[0].EndDate", null, new { id = "txt_EndDate", @class = "form-control text-box single-line", type = "date" })
                                                            </td>
                                                            <td>
                                                                <span id="btnPlus" onclick="addAvailabilityDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="deleteRowAvailabilityDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>
                                                            </td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        for (int i = 0; i < Model.InterviewerAvailabilityDetails.Count(); i++)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @Html.DropDownListFor(m => m.InterviewerAvailabilityDetails[i].SlotTime, (SelectList)Model.DayTimeSlotList, new { @class = "form-control text-box single-line" })
                                                                </td>
                                                                <td>
                                                                    @Html.DropDownListFor(m => m.InterviewerAvailabilityDetails[i].SlotDay, (SelectList)Model.DaySlotList, new { @class = "form-control text-box single-line" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.InterviewerAvailabilityDetails[0].StartDate, null, new { id = "txt_StartDate", @class = "form-control text-box single-line", type = "date" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.InterviewerAvailabilityDetails[0].EndDate, null, new { id = "txt_EndDate", @class = "form-control text-box single-line", type = "date" })
                                                                </td>
                                                                <td>
                                                                    <span id="btnPlus" onclick="addAvailabilityDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                    <span id="btnMinus" onclick="deleteRowAvailabilityDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                            <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:815px"></label>
                                        </div>
                                    </div>
                                </div>
                                <!-- Availabality Details end-->
                                <!-- Account Details start-->
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Account Details</h2>
                                        </div>
                                    </div>

                                    <div class="col-md-2 col-sm-2 pr-1">
                                        <div class="form-group">
                                            <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="accountHolderName">Account Holder Name</label>
                                            @Html.TextBoxFor(m => m.InterviewerAccDetails.AccountName, null, new { @class = "form-control text-box single-line" })
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-2 px-1">
                                        <div class="form-group">
                                            <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="accountNum">Account number</label>
                                            @Html.TextBoxFor(m => m.InterviewerAccDetails.AccountNumber, null, new { Id = "txt_AccountNumber", @class = "form-control text-box single-line" })
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-2 px-1">
                                        <div class="form-group">
                                            <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="accountNum">Confirm Account Number</label>
                                            @Html.TextBox("ConfirmAccountNumber", null, new { Id = "txt_ConfirmAccountNumber", @class = "form-control text-box single-line" })
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-2pr-1">
                                        <div class="form-group">
                                            <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="ifsce">IFSC Code</label>
                                            @Html.TextBoxFor(m => m.InterviewerAccDetails.IFSCCode, null, new { @class = "form-control text-box single-line" })
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-sm-2 px-1">
                                        <div class="form-group">
                                            <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="accountNum">Location</label>
                                            @Html.TextBoxFor(m => m.InterviewerAccDetails.AccountLocation, null, new { @class = "form-control text-box single-line" })
                                        </div>
                                    </div>


                                    
                                </div>
                                <!-- Account Details End-->
                                <div class="card-footer-button ">
                                    <div class="row">
                                        <label class="col-md-2"></label>
                                        <div class="col-md-6">
                                            <input type="submit" value="Submit" class="btn btn-fill btn-primary" />
                                           
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                        <div class=" col-md-3">
                            @Html.ActionLink("Back", "Interviewers", "User", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                        </div>
                    </div>
                </div>
            </div>

           
        </div>
    </div>

    <script>

        $(document).ready(function () {
            $("#txt_ConfirmAccountNumber").change(function () {
                var firstInput = document.getElementById("txt_AccountNumber").value;
                var secondInput = document.getElementById("txt_ConfirmAccountNumber").value;
                if (firstInput !== secondInput) 
                    alert("Account Number Not match!");
            });
        });

        function addAvailabilityDetails() {
            var x = document.getElementById('availabilityDetailsTable');
            var rowLen = x.rows.length;
          
            if (rowLen > 14) {
                alert("Cannot add more than 14 Availability Detaiils.");
                return;
            }
            else {
                var new_row = x.rows[1].cloneNode(true);
                x.appendChild(new_row);
            }
        }

        function deleteRowAvailabilityDetails(row) {
            var x = document.getElementById('availabilityDetailsTable');
            // get the total number of rows
            var rowLen = x.rows.length;
            
            if (rowLen == 2) {
                alert('Must have atleast one Row');
                return false;
            }
            else {
                var i = row.parentNode.parentNode.rowIndex;
                document.getElementById('availabilityDetailsTable').deleteRow(i);
            }
        }

    </script>
