@model IEnumerable<Risebird.Entities.ViewModel.QCInterviewerVM>
@{
    ViewData["Title"] = "QC Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">QCInterviewers</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">QCInterviewers</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <div class="text-right">
                                <button type="button" style="margin-top:-108px;" class="btn btn-primary"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add QC interviewer" onclick="location.href='@Url.Action("AddQCInterviewer","User")'" data-original-title="Tooltip on top"> Add QCInterviewer</span></button>
                            </div>
                        </div>
                        <table id="qcinterviewer" class="table table-striped table-bordered" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Email Id</th>
                                    <th>Mobile Number</th>
                                    <th>Primary Skills</th>
                                    <th>Resume Link</th>
                                    <th>Approved</th>
                                    <th>No Of Interview</th>
                                    <th>SuccessRate</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Email Id</th>
                                    <th>Mobile Number</th>
                                    <th>Primary Skills</th>
                                    <th>Resume Link</th>
                                    <th>Approved</th>
                                    <th>No Of Interview</th>
                                    <th>SuccessRate</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr id=@item.id>
                                        <td>@item.FirstName</td>
                                        <td>@item.LastName</td>
                                        <td>@item.EmailId</td>
                                        <td>@item.MobileNumber</td>
                                        <td><textarea>@item.PrimarySkill</textarea></td>
                                        <td class="text-center"><a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a></td>
                                        @if (@item.IsApproved == true)
                                        {
                                            <td>Approved</td>
                                        }
                                        else
                                        {
                                            <td>Not Approved</td>
                                        }

                                        <td>@item.NoOfInterview</td>
                                        <td>@item.SuccessRate</td>
                                        <td class="text-right">
                                            <span onclick="location.href = '@Url.Action("EditQCInterviewer", "User", new { id = item.id})'" title="Click here to edit QC interviewer" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                            <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.EmailId');" title="Click here to delete QC interviewer" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-trash-alt"></i></span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>


<script>
    $(document).ready(function () {




        $('#qcinterviewer').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });


        var table = $('#qcinterviewer').DataTable();


    });

    function DeleteEntityfromEnvironment(userId, EmailId) {

        //var confirmMessageBox = confirm('Are you sure you want to delete QC interviewer ' + EmailId + ' ?');
        //if (confirmMessageBox) {
        //    if (userId != '') {
        //        $.ajax({
        //            url: '/User/DeleteQCInterviewer',
        //            data: { 'id': userId },
        //            type: 'get',
        //            success: function (data) {
        //                window.location = data.url;
        //            }
        //        });
        //    }
        //}
        debugger;
        swal.fire({
            title: 'Are you sure you want to delete QC interviewer' + EmailId + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/User/DeleteQCInterviewer',
                        data: { 'id': userId },
                        type: 'get',                  
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>Your file has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/User/QCInterviewers";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>
