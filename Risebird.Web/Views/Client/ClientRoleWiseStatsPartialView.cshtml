@model IEnumerable<Risebird.Entities.ViewModel.StatsVM>
@using Risebird.Entities.Data;

<div id="tableID" class="second" style="overflow-x:scroll">
    <table id="listTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
        <thead>
            <tr>
                @if(ViewBag.RoleType == ClientRoleTypes.StaffingAgency)
                {
                    <th>Staffing Agency</th>
                }
                else 
                {
                    <th>Client HR</th>
                }
                <th>Total Meetings</th>
                <th>Total Completed</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Scheduled</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tfoot>
            <tr>
                @if(ViewBag.RoleType == ClientRoleTypes.StaffingAgency)
                {
                    <th>Staffing Agency</th>
                }
                else
                {
                    <th>Client HR</th>
                }
                <th>Total Meetings</th>
                <th>Total Completed</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Scheduled</th>
                <th>Actions</th>

            </tr>
        </tfoot>
        <tbody>

            @if (Model != null && Model.Count() > 0)
            {
                int i = 0;
                foreach (var item in Model)
                {

                    <tr>
                        @if (!string.IsNullOrEmpty(item.EmailId))
                        {
                            <td> @item.EmailId </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (item.TotalMeetings > 0)
                        {
                            <td title="Total Meetings">
                                <a title="Total Meetings" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.All, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">@item.TotalMeetings</a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalMeetings</td>
                        }
                        @if (item.TotalCompletedMeetings > 0)
                        {
                            <td title="Total Completed Meetings">
                                <a title="Total Completed Meetings" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Completed, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">@item.TotalCompletedMeetings</a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalCompletedMeetings</td>
                        }
                        @if (item.StatusPending > 0)
                        {
                            <td title="Status Pending">
                                <a title="Status Pending" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Pending, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalSelected > 0)
                        {
                            <td title="Total Selected">
                                <a title="Total Selected" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Selected, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalSelected { @(item.TotalCompletedMeetings != 0 ? (item.TotalSelected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalSelected { @(item.TotalCompletedMeetings != 0 ? (item.TotalSelected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        }

                        @if (item.TotalBorderLine > 0)
                        {
                            <td title="Total Borderline">
                                <a title="Total Borderline" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Borderline, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalBorderLine { @(item.TotalCompletedMeetings != 0 ? (item.TotalBorderLine * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalBorderLine</td>
                        }
                        @if (item.TotalRejected > 0)
                        {
                            
                            <td title="Total Rejected">
                                <a title="Total Rejected" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Rejected, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalRejected { @(item.TotalCompletedMeetings != 0 ? (item.TotalRejected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalRejected { @(item.TotalCompletedMeetings != 0 ? (item.TotalRejected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalProxy > 0)
                        {
                            <td title="Total Proxy">
                                <a title="Total Proxy" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Proxy, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalProxy { @(item.TotalCompletedMeetings != 0 ? (item.TotalProxy * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalProxy { @(item.TotalCompletedMeetings != 0 ? (item.TotalProxy * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalDropped > 0)
                        {
                            
                            <td title="Total Dropped">
                                <a title="Total Dropped" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Dropped, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalInterviewerNoShow > 0)
                        {
                            
                            <td title="No Show(Interviewer)">
                                <a title="No Show(Interviewer)" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Noshowinterviewer, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalInterviewerNoShow { @(item.TotalMeetings != 0 ? (item.TotalInterviewerNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalInterviewerNoShow { @(item.TotalMeetings != 0 ? (item.TotalInterviewerNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalNoShowCandidate > 0)
                        {
                            <td title="No Show(Candidate)">
                                <a title="No Show(Candidate)" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Noshowcandidate, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.TotalNoShowCandidate { @(item.TotalMeetings != 0 ? (item.TotalNoShowCandidate * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalNoShowCandidate { @(item.TotalMeetings != 0 ? (item.TotalNoShowCandidate * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }

                        @if (item.Scheduled > 0)
                        {
                            <td title="Scheduled">
                                <a title="Scheduled" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Scheduled, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = ViewBag.irfId, irfName = ViewBag.IRFName})">
                                    @item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }


                        @*<td>@item.TotalMeetings </td>
                        <td>@item.TotalCompletedMeetings </td>
                        <td>@item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalSelected { @(item.TotalCompletedMeetings != 0 ? (item.TotalSelected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalBorderLine { @(item.TotalCompletedMeetings != 0 ? (item.TotalBorderLine * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalRejected { @(item.TotalCompletedMeetings != 0 ? (item.TotalRejected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalProxy { @(item.TotalCompletedMeetings != 0 ? (item.TotalProxy * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalInterviewerNoShow { @(item.TotalMeetings != 0 ? (item.TotalInterviewerNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalNoShowCandidate { @(item.TotalMeetings != 0 ? (item.TotalNoShowCandidate * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        *@
                        <td class="text-center">
                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                            {
                                <span class="interviewer_14"><span class="call" data-toggle="tooltip" data-placement="top" onclick="CommonCallButtonClick('@item.EmailId', '@item.MobileNumber', '@item.EmailId')" data-original-title="Tooltip on top"><span title="Click here to call the interviewer" class="mdc-fab app-fab--absolute" style="top: -3px;left:1px;"><span class="fa fa-phone-alt"></span></span></span></span>

                            }


                        </td>


                    </tr>
                    i++;

                }
            }

        </tbody>

    </table>


    @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

</div>