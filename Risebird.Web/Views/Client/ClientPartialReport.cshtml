    function MeetingStatusChanged(value) {
        if (value != null && value != '') {
            document.getElementById('InterviewerComment').disabled = false;
            document.getElementById("interviewerComment_Error").innerHTML = "";

        }
        else {

            document.getElementById('InterviewerComment').value = '';
            document.getElementById('InterviewerComment').disabled = true;
            document.getElementById("interviewerComment_Error").innerHTML = "Select an appropriate value for Meeting Status above to add comments here.";

        }
        if (value != 2) {
            document.getElementById("meetingStatus_Error").innerHTML = "";
        }
        if (value != 4) {
            document.getElementById("InterviewStatus").value = '';
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById("InterviewStatus").disabled = false;
        }
    }

    function CheckConditions() {

        return (CheckInterviewStatus() && CheckMeetingStatus() && CheckInterviewerComments() && CheckQuestionsTiming());
    }

    function CheckInterviewerComments() {
        var interviewStatusElem = document.getElementById("InterviewStatus");
        if (interviewStatusElem.value == 2|| interviewStatusElem.value == 4) {
            var comments = document.getElementById("InterviewerComment").value;
            if (comments.length >= 250) {
                document.getElementById("interviewerComment_Error").innerHTML = "";
                return true;
            }
            else {
                //interviewerComment_Error
                document.getElementById("InterviewerComment").focus();
                document.getElementById("interviewerComment_Error").innerHTML="Kindly enter a minimum of 250 characters.";
                return false;
            }
        }
        else
            return true;
    }

    function CheckQuestionsTiming() {
     var interviewStatusElem = document.getElementById("InterviewStatus");
        if (interviewStatusElem.value == 2|| interviewStatusElem.value == 4)
        {
        var questionItems = $('[id^="QuestionsCollection"][id$="Timing"]');
        var oldVal = $("#QuestionsCollection_0__Timing").val();
        for (i = 0; i < questionItems.length; i++) {
            var temp = $("#QuestionsCollection_" + i + "__Timing").val();
            if (temp == null || temp == '') {
                document.getElementById('QuestionsCollection_TimingError').innerHTML = "Please fill exact timing of question discussed in seconds(value must be greater than 60) and it should be in ascending order."
                return false;
            }
            if (i > 0) {
                if (parseInt(temp) < parseInt(oldVal)) {
                    document.getElementById('QuestionsCollection_TimingError').innerHTML = "Please fill exact timing of question discussed in seconds(value must be greater than 60) and it should be in ascending order.";
                    return false;
                }
                else
                    oldVal = temp;
            }
        }
        document.getElementById('QuestionsCollection_TimingError').innerHTML = "";
        return true;
       }
      else
            return true;
    }




    function CheckMeetingStatus() {
        var meetingStatusElem = document.getElementById("MeetingStatus");
        if (meetingStatusElem.value == 2) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly change the Meeting Status to an appropriate value.";
            meetingStatusElem.focus();
            return false;
        }
        else {
            document.getElementById("meetingStatus_Error").innerHTML = "";
            return true;

        }

    }

    function CheckInterviewStatus() {
        var meetingStatusElem = document.getElementById("MeetingStatus");
        if (meetingStatusElem.value == 4) {
            var interviewStatusElem = document.getElementById("InterviewStatus");
            if (interviewStatusElem.value == null || interviewStatusElem.value == '') {
                document.getElementById("interviewStatus_Error").innerHTML = "Kindly change the Interview Status to an appropriate value.";
                interviewStatusElem.focus();
                return false;
            }
            else {
                document.getElementById("interviewStatus_Error").innerHTML = '';
            }

        }
        return true;
    }

