}
<style>
    .star-rating {
        border: solid 1px white;
        display: flex;
        direction: rtl;
        font-size: 2.0em;
        justify-content: space-around;
        padding: 0 .2em;
        text-align: center;
        width: 100%;
        margin-bottom: 10px;
        background-color: white;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            /*color: #ccc;*/
            color: #e4e4e4;
            cursor: pointer;
        }

        .star-rating :checked ~ label {
            color: #f90;
        }

        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #fc0;
        }

    .card-title-space {
        margin: 20px 0px;
        float: right
    }

    .mb10 {
        margin-bottom: 10px
    }

    .tox-notifications-container {
        display: none
    }
</style>
<script>
    var Header = "<div>Interview Report</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
