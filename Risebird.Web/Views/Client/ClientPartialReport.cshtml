    function CalculateOverAll(id, value) {
        var num = id.match(/(\d+)/);
        var index = num[0];
        value = parseInt(value);
        var skillName;
        if (id.includes("Tech")) {

            skillName = "TechSkillReportCollection";
        }

        else if (id.includes("General")) {

            skillName = "SkillGeneralReportCollection";
        }
        else if (id.includes("Joinability")) {

            skillName = "JoinabilityHRReportCollection";
        }
        else {

            skillName = "SelectabilityEvaluatorReportCollection";
        }
        var reqLevelId = skillName + "_" + index + "__RequiredLevelId"; //SkillGeneralReportCollection_0__RequiredLevel
        var required = $("#" + reqLevelId).val();
        if (required <= value) {
            var reqWeightage = $("#" + skillName + "_" + index + "__WeightageRequired").val();
            $("#" + skillName + "_" + index + "__WeightageActual").val(reqWeightage);
            $("#" + skillName + "_" + index + "__ActualLevelId").css("border-color", "#008000");

        }
        else {

            var reqWeightage = $("#" + skillName + "_" + index + "__WeightageRequired").val();
            var adjustedReqWeightage = Math.pow(0.5, (required - value)) * (reqWeightage);
            $("#" + skillName + "_" + index + "__WeightageActual").val(adjustedReqWeightage);
            $("#" + skillName + "_" + index + "__ActualLevelId").css("border-color", "red");
        }

        var items = $('[id$="WeightageActual"]');
        //var length = item.length;
        var totalCount = 0;

        for (i = 0; i < items.length; i++) {
            totalCount += parseInt(items[i].value);
        }
        //items.forEach(function (item) {
        //    totalCount = totalCount + item.val();
        //});
        var average = totalCount / 4;
        $("#OverallScore").val(average);

        SetChart();
    }

