<script>
    function setDate() {
        todayDate = getDate(0);
        monthAgoDate = getDate(-30);
        document.getElementById('interviewTrackingStartDate').value = monthAgoDate;
        document.getElementById('interviewTrackingEndDate').value = todayDate;
        //document.getElementById('statusTrackingDate').value = today;
        //ocument.getElementById('interviewSlotsDate').value = today;
        //document.getElementById('progressTrackingDate').value = today;
    }

    function getDate(addDays = 0) {
        var date = new Date();
        date.setDate(date.getDate() + addDays);
        var dd = date.getDate();
        var mm = date.getMonth() + 1; //January is 0!
        var yyyy = date.getFullYear();

        if (dd < 10) {
            dd = '0' + dd
        }

        if (mm < 10) {
            mm = '0' + mm
        }

        date = yyyy + '-' + mm + '-' + dd;
        return date;
    }
</script>
