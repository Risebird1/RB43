<script>
    function GetClientData(clientId = null) {
        var clientIdValue = clientId;
        if (clientId == null) {
            clientIdValue = document.getElementById('ClientId').value;
        }
        updateInterviewTracking(clientIdValue);
        GetDateRangeWiseMeetingStatusForClientRoles(clientIdValue);
    }

    function updateInterviewTracking(clientIdValue = null) {
        document.getElementById('area-chart').innerHTML = '';
        var startDateValue = document.getElementById('interviewTrackingStartDate').value;
        var endDateValue = document.getElementById('interviewTrackingEndDate').value;
        //var clientId;
        //if (clientIdValue == null)
        //{
        //    clientId = document.getElementById('ClientId').value;
        //}
        //else
        //{
        //    clientId = clientIdValue;
        //}
        if (startDateValue == null || startDateValue == '') {
            startDateValue = getDate(-30);
        }
        if (endDateValue == null || endDateValue == '') {
            endDateValue = getDate(0);
        }
        $.ajax({
            url: '/Client/GetDateRangeWiseClientInterviews',
            async: true,
            data: { 'startDateValue': startDateValue, 'endDateValue': endDateValue, 'emailId': '@Model.EmailId', 'clientId': clientIdValue },
            success: function (data) {

                UpdateInterviewTrackingGraph(JSON.parse(data.meetingsData), JSON.parse(data.meetingsDataLabels));
            }
        });
    }

    function UpdateInterviewTrackingGraph(meetingsData, meetingsDataLabels) {

        config = {
            data: meetingsData,
            xkey: 'Date',
            ykeys: meetingsDataLabels,
            labels: meetingsDataLabels,
            resize: true,
            hideHover: true,
            parseTime: false,
            xLabels: 'day',
            yLabelFormat: function (y) { return y != Math.round(y) ? '' : y; },
            gridTextSize: '10px',
            //lineColors: ['#1caf9a', '#33414E'],
            gridLineColor: '#E5E5E5'
        };
        config.element = 'area-chart';
        Morris.Area(config);

    }
</script>


<script>

    function GetDateRangeWiseMeetingStatusForClientRoles(clientIdValue) {
        var startDateValue = document.getElementById('interviewTrackingStartDate').value;
        var endDateValue = document.getElementById('interviewTrackingEndDate').value;
        //var clientId;
        //if (clientIdValue == null) {
        //    clientId = document.getElementById('ClientId').value;
        //}
        //else {
        //    clientId = clientIdValue;
        //}
        if (startDateValue == null || startDateValue == '') {
            startDateValue = getDate(-30);
        }
        if (endDateValue == null || endDateValue == '') {
            endDateValue = getDate(0);
        }
        $.ajax({
            url: '/Client/GetDateRangeWiseMeetingStatusForClientRoles',
            async: true,
            data: { 'startDateValue': startDateValue, 'endDateValue': endDateValue, 'clientId': clientIdValue },
            success: function (data) {
                $('#id_roleWiseMeetingResults').html('');
                $('#id_roleWiseMeetingResults').html(data);

            }
        });
    }

</script>
