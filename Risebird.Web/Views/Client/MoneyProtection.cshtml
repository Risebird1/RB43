@model IEnumerable<Risebird.Entities.ViewModel.MoneyProtectionVM>
@{
    ViewData["Title"] = "Payment Protection";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> </h4></div>
                </div>
                <div class="pull-left">
                    @if (ViewBag.Type == "Completed")
                    {
                        <div class="feedback-tab" onclick="Changeurldetails('Pending')"><strong>Pending</strong></div>
                        <div class="feedback-tab-ac" onclick="Changeurldetails('Completed')"><strong>Completed</strong></div>
                    }
                    else
                    {
                        <div class="feedback-tab-ac" onclick="Changeurldetails('Pending')"><strong>Pending</strong></div>
                        <div class="feedback-tab" onclick="Changeurldetails('Completed')"><strong>Completed</strong></div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <td>Client</td>
                                                    <td>Billing Type</td>
                                                    <td>Points</td>
                                                    <td>Action</td>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <td>Client</td>
                                                    <td>Billing Type</td>
                                                    <td>Points</td>
                                                    <td>Action</td>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.ClientName</td>
                                                        <td>@item.BillingType</td>
                                                        <td>@item.Point</td>
                                                        <td>
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Detail View">
                                                                <span onclick="DetailedView('@ViewBag.Type','@item.id','@item.ClientName')" title="Detail View" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                    </svg>
                                                                </span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <!-- end content-->
                        </div>
                        <!-- end col-md-12 -->
                    </div>
                    <!-- end row -->
                </div>
            </div>
        </div>
    </div>
</div>
<div id="MoneyProtectionDetailsModel" class="modal modal-bg" style="z-index:3">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document" style="max-width: 1050px !important;">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-lightbulb" viewBox="0 0 16 16"> <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z" fill="white"></path> </svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Detailed View </h5><span id="txtheaderMoneyProtection" style="margin-right:25px;"></span>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeMoneyProtectionDetailsModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="divMoneyProtectionmodel">
            </div>
        </div>
    </div>
</div>
<script>
    function RefreshSearch() {
        $('#meetingTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meetingTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter input:eq(0)").after("<span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function Changeurldetails(type) {
        window.location.href = "/Client/MoneyProtection?actionstatus=" + type;
    }
    function DetailedView(actionstatus, clientid, ClientName) {
        $.ajax({
            url: '/Client/MoneyProtectionDetailsView',
            data: { 'type': actionstatus, 'Clientid': clientid },
            type: "GET",
            success: function (data) {
                openInterviewerInsightsModel();
                $('#divMoneyProtectionmodel').html('');
                $('#divMoneyProtectionmodel').html(data);
                $("#txtheaderMoneyProtection").text('( ' + ClientName + ' )');
            }
        });
    }
    function closeMoneyProtectionDetailsModel() {
        var modal = document.getElementById("MoneyProtectionDetailsModel");
        modal.style.display = "none";
    }
    function openInterviewerInsightsModel() {
        var modal = document.getElementById("MoneyProtectionDetailsModel");
        modal.style.display = "block";
    }
</script>
<script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>