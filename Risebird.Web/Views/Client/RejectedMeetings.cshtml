<script>
    function closemyRaitingPopup() {
        var modal = document.getElementById("myRaitingPopup");
        modal.style.display = "none";
    }
    function openpopUpRating(candidate, interviewid) {
        $("#txtratingCandidate").text(candidate);
        $("#txtratinginterviewid").val(interviewid);
        $.ajax({
            url: '/RiseTube/FetchRaitingDetails',
            type: "POST",
            data: { 'imid': interviewid },
            success: function (data) {
                $("#txtratingvalue").val(data.starRating);
                $("#txtratingComment").val(data.comment);
                var modal = document.getElementById("myRaitingPopup");
                modal.style.display = "block";
                setRating(data.starRating);
            }
        });

    }
    function ChangeRating(value) {
        $("#txtratingvalue").val(value);
    }
    function SaveRating() {
        var interviewid = $("#txtratinginterviewid").val();
        var ratingvalue = $("#txtratingvalue").val();
        var comments = $("#txtratingComment").val();
        if (parseInt(ratingvalue) > 0) {
            $.ajax({
                url: '/RiseTube/SaveRaitingDetails',
                type: "POST",
                data: { 'imid': interviewid, 'rating': ratingvalue, 'comment': comments },
                success: function (data) {
                    swal.fire(data);
                    var modal = document.getElementById("myRaitingPopup");
                    modal.style.display = "none";
                }
            });
        } else {
            swal.fire("Rating is required.");
        }
    }
    function setRating(starRating) {
        if (starRating != '' && parseInt(starRating) > 0) {
            document.getElementById("Q1_" + starRating).checked = true;
        } else {
            for (i = 1; i <= 5; i++) {
                document.getElementById("Q1_" + i).checked = false;
            }
        }
    }

</script>
<script>
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function CallButtonClick(candidateName, mobileNumber) {
        candidate = candidateName;
        // Get the modal
        var modal = document.getElementById("myCallModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(mobileNumber);
    }
    function CallButtonClickjson(imid) {
        var candidate = $("#hidcandidate_" + imid).val();
        var mobile = $("#hidmobile" + imid).val();
        CallButtonClick(candidate, mobile);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
</script>
