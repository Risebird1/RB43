@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "Not Scheduled Candidates";
    ViewBag.PageHeader = "Not Scheduled Candidates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div>Not Scheduled Meetings</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=9" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Not Scheduled Meetings</h4></div>
                </div>
                <div class="pull-right client-ms">
                    <div style="float:left">

                    </div>
                    <div style="float:left">
                    </div>
                </div>
                @*<div class="note-filter" style="text-align: right;"> Note: To visualize data older than 30 days, please apply filter</div>*@
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <div class="notschedulemeeting">
                                                    <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                        <thead>
                                                            <tr>
                                                                <th style="border-left: 0px !important;" id='start'>Skill Channel ID</th>
                                                                <th>Candidate Detail</th>
                                                                <th>Resume</th>
                                                                <th>Client HR</th>
                                                                <th>Invite</th>
                                                                <th>Call</th>
                                                            </tr>
                                                        </thead>
                                                        <tfoot>
                                                            <tr>
                                                                <th style="border-left: 0px !important;" id='start'>Skill Channel ID</th>
                                                                <th>Candidate Detail</th>
                                                                <th>Resume</th>
                                                                <th>Client HR</th>
                                                                <th>Invite</th>
                                                                <th>Call</th>
                                                            </tr>
                                                        </tfoot>
                                                        <tbody>
                                                            @if (Model.Count() == 0)
                                                            {
                                                                <tr>
                                                                    <td colspan="5" class="text-center">No data available in table</td>
                                                                </tr>
                                                            }
                                                            @foreach (var item in Model)
                                                            {
                                                                <tr data-changes="1">
                                                                    <td class="candidate-skill"> @item.IRFId </td>
                                                                    <td class="candidate-details">
                                                                        @if (item.candidateName != null && item.candidateName != "")
                                                                        {
                                                                            <div class="mtop-5">@item.candidateName</div>
                                                                        }
                                                                        else
                                                                        {
                                                                        }
                                                                        @if (item.candidateEmail != null && item.candidateEmail != "")
                                                                        {
                                                                            <div class="mtop-5"><strong>Email:</strong> @item.candidateEmail</div>
                                                                        }
                                                                        else
                                                                        {
                                                                        }
                                                                        @if (item.JDTiltle != null && item.JDTiltle != "")
                                                                        {
                                                                            <div class="mtop-5"><strong>Jd Title:</strong> @item.JDTiltle</div>
                                                                        }
                                                                        else
                                                                        {
                                                                        }
                                                                    </td>


                                                                    @if (!String.IsNullOrEmpty(item.resumeLink))
                                                                    {
                                                                        <td><a target="_blank" href=@item.resumeLink>Resume</a></td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td></td>
                                                                    }
                                                                    <td>@item.ClientHrContact</td>
                                                                    <td><button class="send-btn" onclick="Sendinvite(@item.imid,'@item.IRFId','@item.candidateEmail')">Send</button></td>
                                                                    <td class="text-left">
                                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                        {
                                                                            <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CallButtonClick('@item.candidateName', '@item.MobileNumber')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span></span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>


<div id="myCallModal" class="modal  modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content ">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Call Candidate !</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body">
                <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>
                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin-left:43%" class="btn btn-fill btn-danger" value="Hang Up">
            </div>
        </div>
    </div>
</div>

<script>
    function Sendinvite(id, IRFId, CandidateEmail) {
        $.ajax({
            url: '/Client/SendInvite',
            type: 'POST',
            data: { 'irfId': id, 'IRFName': IRFId, 'emailId': CandidateEmail },
            success: function (data) {
                alert(data);
            }
        });
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>


<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>

<script>



    $('#meeting tbody').on('click', 'td.detail-control', function () {
        var tr = $(this).closest('tr');
        var row = table.row(tr);
        if (row.child.isShown()) {
            // This row is already open - close it
            row.child.hide();
            tr.removeClass('show');
        }
        else {
            // Open this row
            row.child(format(row.data())).show();
            tr.addClass('show');
        }
    });


</script>
<script>
    $(".candidateName").each(function () {
        if ($(this).text().length > 20) {
            $(this).text($(this).text().substr(0, 20) + "..")

            $('[role="data-tooltip"]').css("visibility", "visible");

        }


        else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
    });


    $(".candidateSkill").each(function () {
        if ($(this).text().length > 13) {
            $(this).text($(this).text().substr(0, 13) + "..")

            $('[role="data-tooltip"]').css("visibility", "visible");

        }


        else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
    });
    $(".candidateEmail").each(function () {
        if ($(this).text().length > 22) {
            $(this).text($(this).text().substr(0, 22) + "..")
            $('[role="data-tooltip"]').css("visibility", "visible");
        }
        else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
    });
</script>

<script>
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function CallButtonClick(candidateName, mobileNumber) {
        candidate = candidateName;
        // Get the modal
        var modal = document.getElementById("myCallModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(mobileNumber);
    }

    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
</script>

