@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Risebird.CommonHelper

@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Not Scheduled Candidates";
    ViewBag.PageHeader = "Not Scheduled Candidates";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] RFID = new string[] { };
    string[] primarySkills = new string[] { };
    string[] ClientHR = new string[] { };
    string[] ClientName = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("NotScheduledMeetingsfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("NotScheduledMeetingsfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
}
<script>
    var Header = "<div>Not Scheduled Candidates</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=9" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css" />
@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"Client\"")
{
    @if (HttpContextAccessor.HttpContext.Session.GetString("NNotScheduleCandidate") != null)
    {

    }
    else
    {
        <script src="https://code.jquery.com/jquery-1.9.1.min.js"></script>
        <script src="~/Newassets/js/chardinjs.js"></script>
        <script src="~/Newassets/js/demo.js"></script>
        HttpContextAccessor.HttpContext.Session.SetString("NNotScheduleCandidate", "1");

    }


}

@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("ClientRole") == ClientRoleEnum.RestrictedIRFowner.GetDescription())
{
    @if (HttpContextAccessor.HttpContext.Session.GetString("NNotScheduleCandidate") != null)
