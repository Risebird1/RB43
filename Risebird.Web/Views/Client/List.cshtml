@model IEnumerable<Risebird.Entities.Data.Client>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Client";
    ViewBag.PageHeader = "Client";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
    
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Clients</h4></div>
                </div>

                <div class="pull-right">

                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add client" onclick="location.href='@Url.Action("AddClient","Client")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Client</font></span>
                    </button>

                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row  bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <table id="skillLevel" class="table table-striped table-bordered" cellspacing="0" style="width:100%;">
                                <thead>
                                    <tr>

                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>GST</th>
                                        <th>Address</th>
                                        <th>RB Pay Balance</th>
                                        <th>Logo</th>
                                        <th>URL</th>
                                        <th>Company Video(GIF)</th>

                                        <th class="disabled-sorting text-right">Actions</th>
                                        <th hidden></th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>

                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>GST</th>
                                        <th>Address</th>
                                        <th>RiseBird Pay Balance</th>
                                        <th>Logo</th>
                                        <th>URL</th>
                                        <th>Company Video(GIF)</th>

                                        <th class="disabled-sorting text-right">Actions</th>
                                        <th hidden></th>
                                    </tr>
                                </tfoot>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                    <tr id=@item.id>

                                        <td>@item.Name</td>
                                        <td>
                                            <div id="section">
                                                @if (item.Description != null && item.Description != "")
                                                {
                                                    @if (item.Description.Length > 24)
                                                    {
                                                        <div class="article">
                                                            <p style="margin-bottom:0px;">
                                                                @item.Description.Substring(0, 24)
                                                            </p>
                                                            <p class="moretext_@item.id moretext">
                                                                @item.Description.Substring(24, @item.Description.Length - 24)
                                                            </p>
                                                        </div> <a onclick="moreless(@item.id)" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                    }
                                                    else
                                                    {
                                                        <div class="article">

                                                            <p>
                                                                @item.Description.Substring(0, @item.Description.Length)
                                                            </p>
                                                        </div>
                                                    }}
                                                else
                                                { <div></div>}





                                            </div>
                                        </td>
                                        <td>@item.GST</td>
                                        <td style="white-space:normal;">@item.OfficeAddress</td>
                                        <td>@item.Balance</td>
                                        @if (item.LogoLink != null && item.LogoLink != "")
                                        {
                                            <td>

                                                <a target="_blank" title="Logo" href=@item.LogoLink>Logo</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No Logo</td>
                                        }

                                        @if (item.CompanyLink != null && item.CompanyLink != "")
                                        {
                                            <td>

                                                <a target="_blank" title="Company URL" href=@item.CompanyLink>Company URL</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No URL</td>
                                        }

                                        @if (item.CompanyVideoLink != null && item.CompanyVideoLink != "")
                                        {
                                            <td>

                                                <a target="_blank" title="Company Video URL(GIF)" href=@item.CompanyVideoLink>Video URL(GIF)</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No Video(GIF)</td>
                                        }

                                        <td class="text-right" style="padding-right:30px;">

                                            <button class="mdc-fab app-fab--absolute" aria-label="Add Points">
                                                <span onclick="OpenAddpointmodel(@item.id)" title="Add Points" class="fa fa-plus-circle"></span>
                                            </button>
                                            <button class="mdc-fab app-fab--absolute" aria-label="Deduct Points">
                                                <span onclick="OpenDeductpointmodel(@item.id)" title="Deduct Points" class="fa fa-minus-circle"></span>
                                            </button>

                                            <button class="mdc-fab app-fab--absolute" aria-label="View Details">
                                                <span onclick="location.href = '@Url.Action("ClientDetails", "RisebirdPay", new { id = item.id})'" title="View Details" class="fa fa-fw fa-eye"></span>
                                            </button>

                                            <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit client user">
                                                <span onclick="location.href = '@Url.Action("EditClient", "Client", new { id = item.id})'" title="Click here to edit client" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                            </button>
                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete client">
                                                <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.Name');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                            </button>


                                        </td>

                                        <td hidden>@item.id</td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>


<div id="Addpointmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i style=" font-size: 23px;" class="fas fa-coins publicsharing-icon"></i>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Add Points</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseAddpointmodel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Points</label>
                        <input type="number" id="txtpoints" class="form-control" />
                        <input type="hidden" id="txtClientid" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Comments</label>
                        <input type="text" id="txtcomment" class="form-control" />
                    </div>
                </div>
                <div class="col-md-12 mt-10">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="AddPoints()" class="mdc-button mdc-button--raised mdc-ripple-upgraded  card-title-space" value="Add Points">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="CloseAddpointmodel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="Deductpointmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i style=" font-size: 23px;" class="fas fa-coins publicsharing-icon"></i>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Deduct Points</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseDeductpointmodel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Points</label>
                        <input type="number" id="txtpointsdeduct" class="form-control" />
                        <input type="hidden" id="txtClientiddeduct" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Comments</label>
                        <input type="text" id="txtcommentdeduct" class="form-control" />
                    </div>
                </div>
                <div class="col-md-12 mt-10 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="DeductPoints()" class="mdc-button mdc-button--raised mdc-ripple-upgraded  card-title-space" value="Deduct Points">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="CloseDeductpointmodel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>







@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}
<script>

    function RefreshSearch() {
        $('#skillLevel').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#skillLevel').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }





    $(document).ready(function () {


        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });
    function DeleteEntityfromEnvironment(clientId, Name) {

        //var confirmMessageBox = confirm('Are you sure you want to delete client ' + Name + ' ?');
        //if (confirmMessageBox) {
        //    if (clientId != '') {
        //        $.ajax({
        //            url: '/Client/DeleteClient',
        //            data: { 'id': clientId },
        //            type: 'get',
        //            success: function (data) {
        //                window.location = data.url;
        //            }
        //        });
        //    }
        //}

        swal.fire({
            title: 'Are you sure you want to delete client ' + Name + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Client/DeleteClient',
                        data: { 'id': clientId },
                        type: 'get',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>Your record has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Client/List";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#skillLevel").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#skillLevel").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#skillLevel").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function OpenAddpointmodel(id) {
        var model = document.getElementById("Addpointmodel");
        model.style.display = 'block';
        $("#txtClientid").val(id);
    }
    function CloseAddpointmodel() {
        var model = document.getElementById("Addpointmodel");
        model.style.display = 'none';
    }
    function AddPoints() {
        var point = $("#txtpoints").val();
        if (point.trim() != "" && parseInt(point) > 0) {
            $.ajax({
                type: "POST",
                url: "/RisebirdPay/AddWalletPoints",
                data: { points: point, comment: $("#txtcomment").val(), ClientId: $("#txtClientid").val() },
                success: function (data) {
                    if (data == "Success") {
                        alert("Points added successfully.");
                        CloseAddpointmodel();
                        initialcall();
                    } else if (data == "failed") {
                        alert("Fail to add points");
                    }
                }
            });
        } else {
            alert("Please Enter valid value in point field.");
        }
    }
    function OpenDeductpointmodel(id) {
        var model = document.getElementById("Deductpointmodel");
        model.style.display = 'block';
        $("#txtClientiddeduct").val(id);
    }
    function CloseDeductpointmodel() {
        var model = document.getElementById("Deductpointmodel");
        model.style.display = 'none';
    }
    function DeductPoints() {
        var point = $("#txtpointsdeduct").val();
        if (point.trim() != "" && parseInt(point) > 0) {
            $.ajax({
                type: "POST",
                url: "/RisebirdPay/DeductWalletPoints",
                data: { points: point, comment: $("#txtcommentdeduct").val(), ClientId: $("#txtClientiddeduct").val() },
                success: function (data) {
                    if (data == "Success") {
                        alert("Points deduct successfully.");
                        CloseDeductpointmodel();
                        initialcall();
                    } else if (data == "failed") {
                        alert("Fail to add points");
                    }
                }
            });
        } else {
            alert("Please Enter valid value in point field.");
        }
    }
    function initialcall() {
        var url = "List";
        window.location.href = url;
    }
</script>
<script>
    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>