@model IEnumerable<Risebird.Entities.ViewModel.IRF>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Recruiter Report";
    ViewBag.PageHeader = "Recruiter Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Recruiter Report</h4></div>
                </div>

                <div class="pull-right">

                    @*<button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("AddClient","Client")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Client</font></span>
                        </button>*@

                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row  bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <table id="skillLevel" class="table table-striped table-bordered" cellspacing="0" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Recruiter</th>
                                        <th>Skill Channel</th>
                                        <th>Job Title</th>
                                        <th>Total Completed</th>
                                        <th>Selected</th>
                                        <th>Rejected</th>
                                        <th>Selection Rate</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th>Recruiter</th>
                                        <th>Skill Channel</th>
                                        <th>Job Title</th>
                                        <th>Total Completed</th>
                                        <th>Selected</th>
                                        <th>Rejected</th>
                                        <th>Selection Rate</th>
                                    </tr>
                                </tfoot>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.ClientHrContact</td>
                                            <td>@item.IRFId</td>
                                            <td>
                                                <div id="section">
                                                    @if (item.JDTiltle != null && item.JDTiltle != "")
                                                    {
                                                        @if (item.JDTiltle.Length > 24)
                                                        {
                                                            <div class="article" title="@item.JDTiltle">
                                                                <p style="margin-bottom:0px;">
                                                                    @item.JDTiltle.Substring(0, 24)...
                                                                </p>
                                                                @*<p class="moretext_@item.id moretext">
                                                                    @item.JDTiltle.Substring(24, @item.JDTiltle.Length - 24)
                                                                </p>*@
                                                            </div> @*<a onclick="moreless(@item.id)" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>*@
                                                        }
                                                        else
                                                        {
                                                            <div class="article">
                                                                <p>
                                                                    @item.JDTiltle
                                                                </p>
                                                            </div>
                                                        }}
                                                    else
                                                    { <div></div>}
                                                </div>
                                            </td>
                                            
                                            <td>@item.ScheduledMeetings</td>
                                            <td>@item.SelectedMeetings</td>
                                            <td>@item.RejectedMeetings</td>
                                            @if (@item.ScheduledMeetings != null && @item.ScheduledMeetings != 0)
                                            {
                                                <td>@(Convert.ToInt32(item.SelectedMeetings)*100/item.ScheduledMeetings)</td>
                                            }
                                            else
                                            {
                                                <td>0</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}
<script>

    function RefreshSearch() {
        $('#skillLevel').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#skillLevel').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }





    $(document).ready(function () {


        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#skillLevel").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#skillLevel").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#skillLevel").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>