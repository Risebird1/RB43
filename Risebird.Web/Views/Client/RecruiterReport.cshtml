@model IEnumerable<Risebird.Entities.ViewModel.IRF>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Recruiter Report";
    ViewBag.PageHeader = "Recruiter Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
}
@if (HttpContextAccessor.HttpContext.Session.GetString("RecruiterReportfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("RecruiterReportfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Recruiter Report</h4></div>
                </div>

                <div class="pull-right">
                    <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                        <span class="mdc-button__label"><span class="fa fa-filter" data-bs-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                        <div class="mdc-button__ripple"></div>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row  bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("RecruiterReport","Client")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>
                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <table id="skillLevel" class="table table-striped table-bordered" cellspacing="0" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Recruiter</th>
                                        <th>Skill Channel</th>
                                        <th>Job Title</th>
                                        <th>Total Completed</th>
                                        <th>Selected</th>
                                        <th>Rejected</th>
                                        <th>Selection Rate</th>
                                        @if (ViewBag.ButtonAccess)
                                        {
                                            <th>Action</th>
                                        }
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th>Recruiter</th>
                                        <th>Skill Channel</th>
                                        <th>Job Title</th>
                                        <th>Total Completed</th>
                                        <th>Selected</th>
                                        <th>Rejected</th>
                                        <th>Selection Rate</th>
                                        @if (ViewBag.ButtonAccess)
                                        {
                                            <th>Action</th>
                                        }
                                    </tr>
                                </tfoot>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.ClientHrContact</td>
                                            <td>@item.IRFId</td>
                                            <td>
                                                <div id="section">
                                                    @if (item.JDTiltle != null && item.JDTiltle != "")
                                                    {
                                                        @if (item.JDTiltle.Length > 24)
                                                        {
                                                            <div class="article" title="@item.JDTiltle">
                                                                <p style="margin-bottom:0px;">
                                                                    @item.JDTiltle.Substring(0, 24)...
                                                                </p>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="article">
                                                                <p>@item.JDTiltle</p>
                                                            </div>
                                                        }}
                                                    else
                                                    { <div></div>}
                                                </div>
                                            </td>

                                            <td>@item.ScheduledMeetings</td>
                                            <td>@item.SelectedMeetings</td>
                                            <td>@item.RejectedMeetings</td>
                                            @if (@item.ScheduledMeetings != null && @item.ScheduledMeetings != 0)
                                            {
                                                <td>@(Convert.ToInt32(item.SelectedMeetings)*100/item.ScheduledMeetings)</td>
                                            }
                                            else
                                            {
                                                <td>0</td>
                                            }
                                            @if (ViewBag.ButtonAccess)
                                            {
                                                <td>
                                                    @*@if (item.IsPaused)
                                                        {
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Play Skill Channel">
                                                                <span onclick="PlayIRF('@item.id', '@item.IRFId');" title="Play Skill Channel" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Pause Skill Channel">
                                                                <span onclick="PauseIRF('@item.id', '@item.IRFId');" title="Pause Skill Channel" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg></span>
                                                            </button>
                                                        }*@
                                                    @if (!item.IsRecruiterActive)
                                                    {
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Active the Recruiter">
                                                            <span onclick="ActiveRecruiter('@item.UserId', '@item.ClientId');" title="Active the Recruiter" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z" /></svg></span>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Disable the Recruiter">
                                                            <span onclick="DisableRecruiter('@item.UserId', '@item.ClientId');" title="Disable the Recruiter" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M2.23 4.35A6.004 6.004 0 0 0 2 6c0 1.691.7 3.22 1.826 4.31.203.196.359.4.453.619l.762 1.769A.5.5 0 0 0 5.5 13a.5.5 0 0 0 0 1 .5.5 0 0 0 0 1l.224.447a1 1 0 0 0 .894.553h2.764a1 1 0 0 0 .894-.553L10.5 15a.5.5 0 0 0 0-1 .5.5 0 0 0 0-1 .5.5 0 0 0 .288-.091L9.878 12H5.83l-.632-1.467a2.954 2.954 0 0 0-.676-.941 4.984 4.984 0 0 1-1.455-4.405l-.837-.836zm1.588-2.653.708.707a5 5 0 0 1 7.07 7.07l.707.707a6 6 0 0 0-8.484-8.484zm-2.172-.051a.5.5 0 0 1 .708 0l12 12a.5.5 0 0 1-.708.708l-12-12a.5.5 0 0 1 0-.708z" /></svg></span>
                                                        </button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}
<script>

    function RefreshSearch() {
        $('#skillLevel').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#skillLevel').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }





    $(document).ready(function () {


        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#skillLevel").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#skillLevel").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#skillLevel").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>
<script type="text/javascript">

    $(document).ready(function () {
            $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
    });

    function ResetFilter() {
        window.location.href = "/Client/ResetRecruiterReportFilter";
    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        var form = $("#form").serialize();
    }
    function PauseIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The Skill Channel will be paused, all the feture interviews of this channel will be cancelled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, pause it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/PauseIRF?irfId=' + irfId + '&irfName=' + irfName,
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Paused!',
                    type: 'success',
                    html: '<p>IRF has been paused.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/IRF/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been paused!',
                    'error'
                )
            }
        })
        changeColor('red');
    }

    function PlayIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The Skill Channel will be enabled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, play it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/PlayIRF?irfId=' + irfId + '&irfName=' + irfName,
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Played!',
                    type: 'success',
                    html: '<p>IRF has been enabled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/IRF/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been enabled! :)',
                    'error'
                )
            }
        })
        changeColor("yellow");
    }
    function DisableRecruiter(userid, clientid) {
        swal.fire({
            title: 'Are you sure?',
            text: "Recruiter will not be able to upload candidates!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, disabled it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Client/DisableRecruiter?userid=' + userid + '&clientid=' + clientid,
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                window.location = "/Client/RecruiterReport";
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Recruiter has not been disabled!',
                    'error'
                )
            }
        })
        changeColor('red');
    }

    function ActiveRecruiter(userid, clientid) {
        swal.fire({
            title: 'Are you sure?',
            text: "Recruiter will be active!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, active it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Client/ActiveRecruiter?userid=' + userid + '&clientid=' + clientid,
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Actived!',
                    type: 'success',
                    html: '<p>Recruiter has been actived!</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Client/RecruiterReport";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Recruiter has not been actived! :)',
                    'error'
                )
            }
        })
        changeColor("yellow");
    }
</script>