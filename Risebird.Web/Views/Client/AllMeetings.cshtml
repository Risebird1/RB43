                                                            <thead>
                                                                <tr>
                                                                    <th style="border-right: 0px !important;"></th>
                                                                    <th style="border-left: 0px !important;" id='start'>Interview Date</th>
                                                                    <th>Candidate Details</th>
                                                                    <th>Client HR</th>
                                                                    <th id="allinterview_6">Confirmation Status</th>
                                                                    <th id="allinterview_7">Meeting Status</th>
                                                                    <th id="allinterview_8">Interview Status</th>
                                                                    <th id="allinterview_9">Report</th>

                                                                </tr>
                                                            </thead>
                                                            <tfoot>
                                                                <tr>
                                                                    <th style="border-right: 0px !important;"></th>
                                                                    <th style="border-left: 0px !important;">Interview Date</th>
                                                                    <th>Candidate Details</th>
                                                                    <th>Client HR</th>
                                                                    <th>Confirmation Status</th>
                                                                    <th>Meeting Status</th>
                                                                    <th>Interview Status</th>
                                                                    <th>Report</th>

                                                                </tr>
                                                            </tfoot>
                                                            <tbody id="tblbodyPriority">

                                                                @if (Model.Count == 0)
                                                                {
                                                                    <tr>
                                                                        <td colspan="10" class="text-center">No data available in table</td>
                                                                    </tr>
                                                                }
                                                                @foreach (var item in Model)
                                                                {
                                                                    <tr id="@item.imid" data-changes="1">
                                                                        <td style="width:10px;padding:5px!important;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                        <td> @item.interviewDate </td>

                                                                        @if (item.candidateName != null && item.candidateName != "")
                                                                        {

                                                                            @if (item.IsOnline == 1)
                                                                            {
                                                                                <td class="candidate-details">
                                                                                    <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span> @item.candidateName</a>
                                                                                    <div class="mtop-5">
                                                                                        @if (item.candidateEmail != null && item.candidateEmail != "")
                                                                                        {
                                                                                            @if (item.candidateEmail.Length > 38)
                                                                                            {
                                                                                                <a onclick="" data-tooltip="@item.candidateEmail"><strong>Email:</strong><span class="hrname"> @item.candidateEmail</span> </a>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <a onclick=""><strong>Email:</strong> @item.candidateEmail </a>
                                                                                            }



                                                                                        }
                                                                                        else
                                                                                        {

                                                                                        }
                                                                                    </div>
                                                                                    <div class="mtop-5">
                                                                                        @if (item.JDTiltle.Split("|")[0] != null && item.JDTiltle.Split("|")[0] != "")
                                                                                        {
                                                                                            <a onclick=""><strong>Jd Title:</strong>  @item.JDTiltle.Split("|")[0]</a>
                                                                                        }
                                                                                        else
                                                                                        {

                                                                                        }
                                                                                    </div>

                                                                                </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td class="candidate-details">
                                                                                    <a onclick=""><span class="dot"></span>@item.candidateName</a>
                                                                                    <div class="mtop-5">
                                                                                        @if (item.candidateEmail != null && item.candidateEmail != "")
                                                                                        {
                                                                                            @if (item.candidateEmail.Length > 30)
                                                                                            {
                                                                                                <a onclick="" data-tooltip="@item.candidateEmail"><strong>Email:</strong><span class="hrname">  @item.candidateEmail</span> </a>
