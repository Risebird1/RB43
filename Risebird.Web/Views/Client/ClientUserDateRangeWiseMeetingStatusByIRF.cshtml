@model IEnumerable<Risebird.Entities.ViewModel.StatsDerived>
@using Risebird.Entities.Data;

<div id="tableID" class="second" style="overflow-x:scroll">
    <table id="listTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
        <thead>
            <tr>
                @*@if (ViewBag.RoleType == ClientRoleTypes.StaffingAgency)
                {
                    <th>Staffing Agency</th>
                }
                else
                {
                    <th>Client HR</th>
                }*@
                <th>Skill Channel</th>
                <th>Total Meetings</th>
                <th>Total Completed</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show</th>
                <th>Scheduled</th>
                @*<th>Actions</th>*@
            </tr>
        </thead>
        <tfoot>
            <tr>
                @*@if (ViewBag.RoleType == ClientRoleTypes.StaffingAgency)
                {
                <th>Staffing Agency</th>
                }
                else
                {
                <th>Client HR</th>
                }*@
                <th>Skill Channel</th>
                <th>Total Meetings</th>
                <th>Total Completed</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show</th>
                <th>Scheduled</th>
                @*<th>Actions</th>*@
            </tr>
        </tfoot>
        <tbody>

            @if (Model != null && Model.Count() > 0)
            {
                //int i = 0;
                foreach (var item in Model)
                {

                    <tr>
                        @*@if (!string.IsNullOrEmpty(item.EmailId))
                        {
                            <td> @item.EmailId </td>
                        }
                        else
                        {
                            <td></td>
                        }*@
                        <td>@item.IRFnSkill</td>
                        @if (item.TotalMeetings > 0)
                        {
                            <td title="Total Meetings">
                                <a title="Total Meetings" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.All, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">@item.TotalMeetings</a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalMeetings</td>
                        }
                        @if (item.TotalCompletedMeetings > 0)
                        {
                            <td title="Total Completed Meetings">
                                <a title="Total Completed Meetings" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Completed, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">@item.TotalCompletedMeetings</a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalCompletedMeetings</td>
                        }
                        @if (item.StatusPending > 0)
                        {
                            <td title="Status Pending">
                                <a title="Status Pending" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Pending, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalSelected > 0)
                        {
                            <td title="Total Selected">
                                <a title="Total Selected" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Selected, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.TotalSelected { @(item.TotalCompletedMeetings != 0 ? (item.TotalSelected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalSelected { @(item.TotalCompletedMeetings != 0 ? (item.TotalSelected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        }

                        @if (item.TotalBorderLine > 0)
                        {
                            <td title="Total Borderline">
                                <a title="Total Borderline" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Borderline, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.TotalBorderLine { @(item.TotalCompletedMeetings != 0 ? (item.TotalBorderLine * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalBorderLine</td>
                        }
                        @if (item.TotalRejected > 0)
                        {

                            <td title="Total Rejected">
                                <a title="Total Rejected" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Rejected, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.TotalRejected { @(item.TotalCompletedMeetings != 0 ? (item.TotalRejected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalRejected { @(item.TotalCompletedMeetings != 0 ? (item.TotalRejected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalProxy > 0)
                        {
                            <td title="Total Proxy">
                                <a title="Total Proxy" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Proxy, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.TotalProxy { @(item.TotalCompletedMeetings != 0 ? (item.TotalProxy * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalProxy { @(item.TotalCompletedMeetings != 0 ? (item.TotalProxy * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalDropped > 0)
                        {

                            <td title="Total Dropped">
                                <a title="Total Dropped" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Dropped, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }
                        @if (item.TotalNoShow > 0)
                        {

                            <td title="No Show">
                                <a title="No Show" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Noshowinterviewer, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.TotalNoShow { @(item.TotalMeetings != 0 ? (item.TotalNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.TotalNoShow { @(item.TotalMeetings != 0 ? (item.TotalNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }
                        
                        @if (item.Scheduled > 0)
                        {
                            <td title="Scheduled">
                                <a title="Scheduled" target="_blank" href="@Url.Action("StatsDetails", "Client", new {userId = item.UserId, statType = StatsTypes.Scheduled, clientRole = ViewBag.RoleType, clientEmailId = item.EmailId, irfId = item.irfIntId, irfName = item.IRFId, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate})">
                                    @item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }
                                </a>
                            </td>
                        }
                        else
                        {
                            <td>@item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        }

                        @*<td class="text-center">
                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                            {
                                <span class="interviewer_14"><span class="call" data-toggle="tooltip" data-placement="top" onclick="CommonCallButtonClick('@item.EmailId', '@item.MobileNumber', '@item.EmailId')" data-original-title="Tooltip on top"><span title="Click here to call the interviewer" class="mdc-fab app-fab--absolute" style="top: -3px;left:1px;"><span class="fa fa-phone-alt"></span></span></span></span>

                            }


                        </td>*@


                    </tr>
                    //i++;

                }
            }

        </tbody>

    </table>


    @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

</div>


