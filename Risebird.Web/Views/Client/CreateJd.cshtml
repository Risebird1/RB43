@*@model IEnumerable<Risebird.Entities.ViewModel.ClientDetails>*@
@model Risebird.Entities.ViewModel.ClientDetails
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "RB Matches";
    ViewBag.PageHeader = "RB Matches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interviewer.css?v=8" />

<link rel="stylesheet" type="text/css" href="~/Newassets/css/risetube.css?v=8" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<script src="ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
@*<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>*@


@*<script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery("#fillter_AssessmentGroupName").select2({ multiple: true });
    });

    jQuery(document).ready(function () {
        jQuery("#fillter_ClientEmail").select2({ multiple: true });
    });

</script>*@
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">RB Matches</h4></div>
                </div>
                <div class="pull-right">
                    <div class="newsletter">
                        <div class="content">
                            <div class="input-group" id="myForm">

                            </div>
                        </div>
                    </div>
                    @if (!Model._clientjddetails.isClientUser)
                    {
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded btn1" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-bs-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>

                        <a onclick="CreateJd(2)" class="mdc-button mdc-button--raised mdc-ripple-upgraded"><span class="fa fa-plus-square" style="color:#fff;"></span>&nbsp;Create JD</a>
                    }
                    @*<a href="/User/Interviewers" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space"><span class="fa fa-chevron-left"></span> Back to List</a>*@
                </div>
            </div>
        </div>
    </div>


    <div class="content client assesment">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                            </div>
                            <div class="modal modal-wrap fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">



                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>

                                        <form action="@Url.Action("CreateJd", "Client")" method="post" id="form">
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate"> Start Date </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="fillter_StartDate" name="fillter.StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="EndDate"> End Date </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="fillter_EndDate" name="fillter.EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6  border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="AssessmentGroupName"> Assessment Group </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="fillter_AssessmentGroupName" name="fillter.AssessmentGroupName" data-placeholder="None Selected" class="multiselect" multiple="multiple">

                                                                    @foreach (var item in Model._clientjd.Select(x => x.AssessmentGroupName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6  border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientEmail"> Client </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="fillter_ClientEmail" name="fillter.ClientEmail" data-placeholder="None Selected" class="multiselect" multiple="multiple" >

                                                                    @foreach (var item in Model._clientjd.Select(x => x.ClientEmail).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="form-group col-md-12 col-sm-12 text-align">
                                                        <div>
                                                            <div class="col-md-12 col-sm-12">
                                                                <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;"> <font style="font-size:12px;"> Reset Filter</font> </button>
                                                                <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right"> <font style="font-size:12px;"> Apply Filter</font> </button>

                                                            </div>
                                                        
                                                    </div>

                                                </div>
                                            </div>
                                                </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div style="clear:both;padding:10px"></div>
                            <div class="row">
                                @foreach (var item in Model._clientjd)
                                {
                                    <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                        <div class="card-content-holder border card-blue">
                                            <div class="card-header jd">
                                                <div class="row">
                                                    <div id="rbmatches_2" class="col-md-6 col-sm-12 first">


                                                        @if (@item.JDTitle.Length > 10)
                                                        {
                                                            <a style="text-decoration: none; cursor: pointer;" data-tooltip="@item.JDTitle"><h6 class="skillname assessment-grp">@item.JDTitle</h6> </a>
                                                        }
                                                        else
                                                        {
                                                            <h6 class="assessment-grp">
                                                                @item.JDTitle
                                                            </h6>
                                                        }



                                                    </div>

                                                    <div class="col-md-6 col-sm-12 card-header-buttons action text-right">
                                                        @if (!Model._clientjddetails.isClientUser)
                                                        {
                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                                <span onclick="javascript:DeleteJd('@item.id');" title="Delete" class="mdc-fab__icon material-icons "><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg></span>
                                                            </button>
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                                <span onclick="javascript:EditJD('@item.id');" title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                            </button>

                                                            <button class="mdc-fab app-fab--absolute priority" aria-label="Candidate JD Score Priority">
                                                                <span onclick="javascript:CandidateJdScorePriority('@item.id');" title="Candidate Curated Score Priority" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M14 5h8v2h-8zm0 5.5h8v2h-8zm0 5.5h8v2h-8zM2 11.5C2 15.08 4.92 18 8.5 18H9v2l3-3-3-3v2h-.5C6.02 16 4 13.98 4 11.5S6.02 7 8.5 7H12V5H8.5C4.92 5 2 7.92 2 11.5z" /></svg></span>
                                                            </button>
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Candidate JD Score">
                                                                <span onclick="javascript:CandidateJdScore('@item.id');" title="Candidate Curated Score" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><path d="M9 11.3l3.71 2.7-1.42-4.36L15 7h-4.55L9 2.5 7.55 7H3l3.71 2.64L5.29 14z" /></svg></span>
                                                            </button>
                                                        }

                                                    </div>
                                                </div>
                                            </div>

                                            <!-- irf body-->
                                            <div class="card-body">
                                                <div class="statusInfo">
                                                    <div class="group inner list-group-item-text">
                                                        <div id="rbmatches_3" class="second clearfix">
                                                            <div class="client-field"><span> Start Date:</span><span style="font-weight:normal">@item.StartDate</span></div>
                                                        </div>
                                                        <div id="rbmatches_4" class="three clearfix">
                                                            <div class="client-field">
                                                                <span><b>End Date:</b></span><span style="font-weight:normal">@item.EndDate</span>
                                                            </div>
                                                        </div>
                                                        @if (!Model._clientjddetails.isClientUser)
                                                        {
                                                            <div>
                                                                <span><b>Client:</b></span> @item.Name
                                                            </div>
                                                        }
                                                        <div id="rbmatches_5" class="clearfix">
                                                            <div class="client-field">
                                                                <span><b>Assessment Group:</b></span><span style="font-weight:normal"> @item.AssessmentGroupName</span>
                                                            </div>
                                                        </div>
                                                        <div id="rbmatches_6" class="clearfix">
                                                            <div class="client-field">
                                                                <span><b>JD Link:</b></span>
                                                                @if (!String.IsNullOrEmpty(item.Filelink))
                                                                {
                                                                    <a href="@item.Filelink" target="_blank">Click Here</a>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div id="rbmatches_7" class="clearfix">
                                                            <div class="client-field">
                                                                <span><b>Role:</b></span><span style="font-weight:normal"> @item.JobRole</span>
                                                            </div>
                                                        </div>
                                                        <div id="rbmatches_8" class="clearfix">
                                                            <div class="client-field">
                                                                <span><b>Salary Range:</b></span><span style="font-weight:normal"> @item.JDBudget</span>
                                                            </div>
                                                        </div>
                                                        <div id="rbmatches_9" class="clearfix">
                                                            <div class="client-field">
                                                                <span><b>Location:</b></span><span style="font-weight:normal"> @item.Location</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>

                                            <div class="card-footer action">
                                                <div class="row">

                                                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3 " id="irf-card-footer">

                                                        @*@if (@item.IRFStatus == "Active")
                                                            {
                                                                <h6 style="color: green;"> @item.IRFStatus</h6>
                                                            }
                                                            else if (@item.IRFStatus == "Paused")
                                                            {
                                                                <h6 style="color: grey;"> @item.IRFStatus</h6>
                                                            }
                                                            else
                                                            {
                                                                <h6 style="color: black;"> @item.IRFStatus</h6>
                                                            }*@
                                                    </div>

                                                    <div class="stats-bttm-btn  col-lg-9 col-md-9 col-sm-9 col-xs-9 text-right ">
                                                        <button id="rbmatches_10" class="mdc-fab app-fab--absolute item1" aria-label="All">
                                                            <span onclick="location.href='@Url.Action("VideoPageCandidateJd", "RiseTube",new { ClientJdId = item.id, actionstatus="ALL"})'" title="All Candidates" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg></span>
                                                        </button>
                                                        <button id="rbmatches_11" class="mdc-fab app-fab--absolute item1" aria-label="ShortListed">
                                                            <span onclick="location.href='@Url.Action("VideoPageCandidateJd", "RiseTube",new { ClientJdId = item.id, actionstatus="SHORTLIST"})'" title="Shortlisted Candidates" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"><path d="M14 10H2v2h12v-2zm0-4H2v2h12V6zM2 16h8v-2H2v2zm19.5-4.5L23 13l-6.99 7-4.51-4.5L13 14l3.01 3 5.49-5.5z" /></svg></span>
                                                        </button>
                                                        <button id="rbmatches_12" class="mdc-fab app-fab--absolute item1" aria-label="Interest-Send">
                                                            <span onclick="location.href='@Url.Action("VideoPageCandidateJd", "RiseTube",new { ClientJdId = item.id, actionstatus="INTRESTED"})'" title="Interest Sent Candidates" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg></span>
                                                        </button>
                                                        <button id="rbmatches_13" class="mdc-fab app-fab--absolute item1" aria-label="Interest-Accept">
                                                            <span onclick="location.href='@Url.Action("VideoPageCandidateJd", "RiseTube",new { ClientJdId = item.id, actionstatus="ACCEPT"})'" title="Interest Accepted Candidates" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg></span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="commentsmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span >
                        <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="28" height="28" viewBox="0 0 172 172" style=" fill:#000000;"><g fill="none" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" font-size="none" text-anchor="none" style="mix-blend-mode: normal"><path d="M0,172v-172h172v172z" fill="none"></path><g fill="#ffffff"><path d="M64.5,21.5v7.16667h-35.83333c-7.90483,0 -14.33333,6.4285 -14.33333,14.33333v28.66667v28.66667v28.66667c0,7.90483 6.4285,14.33333 14.33333,14.33333h58.63509c-1.64117,-4.63683 -1.64117,-9.6965 0,-14.33333h-58.63509v-14.33333h64.5c0,-5.53267 2.15213,-10.52067 5.58496,-14.33333h-70.08496v-28.66667v-28.66667h114.66667v44.30176c2.93117,1.03917 5.69101,2.65357 8.03451,4.99707l0.86784,0.86784h5.43099v-50.16667c0,-7.90483 -6.4285,-14.33333 -14.33333,-14.33333h-35.83333v-7.16667zM86,71.66667c-3.95804,0 -7.16667,3.20863 -7.16667,7.16667c0,3.95804 3.20863,7.16667 7.16667,7.16667c3.95804,0 7.16667,-3.20863 7.16667,-7.16667c0,-3.95804 -3.20863,-7.16667 -7.16667,-7.16667zM136.05469,100.33333c-1.86171,0.02969 -3.6388,0.78269 -4.95508,2.09961l-5.06706,5.06706h-11.36589c-3.95788,0.0004 -7.16627,3.20879 -7.16667,7.16667v11.36589l-5.06706,5.06706c-2.79764,2.7988 -2.79764,7.33531 0,10.13411l5.06706,5.06706v11.36589c0.0004,3.95788 3.20879,7.16627 7.16667,7.16667h11.36589l5.06706,5.06706c2.7988,2.79764 7.33531,2.79764 10.13411,0l5.06706,-5.06706h11.36589c3.95788,-0.0004 7.16627,-3.20879 7.16667,-7.16667v-11.36589l5.06706,-5.06706c2.79764,-2.7988 2.79764,-7.33531 0,-10.13411l-5.06706,-5.06706v-11.36589c-0.0004,-3.95788 -3.20879,-7.16627 -7.16667,-7.16667h-11.36589l-5.06706,-5.06706c-1.37115,-1.37178 -3.23971,-2.12931 -5.17903,-2.09961zM136.16667,117.63411l2.09961,2.09961c1.34383,1.34401 3.16646,2.09924 5.06706,2.09961h7.16667v7.16667c0.00037,1.90059 0.7556,3.72322 2.09961,5.06706l2.09961,2.09961l-2.09961,2.09961c-1.34401,1.34383 -2.09924,3.16646 -2.09961,5.06706v7.16667h-7.16667c-1.90059,0.00037 -3.72322,0.7556 -5.06706,2.09961l-2.09961,2.09961l-2.09961,-2.09961c-1.34383,-1.34401 -3.16646,-2.09924 -5.06706,-2.09961h-7.16667v-7.16667c-0.00037,-1.90059 -0.7556,-3.72322 -2.09961,-5.06706l-2.09961,-2.09961l2.09961,-2.09961c1.34401,-1.34383 2.09924,-3.16646 2.09961,-5.06706v-7.16667h7.16667c1.90059,-0.00037 3.72322,-0.7556 5.06706,-2.09961z"></path></g></g></svg>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Add Job Description</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;" onclick="closeCallPopUp()">&times;</span>
            </button>
            <div class="modal-body">
                @using (Html.BeginForm("AddCreateJd", "Client", FormMethod.Post))
                {
                    <div>
                        @Html.HiddenFor(m => m._clientjddetails.ClientId)
                        @Html.HiddenFor(m => m._clientjddetails.id)

                        <div class="col-md-12">
                            <div class="row">
                                <div class="form-group col-lg-6  col-md-6 col-sm-6  pull-left">
                                    <div class="form-group">
                                        <label class="control-label  desp-label" for="StartDate"> Start Date </label>
                                        <div>
                                            <input id="zclientjddetails_StartDate" name="_clientjddetails.StartDate" type="date" class="form-control">
                                        </div>
                                    </div>

                                </div>
                                <div class="form-group col-lg-6  col-md-6 col-sm-6  pull-left">
                                    <div class="form-group">
                                        <label class="control-label  desp-label" for="StartDate"> End Date </label>
                                        <div>
                                            <input id="zclientjddetails_EndDate" name="_clientjddetails.EndDate" type="date" class="form-control">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-lg-6  col-md-6 col-sm-6  pull-left">
                                    @Html.LabelFor(model => model._clientjddetails.AssessmentGroup, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                    @Html.DropDownListFor(m => m._clientjddetails.AssessmentGroup, Model._clientjddetails.AssessmentGrouplist, htmlAttributes: new { @class = "select-css form-control webkitEnabled"})
                                    @Html.ValidationMessageFor(model => model._clientjddetails.AssessmentGroup, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group col-lg-6  col-md-6 col-sm-6  pull-left">
                                    @Html.LabelFor(model => model._clientjddetails.JDTitle, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                    @Html.TextBoxFor(m => m._clientjddetails.JDTitle, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model._clientjddetails.JDTitle, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-6 pull-left">

                                    @Html.LabelFor(model => model._clientjddetails.Filelink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                    @Html.TextBoxFor(m => m._clientjddetails.Filelink, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model._clientjddetails.Filelink, "", new { @class = "text-danger" })
                                </div>
