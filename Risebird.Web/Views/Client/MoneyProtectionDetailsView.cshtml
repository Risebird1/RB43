@model IEnumerable<Risebird.Entities.ViewModel.MoneyProtectionVM>

<table class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>Skill Channel</th>
            <th>Interview</td>
            <th>Candidate</th>
            <th>Points</th>
            <th>AddedOn</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Skill Channel</td>
            <th>Interview</th>
            <th>Candidate</th>
            <th>Points</th>
            <th>AddedOn</th>
        </tr>
    </tfoot>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IRFId</td>
                <td>@item.interviewDate</td>
                <td>@item.candidateEmail</td>
                <td>@item.Point</td>
                <td>@item.AddedOn</td>
            </tr>
        }
    </tbody>
</table>