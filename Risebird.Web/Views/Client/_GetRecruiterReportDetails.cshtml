
<table id="skillLevelRecruiter" class="table table-striped table-bordered" cellspacing="0" style="width:100%;">
    <thead>
        <tr>
            <th>Skill Channel</th>
            <th>JD Title</th>
            <th>Total Completed</th>
            <th>Selected</th>
            <th>Rejected</th>
            <th>Selection Rate (%)</th>
            <th>Action</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Skill Channel</th>
            <th>JD Title</th>
            <th>Total Completed</th>
            <th>Selected</th>
            <th>Rejected</th>
            <th>Selection Rate (%)</th>
            <th>Action</th>
        </tr>
    </tfoot>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IRFId </td>
                <td>@item.JDTiltle</td>
                <td>@item.ScheduledMeetings</td>

                @if (@item.SelectedMeetings != null && @item.SelectedMeetings != 0)
                {
                     <td>@item.SelectedMeetings</td>
                }
                else
                {
                    <td>0</td>
                }


               
                <td>@item.RejectedMeetings</td>
                @if (@item.ScheduledMeetings != null && @item.ScheduledMeetings != 0)
                {  @if ((Convert.ToInt32(item.SelectedMeetings) * 100 / item.ScheduledMeetings) <= 30)

                    {
                        <td><span style="color:red;">@(Convert.ToInt32(item.SelectedMeetings) * 100 / item.ScheduledMeetings)%</span></td>
                    }
                    else
                    {
                        <td>@(Convert.ToInt32(item.SelectedMeetings) * 100 / item.ScheduledMeetings)%</td>
                    }
                }
                else
                {
                    <td>0</td>
                }
                 <td>
                @if (ViewBag.ButtonAccess)
                {
                   

                        @if (!item.IsRecruiterActive)
                        {
                            <button class="mdc-fab app-fab--absolute" aria-label="Active the Recruiter">
                                <span onclick="ActiveRecruiter('@item.UserId', '@item.ClientId', '@item.id');" title="Active the Recruiter" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z" /></svg></span>
                            </button>
                        }
                        else
                        {
                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Disable the Recruiter">
                                <span onclick="DisableRecruiter('@item.UserId', '@item.ClientId', '@item.id');" title="Disable the Recruiter" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M2.23 4.35A6.004 6.004 0 0 0 2 6c0 1.691.7 3.22 1.826 4.31.203.196.359.4.453.619l.762 1.769A.5.5 0 0 0 5.5 13a.5.5 0 0 0 0 1 .5.5 0 0 0 0 1l.224.447a1 1 0 0 0 .894.553h2.764a1 1 0 0 0 .894-.553L10.5 15a.5.5 0 0 0 0-1 .5.5 0 0 0 0-1 .5.5 0 0 0 .288-.091L9.878 12H5.83l-.632-1.467a2.954 2.954 0 0 0-.676-.941 4.984 4.984 0 0 1-1.455-4.405l-.837-.836zm1.588-2.653.708.707a5 5 0 0 1 7.07 7.07l.707.707a6 6 0 0 0-8.484-8.484zm-2.172-.051a.5.5 0 0 1 .708 0l12 12a.5.5 0 0 1-.708.708l-12-12a.5.5 0 0 1 0-.708z" /></svg></span>
                            </button>
                        }
                   
                }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        applyDataTableRecruiter();
    });
    function applyDataTableRecruiter() {
        $('#skillLevelRecruiter').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }
</script>