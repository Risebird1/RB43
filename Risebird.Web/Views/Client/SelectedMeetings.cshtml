            var offerComment = document.getElementById("offComments").value;
            var offerStatus = document.getElementById("offerDropdown").value;
            var movetoCP = document.getElementById("MoveToCP").checked;
            var id = imid;

            $.ajax({
                type: "GET",
                url: "/Interview/SaveClientFeedback",
                data: { 'imid': id, 'isApproved': isApproved, 'approvalComment': approvalComment, 'isSelected': isSelected, 'selectionComment': selectionComment, 'joiningStatus': joiningStatus, 'joiningComment': joiningComment, 'offerStatus': offerStatus, 'offerComment': offerComment, 'movetoCP': movetoCP },
