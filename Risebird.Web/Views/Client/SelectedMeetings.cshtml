                                                                            <th>Call</th>
                                                                        </tr>
                                                                    </tfoot>
                                                                    <tbody id="tblbodySelect">

                                                                        @if (Model.Count == 0)
                                                                        {
                                                                            <tr>
                                                                                <td colspan="9" class="text-center">No data available in table</td>
                                                                            </tr>
                                                                        }
                                                                        @foreach (var item in Model)
                                                                        {
                                                                            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                                            <tr id=@item.imid data-changes="1">
                                                                                <td style="width:10px;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                                <td class="interviewdate"> @item.interviewDate </td>
                                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                                {
                                                                                    @if (item.IsOnline == 1)
                                                                                    {
                                                                                        <td class="candidate-details">
                                                                                            <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span><strong>Name:</strong>@item.candidateName</a>
                                                                                            <div class="mtop-5">
                                                                                                @if (item.JDTiltle.Split("|")[0] != null && item.JDTiltle.Split("|")[0] != "")
                                                                                                {

                                                                                                    @if (item.JDTiltle.Split("|")[0].Length > 38)
                                                                                                    {
                                                                                                        <a onclick="" data-tooltip="@item.JDTiltle.Split("|")[0]"><strong>Jd Title:</strong><span class="hrname"> @item.JDTiltle.Split("|")[0]</span> </a>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <a onclick=""><strong>Jd Title:</strong> @item.JDTiltle.Split("|")[0] </a>
                                                                                                    }



                                                                                                }
                                                                                                else
                                                                                                {

                                                                                                }
                                                                                            </div>
                                                                                        </td>
                                                                                    }
                                                                                    else
                                                                                    {

                                                                                        <td class="candidate-details">
                                                                                            <a onclick=""><span class="dot"></span>@item.candidateName</a>
                                                                                            <div class="mtop-5">
                                                                                                @if (item.JDTiltle.Split("|")[0] != null && item.JDTiltle.Split("|")[0] != "")
                                                                                                {

                                                                                                    @if (item.JDTiltle.Split("|")[0].Length > 38)
                                                                                                    {
                                                                                                        <a onclick="" data-tooltip="@item.JDTiltle.Split("|")[0]"><strong>Jd Title:</strong><span class="hrname"> @item.JDTiltle.Split("|")[0]</span> </a>
                                                                                                    }
                                                                                                    else
                                                                                                    {
                                                                                                        <a onclick=""><strong>Jd Title:</strong> @item.JDTiltle.Split("|")[0] </a>
                                                                                                    }



                                                                                                }
                                                                                                else
                                                                                                {

                                                                                                }
                                                                                            </div>
                                                                                        </td>


                                                                                    }

                                                                                }
                                                                                else
                                                                                {
                                                                                    <td></td>
                                                                                }




                                                                                @if (item.ClientHrContact != null && item.ClientHrContact != "")
                                                                                {
                                                                                    @if (item.IsHrOnline == 1)
                                                                                    {
                                                                                        <td class="candidate-client">
                                                                                            <a data-tooltip="@item.ClientHrContact" onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span><span class="s_cname">@item.ClientHrContact</span></a>
                                                                                        </td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="candidate-client">
                                                                                            <a onclick=""><span class="dot"></span><span class="s_cname">@item.ClientHrContact </span></a>
                                                                                        </td>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td></td>
                                                                                }

                                                                                @if ((item.MeetingStatus == 4) && item.VideoLink != null && item.VideoLink != "")
                                                                                {
                                                                                    <td><span id="selectedcandidate_6"> <a id="videoId" target="_blank" title="Video" href=@item.VideoLink>Video</a></span> </td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td>No Video</td>
                                                                                }


                                                                                <td class="interview-com">
