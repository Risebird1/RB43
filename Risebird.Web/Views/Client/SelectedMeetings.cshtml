                                                                                        @if (item.InterviewerComment != null && item.InterviewerComment != "")
                                                                                        {
                                                                                            @if (item.InterviewerComment.Length > 28)
                                                                                            {
                                                                                                <div class="article">
                                                                                                    <p style="margin-bottom:0px;">
                                                                                                        @item.InterviewerComment.Substring(0, 28)
                                                                                                    </p>
                                                                                                    <p class="moretext_@item.imid moretext">
                                                                                                        @item.InterviewerComment.Substring(28, @item.InterviewerComment.Length - 28)
                                                                                                    </p>
                                                                                                </div>
                                                                                            }
                                                                                            else
                                                                                            {
                                                                                                <div class="article">

                                                                                                    <p>
                                                                                                        @item.InterviewerComment.Substring(0, @item.InterviewerComment.Length - 1)
                                                                                                    </p>
                                                                                                </div>
                                                                                            }}
                                                                                        else
                                                                                        { <div></div>}







                                                                                        <a onclick="moreless(@item.imid)" class="moreless-button" value="Readmore" id="read_@item.imid" href="#">Read more</a>


                                                                                    </div>

                                                                                </td>

                                                                                @if ((item.MeetingStatus == 4) && (item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && item.MeetingStatus == 4 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
