                    html += '   <li class="active"><span>1</span></li>';
                } else if (i <= 10) {
                    html += '<li><a href="/Client/SelectedMeetings?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
                } else if (i == 11) {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a href="/Client/SelectedMeetings?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a href="/Client/SelectedMeetings?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
                } else {
                    break;
                }
                if (pagecount <= 10 && i == pagecount && i != 1) {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a href="/Client/SelectedMeetings?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a href="/Client/SelectedMeetings?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
                }
            }
