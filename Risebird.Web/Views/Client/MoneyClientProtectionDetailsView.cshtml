@model IEnumerable<Risebird.Entities.ViewModel.MoneyProtectionVM>
<input type="hidden" value="@Model?.FirstOrDefault()?.PerInterviewRate" id="hidPerInterviewRate" />
<input type="hidden" value="@Model?.Select(x=>x.Point)?.Sum()" id="hidInterviewCountSum" />
<div class="scrollbar int-table" id="style-2">

<table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>Skill Channel</th>
            <th>Interview</th>
            <th>Candidate Email</th>
                @if (ViewBag.action == "All" || ViewBag.action == "CREDIT")
                {
                <th>Credit</th>
                }
                @if (ViewBag.action == "All" || ViewBag.action == "DEBIT")
                {
                <th>Debit</th>
                }
            <th>Date</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Skill Channel</th>
            <th>Interview</th>
            <th>Candidate Email</th>
                @if (ViewBag.action == "All" || ViewBag.action == "CREDIT")
                {
                <th>Credit</th>
                }
                @if (ViewBag.action == "All" || ViewBag.action == "DEBIT")
                {
                <th>Debit</th>
                }
            <th>Date</th>
        </tr>
    </tfoot>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IRFId</td>
                <td>@item.interviewDate</td>
                <td style="text-transform:lowercase;">@item.candidateEmail</td>
                @if (ViewBag.action == "All" || ViewBag.action == "CREDIT")
                {
                    <td>@item.Point</td>
                }
                @if (ViewBag.action == "All" || ViewBag.action == "DEBIT")
                {
                    <td></td>
                }
                <td>@item.AddedOn</td>
            </tr>
        }
    </tbody>
</table>
</div>

<script>
    function RefreshSearch() {
        $('#meetingTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meetingTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'></span>");
                $(".dataTables_filter input:eq(0)").after("<span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
