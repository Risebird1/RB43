@using Risebird.Entities.Data;
@model Risebird.Entities.ViewModel.ClientRoleWiseStatsWrapper
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />

<div class="row" style = "width : 100%">
    <div class="panel-body panel-body-table" style="width : 50%">
        <h5>HR Stats</h5>
        @if (Model.ClientHRStats != null && Model.ClientHRStats.Count() > 0)
        {

            <div class="sb-container scroller">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th width="40%" class="text-center"><strong>HR</strong></th>
                                <th width="60%" class="text-center"><strong>Status</strong></th>
                            </tr>
                        </thead>
                        <tbody>

                            @{
                                foreach (var item in Model.ClientHRStats.Distinct()) /*.Select(x => x.EmailId).Distinct()*/
                                {

                                    <tr>

                                        <td title="@item.EmailId" class="text-center"><strong>@item.EmailId</strong></td>

                                        <td class="text-center"><a class="allMeetings" style="color:navy" href="#" data-toggle="tooltip" title="All Meetings : @item.TotalMeetings"><span><strong>@item.TotalMeetings</strong></span></a> / <a class="Completed" style="color:darkmagenta" href="#" data-toggle="tooltip" title="Completed : @item.TotalCompletedMeetings"><span><strong>@item.TotalCompletedMeetings</strong></span></a> / <a class="selected" href="#" data-toggle="tooltip" title="Selected : @item.TotalSelected"><span><strong>@item.TotalSelected</strong> </span></a> / <a class="rejected" href="#" data-toggle="tooltip" title="Rejected : @item.TotalRejected"><span><strong>@item.TotalRejected</strong></span></a> / <a class="borderline" href="#" data-toggle="tooltip" title="BorderLine : @item.TotalBorderLine"><span><strong>@item.TotalBorderLine</strong></span></a> / <a class="proxy" href="#" data-toggle="tooltip" title="Proxy : @item.TotalProxy"><span><strong>@item.TotalProxy</strong></span></a> /  <a class="noshow" href="#" data-toggle="tooltip" title="NoShow : @item.TotalNoShow"><span><strong>@item.TotalNoShow </strong> </span></a> / <a class="schedule" href="#" data-toggle="tooltip" title="Scheduled : @item.Scheduled"><span><strong>@item.Scheduled </strong> </span></a> / <a class="dropped" href="#" data-toggle="tooltip" title="Dropped : @item.TotalDropped"><span><strong>@item.TotalDropped</strong></span></a> / <a class="pending" href="#" data-toggle="tooltip" title="Pending : @item.StatusPending"><span><strong>@item.StatusPending</strong></span></a> </td>

                                    </tr>

                                }
                            }


                        </tbody>
                    </table>
                </div>


            </div>

            
        }
        else
        {
            <div>No data for this date range!</div>
        }
        <div class="legend">
            @{
                var distinctCLientHRmodel = Model.ClientHRStats.Distinct();
            }
            <ul>
                <li><div class="na color" style="background:navy"></div>All: @distinctCLientHRmodel.Select(x => x.TotalMeetings).Sum()</li>
                <li><div class="dm color" style="background:darkmagenta"></div>Completed: @distinctCLientHRmodel.Select(x => x.TotalCompletedMeetings).Sum()</li>
                <li><div class="g color"></div>Selected: @distinctCLientHRmodel.Select(x => x.TotalSelected).Sum()</li>
                <li><div class="r color"></div>Rejected: @distinctCLientHRmodel.Select(x => x.TotalRejected).Sum()</li>
                <li><div class="b color"></div>BorderLine: @distinctCLientHRmodel.Select(x => x.TotalBorderLine).Sum()</li>
                <li><div class="pr color"></div>Proxy: @distinctCLientHRmodel.Select(x => x.TotalProxy).Sum()</li>
                <li><div class="ns color"></div>NoShow: @distinctCLientHRmodel.Select(x => x.TotalNoShow).Sum()</li>
                <li><div class="sch color"></div>Scheduled: @distinctCLientHRmodel.Select(x => x.Scheduled).Sum()</li>
                <li><div class="dr color"></div>Dropped: @distinctCLientHRmodel.Select(x => x.TotalDropped).Sum()</li>
                <li><div class="pe color"></div>Status Pending: @distinctCLientHRmodel.Select(x => x.StatusPending).Sum()</li>

            </ul>
        </div>
    </div>
    <div class="panel-body panel-body-table" style="width : 50%">

        <h5>Staffing Agency/Recruiter Stats</h5>
        @if (Model.StaffingAgencyStats != null && Model.StaffingAgencyStats.Count() > 0)
        {
            <div class="sb-container scroller">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th width="40%" class="text-center"><strong>Staffing Agency/Recruiter</strong></th>
                                <th width="60%" class="text-center"><strong>Status</strong></th>
                            </tr>
                        </thead>
                        <tbody>

                            @{
                                foreach (var item in Model.StaffingAgencyStats.Distinct()) /*.Select(x => x.EmailId).Distinct()*/
                                {

                                    <tr>


                                        <td title="@item.EmailId" class="text-center"><strong>@item.EmailId</strong></td>

                                        <td class="text-center"><a class="allMeetings" style="color:navy" href="#" data-toggle="tooltip" title="All Meetings : @item.TotalMeetings"><span><strong>@item.TotalMeetings</strong></span></a> / <a class="completed" style="color:darkmagenta" href="#" data-toggle="tooltip" title="Completed : @item.TotalCompletedMeetings"><span><strong>@item.TotalCompletedMeetings</strong></span></a> / <a class="selected" href="#" data-toggle="tooltip" title="Selected : @item.TotalSelected"><span><strong>@item.TotalSelected</strong> </span></a> / <a class="rejected" href="#" data-toggle="tooltip" title="Rejected : @item.TotalRejected"><span><strong>@item.TotalRejected</strong></span></a> / <a class="borderline" href="#" data-toggle="tooltip" title="BorderLine : @item.TotalBorderLine"><span><strong>@item.TotalBorderLine</strong></span></a> / <a class="proxy" href="#" data-toggle="tooltip" title="Proxy : @item.TotalProxy"><span><strong>@item.TotalProxy</strong></span></a> /  <a class="noshow" href="#" data-toggle="tooltip" title="NoShow : @item.TotalNoShow"><span><strong>@item.TotalNoShow </strong> </span></a> / <a class="schedule" href="#" data-toggle="tooltip" title="Scheduled : @item.Scheduled"><span><strong>@item.Scheduled </strong> </span></a> / <a class="dropped" href="#" data-toggle="tooltip" title="Dropped : @item.TotalDropped"><span><strong>@item.TotalDropped</strong></span></a> / <a class="pending" href="#" data-toggle="tooltip" title="Pending : @item.StatusPending"><span><strong>@item.StatusPending</strong></span></a> </td>

                                    </tr>


                                }
                            }



                        </tbody>
                    </table>
                </div>


            </div>


        }
        else
        {
            <div>No data for this date range!</div>
        }
        <div class="legend">
            @{
                var distinctStaffingAgencymodel = Model.StaffingAgencyStats.Distinct();
            }
            <ul>
                <li><div class="na color" style="background:navy"></div>All: @distinctStaffingAgencymodel.Select(x => x.TotalMeetings).Sum()</li>
                <li><div class="dm color" style="background:darkmagenta"></div>Completed: @distinctStaffingAgencymodel.Select(x => x.TotalCompletedMeetings).Sum()</li>
                <li><div class="g color"></div>Selected: @distinctStaffingAgencymodel.Select(x => x.TotalSelected).Sum()</li>
                <li><div class="r color"></div>Rejected: @distinctStaffingAgencymodel.Select(x => x.TotalRejected).Sum()</li>
                <li><div class="b color"></div>BorderLine: @distinctStaffingAgencymodel.Select(x => x.TotalBorderLine).Sum()</li>
                <li><div class="pr color"></div>Proxy: @distinctStaffingAgencymodel.Select(x => x.TotalProxy).Sum()</li>
                <li><div class="ns color"></div>NoShow: @distinctStaffingAgencymodel.Select(x => x.TotalNoShow).Sum()</li>
                <li><div class="sch color"></div>Scheduled: @distinctStaffingAgencymodel.Select(x => x.Scheduled).Sum()</li>
                <li><div class="dr color"></div>Dropped: @distinctStaffingAgencymodel.Select(x => x.TotalDropped).Sum()</li>
                <li><div class="pe color"></div>Status Pending: @distinctStaffingAgencymodel.Select(x => x.StatusPending).Sum()</li>

            </ul>
        </div>

    </div>
</div>


<script src="~/Newassets/js/scrollBar.js"></script>

<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>

<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>