@model Risebird.Entities.ViewModel.ClientAudioInstructionsWrapper
<!-- Modal -->

<div class="modal fade" style="height:1000px" id="addRecording" tabindex="-1" role="dialog" aria-labelledby="addRecordingLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width:750px">
            <div class="modal-header">
                <h5 class="modal-title" id="addRecordingLabel">Record Audio Feedback</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" style="margin-top: 5px; margin-right: -17px;">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body" id="recording_modal_body" style="max-height:400px">
                <div class="row" id="divAudioRecording">

                    <div class="col-lg-5 col-md-5 col-sm-4 col-xs-5">
                        <div class="pull-left" style="padding:10px"><button id="startClientRecButton" onclick="startClientRecording()" style="background-color:#42a5f5 !important;border-radius:50%;margin: 4px 2px;" title="Start Recording"><i class="fa fa-play"></i></button></div>
                        <div class="pull-left" style="padding:10px"><button id="stopClientRecButton" type="button" onclick="stopClientRecording(@Model.InterviewId)" style="background-color:red !important;border-radius:50%;margin: 4px 2px;" title="Stop Recording" disabled><i class="fa fa-stop"></i></button></div>
                        <div class="pull-left" style="padding:10px"><button id="cancelClientRecButton" type="button" onclick="cancelClientRecording()" style="background-color:red !important;border-radius:50%;margin: 4px 2px;" title="Cancel Recording" disabled><i class="fa fa-close"></i></button></div>

                    </div>
                    <div class="col-lg-7 col-md-7 col-sm-7 col-xs-7">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:center">
                                <p style="font-size:18px" id="clientRecordingStatus"></p>

                            </div>
                        </div>

                        @*<div class="row" id="clientRecordingRow" style="display:none">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:center">
                    <div id="clientRecordingsList">

                    </div>
                </div>
            </div>*@

                    </div>
                    @{
                        string displayStatus = "none";
                        string audioUrl = string.Empty;
                        string fileName = string.Empty;

                        if (Model != null && Model.ClientAudioInstructionsList != null && Model.ClientAudioInstructionsList.Count() > 0)
                        {
                            displayStatus = "block";
                            audioUrl = Model.ClientAudioInstructionsList.FirstOrDefault().AudioUrl;
                            var splitUrl = audioUrl?.Split("/");
                            fileName = splitUrl?[splitUrl.Length - 1];
                        }
                    }
                    <div @*class="row"*@ id="playUploadedAudioTwo" style="display:@displayStatus">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="multiple_row">
                                    <h2>Uploaded Feedback Audio</h2>
                                </div><!--end of multiple location-->
                            </div><!--end of col-md-12-->
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="table-responsive-sm">
                                    <table class="table table-bordered mbn" id="FeedBackAudioTable" style="text-align:center">
                                        <thead>
                                            <tr>
                                                <th width="30%">File</th>
                                                <th width="35%">Play</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td id="td_audioFile">
                                                    <a id="anchorAudioId" asp-append-version="true" href="@audioUrl" download>
                                                        @fileName
                                                    </a>
                                                </td>
                                                <td id="td_audioControl">
                                                    <audio id="controlAudioId" asp-append-version="true" src="@audioUrl" controls></audio>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div><!--end of col-md-12-->
                        </div>
                    </div>

                </div>

            </div>
            
        </div>
    </div>
</div>

