<script>
    //$('form').submit(function () {
    //    if ($(this).valid()) {
    //        $(':submit', this).attr('disabled', 'disabled');
    //    }
    //});
    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("resumeLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("File").value = '';

        }

    }

    function IRFChanged(val) {
        SkillChannelChanged(val);
        $.ajax({
            type: "GET",
            url: "/Interview/GetClientsByRoles",
            data: { 'val': val },
            success: function (data) {

                var drpdownClientHR = $("#ClientHrContact");
                var drpdownStaffingAgency = $("#staffingAgency");
                $("#ClientHrContact option").remove();
                $("#staffingAgency option").remove();

                //check if the data array contains atleast one of each roles
                var arr = [];

                for (i = 0; i < data.length; i++) {
                    arr.push(data[i].value);
                }
                var CH = arr.indexOf("1");
                var SA = arr.indexOf("4");

                if (CH == (-1)) {
                    var opt = $("<option />");

                    //Set Text part.
                    opt.html("No Client HR");

                    //Set Value part.
                    opt.val("");
                    drpdownClientHR.append(opt);
                }
                if (SA == (-1)) {
                    var optn = $("<option />");

                    //Set Text part.
                    optn.html("No Staffing Agency");

                    //Set Value part.
                    optn.val("");
                    drpdownStaffingAgency.append(optn);
                }

                if (CH == (-1) && SA == (-1)) {
                    return;
                }
                if (data.length > 0) {

                    $(data).each(function () {
                        var option = $("<option />");

                        //Set Text part.
                        option.html(this.text);

                        //Set Value part.
                        option.val(this.text);

                        if (this.value != null && this.value == 1) {
                            drpdownClientHR.append(option);
                        }
                        else if (this.value != null && this.value == 4) {
                            drpdownStaffingAgency.append(option);
                        }

                    });


                }


            }
        });

    }

    function checkDate() {

        var interviewDate = new Date(document.getElementById("interviewDate").value);

        var todayDate = new Date();

        if (todayDate.getTime() > interviewDate.getTime()) {

            document.getElementById("error_interviewDate").innerHTML = "Interview Date time should be greater than current Date time.";
            return false;
        }
        else
            document.getElementById("error_interviewDate").innerHTML = "";
        return true;
    }
    function CheckResume() {
        var linkDisplay = document.getElementById("linkDiv").style.display;
        if (linkDisplay == "block") {
            if (document.getElementById("resumeLink").value == '') {
                document.getElementById("error_linkDiv").innerHTML = "Please enter a Resume Link.";
                return false;
            }
            else {
                document.getElementById("error_linkDiv").innerHTML = "";
                return true;
            }
        }
        else {
            if (document.getElementById("File").value == '') {
                document.getElementById("uploadDiv").style.display = 'block';
                document.getElementById("error_uploadDiv").innerHTML = "Please upload a File.";

                return false;
            }
            else {
                document.getElementById("error_uploadDiv").innerHTML = "";
                return true;
            }
        }
    }

    function checkValidation() {
        if (CheckResume && checkDate && $('#confirmationStatus').val() != '') {
            //$("#btnUpload").attr("disabled", "disabled");
            return true;
        }
        else { return false; }

    }

    function SkillChannelChanged(skillChannelName) {

        $.ajax({
            type: "GET",
            url: "/Interview/GetIRFMembersEmailsForInterviewDetails",
            data: { 'IRFId': skillChannelName },
            success: function (data) {

                $("#interviewer option").remove();
                //$("#QCInterviewer option").remove();
                $("#ChannelOwner").val('');

                if (data != null && data.length > 0) {
                    if (data.some(d => d.type === 'I')) {
                        var option = $("<option />");

                        //Set Text part.
                        option.html("Select Interviewer");

                        //Set Value part.
                        option.val('');

                        //Add the Option element to DropDownList.

                        $("#interviewer").append(option);
                    }
                    //if (data.some(d => d.type === 'Q')) {
                    //    var option = $("<option />");

                    //    //Set Text part.
                    //    option.html("Select Quality Controller");

                    //    //Set Value part.
                    //    option.val('');

                    //    //Add the Option element to DropDownList.

                    //    $("#QCInterviewer").append(option);
                    //}
                    $(data).each(function () {
                        if (this.type.toUpperCase() == 'I') {
                            var option = $("<option />");

                            //Set Text part.
                            option.html(this.emailId);

                            //Set Value part.
                            option.val(this.emailId);

                            //Add the Option element to DropDownList.

                            $("#interviewer").append(option);
                        }
                        //else if (this.type.toUpperCase() == 'Q') {
                        //    var option = $("<option />");

                        //    //Set Text part.
                        //    option.html(this.emailId);

                        //    //Set Value part.
                        //    option.val(this.emailId);

                        //    //Add the Option element to DropDownList.

                        //    $("#QCInterviewer").append(option);
                        //}

                        else if (this.type.toUpperCase() == 'O') {
                            $("#ChannelOwner").val(this.emailId);
                        }
                    });
                }


            }
        });

    }
</script>

<script>

    document.body.className += "js";

    var spinner = document.querySelector('.input');
    var buttonUp = document.querySelector('.up');
    var buttonDown = document.querySelector('.down');

    buttonUp.onclick = function () {
        var value = parseInt(spinner.value, 10);
        value = isNaN(value) ? 0 : value;
        value++;
        spinner.value = value;
    };

    buttonDown.onclick = function () {
        var value = parseInt(spinner.value, 10);
        value = isNaN(value) ? 0 : value;
        value--;
        spinner.value = value;
    };

</script>

