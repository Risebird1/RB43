<script>
    $(document).ready(function () {
        if ($("#txtVideostatus").val() == "Public") {
            var modal = document.getElementById("PublicShareVideo");
            modal.style.display = "block";
        }
    });
    function SubmitEmail() {
        if ($("#txtvideoemailid").val().trim() != "") {
            localStorage.setItem('PublicOPenInterviewEmailid', $("#txtvideoemailid").val());
            $.ajax({
                type: "POST",
                url: "/Interview/PublicOpenInterviewInvite",
                data: { id: $("#hidtxtid").val(), Emailid: $("#txtvideoemailid").val().trim() },
                success: function (data) {
                    if (data == "success") {
                        window.location = "/Interview/PublicOpenInterview?emailid=" + $("#txtvideoemailid").val() + "&id=" + $("#hidtxtid").val();
                    } else {
                        swal.fire(data);
                    }
                }
            });
        }
    }
</script>


