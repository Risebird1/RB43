                                                    {
                                                        appendTime = configuration["ThumbnailTimeDefault"];
                                                    }
                                                    else
                                                    {
                                                        appendTime = Model.ThumbnailTimeSeconds.ToString();
                                                    }
                                                    var src = Model.VideoLink + "#t=" + appendTime;
                                                    <video width="600" controls="controls" preload="metadata">
                                                        <source src='@src' type="video/mp4">
                                                    </video>
                                                }

                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>
                                    </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h3 class="mb-0"><span>Report Details</span></h3>
                                        </div><!--end of multiple location-->
                                    </div>
                                    <div class="report-wrap">
                                        <div class="col-md-6 col-sm-6 border-rv pull-left">
