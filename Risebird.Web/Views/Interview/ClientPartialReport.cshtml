                                                        <tr>

                                                            <th width="40%" class="table_heading">Questions</th>
                                                            <th class="table_heading">Skill Name</th>
                                                            <th width="10%" class="table_heading">Rating</th>
                                                            <th class="table_heading">Time(Min)</th>
                                                            @*<th width="10%" class="action text-center">Action</th>*@
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.QuestionsCollection == null || Model.QuestionsCollection.Count() == 0)
                                                        {
                                                            <tr>
                                                                <td>


                                                                    @Html.DropDownList("QuestionsCollection[0].Comment", (SelectList)Model.QuestionsList, new { @class = "select-css form-control text-box single-line", @onchange = "QuestionChanged(this.id, this.value)", @disabled = "disabled" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBox("QuestionsCollection[0].SkillName", null, new { @class = "form-control", @readonly = "readonly" })

                                                                </td>
                                                                <td>

                                                                    @Html.DropDownList("QuestionsCollection[0].RatingId", (SelectList)Model.QuestionsLevelList, new { @class = "select-css form-control", @disabled = "disabled" })

                                                                </td>

                                                                <td>
                                                                    <input class="form-control text-box single-line" id="QuestionsCollection_0__Timing" name="QuestionsCollection[0].Timing" type="number" min="1">

                                                                </td>

                                                                @*<td class="action text-center">
                                            <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute "><i class="fas  fa fa-plus"></i></span>
                                            <span id="btnMinus" onclick="DeleteRow(0)" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                        </td>*@

                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            for (int i = 0; i < Model.QuestionsCollection.Count(); i++)
                                                            {
                                                                <tr>
                                                                    <td>



                                                                        @Html.DropDownListFor(m => m.QuestionsCollection[i].Comment, (SelectList)Model.QuestionsList, new { ID = "drop", @class = "select-css form-control dropques text-box single-line", @onchange = "QuestionChanged(this.id, this.value)", onmouseover = "dropDwnToolTips(this)" })


                                                                    </td>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.QuestionsCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                    </td>
                                                                    <td>


                                                                        @Html.DropDownListFor(m => m.QuestionsCollection[i].RatingId, (SelectList)Model.QuestionsLevelList, new { @class = "select-css form-control droprating", @disabled = "disabled" })


                                                                    </td>

                                                                    <td>

                                                                        @Html.EditorFor(m => m.QuestionsCollection[i].Timing, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @min = "1", @readonly = "readonly" } })

                                                                    </td>

                                                                    @*<td class="action text-center">
                                                <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                <span id="btnMinus" onclick="DeleteRow(this, 'QuestionsCollection', 'Comment', 'SkillName', 'RatingId', 'Timing')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                            </td>*@

                                                                </tr>


                                                            }

                                                        }




                                                    </tbody>
                                                </table>
                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>

                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h3 class="mb-0"><span>Tech Skill Report</span></h3>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive-sm">
                                                <table class="table table-bordered mbn" id="SkillTable">
                                                    <thead>
                                                        <tr>

                                                            <th class="table_heading">Required Level</th>
                                                            <th class="table_heading">Skill Name</th>
                                                            <th class="table_heading">Actual Level</th>
                                                            <th class="table_heading">Required Weightage</th>
                                                            <th class="table_heading">Actual Weightage</th>
                                                        </tr>
                                                    </thead>


                                                    <tbody>
                                                        @if (Model.TechSkillReportCollection != null)
                                                        {
                                                            @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                            {
                                                                <tr>

                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.TechSkillReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                    </td>
                                                                    <td>
                                                                        @Html.TextBoxFor(m => m.TechSkillReportCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                    </td>

                                                                    <td>
