                                                <div>
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.InterviewerComment, htmlAttributes: new { @class = "textarealabel col-md-12 col-sm-12 desp-label" })


                                                        <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                            <div class="talktext">
                                                                @Html.TextAreaFor(m => m.InterviewerComment, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "height: 100px; width:100%" })

                                                            </div>
                                                        </div>

                                                        @Html.ValidationMessageFor(model => model.InterviewerComment, "", new { @class = "text-danger" })
                                                    </div>
                                                    <div class="form-group">
                                                        <span>

                                                        </span>
                                                    </div>


