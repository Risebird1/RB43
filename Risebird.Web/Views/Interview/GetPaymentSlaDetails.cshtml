<script>
    function NotApproved(interviewid) {
        $.ajax({
            type: "POST",
            url: "/Interview/PaymentSlaDetailsNotApproved",
            data: { interviewid: interviewid },
            success: function (data) {
                swal.fire(data);
                location.reload();
            }
        });
    }
</script>
<script>
    function ChangeCheckBox(groupName) {
        var result = $('input[name="' + groupName + '"]:checked');
        var resultString = '';
        if (result.length > 0) {
            result.each(function () {
                if (resultString == '') {
                    resultString += $(this).val();
                } else {
                    resultString += "," + $(this).val();
                }
            });
            $('#' + groupName).val(resultString);
        }
        else {
            $('#' + groupName).val("");
        }
        CountCheckBox();
    }
    function CountCheckBox() {
        var countcheck = 0;
        $('#accordion2').find(':checkbox').each(function () {
            var vlucheck = $(this)[0].checked;
            if (vlucheck) {
                countcheck = countcheck + 1;
            }
        });
        $("#PaymentComplianceCount").val(countcheck);
    }
</script>
