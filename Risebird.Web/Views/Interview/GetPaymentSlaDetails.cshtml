<style>
    .popup {
        margin: 0 auto;
        position: relative;
        text-align: center;
        z-index: 999;
        width: calc(100% - 35px);
    }

        .popup:after {
            content: "";
            height: 100%;
            width: 100%;
            border-radius: 4px;
            position: absolute;
            top: 0;
            left: 0;
            box-shadow: 0 1px 14px rgba(0,0,0,.2);
        }

        .popup:before {
            content: "";
            width: 20px;
            height: 20px;
            transform: rotate(45deg);
            box-shadow: 0 1px 14px rgba(0,0,0,.2);
            background: #fff;
            position: absolute;
            z-index: 998;
        }
        /*
                        Different arrow positioning
                        */
        .popup.arrow-top:before {
            left: calc(10% - 10px);
            top: -4px;
        }

    }

    .popup.arrow-right:before {
        top: calc(50% - 10px);
        right: -8px;
    }

    .popup.arrow-bottom:before {
        left: calc(50% - 10px);
        bottom: -8px;
    }

    .popup.arrow-left:before {
        top: calc(50% - 10px);
        left: -8px;
    }


    .popup-wrapper {
        width: 100%;
        padding: 2px;
        border-radius: 4px;
        background: #fff;
        position: relative;
        z-index: 998;
        margin-bottom: 20px;
        height: 70px;
    }

        .popup-wrapper textarea {
            border: 0px;
            height: 95%;
            width: 100%;
        }

            .popup-wrapper textarea::placeholder {
                font-weight: normal;
                opacity: 0.5;
                color: #676464;
            }

</style>
