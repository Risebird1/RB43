                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Client">
                                                                    Client
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Client" name="Client" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.Client).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
