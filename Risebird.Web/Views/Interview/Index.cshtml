<script>
    var closeMember = document.getElementById("membersPopUp");
    // When the user clicks on <span> (x), close the modal
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewerMemberModal");
        modal.style.display = "none";
    }
    function getIRFMembers(id) {

        $.ajax({
            url: '/IRF/GetIRFInterviewerMembers',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);


            }
        });
    }

</script>
<script>
    var span = document.getElementById("sentimentPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        var modal = document.getElementById("sentimentModal");
        modal.style.display = "none";
    }


    function SentimentModalClick(imid) {

        // Get the modal
        var modal = document.getElementById("sentimentModal");

        // When the user clicks the button, open the modal
        modal.style.display = "block";
        document.getElementById("sentimentImid").value = imid;
    }
</script>


