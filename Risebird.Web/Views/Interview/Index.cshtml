                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                <tr id=@item.imid>
                                                    <td class="text-right action">
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Interviewing Members">
