@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Interview";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] RFID = new string[] { };
    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] Interviewer = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("Interviewfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("Interviewfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
}




<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand"></a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content interview">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="row">

                                    <div class="card-header">
                                        <div class="pull-left"> <h4 class="card-title">Interview</h4></div>

                                        <div class="pull-right">
                                            <div>



                                                <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" style="margin-top: 2px;" data-toggle="modal" data-target="#filterModal">

                                                    <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                                    <div class="mdc-button__ripple"></div>
                                                </button>

                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px; ">
                                                    <span  data-toggle="tooltip" data-placement="top" title="Click here to Broadcast Message" onclick="OpenBroadcastModal()" data-original-title="Tooltip on top"><svg class="broadcast-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"><path fill-rule="evenodd"  fill="rgb(255, 255, 255)" d="M21 6h-7.59l3.29-3.29L16 2l-4 4-4-4-.71.71L10.59 6H3c-1.1 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.11-.9-2-2-2zm0 14H3V8h18v12zM9 10v8l7-4z" /></svg><font style="font-family: Roboto, sans-serif; font-size:12px;"> Broadcast</font></span>
                                                </button>

                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                    <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "Interview")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Interview</font></span>
                                                </button>

                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                    <span class="fa fa-plus-clone" data-toggle="tooltip" data-placement="top" title="Multiple Candidate Invite" onclick="location.href='@Url.Action("MultipleCandidateInvites", "Interview")'" data-original-title="Tooltip on top"><font style="font-size:12px;    font-family: Roboto, sans-serif;"> Multiple Candidate Invites</font></span>
                                                </button>



                                                <i type="submit" class="fa fa-file-excel-o excel-file" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("InterviewsExporttoExcel", "Interview")'"></i>

                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                                <h5 class="modal-title" id="filterModalLabel">Filter</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <form action="@Url.Action("Index","Interview")" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Primary Skill</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                            }
                                                                        }
                                                                    </select>


                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                    Client
                                                                    HR
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                    Meeting Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="MeetingStatus" name="MeetingStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.MeetingStatusStatusDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                    Interviewer
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Interviewer" name="Interviewer" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.interviewer).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="RFID">RFID</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.IRFId).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label  col-md-12 col-sm-12 desp-label" for="ConfirmationStatus">
                                                                    Confirmation Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.confirmationStatus).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                    Interview Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group col-md-12">
                                                                <div class="row">
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>



                                                                        <!--  <button type="submit" style="margin-top:30px; float:right" class="btn btn-primary">Apply Filter</button>-->
                                                                    </div>

                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <div id="tableID" class="second">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD Link</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom ID</th>
                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>QC Interviewer</th>
                                                    <th>Co-ordinating HR</th>
                                                    <th>HR Comments</th>
                                                    <th>Staffing Agenecy</th>
                                                    <th>Interview Duration</th>
                                                    <th>Expected Joining Time</th>
                                                    <th>Preferred Location</th>
                                                    <th>Expected Salary</th>
                                                    <th>Current Employer</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Aadhar Link</th>
                                                    <th>Approval Status</th>
                                                    <th>Approval Comments</th>
                                                    <th class="no-sort"></th>
                                                    <th>Final Selection Status</th>
                                                    <th>Final Selection Comments</th>
                                                    <th class="no-sort"></th>
                                                    @*<th>Interview Device Details</th>*@
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th style="text-align:center">Call</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD Link</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom ID</th>

                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>QC Interviewer</th>
                                                    <th>Co-ordinating HR</th>
                                                    <th>HR Comments</th>
                                                    <th>Staffing Agenecy</th>
                                                    <th>Interview Duration</th>
                                                    <th>Expected Joining Time</th>
                                                    <th>Preferred Location</th>
                                                    <th>Expected Salary</th>
                                                    <th>Current Employer</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Aadhar Link</th>
                                                    <th>Approval Status</th>
                                                    <th>Approval Comments</th>
                                                    <th class="no-sort"></th>
                                                    <th>Final Selection Status</th>
                                                    <th>Final Selection Comments</th>
                                                    <th class="no-sort"></th>
                                                    @*<th>Interview Device Details</th>*@
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th style="text-align:center">Call</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                    <tr id=@item.imid>
                                                        <td title=@item.IRFId> @item.IRFId </td>
                                                        <td> @item.interviewDate </td>
                                                        @if (item.IsOnline == 1)
                                                        {
                                                            <td>
                                                                <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>    @item.candidateName </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                 @item.candidateName 
                                                            </td>
                                                        }
                                                        <td> @item.candidateEmail</td>
                                                        <td> @item.JDTiltle.Split("|")[0] </td>
                                                        @if (@item.interviewer != null || @item.interviewer != "")
                                                        {
                                                            @if (item.IsInterviewerOnline == 1)
                                                            {
                                                                <td>
                                                                    <a onclick="directopenChat('@item.interviewer')"><span class="dot" style="background-color:green"></span>    @item.interviewer </a>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td>
                                                                     @item.interviewer 
                                                                </td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.confirmationStatus.Trim() == "Cancelled")
                                                        {
                                                            <td class="text-center">

                                                                <a style="color:red"> @item.confirmationStatus</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center"> @item.confirmationStatus</td>
                                                        }

                                                        <td> @item.MeetingStatusStatusDesc</td>
                                                        <td> @item.intervieweStatusStatDesc</td>
                                                        @if (item.resumeLink != null && item.resumeLink != "")
                                                        {
                                                            <td>

                                                                <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }
                                                        @if (item.JDLink != null && item.JDLink != "")
                                                        {
                                                            <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td>No JD</td>
                                                        }

                                                        @if (item.zoomLink != null && item.zoomLink != "")
                                                        {
                                                            <td> <a id="zoomlinkId" target="_blank" title="Zoom Link" href=@item.zoomLink>Zoom Link</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Zoom Link</td>
                                                        }
                                                        <td> @item.risebirdHR</td>

                                                        @if (item.IsHrOnline == 1)
                                                        {
                                                            <td>
                                                                <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                               @item.ClientHrContact
                                                            </td>
                                                        }
                                                        <td> @item.ClientName </td>

                                                        @if (item.VideoLink != null && item.VideoLink != "")
                                                        {
                                                            <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Video</td>
                                                        }
                                                        <td>@item.interviewSlot</td>
                                                        <td>@item.QCInterviewer</td>
                                                        <td>@item.HRCoordinatorEmailId</td>
                                                        <td>@item.HRComment</td>
                                                        <td>@item.staffingAgency</td>
                                                        <td> @item.interviewDuration </td>
                                                        <td> @item.joiningTime</td>
                                                        <td> @item.preferredLocation</td>
                                                        <td> @item.expectedPerHourRate</td>
                                                        <td> @item.currentEmployerName</td>
                                                        <td>
                                                            @item.IsEmergency
                                                        </td>
                                                        @if (item.AadharFileLink != null && item.AadharFileLink != "")
                                                        {
                                                            <td>

                                                                <a id="aadharLinkId" target="_blank" title="Aadhar" href=@item.AadharFileLink>Aadhar</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No document</td>
                                                        }
                                                        <td>
                                                            @item.NextLevelApprovalStat
                                                        </td>
                                                        <td>
                                                            <div class="talk-bubble tri-right border-bubble right-in cmt-w">
                                                                <div class="talktext">
                                                                    <textarea class="scrollbar" style="height: 40px; width:100%;">@item.ApprovalComments</textarea>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td></td>

                                                        <td>
                                                            @item.FinalSelectionStat
                                                        </td>
                                                        <td>
                                                            <div class="talk-bubble tri-right border-bubble right-in cmt-w">
                                                                <div class="talktext">
                                                                    <textarea class="scrollbar" style="height: 40px; width:100%;">@item.FinalComments</textarea>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td></td>

                                                        <td class="text-right action">

                                                            <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                                <span onclick="location.href = '@Url.Action("Edit", "Interview", new { id = item.imid})'" title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                            </button>

                                                            <button class="mdc-fab app-fab--absolute mdc-fab-secondary" aria-label="Comment">
                                                                <span onclick="location.href = '@Url.Action("AddComments", "Interview", new { interviewId = item.imid})'" title="HR and QC Comment" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3zm-4 8H5V9h8v2zm0-3H5V6h8v2z" /></svg></span>
                                                            </button>

