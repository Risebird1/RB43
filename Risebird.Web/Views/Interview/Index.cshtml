<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function ModalButtonClick(candidateObj) {
        candidate = candidateObj.candidateName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(candidateObj.MobileNumber);
        //callCandidate('+918888571923');
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }


</script>


<script type="text/javascript">
    var spanbroadcast = document.getElementById("broadcastPopUp");
    // When the user clicks on <span> (x), close the modal
    spanbroadcast.onclick = function () {
        var modal = document.getElementById("broadcastModal");
        modal.style.display = "none";
    }

    var spanbroadcast1 = document.getElementById("broadcastPopUpclose");
    // When the user clicks on <span> (x), close the modal
    spanbroadcast1.onclick = function () {
        var modal = document.getElementById("broadcastModal");
        modal.style.display = "none";
    }


    function OpenBroadcastModal() {
        // Get the modal
        var modalBct = document.getElementById("broadcastModal");

        //// When the user clicks the button, open the modal
        modalBct.style.display = "block";
        return;

    }

    function SendBroadcast() {
       
        var message = document.getElementById("bcMessage").value;
        var subject = document.getElementById("bcSubject").value;

        var ele = document.getElementsByName('receivers');
        for (i = 0; i < ele.length; i++) {
            if (ele[i].checked) {
                var receiver = ele[i].value;
            }
        }


        $.ajax({
            type: "GET",
            url: "/Interview/Broadcast",
            data: {
                'message': message, 'subject': subject, 'receiver': receiver
            },
            success: function (data) {
                location.reload(true);

            }
        });
    }

</script>

<script>
    var meetingId;

    var spanComment = document.getElementById("hrCommentPopUp");
    // When the user clicks on <span> (x), close the modal
    spanComment.onclick = function () {
        var modal = document.getElementById("hrCommentModal");
        modal.style.display = "none";
    }

    function OpenCommentModal(id, date, commentVal) {
        meetingId = id;
        // Get the modal
        var modal = document.getElementById("hrCommentModal");

        document.getElementById("hrCommentHeading").innerHTML = "Add comment for interview dated: " + date;

        if (commentVal != null && commentVal != "") {
            $("#hrCommentValue").val(commentVal);
        }
        // When the user clicks the button, open the modal
        modal.style.display = "block";


    }
    function SaveHRCommentPopUp() {
        var comment = document.getElementById("hrCommentValue").value;

        $.ajax({
            type: "GET",
            url: "/Interview/SaveHRComment",
            data: { id: meetingId, 'comment': comment },
            success: function (data) {

                location.reload(true);

            }
        });
    }
</script>
<script>
    $(document).ready(function () {
        $('.sendButton').attr('disabled', true);
        $('input[type="text"],textarea').on('keyup', function () {
            var textarea_value = $("#bcMessage").val();
            var text_value = $('input[name="textField"]').val();
            if (textarea_value != '' && text_value != '') {
                $('.sendButton').attr('disabled', false);
                
            } else {
                $('.sendButton').attr('disabled', true);
            }
        });
    });
</script>
