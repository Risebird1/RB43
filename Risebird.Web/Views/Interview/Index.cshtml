            cancelButtonText: "Don't",
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PublicCancelInterview',
                        type: 'POST',
                        data: { 'id': id, 'interviewDate': interviewdate, 'candidateEmail': CandidateEmail, 'emailId': $("#hidtxtemailid").val(), 'IRFId': IRFid, 'zoomMeetingId': zoomMeetingId },
                        success: function (data) {
                            if (data != null && data.toLowerCase().includes('success')) {
                                resolve(data);

                            }
                            else {
                                swal.fire("Error cancelling!", "Please try again", "error");

                            }

                        }
                    });

                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Cancelled!',
                    type: 'success',
                    html: '<p>Meeting cancelled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    //window.location = "/IRF/Index";
                    //location.reload(true);
                    document.getElementById(elementId).style.display = "none";
                })

            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Aborted!',
                    'Meeting remains confirmed! :)',
                    'error'
                )
            }
        })


    }

        </script>


