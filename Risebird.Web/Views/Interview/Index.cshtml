@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interview";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] RFID = new string[] { };
    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] Interviewer = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("Interviewfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("Interviewfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
}



<style>

    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }

    .no-sort::after {
        display: none !important;
    }

    .no-sort {
        pointer-events: none !important;
        cursor: default !important;
    }

    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    table {
        white-space: nowrap !important;
    }

    td.wordwrap {
        display: inline-block !important;
        max-width: 250px !important;
        min-width: 250px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: top !important;
        white-space: nowrap !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }

    /*CSS FOR Loader*/
    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
            height: 100px;*/
        display: none;
        position: center !important;
        background-color: White;
        z-index: 999;
        /*opacity: 0.5;*/
        filter: alpha(opacity = 50);
    }
    /*table.dataTable > thead > tr > th {
        max-width: 200px !important;
    }*/
    table.dataTable > thead > tr > th, table.dataTable > tbody > tr > th, table.dataTable > tfoot > tr > th, table.dataTable > thead > tr > td, table.dataTable > tbody > tr > td, table.dataTable > tfoot > tr > td {
        max-width: 300px !important;
    }
</style>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interview</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Interview</h4>
                    </div>

                    <div class="card-body">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="row">
                                    <div class="col-md-3 ml-md-auto">
                                        <div class="form-group">

                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#filterModal" style="margin-top: 2px;"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"> Filter</span></button>
                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "Interview")'" data-original-title="Tooltip on top"> Add Interview</span></button>
                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;"><span class="fa fa-plus-clone" data-toggle="tooltip" data-placement="top" title="Multiple Candidate Invite" onclick="location.href='@Url.Action("MultipleCandidateInvites", "Interview")'" data-original-title="Tooltip on top"> Multiple Candidate Invites</span></button>
                                        <i type="submit" class="fa fa-file-excel-o" style="margin-right:10px;float:right;color:green;font-size: 35px;margin-top:3px; margin-left:3px" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("InterviewsExporttoExcel", "Interview")'"></i>

                                    </div>


                                </div>
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                                <h5 class="modal-title" id="filterModalLabel">Advanced Filters</h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <form action="@Url.Action("Index","Interview")" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="PrimarySkill">Primary Skill</label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientHR">
                                                                    Client
                                                                    HR
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="MeetingStatus">
                                                                    Meeting Status
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="MeetingStatus" name="MeetingStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.MeetingStatusStatusDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="Interviewer">
                                                                    Interviewer
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="Interviewer" name="Interviewer" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.interviewer).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">RFID</label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.IRFId).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="ConfirmationStatus">
                                                                    Confirmation Status
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.confirmationStatus).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-6 col-sm-4 desp-label" for="InterviewStatus">
                                                                    Interview Status
                                                                </label>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group col-md-12">
                                                                <div class="row">
                                                                    <div class="col-md-6 col-sm-6">
                                                                        <button type="submit" style="margin-top: 40px; float:right" class="btn btn-primary">Apply Filter</button>
                                                                    </div>
                                                                    <div class="col-md-6 col-sm-6">
                                                                        <button type="button" id="ResetFilter" style="float:right;margin-top: 39px;" class="btn btn-primary">Reset Filter</button>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <div id="tableID">
                                        <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD Link</th>
                                                    <th>Zoom Link</th>
                                                    <th>Risebird HR</th>
                                                    @*<th>Candidate Contact</th>*@
                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>Staffing Agenecy</th>
                                                    <th>Interview Duration</th>
                                                    <th>Expected Joining Time</th>
                                                    <th>Preferred Location</th>
                                                    <th>Expected Per Hour Rate</th>
                                                    <th>Current Employer</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Approval Status</th>
                                                    <th>Approval Comments</th>
                                                    <th class="no-sort"></th>
                                                    <th>Final Selection Status</th>
                                                    <th>Final Selection Comments</th>
                                                    <th class="no-sort"></th>
                                                    @*<th>Interview Device Details</th>*@
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th style="text-align:center">Call</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD Link</th>
                                                    <th>Zoom Link</th>
                                                    <th>Risebird HR</th>
                                                    @*<th>Candidate Contact</th>*@
                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>Staffing Agenecy</th>
                                                    <th>Interview Duration</th>
                                                    <th>Expected Joining Time</th>
                                                    <th>Preferred Location</th>
                                                    <th>Expected Per Hour Rate</th>
                                                    <th>Current Employer</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Approval Status</th>
                                                    <th>Approval Comments</th>
                                                    <th class="no-sort"></th>
                                                    <th>Final Selection Status</th>
                                                    <th>Final Selection Comments</th>
                                                    <th class="no-sort"></th>
                                                    @*<th>Interview Device Details</th>*@
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th style="text-align:center">Call</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                <tr id=@item.imid>
                                                    <td title=@item.IRFId> @item.IRFId </td>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.candidateName</td>
                                                    <td> @item.candidateEmail</td>
                                                    <td> @item.JDTiltle.Split("|")[0] </td>
                                                    <td> @item.interviewer</td>
                                                    <td> @item.confirmationStatus</td>
                                                    <td> @item.MeetingStatusStatusDesc</td>
                                                    <td> @item.intervieweStatusStatDesc</td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }

                                                    <td class="wordwrap"> @item.zoomLink</td>
                                                    <td> @item.risebirdHR</td>
                                                    @*<td>@item.MobileNumber</td>*@
                                                    <td> @item.ClientHrContact </td>
                                                    <td> @item.ClientName </td>

                                                    @if (item.VideoLink != null && item.VideoLink != "")
                                                    {
                                                        <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Video</td>
                                                    }
                                                    <td>@item.interviewSlot</td>
                                                    <td>@item.staffingAgency</td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.joiningTime</td>
                                                    <td> @item.preferredLocation</td>
                                                    <td> @item.expectedPerHourRate</td>
                                                    <td> @item.currentEmployerName</td>
                                                    <td>
                                                        @item.IsEmergency
                                                    </td>
                                                    <td>
                                                        @item.NextLevelApprovalStat
                                                    </td>
                                                    <td>
                                                        <textarea style="height: 50px; width:100%;">@item.ApprovalComments</textarea>
                                                    </td>
                                                    <td></td>


                                                    <td>
                                                        @item.FinalSelectionStat
                                                    </td>
                                                    <td>
                                                        <textarea style="height: 50px; width:100%;">@item.FinalComments</textarea>
                                                    </td>
                                                    <td></td>
                                                    @*<td class="wordwrap"> @item.interviewOnDevice</td>*@
                                                    <td class="text-right">
                                                        <span onclick="location.href = '@Url.Action("Edit", "Interview", new { id = item.imid})'" title="Edit" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                                        <span onclick="location.href = '@Url.Action("AddComments", "Interview", new { interviewId = item.imid})'" title="Comment" class="btn btn-round btn-warning btn-icon btn-sm edit"><i class="far fa-comment"></i></span>
                                                        <span onclick="location.href = '@Url.Action("AddReport", "Interview", new { interviewId = item.imid, irfId= item.irfIntId})'" title="Feedback Report" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-file-pdf-o"></i></span>
                                                        @if (item.IsBiometricEnabled)
                                                        {
                                                            <span onclick="location.href = '@Url.Action("VerifyAudio", "Interview", new { candidateId = item.CandidateId, irfId= item.irfIntId, meetingId = item.imid})'" title="Upload audio for verification" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-microphone"></i></span>

                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                        {
                                                            <button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="ModalButtonClick(@jsonObject)" data-original-title="Tooltip on top"> Call Candidate</span></button>
                                                        }

                                                    </td>
                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>


                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <div id="myModal" class="modal" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
