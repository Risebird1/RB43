    // When the user clicks on <span> (x), close the modal
    spanbroadcast1.onclick = function () {
        var modal = document.getElementById("broadcastModal");
        modal.style.display = "none";
    }


    function OpenBroadcastModal() {
        // Get the modal
        var modalBct = document.getElementById("broadcastModal");

        //// When the user clicks the button, open the modal
        modalBct.style.display = "block";
        return;

    }

    function SendBroadcast() {

        var message = document.getElementById("bcMessage").value;
        var subject = document.getElementById("bcSubject").value;
        var irfid = document.getElementById("irflist").value;
        var ele = document.getElementsByName('receivers');
        for (i = 0; i < ele.length; i++) {
            if (ele[i].checked) {
                var receiver = ele[i].value;
            }
        }
        $.ajax({
            type: "GET",
            url: "/Interview/Broadcast",
            data: {

                'message': message, 'subject': subject, 'receiver': receiver, 'irfid': irfid
            },
            success: function (data) {
                window.location.href = '/Interview/Index';

            }
        });
    }
    function openCandidateFeedbackModel() {
        var modal = document.getElementById("CandidateFeedbackModel");
        modal.style.display = "block";
    }
    function closeCandidateFeedbackModel() {
        var modal = document.getElementById("CandidateFeedbackModel");
        modal.style.display = "none";
    }
    function CandidateFeedback(interviewid) {
        $.ajax({
            type: "POST",
            url: "/Interview/FetchCandidateFeedback",
            data: { interviewid: interviewid },
            success: function (data) {
                openCandidateFeedbackModel();
                $("#txtinterviewid").val(interviewid);
                BindCandidateFeedback(data);
            }
        });
    }
    function BindCandidateFeedback(Data) {
        var html = '';
        document.getElementById("btnresendform").style.display = "none";
        if (Data == null) {
            html = 'No Feedback record found';
            document.getElementById("btnresendform").style.display = "block";
        } else {
            html += '<p><b>Overall, how would you rate the video interview experience?</b></p>';
            html += '<p>FeedBack: ' + Data.question1 + ' out of 5</p>';
            html += '<p><b>How would you rate the evaluation process of interviewer?</b></p>';
            html += '<p>FeedBack: ' + Data.question2 + ' out of 5</p>';
            html += '<p><b>Given a chance would you like to reappear for the video interview?</b></p>';
            if (Data.question3 == "1") {
                html += '<p>FeedBack: No, I am satisfied with the interviewer and evaluation process</p>';
            } else {
                html += '<p>FeedBack: Yes, I did not get a fair chance and I can do better</p> ';
            }
            html += '<p><b>What did you like about the video interviews event?</b></p>';
            html += '<p>FeedBack: ' + Data.question4 + '</p>';
            html += '<p><b>What did you dislike about the video interviews event?</b></p>';
            html += '<p>FeedBack: ' + Data.question5 + '</p>';
            html += '<p><b>How friendly was the Risebird staff from scheduling to completion of interviews ?</b></p>';
            html += '<p>FeedBack: ' + Data.question6 + ' out of 5</p>';
            if (Data.commentforInterviewer != null) {
                html += '<p><b>Comments:</b> ' + Data.commentforInterviewer + '</p>';
            } else {
                html += '<p><b>Comments:</b> </p>';
            }
        }
        $("#divcandidatefeedback").empty().html(html);
    }
    function ResendFeedbackForm() {
        var interviewid = $("#txtinterviewid").val();
        var candidateemail = $("#txtcandidateemail_" + interviewid).val();
        $.ajax({
            type: "POST",
            url: "/Interview/ResendFeedbackform",
            data: { interviewid: interviewid, CandidateEmail: candidateemail },
            success: function (data) {
                alert(data);
                closeCandidateFeedbackModel();
            }
        });
    }
</script>
<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
