@model List<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "QCOpenInterviews";
}
<script>
    var Header = "<div>Open QC Interviews</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<div class="main-panel" id="main-panel">
<div class="mt50">
        <div class="col-md-12 nopad" style="margin:0px 0px 8px 0px;padding:5px 0px!important">
          <div class="mobile-view"> 
              <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <h4 class="card-title">QC Open Interviews</h4>
                </div>
              
               
            </div>
            </div>
        </div>
    </div>
<div class="content client">
    <div class="row bl-bg">
        <div class="col-md-12">
            <div class="mdc-card card bl-bg">
                <div class="mdc-card-wrapper__text-section">
                    <div class="loader text-center">
                        <img src="~/Newassets/img/lazyload.gif" />
                    </div>
                    <div class="dataloading">
                        <div class="toolbar">
                            <div class="scrollbar int-table" id="style-2">
                                <div id="tableID" class="second ">
                                    <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Candidate</th>
                                                <th>JD Link</th>
                                                @* <th>Channel Owner</th> *@
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Candidate</th>
                                                <th>JD Link</th>
                                                @* <th>Channel Owner</th> *@
                                                <th>Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.IRFId</td>
                                                    <td>@item.interviewDate</td>
                                                        <td>@item.NickName</td>
                                                    <td>@item.candidateEmail</td>
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }
                                                    @* <td>@item.ChannelOwner</td> *@
                                                    <td class="text-center">
                                                        <button  class="mdc-fab app-fab--absolute mdc-fab-secondary voicebiobtn" aria-label="Upload audio for verification"><span onclick="AssignYourSelf('@item.imid')" title="Assign Yourself"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <circle cx="9" cy="7" r="3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M11 13H7C4.79086 13 3 14.7909 3 17C3 18.6569 4.34315 20 6 20H12C13.6569 20 15 18.6569 15 17C15 14.7909 13.2091 13 11 13Z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M21 8L18 11L16.5 9.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg></span></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<script>
    function AssignYourSelf(id) {
        $.ajax({
            url: '/Interview/AssignYourSelfForMyQCInterviws',
            data: { 'id': id },
            type:'Post',
            success: function (data) {

                swal.fire({ text: data}).then((result) => {
                    location.reload(true);
                });
            }

        });
    }


</script>

<script>
        $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
    }
</script>

