<script>
    document.querySelector("#CodeSnippetFile").onchange = function () {
    document.querySelector("#files-names").textContent = this.files[0].name;
    }

 </script>
<script>
    function CodeSnippetFileUpload() {
        var fileControl = document.getElementById("CodeSnippetFile");
        var interviewid = $("#interviewid").val();
        var fileChunk = new FormData();
        fileChunk.append('interviewid', interviewid);
        if (fileControl.files.length > 0) {
            for (var i = 0; i < fileControl.files.length; i++) {
                fileChunk.append('file', fileControl.files[i]);
            }
        }
        $("#btnfileUpload").hide();
        document.getElementById("txtfileuploading").style.display = "block";
        $("#txtfileuploading").text("Uploading...");
        $.ajax({
            type: "POST",
            url: "/IRF/UploadInterviewCodeSnippet",
            data: fileChunk,
            contentType: false,
            enctype: 'multipart/form-data',
            processData: false,
            success: function (data) {
                $("#txtfileuploading").text(data);
                $("#btnfileUpload").show();
                //FetchCodesnippet();
            }
        });
    }
    function CodeSnippetTextSave() {
        var interviewid = $("#interviewid").val();
        var codesnippettext = $("#addcoding").val();
        $("#btnSaveText").hide();
        $.ajax({
            type: "POST",
            url: '/IRF/UploadInterviewTextCodeSnippet',
            data: {'interviewid':interviewid,'codesnippettext':codesnippettext},
            success: function (data) {
                 alert(data);
                $("#btnSaveText").show();
            }
        });
    }
</script>
<!---new page-->
