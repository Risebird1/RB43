                                                            @Html.TextBoxFor(model => model.ThumbnailTimeSeconds, new { type = "number", @class = "form-control text-box single-line col-lg-12 col-md-12 col-sm-12 col-xs-12" })
                                                        </div>
                                                        @if (ViewBag.Profile == "Admin" || ViewBag.Profile == "HR" || ViewBag.Profile == "SeniorHR")
                                                        {

                                                            <div class="form-group">
