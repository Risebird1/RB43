<script>
    function getPDF() {

        var HTML_Width = $(".canvas_div_pdf").width();
        var HTML_Height = $(".canvas_div_pdf").height();
        var top_left_margin = 15;
        var PDF_Width = HTML_Width + (top_left_margin * 2);
        var PDF_Height = (PDF_Width * 1.5) + (top_left_margin * 2);
        var canvas_image_width = HTML_Width;
        var canvas_image_height = HTML_Height;

        var totalPDFPages = Math.ceil(HTML_Height / PDF_Height) - 1;


        html2canvas($(".canvas_div_pdf")[0], { allowTaint: false }).then(function (canvas) {
            canvas.getContext('2d');

            var imgData = canvas.toDataURL("image/png", 1.0);
            var pdf = new jsPDF('p', 'pt', [PDF_Width, PDF_Height]);
            pdf.addImage(imgData, 'JPG', top_left_margin, top_left_margin, canvas_image_width, canvas_image_height);


            for (var i = 1; i <= totalPDFPages; i++) {
                pdf.addPage(PDF_Width, PDF_Height);
                pdf.addImage(imgData, 'JPG', top_left_margin, -(PDF_Height * i) + (top_left_margin * 4), canvas_image_width, canvas_image_height);
            }
            var d = new Date();

            var filename = $('#CandidateName').val() + "_" + d.getDate() + "_" + (d.getMonth() + 1) + "_" + d.getFullYear();
            pdf.save(filename + ".pdf")

        });

    }
    function GeneratePublicUrl(index) {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "block";
        var urlcurrent = window.location.href;
        if (index == 1) {
            urlcurrent = urlcurrent.replace("Public", "");
            urlcurrent = urlcurrent.replace("AddReport", "ExecutiveReport");
            urlcurrent = urlcurrent.replace("ProctorReport", "ExecutiveReport");
        }
        else {
            urlcurrent = urlcurrent.replace("Public", "");
            urlcurrent = urlcurrent.replace("AddReport", "InstaAddReport");
            urlcurrent = urlcurrent.replace("ProctorReport", "InstaAddReport");
        }
        $("#txtvideoUrls").text(urlcurrent);
    }
    function closePublicUrlShareModel() {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
</script>
<script>
    function SubmitForm() {
        //disable button
        document.getElementById("btnUpload").disabled = true;
        if (CheckConditions()) {
            document.getElementById("reportForm").submit();
        }
        else {
            //enable button
            document.getElementById("btnUpload").disabled = false;
            return;

        }
    }
</script>

<script src="~/js/ScoreChart/SetScoreChartValues.js"></script>
<script>


    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("PageVideoLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("VideoFile").value = '';
        }
    }

    function MeetingStatusChanged(value) {
        if (value != null && value != '') {
            document.getElementById('InterviewerComment').disabled = false;
            document.getElementById("interviewerComment_Error").innerHTML = "";
        }
        else {
            document.getElementById('InterviewerComment').value = '';
            document.getElementById('InterviewerComment').disabled = true;
            document.getElementById("interviewerComment_Error").innerHTML = "Select an appropriate value for Meeting Status above to add comments here.";
        }
        if (value != 2) {
            document.getElementById("meetingStatus_Error").innerHTML = "";
        }
        //for dropped
        if (value == 3) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly use this option only in the case when a meeting was dropped so early (5-10 mins) that a conclusive judgement regarding selection cannot be made.";

        }
        //for dropped with interview status
        if (value == 6 || value == 7 || value == 8) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly use this option only in the case when a meeting was dropped but ran for a duration long enough (20 or more mins) to pass a conclusive judgement regarding selection.";
        }
        if (value != 4) {
            if (value == 6) {
                //dropped but selected
                document.getElementById("InterviewStatus").value = '2';
            }
            else if (value == 7) {
                //dropped but rejected
                document.getElementById("InterviewStatus").value = '3';
            }
            else if (value == 8) {
                //dropped but borderline
                document.getElementById("InterviewStatus").value = '4';
            }
            else {
                document.getElementById("InterviewStatus").value = '';
            }
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById("InterviewStatus").disabled = false;
        }
    }

    function CheckConditions() {
        return (CheckInterviewStatus() && CheckMeetingStatus() && CheckInterviewerComments());
    }

    function CheckInterviewerComments() {
        var interviewStatusElem = document.getElementById("InterviewStatus");
        if (interviewStatusElem.value == 2|| interviewStatusElem.value == 4) {
            var comments = document.getElementById("InterviewerComment").value;
            if (comments.length >= 250) {
                document.getElementById("interviewerComment_Error").innerHTML = "";
                return true;
            }
            else {
                //interviewerComment_Error
                document.getElementById("InterviewerComment").focus();
                document.getElementById("interviewerComment_Error").innerHTML="Kindly enter a minimum of 250 characters.";
                return false;
            }
        }
        else
            return true;
    }

    function CheckMeetingStatus() {
        var meetingStatusElem = document.getElementById("MeetingStatus");
        if (meetingStatusElem.value == 2 || (meetingStatusElem.value == null || meetingStatusElem.value == '')) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly change the Meeting Status to an appropriate value.";
            meetingStatusElem.focus();
            return false;
        }
        else {
            document.getElementById("meetingStatus_Error").innerHTML = "";
            return true;

        }

    }

    function CheckInterviewStatus() {
        var meetingStatusElem = document.getElementById("MeetingStatus");
        if (meetingStatusElem.value == 4) {
            var interviewStatusElem = document.getElementById("InterviewStatus");
            if (interviewStatusElem.value == null || interviewStatusElem.value == '') {
                document.getElementById("interviewStatus_Error").innerHTML = "Kindly change the Interview Status to an appropriate value.";
                interviewStatusElem.focus();
                return false;
            }
            else {
                document.getElementById("interviewStatus_Error").innerHTML = '';
            }

        }
        return true;
    }
</script>
