                            @Html.HiddenFor(x => x.OldMeetingStatus)
                            @Html.HiddenFor(x => x.OverallScore)
                            @if (ViewBag.Profile == "Interviewer" || ViewBag.Profile == "Quality Controller")
                            {
                                @Html.HiddenFor(x => x.ThumbnailTimeSeconds)
                                @Html.HiddenFor(x => x.VideoDuration)
                            }
                            @Html.HiddenFor(x => x.OldInterviewerComment)
                            @Html.HiddenFor(x => x.IsEdited)
                            @Html.HiddenFor(x => x.ResourceUrl)

                        </form>
                    </div>

                    <!-- end content-->
