@model Risebird.Entities.ViewModel.InterviewReport
@using System.Text.RegularExpressions
@using Risebird.Entities.Enum
@using Microsoft.Extensions.Configuration;

@inject IConfiguration configuration


@{
    ViewData["Title"] = "Interview Proctor Report";
    ViewBag.PageHeader = "Interview Proctor Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var meetingStatusList = new List<SelectListItem>();
    if (ViewBag.Profile == "Admin" || ViewBag.Profile == "SeniorHR")
    {
        meetingStatusList = Html.GetEnumSelectList<MeetingStatus>().ToList();
    }
    else
    {
        meetingStatusList = Html.GetEnumSelectList<MeetingStatus>().Where(x => x.Value != ((int)MeetingStatus.NoShowInterviewer).ToString()).ToList();

    }
}
<link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
