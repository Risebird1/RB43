                                                            <!-- Calendly inline widget end -->
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                                            <!-- Calendly inline widget begin -->
                                                            <label style="margin-left:440px"><strong>Sorry! No Proctor details available!</strong></label>
                                                            <!-- Calendly inline widget end -->
                                                        </div>
                                                    </div>
                                                }
                                                <!-- end content-->
                                            </div>
                                        </div>
                                        <!--  end card  -->
                                    </div>
                                    <!-- end col-md-12 -->
                                </div>
                                <!-- end row -->
                            </div>
                            @Html.HiddenFor(m => m.id)
                            @Html.HiddenFor(m => m.IRFId)
                            @Html.HiddenFor(m => m.InterviewId)
                            @Html.HiddenFor(m => m.IsEdited)
                            @Html.HiddenFor(m => m.IsQC)
                            @Html.HiddenFor(m => m.IRFName)
                            @Html.HiddenFor(m => m.PrimarySkill)
                            @Html.HiddenFor(m => m.IsQCRequired)
                            @Html.HiddenFor(m => m.IsProctor)

                            <div class="card-footer ">
