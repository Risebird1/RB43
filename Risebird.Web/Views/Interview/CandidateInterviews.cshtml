@model IEnumerable<Risebird.Entities.Data.Meeting>
@{
    ViewData["Title"] = "My Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<style>
    .spanclass {
        color: black;
        font-size: 11px;
    }

    .desc {
        display: inline-block;
        width: 120px;
        white-space: nowrap;
        overflow: hidden !important;
        text-overflow: ellipsis;
    }

    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 35px;
        margin-bottom: 35px;
    }

    @@media (min-width: 1200px) {
        .container {
            width: 1125px;
        }
    }

    .thumbnail {
        border-top: 5px solid #443f3f;
    }

    .list-group-item-heading {
        font-size: 13px;
        font-weight: 700;
        border-bottom: 1px solid #ccc;
        padding-bottom: 15px;
    }

    .list-group-item-text {
        padding-top: 20px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 20px;
    }

        .list-group-item-text span {
            float: left;
            font-weight: 700;
            padding-right: 5px;
        }

    .icon span {
        padding-top: 15px;
        font-size: 19px;
        color: #5f95b1;
        padding-left: 5px;
    }

    .list-group {
        margin-bottom: 150px;
    }
</style>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Scheduled Interviews
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Scheduled Interviews</h4>
                    </div>
                    <div class="row">
                        <div class="col-md-3 ml-md-auto">
                            <div class="form-group">

                            </div>
                        </div>
                        @*<div class="col-auto">
                                @if (ViewBag.IsClientUser == false)
                                {
                                    <button type="button" style="margin-right: 6px;" class="btn btn-primary"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add IRF" onclick="location.href='@Url.Action("Add", "IRF")'" data-original-title="Tooltip on top"> Add IRF</span></button>

                                }
                                <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#filterModal"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"> Filter</span></button>
                            </div>*@
                    </div>


                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-stats">
                        <div class="card-body ">

                            <div class="statistics statistics-horizontal">
                                <div class="info info-horizontal">
                                    <div class="row">
                                        <div class="col-12 text-center">
                                            <h3 class="info-title" style="font-size:smaller;"> @item.IRFID</h3>
                                        </div>
                                    </div>
                                    <hr>

                                    <div class="row" style="font-size:smaller;">

                                        <div class="col-12">
                                            <div class="group inner list-group-item-text">
                                                <span>Client Name:</span> <p>@item.ClientCompName (@item.ClientName)</p>
                                                <span>Interview Date:</span> <p>@item.interviewDate  </p>                                                
                                                <span>Primary Skills:</span> <p>@item.JDTiltle.Split('|')[0]  </p>
                                                <span>JD Link:</span> <p><a href="@item.JDLink" target="_blank">Job Description</a>  </p>
                                                <span>Job Ends on:</span> <p> @item.EndDate.ToString("dd MMM yyyy") </p>
                                                <span>Resume:</span> <p><a href="@item.resumeLink" target="_blank">Resume</a>   </p>


                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer ">
                            <div class="stats text-center">

                               
                                <button type="button" onclick="window.open('@item.CalendlyLink')" class="btn btn-info btn-icon btn-sm" title="Reschedule Meeting">
                                    <i class="now-ui-icons fa fa-calendar"></i>
                                </button>
                                <button type="button" onclick="window.open('@item.zoomLink')" class="btn btn-warning btn-icon btn-sm" title="Join Meeting">
                                    <i class="now-ui-icons fa fa-meetup"></i>
                                </button>
                                @if (item.InterviewerPhone != null && item.InterviewerPhone != string.Empty && (DateTime.Now.AddMinutes(-5) <= item.interviewDate) && (item.interviewDate <= DateTime.Now.AddMinutes(65)))
                                {
                                    <button type="button" onclick="ModalButtonClick(@jsonObject)" class="btn btn-success btn-icon btn-sm" title="Call Interviewer">
                                        <i class="now-ui-icons fa fa-phone"></i>
                                    </button>
                                }
                               
                                <button type="button" onclick="javascript:CancelInterview(@jsonObject);" class="btn btn-round btn-danger btn-icon btn-sm like" title="Cancel interview request.">
                                    <i class="fa fa-times"></i>
                                </button>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div id="myModal" class="modal" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */">
            <!-- Modal content -->
            <div class="modal-content" style="width:70%;position: relative; background-color: #fefefe; margin: auto; padding: 0;border: 1px solid #888;box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2),0 6px 20px 0 rgba(0,0,0,0.19);font-size: 12px;margin-top:-53px">
                <div class="modal-header" style="padding: 2px 16px;background-color: #14406e;color: white;font-size: 10px;">
                    <h5 style="margin-left:40%;font-size:20px">Call Interviewer!</h5>
                    <span class="close" id="callPopUp">&times;</span>
                </div>
                <div class="modal-body" style="padding: 2px 16px;">
                    <div class="row">
                        <label id="callingLabel" style="margin-top:23px;margin-left:38%; font-size:20px"><b>Calling...</b></label>

                    </div>

                    <div class="">
                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin-left:43%" class="btn btn-fill btn-danger" value="Hang Up">
                    </div>
                </div>
                <div class="modal-footer" style="padding: 2px 16px;
        background-color: #14406e;
        color: white;">

                </div>
            </div>

        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>
<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

<script>
    var interviewerMail = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callInterviewer(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + interviewerMail + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function ModalButtonClick(obj) {
        
        //candidate = candidateObj.candidateName;
        interviewerMail = obj.interviewer;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + interviewerMail + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callInterviewer(obj.InterviewerPhone);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }


</script>
<script>
        function CancelInterview(obj) {

        //var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: "The Interview will be cancelled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel interview!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Interview/CancelInterview?id=' + obj.id+ '&interviewDate=' + obj.interviewDate + '&candidateEmail='+obj.candidateEmail,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error cancelling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successful!',
                    type: 'success',
                    html: '<p>The interview was cancelled!</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interview/CandidateInterviews";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Sorry!',
                    'The interview was not cancelled.',
                    'error'
                )
            }
        })
    }

</script>