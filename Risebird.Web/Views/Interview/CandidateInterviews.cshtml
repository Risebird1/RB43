<script>
    function ShortList(IRFID) {
        $.ajax({
            type: "POST",
            url: "/Interview/ShortListList",
            data: { IRFID: IRFID },
            success: function (data) {
                var modal = document.getElementById("myShorlList");
                modal.style.display = "block";
                var html = '';
                html += '<table style="Width:100%">';
                html += '<tr><td>Client Name</td><td>Shortlisted Date</td></tr>';
                for (var i = 0; i < data.length; i++) {
                    html += '<tr>';
                    html += '<td>' + data[i].clientName.toUpperCase() + '</td>';
                    html += '<td>' + data[i].dateRequired + '</td>';
                    html += "</tr>";

                }
                html += "</table>";
                if (data.length == 0) {
                    html = 'No record found';
                }
                $("#divshortlist").empty().html(html);
            }
        });
    }
    function Interested(IRFID) {
        $.ajax({
            type: "POST",
            url: "/Interview/InterestList",
            data: { IRFID: IRFID },
            success: function (data) {
                var modal = document.getElementById("myintrestList");
                modal.style.display = "block";
                var html = '';
                html += '<div  class="table-responsive-sm"><table style="Width:100%">';
                html += '<tr><td class="client-nme" >Client Name</td><td class="client-date">Interested Date</td><td class="client-cmt">Comments</td><td class="text-center client-action">Action</td></tr>';
                for (var i = 0; i < data.length; i++) {
                    if (data[i].status == "Interest Accepted") {
                        html += '<tr id="tablerow_' + data[i].id + '" style="background-color:#adf9ad96">';
                    }
                    else if (data[i].status == "Interested Passed") {
                        html += '<tr id="tablerow_' + data[i].id + '" style="background-color:#d61f4533">';
                    }
                    else {
                        html += '<tr id="tablerow_' + data[i].id + '">';
                    }
                    html += '<td class="client-nme" style="border-right: 1px #ccc solid;">' + data[i].clientName.toUpperCase() + '</td>';
                    html += '<td class="client-date" style="border-right: 1px #ccc solid;">' + data[i].dateRequired + '</td>';
                    if (data[i].approvalComments.length > 40)
                    {
                        html += '<td class="client-cmt" style="border-right: 1px #ccc solid;"><c title="' + data[i].approvalComments+ '">' + data[i].approvalComments.substr(0, 40) + '...</c></td><td class="text-center client-action">';
                    }
                    else
                    {
                    html += '<td class="client-cmt" style="border-right: 1px #ccc solid;">' + data[i].approvalComments + '</td><td class="text-center client-action">';
                    }
                    //html += '<td class="client-cmt" style="border-right: 1px #ccc solid;">' + data[i].approvalComments + '</td><td class="text-center client-action">';
                    if (data[i].status == "Interest Accepted") {
                        html += '          <button type="button"  class="mdc-fab app-fab--absolute trash-btn" id="btnRejectIntrest_' + data[i].id + '" title="Pass">';
                        html += '            <span  onclick="RejectIntrest(' + data[i].id + ')" title="Pass" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></span>';
                        html += '          </button>';
                    }
                    else if (data[i].status == "Interested Passed") {
                        html += '             <button type="button" class="mdc-fab app-fab--absolute" id="btnAcceptIntrest_' + data[i].id + '" title="Accept">';
                        html += '               <span onclick="AcceptIntrest(' + data[i].id + ')" title="Accept" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 2c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm9 7h-6v13h-2v-6h-2v6H9V9H3V7h18v2z"/></svg></span>';
                        html += '            </button>';
                    }
                    else {
                        html += '             <button type="button"  class="mdc-fab app-fab--absolute" id="btnAcceptIntrest_' + data[i].id + '" title="Accept">';
                        html += '             <span onclick="AcceptIntrest(' + data[i].id + ')" title="Accept" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 2c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm9 7h-6v13h-2v-6h-2v6H9V9H3V7h18v2z"/></svg></span> ';
                        html += '             </button>';
                        html += '             <button type="button" class="mdc-fab app-fab--absolute trash-btn" id="btnRejectIntrest_' + data[i].id + '" title="Pass">';
                        html += '              <span  onclick="RejectIntrest(' + data[i].id + ')" title="Pass" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg></span>';
                        html += '              </button>';
                    }
                    html += "</td></tr>";

                }
                html += "</table></div>";
                if (data.length == 0) {
                    html = 'No record found';
                }
                $("#divIntrestedShown").empty().html(html);
            }
        });
    }
