    function interestConfirm() {
        var id = $("#txtConfirmAccept").val();
        $.ajax({
            type: "POST",
            url: "/Interview/Intrestreaction",
            data: { vedioid: id, Status: "Interest Accepted" },
            success: function (data) {
                $("#btnAcceptIntrest_" + id).attr('disabled', true);
                $("#tablerow_" + id).attr('style', 'background-color:limegreen');
                closeIntrestAccept();
            }
        });
    }
    function closeIntrestAccept() {
        var modal = document.getElementById("myintrestConfirmAccept");
        modal.style.display = "none";
    }
    function closeIntrestPass() {
        var modal = document.getElementById("myintrestConfirmPass");
        modal.style.display = "none";
    }
    function interestConfirmPass() {
        var id = $("#txtConfirmPass").val();


        $.ajax({
            type: "POST",
            url: "/Interview/Intrestreaction",
            data: { vedioid: id, Status: "Interested Passed" },
            success: function (data) {
                $("#btnRejectIntrest_" + id).attr('disabled', true);
                $("#tablerow_" + id).attr('style', 'background-color:red');
                closeIntrestPass();
