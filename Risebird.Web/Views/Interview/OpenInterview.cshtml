                                                                                </div>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                <span style="padding-left:5px;"> @item.candidateName</span>
                                                                <span>
                                                                    @if (item.JDTiltle != null && item.JDTiltle != "")
