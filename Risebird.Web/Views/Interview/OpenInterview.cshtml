@model IEnumerable<Risebird.Entities.Data.Meeting>
    @{
        ViewData["Title"] = "Open Interviews";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <script type="text/javascript">
        $(document).ready(function () {
            //var allowDateConvert = true;
            $('#meeting').DataTable({
                "lengthMenu": [[15, 20, 25, 50, -1], [15, 20, 25, 50, "All"]],
                "order": [[15, "desc"]],
                fixedColumns: {
                    leftColumns: 2
                }
            });
        });


    </script>
    <style>
        i.hover {
            cursor: pointer;
        }
    </style>
    <style type="text/css">
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            background-color: black;
            z-index: 99;
            opacity: 0.8;
            filter: alpha(opacity=80);
            -moz-opacity: 0.8;
            min-height: 100%;
            width: 100%;
        }

        th, td {
            white-space: nowrap;
        }

        div.dataTables_wrapper {
            width: 800px;
            margin: 0 auto;
        }

        .loader {
            font-family: Arial;
            font-size: 10pt;
            /*border: 5px solid #67CFF5;*/
            /*width: 200px;
        height: 100px;*/
            display: none;
            position: fixed;
            background-color: White;
            z-index: 999;
            opacity: 0.5;
            filter: alpha(opacity = 50);
        }
    </style>
    <!--START BREADCRUMB-->
    <ul class="breadcrumb">
        <li class="active"><strong>Open Interviews</strong></li>
    </ul>
    <!-- END BREADCRUMB -->
    <!-- PAGE TITLE -->
    <div class="page-title">
        <h4><span class="fa fa-meetup"></span> Open Interviews</h4>
    </div>
    <!-- END PAGE TITLE -->
    <!-- PAGE CONTENT WRAPPER -->
    <div class="page-content-wrap">

        <div class="row">
            <div class="loader" align="center">
                <img src="~/img/owl/AjaxLoader.gif" style="width: 160px; height:80px; " />
            </div>
            <div class="col-md-12 dataloading">
                <!-- START DEFAULT DATATABLE -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <ul class="panel-controls">
                            <li><a href="#" title="Refresh"><span class="fa fa-refresh" onclick="location.href='@Url.Action("Index", "Interview")'"></span></a></li>
                        </ul>
                    </div>
                    <div class="panel-body">
                        <div class=" table-responsive">
                            <table class="table datatable table-striped table-bordered table-sorting" id="meeting">
                                <thead>
                                    <tr>
                                        <th>Client Name</th>
                                        <th>Client HR</th>
                                        <th>Job Role</th>
                                        <th>Interview Date</th>
                                        <th>Interview Duration</th>
                                        <th>Primary Skill</th>
                                        <th>Candidate Email</th>
                                        <th>Resume Detail</th>
                                        <th>Confrimation Status</th>
                                        <th>Zoom Link</th>
                                        <th>Risebird HR</th>
                                        <th>Interviewer</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id=@item.id>
                                            <td> @item.clientName </td>
                                            <td> @item.ClientHrContact </td>
                                            <td> @item.JobRole </td>
                                            <td> @item.interviewDate </td>
                                            <td> @item.interviewDuration </td>
                                            <td> @item.primaryskill</td>
                                            <td> @item.candidateEmail</td>
                                            <td>  <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a></td>
                                            <td> @item.comfirmationStatus</td>
                                            <td> @item.zoomLink</td>
                                            <td> @item.risebirdHR</td>
                                            <td> @item.interviewer</td>
                                            <td>
                                                <i type="submit" onclick="location.href = '@Url.Action("Assign", "Interview", new { id = item.id})'" class="fa fa-pencil-square-o" style="color:green;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Edit" data-original-title="Tooltip on bottom"></i>
                                             </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- END DEFAULT DATATABLE -->
            </div>
        </div>

    </div>
    <script type="text/javascript">

        $(".dataloading").hide();
        $(".datatable").hide();
        var loader;
        function ShowProgress() {
            $(".dataloading").hide();
            $(".datatable").hide();
            loader = document.getElementsByClassName("loader")[0];
            loader.style.display = "block";
            var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
            var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
            loader.style.top = top + "px";
            loader.style.left = left + "px";
        };
        ShowProgress();
    </script>

    <!-- Keep the Page Content Here.-->

    <script type="text/javascript">
        window.onload = function () {
            setTimeout(function () {
                loader.style.display = "none";
                $(".dataloading").show();
                $(".datatable").show();
            }, 2000);
        };
    </script>
    <script type="text/javascript">
        function InterviewRefresh() {
            window.location.href = "/Meeting/Index";
        };
    </script>
    <!-- PAGE CONTENT WRAPPER -->
