                                                        @* <th>Resume</th>*@

                                                        @*<th>JD Link</th>*@

                                                    </tr>
                                                </tfoot>
                                                <tbody>

                                                    @if (Model.Count == 0)
                                                    {
                                                        <tr>
                                                            <td colspan="9" class="text-center">No data available in table</td>
                                                        </tr>
                                                    }
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr id=@item.id>
                                                            <td class="text-center">
                                                                @* <button id="openinterview_7" class="mdc-fab app-fab--absolute mdc-fab-secondary voicebiobtn" aria-label="Upload audio for verification"><span onclick="location.href = '@Url.Action("AssignYourself", "Interview", new { id = item.id,InterviewDate=item.interviewDate})'" title="Assign Yourself"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <circle cx="9" cy="7" r="3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M11 13H7C4.79086 13 3 14.7909 3 17C3 18.6569 4.34315 20 6 20H12C13.6569 20 15 18.6569 15 17C15 14.7909 13.2091 13 11 13Z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M21 8L18 11L16.5 9.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg></span></button> *@
                                                                <button id="openinterview_7" class="mdc-fab app-fab--absolute mdc-fab-secondary voicebiobtn" aria-label="Upload audio for verification"><span onclick="AssingInterviewYourSelf('@item.id','@item.interviewDate','@item.AudioComment','@item.CompanyDetails')" title="Assign Yourself"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <circle cx="9" cy="7" r="3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M11 13H7C4.79086 13 3 14.7909 3 17C3 18.6569 4.34315 20 6 20H12C13.6569 20 15 18.6569 15 17C15 14.7909 13.2091 13 11 13Z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M21 8L18 11L16.5 9.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg></span></button>
                                                            </td>
                                                            <td>
                                                                <button class="mandate-btn" aria-label="Upload audio for verification"><span onclick="InstructionModel('@item.AudioComment','@item.CompanyDetails')"><svg style="color: rgb(223, 135, 12);margin:0px 4px;" xmlns="http://www.w3.org/2000/svg"  fill="currentColor" class="bi bi-exclamation-circle" viewBox="0 0 16 16"> <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" fill="#df870c"></path> <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" fill="#df870c"></path> </svg>Mandatory Video Instruction</span></button>
                                                            </td>
                                                            <td>
                                                                @item.interviewDate

                                                            </td>

                                                            @*  @if (item.IsNewSkillChannel)
                                                        {
                                                        <td>
                                                        <div class="techinfocontainer">
                                                        <span style="float:left;position:relative;left:8px;font-size:14px;"> ₹ 120</span>
                                                        <i class="fa fa-info-circle techinfoicon tooltipquestion" style="left:17px;padding:0px;font-size:15px;top:5px;">

                                                        <span class="tooltiptext">

                                                        <p>₹ 50: Client Rating is 5/5 </p>
                                                        <p>₹ 20: Candidate Rating is 5/5 </p>
                                                        <p> Video Reward - 50 for India, 100 for US </p>

                                                        </span>
                                                        </i>
                                                        </div>
                                                        </td>
                                                        }
                                                        else
                                                        {
                                                        <td>₹ 0 </td>
                                                        }*@

                                                            <td style="padding-left:25px;">

                                                                @if (item.IsVideoRequired == true)
                                                                {
                                                                    <div style="position:relative;width:fit-content">
                                                                        <div class="absCenter">
                                                                            <button class="infoButton" style="top: 13px;left:-8px;">
                                                                                <div class="infoButton-btn" style="width:15px;height:15px;">
