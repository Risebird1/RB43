                                                @*<button style="display:none;" type="button" id="x">x</button>*@

                                            </div>
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                    <div class="col-sm-12">

                                        <table id="OpeninterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
