@*@model IEnumerable<Risebird.Entities.Data.Meeting>*@
@model X.PagedList.IPagedList<Risebird.Entities.Data.Meeting>
@using X.PagedList.Mvc.Core;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using System.Text.RegularExpressions
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Open Interviews";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Keep the Page Content Here.-->
<script>
    var Header = "<div id='openinterview_1'>Open Interviews</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup {
        width: 500px;
    }

    .open-iv-cap-pill {
        display: inline-block;
        margin-top: 8px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: #1d4ed8;
        background: #eff6ff;
        clear: both;
    }

    .open-iv-cap-pill--full {
        color: #b45309;
        background: #fffbeb;
    }

    .open-iv-cap-blocked {
        cursor: not-allowed;
        opacity: 0.65;
    }

        .swal2-popup #swal2-content {
            text-align: center;
            color: #00000094;
            font-weight: 400;
        }

    .assign-success-compact {
        text-align: left;
        margin: 0 auto;
        max-width: 420px;
        padding: 10px 12px 4px;
        background: linear-gradient(135deg, #f4fbf4 0%, #eef6ff 100%);
        border: 1px solid #c8e6c9;
        border-radius: 10px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }

        .assign-success-compact__lead {
            font-size: 15px;
            font-weight: 700;
            color: #1b5e20;
            margin-bottom: 8px;
            line-height: 1.35;
        }

        .assign-success-compact__badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: #0d47a1;
            background: #e3f2fd;
            border: 1px solid #90caf9;
            border-radius: 6px;
            padding: 4px 10px;
            margin-bottom: 8px;
        }

        .assign-success-compact__list {
            margin: 0;
            padding: 0 0 0 18px;
            font-size: 13px;
            font-weight: 500;
            color: #333;
            line-height: 1.45;
        }

            .assign-success-compact__list li {
                margin-bottom: 6px;
            }

    #txtconfirmmessage.interviewerAlert {
        line-height: 1.4 !important;
        text-align: left;
    }

    .interviewer-alert-status-wrap {
        padding: 0 15px;
    }

    .interviewer-alert-status {
        display: none;
        gap: 12px;
        align-items: flex-start;
        margin: 8px 0 12px;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid transparent;
        box-shadow: 0 4px 14px rgba(0, 0, 0, .05);
    }

        .interviewer-alert-status.is-visible {
            display: flex;
        }

        .interviewer-alert-status.is-success {
            background: #eaf8ec;
            border-color: #b8e0bf;
            color: #1d6b2f;
        }

        .interviewer-alert-status.is-error {
            background: #fdeeee;
            border-color: #efc2c2;
            color: #b42318;
        }

    .interviewer-alert-status__icon {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
    }

    .interviewer-alert-status.is-success .interviewer-alert-status__icon {
        background: #1f9d43;
        color: #fff;
    }

    .interviewer-alert-status.is-error .interviewer-alert-status__icon {
        background: #d92d20;
        color: #fff;
    }

    .interviewer-alert-status__content {
        flex: 1 1 auto;
        min-width: 0;
    }

    .interviewer-alert-status__title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 4px;
        line-height: 1.35;
    }

    .interviewer-alert-status__message {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
    }

        .interviewer-alert-status__message .assign-success-compact {
            margin: 0;
            max-width: 100%;
        }

        .interviewer-alert-status__message .assign-success-compact__lead {
            margin-bottom: 6px;
        }

</style>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<link href="~/newassets/css/rbtooltip.css" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="mt50">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Open Interviews</h4></div>
                </div>
                <div class="pull-right ">
                    <button class="mdc-fab app-fab--absolute " aria-label="Copy Public URL">
                        <span onclick="javascript:CopyPublicUrl('@ViewBag.emailid');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg></span>
                    </button>
                </div>
                <div class="pull-right ">
                    <span style="float:left;line-height:36px;">Sort By:</span>   @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "select-css form-control card-title-space", @style = "margin:0px 5px;width:150px;", onchange = "FilterInterviews(this.value);" })

                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">



                            <div id="tableID" class="second">
                                <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                    <div class="col-sm-12 col-md-6">
                                        <input type="hidden" value="@ViewBag.CodedName" id="hidcodedname" />
                                    </div>
                                    <div class="pull-right client-ms" style="margin:0px 10px 10px 10px;">
                                        <div id="meeting_filter" class="dataTables_filter">
                                            <div class="searchbox">
                                                <div class="searchCon">

                                                    <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                                    <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting">
                                                    <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>


                                                    @*<button style="display:none;" type="button" id="x">x</button>*@

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                    <div class="col-sm-12 nopad">
                                        <div class="table-responsive" style="overflow-y:hidden">

                                            <table id="OpeninterviewList" class="table table-striped table-bordered dataTable dtr-inline" cellspacing="0" width="100%">
                                                <thead>
                                                    <tr>
                                                        @if (Model.Count == 0)
                                                        {
                                                            <th id="openinterview_6" class="disabled-sorting text-center">Actions</th>
                                                        }
                                                        else
                                                        {
                                                            <th class="disabled-sorting text-center">Actions</th>
                                                        }
                                                        <th>Instruction</th>
                                                        <th>Date</th>
                                                        @*  <th>Variable Pay</th>*@
                                                        <th id="openinterview_2">Interview Details</th>
                                                        <th>JD-Skills</th>
                                                        @*<th id="openinterview_3">Resume</th>*@

                                                        @*<th id="openinterview_4">JD Link</th>*@


                                                    </tr>
                                                </thead>
                                                <tfoot>
                                                    <tr>
                                                        <th class="disabled-sorting text-center">Actions</th>
                                                        <th>Instruction</th>
                                                        <th>Date</th>

                                                        @* <th>Variable Pay</th>*@

                                                        <th>Interview Details</th>
                                                        <th>JD-Skills</th>
                                                        @* <th>Resume</th>*@

                                                        @*<th>JD Link</th>*@

                                                    </tr>
                                                </tfoot>
                                                <tbody>

                                                    @if (Model.Count == 0)
                                                    {
                                                        <tr>
                                                            <td colspan="9" class="text-center">No data available in table</td>
                                                        </tr>
                                                    }
                                                    @foreach (var item in Model)
                                                    {
                                                        var ivCapEnforced = DmIvCapHelper.IsCapEnforced(item.DmIvLockNew, item.InterviewCapacity);
                                                        var ivEffectiveCap = DmIvCapHelper.GetDisplayCap(item.InterviewCapacity);
                                                        var ivCapReached = DmIvCapHelper.IsCapReached(item.IvFutureAssignedCount, item.InterviewCapacity, item.DmIvLockNew);
                                                        var ivCapTitle = ivCapReached
                                                            ? $"Interview limit reached ({ivEffectiveCap}). You can't take more interviews on this channel right now."
                                                            : "Assign Yourself";
                                                        <tr id=@item.id>
                                                            <td class="text-center">
                                                                @if (ivCapReached)
                                                                {
                                                                    <button id="openinterview_7" class="mdc-fab app-fab--absolute mdc-fab-secondary voicebiobtn open-iv-cap-blocked" disabled="disabled" title="@ivCapTitle" aria-label="@ivCapTitle"><span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity:0.45"><circle cx="9" cy="7" r="3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M11 13H7C4.79086 13 3 14.7909 3 17C3 18.6569 4.34315 20 6 20H12C13.6569 20 15 18.6569 15 17C15 14.7909 13.2091 13 11 13Z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 8L18 11L16.5 9.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></button>
                                                                }
                                                                else
                                                                {
                                                                    <button id="openinterview_7" class="mdc-fab app-fab--absolute mdc-fab-secondary voicebiobtn" aria-label="Upload audio for verification"><span onclick="AssingInterviewYourSelf('@item.id','@item.interviewDate','@item.AudioComment','@item.CompanyDetails')" title="@ivCapTitle"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <circle cx="9" cy="7" r="3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M11 13H7C4.79086 13 3 14.7909 3 17C3 18.6569 4.34315 20 6 20H12C13.6569 20 15 18.6569 15 17C15 14.7909 13.2091 13 11 13Z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> <path d="M21 8L18 11L16.5 9.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg></span></button>
                                                                }
                                                            </td>
                                                            <td>
                                                                <button class="mandate-btn" aria-label="Upload audio for verification"><span onclick="InstructionModel('@item.AudioComment','@item.CompanyDetails')"><svg style="color: rgb(223, 135, 12);margin:0px 4px;" xmlns="http://www.w3.org/2000/svg"  fill="currentColor" class="bi bi-exclamation-circle" viewBox="0 0 16 16"> <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" fill="#df870c"></path> <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" fill="#df870c"></path> </svg>Mandatory Video Instruction</span></button>
                                                            </td>
                                                            <td>
                                                                @item.interviewDate

                                                            </td>

                                                            @*  @if (item.IsNewSkillChannel)
                                                        {
                                                        <td>
                                                        <div class="techinfocontainer">
                                                        <span style="float:left;position:relative;left:8px;font-size:14px;"> ₹ 120</span>
                                                        <i class="fa fa-info-circle techinfoicon tooltipquestion" style="left:17px;padding:0px;font-size:15px;top:5px;">

                                                        <span class="tooltiptext">

                                                        <p>₹ 50: Client Rating is 5/5 </p>
                                                        <p>₹ 20: Candidate Rating is 5/5 </p>
                                                        <p> Video Reward - 50 for India, 100 for US </p>

                                                        </span>
                                                        </i>
                                                        </div>
                                                        </td>
                                                        }
                                                        else
                                                        {
                                                        <td>₹ 0 </td>
                                                        }*@

                                                            <td style="padding-left:25px;">

                                                                @if (item.IsVideoRequired == true)
                                                                {
                                                                    <div style="position:relative;width:fit-content">
                                                                        <div class="absCenter">
                                                                            <button class="infoButton" style="top: 13px;left:-8px;">
                                                                                <div class="infoButton-btn" style="width:15px;height:15px;">
                                                                                    <span class="infoButton-btn-text" style="position: relative;font-size:13px;width: 10px;height: 21px;left:-5px;top: -2px;">i</span>
                                                                                </div>
                                                                                <div class="infoButton-container" style="bottom: calc(-100% + 35px);">
                                                                                    <div class="infoButton-container-message" style="position:relative;top:-14px;padding:4px 7px;width:auto;"><b style="color:red">Interviewer video on</b> is mandatory by client, else 100% payment deduction</div>
                                                                                </div>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                <span style="padding-left:5px;"> @item.candidateName</span>
                                                                <span>
                                                                    @if (item.JDTiltle != null && item.JDTiltle != "")
                                                                    {
                                                                        <span class="pskill" style="font-weight: 600;font-size: 14px; display: block;">
                                                                            <span style="font-size: 13px;color: grey;padding: 0px 4px 0px 0px;">JD Title : </span>@item.JDTiltle
                                                                        </span>
                                                                    }
                                                                </span>


                                                                <div style="font-size:14px;color: chocolate;font-weight: 600;width:100%;float:left;">
                                                                    <div style="float:left;margin-right:10px;">
                                                                        <span style="font-weight: 500;font-size: 14px;color: #918d8d;margin-top:9px;display: inline-block;padding-right:5px;">Interview Price:</span>₹ @(Convert.ToInt32(item.ExpectedPerHourRate) + item.Surcharge)
                                                                    </div><div style="float:left"><span style="font-weight: 500;font-size: 14px;color: #918d8d;margin-top:9px;padding-right:5px;display: inline-block;">Interview Duration:</span>@item.interviewDuration Min.</div>
                                                                </div>
                                                                @if (ivCapEnforced)
                                                                {
                                                                    <div class="open-iv-cap-pill @(ivCapReached ? "open-iv-cap-pill--full" : "")" title="Future assigned interviews on this channel">
                                                                        @item.IvFutureAssignedCount / @ivEffectiveCap interviews on channel
                                                                    </div>
                                                                }

                                                            </td>
                                                            <td>
                                                                <button type="button" class="clickhere_btn pull-left">
                                                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="openSkillpopup(@item.irfIntId)" data-original-title="Click here to view Tech Skills required."><font style="font-family: Roboto, sans-serif; font-size:12px;">Click Here</font></span>
                                                                </button>
                                                                <input id="skill_id_@item.irfIntId" type="hidden" value="@item.IRFID" />
                                                            </td>
                                                            @*   @if ( item.interviewDate<= DateTime.Now && item.interviewDate.AddMinutes(Convert.ToInt16(item.interviewDuration ?? "60")) >= DateTime.Now && item.resumeLink != null && item.resumeLink != "")
                                                        {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                        }
                                                        else
                                                        {
                                                        <td>No Resume</td>
                                                        }*@
                                                            @*@if (item.JDLink != null && item.JDLink != "")
                                                        {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>@item.JDTiltle</a></td>
                                                        }
                                                        else
                                                        {
                                                        <td>No JD</td>
                                                        }*@



                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                        </div>
                                    </div>

                                    <div class="col-sm-12 col-md-5 pull-left">
                                        Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                    </div>

                                    <div class="col-sm-12 col-md-7 dataTables_paginate pull-right">
                                        @Html.PagedListPager(Model, Page => Url.Action("OpenInterview", new { Page = Page }))
                                    </div>

                                </div>



                            </div>


                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>
<div id="IRFSkillModel" class="modal modal-bg" style="z-index:3">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg modal-full-size" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Tech Skills <span class="popup-text" id="skill_id_pop"></span></h5>

                <div id="tech-note">
                    <span class="report-tooltip" style="border:0px;margin-right:10px;">
                        <svg style="color:#716d6d;position:relative;top:18px;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16"> <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" fill="#ccc"></path> </svg>
                        <span class="report-tooltiptext">
                            <p style="font-weight:500;line-height:20px;">(This is a multistack interview where <b style="color:#dd1f1f;">50-60 mins</b> have to be allocated to evaluate primary stack skills and remaining <b style="color:#dd1f1f;">30-40</b> mins have to be allocated to evaluate secondary stack skills)</p>
                        </span>
                    </span>
                </div>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeIRFSkillModel()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <input type="text" hidden id="txtinterviewid" />
            <div class="modal-body">
                <div style="padding:10px" id="divcandidateskills">
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeIRFSkillModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div id="PublicUrlShareModel" class="modal modal-bg">
    <!-- Modal content -->
