@model IEnumerable<Risebird.Entities.Data.Meeting>
@{
    ViewData["Title"] = "Open Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Keep the Page Content Here.-->


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Open Interviews</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>         
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Open Interviews</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <table id="OpeninterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>Interview Date</th>
                                    <th>Slot</th>
                                    <th>Interview Duration</th>
                                    <th>Candidate Name</th>
                                    <th>Resume</th>
                                    <th>JD Link</th>
                                    <th>Risebird HR</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Interview Date</th>
                                    <th>Slot</th>
                                    <th>Interview Duration</th>
                                    <th>Candidate Name</th>
                                    <th>Resume</th>
                                    <th>JD Link</th>
                                    <th>Risebird HR</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </tfoot>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                <tr id=@item.id>
                                    <td> @item.interviewDate </td>
                                    <td> @item.interviewSlot </td>
                                    <td> @item.interviewDuration </td>
                                    <td> @item.candidateName</td>
                                    <td>  <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a></td>
                                    <td> @item.JDLink</td>
                                    <td> @item.risebirdHR</td>
                                    <td class="text-right">
                                        <span onclick="location.href = '@Url.Action("AssignYourself", "Interview", new { id = item.id,InterviewDate=item.interviewDate,CandidateEmail=item.candidateEmail})'" title="Assign Yourself" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>




<script>
    $(document).ready(function () {
        $('#OpeninterviewList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#OpeninterviewList').DataTable();
    });
</script>







<script type="text/javascript">
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $(".datatable").show();
        }, 2000);
    };
</script>
<loading></loading>


@if (ViewBag.Message != null && ViewBag.Message.Contains("successfully"))
{
    <script type="text/javascript">
        window.onload = function ()
        {
            sweetAlert({
                title: "Risebird Notification",
                text:'@ViewBag.Message',
                type: "success"
            });
        };
    </script>
}
@if (ViewBag.Message != null && (ViewBag.Message.Contains("Failed")))
{
    <script type="text/javascript">
        window.onload = function ()
        {
            sweetAlert({
                title: "Risebird Notification",
                text: '@ViewBag.Message',
                type: "error"
            });
        };
    </script>
}
<!-- PAGE CONTENT WRAPPER -->
