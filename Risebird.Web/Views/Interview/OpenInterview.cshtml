            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label class="label-field desp-label"> Public Url:  <b id="txtvideoUrls"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtvideoUrls')">
                            <p class="special-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                <span id="special_text" class="special-text__tooltip">
                                    Copy Link
                                </span>
                            </p>
                        </button>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closePublicUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="InterviewerAlert" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document" style="max-width: 750px !important;top:10px;">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar" style="background:#d61818!important;">
                    <span class="mdc-fab__icon material-icons">
                        <i class='fa fa-warning' style='color: white'></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left" style="padding-top:0px;">Mandatory Interview Instruction</h5>
            </div>
