</div>
<div id="IRFSkillModel" class="modal modal-bg" style="z-index:3">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg modal-full-size" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Tech Skills <span class="popup-text" id="skill_id_pop"></span></h5>

                <div id="tech-note">
                    <span class="report-tooltip" style="border:0px;margin-right:10px;">
                        <svg style="color:#716d6d;position:relative;top:18px;" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16"> <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" fill="#ccc"></path> </svg>
                        <span class="report-tooltiptext">
                            <p style="font-weight:500;line-height:20px;">(This is a multistack interview where <b style="color:#dd1f1f;">50-60 mins</b> have to be allocated to evaluate primary stack skills and remaining <b style="color:#dd1f1f;">30-40</b> mins have to be allocated to evaluate secondary stack skills)</p>
                        </span>
                    </span>
                </div>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeIRFSkillModel()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <input type="text" hidden id="txtinterviewid" />
            <div class="modal-body">
                <div style="padding:10px" id="divcandidateskills">
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeIRFSkillModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div id="PublicUrlShareModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Secure Share Url</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closePublicUrlShareModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label class="label-field desp-label"> Public Url:  <b id="txtvideoUrls"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtvideoUrls')">
                            <p class="special-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                <span id="special_text" class="special-text__tooltip">
                                    Copy Link
                                </span>
                            </p>
                        </button>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closePublicUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="InterviewerAlert" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document" style="max-width: 750px !important;top:10px;">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar" style="background:#d61818!important;">
                    <span class="mdc-fab__icon material-icons">
                        <i class='fa fa-warning' style='color: white'></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left" style="padding-top:0px;">Mandatory Interview Instruction</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" style="z-index:100">
                <span onclick="closeInterviewerAlert()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <input type="hidden" id="popupreload"/>
            <div class="col-md-12 pull-left text-center">
                <h2 class="interviewerAlert" style="margin: 0px 10px;padding: 2px!important;background: #dbf6db;" id="txtconfirmmessage"></h2>
            </div>
            <div class="modal-body" style="padding:10px 20px;">
                <div style="overflow-y:auto;max-height:440px;">
                
                <div class="col-md-12 pull-left text-center">
                    <h2 class="interviewerAlert"> If the given instructions are not followed, the client may deduct upto  <strong style="color: #e42c2c;">100% of the amount payable to you</strong></h2>
                </div>
                <div id="divvideoinstruction" style="display:none">
                    <div style=" padding: 5px 20px 5px 20px;font-size: 16px;clear:both;text-align:center;color: #d61818;font-weight: 500;text-transform: uppercase;border-top: 1px #dcd2d252 solid;">
                        <i class="fa fa-video-camera" aria-hidden="true" style="color: #b7b1b1;font-size: 19px;margin-right: 5px;"></i> Video Instruction:
                    </div>
                    
                    <video id="vidvideoinstruction" style="width:100%;height:260px;" controls="controls" preload="metadata">
                        <source id="srcvideoinstruction" src='' type="video/mp4">
                    </video>
                   
                </div>
                <div id="divcompanytextinstruction" style="display:none;padding-top:10px;clear:both">
                    <div style=" padding:5px 0px 5px 0px;font-size: 16px;text-align:center;color: #d61818;font-weight: 500;text-transform: uppercase;    border-bottom: 1px #dcd2d252 solid;border-top: 1px #dcd2d252 solid;">
                        <i class="fa fa-align-left" aria-hidden="true" style="color: #b7b1b1;font-size: 19px;margin-right: 5px;"></i> Text Instruction:<a style="color:#0d6efd;text-decoration: none;text-transform: none;" id="companylinkId" target="_blank" title="Company Instructions" href=""> Click to view instruction</a>
                    </div>
                </div>

                <div id="mandate-popup-btn" class="col-md-12 text-center" style="display:none">
                    <button type="button" class="mdc-button button-warning" onclick="closeInterviewerAlert()">OK</button>
                </div>
                @* <div class="col-md-12  text-center" style="margin:0px auto;display: block;width: 335px;clear: both;">
                <div id="assign-btn"><button type="button" style="background:#28982399;float: left;" class="mdc-button button-warning" onclick="closeInterviewerAlert()">OK, Continue with assigning!</button></div>
                <div id="unassign-btn" class="mdc-button button-warning" style="float: left;margin-left: 3px;">
                <span onclick="()" title="Unassign Yourself" class="mdc-fab__icon material-icons">UNASSIGN</span>
                </div>
                </div> *@
            </div>
            </div>
        
        
        </div>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                var codedname = $("#hidcodedname").val();
                swal.fire("Assigned Successfully", '@ViewBag.Message', "success");
                //swal.fire("For your privacy concerns \n Please join meeting using browser in private or incognito mode only with your coded name : "+ codedname,'@ViewBag.Message', "success");
                //swal.fire("For your privacy concerns", "Please join meeting using browser in private or incognito mode only with your coded name : " + codedname, "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
        //window.onload = my_code();
    </script>
}



