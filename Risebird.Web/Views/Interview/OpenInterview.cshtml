<script>
    function InstructionModel(videolink,textinstruction){
        openInterviewerAlert();
        $("#popupreload").val("false");
        // $('#assign-btn').hide();
        // $('#unassign-btn').hide();
        $('#txtconfirmmessage').hide();
        $('#mandate-popup-btn').show();
        bindinstructiondetails(videolink,textinstruction);
    }
    function openInterviewerAlert() {
        var modal = document.getElementById("InterviewerAlert");
        modal.style.display = "block";
    }
    function closeInterviewerAlert() {
        var modal = document.getElementById("InterviewerAlert");
        modal.style.display = "none";
        if($("#popupreload").val()=="true")
        {
            location.reload();
        }else{
            var video = document.getElementById('vidvideoinstruction');
            video.pause();
        }
    }
    function AssingInterviewYourSelf(id,interviewDate,videolink,textinstruction){
         $.ajax({
            type: "POST",
            url: "/Interview/InterviewAssignYourself",
            data: { id: id,interviewDate:interviewDate },
            success: function (data) {
                $("#txtconfirmmessage").text(data);
                openInterviewerAlert();
                $("#popupreload").val("true");
                bindinterviewalertdetails(data,videolink,textinstruction);
            }
        });
    }
    function bindinterviewalertdetails(data,videolink,textinstruction){
        if(data.includes('Successfully')){
            bindinstructiondetails(videolink,textinstruction);
        }
        else
        {
            document.getElementById("divvideoinstruction").style.display="none";
            document.getElementById("divcompanytextinstruction").style.display="none";
        }
    }
     function bindinstructiondetails(videolink,textinstruction){
        if(videolink!='' && videolink!=null){
                document.getElementById("divvideoinstruction").style.display="block";
                var video = document.getElementById('vidvideoinstruction');
                var sources = document.getElementById('srcvideoinstruction');
                sources.src = videolink;
                video.load();
            }
            else
            {
                document.getElementById("divvideoinstruction").style.display="none";
            }
            if(textinstruction!='' && textinstruction!=null){
                document.getElementById("divcompanytextinstruction").style.display="block";
                document.getElementById('companylinkId').href=textinstruction;
            }
            else
            {
                document.getElementById("divcompanytextinstruction").style.display="none";
            }
    }
</script>
