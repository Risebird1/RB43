                                                        }

                                                        <td> @item.risebirdHR</td>
                                                        <td class="text-right four">
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Assign">
                                                                <span onclick="location.href = '@Url.Action("AssignYourself", "Interview", new { id = item.id,InterviewDate=item.interviewDate,CandidateEmail=item.candidateName})'" title="Assign Yourself" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                       </button>
                                                                </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>

