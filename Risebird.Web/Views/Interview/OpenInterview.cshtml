<script type="text/javascript">
    function formatAssignYourselfMessage(raw) {
        if (raw == null) return '';
        var s = String(raw);
        if (s.indexOf('CAP_REACHED|') === 0) {
            return $('<div/>').text(s.substring('CAP_REACHED|'.length)).html();
        }
        if (s.indexOf('INACTIVE_IVY|') === 0) {
            return $('<div/>').text(s.substring('INACTIVE_IVY|'.length)).html();
        }
        if (s.indexOf('|VIDEO_MANDATE') !== -1) {
            return '<div class="assign-success-compact">'
                + '<div class="assign-success-compact__lead">Interview assigned successfully</div>'
                + '<div class="assign-success-compact__badge" title="Client requirement"><span class="material-icons" style="font-size:18px;line-height:1;vertical-align:middle;">videocam</span> Video on required</div>'
                + '<ul class="assign-success-compact__list">'
                + '<li>Unassign at least <strong>4 hours</strong> before start if you cannot comply.</li>'
                + '<li>Use a <strong>virtual background</strong>.</li>'
                + '<li>Your data is <strong>100% secure</strong>.</li>'
                + '</ul></div>';
        }
        return $('<div/>').text(s).html();
    }
    function fireAssignResultSwal(raw, isSuccess) {
        if (typeof swal === 'undefined' || !swal.fire) return;
        var html = formatAssignYourselfMessage(raw);
        if (isSuccess) {
            swal.fire({
                title: 'Assigned successfully',
                html: html,
                icon: 'success',
                width: 460,
                customClass: { popup: 'swal2-popup-assign' }
            });
        } else {
            swal.fire({ title: 'Failed', html: html, icon: 'error', width: 420 });
        }
    }
</script>

