                                                <tr>
                                                    <th>Date</th>
                                                    <th>Slot</th>
                                                    <th>Duration</th>
                                                    <th>Candidate Name</th>
                                                    <th>Resume</th>
                                                    <th>JD Link</th>
                                                    <th>Risebird HR</th>
