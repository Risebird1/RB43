@*@model IEnumerable<Risebird.Entities.Data.Meeting>*@
@model X.PagedList.IPagedList<Risebird.Entities.Data.Meeting>
@using X.PagedList.Mvc.Core;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using System.Text.RegularExpressions
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Open Interviews";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Keep the Page Content Here.-->
<script>
    var Header = "<div id='openinterview_1'>Open Interviews</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup {
        width: 500px;
    }

        .swal2-popup #swal2-content {
            text-align: center;
            color: #00000094;
            font-weight: 400;
        }

    .mandate-btn {
        background: #fcf1e6;
        border: 1px #b776272b solid;
        color: #de8e48 !important;
        font-size: 12px;
        border-radius: 4px;
        padding: 5px 7px !important;
        font-weight: 700;
    }
</style>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<link href="~/newassets/css/rbtooltip.css" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="mt50">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Open Interviews</h4></div>
                </div>
                <div class="pull-right ">
                    <button class="mdc-fab app-fab--absolute " aria-label="Copy Public URL">
                        <span onclick="javascript:CopyPublicUrl('@ViewBag.emailid');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg></span>
                    </button>
                </div>
                <div class="pull-right ">
                    <span style="float:left;line-height:36px;">Sort By:</span>   @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "select-css form-control card-title-space", @style = "margin:0px 5px;width:150px;", onchange = "FilterInterviews(this.value);" })

                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

