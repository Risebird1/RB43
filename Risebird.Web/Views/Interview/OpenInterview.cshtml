<script>
    function getInterviewerAlertIconSvg(isSuccess) {
        if (isSuccess) {
            return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="18" height="18"><path fill="currentColor" d="M256 48a208 208 0 1 1 0 416 208 208 0 1 1 0-416zm0 464A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209c9.4-9.4 9.4-24.6 0-33.9s-24.6-9.4-33.9 0l-111 111-47-47c-9.4-9.4-24.6-9.4-33.9 0s-9.4 24.6 0 33.9l64 64c9.4 9.4 24.6 9.4 33.9 0L369 209z"/></svg>';
        }

        return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" width="16" height="18"><path fill="currentColor" d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"/></svg>';
    }

    function setInterviewerAlertStatus(isSuccess, messageHtml) {
        var statusBox = $('#interviewerAlertStatus');
        statusBox.removeClass('is-success is-error').addClass(isSuccess ? 'is-success' : 'is-error').addClass('is-visible');
        $('#txt-confirm-icon').html(getInterviewerAlertIconSvg(isSuccess));
        $('#txtconfirmtitle').text(isSuccess ? 'Assigned successfully' : 'Assignment failed');
        $('#txtconfirmmessage').html(messageHtml);
        $('#interviewerAlertDetails').toggle(isSuccess);
    }

    function resetInterviewerAlertStatus() {
        $('#interviewerAlertStatus').removeClass('is-success is-error is-visible');
        $('#txt-confirm-icon').empty();
        $('#txtconfirmtitle').empty();
        $('#txtconfirmmessage').empty();
        $('#interviewerAlertDetails').show();
    }

    function InstructionModel(videolink,textinstruction){
        openInterviewerAlert();
        $("#popupreload").val("false");
        // $('#assign-btn').hide();
        // $('#unassign-btn').hide();
        resetInterviewerAlertStatus();
        $('#mandate-popup-btn').show();
        bindinstructiondetails(videolink,textinstruction);
    }
    function openInterviewerAlert() {
        var modal = document.getElementById("InterviewerAlert");
        modal.style.display = "block";
    }
    function closeInterviewerAlert() {
        var modal = document.getElementById("InterviewerAlert");
        modal.style.display = "none";
        if($("#popupreload").val()=="true")
        {
            location.reload();
        }else{
            var video = document.getElementById('vidvideoinstruction');
            video.pause();
        }
    }
    function AssingInterviewYourSelf(id,interviewDate,videolink,textinstruction){
         $.ajax({
            type: "POST",
            url: "/Interview/InterviewAssignYourself",
            data: { id: id,interviewDate:interviewDate },
            success: function (data) {
                openInterviewerAlert();
                $("#popupreload").val("true");
                bindinterviewalertdetails(data,videolink,textinstruction);
            }
        });
    }
    function bindinterviewalertdetails(data,videolink,textinstruction){
        $('#mandate-popup-btn').show();
        var msg = '';
        if (data && typeof data === 'object' && data.message) {
            msg = String(data.message);
        } else {
            msg = data == null ? '' : String(data);
        }
        if((data && data.code === 'OK') || msg.indexOf('Successfully') !== -1 || msg.indexOf('|VIDEO_MANDATE') !== -1){
            setInterviewerAlertStatus(true, formatAssignYourselfMessage(msg));
            bindinstructiondetails(videolink,textinstruction);
        }
        else
        {
            setInterviewerAlertStatus(false, formatAssignYourselfMessage(msg));
            document.getElementById("divvideoinstruction").style.display="none";
            document.getElementById("divcompanytextinstruction").style.display="none";
            if ((data && data.code === 'CAP_REACHED') || msg.indexOf('CAP_REACHED|') === 0) {
                $("#popupreload").val("true");
            }
        }
    }
     function bindinstructiondetails(videolink,textinstruction){
        if(videolink!='' && videolink!=null){
                document.getElementById("divvideoinstruction").style.display="block";
                var video = document.getElementById('vidvideoinstruction');
                var sources = document.getElementById('srcvideoinstruction');
                sources.src = videolink;
                video.load();
            }
            else
            {
                document.getElementById("divvideoinstruction").style.display="none";
            }
            if(textinstruction!='' && textinstruction!=null){
                document.getElementById("divcompanytextinstruction").style.display="block";
                document.getElementById('companylinkId').href=textinstruction;
            }
            else
            {
                document.getElementById("divcompanytextinstruction").style.display="none";
            }
    }
</script>
