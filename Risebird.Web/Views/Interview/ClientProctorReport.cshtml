@using Microsoft.Extensions.Configuration;

@inject IConfiguration configuration


@model Risebird.Entities.ViewModel.InterviewReport
@{
    ViewData["Title"] = "Interview Proctor Report";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .star-rating {
        border: solid 1px white;
        display: flex;
        direction: rtl;
        font-size: 2.0em;
        justify-content: space-around;
        padding: 0 .2em;
        text-align: center;
        width: 100%;
        margin-bottom: 10px;
        background-color: lightgray;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            /*color: #ccc;*/
            color: #e4e4e4;
            cursor: pointer;
        }

        .star-rating :checked ~ label {
            color: #f90;
        }

        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #fc0;
        }

    .card-title-space {
        margin: 20px 0px;
        float: right
    }

    .mb10 {
        margin-bottom: 10px
    }
</style>
<script>
    var Header = "<a  style='line-height:50px;'><span>Interview Proctor Report</span></a>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .mob_h {
        display: none;
    }
</style>
@if (ViewBag.PageStatus == "ExecutiveReport")
{
    <style>
        .sidebar-mini .sidebar:hover {
            width: 80px !important;
        }

        .sidebar .navbar-minimize .btn {
            display: none !important
        }
    </style>
    <script>
        document.getElementById('theme').href = '../Newassets/css/blue-theme.css';
    </script>
}
@if (ViewBag.PageStatus == "PublicExternal")
{
    <style>
        .sidebar-mini .sidebar:hover {
            width: 80px !important;
        }

        .sidebar .navbar-minimize .btn {
            display: none !important
        }
    </style>
    <script>
        document.getElementById('theme').href = '../Newassets/css/blue-theme.css';
    </script>
}
<meta charset="utf-8" />
<link rel="apple-touch-icon" sizes="76x76" href="~/Newassets/img/apple-icon.png">
<link rel="icon" type="image/png" href="~/Newassets/img/favicon.png">
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!--     Fonts and icons     -->

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<!--<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />-->


<input type="hidden" value="@ViewBag.ClientDetails" id="hidPagestatus" />
<div class="main-panel" id="main-panel">

    <div class="mt50 col-md-12">

        @if (ViewBag.PageStatus == "Mainurl" || ViewBag.PageReport == "External")
        {
            <div class="pull-right mt-20"> <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style="margin-bottom: 4px; margin-right: 15px;" value="Generate PDF" onclick="getPDF()"></div>
            <div class="pull-right mt-20"> <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style="margin-bottom: 4px; margin-right: 15px;" value="Generate Insta Public URL" onclick="GeneratePublicUrl(3)"></div>
            <div class="pull-right mt-20"> <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style="margin-bottom: 4px; margin-right: 15px;" value="Generate Executive Public URL" onclick="GeneratePublicUrl(1)"></div>
        }
    </div>
    <div id="reportForm" class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">


                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">

                            @if (Model.InterviewStatus == 2 || Model.InterviewStatus == 4)
                            {
                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(Model);
                                <div class="clearfix text-right">
                                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-success" style="width:145px; margin-bottom:16px;background: #18ce0f!important;">
                                        <span class="fa fa-thumbs-up" onclick="ModalButtonClick(@jsonObject)" id="@("myBtn_"+Model.InterviewId)"><font style="font-size:12px;    font-family: Roboto, sans-serif;"> Approve</font></span>
                                    </button>
                                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="width:145px;margin-bottom:16px;">
                                        <span class="fa fa-check-circle" onclick="ModalSelectionButtonClick(@jsonObject)" id="@("mySelectionBtn_"+Model.InterviewId)"><font style="font-size:12px;    font-family: Roboto, sans-serif;"> Select</font></span>
                                    </button>
                                </div>
                            }

                            <form action="/IRF/ProctorReport" enctype="multipart/form-data" method="post" class="ng-pristine clearfix ng-valid form" id="Clienform">
                                @Html.AntiForgeryToken()
                                <div class="canvas_div_pdf">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="report-full-wrap">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h3 class="mb-0"><span>Candidate Details</span></h3>
                                                </div><!--end of multiple location-->
                                            </div>
                                        </div>
                                        <div class="card-wrap">
                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 pull-left border-rv">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.JobLevelName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @Html.TextBoxFor(m => m.JobLevelName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                        @Html.ValidationMessageFor(model => model.JobLevelName, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                            @if (ViewBag.PageStatus != "PublicExternal")
                                            {
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 pull-left border-rv">
                                                        <div class="form-group">
                                                            @Html.LabelFor(model => model.expectedPerHourRate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                            @Html.TextBoxFor(m => m.expectedPerHourRate, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                            @Html.ValidationMessageFor(model => model.OverallScore, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6 col-sm-6 pull-left">
                                                        <div class="form-group">
                                                            @Html.LabelFor(model => model.PreferredLocation, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                            @Html.TextBoxFor(m => m.PreferredLocation, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            <div class="row">
                                                @if (ViewBag.PageStatus != "PublicExternal")
                                                {
                                                    <div class="col-md-6 col-sm-6 pull-left border-rv">
                                                        <div class="form-group">
                                                            @Html.LabelFor(model => model.currentEmployerName, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                            @Html.TextBoxFor(m => m.currentEmployerName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                        </div>
                                                    </div>
                                                }
                                                <div class="col-md-6 col-sm-6 pull-left">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.resumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @{
                                                            if (Model.resumeLink != null && Model.resumeLink != "")
                                                            {
                                                                <a id="resumeID" target="_blank" title="Resume" href=@Model.resumeLink.ToString().Replace(" ", "%20") class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label click ">Click here</a>
                                                            }
                                                        }
                                                    </div>
                                                </div>

                                                @if (ViewBag.PageStatus != "PublicExternal")
                                                {
                                                    <div class="col-md-6 col-sm-6 pull-left">
                                                        <div class="form-group">
                                                            @Html.LabelFor(model => model.interviewDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                            @Html.TextBoxFor(m => m.interviewDate, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="row">
                                                @if (ViewBag.IsClient)
                                                {
                                                    @if (Model.ClientAction == "Shortlisted")
                                                    {
                                                        <div class="col-md-6 col-sm-6 pull-left border-rv">
                                                            <div class="form-group">
                                                                @Html.Label("Interviewer Coded Name", "Interviewer Coded Name", htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                                @Html.TextBoxFor(m => m.NickName, new { @class = "form-control text-box single-line", @readonly = "readonly", @style = "background-color:green" })
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="col-md-6 col-sm-6 pull-left border-rv">
                                                            <div class="form-group">
                                                                @Html.Label("Interviewer Coded Name", "Interviewer Coded Name", htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                                @Html.TextBoxFor(m => m.NickName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                @if (Model.AadhaarVerified)
                                                {
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group" style="padding-left:10px">
                                                            <a href="#" onclick="javascript:FetchInterviewAadhaarDetails('@Model.CandidateEmail');">Click Here For Candidate Verified Data</a>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>Interview Report</h2>
                                            </div><!--end of multiple location-->
                                        </div>
                                    </div>
                                    <div class="row">

                                        <div class="col-md-6 col-sm-6 pull-left">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.MeetingStatusList, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                @Html.DropDownListFor(x => Model.MeetingStatus, Model.MeetingStatusList, "Select Status", htmlAttributes: new { @class = "select-css form-control webkitEnabled", @disabled = "disabled" })
                                                @Html.ValidationMessageFor(model => model.MeetingStatus, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-sm-6 pull-left">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.InterviewStatusList, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                @Html.DropDownListFor(x => Model.InterviewStatus, Model.InterviewStatusList, "Select Status", htmlAttributes: new { @class = "select-css form-control webkitEnabled", @disabled = "disabled" })
                                                @Html.ValidationMessageFor(model => model.InterviewStatus, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    @if (ViewBag.PageReport != "Insta")
                                    {
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h3 class="mb-0"><span>Interview Video</span></h3>
                                                </div><!--end of multiple location-->
                                            </div><!--end of col-md-12-->
                                        </div>
                                        <div class="card-wrap">
                                            <div class="row">
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                    <div class="videoConplayer">
                                                        @Html.HiddenFor(x => Model.VideoLink)
                                                        @if (Model.VideoLink != null && Url.Content(Model.VideoLink) != null)
                                                        {
                                                            string appendTime;
                                                            if (Model.ThumbnailTimeSeconds == 0)
                                                            {
                                                                appendTime = configuration["ThumbnailTimeDefault"];
                                                            }
                                                            else
                                                            {
                                                                appendTime = Model.ThumbnailTimeSeconds.ToString();
                                                            }
                                                            var src = Model.VideoLink + "#t=" + appendTime;
                                                            <video width="600" controls="controls" preload="metadata">
                                                                <source src='@src' type="video/mp4">
                                                            </video>
                                                        }
                                                    </div>
                                                </div><!--end of col-md-12-->
                                            </div>
                                        </div>
                                    }
                                    @* Bind iframe Report from item.proctorReport Link *@
                                    <div class="content client">
                                        <div class="row bg-w">
                                            <div class="col-md-12">
                                                <div class="mdc-card card bg-w">
                                                    <div class="mdc-card-wrapper__text-section">
                                                        @if (Model.ProctorReport != null)
                                                        {
                                                            <div class="row">
                                                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                                                    <!-- Calendly inline widget begin -->
                                                                    <div class="calendly-inline-widget" data-url='@Model.ProctorReport' style="height:636px"></div>
                                                                    <!-- Calendly inline widget end -->
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="row">
                                                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                                                    <!-- Calendly inline widget begin -->
                                                                    <label style="margin-left:440px"><strong>Sorry! No Proctor details available!</strong></label>
                                                                    <!-- Calendly inline widget end -->
                                                                </div>
                                                            </div>
                                                        }
                                                        <!-- end content-->
                                                    </div>
                                                </div>
                                                <!--  end card  -->
                                            </div>
                                            <!-- end col-md-12 -->
                                        </div>
                                        <!-- end row -->
                                    </div>

                                    @if (ViewBag.PageStatus != "PublicExternal")
                                    {
                                        <div class="card-footer">
                                            <div class="row">
                                                <div class="col-md-12 mc-button-area">
                                                    @if (ViewBag.actiontype == "IRFCandidate")
                                                    {
                                                        @Html.ActionLink("Back", "GetCandidateStatus", "IRF", new { id = ViewBag.IRFID }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                                    }
                                                    else if (ViewBag.actiontype == "Candidate")
                                                    {
                                                        @Html.ActionLink("Back", "CandidateTimeline", "Candidate", null, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @Html.HiddenFor(m => m.id)
                                    @Html.HiddenFor(m => m.IRFId)
                                    @Html.HiddenFor(m => m.InterviewId)
                                    @Html.HiddenFor(m => m.IsEdited)
                                    @Html.HiddenFor(m => m.IsProctor)
                                </div>
                            </form>

                            <div id="myModal" class="modal modal-bg">
                                <!-- Modal content -->
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <svg class="broadcastfilter-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-1.91l-.01-.01L23 10z" /></svg>
                                            </div>
                                            <h5 class="modal-title pull-left" id="ApproveModalLabel"> Approved For Next Round</h5>
                                        </div>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true" id="approvePopUp">&times;</span>
                                        </button>
                                        <div class="modal-body">
                                            <div class="form-group">
                                                <label for="approveDropdown" class="control-label">Approved For Next Round</label>
                                                <select class="form-control" id="approveDropdown" name="approveDropdown"></select>
                                            </div>
                                            <div id="approvalComments" class="form-group">
                                                <label class="control-label">Approval Comments</label>
                                                <input type="text" name="appComments" class="form-control" id="appComments" style="margin-left:6px">
                                            </div>
                                            <div>
                                                <input type="button" onclick="SavePopUp()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnUpload" value="Save">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="mySelectionModal" class="modal modal-bg" tabindex="-1" role="dialog" aria-labelledby="mySelectionModalLabel" aria-hidden="true">
                                <!-- Modal content -->
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="reportbtn-icon fas fa-check"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Final Selection Status</h5>
                                        </div>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true" id="selectPopUp">&times;</span>
                                        </button>
                                        <div class="modal-body">
                                            <div class="form-group">
                                                <label for="selectionDropdown" class="control-label">Final Selection</label>
                                                <select class="form-control" id="selectionDropdown" name="selectionDropdown"></select>
                                            </div>
                                            <div id="selectionComments" class="form-group">
                                                <label class="control-label">Final Comments</label>
                                                <input type="text" name="selecComments" class="form-control" id="selecComments">
                                            </div>
                                            <div class="">
                                                <input type="button" onclick="SaveSelecPopUp()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnSelectUpload" value="Save">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>
<div id="PublicUrlShareModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Public Share Url</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closePublicUrlShareModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label class="label-field desp-label"> Public Url:  <b id="txtvideoUrls"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtvideoUrls')">
                            <p class="special-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                <span id="special_text" class="special-text__tooltip">
                                    Copy Link
                                </span>
                            </p>
                        </button>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="closePublicUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="myRaitingPopup" class="modal modal-wrap modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left"> Rate Interviewer</h5>
                <div class="rating-box"><i class="fa fa-star"></i> Low &nbsp; &nbsp;<i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i> High</div>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closemyRaitingPopup()">
                <span aria-hidden="true">×</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12 clearfix">
                    <div class="pull-left">
                        <label class="interviewer_name" id="txtratingCandidate"></label>
                        <input type="hidden" id="txtratinginterviewid" />
                        <input type="hidden" id="txtratingvalue" />
                    </div>
                    <div class="star-rating pull-right">
                        <input type="radio" id="Q1_5" name="rating1" value="5" onclick="ChangeRating(5)" />
                        <label for="Q1_5" class="star">&#9733;</label>
                        <input type="radio" id="Q1_4" name="rating1" value="4" onclick="ChangeRating(4)" />
                        <label for="Q1_4" class="star">&#9733;</label>
                        <input type="radio" id="Q1_3" name="rating1" value="3" onclick="ChangeRating(3)" />
                        <label for="Q1_3" class="star">&#9733;</label>
                        <input type="radio" id="Q1_2" name="rating1" value="2" onclick="ChangeRating(2)" />
                        <label for="Q1_2" class="star">&#9733;</label>
                        <input type="radio" id="Q1_1" name="rating1" value="1" onclick="ChangeRating(1)" />
                        <label for="Q1_1" class="star">&#9733;</label>
