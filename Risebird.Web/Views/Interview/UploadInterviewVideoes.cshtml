@model Risebird.Entities.ViewModel.Question
@{
    ViewData["Title"] = "Interview Video Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/jquery.mCustomScrollbar.css" />

<script type="text/javascript" src="~/js/plugins/mcustomscrollbar/jquery.mCustomScrollbar.js"></script>
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interview Video Upload</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="mt50">
    </div>
    <div class="content curated-group client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        @using (Html.BeginForm("UploadInterviewVideoes", "Interview", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "Meetingpatchform" }))
                        {




                            <div id="tableID">
                                <div class="scrollbox-curated">
                                    <div class="table-responsive-sm">
                                        <table class="table table-bordered mbn" id="IRFList">
                                            <thead>
                                                <tr>
                                                    <th class="text-center" style="font-size:15px!important;">Question</th>
                                                    <th class="text-center" style="font-size:15px!important;">VideoTitle</th>
                                                    <th class="text-center" style="font-size:15px!important;">Priority</th>
                                                    <th class="text-center" style="font-size:15px!important;">VideoLink</th>
                                                    <th class="text-center" style="font-size:15px!important;">ThumbNailLink</th>
                                                    <th class="text-center" style="font-size:15px!important;">Thumbnail</th>
                                                    <th class="text-center" style="font-size:15px!important;">Video Upload</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.questionset.Count(); i++)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.HiddenFor(m => m.questionset[i].InterviewId)
                                                            @Html.HiddenFor(m => m.questionset[i].Id)

                                                            @Html.TextBoxFor(m => m.questionset[i].Question, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                        </td>
                                                        <td>
                                                            @Html.TextBoxFor(m => m.questionset[i].VideoTitle, new { @class = "form-control text-box single-line" })
                                                        </td>
                                                        <td>
                                                            @Html.TextBoxFor(m => m.questionset[i].Priority, new { @class = "form-control text-box single-line" })
                                                        </td>
                                                        <td>
                                                            @Html.TextBoxFor(m => m.questionset[i].VideoLink, new { @class = "form-control text-box single-line" })
                                                        </td>
                                                        <td>
                                                            @Html.TextBoxFor(m => m.questionset[i].ThumbnailLink, new { @class = "form-control text-box single-line" })
                                                        </td>
                                                        <td>
                                                            @Html.TextBoxFor(m => m.questionset[i].Thumbnail, new { type = "file", @class = "choose-file", @accept = ".jpg,.png" })
                                                        </td>
                                                        <td>
                                                            @Html.TextBoxFor(m => m.questionset[i].VideoFile, new { type = "file", @class = "choose-file", @accept = ".mp4" })
                                                        </td>
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "Index", "Interview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        @*<button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Save</button>*@
                                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" onclick="Submitform(@Model.questionset.Count())" value="Submit">Save</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
</div>


<script>
    $(document).ready(function () {

        $('#IRFList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                //[10, 25, 50, -1],
                //[10, 25, 50, "All"]
                [-1],
                ["All"]
            ],
            order: [],
            responsive: false,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#IRFList').DataTable();
    });
</script>
<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>

<script>
    (function ($) {
        $(window).on("load", function () {
            $(".scrollbox-curated").mCustomScrollbar();
        });
    })(jQuery);
    function Submitform(totalcount) {
        var message = '';
        var videotitle = false;
        var prioritydetails = false;
        var priorityblank = false;
        var priority = [];
        for (var i = 0; i < totalcount; i++) {
            if (document.getElementById("questionset_" + i + "__VideoFile").files.length > 0 || document.getElementById("questionset_" + i + "__VideoLink").value != '')
            {
                if (document.getElementById("questionset_" + i + "__VideoTitle").value == '') {
                    videotitle = true;
                }
                if (document.getElementById("questionset_" + i + "__Priority").value != '') {
                    if (parseInt(document.getElementById("questionset_" + i + "__Priority").value) == 0) {
                        priorityblank = true;
                    } else {
                        priority.push(parseInt(document.getElementById("questionset_" + i + "__Priority").value));
                    }
                } else {
                    prioritydetails = true;
                }
            }
        }
        var result = hasDuplicates(priority);
        if (videotitle == true) {
            if (message == '') {
                message = 'Please enter Video title';
            } else {
                message = message+', Please enter Video title';
            }
        }
        if (priorityblank == true) {
            if (message == '') {
                message = 'Priority should not be 0';
            } else {
                message = message + ', Priority should not be 0';
            }
        }
        if (prioritydetails == true) {
            if (message == '') {
                message = 'Priority should not be blank';
            } else {
                message = message + ', Priority should not be blank';
            }
        }
        if (result == true) {
            if (message == '') {
                message = 'Priority should be unique';
            } else {
                message = message + ', Priority should be unique';
            }
        }
        if (videotitle == true || priorityblank == true || prioritydetails == true || result == true) {
            alert(message);
        } else {
            document.getElementById("Meetingpatchform").submit();
        }
    }
    function hasDuplicates(arr) {
        return arr.some(function (item) {
            return arr.indexOf(item) !== arr.lastIndexOf(item);
        });
    }
</script>