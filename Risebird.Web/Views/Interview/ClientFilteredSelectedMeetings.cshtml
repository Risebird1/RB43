@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>

<link href="~/Newassets/css/SelectedPriorityClientMeetings.css" rel="stylesheet" />
<table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>Interview Date</th>
            <th>Candidate Name</th>
            <th>Client HR</th>
            <th>Project Name</th>
            <th>Primary Skill</th>
            <th>Report Link</th>
            <th>Video</th>
            <th>Resume</th>
            <th>Candidate Contact</th>
            <th>Current Employer</th>
            <th>Expected Salary</th>
            <th>Expected Joining Time</th>
            <th>Preferred Location</th>
            <th>Staffing Agency</th>
            <th>Approval Status</th>
            <th>Approval Comments</th>
            <th class="no-sort"></th>
            <th>Final Selection Status</th>
            <th>Final Selection Comments</th>
            <th class="no-sort"></th>
            <th>Action</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Interview Date</th>
            <th>Candidate Name</th>
            <th>Client HR</th>
            <th>Project Name</th>
            <th>Primary Skill</th>
            <th>Report Link</th>
            <th>Video</th>
            <th>Resume</th>
            <th>Candidate Contact</th>
            <th>Current Employer</th>
            <th>Expected Salary</th>
            <th>Expected Joining Time</th>
            <th>Preferred Location</th>
            <th>Staffing Agency</th>
            <th>Approval Status</th>
            <th>Approval Comments</th>
            <th class="no-sort"></th>
            <th>Final Selection Status</th>
            <th>Final Selection Comments</th>
            <th class="no-sort"></th>
            <th>Action</th>
        </tr>
    </tfoot>
    <tbody>
        @foreach (var item in Model)
        {
            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

            <tr id=@item.imid>
                <td> @item.interviewDate </td>
                @if (item.IsOnline == 1)
                {
                    <td>
                        <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>     @item.candidateName </a>
                    </td>
                }
                else
                {
                    <td>
                        <a onclick=""><span class="dot"></span> @item.candidateName </a>
                    </td>
                }
                @if (item.IsHrOnline == 1)
                {
                    <td>
                        <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                    </td>
                }
                else
                {
                    <td>
                        <a onclick=""><span class="dot"></span> @item.ClientHrContact </a>
                    </td>
                }
                <td> @item.ClientName </td>
                <td> @item.JDTiltle.Split("|")[0] </td>
                <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.irfIntId, isClient = true})'>Report</a> </td>
                @if (item.VideoLink != null && item.VideoLink != "")
                {
                    <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                }
                else
                {
                    <td>No Video</td>
                }
                @if (item.resumeLink != null && item.resumeLink != "")
                {
                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                }
                else
                {
                    <td>No Resume</td>
                }

                @if (item.MobileNumber != null)
                {
                    <td>@item.MobileNumber</td>

                }
                else
                {
                    <td>No Contact</td>
                }
                <td> @item.currentEmployerName </td>
                <td> @item.expectedPerHourRate </td>
                <td> @item.joiningTime </td>
                <td> @item.preferredLocation </td>
                <td>@item.staffingAgency</td>
                <td>
                    @item.NextLevelApprovalStat
                </td>
                <td>
                    <textarea style="height: 100px; width:100%;">@item.ApprovalComments</textarea>
                </td>
                <td></td>

                <td>
                    @item.FinalSelectionStat
                </td>
                <td>
                    <textarea style="height: 100px; width:100%;">@item.FinalComments</textarea>
                </td>
                <td></td>
                <td class="text-right">
                    <span title="Approved For Next Round" onclick="ModalButtonClick(@jsonObject)" id="@("myBtn_"+item.imid)" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-thumbs-up"></i></span>
                    <span title="Final Selection Status" onclick="ModalSelectionButtonClick(@jsonObject)" id="@("mySelectionBtn_"+item.imid)" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-check-circle-o"></i></span>
                </td>
            </tr>
        }
    </tbody>
</table>