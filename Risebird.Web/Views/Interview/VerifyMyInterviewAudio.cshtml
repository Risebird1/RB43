@model Risebird.Entities.ViewModel.VerifyCandidateAudio


@{
    ViewData["Title"] = "Verify Audio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>

    body {
        font-family: Roboto, sans-serif;
    }

    .panel-header-sm {
        height: 85px;
        padding-top: 65px;
        background: none !important;
    }
    table {
        white-space: nowrap !important;
    }

    .canvasjs-chart-credit {
        display: none;
    }


    .multiple_row > h2 {
        font-size: 16px;
        background: #42a5f5 !important;
        padding: 4px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 0px;
        margin-bottom: 10px;
    }
    .mdc-fab {
        width: 30px !important;
        height: 30px !important;
        background-color: #53a5f5 !important;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }
    .mc-button-area {
        text-align: right;
    }
    .mdc-card {
        border-top: 3px #53a5f5 solid;
    }
    .mdc-card-wrapper__text-section {
        padding: 16px;
    }
    .mdc-button--raised:not(:disabled), .mdc-button--unelevated:not(:disabled) {
        background: #42a5f5 !important;
        font-family: Roboto, sans-serif;
        font-size: 12px;
        text-decoration: none;
    }

    .mdc-button--outlined:not(:disabled) {
        border-color: #42a5f5 !important;
        color: #42a5f5 !important;
    }

    .mdc-fab-secondary {
        background: #fff !important;
        color: #53a5f5 !important;
    }

    .mdc-card .modal .form-control, .mdc-card .form-control {
        border: 0;
        border-radius: 4px 4px 0 0;
        background: whitesmoke;
        height: 40px;
        font-size: 0.8rem;
        border-bottom: 1px rgba(0, 0, 0, 0.29) solid;
    }

        .mdc-card .modal .form-control:focus, .mdc-card .form-control:focus {
            border-bottom: 2px rgb(80, 158, 235) solid;
        }

</style>

<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js"></script>*@


<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>
<link href="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />

<script src="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

<div class="main-panel" id="main-panel">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Verify Audio
                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">

        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/Interview/VerifyMyInterviewAudio" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Candidate Details</h2>
                                        </div><!--end of multiple location-->
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.IRFName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.IRFName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Uploaded Audios</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">
                                            <table class="table table-bordered mbn" id="AudioTable" style="text-align:center">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">File</th>
                                                        <th width="15%">Phrase</th>
                                                        <th width="20%">Enrollment Status</th>
                                                        <th width="35%">Result</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.CandidateAudios != null)
                                                    {
                                                        @for (int i = 0; i < Model.CandidateAudios.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    <a href='@Model.CandidateAudios[i].AudioFileLink' download>
                                                                        @Model.CandidateAudios[i].AudioFileLink.Split('/').Last()
                                                                    </a>
                                                                </td>
                                                                <td>@Model.CandidateAudios[i].PhraseDetail</td>
                                                                @if (Model.CandidateAudios[i].IsEnrolled)
                                                                {
                                                                    <td>Yes</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No</td>

                                                                }
                                                                @if (Model.CandidateAudios[i].EnrollmentMessage != null)
                                                                {
                                                                    <td>@Model.CandidateAudios[i].EnrollmentMessage</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>NA</td>

                                                                }

                                                                @if (Model.CandidateAudios[i].VoiceItUserId != null)
                                                                {
                                                                    @Html.HiddenFor(m => Model.CandidateAudios[i].VoiceItUserId)
                                                                }

                                                            </tr>

                                                        }

                                                    }

                                                </tbody>
                                            </table>


                                        </div>
                                    </div><!--end of col-md-12-->

                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Upload Audio for Verification</h2>
                                        </div><!--end of multiple location-->
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 col-sm-12">

                                        @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                        @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control btn", @accept = ".mp3, .wav, .m4a" })

                                    </div>

                                </div>

                                <ul style="margin:0px; padding:0 15px;">
                                    <li style="color:red;font-size: 13px;line-height: 18px;font-weight: normal;padding: 8px 0px 10px 0px;">Kindly ensure the duration of the audio file for voice biometric verification is a minimum of 2 seconds and does not exceed 5 seconds.</li>
                                </ul>
                                @Html.HiddenFor(m => m.IRFId)
                                @Html.HiddenFor(m => m.CandidateId)
                                @Html.HiddenFor(m => m.VoiceItUserId)
                                @Html.HiddenFor(m => m.MeetingId)
                                @Html.HiddenFor(m => m.PhraseDetail)

                                <div class="card-footer ">
                                    <div class="row">

                                        <div class="col-md-12 mc-button-area">
                                            @Html.ActionLink("Back to List", "MyInterview", "Interview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save">Verify</button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

    </div>

</div>



@*<script src="https://code.jquery.com/jquery-1.12.4.min.js" integrity="sha256-ZosEbRLbNQzLpnKIkEdrPv7lOy9C27hHQ+Xp8a4MxAQ=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.5/jspdf.min.js"></script>*@






