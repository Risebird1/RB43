@model Risebird.Entities.ViewModel.VerifyCandidateAudio


@{
    ViewData["Title"] = "Verify Audio";
    ViewBag.PageHeader = "Verify Audio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">


    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">

        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/Interview/VerifyMyInterviewAudio" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Candidate Details</h2>
                                        </div><!--end of multiple location-->
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.IRFName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.IRFName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Uploaded Audios</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">
                                            <table class="table table-bordered mbn" id="AudioTable" style="text-align:center">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">File</th>
                                                        <th width="15%">Phrase</th>
                                                        <th width="20%">Enrollment Status</th>
                                                        <th width="35%">Result</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.CandidateAudios != null)
                                                    {
                                                        @for (int i = 0; i < Model.CandidateAudios.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    <a href='@Model.CandidateAudios[i].AudioFileLink' download>
                                                                        @Model.CandidateAudios[i].AudioFileLink.Split('/').Last()
                                                                    </a>
                                                                </td>
                                                                <td>@Model.CandidateAudios[i].PhraseDetail</td>
                                                                @if (Model.CandidateAudios[i].IsEnrolled)
                                                                {
                                                                    <td>Yes</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No</td>

                                                                }
                                                                @if (Model.CandidateAudios[i].EnrollmentMessage != null)
                                                                {
                                                                    <td>@Model.CandidateAudios[i].EnrollmentMessage</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>NA</td>

                                                                }

                                                                @if (Model.CandidateAudios[i].VoiceItUserId != null)
                                                                {
                                                                    @Html.HiddenFor(m => Model.CandidateAudios[i].VoiceItUserId)
                                                                }

                                                            </tr>

                                                        }

                                                    }

                                                </tbody>
                                            </table>


                                        </div>
                                    </div><!--end of col-md-12-->

                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Upload Audio for Verification</h2>
                                        </div><!--end of multiple location-->
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12 col-sm-12">

                                        @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                        @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control btn", @accept = ".mp3, .wav, .m4a" })

                                    </div>

                                </div>

                                <ul style="margin:0px; padding:0 15px;">
                                    <li style="color:red;font-size: 13px;line-height: 18px;font-weight: normal;padding: 8px 0px 10px 0px;">Kindly ensure the duration of the audio file for voice biometric verification is a minimum of 2 seconds and does not exceed 5 seconds.</li>
                                </ul>
                                @Html.HiddenFor(m => m.IRFId)
                                @Html.HiddenFor(m => m.CandidateId)
                                @Html.HiddenFor(m => m.VoiceItUserId)
                                @Html.HiddenFor(m => m.MeetingId)
                                @Html.HiddenFor(m => m.PhraseDetail)

                                <div class="card-footer ">
                                    <div class="row">

                                        <div class="col-md-12 mc-button-area">
                                            @Html.ActionLink("Back", "MyInterview", "Interview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save">Verify</button>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

    </div>

</div>









