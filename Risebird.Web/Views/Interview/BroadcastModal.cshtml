
<div id="broadcastModal" class="modal modal-bg">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <svg class="broadcastfilter-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M21 6h-7.59l3.29-3.29L16 2l-4 4-4-4-.71.71L10.59 6H3c-1.1 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.11-.9-2-2-2zm0 14H3V8h18v12zM9 10v8l7-4z"></path></svg>
                </div>
                <h5 class="modal-title pull-left" id="filterModalLabel"> Broadcast</h5>@*(<label id="boradcastIrfName"></label>)*@
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" onclick="closeBroadcastModal()">&times;</span>
            </button>

            <div class="modal-body">
                <input type="hidden" id="hid_irfid_broadcast" />
                <input type="hidden" id="hid_interviewId_broadcast" />
                <input type="hidden" id="hid_shouldSendEmail_broadcast" />
                <div class="col-md-12 col-sm-12">
                    <div class="form-group">
                        <label class="control-label  desp-label" for="Subject">Subject <span class="required">*</span></label>
                        <input class="w-full" type="text" name="textField" id="bcSubject" required />
                    </div>

                    <div class="form-group">
                        <label class="control-label  desp-label" for="Message">Message <span class="required">*</span></label>

                        <div>
                            <textarea style="width:100%;" id="bcMessage"></textarea>
                        </div>

                    </div>
                </div>
                <div class="col-md-12 col-sm-12 text-right">
                    <button type="button" onclick="SendBroadcast()" class="mdc-button mdc-button--raised mdc-ripple-upgraded sendButton">Send</button>
                    <button type="button" onclick="closeBroadcastModal()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style=" background-color: #FF3636 !important; margin-left: 10px;">Close</button>
                </div>
            </div>

        </div>
    </div>
</div>
@*Start: Email mail popup*@
<div id="SendmailModal" class="modal modal-bg">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <svg class="broadcastfilter-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M21 6h-7.59l3.29-3.29L16 2l-4 4-4-4-.71.71L10.59 6H3c-1.1 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.11-.9-2-2-2zm0 14H3V8h18v12zM9 10v8l7-4z"></path></svg>
                </div>
                <h5 class="modal-title pull-left" id="filterModalLabel"> Mail</h5>@*(<label id="boradcastIrfName"></label>)*@
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" onclick="closeSendmailModal()">&times;</span>
            </button>
            <div class="modal-body">
                <input type="hidden" id="hid_needClearityinterviewId" />
                <input type="hidden" id="hid_needClearityclienthr" />
                <input type="hidden" id="hid_needClearitycandidateEmail" />
                <div class="col-md-12 col-sm-12">
                    <div class="form-group">
                        <label class="control-label  desp-label" for="Subject">Subject <span class="required">*</span></label>
                        <input class="form-control w-full" type="text" name="textField" id="needClearitybcSubject" readonly />
                    </div>
                    <div class="form-group">
                        <label class="control-label  desp-label" for="Message">Message <span class="required">*</span></label>
                        <div>
                            <textarea style="width:100%;" id="bcMessage"></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 col-sm-12 text-right">
                    <button type="button" onclick="SendNeedClearitymail()" class="mdc-button mdc-button--raised mdc-ripple-upgraded sendButton">Send</button>
                    <button type="button" onclick="closeSendmailModal()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style=" background-color: #FF3636 !important; margin-left: 10px;">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
@*End: Email mail popup*@