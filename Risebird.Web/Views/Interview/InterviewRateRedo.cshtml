        Request a Redo<span style="display: inline-block;font-weight: 300;font-size: 15px;">
            If you had a poor experience, request a redo for another interview. Our team will review and get back to you
        </span>
    </h2>
    <input type="checkbox" id="redoInterviewer" name="" value="Check this box if you are not satisfied with the interviewer" />
    <label for="redoInterviewer" style="font-weight: 500;font-size:17px;">Kindly checkmark if you want to submit redo request along with your rating</label>
    <div id="ClientInterviewbuttonHide" class="submit-wrapper" style="display:none;position:relative;top:4px;padding-top: 20px;margin-bottom:25px;border-top: 1px grey dotted;">
        <input type="button" id="btnSubmit" class="submit-feedback" value="Submit Feedback" onclick="AddCandidateFeedbackForm()" />
    </div>
    <script>
        function ChangeCheckBox(groupName) {
            var result = $('input[name="' + groupName + '"]:checked');
            var resultString = '';
            if (result.length > 0) {
                result.each(function () {
                    if (resultString == '') {
                        resultString += $(this).val();
                    } else {
                        resultString += "," + $(this).val();
                    }
                });
                $('#' + groupName).val(resultString);
            }
            else {
                $('#' + groupName).val("");
            }
            CountCheckBox();
        }
    </script>


    <script>
        $(document).on('show', '.accordion', function (e) {
            $(e.target).prev('.accordion-heading').addClass('accordion-opened');
        });
        $(document).on('hide', '.accordion', function (e) {
            $(this).find('.accordion-heading').not($(e.target)).removeClass('accordion-opened');
        });
    </script>
    <script>
        $(".accordion-heading a").on("click", function () {
            $($(this).data("target")).addClass("page--active");
        });

        $(".page__close").on("click", function () {
            $(".page").removeClass("page--active");

        });

    </script>
    <script>
        function AddCandidateFeedbackForm() {
            var Rating = $("#Rating").val();
            var LimitedHandoncoding = $("#LimitedHandoncoding").val();
            var WeakInfrastructure = $("#WeakInfrastructure").val();
            var UnethicalPractices = $("#UnethicalPractices").val();
            var PoorCommunicationSkills = $("#PoorCommunicationSkills").val();
            var TimeManagement = $("#TimeManagement").val();
            var Interviewid = $("#Interviewid").val();
            var PaymentComplianceCount = $("#PaymentComplianceCount").val();

            var Inaccuratedecisionmaking = $("#Inaccuratedecisionmaking").val();
            var QuestionsRelevance = $("#QuestionsRelevance").val();
            var ScoreRubricIgnorance = $("#ScoreRubricIgnorance").val();
            var PoorFeedbackComments = $("#PoorFeedbackComments").val();
            var WrongStatusUpdates = $("#WrongStatusUpdates").val();
            var ProctoringIgnorance = $("#ProctoringIgnorance").val();
            var InterviewerVideo = ($("#InterviewerVideo").length ? $("#InterviewerVideo").val() : "");
            if ((parseInt($("#PaymentComplianceCount").val()) > 0 && parseInt($("#Rating").val()) < 5) || parseInt($("#Rating").val()) == 5) {
                $.ajax({
                    type: "POST",
                    data: {
                        Rating: Rating,
                        TimeManagement: TimeManagement,
                        LimitedHandoncoding: LimitedHandoncoding,
                        WeakInfrastructure: WeakInfrastructure,
                        UnethicalPractices: UnethicalPractices,
                        PoorCommunicationSkills: PoorCommunicationSkills,
                        Interviewid: Interviewid,
                        PaymentComplianceCount: PaymentComplianceCount,

                        Inaccuratedecisionmaking: Inaccuratedecisionmaking,
                        QuestionsRelevance: QuestionsRelevance,
                        ScoreRubricIgnorance: ScoreRubricIgnorance,
                        PoorFeedbackComments: PoorFeedbackComments,
                        WrongStatusUpdates: WrongStatusUpdates,
                        ProctoringIgnorance: ProctoringIgnorance,
                        InterviewerVideo: InterviewerVideo
                    },
                    url: "/Interview/ClientInterviewReview",
                    success: function (result) {
                        swal.fire("Rating has been updated successfully.");
                        closeClientInterviewRating();
                        location.reload();
                    }
                });
            } else {
                alert('Please select at least a reason.');
            }
        }
        function ChangeQuestion1(id) {
            var Rating = $("#Rating").val(id);
            if (Rating.val() == 5) {
                $("#ClientInterviewFeedbackHide").hide();
            } else {
                $("#ClientInterviewFeedbackHide").show();
            }
            $("#ClientInterviewbuttonHide").show();
        }
        function CountCheckBox() {
            var countcheck = 0;
            $('#checkboxlist').find(':checkbox').each(function () {
                var vlucheck = $(this)[0].checked;
                if (vlucheck) {
                    countcheck = countcheck + 1;
                }
            });
            $("#PaymentComplianceCount").val(countcheck);
        }
    </script>
