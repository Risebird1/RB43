<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#OpeninterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#OpeninterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#OpeninterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function openAssignationPopup(id, meetingid) {
        var modal = document.getElementById("MyAssignationModel");
        modal.style.display = "block";
        $("#myassiinterviewid").val(id);
        $("#myassimeetingid").val(meetingid);
    }
    function closeAssignationPopUp() {
        var modal = document.getElementById("MyAssignationModel");
        modal.style.display = "none";
        $("#myassiinterviewid").val('');
        $("#myassimeetingid").val('');
    }
    function ReAssignMeeting() {
        if ($("#txtsharetext1").val().trim() != "") {
            var urlcurrent = $("#zoomlink_" + $("#myassiinterviewid").val()).val();
            $.ajax({
                url: "/Interview/ReassignMeeting",
                data: { id: $("#myassiinterviewid").val(), meetingid: $("#myassimeetingid").val(), Emailid: $("#txtsharetext1").val() },
                success: function (data) {
                    closeAssignationPopUp();
                    if (data.code === 'CAP_REACHED') {
                        swal.fire('Interview Limit Reached', data.meetings, 'warning');
                        return;
                    }
                    swal.fire(data.meetings);
                    if (data.meetings == "Interview assigned Successfully.") {
                        $("#txtvideoUrls").text(urlcurrent);
                        var modal = document.getElementById("MeetingLinkModel");
                        modal.style.display = "block";
                        $("#lblcodedname").text(data.codedname);
                        $('#special_text').text('Copy Link');
                    }
                }
            });
        }
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
    function closeMeetingLinkModel() {
        var modal = document.getElementById("MeetingLinkModel");
        modal.style.display = "none";
    }
</script>

