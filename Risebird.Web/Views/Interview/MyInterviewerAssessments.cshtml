@model IEnumerable<Risebird.Entities.Data.Meeting>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "My Interviewer Assessments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] InterviewSlot = new string[] { };
    string[] CandidateName = new string[] { };
    string[] RisebirdHR = new string[] { };
    string[] InterviewDate = new string[] { };
    string[] JobLevel = new string[] { };
    //string[] InterviewDuration = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("MyInterviewfilters") != null)
{
    filter = JsonConvert.DeserializeObject<MyInterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("MyInterviewfilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
    InterviewSlot = filter.InterviewSlot != null ? filter.InterviewSlot : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
    RisebirdHR = filter.RisebirdHR != null ? filter.RisebirdHR : new string[] { };
    InterviewDate = filter.InterviewDate != null ? filter.InterviewDate : new string[] { };
    JobLevel = filter.JobLevel != null ? filter.JobLevel : new string[] { };

    //InterviewDuration = filter.InterviewDuration != null ? filter.InterviewDuration : new string[] { };
}

<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

