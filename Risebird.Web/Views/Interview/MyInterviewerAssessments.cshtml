<script>
    var interviewUnassignedMinutes;
    $(document).ready(function () {
        $.ajax({
            type: "GET",
            url: "/Interview/GetInterviewUnassignedMinutes",
            success: function (data) {
                interviewUnassignedMinutes = data;
            }
        });


        $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        $("#InterviewSlot").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#CandidateName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#RisebirdHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#InterviewDate").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        $("#JobLevel").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $('#MyInterviewList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#MyInterviewList').DataTable();
    });
    function ResetFilter() {

             $.ajax({
            type: "POST",
                 url: "/Interview/MyInterviewerAssessments",
                 success: function (data) {
                    window.location.href = "/Interview/ResetMyInterviewFilter";
                 }
                });
    }
        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var InterviewSlot = @Html.Raw(Json.Serialize(InterviewSlot));
            var CandidateName =  @Html.Raw(Json.Serialize(CandidateName));
            var RisebirdHR =  @Html.Raw(Json.Serialize(RisebirdHR));
            var InterviewDate =  @Html.Raw(Json.Serialize(InterviewDate));
            var JobLevel =  @Html.Raw(Json.Serialize(JobLevel));
            @*//var InterviewDuration =  @Html.Raw(Json.Serialize(InterviewDuration));*@

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#InterviewSlot").val(InterviewSlot);
            $("#CandidateName").val(CandidateName);
            $("#RisebirdHR").val(RisebirdHR);
            $("#InterviewDate").val(InterviewDate);
            $("#JobLevel").val(JobLevel);
            //$("#InterviewDuration").val(InterviewDuration);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
                 url: "/Interview/MyInterviewerAssessments",
            data: form,
                 success: function (data) {
                 }
                });
    }
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#MyInterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#MyInterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#MyInterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

