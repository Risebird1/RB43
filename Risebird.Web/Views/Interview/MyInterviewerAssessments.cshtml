<script type="text/javascript">


    function CheckTimeDifference(meetingId, interviewDate) {
        $.ajax({
            type: "GET",
            url: "/Interview/GetTimeDifference",
            data: { 'interviewDate': interviewDate, 'interviewUnassignedMinutes': interviewUnassignedMinutes },
            success: function (response) {
                UnAssignInterviewer(meetingId, response)
            }
        });
    }
    function UnAssignInterviewer(meetingId, isPenalty) {

        var textMsg;
        if (isPenalty) {
            textMsg = "Unassigning at this hour will lead to a penalty. Note: Update Risebird HR, before unassigning interview."
        }
        else {
            textMsg = "The Interview will be unassigned! Note: Update Risebird HR, before unassigning interview.";
        }


        //var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: textMsg,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Unassign Me!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Interview/UnassignYourself?id=' + meetingId + '&isPenalty=' + isPenalty,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error unassigning!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Unassigned!',
                    type: 'success',
                    html: '<p>You have been unassigned.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interview/MyInterviewerAssessments";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your were not unassigned.',
                    'error'
                )
            }
        })
    }

</script>

<script>
    function checkStartDate(val) {

        if (val == "") {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var StartDate = new Date(year, month, date);

        var endDateValue = document.getElementById("EndDate").value;
        var yearEnd = endDateValue.substring(0, 4);
        var monthEnd = parseInt(endDateValue.substring(5, 7)) - 1;
        var dateEnd = endDateValue.substring(8, 10);
        var EndDate = new Date(yearEnd, monthEnd, dateEnd);


        if (StartDate > EndDate) {
            document.getElementById("submitFilter").disabled = true;
            document.getElementById("startDateCheck").style.display = "block";
            document.getElementById("startDateCheck").innerHTML = "Start Date should be less than or equal to End Date";
            document.getElementById("StartDate").focus();
            return;
        }
        else {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;

        }
        //if (document.getElementById("EndDate").value != "") {
        //    checkEndDate(document.getElementById("EndDate").value);
        //}

    }

    function checkEndDate(val) {

        if (val == "") {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }
        var startDateValue = document.getElementById("StartDate").value;
        if (startDateValue == null || startDateValue == "") {
            return;
        }

        //end Date object creation
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var endDate = new Date(year, month, date);

        //start Date object creation

        //if (startDateValue == "") {
        //    document.getElementById("endDateCheck").style.display = "block";
        //    document.getElementById("endDateCheck").innerHTML = "Kindly fill the Start Date field.";
        //    document.getElementById("StartDate").focus();
        //    return;
        //}
        var yearStart = startDateValue.substring(0, 4);
        var monthStart = parseInt(startDateValue.substring(5, 7)) - 1;
        var dateStart = startDateValue.substring(8, 10);
        var startDate = new Date(yearStart, monthStart, dateStart);


        if (endDate <= startDate) {
            document.getElementById("submitFilter").disabled = true;
            document.getElementById("endDateCheck").style.display = "block";
            document.getElementById("endDateCheck").innerHTML = "End Date should be greater than Start Date";
            document.getElementById("EndDate").focus();
            return;
        }
        else {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }

    }
</script>
<script>
    function FilterInterviews(filterValue) {

        $.ajax({
            type: "GET",
            url: "/Interview/GetFilteredMyInterviews",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#MyInterviewList').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#MyInterviewList').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>


