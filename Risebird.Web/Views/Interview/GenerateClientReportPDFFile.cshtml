<link href="~/newassets/css/report.css" rel="stylesheet" />
<div id="main-panel" style="display:none">


    <div class="content dataloading client">
        <div class="row bl-bg">
            <div class="col-md-12">
            </div>
        </div>
        <div class="row bl-bg" id="pdfdownload">
            <nav class="navbar navbar-expand-lg navbar-transparent btn-primary  navbar-absolute top-panel" style="height:53px;">
                <div class="pull-left">
                    <div class="navbar-wrapper w-full">
                        <div id="txtpageHeader" class="navbar-brand" style=" line-height:50px!important;">
                            <img style="position:relative;top:0px;width: 30%;" src="data:image/png;base64,@ViewBag.Risebirdlogo" />
                        </div>
                    </div>

                </div>
                <div class="pull-right" style="text-align:right!important">
                    <img style="position:relative;top:0px;width: 30%;" src="data:image/png;base64,@ViewBag.ClientLogo" />
                </div>
            </nav>
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/Interview/AddReport" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form" id="reportForm">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row" style="padding-top:20px">
                                    <div class="col-md-4" style="padding-top:30px">
                                        <div>
                                            @*<label>REPORT DETAILS</label>*@
                                            @{
                                                var meestingstatusvalue = Model.MeetingStatus.HasValue ? ((MeetingStatus)Convert.ToInt32(Model.MeetingStatus)).GetDescription() : string.Empty;
                                                var interviewtatusvalue = Model.InterviewStatus.HasValue ? ((InterviewStatus)Convert.ToInt32(Model.InterviewStatus)).GetDescription() : string.Empty;
                                            }
                                            @if (Model.MeetingStatus == 4)
                                            {
                                                var meetingcolor = "";
                                                @if (Model.InterviewStatus == 2)
                                                {
                                                    meetingcolor = "green";
                                                }
                                                else if (Model.InterviewStatus == 3)
                                                {
                                                    meetingcolor = "red";
                                                }
                                                <h6>Status : <strong style="color:@meetingcolor">@interviewtatusvalue</strong></h6>
                                            }
                                            else
                                            {
                                                <h6>Status : <strong>@meestingstatusvalue</strong></h6>
                                            }
                                        </div>
                                        <hr />
                                        <div style="padding-top:20px">
                                            <p style="font-size:18px">Tech Skill Score: <span class="totScore"><strong id="totTechScore"></strong></span></p>
                                        </div>
                                        <div>
                                            @if (Model.TechSkillReportCollection != null)
                                            {
                                                @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                {
                                                    <div style="padding-top:10px">
                                                        <p>@Model.TechSkillReportCollection[i].SkillName</p>
                                                        @{
                                                            var TechSkill_Score = Model.TechSkillReportCollection[i].WeightageActual * 100 / Model.TechSkillReportCollection[i].WeightageRequired;
                                                        }
                                                        @Html.HiddenFor(m => m.TechSkillReportCollection[i].RequiredLevelId)
                                                        @Html.HiddenFor(m => m.TechSkillReportCollection[i].ActualLevelId)
                                                        @Html.HiddenFor(m => m.TechSkillReportCollection[i].WeightageRequired)
                                                        @Html.HiddenFor(m => m.TechSkillReportCollection[i].WeightageActual)
                                                        <div class="skillBackground skill-round-xlarge skill-small">
                                                            <div class="skill-center skill-round-xlarge skill-teal" style="width:@TechSkill_Score%">@TechSkill_Score %</div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="row col-md-8" style="background-color:white;padding-top:20px;padding-left:20px;border-radius: 25px;">
                                        @if (Model.resumeLink != null && Model.resumeLink != "")
                                        {
                                            <a id="resumeID" target="_blank" title="Resume" href=@Model.resumeLink.ToString().Replace(" ", "%20")><h5>@Model.CandidateName</h5></a>
                                        }
                                        else
                                        {
                                            <h5>@Model.CandidateName</h5>
                                        }
                                        @Html.HiddenFor(m => m.CandidateName)
                                        <p>@Model.JDTiltle</p>
                                        <p>@Model.interviewDate</p>
                                        @if (Model.VideoLink != null && Url.Content(Model.VideoLink) != null)
                                        {
                                            <div style="clear:both"></div>
                                            <div style="padding-top:10px">
                                                <a href="@Model.VideoLink"><p style="font-size:16px">Click Here For Interview Video</p></a>
                                                <hr />
                                            </div>
                                        }
                                        <div style="clear:both"></div>
                                        <div style="padding-top:10px">
                                            <p style="font-size:18px">Interviewer Comment</p>
                                            <hr />
                                            <div>
                                                <p>@Model.InterviewerComment</p>
                                            </div>
                                        </div>
                                        <div style="clear:both"></div>
                                        <div style="padding-top:10px">
                                            <p style="font-size:18px">Questions Discussed</p>
                                            <hr />
                                            <div>
                                                @if (Model.QuestionsCollection != null && Model.QuestionsCollection.Count() != 0)
                                                {
                                                    <ul>
                                                        @for (int i = 0; i < Model.QuestionsCollection.Count(); i++)
                                                        {
                                                            var valueslist = Model.QuestionsLevelList.Where(x => x.Value == (Model.QuestionsCollection[i].RatingId).ToString()).Select(x => x.Text).FirstOrDefault();
                                                            @if (Model.QuestionsCollection[i].Timing != null && Model.QuestionsCollection[i].Timing > 0)
                                                            {
                                                                <li onclick="switchtoquestionVedio(@Model.QuestionsCollection[i].Timing)" style="cursor:pointer">@Model.QuestionsCollection[i].Comment [@Model.QuestionsCollection[i].SkillName]</li>
                                                            }
                                                            else
                                                            {
                                                                <li>@Model.QuestionsCollection[i].Comment [@Model.QuestionsCollection[i].SkillName]</li>
                                                            }
                                                            <label>Rating : @valueslist</label>
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @Html.HiddenFor(m => m.IsGeneralSkillRequired)
                            </div>

                            @Html.HiddenFor(m => m.id)
                            @Html.HiddenFor(m => m.IRFId)
                            @Html.HiddenFor(m => m.InterviewId)
                            @Html.HiddenFor(m => m.IsEdited)
                            @Html.HiddenFor(m => m.IsQC)
                            @Html.HiddenFor(m => m.IRFName)
                            @Html.HiddenFor(m => m.PrimarySkill)
                            @Html.HiddenFor(m => m.IsQCRequired)

                            @Html.HiddenFor(x => x.CandidateId)
                            @Html.HiddenFor(x => x.OldInterviewStatus)
                            @Html.HiddenFor(x => x.OldMeetingStatus)
                            @Html.HiddenFor(x => x.OverallScore)
                            @if (ViewBag.profile == "Interviewer" || ViewBag.profile == "Quality Controller")
                            {
                                @Html.HiddenFor(x => x.ThumbnailTimeSeconds)
                                @Html.HiddenFor(x => x.VideoDuration)
                            }
                            @Html.HiddenFor(x => x.OldInterviewerComment)
                            @Html.HiddenFor(x => x.IsEdited)
                            @Html.HiddenFor(x => x.ResourceUrl)
                        </form>
                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
            <div class="col-md-12" style="text-align:center">---------------------------*** END OF THE REPORT ***---------------------------</div>
        </div>
        <!-- end row -->

    </div>

</div>

