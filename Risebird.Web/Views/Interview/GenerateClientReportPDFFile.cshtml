</style>
@if (isServerPdf)
{
    <style>
        /* wkhtml/DinkToPdf: full page height; keep #main-panel floats for skill rows */
        html, body {
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
        }
        body.sidebar-mini .wrapper, .wrapper {
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
        }
        #main-panel {
            display: block !important;
            height: auto !important;
            max-height: none !important;
            min-height: 0 !important;
            overflow: visible !important;
        }
        #main-panel > .content,
        #main-panel .content.dataloading,
        #pdfdownload {
            height: auto !important;
            max-height: none !important;
            overflow: visible !important;
        }
        .perfect-scrollbar-on .main-panel {
            height: auto !important;
            max-height: none !important;
        }
        .modal, .modal-bg, #QuestionNotificationModelPopup, #PublicUrlShareModel, #AadhaarKYCpopup, #SecureUrlModel, #SecureUrlShareModel {
            display: none !important;
        }
        body.sidebar-mini .wrapper .main-panel,
        body.sidebar-mini #main-panel {
            width: 100% !important;
            max-width: 100% !important;
        }
    </style>
}
