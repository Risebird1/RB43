                                                            @if (TechSkill_Score == 0)
                                                            {
                                                                                             <div class="skill-center skill-round-xlarge skill-teal" style="display:contents;width:@TechSkill_Score%"><span class="ratecount" style="right:-350px;">@TechSkill_Score %</span></div>
                                                            }
                                                            else
                                                            {
                                                                                                         <div class="skill-center skill-round-xlarge skill-teal" style="width:@TechSkill_Score%"><span class="ratecount" style="right:-350px;">@Model.TechSkillReportCollection[i].WeightageActual  / @Model.TechSkillReportCollection[i].WeightageRequired</span></div>

                                                            }
                                                                     </div>
                                                                 </div>
                                                }
                                            }
                                             </div>
                                         </div>

                                         <div class="html2pdf__page-break"></div>

                                         <div class="col-md-12">

                                             <div style="margin-top:10px;padding:80px 20px 20px 20px;">
                                                 <div style="color:#000;margin:0px 0px 10px 0px;font-weight:600;font-size:17px;"><span style="color:#fff;background:#000;padding:3px 10px; text-align:center;margin-right:10px;">5</span>Questions Discussed</div>
                                                 <hr style="margin-bottom:8px;" />
                                                 <div class="question">
