<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>

<script>
    function getPDF() {
        var imgData = $("#hidclientlogo").val();
        var imgData1 = $("#hidlogo").val();
        var d = new Date();
        var filename = $('#CandidateName').val() + "_" + d.getDate() + "_" + (d.getMonth() + 1) + "_" + d.getFullYear() + ".pdf";
        var element = document.getElementById("pdfdownload");


        html2pdf()
            .from(element)
            .set({
                margin: [-4, -2, -4, -2], //top, left, buttom, right,
                padding:[20, 40, 20, 40],
                filename: filename,
                image: { type: 'jpeg', quality: .95 },
                html2canvas: { scale: 2, logging: true, dpi: 192, letterRendering: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'p' },
                pagebreak: { mode: 'avoid-all' }

            })
            .toPdf()
            .get('pdf').then(function (pdf) {

                var totalPages = pdf.internal.getNumberOfPages();


                for (let i = 1; i <= totalPages; i++) {
                    pdf.setPage(i);
                    pdf.setFontSize(10);
                    pdf.setTextColor(50);
                    pdf.addImage(imgData, "PNG", 175, 3, 25, 8);
                    pdf.addImage(imgData1, "PNG", 5, 3, 25, 10);
                    pdf.text('© 2023 Arhat Talent Solutions Pvt Ltd.:' + i + '/' + totalPages + '', pdf.internal.pageSize.getWidth() - 85, pdf.internal.pageSize.getHeight() - 8);

                }

            }).save();
        timeout(5000);
    }
    function timeout(index) {
        setTimeout('', index);
        window.setTimeout(function () { window.close(); }, 5000);
    }



</script>


