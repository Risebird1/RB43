@model Risebird.Entities.ViewModel.InterviewReport
@using System.Text.RegularExpressions
@using Risebird.CommonHelper;
@using Risebird.Entities.Enum
@using Microsoft.Extensions.Configuration;

@inject IConfiguration configuration


@{
    ViewData["Title"] = "Interview Report";
    ViewBag.PageHeader = "Interview Report";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    var isServerPdf = ViewBag.IsServerPdfDownload as bool? == true;

    var meetingStatusList = new List<SelectListItem>
    ();
    meetingStatusList = Html.GetEnumSelectList<MeetingStatus>
        ().ToList();
    var interviewStatusList = new List<SelectListItem>
        ();
    var hasDistinctParticipants = Model.HasDistinctParticipants;

    decimal serverPdfTotTech = 0;
    decimal serverPdfTotTech2 = 0;
    if (isServerPdf)
    {
        if (Model.TechSkillReportCollection != null)
        {
            foreach (var t in Model.TechSkillReportCollection)
            {
                serverPdfTotTech += (decimal)t.WeightageActual;
            }
        }

        if (Model.TechSkillTwoReportCollection != null)
        {
            foreach (var t in Model.TechSkillTwoReportCollection)
            {
                serverPdfTotTech2 += (decimal)t.WeightageActual;
            }
        }
    }
}
