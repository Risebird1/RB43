                                                                                  <div class="cr-hdr-value">@Model.CommunicationalProficiency <span style="opacity:.7">/ 10</span></div>
                                                    }
                                                    else
                                                    {
                                                                                          <div class="cr-hdr-label" style="margin-top:12px;">Communication Score</div>
                                                                                          <div class="cr-hdr-value">@Model.CommunicationalProficiency <span style="opacity:.7">/ 10</span></div>
                                                    }
                                                 </div>
                                                 <div class="cr-report-header__col cr-report-header__col--right">
