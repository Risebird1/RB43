<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>
<script src="~/js/ScoreChart/SetScoreChartValues.js?v=2024"></script>
<script>

    function switchtoquestionVedio(questiontime) {
        var time = 1.0;
        if (questiontime != '') {
            time = questiontime;
        }
        var vid = document.getElementsByClassName("vjs-tech");
        vid[0].currentTime = time;
    }

    $(document).ready(function () {

        //shorter/better attempt
        var weightageItems = $('[id$="WeightageActual"]');
        for (i = 0; i < weightageItems.length; i++) {
            var id = weightageItems[i].id;
            var match = id.match(/\d+/g);
            var digit = match[0];

            var index = weightageItems[i].id.indexOf(digit);
            var skillName = weightageItems[i].id.substring(0, index);
            var reqLevel = $("#" + skillName + digit + "__RequiredLevelId").val();
            var actLevel = $("#" + skillName + digit + "__ActualLevelId").val();

            var actualWeightage;
            var reqWeightage = $("#" + skillName + digit + "__WeightageRequired").val();
            actualWeightage = CalculateOverAllScore(reqLevel, actLevel, reqWeightage);
            if (reqLevel <= actLevel) {
                $("#" + skillName + digit + "__WeightageActual").val(actualWeightage);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "#008000");
            }
            else {
                $("#" + skillName + digit + "__WeightageActual").val(actualWeightage);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "red");
            }
        }

        var items = $('[id$="WeightageActual"]');
        var totalCount = 0;

        for (i = 0; i < items.length; i++) {
            totalCount += parseInt(items[i].value);
        }
        SetTechReportCalculation('TechSkillReportCollection');
        SetTechTwoReportCalculation('TechSkillTwoReportCollection');
        var average = 0;
        if ('@Model.IsJoinabilitySelectabilityRequired' == "True") {
            average = totalCount / 4;
        }
        else {
            average = totalCount / 2;
        }
        $("#OverallScore").val(average);

    });

    function SetTechReportCalculation(techCollectionIdStartsWith) {
        var idSelector = '[id^=' + '"' + techCollectionIdStartsWith + '"' + '][id$="WeightageActual"]';
        var techItems = $(idSelector);
        var totalTechSkillScore = 0;
        if (techItems != null) {
            var techItemsLength = 0;
            if (techCollectionIdStartsWith == 'IreportModel_TechSkillReportCollection') {
                techItemsLength = techItems.length / 2;
            }
            else {
                techItemsLength = techItems.length;
            }
            for (i = 0; i < techItemsLength; i++) {
                var requiredWeightage = document.getElementById(techCollectionIdStartsWith + "_" + i + "__WeightageRequired").value;
                var actualWeightage = document.getElementById(techCollectionIdStartsWith + "_" + i + "__WeightageActual").value;

                if (actualWeightage != null && actualWeightage != '') {
                    totalTechSkillScore = totalTechSkillScore + parseFloat(actualWeightage);
                }
            }
            document.getElementById("totTechScore").innerHTML = (parseFloat(totalTechSkillScore).toFixed(2)).toString() + '%';
        }
    }
    function SetTechTwoReportCalculation(techCollectionIdStartsWith) {
        var idSelector = '[id^=' + '"' + techCollectionIdStartsWith + '"' + '][id$="WeightageActual"]';
        var techItems = $(idSelector);
        var totalTechSkillScore = 0;
        if (techItems != null) {
            var techItemsLength = 0;
            techItemsLength = techItems.length;
            for (i = 0; i < techItemsLength; i++) {
                var requiredWeightage = document.getElementById(techCollectionIdStartsWith + "_" + i + "__WeightageRequired").value;
                var actualWeightage = document.getElementById(techCollectionIdStartsWith + "_" + i + "__WeightageActual").value;

                if (actualWeightage != null && actualWeightage != '') {
                    totalTechSkillScore = totalTechSkillScore + parseFloat(actualWeightage);
                }
            }
            document.getElementById("totTechScore2").innerHTML = (parseFloat(totalTechSkillScore).toFixed(2)).toString() + '%';
        }
    }
