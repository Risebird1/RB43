                                             <div class="col-lg-12 col-md-12 skill-divider cr-skill-meta"> <hr style="margin-top:0;border:none" /> <h2 style="font-size:15px!important;letter-spacing:normal;top:10px;position:relative"><span style="text-transform:none!important;float:left;font-size:15px;line-height:18px;color:#000;padding-right:5px;">Primary Skill :</span><span style="float:left"> @Model.JDTiltle</span>
