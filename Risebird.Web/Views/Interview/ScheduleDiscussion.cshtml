


@model IEnumerable<Risebird.Entities.Data.Meeting>
@{
    ViewData["Title"] = "Schedule Discussion";
    Layout = "~/Views/Shared/_Layout.cshtml";

}


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Scheduled Interviews
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Scheduled Interviews</h4>
                    </div>
                    <div class="row">
                        <div class="col-md-3 ml-md-auto">
                            <div class="form-group">

                            </div>
                        </div>

                    </div>


                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-stats">
                        <div class="card-body ">

                            <div class="statistics statistics-horizontal">
                                <div class="info info-horizontal">
                                    <div class="row">
                                        <div class="col-12 text-center">
                                            <h3 class="info-title" style="font-size:smaller;"> @item.IRFID</h3>
                                        </div>
                                    </div>
                                    <hr>

                                    <div class="row" style="font-size:smaller;">

                                        <div class="col-12">
                                            <div class="group inner list-group-item-text">
                                                <span>Client Name:</span> <p>@item.ClientCompName (@item.ClientName)</p>
                                                <span>Interview Date:</span> <p>@item.interviewDate  </p>
                                                <span>Primary Skills:</span> <p>@item.JDTiltle.Split('|')[0]  </p>
                                                <span>JD Link:</span> <p><a href="@item.JDLink" target="_blank">Job Description</a>  </p>
                                                <span>Job Ends on:</span> <p> @item.EndDate.ToString("dd MMM yyyy") </p>
                                                <span>Resume:</span> <p><a href="@item.resumeLink" target="_blank">Resume</a>   </p>


                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer ">
                            <div class="stats text-center">


                                <button type="button" onclick="window.open('@item.CalendlyLink')" class="btn btn-info btn-icon btn-sm" title="Reschedule Meeting">
                                    <i class="now-ui-icons fa fa-calendar"></i>
                                </button>
                                <button type="button" onclick="window.open('@item.zoomLink')" class="btn btn-warning btn-icon btn-sm" title="Join Meeting">
                                    <i class="now-ui-icons fa fa-meetup"></i>
                                </button>
                                @if (item.InterviewerPhone != null && item.InterviewerPhone != string.Empty && DateTime.Now.AddMinutes(-5) <= item.interviewDate && item.interviewDate <= DateTime.Now.AddMinutes(65))
                                {
                                    @*<button type="button" onclick="ModalButtonClick(@jsonObject)" class="btn btn-success btn-icon btn-sm" title="Call Interviewer">
                                        <i class="now-ui-icons fa fa-phone"></i>
                                    </button>*@
                                    <button type="button" onclick="CommonCallButtonClick('@item.InterviewerFirstName', '@item.InterviewerPhone', '@item.interviewer', null, null, 'Interviewer')" class="btn btn-success btn-icon btn-sm" title="Call Interviewer">
                                        <i class="now-ui-icons fa fa-phone"></i>
                                    </button>
                                }

                                <button type="button" onclick="javascript:CancelInterview(@jsonObject);" class="btn btn-round btn-danger btn-icon btn-sm like" title="Cancel interview request.">
                                    <i class="fa fa-times"></i>
                                </button>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

        @*<div id="myModal" class="modal modal-bg">
            <!-- Modal content -->
            <div class="modal-content">


                <div class="filheader">
                    <div class="filavatar">
                        <span class="publicsharing-icon">


                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                        </span>
                    </div>
                    <h5 class="modal-title pull-left">Call Candidate !</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                </button>

                <div class="modal-body">

                    <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>


                    <input type="button" onclick="closeCallPopUp()" id="hangUpButton" tyle="margin: 10px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">

                </div>

            </div>

        </div>*@
        <!-- end row -->
    </div>

</div>


<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>
<script src="~/js/twiliocallmaker.js"></script>

<script>
    function CancelInterview(obj) {

        //var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: "The Interview will be cancelled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel interview!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Interview/CancelInterview?id=' + obj.id + '&interviewDate=' + obj.interviewDate + '&candidateEmail=' + obj.candidateEmail,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error cancelling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successful!',
                    type: 'success',
                    html: '<p>The interview was cancelled!</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interview/ScheduleDiscussion";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Sorry!',
                    'The interview was not cancelled.',
                    'error'
                )
            }
        })
    }

</script>