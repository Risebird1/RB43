@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "Multiple Candidate Invites";
    ViewBag.PageHeader = "Multiple Candidate Invites";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin-bottom:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Multiple Candidate Invites</h4></div>
                </div>

                <div class="pull-right">

                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span data-toggle="tooltip" data-placement="top" title="Back" onclick="location.href='@Url.Action("Index", "Interview")'" data-original-title="Tooltip on top"> Back</span>
                    </button>






                    <i type="submit" class="fa fa-file-excel-o excel-file card-title-space" style="margin-left:10px;float:right;color:green;font-size: 35px;" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("MultipleCandidateInvitesExporttoExcel", "Interview")'"></i>
                </div>
            </div>
        </div>
    </div>






    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">



                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">


                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <div id="tableID">
                                        <table id="dupmeeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th id='start'>Invite Count</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>IRF ID</th>
                                                    <th>Risebird HR</th>
                                                    <th>Candidate Contact</th>
                                                    <th>Client HR</th>
                                                    <th>Staffing Agenecy</th>
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Invite Count</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>IRF ID</th>
                                                    <th>Risebird HR</th>
                                                    <th>Candidate Contact</th>
                                                    <th>Client HR</th>
                                                    <th>Staffing Agenecy</th>
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.imid>
                                                        <td> @item.InviteCount </td>
                                                        <td> @item.interviewDate </td>
                                                        <td> @item.candidateName</td>
                                                        <td> @item.candidateEmail</td>
                                                        <td> @item.JDTiltle.Split("|")[0] </td>
                                                        <td> @item.interviewer</td>
                                                        @if (item.confirmationStatus.Trim() == "Cancelled")
                                                        {
                                                            <td class="text-center">

                                                                <a style="color:red"> @item.confirmationStatus</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center"> @item.confirmationStatus</td>
                                                        }
                                                        <td> @item.MeetingStatusStatusDesc</td>
                                                        <td> @item.intervieweStatusStatDesc</td>
                                                        <td> @item.IRFId</td>
                                                        <td> @item.risebirdHR</td>
                                                        <td>@item.MobileNumber</td>
                                                        <td> @item.ClientHrContact </td>
                                                        <td>@item.staffingAgency</td>
                                                        <td class=" action">
                                                            @if (item.IsAdmin && item.MeetingStatusStatusDesc != "Completed")
                                                            {
                                                                <button class="mdc-fab app-fab--absolute trash-btn" aria-label="">
                                                                    <span onclick="location.href = '@Url.Action("DeleteInterview", "Interview", new { id = item.imid,controllerName="Interview" })'" title="Delete Interview" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>


                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->
        </div>

    </div>
</div>

<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
<script>
    function RefreshSearch() {
        $('#dupmeeting').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#dupmeeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top:11px;' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }


 
 
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#dupmeeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#dupmeeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#dupmeeting").show();
        }, 2000);
    };
                //// script for loader ends here
</script>


