<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
<script>
    $(function () {
        $(".accordion-content:not(:first-of-type)").css("display", "none");
        $(".js-accordion-title:first-of-type").addClass("open");
        $(".js-accordion-title:first-of-type").addClass("open");
        $(".js-accordion-title").click(function () {
            $(".open").not(this).removeClass("open").next().slideUp(300);
            $(this).toggleClass("open").next().slideToggle(300);
        });
    });
</script>
<script>
    function ClientInterviewRating(interviewid, Reportsnippet) {
        $.ajax({
            url: '/Interview/ClientInterviewReview',
            data: { 'id': interviewid, 'actionType': Reportsnippet },
            type: "GET",
            success: function (data) {
                if (document.getElementById("ClientInterviewRatingModel").style.display != "block") {
                    openClientInterviewRating();
                    $('#divClientInterviewRating').html('');
                    $('#divClientInterviewRating').html(data);
                }
            }
        });
    }
    function closeClientInterviewRating() {
        var modal = document.getElementById("ClientInterviewRatingModel");
        modal.style.display = "none";
    }
    function openClientInterviewRating() {
        var modal = document.getElementById("ClientInterviewRatingModel");
        modal.style.display = "block";
    }
</script>
@if (!Model.ReportAccepted && ViewBag.profile == "Client" && Model.Reportsnippet == 1)
{
    <script>
        var video = document.getElementById('video');
        var startTime = 0;
        var endTime = 15 * 60;
        function checkTime() {
            if (video.currentTime >= endTime) {
                video.pause();
                ClientInterviewRating($("#hidtxtinterviewid").val());
            }
            setTimeout(checkTime, 100);
        }
        video.currentTime = startTime;
        checkTime();
    </script>
}
@if ((ViewBag.profile == "Client" && !string.IsNullOrEmpty(Model.AudioTranscriptFileLink)) && (Model.ReportAccepted || Model.Reportsnippet == 0))
{
    <script>
        openSecureReportNotificationModel();
    </script>
}
<script>
    function removeOrShortlistInterviewer(interviewid, action) {
        var bodyText;
        var confirmationButtonText;
        var successHtmlText;
        if(action =='Rejected')
        {
            bodyText = 'Do you want to terminate this interviewer from taking further interviews for this Skill Channel?';
            confirmationButtonText = 'Yes, Remove it!';
            successHtmlText = '<p>The Interviewer has been removed.</p>';
        }
        else
        {
            bodyText = 'Do you want to shortlist this interviewer?';
            confirmationButtonText = 'Yes';
            successHtmlText='<p>The Interviewer has been shortlisted.</p>';
        }

        swal.fire({
            title: 'Are you sure?',
            text: bodyText,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: confirmationButtonText,
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        type: "POST",
                        url: "/Interview/RemoveOrShortlistInterviewer",
                        data: { 'interviewid': interviewid, 'action' : action },
                        success: function (result) {
                            resolve(result);
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successful!',
                    type: 'success',
                    html: successHtmlText,
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled! :)',
                    'error'
                )
            }
        })
    }
</script>
<script>
    function EditReport() {
        var modal = document.getElementById("EditReportModel");
        modal.style.display = "block";
        $("#edinterviewerComment").val($("#hidinterviewerComment").val());
    }
    function closeEditReportModel() {
        var modal = document.getElementById("EditReportModel");
        modal.style.display = "none";
    }
    function SaveEditReport() {
        var comment = $("#edinterviewerComment").val();
        if (comment != '') {
            $.ajax({
                type: "POST",
                url: "/Interview/UpdateInterviewReport",
                data: { comment: comment, interviewid: $("#hidtxtinterviewid").val() },
                success: function (data) {
                    closeEditReportModel();
                    location.reload();
                    swal.fire(data);
                }
            });
        } else {
            swal.fire('Comment is required.');
        }
    }
</script>

