@if (!Model.ReportAccepted && ViewBag.profile == "Client")
{
    <script>
        var video = document.getElementById('video');
        var startTime = 0;
        var endTime = 15 * 60;
        function checkTime() {
            if (video.currentTime >= endTime) {
                video.pause();
                ClientInterviewRating($("#hidtxtinterviewid").val());
            }
            setTimeout(checkTime, 100);
        }
        video.currentTime = startTime;
        checkTime();

        function ClientInterviewRating(interviewid) {
            $.ajax({
                url: '/Interview/ClientInterviewReview',
                data: { 'id': interviewid },
                type: "GET",
                success: function (data) {
                    openClientInterviewRating();
                    $('#divClientInterviewRating').html('');
                    $('#divClientInterviewRating').html(data);
                }
            });
        }
        function closeClientInterviewRating() {
            var modal = document.getElementById("ClientInterviewRatingModel");
            modal.style.display = "none";
        }
        function openClientInterviewRating() {
            var modal = document.getElementById("ClientInterviewRatingModel");
            modal.style.display = "block";
        }
    </script>
}
