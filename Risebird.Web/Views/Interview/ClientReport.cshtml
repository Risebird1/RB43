                                                        <span class="totScore">
                                                            @if ((Model.ReportAccepted && ViewBag.profile == "Client") || (Model.Reportsnippet == 2 || Model.Reportsnippet == 0) || ViewBag.profile != "Client")
                                                            {  
                                                                <strong id="totTechScore"></strong>
                                                            }
                                                            else
                                                            {
                                                                <strong id="totTechScore" style="display:none"></strong>
                                                            }
                                                        </span>
                                                    </h3>
                                                </div>
                                                <div>
                                                    @if (Model.TechSkillReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                        {
                                                            <div class="tech-skill-wrapper">
                                                                <div style="font-weight:500;">@Model.TechSkillReportCollection[i].SkillName</div>
                                                                @{
                                                                    var TechSkill_Score = 0.0;
                                                                    if ((Model.ReportAccepted && ViewBag.profile == "Client") || (Model.Reportsnippet == 2 || Model.Reportsnippet == 0) || ViewBag.profile != "Client")
                                                                    {
                                                                        TechSkill_Score = Model.TechSkillReportCollection[i].WeightageActual * 100 / Model.TechSkillReportCollection[i].WeightageRequired;
                                                                    }
                                                                }
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].RequiredLevelId)
                                                                <span class="rqlevel">Evaluated at <b>@Model.TechSkillReportCollection[i].RequiredLevel</b></span>
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].ActualLevelId)
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].WeightageRequired)
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].WeightageActual)
                                                                <div class="skillBackground skill-round-xlarge skill-small">
                                                                    @if (TechSkill_Score == 0)
                                                                    {
                                                                        <div class="skill-round-xlarge skill-teal" style="display:contents;width:@TechSkill_Score%"><span class="ratecount">@TechSkill_Score %</span></div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="skill-round-xlarge skill-teal" style="width:@TechSkill_Score%"><span class="ratecount">@Model.TechSkillReportCollection[i].WeightageActual  / @Model.TechSkillReportCollection[i].WeightageRequired</span></div>

                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                                <p class="note-skill">
                                                    <b> Note:</b> % score for every skill represents difference between candidate actual and required competency. 
                                                </p>

                                            </div>

                                            <div class="col-lg-9 col-md-7">
                                                @if (Model.MeetingStatus == 1)
                                                {

                                                    <div class="row"><div class="nodata-wrapper"><p class="nodata-img"><img src="../../img/nodata.png"></p></div></div>

                                                }
                                                else
                                                {
                                                    <div class="row">
                                                        <h3><img style="width:30px;left:-11px; top:-2px; position:relative;background: #f5f5f5;padding:4px;" src="/img/detail-icon.png">Watch Interview Video</h3>

                                                        <div class="col-lg-8 col-md-12 col-sm-12 col-xs-12">

                                                            <div>
                                                                @Html.HiddenFor(x => Model.VideoLink)
                                                                @if (Model.VideoLink != null && Url.Content(Model.VideoLink) != null)
                                                                {
                                                                    int appendTime = 0;
                                                                    if (Model.ThumbnailTimeSeconds == 0)
                                                                    {
                                                                        appendTime = Convert.ToInt16(configuration["ThumbnailTimeDefault"]);
                                                                        if (((Model.VideoDuration * 60) > 120) && appendTime > (Model.VideoDuration * 60))
                                                                        {
                                                                            appendTime = (Model.VideoDuration * 60) - 60;
                                                                        }
                                                                        else if ((Model.VideoDuration * 60) < 120)
                                                                        {
                                                                            appendTime = 0;
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        appendTime = Model.ThumbnailTimeSeconds;
                                                                    }
                                                                    var src = Model.VideoLink + "#t=" + appendTime.ToString();
                                                                    <video id="video" controls="controls" controlsList="nodownload" preload="metadata" class="vjs-tech interview">
                                                                        <source src='@Model.VideoLink' type="video/mp4">
                                                                    </video>
                                                                }
                                                                else
                                                                {
                                                                    <p class="nodata"><img src="../../img/novideo.png" /><span>No Video Found</span></p>
                                                                }

                                                                @if (Model.IsTranscript && ViewBag.profile == "Client" && !string.IsNullOrEmpty(Model.AudioTranscriptFileLink))
                                                                {
