<input type="text" hidden id="id_SecurelyShared" value="@ViewBag.SecurelyShared" />
<input type="text" hidden id="id_UniqueId" value="@ViewBag.UniqueId" />
<input type="text" hidden id="id_IsMatched" value="@ViewBag.IsMatched" />
<input type="text" hidden id="hidtxtinterviewid" value="@ViewBag.InterviewId" />
<input type="text" hidden id="hidtxtirfid" value="@ViewBag.IrfId" />

<div id="main-panel">
    <div class="pt30">
        <div class="col-md-12">
            @*<span class="discretion"><strong style="font-size:15px;">Report discretion:</strong> Till the time QC is passed, Risebird can not ensure that all quality standards are met on this report. Use this report at your own discretion.</span>*@
        </div>
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interview Report</h4></div>

                </div>

                <div class="pull-right">

                    <div class="pull-left">
                    </div>

                    <div class="pull-right">
                        @if (!Model.ReportAccepted && ViewBag.profile == "Client" && Model.Reportsnippet == 1)
                        {  <div class="rate-wrap">
                            <div class="rate-interview">
                                <h1>Please watch 15 minutes of interview and rate it to know the status and other details:</h1>
                                <button onclick="ClientInterviewRating('@Model.InterviewId',@Model.Reportsnippet)"> Rate the Interview</button>
                            </div>
                            </div>
                        }
                        else if (!Model.ReportAccepted && ViewBag.profile == "Client" && Model.Reportsnippet == 2)
                        {  <div class="rate-wrap">
                            <div class="rate-interview">
