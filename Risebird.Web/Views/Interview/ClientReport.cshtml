                                <button onclick="ClientInterviewRating('@Model.InterviewId',@Model.Reportsnippet)"> Rate the Interview</button>
                            </div>
                            </div>
                        }
                        @if (((Model.ReportAccepted && ViewBag.profile == "Client") || ViewBag.profile != "Client") && ViewBag.ClientDetails == "client" || ViewBag.SecurelyShared == "True")
                        {
                            <div class="pull-right">
                                <div class="reportdropdown">

                                    <button class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="padding:0px 4px;" type="button" onclick="ClientInterviewRating('@Model.InterviewId',@Model.Reportsnippet)">
                                            <text>Rate Interviewer</text>
                                        </button>
                                    <button class="mdc-button mdc-button--raised mdc-ripple-upgraded" type="button" style="padding:0px 5px;">
                                        <span data-toggle="tooltip" data-placement="top" onclick="javascript:openHMLink('@Model.IRFId');" data-original-title="Tooltip on top"><text><svg fill="#fff" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path></svg> HM Instruction</text></span>
                                        </button>
                                        @if (Model.IsRedoInterview && (Model.MeetingStatus == 4 || Model.MeetingStatus == 6 || Model.MeetingStatus == 7 || Model.MeetingStatus == 8))
                                        {
                                        <button class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                                <span onclick="OpenSecureRedoFormModel('@Model.InterviewId','@Model.InterviewStatus','InterviewAddReport')"><text> Redo Interview</text></span>
                                            </button>
                                        }

                                  @*  <button class="reportdropbtn">Report Quality Issue</button>
                                    <div class="reportdropdown-content">
                                      
                                        <button class="dropdown-btn" type="button" onclick="ClientInterviewRating('@Model.InterviewId',@Model.Reportsnippet)">
                                            <text>Rate Interviewer</text>
                                        </button>
                                        <button class="dropdown-btn" type="button">
                                            <span data-toggle="tooltip" data-placement="top" onclick="javascript:openHMLink('@Model.IRFId');" data-original-title="Tooltip on top"><text>Edit HM Instruction</text></span>
                                        </button>
                                        @if (Model.IsRedoInterview && (Model.MeetingStatus == 4 || Model.MeetingStatus == 6 || Model.MeetingStatus == 7 || Model.MeetingStatus == 8))
                                        {
                                            <button class="dropdown-btn">
                                                <span onclick="OpenSecureRedoFormModel('@Model.InterviewId','@Model.InterviewStatus','InterviewAddReport')"><text> Redo Interview</text></span>
                                            </button>
                                        }
                                    </div>*@
                                </div>
                            </div>
                            @if (Model.IRFInterviewerActive)
                            {
                                <div class="pull-right"> <input style="background:green!important;margin-bottom: 4px; margin-right: 5px;padding:0px 5px;" type="button" class="generate-pdf mdc-button mdc-button--raised mdc-ripple-upgraded pull-right"  value="ShortList Interviewer" onclick="removeOrShortlistInterviewer('@Model.InterviewId', 'Shortlisted')"></div>

                                <div class="pull-right"> <input style="background:#e03030!important;margin-bottom: 4px; margin-right: 5px;padding:0px 5px;" type="button" class="generate-pdf mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" value="Remove Interviewer" onclick="removeOrShortlistInterviewer('@Model.InterviewId', 'Rejected')"></div>
                            }
                        }

                        @if (((Model.ReportAccepted && ViewBag.profile == "Client") || ViewBag.profile != "Client") && (ViewBag.PageStatus == "Mainurl" || ViewBag.PageReport == "External"))
                        {
                            <div class="pull-right"> <input type="button" class="generate-pdf mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style="margin-bottom: 4px; margin-right: 5px;padding:0px 5px" value="Generate PDF" onclick="getPDF()"></div>
                        }
                        @if (((Model.ReportAccepted && ViewBag.profile == "Client") || ViewBag.profile != "Client") && ViewBag.ClientDetails == "client")
                        {
                            <div class="pull-right"> <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style="margin-bottom: 4px; margin-right: 5px;padding:0px 5px;" value="Generate Secure URL" onclick="GenerateSecureUrl('@Model.InterviewId','@Model.IRFId')"></div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="loader text-center">
            <img src="~/Newassets/img/lazyload.gif" />
        </div>
        @if (ViewBag.SecurelyShared == null || ViewBag.SecurelyShared == "" || (ViewBag.SecurelyShared == "True" && ViewBag.UniqueId != null && ViewBag.IsMatched == "True"))
        {
            <div class="content dataloading client">
                <div class="row bl-bg">
                    <div class="col-md-12">
                    </div>
                </div>

                <div class="row bl-bg" id="pdfdownload">
                    <div class="col-md-12">
                        <div class="mdc-card card bl-bg">
                            <div>
                              <div>  @if (!string.IsNullOrEmpty(Model.ClientAction))
                                {
                                    if (Model.ClientAction == "Shortlisted")
                                    {
                                            <span style="color:green; width: 100%;font-size:15px;background: #c9f6c9;padding: 2px;display: block; position: relative;top: 0px;text-align: center;font-weight:bold;    margin-bottom: 20px;">This interview is completed by the Interviewer shortlisted by you</span>
                                    }
                                    else if (Model.ClientAction == "Rejected")
                                    {
                                            <span style="color: #e21c1c;width: 100%;font-size:15px;background: #f4433633;padding: 2px;display: block; position: relative;top: 0px;text-align: center;font-weight:bold;    margin-bottom: 20px;">This interview is completed by the Interviewer shortlisted by you</span>

                                    }

                                }
                                else
                                {
                                    <span></span>
                                }
                                </div>
                                <form action="/Interview/AddReport" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form" id="reportForm">
                                    @Html.AntiForgeryToken()
                                    <div class="canvas_div_pdf">
                                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        <div class="row">
                                            <div class="col-lg-3 col-md-5">
                                                @if ((Model.ReportAccepted && ViewBag.profile == "Client") || (Model.Reportsnippet == 2 || Model.Reportsnippet == 0) || ViewBag.profile != "Client")
                                                {
                                                    <div>
                                                        @*<label>REPORT DETAILS</label>*@
                                                        @{
                                                            var meestingstatusvalue = Model.MeetingStatus.HasValue ? ((MeetingStatus)Convert.ToInt32(Model.MeetingStatus)).GetDescription() : string.Empty;
                                                            var interviewtatusvalue = Model.InterviewStatus.HasValue ? ((InterviewStatus)Convert.ToInt32(Model.InterviewStatus)).GetDescription() : string.Empty;
                                                        }
                                                        @if (Model.MeetingStatus == 4)
                                                        {
                                                            var meetingcolor = "";

                                                            @if (Model.InterviewStatus == 2)
                                                            {
                                                                meetingcolor = "green";
                                                            }
                                                            else if (Model.InterviewStatus == 3)
                                                            {
                                                                meetingcolor = "red";
                                                            }

                                                            else if (Model.InterviewStatus == 1)
                                                            {
                                                                meetingcolor = "#fbc02d";
                                                            }
                                                            <h2 class="interview-status"><span>Interview Status :</span> <strong style="color:@meetingcolor">@interviewtatusvalue</strong></h2>
                                                        }
                                                        else
                                                        {
                                                            <h2 class="interview-status"><span>Interview Status :</span> <strong>@meestingstatusvalue</strong></h2>
                                                        }
                                                    </div>
                                                }
                                                @if (ViewBag.profile != "Interviewer")
                                                {
                                                    @if (Model.resumeLink != null && Model.resumeLink != "")

                                                    {
                                                        <div class="report-heading">Candidate Name</div>
                                                        <a id="resumeID" target="_blank" title="Resume" href=@Model.resumeLink.ToString().Replace(" ", "%20")><h2>@Model.CandidateName</h2></a>
                                                    }
                                                    else
                                                    {
                                                        <div class="report-heading">Candidate Name</div>
                                                        <h2>@Model.CandidateName</h2>
                                                    }
                                                }
                                                

                                                <div class="report-heading">
                                                    Position
                                                </div>

                                                <h4>@Model.JDTiltle</h4>
                                                <div class="report-heading">
                                                    Date of Interview
                                                </div>
