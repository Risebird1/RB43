@model Risebird.Entities.ViewModel.TechSkillComments

@{
    ViewData["Title"] = "Sample Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }



    textarea::-webkit-scrollbar {
        width: 2px;
        height: 6px;
        background-color: var(--mdc-theme-primary, #018786) !important;
    }

    textarea::-webkit-scrollbar-thumb {
        background-color: #56a9ff;
        border: 1px solid #56a9ff;
        margin: 2px;
        border-radius: 2px;
    }

    .mc-button-area {
        text-align: right;
    }

    .mdc-card .form-control {
        border: 0;
        border-radius: 4px 4px 0 0;
        background: whitesmoke;
        height: 40px;
        font-size: 0.8rem;
        border-bottom: 1px rgba(0, 0, 0, 0.29) solid;
    }

        .mdc-card .form-control:focus {
            border-bottom: 2px rgb(80, 158, 235) solid;
        }

    .mdc-fab {
        width: 30px !important;
        height: 30px !important;
        background-color: #53a5f5 !important;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .mdc-card {
        border-top: 3px #53a5f5 solid;
    }

    .mdc-card-wrapper__text-section {
        padding: 16px;
    }

    .mdc-button--raised:not(:disabled), .mdc-button--unelevated:not(:disabled) {
        background: #42a5f5 !important;
        font-family: Roboto, sans-serif;
        font-size: 12px;
        text-decoration: none;
    }

    .mdc-button--outlined:not(:disabled) {
        border-color: #42a5f5 !important;
        color: #42a5f5 !important;
    }

    .mdc-fab-secondary {
        background: #fff !important;
        color: #53a5f5 !important;
    }

    .card .card-header .card-title, .card .card-header h4.card-title {
        margin: 0 0px 10px 0;
    }


    .navbar .navbar-wrapper .navbar-brand {
        margin-right: 0.5rem;
    }

    .mc-button-area {
        text-align: right;
    }

    .panel-header-sm {
        height: 85px;
        padding-top: 65px;
        background: none !important;
    }

    .talktext {
        padding: 8px 8px 4px 8px;
        text-align: left;
        line-height: 1.5em;
    }

    .talk-bubble {
        display: inline-block;
        position: relative;
        font-size: 13px;
        height: auto;
        border-radius: 7px;
        margin: 5px 0px;
        background-color: #fff;
    }


        .talk-bubble textarea {
            resize: none;
            border: 0;
            background: #fff;
            padding: 5px;
        }

    .border-bubble {
        border: 1px solid #620bee21;
    }

        .trash-btn {
            background: #d20505 !important;
        }
        #btnPlus {
            top: -3px;
        }
    </style>


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a class="navbar-brand">Sample Questions</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        <form action="/Interview/SampleQuestions" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">
                            @Html.AntiForgeryToken();
                            <div class="row">

                                <div class="card-header">
                                    <h4 class="card-title">Sample Questions</h4>
                                </div>

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive-sm">
                                        <table class="table table-bordered mbn" id="SkillTable">
                                            <thead>
                                                <tr>
                                                    <th class="table_heading">Skill Name</th>
                                                    <th class="table_heading">Questions</th>
                                                    <th class="table_heading text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.SkillCollection.Count() == 0)
                                                {
                                                    <tr>
                                                        <td>

                                                            @Html.DropDownList("SkillCollection[0].Skill", (SelectList)ViewBag.Skills, new { @class = "form-control" })

                                                        </td>

                                                        <td>
                                                            <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                                <div class="talktext">
                                                                    <textarea htmlattributes="{ class = form-control text-box single-line }" id="SkillCollection_0__Comment" style="width:100%" name="SkillCollection[0].Comment" class="valid" aria-invalid="false"></textarea>

                                                                </div>
                                                            </div>



                                                        </td>

                                                        <td class="text-center action-area">

                                                            <span id="btnPlus" onclick="AddRowComments()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>


                                                            @*<button class="mdc-fab app-fab--absolute" aria-label="Add">
                                                                <span id="btnPlus" onclick="AddRowComments()" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"></path></svg></span>
                                                            </button>*@



                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                                <span id="btnMinus" onclick="DeleteRow(this, 'SkillCollection','Skill','Comment')" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                            </button>




                                                        </td>
                                                    </tr>

                                                }
                                                else
                                                {
                                                    for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                    {
                                                        <tr>
                                                            <td>

                                                                @Html.DropDownListFor(m => m.SkillCollection[i].Skill, (SelectList)ViewBag.Skills, new { @class = "form-control" })
                                                            </td>

                                                            <td>
                                                                <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                                    <div class="talktext">

                                                                        @Html.TextAreaFor(m => m.SkillCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%" })

                                                                    </div>
                                                                </div>


                                                            </td>

                                                            <td class="text-center">
                                                                <span id="btnPlus" onclick="AddRowComments()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>

                                                                @*<button class="mdc-fab app-fab--absolute" aria-label="Add">
                                                                    <span id="btnPlus" onclick="AddRowComments()" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"></path></svg></span>
                                                                </button>*@



                                                                <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                                    <span id="btnMinus" onclick="DeleteRow(this, 'SkillCollection','Skill','Comment')" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                                </button>


                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div><!--end of col-md-12-->

                            </div>

                            <div class="card-footer ">
                                <div class="row">

                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "MyInterview", "Interview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>


                            @Html.HiddenFor(m => m.IRFId)
                        </form>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>

</div>

<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
    function AddRowComments() {

        var table = document.getElementById("SkillTable");

        var $ttc = $("#SkillTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#SkillTable tr").length - 1;

        $tr.find("textarea,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("textarea[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#SkillTable").find("tbody tr:last").after($tr);

        var $ttlast = $("#SkillTable").find("tbody tr:last");
        $ttlast.find("textarea").val("");

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        //// Check document for changes
        //$.validator.unobtrusive.parse(document);

    }


    function DeleteRow(element, collectionName, tdOne, tdTwo) {

        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {

            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            //ClientCollection_1__ClientRoleId
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    //name="ClientCollection[3].ClientUserId"
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                }

            }

        }


    }


</script>