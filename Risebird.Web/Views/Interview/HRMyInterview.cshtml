<script type="text/javascript">
   
    $(".dataloading").hide();
    $("#MyInterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#MyInterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#MyInterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    var receiver = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function call(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + receiver + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function ModalButtonClick(phone, receiverName, type) {
        receiver = receiverName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + receiver + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        //document.getElementById("idTitle").innerHTML = "Call " + type;
        call(phone);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }


</script>



<script type="text/javascript">

    
    function UnAssignInterviewer(meetingId) {

        
        //var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: 'You will be unassigned.',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Unassign Me!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Interview/HRUnassignYourself?id=' + meetingId,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error unassigning!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Unassigned!',
                    type: 'success',
                    html: '<p>You have been unassigned.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interview/HRMyInterview";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your were not unassigned.',
                    'error'
                )
            }
        })
    }

</script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true
                    
                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Interview/HRMyInterview';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true
                    
                },
                    function ()
                    {
                        window.location.href = '/Interview/HRMyInterview';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}
    <script>
        var meetingId;

        var spanComment = document.getElementById("hrCommentPopUp");
        // When the user clicks on <span> (x), close the modal
        spanComment.onclick = function () {
            var modal = document.getElementById("hrCommentModal");
            modal.style.display = "none";
        }

        function OpenCommentModal(id, date, commentVal) {
            meetingId = id;
            // Get the modal
            var modal = document.getElementById("hrCommentModal");

            document.getElementById("hrCommentHeading").innerHTML = "Add comment for interview dated: " + date;

            if (commentVal != null && commentVal != "") {
                $("#hrCommentValue").val(commentVal);
            }
            // When the user clicks the button, open the modal
            modal.style.display = "block";


        }
        function SaveHRCommentPopUp() {
            var comment = document.getElementById("hrCommentValue").value;

            $.ajax({
                type: "GET",
                url: "/Interview/SaveHRComment",
                data: { id: meetingId, 'comment': comment },
                success: function (data) {

                    location.reload(true);

                }
            });
        }
    </script>




