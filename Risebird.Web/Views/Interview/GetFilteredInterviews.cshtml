@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Get Filtered Interviews</a>
            </div>
        </div>
    </nav>
    <div class="mt50">
    </div>

    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>


                        <div class="dataloading">

                            <div class="toolbar">

                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">



                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>

                                                <th>IRF ID</th>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Primary Skill</th>
                                                <th>Interviewer</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Zoom Link</th>
                                                <th>Zoom ID</th>
                                                <th>Candidate Contact</th>
                                                <th>Client HR</th>
                                                <th>Staffing Agenecy</th>
                                                <th>Interview Duration</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Expected Salary</th>
                                                <th>Current Employer</th>
                                                <th>Approval Status</th>
                                                <th>Approval Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Final Selection Status</th>
                                                <th>Final Selection Comments</th>
                                                <th class="no-sort"></th>
                                                @*<th>Interview Device Details</th>*@
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>IRF ID</th>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Primary Skill</th>

                                                <th>Interviewer</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Zoom Link</th>
                                                <th>Zoom ID</th>
                                                <th>Candidate Contact</th>
                                                <th>Client HR</th>
                                                <th>Staffing Agenecy</th>
                                                <th>Interview Duration</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Expected Salary</th>
                                                <th>Current Employer</th>
                                                <th>Approval Status</th>
                                                <th>Approval Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Final Selection Status</th>
                                                <th>Final Selection Comments</th>
                                                <th class="no-sort"></th>
                                                @*<th>Interview Device Details</th>*@
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.imid>
                                                    <td title=@item.IRFId> @item.IRFId </td>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.candidateName</td>
                                                    <td> @item.candidateEmail</td>
                                                    <td> @item.JDTiltle.Split("|")[0] </td>
                                                    <td> @item.interviewer</td>
                                                    <td> @item.confirmationStatus</td>
                                                    <td> @item.MeetingStatusStatusDesc</td>
                                                    <td> @item.intervieweStatusStatDesc</td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }

                                                    @if (item.zoomLink != null && item.zoomLink != "")
                                                    {
                                                        <td> <a id="zoomlinkId" target="_blank" title="Zoom Link" href=@item.zoomLink>Zoom Link</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Zoom Link</td>
                                                    }
                                                    <td> @item.risebirdHR</td>
                                                    <td>@item.MobileNumber</td>
                                                    <td> @item.ClientHrContact </td>
                                                    <td>@item.staffingAgency</td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.joiningTime</td>
                                                    <td> @item.preferredLocation</td>
                                                    <td> @item.expectedPerHourRate</td>
                                                    <td> @item.currentEmployerName</td>
                                                    <td>
                                                        @item.NextLevelApprovalStat
                                                    </td>
                                                    <td>
                                                        <textarea style="height: 50px; width:100%;">@item.ApprovalComments</textarea>
                                                    </td>
                                                    <td></td>
                                                    <td>
                                                        @item.FinalSelectionStat
                                                    </td>
                                                    <td>
                                                        <textarea style="height: 50px; width:100%;">@item.FinalComments</textarea>
                                                    </td>
                                                    <td></td>
                                                    @*<td class="wordwrap"> @item.interviewOnDevice</td>*@
                                                    <td class="text-right">
                                                        <span onclick="location.href = '@Url.Action("Edit", "Interview", new { id = item.imid})'" title="Edit" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                                        <span onclick="location.href = '@Url.Action("AddComments", "Interview", new { interviewId = item.imid})'" title="Comment" class="btn btn-round btn-warning btn-icon btn-sm edit"><i class="far fa-comment"></i></span>
                                                        <span onclick="location.href = '@Url.Action("AddReport", "Interview", new { interviewId = item.imid, irfId= item.irfIntId})'" title="Feedback Report" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-file-pdf-o"></i></span>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>