    <script>
        var interviewUnassignedMinutes;
        function openSkillpopup(id, item) {
            $.ajax({
                type: "POST",
                url: "/IRF/FetchSkillDetails",
                data: { id: id },
                success: function (data) {
                    var modal = document.getElementById("IRFSkillModel");
                    var skill_id_pop = $("#skill_id_" + id).val();
                    $("#skill_id_pop").text(skill_id_pop);

                    modal.style.display = "block";
                    bindSkillData(data);
                }
            });
        }
        function closeIRFSkillModel() {
            var model = document.getElementById("IRFSkillModel");
            model.style.display = "none";
        }
        function bindSkillData(data) {
            var html = '';
            html += ' <div class="table-responsive scrollbar style-2" style="overflow-x:scroll"><table class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">';
            html += '  <thead>';
            html += '  <tr>';
            html += '  <th width="20%" class="table_heading">Level<span class="red">*</span></th>';
            html += '  <th width="40%" class="table_heading">Skill Name<span class="red">*</span></th>';
            html += '  <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>';
            html += '  <th width="10%" class="table_heading">Concepts <span class="red">*</span></th>';
            html += '  <th width="10%" class="table_heading">Natureofquestion <span class="red">*</span></th>';
            html += '  <th width="10%" class="table_heading">Timelimit <span class="red">*</span></th>';
            html += '  </tr>';
            html += '  </thead>';
            html += '  <tbody>';
            for (i = 0; i < data.length; i++) {
                html += '   <tr>';
                html += '  <td>' + data[i].levelName + '</td>';
                html += '  <td>' + data[i].skillName + '</td>';
                html += '  <td>' + data[i].weightage + '</td>';
                html += '  <td>' + data[i].concepts + '</td>';
                html += '  <td>' + data[i].natureofquestion + '</td>';
                if (parseInt(data[i].timelimit) > 0) {
                    html += '  <td>' + data[i].timelimit + '</td>';
                } else {
                    html += '<td></td>';
                }
                html += '  </tr>';
            }
            html += '</tbody>';
            html += ' </table></div>';
            $("#divcandidateskills").empty().html(html);
        }

    </script>
    <script>
        function searchResult() {
            $('#MyInterviewList').DataTable();
        }
        function RefreshSearch() {
            $('#MyInterviewList').DataTable().destroy();
            setTimeout(function () {
                applyDataTable();
            }, 2000);
        }

        $(document).ready(function () {
            applyDataTable();

        });

        function applyDataTable() {
            $('#MyInterviewList').DataTable({
                "pagingType": "full_numbers",
                "lengthMenu": [
                    [10, 25, 50, -1],
                    [10, 25, 50, "All"]
                ],
                order: [],
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records",
                },
                "fnInitComplete": function () {
                    $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                    $(".dataTables_filter").keyup(function (e) {
                        if ($(this).val() != "") {
                            $("#x").show();
                        }
                        else { $("#x").show(); }
                    });
                }
            });
        }

        $(document).ready(function () {
            $("#x").click(function (e) {
                $(".dataTables_filter input").val('');
                $(this).hide();
            });

        });
    </script>
    <script type="text/javascript">
        $(".dataloading").hide();
        $("#MyInterviewList").hide();
        var loader;
        function ShowProgress() {
            $(".dataloading").hide();
            $("#MyInterviewList").hide();
            loader = document.getElementsByClassName("loader")[0];
            loader.style.display = "block";
            var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
            var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
            loader.style.top = top + "px";
            loader.style.left = left + "px";
        };
        ShowProgress();
        window.onload = function () {
            setTimeout(function () {
                loader.style.display = "none";
                $(".dataloading").show();
                $("#MyInterviewList").show();
            }, 2000);
        };
        //// script for loader ends here
    </script>

    <script src="~/js/twiliocallmaker.js"></script>

    <script type="text/javascript">


        function CheckTimeDifference(meetingId, interviewDate) {
            $.ajax({
                type: "GET",
                url: "/Interview/GetTimeDifference",
                data: { 'interviewDate': interviewDate, 'interviewUnassignedMinutes': interviewUnassignedMinutes },
                success: function (response) {
                    UnAssignInterviewer(meetingId, response)
                }
            });
        }
        function UnAssignInterviewer(meetingId, isPenalty) {
            var textMsg;
            if (isPenalty) {
                textMsg = "Unassigning at this hour will lead to a penalty. Note: Update Risebird HR, before unassigning interview."
            }
            else {
                textMsg = "As per Client SLA unassigning the interview 4 hours before scheduled time may result deduction of Rs 250 to Rs 1000 from your payment.";
            }


            //var IdIRF = dataID;
            swal.fire({
                title: 'Are you sure?',
                text: textMsg,
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Unassign Me!',
                preConfirm: function () {
                    return new Promise(function (resolve, reject) {
                        //var IdIRF = dataID;
                        $.ajax({
                            url: '/Interview/UnassignYourself?id=' + meetingId + '&isPenalty=' + isPenalty,
                            success: function (result) {
                                resolve(result)
                                ConfirmAvailable(meetingId, 'No');
                            },
                            error: function () {
                                //reject("error message")
                                swal.fire("Error unassigning!", "Please try again", "error");
                            }
                        })
                    })
                },
                allowOutsideClick: false
            }).then(function (result) {
                if (result.dismiss !== 'cancel') {
                    swal.fire({
                        title: 'Unassigned!',
                        type: 'success',
                        html: '<p>You have been unassigned.</p>',
                        showCancelButton: false,
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'Close!',
                        allowOutsideClick: false
                    }).then(function () {
                        window.location = "/Interview/MyInterview";
                    })
                }
                else if (result.dismiss === 'cancel') {
                    swal.fire(
                        'Cancelled',
                        'Your were not unassigned.',
                        'error'
                    )
                }
            })
        }

    </script>
    @if (ViewBag.Message != null)
    {
        <script type="text/javascript">
            $(document).ready(function () {
                my_code();
            });
            function my_code() {
                var msg = '@ViewBag.Message';
                if (msg.includes("Success")) {
                    swal.fire("Successful", '@ViewBag.Message', "success");
                }
                else {
                    swal.fire("Failed", '@ViewBag.Message', "error");
                }
            }
        </script>
    }


    <script>
        $(document).ready(function () {
            if ($("#txtVideostatus").val() == "Public") {
                var modal = document.getElementById("PublicShareVideo");
                modal.style.display = "block";
            }
        });
        function SubmitEmail() {
            if ($("#txtvideoemailid").val().trim() != "") {
                $.ajax({
                    type: "POST",
                    url: "/Interview/PublicMyInterviewInvite",
                    data: { id: $("#hidtxtid").val(), Emailid: $("#txtvideoemailid").val().trim() },
                    success: function (data) {
                        if (data == "success") {
                            window.location = "/Interview/PublicMyInterview?emailid=" + $("#txtvideoemailid").val() + "&id=" + $("#hidtxtid").val();
                        } else {
                            swal.fire(data);
                        }
                    }
                });
            }
        }
        function ConfirmAvailable(meetingId, type) {
            $.ajax({
                type: "POST",
                url: '/Interview/ConfirmInterviewavailability?id=' + meetingId + '&type=' + type,
                success: function (result) {
                    if (type != 'No') {
                        swal.fire(result);
                    }
                }
            });
        }
    </script>
