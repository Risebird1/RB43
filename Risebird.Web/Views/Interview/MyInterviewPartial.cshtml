<script>


    $(document).ready(function () {


        var clientInstructionsPlaceHolder = $('#clientInstructions_modal_body');
        $('a[data-toggle="clientInstructions-modal"]').click(function (event) {
            var url = $(this).data('url');
            //var interviewDate = event.delegateTarget.dataset.interviewDate;
            var interviewDate = $(this).data('interviewdate');
            var candidateName = $(this).data('candidatename');
            $.get(url).done(function (data) {
                clientInstructionsPlaceHolder.html('');
                $("#clientInstructions_interviewDate").html('');
                $("#clientInstructions_candidateName").html('');

                $("#clientInstructions").modal('show');

                clientInstructionsPlaceHolder.html(data);
                $("#clientInstructions_interviewDate").html('Interview Date: ' + interviewDate);
                $("#clientInstructions_candidateName").html("Candidate's Name: " + candidateName);

            });

        });
        //clientInstructions_interviewDate
    });
</script>