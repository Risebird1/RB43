@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Interview Report";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";

    var meetingStatusList = new List<SelectListItem>();
