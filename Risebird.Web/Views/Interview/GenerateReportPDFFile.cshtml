<script type="text/javascript">
    $(document).ready(function () {
        var meetingStatus = document.getElementById('MeetingStatus').value;
        if (meetingStatus == null || meetingStatus == '') {
            document.getElementById('InterviewerComment').disabled = true;
            document.getElementById("interviewerComment_Error").innerHTML = "Select an appropriate value for Meeting Status above to add comments here.";
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById('InterviewerComment').disabled = false;
            document.getElementById("interviewerComment_Error").innerHTML = "";
            if (meetingStatus == 6 || meetingStatus == 7 || meetingStatus == 8) {
                document.getElementById("InterviewStatus").disabled = true;
            }
        }
        var hasDistinctParticipants = '@hasDistinctParticipants';
        if (hasDistinctParticipants != null && hasDistinctParticipants.toLowerCase() == 'false') {
            document.getElementById("InterviewStatus").disabled = true;
        }
    })

</script>
<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>

<script>
    function getPDF() {
        var HTML_Width = $(".canvas_div_pdf").width();
        var HTML_Height = $(".canvas_div_pdf").height();
        var top_left_margin = 15;
        var PDF_Width = HTML_Width + (top_left_margin * 2);
        var PDF_Height = (PDF_Width * 1.5) + (top_left_margin * 2);
        var canvas_image_width = HTML_Width;
        var canvas_image_height = HTML_Height;

        var totalPDFPages = Math.ceil(HTML_Height / PDF_Height) - 1;

        html2canvas($(".canvas_div_pdf")[0], { allowTaint: false }).then(function (canvas) {
            canvas.getContext('2d');

            var imgData = canvas.toDataURL("image/png", 1.0);
            var pdf = new jsPDF('p', 'pt', [PDF_Width, PDF_Height]);
            pdf.addImage(imgData, 'JPG', top_left_margin, top_left_margin, canvas_image_width, canvas_image_height);


            for (var i = 1; i <= totalPDFPages; i++) {
                pdf.addPage(PDF_Width, PDF_Height);
                pdf.addImage(imgData, 'JPG', top_left_margin, -(PDF_Height * i) + (top_left_margin * 4), canvas_image_width, canvas_image_height);
            }
            var d = new Date();

            var filename = $('#CandidateName').val() + "_" + d.getDate() + "_" + (d.getMonth() + 1) + "_" + d.getFullYear();
            pdf.save(filename + ".pdf")

        });

    }
</script>

<script src="~/js/ScoreChart/SetScoreChartValues.js"></script>
<script>
    $(document).ready(function () {
        //shorter/better attempt
        var weightageItems = $('[id$="WeightageActual"]');
        for (i = 0; i < weightageItems.length; i++) {
            var id = weightageItems[i].id;
            var match = id.match(/\d+/g);
            var digit = match[0];

            var index = weightageItems[i].id.indexOf(digit);
            var skillName = weightageItems[i].id.substring(0, index);
            var reqLevel = $("#" + skillName + digit + "__RequiredLevelId").val();
            var actLevel = $("#" + skillName + digit + "__ActualLevelId").val();
            var actualWeightage;
            var reqWeightage = $("#" + skillName + digit + "__WeightageRequired").val();
            actualWeightage = CalculateOverAllScore(reqLevel, actLevel, reqWeightage);
            if (reqLevel <= actLevel) {
                $("#" + skillName + digit + "__WeightageActual").val(actualWeightage);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "#008000");
            }
            else {
                $("#" + skillName + digit + "__WeightageActual").val(actualWeightage);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "red");
            }
        }

        var items = $('[id$="WeightageActual"]');
        var totalCount = 0;

        for (i = 0; i < items.length; i++) {
            totalCount += parseInt(items[i].value);
        }

        SetTechReportChart('TechSkillReportCollection');
        var average = 0;
        if ('@Model.IsJoinabilitySelectabilityRequired' == "True") {
            average = totalCount / 4;
        }
        else {
            average = totalCount / 2;
        }
        $("#OverallScore").val(average);
    });

    $(document).ready(function () {
        var count = '@ViewBag.QuestionsDiscussedCount';
        if (count == null || parseInt(count) == 0) {
            var questionSkillMappingArray = @Html.Raw(Json.Serialize(Model.QuestionsSkillMapping));
            var skillName = questionSkillMappingArray[0].skillName;
            $("#QuestionsCollection_0__SkillName").val(skillName);
        }
    });
    window.onload = function () {
        getPDF();
    }
</script>

