<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.8.1/html2pdf.bundle.min.js"></script>
<script>
    function getPDF() {
        var d = new Date();
        var filename = $('#CandidateName').val() + "_" + d.getDate() + "_" + (d.getMonth() + 1) + "_" + d.getFullYear() + ".pdf";
        var element = document.getElementById("pdfdownload");
        var opt = {
            filename: filename,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 }
        };
        html2pdf(element, opt);
        timeout(5000);
    }
    function timeout(index) {
        setTimeout('', index);
        window.setTimeout(function () { window.close(); }, 5000);
    }
</script>
