@model Risebird.Entities.ViewModel.AssignYourselfVM

@{
    ViewData["Title"] = "Assign Youself Interview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/Meeting/Index">Interview</a>
                <a class="navbar-brand">Assign Youself Interview</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
           
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        @using (Html.BeginForm("AssignYourself", "Interview"))
        {
            @Html.AntiForgeryToken()
            <div class="row">

                <div class="col-md-12">
                    <div class="card ">
                        <div class="card-header ">
                            <h4 class="card-title">Assign Youself Interview</h4>
                        </div>
                        <div class="card-body ">
                            <form class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                @Html.HiddenFor(model => model.id)
                                <div class="row">
                                    @Html.LabelFor(model => model.InterviewDate, htmlAttributes: new { @class = "col-md-2 col-form-label" })
                                    @*<label class="col-md-3 col-form-label">Interview Date</label>*@
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            @Html.TextBoxFor(model => model.InterviewDate, new { @class = "form-control", @readonly = "true" })
                                            @Html.ValidationMessageFor(model => model.InterviewDate, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    @Html.LabelFor(model => model.CandidateEmail, htmlAttributes: new { @class = "col-md-2 col-form-label" })
                                    @*<label class="col-md-3 col-form-label">Email</label>*@
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            @*<input type="email" class="form-control">*@
                                            @Html.TextBoxFor(model => model.CandidateEmail, new { @readonly = true, @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.CandidateEmail, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    @*<label class="col-md-3 col-form-label">Password</label>*@
                                    @Html.LabelFor(model => model.Interviewer, htmlAttributes: new { @class = "col-md-2 col-form-label" })
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            @*<input type="password" class="form-control">*@
                                            @Html.EditorFor(model => model.Interviewer, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.Interviewer, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                               
                            </form>
                        </div>
                        <div class="card-footer ">
                            <div class="row">
                                <label class="col-md-2"></label>
                                <div class="col-md-9">
                                    @Html.ActionLink("Back", "OpenInterview", null, htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                    <button type="submit" class="btn btn-fill btn-primary" id="btnUpload" value="Assign Yourself">Assign Yourself</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        }
    </div>
 
</div>


<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
</script>



