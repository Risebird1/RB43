<div id="ClientwhatsappModel" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Add whatsapp number <span class="popup-text" id="skill_id_pop"></span></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeClientwhatsappModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>

            <input type="text" hidden id="txtinterviewid" />
            <div class="modal-body" style="color:black">
                <div class="form-group whatsapp col-md-12 pull-left p15">
                    <span class="intrqtext">To recieve candidate Report update. Please add whatsapp number, without country code. Ex: 9999999999 </span>
                    <input type="text" class="form-control  text-box single-line" maxlength="10" minlength="10" id="clttxtwhatsappnumber" />
                </div>
                <div class="row">
                    <div class="col-md-12 mc-button-area">
                        <button class="mdc-button mdc-button--raised mdc-ripple-upgraded" onclick="SubmitWhatsapp()" value="Save">Save</button>

                    </div>
                </div>
            </div>




        </div>
    </div>
</div>