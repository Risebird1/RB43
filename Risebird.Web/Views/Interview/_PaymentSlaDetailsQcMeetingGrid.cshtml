@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    var actionStatus = ViewBag.actionstatus as string ?? "";
    var returnBack = ViewBag.ReturnBack != null ? (int)ViewBag.ReturnBack : 0;
}

<div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2-qc">
    <div id="tableIDQc" class="second">
        <table id="meetingTableQc" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <td>Action</td>
                    <td>IRF ID</td>
                    <td>Interview Date</td>
                    <td>Candidate Name</td>
                    <td>Interviewer Issues found in Transcript</td>
                    <td>AI Transcript analysis score</td>
                    <td>Interview Duration</td>
                    <td>Deficit Duration</td>
                    <td>Candidate Rating</td>
                    <td>Reason</td>
                    <td>Interviewer</td>
                    <td>Interviewer Joined on</td>
                    <td>Interviewer Late join</td>
                    <td>Meeting Status</td>
                    <td>Interview Status</td>
                    <td>Channel Owner</td>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <td>Action</td>
                    <td>IRF ID</td>
                    <td>Interview Date</td>
                    <td>Candidate Name</td>
                    <td>Interviewer Issues found in Transcript</td>
                    <td>AI Transcript analysis score</td>
                    <td>Interview Duration</td>
                    <td>Deficit Duration</td>
                    <td>Candidate Rating</td>
                    <td>Reason</td>
                    <td>Interviewer</td>
                    <td>Interviewer Joined on</td>
                    <td>Interviewer Late join</td>
                    <td>Meeting Status</td>
                    <td>Interview Status</td>
                    <td>Channel Owner</td>
                </tr>
            </tfoot>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id="qc_@item.imid">
                        <td>
                            <span>
                                <a style="width:25px;height:25px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onclick="ProxyFormDetails('@item.imid',true,'PaymentSLA','@(actionStatus ?? "")',@returnBack)">
                                    <button type="button" class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Proxy Form" style=" position: relative; top: -1px;">
                                        <i style="font-size: 16px; position: relative; top: -1px;" class="fa fa-wpforms"></i>
                                    </button>
                                </a>
                            </span>
                            @if (item.IsAIInterview && item.AICandidateResponseVideoCount > 0)
                            {
                                <a style="text-decoration:none" target="_blank" href='@Url.Action("Report", "AIInterview" , new { seId = item.SessionId})' title="AI Report">
                                    <button class="mdc-fab app-fab--absolute" aria-label="Report" style="position:relative;top:-3px;"><span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path><path d="M15 2v5h5"></path></svg></span></button>
                                </a>
                            }
                            else
                            {
                                <a target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.imid, irfId=item.irfIntId})" title="Client Interview Report" style="text-decoration:none;">
                                    <button class="mdc-fab app-fab--absolute" aria-label="Client Interview Report" style="margin: 0px 0px 0px 6px;">
                                        <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                    </button>
                                </a>
                            }
                            <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Payment SLA">
                                <div onclick="PaymentSLADetails('@item.imid','@item.candidateEmail','@item.interviewer',false,'PaymentSLA',true)" title="Payment Deduction" class="mdc-fab__icon material-icons">
                                    <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"><path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path><path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path></svg>
                                </div>
                            </button>
                            <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Redo Interview">
                                <span onclick="OpenRedoRequestFormModel('@item.imid','@item.intervieweStatusStatDesc','PaymentSLA')" title="Redo Interview" class="mdc-fab__icon material-icons">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" /><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" /></svg>
                                </span>
                            </button>
                            @if (!string.IsNullOrWhiteSpace(item.interviewer))
                            {
                                <button class="mdc-fab app-fab--absolute " aria-label="Suspicious Interviewer">
                                    <span onclick="javascript:SuspiciousTypeDetails('@item.interviewer');" title="Suspicious Interviewer" class="mdc-fab__icon touch"><img width="17" src="/img/suspicious.png" /></span>
                                </button>
                            }
                        </td>
                        <td title="@item.IRFId">@item.IRFId</td>
                        <td>@item.interviewDate</td>
                        <td>
                            <span style="display:block;font-size:14px;">@item.candidateName</span>
                            @if (item.InterviewerMobileNumber != null && item.InterviewerMobileNumber != string.Empty)
                            {
                                <div>
                                    <span onclick="CommonCallButtonClick('@item.candidateName','@item.InterviewerMobileNumber', '@item.candidateEmail','@item.imid', null, 'Candidate')" title="Call candidate"><img src="/img/calling.png" style="width: 16px;margin: 7px 0px 7px 0px;"></span>
                                    @item.InterviewerMobileNumber
                                </div>
                            }
                        </td>
                        <td style="text-align:center">
                            @if (item.AITranscriptVerdict != null && item.AITranscriptVerdict != "")
                            {
                                <a target="_blank" href="@Url.Action("TransciptAnalysis", "AIScreener" , new { interviewId = item.InterviewId, irfId = item.irfIntId})" title="Transcript Analysis" style="text-decoration:none;"><span style="background:#abadabe3;padding: 0px 10px 3px 10px;border-radius: 4px;color: #fff;font-size: 14px;">Transcript quality</span></a>
                            }
                            @if (item.AIVerdict != null && item.AIVerdict != "")
                            {
                                <br /><br />
                                <a target="_blank" href="@Url.Action("AIClientReport", "Interview" , new { InterviewId = item.InterviewId, irfId=item.irfIntId, isOpenAIQC = true})" title="AI QC Report" style="text-decoration:none;"><span style="background:#abadabe3;padding: 0px 10px 3px 10px;border-radius: 4px;color: #fff;font-size: 14px;">Report quality</span></a>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.AITranscriptAnalysisScore == 0)
                            {<span>NA</span>}
                            else
                            {<span class="count" style="width:26px;height:26px;line-height:26px;">@item.AITranscriptAnalysisScore</span>}
                        </td>
                        <td>@(item.interviewDuration > 0 ? item.interviewDuration + " (mins)" : "")</td>
                        <td>@item.deficit (mins)</td>
                        <td>
                            @if (item.Rating != 0)
                            {<label style="color:#42a5f5;font-size:15px;" onclick="PaymentComplianceDetails('@item.InterviewId','Candidate')">@item.Rating<span style="color:grey;text-transform:lowercase;"> / 5</span></label>}
                            else
                            {<label style="font-size:15px;color:grey">NA</label>}
                        </td>
                        <td>@item.StatusValue</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.interviewer))
                            {<d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer;color: #42a5f5;">@item.InterviewerName</d>}
                            else
                            {<span style="color: #42a5f5">@item.InterviewerName</span>}
                        </td>
                        <td class="intime-on" style="padding-left:30px;">
                            @if (item.IsVideoRequired == true)
                            {
                                <div style="position:relative;z-index:10;width: fit-content">
                                    <div class="absCenter">
                                        <button class="infoButton" style="top:12px;left:-16px;">
                                            <div class="infoButton-btn" style="width:15px;height:15px;"><span class="infoButton-btn-text" style="position: relative;font-size:13px;width: 10px;height: 21px;left:1px;top: -3px;">i</span></div>
                                            <div class="infoButton-container" style="bottom: calc(-100% + 35px);">
                                                <div class="infoButton-container-message" style="position:relative;top:-14px;padding:4px 7px;width:auto;"><b style="color:red">Interviewer video on</b> is mandatory by client, else 100% payment deduction</div>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            }
                            <div style="float:left">@item.Joinedon</div>
                        </td>
                        <td>
                            @if (item.InterviewerLateJoin != 0)
                            {<span style="color:green">Yes</span>}
                            else
                            {<span style="color:#000;font-weight:400">No</span>}
                        </td>
                        @if (item.interviewDate > DateTime.Now && !string.IsNullOrEmpty(item.confirmationStatus) && item.confirmationStatus.Trim() != "Cancelled")
                        {
                            <td>Scheduled</td>
                        }
                        else
                        {
                            <td>@(item.MeetingStatusStatusDesc != "0" ? item.MeetingStatusStatusDesc : "")</td>
                        }
                        <td>@(item.intervieweStatusStatDesc != "0" ? item.intervieweStatusStatDesc : "")</td>
                        <td>@item.ChannelOwner</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
