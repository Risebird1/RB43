@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "QC Report";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "QC Report";
    $('#txtpageHeader').empty().html(Header);
</script>

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> QC Report</h4></div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th id='start'>Skill Channel ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>JD Title</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Client</th>
                                                    <th>Video Link</th>
                                                    <th>Video Duration</th>
                                                    <th>Red Flags</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th id='start'>Skill Channel ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>JD Title</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Client</th>
                                                    <th>Video Link</th>
                                                    <th>Video Duration</th>
                                                    <th>Red Flags</th>
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                    <tr id=@item.imid>
                                                        <td title=@item.IRFId> @item.IRFId </td>
                                                        <td> @item.interviewDate </td>
                                                        <td> @item.candidateName </td>
                                                        <td> @item.candidateEmail</td>
                                                        <td> @item.JDTiltle.Split("|")[0] </td>
                                                        @if (item.MeetingStatusStatusDesc == "Status Pending")
                                                        {
                                                            <td><a style="color:hotpink; font-weight: bold">@item.MeetingStatusStatusDesc</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.MeetingStatusStatusDesc</td>
                                                        }
                                                        @if (item.InterviewStatus == 2)
                                                        {
                                                            <td class="text-center"><a style="color:green;font-weight: bold"> @item.intervieweStatusStatDesc</a></td>
                                                        }
                                                        else if (item.InterviewStatus == 4)
                                                        {
                                                            <td class="text-center"><a style="color:darkorange; font-weight: bold"> @item.intervieweStatusStatDesc</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center">@item.intervieweStatusStatDesc</td>
                                                        }
                                                        <td> @item.ClientName </td>
                                                        @if (item.VideoLink != null && item.VideoLink != "")
                                                        {
                                                            <td> <a id="videoId" target="_blank" title="Video" href=@item.VideoLink.Replace(" ","%20")>Video</a> </td>
                                                            @if (item.VideoDuration > 0)
                                                            {
                                                                <td>@item.VideoDuration</td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td>No Video</td>
                                                            <td>NA</td>
                                                        }
                                                        <td></td>
                                                        <td>
                                                            <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="QC Form" style=" position: relative; top: -3px;">
                                                                <a style="color:white" target="_blank" href="@Url.Action("QCReportForm", "Interview", new { interviewid = item.imid })" title="QC Form" class="mdc-fab__icon material-icons">
                                                                    <i style="font-size: 16px; position: relative; top: -1px;" class="far fa-comment-dots"></i>
                                                                </a>
                                                            </button>
                                                            <button onclick="Redflagsresolved(@item.imid)" class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="RedFalgs Resolved" style=" position: relative; top: -3px;">
                                                                <span title="RedFalgs Resolved" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send-check" viewBox="0 0 16 16"><path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855a.75.75 0 0 0-.124 1.329l4.995 3.178 1.531 2.406a.5.5 0 0 0 .844-.536L6.637 10.07l7.494-7.494-1.895 4.738a.5.5 0 1 0 .928.372l2.8-7Zm-2.54 1.183L5.93 9.363 1.591 6.602l11.833-4.733Z" /><path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Zm-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l.774.773a.75.75 0 0 0 1.174-.144l1.335-2.226a.5.5 0 0 0-.172-.686Z" /></svg>
                                                                </span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}


<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }
    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
    function Redflagsresolved(interviewid) {
        $.ajax({
            type: "POST",
            url: "/Interview/QCReportRedFlagsResolved",
            data: { interviewid: interviewid },
            success: function (data) {
                swal.fire(data);
            }
        });
    }
</script>