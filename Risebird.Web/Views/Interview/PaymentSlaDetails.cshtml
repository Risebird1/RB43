@model IEnumerable<Risebird.Entities.ViewModel.PaymentSLAVM>

@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using System.Collections.Generic
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "911 Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}
<input type="hidden" value="@ViewBag.actionstatus" id="hidactionstatus" />
<input type="hidden" value="@ViewBag.returnBack" id="hidreturnBack" />
<input type="hidden" value="@ViewBag.qcTab" id="hidqcTab" />
@if (HttpContextAccessor.HttpContext.Session.GetString("PaymentSlaDetailsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<SkillChannelDetailsFilter>(HttpContextAccessor.HttpContext.Session.GetString("PaymentSlaDetailsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix payment-sla-911-header">
                <div class="payment-sla-911-title">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"><h4 class="card-title">911 Dashboard</h4></div>
                </div>
                <div class="payment-sla-tabs-row">
                    @{
                        var sla911Action = ViewBag.actionstatus as string ?? "";
                        var sla911OnQc = ViewBag.ShowQcMeetingGrid == true;
                        var sla911SlaCompleted = sla911Action == "SLACompleted";
                    }
                    <div class="@(!sla911SlaCompleted && !sla911OnQc ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('PaymentCompliance','@ViewBag.ReturnBack')"><strong>Payment compliance</strong></div>
                    <div class="@(sla911SlaCompleted && !sla911OnQc ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('SLACompleted','@ViewBag.ReturnBack')"><strong>SLA completed</strong></div>
                    <span class="payment-sla-tab-sep" aria-hidden="true"></span>
                    <div class="@(sla911OnQc && (ViewBag.qcTab as string) == "PropableRedo" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangePaymentSlaQcTab('PropableRedo')"><strong>High severity QC</strong></div>
                    <div class="@(sla911OnQc && (ViewBag.qcTab as string) == "QCUnderReview" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangePaymentSlaQcTab('QCUnderReview')"><strong>Under review</strong></div>
                    <div class="@(sla911OnQc && (ViewBag.qcTab as string) == "FakeReport" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangePaymentSlaQcTab('FakeReport')"><strong>Fake report</strong></div>
                    <div class="@(sla911OnQc && (ViewBag.qcTab as string) == "RedoInterviewCount" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangePaymentSlaQcTab('RedoInterviewCount')"><strong>Redo requested</strong></div>
                </div>
                <div class="payment-sla-911-actions">
                    <div>
                        
                          
                        
                        <button type="button" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-toggle="modal" data-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>

                                            <form action="@Url.Action("PaymentSlaDetails","Interview",new { actionstatus=ViewBag.actionstatus, returnBack = ViewBag.returnBack, qcTab = ViewBag.qcTab })" method="post" id="form" onsubmit="return checkfilterDate();">
                                                <input type="hidden" name="qcTab" value="@ViewBag.qcTab" />
                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12">
                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12 pull-right">
                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>
                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>


                                        </div>
                                    </div>

                                </div>
                                @if (ViewBag.ShowQcMeetingGrid == true && ViewBag.QcMeetingList != null)
                                {
                                    @await Html.PartialAsync("_PaymentSlaDetailsQcMeetingGrid", (IEnumerable<Risebird.Entities.ViewModel.MeetingVM>)ViewBag.QcMeetingList)
                                }
                                else
                                {
                                <div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <td>Skill Channel</td>
                                                    <td>Interview Date</td>
                                                    <td>Join Date</td>
                                                    <td>JD Skills</td>
                                                    <td>Candidate</td>
                                                    
                                                   
                                                      @*   <td>Candidate Email</td> *@
                                                    
                                                    <td>Interviewer</td>
                                                    <td>Company Name</td>
                                                    <td>Resume</td>
                                                    <td>Interviewer Call</td>
                                                    <td>Red Marker</td>
                                                    <td>Payment Deduction</td>
                                                    <td>Video Reward</td>
                                                    <td>Payment Compliance</td>
                                                    <td>Payment Compliance History</td>
                                                    <td>Channel Owner</td>
                                                    <td>Created By</td>
                                                    <td>Created Date</td>
                                                    @if (ViewBag.actionstatus == "SLACompleted")
                                                    {
                                                        <td>Status</td>
                                                    }
                                                    else
                                                    {
                                                        <td>QC Status</td>
                                                    }
                                                    <td>QC RedFlags</td>
                                                    @if (ViewBag.actionstatus != "SLACompleted")
                                                    {
                                                        <td>Action</td>
                                                    }
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <td>Skill Channel</td>
                                                    <td>Interview Date</td>
                                                    <td>Join Date</td>
                                                    <td>JD Skills</td>
                                                    <td>Candidate</td>
                                                      @*   <td>Candidate Email</td> *@
                                                    <td>Interviewer</td>
                                                    <td>Company Name</td>
                                                    <td>Resume</td>
                                                    <td>Interviewer Call</td>
                                                    <td>Red Marker</td>
                                                    <td>Payment Deduction</td>
                                                    <td>Video Reward</td>
                                                    <td>Payment Compliance</td>
                                                    <td>Payment Compliance History</td>
                                                    <td>Channel Owner</td>
                                                    <td>Created By</td>
                                                    <td>Created Date</td>
                                                    @if (ViewBag.actionstatus == "SLACompleted")
                                                    {
                                                        <td>Status</td>
                                                    }
                                                    else
                                                    {
                                                        <td>QC Status</td>
                                                    }
                                                    <td>QC RedFlags</td>
                                                    @if (ViewBag.actionstatus != "SLACompleted")
                                                    {
                                                        <td>Action</td>
                                                    }
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.InterviewDate</td>
                                                        <td>@item.Joinedon</td>
                                                        <td>
                                                            <button type="button" class="clickhere_btn pull-left">
                                                                <span data-toggle="tooltip" data-placement="top" title="" onclick="openSkillpopup(@item.irfIntId)" data-original-title="Click here to add Interviewer"><font style="font-family: Roboto, sans-serif; font-size:12px;">Click Here</font></span>
                                                            </button>
                                                            <input id="skill_id_@item.irfIntId" type="hidden" value="@item.IRFId" />
                                                        </td>
                                                        <td>@item.candidateName
                                                            <br /><div style="margin-top:2px;"> <span class="call-area">
                                                                @if (!string.IsNullOrEmpty(item.CandidatePhone))
                                                                {
                                                                    <span data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.candidateName','@item.CandidatePhone','@item.candidateEmail')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="16" /></span>
                                                                }
                                                                </span><span style="font-size:14px;">@item.CandidatePhone</span>
                                                            </div>
                                                        </td>
                                                       
                                                            @* <td>@item.candidateEmail</td> *@
                                                        
                                                        <td>@item.interviewer</td>
                                                        @if (!string.IsNullOrWhiteSpace(item.CompanyName))
                                                        {
                                                            @if (item.CompanyName.Length > 30)
                                                            {
                                                                <td style="font-size:13px; color:brown" title="@item.CompanyName">@item.CompanyName.Substring(0, 29) ....</td>
                                                            }
                                                            else
                                                            {
                                                                <td style="font-size:13px; color:brown">@item.CompanyName</td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (item.ResumeLink != null && item.ResumeLink != "")
                                                        {
                                                            <td>

                                                                <a style="background:none!important;border:0px!important; text-decoration: underline; color: #039BE5!important;padding:0px;" id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink><img style="position:relative;left:-5px;width:17px" src="/img/resume-icon.png" width="21"><span style="font-size:13px;">Resume</span></a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }
                                                        <td class="text-center flex-w">
                                                            <span class="call-area">
                                                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                {
                                                                    <span data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.InterviewerName','@item.MobileNumber','@item.Interviewer')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="16" /></span>
                                                                }
                                                            </span>@item.MobileNumber
                                                        </td>
                                                        @if (item.interviewer != null || item.interviewer != "")
                                                        {
                                                            <td style="color:red;text-align:center"><d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">@item.RedMarker</d></td>
                                                        }
                                                        else
                                                        {
                                                            <td style="color:red;text-align:center">@item.RedMarker</td>
                                                        }
                                                        <td>@item.PaymentDeduction %</td>

                                                        <td>@item.VideoReward %</td>
                                                        @*   @if (item.PaymentComplianceCount > 0)
                                                    { *@
                                                        <td class="text-center"><a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="PaymentComplianceDetails('@item.Interviewid')">@item.PaymentComplianceCount</a></td>
                                                        @*  }
                                                    else
                                                    {
                                                    <td class="text-center">0</td>
                                                    }  *@
                                                        <td class="text-center"><a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="TotalPaymentComplianceDetails('@item.Interviewid')">@item.TotalPaymentComplianceCount</a></td>
                                                        <td>@item.ChannelOwner</td>
                                                        <td>@item.CreatedBy</td>
                                                        <td>@item.CreatedOn</td>
                                                        @if (ViewBag.actionstatus == "SLACompleted")
                                                        {
                                                            if (item.isapproved == 1)
                                                            {
                                                                <td>Approved</td>
                                                            }
                                                            else if (item.isapproved == 2)
                                                            {
                                                                <td>Not Approved</td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            if (item.QCStatus)
                                                            {
                                                                <td>Completed</td>
                                                            }
                                                            else
                                                            {
                                                                <td>Pending</td>
                                                            }
                                                        }
                                                        @if (item.Redflags > 0)
                                                        {
                                                            <td class="text-center"><a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="GetRedFlagsModal('@item.Interviewid')">@item.Redflags</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center">0</td>
                                                        }
                                                        @if (ViewBag.actionstatus != "SLACompleted")
                                                        {
                                                            <td>
                                                                <span>
                                                                    <a style="width:25px;height:25px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;margin-right:5px;" onclick="ProxyFormDetails('@item.Interviewid',true,'PaymentSLA','@(ViewBag.actionstatus ?? "")',@(ViewBag.ReturnBack != null ? ViewBag.ReturnBack : 0))">
                                                                        <button type="button" class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Proxy Form" style=" position: relative; top: -1px;">
                                                                            <i style="font-size: 16px; position: relative; top: -1px;" class="fa fa-wpforms"></i>
                                                                        </button>
                                                                    </a>
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(item.interviewer))
                                                                {
                                                                    <span>
                                                                        <button class="mdc-fab app-fab--absolute " aria-label="Suspicious Interviwer">
                                                                            <span onclick="javascript:SuspiciousTypeDetails('@item.interviewer');" title="Suspicious Interviwer" class="mdc-fab__icon touch"><img width="17" src="/img/suspicious.png" /></span>
                                                                        </button>
                                                                    </span>
                                                                }

                                                                 @if(item.IsAIInterview)
                                                                        {
                                                                            <span class="interview_9">
                                                                                <a style="text-decoration:none" target="_blank" href='@Url.Action("Report", "AIInterview" , new { seId = item.SessionId})'>
                                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Report" style="position:relative;top:-3px;">
                                                                                <span>
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                                                        <!-- Report/document shape -->
                                                                                        <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                                                                        <path d="M15 2v5h5"></path>

                                                                                        <!-- Brain-like AI/circuit element -->
                                                                                        <path d="M10 12c0-1 .5-2 2-2s2 1 2 2-.5 2-2 2-2-1-2-2z"></path>
                                                                                        <line x1="12" y1="10" x2="12" y2="8"></line>
                                                                                        <line x1="12" y1="14" x2="12" y2="16"></line>
                                                                                        <line x1="10" y1="12" x2="8" y2="12"></line>
                                                                                        <line x1="14" y1="12" x2="16" y2="12"></line>

                                                                                        <!-- Text lines on report -->
                                                                                        <line x1="7" y1="18" x2="17" y2="18"></line>
                                                                                    </svg>
                                                                                </span>
                                                                                    </button>
                                                                                </a>
                                                                            </span> //Remember : Change the report icon for an ai interview report. A normal report and an AI report should be identifiable by their distinct icons.
                                                                        }
                                                                        else{

                                                                <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.Interviewid, irfId=item.irfIntId})">
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Client Interview Report">
                                                                        <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                    </button>
                                                                </a>
                                                                        }
                                                                <a style="text-decoration:none;" target="_blank" href="@Url.Action("QCMergedAIDetails", "Interview", new { interviewId = item.Interviewid })">
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Payment Deduction Reasoning" style="position:relative;top:-2px;">
                                                                        <span title="Payment Deduction Reasoning" class="mdc-fab__icon material-icons">
                                                                            <i class="fas fa-code-branch" style="color: rgb(255, 255, 255);font-size: 16px;"></i>
                                                                        </span>
                                                                    </button>
                                                                </a>
                                                                <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Payment SLA">
                                                                    <div onclick="PaymentSLADetails('@item.Interviewid','@item.candidateEmail','@item.Interviewer',true,'PaymentSLA',false)" title="Palyment SLA" class="mdc-fab__icon material-icons">
                                                                        <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg>
                                                                    </div>
                                                                </button>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                }
                            </div>
                            <!-- end content-->
                        </div>
                        <!-- end col-md-12 -->
                    </div>
                    <!-- end row -->
                </div>
            </div>
        </div>
    </div>
</div>


<div id="IRFSkillModel" class="modal modal-bg" style="z-index:3">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Tech Skills <span class="popup-text" id="skill_id_pop"></span></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeIRFSkillModel()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <input type="text" hidden id="txtinterviewid" />
            <div class="modal-body">
                <div style="padding:10px" id="divcandidateskills">
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeIRFSkillModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div id="RedFlagModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="memberHeading">Red Flag</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="RedFlagPopUp" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="RedFlagTableBody">
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
@await Html.PartialAsync("~/Views/Common/_ProxyForm.cshtml")
@await Html.PartialAsync("~/Views/Common/_PaymentSLA.cshtml")
@await Html.PartialAsync("~/Views/Interviewer/_SuspiciousInterviewer.cshtml")
@await Html.PartialAsync("~/Views/Common/_InterviewerInsights.cshtml")
