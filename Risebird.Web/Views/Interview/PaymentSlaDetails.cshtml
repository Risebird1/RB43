@model IEnumerable<Risebird.Entities.ViewModel.PaymentSLAVM>

@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "911 Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    var slaActionTab = ViewBag.actionstatus as string ?? "";
    var embeddedSingleInterview = ViewBag.EmbeddedSingleInterview == true;
}
<input type="hidden" value="@ViewBag.actionstatus" id="hidactionstatus" />
<input type="hidden" value="@ViewBag.returnBack" id="hidreturnBack" />
@if (HttpContextAccessor.HttpContext.Session.GetString("PaymentSlaDetailsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<SkillChannelDetailsFilter>(HttpContextAccessor.HttpContext.Session.GetString("PaymentSlaDetailsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<style>
    /* Action column — single row of buttons, no wrapping */
    .psla-action-btns {
        display: flex;
        flex-wrap: nowrap;
        gap: 3px;
        align-items: center;
        white-space: nowrap;
    }

    .psla-action-btns .mdc-fab,
    .psla-action-btns .mdc-fab.app-fab--absolute {
        position: relative !important;
        top: 0 !important;
        width: 28px !important;
        height: 28px !important;
        min-height: 28px !important;
        flex-shrink: 0;
        margin: 0 !important;
    }

    .psla-action-btns a {
        display: inline-flex;
        text-decoration: none;
        flex-shrink: 0;
    }

    /* Payment SLA interview detail modal (layout matches SensitiveData QC detail modal) */
    #paymentSlaInterviewDetailModal .modal-dialog {
        max-width: 880px;
    }

    #paymentSlaInterviewDetailModal .qc-interview-detail-body {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    #paymentSlaInterviewDetailModal .qc-interview-detail-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap:0px 4px;
        align-items: start;
    }

        #paymentSlaInterviewDetailModal .qc-interview-detail-row.qc-interview-detail-row--two {
            grid-template-columns: repeat(2, 1fr);
        }

    #paymentSlaInterviewDetailModal .qc-interview-detail-cell {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        min-width: 0;
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 2px;
        background: #fff;
        height: 100% !important;
    }

    #paymentSlaInterviewDetailModal .qc-interview-detail-cell--multiline {
        align-items: flex-start;
        height: 42px;
    }

    #paymentSlaInterviewDetailModal .qc-interview-detail-label {
        flex: 0 0 auto;
        max-width: 60%;
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
        letter-spacing: 0.02em;
        margin-bottom: 0;
        line-height: 1.35;
    }

    #paymentSlaInterviewDetailModal .qc-interview-detail-value {
        flex: 1 1 auto;
        min-width: 0;
        font-size: 12px;
        color: #0f172a;
        line-height: 1.45;
        word-break: break-word;
        text-align: right;
    }
</style>
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> 911 Dashboard</h4></div>
                </div>
                <div class="pull-left payment-sla-tabs" style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;max-width:100%;">
                    @* <div class="@(string.IsNullOrWhiteSpace(slaActionTab) || slaActionTab == "PaymentCompliance" ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('PaymentCompliance','@ViewBag.ReturnBack')"><strong>Payment Compliance</strong></div> *@
                    @* <div class="@(slaActionTab == "RedoRequested" ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('RedoRequested','@ViewBag.ReturnBack')"><strong>Redo Requested</strong></div> *@
                    <div class="@(slaActionTab == "QCRejectPending" ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('QCRejectPending','@ViewBag.ReturnBack')"><strong>QC Reject</strong></div>
                    <div class="@(slaActionTab == "QCSelectPending" ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('QCSelectPending','@ViewBag.ReturnBack')"><strong>QC Select</strong></div>
                    <div class="@(slaActionTab == "SLACompleted" ? "feedback-tab-ac" : "feedback-tab")" onclick="Changeurldetails('SLACompleted','@ViewBag.ReturnBack')"><strong>SLA Completed</strong></div>
                </div>
                <div class="pull-right">
                    <div>
                        
                          
                        
                        <button type="button" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-toggle="modal" data-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>

                                            <form action="@Url.Action("PaymentSlaDetails","Interview",new { actionstatus=ViewBag.actionstatus, returnBack = ViewBag.returnBack })" method="post" id="form" onsubmit="return checkfilterDate();">
                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12">
                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12 pull-right">
                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>
                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>


                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <td>Skill Channel</td>
                                                    <td>Priority</td>
                                                    <td>Interview Date</td>
                                                    <td>Join Date</td>
                                                    <td>JD Skills</td>
                                                    <td>Candidate</td>
                                                    
                                                   
                                                      @*   <td>Candidate Email</td> *@
                                                    
                                                    <td>Interviewer</td>
                                                    <td>Company Name</td>
                                                    <td>Resume</td>
                                                    <td>Interviewer Call</td>
                                                    <td>Red Marker</td>
                                                    <td>Payment Deduction</td>
                                                    <td>Payment Compliance</td>
                                                    <td>Payment Compliance History</td>
                                                    <td>Channel Owner</td>
                                                    <td>Created By</td>
                                                    <td>Created Date</td>
                                                    @if (ViewBag.actionstatus == "SLACompleted" && !embeddedSingleInterview)
                                                    {
                                                        <td>Status</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Non AI Reasoning</td>
                                                        <td>Risk Category</td>
                                                        <td>QC Status</td>
                                                    }
                                                    @* <td>QC RedFlags</td> *@
                                                    @if (ViewBag.actionstatus != "SLACompleted" || embeddedSingleInterview)
                                                    {
                                                        <td style="min-width:320px;">Action</td>
                                                    }
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <td>Skill Channel</td>
                                                    <td>Priority</td>
                                                    <td>Interview Date</td>
                                                    <td>Join Date</td>
                                                    <td>JD Skills</td>
                                                    <td>Candidate</td>
                                                      @*   <td>Candidate Email</td> *@
                                                    <td>Interviewer</td>
                                                    <td>Company Name</td>
                                                    <td>Resume</td>
                                                    <td>Interviewer Call</td>
                                                    <td>Red Marker</td>
                                                    <td>Payment Deduction</td>
                                                    <td>Payment Compliance</td>
                                                    <td>Payment Compliance History</td>
                                                    <td>Channel Owner</td>
                                                    <td>Created By</td>
                                                    <td>Created Date</td>
                                                    @if (ViewBag.actionstatus == "SLACompleted" && !embeddedSingleInterview)
                                                    {
                                                        <td>Status</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Non AI Reasoning</td>
                                                        <td>Risk Category</td>
                                                        <td>QC Status</td>
                                                    }
                                                    @* <td>QC RedFlags</td> *@
                                                    @if (ViewBag.actionstatus != "SLACompleted" || embeddedSingleInterview)
                                                    {
                                                        <td>Action</td>
                                                    }
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.PriorityLevelDesc</td>
                                                        <td>@item.InterviewDate</td>
                                                        <td>@item.Joinedon</td>
                                                        <td>
                                                            <button type="button" class="clickhere_btn pull-left">
                                                                <span data-toggle="tooltip" data-placement="top" title="" onclick="openSkillpopup(@item.irfIntId)" data-original-title="Click here to add Interviewer"><font style="font-family: Roboto, sans-serif; font-size:12px;">Click Here</font></span>
                                                            </button>
                                                            <input id="skill_id_@item.irfIntId" type="hidden" value="@item.IRFId" />
                                                        </td>
                                                        <td>@item.candidateName
                                                            <br /><div style="margin-top:2px;"> <span class="call-area">
                                                                @if (!string.IsNullOrEmpty(item.CandidatePhone))
                                                                {
                                                                    <span data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.candidateName','@item.CandidatePhone','@item.candidateEmail')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="16" /></span>
                                                                }
                                                                </span><span style="font-size:14px;">@item.CandidatePhone</span>
                                                            </div>
                                                        </td>
                                                       
                                                            @* <td>@item.candidateEmail</td> *@
                                                        
                                                        <td>@item.Interviewer</td>
                                                        @if (!string.IsNullOrWhiteSpace(item.CompanyName))
                                                        {
                                                            @if (item.CompanyName.Length > 30)
                                                            {
                                                                <td style="font-size:13px; color:brown" title="@item.CompanyName">@item.CompanyName.Substring(0, 29) ....</td>
                                                            }
                                                            else
                                                            {
                                                                <td style="font-size:13px; color:brown">@item.CompanyName</td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (item.ResumeLink != null && item.ResumeLink != "")
                                                        {
                                                            <td>

                                                                <a style="background:none!important;border:0px!important; text-decoration: underline; color: #039BE5!important;padding:0px;" id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink><img style="position:relative;left:-5px;width:17px" src="/img/resume-icon.png" width="21"><span style="font-size:13px;">Resume</span></a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }
                                                        <td class="text-center flex-w">
                                                            <span class="call-area">
                                                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                {
                                                                    <span data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.InterviewerName','@item.MobileNumber','@item.Interviewer')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="16" /></span>
                                                                }
                                                            </span>@item.MobileNumber
                                                        </td>
                                                        @if (item.Interviewer != null || item.Interviewer != "")
                                                        {
                                                            <td style="color:red;text-align:center"><d onclick="InsightsDetails('@item.Interviewer')" style="cursor:pointer">@item.RedMarker</d></td>
                                                        }
                                                        else
                                                        {
                                                            <td style="color:red;text-align:center">@item.RedMarker</td>
                                                        }
                                                        <td>@item.PaymentDeduction %</td>

                                                        @*   @if (item.PaymentComplianceCount > 0)
                                                    { *@
                                                        <td class="text-center"><a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="PaymentComplianceDetails('@item.Interviewid')">@item.PaymentComplianceCount</a></td>
                                                        @*  }
                                                    else
                                                    {
                                                    <td class="text-center">0</td>
                                                    }  *@
                                                        <td class="text-center"><a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="TotalPaymentComplianceDetails('@item.Interviewid')">@item.TotalPaymentComplianceCount</a></td>
                                                        <td>@item.ChannelOwner</td>
                                                        <td>@item.CreatedBy</td>
                                                        <td>@item.CreatedOn</td>
                                                        @if (ViewBag.actionstatus == "SLACompleted" && !embeddedSingleInterview)
                                                        {
                                                            if (item.isapproved == 1)
                                                            {
                                                                <td>Approved</td>
                                                            }
                                                            else if (item.isapproved == 2)
                                                            {
                                                                <td>Not Approved</td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td>@item.NonAIreasoning</td>
                                                            <td>@item.Riskcategory</td>
                                                            if (item.QCStatus)
                                                            {
                                                                <td>Completed</td>
                                                            }
                                                            else
                                                            {
                                                                <td>Pending</td>
                                                            }
                                                        }
                                                       @*  @if (item.Redflags > 0)
                                                        {
                                                            <td class="text-center"><a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="GetRedFlagsModal('@item.Interviewid')">@item.Redflags</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center">0</td>
                                                        } *@
                                                        @if (ViewBag.actionstatus != "SLACompleted" || embeddedSingleInterview)
                                                        {
                                                            <td>
                                                                <div class="psla-action-btns">
                                                                    <button type="button" class="mdc-fab app-fab--absolute" aria-label="Interview details" title="Interview details" onclick="openPaymentSlaInterviewDetailModal(@item.Interviewid);">
                                                                        <span class="mdc-fab__icon touch"><i class="fas fa-info-circle" style="font-size:14px;" aria-hidden="true"></i></span>
                                                                    </button>

                                                                    <button type="button" class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Proxy Form" title="Proxy Form" onclick="ProxyFormDetails('@item.Interviewid',true,'PaymentSLA','@(ViewBag.actionstatus ?? "")',@(ViewBag.ReturnBack != null ? ViewBag.ReturnBack : 0))">
                                                                        <span class="mdc-fab__icon touch"><i style="font-size:14px;" class="fa fa-wpforms"></i></span>
                                                                    </button>

                                                                    @if (!string.IsNullOrWhiteSpace(item.Interviewer))
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Suspicious Interviewer" title="Suspicious Interviewer" onclick="javascript:SuspiciousTypeDetails('@item.Interviewer');">
                                                                            <span class="mdc-fab__icon touch"><img width="15" src="/img/suspicious.png" /></span>
                                                                        </button>
                                                                    }

                                                                    @if (item.IsAIInterview)
                                                                    {
                                                                        <a target="_blank" href='@Url.Action("Report", "AIInterview", new { seId = item.SessionId })'>
                                                                            <button class="mdc-fab app-fab--absolute" aria-label="AI Interview Report" title="AI Interview Report">
                                                                                <span class="mdc-fab__icon">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                                                        <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                                                                        <path d="M15 2v5h5"></path>
                                                                                        <path d="M10 12c0-1 .5-2 2-2s2 1 2 2-.5 2-2 2-2-1-2-2z"></path>
                                                                                        <line x1="12" y1="10" x2="12" y2="8"></line>
                                                                                        <line x1="12" y1="14" x2="12" y2="16"></line>
                                                                                        <line x1="10" y1="12" x2="8" y2="12"></line>
                                                                                        <line x1="14" y1="12" x2="16" y2="12"></line>
                                                                                        <line x1="7" y1="18" x2="17" y2="18"></line>
                                                                                    </svg>
                                                                                </span>
                                                                            </button>
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <a target="_blank" href="@Url.Action("ClientReport", "Interview", new { interviewId = item.Interviewid, irfId = item.irfIntId })">
                                                                            <button class="mdc-fab app-fab--absolute" aria-label="Client Interview Report" title="Client Interview Report">
                                                                                <span class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                            </button>
                                                                        </a>
                                                                    }

                                                                    <a target="_blank" href="@Url.Action("QCMergedAIDetails", "Interview", new { interviewId = item.Interviewid })">
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Payment Deduction Reasoning" title="Payment Deduction Reasoning">
                                                                            <span class="mdc-fab__icon material-icons"><i class="fas fa-code-branch" style="color:#fff;font-size:14px;"></i></span>
                                                                        </button>
                                                                    </a>

                                                                    <a target="_blank" href="@Url.Action("ContradictionReport", "Interview", new { interviewId = item.Interviewid })">
                                                                        <button type="button" class="mdc-fab app-fab--absolute" aria-label="Contradiction Report" title="Contradiction Report">
                                                                            <span class="mdc-fab__icon material-icons"><i class="fas fa-not-equal" style="color:#fff;font-size:14px;"></i></span>
                                                                        </button>
                                                                    </a>

                                                                    <a target="_blank" href="@Url.Action("ReportAIDetailsReport", "Interview", new { interviewId = item.Interviewid })">
                                                                        <button type="button" class="mdc-fab app-fab--absolute" aria-label="Report AI Details" title="Report AI Details">
                                                                            <span class="mdc-fab__icon material-icons"><i class="fas fa-file-alt" style="color:#fff;font-size:14px;"></i></span>
                                                                        </button>
                                                                    </a>

                                                                    <a target="_blank" href="@Url.Action("TranscritAiDetailsReport", "Interview", new { interviewId = item.Interviewid })">
                                                                        <button type="button" class="mdc-fab app-fab--absolute" aria-label="Transcript AI Details" title="Transcript AI Details">
                                                                            <span class="mdc-fab__icon material-icons"><i class="fas fa-align-left" style="color:#fff;font-size:14px;"></i></span>
                                                                        </button>
                                                                    </a>

                                                                    <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Payment SLA" title="Payment SLA">
                                                                        <div onclick="PaymentSLADetails('@item.Interviewid','@item.candidateEmail','@item.Interviewer',true,'PaymentSLA',false)" class="mdc-fab__icon material-icons">
                                                                            <svg style="color:white" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"><path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path><path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path></svg>
                                                                        </div>
                                                                    </button>

