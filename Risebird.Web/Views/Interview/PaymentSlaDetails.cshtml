<script>
    function RefreshSearch() {
        var sel = $('#meetingTableQc').length ? '#meetingTableQc' : '#meetingTable';
        $(sel).DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        var tbl = $('#meetingTableQc').length ? '#meetingTableQc' : '#meetingTable';
        $(tbl).DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter input:eq(0)").after("<span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingTable").show();
            $("#meetingTableQc").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
    function openSkillpopup(id) {
        $.ajax({
            type: "POST",
            url: "/IRF/FetchSkillDetails",
            data: { id: id },
            success: function (data) {
                var modal = document.getElementById("IRFSkillModel");
                var skill_id_pop = $("#skill_id_" + id).val();
                $("#skill_id_pop").text(skill_id_pop);
                modal.style.display = "block";
                bindSkillData(data);
            }
        });
    }
    function closeIRFSkillModel() {
        var model = document.getElementById("IRFSkillModel");
        model.style.display = "none";
    }
    function bindSkillData(data) {
        var html = '';
        html += ' <div class="table-responsive scrollbar style-2" style="overflow-x:scroll"><table class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">';
        html += '  <thead>';
        html += '  <tr>';
        html += '  <th width="20%" class="table_heading">Level<span class="red">*</span></th>';
        html += '  <th width="40%" class="table_heading">Skill Name<span class="red">*</span></th>';
        html += '  <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>';
        html += '  <th width="10%" class="table_heading">Concepts <span class="red">*</span></th>';
        html += '  <th width="10%" class="table_heading">Natureofquestion <span class="red">*</span></th>';
        html += '  <th width="10%" class="table_heading">Timelimit <span class="red">*</span></th>';
        html += '  </tr>';
        html += '  </thead>';
        html += '  <tbody>';
        for (i = 0; i < data.length; i++) {
            html += '   <tr>';
            html += '  <td>' + data[i].levelName + '</td>';
            html += '  <td>' + data[i].skillName + '</td>';
            html += '  <td>' + data[i].weightage + '</td>';
            html += '  <td>' + data[i].concepts + '</td>';
            html += '  <td>' + data[i].natureofquestion + '</td>';
            if (parseInt(data[i].timelimit) > 0) {
                html += '  <td>' + data[i].timelimit + '</td>';
            } else {
                html += '<td></td>';
            }
            html += '  </tr>';
        }
        html += '</tbody>';
        html += ' </table></div>';
        $("#divcandidateskills").empty().html(html);
    }
    function Changeurldetails(type,returnBack) {
        window.location.href = "/Interview/PaymentSlaDetails?actionstatus=" + encodeURIComponent(type || '') + "&returnBack=" + returnBack;
    }
    function ChangePaymentSlaQcTab(qcTab) {
        var actionstatus = $("#hidactionstatus").val() || '';
        var returnBack = $("#hidreturnBack").val() || '0';
        var url = "/Interview/PaymentSlaDetails?actionstatus=" + encodeURIComponent(actionstatus) + "&returnBack=" + returnBack;
        if (qcTab) {
            url += "&qcTab=" + encodeURIComponent(qcTab);
        }
        window.location.href = url;
    }
    function OpenRedoRequestFormModel(interviewid, interviewstatus, type) {
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { 'interviewid': interviewid, 'interviewstatus': interviewstatus, 'type': type },
            success: function (data) {
                $('#divredoRequestInterview').html('');
                $('#divredoRequestInterview').html(data);
                openRedoRequestInterviewModel();
            }
        });
    }
    function openRedoRequestInterviewModel() {
        var modal = document.getElementById("RedoRequestInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoRequestInterviewModel() {
        var modal = document.getElementById("RedoRequestInterviewModel");
        modal.style.display = "none";
    }
</script>
<script>
    var closeRedFlag = document.getElementById("RedFlagPopUp");
    closeRedFlag.onclick = function () {
        var modal = document.getElementById("RedFlagModal");
        modal.style.display = "none";
    }
    function GetRedFlagsModal(Interviewid) {
        $.ajax({
            url: '/DashBoard/GetRedFlagsQCReport',
            data: { 'Interviewid': Interviewid },
            success: function (data) {
                var modal = document.getElementById("RedFlagModal");
                modal.style.display = "block";
                $('#RedFlagTableBody').html('');
                $('#RedFlagTableBody').html(data);
            }
        });
    }
</script>
<script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>

<script type="text/javascript">
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }
    });


    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);

        var form = $("#form").serialize();
    }
    function ResetFilter() {
        var actionstatus = $("#hidactionstatus").val();
        var returnBack = $("#hidreturnBack").val();
        var qcTab = $("#hidqcTab").val() || '';
        var url = "/Interview/ResetPaymentSlaDetailsFilter?actionstatus=" + encodeURIComponent(actionstatus || '') + "&returnBack=" + returnBack;
        if (qcTab) {
            url += "&qcTab=" + encodeURIComponent(qcTab);
        }
        window.location.href = url;
    }
</script>
