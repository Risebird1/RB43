                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.InterviewerComment, htmlAttributes: new { @class = "col-md-2 col-form-label" })
                                        <div class="col-md-6 col-sm-6">
                                            @Html.EditorFor(model => model.InterviewerComment, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.InterviewerComment, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    @*<div class="form-group">*@
                                    @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6">
                                        @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control" })
                                        @{
                                            if (Model.AudioLink != null)
                                            {
                                                <a id="audioId" target="_blank" title="Audio" href=@Model.AudioLink.ToString().Replace(" ","%20")>Uploaded Audio</a>
                                            }
                                        }



                                    </div>
                                    @*</div>*@
                                    @*<div class="form-group">*@
                                    @Html.LabelFor(model => model.VideoFile, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6">
