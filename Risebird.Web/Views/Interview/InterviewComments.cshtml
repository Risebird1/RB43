@model Risebird.Entities.Data.InterviewComments
@{
    ViewData["Title"] = "InterviewComments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ul class="breadcrumb">
    <li><a href="/Interview/Index">Interview</a></li>
    <li class="active"><strong>InterviewComments</strong></li>
</ul>

@using (Html.BeginForm("AddComments", "Interview", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

@Html.AntiForgeryToken()
<div class="row">
    <div class="col-md-12 edit-build nova-cont">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h2 class="panel-title">Interview Comments</h2>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model=>model.InterviewId)
                            <div class="multiple_row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Interviewer Action</h2>
                                    </div><!--end of multiple location-->
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.InterviewStatusList, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(x => Model.InterviewStatus, Model.InterviewStatusList, "Select Profile", htmlAttributes: new { @class = "form-control webkitEnabled" })
                                        @Html.ValidationMessageFor(model => model.InterviewStatus, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.InterviewerComment, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6 col-sm-6">
                                        @Html.EditorFor(model => model.InterviewerComment, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.InterviewerComment, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="multiple_row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>HR Action</h2>
                                    </div><!--end of multiple location-->
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.FraudCheckStatusList, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(x => Model.FraudCheckStatus, Model.FraudCheckStatusList, "Select Profile", htmlAttributes: new { @class = "form-control webkitEnabled" })
                                        @Html.ValidationMessageFor(model => model.FraudCheckStatus, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.HRComment, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6 col-sm-6">
                                        @Html.EditorFor(model => model.HRComment, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.HRComment, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="multiple_row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Quality Controller Action</h2>
                                    </div><!--end of multiple location-->
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.QCStatusList, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(x => Model.QCStatus, Model.QCStatusList, "Select Profile", htmlAttributes: new { @class = "form-control webkitEnabled" })
                                        @Html.ValidationMessageFor(model => model.QCStatus, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.QCComment, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6 col-sm-6">
                                        @Html.EditorFor(model => model.QCComment, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.QCComment, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="multiple_row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Trainer Action</h2>
                                    </div><!--end of multiple location-->
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.TrainingStatusList, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6">
                                        @Html.DropDownListFor(x => Model.TrainingStatus, Model.TrainingStatusList, "Select Profile", htmlAttributes: new { @class = "form-control webkitEnabled" })
                                        @Html.ValidationMessageFor(model => model.TrainingStatus, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.TrainerComment, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6 col-sm-6">
                                        @Html.EditorFor(model => model.TrainerComment, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.TrainerComment, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-12">
                                <div class="pull-right">
                                    <input type="submit" id="btnUpload" value="Update Comments" class="btn btn btn-primary" />
                                </div>
                                @*<div>
                @Html.ActionLink("Back to List", "Index", "User", new { @class = "btn btn-link" })
            </div>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}

<style>
    .fa-spinner {
        font-size: 18px;
        position: relative;
        top: 6px;
        left: 4px;
    }
    .webkitEnabled {
        -webkit-appearance: menulist;
    }
  
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }
</style>


