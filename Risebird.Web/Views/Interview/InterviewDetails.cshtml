            html += '  <td>' + data[i].skillName + '</td>';
            html += '  <td>' + data[i].comment + '</td>';
            html += '  </tr>';
        }
        html += '</tbody>';
        html += ' </table></div>';
        $("#divquestionslist").empty().html(html);
    }
</script>
