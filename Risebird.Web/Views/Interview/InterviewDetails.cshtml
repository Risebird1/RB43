@model Risebird.Entities.Data.Meeting

@{
    ViewData["Title"] = "Interviews Detail";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<meta name="viewport" content="width=device-width" />
<title>InterviewDetails</title>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css?v=2024'>
<script>
    var Header = "<div id='myinterview_1'> Interview Details</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<input type="hidden" value="@ViewBag.id" id="id" />
<input type="hidden" value="@ViewBag.InterviewId" id="hidinterviewid" />

<div class="interviewWrapper">

    <div class="col-md-12 pull-left pad10" style="padding-bottom:0px;padding-top:0px;">
        <div class="heading-txt">
            Review the below client instructions to get the meeting link<br />
            @if (Model.IsVideoRequired == true)
            {
                <div class="video-onmsg"><svg class="blink" style="color: #e12f2f;width: 28px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18 16v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-5 0h-2v-2h2v2zm0-4h-2V8h2v4zm-1 10c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2z" fill="#e12f2f"></path></svg> Important Notice: Interview requires mandatory Video On of the interivewer</div>
            }

            <span style="font-weight:normal; color: #8b8bcd;font-size: 18px; line-height: 36px;">Always Use Virtual Background while keeping your Video On</span>
        </div>


        @if (Model.zoomLink != null && Model.zoomLink != "")
        {
            @*  @if (Model.interviewDate.AddMinutes(-10) <= DateTime.Now && Model.interviewDate.AddMinutes(60) >= DateTime.Now)
        {*@
            <div>
                <a style="float: none;margin: 0px auto 20px auto;width: 245px;" target="_blank" id="join-button" class="join-button" onclick="CaptureMeetingOpenTime('@ViewBag.InterviewId')" title="Meeting Link" href=@Model.zoomLink>Join Zoom Meeting now</a>
            </div>
            @*}*@
            @*  else
        {
        <div>Before 10 min only</div>
        }  *@
        }
        <div class="card" style="margin-bottom:10px;">

            <label class="question note-card" for="checkbox_two">
                <label for="checkbox_two" class="consent-label" style="position:relative;">
                    <i class="fa fa-cogs" aria-hidden="true"></i>


                    Tech Skills
                    @if (Model.Heuristicsscore == 6)
                    {
                        <span id="techskills-note-txt"><label style="font-size:12.2px;color:#929c9c;text-transform: none;margin:0px; padding: 0px;font-weight: 400;">(This is a muktistack interview where <b style="color:#dd1f1f;">50-60 mins</b> have to be allocated to evaluate primary stack skills and remaining <b style="color:#dd1f1f;">30-40 mins</b> have to be allocated to evaluate secondary stack skills)</label></span>
                    }
                    // plan type MultiStack[s]//
                    else if (Model.Heuristicsscore == 8)
                    {
                        <span id="techskills-note-txt"><label style="font-size:12.2px;color:#929c9c;text-transform: none;margin:0px; padding: 0px;font-weight: 400;">(This is a muktistack interview where <b style="color:#dd1f1f;">40-45 mins</b> have to be allocated to evaluate primary stack skills and remaining <b style="color:#dd1f1f;">20-25 mins</b> have to be allocated to evaluate secondary stack skills)</label></span>
                    }
                    // plan type MultiStack[M]//
                    else if (Model.Heuristicsscore == 7)
                    {
                        <span id="techskills-note-txt"><label style="font-size:12.2px;color:#929c9c;text-transform: none;margin:0px; padding: 0px;font-weight: 400;">(This is a muktistack interview where <b style="color:#dd1f1f;">50-55 mins</b> have to be allocated to evaluate primary stack skills and remaining <b style="color:#dd1f1f;">25-30 mins</b> have to be allocated to evaluate secondary stack skills)</label></span>
                    }
                </label>
                <span class="round">
                    <input style="visibility:hidden" type="checkbox" class="coupon_question trigger" id="checkbox_two" name="question1" data-trigger="hidden_fields_two" />
                    <label style="visibility:hidden" for="checkbox_two"></label>

                    <input type="checkbox" class="coupon_question" disabled id="hidden_fields_two_1" name="Checkshow" checked />
                    <label for="hidden_fields_two_1"></label>
                    <span id="hidden_fields_two_1" class="expand-panel"><i class='fas fa-chevron-up'></i> </span>

                    <span id="hidden_fields_two_1" class="collapsible-panel"><i class='fas fa-chevron-up'></i></span>

                </span>
            </label>

            <fieldset class="answer hidden show-default" id="hidden_fields_two">
                <div class="answer-label"></div>
                <div id="techskills"></div>
            </fieldset>

        </div>
    </div>
