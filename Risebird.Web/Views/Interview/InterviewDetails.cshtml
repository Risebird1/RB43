<script src="~/js/TwilioCallMaker.js?v=2024"></script>
<script>
    function closePopupDetailsModal() {
        var modal = document.getElementById("PopupDetailsModal");
        modal.style.display = "none";
    }
    function openPopupDetailsModal() {
        var modal = document.getElementById("PopupDetailsModal");
        modal.style.display = "block";
    }
    function OpenCodeModal(interviewid, irfid) {
        $("#changememberHeading").text('Code Snippet');
        $.ajax({
            url: '/IRF/InterviewCodeSnippet',
            data: { id: interviewid, irfid: irfid },
            success: function (data) {
                openPopupDetailsModal();
                $('#divpopupModel').html('');
                $('#divpopupModel').html(data);
            }
        });
    }
    function FetchCodesnippet() {
        var interviewid = $("#hidinterviewid").val();
        $.ajax({
            type: "POST",
            url: '/IRF/GetCodeSnippet',
            data: { interviewid: interviewid },
            success: function (data) {
                BindCodeSnippet(data);
            }
        });
    }
    function BindCodeSnippet(data) {
        var html = '';
        if (data != null) {
            html += '<iframe src="' + data + '"></iframe>';
        }
        $("#divcodesnippets").empty().html(html);
    }
</script>

