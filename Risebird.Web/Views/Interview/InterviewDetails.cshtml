    function GetInstruction(){
         var irfId = $("#id").val();
        $.ajax({
            url: '/IRF/GetTextInstruction',
            data: { 'irfId': irfId },
            type: "POST",
            success: function (data) {
                let text = "";
                text += "<ui>";
                for (let i = 0; i < data.length; i++) {
                    text += "<li>" + data[i].message + "</li>";
                }
                text += "</ui>";
                $('#lblComments').empty().html(text);
            }
        });
    }


     function CountCheckBox() {
