@model IEnumerable<Risebird.Entities.Data.Meeting>
@{
    ViewData["Title"] = "QC Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>

            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">QC Interviews</h4>
                    </div>
                    <div class="card-body">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="dataloading">
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <table id="QCInterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>

                                            <th>Date</th>
                                            <th>Duration</th>
                                            <th>Candidate Email</th>
                                            <th>Primary Skills</th>
                                            <th>Resume</th>
                                            <th>JD Link</th>
                                            <th>Risebird HR</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>Date</th>
                                            <th>Duration</th>
                                            <th>Candidate Email</th>
                                            <th>Primary Skills</th>
                                            <th>Resume</th>
                                            <th>JD Link</th>
                                            <th>Risebird HR</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr id=@item.id>
                                                <td> @item.interviewDate </td>
                                                <td> @item.interviewDuration </td>
                                                <td> @item.candidateEmail</td>
                                                <td></td>
@*                                                <td> @item.primaryskill</td>
*@                                                @if (item.resumeLink != null && item.resumeLink != "")
                                                {
                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                }
                                                else
                                                {
                                                    <td>No Resume</td>
                                                }
                                                @if (item.JDLink != null && item.JDLink != "")
                                                {
                                                    <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                }
                                                else
                                                {
                                                    <td>No JD</td>
                                                }

                                                <td> @item.risebirdHR</td>
                                                <td class="text-right">
                                                    <span onclick="location.href = '@Url.Action("AddComments", "Interview", new { interviewId = item.id})'" title="Comments" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-comment"></i></span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

<script>
    $(document).ready(function () {
        $('#QCInterviewList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#QCInterviewList').DataTable();
    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#QCInterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#QCInterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#QCInterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>




<!-- Keep the Page Content Here.-->


<loading></loading>
@if (ViewBag.Message != null && ViewBag.Message.Contains("successfully"))
{
    <script type="text/javascript">
        window.onload = function ()
        {
            sweetAlert({
                title: "Risebird Notification",
                text:'@ViewBag.Message',
                type: "success"
            });
        };
    </script>
}
@if (ViewBag.Message != null && (ViewBag.Message.Contains("Failed")))
{
    <script type="text/javascript">
        window.onload = function ()
        {
            sweetAlert({
                title: "Risebird Notification",
                text: '@ViewBag.Message',
                type: "error"
            });
        };
    </script>
}
