@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>

@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />

<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Get Client Filtered Meeting</a>
            </div>
        </div>
    </nav>
    <div class="mt50">
    </div>

    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <table id="meeting" class="table table-striped table-bordered " cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>Project Name</th>
                                                <th>Primary Skill</th>
                                                <th>Report Link</th>
                                                <th>Video</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Salary</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>Project Name</th>
                                                <th>Primary Skill</th>
                                                <th>Report Link</th>
                                                <th>Video</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Salary</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.imid>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.candidateName </td>
                                                    <td> @item.ClientHrContact </td>
                                                    <td> @item.ClientName </td>
                                                    <td> @item.JDTiltle.Split("|")[0] </td>
                                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.irfIntId, isClient = true})'>Report</a> </td>
                                                    @if (item.VideoLink != null && item.VideoLink != "")
                                                    {
                                                        <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Video</td>
                                                    }
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.MobileNumber != null)
                                                    {
                                                        <td>@item.MobileNumber</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No Contact</td>
                                                    }

                                                    <td> @item.confirmationStatus</td>
                                                    <td> @item.MeetingStatusStatusDesc </td>
                                                    <td> @item.intervieweStatusStatDesc </td>
                                                    <td> @item.currentEmployerName </td>
                                                    <td> @item.expectedPerHourRate </td>
                                                    <td> @item.joiningTime </td>
                                                    <td> @item.preferredLocation </td>
                                                    <td>@item.staffingAgency</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                </div>
                            </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>