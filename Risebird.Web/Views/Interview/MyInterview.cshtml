<script>
    (function () {
        if (("@(HttpContextAccessor.HttpContext.Session.GetString("profileName") ?? "")").replace(/&quot;|"/g, "").trim() !== "Interviewer") return;
        $.getJSON("/Interviewer/MyQualitySummary").done(function (res) {
            if (!res || !(res.ok || res.Ok)) return;
            var focus = Number(res.focusCount != null ? res.focusCount : res.FocusCount) || 0;
            var ded = Number(res.monthDeductionCount != null ? res.monthDeductionCount : res.MonthDeductionCount) || 0;
            var $focus = $("#myQualityFocusPill").empty();
            if (focus > 0) {
                $focus.addClass("mqc-pill--focus").append($("<b>").text(focus)).append(document.createTextNode(focus === 1 ? " thing to work on" : " things to work on"));
            } else {
                $focus.addClass("mqc-pill--ok").text("✓ Nothing stands out right now");
            }
            var $ded = $("#myQualityDeductionPill").empty();
            $ded.addClass(ded > 0 ? "mqc-pill--bad" : "mqc-pill--ok")
                .append($("<b>").text(ded)).append(document.createTextNode(ded === 1 ? " deduction this month" : " deductions this month"));
            $("#myQualityCard").addClass("is-visible");
        });
    })();
</script>
