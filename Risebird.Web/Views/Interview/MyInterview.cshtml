<script>
    startTimer();
    function startTimer() {
        var presentTime1 = document.getElementsByClassName('timer');
        var presentTab = document.getElementsByClassName('time_tab');
        for (var i = 0; i < presentTime1.length; i++) {
            var presentTime = presentTime1[i].innerHTML + ':00';
            var timeArray = presentTime.split(/[:]+/);
            var m = timeArray[0];
            var s = checkSecond((timeArray[1] - 1));
            if (s == 59) { m = m - 1 }
            if (m < 0) {
                return
            }
            if (m >= 120) {
                presentTime1[i].style.display = 'none';
                presentTab[i].style.display = 'none';
            }
            else {
                presentTime1[i].style.display = 'block';
                presentTab[i].style.display = 'block';
            }
            presentTime1[i].innerHTML = m + ":" + s;
        }
        setTimeout(startTimer, 1000);
    }

    function checkSecond(sec) {
        if (sec < 10 && sec >= 0) { sec = "0" + sec }; // add zero in front of numbers < 10
        if (sec < 0) { sec = "59" };
        return sec;
    }
    function changeinterviewnotificationstatus() {
        if (document.getElementById("chk_interviewernotifcation").checked) {
            $.ajax({
                type: "POST",
                url: "/Interview/ChangeInterviewernotificationStatus",
                data: { status: 1 },
                success: function (data) {
                }
            });
        } else {
            $.ajax({
                type: "POST",
                url: "/Interview/ChangeInterviewernotificationStatus",
                data: { status: 0 },
                success: function (data) {
                }
            });
        }
    }
    function closeInterviewerNotificationModel() {
        var model = document.getElementById("InterviewerNotificationModel");
        model.style.display = "none";
    }
    function openInterviewerNotificationModel() {
        var model = document.getElementById("InterviewerNotificationModel");
        model.style.display = "block";
    }
    //function closeCodedResumeNotificationModel() {
    //    var model = document.getElementById("CodedResumeNotificationModel");
    //    model.style.display = "none";
    //}
    //function openCodedResumeNotificationModel() {
    //    var model = document.getElementById("CodedResumeNotificationModel");
    //    model.style.display = "block";
    //}
</script>
