<script>
    var actionclick = 1;
    function captureclick(type, buttonaction, interviewid) {
        var currenturl = window.location.href;
        if (actionclick == 1) {
            actionclick = 0;
            $.ajax({
                url: '/ActivityTracker/CapturePageClick',
                method: 'POST',
                async: true,
                data: {
                    'type': type,
                    'currenturl': currenturl,
                    'buttonaction': buttonaction,
                    'interviewid': interviewid
                },
                success: function (result) {
                    actionclick = 1;
                }
            });
        }
    }
</script>

