    function searchResultEnter(e) {
        var code = (e.keyCode ? e.keyCode : e.which);
        if (code == 13) {
            searchResult();
        }
    }
    function Changeurldetails(meetingLineUpType) {
        window.location.href = "/Interview/MyInterview?meetingLineUpType=" + meetingLineUpType;
    }
   
    function bindPages(pagecount, startpage, endpage, totalcount, meetingLineUpType) {//
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/Interview/MyInterview?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/Interview/MyInterview?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '&meetingLineUpType=' + meetingLineUpType + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/Interview/MyInterview?Page=' + pagecount + '&meetingLineUpType=' + meetingLineUpType + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/Interview/MyInterview?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '&meetingLineUpType=' + meetingLineUpType + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/Interview/MyInterview?Page=' + pagecount + '&meetingLineUpType=' + meetingLineUpType + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>
