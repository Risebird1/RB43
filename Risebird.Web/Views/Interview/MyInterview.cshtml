@model IEnumerable<Risebird.Entities.Data.Meeting>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using System.Text.RegularExpressions
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "My Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] InterviewSlot = new string[] { };
    string[] CandidateName = new string[] { };
    string[] RisebirdHR = new string[] { };
    string[] InterviewDate = new string[] { };
    string[] JobLevel = new string[] { };
    //string[] InterviewDuration = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("MyInterviewfilters") != null)
{
    filter = JsonConvert.DeserializeObject<MyInterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("MyInterviewfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    InterviewSlot = filter.InterviewSlot != null ? filter.InterviewSlot : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
    RisebirdHR = filter.RisebirdHR != null ? filter.RisebirdHR : new string[] { };
    InterviewDate = filter.InterviewDate != null ? filter.InterviewDate : new string[] { };
    JobLevel = filter.JobLevel != null ? filter.JobLevel : new string[] { };

    //InterviewDuration = filter.InterviewDuration != null ? filter.InterviewDuration : new string[] { };
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    My Interviews
                </a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> My Interviews</h4></div>
                </div>

                <div class="pull-right">
                    <div>


                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded first card-title-space" data-toggle="modal" data-target="#filterModal">

                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>


                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-life-ring" data-toggle="tooltip" data-placement="top" title="Support" onclick="location.href='@Url.Action("Index", "Support", new { controllerName = "Interview", actMethod ="MyInterview" } )'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Support</font></span>
                        </button>
                        <i type="submit" class="fa fa-file-excel-o excel-file card-title-space" style="margin-right:10px;float:right;margin-left:3px;color:green;font-size: 35px;" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("MyInterviewsExporttoExcel", "Interview")'"></i>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client ">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">

                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>


                                        <form action="@Url.Action("MyInterview","Interview")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control" onblur="checkStartDate(this.value)">
                                                            </div>
                                                            <label class="text-danger col-md-6 col-sm-6" id="startDateCheck" style="display:none;"></label>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control" onblur="checkEndDate(this.value)">
                                                            </div>
                                                            <label class="text-danger col-md-6 col-sm-6" id="endDateCheck" style="display:none;"></label>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Slot</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewSlot" name="InterviewSlot" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.interviewSlot).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                Interview Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewDate" name="InterviewDate" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDate).Distinct().ToList())
                                                                    {
                                                                        @if (item != null)
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="JobLevel">
                                                                Job Level
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="JobLevel" name="JobLevel" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.JobLevelDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                Candidate Name
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                Zoom ID
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="RisebirdHR" name="RisebirdHR" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.risebirdHR).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">



                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>


                                                                    <button id="submitFilter" type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>
                                                                </div>

                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID" class="second">
                                    <table id="MyInterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th style="text-align:center">Call Candidate</th>
                                                <th style="text-align:center">Call Coordinating HR</th>
                                                <th>Duration</th>
                                                <th>Job Level</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Company Detail</th>
                                                <th>Zoom ID</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Co-ordinating HR</th>
                                                <th class="disabled-sorting text-right">Actions</th>

                                            </tr>

                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Date</th>
                                                <th style="text-align:center">Call Candidate</th>
                                                <th style="text-align:center">Call Coordinating HR</th>
                                                <th>Duration</th>
                                                <th>Job Level</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Company Detail</th>
                                                <th>Zoom ID</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Co-ordinating HR</th>
                                                <th class="disabled-sorting text-right">Actions</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>


                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                <tr id=@item.id>
                                                    <td> @item.interviewDate </td>
                                                    <td class="callcandidatebtn" style="text-align:center">
                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty && DateTime.Now.AddMinutes(-5) <= item.interviewDate && item.interviewDate <= DateTime.Now.AddMinutes(65))
                                                        {

                                                            <button class="mdc-fab app-fab--absolute" aria-label="Click here to call the candidate.">
                                                                <span onclick="ModalButtonClick('@item.candidateName','@item.MobileNumber')" data-original-title="Tooltip on top" title="Click here to call the candidate." class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg></span>
                                                            </button>


                                                        }

                                                    </td>
                                                    <td style="text-align:center">
                                                        @if (item.HRMobileNumber != null && item.HRMobileNumber != string.Empty && DateTime.Now.AddMinutes(-5) <= item.interviewDate && item.interviewDate <= DateTime.Now.AddMinutes(65))
                                                        {

                                                            <button class="mdc-fab app-fab--absolute" aria-label="Click here to call the candidate.">
                                                                <span onclick="ModalButtonClick('@item.HRCoordinatorEmailId','@item.HRMobileNumber')" data-original-title="Tooltip on top" title="Click here to call the candidate." class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg></span>
                                                            </button>


                                                        }

                                                    </td>

                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.JobLevelDesc </td>
                                                    @if (item.IsOnilne == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.candidateEmail')"> @item.candidateName   <span class="dot" style="background-color:green"></span></a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @item.candidateName
                                                        </td>
                                                    }
                                                    <td> @Regex.Replace(@item.candidateEmail, "[a-zA-Z0-9.-]", "*")</td>

                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }
                                                    @if (item.CompanyDetails != null && item.CompanyDetails != "")
                                                    {
                                                        <td>  <a id="companylinkId" target="_blank" title="Company Instructions" href=@item.CompanyDetails>Company Instructions</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Company Instructions</td>
                                                    }

                                                    <td> @item.risebirdHR</td>
                                                    <td>@item.MeetingStatusDesc</td>
                                                    <td>@item.InterviewStatusDesc</td>
                                                    <td>@item.HRCoordinatorEmailId</td>
                                                    <td class="text-right">
                                                        @if (item.interviewDate.Date >= DateTime.Now.Date)
                                                        {
                                                            <button class="mdc-fab app-fab--absolute sampleQues" aria-label="Sample Questions">
                                                                <span onclick="javascript:CheckTimeDifference('@item.id','@item.interviewDate');" title="UnAssigned Yourself" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg></span>
                                                            </button>
                                                        }

                                                        <button class="mdc-fab app-fab--absolute sampleQues" aria-label="Sample Questions">
                                                            <span onclick="location.href = '@Url.Action("SampleQuestions", "Interview", new { id = item.irfIntId })'" title="Sample Questions" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z" /></svg></span>
                                                        </button>
                                                        <button class="mdc-fab app-fab--absolute mdc-fab-secondary voicebiobtn" aria-label="Upload audio for verification">
                                                            <span onclick="location.href = '@Url.Action("VerifyMyInterviewAudio", "Interview", new { candidateId = item.CandidateMasterId, irfId = item.irfIntId, meetingId = item.id })'" title="Upload audio for verification" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 3v9.28c-.47-.17-.97-.28-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z" /></svg></span>
                                                        </button>
                                                        <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Feedback Report">
                                                            <span onclick="location.href = '@Url.Action("AddReport", "Interview", new { interviewId = item.id, irfId = item.irfIntId })'" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                        </button>


                                                    </td>

                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <div id="myModal" class="modal modal-bg">
                <!-- Modal content -->
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header" style="padding: 2px 16px;background-color: #14406e;color: white;font-size: 10px;">
                            <h5 class="modal-title" style="font-size:20px;">Call!</h5>
                            <span style="cursor:pointer;" class="close" id="callPopUp">&times;</span>
                        </div>
                        <div class="modal-body" style="padding: 2px 16px;">

                            <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>

                            <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin-left:43%" class="btn btn-fill btn-danger" value="Hang Up">

                        </div>

                    </div>

                </div>
            </div>


            <!-- end row -->
        </div>

    </div>
</div>



<script>
    var interviewUnassignedMinutes;
    $(document).ready(function () {
        $.ajax({
            type: "GET",
            url: "/Interview/GetInterviewUnassignedMinutes",
            success: function (data) {
                interviewUnassignedMinutes = data;
            }
        });


        $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        $("#InterviewSlot").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#CandidateName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#RisebirdHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#InterviewDate").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        $("#JobLevel").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $('#MyInterviewList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button style=display:none; type=button id=x>x</button>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") { $("#x").hide(); }
                    else { $("#x").show(); }
                });
            }

        });
        var table = $('#MyInterviewList').DataTable();
    });

    $(document).ready(function () {

        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });
    function ResetFilter() {

             $.ajax({
            type: "POST",
            url: "/Interview/MyInterview",
                 success: function (data) {
                    window.location.href = "/Interview/ResetMyInterviewFilter";
                 }
                });
    }
        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var InterviewSlot = @Html.Raw(Json.Serialize(InterviewSlot));
            var CandidateName =  @Html.Raw(Json.Serialize(CandidateName));
            var RisebirdHR =  @Html.Raw(Json.Serialize(RisebirdHR));
            var InterviewDate =  @Html.Raw(Json.Serialize(InterviewDate));
            var JobLevel =  @Html.Raw(Json.Serialize(JobLevel));


            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#InterviewSlot").val(InterviewSlot);
            $("#CandidateName").val(CandidateName);
            $("#RisebirdHR").val(RisebirdHR);
            $("#InterviewDate").val(InterviewDate);
            $("#JobLevel").val(JobLevel);
            //$("#InterviewDuration").val(InterviewDuration);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
            url: "/Interview/MyInterview",
            data: form,
                 success: function (data) {
                 }
