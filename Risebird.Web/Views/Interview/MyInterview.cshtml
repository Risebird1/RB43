                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#MyInterviewList').DataTable();
    });
</script>






<script type="text/javascript">

    $(".dataloading").hide();
    $(".datatable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $(".datatable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
</script>

<!-- Keep the Page Content Here.-->

<script type="text/javascript">
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $(".datatable").show();
        }, 2000);
    };
</script>
<loading></loading>
@if (ViewBag.Message != null && ViewBag.Message.Contains("successfully"))
{
    <script type="text/javascript">
        window.onload = function ()
        {
            sweetAlert({
                title: "Risebird Notification",
                text:'@ViewBag.Message',
                type: "success"
            });
        };
    </script>
}
@if (ViewBag.Message != null && (ViewBag.Message.Contains("Failed")))
{
    <script type="text/javascript">
        window.onload = function ()
        {
            sweetAlert({
                title: "Risebird Notification",
                text: '@ViewBag.Message',
                type: "error"
            });
        };
    </script>
}

<script type="text/javascript">
    function UnAssignInterviewer(meetingId) {

        var confirmMessageBox = confirm('Are you sure you wish to Unassign?');
        if (confirmMessageBox) {
            if (meetingId != '') {
                $.ajax({
                    url: '/Interview/UnassignYourself',
                    data: { 'id': meetingId },
                    type: 'get',
                    success: function (data) {
                        window.location = data.url;
                    }
                });
            }
        }
    }

</script>
