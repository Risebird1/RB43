                    var totalPage = document.getElementById('id_totalPage').innerHTML;
                    var endPage = document.getElementById('id_endPage').innerHTML;
                    var startPage = document.getElementById('id_startPage').innerHTML;
                    var totalentry = document.getElementById('id_totalentry').innerHTML;

                    //bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                    bindPages(totalPage, startPage, endPage, totalentry, '@ViewBag.MeetingLineUpType');//
