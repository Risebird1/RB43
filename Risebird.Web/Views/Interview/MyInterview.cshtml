    //}
    function GenerateBackupLink(interviewid, IRFId, clientname, irfIntId) {
        $.ajax({
            type: "POST",
            url: "/Interview/GenerateZoomMeeting",
            data: { interviewid: interviewid, IRFId: IRFId, clientname: clientname, irfIntId: irfIntId },
            success: function (data) {
                openBackUpLinkModel(data);
            }
        });
    }
    function openBackUpLinkModel(data) {
        var model = document.getElementById("BackUpLinkModel");
        model.style.display = "block";
        if (data == "FailToSet") {
            document.getElementById("special_text").style.display = "none";
            $("#txtvideoUrls").text("Due to some technical issue the interview backup link is not created and interview marked as dropped!");
        }
        else {
            $("#txtvideoUrls").text(data);
            document.getElementById("special_text").style.display = "block";
        }
    }
    function closeBackUpLinkModel() {
        var model = document.getElementById("BackUpLinkModel");
        model.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
    function CaptureMeetingOpenTime(interviewid) {
        $.ajax({
            type: "POST",
            url: "/Interview/CaptureJoinMeetingTime",
            data: { interviewid: interviewid },
            success: function (data) {

            }
        });
    }
