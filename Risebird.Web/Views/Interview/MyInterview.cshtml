    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">My Interviews</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="row">

                                    <div class="col-md-3 ml-md-auto">
                                        <div class="form-group">
                                            <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#filterModal" style="margin-top: 0px;float:right;margin-right:0px"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"> Filter</span></button>

                                            @* @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "form-control", onchange = "FilterInterviews(this.value);" })*@
                                        </div>
                                    </div>
                                    @*<div class="col-sm-9">
                                            <button type="button" class="btn btn-primary " style="margin-top: 2px;"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "Interview")'" data-original-title="Tooltip on top"> Add Interview</span></button>


                                        </div>*@
                                </div>



                            </div>
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                            <h5 class="modal-title" id="filterModalLabel">Advanced Filters</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <form action="@Url.Action("MyInterview","Interview")" method="post">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="PrimarySkill">Slot</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="InterviewSlot" name="InterviewSlot" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.interviewSlot).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="MeetingStatus">
                                                                Interview Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="InterviewDate" name="InterviewDate" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDate).Distinct().ToList())
                                                                    {
                                                                        @if (item != null)
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="Interviewer">
                                                                Candidate Name
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientHR">
                                                                Zoom ID
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="RisebirdHR" name="RisebirdHR" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.risebirdHR).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">Duration</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="InterviewDuration" name="InterviewDuration" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDuration).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <div class="col-md-6 col-sm-6">
                                                                <button type="submit" style="margin-top: 40px; float:right" class="btn btn-primary">Apply Filter</button>

                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="MyInterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Candidate Contact</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Zoom ID</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Candidate Contact</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Zoom ID</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>


                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.id>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.interviewSlot </td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.candidateName</td>
                                                    <td> @item.candidateEmail</td>
                                                    @if (item.MobileNumber != null)
                                                    {
                                                        <td>@item.MobileNumber</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No Contact</td>
                                                    }
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }

                                                    <td> @item.risebirdHR</td>
                                                    <td class="text-right">
                                                        <span onclick="javascript:UnAssignInterviewer('@item.id');" title="UnAssigned Yourself" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-remove"></i></span>
                                                        <span onclick="location.href = '@Url.Action("SampleQuestions", "Interview", new {id= item.irfIntId})'" title="Sample Questions" class="btn btn-round btn-info btn-icon btn-sm like"><i class="now-ui-icons fa fa-comments"></i></span>
                                                        <span onclick="location.href = '@Url.Action("AddReport", "Interview", new { interviewId = item.id, irfId= item.irfIntId})'" title="Feedback Report" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-file-pdf-o"></i></span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->
        </div>
        <footer class="footer">
            <div class=" container-fluid ">
                <nav>
                    <ul>
                        <li>
                            <a href="#">
                                Risebird
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                About Us
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                Blog
                            </a>
                        </li>
                    </ul>
                </nav>
                <div class="copyright" id="copyright">
                    &copy;
                    <script>
                        document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                    </script> Risebird All Rights Reserved.
                </div>
            </div>
        </footer>
    </div>
</div>



