    <div class="content client ">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">

                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>


                                        <form action="@Url.Action("MyInterview","Interview")" method="post" id="form" class="myinterview_modal">

                                            <div class="modal-body ">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control" onblur="checkStartDate(this.value)">
                                                            </div>
                                                            <label class="text-danger col-md-6 col-sm-6" id="startDateCheck" style="display:none;"></label>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control" onblur="checkEndDate(this.value)">
                                                            </div>
                                                            <label class="text-danger col-md-6 col-sm-6" id="endDateCheck" style="display:none;"></label>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Slot</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewSlot" name="InterviewSlot" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in Model.Select(x => x.interviewSlot).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                Interview Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewDate" name="InterviewDate" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDate).Distinct().ToList())
                                                                    {
                                                                        @if (item != null)
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="JobLevel">
                                                                Job Level
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="JobLevel" name="JobLevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.JobLevelDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                Candidate Name
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="CandidateName" name="CandidateName" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                Zoom ID
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="RisebirdHR" name="RisebirdHR" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.risebirdHR).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">



                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>


                                                                    <button id="submitFilter" type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>
                                                                </div>

                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <div>
                                <div class="note-meeting text-left"> <b style="color:green">Note: To join the meeting click on Meeting Link and always use your Coded Name </b><b style="color:red">(@ViewBag.CodedName)</b></div>
                                <div id="tableID" class="second">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">

                                        <div class="col-sm-12 col-md-6">

                                        </div>
                                        <div class="pull-right client-ms" style="margin:0px 10px 10px 10px;">
                                            <div id="meeting_filter" class="dataTables_filter">

                                                <div class="searchbox">
                                                    <div class="searchCon">

                                                        <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                                        <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeypress="searchResultEnter(event)" value="@ViewBag.Searchvalue">

                                                        <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                                                        @*<button style="display:none;" type="button" id="x">x</button>*@

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="MyInterviewList" class="table table-striped table-bordered dataTable" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;">Date </th>
                                                            <th style="text-align:left">Job Level</th>
                                                            <th style="text-align:left">JD-Skills</th>
                                                            <th id="myinterview_4">Candidate Name</th>
                                                            <th>Client</th>
                                                            <th>Job Location</th>
                                                            @*<th id="myinterview_5">JD Link</th>*@
                                                            <th>Instructions</th>
                                                            <th id="myinterview_6">Resume</th>
                                                            <th id="myinterview_7">Meeting Link</th>
                                                            <th>Max Interview Duration</th>
                                                            <th class="disabled-sorting text-left">Actions</th>

                                                        </tr>

                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;width:12%">Date</th>
                                                            <th>Job Level</th>
                                                            <th>JD-Skills</th>
                                                            <th>Candidate Name</th>
                                                            <th>Client</th>
                                                            <th>Job Location</th>
                                                            @*<th>JD Link</th>*@
                                                            <th>Instructions</th>
                                                            <th>Resume</th>
                                                            <th>Meeting Link</th>
                                                            <th>Max Interview Duration</th>
                                                            <th class="disabled-sorting text-left">Actions</th>

                                                        </tr>

                                                    </tfoot>
                                                    <tbody id="tblbodyMyInterview">
                                                        @if (Model.Count == 0)
                                                        {
                                                            <tr>
                                                                <td colspan="12" class="text-center">No data available in table</td>
                                                            </tr>
                                                        }

                                                        @foreach (var item in Model)
                                                        {
                                                            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                            <tr id=@item.id>
                                                                <td style="width:10px;" data-toggle="collapse" id="@item.id" data-target=".@item.id" class="detail-row" onclick="changeicon('@item.id')">&nbsp;</td>
                                                                <td>
                                                                    <div> @item.interviewDate</div>
                                                                    @if (item.Timer > 0)
                                                                    {
                                                                        <div class="time_tab"> <span class="time-left-txt">Time left to fill the feedback:</span><div class="time-clock pull-left"><span class="timer">@item.Timer</span> <span class="time-min">(In Mins)</span></div> <a class="infos" href="#"><span>If feedback is not updated within 2 hours of the Interview Time then this interview will not be billable </span></a></div>
                                                                    }
                                                                </td>
                                                                <td> @item.JobLevelDesc </td>
                                                                <td>
                                                                    <button type="button" class="clickhere_btn pull-left">
                                                                        <span data-toggle="tooltip" data-placement="top" title="" onclick="openSkillpopup(@item.irfIntId)" data-original-title="Click here to add Interviewer"><font style="font-family: Roboto, sans-serif; font-size:12px;">Click Here</font></span>
                                                                    </button>
                                                                    <input id="skill_id_@item.irfIntId" type="hidden" value="@item.IRFID" />
                                                                </td>


                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                {
                                                                    @if (item.candidateName.Length > 26)
                                                                    {

                                                                        <td class="cadName">
                                                                            <a onclick="" data-tooltip="@item.candidateName"><span class="cname"> @item.candidateName</span> </a>
                                                                        </td>

                                                                    }

                                                                    else
                                                                    {
                                                                        <td class="cadName">
                                                                            <a onclick=""><span class="cname"> @item.candidateName</span> </a>
                                                                        </td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                <td>@item.ClientName</td>

                                                                @*<td> @item.HeuristicProfileTypeDesc </td>*@
                                                                @if (item.JobCountry == "1")
                                                                {
                                                                    <td>India</td>
                                                                }
                                                                else if (item.JobCountry == "2")
                                                                {
                                                                    <td>Out Side India</td>
                                                                }
                                                                else
                                                                {
                                                                    <td> @item.JobCountry </td>
                                                                }
                                                                @*@if (item.JDLink != null && item.JDLink != "")
                                                                    {
                                                                        <td>  <a data-tooltip="@item.JDLink" id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>@item.JDTiltle</a></td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No JD</td>
                                                                    }*@
                                                                @if (!String.IsNullOrEmpty(item.AudioComment))
                                                                {
                                                                    <td><a href='@item.AudioComment' asp-append-version="true" download>@item.AudioComment.Split('/').Last()</a></td>
                                                                }
                                                                else
                                                                {
                                                                    @if (item.CompanyDetails != null && item.CompanyDetails != "")
                                                                    {
                                                                        <td>  <a id="companylinkId" target="_blank" title="Company Instructions" href=@item.CompanyDetails.Replace(" ", "%20")>Instructions</a></td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Instructions</td>
                                                                    }
                                                                }
                                                                @if (item.resumeLink != null && item.resumeLink != "")
                                                                {
                                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }

                                                                @if (item.zoomLink != null && item.zoomLink != "")
                                                                {

                                                                    <td class="cadName">
                                                                        <a target="_blank" title="Meeting Link" href=@item.zoomLink>Meeting Link</a>
                                                                    </td>

                                                                }


                                                                else
                                                                {
                                                                    <td></td>
                                                                }

                                                                <td><strong>@item.interviewDuration</strong></td>
                                                                <td class="text-left">
                                                                    @{
                                                                        var interviewDate = @item.interviewDate.AddHours(Convert.ToInt32(ViewBag.TimeExpire));
                                                                    }
                                                                    @if (item.interviewDate <= DateTime.Now && DateTime.Now <= @interviewDate)
                                                                    {
                                                                        <button id="myinterview_10" class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Feedback Report">
                                                                            <span onclick="location.href = '@Url.Action("AddReport", "Interview", new { interviewId = item.id, irfId = item.irfIntId })'" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                                        </button>

                                                                    }

                                                                    @if (item.interviewDate.Date >= DateTime.Now.Date)
                                                                    {
                                                                        <button id="myinterview_9" class="mdc-fab app-fab--absolute sampleQues" aria-label="Unassign Yourself">
                                                                            <span onclick="javascript:CheckTimeDifference('@item.id','@item.interviewDate');" title="Unassign Yourself" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg></span>
                                                                        </button>
                                                                    }

                                                                    <button id="myinterview_9" class="mdc-fab app-fab--absolute sampleQues" aria-label="Sample Questions">
                                                                        <span onclick="location.href = '@Url.Action("SampleQuestions", "IRF", new { id = item.irfIntId, irf= item.IRFID })'" title="Sample Questions" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z" /></svg></span>
                                                                    </button>
