            url: "/Interview/getSelectionStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#selectionDropdown").html(s);
                $("#selectionDropdown").val(item.IsSelected);
            }
        });

        if (item.FinalComments != 'Selected') {
            commSelect = item.FinalComments;
        }
        else {
            commSelect = '';
        }
        //if (item.IsSelected) {
        //    //var commentId = 'selectionComments';
        //    document.getElementById('selectionComments').style.display = "none";
        //}
        //else {
        //    //var commentId = 'selectionComments';
        //    document.getElementById('selectionComments').style.display = "block";
        //}


    }

    function SelectionChanged() {
        var commentId = 'selectionComments';
        document.getElementById("selecComments").value = commSelect;

        //var checkElem = document.getElementById("checkBoxDiv_" + imid);

        var isChecked = document.getElementById("IsSelected").checked;

        if (isChecked == false) {

            document.getElementById(commentId).style.display = "block";
        }
        else {
            document.getElementById(commentId).style.display = "none";
        }
    }

    function SaveSelecPopUp() {
        var comment = document.getElementById("selecComments").value;
        var isSelected = document.getElementById("selectionDropdown").value;
        var id = imidSelect;

        $.ajax({
            type: "GET",
            url: "/Interview/ChangeSelection",
            data: { 'imid': id, 'value': isSelected, 'comment': comment },
            success: function (data) {

                location.reload(true);

            }
        });
    }

</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function FilterInterviews(filterValue) {
        $.ajax({
            type: "GET",
            url: "/Interview/GetSelectedPriorityClientFilteredMeetings",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '' && filterValue == 'Next Seven Days') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'All') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>
