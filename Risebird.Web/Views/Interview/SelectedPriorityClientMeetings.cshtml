            function ResetFilter() {

                $.ajax({
                    type: "POST",
                    url: "/Interview/SelectedPriorityClientMeetings",
                    success: function (data) {
                        window.location.href = "/Interview/ResetSelectedPriorityClientMeetingsfilters";
                    }
                });
