@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Selected Candidate Priority View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] CandidateName = new string[] { };
    string[] ClientHR = new string[] { };
    string[] InterviewDate = new string[] { };
    string[] ClientName = new string[] { };
    string[] ApprovalStatus = new string[] { };
    string[] SelectionStatus = new string[] { };
    string[] JoiningStatus = new string[] { };
    string[] OfferStatus = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters") != null)
{
    filter = JsonConvert.DeserializeObject<SelectedPriorityViewFilter>
        (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    InterviewDate = filter.InterviewDate != null ? filter.InterviewDate : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    ApprovalStatus = filter.ApprovalStatus != null ? filter.ApprovalStatus : new string[] { };
    SelectionStatus = filter.SelectionStatus != null ? filter.SelectionStatus : new string[] { };
    JoiningStatus = filter.JoiningStatus != null ? filter.JoiningStatus : new string[] { };
    OfferStatus = filter.OfferStatus != null ? filter.OfferStatus : new string[] { };
}
<style>
    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }

    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    table.dataTable > thead > tr > th, table.dataTable > tbody > tr > th, table.dataTable > tfoot > tr > th, table.dataTable > thead > tr > td, table.dataTable > tbody > tr > td, table.dataTable > tfoot > tr > td {
        max-width: 200px !important;
    }



    td.wordwrap {
        display: inline-block !important;
        max-width: 200px !important;
        min-width: 200px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: top !important;
        white-space: nowrap !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }

    .no-sort::after {
        display: none !important;
    }

    .no-sort {
        pointer-events: none !important;
        cursor: default !important;
    }
    /*CSS FOR Loader*/
    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
            height: 100px;*/
        display: none;
        position: center !important;
        background-color: White;
        z-index: 999;
        /*opacity: 0.5;*/
        filter: alpha(opacity = 50);
    }
</style>




<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor">Selected Candidate Priority View</a>
                @*<a class="navbar-brand">Client Interview Meetings</a>*@
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">
                            Selected Candidate Priority View
                        </h4>
                    </div>
                    <div class="card-body">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="toolbar">

                                <div class="row">

                                    <div class="col-md-5 ml-md-auto">
                                        <button type="button" style="margin-top:3px" class="btn btn-primary "><span class="fa fa-meetup" data-toggle="tooltip" title="Click here to get all the priority meetings' details." onclick="location.href='@Url.Action("ClientSelectedMeetings", "Interview" , new { irfId=ViewBag.IRFId, irfName=ViewBag.IRFName})'" data-original-title="Tooltip on top"> Meeting Details</span></button>

                                        <button type="button" style="margin-top:3px" class="btn btn-primary " data-toggle="modal" data-target="#filterModal"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"> Filter</span></button>

                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;"><span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Selected Candidate" onclick="location.href='@Url.Action("SelectedPriorityExporttoExcel", "Interview" )'" data-original-title="Tooltip on top"> Export Selected Candidate</span></button>

                                    </div>
                                    

                                </div>


                            </div>
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                            <h5 class="modal-title" id="filterModalLabel">Advanced Filters</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <form action="@Url.Action("SelectedPriorityClientMeetings","Interview")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="PrimarySkill">Primary Skill</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item.Split(" |")[0]">@item.Split("|")[0]</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="MeetingStatus">
                                                                Interview Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="InterviewDate" name="InterviewDate" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDate).Distinct().ToList())
                                                                    {
                                                                        @if (item != null)
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="Interviewer">
                                                                Candidate Name
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientHR">
                                                                Client
                                                                HR
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.ClientHRList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">End Client Name</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ClientName" name="ClientName" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        @foreach (var item in Model.Select(x => x.ClientName).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.ClientNameList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="ApprovalStatus">
                                                                Approval Status
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ApprovalStatus" name="ApprovalStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.NextLevelApprovalStat).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="SelectionStatus">
                                                                Selection Status
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="SelectionStatus" name="SelectionStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.FinalSelectionStat).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="JoiningStatus">
                                                                Joining Status
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="JoiningStatus" name="JoiningStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.JoiningStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="OfferStatus">
                                                                Offer Status
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="OfferStatus" name="OfferStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.OfferStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group col-md-12">
                                                            <div class="row">
                                                                <div class="col-md-6 col-sm-6">
                                                                    <button type="submit" style="margin-top: 40px; float:right" class="btn btn-primary">Apply Filter</button>
                                                                </div>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <button type="button" style="float:right;margin-top: 39px;" class="btn btn-primary" id="ResetFilter">Reset Filter</button>
                                                                </div>
                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Video</th>
                                                <th>Interviewer Comment</th>
                                                <th class="no-sort"></th>
                                                <th class="no-sort"></th>
                                                <th class="no-sort"></th>
                                                <th class="no-sort"></th>
                                                <th>Report Link</th>
                                                <th>Approval Status</th>
                                                <th>Final Selection Status</th>
                                                <th>Offer Status</th>
                                                <th>Joining Status</th>

                                                <th>Action</th>

                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Video</th>
                                                <th>Interviewer Comment</th>
                                                <th class="no-sort"></th>
                                                <th class="no-sort"></th>
                                                <th class="no-sort"></th>
                                                <th class="no-sort"></th>
                                                <th>Report Link</th>
                                                <th>Approval Status</th>
                                                <th>Final Selection Status</th>
                                                <th>Offer Status</th>
                                                <th>Joining Status</th>

                                                <th>Action</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                            <tr id=@item.imid>
                                                <td> @item.interviewDate </td>
                                                <td> @item.candidateName </td>
                                                <td> @item.ClientHrContact </td>
                                                <td> @item.ClientName </td>
                                                <td> @item.JDTiltle.Split("|")[0] </td>

                                                @if (item.VideoLink != null && item.VideoLink != "")
                                                {
                                                    <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                }
                                                else
                                                {
                                                    <td>No Video</td>
                                                }
                                                <td>
                                                    <textarea style="height: 100px; width:150%;">@item.InterviewerComment</textarea>
                                                </td>
                                                <td>  </td>
                                                <td>  </td>
                                                <td>  </td>
                                                <td>  </td>
                                                <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.irfIntId, isClient = true})'>Report</a> </td>
                                                <td>@item.NextLevelApprovalStat</td>
                                                <td>@item.FinalSelectionStat</td>
                                                <td>@item.OfferStatusStatDesc</td>
                                                <td>@item.JoiningStatusStatDesc</td>
                                                <td class="text-right">
                                                    <span title="Client Feedback" onclick="ModalButtonClick(@jsonObject)" id="@(" myBtn_"+item.imid)" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-thumbs-up"></i></span>
                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */">
            <!-- Modal content -->
            <div class="modal-content" style="width:70%;position: relative; background-color: #fefefe; margin: auto; padding: 0;border: 1px solid #888;box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2),0 6px 20px 0 rgba(0,0,0,0.19);font-size: 12px;margin-top:-53px">
                <div class="modal-header" style="padding: 2px 16px;background-color: #14406e;color: white;font-size: 10px;">
                    <h5>Client Feedback</h5>
                    <span class="close" id="feedbackPopUp">&times;</span>
                </div>
                <div class="modal-body" style="padding: 2px 16px;">
                    <div class="row">
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div class="form-group">
                                <label for="approveDropdown"><b>Approved For Next Round</b></label>
                                <select class="form-control" id="approveDropdown" name="approveDropdown"></select>
                            </div>

                        </div>

                        <div class="col-md-6 col-sm-6 pr-1">
                            <div id="approvalComments" class="form-group">
                                <label>Approval Comments</label>
                                <textarea name="appComments" class="form-control text-box single-line" id="appComments" style="margin-left:6px;border: 1px solid black;height:46px;width:95%"></textarea><br>

                                @*<input type="text" name="appComments" class="form-control" id="appComments" style="margin-left:6px"><br>*@
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div class="form-group">
                                <label for="selectionDropdown"><b>Final Selection</b></label>
                                <select class="form-control" id="selectionDropdown" name="selectionDropdown"></select>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div id="selectionComments" class="form-group">
                                <label>Final Comments</label>

                                <textarea name="selecComments" class="form-control text-box single-line" id="selecComments" style="margin-left:6px;border: 1px solid black;height:46px;width:95%"></textarea><br>

                                @*<input type="text" name="selecComments" class="form-control" id="selecComments" style="margin-left:6px"><br>*@
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div class="form-group">

                                <label for="offerDropdown"><b>Offer Status</b></label>
                                <select class="form-control" id="offerDropdown" name="offerDropdown"></select>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div id="offerComments" class="form-group">
                                <label>Offer Comments</label>
                                <textarea name="offComments" class="form-control text-box single-line" id="offComments" style="margin-left:6px;border: 1px solid black;height:46px;width:95%"></textarea><br>

                                @*<input type="text" name="offComments" class="form-control" id="offComments" style="margin-left:6px"><br>*@
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div class="form-group">

                                <label for="joiningDropdown"><b>Joining Status</b></label>
                                <select class="form-control" id="joiningDropdown" name="joiningDropdown"></select>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-6 pr-1">
                            <div id="joiningComments" class="form-group">
                                <label>Joining Comments</label>
                                <textarea name="joinComments" class="form-control text-box single-line" id="joinComments" style="margin-left:6px;border: 1px solid black;height:46px;width:95%"></textarea><br>

                                @*<input type="text" name="joinComments" class="form-control" id="joinComments" style="margin-left:6px"><br>*@
                            </div>
                        </div>
                    </div>

                    <div class="">
                        <input type="button" onclick="SavePopUp()" class="btn btn-fill btn-primary" id="btnUpload" value="Save">
                    </div>
                </div>
                <div class="modal-footer" style="padding: 2px 16px;
        background-color: #14406e;
        color: white;">

                </div>
            </div>

        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>
<style>
    .caret {
        display: none !important;
    }

    .multiselect-container {
        width: 100% !important;
    }

    .modal-lg {
