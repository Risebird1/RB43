@if (ViewBag.Message != null)
{

    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        location.reload();
                        //window.location.href = '/Interview/Index';
                    }
                )

            }
            else {
                swal({
