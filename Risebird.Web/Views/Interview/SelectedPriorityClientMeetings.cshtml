        var isSelected = document.getElementById("selectionDropdown").value;

        var joiningComment = document.getElementById("joinComments").value;
        var joiningStatus = document.getElementById("joiningDropdown").value;

        var offerComment = document.getElementById("offComments").value;
        var offerStatus = document.getElementById("offerDropdown").value;
        var id = imid;

        $.ajax({
