@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Selected Candidates Priority View";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] CandidateName = new string[] { };
    string[] ClientHR = new string[] { };
    string[] InterviewDate = new string[] { };
    string[] ClientName = new string[] { };
    string[] ApprovalStatus = new string[] { };
    string[] SelectionStatus = new string[] { };
    string[] JoiningStatus = new string[] { };
    string[] OfferStatus = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters") != null)
{
    filter = JsonConvert.DeserializeObject<SelectedPriorityViewFilter>
        (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    InterviewDate = filter.InterviewDate != null ? filter.InterviewDate : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    ApprovalStatus = filter.ApprovalStatus != null ? filter.ApprovalStatus : new string[] { };
    SelectionStatus = filter.SelectionStatus != null ? filter.SelectionStatus : new string[] { };
    JoiningStatus = filter.JoiningStatus != null ? filter.JoiningStatus : new string[] { };
    OfferStatus = filter.OfferStatus != null ? filter.OfferStatus : new string[] { };
}



<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>

            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content selected-priority client">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                                <div class="row">


                                    <div class="card-header">
                                        <div class="pull-left first"> <h4 class="card-title">  Selected Candidates Priority View</h4></div>

                                        <div class="pull-right">
                                            <div>


                                                <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded three" style="margin-top: 2px;" data-toggle="modal" data-target="#filterModal">

                                                    <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="modal" data-target="#filterModal"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                                    <div class="mdc-button__ripple"></div>
                                                </button>

                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded four" style="margin-top: 2px;">
                                                    <span class="fa fa-meetup" data-toggle="tooltip" title="Click here to get all the priority meetings' details." onclick="location.href='@Url.Action("ClientSelectedMeetings", "Interview" , new { irfId=ViewBag.IRFId, irfName=ViewBag.IRFName})'" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Meeting Details</font></span>
                                                </button>



                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded exportfive" style="margin-top: 2px;">
                                                    <span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Selected Candidate" onclick="location.href='@Url.Action("SelectedPriorityExporttoExcel", "Interview" )'" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Export Selected Candidate</font></span>
                                                </button>

                                                <!-- <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                      <span class="fa fa-life-ring" data-toggle="tooltip" data-placement="top" title="Support" onclick="location.href='@Url.Action("Index", "Support", new { controllerName = "Interview", actMethod ="SelectedPriorityClientMeetings" } )'" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Export Selected Candidate</font></span>
                                                  </button>-->


                                            </div>
                                        </div>
                                    </div>


                                </div>


                            </div>
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                      
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>

                                        
                                        <form action="@Url.Action("SelectedPriorityClientMeetings","Interview")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Primary Skill</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                Interview Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewDate" name="InterviewDate" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDate).Distinct().ToList())
                                                                    {
                                                                        @if (item != null)
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                Candidate Name
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                Client
                                                                HR
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.ClientHRList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="RFID">End Client Name</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ClientName" name="ClientName" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("SelectedPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        @foreach (var item in Model.Select(x => x.ClientName).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.ClientNameList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ApprovalStatus">
                                                                Approval Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ApprovalStatus" name="ApprovalStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.NextLevelApprovalStat).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SelectionStatus">
                                                                Selection Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="SelectionStatus" name="SelectionStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.FinalSelectionStat).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="JoiningStatus">
                                                                Joining Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="JoiningStatus" name="JoiningStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.JoiningStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="OfferStatus">
                                                                Offer Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="OfferStatus" name="OfferStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.OfferStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">


                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>


                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>

                                                                </div>

                                                            </div>


                                                        </div>


                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>



                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID" class="second">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Video</th>
                                                <th>Interviewer Comment</th>
                                                <th class="no-sort"></th>



                                                <th>Report Link</th>
                                                <th>Aadhar Link</th>
                                                <th>Approval Status</th>
                                                <th>Final Selection Status</th>
                                                <th>Offer Status</th>
                                                <th>Joining Status</th>

                                                <th>Action</th>
                                                <th>Call</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Video</th>
                                                <th>Interviewer Comment</th>
                                                <th class="no-sort"></th>



                                                <th>Report Link</th>
                                                <th>Aadhar Link</th>
                                                <th>Approval Status</th>
                                                <th>Final Selection Status</th>
                                                <th>Offer Status</th>
                                                <th>Joining Status</th>

                                                <th>Action</th>
                                                <th>Call</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                
                                            <tr id=@item.imid>
                                                <td hidden>@item.MoveToCP</td>
                                                <td> @item.interviewDate </td>
                                                @if (item.IsOnline == 1)
                                                {
                                                    <td>
                                                        <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>    @item.candidateName </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                         @item.candidateName
                                                    </td>
                                                }
                                                @if (item.IsHrOnline == 1)
                                                {
                                                    <td>
                                                        <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                         @item.ClientHrContact 
                                                    </td>
                                                }
                                                <td> @item.ClientName </td>
                                                <td> @item.JDTiltle.Split("|")[0] </td>

                                                @if (item.VideoLink != null && item.VideoLink != "")
                                                {
                                                    <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                }
                                                else
                                                {
                                                    <td>No Video</td>
                                                }
                                                <td>
                                                    <div class="talk-bubble tri-right border-bubble right-in">
                                                        <div class="talktext">
                                                            <textarea style="height:40px;">@item.InterviewerComment</textarea>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>  </td>


                                                <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.irfIntId, isClient = true})'>Report</a> </td>
                                                @if (item.AadharFileLink != null && item.AadharFileLink != "")
                                                {
                                                    <td>

                                                        <a id="aadharLinkId" target="_blank" title="Aadhar" href=@item.AadharFileLink>Aadhar</a>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>No document</td>
                                                }
                                                <td>@item.NextLevelApprovalStat</td>
                                                <td>@item.FinalSelectionStat</td>
                                                <td>@item.OfferStatusStatDesc</td>
                                                <td>@item.JoiningStatusStatDesc</td>
                                                <td class="text-center action">


                                                    <button class="mdc-fab app-fab--absolute" aria-label="Client Feedback">
                                                        <span onclick="ModalButtonClick(@jsonObject)" id="@(" myBtn_"+item.imid)" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                    </button>

                                                    @if (item.IsBiometricEnabled)
                                                    {
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Verify">
                                                            <span onclick="location.href = '@Url.Action("VerifyJoiningAudio", "Interview", new { candidateId = item.CandidateId,CandidateName=item.candidateName, irfId= item.irfIntId, meetingId = item.imid})'" title="Upload audio for verification" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 3v9.28c-.47-.17-.97-.28-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z" /></svg></span>
                                                        </button>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                    {
                                                        <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CallButtonClick('@item.candidateName','@item.MobileNumber')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt"> Call Candidate</span></span>
                                                    }

                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>


                            <div id="myModal" class="modal modal-bg">
                                <!-- Modal content -->
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                            <h5 class="modal-title"> Client Feedback</h5>
                                            <span class="close" id="feedbackPopUp" style="cursor:pointer;">&times;</span>
                                        </div>
                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">
                                                        <label class="control-labeled" for="approveDropdown">
                                                            Approved For Next Round
                                                        </label>
                                                        <select class="form-control" id="approveDropdown" name="approveDropdown"></select>
                                                    </div>
                                                </div>

                                                <div class="col-md-6 col-sm-6">
                                                    <div id="approvalComments">
                                                        <div class="form-group">

                                                            <label class="control-labeled">Approval Comments</label>

                                                            <div class="form-control text-areadiv"><textarea name="appComments" class="text-box single-line" id="appComments"></textarea></div>


                                                           
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">
                                                        <label class="control-labeled" for="selectionDropdown">Final Selection</label>
                                                        <select class="form-control" id="selectionDropdown" name="selectionDropdown"></select>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div id="selectionComments">
                                                        <div class="form-group">
                                                            <label class="control-labeled">Final Comments</label>

                                                            <div class="form-control text-areadiv">
                                                                <textarea name="selecComments" class="text-box single-line" id="selecComments"></textarea>
                                                            </div>


                                                            
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">

                                                        <label class="control-labeled" for="offerDropdown">Offer Status</label>
                                                        <select class="form-control" id="offerDropdown" name="offerDropdown"></select>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div id="offerComments">
                                                        <div class="form-group">
                                                            <label class="control-labeled">Offer Comments</label>

                                                            <div class="form-control text-areadiv">
                                                                <textarea name="offComments" class="text-box single-line" id="offComments"></textarea>
                                                            </div>


                                                        </div>

                                                       
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">

                                                        <label class="control-labeled" for="joiningDropdown"><b>Joining Status</b></label>
                                                        <select class="form-control" id="joiningDropdown" name="joiningDropdown"></select>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div id="joiningComments">
                                                        <div class="form-group">
                                                            <label class="control-labeled">Joining Comments</label>

                                                            <div class="form-control text-areadiv">
                                                                <textarea name="joinComments" class="text-box single-line" id="joinComments"></textarea>
                                                            </div>                                                           
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
