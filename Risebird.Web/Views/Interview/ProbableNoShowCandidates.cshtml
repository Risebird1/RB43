@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.Data
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Probable No Show Candidates";
    ViewBag.PageHeader = "Probable No Show Candidates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    var Header = "<div>Probable No Show Candidates</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=1234" />

<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        @*<img style="visibility:hidden" src="img/chardin.png" data-position="right" />*@
                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">Probable No Show Candidates</h4></div>
                    </div>
                    <div class="pull-right client-ms">
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    </div>
                    @*<div class="pull-right client-ms">
                    <div style="float:left">
                    <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded three " style="float: left;margin-right: 5px;" data-bs-toggle="modal" data-bs-target="#filterModal">
                    <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                    <div class="mdc-button__ripple"></div>
                    </button>
                    </div>
                    </div>*@
                </div>
            </div>
        </div>
        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
        </button>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Email</th>
                                                <th>Mobile Number</th>
                                                <th>Skill Channel</th>
                                                <th>Actual Meeting Status</th>

                                                <th style="text-align:center">Call</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Email</th>
                                                <th>Mobile Number</th>
                                                <th>Skill Channel</th>
                                                <th>Actual Meeting Status</th>
                                                <th style="text-align:center">Call</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @if (Model != null && Model.Count() > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                    <tr>
                                                        <td>@item.interviewDate</td>
                                                        <td>@item.candidateEmail</td>
                                                        <td>@item.MobileNumber</td>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.MeetingStatusStatusDesc</td>
                                                        <td>
                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                            {
                                                                <span id="getstatus_12" class="call" data-toggle="tooltip" data-placement="top" onclick="CallButtonClick(@jsonObject,1)" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                                                            }

                                                        </td>
                                                        
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->
        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
<!-- end row -->
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

<script src="~/js/twiliocallmaker.js"></script>

<script type="text/javascript">

    $(document).ready(function () {


    });


</script>
<script>
    //function searchResult() {
    //    $('#recordingsTable').DataTable();
    //}
    //function RefreshSearch() {
    //    $('#recordingsTable').DataTable().destroy();
    //    setTimeout(function () {
    //        applyDataTable();
    //    }, 2000);
    //}

    $(document).ready(function () {
        applyDataTable();
        //$('#detailsTable').DataTable();
    });

    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }


</script>




