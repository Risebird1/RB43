@model Risebird.Entities.ViewModel.QCFormVM

@{
    ViewData["Title"] = "QC Form";
    ViewBag.PageHeader = "QC Form";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<script>
    var Header = "<div>QC Form</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=987654" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=987654" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
@*<script>
        document.getElementById('theme').href = '../Newassets/css/blue-theme.css';
    </script>*@
<div class="main-panel" id="main-panel">
    <div class="mt50 col-md-12">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> QC Form</h4></div>
                </div>
                <div class="pull-right">
                    <div>
                        @*<a href="/MCQ/Index" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">Back</a>*@
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content dataloading client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/Interview/QCReportForm" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form" id="reportForm">
                            @Html.HiddenFor(m => m.Interviewid)
                            <div class="canvas_div_pdf">
                                <div class="report-full-wrap">
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h3 class="mb-0"><span>Video Quality Check</span></h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-wrap">
                                        <div class="row">
                                            <div class="col-md-6 col-sm-6 border-rv pull-left">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.IsCodingPresent, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    <div style="padding-left:15px">
                                                        @Html.RadioButtonFor(model => model.IsCodingPresent, true) Yes
                                                        @Html.RadioButtonFor(model => model.IsCodingPresent, false) No
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.IsVideoClearQuality, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    <div style="padding-left:15px">
                                                        @Html.RadioButtonFor(model => model.IsVideoClearQuality, true) Yes
                                                        @Html.RadioButtonFor(model => model.IsVideoClearQuality, false) No
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
