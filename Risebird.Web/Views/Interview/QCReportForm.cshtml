                                                    <div style="padding-left:15px">
                                                        @Html.RadioButtonFor(model => model.IsSuspiciousappfound, true) Yes
                                                        @Html.RadioButtonFor(model => model.IsSuspiciousappfound, false) No
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
