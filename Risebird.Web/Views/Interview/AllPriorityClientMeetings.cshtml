<script>
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        $("#PrimarySkill").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#RFID").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#ClientHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#ConfirmationStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#MeetingStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#InterviewStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#Interviewer").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        
        //FilterInterviews("All");// on page load default dropdownlist value set
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meeting').DataTable();
    });

    function ResetFilter() {
           
             $.ajax({
            type: "POST",
                 url: "/Interview/AllPriorityClientMeetings",
                 success: function (data) {
                     window.location.href = "/Interview/ResetAllPriorityClientMeetingsFilter";
                 }
                });
    }
        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
            var rFID =  @Html.Raw(Json.Serialize(RFID));
            var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
            var confirmationStatus =  @Html.Raw(Json.Serialize(ConfirmationStatus));
            var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
            var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
            var interviewer =  @Html.Raw(Json.Serialize(Interviewer));

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#PrimarySkill").val(primarySkillsArr);
            $("#RFID").val(rFID);
            $("#ClientHR").val(clientHR);
            $("#ConfirmationStatus").val(confirmationStatus);
            $("#MeetingStatus").val(meetingStatus);
            $("#InterviewStatus").val(interviewStatus);
            $("#Interviewer").val(interviewer);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
            url: "/Interview/ClientMeetings",
            data: form,
                 success: function (data) {
                 }
                });
    }

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
