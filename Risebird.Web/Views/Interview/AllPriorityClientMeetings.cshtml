<script>
    function FilterInterviews(filterValue) {
        $.ajax({
            type: "GET",
            url: "/Interview/GetAllPriorityClientFilteredMeetings",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '' && filterValue == 'Next Seven Days') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'All') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>



<script>
 var start = document.getElementById('start');
start.focus();

function dotheneedful(sibling) {
  if (sibling != null) {
    start.focus();
    start.style.backgroundColor = '';
    start.style.color = '';
    sibling.focus();
        start = sibling;
  }
}

document.onkeydown = checkKey;

function checkKey(e) {
  e = e || window.event;
  if (e.keyCode == '38') {
    // up arrow
    var idx = start.cellIndex;
    var nextrow = start.parentElement.previousElementSibling;
    if (nextrow != null) {
      var sibling = nextrow.cells[idx];
      dotheneedful(sibling);
    }
  } else if (e.keyCode == '40') {
    // down arrow
    var idx = start.cellIndex;
    var nextrow = start.parentElement.nextElementSibling;
    if (nextrow != null) {
      var sibling = nextrow.cells[idx];
      dotheneedful(sibling);
    }
  } else if (e.keyCode == '37') {
    // left arrow
    var sibling = start.previousElementSibling;
    dotheneedful(sibling);
  } else if (e.keyCode == '39') {
    // right arrow
    var sibling = start.nextElementSibling;
    dotheneedful(sibling);
  }
}
</script>







