    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">

                    <div class="card-body">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="toolbar">




                                <div class="row">


                                    <div class="card-header ">
                                        <div class="pull-left first"> <h4 class="card-title">All Interview Priority View</h4></div>

                                        <div class="pull-right">
                                            <div>
                                                <button type="button" style="margin-top:3px" class="btn btn-primary buttons  four"><span class="fa fa-meetup" data-toggle="tooltip" data-placement="top" title="Click here to get all the meetings' details." onclick="location.href='@Url.Action("ClientMeetings", "Interview", new { irfId = ViewBag.IRFId, irfName = ViewBag.IRFName})'" data-original-title="Tooltip on top"><font style="font-family:arial;"> Meeting Details</font></span></button>

                                                <button type="button" style="margin-top:3px" class="btn btn-primary buttons three " data-toggle="modal" data-target="#filterModal"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style="font-family:arial;"> Filter</font></span></button>
                                                <button type="button" class="btn btn-primary buttons  " style="margin-top: 2px;"><span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export All Candidate" onclick="location.href='@Url.Action("AllPriorityExporttoExcel", "Interview" )'" data-original-title="Tooltip on top"><font style="font-family:arial;"> Export All Candidate</font></span></button>
                                            </div>
                                        </div>
                                    </div>


                                </div>

















                            </div>
                            <div class="modal modal-wrap fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                            <h5 class="modal-title" id="filterModalLabel">Filter</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <form action="@Url.Action("AllPriorityClientMeetings","Interview")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="EndDate">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="PrimarySkill">Primary Skill</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientHR">
                                                                Client
                                                                HR
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("AllPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.ClientHRList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="MeetingStatus">
                                                                Meeting Status
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="MeetingStatus" name="MeetingStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.MeetingStatusStatusDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">RFID</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("AllPriorityClientMeetingsfilters") != null)
                                                                    {
