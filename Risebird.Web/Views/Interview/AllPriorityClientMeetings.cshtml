                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="RFID">RFID</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("AllPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        @foreach (var item in Model.Select(x => x.IRFId).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.IRFList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ConfirmationStatus">
                                                                Confirmation Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.confirmationStatus).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="RFID">End Client Name</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ClientName" name="ClientName" class="form-control multiselect" multiple="multiple">
                                                                    @if (HttpContextAccessor.HttpContext.Session.GetString("AllPriorityClientMeetingsfilters") != null)
                                                                    {
                                                                        @foreach (var item in Model.Select(x => x.ClientName).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        foreach (var item in ViewBag.ClientNameList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                Interview Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ApprovalStatus">
                                                                Approval Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ApprovalStatus" name="ApprovalStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.NextLevelApprovalStat).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SelectionStatus">
                                                                Selection Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="SelectionStatus" name="SelectionStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.FinalSelectionStat).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="JoiningStatus">
                                                                Joining Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="JoiningStatus" name="JoiningStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.JoiningStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="OfferStatus">
                                                                Offer Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="OfferStatus" name="OfferStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.OfferStatusStatDesc).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">



                                                            <div>
                                                                <div class="col-md-12 col-sm-12">


                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>


                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>

                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID" class="second">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th id='start'>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th class="itemInterviewLink">Interview Link</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Report Link</th>
                                                <th>Aadhar Link</th>
                                                <th>Video</th>
                                                <th>Approval Status</th>
                                                <th>Final Selection Status</th>
                                                <th>Offer Status</th>
                                                <th>Joining Status</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>Interview Link</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Report Link</th>
                                                <th>Aadhar Link</th>
                                                <th>Video</th>
                                                <th>Approval Status</th>
                                                <th>Final Selection Status</th>
                                                <th>Offer Status</th>
                                                <th>Joining Status</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.imid>
                                                    <td> @item.interviewDate </td>
                                                    @if (item.IsOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>    @item.candidateName </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @item.candidateName
                                                        </td>
                                                    }
                                                    @if (item.IsHrOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @item.ClientHrContact
                                                        </td>
                                                    }

                                                    @if (item.zoomLink != null && item.zoomLink != "")
                                                    {
                                                        <td> <a id="zoomlinkId" target="_blank" title="Interview Link" href=@item.zoomLink>Interview Link</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Interview Link</td>
                                                    }
                                                    <td> @item.ClientName </td>
                                                    <td> @item.JDTiltle.Split("|")[0] </td>
                                                    @if (item.confirmationStatus.Trim() == "Cancelled")
                                                    {
                                                        <td class="text-center">

                                                            <a style="color:red"> @item.confirmationStatus</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td class="text-center"> @item.confirmationStatus</td>
                                                    }
                                                    @if (@item.interviewDate > DateTime.Now && item.confirmationStatus.Trim() != "Cancelled")
                                                    {
                                                        <td>Scheduled</td>
                                                    }
                                                    else
                                                    {
                                                        <td> @item.MeetingStatusStatusDesc</td>
                                                    }
                                                    @if ((item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                    {
                                                        <td> @item.intervieweStatusStatDesc</td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    @if ((item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                    {

                                                        <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.irfIntId, isClient = true})'>Report</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Report</td>
                                                    }
                                                    @if (item.AadharFileLink != null && item.AadharFileLink != "")
                                                    {
                                                        <td>

                                                            <a id="aadharLinkId" target="_blank" title="Aadhar" href=@item.AadharFileLink.ToString().Replace(" ","%20")>Aadhar</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No document</td>
                                                    }
                                                    @if (item.VideoLink != null && item.VideoLink != "" && (item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                    {
                                                        <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Video</td>
                                                    }
                                                    <td>@item.NextLevelApprovalStat</td>
                                                    <td>@item.FinalSelectionStat</td>
                                                    <td>@item.OfferStatusStatDesc</td>
                                                    <td>@item.JoiningStatusStatDesc</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>

<script>
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        $("#PrimarySkill").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#RFID").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ClientHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ConfirmationStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#MeetingStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#ClientName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#InterviewStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#ApprovalStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#SelectionStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#JoiningStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#OfferStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });


        //FilterInterviews("All");// on page load default dropdownlist value set
        $('#meeting').DataTable({
