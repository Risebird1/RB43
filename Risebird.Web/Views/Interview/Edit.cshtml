@model Risebird.Entities.ViewModel.MeetingVM

@{
    ViewData["Title"] = "Edit Interview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="main-panel" id="main-panel">
    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/Interview/Index">Interview Forms</a>
                  <a class="navbar-brand">&nbsp; Edit Interview</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>



    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        @using (Html.BeginForm("Edit", "Interview", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()



                            <div class="row">
                                <div class="card-header">
                                    <h4 class="card-title">Edit Interview</h4>
                                </div>
                                <div style="width: 100%;">&nbsp;</div>
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input type="hidden" name="imid" value=@Model.imid />

                                <div class="col-lg-4  col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IRFId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownListFor(model => model.IRFId, Model.IRFList, new { @class = "select-css form-control", @onchange = "IRFChanged(this.value)" })
                                        
                                        @Html.ValidationMessageFor(model => model.IRFId, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.interviewDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.interviewDate, new { htmlAttributes = new { @class = "form-control ", @Value = Model.interviewDate.ToString("dd/MM/yyyy") } })
                                        @Html.ValidationMessageFor(model => model.interviewDate, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.interviewSlot, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownListFor(x => Model.interviewSlot, Model.InterviewSlotList, "Select Status", htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                        @Html.ValidationMessageFor(model => model.interviewSlot, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.interviewDuration, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.interviewDuration, new { htmlAttributes = new { @class = "input form-control" } })
                                        @Html.ValidationMessageFor(model => model.interviewDuration, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.candidateEmail, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.candidateEmail, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.candidateEmail, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.candidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.candidateName, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.candidateName, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="col-lg-4  col-md-4 col-sm-4 px-1">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ClientHrContact, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownListFor(model => model.ClientHrContact, Model.ClientHrContactList, new { @class = "select-css form-control" })

                                       
                                        @Html.ValidationMessageFor(model => model.ClientHrContact, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.zoomLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.zoomLink, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.zoomLink, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.zoomDetails, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.zoomDetails, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.zoomDetails, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.ConfirmationStatusList, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.DropDownListFor(x => Model.confirmationStatus, Model.ConfirmationStatusList, "Select Status", htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                        @Html.ValidationMessageFor(model => model.confirmationStatus, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.interviewer, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.interviewer, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.interviewer, "", new { @class = "text-danger" })

                                    </div>
                                    <div>
                                        Upload Resume



                                        <div class="mdc-touch-target-wrapper" style="top: 4px;
    position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="Resume" name="Resume" value="Upload" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>


                                        Add a link


                                        <div class="mdc-touch-target-wrapper" style="top: 4px;
    position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="Resume" name="Resume" value="Link" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>

                                        None


                                        <div class="mdc-touch-target-wrapper" style="top: 4px;
    position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="Resume" name="Resume" value="None" checked="checked" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>

                                    </div>

                                    <div style="display:none" id="linkDiv">
                                        @Html.LabelFor(model => model.resumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.resumeLink, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.resumeLink, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="" style="display:none" id="uploadDiv">
                                        @Html.LabelFor(model => model.File, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.TextBoxFor(model => model.File, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })

                                    </div>
                                    <div class="upload">
                                        @{
                                            if (!String.IsNullOrEmpty(Model.resumeLink))
                                            {
                                                <a style="text-decoration:none;" id="audioId" target="_blank" rel="tooltip" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded  col-lg-12" data-original-title="" title="Download your uploaded file" href=@Model.resumeLink.ToString().Replace(" ","%20")>Uploaded Resume</a>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-4  col-md-4 col-sm-4 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.HRCoordinatorEmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.HRCoordinatorEmailId, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.HRCoordinatorEmailId, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.risebirdHR, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.risebirdHR, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.risebirdHR, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.preferredLocation, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.preferredLocation, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.preferredLocation, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.staffingAgency, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownListFor(model => model.staffingAgency, Model.StaffingAgencyList, new { @class = "select-css form-control" })

                                       
                                        @Html.ValidationMessageFor(model => model.staffingAgency, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.expectedPerHourRate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.expectedPerHourRate, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.expectedPerHourRate, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.joiningTime, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.joiningTime, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.joiningTime, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.currentEmployerName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.currentEmployerName, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.currentEmployerName, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                            </div>


                            <div class="card-footer ">
                                <div class="row">

                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "Index", "Interview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Update Interview">Save</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>


<script src="~/Newassets/js/interview.js"></script>
<script>

    document.body.className += "js";

    var spinner = document.querySelector('.input');
    var buttonUp = document.querySelector('.up');
    var buttonDown = document.querySelector('.down');

    buttonUp.onclick = function () {
        var value = parseInt(spinner.value, 10);
        value = isNaN(value) ? 0 : value;
        value++;
        spinner.value = value;
    };

    buttonDown.onclick = function () {
        var value = parseInt(spinner.value, 10);
        value = isNaN(value) ? 0 : value;
        value--;
        spinner.value = value;
    };

</script>


