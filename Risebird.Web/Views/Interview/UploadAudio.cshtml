@model Risebird.Entities.ViewModel.CandidateAudio


@{
    ViewData["Title"] = "Upload Audio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .canvasjs-chart-credit {
        display: none;
    }

    .table-responsive {
        overflow: hidden;
    }

    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }
</style>

<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js"></script>*@


<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>

<div class="main-panel" id="main-panel">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Upload Audio
                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">

        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <form action="/IRF/UploadAudio" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <ul>
                                    <li>Kindly ensure the duration of the audio file for voice biometric is a minimum of 2 seconds and does not exceed 5 seconds.</li>
                                </ul>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.IRFName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.IRFName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                       
                                        @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                        @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control btn", @accept = ".mp3, .wav, .m4a" })

                                    </div>
                                    <div class="col-md-6 col-sm-6">

                                        <div class="form-group" id="descText">
                                            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.Description, new { @class = "form-control text-box single-line", @style = "margin-top:10px; height:45px" })
                                        </div>
                                       
                                    </div>

                                </div>
                      
                             


                                @Html.HiddenFor(m => m.IRFId)
                                @Html.HiddenFor(m => m.CandidateId)
                                @Html.HiddenFor(m => m.IRFName)

                                <div class="card-footer ">
                                    <div class="row">
                                        <label class="col-md-2"></label>
                                        <div class="col-md-9">

                                            @Html.ActionLink("Back to List", "MyInterview", "Interview", new { id = Model.IRFId, irfName = Model.IRFName }, htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                            <button type="submit" class="btn btn-fill btn-primary" id="btnUpload" value="Save">Upload</button>


                                        </div>
                                    </div>
                                </div>






                            </div>
                        </form>
                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>



