<script>
    $(document).ready(function () {
         $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        $("#PrimarySkill").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#CandidateName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ClientHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#ApprovalStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#SelectionStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#JoiningStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#OfferStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#InterviewDate").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#ClientName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        //FilterInterviews("All");// on page load default dropdownlist value set
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meeting').DataTable();
    });
    function ResetFilter() {

             $.ajax({
            type: "POST",
            url: "/Interview/ClientSelectedMeetings",
                 success: function (data) {
                    window.location.href = "/Interview/ResetClientSelectedMeetingsfilters";
                 }
                });
    }
     function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
            var candidateName =  @Html.Raw(Json.Serialize(CandidateName));
            var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
            var interviewDate =  @Html.Raw(Json.Serialize(InterviewDate));
            var clientName =  @Html.Raw(Json.Serialize(ClientName));
            var selectionStatus = @Html.Raw(Json.Serialize(SelectionStatus));
            var approvalStatus = @Html.Raw(Json.Serialize(ApprovalStatus));
            var joiningStatus = @Html.Raw(Json.Serialize(JoiningStatus));
            var offerStatus = @Html.Raw(Json.Serialize(OfferStatus));

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#PrimarySkill").val(primarySkillsArr);
            $("#CandidateName").val(candidateName);
            $("#ClientHR").val(clientHR);
            $("#InterviewDate").val(interviewDate);
            $("#ClientName").val(clientName);
            $("#SelectionStatus").val(selectionStatus);
            $("#ApprovalStatus").val(approvalStatus);
            $("#JoiningStatus").val(joiningStatus);
             $("#OfferStatus").val(offerStatus);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
            url: "/Interview/ClientSelectedMeetings",
            data: form,
                 success: function (data) {
                 }
                });
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

