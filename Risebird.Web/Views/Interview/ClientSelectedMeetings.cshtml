@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Selected Candidate Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] CandidateName = new string[] { };
    string[] ClientHR = new string[] { };
    string[] InterviewDate = new string[] { };
    string[] ClientName = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("ClientSelectedMeetingsfilters") != null)
{
    filter = JsonConvert.DeserializeObject<SelectedPriorityViewFilter>(HttpContextAccessor.HttpContext.Session.GetString("ClientSelectedMeetingsfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    InterviewDate = filter.InterviewDate != null ? filter.InterviewDate : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
}
<style>
    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }

    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    /*CSS FOR Loader*/
    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
            height: 100px;*/
        display: none;
        position: center !important;
        background-color: White;
        z-index: 999;
        /*opacity: 0.5;*/
        filter: alpha(opacity = 50);
    }

    table.dataTable > thead > tr > th, table.dataTable > tbody > tr > th, table.dataTable > tfoot > tr > th, table.dataTable > thead > tr > td, table.dataTable > tbody > tr > td, table.dataTable > tfoot > tr > td {
        max-width: 300px !important;
    }

    table {
        white-space: nowrap !important;
    }

    td.wordwrap {
        display: inline-block !important;
        max-width: 250px !important;
        min-width: 250px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: top !important;
        white-space: nowrap !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }
</style>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor">Selected Candidate Interviews</a>
                @*<a class="navbar-brand">Client Interview Meetings</a>*@
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">
                            Selected Candidate Interviews @*list for <b>@ViewBag.IRF</b>*@
                        </h4>
                    </div>
                    <div class="card-body">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="toolbar">

                                <div class="row">

                                    <div class="col-md-3 ml-md-auto">
                                        <div class="form-group">
                                            @Html.ActionLink("Back to List", "SelectedPriorityClientMeetings", "Interview", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#filterModal" style="margin-top: 2px;"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"> Filter</span></button>
                                        </div>
                                    </div>

                                </div>


                            </div>
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                            <h5 class="modal-title" id="filterModalLabel">Advanced Filters</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <form action="@Url.Action("ClientSelectedMeetings","Interview")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="PrimarySkill">Primary Skill</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>


                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="MeetingStatus">
                                                                Interview Date
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="InterviewDate" name="InterviewDate" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.interviewDate).Distinct().ToList())
                                                                    {
                                                                        @if (item != null)
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="Interviewer">
                                                                Candidate Name
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientHR">
                                                                Client
                                                                HR
                                                            </label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">End Client Name</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ClientName" name="ClientName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.ClientName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group col-md-12">
                                                            <div class="row">
                                                                <div class="col-md-6 col-sm-6">
                                                                    <button type="submit" style="margin-top: 40px; float:right" class="btn btn-primary">Apply Filter</button>
                                                                </div>
                                                                <div class="col-md-6 col-sm-6">
                                                                    <button type="button"  id="ResetFilter"  style="float:right;margin-top: 39px;" class="btn btn-primary" >Reset Filter</button>
                                                                </div>
                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Report Link</th>
                                                <th>Video</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Current Employer</th>
                                                <th>Expected Per Hour Rate</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Client HR</th>
                                                <th>End Client Name</th>
                                                <th>Primary Skill</th>
                                                <th>Report Link</th>
                                                <th>Video</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Current Employer</th>
                                                <th>Expected Per Hour Rate</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.imid>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.candidateName </td>
                                                    <td> @item.ClientHrContact </td>
                                                    <td> @item.ClientName </td>
                                                    <td> @item.JDTiltle.Split("|")[0] </td>
                                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.irfIntId, isClientSelected = true})'>Report</a> </td>
                                                    @if (item.VideoLink != null && item.VideoLink != "")
                                                    {
                                                        <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Video</td>
                                                    }
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.MobileNumber != null)
                                                    {
                                                        <td>@item.MobileNumber</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No Contact</td>
                                                    }
                                                    <td> @item.currentEmployerName </td>
                                                    <td> @item.expectedPerHourRate </td>
                                                    <td> @item.joiningTime </td>
                                                    <td class="wordwrap"> @item.preferredLocation </td>
                                                    <td>@item.staffingAgency</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>
<style>
    .caret {
        display: none !important;
    }

    .multiselect-container {
        width: 100% !important;
    }

    .modal-lg {
        max-width: 690px !important;
    }

    .dropdown-toggle {
        background-color: white !important;
        color: black !important;
        border: 1px solid #ccc !important;
    }

    #StartDate, #EndDate {
        width: 270px;
    }

    .modal-content .modal-body {
        padding-top: 10px;
    }
</style>
<script>
    $(document).ready(function () {
         $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        $("#PrimarySkill").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#CandidateName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#ClientHR").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });

        $("#InterviewDate").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        $("#ClientName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        //FilterInterviews("All");// on page load default dropdownlist value set
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meeting').DataTable();
    });
    function ResetFilter() {
           
             $.ajax({
            type: "POST",
            url: "/Interview/ClientSelectedMeetings",
                 success: function (data) {
                    window.location.href = "/Interview/ResetClientSelectedMeetingsfilters";
                 }
                });
    }
     function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
            var candidateName =  @Html.Raw(Json.Serialize(CandidateName));
            var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
            var interviewDate =  @Html.Raw(Json.Serialize(InterviewDate));
            var clientName =  @Html.Raw(Json.Serialize(ClientName));

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#PrimarySkill").val(primarySkillsArr);
            $("#CandidateName").val(candidateName);
            $("#ClientHR").val(clientHR);
            $("#InterviewDate").val(interviewDate);
            $("#ClientName").val(clientName);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
            url: "/Interview/ClientSelectedMeetings",
            data: form,
                 success: function (data) {
                 }
                });
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

