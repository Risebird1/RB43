@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.Data
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Probable No Show Candidates";
    ViewBag.PageHeader = "Probable No Show Candidates";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}

<script>
    var Header = "<div>Probable No Show Candidates</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=1234" />

<div id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">Probable No Show Candidates</h4></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Email</th>
                                                <th>Mobile Number</th>
                                                <th>Skill Channel</th>
                                                <th>Actual Meeting Status</th>
                                                <th>Channel Owner</th>
                                                <th style="text-align:center">Call</th>
                                                <th style="text-align:center">Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Email</th>
                                                <th>Mobile Number</th>
                                                <th>Skill Channel</th>
                                                <th>Actual Meeting Status</th>
                                                <th>Channel Owner</th>
                                                <th style="text-align:center">Call</th>
                                                <th style="text-align:center">Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @if (Model != null && Model.Count() > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                    <tr>
                                                        <td>@item.interviewDate</td>
                                                        <td>@item.candidateEmail</td>
                                                        <td>@item.MobileNumber</td>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.MeetingStatusStatusDesc</td>
                                                        <td>@item.candidateEmail</td>
                                                        <td>
                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                            {
                                                                <span id="getstatus_12" class="call" data-toggle="tooltip" data-placement="top" onclick="CallButtonClick(@jsonObject,1)" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <div class="btn btn-reschedule shadow btn-xs sharp me-1" title="Reschudule Interview">
                                                                <span onclick="ReschuduleMeeting(@item.InterviewId,'@item.CalendlyLink.Split("=").LastOrDefault()','@item.IRFId','@item.candidateEmail')"><i class="fas fa-calendar-alt" style="color:#fff;font-size:13px;position:relative;top:-1px;" aria-hidden="true"></i></span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->
        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
<!-- end row -->
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

<script src="~/js/twiliocallmaker.js"></script>

<script>

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>
<script>
    function ReschuduleMeeting(interviewid, uniqueid, irfid, candidateEmailid) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to cancel this meeting and reschedule?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Reschedule!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/InterviewScheduler/GenerateCandidatescheuleLink',
                        method: 'POST',
                        data: {
                            'CandidateEmailid': candidateEmailid,
                            'interviewid': interviewid,
                            'uniqueid': uniqueid,
                            'Irfid': irfid,
                            'schedulertype': 1
                        },
                        success: function (result) {
                            location.href = result;
                            //window.open(result, '_blank');
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error rescheduling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                //location.reload(true);
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'reschedule cancelled! :)',
                    'error'
                )
            }
        })
    }
</script>



