@model IEnumerable<Risebird.Entities.Data.Meeting>
<div class="dataloading">
    <div class="toolbar">
        <div style="overflow-x:scroll" class="scrollbar" id="style-2">
            <table id="OpeninterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Slot</th>
                        <th>Duration</th>
                        <th>Candidate Name</th>
                        <th>Resume</th>
                        <th>JD Link</th>
                        <th>Risebird HR</th>
                        <th class="disabled-sorting text-right">Actions</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th>Date</th>
                        <th>Slot</th>
                        <th>Duration</th>
                        <th>Candidate Name</th>
                        <th>Resume</th>
                        <th>JD Link</th>
                        <th>Risebird HR</th>
                        <th class="disabled-sorting text-right">Actions</th>
                    </tr>
                </tfoot>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id=@item.id>
                            <td> @item.interviewDate </td>
                            <td> @item.interviewSlot </td>
                            <td> @item.interviewDuration </td>
                            <td> @item.candidateName</td>
                            @if (item.resumeLink != null && item.resumeLink != "")
                            {
                                <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                            }
                            else
                            {
                                <td>No Resume</td>
                            }
                            @if (item.JDLink != null && item.JDLink != "")
                            {
                                <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                            }
                            else
                            {
                                <td>No JD</td>
                            }

                            <td> @item.risebirdHR</td>
                            <td class="text-right">
                                <span onclick="location.href = '@Url.Action("AssignYourself", "Interview", new { id = item.id,InterviewDate=item.interviewDate,CandidateEmail=item.candidateEmail})'" title="Assign Yourself" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>