@model Risebird.Entities.ViewModel.InterviewReport


@{
    ViewData["Title"] = "Interview Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .table-responsive {
        overflow: hidden;
    }

    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }
</style>

<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
