                                        <div class="multiple_row">
                                            <h2>Proctoring Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered mbn" id="ProctoringTable">
                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Areas</th>
                                                        <th class="table_heading">Number of Red Flags</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            Eyes Movement
                                                        </td>
                                                        <td></td>
                                                    </tr>
                                                    <tr>

                                                        <td>
                                                            <label class="form-control" for="EyesDirection">At the time of code writing or theoretical questions explanations where the eyes are</label>
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(m => m.Proctoring.EyesDirection, new { @class = "form-control text-box single-line", @type = "number", @min = "0", @value = "0" })
                                                        </td>

                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            <label class="form-control" for="EyesReflection">Zoom the candidate to see how many lights reflection in her eyes</label>
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(m => m.Proctoring.EyesReflection, new { @class = "form-control text-box single-line", @type = "number", @min = "0", @value = "0" })
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td>
                                                            Head Movement
                                                        </td>
                                                        <td></td>
