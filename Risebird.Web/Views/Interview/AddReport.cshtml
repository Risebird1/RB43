                                                                        short comments, HR related observations,irrelevant points, observation that is not aligned to score rubric.otherwise, Customer may apply penalty from 10-100%
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                </fieldset>

                                            </div>
                                            <!--report end--->
                                            <!--tech skill start-->
                                            <div class="card" style="margin-bottom:10px;">

                                                <label class="question" for="checkbox_two">
                                                    <label for="checkbox_two">
                                                        <i class="fa fa-user" aria-hidden="true"></i>
