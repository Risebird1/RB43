    function CheckInterviewerComments() {
        var flag = true;
        var counter = 0;
        var meetingStatusValue = document.getElementById("MeetingStatus").value;
        var interviewStatusValue = document.getElementById("InterviewStatus").value;
        if (meetingStatusValue == 6 || meetingStatusValue == 8 || interviewStatusValue == 2 || interviewStatusValue == 4 || interviewStatusValue == 3 || interviewStatusValue == 5) {
            flag = CheckLength(250);
            if (!flag) {
                counter = counter + 1;
            }
        }
        else if (interviewStatusValue == 1) {
            flag = CheckLength(50);
            if (!flag) {
                counter = counter + 1;
            }
        }
        if ($("#SkillSetsevaluate").val() > 1) {
            var meetingStatusValueTwo = document.getElementById("MeetingStatusTwo").value;
            var interviewStatusValueTwo = document.getElementById("InterviewStatusTwo").value;
