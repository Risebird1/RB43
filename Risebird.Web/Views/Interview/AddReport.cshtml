                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Required Level</th>
                                                        <th class="table_heading">Skill Name</th>
                                                        <th class="table_heading">Actual Level</th>
                                                        <th class="table_heading">Required Weightage</th>
                                                        <th class="table_heading">Actual Weightage</th>
                                                    </tr>
                                                </thead>


                                                <tbody>
                                                    @if (Model.TechSkillReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownList("TechSkillReportCollection[" + i + "].ActualLevelId", (SelectList)ViewBag.LevelTech, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value)" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].RequiredLevelId)
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].SkillId)


                                                            </tr>

                                                        }
                                                    }



                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.TechSkillComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.TextBoxFor(m => m.TechSkillComments, new { @class = "form-control text-box single-line" })
                                        </div>

                                        

                                    </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
