                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].Type, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownList("SkillGeneralReportCollection[" + i + "].ActualLevelId", (SelectList)ViewBag.Level, new { @class = "form-control" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
