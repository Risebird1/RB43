@model Risebird.Entities.ViewModel.InterviewReport


@{
    ViewData["Title"] = "Interview Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .table-responsive {
        overflow: hidden;
    }

    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }
</style>

<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.js"></script>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Interview Report
                </a>
            </div>
           
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">                    
                    <div class="card-body">
                        <input type="button" class="btn btn-fill btn-primary pull-right" id="create_pdf" style="margin-top: -61px;" value="Generate PDF" onclick="getPDF()">
                        <form action="/Interview/AddReport" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Interview Report</h2>
                                        </div><!--end of multiple location-->
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })                                        

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.resumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @{
                                                if (Model.resumeLink != null)
                                                {
                                                    <a id="resumeID" target="_blank" title="Resume" href=@Model.resumeLink.ToString().Replace(" ", "%20") class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label">Click here</a>
                                                }
                                            }

                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.JobLevelName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.JobLevelName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(model => model.JobLevelName, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.interviewDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.interviewDate, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">

                                        <video width="320" height="240" controls="controls">
                                            <source src=@Url.Content(Model.VideoLink) type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>

                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="card">
                                            <div class="card-body">
                                                <p class="card-text">Overall Score: <span style="color: black" id="totScore"></span></p>                                               
                                                <div class="col-lg-6 col-md-6 col-sm-6">
                                                    <div id="scoreChart" style="height: 200px; width: 40%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.MeetingStatusList, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                            @Html.DropDownListFor(x => Model.MeetingStatus, Model.MeetingStatusList, "Select Status", htmlAttributes: new { @class = "form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.MeetingStatus, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.InterviewStatusList, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                            @Html.DropDownListFor(x => Model.InterviewStatus, Model.InterviewStatusList, "Select Status", htmlAttributes: new { @class = "form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.InterviewStatus, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6 px-1">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.InterviewerComment, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                            @Html.EditorFor(model => model.InterviewerComment, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.InterviewerComment, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6 px-1">
                                        @*<div class="form-group">*@
                                        @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                        @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control btn" })
                                        @{
                                            if (Model.AudioLink != null)
                                            {
                                                <a id="audioId" target="_blank" title="Audio" href=@Model.AudioLink.ToString().Replace(" ","%20")>Uploaded Audio</a>
                                            }
                                        }
                                        @*</div>*@
                                    </div>

                                    <div class="col-md-6 col-sm-6 px-1">
                                        @*<div class="form-group">*@
                                        @Html.LabelFor(model => model.VideoFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                        @Html.TextBoxFor(model => model.VideoFile, new { type = "file", @class = "form-control btn " })
                                        @{
                                            if (Model.VideoLink != null)
                                            {
                                                <a id="videoId" target="_blank" title="Video" href=@Model.VideoLink.ToString().Replace(" ","%20")>Uploaded Video</a>
                                            }
                                        }

                                        @*</div>*@
                                    </div>
                                </div>

                                <div class="row">

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Report Details</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->
                                    <div class="col-md-3 col-sm-3 pr-1">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.confirmationStatus, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.DropDownListFor(m => m.confirmationStatus, (SelectList)Model.ConfirmationTypeList, new { @class = "form-control" })

                                            @*<select class="form-control text-box single-line" id="confirmationStatus" name="confirmationStatus" type="select" value="">
                                                <option value="Selected">Selected</option>
                                                <option value="Rejected">Rejected</option>
                                            </select>*@
                                            @Html.ValidationMessageFor(model => model.confirmationStatus, "", new { @class = "text-danger" })



                                        </div>
                                    </div>
                                    <div class="col-md-3 col-sm-3 px-1">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Rating, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.DropDownList("Rating", (SelectList)Model.Level, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.OverallScore, "", new { @class = "text-danger" })

                                        </div>

                                    </div>
                                    @*<div class="col-md-3 col-sm-3 px-1">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OverallScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            <input class="form-control text-box single-line" id="OverallScore" name="OverallScore" type="text" value="@Model.OverallScore" readonly="readonly">
                                            @Html.TextBoxFor(model => model.OverallScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(model => model.OverallScore, "", new { @class = "text-danger" })

                                        </div>

                                    </div>*@

                                    
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Questions Discussed</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered mbn" id="QuestionsTable">
                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Questions</th>
                                                        <th class="table_heading">Rating</th>
                                                        <th class="table_heading">Time(Min)</th>
                                                        <th class="table_heading">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.QuestionsCollection == null || Model.QuestionsCollection.Count() == 0)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DropDownList("QuestionsCollection[0].Comment", (SelectList)Model.QuestionsList, new { @class = "form-control text-box single-line" })


                                                                @*@Html.EditorFor(m => m.QuestionsCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" } })*@
                                                                <input class="form-control text-box single-line" id="QuestionsCollection_0__Comment" name="QuestionsCollection[0].Comment" type="text" value="">



                                                            </td>
                                                            <td>
                                                                @Html.DropDownList("QuestionsCollection[0].Type", (SelectList)Model.QuestionsList, new { @class = "form-control" })


                                                                @*<select class="form-control" id="QuestionsCollection_0__RatingId" name="QuestionsCollection[0].RatingId">
                                                                    <option value="1">Poor</option>
                                                                    <option value="2">Average</option>
                                                                    <option value="3">Above Average</option>
                                                                    <option value="4">Excellent</option>
                                                                    <option value="5">Outstanding</option>
                                                                </select>*@
                                                            </td>

                                                            <td>
                                                                <input class="form-control text-box single-line" id="QuestionsCollection_0__Timing" name="QuestionsCollection[0].Timing" type="number" min="1">

                                                                @*@Html.EditorFor(m => m.QuestionsCollection[].Timing, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @min = "1" } })*@

                                                            </td>

                                                            <td>

                                                                <span id="btnPlus" onclick="AddRow()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="DeleteRow(0)" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>

                                                            </td>
                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        for (int i = 0; i < Model.QuestionsCollection.Count(); i++)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @Html.DropDownListFor(m => m.QuestionsCollection[i].Comment, (SelectList)Model.QuestionsList, new { @class = "form-control text-box single-line" })

                                                                    @*@Html.EditorFor(m => m.QuestionsCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" } })*@

                                                                </td>
                                                                <td>

                                                                    @Html.DropDownListFor(m => m.QuestionsCollection[i].RatingId, (SelectList)Model.QuestionsLevelList, new { @class = "form-control" })

                                                                    @*<select class="form-control" id="@("QuestionsCollection_"+i+"__RatingId")" name="QuestionsCollection[@i].RatingId">
                                                                            <option value="1">Poor</option>
                                                                            <option value="2">Average</option>
                                                                            <option value="3">Above Average</option>
                                                                            <option value="4">Excellent</option>
                                                                            <option value="5">Outstanding</option>
                                                                        </select>*@
                                                                </td>

                                                                <td>

                                                                    @Html.EditorFor(m => m.QuestionsCollection[i].Timing, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @min = "1" } })

                                                                </td>

                                                                <td>

                                                                    <span id="btnPlus" onclick="AddRow()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                    <span id="btnMinus" onclick="DeleteRow(0)" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>

                                                                </td>
                                                            </tr>


                                                        }

                                                    }




                                                </tbody>
                                            </table>
                                        </div>
                                    </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Tech Skill Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered mbn" id="SkillTable">
                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Required Level</th>
                                                        <th class="table_heading">Skill Name</th>
                                                        <th class="table_heading">Actual Level</th>
                                                        <th class="table_heading">Required Weightage</th>
                                                        <th class="table_heading">Actual Weightage</th>
                                                    </tr>
                                                </thead>


                                                <tbody>
                                                    @if (Model.TechSkillReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.TechSkillReportCollection[i].ActualLevelId, (SelectList)Model.LevelTech, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value)" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].RequiredLevelId)
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].SkillId)


                                                            </tr>

                                                        }
                                                    }



                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.TechSkillComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.TextBoxFor(m => m.TechSkillComments, new { @class = "form-control text-box single-line" })
                                        </div>



                                    </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>General Skill Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered mbn" id="SkillGeneralTable">
                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Required Level</th>
                                                        <th class="table_heading">Type</th>
                                                        <th class="table_heading">Actual Level</th>
                                                        <th class="table_heading">Required Weightage</th>
                                                        <th class="table_heading">Actual Weightage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.SkillGeneralReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.SkillGeneralReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].Type, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.SkillGeneralReportCollection[i].ActualLevelId, (SelectList)Model.Level, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value)" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                @Html.HiddenFor(m => m.SkillGeneralReportCollection[i].RequiredLevelId)


                                                            </tr>

                                                        }

                                                    }


                                                </tbody>
                                            </table>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.SkillGeneralComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.TextBoxFor(m => m.SkillGeneralComments, new { @class = "form-control text-box single-line" })
                                            </div>


                                        </div>
                                    </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Joinability Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">
                                            <table class="table table-bordered mbn" id="JoinabilityTable">
                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Required Level</th>
                                                        <th class="table_heading">Type</th>
                                                        <th class="table_heading">Actual Level</th>
                                                        <th class="table_heading">Required Weightage</th>
                                                        <th class="table_heading">Actual Weightage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.JoinabilityReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.JoinabilityReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].Type, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.JoinabilityReportCollection[i].ActualLevelId, (SelectList)Model.Level, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value)" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                @Html.HiddenFor(m => m.JoinabilityReportCollection[i].RequiredLevelId)

                                                            </tr>

                                                        }
                                                    }



                                                </tbody>
                                            </table>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.JoinabilityComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.TextBoxFor(m => m.JoinabilityComments, new { @class = "form-control text-box single-line" })
                                            </div>


                                        </div>
                                    </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Selectability Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive">

                                            <table class="table table-bordered mbn" id="SelectabilityTable">
                                                <thead>
                                                    <tr>

                                                        <th class="table_heading">Required Level</th>
                                                        <th class="table_heading">Type</th>
                                                        <th class="table_heading">Actual Level</th>
                                                        <th class="table_heading">Required Weightage</th>
                                                        <th class="table_heading">Actual Weightage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.SelectabilityReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.SelectabilityReportCollection.Count(); i++)
                                                        {
                                                            <tr>

