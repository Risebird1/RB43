    function MeetingStatusChanged(value) {
        if (value != null && value != '') {
            document.getElementById('InterviewerComment').disabled = false;
            document.getElementById("interviewerComment_Error").innerHTML = "";

        }
        else {

            document.getElementById('InterviewerComment').value = '';
            document.getElementById('InterviewerComment').disabled = true;
            document.getElementById("interviewerComment_Error").innerHTML = "Select an appropriate value for Meeting Status above to add comments here.";

        }
        if (value != 2) {
            document.getElementById("meetingStatus_Error").innerHTML = "";
        }
        //for dropped
        if (value == 3) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly use this option only in the case when a meeting was dropped so early (5-10 mins) that a conclusive judgement regarding selection cannot be made.";

        }
        //for dropped with interview status
        if (value == 6 || value == 7 || value == 8) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly use this option only in the case when a meeting was dropped but ran for a duration long enough (20 or more mins) to pass a conclusive judgement regarding selection.";

        }


        if (value != 4) {
            if (value == 6) {
                //dropped but selected
                document.getElementById("InterviewStatus").value = '2';
            }
            else if (value == 7) {
                //dropped but rejected
                document.getElementById("InterviewStatus").value = '3';
            }
            else if (value == 8) {
                //dropped but borderline
                document.getElementById("InterviewStatus").value = '4';
            }

            else {
                document.getElementById("InterviewStatus").value = '';
            }
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById("InterviewStatus").disabled = false;
        }
    }

