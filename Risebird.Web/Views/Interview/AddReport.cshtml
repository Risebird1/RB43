    $(document).ready(function () {

        var meetingStatus = document.getElementById('MeetingStatus').value;
        if (meetingStatus == null || meetingStatus == '') {
            document.getElementById('InterviewerComment').disabled = true;
            document.getElementById("interviewerComment_Error").innerHTML = "Select an appropriate value for Meeting Status  to add comments here.";
            //interview status check
            //document.getElementById("InterviewStatus").value = '';
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById('InterviewerComment').disabled = false;
            document.getElementById("interviewerComment_Error").innerHTML = "";
            if (meetingStatus == 6 || meetingStatus == 7 || meetingStatus == 8) {
                document.getElementById("InterviewStatus").disabled = true;
            }
        }
        var hasDistinctParticipants = '@hasDistinctParticipants';
        if (hasDistinctParticipants != null && hasDistinctParticipants.toLowerCase() == 'false') {
            document.getElementById("InterviewStatusTwo").disabled = true;
