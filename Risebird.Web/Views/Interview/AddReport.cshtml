@model Risebird.Entities.ViewModel.InterviewReport

@{
    ViewData["Title"] = "Interview Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>
<div style="margin-bottom:10px">
    <form action="/Interview/AddReport" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">
        <div class="row">
            <div class="col-md-12 edit-build nova-cont">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h2 class="panel-title">Interview Report</h2>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })

                                            <div class="col-md-6 col-sm-6">
                                                @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                @Html.ValidationMessageFor(model => model.IRFId, "", new { @class = "text-danger" })

                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Report Details</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->
                                    <div class="col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.confirmationStatus, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })

                                            <div class="col-md-6 col-sm-6">
                                                <select class="form-control text-box single-line" id="confirmationStatus" name="confirmationStatus" type="select" value="">
                                                    <option value="Selected">Selected</option>
                                                    <option value="Rejected">Rejected</option>
                                                </select>
                                                @Html.ValidationMessageFor(model => model.confirmationStatus, "", new { @class = "text-danger" })


                                            </div>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.OverallScore, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                            <div class="col-md-6 col-sm-6">
                                                @Html.EditorFor(model => model.OverallScore, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })
                                                @Html.ValidationMessageFor(model => model.OverallScore, "", new { @class = "text-danger" })
                                            </div>
                                        </div>

                                    </div>

                                    <div class="multiple-row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>Questions Discussed</h2>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive">
                                                <table class="table table-bordered mbn" id="QuestionsTable">
                                                    <thead>
                                                        <tr>

                                                            <th class="table_heading">Questions</th>
                                                            <th class="table_heading">Rating</th>
                                                            <th class="table_heading">Time</th>
                                                            <th class="table_heading">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @for (int i = 0; i < Model.QuestionsCollection.Count(); i++)
                                                        {
                                                            <tr>
                                                                <td>

                                                                    @Html.EditorFor(m => m.QuestionsCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                                </td>
                                                                <td>
                                                                    <select class="form-control" id="@("QuestionsCollection_"+i+"__RatingId")" name="QuestionsCollection[@i].RatingId">
                                                                        <option value="1">Poor</option>
                                                                        <option value="2">Average</option>
                                                                        <option value="3">Above Average</option>
                                                                        <option value="4">Excellent</option>
                                                                        <option value="5">Outstanding</option>
                                                                    </select>
                                                                </td>

                                                                <td>

                                                                    @Html.EditorFor(m => m.QuestionsCollection[i].Timing, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @min = "1" } })

                                                                </td>

                                                                <td width="8%">
                                                                    <a class="btn btn-primary border-white btn-sm" id="btnPlus" onclick="AddRow()">
                                                                        <span class="glyphicon glyphicon-plus"></span>
                                                                    </a>

                                                                    <a class="btn border-white btn-sm btn-danger delete-row" id="btnMinus" onclick="DeleteRow(0)">
                                                                        <span class="glyphicon glyphicon-trash"></span>
                                                                    </a>
                                                                </td>
                                                            </tr>


                                                        }


                                                    </tbody>
                                                </table>
                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>

                                    <div class="multiple-row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>Tech Skill Report</h2>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive">
                                                <table class="table table-bordered mbn" id="SkillTable">
                                                    <thead>
                                                        <tr>

                                                            <th class="table_heading">Required Level</th>
                                                            <th class="table_heading">Skill Name</th>
                                                            <th class="table_heading">Actual Level</th>
                                                            <th class="table_heading">Required Weightage</th>
                                                            <th class="table_heading">Actual Weightage</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownList("TechSkillReportCollection[" + i + "].ActualLevelId", (SelectList)ViewBag.Level, new { @class = "form-control" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.EditorFor(m => m.TechSkillReportCollection[i].WeightageActual, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })
                                                                </td>
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].RequiredLevelId)
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].SkillId)


                                                            </tr>

                                                        }


                                                    </tbody>
                                                </table>
                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>

                                    <div class="multiple-row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>General Skill Report</h2>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive">
                                                <table class="table table-bordered mbn" id="SkillGeneralTable">
                                                    <thead>
                                                        <tr>

                                                            <th class="table_heading">Required Level</th>
                                                            <th class="table_heading">Type</th>
                                                            <th class="table_heading">Actual Level</th>
                                                            <th class="table_heading">Required Weightage</th>
                                                            <th class="table_heading">Actual Weightage</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < Model.SkillGeneralReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].Type, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownList("SkillGeneralReportCollection[" + i + "].ActualLevelId", (SelectList)ViewBag.Level, new { @class = "form-control" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SkillGeneralReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.EditorFor(m => m.SkillGeneralReportCollection[i].WeightageActual, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })
                                                                </td>
                                                                @Html.HiddenFor(m => m.SkillGeneralReportCollection[i].RequiredLevelId)


                                                            </tr>

                                                        }


                                                    </tbody>
                                                </table>
                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>

                                    <div class="multiple-row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>Joinability Report</h2>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive">
                                                <table class="table table-bordered mbn" id="JoinabilityTable">
                                                    <thead>
                                                        <tr>

                                                            <th class="table_heading">Required Level</th>
                                                            <th class="table_heading">Type</th>
                                                            <th class="table_heading">Actual Level</th>
                                                            <th class="table_heading">Required Weightage</th>
                                                            <th class="table_heading">Actual Weightage</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < Model.JoinabilityReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].Type, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownList("JoinabilityReportCollection[" + i + "].ActualLevelId", (SelectList)ViewBag.Level, new { @class = "form-control" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.JoinabilityReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.EditorFor(m => m.JoinabilityReportCollection[i].WeightageActual, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })
                                                                </td>

                                                                @Html.HiddenFor(m => m.JoinabilityReportCollection[i].RequiredLevelId)

                                                            </tr>

                                                        }


                                                    </tbody>
                                                </table>
                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>


                                    @Html.HiddenFor(m => m.id);
                                    @Html.HiddenFor(m => m.IRFId)
                                    @Html.HiddenFor(m => m.InterviewId)
                                    <div class="form-group col-sm-12">
                                        <div class="pull-right">
                                            <input type="submit" id="btnUpload" value="Save" class="btn btn btn-primary">
                                        </div>
                                        <div>
                                            <a href="/Interview/MyInterview">Back to List</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }
</style>
<script>
    function AddRow() {
        //var table = document.getElementById("QuestionsTable");
        //var rowCount = table.rows.length;
        //if (rowCount == 6) {
        //    alert("Cannot add more than 5 Tech Skills.");
        //    return;
        //}

        var $ttc = $("#QuestionsTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#QuestionsTable tr").length - 1;

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#QuestionsTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        // Check document for changes
        $.validator.unobtrusive.parse(document);

    }
