@model Risebird.Entities.ViewModel.InterviewReport
@using System.Text.RegularExpressions
@using Risebird.Entities.Enum
@using Microsoft.Extensions.Configuration;

@inject IConfiguration configuration


@{
    ViewData["Title"] = "Interview Report";
    ViewBag.PageHeader = "Interview Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var meetingStatusList = new List<SelectListItem>();
    meetingStatusList = Html.GetEnumSelectList<MeetingStatus>().ToList();
    var interviewStatusList = new List<SelectListItem>();
    var hasDistinctParticipants = Model.HasDistinctParticipants;
    var currentMeetingStatus = Model.MeetingStatus.HasValue ? Model.MeetingStatus.Value : 0;
    var currentInterviewStatus = Model.InterviewStatus.HasValue ? Model.InterviewStatus.Value : 0;

    string loggedInUser = string.Empty;
    string loggedInUserDomain = string.Empty;
    bool showGeneralNoShowStatus = false;

    if (ViewBag.EmailId != null && ViewBag.EmailId != string.Empty)
    {
        loggedInUser = ViewBag.EmailId;
        loggedInUserDomain = loggedInUser.Split("@").LastOrDefault();
    }
    if (!string.IsNullOrEmpty(loggedInUserDomain) && loggedInUserDomain == "risebird.io")
    {
        showGeneralNoShowStatus = true;
    }
    if (ViewBag.profile == "Admin" || ViewBag.profile == "SeniorHR" || ViewBag.profile == "SupportAdmin")
    {
        if (currentMeetingStatus != (int)MeetingStatus.NoShowStatus && !showGeneralNoShowStatus)
        {
            meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.NoShowStatus).ToString()).ToList();
        }
        else
        {
            meetingStatusList = meetingStatusList.ToList();
        }

        interviewStatusList = Html.GetEnumSelectList<InterviewStatus>().ToList();
    }
    else if (ViewBag.profile == "Interviewer")
    {

        if (currentMeetingStatus != (int)MeetingStatus.DroppedBorderLine)
        {
            meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.NoShowInterviewer).ToString() && x.Value != ((int)MeetingStatus.NoShowStatus).ToString() && x.Value != ((int)MeetingStatus.DroppedBorderLine).ToString()).ToList();
        }
        else
        {
            meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.NoShowInterviewer).ToString() && x.Value != ((int)MeetingStatus.NoShowStatus).ToString()).ToList();
        }

        // if (currentInterviewStatus != (int)InterviewStatus.BorderLine)
        // {
        //     interviewStatusList = Html.GetEnumSelectList<InterviewStatus>().Where(x => x.Value != ((int)InterviewStatus.BorderLine).ToString()).ToList();
        // }
        // else
        // {
        interviewStatusList = Html.GetEnumSelectList<InterviewStatus>().ToList();
        // }

        if (Model.HasDistinctParticipants == false)
        {
            meetingStatusList = Html.GetEnumSelectList<MeetingStatus>().ToList().Where(x => x.Value != ((int)MeetingStatus.NoShowInterviewer).ToString() && x.Value != ((int)MeetingStatus.NoShow).ToString() && x.Value != ((int)MeetingStatus.NoShowStatus).ToString()).ToList();

        }
        //var timeSpan = DateTime.Now - Convert.ToDateTime(Model.interviewDate);
        //if (timeSpan.TotalMinutes > 15)
        //{
        //    meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.NoShow).ToString() && x.Value != ((int)MeetingStatus.NoShowStatus).ToString()).ToList();
        //}

    }
    else
    {

        if (currentMeetingStatus != (int)MeetingStatus.NoShowStatus && !showGeneralNoShowStatus)
        {
            meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.NoShowInterviewer).ToString() && x.Value != ((int)MeetingStatus.NoShowStatus).ToString()).ToList();
        }
        else
        {
            meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.NoShowInterviewer).ToString()).ToList();
        }

        interviewStatusList = Html.GetEnumSelectList<InterviewStatus>().ToList();

    }

    if (showGeneralNoShowStatus)
    {
        meetingStatusList = Html.GetEnumSelectList<MeetingStatus>().ToList();
    }
    meetingStatusList = meetingStatusList.Where(x => x.Value != ((int)MeetingStatus.DroppedBorderLine).ToString()).ToList();
    if (Model.ClientId == 149 || Model.ClientId == 151 || Model.ClientId == 67 || Model.ClientId == 81 || Model.ClientId == 171 || Model.ClientId == 172)
    {
        interviewStatusList = interviewStatusList.Where(x => x.Value != ((int)InterviewStatus.BorderLine).ToString() && x.Value != ((int)InterviewStatus.MarginallyRejected).ToString()).ToList();
    }

}
