                                                        <input type="checkbox" id="checkboxTwentyTwo" name="SuspiciousEnvironment" checked onclick="ChangeCheckBox('SuspiciousEnvironment')" value="Strange sounds in the background" />

                                                        <label for="checkboxTwentyTwo">
                                                            Strange sounds in the background
                                                        </label>
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" id="checkboxTwentyTwo" name="SuspiciousEnvironment" onclick="ChangeCheckBox('SuspiciousEnvironment')" value="Strange sounds in the background" />

                                                        <label for="checkboxTwentyTwo">
                                                            Strange sounds in the background
                                                        </label>
                                                    }

                                                </li>

                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
                <div class="col-md-12 nopad">
                    <div class="mc-button-area" style="margin-top:20px;padding: 10px 0px 0px 0px;border-top: 1px #ccc solid;">
                        @if (Model.type != "Report")
                        {
                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" value="Submit">Submit</button>
                        }
                        else
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onclick="SaveReportvalues()" value="Submit">Submit</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<script>
    $(document).ready(function () {
        checkProxy();
    });
    function ChangeCheckBox(groupName) {
        var result = $('input[name="' + groupName + '"]:checked');
        var resultString = '';
        if (result.length > 0) {
            result.each(function () {
                if (resultString == '') {
                    resultString += $(this).val();
                } else {
                    resultString += ";" + $(this).val();
                }
            });
            $('#' + groupName).val(resultString);
        }
        else {
            $('#' + groupName).val("");
        }
        CountCheckBox();
    }
    function CountCheckBox() {
        var countcheck = 0;
        $('#proxy-content').find(':checkbox').each(function () {
            var vlucheck = $(this)[0].checked;
            if (vlucheck) {
                countcheck = countcheck + 1;
            }
        });
        $("#ProxyvotingCount").val(countcheck);
    }
</script>

<script>
    function checkProxy() {
        var checkBox = document.getElementById("isProxyCandidate");
        var text = document.getElementById("proxy-content");
       
        if (checkBox.checked == true) {
            text.style.display = "block";
        } else {
            text.style.display = "none";
        }
    }
    function SaveReportvalues() {
        closeProxyModel();
        if (document.getElementById("isProxyCandidate").checked) {
            $("#Proctoring_isProxyCandidate").val(true);
        } else {
            $("#Proctoring_isProxyCandidate").val(false);
        }
        $("#Proctoring_EyeMovement").val($("#EyeMovement").val());
        $("#Proctoring_LipsMovement").val($("#LipsMovement").val());
        $("#Proctoring_CandidateDesktop").val($("#CandidateDesktop").val());
        $("#Proctoring_LinkedinPhoto").val($("#LinkedinPhoto").val());
        $("#Proctoring_HeadMovement").val($("#HeadMovement").val());
        $("#Proctoring_LatencyCheck").val($("#LatencyCheck").val());
        $("#Proctoring_VoiceImpostering").val($("#VoiceImpostering").val());
        $("#Proctoring_SusipicousDevices").val($("#SusipicousDevices").val());
        $("#Proctoring_SuspiciousVoice").val($("#SuspiciousVoice").val());
        $("#Proctoring_SuspiciousEnvironment").val($("#SuspiciousEnvironment").val());
        $("#Proctoring_IsQCdone").val($("#IsQCdone").val());
    }
</script>
