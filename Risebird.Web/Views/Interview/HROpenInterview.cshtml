function bindPages(pagecount, startpage, endpage, totalcount) {
var html = '';
html += '<div class="pagination-container">';
html += '<ul class="pagination">';
for (var i = 1; i <= pagecount; i++) {
    if (i == 1) {
        html += '   <li class="active"><span>1</span></li>';
    } else if (i <= 10) {
        html += '<li><a href="/Interview/HROpenInterview?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
    } else if (i == 11) {
        html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
        html += '<li class="PagedList-skipToNext"><a href="/Interview/HROpenInterview?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
        html += '<li class="PagedList-skipToLast"><a href="/Interview/HROpenInterview?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
    } else {
        break;
    }
    if (pagecount <= 10 && i == pagecount && i != 1) {
        html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
        html += '<li class="PagedList-skipToNext"><a href="/Interview/HROpenInterview?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
        html += '<li class="PagedList-skipToLast"><a href="/Interview/HROpenInterview?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
    }
}
html += '</ul>';
html += '</div>';
$("#divmeetingpages").empty().html(html);
var pagestartdetails = '';
pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
$("#divmeetingentries").empty().html(pagestartdetails);

}
</script>

<script>

    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
            $("#" + id).attr("data-changes", "1");
        }
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#OpeninterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#OpeninterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#OpeninterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function FilterInterviews(filterValue) {

        $.ajax({
            type: "GET",
            url: "/Interview/GetFilteredOpenInterviews",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#OpeninterviewList').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#OpeninterviewList').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>
