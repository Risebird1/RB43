        document.getElementById("idHandsOncoding").checked = item.HandsOnCoding;
        document.getElementById("idBias").checked = item.BiasAndCandidateHandling;
        document.getElementById("idTechnicalCommunication").checked = item.TechnicalCommunicationSkills;
        document.getElementById("idChaptering").checked = item.ChapteringCompleted;
        document.getElementById("idQuestionsFilled").checked = item.QuestionsFilled;
        document.getElementById("idTechSkillsMetric").checked = item.TechSkillsMetric;
        document.getElementById("idSelectabilityMetric").checked = item.SelectabilityMetric;
        document.getElementById("idJoinabilityMetric").checked = item.JoinabilityMetric;
        document.getElementById("idGeneralSkillMetric").checked = item.GeneralSkillMetric;
        document.getElementById("idCommentsfilled").checked = item.CommentsFilled;
        document.getElementById("idMeaningfulAssessments").checked = item.MeaningfulAssessments;
        document.getElementById("idGrammar").checked = item.CorrectEnglishGrammar;
        document.getElementById("idProctoring").checked = item.ProctoringReportFilled;

        $.ajax({
            type: "GET",
            url: "/Interview/getQCStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#qcDropdown").html(s);
                if (item.QCStatus != null) {
                    $("#qcDropdown").val(item.QCStatus);
                }
                else {
                    $("#qcDropdown").val("");

                }
            }
        });


    }


    function SavePopUp() {
        var comment = document.getElementById("qcComments").value;
        var qcStatus = document.getElementById("qcDropdown").value;
        if (qcStatus == null || qcStatus=="") {
            document.getElementById("error_QcStatus").innerHTML = "Please select a status";
            document.getElementById("error_QcStatus").focus();
            return;
        }
        else {
            document.getElementById("error_QcStatus").innerHTML = "";
        }

        var FraudLipSync = document.getElementById("idFraudLipSync").checked;
        var QuestionsRelevance = document.getElementById("idQuestionsRelevance").checked;
        var HandsOnCoding = document.getElementById("idHandsOncoding").checked;
        var BiasAndCandidateHandling = document.getElementById("idBias").checked;
        var TechnicalCommunicationSkills = document.getElementById("idTechnicalCommunication").checked;
        var ChapteringCompleted = document.getElementById("idChaptering").checked;
        var QuestionsFilled = document.getElementById("idQuestionsFilled").checked;
        var TechSkillsMetric = document.getElementById("idTechSkillsMetric").checked;
        var SelectabilityMetric = document.getElementById("idSelectabilityMetric").checked;
        var JoinabilityMetric = document.getElementById("idJoinabilityMetric").checked;
        var GeneralSkillMetric = document.getElementById("idGeneralSkillMetric").checked;
        var CommentsFilled = document.getElementById("idCommentsfilled").checked;
        var MeaningfulAssessments = document.getElementById("idMeaningfulAssessments").checked;
        var CorrectEnglishGrammar = document.getElementById("idGrammar").checked;
        var ProctoringReportFilled = document.getElementById("idProctoring").checked;

        var id = imid;

        $.ajax({
            type: "GET",
            url: "/Interview/SaveQCFeedback",
            data: {
                'imid': id, 'qcStatus': qcStatus, 'comment': comment, 'FraudLipSync': FraudLipSync, 'QuestionsRelevance': QuestionsRelevance, 'HandsOnCoding': HandsOnCoding, 'BiasAndCandidateHandling': BiasAndCandidateHandling, 'TechnicalCommunicationSkills': TechnicalCommunicationSkills, 'ChapteringCompleted': ChapteringCompleted,
                'QuestionsFilled': QuestionsFilled, 'TechSkillsMetric': TechSkillsMetric, 'SelectabilityMetric': SelectabilityMetric, 'JoinabilityMetric': JoinabilityMetric,
                'GeneralSkillMetric': GeneralSkillMetric, 'CommentsFilled': CommentsFilled, 'MeaningfulAssessments': MeaningfulAssessments, 'CorrectEnglishGrammar': CorrectEnglishGrammar,
                'ProctoringReportFilled': ProctoringReportFilled, 'oldQcStatus': oldQcStatus
            },
            success: function (data) {

                location.reload(true);

            }
        });
    }

</script>




<script>
    function checkStartDate(val) {

        if (val == "") {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var StartDate = new Date(year, month, date);

        var endDateValue = document.getElementById("EndDate").value;
        var yearEnd = endDateValue.substring(0, 4);
        var monthEnd = parseInt(endDateValue.substring(5, 7)) - 1;
        var dateEnd = endDateValue.substring(8, 10);
        var EndDate = new Date(yearEnd, monthEnd, dateEnd);


        if (StartDate > EndDate) {
            document.getElementById("submitFilter").disabled = true;
            document.getElementById("startDateCheck").style.display = "block";
            document.getElementById("startDateCheck").innerHTML = "Start Date should be less than or equal to End Date";
            document.getElementById("StartDate").focus();
            return;
        }
        else {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;

        }


    }

    function checkEndDate(val) {

        if (val == "") {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }
        var startDateValue = document.getElementById("StartDate").value;
        if (startDateValue == null || startDateValue == "") {
            return;
        }

        //end Date object creation
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var endDate = new Date(year, month, date);

        //start Date object creation


        var yearStart = startDateValue.substring(0, 4);
        var monthStart = parseInt(startDateValue.substring(5, 7)) - 1;
        var dateStart = startDateValue.substring(8, 10);
        var startDate = new Date(yearStart, monthStart, dateStart);


        if (endDate <= startDate) {
            document.getElementById("submitFilter").disabled = true;
            document.getElementById("endDateCheck").style.display = "block";
            document.getElementById("endDateCheck").innerHTML = "End Date should be greater than Start Date";
            document.getElementById("EndDate").focus();
            return;
        }
        else {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }

    }
</script>


