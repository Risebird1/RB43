@model List<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "MyQualityControlledInterviews";
}
<script>
    var Header = "<div>My QC Interviews</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<div class="main-panel" id="main-panel">
    <div class="mt50">
        <div class="col-md-12 nopad" style="margin:0px 0px 8px 0px;padding:5px 0px!important">
            <div class="mobile-view">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        <h4 class="card-title"></h4>
                        <h4 class="card-title">My QC Interviews</h4>
                    </div>
                </div>
            </div>
            <div class="pull-left">
                @if (ViewBag.Type == "Pending")
                {
                    <div class="feedback-tab-ac" onclick="Changeurldetails('Pending')"><strong>Pending QC</strong></div>
                    <div class="feedback-tab" onclick="Changeurldetails('Completed')"><strong>Completed QC</strong></div>
                }
                else if (ViewBag.Type == "Completed")
                {
                    <div class="feedback-tab" onclick="Changeurldetails('Pending')"><strong>Pending QC</strong></div>
                    <div class="feedback-tab-ac" onclick="Changeurldetails('Completed')"><strong>Completed QC</strong></div>
                }
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="scrollbar int-table" id="style-2">
                                    <div id="tableID" class="second ">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Interviewer</th>
                                                    <th>Candidate</th>
                                                    <th>Instruction</th>
                                                    @* <th>Channel Owner</th> *@
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Interviewer</th>
                                                    <th>Candidate</th>
                                                    <th>Instruction</th>
                                                    @* <th>Channel Owner</th> *@
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        <td>@item.NickName</td>
                                                        <td>@item.candidateName</td>
                                                        @if (item.FeedbackAudioLink != null && item.FeedbackAudioLink != "")
                                                        {
                                                            <td>  <a id="jdlinkId" target="_blank" title="Interview Instruction" href=@item.FeedbackAudioLink>Instruction</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @* <td>@item.ChannelOwner</td> *@
                                                        <td class="text-center">
                                                            <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="QC Form">
                                                                <div onclick="PaymentSLADetails('@item.imid','@item.candidateEmail','@item.interviewer',false,'MYQC',false,true)" title="QC Form" class="mdc-fab__icon material-icons">
                                                                    <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg>
                                                                </div>
                                                            </button>
                                                             @if(item.IsAIInterview)
                                                                        {
                                                                            <span class="interview_9">
                                                                                <a style="text-decoration:none" target="_blank" href='@Url.Action("Report", "AIInterview" , new { seId = item.SessionId})'>
                                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Report" style="position:relative;top:-3px;">
                                                                                        <span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                                                    </button>
                                                                                </a>
                                                                            </span> //Remember : Change the report icon for an ai interview report. A normal report and an AI report should be identifiable by their distinct icons.
                                                                        }
                                                                        else{
                                                            <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.imid, irfId=item.irfIntId})">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Client Interview Report">
                                                                    <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                </button>
                                                            </a>
                                                                        }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @{
                var aiCodeItems = ViewBag.AICodeInterviewQCItems as List<Risebird.Entities.ViewModel.AICodeInterviewQCItemVM>
                    ?? new List<Risebird.Entities.ViewModel.AICodeInterviewQCItemVM>();

                Func<int, string> aiSeverityLabel = severity =>
                    severity == 3 ? "Critical" : severity == 2 ? "Major" : severity == 1 ? "Minor" : "Informational";
                Func<int, string> aiSeverityStyle = severity =>
                    severity == 3 ? "background:#c0392b;color:#fff;"
                    : severity == 2 ? "background:#ffe9e5;color:#c0392b;"
                    : severity == 1 ? "background:#fff4e5;color:#b26a00;"
                    : "background:#eef2f7;color:#52606d;";
            }
            @if (aiCodeItems.Count > 0)
            {
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="card-header bg-w clearfix">
                                <div class="pull-left">
                                    <h4 class="card-title">My AI Code Interview Reviews</h4>
                                </div>
                            </div>
                            <div class="toolbar">
                                <div class="scrollbar int-table" id="style-3">
                                    <div class="second">
                                        <table id="aiCodeQCTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate</th>
                                                    <th>Discrepancy</th>
                                                    <th>Max Severity</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in aiCodeItems)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        <td>
                                                            @item.candidateName
                                                            <div style="font-size:11px;color:#7b8794;">@item.JDTiltle</div>
                                                        </td>
                                                        <td>
                                                            @if (!item.IsSubmitted)
                                                            {
                                                                <span style="font-size:11px;color:#7b8794;">Not reviewed yet</span>
                                                            }
                                                            else if (item.WasDiscrepancyFound == true)
                                                            {
                                                                <span style="display:inline-block;font-size:11px;font-weight:700;padding:3px 8px;border-radius:10px;background:#ffe9e5;color:#c0392b;">Yes</span>
                                                            }
                                                            else
                                                            {
                                                                <span style="display:inline-block;font-size:11px;font-weight:700;padding:3px 8px;border-radius:10px;background:#e8f7ef;color:#1e7d44;">Agreed with AI</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.IsSubmitted)
                                                            {
                                                                <span style="display:inline-block;font-size:11px;font-weight:700;padding:3px 8px;border-radius:10px;@aiSeverityStyle(item.MaxSeverity ?? 0)">
                                                                    @aiSeverityLabel(item.MaxSeverity ?? 0)
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span style="font-size:11px;color:#7b8794;">&mdash;</span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            <a style="text-decoration:none"
                                                               href="@Url.Action("ExpertReport", "AICodeInterviewQC", new { seId = item.SessionId })">
                                                                <button type="button" class="clickhere_btn" style="padding:3px 10px;">
                                                                    <font style="font-family: Roboto, sans-serif; font-size:12px;">
                                                                        @(item.IsSubmitted ? "View review" : "Review AI report")
                                                                    </font>
                                                                </button>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Common/_PaymentSLA.cshtml")
<script>

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });

        if ($('#aiCodeQCTable').length) {
            $('#aiCodeQCTable').DataTable({
                "pagingType": "full_numbers",
                "lengthMenu": [
                    [10, 25, 50, -1],
                    [10, 25, 50, "All"]
                ],
                order: [],
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records",
                }
            });
        }
    }
    function Changeurldetails(type) {
        window.location.href = "/Interview/MyQualityControlledInterviews?type=" + type;
    }

</script>