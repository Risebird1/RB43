        //document.getElementById("IsApproved").checked = item.IsApproved;
        document.getElementById("qcComments").value = item.QCComment;

        
        $.ajax({
            type: "GET",
            url: "/Interview/getQCStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#qcDropdown").html(s);
                if (item.QCStatus != null) {
                    $("#qcDropdown").val(item.QCStatus);
                }
                else {
                    $("#qcDropdown").val("-1");

                }
            }
        });

       
    }
    

