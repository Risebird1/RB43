                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Job Level</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                @*<th>Candidate Contact</th>*@
                                                <th>Resume</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>JD Link</th>
                                                <th>Zoom ID</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                                @*<th style="text-align:center">Call</th>*@
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Job Level</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                @*<th>Candidate Contact</th>*@
                                                <th>Resume</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>JD Link</th>
                                                <th>Zoom ID</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                                @*<th style="text-align:center">Call</th>*@
                                            </tr>
                                        </tfoot>
                                        <tbody>


                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                <tr id=@item.id>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.interviewSlot </td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.JobLevelDesc </td>
                                                    <td> @item.candidateName</td>
                                                    <td> @Regex.Replace(@item.candidateEmail, "[a-zA-Z0-9.-]", "*")</td>

                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    <td>@item.MeetingStatusDesc</td>
                                                    <td>@item.InterviewStatusDesc</td>

                                                    @if (item.JDLink != null && item.JDLink != "")
