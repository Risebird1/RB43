        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
            var rFID =  @Html.Raw(Json.Serialize(RFID));
            var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
            var confirmationStatus =  @Html.Raw(Json.Serialize(ConfirmationStatus));
            var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
            var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
            var selectionStatus = @Html.Raw(Json.Serialize(SelectionStatus));
            var approvalStatus = @Html.Raw(Json.Serialize(ApprovalStatus));
            var joiningStatus = @Html.Raw(Json.Serialize(JoiningStatus));
            var offerStatus = @Html.Raw(Json.Serialize(OfferStatus));
            var clientName = @Html.Raw(Json.Serialize(ClientName));
            @*var interviewer =  @Html.Raw(Json.Serialize(Interviewer));*@

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#PrimarySkill").val(primarySkillsArr);
            $("#RFID").val(rFID);
            $("#ClientHR").val(clientHR);
            $("#ConfirmationStatus").val(confirmationStatus);
            $("#MeetingStatus").val(meetingStatus);
            $("#InterviewStatus").val(interviewStatus);
            $("#ClientName").val(clientName);
            $("#SelectionStatus").val(selectionStatus);
            $("#ApprovalStatus").val(approvalStatus);
            $("#JoiningStatus").val(joiningStatus);
            $("#OfferStatus").val(offerStatus);
            //$("#Interviewer").val(interviewer);
            var form = $("#form").serialize();

    }

</script>


<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function FilterInterviews(filterValue) {
        $.ajax({
            type: "GET",
            url: "/Interview/GetClientFilteredMeetings",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '' && filterValue == 'Next Seven Days') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'All') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>
