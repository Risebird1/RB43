@model IEnumerable<Risebird.Entities.ViewModel.InterviewRequestVM>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interview Request";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] RFID = new string[] { };
    string[] ArchiveStatus = new string[] { };
    string[] ClientName = new string[] { };
    string[] SubscriptionStatus = new string[] { };
    string[] ClientRole = new string[] { };
    string[] PrimarySkill = new string[] { };
    string[] EndClientName = new string[] { };

}
@if (HttpContextAccessor.HttpContext.Session.GetString("InterviewRequestfilters") != null)
{
    filter = JsonConvert.DeserializeObject<IRFFilter>
    (HttpContextAccessor.HttpContext.Session.GetString("InterviewRequestfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ArchiveStatus = filter.ArchiveStatus != null ? filter.ArchiveStatus : new string[] { };
    SubscriptionStatus = filter.SubscriptionStatus != null ? filter.SubscriptionStatus : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    ClientRole = filter.ClientRole != null ? filter.ClientRole : new string[] { };
    PrimarySkill = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    EndClientName = filter.EndClientName != null ? filter.EndClientName : new string[] { };
}
<script>
    var Header = "<div id='skill_1'>Interview Request</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
