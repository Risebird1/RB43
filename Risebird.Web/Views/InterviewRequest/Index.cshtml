            url: "/InterviewRequest/FetchCoordinators",
            success: function (data) {
                $("#txthidEventid").val(id);
                var modal = document.getElementById("AssignationModel");
                modal.style.display = "block";
                $("#txtCoordinator").empty();
                $("#txtCoordinator").append($("<option></option>").val("").html("Select"));
                for (var i = 0; i < data.result.length; i++) {
                    $("#txtCoordinator").append($("<option></option>").val(data.result[i].value).html(data.result[i].text));
                }
            }
        });
    }
    function closeAssignationModel() {
        var modal = document.getElementById("AssignationModel");
        modal.style.display = "none";
    }
    function SubmitAssign() {
        var coordinator = $("#txtCoordinator").val();
        if (parseInt(coordinator) > 0) {
            $.ajax({
                type: "POST",
                url: "/InterviewRequest/AssignCoordinator",
                data: { userid: coordinator, id: $("#txthidEventid").val() },
                success: function (data) {
                    closeAssignationModel();
                    window.location.href = "/InterviewRequest/Index";

                }
            });
        } else {
            swal.fire("Please select a co-ordinator.");
        }
    }
    function markedCompleted(id) {
        $("#txthidmarkedEventid").val(id);
        var modal = document.getElementById("MarkCompleteModel");
        modal.style.display = "block";
    }
    function closeMarkCompleteModel() {
        var modal = document.getElementById("MarkCompleteModel");
        modal.style.display = "none";
    }
    function SubmitSkillChannel() {
        var SkillChannel = $("#txtskillChannelid").val();
        if (SkillChannel.trim() != "") {
            window.location.href = "/InterviewRequest/SetIRFCreated?id=" + $("#txthidmarkedEventid").val() + "&IRFId=" + SkillChannel;
        } else {
            swal.fire("Please select a co-ordinator.");
        }
    }
</script>


<script>


    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>