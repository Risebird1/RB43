        //window.onload = my_code();
    </script>
}

<script>
    function AddRow() {
        var table = document.getElementById("SkillTable");
        var rowCount = table.rows.length;
        if (rowCount < 6) {
            var $ttc = $("#SkillTable").find("tbody tr:last");
            var $tr = $ttc.clone();
            var trIndexReplaced = $("#SkillTable tr").length - 1;

            $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
                var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
                return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
            }).attr("id", function () { // change id also
                var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
                return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
            });
            $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
                var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
                return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
            })
            // reset fields in the new row
            $tr.find("select").val("");
            $tr.find("input[type=text]").val("");
            $tr.find("input[type=hidden]").val("");
            $tr.find("a").val("");
            // add cloned row as last row
            $("#SkillTable").find("tbody tr:last").after($tr);
            // Find the affected form
            var $form = $tr.closest("FORM");
            // Unbind existing validation
            $form.unbind();
            $form.data("validator", null);
        } else {
            document.getElementById("SkillCollection_WeightageError").innerHTML = "Add max 5 skills only.";
        }
    }
    function DeleteRowSkills(element, collectionName, tdOne, tdTwo, tdThree, tdFour) {
        if ($(element).parents('tbody').find('tr').length === 1) {
            alert('Must have atleast one Row');
            return false;
        }
        else {
            //document.getElementById("btnUpload").disabled = false;
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    var elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;
                    var elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;
                }
            }
        }
    }
    function checkRowcount() {
        var table = document.getElementById("SkillTable");
        var rowCount = table.rows.length;
        if (rowCount < 3) {
            document.getElementById("SkillCollection_WeightageError").innerHTML = "Atleast add two Skills";
            return false;
        }
        var drpdowns1 = $('[id^=TechSkill][id$="SkillId"]');
        for (i = 0; i < drpdowns1.length; i++) {
            var interviewId = $("#" + drpdowns1[i].id).val();
            if (interviewId == '' || interviewId == null) {
                document.getElementById("SkillCollection_WeightageError").innerHTML = "Skill field should not be blank.";
                return false;
            }
        }
        return true;
    }
    function checkValidation() {
        if (checkRowcount() && CheckTotalWeightage()) {
            return true;
        }
        else {
            return false;
        }
    }
    function CheckTotalWeightage() {
        var inCorrectCount = 0;
        var items = $('[id^=TechSkill][id$="Weightage"]');
        var total = 0;
        for (j = 0; j < items.length; j++) {
            var total = total + parseInt($("#" + items[j].id).val());
        }
        if (total != 100) {
            inCorrectCount = inCorrectCount + 1;
            document.getElementById("SkillCollection_WeightageError").innerHTML = "Weightage total should be equal to 100.";
            return false;
        }
        else {
            document.getElementById("SkillCollection_WeightageError").innerHTML = "";
            return true;
        }
    }
    function UpdateAssessmentGroup(isCategoryChanged) {
        var categoryId = $("#Categoryid").val();
        if (isCategoryChanged == true && (categoryId != null && categoryId != '0' && categoryId != 0)) {
            GetPrimarySkillsBasedOnCategory(categoryId);
        }
        var companytype = $("#CompanyTypes").val();
        var countryid = $("#Country").val();
        var jobLevelid = $("#JobLevel").val();
        //var competencyid = $("#CompetencyLevel").val();
        var employmentType = $("#EmploymentType").val();
        var difficultyLevel = $("#DifficultyLevel").val();
        var primarySkills = $("#PrimarySkills").val();
        var primarySkillJoined = '';

        if (primarySkills != null) {
            primarySkillJoined = primarySkills.join();
        }
        $.ajax({
            type: "GET",
            url: "/InterviewRequest/GetAssessmentGroupsByCategory",
            data: { 'categoryId': categoryId, 'companytype': companytype, 'countryid': countryid, 'jobLevelid': jobLevelid, 'employmentType': employmentType, 'difficultyLevel': difficultyLevel, 'primarySkills': primarySkillJoined },
            success: function (data) {
                if (data != null) {
                    document.getElementById('error_AssessmentGroupId').innerHTML = '';
                    bindAssessmentGroupDropDown(data);
                    SkillsAssessmentGroupChanged(0);
                }
                else {
                    $("#AssessmentGroupId option").remove();
                    document.getElementById('error_AssessmentGroupId').innerHTML = 'No Assessment Groups for the selected combination above!';
                }

            }
        });
    }

    function bindAssessmentGroupDropDown(data) {
        var drpdwnId = $("#AssessmentGroupId");
        if (data.length > 0) {
            $("#AssessmentGroupId option").remove();
            var option = $("<option />");
            option.html("Select");
            option.val();
            drpdwnId.append(option);
            $(data).each(function () {
                var option = $("<option />");
                option.html(this.text);
                option.val(this.value);
                drpdwnId.append(option);
            });
        }
    }
    function ClientChanged(clientId) {
        $.ajax({
            type: "GET",
            url: "/IRF/GetClientUser",
            data: { 'clientId': clientId },
            success: function (data) {
                var drpbilling = $("#BillingOwner");
                $("#BillingOwner option").remove();
                var option = $("<option />");
                option.html("Select");
                option.val();
                drpbilling.append(option);
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");
                        option.html(this.text);
                        option.val(this.value);
                        drpbilling.append(option);
                    });
                }
            }
        });
    }
    function SkillsAssessmentGroupChanged(assessmentgroupid) {
        $.ajax({
            type: "GET",
            url: "/InterviewRequest/GetSkillsByAssessmentGroups",
            data: { 'assessmentgroupid': assessmentgroupid },
            success: function (data) {
                var drpdowns = $('[id^="TechSkills"][id$="SkillId"]');
                for (i = 0; i < drpdowns.length; i++) {
                    $("#" + drpdowns[i].id + " option").remove();
                }
                for (i = 0; i < drpdowns.length; i++) {
                    $(data).each(function () {
                        var option = $("<option />");
                        option.html(this.text);
                        option.val(this.value);
                        $("#" + drpdowns[i].id).append(option);
                    });
                }
            }
        });
    }
    function GetPrimarySkillsBasedOnCategory(categoryId) {
        $.ajax({
            type: "GET",
            url: "/InterviewRequest/GetPrimarySkillsBasedOnCategory",
            data: { 'categoryId': categoryId },
            async: false,
            success: function (data) {
                var drpPrimarySkills = $("#PrimarySkills");
                $("#PrimarySkills option").remove();
                //var option = $("<option />");
                //option.html("Select");
                //option.val();
                //drpPrimarySkills.append(option);
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");
                        option.html(this);
                        option.val(this);
                        drpPrimarySkills.append(option);
                    });
                }
            }
        });
    }
</script>

