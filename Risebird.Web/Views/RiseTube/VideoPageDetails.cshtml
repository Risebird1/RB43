                                                                                                                        @Html.TextBoxFor(m => m.IreportModel.QuestionsCollection[i].Comment, new { ID = "drop", @class = "dropques form-control text-box single-line", @readonly = "readonly", onmouseover = "dropDwnToolTips(this)" })

                                                                                                                    </td>
                                                                                                                    <td>
                                                                                                                        @Html.TextBoxFor(m => m.IreportModel.QuestionsCollection[i].SkillName, new { ID = "drop", @class = "dropques form-control text-box single-line", @readonly = "readonly", onmouseover = "dropDwnToolTips(this)" })
                                                                                                                    </td>
                                                                                                                    <td>
                                                                                                                        @Html.DropDownListFor(m => m.IreportModel.QuestionsCollection[i].RatingId, (SelectList)Model.IreportModel.QuestionsLevelList, new { @class = "form-control droprating" })
                                                                                                                    </td>
                                                                                                                </tr>
                                                                                                            }
                                                                                                        }
                                                                                                    }




                                                                                                </tbody>
                                                                                            </table>
                                                                                        }
                                                                                    </div>
