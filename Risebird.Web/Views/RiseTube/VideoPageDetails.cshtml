                                                                                            @Html.LabelFor(model => model.IreportModel.currentEmployerName, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                                                                            @Html.TextBoxFor(m => m.IreportModel.currentEmployerName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                        </div>
                                                                                    </div>

                                                                                    <div class="col-md-6 col-sm-6">
                                                                                        <div class="form-group">
                                                                                            @Html.LabelFor(model => model.IreportModel.joiningTime, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                                                                            @Html.TextBoxFor(m => m.IreportModel.joiningTime, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="row">
                                                                                    <div class="col-md-6 col-sm-6">
                                                                                        <div class="form-group">
                                                                                            @Html.LabelFor(model => model.IreportModel.resumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 upload-label" })

                                                                                            @{
                                                                                                if (Model.IreportModel.resumeLink != null && Model.IreportModel.resumeLink != "")
                                                                                                { <a id="resumeID" target="_blank" title="Resume" href=@Model.IreportModel.resumeLink.ToString().Replace(" ", " %20") class=" col-lg-12 col-md-12 col-sm-12 col-xs-12 click">Click here</a> }
                                                                                            }
                                                                                        </div>
                                                                                    </div>



                                                                                </div>


                                                                            </div>

                                                                            <h3 class="d_active tab_drawer_heading" rel="link3">Tech Skill</h3>

                                                                            <div class="tab-pane tab_content" id="link3">
