                                                                                                {
                                                                                                    <label>Not Yet Verified</label>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    @Html.TextBoxFor(m => m.IreportModel.InterviewBiometryScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                }

                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                </div>


                                                                            </div>
                                                                            <!-- #tab1 -->
                                                                            <h3 class="tab_drawer_heading" rel="link2">Candidate Details</h3>
