            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
        });
        $(".join-time").each(function () {
            if ($(this).text().length > 10) {
                $(this).text($(this).text().substr(0, 10) + "...")
                $('[role="data-tooltip"]').css("visibility", "visible");
            }
            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
        });
    });
</script>
<script>

    jQuery(document).ready(function ($) {
        if ($("#txtVideostatus").val() == "Public") {
            var modal = document.getElementById("PublicShareVideo");
            modal.style.display = "block";
        }
        $("#btnComment").on('click', function () {
            if ($("#txtComment").val().trim() != "") {
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VideoComment",
                    data: { comment: $("#txtComment").val(), videoid: $("#txtVideoId").val() },
                    success: function (response) {
                        $("#txtComment").val("");
                        $.ajax({
                            type: "POST",
                            url: "/RiseTube/UpdateVideoComment",
                            data: { videoid: $("#txtVideoId").val() },
                            success: function (data) {
                                var html = '';
                                html += '  <div class="chat"><div class="chat-history"><ul class="posts" >';
                                for (var i = 0; i < data.length; i++) {

                                    html += '                <li>';
                                    html += '  <div class="message-data"><span class="message-data-name"><b>' + data[i].userName + ' </b></span></div>  <div class="message my-message borders comment-tri-right left-tp"> ' + data[i].comment; '</div>'
                                    html += '    </li>';
                                }

                                html += '    </ul></div></div>';
                                $("#divcomments").empty().html(html);
                            }
                        });
                    }
                });
            }
        });
        $('#btnSearch').on('click', function () {
            if ($(this).attr('data-click-state') == 1) {
                $(this).attr('data-click-state', 0);
                $(this).css('background-color', 'blue');
                $(this).val('Share');
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VideoShare",
                    data: { value: "Private", videoid: $("#txtVideoId").val() },
                    success: function (data) {

                    }
                });
            }
            else {
                $(this).attr('data-click-state', 1);
                $(this).css('background-color', 'green');
                $(this).val('Shared');
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VideoShare",
                    data: { value: "Public", videoid: $("#txtVideoId").val() },
                    success: function (data) {

                    }
                });

            }
        });

    });
    function switchtoquestionVideo(questiontime) {
        var time = 1;
        if (questiontime != '') {
            time = questiontime;
        }
        var vid = document.getElementsByClassName("vjs-tech");
        vid[0].currentTime = time;
        //time should be in seconds
    }

    function SubmitEmail() {
        if ($("#txtvideoemailid").val() != "") {
            var currentUrl = window.location.href;
            $.ajax({
                type: "POST",
                url: "/RiseTube/VideoShareEmail",
                data: { videoid: $("#txtVideoId").val(), Emailid: $("#txtvideoemailid").val(), CurrentUrl: currentUrl },
                success: function (data) {
                    closepublicSharePopUpvideo();
                    $("#divbackground").removeClass("blk-bg");
                }
            });
        }
    }
    function closepublicSharePopUpvideo() {
        var modal = document.getElementById("PublicShareVideo");
        modal.style.display = "none";
    }

    function RemoveRow(index) {
        document.getElementById("quetxt_" + index).style.display = "none";
        $("#IreportModel_QuestionsCollection_" + index + "__QuestionStatus").val("true");
        //document.getElementById("IreportModel_QuestionsCollection_"+index+"__QuestionStatus").value = "true";
    }
    function SendIntrestUrl() {
        var videourl = window.location.href;
        var CandidateEmail = $("#txtOnlineEmail").val();
        if (Swal.fire("Are you sure, you want to show interest on this Candidate Interview?")) {
            $.ajax({
                type: "POST",
                url: "/RiseTube/VideoShareIntrest",
                data: { CurrentUrl: videourl, Emailid: $("#txtvideoemailid").val(), CandidateEmail: CandidateEmail, clienthr: $("#txtclienthr").val() },
                success: function (data) {
                    swal.fire("Your interest has been recorded successfully.");
                }
            });
        }
    }
    function changeVideo(index) {
        $(".video-card-image").removeClass("active-video");
        $("#divvideoclick_" + index).addClass("active-video");
        $('.active-video').attr('opacity', '0.65')
        var videourl = $("#txtvideopri_" + index).val();
        var html = '';

        if (videourl.includes(".mp4") || videourl.includes(".org")) {
            html += '<video controls class="vjs-tech video-width btnvideo" controlsList="nodownload">';
            html += '<source src="' + videourl + '" type="video/mp4">';
            html += '</video>';
        }
        else if (videourl.includes("/manifest")) {
            html += '<video id="vid1" class="azuremediaplayer amp-default-skin amp-big-play-centered btnvideo" controls data-setup="{ "logo": { "enabled": false }, "techOrder": ["azureHtml5JS", "flashSS", "silverlightSS", "html5"], "nativeControlsForTouch": false } " controlsList="nodownload">';
            html += '<source src="' + videourl + '" type="application/vnd.ms-sstr+xml" />';
            html += ' </video>';
        }
        else {
            html += '           <iframe width="100%" class="vjs-tech btnvideo" height="315" src="' + videourl + '" allowfullscreen></iframe>';
        }
        $("#divvideochange").empty().html(html);
    }
</script>
