                                                                        <input class="view-video" type="button" value="Show Interest" title="Click to show your interest for this candidate interview" onclick="SendIntrestUrl()" />
                                                                    </div>


                                                                    @if (@Model.JDTiltle.Length > 5)
                                                                    {

                                                                        <a href="#" data-tooltip="@Model.JDTiltle">
                                                                            <span class="job_title join-time"> (@Model.JDTiltle.Split("|")[0])</span>
                                                                        </a>}
                                                                    else
                                                                    {
                                                                        <span>@Model.JDTiltle</span>}
