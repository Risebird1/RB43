    <div class="pt30 videocon">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix" style=" margin-top: 27px;">
                <div class="pull-left">
                    <h4 class="card-title"></h4>

                    <div class="mobile-view"> <h4 class="card-title">Risetube</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <input type="text" hidden id="txtVideostatus" value="@ViewBag.VideoStatus" />
