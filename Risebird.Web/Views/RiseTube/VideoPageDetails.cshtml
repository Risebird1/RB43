                                                                        </ul>
                                                                        <hr />
                                                                        <div class="tab_container tab-space">
                                                                            <h3 class="d_active tab_drawer_heading" rel="link1">Report Summary</h3>
                                                                            <div id="link1" class="tab_content">
                                                                                <div class="row">
                                                                                    <div class="left-chart">

                                                                                        <div class="chart-box itemchart">
                                                                                            <p class="card-text">Tech Skill Score: <span class="toscore" id="totScore"></span></p>
                                                                                            <div class="col-lg-12 col-md-12 col-sm-12 nopad">
                                                                                                <div id="scoreChart" style="height: 200px; width: 100%;"></div>
                                                                                            </div>
                                                                                        </div>

                                                                                        @if (Model.FeedbackAudioLink != null)
                                                                                        {
                                                                                            <div class="audio-wrap">

                                                                                                <h6>Audio Feedback</h6>
                                                                                                <audio src='@Model.FeedbackAudioLink' controls></audio>



                                                                                                <!--end of col-md-12-->

                                                                                            </div>

                                                                                        }


                                                                                    </div>
                                                                                    <div class="interviewer-comment itemcomment">

                                                                                        <div class="form-group" style="margin-bottom:0px; ">
                                                                                            @Html.LabelFor(model => model.IreportModel.InterviewerComment, htmlAttributes: new { @class = "control-label bolder col-md-12 col-sm-12 card-text-label" })


                                                                                            <div class="talk-bubble tri-right border-bubble right-in inComment" style="width:100%;">
                                                                                                <a href="#" data-tooltip="@Model.InterviewerComment">
                                                                                                    <div class="talktext">


                                                                                                        @Html.TextAreaFor(m => m.IreportModel.InterviewerComment, new { htmlAttributes = new { @class = "form-control text-box comment single-line" }, @style = "height:195px;", @readonly = "readonly" })

                                                                                                    </div>
                                                                                                </a>
                                                                                            </div>



                                                                                            @*@Html.EditorFor(model => model.InterviewerComment, new { htmlAttributes = new { @class = "form-control" } })*@
                                                                                            @Html.ValidationMessageFor(model => model.InterviewerComment, "", new { @class = "text-danger" })
                                                                                        </div>
                                                                                        <div class="form-group">
                                                                                            @Html.LabelFor(model => model.IreportModel.JobLevelName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 card-text-label bolder" })
                                                                                            @Html.TextBoxFor(m => m.IreportModel.JobLevelName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                                        </div>
                                                                                        @if (@Model.IreportModel.IsBiometricEnabled)
                                                                                        {
                                                                                            <div class="form-group">
                                                                                                @Html.LabelFor(model => model.IreportModel.InterviewBiometryScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 card-text-label bolder" })
