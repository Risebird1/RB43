                                                                            <h3 class="tab_drawer_heading" rel="link4">  Questions Discussed</h3>
                                                                            <div id="link4" class="tab_content">
                                                                                <div>
                                                                                    <div class="table-responsive-sm ">
                                                                                        @if (Model.IreportModel.QuestionsList != null)
                                                                                        {
                                                                                            <table class="table table-bordered mbn disQus" id="QuestionsTable">
                                                                                                <thead>
                                                                                                    <tr>
                                                                                                        <th width="40%">Questions</th>
                                                                                                        <th width="20%">SkillName</th>
                                                                                                        <th width="20%">Rating</th>
