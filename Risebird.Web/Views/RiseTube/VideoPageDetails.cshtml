                                                                    <input class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded pull-right" type="button" id="1" value="THEATER-MODE-ON" onclick="toggle(this);">
                                                                    <input type="text" hidden value="@Model.candidateName" id="txthiddenCandidate" />
                                                                    <input type="text" hidden value="@Model.JDTiltle" id="txthiddenSkill" />
                                                                </h1>
                                                            }
