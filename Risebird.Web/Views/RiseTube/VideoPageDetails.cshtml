                                                                                                                        @Html.TextBoxFor(m => m.IreportModel.QuestionsCollection[i].Comment, new { @class = "dropques form-control text-box single-line", @readonly = "readonly", onmouseover = "dropDwnToolTips(this)" })


                                                                                                                    </td>
                                                                                                                    <td>
