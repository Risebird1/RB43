                                                                            <li class="nav-link item2" rel="link2">Candidate Details</li>
                                                                            <li class="nav-link item3" rel="link3"> Tech Skill Report</li>
                                                                            <li class="nav-link item4" rel="link4"> Questions Discussed</li>
                                                                            <li class="nav-link item5" rel="link5">General Skill Report</li>
