                    }
                });

            }
            else {
                $(this).attr('data-click-state', 1);
                $(this).css('background-color', 'green');
                $(this).val('Shared');
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioShare",
                    data: { value: "Public", vedioid: $("#txtVedioId").val() },
                    success: function (data) {

                    }
                });
            }
        });
        $('#toggle-click').on('click', function () {
            if ($(this).attr('data-click-state') == 1) {
                $(this).attr('data-click-state', 0);


            }
            else {
                $(this).attr('data-click-state', 1);
                $(this).css('color', 'blue');
                $('#toggle-click1').css('color', 'black');
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioLike",
                    data: { value: "Liked", vedioid: $("#txtVedioId").val() },
                    success: function (data) {
                        $("#pTotalvediolike").text(data.totalVedioLike);
                        $("#pTotalvediodislike").text(data.totalVedioDisLike);

                    }
                });
            }
        });
        $('#toggle-click1').on('click', function () {
            if ($(this).attr('data-click-state') == 1) {
                $(this).attr('data-click-state', 0);

            }
            else {
                $(this).attr('data-click-state', 1);
                $(this).css('color', 'blue');
                $('#toggle-click').css('color', 'black');
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioLike",
                    data: { value: "Disliked", vedioid: $("#txtVedioId").val() },
                    success: function (data) {
                        $("#pTotalvediolike").text(data.totalVedioLike);
                        $("#pTotalvediodislike").text(data.totalVedioDisLike);

                    }
                });
            }
        });
    });

    function SendNotification() {
