<script>
    function datecal() {
        var dtToday = new Date();
        var time = dtToday.getHours() + ":" + dtToday.getMinutes();
        var month = dtToday.getMonth() + 1;
        var day = dtToday.getDate();
        var year = dtToday.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();

        var maxDate = year + '-' + month + '-' + day + 'T' + time;

        $('#txtOnlinestart').attr('min', maxDate);
    }

    function endcal() {


        var maxDate = $('#txtOnlinestart').val();
        if (maxDate == '') {
            var dtToday = new Date();
            var time = dtToday.getHours() + ":" + dtToday.getMinutes();
            var month = dtToday.getMonth() + 1;
            var day = dtToday.getDate();
            var year = dtToday.getFullYear();
            if (month < 10)
                month = '0' + month.toString();
            if (day < 10)
                day = '0' + day.toString();

            maxDate = year + '-' + month + '-' + day + 'T' + time;
        }
        $('#txtOnlineend').attr('min', maxDate);
    }
</script>

