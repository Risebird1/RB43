    function SaveRating() {
        var interviewid = $("#txtratinginterviewid").val();
        var ratingvalue = $("#txtratingvalue").val();
        var comments = $("#txtratingComment").val();
        var clientaction = '';
        if (document.getElementById('rd_shortlistinterviewer').checked) {
            clientaction = 'Shortlisted';
        } else if (document.getElementById('rd_removeinterviewer').checked) {
            clientaction = 'Rejected';
        } else {
            clientaction = '';
        }
        if (parseInt(ratingvalue) > 0) {
            $.ajax({
                url: '/RiseTube/SaveRaitingDetails',
                type: "POST",
                data: { 'imid': interviewid, 'rating': ratingvalue, 'comment': comments, 'clientaction': clientaction },
                success: function (data) {
                    swal.fire(data);
                    var modal = document.getElementById("myRaitingPopup");
                    modal.style.display = "none";
                }
            });
        } else {
            swal.fire("Rating is required.");
        }
    }
    function setRating(starRating) {
        if (starRating != '' && parseInt(starRating) > 0) {
            document.getElementById("Q1_" + starRating).checked = true;
        } else {
            for (i = 1; i <= 5; i++) {
                document.getElementById("Q1_" + i).checked = false;
            }
        }
    }
