<script src="https://cdn.jsdelivr.net/npm/table-to-json@1.0.0/lib/jquery.tabletojson.min.js" integrity="sha256-H8xrCe0tZFi/C2CgxkmiGksqVaxhW0PFcUKZJZo1yNU=" crossorigin="anonymous"></script>
<script type="text/javascript">

    $(document).ready(function () {
        $('.dropques option').wrap('<span>');
        var selectedOption = $('.dropques').find("[selected]");
        $(selectedOption).unwrap();
        if ('@ViewBag.profileName' == "CuratedUser" || '@Model.IsClientCurated' == 'True') {
            document.getElementsByClassName('minmaxCon')[0].style.display = "none";
        }
        var weightageItems = $('[id$="WeightageActual"]');
        for (i = 0; i < weightageItems.length; i++) {
            var id = weightageItems[i].id;
            var match = id.match(/\d+/g);
            var digit = match[0];
            var index = weightageItems[i].id.indexOf(digit);
            var skillName = weightageItems[i].id.substring(0, index);
            var reqLevel = $("#" + skillName + digit + "__RequiredLevelId").val();
            var actLevel = $("#" + skillName + digit + "__ActualLevelId").val();
            //if (reqLevel <= actLevel) {
            //    reqWeight = $("#" + skillName + digit + "__WeightageRequired").val();
            //    $("#" + skillName + digit + "__WeightageActual").val(reqWeight);
            //    $("#" + skillName + digit + "__ActualLevelId").css("border-color", "#008000");
            //}
            //else {
            //    reqWeight = $("#" + skillName + digit + "__WeightageRequired").val();
            //    var adjustedReqWeightage = Math.pow(0.5, (reqLevel - actLevel)) * (reqWeight);
            //    $("#" + skillName + digit + "__WeightageActual").val(adjustedReqWeightage);
            //    $("#" + skillName + digit + "__ActualLevelId").css("border-color", "red");

            //}
            var actualWeightage;
            var reqWeightage = $("#" + skillName + digit + "__WeightageRequired").val();
            actualWeightage = CalculateOverAllScore(reqLevel, actLevel, reqWeightage);
            if (reqLevel <= actLevel) {

                $("#" + skillName + digit + "__WeightageActual").val(actualWeightage);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "#008000");

            }
            else {
                $("#" + skillName + digit + "__WeightageActual").val(actualWeightage);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "red");
            }

        }

    });

    $(document).ready(function () {
        $('.droprating option').wrap('<span>');

        var selectedOption = $('.droprating').find("[selected]");
        $(selectedOption).unwrap();


    })

</script>

<script>
    function GetMeetingAudioText(imid) {
        document.getElementById('link9').innerHTML = '';
        $.ajax({
            url: '/RiseTube/GetMeetingAudioText',
            data: { 'imid': imid },
            success: function (data) {
                if (data.convertedText == null || data.convertedText == '') {
                    document.getElementById('link9').innerHTML = 'Not available';
