@model Risebird.Entities.ViewModel.MeetingVM
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel

@using Microsoft.Extensions.Configuration;

@inject IConfiguration configuration

@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "VideoPage";
    ViewBag.PageHeader = "RiseTube";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] ClientHR = new string[] { };
    string[] ClientName = new string[] { };
    string[] ApprovalStatus = new string[] { };
    string[] JoiningStatus = new string[] { };
    string[] OfferStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] CandidateName = new string[] { };
    string[] CandidateLocation = new string[] { };
    string[] IsShortListed = new string[] { };
    string[] IsIntrested = new string[] { };
    string[] CandidateAvailable = new string[] { };


    string appendTime = configuration["ThumbnailTimeDefault"];

}
@if (HttpContextAccessor.HttpContext.Session.GetString("VideoPagefilters") != null)
{
    filter = JsonConvert.DeserializeObject
<InterviewFilter>
(HttpContextAccessor.HttpContext.Session.GetString("VideoPagefilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    ApprovalStatus = filter.ApprovalStatus != null ? filter.ApprovalStatus : new string[] { };
    JoiningStatus = filter.JoiningStatus != null ? filter.JoiningStatus : new string[] { };
    OfferStatus = filter.OfferStatus != null ? filter.OfferStatus : new string[] { };
    CandidateLocation = filter.CandidateLocation != null ? filter.CandidateLocation : new string[] { };
    IsShortListed = filter.IsShortListed != null ? filter.IsShortListed : new string[] { };
    IsIntrested = filter.IsIntrested != null ? filter.IsIntrested : new string[] { };
    CandidateAvailable = filter.CandidateAvailable != null ? filter.CandidateAvailable : new string[] { };

}
<style>
    .star-rating {
        border: solid 1px white;
        display: flex;
        direction: rtl;
        font-size: 2.0em;
        justify-content: space-around;
        padding: 0 .2em;
        text-align: center;
        width: 100%;
        margin-bottom: 10px;
        background-color: lightgray;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            /*color: #ccc;*/
            color: #e4e4e4;
            cursor: pointer;
        }

        .star-rating :checked ~ label {
            color: #f90;
        }

        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #fc0;
        }

    .card-title-space {
        margin: 20px 0px;
        float: right
    }

    .mb10 {
        margin-bottom: 10px
    }
</style>
