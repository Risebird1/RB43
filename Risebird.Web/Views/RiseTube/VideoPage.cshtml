                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioLike",
                    data: { value: "Disliked", vedioid: $("#txtVedioId").val() },
                    success: function (data) {
                        $("#pTotalvediolike").text(data.totalVedioLike);
                        $("#pTotalvediodislike").text(data.totalVedioDisLike);

                    }
                });
            }
        });
    });

