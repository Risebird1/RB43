                        $("#btnShortlist").val("Shortlisted(" + data + ")");
                    }
                });

            }
        });
        $("#btnIntrest").on('click', function () {
            if ($(this).attr('Shortvalue') == 1) {
                var modal = document.getElementById("myModalComment");
                modal.style.display = "block";

            }
        });
        $("#btnComment").on('click', function () {
            if ($("#txtComment").val().trim() != "") {
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioComment",
                    data: { comment: $("#txtComment").val(), vedioid: $("#txtVedioId").val() },
                    success: function (response) {
                        $("#txtComment").val("");
                        $.ajax({
                            type: "POST",
