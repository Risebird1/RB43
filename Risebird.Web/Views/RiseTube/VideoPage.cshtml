                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioShare",
                    data: { value: "Public", vedioid: $("#txtVedioId").val() },
                    success: function (data) {

                    }
                });

            }
        });
        $('#toggle-click').on('click', function () {
            if ($(this).attr('data-click-state') == 1) {
                $(this).attr('data-click-state', 0);


            }
            else {
                $(this).attr('data-click-state', 1);
                $(this).css('color', 'blue');
                $('#toggle-click1').css('color', 'black');
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioLike",
