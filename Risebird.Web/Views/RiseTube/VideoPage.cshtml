<script>


    jQuery(document).ready(function ($) {

        $(".tab_content").hide();
        $(".tab_content:first").show();

        /* if in tab mode */
        $("ul.tabs li").click(function () {

            $(".tab_content").hide();
            var activeTab = $(this).attr("rel");
            $("#" + activeTab).fadeIn();

            $("ul.tabs li").removeClass("active");
            $(this).addClass("active");

            $(".tab_drawer_heading").removeClass("d_active");
            $(".tab_drawer_heading[rel^='" + activeTab + "']").addClass("d_active");

        });
        /* if in drawer mode */
        $(".tab_drawer_heading").click(function () {

            $(".tab_content").hide();
            var d_activeTab = $(this).attr("rel");
            $("#" + d_activeTab).fadeIn();

            $(".tab_drawer_heading").removeClass("d_active");
            $(this).addClass("d_active");

            $("ul.tabs li").removeClass("active");
            $("ul.tabs li[rel^='" + d_activeTab + "']").addClass("active");
        });


        /* Extra class "tab_last"
           to add border to right side
           of last tab */
        $('ul.tabs li').last().addClass("tab_last");
    })

</script>
<script>
    < script >
    jQuery(document).ready(function ($) {



        var main = function () {
            $('.btn').click(function () {
                var post = $('.status-box').val();
                $('<li>').text(post).prependTo('.posts');
                $('.status-box').val('');
                $('.counter').text('450');
                $('.btn').addClass('disabled');
            });
            $('.status-box').keyup(function () {
                var postLength = $(this).val().length;
                var charactersLeft = 450 - postLength + "   " + "CharacterLeft";
                $('.counter').text(charactersLeft);
                if (charactersLeft < 0) {
                    $('.btn').addClass('disabled');
                } else if (charactersLeft === 450) {
                    $('.btn').addClass('disabled');
                } else {
                    $('.btn').removeClass('disabled');
                }
            });
        }
        $('.btn').addClass('disabled');
        $(document).ready(main)
</script>
<script>
            $('form').submit(function () {
                if ($(this).valid()) {
                    $(':submit', this).attr('disabled', 'disabled');
                }
            });

            function CountProctoring(value) {

                if (value == "" || value == null) {
                    return;
                }

                var proctoringItems = $('[id^="Proctoring_"]');
                var proctoringTotal = 0;
                for (i = 0; i < proctoringItems.length; i++) {
                    proctoringTotal += parseInt(proctoringItems[i].value);
                }
                $("#ProctoringCount").val(proctoringTotal);
                if (parseInt(proctoringTotal) > 0) {
                    $("#ProctoringCount").css("border-color", "red");
                }
                else {
                    $("#ProctoringCount").css("border-color", "#E3E3E3");
                }
            }

            function CalculateOverAll(id, value) {

                value = parseInt(value);
                var index;
                var skillName;
                if (id.includes("Tech")) {
                    index = id.charAt(26);
                    skillName = "TechSkillReportCollection";
                }

                else if (id.includes("General")) {
                    index = id.charAt(29);
                    skillName = "SkillGeneralReportCollection";
                }
                else if (id.includes("Joinability")) {
                    index = id.charAt(30);
                    skillName = "JoinabilityHRReportCollection";
                }
                else {
                    index = id.charAt(39);
                    skillName = "SelectabilityEvaluatorReportCollection";
                }
                var reqLevelId = skillName + "_" + index + "__RequiredLevelId"; //SkillGeneralReportCollection_0__RequiredLevel
                var required = $("#" + reqLevelId).val();
                if (required <= value) {
                    var reqWeightage = $("#" + skillName + "_" + index + "__WeightageRequired").val();
                    $("#" + skillName + "_" + index + "__WeightageActual").val(reqWeightage);
                    $("#" + skillName + "_" + index + "__ActualLevelId").css("border-color", "#008000");

                }
                else {
                    $("#" + skillName + "_" + index + "__WeightageActual").val("0");
                    $("#" + skillName + "_" + index + "__ActualLevelId").css("border-color", "red");
                }

                var items = $('[id$="WeightageActual"]');
                //var length = item.length;
                var totalCount = 0;

                for (i = 0; i < items.length; i++) {
                    totalCount += parseInt(items[i].value);
                }
                //items.forEach(function (item) {
                //    totalCount = totalCount + item.val();
                //});
                var average = totalCount / 4;
                $("#OverallScore").val(average);

                var arr = [];
                var obj = { y: "", legendText: "", label: "" }
                //TechSkills actual weightage total
                var techItems = $('[id^="IreportModel_TechSkillReportCollection"][id$="WeightageActual"]');
                var techTotal = 0;
                for (i = 0; i < techItems.length; i++) {

                    techTotal = parseInt(techTotal) + parseInt($("#IreportModel_TechSkillReportCollection_" + i + "__WeightageActual").val());

                }
                obj.y = parseInt(techTotal) / 4;
                obj.label = "Tech Skills Score";
                obj.legendText = "Tech Skills Score";
                arr.push(obj);

                //SkillsGeneral actual weightage total
                var objGen = { y: "", legendText: "", label: "" }
                var genSkillsItems = $('[id^="IreportModel_SkillGeneralReportCollection"][id$="WeightageActual"]');
                var genTotal = 0;
                for (i = 0; i < genSkillsItems.length; i++) {
                    var weightage = $("#IreportModel_SkillGeneralReportCollection_" + i + "__WeightageActual").val();
                    genTotal = parseInt(genTotal) + parseInt(weightage);

                }

                objGen.y = parseInt(genTotal) / 4;
                objGen.label = "General Skills Score";
                objGen.legendText = "General Skills Score";
                arr.push(objGen);

                //Joinability actual weightage total
                var objJoin = { y: "", legendText: "", label: "" }
                var joinabilityItems = $('[id^="IreportModel_JoinabilityHRReportCollection"][id$="WeightageActual"]');
                var joinabilityTotal = 0;
                for (i = 0; i < joinabilityItems.length; i++) {

                    joinabilityTotal = parseInt(joinabilityTotal) + parseInt($("#IreportModel_JoinabilityHRReportCollection_" + i + "__WeightageActual").val());

                }
                objJoin.y = parseInt(joinabilityTotal) / 4;
                objJoin.label = "Joinability Score";
                objJoin.legendText = "Joinability Score";
                arr.push(objJoin);

                //Selectability actual weightage total
                var objSelect = { y: "", legendText: "", label: "" }
                var selectabilityItems = $('[id^="IreportModel_SelectabilityEvaluatorReportCollection"][id$="WeightageActual"]');
                var selectabilityTotal = 0;
                for (i = 0; i < selectabilityItems.length; i++) {

                    selectabilityTotal = parseInt(selectabilityTotal) + parseInt($("#IreportModel_SelectabilityEvaluatorReportCollection_" + i + "__WeightageActual").val());

                }
                objSelect.y = parseInt(selectabilityTotal) / 4;
                objSelect.label = "Selectability Score";
                objSelect.legendText = "Selectability Score";
                arr.push(objSelect);

                //totalScore = (techTotal + genTotal + joinabilityTotal + selectabilityTotal) / 4;
                document.getElementById("totScore").innerHTML = average;

                var chart = new CanvasJS.Chart("scoreChart", {
                    theme: "light2", // "light1", "light2", "dark1", "dark2"
                    width: 400,//in pixels
                    height: 200,//in pixels
                    animationEnabled: true,
                    title: {
                        text: "Score Chart"
                    },
                    data: [{
                        type: "column",
                        //startAngle: 60,
                        //innerRadius: 55,
                        indexLabelFontSize: 8,
                        indexLabel: "{label}  {y}",
                        toolTipContent: "<b>{label} </b>({y})",
                        dataPoints: arr

                    }]
                });
                chart.render();


            }

             $(document).ready(function () {

        var proctoringItems = $('[id^="Proctoring_"]');
        var proctoringTotal = 0;
        for (i = 0; i < proctoringItems.length; i++) {
            proctoringTotal += parseInt(proctoringItems[i].value);
        }
        $("#ProctoringCount").val(proctoringTotal);
        if (parseInt(proctoringTotal) > 0) {
            $("#ProctoringCount").css("border-color", "red");
        }
        else {
            $("#ProctoringCount").css("border-color", "#E3E3E3");
        }

        //shorter/better attempt
        var weightageItems = $('[id$="WeightageActual"]');
        for (i = 0; i < weightageItems.length; i++) {
            var id = weightageItems[i].id;
            var match = id.match(/\d+/g);
            var digit = match[0];

            var index = weightageItems[i].id.indexOf(digit);
            var skillName = weightageItems[i].id.substring(0, index);
            var reqLevel = $("#" + skillName + digit + "__RequiredLevelId").val();
            var actLevel = $("#" + skillName + digit + "__ActualLevelId").val();
            if (reqLevel <= actLevel) {
                reqWeight = $("#" + skillName + digit + "__WeightageRequired").val();
                $("#" + skillName + digit + "__WeightageActual").val(reqWeight);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "#008000");
            }
            else {
                $("#" + skillName + digit + "__WeightageActual").val("0");
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "red");

            }

        }


        var items = $('[id$="WeightageActual"]');
        var totalCount = 0;

        for (i = 0; i < items.length; i++) {
            totalCount += parseInt(items[i].value);
        }
        var average = totalCount / 4;
        $("#OverallScore").val(average);






    });

