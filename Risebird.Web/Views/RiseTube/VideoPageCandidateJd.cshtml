            }
            html += '                  <td class="text-center count-view"><span class="label-num"><strong>' + data[i].count + '</strong></span></td>';
            if (data[i].timeSpend != null) {
                html += '                <td class="text-center">' + data[i].timeSpend + '</td>';
            } else {
