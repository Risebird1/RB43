@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "RiseTube";
    ViewBag.PageHeader = "RiseTube";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <!-- Start of  Zendesk Widget script -->
    <script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key=e028bcf9-a477-4550-812a-0ec957f2188d"></script>
    <!-- End of  Zendesk Widget script -->
</head>

<link rel="stylesheet" type="text/css" href="~/Newassets/css/risetube.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">
  
    <!--  <div class="panel-header panel-header-sm"> </div>-->

    <div class="pt30 videocon">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left risetubeheader">
                    <h4 class="card-title"></h4>

                    <div class="mobile-view"> <h4 class="card-title risetubeid">Risetube</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <div class="newsletter">

                            <div class="content">
                                <div class="input-group card-title-space" id="myForm">
                                    <div class="searchbox">
                                        <input type="email" id="txtsearch" value="@ViewBag.searchvalue" class="form-control txtsearch1" placeholder="Please enter Skills (or) Name of Candidate">
                                        <span class="input-group-btn">
                                            <button class="btn btn3" id="btnSearch" type="submit"><svg style="fill: #fff;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" /></svg></button>
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-life-ring" data-toggle="tooltip" data-placement="top" title="Support" onclick="location.href='@Url.Action("Index", "Support", new { controllerName = "Risetube", actMethod ="SharedIndex" } )'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Support</font></span>
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </div>



    <div class="content video client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">



                            <div class="video-block section-padding" id="VideoList">
                                <div class="row">
                                    @foreach (var item in Model)
                                    {
                                        var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                        <div class="col-xl-3 col-sm-6 mb-3">
                                            <div class="video-card">
                                                <div class="video-card-image">
                                                    @if (item.MeetingPatchCount > 0)
                                                    {
                                                        <div class="count-bg"><span>@item.MeetingPatchCount</span></div>
                                                    }
                                                    @if (item.VideoLink.Contains(".mp4"))
                                                    {
                                                        @if (item.ThumbnailImage != null)
                                                        {
                                                            <img src="@item.ThumbnailImage" class="thumbnailImage" />
                                                        }
                                                        <video controls class="video-thumb" controlsList="nodownload">
                                                            <source src="@item.VideoLink" type="video/mp4">
                                                        </video>
                                                        <a class="play-icon" onclick="location.href='@Url.Action("VideoPageDetails", "Risetube", new { id = item.imid})'" style=" cursor: pointer;"></a>
                                                    }
                                                    else
                                                    {
                                                        @if (item.ThumbnailImage != null)
                                                        {
                                                            <img src="@item.ThumbnailImage" class="thumb-height" />
                                                        }
                                                        else
                                                        {
                                                            <img src="~/RiseTube/img/video-icon.png" class="thumb-height" />
                                                        }
                                                        <a class="play-icon" onclick="location.href='@Url.Action("VideoPageDetails", "Risetube", new { id = item.imid})'" style=" cursor: pointer;"></a>
                                                    }


                                                </div>
                                                <div class="video-card-body" style="height:130px">
                                                    <div class="video-title">

                                                        @if (@item.candidateName.Length > 20)
                                                        {
                                                            <a data-tooltip="@item.candidateName" onclick="location.href='@Url.Action("VideoPageDetails", "Risetube", new { id = item.imid })'" style=" cursor: pointer;"><span class="candidate-name candidate">@item.candidateName</span> </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="candidate">@item.candidateName</span>}




                                                        @if (@item.JDTiltle.Length > 20)
                                                        {
                                                            <a href="#" data-tooltip="@item.JDTiltle"> <span class="join-time  designation">@item.JDTiltle</span></a>
                                                        }
                                                        else
                                                        {
                                                            <span class="designation">@item.JDTiltle</span>
                                                        }
                                                        @if (item.CostEstimate != null)
                                                        {<div class="video-info  col-sm-6 col-md-5 col-lg-5 nopad pull-right">
                                                                <span>Per Hour Rate:</span> @if (@item.CostEstimate.Length > 10)
                                                                {
                                                                    <a href="#" data-tooltip="@item.CostEstimate"> <span class="expected-salari">@item.CostEstimate</span></a>}

                                                                else
                                                                {
                                                                    <span>@item.CostEstimate</span>
                                                                }
                                                            </div>
                                                        }


                                                    </div>
                                                    <div class="video-page text-success">
                                                        @*@item.candidateName &nbsp; <i class="fas fa-check-circle text-success"></i>*@
                                                    </div>
                                                    <div class="video-info col-sm-6 col-md-7 col-lg-7 nopad pull-left">
                                                        <i class="fas fa-calendar-alt"></i>
                                                        <span>@item.interviewDate</span>
                                                    </div>
                                                    <div class="video-info col-sm-6 col-md-5 col-lg-5 nopad pull-left">
                                                        <span class="pull-left">Tech Skill Score:</span>

                                                        <span class="pull-left">@(item.TechSkillScore)%</span>

                                                    </div>
                                                    <div class="video-info col-sm-6 col-md-7 col-lg-7 nopad pull-left">
                                                        <span class="notice"> Notice Period: </span>
                                                        @if (item.joiningTime != null && item.joiningTime.Length > 12)
                                                        {
                                                            <a href="#" data-tooltip="@item.joiningTime"> <span class="joining-time"> @item.joiningTime</span></a>
                                                        }
                                                        else
                                                        {
                                                            <span class="join"> @item.joiningTime</span>
                                                        }
                                                    </div>

                                                    <div class="video-info col-sm-6 col-md-5 col-lg-5 nopad pull-left">
                                                        <span>Status:</span>
                                                        @if (item.InterviewStatus == 4)
                                                        {
                                                            <span style="color:palevioletred">Border Line</span>
                                                        }

                                                        else if (item.InterviewStatus == 2)
                                                        {
                                                            <span style="color:green">Selected</span>

                                                        }

                                                    </div>

                                                    <div class="video-info col-sm-6 col-md-7 col-lg-7 nopad pull-left">
                                                        <span>Expected Salary:</span> @if (item.expectedPerHourRate != null && item.expectedPerHourRate.Length > 5)
                                                        {
                                                            <a href="#" data-tooltip="@item.expectedPerHourRate"> <span class="expected-salari">@item.expectedPerHourRate</span></a>}

                                                        else
                                                        {
                                                            <span>@item.expectedPerHourRate</span>}
                                                    </div>

                                                    <div class="video-info col-sm-6 col-md-5 col-lg-5 nopad pull-left">

                                                        <span>Location:</span>
                                                        <span>
                                                            @if (item.preferredLocation != null && item.preferredLocation.Length > 10)
                                                            {
                                                                <a href="#" data-tooltip="@item.preferredLocation"> <span class="expected-timing">@item.preferredLocation</span></a>}
                                                            else
                                                            {<span>@item.preferredLocation</span>}
                                                        </span>

                                                    </div>
                                                    <div class="video-info col-sm-6 col-md-7 col-lg-7 nopad pull-left">
                                                        <span>Resume:</span>
                                                        <a href="@item.resumeLink" target="_blank">resume</a>
                                                    </div>

                                                    <div class="video-info col-sm-6 col-md-5 col-lg-5 nopad pull-left">

                                                        <span>Experience:</span>
                                                        <span>
                                                            @if (!string.IsNullOrEmpty(item.TotalExperience))
                                                            {
                                                                <span>@item.TotalExperience</span>
                                                            }

                                                        </span>

                                                    </div>


                                                </div>
                                            </div>
                                        </div>
                                    }


                                </div>
                            </div>
                            <hr>
                            @{
                                var page = ViewBag.Page;
                                var startCount = (page - 1) * 12 + 1;
                                var endCount = (page) * 12;
                            }
                            @if (ViewBag.MeetingsCount == 0)
                            {
                        <p>
                            No selected candidates are available as per requirement!
                        </p>
                            }
                            else if (ViewBag.Pages == page && ViewBag.Remainder == 0)
                            {
                                var endNum = page * 12;
                                <p>
                                    @startCount - @endNum of @ViewBag.MeetingsCount
                                </p>
                            }
                            else if (ViewBag.Pages == page && ViewBag.Remainder != 1)
                            {
                                var endNum = (page - 1) * 12 + ViewBag.Remainder;
                                <p>
                                    @startCount - @endNum of @ViewBag.MeetingsCount
                                </p>
                            }
                            else if (ViewBag.Pages == page && ViewBag.Remainder == 1)
                            {
                                <p>
                                    @startCount of @ViewBag.MeetingsCount
                                </p>
                            }
                            else
                            {
                                <p>
                                    @startCount - @endCount of @ViewBag.MeetingsCount
                                </p>
                            }

                            <div class="pagination-container">
                                <ul class="pagination">
                                   
                                    @{
                                        var startFrom = 0;
                                        var endWith = 0;
                                        if (page % 3 != 0)
                                        {
                                            startFrom = ((page / 3) * 3) + 1;
                                        }
                                        else
                                        {
                                            startFrom = (((page - 1) / 3) * 3) + 1;
                                        }
                                        var pages = ViewBag.Pages;

                                        if (pages - startFrom > 2)
                                        {
                                            endWith = startFrom + 2;
                                        }
                                        else
                                        {
                                            endWith = pages;
                                        }

                                    }

                                    @if (page > 3)
                                    {
                                        <li>
                                            <a href="@Url.Action("SharedIndex", "Risetube", new { page = startFrom - 1, searchvalue = ViewBag.searchvalue })"
                                               class="PagedList-skipToPrevious">
                                                &laquo;
                                            </a>
                                        </li>

                                    }
                                    @for (int i = startFrom; i <= endWith; i++)

                                    {

                                        <li class="@(i == ViewBag.page ? "page-item active" : "page-item")">
                                            @Html.ActionLink(i.ToString(), "SharedIndex", "Risetube", new { Page = i, searchvalue = ViewBag.searchvalue }, htmlAttributes: new { @class = "" })

                                        </li>
                                    }


                                    @if (pages > endWith)
                                    {
                                        <li class="PagedList-skipToNext">
                                            <a href="@Url.Action("SharedIndex", "Risetube", new { page = endWith + 1, searchvalue = ViewBag.searchvalue })">
                                                &raquo;
                                            </a>
                                        </li>

                                    }


                                </ul>
                            </div>

                            @*@for (int i = 1; i <= ViewBag.Pages; i++)
                            {
                                @Html.ActionLink(i.ToString(), "SharedIndex", "Risetube", new { Page = i, searchvalue = ViewBag.searchvalue }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" })

                            }*@
                        </div>

                    </div>
                </div>

            </div>
        </div>


    </div>
</div>




