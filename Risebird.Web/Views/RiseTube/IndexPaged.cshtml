<script>
    $(document).ready(function () {

        $(".candidate-name").each(function () {
            if ($(this).text().length > 15) {
                $(this).text($(this).text().substr(0, 15) + "...")

                $('[role="data-tooltip"]').css("visibility", "visible");

            }


            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
        });

        $(".join-time").each(function () {
            if ($(this).text().length > 10) {
                $(this).text($(this).text().substr(0, 10) + "...")

                $('[role="data-tooltip"]').css("visibility", "visible");

            }


            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
        });

        $(".joining-time").each(function () {
            if ($(this).text().length > 12) {
                $(this).text($(this).text().substr(0, 12) + "...")

                $('[role="data-tooltip"]').css("visibility", "visible");

            }


            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
        });



        $(".expected-salary").each(function () {
            if ($(this).text().length > 5) {
                $(this).text($(this).text().substr(0, 5) + "...")

                $('[role="data-tooltip"]').css("visibility", "visible");

            }


            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }





        });


        $(".expected-time").each(function () {
            if ($(this).text().length > 3) {
                $(this).text($(this).text().substr(0, 3) + "...")

                $('[role="data-tooltip"]').css("visibility", "visible");

            }


            else { $('[role="data-tooltip"]').css("visibility", "hidden"); }
        });


    });
</script>

