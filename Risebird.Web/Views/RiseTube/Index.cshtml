                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="IsShortListed">
                                                                    Shortlisted
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="IsShortListed" name="IsShortListed" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in ViewBag.IsShortListed)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    @if (ViewBag.ProfileName != "CuratedUser")
                                                    {
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="JoiningStatus">
                                                                    Joining Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="JoiningStatus" name="JoiningStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in ViewBag.JoiningStatusList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="IsIntrested">
                                                                    Interested
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="IsIntrested" name="IsIntrested" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in ViewBag.IsIntrested)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                        </div>
                                                    }
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group col-md-12">


                                                            <div class="row">
                                                                <div class="col-md-12 mc-button-area text-right">

                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn4  reset-filter">
                                                                      Reset Filter
                                                                    </button>


                                                                    <!--<button type="button" id="ResetFilter" style="float:right;margin-top: 39px;" class="buttons button-2 button-2b">Reset Filter</button>-->



                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn5 apply-filter">
                                                                      Apply Filter
                                                                    </button>








                                                                    <!--  <button type="submit" style="margin-top: 40px; float:right" class="buttons button-2 button-2b">Apply Filter</button>-->
                                                                </div>

                                                            </div>










                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>

                            <div class="video-block section-padding" id="VideoList">
                                <div class="row">
                                    @foreach (var item in Model)
                                    {
                                        var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                        <div class="col-xl-3 col-sm-6 mb-3">
                                            <div class="video-card">
                                                <div class="video-card-image">
                                                    @if (item.VideoLink.Contains(".mp4"))
                                                    {
                                                        @if (item.ThumbnailImage != null)
                                                        {
                                                            <img src="@item.ThumbnailImage" class="thumbnailImage" />
                                                        }
                                                        <video controls class="video-thumb">
                                                            <source src="@item.VideoLink" type="video/mp4">
                                                        </video>
                                                        <a class="play-icon" onclick="location.href='@Url.Action("VideoPage", "Risetube", new { id = item.imid})'" style=" cursor: pointer;"></a>
                                                    }
                                                    else
                                                    {
                                                        @if (item.ThumbnailImage != null)
                                                        {
                                                            <img src="@item.ThumbnailImage" class="thumb-height"  />
                                                        }
                                                        else
                                                        {
                                                            <img src="~/RiseTube/img/video-icon.png" class="thumb-height"  />
                                                        }
                                                        <a class="play-icon" onclick="location.href='@Url.Action("VideoPage", "Risetube", new { id = item.imid})'" style=" cursor: pointer;"></a>
                                                    }


                                                </div>
                                                <div class="video-card-body">
                                                    <div class="video-title">
                                                        <a onclick="location.href='@Url.Action("VideoPage", "Risetube", new { id = item.imid})'" style=" cursor: pointer;">@item.candidateName </a>
                                                        <span style="  color: #606060; font-weight: 500;font-size: 14px;">(@item.JDTiltle.Split("|")[0])</span>
                                                    </div>

                                                    <div class="video-page text-success">
                                                        @*@item.candidateName &nbsp; <i class="fas fa-check-circle text-success"></i>*@

                                                    </div>
                                                    <div class="video-view">
                                                        &nbsp;<i  class="fas fa-calendar-alt"></i> <span>@item.interviewDate</span>
</div>
</div>
</div>
</div>
}


                                </div>
                            </div>
                            <hr>
                            @foreach (var item in Model)
                            {
                                <p>
                                    @item.PageNumber of @item.interviewVediosequence
                                </p>
                                break;
                            }
                            @Html.PagedListPager(Model, Page => Url.Action("Index", new { Page = Page }))
                        </div>




                    </div>
                </div>

            </div>
        </div>

    </div>

</div>




