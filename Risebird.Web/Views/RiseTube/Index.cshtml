                                    <hr>

                                    @{
                                        var page = ViewBag.Page;
                                        var startCount = (page - 1) * 12 + 1;
                                        var endCount = (page) * 12;
                                    }
                                    @if (ViewBag.MeetingsCount == 0)
                                    {
                                        <p>
                                            No selected candidates are available as per requirement!
                                        </p>
                                    }
                                    else if (ViewBag.Pages == page && ViewBag.Remainder == 0)
                                    {
                                        var endNum = page * 12;
                                        <p>
                                            @startCount - @endNum of @ViewBag.MeetingsCount
                                        </p>
                                    }
                                    else if (ViewBag.Pages == page && ViewBag.Remainder != 1)
                                    {
                                        var endNum = (page - 1) * 12 + ViewBag.Remainder;
                                        <p>
                                            @startCount - @endNum of @ViewBag.MeetingsCount
                                        </p>
                                    }
                                    else if (ViewBag.Pages == page && ViewBag.Remainder == 1)
                                    {
                                        <p>
                                            @startCount of @ViewBag.MeetingsCount
                                        </p>
                                    }
                                    else
                                    {
                                        <p>
                                            @startCount - @endCount of @ViewBag.MeetingsCount
                                        </p>
                                    }

                                    <div class="pagination-container">
                                        <ul class="pagination">

                                            @{
                                                var startFrom = 0;
                                                var endWith = 0;
                                                if (page % 3 != 0)
                                                {
                                                    startFrom = ((page / 3) * 3) + 1;
                                                }
                                                else
                                                {
                                                    startFrom = (((page - 1) / 3) * 3) + 1;
                                                }
                                                var pages = ViewBag.Pages;

                                                if (pages - startFrom > 2)
                                                {
                                                    endWith = startFrom + 2;
                                                }
                                                else
                                                {
                                                    endWith = pages;
                                                }

                                            }

                                            @if (page > 3)
                                            {
                                                <li>
                                                    <a href="@Url.Action("Index", "Risetube", new { page = startFrom - 1, searchvalue = ViewBag.searchvalue })"
                                                       class="PagedList-skipToPrevious">
                                                        &laquo;
                                                    </a>
                                                </li>

                                            }
                                            @for (int i = startFrom; i <= endWith; i++)

                                            {

                                                <li class="@(i == ViewBag.page ? "page-item active" : "page-item")">
                                                    @Html.ActionLink(i.ToString(), "Index", "Risetube", new { Page = i, searchvalue = ViewBag.searchvalue }, htmlAttributes: new { @class = "" })

                                                </li>
                                            }


                                            @if (pages > endWith)
                                            {
                                                <li class="PagedList-skipToNext">
                                                    <a href="@Url.Action("Index", "Risetube", new { page = endWith + 1, searchvalue = ViewBag.searchvalue })">
                                                        &raquo;
                                                    </a>
                                                </li>

                                            }


                                        </ul>
                                    </div>


                                </div>

                            </div>


                        </div>
                        </div>

