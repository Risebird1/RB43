                maxHeight: 200
            });
            $("#OfferStatus").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#CandidateLocation").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
         $("#IsShortListed").multiselect({
                    includeSelectAllOption: true,
