@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.MeetingVM>

@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using X.PagedList.Mvc.Core;
@using X.PagedList;

@{
    ViewData["Title"] = "RiseTube";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pagination-container > ul > li {
        padding: 5px 12px !important;
        border-radius: 21px !important;
        border: 1px solid blanchedalmond !important;
        background: antiquewhite !important;
        margin: 2px 4px !important;
    }

    .pagination-container {
        float: right !important;
    }
</style>

<script src="~/RiseTube/vendor/jquery/jquery.min.js"></script>
<!-- Custom styles for this template-->
<link href="~/RiseTube/css/osahan.css" rel="stylesheet">
<!-- Owl Carousel -->
<link rel="stylesheet" href="~/RiseTube/vendor/owl-carousel/owl.carousel.css">
<link rel="stylesheet" href="~/RiseTube/vendor/owl-carousel/owl.theme.css">

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">RiseTube</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        @*<h4 class="card-title">RiseTube</h4>*@
                    </div>
                    <div class="card-body">

                        <div>

                            <hr>
                            <div class="video-block section-padding">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="main-title">
                                            <h6>Featured Videos</h6>
                                        </div>
                                    </div>
                                    @foreach (var item in Model)
                                    {
                                        var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                        <div class="col-xl-3 col-sm-6 mb-3">
                                            <div class="video-card">
                                                <div class="video-card-image">
                                                    @if (item.VideoLink.Contains(".mp4"))
                                                    {
                                                        <video width="100%" height="100%" controls>
                                                            <source src="@item.VideoLink" type="video/mp4">
                                                        </video>
                                                        <a class="play-icon" onclick="location.href='@Url.Action("VideoPage", "Risetube",item)'" style=" cursor: pointer;"></a>
                                                    }
                                                    else
                                                    {
                                                        <img src="~/RiseTube/img/video-icon.png" style="height:163px;" />
                                                        <a class="play-icon" onclick="location.href='@Url.Action("VideoPage", "Risetube",item)'" style=" cursor: pointer;"></a>
                                                    }

                                                    @*@if (item.VideoLink != null && item.VideoLink != "")
                                                        {
                                                            <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink style="height:158px;"></a>
                                                        }
                                                        else
                                                        {
                                                            <span> Video deleted !!!</span>
                                                        }*@
                                                </div>
                                                <div class="video-card-body">
                                                    <div class="video-title">
                                                        <a onclick="location.href='@Url.Action("VideoPage", "Risetube",item)'" style=" cursor: pointer;">@item.candidateName </a>

                                                        &nbsp; <span style="color: #6c757d;font-weight: 600;">(@item.JDTiltle.Split("|")[0])</span>
                                                    </div>

                                                    <div class="video-page text-success">
                                                        @*@item.candidateName &nbsp; <i class="fas fa-check-circle text-success"></i>*@

                                                    </div>
                                                    <div class="video-view">
                                                        &nbsp;<i class="fas fa-calendar-alt"></i> <span style="color: #343a40;font-weight: 600;">@item.interviewDate</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @*<div class="col-xl-3 col-sm-6 mb-3">
                                            <div class="video-card">
                                                <div class="video-card-image">
                                                    <a class="play-icon" href="#"><i class="fas fa-play-circle"></i></a>
                                                    <a href="#"><img class="img-fluid" src="~/RiseTube/img/v2.png" alt=""></a>
                                                    <div class="time">3:50</div>
                                                </div>
                                                <div class="video-card-body">
                                                    <div class="video-title">
                                                        <a href="#">There are many variations of passages of Lorem</a>
                                                    </div>
                                                    <div class="video-page text-success">
                                                        Education  <a title="" data-placement="top" data-toggle="tooltip" href="#" data-original-title="Verified"><i class="fas fa-check-circle text-success"></i></a>
                                                    </div>
                                                    <div class="video-view">
                                                        1.8M views &nbsp;<i class="fas fa-calendar-alt"></i> 11 Months ago
                                                    </div>
                                                </div>
                                            </div>
                                        </div>*@

                                </div>
                            </div>
                            <hr>
                            @Html.PagedListPager(Model, Page => Url.Action("Index", new { Page = Page }))
                        </div>




                    </div>
                </div>

            </div>
        </div>

    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>




<!-- Bootstrap core JavaScript-->
<script src="~/RiseTube/vendor/jquery/jquery.min.js"></script>
@*<script src="~/RiseTube/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>*@
<!-- Core plugin JavaScript-->
<script src="~/RiseTube/vendor/jquery-easing/jquery.easing.min.js"></script>
<!-- Owl Carousel -->
<script src="~/RiseTube/vendor/owl-carousel/owl.carousel.js"></script>
<!-- Custom scripts for all pages-->
<script src="~/RiseTube/js/custom.js"></script>


