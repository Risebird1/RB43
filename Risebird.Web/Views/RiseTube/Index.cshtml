<script type="text/javascript">

    $(document).ready(function () {
            $("#btnSearch").click(function () {
            var value = $("#txtsearch").val();
                window.location.href = "/risetube/Index?searchvalue=" + value;
                $('#myForm').trigger("reset");
        });
            $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }

        $("#PrimarySkill").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });


         $("#RFID").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
             buttonWidth: '100%',
                    maxHeight: 200
                });
         $("#ClientHR").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
             buttonWidth: '100%',
                    maxHeight: 200
                });

        $("#ConfirmationStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
            buttonWidth: '100%',
                    maxHeight: 200
                });

         $("#MeetingStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
             buttonWidth: '100%',
                    maxHeight: 200
                });

        $("#InterviewStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
            buttonWidth: '100%',
                    maxHeight: 200
                });

        $("#Interviewer").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
            buttonWidth: '100%',
                    maxHeight: 200
        });
            $("#CandidateName").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#ClientName").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#ApprovalStatus").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#JoiningStatus").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
