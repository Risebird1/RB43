                                                                        @foreach (var item in ViewBag.ClientNameList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }

                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="OfferStatus">
                                                                    Offer Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="OfferStatus" name="OfferStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in ViewBag.OfferStatusList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>



                                                        </div>
                                                    }
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="CandidateLocation">
                                                                Candidate Location
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="CandidateLocation" name="CandidateLocation" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in ViewBag.preferredLocationList)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        @if (ViewBag.ProfileName != "CuratedUser")
                                                        {
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="ApprovalStatus">
                                                                    Approval Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ApprovalStatus" name="ApprovalStatus" class="form-control multiselect" multiple="multiple">
