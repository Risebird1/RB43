                                                                    Candidate Name
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in ViewBag.CandidateList)
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
