        var candidateLocation =  @Html.Raw(Json.Serialize(CandidateLocation));
        var IsShortListed =  @Html.Raw(Json.Serialize(IsShortListed));
        var IsIntrested =  @Html.Raw(Json.Serialize(IsIntrested));
        var CandidateAvailable=@Html.Raw(Json.Serialize(CandidateAvailable));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#PrimarySkill").val(primarySkillsArr);
        $("#ClientHR").val(clientHR);
        $("#InterviewStatus").val(interviewStatus);
        $("#ApprovalStatus").val(approvalStatus);
        $("#JoiningStatus").val(joiningStatus);
        $("#OfferStatus").val(offerStatus);
        $("#CandidateName").val(candidateName);
        $("#ClientName").val(clientName);
        $("#CandidateLocation").val(candidateLocation);
        $("#IsShortListed").val(IsShortListed);
        $("#IsIntrested").val(IsIntrested);
        $("#CandidateAvailable").val(CandidateAvailable);


    }


