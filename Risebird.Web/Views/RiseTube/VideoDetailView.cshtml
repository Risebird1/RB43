@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.VideoDetails>
@{
    ViewData["Title"] = "Interview Deatils";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using X.PagedList.Mvc.Core;


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interview Deatils</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">



                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>
                            <div class="row">
                                <div class="card-header clearfix">
                                    <div class="pull-left">
                                        <h4 class="card-title">Interviewers</h4>
                                    </div>

                                    <div class="pull-right">
                                        @*<div class="newsletter">
                                            <div class="content">
                                                <div class="input-group" id="myForm">
                                                    <div class="searchbox">
                                                        <input id="searchinput" type="text" class="form-control txtsearch1" placeholder="Please enter interviewer's name or skill" value="@ViewBag.searchvalue">
                                                        <span class="input-group-btn" id="searchGo">
                                                            <button class="btn btn3" id="btnSearch" value="Search" type="submit"><svg style="fill: #fff;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path></svg></button>
                                                        </span>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>*@
                                        @foreach (var item in Model)
                                        {
                                            @Html.ActionLink("Back to List", "VideoPage", "Risetube", new { id = item.interviewid }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button", @style = "margin-top: 2px;" })
                                            @*<a href="~/RiseTube/VideoPage" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;"><span class="fa fa-chevron-left"></span> Back to List</a>*@
                                            break;
                                        }
                                    </div>



                                </div>
                            </div>
                            <div style="clear:both;padding:10px"></div>
                            <table style="width:100%">
                                <tr>
                                    <th>Video Link</th>
                                    <th>User Name</th>
                                    <th>Total View</th>
                                    <th>Total Time</th>

                                </tr>
                                @foreach (var item in Model)
                                {
                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                    <tr>
                                        <td>@item.VideoUrl</td>
                                        <td>@item.Candidate</td>
                                        <td>@item.Count</td>
                                        <td>@item.TimeSpend</td>

                                    </tr>


                                }
                            </table>
                            <div style="clear:both"></div>

                            @Html.PagedListPager(Model, Page => Url.Action("VideoDetailView", new { Page = Page }))
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
