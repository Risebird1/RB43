@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.VideoDetails>
@{
    ViewData["Title"] = "Interview Deatils";
    ViewBag.PageHeader = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using X.PagedList.Mvc.Core;


<div class="main-panel" id="main-panel">
  
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view">      <h4 class="card-title">Interviewers</h4></div>
                </div>


                <div class="pull-right">

                    @foreach (var item in Model)
                    {
                        @*Html.ActionLink("Back", "VideoPage", "Risetube", new { id = item.interviewid }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button", @style = "margin-top: 2px;" })*@
                        @*<a href="~/RiseTube/VideoPage" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;"><span class="fa fa-chevron-left"></span> Back</a>*@
                        break;
                    }
                </div>
            </div>
        </div>
    </div>


    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">



                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>
                        
                            <div style="clear:both;padding:10px"></div>
                            <table class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                <tr>
                                    <th>Candidate Email</th>
                                    <th>Video Link</th>
                                    <th>User Name</th>
                                    <th><span class="text-center">Total View</span>   </th>
                                    <th><span class="text-center">Total Time</span> </th>
                                    <th><span class="text-center">Video Time</span> </th>
                                    <th class="text-center">Action</th>

                                </tr>

                                @foreach (var item in Model)
                                {
                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                    <tr>
                                        <td>@item.CandidateEmail</td>
                                        <td><a href="@item.VideoUrl" target="_blank" title="@item.VideoUrl">Click Here</a></td>
                                        <td>@item.Candidate</td>
                                        <td class="text-center count-view"><span class="label-num"><strong>@item.Count</strong></span></td>
                                        <td class="text-center">@item.TimeSpend</td>
                                        <td>@item.CurrentTime</td>
                                        <td class="videodetail"><div class="sharing-btn"><i class="fa fa-share-alt"></i> <input type="button" value="Share" onclick="OpenSharePopup('@item.VideoUrl')" /></div></td>
                                    </tr>
                                }
                            </table>
                            <div style="clear:both"></div>
                            @Html.PagedListPager(Model, Page => Url.Action("VideoDetailView", new { Page = Page }))
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div id="PublicShareModel" class="modal modal-bg" style="z-index:10">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="sharing-icon" src="~/Newassets/img/share-3w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Share</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closepublicSharePopUp()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <input type="text" value="Shared" id="txtpublicsharetxt" hidden />
            <input type="text" value="" id="txtpublicshareurl" hidden />
            <div class="modal-body">
                <div class="col-md-12">
                    <label class="label-field desp-label" for="Please enter EmailIds"> Please Enter Email Id's</label>
                    <div class="sharing">
                        <textarea class="form-control" rows="2" id="txtpublicsharing" placeholder="Please enter EmailIds ';' seprated"></textarea>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class=" text-right">
                        <input type="button" onclick="SharepublicVedioLink()" id="btnintrested" class="mdc-button mdc-button--raised mdc-ripple-upgraded" value="Share">
                        <input style="background:#ff253a!important; line-height:13px;" type="button" onclick="closepublicSharePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function OpenSharePopup(videourl) {
        alert(videourl);
        //var videourl = $("#txt_" + index).val();
        var modal = document.getElementById("PublicShareModel");
        modal.style.display = "block";
        $("#txtpublicsharetxt").val("Shared");
        $("#txtpublicshareurl").val(videourl);
    }
    function closepublicSharePopUp() {
        var modal = document.getElementById("PublicShareModel");
        modal.style.display = "none";
        $("#txtpublicsharetxt").val("");
    }
    function SharepublicVedioLink() {
        if ($("#txtpublicsharing").val() != "") {
            if (window.confirm('Are you sure, you want to share this video?')) {
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioShareDetails",
                    data: { value: "Public", vedioid: $("#txtVedioId").val(), Name: $("#txthiddenCandidate").val(), Emailids: $("#txtpublicsharing").val(), currentUrl: $("#txtpublicshareurl").val() },
                    success: function (data) {
                        closepublicSharePopUp();
                    }
                });
            }
        }
    }
</script>