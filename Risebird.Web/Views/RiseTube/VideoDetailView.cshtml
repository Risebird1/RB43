<div id="PublicShareModel" class="modal modal-bg" style="z-index:10">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="sharing-icon" src="~/Newassets/img/share-3w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Share</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closepublicSharePopUp()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <input type="text" value="Shared" id="txtpublicsharetxt" hidden />
            <input type="text" value="" id="txtpublicshareurl" hidden />
            <div class="modal-body">
                <div class="col-md-12">
                    <label class="label-field desp-label" for="Please enter EmailIds"> Please Enter Email Id's</label>
                    <div class="sharing">
                        <textarea class="form-control" rows="2" id="txtpublicsharing" placeholder="Please enter EmailIds ';' seprated"></textarea>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class=" text-right">
                        <input type="button" onclick="SharepublicVedioLink()" id="btnintrested" class="mdc-button mdc-button--raised mdc-ripple-upgraded" value="Share">
                        <input style="background:#ff253a!important; line-height:13px;" type="button" onclick="closepublicSharePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function OpenSharePopup(videourl) {
        alert(videourl);
        //var videourl = $("#txt_" + index).val();
        var modal = document.getElementById("PublicShareModel");
        modal.style.display = "block";
        $("#txtpublicsharetxt").val("Shared");
        $("#txtpublicshareurl").val(videourl);
    }
    function closepublicSharePopUp() {
        var modal = document.getElementById("PublicShareModel");
        modal.style.display = "none";
        $("#txtpublicsharetxt").val("");
    }
    function SharepublicVedioLink() {
        if ($("#txtpublicsharing").val() != "") {
            if (window.confirm('Are you sure, you want to share this video?')) {
                $.ajax({
                    type: "POST",
                    url: "/RiseTube/VedioShareDetails",
                    data: { value: "Public", vedioid: $("#txtVedioId").val(), Name: $("#txthiddenCandidate").val(), Emailids: $("#txtpublicsharing").val(), currentUrl: $("#txtpublicshareurl").val() },
                    success: function (data) {
                        closepublicSharePopUp();
                    }
                });
            }
        }
    }
</script>