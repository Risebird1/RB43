@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@model IEnumerable<Risebird.Entities.ViewModel.VideoDetails>


@{
    ViewData["Title"] = "Interview Deatils";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interest Shows Details</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interview Interest Details</h4></div>
                </div>

                <div class="pull-right">


                    @Html.ActionLink("Back to List", "Index", "Risetube", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button", @style = "margin-top: 2px;" })



                </div>
            </div>
        </div>
    </div>



    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">



                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                                <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Candidate Email</th>
                                            <th>User</th>
                                            <th class="text-center">Video Link</th>
                                            <th class="text-center">Total View </th>
                                            <th class="text-center">Total Time </th>
                                            <th class="text-center">Video Time </th>

                                        </tr>
                                    </thead>
                                   
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                            <tr>
                                                <td>@item.CandidateEmail</td>
                                                <td>@item.Candidate</td>
                                                @if (!String.IsNullOrEmpty(item.ViewName))
                                                {
                                                    <td class="text-center"><a href="@item.VideoUrl" target="_blank" title="@item.VideoUrl">@item.ViewName</a></td>
                                                }
                                                else
                                                {
                                                    <td class="text-center"><a href="@item.VideoUrl" target="_blank" title="@item.VideoUrl">Click Here</a></td>
                                                }
                                                <td class="text-center count-view"><span class="label-num"><strong>@item.Count</strong></span></td>
                                                <td class="text-center">@item.TimeSpend</td>
                                                <td>@item.CurrentTime</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            <div style="clear:both"></div>

                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div id="PublicShareModel" class="modal modal-bg" style="z-index:10">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="sharing-icon" src="~/Newassets/img/share-3w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Share</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closepublicSharePopUp()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <input type="text" value="Shared" id="txtpublicsharetxt" hidden />
            <input type="text" value="" id="txtpublicshareurl" hidden />
            <div class="modal-body">
                <div class="col-md-12">
                    <label class="label-field desp-label" for="Please enter EmailIds"> Please Enter Email Id's</label>
                    <div class="sharing">
                        <textarea class="form-control" rows="2" id="txtpublicsharing" placeholder="Please enter EmailIds ';' seprated"></textarea>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class=" text-right">
                        <input type="button" onclick="SharepublicVedioLink()" id="btnintrested" class="mdc-button mdc-button--raised mdc-ripple-upgraded" value="Share">
                        <input style="background:#ff253a!important; line-height:13px;" type="button" onclick="closepublicSharePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button style=display:none; type=button id=x>x</button>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").hide();
                    }
                    else { $("#x").show(); }
                });
            }
        });
        var table = $('#meeting').DataTable();
    });
  


    
</script>
