@model Risebird.Entities.ViewModel.IRFVm
@using Risebird.Entities.Enum;

@{
    ViewData["Title"] = "Create Skills Channel";
    ViewBag.PageHeader = "Skills Channels / Create Skills Channel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    var Header = "<a href='/Template/Index'>Skills Channel</a>&nbsp;/&nbsp;Create Skill Channel";
    $('#txtpageHeader').empty().html(Header);
</script>


<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />



<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />


<div class="main-panel " id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">

                        @using (Html.BeginForm("Create", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "irfForm", @onsubmit = "return CheckConditions()" }))
                        {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @*@Html.HiddenFor(x => x.InterviewerId)*@

                            <div>
                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Create Skill Channel</h4></div>
                                </div>

                                <div class="tabCon">
                                    <div class="tab-menu">
                                        <ul class="tabs">
                                            <li><a href="#" class="active text-center" rel="tab-1" id="rtab-1">Event Details</a></li>
                                            <li><a href="#" rel="tab-2" class="" id="rtab-2">Tech Skill</a><span id="count_SkillCollection" class="skillcount">@(Model.SkillCollection != null ? Model.SkillCollection.Count() : 0)</span></li>
                                            <li><a href="#" rel="tab-3" class="text-center" id="rtab-3">Client User</a><span id="count_ClientTable" class="skillcount">@(Model.ClientCollection != null ? Model.ClientCollection.Count() : 0)</span></li>
                                            <li><a href="#" rel="tab-4" class="" id="rtab-4">Interviewer</a><span id="count_Interviewer" class="skillcount">@(Model.InterviewerCollection != null ? Model.InterviewerCollection.Count() : 0)</span></li>
                                        </ul>

                                    </div>

                                    <div>
                                        <h3 class="tab_drawer_heading" rel="tab-1">Event Details</h3>
                                        <div class="tab-box" id="tab-1" style="display:block;">
                                            <div class="tab-main-box clearfix">
                                                
                                                <div class="row">
                                                    
                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group" style="margin-bottom:20px;">
                                                            <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="Name">Client Name</label>
                                                            @if (Model.Profile == "Client")
                                                            {
                                                                @Html.DropDownList("ClientId", Model.Clients, "Select Client Name", new { @class = "select-css form-control", @disabled = "disabled" })
                                                                @Html.HiddenFor(m => m.ClientId)
                                                            }
                                                            else
                                                            {
                                                                @Html.DropDownList("ClientId", Model.Clients, "Select Client Name", new { @class = "select-css form-control", @onchange = "ClientChanged(this)" })

                                                            }
                                                            @Html.ValidationMessageFor(model => model.BillingOwner, "", new { @id = "error_ClientId", @class = "text-danger" })

                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group" style="margin-bottom:0px;">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.BillingOwner, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @Html.DropDownListFor(model => model.BillingOwner, Model.ClientUser, "Select Billing Owner", new { @class = "select-css form-control", @required = "required" })
                                                            @Html.ValidationMessageFor(model => model.BillingOwner, "", new { @id = "error_BillingOwner", @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.ClientName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @Html.EditorFor(model => model.ClientName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                                            @Html.ValidationMessageFor(model => model.ClientName, "", new { @id = "error_ClientName", @class = "text-danger" })

                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="row">


                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="JDTiltle">Job Title</label>
                                                            </div>
                                                            @Html.EditorFor(model => model.JDTiltle, new { htmlAttributes = new { @class = "form-control text-box single-line", @placeholder = "Add Primary Skill and Role(max 40 char)" } })
                                                            @Html.ValidationMessageFor(model => model.JDTiltle, "", new { @id = "error_JDTiltle", @class = "text-danger" })

                                                        </div>
                                                    </div>


                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group">
                                                            Upload JD <span class="red">*</span>


                                                            <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                                                <div class="mdc-radio mdc-radio--touch">
                                                                    <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Upload" onclick="RadioChanged(this.value)">
                                                                    <div class="mdc-radio__background">
                                                                        <div class="mdc-radio__outer-circle"></div>
                                                                        <div class="mdc-radio__inner-circle"></div>
                                                                    </div>
                                                                    <div class="mdc-radio__ripple"></div>
                                                                </div>
                                                            </div>
                                                            Provide JD Link <span class="red">*</span>

                                                            <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                                                <div class="mdc-radio mdc-radio--touch">
                                                                    <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Link" onclick="RadioChanged(this.value)">
                                                                    <div class="mdc-radio__background">
                                                                        <div class="mdc-radio__outer-circle"></div>
                                                                        <div class="mdc-radio__inner-circle"></div>
                                                                    </div>
                                                                    <div class="mdc-radio__ripple"></div>
                                                                </div>
                                                            </div>

                                                        </div>

                                                        <div class="form-group" style="display:none" id="linkDiv">

                                                            @Html.LabelFor(model => model.JDLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                            @Html.EditorFor(model => model.JDLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                        </div>
                                                        <div class="" style="display:none" id="uploadDiv">

                                                            @Html.LabelFor(model => model.JDFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                            @Html.TextBoxFor(model => model.JDFile, new { type = "file", @class = "choose-file", @accept = ".doc, .docx, .pdf, .txt" })

                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.JDLink, "", new { @id = "error_JDLink", @class = "text-danger" })

                                                    </div>

                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group" style="margin-bottom:0px;">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>

                                                            </div>
                                                            @*@Html.EditorFor(model => model.IRFId, new { htmlAttributes = new { @class = "form-control text-box single-line", @onblur = "checkUniqueness(this.value)" } })*@
                                                            @Html.EditorFor(model => model.IRFId, new { htmlAttributes = new { @class = "form-control text-box single-line", @readonly = "readonly" } })
                                                            @Html.ValidationMessageFor(model => model.IRFId, "", new { @id = "uniqueMsg", @class = "text-danger" })

                                                            @Html.HiddenFor(m=>m.IsAadhaarVerificationRequired)
                                                        </div>
                                                    </div>



                                                </div>
                                            </div>
                                        </div>

                                        <h3 class="tab_drawer_heading" rel="tab-2">Tech Skill</h3>
                                        <div class="tab-box" id="tab-2">
                                            <div class="tab-main-box">
                                                <div class="row">

                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            @*<input type="text" id="txtinterviewerskills" value="@ViewBag.InterviewerSkills" hidden />*@

                                                            <table class="table table-bordered mbn" id="SkillTable">
                                                                <thead>
                                                                    <tr>

                                                                        <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                                                                        <th width="35%" class="table_heading">Skill Name<span class="red">*</span></th>
                                                                        <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>
                                                                        <th width="10%" class="table_heading">Concepts</th>
                                                                        <th width="30%" class="table_heading">Nature of questions</th>
                                                                        <th width="10%" class="table_heading">Time limit</th>
                                                                        <th width="10%" class="table_heading text-center">Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.SkillCollection == null || Model.SkillCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.DropDownList("SkillCollection[0].LevelId", Model.LevelTech, "Select", new { @class = "select-css form-control " })

                                                                            </td>
                                                                            <td>
                                                                                @Html.DropDownList("SkillCollection[0].SkillId", Model.SkillsList, "Select", new { @class = "select-css form-control " })
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Weightage" name="SkillCollection[0].Weightage" type="number" max="100" min="1" value="100">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Concepts" name="SkillCollection[0].Concepts" type="text" maxlength="50">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Natureofquestion" name="SkillCollection[0].Natureofquestion" type="text" maxlength="50">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Timelimit" name="SkillCollection[0].Timelimit" type="number" max="30" min="1">
                                                                            </td>
                                                                            <td class="action text-center">

                                                                                <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>


                                                                            </td>
                                                                        </tr>

                                                                    }
                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                                        {
                                                                            <tr>

                                                                                <td>

                                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].LevelId, Model.LevelTech, new { @class = "form-control select-css" })

                                                                                </td>
                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].SkillId, Model.SkillsList, new { @class = "select-css form-control" })
                                                                                </td>

                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Weightage, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Concepts, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Natureofquestion, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Timelimit, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "30", @min = "1" } })
                                                                                </td>
                                                                                <td class="action text-center">
                                                                                    <div>

                                                                                        <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                        <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                                                                    </div>
                                                                                </td>
                                                                            </tr>

                                                                        }
                                                                    }


                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="SkillCollection_WeightageError"></label>
                                                            <label class="text-danger" id="SkillCollection_WeightageErrorDown" style="color:white!important; margin-left:415px"></label>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <h3 class="tab_drawer_heading" rel="tab-3">Client User</h3>
                                        <div class="tab-box" id="tab-3">
                                            <div class="tab-main-box">
                                                <div class="row">

                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table table-bordered mbn" id="ClientTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="table_heading">EmailId <span class="red">*</span></th>
                                                                        <th class="table_heading">Role</th>
                                                                        <th width="10%" class="table_heading text-center">Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.ClientCollection == null || Model.ClientCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.DropDownList("ClientCollection[0].ClientUserId", Model.ClientUser, "Select", new { @class = "select-css form-control ", @onchange = "ClientUserChanged(this.value, this.id)" })
                                                                            </td>
                                                                            <td>

                                                                                @Html.TextBoxFor(m => m.ClientCollection[0].Role, new { @class = "form-control", @readonly = "readonly" })

                                                                            </td>

                                                                            <td class="action text-center">
                                                                                <span id="btnPlus" onclick="AddRowClient()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                <span id="btnMinus" onclick="DeleteRow(this, 'ClientCollection', 'ClientUserId', 'Role')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.ClientCollection.Count(); i++)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.ClientCollection[i].ClientUserId, Model.ClientUser, new { @class = "form-control select-css ", @onchange = "ClientUserChanged(this.value, this.id)" })
                                                                                </td>
                                                                                <td>

                                                                                    @Html.TextBoxFor(m => m.ClientCollection[i].Role, new { @class = "form-control", @readonly = "readonly" })
                                                                                </td>

                                                                                <td class="action text-center">
                                                                                    <span id="btnPlus" onclick="AddRowClient()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                    <span id="btnMinus" onclick="DeleteRow(this, 'ClientCollection', 'ClientUserId', 'Role')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                                                                </td>
                                                                            </tr>

                                                                        }
                                                                    }

                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="error_client"></label>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <h3 class="tab_drawer_heading" rel="tab-4">Interviewer</h3>
                                        @{ 
                                            string displayStatus = string.Empty;//"block";

                                            if(Model.Profile == "Client")
                                            {
                                                displayStatus = "none";
                                            }
                                        }
                                        <div class="tab-box" id="tab-4">
                                            <div class="tab-main-box">
                                                <div class="row">

                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            @*<input type="text" id="txtinterviewerids" value="@ViewBag.InterviewerFromSearch" hidden />*@

                                                            <table class="table table-bordered mbn" id="InterviewerTable">
                                                                <thead>
                                                                    <tr>
                                                                        @if (Model.Profile == "Client")
                                                                        {
                                                                            <th width="20%" class="table_heading">Pseudonym</th>
                                                                        }
                                                                        else
                                                                        {
                                                                            <th width="20%" class="table_heading">EmailId</th>
                                                                        }
                                                                        <th width="50%" class="table_heading">Skills</th>
                                                                        
                                                                        <th width="20%" class="table_heading" style="display:@displayStatus">Per Interviewer Rate <span style="color:red">*</span></th>

                                                                        <th width="10%" class="table_heading"> Select </th>
                                                                        @if (Model.Profile == "Client")
                                                                        {
                                                                            <th width="30%" class="table_heading"> Coded Resume </th>
                                                                        }
                                                                        else
                                                                        {
                                                                            <th width="10%" class="table_heading"> Resume </th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.InterviewerCollection == null || Model.InterviewerCollection.Count() == 0)
                                                                    {
                                                                        <tr>

                                                                            <td>
                                                                                @if (Model.Profile == "Client")
                                                                                {
                                                                                    @Html.TextBoxFor(m => m.InterviewerCollection[0].NickName, new { @class = "form-control", @readonly = "readonly" })
                                                                                }
                                                                                else
                                                                                {
                                                                                    @Html.TextBoxFor(m => m.InterviewerCollection[0].EmailId, new { @class = "form-control", @readonly = "readonly" })
                                                                                }
                                                                                @Html.HiddenFor(m => m.InterviewerCollection[0].UserId)
                                                                            </td>
                                                                            <td>

                                                                                @Html.TextBox("InterviewerCollection[0].PrimarySkill", null, new { @class = "form-control", @readonly = "readonly" })

                                                                            </td>
                                                                            <td style="display:@displayStatus">
                                                                                @if (Model.Profile == "Admin" || Model.Profile == "SupportAdmin")
                                                                                {
                                                                                    @Html.TextBox("InterviewerCollection[0].PerSuccessRate", null, new { @class = "form-control", @type = "number", @min = "1" })

                                                                                }
                                                                                else
                                                                                {
                                                                                    @Html.TextBox("InterviewerCollection[0].PerSuccessRate", null, new { @class = "form-control", @type = "number", @min = "1", @readonly = "readonly" })

                                                                                }
                                                                            </td>
                                                                            <td class="text-center">
                                                                                @Html.CheckBoxFor(m => m.InterviewerCollection[0].IsActive)
                                                                            </td>
                                                                            @if (Model.Profile == "Client")
                                                                            {
                                                                                @if (!string.IsNullOrEmpty(Model.InterviewerCollection[0].CodedResumeLink))
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a href="@Model.InterviewerCollection[0].CodedResumeLink" target="_blank" data-tooltip="@Model.InterviewerCollection[0].CodedResumeLink">Resume</a>
                                                                                    </td>

                                                                                }
                                                                                else
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a onclick="" data-tooltip="">No Resume</a>
                                                                                    </td>
                                                                                }

                                                                            }
                                                                            else
                                                                            {

                                                                                @if (!string.IsNullOrEmpty(Model.InterviewerCollection[0].ResumeLink))
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a href="@Model.InterviewerCollection[0].ResumeLink" target="_blank" data-tooltip="@Model.InterviewerCollection[0].ResumeLink">Resume</a>
                                                                                    </td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a onclick="" data-tooltip="">No Resume</a>
                                                                                    </td>
                                                                                }

                                                                            }

                                                                        </tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.InterviewerCollection.Count(); i++)
                                                                        {
                                                                            <tr>

                                                                                <td>
                                                                                    @if (Model.Profile == "Client")
                                                                                    {
                                                                                        @Html.TextBoxFor(m => m.InterviewerCollection[i].NickName, new { @class = "form-control", @readonly = "readonly" })
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @Html.TextBoxFor(m => m.InterviewerCollection[i].EmailId, new { @class = "form-control", @readonly = "readonly" })
                                                                                    }
                                                                                    @Html.HiddenFor(m => m.InterviewerCollection[i].UserId)
                                                                                </td>
                                                                                <td>
                                                                                    @Html.TextBoxFor(m => m.InterviewerCollection[i].PrimarySkill, new { @class = "form-control", @readonly = "readonly" })

                                                                                </td>
                                                                                <td style="display:@displayStatus">
                                                                                    @if (Model.Profile == "Admin" || Model.Profile == "SupportAdmin")
                                                                                    {
                                                                                        @Html.TextBoxFor(m => m.InterviewerCollection[i].PerSuccessRate, new { @class = "form-control", @type = "number", @min = "1" })
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @Html.TextBoxFor(m => m.InterviewerCollection[i].PerSuccessRate, new { @class = "form-control", @type = "number", @min = "1", @readonly = "readonly" })
                                                                                    }
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    @Html.CheckBoxFor(m => m.InterviewerCollection[i].IsActive)
                                                                                </td>
                                                                                @if (Model.Profile == "Client")
                                                                                {
                                                                                    @if (!string.IsNullOrEmpty(Model.InterviewerCollection[i].CodedResumeLink))
                                                                                    {
                                                                                        <td class="cadName">
                                                                                            <a href="@Model.InterviewerCollection[i].CodedResumeLink" target="_blank" data-tooltip="@Model.InterviewerCollection[i].CodedResumeLink">Resume</a>
                                                                                        </td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="cadName">
                                                                                            <a onclick="" data-tooltip="">No Resume</a>
                                                                                        </td>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    @if (!string.IsNullOrEmpty(Model.InterviewerCollection[i].ResumeLink))
                                                                                    {
                                                                                        <td class="cadName">
