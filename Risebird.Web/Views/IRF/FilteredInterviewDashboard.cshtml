@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewVM>



<table id="meetingIRF" class="table table-bordered" cellspacing="0" width="100%" style="margin-top: 5px;">

    <thead>
        <tr style="background-color: #007bff;font-size:13px;color:#ffffff" ">
            <th>IRF ID</th>
            <th>Primary Skill</th>
            <th>Client Name</th>
            <th>Project Name</th>
            <th>Interview</th>
            <th>Unassigned Interview</th>
            <th>Concurrent Interviews</th>
            <th>Interviews Status</th>
            <th>Not Filled Report</th>
            <th>Quality Check Pending</th>
        </tr>
    </thead>
    @if (Model != null)
    {
        <tbody>
            @foreach (var item in Model)
            {
                <tr id=@item.IRFId>
                    <td> @item.IRFId </td>
                    <td> @item.PrimarySkill </td>
                    <td> @item.EndClientName </td>
                    <td> @item.ClientName </td>
                    <td> @item.InterviewCount</td>
                    <td> @item.UnassignedInterviewCount </td>
                    <th>@item.ConcurrentInterview</th>
                    <td> @item.SelectionCount </td>
                    <td> @item.InterviewsReportCount </td>
                    <td> @item.QualityCheck </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        <tbody>
            <tr rowspan="10">
                <td>No Data Available In Table</td>
            </tr>
        </tbody>
    }
</table>