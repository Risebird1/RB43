@model Risebird.Entities.ViewModel.CuratedGroup
@{
    ViewData["Title"] = "Add Project";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Add Curated Group</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">

                       

                        <div class="row">

                            <div class="card-header">
                                <h4 class="card-title">Add Curated Group</h4>
                            </div>

                            <div style="width: 100%;">&nbsp;</div>
                            <div class="col-md-4 col-sm-4 pr-1">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

                                </div>
                            </div>

                        </div>
                        <hr class="l-hr" />
                        <div id="tableID">
                            <table class="table table-bordered mbn" id="IRFList">
                                <thead>
                                    <tr>
                                        <th class="text-center border-db" style="font-size:15px!important; width:30%">IRF ID</th>
                                        <th class="text-center border-db" style="font-size:15px!important; width:40%">Primary Skills</th>
                                        <th class="text-center" style="font-size:15px!important;width:30%">Add</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.CuratedIRFMappings.Count(); i++)
                                    {
                                        <tr>

                                            <td class="text-center border-db"> <a id="@("irflink_"+i)" target="_blank" title="IRF" href='@Url.Action("EditIRF", "IRF", new { id = Model.CuratedIRFMappings[i].IRFId })'> @Model.CuratedIRFMappings[i].IRFName</a> </td>
                                            <td class="text-center border-db" width="30%">@Model.CuratedIRFMappings[i].PrimarySkills</td>
                                            <td class="text-center" width="20%">
                                                <div class="mdc-form-field" style="margin-bottom: 10px;">
                                                    <div class="mdc-checkbox">
                                                        @Html.CheckBoxFor(m => m.CuratedIRFMappings[i].IsAdded, new { @class = "mdc-checkbox__native-control", @onclick = "UpdateCGList(this.id)" })


                                                        <div class="mdc-checkbox__background">
                                                            <svg class="mdc-checkbox__checkmark"
                                                                 viewBox="0 0 24 24">
                                                                <path class="mdc-checkbox__checkmark-path"
                                                                      fill="none"
                                                                      d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                            </svg>
                                                            <div class="mdc-checkbox__mixedmark"></div>
                                                        </div>
                                                        <div class="mdc-checkbox__ripple"></div>


                                                    </div>
                                                </div>

                                            </td>
                                            @Html.HiddenFor(m => m.CuratedIRFMappings[i].IRFId)

                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer ">

                            <div class="row">
                                <div class="col-md-12 mc-button-area">
                                    @Html.ActionLink("Back to List", "CuratedGroups", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit" onclick="AddCuratedGroup()">Submit</button>
                                </div>
                            </div>
                        </div>


                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>
<script>
    var irfList = [];

    
    function AddCuratedGroup() {
        var cgName = document.getElementById('Name').value;
        $.ajax({
            url: '/IRF/AddCuratedGroup',
            type: 'POST',
            data: { 'irfList': irfList, 'cgName': cgName },
            success: function (data) {
                window.location.href = "/IRF/CuratedGroups";
            }
        });
    }

    function UpdateCGList(id) {
        var valueId = id.split('__')[0] + '__IRFId';
        var value = document.getElementById(valueId).value;
        var checked = document.getElementById(id).checked;
        if (checked) {
            //check if the array has this value
            if (irfList.includes(value)) {
                return;
            }
            //if not, add the value
            else {
                irfList.push(value);
                return;
            }

        }
        else {
            //check if the array has this value. If yes, remove the value
            if (irfList.includes(value)) {
                var index = irfList.indexOf(value);
                irfList.splice(index,1);
                return;
            }

            else {
                return;
            }

        }
    }
</script>

<script>
    $(document).ready(function () {

        $('#IRFList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order:[],
            responsive: false,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#IRFList').DataTable();
    });
</script>


