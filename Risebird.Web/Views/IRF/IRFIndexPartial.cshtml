@model Risebird.Entities.ViewModel.IRFViewModel
@*<link href="~/Newassets/css/irf.css?v=123456" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=123456" />
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css" />*@

@if (Model.IRFList != null && Model.IRFList.Count() > 0)
{
    @foreach (var item in Model.IRFList)
    {
        <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
            <div class="card-content-holder border card-blue">
                <div class="card-header">
                    <div class="w-full">
                        <div class="w60">
                            @if (item.IRFId != null && item.IRFId != "")
                            {
                                @if (item.IRFId.Length > 40)
                                {
                                    <a href="#" data-tooltip="@item.IRFId">
                                        <h6 class="pskill" title="@item.IRFId">@item.IRFId.Substring(0, 40)</h6>
                                    </a>
                                }
                                else
                                {
                                    <h6 class="pskill" title="@item.IRFId">@item.IRFId</h6>
                                }
                            }
                            else
                            {<h6></h6>}


                            @if (item.JDTiltle != null && item.JDTiltle != "")
                            {
                                @if (item.JDTiltle.Length > 40)
                                {
                                    <a href="#" data-tooltip="@item.JDTiltle">
                                        <span class="pskill" title="@item.JDTiltle.Split("|")[0]">(@item.JDTiltle.Split("|")[0].Substring(0, 40))</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="pskill" title="@item.JDTiltle.Split("|")[0]">(@item.JDTiltle.Split("|")[0])</span>
                                }
                            }
                            else
                            {<span></span>}

                        </div>

                        <div class="w40 card-header-buttons action">
                            @if ((!@item.IsClientUser && Model.Profile != "Recruiter" && Model.Profile != "CuratedUser") || (Model.Profile == "Client" && item.CreatedFromTemplateId != null && item.CreatedFromTemplateId.Value > 0))
                            {
                                <button class="mdc-fab app-fab--absolute notification" aria-label="StatsFlag">
                                    @if (item.flagcount > 0)
                                    {
                                        <span class="badge">@item.flagcount</span>
                                    }
                                    <span onclick="javascript:StatsFlag('@item.id');" title="StatsFlag" class="mdc-fab__icon material-icons">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bell" viewBox="0 0 16 16">
                                            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5.002 5.002 0 0 1 13 6c0 .88.32 4.2 1.22 6z" />
                                        </svg>
                                    </span>
                                </button>
                                <button id="skill_17" class="mdc-fab app-fab--absolute" aria-label="Edit">
                                    <span onclick="javascript:EditIRF('@item.id', '@item.CreatedFromTemplateId');" title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                </button>

                                <button id="skill_21" class="mdc-fab app-fab--absolute" aria-label="Interviewing Members">
                                    <span onclick="javascript:getIRFMembers('@item.id', '@item.IRFId');" title="Interviewing Members" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M16.5 12c1.38 0 2.49-1.12 2.49-2.5S17.88 7 16.5 7C15.12 7 14 8.12 14 9.5s1.12 2.5 2.5 2.5zM9 11c1.66 0 2.99-1.34 2.99-3S10.66 5 9 5C7.34 5 6 6.34 6 8s1.34 3 3 3zm7.5 3c-1.83 0-5.5.92-5.5 2.75V19h11v-2.25c0-1.83-3.67-2.75-5.5-2.75zM9 13c-2.33 0-7 1.17-7 3.5V19h7v-2.25c0-.85.33-2.34 2.37-3.47C10.5 13.1 9.66 13 9 13z" /></svg></span>
                                </button>
                                <button class="mdc-fab app-fab--absolute" aria-label="Share Email to check Interviewer availability">
                                    <span onclick="javascript:CheckIntervieweravailbility('@item.id', '@item.IRFId');" title="Share Email to check Interviewer availability" class="mdc-fab__icon material-icons">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-check-fill" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z" />
                                            <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                        </svg>
                                    </span>
                                </button>
                            }
                            @if (Model.Profile == "Client")
                            {
                                <button class="mdc-fab app-fab--absolute" aria-label="Broadcast Email to the Interviewers of this channel">
                                    <span onclick="javascript:OpenBroadcastModal('@item.id', '@item.IRFId');" title="Broadcast Email to the Interviewers of this channel" class="mdc-fab__icon material-icons">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-broadcast" viewBox="0 0 16 16"><path d="M3.05 3.05a7 7 0 0 0 0 9.9.5.5 0 0 1-.707.707 8 8 0 0 1 0-11.314.5.5 0 0 1 .707.707zm2.122 2.122a4 4 0 0 0 0 5.656.5.5 0 1 1-.708.708 5 5 0 0 1 0-7.072.5.5 0 0 1 .708.708zm5.656-.708a.5.5 0 0 1 .708 0 5 5 0 0 1 0 7.072.5.5 0 1 1-.708-.708 4 4 0 0 0 0-5.656.5.5 0 0 1 0-.708zm2.122-2.12a.5.5 0 0 1 .707 0 8 8 0 0 1 0 11.313.5.5 0 0 1-.707-.707 7 7 0 0 0 0-9.9.5.5 0 0 1 0-.707zM10 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" /></svg>
                                    </span>
                                </button>
                                <button class="mdc-fab app-fab--absolute" aria-label="Audio Recording">
                                    <span onclick="javascript:OpenVoiceRecordingModal('@item.id', '@item.IRFId');" title="Audio Recording" class="mdc-fab__icon material-icons">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-record" viewBox="0 0 16 16"><path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0 1A5 5 0 1 0 8 3a5 5 0 0 0 0 10z" /></svg>
                                    </span>
                                </button>
                            }
                            @if (Model.Profile != "Recruiter" && Model.Profile != "CuratedUser")
                            {
                                if (!item.IsDeleted)
                                {
                                    <button id="btnArchive_@item.id" @*id="skill_22"*@ class="mdc-fab app-fab--absolute trash-btn" aria-label="Archive">
                                        <span onclick="javascript:ArchiveIRF('@item.id', '@item.IRFId');" title="Archive" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM12 17.5L6.5 12H10v-2h4v2h3.5L12 17.5zM5.12 5l.81-1h12l.94 1H5.12z" /></svg></span>
                                    </button>
                                }
                                else
                                {
                                    <button id="btnUnArchive_@item.id" class="mdc-fab app-fab--absolute unarchive-btn" aria-label="UnArchive">
                                        <span onclick="javascript:UnArchiveIRF('@item.id', '@item.IRFId');" title="UnArchive" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20.55 5.22l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.15.55L3.46 5.22C3.17 5.57 3 6.01 3 6.5V19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.49-.17-.93-.45-1.28zM12 9.5l5.5 5.5H14v2h-4v-2H6.5L12 9.5zM5.12 5l.82-1h12l.93 1H5.12z" /></svg></span>
                                    </button>
                                }
                            }
                            @if (Model.Profile == "Admin" || Model.Profile == "HR" || Model.Profile == "SeniorHR")
                            {
                                <button class="mdc-fab app-fab--absolute" aria-label="Clone the Skills Channel" style="top:-2px;">
                                    <span onclick="location.href='@Url.Action("EditIRF", "IRF", new { id = item.id, isClone = true, templateId = item.CreatedFromTemplateId })'" title="Clone the Skills Channel" class="mdc-fab__icon material-icons">
                                        <i style="font-size:14px;" class="fa fa-clone"></i>

                                    </span>
                                </button>
                            }

                        </div>
                    </div>
                </div>

                <!-- irf body-->
                <div class="card-body">
                    <div class="row">
                        <div class="statusImg">
                            <img id="statusImage_@item.id" src="@Url.Content(@item.ImageUrl)" class="img-responsive">
                        </div>
                        <div class="statusInfo">
                            <div class="group inner list-group-item-text">
                                @if (Model.Profile != "CuratedUser")
                                {
                                    <div class="row clearfix">
                                        <div class="client-field">
                                            <span> Client Name: </span> <span title="@item.ClientCompName (@item.ClientName)">@item.ClientCompName (@item.ClientName)</span>
                                        </div>
                                    </div>

                                    <div class="row clearfix">
                                        <div class="client-field">   <span>End Date:</span><span style="font-weight:normal">@item.EndDate</span></div>
                                    </div>

                                    <div id="skill_3" class="row clearfix">
                                        <div class="client-field">
                                            <span>Total Candidates:</span><span style="font-weight:normal">@(item.TotalMeetings != null ? item.TotalMeetings : 0)</span>
                                        </div>
                                    </div>

                                    @if (Model.Profile != "Recruiter")
                                    {
                                        <div id="skill_4" class="row clearfix ">
                                            <div class="client-field">
                                                <span>Completed Interviews:</span><span style="font-weight:normal">@(item.ScheduledMeetings != null ? item.ScheduledMeetings : 0)</span>
                                            </div>
                                        </div>
                                    }
                                }

                                @if (Model.Profile != "CuratedUser")
                                {
                                    <div id="skill_5" class="row five clearfix">
                                        <div class="client-field">
                                            <span>Selected Candidates:</span><span style="font-weight:normal">@(item.SelectedMeetings != null ? item.SelectedMeetings : 0)</span>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(item.RisebirdHREmail))
                                {
                                    <div class="row clearfix">
                                        <div class="client-field">
                                            <span> Channel Owner: </span> <span title="@item.RisebirdHREmail">@item.RisebirdHREmail</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row clearfix">
                                        <div class="client-field">
                                            <span> Channel Owner: </span><span></span>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer action">
                    <div class="row">

                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2" id="irf-card-footer">

                            @if (@item.IRFStatus == "Active")
                            {
                                <h6 style="color: green;"> @item.IRFStatus</h6>
                            }
                            else if (@item.IRFStatus == "Paused")
                            {
                                <h6 style="color: grey;"> @item.IRFStatus</h6>
                            }
                            else
                            {
                                <h6 style="color: black;"> @item.IRFStatus</h6>
                            }
                        </div>

                        <div class="stats-bttm-btn  col-lg-10 col-md-10 col-sm-10 col-xs-10">

                            <button id="skill_10" class="mdc-fab app-fab--absolute item1" aria-label="Candidates List">
                                <span onclick="javascript:Candidates('@item.id', '@item.IRFId');" title="Candidates List" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg></span>
                            </button>

                            <button id="skill_8" class="mdc-fab app-fab--absolute item1" aria-label="Candidate Status">
                                <span onclick="javascript:CandidatesStatus('@item.id', '@item.IRFId');" title="Candidates Status" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="rgb( 255,255,255)" d="M23 8c0 1.1-.9 2-2 2-.18 0-.35-.02-.51-.07l-3.56 3.55c.05.16.07.34.07.52 0 1.1-.9 2-2 2s-2-.9-2-2c0-.18.02-.36.07-.52l-2.55-2.55c-.16.05-.34.07-.52.07s-.36-.02-.52-.07l-4.55 4.56c.05.16.07.33.07.51 0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2c.18 0 .35.02.51.07l4.56-4.55C8.02 9.36 8 9.18 8 9c0-1.1.9-2 2-2s2 .9 2 2c0 .18-.02.36-.07.52l2.55 2.55c.16-.05.34-.07.52-.07s.36.02.52.07l3.55-3.56C19.02 8.35 19 8.18 19 8c0-1.1.9-2 2-2s2 .9 2 2z" /></svg></span>
                            </button>

                            @if (Model.Profile == "Admin" || Model.Profile == "HR" || Model.Profile == "Client" || Model.Profile == "SeniorHR")
                            {
                                <button id="not_schedule" class="mdc-fab app-fab--absolute item1" aria-label="Not Scheduled Candidate">
                                    <span onclick="javascript:NotScheduledCandidate('@item.IRFId');" title="Not Scheduled Candidate" class="mdc-fab__icon material-icons">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-calendar-x" viewBox="0 0 18 18">
                                            <path d="M6.146 7.146a.5.5 0 0 1 .708 0L8 8.293l1.146-1.147a.5.5 0 1 1 .708.708L8.707 9l1.147 1.146a.5.5 0 0 1-.708.708L8 9.707l-1.146 1.147a.5.5 0 0 1-.708-.708L7.293 9 6.146 7.854a.5.5 0 0 1 0-.708z" />
                                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                                        </svg>
                                    </span>
                                </button>
                            }



                            @if (Model.Profile != "Recruiter")
                            {
                                <button id="skill_11" class="mdc-fab app-fab--absolute item2" aria-label="Meetings">
                                    <span onclick="javascript:InterviewMeetings('@item.id', '@item.IRFId');" title="Meetings" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z" /></svg></span>
                                </button>
                                <button id="skill_12" class="mdc-fab app-fab--absolute item3" aria-label="Selected Candidates">
                                    <span onclick="javascript:SelectedInterviewMeetings('@item.id', '@item.IRFId');" title="Selected Candidates" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="17" viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg></span>
                                </button>
                            }



                            @if (Model.Profile == "Admin" || Model.Profile == "HR" || Model.Profile == "SeniorHR")
                            {
                                <button id="skill_7" class="mdc-fab app-fab--absolute item1" aria-label="Candidate Feedback" style=" position: relative; top: -2px;">
                                    <span onclick="javascript:Candidatesfeedback('@item.IRFId');" title="Candidates Feedback" class="mdc-fab__icon material-icons">
                                        <i style="font-size: 16px;position: relative;top: -1px" class="fa fa-commenting-o"></i>
                                    </span>
                                </button>

                                <button id="skill_6" class="mdc-fab app-fab--absolute item1" aria-label="Send Candidate Feedback remainder">
                                    <span onclick="javascript:Candidatesfeedbackremainder('@item.IRFId');" title="Send Candidate Feedback remainder" class="mdc-fab__icon material-icons">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-share-fill" viewBox="0 0 20 20">
                                            <path d="M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z" />
                                        </svg>
                                    </span>
                                </button>

                            }
                            @if (Model.Profile == "Admin" || Model.Profile == "SeniorHR")
                            {<span class="laptop-view"> <br /></span>}
                            @if (Model.Profile != "CuratedUser")
                            {
                                @if (!@item.IsClientUser && Model.Profile != "Recruiter")
                                {
                                    <button id="skill_9" class="mdc-fab app-fab--absolute itemques" aria-label="Questions">
                                        <span onclick="javascript:AddComments('@item.id');" title="Questions" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M21.99 4c0-1.1-.89-2-1.99-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4-.01-18zM18 14H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z" /></svg></span>
                                    </button>
                                }


                                @if (Model.Profile != "Recruiter")
                                {


                                    <button id="skill_13" class="mdc-fab app-fab--absolute item2" aria-label="Meetings">
                                        <span onclick="javascript:MultipleCandidateInvites('@item.IRFId');" title="Multiple Candidate Meetings" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 18 18"><path d="M9 8c1.11 0 2-.9 2-2s-.89-2-2-2c-1.1 0-2 .9-2 2s.9 2 2 2zm4 0c1.11 0 2-.9 2-2s-.89-2-2-2c-.36 0-.69.1-.98.27.3.51.48 1.1.48 1.73s-.18 1.22-.48 1.73c.29.17.63.27.98.27zM9 9.2c-1.67 0-5 .83-5 2.5V13h10v-1.3c0-1.67-3.33-2.5-5-2.5zM5 7H3V5H2v2H0v1h2v2h1V8h2V7zm9.23 2.31c.75.6 1.27 1.38 1.27 2.39V13H18v-1.3c0-1.31-2.07-2.11-3.77-2.39z" /></svg></span>
                                    </button>

                                    <button id="skill_14" class="mdc-fab app-fab--absolute item4" aria-label="Schedule Meeting">
                                        <span onclick="location.href='@Url.Action("ShowCalendly", "IRF" , new {irfName=item.IRFId, calendlyLink=item.CalendlyLink})'" title="Schedule Meeting" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M13 9H9v4h4V9zm2-7h-1V1h-2v1H6V1H4v1H3c-.55 0-1 .45-1 1v12c0 .55.45 1 1 1h12c.55 0 1-.45 1-1V3c0-.55-.45-1-1-1zm-1 12H4V6h10v8z" /></svg></span>
                                    </button>

                                    <button id="skill_15" class="mdc-fab app-fab--absolute item5" aria-label="Stats">
                                        <span onclick="javascript:stats('@item.id', '@item.IRFId');" title="Stats" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" /></svg></span>
                                    </button>

                                    if (item.IsPaused)
                                    {
                                        <button id="skill_16" class="mdc-fab app-fab--absolute  " aria-label="Play">
                                            <span onclick="PlayIRF('@item.id', '@item.IRFId');" title="Play" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button id="skill_16" class="mdc-fab app-fab--absolute trash-btn" aria-label="Pause">
                                            <span onclick="PauseIRF('@item.id', '@item.IRFId');" title="Pause" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg></span>
                                        </button>
                                    }
                                }
                            }
                            @if (item.CalendlyLink != null && item.CalendlyLink.Contains("InterviewScheduler"))
                            {
                                <button class="mdc-fab app-fab--absolute subc" aria-label="Edit Scheduler Event">
                                    <span onclick="javascript:EditSchedulerEvent('@item.CalendlyLink')" title="Edit Scheduler Event" class="mdc-fab__icon material-icons"><i style="font-size:16px;" class="fa fa-calendar-check-o"></i></span>
                                </button>
                            }
                            @if (Model.Profile == "CuratedUser")
                            {
                                @if (item.SubId != null)
                                {
                                    <button class="mdc-fab app-fab--absolute allcur" aria-label="All">
                                        <span onclick="location.href='@Url.Action("VideoPage", "RiseTube",new { irfid=item.id,actionstatus="ALL"})'" title="All Selected Candidates" class="mdc-fab__icon material-icons">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41L6 19l1.41-1.41L1.83 12 .41 13.41z" /></svg>
                                        </span>
                                    </button>
                                    <button class="mdc-fab app-fab--absolute allshort" aria-label="ShortListed">
                                        <span onclick="location.href='@Url.Action("VideoPage", "RiseTube",new { irfid=item.id,actionstatus="ShortList"})'" title="Shortlisted Candidates" class="mdc-fab__icon material-icons">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"><path d="M14 10H2v2h12v-2zm0-4H2v2h12V6zM2 16h8v-2H2v2zm19.5-4.5L23 13l-6.99 7-4.51-4.5L13 14l3.01 3 5.49-5.5z" /></svg>
                                        </span>
                                    </button>
                                    <button class="mdc-fab app-fab--absolute allintsent" aria-label="Interest-Sent">
                                        <span onclick="location.href='@Url.Action("VideoPage", "RiseTube",new { irfid=item.id,actionstatus="Intrested"})'" title="Interest-Sent Candidates" class="mdc-fab__icon material-icons">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                                        </span>
                                    </button>
                                    <button class="mdc-fab app-fab--absolute allintac" aria-label="Interest-Accept">
                                        <span onclick="location.href='@Url.Action("VideoPage", "RiseTube",new { irfid=item.id,actionstatus="Accept"})'" title="Interest-Accept Candidates" class="mdc-fab__icon material-icons">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" /></svg>
                                        </span>
                                    </button>
                                    <button class="mdc-fab app-fab--absolute subc" aria-label="Unsubscribe">
                                        <span onclick="javascript:UnSubscribe('@item.id', '@item.IRFId','@item.JDTiltle.Split("|")[0]');" title="Unsubscribe" class="mdc-fab__icon material-icons">
                                            <i style="font-size:16px;" class="far fa-bell-slash"></i>
                                        </span>
                                    </button>
                                }
                                else
                                {
                                    <button class="mdc-fab app-fab--absolute subc" aria-label="Subscribe">
                                        <span onclick="javascript:Subscribe('@item.id', '@item.IRFId', '@item.JDTiltle.Split("|")[0]');setNav()" title="Subscribe" class="mdc-fab__icon material-icons"><i style="font-size:16px;" class="fas fa-bell"></i></span>
                                    </button>
                                }

                            }

                        </div>
                    </div>
                </div>

            </div>
        </div>
    }

}















