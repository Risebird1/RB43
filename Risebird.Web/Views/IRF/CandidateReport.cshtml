@model Risebird.Entities.ViewModel.EvaluatorReport


@{
    ViewData["Title"] = "Candidate Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    function dropDwnToolTips(id) {

        if (id.value == 0) {
            id.title = "";
        }
        else {
            id.title = id.value
        }
    }


</script>
<script type="text/javascript">

    $(document).ready(function () {
        $('.dropques option').wrap('<span>');

        var selectedOption = $('.dropques').find("[selected]");
        $(selectedOption).unwrap();



    })



</script>


<script type="text/javascript">

    function getOption(id) {
        selectElement = document.querySelector('#droplevel');
        output =
            selectElement.options[selectElement.selectedIndex].text;


        if (id.value == 0) {
            id.title = "";
        }
        else {
            id.title = output
        }


    }
</script>


