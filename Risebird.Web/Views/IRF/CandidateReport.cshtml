@model Risebird.Entities.ViewModel.EvaluatorReport


@{
    ViewData["Title"] = "Candidate Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    body {
        font-family: Roboto, sans-serif;
    }

    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }


    textarea::-webkit-scrollbar {
        width: 2px;
        height: 6px;
        background-color: var(--mdc-theme-primary, #018786) !important;
    }

    textarea::-webkit-scrollbar-thumb {
        background-color: #56a9ff;
        border: 1px solid #56a9ff;
        margin: 2px;
        border-radius: 2px;
    }




    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    .multiple_row > h2 {
        font-size: 16px;
        background: #42a5f5 !important;
        padding: 4px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 0px;
        margin-bottom: 10px;
    }



    .panel-header-sm {
        height: 85px;
        padding-top: 65px;
        background: none !important;
    }




    /* Modal */
    .modal-header {
        background: #42a5f5 !important;
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        color: #fff;
    }

    .modal input, .modal .dropdown-toggle {
        background: #99d1fc0f !important;
    }
    /* Modal */

    .talktext {
        padding: 8px 8px 4px 8px;
        text-align: left;
        line-height: 1.5em;
    }



    .card .card-header .card-title, .card .card-header h4.card-title {
        margin: 0 0px 10px 0;
    }




    .mdc-card-wrapper__text-section {
        padding: 16px;
    }

    .demo-card__title {
        font-family: Roboto, sans-serif;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;
        font-size: 1.25rem;
        line-height: 2rem;
        font-weight: 500;
        letter-spacing: .0125em;
        text-decoration: inherit;
        text-transform: inherit;
    }


    .mdc-fab {
        width: 30px !important;
        height: 30px !important;
        background-color: #53a5f5 !important;
    }

    .sidebar:after, .off-canvas-sidebar:after {
        background: #42a5f5 !important;
    }


    .border-bubble {
        border: 1px solid #620bee21;
    }

    .talk-bubble {
        display: inline-block;
        position: relative;
        font-size: 13px;
        height: auto;
        border-radius: 7px;
        margin: 5px 0px;
        background-color: #fff;
    }


        .talk-bubble textarea {
            resize: none;
            border: 0;
            background: #fff;
            padding: 5px;
        }

    .mdc-card {
        border-top: 3px #53a5f5 solid;
    }

    .mdc-button--raised:not(:disabled), .mdc-button--unelevated:not(:disabled) {
        background: #42a5f5 !important;
        font-family: Roboto, sans-serif;
        font-size: 12px;
        text-decoration: none;
    }

    .mdc-button--outlined:not(:disabled) {
        border-color: #42a5f5 !important;
        color: #42a5f5 !important;
    }

    .mdc-fab-secondary {
        background: #fff !important;
        color: #53a5f5 !important;
    }

    .navbar .navbar-wrapper {
        color: #143e67 !important;
    }

        .navbar .navbar-wrapper .navbar-brand {
            margin-right: 0.5rem;
        }

    .mc-button-area {
        text-align: right;
    }

    .mdc-card .form-control {
        border: 0;
        border-radius: 4px 4px 0 0;
        background: whitesmoke;
        height: 40px;
        font-size: 0.8rem;
        border-bottom: 1px rgba(0, 0, 0, 0.29) solid;
    }

        .mdc-card .form-control:focus {
            border-bottom: 2px rgb(80, 158, 235) solid;
        }

    .mdc-radio .mdc-radio__native-control:enabled:checked + .mdc-radio__background .mdc-radio__outer-circle, .mdc-radio .mdc-radio__native-control:enabled + .mdc-radio__background .mdc-radio__inner-circle {
        border-color: #53a5f5 !important;
    }






    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .table-responsive {
        overflow: hidden;
    }

    #AudioFile {
        margin: 0px 0px 15px 0px;
    }



    #PageVideoLink {
        margin: 0px 0px 10px 0px;
    }


    #VideoFile {
        margin: 0px 0px 10px 0px;
    }


    #Clienform textarea {
        min-height: 100px;
        width: 100%;
        display: inline-block;
        position: relative;
        /* width: 200px; */
        height: auto;
        border-radius: 10px;
        margin: 5px 0px;
        background-color: #eff7ff;
        border: 0;
        font-size: 13px;
        padding: 10px;
    }

        #Clienform textarea:after {
            content: ' ';
            position: absolute;
            width: 0;
            height: 0;
            left: auto;
            right: -20px;
            top: 38px;
            bottom: auto;
            border: 12px solid;
            border-color: #eff7ff transparent transparent #eff7ff;
        }


    .table {
        white-space: nowrap;
    }

    .canvasjs-chart-credit {
        display: none;
    }

    #ProctoringTable .label-type {
        background: #e8f5ff;
        padding: 8px 10px;
        border: 0;
    }

    .video-choose {
        position: relative;
        top: -28px;
    }

    .trash-btn {
        background: #d20505 !important;
    }

    .click {
        color: #53a5f5;
        text-decoration: underline;
    }

    .file-lable {
        color: #000 !important;
        font-size: 14px !important;
    }
    .upload-label {
        background: #57adf80f;
        padding: 5px 15px !important;
    }
    .control-label {
        color: #5f5c5c !important;
        font-weight: normal !important
    }

    .card-text-label {
        font-size: 13px !important;
    }
</style>

<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.js"></script>
<link href="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />

<script src="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

<div class="main-panel" id="main-panel">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
       
            <div class="navbar-wrapper" style="width: 100%; float: left; display: block;">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <div class="pull-left">
                    <a class="navbar-brand">
                        Candidate Report
                    </a>
                </div>
                <div class="pull-right"> <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="create_pdf" value="Generate PDF" onclick="getPDF()"></div>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">

        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">

                        <form action="/IRF/CandidateReport" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Candidate Details</h2>
                                        </div><!--end of multiple location-->
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.CandidateEmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateEmailId, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.currentEmployerName, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                            @Html.TextBoxFor(m => m.currentEmployerName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.PreferredLocation, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                            @Html.TextBoxFor(m => m.PreferredLocation, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SelectabilityScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.SelectabilityScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.HRReport.JoinabilityScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.HRReport.JoinabilityScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.TechSkillScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.TechSkillScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.SkillGeneralScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.SkillGeneralScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>
                                <div class="row">

                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.ResumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 upload-label" })

                                            @{
                                                if (Model.ResumeLink != null && Model.ResumeLink != "")
                                                {
                                                    <a id="resumeID" target="_blank" title="Resume" href=@Model.ResumeLink.ToString().Replace(" ", "%20") class="click col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label">Click here</a>
                                                }
                                            }

                                        </div>
                                    </div>


                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Report Details</h2>
                                        </div><!--end of multiple location-->
                                    </div>

                                    <div class="col-md-6 col-sm-6">

                                        <div class="card">
                                            <div class="card-body">
                                                <div class="col-lg-6 col-md-6 col-sm-6">

                                                    <div id="scoreChart" style="height: 200px; width: 100%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Selectability Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">

                                            <table class="table table-bordered mbn" id="SelectabilityTable">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">Required Level</th>
                                                        <th width="20%">Type</th>
                                                        <th width="35%">Value</th>
                                                        <th width="15%">Actual Level</th>
                                                        <th width="10%">Required Weightage</th>
                                                        <th width="10%">Actual Weightage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.SelectabilityEvaluatorReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.SelectabilityEvaluatorReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SelectabilityEvaluatorReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SelectabilityEvaluatorReportCollection[i].Name, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SelectabilityEvaluatorReportCollection[i].Value, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.SelectabilityEvaluatorReportCollection[i].ActualLevelId, (SelectList)Model.Level, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value,'SelectabilityEvaluatorReportCollection')" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SelectabilityEvaluatorReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.SelectabilityEvaluatorReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                @Html.HiddenFor(m => m.SelectabilityEvaluatorReportCollection[i].RequiredLevelId)

                                                            </tr>

                                                        }
                                                    }



                                                </tbody>
                                            </table>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.SelectabilityComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 card-text-label" })

                                                <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                    <div class="talktext">

                                                        @Html.TextAreaFor(m => m.SelectabilityComments, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%" })
                                                    </div>
                                                </div>

                                                </div>
                                                </div>
                                            </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Joinability Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">

                                            <table class="table table-bordered mbn" id="JoinabilityTable">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">Required Level</th>
                                                        <th width="20%">Type</th>
                                                        <th width="35%">Value</th>
                                                        <th width="15%">Actual Level</th>
                                                        <th width="10%">Required Weightage</th>
                                                        <th width="10%">Actual Weightage</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.HRReport.JoinabilityHRReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.HRReport.JoinabilityHRReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.HRReport.JoinabilityHRReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.HRReport.JoinabilityHRReportCollection[i].Name, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.HRReport.JoinabilityHRReportCollection[i].Value, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.HRReport.JoinabilityHRReportCollection[i].ActualLevelId, (SelectList)Model.Level, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value,'HRReport_JoinabilityHRReportCollection')" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.HRReport.JoinabilityHRReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.HRReport.JoinabilityHRReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                @Html.HiddenFor(m => m.HRReport.JoinabilityHRReportCollection[i].RequiredLevelId)

                                                            </tr>

                                                        }
                                                    }



                                                </tbody>
                                            </table>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.HRReport.JoinabilityComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 card-text-label" })


                                                <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                    <div class="talktext">

                                                        @Html.TextAreaFor(m => m.HRReport.JoinabilityComments, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%" })
                                                    </div>
                                                </div>
                                            </div>


                                                </div>
                                            </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>Tech Skill Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">
                                            <table class="table table-bordered mbn" id="SkillTable">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">Required Level</th>
                                                        <th width="40%">Skill Name</th>
                                                        <th width="20%">Actual Level</th>
                                                        <th width="15%">Required Weightage</th>
                                                        <th width="15%">Actual Weightage</th>
                                                    </tr>
                                                </thead>


                                                <tbody>
                                                    @if (Model.TechSkillEvaluatorReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.TechSkillEvaluatorReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillEvaluatorReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillEvaluatorReportCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.TechSkillEvaluatorReportCollection[i].ActualLevelId, (SelectList)Model.LevelTech, new { @class = "form-control", @onchange = "CalculateOverAll(this.id, this.value,'TechSkillEvaluatorReportCollection')" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillEvaluatorReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillEvaluatorReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                @Html.HiddenFor(m => m.TechSkillEvaluatorReportCollection[i].RequiredLevelId)
                                                                @Html.HiddenFor(m => m.TechSkillEvaluatorReportCollection[i].SkillId)


                                                            </tr>

                                                        }
                                                    }



                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.TechSkillComments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 card-text-label" })


                                            <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                <div class="talktext">

                                                    @Html.TextAreaFor(m => m.TechSkillComments, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%" })
                                                </div>
                                            </div>
                                        </div>



                                            </div><!--end of col-md-12-->

                                        </div>

                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="multiple_row">
                                            <h2>General Skill Report</h2>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">
                                            <table class="table table-bordered mbn" id="SkillGeneralTable">
                                                <thead>
                                                    <tr>
                                                        <th width="10%">Required Level</th>
                                                        <th width="20%">Type</th>
                                                        <th width="35%">Value</th>
                                                        <th width="15%">Actual Level</th>
                                                        <th width="10%">Required Weightage</th>
                                                        <th width="10%">Actual Weightage</th>
                                                    </tr>
