        objSelect.label = "Selectability Score";
        objSelect.legendText = "Selectability Score";
        arr.push(objSelect.y);
        document.getElementById("SelectabilityScore").value = selectabilityTotal;


        var objTech = { y: "", legendText: "", label: "" }
        //TechSkills actual weightage total
        var techItems = $('[id^="TechSkillEvaluatorReportCollection"][id$="WeightageActual"]');
        var techTotal = 0;
        for (i = 0; i < techItems.length; i++) {

            techTotal = parseInt(techTotal) + parseInt($("#TechSkillEvaluatorReportCollection_" + i + "__WeightageActual").val());

        }
        objTech.y = parseInt(techTotal);
        objTech.label = "Tech Skills Score";
        objTech.legendText = "Tech Skills Score";
        arr.push(objTech.y);
        document.getElementById("TechSkillScore").value = techTotal;

        var objGenSkill = { y: "", legendText: "", label: "" }
        //TechSkills actual weightage total
        var genSkillItems = $('[id^="SkillGeneralEvaluatorReportCollection"][id$="WeightageActual"]');
        var genSkillTotal = 0;
        for (i = 0; i < genSkillItems.length; i++) {

            genSkillTotal = parseInt(genSkillTotal) + parseInt($("#SkillGeneralEvaluatorReportCollection_" + i + "__WeightageActual").val());

        }
        objGenSkill.y = parseInt(genSkillTotal);
        objGenSkill.label = "General Skills Score";
        objGenSkill.legendText = "General Skills Score";
        arr.push(objGenSkill.y);
        document.getElementById("SkillGeneralScore").value = genSkillTotal;
        am4core.ready(function () {

            // Themes begin
            am4core.useTheme(am4themes_animated);
            // Themes end

            // Create chart instance
            var chart = am4core.create("scoreChart", am4charts.XYChart);//Tech General Joinability Selectability

            // Add data
            chart.data = [{
                "country": "Joinability",
                "visits": arr[0]

            }, {
                    "country": "Selectability",
                "visits": arr[1]
            }, {
                    "country": "Tech",
                "visits": arr[2]
            }, {
                    "country": "General",
                "visits": arr[3]
            }];

            // Create axes
            chart.logo.disabled = true;
            var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
            categoryAxis.dataFields.category = "country";
            categoryAxis.renderer.inside = true;
            categoryAxis.renderer.labels.template.valign = "top";
            categoryAxis.renderer.grid.template.location = 0;
            categoryAxis.renderer.minGridDistance = 30;
            chart.fontSize = 13;
            categoryAxis.renderer.labels.template.adapter.add("dy", function (dy, target) {
                if (target.dataItem && target.dataItem.index & 2 == 2) {
                    return dy;
                }
                return dy;
            });

            var valueAxis = chart.yAxes.push(new am4charts.ValueAxis());

            categoryAxis.renderer.grid.template.disabled = true;
            valueAxis.renderer.grid.template.disabled = true;

            // Create series
            var series = chart.series.push(new am4charts.ColumnSeries());
            series.dataFields.valueY = "visits";
            series.dataFields.categoryX = "country";
            series.name = "Visits";
            series.colorField = "color";
            series.columns.template.tooltipText = "{categoryX}: [bold]{valueY}[/]";
            series.columns.template.fillOpacity = .8;

            var columnTemplate = series.columns.template;
            columnTemplate.strokeWidth = 0;
            columnTemplate.strokeOpacity = 1;
            chart.colors.list = [
                am4core.color("#07BEF3"),
                am4core.color("#00F96B"),
                am4core.color("#F64042"),
                am4core.color("#ffbc50")

            ];
            series.columns.template.events.once("inited", function (event) {
                event.target.fill = chart.colors.getIndex(event.target.dataItem.index);
            });

        });


    }

</script>


