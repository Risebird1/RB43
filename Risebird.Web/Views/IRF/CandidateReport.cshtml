    function RenderChart() {
        var arr = [];

        //Joinability actual weightage total
        var objJoin = { y: "", legendText: "", label: "" }
        var joinabilityItems = $('[id^="HRReport_JoinabilityHRReportCollection"][id$="WeightageActual"]');
