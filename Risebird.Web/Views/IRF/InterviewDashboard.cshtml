@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewVM>
@{
    ViewData["Title"] = "Interview Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }

    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    td.wordwrap {
        display: inline-block !important;
        max-width: 250px !important;
        min-width: 250px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: top !important;
        white-space: nowrap !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }
    /*CSS FOR Loader*/
    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
            height: 100px;*/
        display: none;
        position: center !important;
        background-color: White;
        z-index: 999;
        /*opacity: 0.5;*/
        filter: alpha(opacity = 50);
    }

    table.dataTable > thead > tr > th, table.dataTable > tbody > tr > th, table.dataTable > tfoot > tr > th, table.dataTable > thead > tr > td, table.dataTable > tbody > tr > td, table.dataTable > tfoot > tr > td {
        max-width: 300px !important;
    }
</style>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Interview Request Forms</a>
                <a class="navbar-brand">Interview Dashboard</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">
                            Interview Dashboard
                        </h4>
                    </div>
                    <div class="card-body">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="toolbar">

                                <div class="row">

                                    <div class="col-md-3 ml-md-auto">
                                        <div class="form-group">
                                            @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "form-control", onchange = "FilterInterviewDashboard(this.value);" })
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                    </div>
                                </div>


                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableIRFID">
                                    <table id="meetingIRF" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>IRF ID</th>
                                                <th>Primary Skill</th>
                                                <th>Client Name</th>
                                                <th>End Client Name</th>
                                                <th>Interview</th>
                                                <th>Unassigned Interview</th>
                                                <th>Concurrent Interviews</th>
                                                <th>Interviews Status</th>
                                                <th>Not Filled Report</th>
                                                <th>Quality Check Pending</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>IRF ID</th>
                                                <th>Primary Skill</th>
                                                <th>Client Name</th>
                                                <th>End Client Name</th>
                                                <th>Interviews</th>
                                                <th>Unassigned Interviews</th>
                                                <th>Concurrent Interviews</th>
                                                <th>Interview Status</th>
                                                <th>Not Filled Report</th>
                                                <th>Quality Check Pending</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                            <tr id=@item.IRFId>
                                                <td> @item.IRFId </td>
                                                <td> @item.PrimarySkill </td>
                                                <td> @item.EndClientName </td>
                                                <td> @item.ClientName </td>
                                                <td> @item.InterviewCount</td>
                                                <td> @item.UnassignedInterviewCount </td>
                                                <td> @item.ConcurrentInterview </td>
                                                <td> @item.SelectionCount </td>
                                                <td> @item.InterviewsReportCount </td>
                                                <td> @item.QualityCheck </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>
  
</div>

<script>
    $(document).ready(function () {
        FilterInterviewDashboard("Today");// on page load default dropdownlist value set
        $('#meetingIRF').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meetingIRF').DataTable();
    });
</script>


<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingIRF").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingIRF").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingIRF").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function FilterInterviewDashboard(filterValue) {     
       
        $.ajax({
            type: "GET",
            url: "/IRF/FilteredInterviewDashboard",
            data: { 'filterValue': filterValue},
            success: function (data) {
                if (data == '') {
                    $('#tableIRFID').html('');
                    $('#tableIRFID').html('No interviews for ' + filterValue + '.');
                    $('#tableIRFID').css("margin-left", "452px");
                    return;
                }
                $('#tableIRFID').css("margin-left", "");
                $('#tableIRFID').html('');
                $('#tableIRFID').html(data);

                $('#meetingIRF').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meetingIRF').DataTable();



            },
            error: function (err) {
              
               
            }
        });
    }
</script>
