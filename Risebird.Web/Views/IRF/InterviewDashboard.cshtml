@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewVM>
@{
    ViewData["Title"] = "Interview Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a class="navbar-brand"> / &nbsp; Interview Dashboard</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="row">

                                    <div class="card-header">
                                        <div class="pull-left">  <h4 class="card-title">  Interview Dashboard</h4></div>

                                        <div class="pull-right">
                                            <div>
                                                <div class="form-group">
                                                    @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "select-css form-control select-box", onchange = "FilterInterviewDashboard(this.value);" })

                                                    @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                                </div>


                                            </div>
                                        </div>
                                    </div>

                                    </div>


                                </div>
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                    <div id="tableIRFID">
                                        <table id="meetingIRF" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Primary Skill</th>
                                                    <th>Client Name</th>
                                                    <th>End Client Name</th>
                                                    <th>Interview</th>
                                                    <th>Unassigned Interview</th>
                                                    <th>Concurrent Interviews</th>
                                                    <th>Interviews Status</th>
                                                    <th>Not Filled Report</th>
                                                    <th>Quality Check Pending</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Primary Skill</th>
                                                    <th>Client Name</th>
                                                    <th>End Client Name</th>
                                                    <th>Interviews</th>
                                                    <th>Unassigned Interviews</th>
                                                    <th>Concurrent Interviews</th>
                                                    <th>Interview Status</th>
                                                    <th>Not Filled Report</th>
                                                    <th>Quality Check Pending</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.IRFId>
                                                        <td> @item.IRFId </td>
                                                        <td> @item.PrimarySkill </td>
                                                        <td> @item.EndClientName </td>
                                                        <td> @item.ClientName </td>
                                                        <td> @item.InterviewCount</td>
                                                        <td> @item.UnassignedInterviewCount </td>
                                                        <td> @item.ConcurrentInterview </td>
                                                        <td> @item.SelectionCount </td>
                                                        <td> @item.InterviewsReportCount </td>
                                                        <td> @item.QualityCheck </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>

                            </div>

                        </div>
                        <!-- end content-->
                                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>

<script>
    $(document).ready(function () {
        FilterInterviewDashboard("Today");// on page load default dropdownlist value set
        $('#meetingIRF').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meetingIRF').DataTable();
    });
</script>


<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingIRF").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingIRF").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingIRF").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function FilterInterviewDashboard(filterValue) {

        $.ajax({
            type: "GET",
            url: "/IRF/FilteredInterviewDashboard",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '') {
                    $('#tableIRFID').html('');
                    $('#tableIRFID').html('No interviews for ' + filterValue + '.');
                    $('#tableIRFID').css("margin-left", "452px");
                    return;
                }
                $('#tableIRFID').css("margin-left", "");
                $('#tableIRFID').html('');
                $('#tableIRFID').html(data);

                $('#meetingIRF').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meetingIRF').DataTable();



            },
            error: function (err) {


            }
        });
    }
</script>
