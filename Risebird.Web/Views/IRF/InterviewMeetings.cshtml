<script>
    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
            $("#" + id).attr("data-changes", "1");
        }
    }

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }
    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });




    });


    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/IRF/InterviewMeetingsJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }


    function bindtableData(data) {
        var irfid = $("#hidirfid").val();
        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="10" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }
        for (var i = 0; i < data.length; i++) {
            html += '  <tr id="' + data[i].imid + '" data-changes="1">';
            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].imid + '" data-target=".' + data[i].imid + '" class="detail-row" onclick="changeicon(' + data[i].imid + ')">&nbsp;</td>';
            html += '  <td> ' + new Date(data[i].interviewDate).toLocaleString() + ' </td>';
            if (data[i].candidateName != null && data[i].candidateName != "") {

                if (data[i].isOnline == 1 && data[i].candidateName.Length > 20) {
                    html += '   <td><a onclick="directopenChat(' + data[i].candidateEmail + ')"><span class="dot" style="background-color:green"></span>' + data[i].candidateName.substring(0, 20) + '...  </a></td>';
                }
                else {
                    if (data[i].candidateName.length > 20) {

                        html += '  <td class="cadName"><a onclick="" data-tooltip="' + data[i].candidateName + '"><span class="dot"></span> ' + data[i].candidateName.substring(0, 20) + '... </a> </td>';


                    }

                    else {
                        html += ' <td class="cadName"> <a onclick=""><span class="dot"></span> ' + data[i].candidateName + ' </a> </td>';

                    }
                }
            }
            else {
                html += '<td></td>';
            }


            if ((data[i].interviewStatus != 4 && data[i].interviewStatus != 2) || (data[i].qcInterview > 0 && data[i].qcStatus == 1 && (data[i].interviewStatus == 4 || data[i].interviewStatus == 2))) {
                html += '  <td> <a id="reportId" target="_blank" title="Report Link" href="/Interview/AddReport?interviewId =' + data[i].imid + '&irfId=' + irfid + '"}>Report</a></td>';
            }
            else {
                html += '   <td>No Report</td>';
            }
            if (data[i].resumeLink != null && data[i].resumeLink != "") {
                html += '      <td> <a id="resumeId" target="_blank" title="Resume" href=' + data[i].resumeLink + '>Resume</a> </td>';
            }
            else {
                html += '    <td>No Resume</td>';
            }

            if (data[i].isHrOnline == 1 && data[i].clientHrContact.length > 20) {
                if (data[i].clientHrContact != null) {
                    html += '   <td>  <a onclick="directopenChat(' + data[i].clientHrContact + ')"><span class="dot" style="background-color:green"></span> ' + data[i].clientHrContact.substring(0, 20) + '... </a></td>';
                }


                else {
                    html += ' <td></td>';
                }


            }
            else {
                if (data[i].clientHrContact != null) {
                    html += '   <td>  <a onclick=""><span class="dot"></span>' + data[i].clientHrContact + ' </a></td>';
                }
                else { html += ' <td></td>'; }


            }
            if (data[i].confirmationStatus.trim() == "Cancelled") {
                html += '    <td class="text-center"> <a style="color:red">' + data[i].confirmationStatus + '</a></td>';


            }
            else {
                html += '  <td class="text-center">' + data[i].confirmationStatus + '</td>';
            }
            if (data[i].zoomLink != null && data[i].zoomLink != "") {
                html += '<td> <a id="zoomlinkId" target="_blank" title="Interview Link" href=' + data[i].zoomLink + '>Interview Link</a></td>';
            }
            else {
                html += '    <td>No Interview Link</td>';
            }
            if (data[i].meetingStatusStatusDesc != null) {
                html += '   <td>' + data[i].meetingStatusStatusDesc + ' </td>';
            }
            else {
                html += '  <td></td>';
            }
            if ((data[i].interviewStatus != 4 && data[i].interviewStatus != 2) || (data[i].qcInterview > 0 && data[i].qcStatus == 1 && (data[i].interviewStatus == 4 || data[i].interviewStatus == 2))) {
                if (data[i].intervieweStatusStatDesc != null) {

                    html += '    <td> ' + data[i].intervieweStatusStatDesc + ' </td>';
                }
                else {
                    html += '<td></td>';
                }
            }

            else {
                html += '    <td></td>';
            }

            html += '  </tr>';

            html += '    <tr class="collapse ' + data[i].imid + '">';

            html += '    <td colspan="999" class="child-section">';
            html += '   <table class="table table-striped ">';
            html += '     <tr>';
            html += '     <th>Candidate Contact</th>';
            html += '    <th>Current Employer</th>';
            html += '   <th>Expected Salary</th>';
            html += '   <th>Expected Joining Time</th>';
            html += '    <th>Preferred Location</th>';
            html += '    <th>Staffing Agency</th>';
            html += ' </tr>';
            html += '    <tr>';
            if (data[i].mobileNumber != null) {
                html += '  <td>' + data[i].mobileNumber + '</td>';

            }
            else {
                html += '  <td>No Contact</td>';
            }


            html += '  <td> ' + data[i].currentEmployerName + '</td>';
            html += ' <td> ' + data[i].expectedPerHourRate + ' </td>';
            html += '  <td> ' + data[i].joiningTime + ' </td>';
            html += '  <td> ' + data[i].preferredLocation + ' </td>';
            html += ' <td>' + data[i].staffingAgency + '</td>';
            html += '  </tr>';

            html += '  </table>';
            html += '   </td>';
            html += ' </tr>';
        }

        $("#tblbodyInterviewMeeting").empty().html(html);
    }


    function bindPages(pagecount, startpage, endpage, totalcount) {
        var irfid = $("#hidirfid").val();
        var irfname = $("#hidirfname").val();
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/IRF/InterviewMeetings/' + irfid + '?irfId=' + irfname + '&Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/IRF/InterviewMeetings/' + irfid + '?irfId=' + irfname + '&Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/IRF/InterviewMeetings/' + irfid + '?irfId=' + irfname + '&Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            //if (pagecount <= 10 && i == pagecount && i != 1) {
            //    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
            //    html += '<li class="PagedList-skipToNext"><a href="/IRF/InterviewMeetings/' + irfid +'?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
            //    html += '<li class="PagedList-skipToLast"><a href="/IRF/InterviewMeetings/' + irfid +'?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            //}
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"Client\"")
{

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/js/hopscotch.min.js" type="text/javascript"></script>

    <script type="text/javascript">

        hopscotch.registerHelper('addOverlay', function () {
            $('body').append('<div class="overlay"></div>');
        });

        hopscotch.registerHelper('removeOverlay', function () {
            $('.overlay').fadeOut(function () {
                $(this).remove();
                $('.helper').remove();
            });
        });

        hopscotch.listen('show', function () {
            var elementObject = $(hopscotch.getCurrTarget(tour));
            var element = $('#' + elementObject[0].id);

            element.prev().removeClass('overlay-relative');
            element.addClass('overlay-relative');

            if ($('.helper').length !== 0) {


                // Use Helper Layer for hilight target element.
                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });

            } else {

                // Add Helper Layer for highlight target element.
                var newHelper = '<div class="helper"></div>';
                $('body').append(newHelper);

                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });
