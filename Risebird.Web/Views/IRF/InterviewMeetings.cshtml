            html += '  <td> ' + data[i].currentEmployerName + '</td>';
            html += ' <td> ' + data[i].expectedPerHourRate + ' </td>';
            html += '  <td> ' + data[i].joiningTime + ' </td>';
            html += '  <td> ' + data[i].preferredLocation + ' </td>';
            html += ' <td>' + data[i].staffingAgency + '</td>';
            html += '  </tr>';

            html += '  </table>';
            html += '   </td>';
            html += ' </tr>';
        }

        $("#tblbodyInterviewMeeting").empty().html(html);
    }


    function bindPages(pagecount, startpage, endpage, totalcount) {
        var irfid = $("#hidirfid").val();
        var irfname = $("#hidirfname").val();
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/IRF/InterviewMeetings/' + irfid + '?irfId=' + irfname + '&Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/IRF/InterviewMeetings/' + irfid + '?irfId=' + irfname + '&Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/IRF/InterviewMeetings/' + irfid + '?irfId=' + irfname + '&Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            //if (pagecount <= 10 && i == pagecount && i != 1) {
            //    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
            //    html += '<li class="PagedList-skipToNext"><a href="/IRF/InterviewMeetings/' + irfid +'?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
            //    html += '<li class="PagedList-skipToLast"><a href="/IRF/InterviewMeetings/' + irfid +'?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            //}
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
