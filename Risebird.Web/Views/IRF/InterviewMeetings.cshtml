                                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                            Interviewer
                                                                        </label>
                                                                        <div class="col-md-12 col-sm-12">
                                                                            <select id="Interviewer" name="Interviewer" class="form-control multiselect" multiple="multiple">
                                                                                @foreach (var item in Model.Select(x => x.interviewer).Distinct().ToList())
                                                                                {
                                                                                    @if (item != null && item != "")
                                                                                    {
                                                                                        <option value="@item">@item</option>
                                                                                    }
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                    </div>*@
                                                                    <div class="form-group">
                                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientName">
                                                                            Candidate Name
                                                                        </label>
                                                                        <div class="col-md-12 col-sm-12">
                                                                            <select id="CandidateName" name="CandidateName" class="form-control multiselect" multiple="multiple">
                                                                                @foreach (var item in Model.Select(x => x.candidateName).Distinct().ToList())
                                                                                {
                                                                                    @if (item != null && item != "")
                                                                                    {
                                                                                        <option value="@item">@item</option>
                                                                                    }
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-6 col-sm-6">

                                                                    
                                                                    <div class="form-group">
                                                                        <label class="control-label  col-md-12 col-sm-12 desp-label" for="ConfirmationStatus">
                                                                            Confirmation Status
                                                                        </label>
                                                                        <div class="col-md-12 col-sm-12">
                                                                            <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                                @foreach (var item in Model.Select(x => x.confirmationStatus).Distinct().ToList())
                                                                                {
                                                                                    @if (item != null && item != "")
                                                                                    {
                                                                                        <option value="@item">@item</option>
                                                                                    }
                                                                                }
                                                                            </select>
                                                                        </div>
                                                                    </div>

                                                                    <div class="form-group">
                                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                            Interview Status
                                                                        </label>
                                                                        <div class="col-md-12 col-sm-12">
                                                                            <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                                @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                                {
                                                                                    @if (item != null && item != "")
