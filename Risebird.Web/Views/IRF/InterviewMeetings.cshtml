@*@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.MeetingVM>
@using X.PagedList.Mvc.Core;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interview Meetings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<input type="hidden" value="@ViewBag.IRFintId" id="hidirfid" />
<input type="hidden" value="@ViewBag.IRF" id="hidirfname" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a id="intmeet_1" class="navbar-brand">/ &nbsp; Interview Meetings</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->






    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="desktop-view">
                        <h4 class="card-title" style="margin-top:0PX;"> Interview Meetings list for <strong>@ViewBag.IRF</strong></h4>
                    </div>
                    <div class="mobile-view"> <h4 class="card-title"> Interview Meetings list for <strong>@ViewBag.IRF</strong></h4></div>
                </div>

                <div class="pull-right">
                    <div>

                        <div id="meeting_filter" class="dataTables_filter pull-left" style="margin-right:10px;">

                            <div id="intmeet_2" class="searchCon">

                                <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.Searchvalue">


                                <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                                @*<button style="display:none;" type="button" id="x">x</button>*@

                            </div>
                        </div>

                        @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                    </div>
                </div>
            </div>
        </div>
    </div>







    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">



                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th id='start' style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;" id='start'>Interview Date</th>
                                                            <th>Candidate Name</th>
                                                            <th id="intmeet_3">Report Link</th>
                                                            <th id="intmeet_4">Resume</th>
                                                            <th>Client HR</th>
                                                            <th id="intmeet_5">Confirmation Status</th>
                                                            <th id="intmeet_6">Interview Link</th>
                                                            <th id="intmeet_7">Meeting Status</th>
                                                            <th id="intmeet_8">Interview Status</th>

                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;">Interview Date</th>
                                                            <th>Candidate Name</th>
                                                            <th>Report Link</th>
                                                            <th>Resume</th>
                                                            <th>Client HR</th>
                                                            <th>Confirmation Status</th>
                                                            <th>Interview Link</th>
                                                            <th>Meeting Status</th>
                                                            <th>Interview Status</th>

                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyInterviewMeeting">
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr id="@item.imid" data-changes="1">
                                                                <td style="width:10px;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                <td> @item.interviewDate </td>
                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                {
                                                                    @if (item.IsOnline == 1 && item.candidateName.Length > 18)
                                                                    {
                                                                        <td>
                                                                            <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>     @item.candidateName.Substring(0, 18)...  </a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {

                                                                        @if (item.candidateName.Length > 18)
                                                                        {


                                                                            <td class="cadName">
                                                                                <a onclick="" data-tooltip="@item.candidateName"><span class="dot"></span> @item.candidateName.Substring(0, 18)... </a>
                                                                            </td>
                                                                        }

                                                                        else
                                                                        {
                                                                            <td class="cadName">
                                                                                <a onclick=""><span class="dot"></span> @item.candidateName </a>
                                                                            </td>
                                                                        }
                                                                    }

                                                                }
                                                                @if ((item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                                {
                                                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId= ViewBag.IRFintId})'>Report</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Report</td>
                                                                }
                                                                @if (item.resumeLink != null && item.resumeLink != "")
                                                                {
                                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }

                                                                @if (item.IsHrOnline == 1 && item.ClientHrContact.Length > 20)
                                                                {
                                                                    <td>
                                                                        <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact.Substring(0, 20)... </a>
                                                                    </td>


                                                                }
                                                                else
                                                                {

                                                                    <td>
                                                                        <a onclick=""><span class="dot"></span> @item.ClientHrContact </a>
                                                                    </td>
                                                                }
                                                                @if (item.confirmationStatus.Trim() == "Cancelled")
                                                                {
                                                                    <td class="text-center">
                                                                        <a style="color:red"> @item.confirmationStatus</a>
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td class="text-center"> @item.confirmationStatus</td>
                                                                }
                                                                @if (item.zoomLink != null && item.zoomLink != "")
                                                                {
                                                                    <td> <a id="zoomlinkId" target="_blank" title="Interview Link" href=@item.zoomLink>Interview Link</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Interview Link</td>
                                                                }

                                                                <td> @item.MeetingStatusStatusDesc </td>
                                                                @if ((item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                                {
                                                                    <td> @item.intervieweStatusStatDesc </td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }

                                                            </tr>

                                                            <tr class="collapse @item.imid">

                                                                <td colspan="999" class="child-section">
                                                                    <table class="table table-striped">
                                                                        <tr>
                                                                            <th>Candidate Contact</th>
                                                                            <th>Current Employer</th>
                                                                            <th>Expected Salary</th>
                                                                            <th>Expected Joining Time</th>
                                                                            <th>Preferred Location</th>
                                                                            <th>Staffing Agency</th>
                                                                        </tr>
                                                                        <tr>
                                                                            @if (item.MobileNumber != null)
                                                                            {
                                                                                <td>@item.MobileNumber</td>

                                                                            }
                                                                            else
                                                                            {
                                                                                <td>No Contact</td>
                                                                            }


                                                                            <td> @item.currentEmployerName </td>
                                                                            <td> @item.expectedPerHourRate </td>
                                                                            <td> @item.joiningTime </td>
                                                                            <td> @item.preferredLocation </td>
                                                                            <td>@item.staffingAgency</td>
                                                                        </tr>

                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right " id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("InterviewMeetings", new { Page = Page, id = ViewBag.IRFintId, irfId = ViewBag.IRF }))
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>

