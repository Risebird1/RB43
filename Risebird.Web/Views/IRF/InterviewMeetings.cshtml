@*@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.MeetingVM>
@using X.PagedList.Mvc.Core;
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.Data
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interview Meetings";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    //string[] Interviewer = new string[] { };
    string[] CandidateName = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("IRFInterviewFilter") != null)
{
    filter = JsonConvert.DeserializeObject<IRFInterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("IRFInterviewFilter"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    //Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
    CandidateName = filter.CandidateName != null ? filter.CandidateName : new string[] { };
}
<script>
    var Header = "<a href='/IRF/Index'>Skills Channel</a>&nbsp;/&nbsp;<a id='intmeet_1'>Interview Meetings</a>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<input type="hidden" value="@ViewBag.IRFintId" id="hidirfid" />
<input type="hidden" value="@ViewBag.IRF" id="hidirfname" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="desktop-view">
                        <h4 class="card-title" style="margin-top:0PX;"> Interview Meetings list for <strong>@ViewBag.IRF</strong></h4>
                    </div>
                    <div class="mobile-view"> <h4 class="card-title"> Interview Meetings list for <strong>@ViewBag.IRF</strong></h4></div>
                </div>

                <div class="pull-right client-ms">
                    <div class="interview_meetings">

                        <div id="meeting_filter" class="dataTables_filter pull-left">
                            <span class="interview_3 pull-left">

                                <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space " data-toggle="modal" data-target="#filterModal">

                                    <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                    <div class="mdc-button__ripple"></div>
                                </button>
                            </span>
                            <div id="intmeet_2" class="searchCon pull-left">


                                <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.Searchvalue">


                                <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                                @*<button style="display:none;" type="button" id="x">x</button>*@

                            </div>
                        </div>

                        @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                    </div>
                </div>
            </div>
        </div>
