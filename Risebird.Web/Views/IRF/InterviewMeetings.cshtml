                                                </div>
                                            </div>

                                        </div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th id='start' style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;" id='start'>Interview Date</th>
                                                            <th>Candidate Name</th>
                                                            <th id="intmeet_3">Report Link</th>
                                                            <th id="intmeet_4">Resume</th>
                                                            <th>Client HR</th>
                                                            <th id="intmeet_5">Confirmation Status</th>
                                                            <th id="intmeet_6">Interview Link</th>
                                                            <th id="intmeet_7">Meeting Status</th>
                                                            <th id="intmeet_8">Interview Status</th>

                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;">Interview Date</th>
                                                            <th>Candidate Name</th>
                                                            <th>Report Link</th>
                                                            <th>Resume</th>
                                                            <th>Client HR</th>
                                                            <th>Confirmation Status</th>
                                                            <th>Interview Link</th>
                                                            <th>Meeting Status</th>
                                                            <th>Interview Status</th>

                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyInterviewMeeting">
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr id="@item.imid" data-changes="1">
                                                                <td style="width:10px;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                <td> @item.interviewDate </td>
                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                {
                                                                    @if (item.IsOnline == 1 && item.candidateName.Length > 18)
                                                                    {
                                                                        <td>
                                                                            <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>     @item.candidateName.Substring(0, 18)...  </a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {

                                                                        @if (item.candidateName.Length > 18)
                                                                        {


                                                                            <td class="cadName">
                                                                                <a onclick="" data-tooltip="@item.candidateName"><span class="dot"></span> @item.candidateName.Substring(0, 18)... </a>
                                                                            </td>
                                                                        }

                                                                        else
                                                                        {
                                                                            <td class="cadName">
                                                                                <a onclick=""><span class="dot"></span> @item.candidateName </a>
                                                                            </td>
                                                                        }
                                                                    }

                                                                }
                                                                @if (!item.IsQCRequired)
                                                                {
                                                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId= ViewBag.IRFintId})'>Report</a> </td>

                                                                }
                                                                else
                                                                {
                                                                    @if ((item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                                    {
                                                                        <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId= ViewBag.IRFintId})'>Report</a> </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Report</td>
                                                                    }
                                                                }

                                                                @if (item.resumeLink != null && item.resumeLink != "")
                                                                {
                                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }

                                                                @if (item.IsHrOnline == 1 && item.ClientHrContact.Length > 20)
                                                                {
                                                                    <td>
                                                                        <a data-tooltip="@item.ClientHrContact" onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span> <span class="cname">    @item.ClientHrContact</span> </a>
                                                                    </td>


                                                                }
                                                                else
                                                                {

                                                                    <td>
                                                                        <a onclick=""><span class="dot"></span><span class="cname"> @item.ClientHrContact </span></a>
                                                                    </td>
                                                                }
                                                                @if (item.confirmationStatus.Trim() == "Cancelled")
                                                                {
                                                                    <td class="text-center">
                                                                        <a style="color:red"> @item.confirmationStatus</a>
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td class="text-center"> @item.confirmationStatus</td>
                                                                }
                                                                @if (item.zoomLink != null && item.zoomLink != "")
                                                                {
                                                                    <td> <a id="zoomlinkId" target="_blank" title="Interview Link" href=@item.zoomLink>Interview Link</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Interview Link</td>
                                                                }

                                                                <td> @item.MeetingStatusStatusDesc </td>

                                                                @if (item.IsQCRequired)
                                                                {
                                                                    @if ((item.InterviewStatus != 4 && item.InterviewStatus != 2) || (item.QCInterview > 0 && item.QCStatus == 1 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                                    {
                                                                        <td> @item.intervieweStatusStatDesc </td>
                                                                    }
                                                                    else if ((item.QCStatus == 2 && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                                    {
                                                                        <td> QC Failed(@item.intervieweStatusStatDesc)  </td>
                                                                    }
                                                                    else if (((item.QCStatus == null || item.QCStatus == 0) && (item.InterviewStatus == 4 || item.InterviewStatus == 2)))
                                                                    {
                                                                        <td> QC Pending(@item.intervieweStatusStatDesc)  </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td></td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td>@item.intervieweStatusStatDesc</td>

                                                                }



                                                            </tr>

                                                            <tr class="collapse @item.imid">

                                                                <td colspan="999" class="child-section">
                                                                    <table class="table table-striped">
                                                                        <tr>
                                                                            <th>Candidate Contact</th>
                                                                            <th>Current Employer</th>
                                                                            <th>Expected Salary</th>
                                                                            <th>Expected Joining Time</th>
                                                                            <th>Preferred Location</th>
                                                                            <th>Staffing Agency</th>
                                                                        </tr>
                                                                        <tr>
                                                                            @if (item.MobileNumber != null)
                                                                            {
                                                                                <td>@item.MobileNumber</td>

                                                                            }
                                                                            else
                                                                            {
                                                                                <td>No Contact</td>
                                                                            }


                                                                            <td> @item.currentEmployerName </td>
                                                                            <td> @item.expectedPerHourRate </td>
                                                                            <td> @item.joiningTime </td>
                                                                            <td> @item.preferredLocation </td>
                                                                            <td>@item.staffingAgency</td>
                                                                        </tr>

                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right " id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("InterviewMeetings", new { Page = Page, id = ViewBag.IRFintId, irfId = ViewBag.IRF }))
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>
<script type="text/javascript">

    $(document).ready(function () {
            $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }

            
            $("#ClientHR").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#ConfirmationStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#MeetingStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#InterviewStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            //$("#Interviewer").multiselect({
            //        includeSelectAllOption: true,
            //        selectedClass: 'active1',
            //        buttonWidth: '100%',
            //        maxHeight: 200
            //});

            $("#CandidateName").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
           
    });

    function ResetFilter() {
      
        if ('@filter' != null && '@filter' != '') {
            window.location.href = "/IRF/ResetIRFInterviewFilter";
        }

        else if ($('#filterModal').modal('hide')) {
            $('body').removeClass('modal-open')
            $('.modal-backdrop').remove() 
        } else {
            $('body').addClass('modal-open')
            $('.modal-backdrop').add() 
        }



    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
        var confirmationStatus =  @Html.Raw(Json.Serialize(ConfirmationStatus));
        var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
        var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
        //var interviewer =  @*@Html.Raw(Json.Serialize(Interviewer));*@
        var candidateName =  @Html.Raw(Json.Serialize(CandidateName));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#ClientHR").val(clientHR);
        $("#ConfirmationStatus").val(confirmationStatus);
        $("#MeetingStatus").val(meetingStatus);
        $("#InterviewStatus").val(interviewStatus);
        //$("#Interviewer").val(interviewer);
        $("#CandidateName").val(candidateName);
        
    }


</script>
