<script>
    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
            $("#" + id).attr("data-changes", "1");
        }
    }

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }
    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });




    });


    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/IRF/InterviewMeetingsJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }


    function bindtableData(data) {
        var irfid = $("#hidirfid").val();
        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="10" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }
        for (var i = 0; i < data.length; i++) {
            html += '  <tr id="' + data[i].imid + '" data-changes="1">';
            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].imid + '" data-target=".' + data[i].imid + '" class="detail-row" onclick="changeicon(' + data[i].imid + ')">&nbsp;</td>';
            html += '  <td> ' + new Date(data[i].interviewDate).toLocaleString() + ' </td>';
