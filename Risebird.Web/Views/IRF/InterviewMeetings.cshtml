            }

            if (data[i].isHrOnline == 1 && data[i].clientHrContact.length > 20) {
                if (data[i].clientHrContact != null) {
                    html += '<td><a onclick="directopenChat(' + data[i].clientHrContact + ')"><span class="dot" style="background-color:green"></span> ' + data[i].clientHrContact.substring(0, 20) + '... </a></td>';
                }


                else {
                    html += ' <td></td>';
                }


            }
            else {
                if (data[i].clientHrContact != null) {
                    html += '<td><a onclick=""><span class="dot"></span>' + data[i].clientHrContact + ' </a></td>';
                }
                else { html += ' <td></td>'; }


            }
            if (data[i].confirmationStatus.trim() == "Cancelled") {
                html += '<td class="text-center"> <a style="color:red">' + data[i].confirmationStatus + '</a></td>';


            }
            else {
                html += '  <td class="text-center">' + data[i].confirmationStatus + '</td>';
            }
            if (data[i].zoomLink != null && data[i].zoomLink != "") {
                html += '<td> <a id="zoomlinkId" target="_blank" title="Interview Link" href=' + data[i].zoomLink + '>Interview Link</a></td>';
            }
            else {
                html += '    <td>No Interview Link</td>';
            }
            if (data[i].meetingStatusStatusDesc != null) {
                html += '<td>' + data[i].meetingStatusStatusDesc + ' </td>';
            }
            else {
                html += '<td></td>';
            }
            debugger;
            if (data[i].isQCRequired) {
                if ((data[i].interviewStatus != 4 && data[i].interviewStatus != 2) || (data[i].qcInterview > 0 && data[i].qcStatus == 1 && (data[i].interviewStatus == 4 || data[i].interviewStatus == 2))) {
                    if (data[i].intervieweStatusStatDesc != null) {

                        html += '    <td> ' + data[i].intervieweStatusStatDesc + ' </td>';
                    }
                    else {
                        html += '<td></td>';
                    }
                }

                else {
                    html += '<td></td>';
                }
            }
            else {
                html += '    <td> ' + data[i].intervieweStatusStatDesc + ' </td>';
            }


            html += '</tr>';

            html += '<tr class="collapse ' + data[i].imid + '">';

            html += ' <td colspan="999" class="child-section">';
            html += '<table class="table table-striped ">';
            html += '<tr>';
            html += '<th>Candidate Contact</th>';
            html += '<th>Current Employer</th>';
            html += '<th>Expected Salary</th>';
            html += '<th>Expected Joining Time</th>';
            html += ' <th>Preferred Location</th>';
            html += '<th>Staffing Agency</th>';
            html += '</tr>';
            html += '<tr>';
            if (data[i].mobileNumber != null) {
                html += '<td>' + data[i].mobileNumber + '</td>';

