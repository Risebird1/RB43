@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "Interview Meetings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link href="~/Newassets/css/irf.css" rel="stylesheet" />
<script src="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.js"></script>
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a class="navbar-brand">/ &nbsp; Interview Meetings</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="toolbar">

                                <div class="row">


                                    <div class="card-header">
                                        <div class="pull-left"> <h4 class="card-title">       Interview Meetings list for <b>@ViewBag.IRF</b></h4></div>

                                        <div class="pull-right">
                                            <div>
                                                <div class="form-group" style="width:100px;float:left;    margin-right: 5px;">
                                                    @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "form-control", onchange = "FilterInterviews(this.value);" })
                                                </div>
                                                @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            </div>
                                        </div>
                                    </div>





                                </div>


                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Report Link</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Client HR</th>
                                                <th>Confirmation Status</th>
                                                <th>Interview Link</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Salary</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Report Link</th>
                                                <th>Resume</th>
                                                <th>Candidate Contact</th>
                                                <th>Client HR</th>
                                                <th>Confirmation Status</th>
                                                <th>Interview Link</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Salary</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.imid>
                                                    <td> @item.interviewDate </td>
                                                    @if (item.IsOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.candidateEmail')">    @item.candidateName <span class="dot" style="background-color:green"></span></a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            <a onclick="">@item.candidateName <span class="dot"></span></a>
                                                        </td>
                                                    }

                                                    @if (item.MeetingStatus != 4 || (item.QCInterview > 0 && item.MeetingStatus == 4))
                                                    {
                                                        <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId= ViewBag.IRFintId})'>Report</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Report</td>
                                                    }
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.MobileNumber != null)
                                                    {
                                                        <td>@item.MobileNumber</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No Contact</td>
                                                    }
                                                    <td> @item.ClientHrContact </td>
                                                    @if (item.zoomLink != null && item.zoomLink != "")
                                                    {
                                                        <td> <a id="zoomlinkId" target="_blank" title="Interview Link" href=@item.zoomLink>Interview Link</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Interview Link</td>
                                                    }
                                                    @if (item.confirmationStatus.Trim() == "Cancelled")
                                                    {
                                                        <td>

                                                            <a style="color:red"> @item.confirmationStatus</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td class="text-center"> @item.confirmationStatus</td>
                                                    }
                                                    <td> @item.MeetingStatusStatusDesc </td>
                                                    @if (item.QCInterview > 0)
                                                    {
                                                        <td> @item.intervieweStatusStatDesc </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    <td> @item.currentEmployerName </td>
                                                    <td> @item.expectedPerHourRate </td>
                                                    <td> @item.joiningTime </td>
                                                    <td> @item.preferredLocation </td>
                                                    <td>@item.staffingAgency</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>

<script>
    $(document).ready(function () {
        FilterInterviews("All");// on page load default dropdownlist value set
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#meeting').DataTable();
    });
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function FilterInterviews(filterValue) {

        var id = '@ViewBag.IRFintId';
        var irfId ='@ViewBag.IRF'
        $.ajax({
            type: "GET",
            url: "/IRF/GetFilteredInterviewMeetings",
            data: { 'filterValue': filterValue, 'id': id, 'irfId': irfId},
            success: function (data) {
                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>
