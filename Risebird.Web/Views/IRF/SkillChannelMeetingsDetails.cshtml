<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    function removeOrShortlistInterviewer(interviewid, action) {
        var bodyText;
        var confirmationButtonText;
        var successHtmlText;
        if (action == 'Rejected') {
            bodyText = 'Do you want to terminate this interviewer from taking further interviews for this Skill Channel?';
            confirmationButtonText = 'Yes, Remove it!';
            successHtmlText = '<p>The Interviewer has been removed.</p>';
        }
        else {
            bodyText = 'Do you want to shortlist this interviewer?';
            confirmationButtonText = 'Yes';
            successHtmlText = '<p>The Interviewer has been shortlisted.</p>';
        }

        swal.fire({
            title: 'Are you sure?',
            text: bodyText,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: confirmationButtonText,
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    captureclick('Interviewer Status', action, interviewid);
                    $.ajax({
                        type: "POST",
                        url: "/Interview/RemoveOrShortlistInterviewer",
                        data: { 'interviewid': interviewid, 'action': action },
                        success: function (result) {
                            resolve(result);
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successful!',
                    type: 'success',
                    html: successHtmlText,
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled! :)',
                    'error'
                )
            }
        })
    }
</script>
<script>
    var actionclick = 1;
    function captureclick(type, buttonaction, interviewid) {
        var currenturl = window.location.href;
        if (actionclick == 1) {
            actionclick = 0;
            $.ajax({
                url: '/ActivityTracker/CapturePageClick',
                method: 'POST',
                async: true,
                data: {
                    'type': type,
                    'currenturl': currenturl,
                    'buttonaction': buttonaction,
                    'interviewid': interviewid
                },
                success: function (result) {
                    actionclick = 1;
                }
            });
        }
    }
</script>
