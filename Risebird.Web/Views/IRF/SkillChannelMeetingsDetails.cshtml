</script>
<script>
    function ModalButtonClickjson(item) {
        var obj = list[item];
        ModalButtonClick(obj);
    }
    function ModalButtonClick(item) {
        imid = item.imid;

        // Get the modal
        var modal = document.getElementById("myModal");

        // When the user clicks the button, open the modal
        modal.style.display = "block";

        //document.getElementById("IsApproved").checked = item.IsApproved;
        document.getElementById("appComments").value = item.ApprovalComments;

        document.getElementById("selecComments").value = item.FinalComments;

        document.getElementById("joinComments").value = item.JoiningComments;

        document.getElementById("offComments").value = item.OfferComments;


        $.ajax({
            type: "GET",
            url: "/Interview/getApprovalStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#approveDropdown").html(s);
                if (item.IsApproved != null) {
                    $("#approveDropdown").val(item.IsApproved);
                }
                else {
                    $("#approveDropdown").val("-1");

                }
            }
        });

        $.ajax({
            type: "GET",
            url: "/Interview/getSelectionStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#selectionDropdown").html(s);
                if (item.IsSelected != null) {
                    $("#selectionDropdown").val(item.IsSelected);
                }
                else {
                    $("#selectionDropdown").val("-1");
                }


            }
        });

        $.ajax({
            type: "GET",
            url: "/Interview/getOfferStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#offerDropdown").html(s);
                if (item.OfferStatus != null) {
                    $("#offerDropdown").val(item.OfferStatus);
                }
                else {
                    $("#offerDropdown").val("-1");
                }

            }
        });

        $.ajax({
            type: "GET",
            url: "/Interview/getJoiningStatusList",
            data: "{}",
            success: function (data) {
                var s = '<option value="-1">Please Select a Status</option>';
                for (var i = 0; i < data.length; i++) {
                    s += '<option value="' + data[i].value + '">' + data[i].description + '</option>';
                }
                $("#joiningDropdown").html(s);
                if (item.JoiningStatus != null) {
                    $("#joiningDropdown").val(item.JoiningStatus);
                }
                else {
                    $("#joiningDropdown").val("-1");
                }

            }
        });


    }



    function SavePopUp() {

        var approvalComment = document.getElementById("appComments").value;
        var isApproved = document.getElementById("approveDropdown").value;

        var selectionComment = document.getElementById("selecComments").value;
        var isSelected = document.getElementById("selectionDropdown").value;

        var joiningComment = document.getElementById("joinComments").value;
        var joiningStatus = document.getElementById("joiningDropdown").value;

        var offerComment = document.getElementById("offComments").value;
        var offerStatus = document.getElementById("offerDropdown").value;
        var id = imid;

        $.ajax({
            type: "GET",
            url: "/Interview/SaveClientFeedback",
            data: { 'imid': id, 'isApproved': isApproved, 'approvalComment': approvalComment, 'isSelected': isSelected, 'selectionComment': selectionComment, 'joiningStatus': joiningStatus, 'joiningComment': joiningComment, 'offerStatus': offerStatus, 'offerComment': offerComment },
            success: function (data) {

                location.reload(true);

            }
        });
    }

</script>


<script>
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>
<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    function removeOrShortlistInterviewer(interviewid, action) {
        var bodyText;
        var confirmationButtonText;
        var successHtmlText;
        if (action == 'Rejected') {
            bodyText = 'Do you want to terminate this interviewer from taking further interviews for this Skill Channel?';
            confirmationButtonText = 'Yes, Remove it!';
            successHtmlText = '<p>The Interviewer has been removed.</p>';
        }
        else {
            bodyText = 'Do you want to shortlist this interviewer?';
            confirmationButtonText = 'Yes';
            successHtmlText = '<p>The Interviewer has been shortlisted.</p>';
        }

        swal.fire({
            title: 'Are you sure?',
            text: bodyText,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: confirmationButtonText,
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        type: "POST",
                        url: "/Interview/RemoveOrShortlistInterviewer",
                        data: { 'interviewid': interviewid, 'action': action },
                        success: function (result) {
                            resolve(result);
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successful!',
                    type: 'success',
                    html: successHtmlText,
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled! :)',
                    'error'
                )
            }
        })
    }
</script>
