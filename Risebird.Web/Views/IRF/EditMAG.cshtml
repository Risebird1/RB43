@if (!string.IsNullOrEmpty(Model.OutcomeMessage))
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@Model.OutcomeMessage';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful", '@Model.OutcomeMessage', "success");
            }
            else {
                swal.fire("Failed", '@Model.OutcomeMessage', "error");
            }
        }
    </script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(function () {
        $(".more-skill").each(function () {
            if ($(this).height() <= 50) {
                $('#expandbtn').css('display', 'none')
            }
            else {
                $('#expandbtn').css('display', 'block')
            }
        });

        $(".more-assessment").each(function () {
            if ($(this).height() <= 50) {
                $('#expandbtn1').css('display', 'none')
            }
            else {
                $('#expandbtn1').css('display', 'block')
            }
        });
    });
    $(document).ready(function () {
        $('#skill').removeClass("readmore");
        $('#expandbtn').click(function () {
            if ($('#skill').hasClass("readmore")) {
                $('#expandbtn').html('Read more');
                $('#skill').removeClass("readmore");

            } else {
                $('#expandbtn').html('Read less');
                $('#skill').addClass("readmore");

            }
        });

        $('#assessment').removeClass("readmore1");
        $('#expandbtn1').click(function () {

            if ($('#assessment').hasClass("readmore1")) {
                $('#expandbtn1').html('Read more');
                $('#assessment').removeClass("readmore1");

            } else {
                $('#expandbtn1').html('Read less');
                $('#assessment').addClass("readmore1");
            }
        });


    });
</script>
<script>
    
    function disableSubmitButton() {
        var button = document.getElementById("id_Submit_Form1");

        // Disable the button
        button.disabled = true;

        // Enable the button after 5 seconds
        setTimeout(function () {
            button.disabled = false;
        }, 5000);
    }
</script>
<script>
    // toggle class show hide text section
    $(document).on('click', '.toggle-title', function () {
        $(this).parent()
            .toggleClass('toggled-on')
            .toggleClass('toggled-off');
    });

</script>
