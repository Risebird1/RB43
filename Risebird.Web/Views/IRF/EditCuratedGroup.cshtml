@model Risebird.Entities.ViewModel.CuratedGroup
@{
    ViewData["Title"] = "Edit Curated Group";
    ViewBag.PageHeader = "Edit Curated Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=6" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=6" />

<div class="main-panel" id="main-panel">

    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bl-bg" >
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="whbg-wrap">
                            <div class="col-md-12" style="background:#fff;float:left;">

                                <div class="col-md-6 col-sm-6">
                                    <div class="form-group mob-mb-0">
                                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label  col-lg-2 col-md-3 col-sm-2 col-xs-2 pull-left desp-label", @style = "padding: 17px 10px 0px 10px;" })
                                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8 mobpad pull-left">
                                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control text-box single-line  curated-name" } })
                                            <label class="text-danger" id="nameError" style="color:red; font-size:14px"></label>
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr class="l-hr" />
                        <div id="tableID" class="curated-group">
                            <div class="table-responsive-sm">
                                <table class="table table-bordered mbn" id="IRFList">
                                    <thead>
                                        <tr>
                                            <th class="text-center border-db" style="font-size:15px!important;border:0px!important;">IRF Name</th>
                                            <th class="text-center  border-db" style="font-size:15px!important;border:0px!important;">Primary Skills</th>
                                            <th class="text-center " style="font-size:15px!important;border:0px!important;">Add</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.CuratedIRFMappings.Count(); i++)
                                        {
                                            <tr>

                                                <td class="text-center  border-db"> <a id="@("irflink_"+i)" target="_blank" title="IRF" href='@Url.Action("EditIRF", "IRF", new { id = Model.CuratedIRFMappings[i].IRFId })'> @Model.CuratedIRFMappings[i].IRFName</a> </td>
                                                <td class="text-center  border-db" width="30%">@Model.CuratedIRFMappings[i].PrimarySkills</td>
                                                <td class="text-center" width="20%">


                                                    <div class="mdc-form-field" style="margin-bottom: 10px;">
                                                        <div class="mdc-checkbox">
                                                            @Html.CheckBoxFor(m => m.CuratedIRFMappings[i].IsAdded, new { @class = "mdc-checkbox__native-control", @onclick = "UpdateIRFList(this.id)" })


                                                            <div class="mdc-checkbox__background">
                                                                <svg class="mdc-checkbox__checkmark"
                                                                     viewBox="0 0 24 24">
                                                                    <path class="mdc-checkbox__checkmark-path"
                                                                          fill="none"
                                                                          d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                                </svg>
                                                                <div class="mdc-checkbox__mixedmark"></div>
                                                            </div>
                                                            <div class="mdc-checkbox__ripple"></div>


                                                        </div>
                                                    </div>



                                                </td>
                                                @Html.HiddenFor(m => m.CuratedIRFMappings[i].IRFId)

                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card-footer ">
                            <div class="row">
                                <div class="col-md-12 mc-button-area">
                                    @Html.ActionLink("Back to List", "CuratedGroups", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit" onclick="EditCuratedGroup()">Save</button>
                                </div>
                            </div>

                        </div>



                    </div>


                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

<script>
    var irfList = [];

    $(document).ready(function () {

        $.each($("input[type=checkbox]:checked"), function () {
            var id = $(this).attr("id");
            var valueId = id.split('__')[0] + '__IRFId';
            irfList.push(document.getElementById(valueId).value);
        });
    });

    function EditCuratedGroup() {
        var cgName = document.getElementById('Name').value;
        if (cgName == null || cgName == '') {
            document.getElementById("nameError").innerHTML = 'This field is required. Kindly enter a name for the Curated Group.';
            document.getElementById("Name").focus();
            return;
        }
        else {
            document.getElementById("nameError").innerHTML = ''
        }
        $.ajax({
            url: '/IRF/EditCuratedGroup',
            type: 'POST',
            data: { 'irfList': irfList, 'cgName': cgName, 'cgId': @Model.id },
            success: function (data) {
                window.location.href = "/IRF/CuratedGroups";
            }
        });
    }

    function UpdateIRFList(id) {
        var valueId = id.split('__')[0] + '__IRFId';
        var value = document.getElementById(valueId).value;
        var checked = document.getElementById(id).checked;
        if (checked) {
            //check if the array has this value
            if (irfList.includes(value)) {
                return;
            }
            //if not, add the value
            else {
                irfList.push(value);
                return;
            }

        }
        else {
            //check if the array has this value. If yes, remove the value
            if (irfList.includes(value)) {
                var index = irfList.indexOf(value);
                irfList.splice(index, 1);
                return;
            }

            else {
                return;
            }

        }
    }
</script>


<script>
    function searchResult() {
        $('#IRFList').DataTable();
    }
    function RefreshSearch() {
        $('#IRFList').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#IRFList').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };



</script>
