    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Schedule Meeting for '@ViewBag.IRFName'</h4>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.CalendlyLink != null)
                        {
                            <div class="row">
                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                    <!-- Calendly inline widget begin -->
                                    <div class="calendly-inline-widget" data-url='@ViewBag.CalendlyLink' style="height:636px"></div>
                                    <!-- Calendly inline widget end -->
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                    <!-- Calendly inline widget begin -->
                                    <label style="margin-left:440px"><strong>Sorry! No Calendly Link available!</strong></label>
                                    <!-- Calendly inline widget end -->
                                </div>
                            </div>
                        }

                    </div>
