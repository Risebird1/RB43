
@{
    ViewData["Title"] = "Schedule Meeting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <style>
        .caret {
            display: none !important;
        }

        .multiselect-container {
            width: 100% !important;
        }

        .modal-lg {
            max-width: 690px !important;
        }

        .dropdown-toggle {
            background-color: white !important;
            color: black !important;
            border: 1px solid #ccc !important;
        }

        #StartDate, #EndDate {
            width: 270px;
        }

        .modal-content .modal-body {
            padding-top: 10px;
        }

        .buttons {
            border: none;
            font-family: inherit;
            font-size: inherit;
            color: inherit;
            background: none;
            cursor: pointer;
            padding: 8px 16px;
            display: inline-block;
            margin: 20px 5px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            outline: none;
            position: relative;
            -webkit-transition: all 0.3s;
            -moz-transition: all 0.3s;
            transition: all 0.3s;
            font-family: Arial, sans-serif;
        }

            .buttons:after {
                content: '';
                position: absolute;
                z-index: -1;
                -webkit-transition: all 0.3s;
                -moz-transition: all 0.3s;
                transition: all 0.3s;
            }

        .button-2 {
            background: #4fa4fb;
            color: #fff;
            -webkit-box-shadow: 0 3px #3884d2;
            -moz-box-shadow: 0 3px #3884d2;
            box-shadow: 0 3px #3884d2;
            -webkit-transition: none;
            -moz-transition: none;
            transition: none;
        }

        .button-2b {
            border-radius: 5px 5px 5px 5px;
            box-shadow: 0 3px #3884d2;
        }

            .button-2b:hover {
                box-shadow: 0 4px #3884d2;
                top: 0px;
            }

            .button-2b:active {
                outline: 0;
                border: 0;
            }

        .border-rv {
            border-right: 1px dotted #ccc;
        }

        .modal-header {
            border-bottom: 3px solid #316b9e !important;
            background: #419dff !important;
            padding-top: 15px !important;
            padding-bottom: 15px !important;
            color: #fff !important;
        }

        .modal-title {
            color: #fff !important;
        }

        .modal-wrap button {
            margin: 0px;
        }

        .modal-wrap .form-group {
            margin-bottom: 8px;
        }
    </style>
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Schedule Meeting</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
           
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Schedule Meeting for '@ViewBag.IRFName'</h4>
                    </div>
                    <div class="toolbar">

                        <div class="row">
                            
                            <div class="col-md-3 ml-md-auto">
                               @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "buttons button-2 button-2b", @role = "button", @style = "margin-top: 2px;" })
                            </div>


                        </div>

                    </div>
                    <div class="card-body">
                        @if (ViewBag.CalendlyLink != null)
                        {
                            <div class="row">
                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                    <!-- Calendly inline widget begin -->
                                    <div class="calendly-inline-widget" data-url='@ViewBag.CalendlyLink' style="height:636px"></div>
                                    <!-- Calendly inline widget end -->
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                    <!-- Calendly inline widget begin -->
                                    <label style="margin-left:440px"><strong>Sorry! No Calendly Link available!</strong></label>
                                    <!-- Calendly inline widget end -->
                                </div>
                            </div>
                        }

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    
</div>

<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js"></script>
