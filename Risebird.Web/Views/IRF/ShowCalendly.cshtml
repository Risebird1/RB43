
@{
    ViewData["Title"] = "Schedule Meeting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Schedule Meeting</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->



    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="desktop-view">
                        <h4 class="card-title">Schedule Meeting for <strong>'@ViewBag.IRFName'</strong></h4>
                    </div>
                    <div class="mobile-view"><h4 class="card-title">Schedule Meeting for <strong>'@ViewBag.IRFName'</strong></h4></div>
                </div>


                <div class="pull-right">
                    @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                </div>
            </div>
        </div>
    </div>






    <div class="content client">
        <div class="row bg-w">
            <div class="col-md-12">
                <div class="mdc-card card bg-w">
                    <div class="mdc-card-wrapper__text-section">


                        @if (ViewBag.CalendlyLink != null)
                        {
                            <div class="row">
                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                    <!-- Calendly inline widget begin -->
                                    <div class="calendly-inline-widget" data-url='@ViewBag.CalendlyLink' style="height:636px"></div>
                                    <!-- Calendly inline widget end -->
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                                    <!-- Calendly inline widget begin -->
                                    <label style="margin-left:440px"><strong>Sorry! No Calendly Link available!</strong></label>
                                    <!-- Calendly inline widget end -->
                                </div>
                            </div>
                        }


                        <!-- end content-->
                    </div>
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js"></script>
