        word-break: break-word;
    }
    .aiqs-jd-meta { margin: 0 0 16px; font-size: 13px; color: #64748b; }
    .aiqs-rubric { display: flex; flex-direction: column; gap: 10px; }
    .aiqs-rubric-row { display: grid; grid-template-columns: 1fr 52px; gap: 10px; align-items: center; }
    .aiqs-rubric-name { font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 4px; }
    .aiqs-bar {
        height: 7px;
        background: #ecfdf5;
        border-radius: 999px;
        overflow: hidden;
    }
    .aiqs-bar > span {
        display: block;
        height: 100%;
        background: #10b981;
        border-radius: 999px;
    }
    .aiqs-rubric-pct { text-align: right; font-size: 13px; font-weight: 700; color: #0f172a; }
    .aiqs-stats {
        display: flex;
        gap: 24px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid #f1f5f9;
    }
    .aiqs-stat { padding-right: 24px; border-right: 1px solid #e2e8f0; }
    .aiqs-stat:last-child { border-right: 0; padding-right: 0; }
    .aiqs-stat b { display: block; font-size: 22px; font-weight: 800; line-height: 1.1; }
    .aiqs-stat span { font-size: 12px; color: #64748b; }
    .aiqs-how { font-size: 13px; color: #475569; line-height: 1.5; margin: 0; }
    .aiqs-panel--ai {
        background: linear-gradient(180deg, #f5f3ff 0%, #ffffff 38%);
        border-color: #e9e4ff;
    }
    .aiqs-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 8px; }
    .aiqs-icon {
        width: 36px; height: 36px; border-radius: 50%;
        background: #7c3aed; color: #fff;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; font-size: 15px;
    }
    .aiqs-title {
        margin: 0 0 4px; font-size: 16px; font-weight: 700; color: #0f172a;
        display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
    }
    .aiqs-pill {
        display: inline-block; background: #f1f5f9; color: #64748b;
        border: 1px solid #e2e8f0; border-radius: 999px;
        padding: 2px 10px; font-size: 11px; font-weight: 600;
    }
    .aiqs-copy { margin: 0; color: #64748b; font-size: 13px; line-height: 1.45; }
    .aiqs-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 8px; }
    .aiqs-btn {
        border-radius: 999px; border: 1px solid transparent;
        padding: 8px 14px; font-size: 13px; font-weight: 600;
        cursor: pointer; line-height: 1.2;
    }
    .aiqs-btn[disabled] { opacity: 0.55; cursor: not-allowed; }
    .aiqs-btn--purple { background: #7c3aed; color: #fff; }
    .aiqs-btn--gray { background: #fff; color: #334155; border-color: #e2e8f0; }
    .aiqs-btn--teal { background: #059669; color: #fff; }
    .aiqs-status { min-height: 18px; font-size: 12.5px; color: #64748b; margin-bottom: 8px; }
    .aiqs-status.is-error { color: #b91c1c; }
    .aiqs-status.is-ok { color: #047857; }
    .aiqs-table-wrap { overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; }
    .aiqs-table { width: 100%; margin: 0; border-collapse: collapse; table-layout: fixed; }
    .aiqs-table th, .aiqs-table td {
        padding: 10px 12px; border-bottom: 1px solid #f1f5f9;
        vertical-align: top; font-size: 13px; color: #1e293b;
        white-space: normal; overflow-wrap: anywhere; word-break: break-word;
        overflow: hidden;
    }
    .aiqs-table th {
        background: #f8fafc; font-size: 11px; letter-spacing: 0.04em;
        text-transform: uppercase; color: #64748b; font-weight: 700;
    }
    .aiqs-table tr:last-child td { border-bottom: 0; }
    .aiqs-table .aiqs-skill-cell {
        width: 18%;
        max-width: 18%;
        overflow: hidden;
    }
    .aiqs-skill {
        display: inline-block;
        max-width: 100%;
        box-sizing: border-box;
        background: #ecfdf5; color: #047857;
        border: 1px solid #bbf7d0; border-radius: 8px;
        padding: 2px 8px; font-size: 11px; font-weight: 700;
        line-height: 1.35;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        hyphens: auto;
    }
    .aiqs-ideal-placeholder { color: #94a3b8; font-style: italic; }
    .aiqs-ideal { white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; color: #334155; }
    .aiqs-list-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
    .aiqs-list-title { margin: 0; font-size: 16px; font-weight: 700; }
    .aiqs-q { padding: 12px 0; border-bottom: 1px solid #f1f5f9; }
    .aiqs-q:last-child { border-bottom: 0; padding-bottom: 0; }
    .aiqs-q:first-child { padding-top: 8px; }
    .aiqs-q-text {
        font-size: 14px; font-weight: 600; color: #0f172a; margin-bottom: 6px; line-height: 1.45;
        white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;
    }
    .aiqs-q-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; color: #94a3b8; }
    .aiqs-empty { font-size: 13px; color: #94a3b8; margin: 8px 0 0; }
    .aiqs-manual .card-header { display: none; }
    .aiqs-manual .card-footer { background: transparent; border: 0; padding: 10px 0 0; }
    .aiqs-manual-title { margin: 0 0 10px; font-size: 16px; font-weight: 700; }
    @@media (max-width: 900px) {
        .aiqs-grid { grid-template-columns: 1fr; }
        #PopupDetailsModal.aiqs-popup-open .modal-dialog.modal-lg { width: 98vw !important; }
    }
</style>

<div class="aiqs-shell">
    <div class="aiqs-topbar">
        <span class="aiqs-dot"></span>
        <div class="aiqs-crumb">Risebird Skill Channels / <strong>@channelName</strong> · HM Instructions</div>
    </div>
    <div class="aiqs-grid">
        <div class="aiqs-col">
            <div class="aiqs-panel">
                <div class="aiqs-kicker">Job Description</div>
                <h3 class="aiqs-jd-title">@jdTitle</h3>
                @if (!string.IsNullOrWhiteSpace(clientMeta))
                {
                    <p class="aiqs-jd-meta">@clientMeta</p>
                }
                <div class="aiqs-kicker">Score Rubric</div>
                @if (rubricSkills.Count == 0)
                {
                    <p class="aiqs-empty">No rubric skills on this channel yet.</p>
                }
                else
                {
                    <div class="aiqs-rubric">
                        @foreach (var skill in rubricSkills)
                        {
                            var pct = skill.Weightage < 0 ? 0 : (skill.Weightage > 100 ? 100 : skill.Weightage);
                            <div class="aiqs-rubric-row">
                                <div>
                                    <div class="aiqs-rubric-name">@skill.SkillName</div>
                                    <div class="aiqs-bar"><span style="width:@(pct)%"></span></div>
                                </div>
                                <div class="aiqs-rubric-pct">@pct%</div>
                            </div>
                        }
                    </div>
                }
                <div class="aiqs-stats">
                    <div class="aiqs-stat"><b>@bankCount.ToString("N0")</b><span>questions in bank</span></div>
                    <div class="aiqs-stat"><b>@rubricSkills.Count</b><span>rubric skills matched</span></div>
                </div>
            </div>
            <div class="aiqs-panel">
                <div class="aiqs-kicker">How it works</div>
                <p class="aiqs-how">AI reads this channel's JD and rubric, then ranks questions <strong>already in your question database</strong>. It does not invent new questions. Ideal answers are generated on demand for the interviewer to score against.</p>
            </div>
        </div>
        <div class="aiqs-col">
            <div class="aiqs-panel aiqs-panel--ai" id="aiSuggestedQuestionsSection">
                <div class="aiqs-head">
                    <div class="aiqs-icon"><i class="fa fa-magic"></i></div>
                    <div>
                        <h4 class="aiqs-title">
                            AI Suggested Questions
                            <span class="aiqs-pill">based on JD · from your question database</span>
                        </h4>
                        <p class="aiqs-copy">Pick the strongest questions for this role, with an AI-written ideal answer your interviewer can score against.</p>
                    </div>
                </div>
                <div class="aiqs-actions">
                    <button type="button" class="aiqs-btn aiqs-btn--purple" id="aiSuggestBtn" onclick="suggestAIQuestions()">
                        <i class="fa fa-magic"></i> Suggest Top 10 with AI
                    </button>
                    <button type="button" class="aiqs-btn aiqs-btn--gray" id="aiIdealBtn" disabled="disabled" onclick="generateAIIdealAnswers()">
                        Generate Ideal Answers
                    </button>
                    <button type="button" class="aiqs-btn aiqs-btn--teal" id="aiSaveBtn" disabled="disabled" onclick="saveAIQuestions()">
                        Save Selected to Channel
                    </button>
                </div>
                <div class="aiqs-status" id="aiSuggestStatus"></div>
                <div class="aiqs-table-wrap" id="aiSuggestionsWrap" style="display:none;">
                    <table class="aiqs-table">
                        <thead>
                            <tr>
                                <th style="width:36px;"><input type="checkbox" id="aiSelectAll" checked="checked" onclick="toggleAISelectAll(this)" /></th>
                                <th class="aiqs-skill-cell">Skill</th>
                                <th>Question</th>
                                <th style="width:32%;">Ideal Answer</th>
                            </tr>
                        </thead>
                        <tbody id="aiSuggestionsBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="aiqs-panel">
                <div class="aiqs-list-head">
                    <h4 class="aiqs-list-title">Sample Questions on this Channel</h4>
                    <span class="aiqs-pill">@existingQuestions.Count @(existingQuestions.Count == 1 ? "question" : "questions")</span>
                </div>
                @if (existingQuestions.Count == 0)
                {
                    <p class="aiqs-empty">No sample questions on this channel yet.</p>
                }
                else
                {
                    foreach (var q in existingQuestions)
                    {
                        <div class="aiqs-q">
                            <div class="aiqs-q-text">@(string.IsNullOrWhiteSpace(q.Comment) ? "Question Missing" : q.Comment)</div>
                            <div class="aiqs-q-meta">
                                @if (!string.IsNullOrWhiteSpace(q.SkillName))
                                {
                                    <span class="aiqs-skill">@q.SkillName</span>
                                }
                                @if (q.IsAIGenerated)
                                {
                                    <span class="dm-v4-badge dm-v4-badge--ai">AI</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(q.CreatedBy))
                                {
                                    <span>added by @q.CreatedBy</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(q.IdealAnswer))
                            {
                                <details class="dm-v4-ideal-answer" style="margin-top:8px;">
                                    <summary>Ideal Answer (AI)</summary>
                                    <div class="dm-v4-ideal-answer__body">@q.IdealAnswer</div>
                                </details>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="aiqs-panel aiqs-manual" style="margin-top:16px;">
        <h4 class="aiqs-manual-title">Add questions manually</h4>
        <form action="/IRF/SkillChannelSampleQuestions" enctype="multipart/form-data" id="questionform" method="post" class="ng-pristine ng-valid">
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <div class="card-header">
                                    <h4 class="card-title">Sample Questions (Add Your Questions Here)</h4>
                                </div>
                                <div style="width:100%; float:left;height:10px;"></div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="sample-qs">
                                        <table class="table mbn" id="QuestionsNewTable">
                                            <thead>
                                                <tr>
                                                    <th class="table_heading b-right">Skill Name</th>
                                                    <th class="table_heading b-right">Questions</th>
                                                    <th class="table_heading b-right">Expected Answer</th>
                                                    <th class="table_heading b-right text-center">Coding Question</th>
                                                    <th colspan="2" class="table_heading text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                    <tr>
                                                        <td class="b-right">
                                                            @Html.DropDownList("SkillCollection[0].SkillName", (SelectList)ViewBag.Skills, new { @class = "select-css form-control" })
                                                        </td>
                                                        <td class="b-right">
                                                            <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                                <div class="talktext">
                                                                    <textarea htmlattributes="{ class = form-control text-box single-line }" id="SkillCollection_0__Comment" style="width:100%" name="SkillCollection[0].Comment" class="valid" aria-invalid="false" onblur="checkQuestionLength(this.id)"></textarea>
                                                                </div>
                                                                <label id="questionError_0" class="text-danger"></label>
                                                            </div>
                                                        </td>
                                                        <td class="b-right">
                                                            <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                                <div class="talktext">
                                                                    <textarea htmlattributes="{ class = form-control text-box single-line }" id="SkillCollection_0__ExpectedAnswer" style="width:100%" name="SkillCollection[0].ExpectedAnswer" class="valid" aria-invalid="false" onblur="checkQuestionLength(this.id)"></textarea>
                                                                </div>
                                                                <label id="expectedAnswerError_0" class="text-danger"></label>
                                                            </div>
                                                        </td>
                                                        <td class="b-right text-center">
                                                            <label style="font-weight:normal;">
                                                                <input type="checkbox" id="SkillCollection_0__IsCodingQuestion" name="SkillCollection[0].IsCodingQuestion" value="true" onchange="toggleCodingTimeLimit(this)" />
                                                                Is Coding
                                                            </label>
                                                            <div style="margin-top:6px;">
                                                                <input type="number" min="1" max="180" step="1" placeholder="Time limit (min)" title="Time limit in minutes for this coding question"
                                                                       id="SkillCollection_0__CodingTimeLimitInMinutes" name="SkillCollection[0].CodingTimeLimitInMinutes"
                                                                       class="form-control" style="width:100%;" disabled />
                                                            </div>
                                                            <div style="margin-top:6px;display:none;" class="coding-gist-wrap">
                                                                <textarea id="SkillCollection_0__QuestionGist" name="SkillCollection[0].QuestionGist"
                                                                          class="form-control coding-gist" style="width:100%;" rows="3"
                                                                          placeholder="Question gist in plain language"
                                                                          title="The AI avatar reads this out instead of the code, which cannot be narrated"
                                                                          onblur="checkQuestionLength(this.id)"></textarea>
                                                                <small class="text-muted">Spoken by the AI avatar in place of the code.</small>
                                                            </div>
                                                            <label id="codingError_0" class="text-danger coding-error"></label>
                                                            <label id="gistError_0" class="text-danger gist-error"></label>
                                                        </td>
                                                        <td class="text-center action-area">
                                                            <div class="sample-btn">
                                                                <span style="float:right;" id="btnMinus_0" onclick="DeleteQuestionRow(this, 'SkillCollection','Skill','Comment', 'CreatedBy', 'ExpectedAnswer')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                            </div>
                                                        </td>
                                                        @* @Html.Hidden("SkillCollection[0].CreatedBy") *@
                                                        <td class="HiddenUserIdElement">
                                                        </td>
                                                    </tr>

                                            </tbody>
                                        </table>
                                    </div>
                                </div><!--end of col-md-12-->

                            </div>
                            <div class="row"><div class="col-md-12 text-right" style="padding-right:30%"> <span id="error_0"></span></div></div>
                            <div class="card-footer mt-10">
                                <div class="row">
                                    <div class="col-md-12 mc-button-area">
                                        <div class="pull-left">
                                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add a Question" onclick="AddQuestionRow()" data-original-title="Tooltip on top"><font style="font-family:arial;"> Add Question</font></span>
                                            </button>
                                        </div>
                                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit" onclick="return errorMessage();">Submit</button>
                                    </div>
                                </div>
                            </div>
                            @Html.HiddenFor(m => m.IRFId)
                            @Html.HiddenFor(m => m.CreatedBy)
</form>
    </div>
</div>

<script>
    $(document).ready(function () {
        if ('@Model.SkillCollection.Count()' == '0') {
            var x = document.createElement("INPUT");
            x.setAttribute("type", "hidden");
            x.setAttribute("id", 'SkillCollection_0__CreatedBy');
            document.getElementsByClassName("HiddenUserIdElement")[0].appendChild(x);
            $("#SkillCollection_0__CreatedBy").val('@Model.CreatedBy');
            $("#SkillCollection_0__CreatedBy").prop('name', 'SkillCollection[0].CreatedBy');;
            if (document.getElementById('btnMinus_0').style.display == 'none') {
                document.getElementById('btnMinus_0').style.display = "block";
            }
        }
    });

    function AddQuestionRow() {
        var $ttc = $("#QuestionsNewTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        //var $tr = $ttc.clone();
        //var trIndexReplaced = $("#QuestionsNewTable tr").length - 1;
        $tr.find("textarea,select,hidden,input[type=checkbox],input[type=number]").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })
        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("textarea[type=text]").val("");
        $tr.find("input[type=checkbox]").prop("checked", false);
        $tr.find("input[type=number]").val("").prop("disabled", true);
        $tr.find(".coding-gist-wrap").hide();
        //$tr.find("textarea[type=text]").removeProp("readonly");
        $tr.find("input[type=hidden]").val('@Model.CreatedBy');
        var rowCount = $('#QuestionsNewTable tr').length;
        var finalIndex = rowCount-1;
        $tr.find("input[type=hidden]").prop('id', 'SkillCollection_' + finalIndex + '__CreatedBy');
        $tr.find("input[type=hidden]").prop('name', 'SkillCollection[' + finalIndex + '].CreatedBy');
        $tr.find('span:last').prop('style', 'display:block');
        $tr.find('span:last').prop('id', 'btnMinus_' + finalIndex);
        
        
        $tr.prop('style', 'visibility : visible');
        
        // add cloned row as last row
        $("#QuestionsNewTable").find("tbody tr:last").after($tr);
        var $ttlast = $("#QuestionsNewTable").find("tbody tr:last");
        $ttlast.find("textarea").val("");
        $ttlast.find("textarea").removeAttr("readonly");
        
        // $ttlast.find("textarea").blur(function () {
        //     checkQuestionLength('SkillCollection_' + finalIndex + '__Comment');
        // });
        $ttlast.find("textarea#SkillCollection_" + finalIndex + "__Comment").blur(function () {
            checkQuestionLength('SkillCollection_' + finalIndex + '__Comment');
        });
        // var errorLabelIdValue = "questionError_" + finalIndex;
        // $ttlast.find("label").attr("id", errorLabelIdValue);

        var errorLabelIdValue1 = "questionError_" + finalIndex;
        var errorLabelIdValue2 = "expectedAnswerError_" + finalIndex;

        $ttlast.find("label").eq(0).attr("id", errorLabelIdValue1);
        $ttlast.find("label").eq(1).attr("id", errorLabelIdValue2);
        $ttlast.find("label.coding-error").attr("id", "codingError_" + finalIndex);
        $ttlast.find("label.gist-error").attr("id", "gistError_" + finalIndex);
        
        //$ttlast.find("label").removeAttr("name");
        // Find the affected form
        var $form = $tr.closest("FORM");
        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        var options = @Html.Raw(Json.Serialize(ViewBag.Skills));
        $("#SkillCollection_" + finalIndex + "__SkillName" + " option").remove();
       
        $(options).each(function () {
            var option = $("<option />");
            //Set Text part.
            option.html(this.text);
            //Set Value part.
            option.val(this.value);
            //Add the Option element to DropDownList.
            $("#SkillCollection_" + finalIndex + "__SkillName").append(option);
        });
    }


    function DeleteQuestionRow(element, collectionName, tdOne, tdTwo, tdThree, tdFour) {
        if ($(element).parents('tbody').find('tr').length === 1) {
            alert('Must have atleast one Row');
            return false;
        }
        else {
            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    //name="ClientCollection[3].ClientUserId"
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    var elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                    var elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;

                    var elem4 = document.getElementById(collectionName + "_" + i + "__" + tdFour);
                    elem4.id = collectionName + "_" + (i - 1) + "__" + tdFour;
                    elem4.name = collectionName + "[" + (i - 1) + "]." + tdFour;

                    ["IsCodingQuestion", "CodingTimeLimitInMinutes", "QuestionGist"].forEach(function (suffix) {
                        var codingElem = document.getElementById(collectionName + "_" + i + "__" + suffix);
                        if (codingElem) {
                            codingElem.id = collectionName + "_" + (i - 1) + "__" + suffix;
                            codingElem.name = collectionName + "[" + (i - 1) + "]." + suffix;
                        }
                    });
                }
            }
        }
    }
</script>

<script>
    // The time limit and the gist only apply to coding questions, so they stay hidden
    // and the time limit stays disabled (and unposted) otherwise
    function toggleCodingTimeLimit(checkbox) {
        var $row = $(checkbox).closest('tr');
        var timeLimitInput = $row.find('input[type=number]');
        var $gistWrap = $row.find('.coding-gist-wrap');
        if (checkbox.checked) {
            timeLimitInput.prop('disabled', false);
            if (!timeLimitInput.val()) {
                timeLimitInput.val(15);
            }
            $gistWrap.show();
        }
        else {
            timeLimitInput.prop('disabled', true).val('');
            $gistWrap.hide();
            $row.find('label.coding-error').html('');
            $row.find('label.gist-error').html('');
        }
    }

    function errorMessage() {
        var items = $('[id^=SkillCollection][id$="Comment"]');
        for (j = 0; j < items.length; j++) {
            if ($('#SkillCollection_' + j + '__Comment').val() == '') {
                var error = document.getElementById("error_0");
                error.textContent = "Question field should not be blank";
                error.style.color = "red";
                return false;
            }

            var codingCheckbox = document.getElementById('SkillCollection_' + j + '__IsCodingQuestion');
            var codingErrorLabel = document.getElementById('codingError_' + j);
            var gistErrorLabel = document.getElementById('gistError_' + j);
            if (codingErrorLabel) {
                codingErrorLabel.innerHTML = "";
            }
            if (gistErrorLabel) {
                gistErrorLabel.innerHTML = "";
            }
            if (codingCheckbox && codingCheckbox.checked) {
                var timeLimit = parseInt($('#SkillCollection_' + j + '__CodingTimeLimitInMinutes').val(), 10);
                if (isNaN(timeLimit) || timeLimit < 1 || timeLimit > 180) {
                    if (codingErrorLabel) {
                        codingErrorLabel.innerHTML = "Enter a time limit between 1 and 180 minutes.";
                    }
                    return false;
                }

                var gist = $('#SkillCollection_' + j + '__QuestionGist').val();
                if (!gist || gist.trim() === '') {
                    if (gistErrorLabel) {
                        gistErrorLabel.innerHTML = "A coding question needs a gist. The AI avatar reads it out instead of the code.";
                    }
                    return false;
                }
            }
        }
        document.getElementById("questionform").submit();
        return true;
    }

    var MAX_QUESTION_LENGTH = 5000;

    function checkQuestionLength(elementId) {
        var index = elementId.match(/\d+/);
        var isExpectedAnswer = /ExpectedAnswer$/.test(elementId);
        var isGist = /QuestionGist$/.test(elementId);
        var element = document.getElementById(elementId);
        if (!element) return;

        var val = element.value;
        var errorPrefix = isGist ? "gistError_" : (isExpectedAnswer ? "expectedAnswerError_" : "questionError_");
        var errorElement = document.getElementById(errorPrefix + index);
        var fieldLabel = isGist ? "Question Gist" : (isExpectedAnswer ? "Expected Answer" : "Question");

        if (errorElement) {
            errorElement.innerHTML = (val != null && val.length > MAX_QUESTION_LENGTH)
                ? "The " + fieldLabel + " should not exceed " + MAX_QUESTION_LENGTH + " characters."
                : "";
        }

        // Re-check every row so one valid field can't re-enable submit while another is still too long
        var stillTooLong = false;
        $('#QuestionsNewTable').find('textarea').each(function () {
            if (this.value && this.value.length > MAX_QUESTION_LENGTH) {
                stillTooLong = true;
            }
        });
        document.getElementById("btnUpload").disabled = stillTooLong;

        if (val != null && val.length > MAX_QUESTION_LENGTH) {
            element.focus();
        }
    }
</script>

<script>
    var _aiSuggestedQuestions = [];

    function escapeAIHtml(str) {
        if (str == null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function setAISuggestStatus(text, kind) {
        var $el = $('#aiSuggestStatus');
        $el.removeClass('is-error is-ok');
        if (kind) $el.addClass(kind === 'error' ? 'is-error' : 'is-ok');
        $el.text(text || '');
    }

    function setAIBusy(isBusy) {
        $('#aiSuggestBtn').prop('disabled', !!isBusy);
        var hasSuggestions = _aiSuggestedQuestions && _aiSuggestedQuestions.length > 0;
        $('#aiIdealBtn, #aiSaveBtn').prop('disabled', !!isBusy || !hasSuggestions);
    }

    function renderAISuggestions() {
        var $body = $('#aiSuggestionsBody');
        $body.empty();
        if (!_aiSuggestedQuestions.length) {
            $('#aiSuggestionsWrap').hide();
            setAIBusy(false);
            return;
        }

        $('#aiSuggestionsWrap').show();
        $('#aiSelectAll').prop('checked', true);

        for (var i = 0; i < _aiSuggestedQuestions.length; i++) {
            var q = _aiSuggestedQuestions[i] || {};
            var ideal = q.idealAnswer;
            var idealHtml = ideal
                ? '<div class="aiqs-ideal">' + escapeAIHtml(ideal) + '</div>'
                : '<span class="aiqs-ideal-placeholder">Press "Generate Ideal Answers"</span>';
            var row = '<tr>' +
                '<td><input type="checkbox" class="aiqs-row-cb" data-index="' + i + '" checked="checked" /></td>' +
                '<td class="aiqs-skill-cell"><span class="aiqs-skill">' + escapeAIHtml(q.skillName || '') + '</span></td>' +
                '<td>' + escapeAIHtml(q.question || '') + '</td>' +
                '<td>' + idealHtml + '</td>' +
                '</tr>';
            $body.append(row);
        }
        setAIBusy(false);
    }

    function toggleAISelectAll(source) {
        $('#aiSuggestionsBody .aiqs-row-cb').prop('checked', source.checked);
    }

    function getSelectedAIQuestions() {
        var selected = [];
        $('#aiSuggestionsBody .aiqs-row-cb:checked').each(function () {
            var idx = parseInt($(this).attr('data-index'), 10);
            if (!isNaN(idx) && _aiSuggestedQuestions[idx]) {
                selected.push(_aiSuggestedQuestions[idx]);
            }
        });
        return selected;
    }

    function suggestAIQuestions() {
        var irfId = $('#IRFId').val();
        setAIBusy(true);
        setAISuggestStatus('Reading JD context…');
        $.ajax({
            type: 'POST',
            url: '/IRF/GetAIQuestionSuggestions',
            data: { irfid: irfId, topCount: 10 }
        }).done(function (res) {
            if (res && res.success && res.questions && res.questions.length) {
                _aiSuggestedQuestions = res.questions;
                renderAISuggestions();
                setAISuggestStatus(res.questions.length + ' question(s) suggested from your database.', 'ok');
            } else {
                _aiSuggestedQuestions = [];
                renderAISuggestions();
                setAISuggestStatus((res && res.message) ? res.message : 'No questions found in the question database.', 'error');
            }
        }).fail(function () {
            setAISuggestStatus('Unable to generate AI suggestions. Please try again.', 'error');
        }).always(function () {
            setAIBusy(false);
        });
    }

    function generateAIIdealAnswers() {
        if (!_aiSuggestedQuestions.length) return;
        var irfId = parseInt($('#IRFId').val(), 10);
        setAIBusy(true);
        setAISuggestStatus('Generating ideal answers…');
        $.ajax({
            type: 'POST',
            url: '/IRF/GenerateAIIdealAnswers',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({
                irfId: irfId,
                questions: _aiSuggestedQuestions.map(function (q) {
                    return { question: q.question, skillName: q.skillName };
                })
            })
        }).done(function (res) {
            if (res && res.success && res.answers && res.answers.length) {
                for (var i = 0; i < _aiSuggestedQuestions.length; i++) {
                    var original = _aiSuggestedQuestions[i];
                    var match = null;
                    for (var j = 0; j < res.answers.length; j++) {
                        if (res.answers[j] && res.answers[j].question === original.question) {
                            match = res.answers[j];
                            break;
                        }
                    }
                    if (!match && res.answers[i]) match = res.answers[i];
                    original.idealAnswer = match ? match.idealAnswer : original.idealAnswer;
                }
                renderAISuggestions();
                setAISuggestStatus('Ideal answers generated.', 'ok');
            } else {
                setAISuggestStatus((res && res.message) ? res.message : 'Unable to generate ideal answers.', 'error');
            }
        }).fail(function () {
            setAISuggestStatus('Unable to generate ideal answers. Please try again.', 'error');
        }).always(function () {
            setAIBusy(false);
        });
    }

    function saveAIQuestions() {
        var selected = getSelectedAIQuestions();
        if (!selected.length) {
            setAISuggestStatus('Select at least one question to save.', 'error');
            return;
        }
        var irfId = parseInt($('#IRFId').val(), 10);
        setAIBusy(true);
        setAISuggestStatus('Saving selected questions…');
        $.ajax({
            type: 'POST',
            url: '/IRF/SaveAIQuestions',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({
                irfId: irfId,
                questions: selected
            })
        }).done(function (res) {
            if (res && res.success) {
                setAISuggestStatus(res.message || 'AI question(s) saved successfully!', 'ok');
                window.location.reload();
            } else {
                setAISuggestStatus((res && res.message) ? res.message : 'AI question(s) could not be saved.', 'error');
                setAIBusy(false);
            }
        }).fail(function () {
            setAISuggestStatus('AI question(s) could not be saved.', 'error');
            setAIBusy(false);
        });
    }

    $(document).on('change', '#aiSuggestionsBody .aiqs-row-cb', function () {
        var all = $('#aiSuggestionsBody .aiqs-row-cb').length;
        var checked = $('#aiSuggestionsBody .aiqs-row-cb:checked').length;
        $('#aiSelectAll').prop('checked', all > 0 && all === checked);
    });
</script>
