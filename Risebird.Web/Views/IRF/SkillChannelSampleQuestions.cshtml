    }
    .aiqs-crumb {
        font-size: 13px;
        color: #64748b;
    }
    .aiqs-crumb strong { color: #0f172a; font-weight: 600; }
    .aiqs-grid {
        display: grid;
        grid-template-columns: minmax(280px, 34%) 1fr;
