@model Risebird.Entities.ViewModel.TechSkillComments
@using System.Collections.Generic
@using System.Linq
@using Microsoft.AspNetCore.Mvc.Rendering
@using Risebird.Entities.ViewModel
@inject IJsonHelper Json;
@{
    var jdTitle = Convert.ToString(ViewData["JdTitle"]);
    if (string.IsNullOrWhiteSpace(jdTitle))
    {
        jdTitle = Convert.ToString(ViewBag.JdTitle);
    }
    if (string.IsNullOrWhiteSpace(jdTitle))
    {
        jdTitle = "Skill Channel";
    }

    var channelName = Convert.ToString(ViewData["ChannelName"]);
    if (string.IsNullOrWhiteSpace(channelName))
    {
        channelName = Convert.ToString(ViewBag.ChannelName);
    }
    if (string.IsNullOrWhiteSpace(channelName))
    {
        channelName = "SC-" + Model.IRFId;
    }

    var clientMeta = Convert.ToString(ViewData["ClientMeta"]);
    if (clientMeta == null)
    {
        clientMeta = Convert.ToString(ViewBag.ClientMeta);
    }

    var rubricSkills = (ViewData["RubricSkills"] as IList<TransSkill>)
        ?? (ViewData["RubricSkills"] as List<TransSkill>)
        ?? new List<TransSkill>();
    if (rubricSkills.Count == 0)
    {
        object skillsObj = ViewBag.Skills;
        var skillSelect = skillsObj as SelectList;
        if (skillSelect != null)
        {
            rubricSkills = skillSelect
                .Where(i => i != null && !string.IsNullOrWhiteSpace(i.Text))
                .Select(i => new TransSkill { SkillName = i.Text.Trim(), Weightage = 0 })
                .ToList();
        }
    }

    var existingQuestions = (ViewData["ExistingQuestions"] as IList<SkillComment>)
        ?? (ViewData["ExistingQuestions"] as List<SkillComment>)
        ?? new List<SkillComment>();

    var bankCount = 0;
    if (ViewData["BankCount"] != null)
    {
        int.TryParse(Convert.ToString(ViewData["BankCount"]), out bankCount);
    }
}

<style>
    #PopupDetailsModal.aiqs-popup-open .modal-dialog.modal-lg {
        max-width: 1240px !important;
        width: 96vw !important;
        margin: 16px auto;
    }
