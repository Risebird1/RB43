        border-radius: 16px;
        overflow: visible;
        background: #F8FAFC;
        position: relative;
    }
    #PopupDetailsModal.aiqs-popup-open .filheader {
        display: none;
    }
    #PopupDetailsModal.aiqs-popup-open .close {
        position: absolute;
        right: 42px;
        top: 14px;
        z-index: 20;
        opacity: 1;
        width: 32px;
        height: 32px;
        padding: 0;
        margin: 0;
        font-size: 28px;
        line-height: 30px;
