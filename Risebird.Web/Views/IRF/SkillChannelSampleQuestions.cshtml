@model Risebird.Entities.ViewModel.TechSkillComments
@inject IJsonHelper Json;
@{
    ViewData["Title"] = "AI Suggested Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    $('#txtpageHeader').empty().html('AI Suggested Questions');
</script>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<style>
    .aiqs-panel {
        margin: 8px 16px 24px;
        padding: 16px 18px 18px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        font-family: inherit;
        color: #0f172a;
    }
    .aiqs-title {
        margin: 0 0 4px;
        font-size: 16px;
        font-weight: 600;
    }
    .aiqs-copy {
        margin: 0 0 12px;
        font-size: 13px;
        color: #475569;
    }
    .aiqs-pill {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #ede9fe;
        color: #42a5f5;
        font-size: 11px;
        font-weight: 600;
        vertical-align: middle;
    }
    .aiqs-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }
    .aiqs-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 0;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }
    .aiqs-btn:disabled {
        opacity: .45;
        cursor: not-allowed;
    }
    .aiqs-btn--blue { background: #42a5f5; color: #fff; }
    .aiqs-btn--gray { background: #e2e8f0; color: #0f172a; }
    .aiqs-btn--teal { background: #0f766e; color: #fff; }
    .aiqs-status {
        min-height: 18px;
        margin: 4px 0 10px;
        font-size: 13px;
        color: #475569;
    }
    .aiqs-status.is-error { color: #b91c1c; }
    .aiqs-status.is-ok { color: #047857; }
    .aiqs-table-wrap { overflow-x: auto; }
    .aiqs-table {
        width: 100%;
        min-width: 860px;
        table-layout: fixed;
        border-collapse: collapse;
        background: #fff;
        font-size: 13px;
    }
    .aiqs-table th, .aiqs-table td {
        border: 1px solid #e2e8f0;
        padding: 8px 10px;
        vertical-align: top;
        text-align: left;
        word-break: normal;
        overflow-wrap: break-word;
        white-space: normal;
    }
    .aiqs-table th { background: #f1f5f9; }
    .aiqs-table .aiqs-check-cell { width: 40px; }
    .aiqs-table .aiqs-skill-cell {
        width: 160px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .aiqs-table .aiqs-question-cell {
        width: auto;
        line-height: 1.45;
        word-break: normal;
        overflow-wrap: break-word;
        white-space: normal;
    }
    .aiqs-table .aiqs-ideal-cell { width: 32%; }
    .aiqs-skill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 6px;
        background: #eef2ff;
        color: #3730a3;
        font-size: 12px;
        font-weight: 600;
    }
    .aiqs-ideal { white-space: pre-wrap; }
    .aiqs-ideal-placeholder { color: #94a3b8; font-style: italic; }
</style>

<div class="main-panel" id="main-panel">
    <div class="panel-header panel-header-sm"></div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        @Html.HiddenFor(m => m.IRFId)
                        @Html.HiddenFor(m => m.CreatedBy)

                        <div class="aiqs-panel aiqs-panel--ai" id="aiSuggestedQuestionsSection">
                            <h4 class="aiqs-title">
                                AI Suggested Questions (Based on JD)
                                <span class="aiqs-pill">from your question database</span>
                            </h4>
                            <p class="aiqs-copy">AI picks the top 10 questions already in the database for this channel's JD and rubric. It does not invent questions. Generate an ideal answer on demand, then save selected rows to this skill channel.</p>
                            <div class="aiqs-actions">
                                <button type="button" class="aiqs-btn aiqs-btn--blue" id="aiSuggestBtn" onclick="suggestAIQuestions()">
                                    <i class="fa fa-magic"></i> Suggest Top 10 with AI
                                </button>
                                <button type="button" class="aiqs-btn aiqs-btn--gray" id="aiIdealBtn" disabled="disabled" onclick="generateAIIdealAnswers()">
                                    Generate Ideal Answers
                                </button>
                                <button type="button" class="aiqs-btn aiqs-btn--teal" id="aiSaveBtn" disabled="disabled" onclick="saveAIQuestions()">
                                    Save Selected
                                </button>
                            </div>
                            <div class="aiqs-status" id="aiSuggestStatus"></div>
                            <div class="aiqs-table-wrap" id="aiSuggestionsWrap" style="display:none;">
                                <table class="aiqs-table">
                                    <thead>
                                        <tr>
                                            <th class="aiqs-check-cell"><input type="checkbox" id="aiSelectAll" checked="checked" onclick="toggleAISelectAll(this)" /></th>
                                            <th class="aiqs-skill-cell">Skill</th>
                                            <th class="aiqs-question-cell">Question</th>
                                            <th class="aiqs-ideal-cell">Ideal Answer</th>
                                        </tr>
                                    </thead>
                                    <tbody id="aiSuggestionsBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var _aiSuggestedQuestions = [];

    function getPageIrfId() {
        var fromHidden = parseInt($('#IRFId').val(), 10);
        if (fromHidden) return fromHidden;
        var pathMatch = (window.location.pathname || '').match(/SkillChannelSampleQuestions\/(\d+)/i);
        if (pathMatch) return parseInt(pathMatch[1], 10);
        var queryId = new URLSearchParams(window.location.search).get('id');
        return parseInt(queryId, 10) || 0;
    }

    function questionText(q) {
        return String((q && (q.question || q.Question)) || '').replace(/\s+/g, ' ').trim();
    }

    function escapeAIHtml(str) {
        if (str == null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function setAISuggestStatus(text, kind) {
        var $el = $('#aiSuggestStatus');
        $el.removeClass('is-error is-ok');
        if (kind) $el.addClass(kind === 'error' ? 'is-error' : 'is-ok');
        $el.text(text || '');
    }

    function setAIBusy(isBusy) {
        $('#aiSuggestBtn').prop('disabled', !!isBusy);
        var hasSuggestions = _aiSuggestedQuestions && _aiSuggestedQuestions.length > 0;
        $('#aiIdealBtn, #aiSaveBtn').prop('disabled', !!isBusy || !hasSuggestions);
    }

    function renderAISuggestions() {
        var $body = $('#aiSuggestionsBody');
        $body.empty();
        if (!_aiSuggestedQuestions.length) {
            $('#aiSuggestionsWrap').hide();
            setAIBusy(false);
            return;
        }

        $('#aiSuggestionsWrap').show();
        $('#aiSelectAll').prop('checked', true);

        for (var i = 0; i < _aiSuggestedQuestions.length; i++) {
            var q = _aiSuggestedQuestions[i] || {};
            var ideal = q.idealAnswer || q.IdealAnswer;
            var idealHtml = ideal
                ? '<div class="aiqs-ideal">' + escapeAIHtml(ideal) + '</div>'
                : '<span class="aiqs-ideal-placeholder">Press "Generate Ideal Answers"</span>';
            var row = '<tr>' +
                '<td class="aiqs-check-cell"><input type="checkbox" class="aiqs-row-cb" data-index="' + i + '" checked="checked" /></td>' +
                '<td class="aiqs-skill-cell"><span class="aiqs-skill">' + escapeAIHtml(q.skillName || q.SkillName || '') + '</span></td>' +
                '<td class="aiqs-question-cell">' + escapeAIHtml(questionText(q)) + '</td>' +
                '<td class="aiqs-ideal-cell">' + idealHtml + '</td>' +
                '</tr>';
            $body.append(row);
        }
        setAIBusy(false);
    }

    function toggleAISelectAll(source) {
        $('#aiSuggestionsBody .aiqs-row-cb').prop('checked', source.checked);
    }

    function getSelectedAIQuestions() {
        var selected = [];
        $('#aiSuggestionsBody .aiqs-row-cb:checked').each(function () {
            var idx = parseInt($(this).attr('data-index'), 10);
            if (!isNaN(idx) && _aiSuggestedQuestions[idx]) {
                selected.push(_aiSuggestedQuestions[idx]);
            }
        });
        return selected;
    }

    function suggestAIQuestions() {
        var irfId = getPageIrfId();
        setAIBusy(true);
        setAISuggestStatus('Reading JD context.');
        $.ajax({
            type: 'POST',
            url: '/IRF/GetAIQuestionSuggestions',
            data: { irfid: irfId, topCount: 10 }
        }).done(function (res) {
            if (res && res.success && res.questions && res.questions.length) {
                _aiSuggestedQuestions = res.questions;
                renderAISuggestions();
                setAISuggestStatus(res.questions.length + ' question(s) suggested from your database.', 'ok');
            } else {
                _aiSuggestedQuestions = [];
                renderAISuggestions();
                setAISuggestStatus((res && res.message) ? res.message : 'No questions found in the question database.', 'error');
            }
        }).fail(function () {
            setAISuggestStatus('Unable to generate AI suggestions. Please try again.', 'error');
        }).always(function () {
            setAIBusy(false);
        });
    }

    function generateAIIdealAnswers() {
        if (!_aiSuggestedQuestions.length) return;
        var irfId = getPageIrfId();
        setAIBusy(true);
        setAISuggestStatus('Generating ideal answers.');
        $.ajax({
            type: 'POST',
            url: '/IRF/GenerateAIIdealAnswers',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({
                irfId: irfId,
                questions: _aiSuggestedQuestions.map(function (q) {
                    return {
                        question: questionText(q),
                        skillName: q.skillName || q.SkillName || ''
                    };
                })
            })
        }).done(function (res) {
            if (res && res.success && res.answers && res.answers.length) {
                for (var i = 0; i < _aiSuggestedQuestions.length; i++) {
                    var original = _aiSuggestedQuestions[i];
                    var match = null;
                    for (var j = 0; j < res.answers.length; j++) {
                    if (res.answers[j] && questionText(res.answers[j]) === questionText(original)) {
                            match = res.answers[j];
                            break;
                        }
                    }
                    if (!match && res.answers[i]) match = res.answers[i];
                    original.idealAnswer = match ? (match.idealAnswer || match.IdealAnswer) : original.idealAnswer;
                }
                renderAISuggestions();
                setAISuggestStatus('Ideal answers generated.', 'ok');
            } else {
                setAISuggestStatus((res && res.message) ? res.message : 'Unable to generate ideal answers.', 'error');
            }
        }).fail(function () {
            setAISuggestStatus('Unable to generate ideal answers. Please try again.', 'error');
        }).always(function () {
            setAIBusy(false);
        });
    }

    function saveAIQuestions() {
        var selected = getSelectedAIQuestions();
        if (!selected.length) {
            setAISuggestStatus('Select at least one question to save.', 'error');
            return;
        }
        var irfId = getPageIrfId();
        if (!irfId) {
            setAISuggestStatus('Could not determine this skill channel id.', 'error');
            return;
        }
        setAIBusy(true);
        setAISuggestStatus('Saving selected questions.');
        $.ajax({
            type: 'POST',
            url: '/IRF/SaveAIQuestions',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify({
                irfId: irfId,
                questions: selected.map(function (q) {
                    return {
                        question: questionText(q),
                        skillName: q.skillName || q.SkillName || '',
                        idealAnswer: q.idealAnswer || q.IdealAnswer || null
                    };
                })
            })
        }).done(function (res) {
            if (res && res.success) {
                var dhiUrl = '/IRF/DeliveryHeadInstruction?irfid=' + encodeURIComponent(irfId) + '#sample-questions';
                setAISuggestStatus((res.message || 'Saved.') + ' Opening the HM Sample Questions list…', 'ok');
                window.location.href = dhiUrl;
            } else {
                setAISuggestStatus((res && res.message) ? res.message : 'AI question(s) could not be saved.', 'error');
            }
        }).fail(function () {
            setAISuggestStatus('AI question(s) could not be saved.', 'error');
        }).always(function () {
            setAIBusy(false);
        });
    }

    $(document).on('change', '#aiSuggestionsBody .aiqs-row-cb', function () {
        var all = $('#aiSuggestionsBody .aiqs-row-cb').length;
        var checked = $('#aiSuggestionsBody .aiqs-row-cb:checked').length;
        $('#aiSelectAll').prop('checked', all > 0 && all === checked);
    });
</script>
