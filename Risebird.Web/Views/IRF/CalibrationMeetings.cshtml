@model IEnumerable<Risebird.Entities.ViewModel.CallibrationCallVM>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Calibration Meetings";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}
<script>
    var Header = "<div id='myinterview_1'>Calibration Meetings</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 7.9rem;
        right: -.3rem;
    }

    .sidebar-mini .sidebar:hover {
        width: 80px !important;
    }

    .navbar {
        position: fixed;
    }

    .tox-notifications-container {
        display: none
    }
</style>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<div id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="row card-header bg-w clearfix">
                <div class="col-md-8 pull-left">
                    <div class="pull-left myinterview">
                        <div class="mobile-view"> <h4 class="card-title"> Calibration Meetings</h4></div>
                    </div>
                </div>
                <div class="col-md-4 pull-left">
                    <div class="pull-right">
                        <input type="hidden" value="@ViewBag.emailid" id="hiddemailid" />
                        <input type="hidden" value="@ViewBag.id" id="hidduniqueid" />
                    </div>
                </div>
                <div class="pull-right">
                    @Html.ActionLink("Back", "FetchInterviewerCommunicator", "Candidate", new { emailid = ViewBag.emailid, uniqueid = ViewBag.id }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                </div>
            </div>
        </div>
    </div>
    <div class="content client ">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div>
                                <div id="tableID" class="second">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="pull-right client-ms" style="margin:0px 10px 10px 10px;">
                                            <div id="meeting_filter" class="dataTables_filter">
                                                <div class="searchbox">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="CalibrationMeetings" class="table table-striped table-bordered dataTable" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th style="border-right: 0px !important;">Skill Channel</th>
                                                            <th style="border-left: 0px !important;">Meeting Date</th>
                                                            <th style="text-align:left">Meeting Link</th>
                                                            <th style="text-align:left">JD Title</th>
                                                            <th class="text-left">Created on</th>
                                                            <th class="text-center">Created By</th>
                                                            <th class="text-center">Video</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;">Skill Channel</th>
                                                            <th style="border-left: 0px !important;">Meeting Date</th>
                                                            <th style="text-align:left">Meeting Link</th>
                                                            <th style="text-align:left">JD Title</th>
                                                            <th class="text-left">Created on</th>
                                                            <th class="text-center">Created By</th>
                                                            <th class="text-center">Video</th>
                                                        </tr>

                                                    </tfoot>
                                                    <tbody id="tblbodyMyInterview">
                                                        @if (Model.Count() == 0)
                                                        {
                                                            <tr>
                                                                <td colspan="7" class="text-center">No data available in table</td>
                                                            </tr>
                                                        }

                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>
                                                                <td>@item.IRFName</td>
                                                                <td>@item.MeetingDate</td>
                                                                @if (!string.IsNullOrWhiteSpace(item.MeetingLink))
                                                                {
                                                                    <td><a target="_blank" href="@item.MeetingLink">Meeting Link</a></td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                <td>@item.JDTiltle</td>
                                                                <td>@item.CreatedOn</td>
                                                                <td>@item.CreatedBy</td>
                                                                @if (!string.IsNullOrWhiteSpace(item.VideoLink))
                                                                {
                                                                    <td><a target="_blank" href="@item.VideoLink">Video</a></td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->
        </div>
    </div>
</div>
<script>
    var irfId = 0;
    var irfName = '';
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#CalibrationMeetings").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#CalibrationMeetings").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#CalibrationMeetings").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function searchResult() {
        $('#CalibrationMeetings').DataTable();
    }
    function RefreshSearch() {
        $('#CalibrationMeetings').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#CalibrationMeetings').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span style='right:20px;top:9px;' id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>



