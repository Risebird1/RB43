@model IEnumerable<Risebird.Entities.ViewModel.IRF>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Stats";
    ViewBag.PageHeader = "Stats";
    if (ViewBag.PageStatus == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}

@if (HttpContextAccessor.HttpContext.Session.GetString("SkillChannelDetailsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<SkillChannelDetailsFilter>(HttpContextAccessor.HttpContext.Session.GetString("SkillChannelDetailsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
<style>
    .DetailLink td {
        color: darkblue;
    }

    .DetailLink:hover {
        text-decoration: underline;
        cursor: pointer;
    }
</style>
<style>
    .modal-dialog {
        height: 900px !important;
    }

    .modal-content {
        /* 80% of window height */
        height: 60%;
    }

</style>

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=234567" />

<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Skill Channel Stats</h4></div>
                </div>
                <input type="hidden" value="@ViewBag.Type" id="hidtype" />
                <div class="pull-left">
                    @* Interview Tab starts*@
                    @* <div style="padding:6px 15px;" class="feedback-tab-ac" onclick="">
                    <div class="date_interview">
                    <strong>Interview Date</strong>
                    <div class="calendar-div" onclick="myDateCalendar()">
                    <div class="form-control-calendar"></div>
                    </div>

                    <div class="calendar-wrapper" id="myDiv">
                    <form autocomplete="off">
                    <div class="input-group input-daterange"> <input type="text" class="form-control input1" placeholder="Start Date" readonly> <input type="text" class="form-control input2" placeholder="End Date" readonly> </div>
                    <button onclick="ChangetabDayStats();">
                    <svg width="20" fill="#4895c9" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M0 256a256 256 0 1 0 512 0A256 256 0 1 0 0 256zM241 377c-9.4 9.4-24.6 9.4-33.9 0s-9.4-24.6 0-33.9l87-87-87-87c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0L345 239c9.4 9.4 9.4 24.6 0 33.9L241 377z" /></svg>
                    </button>
                    </form>
                    </div>
                    </div>
                    </div> *@
                    @* Interview Tab ends*@
                    <div class="feedback-tab-ac" onclick="ChangeChanneldetails('DayStats','@ViewBag.emailid','@ViewBag.uniqueid', '@ViewBag.IsClientLogin')"><strong>Day Stats</strong></div>
                    <div class="feedback-tab" onclick="ChangeChanneldetails('IRF','@ViewBag.emailid','@ViewBag.uniqueid', '@ViewBag.IsClientLogin')"><strong>Skill Channel</strong></div>
                </div>
                <div class="pull-right">
                    <div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                        @if (ViewBag.PageStatus == "Public" || ViewBag.IsCLientLogin == true)
                        {
                            <input type="hidden" value="@ViewBag.emailid" id="hiddemail" />
                            <input type="hidden" value="@ViewBag.uniqueid" id="hidduniqueid" />
                            <input type="hidden" value="@ViewBag.IsCLientLogin" id="hiddLoginStatus" />
                            @if (ViewBag.PageStatus == "Public")
                            {
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="location.href='@Url.Action("PublicCandidateStatus", "Candidate", new { emailid=ViewBag.emailid,id=ViewBag.uniqueid })'" data-original-title="Back to Dashboard"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("DateChannelDetails","IRF",new { emailid=ViewBag.emailid, uniqueid = ViewBag.uniqueid, isClientLogin = ViewBag.IsClientLogin })" method="post" id="form">
                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12">
                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12 pull-right">
                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>
                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div>
                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="irfTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Scheduled Interviews</th>
                                                    <th>Completed Interviews</th>
                                                    <th>Selected Interviews</th>
                                                    <th>Rejected Interviews</th>
                                                    <th>Report Pending</th>
                                                    <th>Rescheduled Count</th>
                                                    <th>Pending Scheduled Count</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Scheduled Interviews</th>
                                                    <th>Completed Interviews</th>
                                                    <th>Selected Interviews</th>
                                                    <th>Rejected Interviews</th>
                                                    <th>Report Pending</th>
                                                    <th>Rescheduled Count</th>
                                                    <th>Pending Scheduled Count</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.interviewDate</td>
                                                            <td> @item.CandidateCount </td>
                                                            <td>
                                                                <a href="#">
                                                                    @item.CompletedInterviews
                                                                    { @if (item.CandidateCount > 0)
                                                                    {
                                                                        @((item.CompletedInterviews * 100) / @item.CandidateCount)
                                                                    }% }
                                                                </a>
                                                            </td>
                                                            <td>
                                                                <a href="#">
                                                                    @item.SelectedMeetings
                                                                    { @if (item.CompletedInterviews > 0)
                                                                    {
                                                                        @((item.SelectedMeetings * 100) / @item.CompletedInterviews)
                                                                    }% }
                                                                </a>
                                                            </td>
                                                            <td>
                                                                @item.RejectedMeetings
                                                                { @if (item.CompletedInterviews > 0)
                                                                {
                                                                    @((item.RejectedMeetings * 100) / @item.CompletedInterviews)
                                                                }% }
                                                            </td>
                                                            <td> @item.PendingCount </td>
                                                            <td>
                                                                @item.ReScheduledCount
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.ReScheduledCount * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                            <td>
                                                                @item.FutureScheduledMeetings
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.FutureScheduledMeetings * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <!-- end content-->
                        </div>
                        <!-- end col-md-12 -->
                    </div>
                    <!-- end row -->
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }
    });
    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        var form = $("#form").serialize();
    }
</script>

<script>
    function searchResult() {
        $('#irfTable').DataTable();
    }
    function RefreshSearch() {
        $('#irfTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#irfTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });
    };
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#irfTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#irfTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#irfTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>

<script>
    function Startloader() {
        $(".loader").show();
        $(".dataloading").hide();
    }
    function Stoploader() {
        $(".loader").hide();
        $(".dataloading").show();
    }
    function ChangeChanneldetails(type, emailid, uniqueid, isclient) {
        if (type == "DayStats") {
            window.location.href = "/IRF/DateChannelDetails?emailid=" + emailid + "&isClientLogin=" + isclient + "&uniqueid=" + uniqueid;
        } else {
            window.location.href = "/IRF/PublicSkillChannelDetails?emailid=" + emailid + "&isClientLogin=" + isclient + "&uniqueid=" + uniqueid;
        }
    }
</script>
<script>
    $(document).ready(function () {
        document.getElementById("main-panel").classList.remove("main-panel");
    });
    function ResetFilter() {
        var email = $("#hiddemail").val();
        var uniqueid = $("#hidduniqueid").val();
        var loginStatus = $("#hiddLoginStatus").val();
        window.location.href = "/IRF/ResetDateChannelDetails?emailid=" + email + "&uniqueid=" + uniqueid + "&isClientLogin=" + loginStatus;
    }
</script>


