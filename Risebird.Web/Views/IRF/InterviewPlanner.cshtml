@model Risebird.Entities.ViewModel.InterviewPlanner
@{
    ViewData["Title"] = "Interview Planner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }

    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    td.wordwrap {
        display: inline-block !important;
        max-width: 250px !important;
        min-width: 250px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: top !important;
        white-space: nowrap !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }
    /*CSS FOR Loader*/
    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
            height: 100px;*/
        display: none;
        position: center !important;
        background-color: White;
        z-index: 999;
        /*opacity: 0.5;*/
        filter: alpha(opacity = 50);
    }

    table.dataTable > thead > tr > th, table.dataTable > tbody > tr > th, table.dataTable > tfoot > tr > th, table.dataTable > thead > tr > td, table.dataTable > tbody > tr > td, table.dataTable > tfoot > tr > td {
        max-width: 300px !important;
    }
</style>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Interview Request Forms</a>
                <a class="navbar-brand">Interview Planner</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">
                            Interview Planner for <b>@Model.IRFName</b>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        @using (Html.BeginForm("EditInterviewPlanner", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid"}))
                        {
                        <div class="dataloading">



                            <div>
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th><strong>Stages</strong></th>
                                                <th><strong>Desired success rate</strong></th>
                                                <th><strong>Actual success rate</strong></th>
                                                <th><strong>Processing Time</strong></th>
                                                <th><strong>Owned by</strong></th>
                                                <th><strong>Number of interviews</strong></th>
                                                <th><strong>Dates</strong></th>

                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Stages</th>
                                                <th>Desired success rate</th>
                                                <th>Actual success rate</th>
                                                <th>Processing Time</th>
                                                <th>Owned by</th>
                                                <th>Number of interviews</th>
                                                <th>Dates</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            <tr>
                                                <td>Joining rate</td>
                                                <td>50%</td>
                                                <td>@Model.JoiningPercentage%</td>

                                                <td>
                                                    @Html.EditorFor(m => m.JoiningProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.JoiningOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.JoiningTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.OverAllProcessingTime - Model.JoiningProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Offer Acceptance rate</td>
                                                <td>50%</td>
                                                <td>@Model.OfferAcceptancePercentage%</td>

                                                <td>
                                                    @Html.EditorFor(m => m.OfferProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.OfferOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.OfferAcceptanceTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime + Model.ApprovalProcessingTime + Model.FinalSelectionProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Final selection rate</td>
                                                <td>33%</td>
                                                <td>@Model.FinalSelectionPercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.FinalSelectionProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.FinalSelectionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.FinalSelectionTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime + Model.ApprovalProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Approval Rate</td>
                                                <td>80%</td>
                                                <td>@Model.ApprovalPercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.ApprovalProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.ApprovalOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.ApprovalTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Risebird Selection rate</td>
                                                <td>33%</td>
                                                <td>@Model.RisebirdSelectionPercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.RisebirdSelectionProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.RisebirdSelectionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.RisebirdSelectionTotal</td>
                                                <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime)</td>
                                            </tr>
                                            <tr>
                                                <td>Completion Rate</td>
                                                <td>80%</td>
                                                <td>@Model.CompletionPercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.CompletionProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.CompletionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.CompletionTotal</td>
                                                <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime)</td>
                                            </tr>
                                            <tr>
                                                <td>Confirmation Rate</td>
                                                <td>80%</td>
                                                <td>@Model.ConfirmationPercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.ConfirmationProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.ConfirmationOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.ConfirmationTotal</td>
                                                <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime)</td>
                                            </tr>
                                            <tr>
                                                <td>Invite Rate</td>
                                                <td>90%</td>
                                                <td>@Model.InvitePercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.InviteProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.InviteOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.TotalInvites</td>
                                                <td>@Model.IRFCreatedOn</td>
                                            </tr>
                                            <tr>
                                                <td>Overall</td>
                                                <td>1.25%</td>
                                                <td>@Model.OverallPercentage%</td>
                                                <td>
                                                    @Html.EditorFor(m => m.OverAllProcessingTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number" } })

                                                </td>
                                                <td></td>
                                                <td>@Model.Overall</td>
                                                <td></td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </div>

                            </div>
                            <div class="toolbar">

                                <div class="row">

                                    <div class="col-auto">
                                        @Html.ActionLink("Back", "Index", "IRF", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                        <button type="submit" class="btn btn-fill btn-primary" id="btnUpload" value="Submit">Save</button>


                                    </div>
                                </div>


                            </div>
                            @Html.HiddenFor(Model => Model.IRFId)
                            @Html.HiddenFor(Model => Model.IRFName)

                        </div>
                        }



                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>




<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<loading></loading>

<!-- PAGE CONTENT WRAPPER -->
