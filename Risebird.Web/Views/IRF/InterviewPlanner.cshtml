@model Risebird.Entities.ViewModel.InterviewPlanner
@{
    ViewData["Title"] = "Interview Planner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}





<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a class="navbar-brand">  / &nbsp;Interview Planner</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        @using (Html.BeginForm("EditInterviewPlanner", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid" }))
                        {
                            <div class="dataloading">

                                <div class="row">
                                    <div class="card-header">
                                        <h4 class="card-title">
                                            Interview Planner for <b>@Model.IRFName</b>
                                        </h4>
                                    </div>
                                    <div class="w-full">&nbsp;</div>
                                </div>
                                <div id="tableID">
                                    <div class="table-responsive-sm">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Stages</th>
                                                    <th>Desired success rate</th>
                                                    <th>Actual success rate</th>
                                                    <th>Processing Time</th>
                                                    <th width="40%">Owned by</th>
                                                    <th>Number of interviews</th>
                                                    <th>Dates</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Stages</th>
                                                    <th>Desired success rate</th>
                                                    <th>Actual success rate</th>
                                                    <th>Processing Time</th>
                                                    <th width="40%">Owned by</th>
                                                    <th>Number of interviews</th>
                                                    <th>Dates</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                <tr>
                                                    <td>Joining rate</td>
                                                    <td>50%</td>
                                                    <td>@Model.JoiningPercentage%</td>

                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.JoiningProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up button">&rsaquo;</button>
                                                            <button type="button" class="down button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.JoiningOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.JoiningTotal</td>
                                                    <td>
                                                        @Model.IRFCreatedOn.AddDays(Model.OverAllProcessingTime - Model.JoiningProcessingTime)
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Offer Acceptance rate</td>
                                                    <td>50%</td>
                                                    <td>@Model.OfferAcceptancePercentage%</td>

                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.OfferProcessingTime, new { htmlAttributes = new { @class = "input-1 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-1 button">&rsaquo;</button>
                                                            <button type="button" class="down-1 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.OfferOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.OfferAcceptanceTotal</td>
                                                    <td>
                                                        @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime + Model.ApprovalProcessingTime + Model.FinalSelectionProcessingTime)
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Final selection rate</td>
                                                    <td>33%</td>
                                                    <td>@Model.FinalSelectionPercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.FinalSelectionProcessingTime, new { htmlAttributes = new { @class = "input-2 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-2 button">&rsaquo;</button>
                                                            <button type="button" class="down-2 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.FinalSelectionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.FinalSelectionTotal</td>
                                                    <td>
                                                        @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime + Model.ApprovalProcessingTime)
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Approval Rate</td>
                                                    <td>80%</td>
                                                    <td>@Model.ApprovalPercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.ApprovalProcessingTime, new { htmlAttributes = new { @class = "input-3 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-3 button">&rsaquo;</button>
                                                            <button type="button" class="down-3 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
