@model Risebird.Entities.ViewModel.InterviewPlanner
@{
    ViewData["Title"] = "Interview Planner";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/IRF/Index'>Skills Channel</a>&nbsp;/&nbsp;Interview Planner";
    $('#txtpageHeader').empty().html(Header);
</script>

<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />


<div class="main-panel" id="main-panel">
   
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="desktop-view">
                        <h4 class="card-title"> Interview Planner for <strong>@Model.IRFName</strong></h4>
                    </div>
                    <div class="mobile-view"> <h4 class="card-title">Interview Planner for <strong>@Model.IRFName</strong></h4></div>
                </div>


            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        @using (Html.BeginForm("EditInterviewPlanner", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid" }))
                        {
                            <div class="dataloading">


                                <div id="tableID">
                                    <div class="table-responsive-sm">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Stages</th>
                                                    <th>Desired success rate</th>
                                                    <th>Actual success rate</th>
                                                    <th>Processing Time</th>
                                                    <th width="40%">Owned by</th>
                                                    <th>Number of interviews</th>
                                                    <th>Dates</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Stages</th>
                                                    <th>Desired success rate</th>
                                                    <th>Actual success rate</th>
                                                    <th>Processing Time</th>
                                                    <th width="40%">Owned by</th>
                                                    <th>Number of interviews</th>
                                                    <th>Dates</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                <tr>
                                                    <td>Joining rate</td>
                                                    <td class="text-center">50%</td>
                                                    <td class="text-center">@Model.JoiningPercentage%</td>

                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.JoiningProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up button">&rsaquo;</button>
                                                            <button type="button" class="down button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.JoiningOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td class="text-center">@Model.JoiningTotal</td>
                                                    <td>
                                                        @Model.IRFCreatedOn.AddDays(Model.OverAllProcessingTime - Model.JoiningProcessingTime)
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Offer Acceptance rate</td>
                                                    <td class="text-center">50%</td>
                                                    <td class="text-center">@Model.OfferAcceptancePercentage%</td>

                                                    <td class="spinner-wrap joiningtime">
