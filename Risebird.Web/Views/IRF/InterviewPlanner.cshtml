        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                /   &nbsp;<a class="navbar-brand">Interview Planner</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        @using (Html.BeginForm("EditInterviewPlanner", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid" }))
                        {
                            <div class="dataloading">

                                <div class="row">
                                    <div class="card-header">
                                        <h4 class="card-title">
                                            Interview Planner for <b>@Model.IRFName</b>
                                        </h4>
                                    </div>
                                    <div class="w-full">&nbsp;</div>
                                </div>
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Stages</th>
                                                <th>Desired success rate</th>
                                                <th>Actual success rate</th>
                                                <th>Processing Time</th>
                                                <th width="40%">Owned by</th>
                                                <th>Number of interviews</th>
                                                <th>Dates</th>

                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Stages</th>
                                                <th>Desired success rate</th>
                                                <th>Actual success rate</th>
                                                <th>Processing Time</th>
                                                <th width="40%">Owned by</th>
                                                <th>Number of interviews</th>
                                                <th>Dates</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            <tr>
                                                <td>Joining rate</td>
                                                <td>50%</td>
                                                <td>@Model.JoiningPercentage%</td>

                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.JoiningProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.JoiningOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                                   
                                                </td>
                                                <td>@Model.JoiningTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.OverAllProcessingTime - Model.JoiningProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Offer Acceptance rate</td>
                                                <td>50%</td>
                                                <td>@Model.OfferAcceptancePercentage%</td>

                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.OfferProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.OfferOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                               
                                                </td>
                                                <td>@Model.OfferAcceptanceTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime + Model.ApprovalProcessingTime + Model.FinalSelectionProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Final selection rate</td>
                                                <td>33%</td>
                                                <td>@Model.FinalSelectionPercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.FinalSelectionProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.FinalSelectionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.FinalSelectionTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime + Model.ApprovalProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Approval Rate</td>
                                                <td>80%</td>
                                                <td>@Model.ApprovalPercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.ApprovalProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.ApprovalOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.ApprovalTotal</td>
                                                <td>
                                                    @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime)
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Risebird Selection rate</td>
                                                <td>33%</td>
                                                <td>@Model.RisebirdSelectionPercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.RisebirdSelectionProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.RisebirdSelectionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.RisebirdSelectionTotal</td>
                                                <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime)</td>
                                            </tr>
                                            <tr>
                                                <td>Completion Rate</td>
                                                <td>80%</td>
                                                <td>@Model.CompletionPercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.CompletionProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.CompletionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.CompletionTotal</td>
                                                <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime)</td>
                                            </tr>
                                            <tr>
                                                <td>Confirmation Rate</td>
                                                <td>80%</td>
                                                <td>@Model.ConfirmationPercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.ConfirmationProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.ConfirmationOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.ConfirmationTotal</td>
                                                <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime)</td>
                                            </tr>
                                            <tr>
                                                <td>Invite Rate</td>
                                                <td>90%</td>
                                                <td>@Model.InvitePercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.InviteProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td>
                                                    @Html.EditorFor(model => model.InviteOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                <td>@Model.TotalInvites</td>
                                                <td>@Model.IRFCreatedOn</td>
                                            </tr>
                                            <tr>
                                                <td>Overall</td>
                                                <td>1.25%</td>
                                                <td>@Model.OverallPercentage%</td>
                                                <td class="spinner-wrap">
                                                    @Html.EditorFor(m => m.OverAllProcessingTime, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number" } })
                                                    <div class="spinner">
                                                        <button type="button" class="up button">&rsaquo;</button>
                                                        <button type="button" class="down button">&lsaquo;</button>
                                                    </div>
                                                </td>
                                                <td></td>
                                                <td>@Model.Overall</td>
                                                <td></td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </div>


                                <div class="toolbar">
                                    <!--           <div class="card-footer ">
                                                    <div class="row">

                                                        <div class="col-md-12 mc-button-area">
                                                            @Html.ActionLink("Back", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded " id="btnUpload" value="Submit">Save</button>


                                                        </div>
                                                    </div>
                                                </div>
                                    -->

                                </div>
                                @Html.HiddenFor(Model => Model.IRFId)
                                @Html.HiddenFor(Model => Model.IRFName)



                                <div class="card-footer ">
                                    <div class="row">

                                        <div class="col-md-12 mc-button-area">
                                            @Html.ActionLink("Back", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded " id="btnUpload" value="Submit">Save</button>


                                        </div>
                                    </div>
                                </div>



                            </div>


                        }



                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>




<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>

    document.body.className += "js";

    var spinner = document.querySelector('.input');
    var buttonUp = document.querySelector('.up');
    var buttonDown = document.querySelector('.down');

    buttonUp.onclick = function () {
        var value = parseInt(spinner.value, 10);
        value = isNaN(value) ? 0 : value;
        value++;
        spinner.value = value;
    };

    buttonDown.onclick = function () {
        var value = parseInt(spinner.value, 10);
        value = isNaN(value) ? 0 : value;
        value--;
        spinner.value = value;
    };

</script>

<loading></loading>

