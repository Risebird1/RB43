                                                        <div class="spinner">
                                                            <button type="button" class="up-5 button">&rsaquo;</button>
                                                            <button type="button" class="down-5 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.CompletionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.CompletionTotal</td>
                                                    <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime)</td>
                                                </tr>
                                                <tr>
                                                    <td>Confirmation Rate</td>
                                                    <td>80%</td>
                                                    <td>@Model.ConfirmationPercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.ConfirmationProcessingTime, new { htmlAttributes = new { @class = "input-6 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-6 button">&rsaquo;</button>
                                                            <button type="button" class="down-6 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.ConfirmationOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.ConfirmationTotal</td>
                                                    <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime)</td>
                                                </tr>
                                                <tr>
                                                    <td>Invite Rate</td>
                                                    <td>90%</td>
                                                    <td>@Model.InvitePercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.InviteProcessingTime, new { htmlAttributes = new { @class = "input-7 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-7 button">&rsaquo;</button>
                                                            <button type="button" class="down-7 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.InviteOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.TotalInvites</td>
                                                    <td>@Model.IRFCreatedOn</td>
                                                </tr>
                                                <tr>
                                                    <td>Overall</td>
                                                    <td>1.25%</td>
                                                    <td>@Model.OverallPercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.OverAllProcessingTime, new { htmlAttributes = new { @class = "input-8 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-8 button">&rsaquo;</button>
                                                            <button type="button" class="down-8 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td></td>
                                                    <td>@Model.Overall</td>
                                                    <td></td>
                                                </tr>

                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                                <div class="toolbar">
                                  

                                </div>
                                @Html.HiddenFor(Model => Model.IRFId)
                                @Html.HiddenFor(Model => Model.IRFName)



                                <div class="card-footer ">
                                    <div class="row">

                                        <div class="col-md-12 mc-button-area">
                                            @Html.ActionLink("Back", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded " id="btnUpload" value="Submit">Save</button>


                                        </div>
                                    </div>
                                </div>



                            </div>


                        }



                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>




<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

