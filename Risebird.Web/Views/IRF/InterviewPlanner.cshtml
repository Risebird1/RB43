        -webkit-box-shadow: 0 3px #3884d2 !important;
        -moz-box-shadow: 0 3px #3884d2 !important;
        box-shadow: 0 3px #3884d2 !important;
        -webkit-transition: none;
        -moz-transition: none;
        transition: none;
        border-radius: 5px 5px 5px 5px;
        box-shadow: 0 3px #3884d2;
    }


