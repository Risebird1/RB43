                                                    </td>
                                                    <td>@Model.ApprovalTotal</td>
                                                    <td>
                                                        @Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime + Model.RisebirdSelectionProcessingTime)
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Risebird Selection rate</td>
                                                    <td>33%</td>
                                                    <td>@Model.RisebirdSelectionPercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
                                                        @Html.EditorFor(m => m.RisebirdSelectionProcessingTime, new { htmlAttributes = new { @class = "input-4 form-control text-box single-line", @type = "number" } })
                                                        <div class="spinner">
                                                            <button type="button" class="up-4 button">&rsaquo;</button>
                                                            <button type="button" class="down-4 button">&lsaquo;</button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @Html.EditorFor(model => model.RisebirdSelectionOwnedBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                    </td>
                                                    <td>@Model.RisebirdSelectionTotal</td>
                                                    <td>@Model.IRFCreatedOn.AddDays(Model.InviteProcessingTime + Model.ConfirmationProcessingTime + Model.CompletionProcessingTime)</td>
                                                </tr>
                                                <tr>
                                                    <td>Completion Rate</td>
                                                    <td>80%</td>
                                                    <td>@Model.CompletionPercentage%</td>
                                                    <td class="spinner-wrap joiningtime">
