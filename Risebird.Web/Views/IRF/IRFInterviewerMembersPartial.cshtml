@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewerMembers>
<div>
    @if (Model != null && Model.Count() != 0)
    {
        <div id="style-2" class="scrollers" style="overflow-y:auto">

            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Interviewer Name</th>
                        <th class="text-center">Call</th>
                       
                        <th>ResumeLink</th>
                        @if (ViewBag.Type == "IRF")
                        {
                            <th>Active</th>
                        }
                        <th>Available</th>
                        <th>Total Interviews</th>
                        
                    </tr>
                </thead>
                <tbody>


                    @foreach (var item in Model)
                    {
                    <tr>
                        @if (item.Type == "Interviewer")
                        {
                            <td style="color: #17c317">@item.Type</td>
                        }
                        else
                        {
                            <td style="color: #ff7bf5">@item.Type</td>
                        }
                        <td>@item.InterviewerName</td>
                        <td class="text-center">
                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                            {
                                <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.InterviewerName', '@item.MobileNumber', '@item.EmailId')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                            }

                        </td>

                        @if (item.ResumeLink != null && item.ResumeLink != "")
                        {
                            <td class="text-center">
                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                            </td>
                        }
                        else
                        {
                            <td class="text-center">No Resume</td>
                        }
                        @if (ViewBag.Type == "IRF")
                        {
                            @if (item.IsActive)
                            {
                                <td class="text-center">Yes</td>
                            }
                            else
                            {
                                <td class="text-center">No</td>
                            }
                        }
                        @if (ViewBag.Type == "IRF")
                        {
                            @if (item.IsAvailable)
                            {
                                <td class="text-center">Yes</td>
                            }
                            else
                            {
                                <td class="text-center">No</td>
                            }
                        }
                        else
                        {
                            @if (@item.AvailableStatus != "0")
                            {
                                <td title="@item.AvailableStatus" style="overflow:hidden">@item.AvailableStatus</td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                        <td class="text-center">@item.TotalInterviews</td>
                       
                    </tr>
                    }

                </tbody>
            </table>

        </div>
    }
    else
    {
        <div>
            No interviewers/Quality Controllers for this Skill Channel
        </div>
    }
</div>


<script src="~/Newassets/js/scrollBar.js"></script>

<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>
<style>
    .sb-content {
        overflow-y: scroll;
        box-sizing: border-box;
    }
</style>
