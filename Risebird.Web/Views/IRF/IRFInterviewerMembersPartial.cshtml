@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewerMembers>

@if (Model != null && Model.Count() != 0)
{
    <div>
        <div class="sb-container scroller">
            <table class="table table-bordered table-striped" style="width:100%">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th class="text-center">Mobile</th>
                        <th class="text-center">Call</th>
                        <th>EmailId</th>
                        <th>ResumeLink</th>
                        <th>Total Interviews</th>
                        <th>Total QC</th>

                    </tr>
                </thead>
                <tbody>


                    @foreach (var item in Model)
                    {
                    <tr>
                        @if (item.Type == "Interviewer")
                        {
                            <td style="color: #17c317">@item.Type</td>
                        }

                        @if (item.Type == "Emergency Interviewer")
                        {
                            <td style="color: #ff7bf5">@item.Type</td>
                        }


                        @if (item.Type == "QCInterviewer")
                        {
                            <td style="color:yellow">@item.Type</td>
                        }
                        <td class="text-center">@item.MobileNumber</td>
                        <td class="text-center">
                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                            {
                                <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CallButtonClick('@item.EmailId','@item.MobileNumber','myCallModal','callingLabel')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt">Call</span></span>
                            }

                        </td>
                        <td>@item.EmailId</td>
                        @if (item.ResumeLink != null && item.ResumeLink != "")
                        {
                            <td class="text-center">

                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                            </td>
                        }
                        else
                        {
                            <td class="text-center">No Resume</td>
                        }
                        <td class="text-center">@item.TotalInterviews</td>
                        <td class="text-center">@item.TotalQCInterviews</td>


                    </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div>
        No interviewers/Quality Controllers for this Skill Channel
    </div>
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=6" />
<script src="~/Newassets/js/scrollBar.js"></script>
<script src="~/js/CallTwilio.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>
