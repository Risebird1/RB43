@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewerMembers>

<div>
    @if (Model != null && Model.Count() != 0)
    {
        <div style="overflow-x:scroll" class="scrollbar" id="style-2">

            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th class="text-center">Mobile</th>
                        <th>EmailId</th>
                        <th class="text-center">Call</th>
                        <th>Resume Link</th>
                        <th>Company Name</th>
                        <th>Available</th>
                        <th>Response</th>
                        <th>Total Interviews</th>
                        <th>Action</th>
                        @if (ViewBag.Type != "IRF")
                        {
                            <th>Report</th>
                        }

                    </tr>
                </thead>
                <tbody>


                    @foreach (var item in Model)
                    {
                        var colorcode = "#bfd2f42b";
                        @if (item.isVerified)
                        {
                            if (item.IsEmployed && string.IsNullOrWhiteSpace(item.EmploymentComment))
                            {
                                colorcode = "#fff";
                            }
                            else if (!item.IsEmployed && string.IsNullOrWhiteSpace(item.EmploymentComment))
                            {
                                colorcode = "#fcfccab5";
                            }
                            else if (item.EmploymentComment.Contains("No record"))
                            {
                                colorcode = "#faddbfa3";
                            }
                        }
                        <tr style="background:@colorcode" title="@item.CompanyName">
                            @if (item.Type == "Interviewer")
                            {
                                <td style="color: #17c317">@item.Type</td>
                            }
                            else
                            {
                                <td style="color: #ff7bf5">@item.Type</td>
                            }
                            <td class="text-center">@item.MobileNumber</td>

                            <td>@item.EmailId</td>
                            <td class="text-center">
                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                {
                                    <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.InterviewerName','@item.MobileNumber','@item.EmailId')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                                }

                            </td>

                            @if (item.ResumeLink != null && item.ResumeLink != "")
                            {
                                <td class="text-center">
                                    <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                                </td>
                            }
                            else
                            {
                                <td class="text-center">No Resume</td>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.CompanyName))
                            {
                                @if (item.CompanyName.Length > 20)
                                {
                                    <td title="@item.CompanyName">@item.CompanyName.Substring(0,19) ....</td>
                                }
                                else
                                {
                                    <td>@item.CompanyName</td>
                                }
                            }
                            else
                            {
                                <td></td>
                            }
                            @if (ViewBag.Type == "IRF")
                            {
                                @if (item.IsAvailable)
                                {
                                    <td class="text-center">Yes</td>
                                }
                                else
                                {
                                    <td class="text-center">No</td>
                                }
                            }
                            else
                            {
                                @if (@item.AvailableStatus != "0")
                                {
                                    <td title="@item.AvailableStatus" style="overflow:hidden">@item.AvailableStatus</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                            <td>@item.AvailabilityResponseDate</td>
                            <td class="text-center">@item.TotalInterviews</td>
                            <td>
                                <button class="mdc-fab app-fab--absolute " aria-label="Interviewer Flags details">
                                    <span onclick="javascript:OpenInterviewerFlagDetails('@item.EmailId');" title="Interviewer Flags details" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-flag-fill" viewBox="0 0 16 16">  <path d="M14.778.085A.5.5 0 0 1 15 .5V8a.5.5 0 0 1-.314.464L14.5 8l.186.464-.003.001-.006.003-.023.009a12.435 12.435 0 0 1-.397.15c-.264.095-.631.223-1.047.35-.816.252-1.879.523-2.71.523-.847 0-1.548-.28-2.158-.525l-.028-.01C7.68 8.71 7.14 8.5 6.5 8.5c-.7 0-1.638.23-2.437.477A19.626 19.626 0 0 0 3 9.342V15.5a.5.5 0 0 1-1 0V.5a.5.5 0 0 1 1 0v.282c.226-.079.496-.17.79-.26C4.606.272 5.67 0 6.5 0c.84 0 1.524.277 2.121.519l.043.018C9.286.788 9.828 1 10.5 1c.7 0 1.638-.23 2.437-.477a19.587 19.587 0 0 0 1.349-.476l.019-.007.004-.002h.001" /></svg></span>
                                </button>
                            </td>
                            @if (ViewBag.Type != "IRF")
                            {
                                @if (item.AssessmentVerificationType == "MCQ")
                                {
                                    @if (!string.IsNullOrEmpty(item.SMCQId))
                                    {
                                        <td>
                                            <a target="_blank" href='@Url.Action("CandidateMCQReport", "MCQ", new { MCQId = item.MCQSetsValue,SMCQId=item.SMCQId })'>
                                                <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                    <span title="Questions Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                </button>
                                            </a>
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(item.inviteId))
                                    {
                                        <td>
                                            <a target="_blank" href='@Url.Action("CodeInviteReport", "Interviewer", new { inviteid = item.inviteId })'>
                                                <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                    <span title="Questions Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                </button>
                                            </a>
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }
                            }
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    }
    else
    {
        <div>
            No interviewers/Quality Controllers for this Skill Channel
        </div>
    }
</div>
<div id="interviewerFlagDetailsModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="memberHeading">Interviewer Details</h5>
            </div>
            <button onclick="closeinterviewerFlagDetailsModal()" type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="FlagDetailsTablebody" style="overflow:auto;max-height:30vw">
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

<script src="~/Newassets/js/scrollBar.js"></script>
<script src="~/js/TwilioCallMaker.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
    function closeinterviewerFlagDetailsModal() {
        var modal = document.getElementById("interviewerFlagDetailsModal");
        modal.style.display = "none";
    }
    function OpenInterviewerFlagDetails(Emailid) {
        $.ajax({
            url: '/Interviewer/FetchInterviewerFlagDetails',
            data: { 'InterviewerEmailid': Emailid },
            success: function (data) {
                var modal = document.getElementById("interviewerFlagDetailsModal");
                modal.style.display = "block";
                $('#FlagDetailsTablebody').html('');
                $('#FlagDetailsTablebody').html(data);
            }
        });
    }
</script>
<style>
    .sb-content {
        overflow-y: scroll;
        box-sizing: border-box;
    }
</style>
