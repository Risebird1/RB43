@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewerMembers>

@if (Model != null && Model.Count() != 0)
{
    <div style="overflow-x:auto">
        <table class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>EmailId</th>
                    <th>ResumeLink</th>
                    <th>Total Interviews</th>
                    <th>Total QC</th>
                    <th>Call</th>
                </tr>
            </thead>
            <tbody>


                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Type</td>
                        <td>@item.EmailId</td>
                        <td>@item.ResumeLink</td>
                        <td>@item.TotalInterviews</td>
                        <td>@item.TotalQCInterviews</td>
                        <td>
                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                            {
                                <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CallButtonClick('@item.EmailId','@item.MobileNumber','myCallModal','callingLabel')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt">Call</span></span>
                            }

                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
}
else
{
    <div>
        No interviewers/Quality Controllers for this Skill Channel
    </div>
}

    <script src="~/js/CallTwilio.js"></script>
