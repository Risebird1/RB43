@model IEnumerable<Risebird.Entities.ViewModel.IRFInterviewerMembers>
<div>
    @if (Model != null && Model.Count() != 0)
    {
        <div id="style-2" class="scrollers" style="overflow-y:auto">

            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th class="text-center">Mobile</th>
                        <th class="text-center">Call</th>
                        <th>EmailId</th>
                        <th>ResumeLink</th>
                        @if (ViewBag.Type == "IRF")
                        {
                            <th>Active</th>
                        }
                        <th>Available</th>
                        <th>Total Interviews</th>
                        @if (ViewBag.Type == "IRF")
                        {
                            <th>Total QC</th>
                        }
                    </tr>
                </thead>
                <tbody>


                    @foreach (var item in Model)
                    {
                        <tr>
                            @if (item.Type == "Interviewer")
                            {
                                <td style="color: #17c317">@item.Type</td>
                            }

                            @if (item.Type == "Emergency Interviewer")
                            {
                                <td style="color: #ff7bf5">@item.Type</td>
                            }


                            @if (item.Type == "QCInterviewer")
                            {
                                <td style="color:yellow">@item.Type</td>
                            }
                            <td class="text-center">@item.MobileNumber</td>
                            <td class="text-center">
                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                {
                                    <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CallButtonClick('@item.EmailId','@item.MobileNumber','myCallModal','callingLabel')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                                }

                            </td>
                            <td>@item.EmailId</td>
                            @if (item.ResumeLink != null && item.ResumeLink != "")
                            {
                                <td class="text-center">
                                    <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                                </td>
                            }
                            else
                            {
                                <td class="text-center">No Resume</td>
                            }
                            @if (ViewBag.Type == "IRF")
                            {
                                @if (item.IsActive)
                                {
                                    <td class="text-center">Yes</td>
                                }
                                else
                                {
                                    <td class="text-center">No</td>
                                }
                            }
                            @if (ViewBag.Type == "IRF")
                            {
                                @if (item.IsAvailable)
                                {
                                    <td class="text-center">Yes</td>
                                }
                                else
                                {
                                    <td class="text-center">No</td>
                                }
                            }
                            else
                            {
                                @if (@item.AvailableStatus != "0")
                                {
                                    <td title="@item.AvailableStatus" style="overflow:hidden">@item.AvailableStatus</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                            <td class="text-center">@item.TotalInterviews</td>
                            @if (ViewBag.Type == "IRF")
                            {
                                <td class="text-center">@item.TotalQCInterviews</td>
                            }
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    }
    else
    {
        <div>
            No interviewers/Quality Controllers for this Skill Channel
        </div>
    }
</div>

<div id="myCallModal" data-keyboard="false" data-backdrop="static" class="modal" style=" display: none;
                /* Hidden by default */ position: fixed; /* Stay in place */ z-index: 1; /* Sit on top */ padding-top: 100px; /* Location of the box */ left: 0; top: 0; width: 100%; /* Full width */ height: 100%; /* Full height */ overflow: auto; /* Enable scroll if needed */ background-color: rgb(0,0,0); /* Fallback color */ background-color: rgba(0,0,0,0.4); /* Black w/ opacity */ ">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">


            <div class="filheader">
                <div class="filavatar">
                    <span>


                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left" id="idTitle">Calling</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closeCallPopUp()">
                &times;
            </button>


            <div class="modal-body" style="padding: 2px 16px;">

                <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>


                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;
                        display: block;" class="btn btn-fill btn-danger" value="Hang Up">

            </div>

        </div>

    </div>
</div>
