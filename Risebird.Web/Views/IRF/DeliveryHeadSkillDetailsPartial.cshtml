@model Risebird.Entities.ViewModel.TechSkillsCollectionsWrapper
@using Risebird.Entities.Data;
@{
   string rubricDisplayStatus =  ViewBag.TechRubricType == TechRubricTypes.Advanced ? "block" : "none";
}
@if(Model.colectionone !=  null && Model.colectionone.Count() > 0)
{
    <div class="table-responsive scrollbar style-2" style="overflow-x:scroll;padding-bottom:0px;">
        <table style="background:#fff;" class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                    <th width="25%" class="table_heading">Skill Name<span class="red">*</span></th>
                    <th  class="table_heading">Weightage <span class="red">*</span></th>
                    <th width="35%" class="table_heading" style="float:left;margin-right:2px;display:@rubricDisplayStatus">Concepts</th>
                    <th width="25%" class="table_heading" style="float:left;margin-right:2px;display:@rubricDisplayStatus">Expectations</th>
                    <th width="14.5%" class="table_heading" style="float:left;margin-right:2px;display:@rubricDisplayStatus">Time limit</th>
                    <th width="24.3%" class="table_heading">Is Elimination Skill</th>
                </tr>
            </thead>
            <tbody>


                @for (int i = 0; i < Model.colectionone.Count(); i++)
                {
                    <tr>

                        <td width="10%">
                            @Model.colectionone[i].LevelName;
                        </td>
                        <td width="25%">
                            @Model.colectionone[i].SkillName;
                        </td>

                        <td>
                            @Model.colectionone[i].Weightage;
                        </td>
                        <td width="35%" style="float:left;display:@rubricDisplayStatus">
                            @Model.colectionone[i].Concepts;
                        </td>
                        <td width="25%" style="float:left;display:@rubricDisplayStatus">
                            @Model.colectionone[i].Natureofquestion;
                        </td>
                        <td width="15%" style="float:left;display:@rubricDisplayStatus">
                            @Model.colectionone[i].Timelimit;
                        </td>
                        <td width="24.5%">
                            @(Model.colectionone[i].isEliminationskill ? "Yes" : "No");
                        </td>


                    </tr>

                }

            </tbody>
        </table>

    </div>
}

@if(Model.colectiontwo != null && Model.colectiontwo.Count() > 0)
{
    <span id="techskills-note-txt"><label style="font-size:12.2px;line-height:14px;color:#929c9c;text-transform: none;margin:0px; padding: 0px;font-weight: 400;">(This is a muktistack interview where <b style="color:#dd1f1f;">40-45 mins</b> have to be allocated to evaluate primary stack skills and remaining <b style="color:#dd1f1f;">20-25 mins</b> have to be allocated to evaluate secondary stack skills)</label></span>
    <h1 style="font-size:18px;padding:10px;display:block;">OTHER SKILL(S)</h1>

    <div class="table-responsive scrollbar style-2" style="overflow-x:scroll;padding-bottom:0px;">
        <table style="background:#fff;" class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                    <th width="30%" class="table_heading">Skill Name<span class="red">*</span></th>
                    <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>
                    <th width="10%" class="table_heading">Is Elimination Skill</th>
                </tr>
            </thead>
            <tbody>


                @for (int i = 0; i < Model.colectiontwo.Count(); i++)
                {
                    <tr>

                        <td>
                            @Model.colectiontwo[i].LevelName;
                        </td>
                        <td>
                            @Model.colectiontwo[i].SkillName;
                        </td>

                        <td>
                            @Model.colectiontwo[i].Weightage;
                        </td>
                        <td>
                            @(Model.colectionone[i].isEliminationskill ? "Yes" : "No");
                        </td>


                    </tr>

                }

            </tbody>
        </table>

    </div>
}
