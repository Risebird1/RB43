<div id="PopupDetailsModal" class="modal modal-bg add-interviewer-popup">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="fa fa-user" style="font-size:25px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="changememberHeading"></h5>
            </div>
            <button onclick="closePopupDetailsModal()" type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="divpopupModel">
            </div>
        </div>
    </div>
</div>
