@if (ViewBag.Message != null )
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
<script src="~/js/addeditskillchannelcommonmethods.js"></script>
<script>
    debugger;
    var isNewSkillChannel = @Html.Raw(Json.Serialize(@Model.IsNewSkillChannel));
    function closePopupDetailsModal() {
        var modal = document.getElementById("PopupDetailsModal");
        modal.style.display = "none";
    }
    function openPopupDetailsModal() {
        var modal = document.getElementById("PopupDetailsModal");
        modal.style.display = "block";
    }
    function OpenInterviewerModal(irfid) {
        debugger;
        $("#changememberHeading").text('Interviewer');
        $.ajax({
            url: '/IRF/SkillChannelInterviewers',
            data: { 'id' : irfid },
            success: function (data) {
                openPopupDetailsModal();
                $('#divpopupModel').html('');
                $('#divpopupModel').html(data);
                debugger;
                UpdateInterviewerRateVariable('@Model.Heuristicsscore', '@Model.JobCountry', '@Model.CompanyType');
                if(isNewSkillChannel)
                {
                    var firstinterviewerRateElement = document.getElementById('InterviewerCollectionPopup_0__PerSuccessRate');
                    if(firstinterviewerRateElement != null  && (firstinterviewerRateElement.value == "" || firstinterviewerRateElement.value == 0))
                    {
                        if(firstinterviewerRateElement.readOnly == true)
                        {
                            firstinterviewerRateElement.readOnly = false;
                        }
                        firstinterviewerRateElement.value = interviewerRate;
                        firstinterviewerRateElement.readOnly = true;
                    }
                }
            }
        });
    }

</script>