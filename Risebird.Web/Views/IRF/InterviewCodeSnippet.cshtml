            Upload Questions <span class="red">*</span>
            <div class="mdc-touch-target-wrapper" style="top: 4px;position: relative;">
                <div class="mdc-radio mdc-radio--touch">
                    <input class="mdc-radio__native-control" type="radio" id="id_ResumeFile" checked name="Resume" value="Upload" onclick="RadioChanged(this.value)">
                    <div class="mdc-radio__background">
                        <div class="mdc-radio__outer-circle"></div>
                        <div class="mdc-radio__inner-circle"></div>
                    </div>
                </div>
            </div>
            Add Code <span class="red">*</span>
            <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                <div class="mdc-radio mdc-radio--touch">
                    <input class="mdc-radio__native-control" type="radio" id="id_ResumeLink" name="Resume" value="Code" onclick="RadioChanged(this.value)">
                    <div class="mdc-radio__background">
                        <div class="mdc-radio__outer-circle"></div>
                        <div class="mdc-radio__inner-circle"></div>
                    </div>
                </div>
            </div>
        </div> *@
        <div class="form-group" style="display:none" id="codeDiv">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="sample-qs">
                    <div class="table-responsive scrollbar style-2" style="overflow-x:scroll">
                        <table class="table mbn" id="QuestionsNewTable">
                            <thead>
                                <tr>
                                    <th class="table_heading b-right">Skill Name</th>
                                    <th class="table_heading b-right">Code Snippet</th>
                                    <th colspan="2" class="table_heading text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="b-right" style="vertical-align:top; border-right: 1px #dbd8d8a1 solid;">
                                        @Html.DropDownList("SkillCollection[0].SkillName", (SelectList)ViewBag.Skills, new { @class = "select-css form-control", @style = "width:180px;" })
                                    </td>
                                    <td class="b-right" style="border-right: 1px #dbd8d8a1 solid;">
                                        <div class="talk-bubble tri-right border-bubble right-in" style="width:315px;">
                                            <div class="talktext">
                                                <textarea htmlattributes="{ class = form-control text-box single-line }" id="SkillCollection_0__Comment" style="width:100%" name="SkillCollection[0].Comment" class="valid" aria-invalid="false" onblur="checkCodeLength(this.id)"></textarea>
                                            </div>
                                            <label id="questionError_0" class="text-danger"></label>
                                        </div>
                                    </td>
                                    <td class="text-center action-area">
                                        <div class="sample-btn" style="position:relative;right:25px;top:-38px;">
                                            <span style="float:right;" id="btnMinus_0" onclick="DeleteQuestionRow(this, 'SkillCollection','Skill','Comment', 'CreatedBy')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                        </div>
                                    </td>
                                    <td class="HiddenUserIdElement">
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="row"><div class="col-md-12 text-right" style="padding-right:30%"> <span id="error_0"></span></div></div>
            <div class="card-footer mt-10">
                <div class="row">
                    <div class="col-md-12 mc-button-area">
                        <div class="pull-left">
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add new Code snippet" onclick="AddQuestionRow()" data-original-title="Tooltip on top"><font style="font-family:arial;"> Add Code Snippet</font></span>
                            </button>
                        </div>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit" onclick="return errorMessage();">Submit</button>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:block" id="uploadDiv">
            <div class="upload_resume" style="padding-top:0px;">
                <div class="col-md-12 col-sm-12">
                    <div class="drop-box">
                        <header>
                            <h4>Select File here</h4>
                        </header>
                        <p>Files Supported: text file</p>
                        <label for="ResumeFiles">
                            <a class="drop-btn text-light" role="button" aria-disabled="false">Drop your files or <span class="filepond--label-action" tabindex="0">Browse</span></a>
                        </label>
                        <input type="file" name="ResumeFiles" accept=".txt" id="ResumeFiles" style="visibility: hidden; position: absolute;" multiple />
                        <div id="files-area">
                            <span id="filesList">
                                <span id="files-names"></span>
                            </span>
                        </div>
                    </div>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnfileUpload" value="Submit" onclick="CodeSnippetFileUpload()" style="margin:0px 15px;">Submit</button>
                    <div style="position:absolute;top:76px;left:0px;width: 100%;margin:10px auto;"> <label id="txtfileuploading" class="txtuploading" style="display:none;margin:-4px auto;"></label></div>
                </div>
            </div>
        </div>
        <div style="width:100%; float:left;height:10px;"></div>
        <!--end of col-md-12-->
    </div>
    @Html.HiddenFor(m => m.IRFId)
    @Html.HiddenFor(m => m.CreatedBy)
</form>

<script>
    $(document).ready(function () {
        if ('@Model.SkillCollection.Count()' == '0') {
            var x = document.createElement("INPUT");
            x.setAttribute("type", "hidden");
            x.setAttribute("id", 'SkillCollection_0__CreatedBy');
            document.getElementsByClassName("HiddenUserIdElement")[0].appendChild(x);
            $("#SkillCollection_0__CreatedBy").val('@Model.CreatedBy');
            $("#SkillCollection_0__CreatedBy").prop('name', 'SkillCollection[0].CreatedBy');;
            if (document.getElementById('btnMinus_0').style.display == 'none') {
                document.getElementById('btnMinus_0').style.display = "block";
            }
        }
    });

    function AddQuestionRow() {
        var $ttc = $("#QuestionsNewTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        //var $tr = $ttc.clone();
        //var trIndexReplaced = $("#QuestionsNewTable tr").length - 1;
        $tr.find("textarea,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })
        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("textarea[type=text]").val("");
        //$tr.find("textarea[type=text]").removeProp("readonly");
        $tr.find("input[type=hidden]").val('@Model.CreatedBy');
        var rowCount = $('#QuestionsNewTable tr').length;
        var finalIndex = rowCount - 1;
        $tr.find("input[type=hidden]").prop('id', 'SkillCollection_' + finalIndex + '__CreatedBy');
        $tr.find("input[type=hidden]").prop('name', 'SkillCollection[' + finalIndex + '].CreatedBy');
        $tr.find('span:last').prop('style', 'display:block');
        $tr.find('span:last').prop('id', 'btnMinus_' + finalIndex);


        $tr.prop('style', 'visibility : visible');

        // add cloned row as last row
        $("#QuestionsNewTable").find("tbody tr:last").after($tr);
        var $ttlast = $("#QuestionsNewTable").find("tbody tr:last");
        $ttlast.find("textarea").val("");
        $ttlast.find("textarea").removeAttr("readonly");

        $ttlast.find("textarea").blur(function () {
            checkCodeLength('SkillCollection_' + finalIndex + '__Comment');
        });
        var errorLabelIdValue = "questionError_" + finalIndex;
        $ttlast.find("label").attr("id", errorLabelIdValue);
        //$ttlast.find("label").removeAttr("name");
        // Find the affected form
        var $form = $tr.closest("FORM");
        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        var options = @Html.Raw(Json.Serialize(ViewBag.Skills));
        $("#SkillCollection_" + finalIndex + "__SkillName" + " option").remove();

        $(options).each(function () {
            var option = $("<option />");
            //Set Text part.
            option.html(this.text);
            //Set Value part.
            option.val(this.value);
            //Add the Option element to DropDownList.
            $("#SkillCollection_" + finalIndex + "__SkillName").append(option);
        });
    }


    function DeleteQuestionRow(element, collectionName, tdOne, tdTwo, tdThree) {
        if ($(element).parents('tbody').find('tr').length === 1) {
            alert('Must have atleast one Row');
            return false;
        }
        else {
            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    //name="ClientCollection[3].ClientUserId"
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                    elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;
                }
            }
        }
    }
</script>

<script>
    function errorMessage() {
        var items = $('[id^=SkillCollection][id$="Comment"]');
        for (j = 0; j < items.length; j++) {
            if ($('#SkillCollection_' + j + '__Comment').val() == '') {
                var error = document.getElementById("error_0");
                error.textContent = "Code Snippet field should not be blank";
                error.style.color = "red";
                return false;
            }
        }
        document.getElementById("questionform").submit();
        return true;
    }

    function checkCodeLength(elementId) {
        var index = elementId.match(/\d+/);
        var val = document.getElementById(elementId).value;
        var errorElementId = "questionError_" + index;

        if (val != null && val.length > 1000) {
            document.getElementById(errorElementId).innerHTML = "Code Snippet should not exceed 1000 characters.";
            document.getElementById("btnUpload").disabled = true;
            document.getElementById(elementId).focus();
            return;
        }
        else {
            document.getElementById(errorElementId).innerHTML = "";
            document.getElementById("btnUpload").disabled = false;
            return;
        }
    }
</script>


<script>
    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("codeDiv").style.display = "none";
        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("codeDiv").style.display = "block";
        }
    }
    function CodeSnippetFileUpload() {
        var fileControl = document.getElementById("ResumeFiles");
        var interviewid = $("#interviewid").val();
        var fileChunk = new FormData();
        fileChunk.append('interviewid', interviewid);
        if (fileControl.files.length > 0) {
            for (var i = 0; i < fileControl.files.length; i++) {
                fileChunk.append('file', fileControl.files[i]);
            }
        }
        $("#btnfileUpload").hide();
        document.getElementById("txtfileuploading").style.display = "block";
        $("#txtfileuploading").text("Uploading...");
        $.ajax({
            type: "POST",
            url: "/IRF/UploadInterviewCodeSnippet",
            data: fileChunk,
            contentType: false,
            enctype: 'multipart/form-data',
            processData: false,
            success: function (data) {
                $("#txtfileuploading").text(data);
                $("#btnfileUpload").show();
                FetchCodesnippet();

            }
        });
    }
</script>

 <script>

    const dt = new DataTransfer();

    $("#ResumeFiles").on('change', function (e) {
        for (var i = 0; i < this.files.length; i++) {
            let fileBloc = $('<span/>', { class: 'file-block' }),
                fileName = $('<span/>', { class: 'name', text: this.files.item(i).name });
            fileBloc.append('<span class="file-delete"><span>+</span></span>')
                .append(fileName);
            $("#filesList > #files-names").append(fileBloc);
        };
        // Ajout des fichiers dans l'objet DataTransfer
        for (let file of this.files) {
            dt.items.add(file);
        }
        // Mise à jour des fichiers de l'input file après ajout
        this.files = dt.files;

        // EventListener pour le bouton de suppression créé
        $('span.file-delete').click(function () {
            let name = $(this).next('span.name').text();
            // Supprimer l'affichage du nom de fichier
            $(this).parent().remove();
            for (let i = 0; i < dt.items.length; i++) {
                // Correspondance du fichier et du nom
                if (name === dt.items[i].getAsFile().name) {
                    // Suppression du fichier dans l'objet DataTransfer
                    dt.items.remove(i);
                    continue;
                }
            }
            // Mise à jour des fichiers de l'input file après suppression
            document.getElementById('ResumeFiles').files = dt.files;
        });
    });

</script>
