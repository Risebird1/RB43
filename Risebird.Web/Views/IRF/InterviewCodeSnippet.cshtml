@model Risebird.Entities.ViewModel.TechSkillComments
@inject IJsonHelper Json;

<form action="/IRF/InterviewCodeSnippet" enctype="multipart/form-data" id="questionform" method="post" class="ng-pristine ng-valid">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.interviewid)
    <div class="row">
        <div class="card-header" style="padding-top:8px;">
            <h4 class="card-title">Candidate Code Snippet</h4>
        </div>
