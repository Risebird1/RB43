
@{
    ViewData["Title"] = "IRF stats";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    var Header = "Interview Stats";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
  
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="desktop-view">
                        <h4 class="card-title pull-left">Interview Stats For <strong>@ViewBag.IRF</strong></h4>
                    </div>
                    <div class="mobile-view"><h4 class="card-title pull-left">Interview Stats For <strong>@ViewBag.IRF</strong></h4></div>
                </div>

                <div class="pull-right">
                    @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                </div>
            </div>
        </div>
    </div>











    <div class="content stats client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">

                        <div class="row">

                            <div style="width: 100%;">&nbsp;</div>

                            <div class="col-md-10 mr-auto" style="margin: auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">Interview Analysis</h4>
                                    </div>
                                    <div class="card-body">
                                        <div id="myFunnelChart" style="height: 300px; width: 100%;"></div>


                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>
<script type="text/javascript">

    $.ajax({
        url: '/IRF/FunnelChart',
        async: false,

        success: function (chData) {
            am4core.ready(function () {

                // Themes begin
                am4core.useTheme(am4themes_animated);
                // Themes end

                let chart = am4core.create("myFunnelChart", am4charts.SlicedChart);
                chart.data = [{
                    "name": "Risebird Selections",
                    "value": chData.totalRisebirdSelection
                }, {
                    "name": "Completed",
                    "value": chData.totalCompleted
                }, {
                    "name": "Candidates",
                    "value": chData.totalCandidates
                }];


                chart.logo.disabled = true;
                let series = chart.series.push(new am4charts.FunnelSeries());
                series.dataFields.value = "value";
                series.dataFields.category = "name";
                series.labels.template.disabled = false;

                series.colors.step = 16;
                var fillModifier = new am4core.LinearGradientModifier();
                fillModifier.brightnesses = [-0.1, -0.1, -0.1];
                fillModifier.offsets = [0, 0.5, 1];


                series.slices.template.fillModifier = fillModifier;
                series.alignLabels = true;
                series.labels.template.fill = am4core.color("#828080");
                chart.fontSize = 13;
                series.labels.template.text = "{category}: [bold]{value}[/]";

            });

        }
    });

</script>

