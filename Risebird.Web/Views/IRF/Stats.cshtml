    $.ajax({
        url: '/IRF/NewChartClientMeetingData',
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {

            
            var xAxisData = [];
            var yData1 = [];
            var yData2 = [];
            var yData3 = [];
            var yData4 = [];

            for (i = 0; i < chData.length; i++) {
                xAxisData.push(chData[i].name);
                yData1.push(chData[i].noShowCount);
                yData2.push(chData[i].scheduledCount);
                yData3.push(chData[i].droppedCount);
                yData4.push(chData[i].completedCount);
              
            }

            var yDataSets = [{
                label: 'No show', data: yData1, backgroundColor: 'rgba(54, 162, 235, 0.7)'
            }, {
                    label: 'Scheduled', data: yData2, backgroundColor: 'rgba(255, 205, 86, 0.7)'
            }, {
                    label: 'Dropped', data: yData3, backgroundColor: 'rgba(255, 99, 132, 0.7)'
            }, {
                    label: 'Completed', data: yData4, backgroundColor: 'rgba(63, 191, 63, 0.7)'
            }
            ]
            var chart = new Chart(clientIndiv, {
                type: 'bar',
                data: {
                    labels: xAxisData,//['Hr Stats', 'Staffing Stats'], // responsible for how many bars are gonna show on the chart
                    // create 12 datasets, since we have 12 items
                    // data[0] = labels[0] (data for first bar - 'Standing costs') | data[1] = labels[1] (data for second bar - 'Running costs')
                    // put 0, if there is no data for the particular bar
                    datasets: yDataSets
                },
                options: {
                    responsive: false,
                    legend: {
                        position: 'right' // place legend on the right side of chart
                    },
                    scales: {
                        xAxes: [{
                            stacked: true // this should be set to make the bars stacked
                        }],
                        yAxes: [{
                            stacked: true // this also..
                        }]
                    }
                }
            });
            
            
        }
    });

    $.ajax({
        url: '/IRF/NewChartClientFeedbackData',
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {
            debugger;
           
            var xAxisData = [];
            var yData1 = [];
            var yData2 = [];
            var yData3 = [];
            var yData4 = [];

            for (i = 0; i < chData.length; i++) {
                xAxisData.push(chData[i].name);
                yData1.push(chData[i].proxyCount);
                yData2.push(chData[i].selectedCount);
                yData3.push(chData[i].rejectedCount);
                yData4.push(chData[i].borderLineCount);

            }

            var yDataSets = [{
                label: 'Proxy', data: yData1, backgroundColor: 'rgba(54, 162, 235, 0.7)'
            }, {
                    label: 'Selected', data: yData2, backgroundColor: 'rgba(63, 191, 63, 0.7)'
            }, {
                    label: 'Rejected', data: yData3, backgroundColor: 'rgba(255, 99, 132, 0.7)'
            }, {
                    label: 'Borderline', data: yData4, backgroundColor: 'rgba(255, 205, 86, 0.7)'
            }
            ]
            var chart = new Chart(clientIndivFeedback, {
                type: 'bar',
                data: {
                    labels: xAxisData,//['Hr Stats', 'Staffing Stats'], // responsible for how many bars are gonna show on the chart
                    // create 12 datasets, since we have 12 items
                    // data[0] = labels[0] (data for first bar - 'Standing costs') | data[1] = labels[1] (data for second bar - 'Running costs')
                    // put 0, if there is no data for the particular bar
                    datasets: yDataSets
