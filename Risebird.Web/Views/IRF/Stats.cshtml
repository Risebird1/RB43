                    borderColor: ["rgb(84, 172, 198)", "rgb(169,222,58)", "rgb(220,53,69)", "rgb(255, 205, 86)", "rgba(255, 159, 64)", "rgba(75, 192, 192)", "rgba(153, 102, 255)", "rgba(201, 203, 207)"],
                    borderWidth: 0
                }]
            };
            var ctx = $("#myChartselected").get(0).getContext("2d");
            var myNewChart = new Chart(ctx, {
                type: 'bar',
                data: dataT,
                options: {
                    responsive: true,
                    title: { display: true },
                    //title: { display: true, text: 'CHART.JS DEMO CHART' },
                    legend: { position: 'bottom' },
                    scales: {
                        xAxes: [{ gridLines: { display: false }, display: true, scaleLabel: { display: false, labelString: '' } }],
                        yAxes: [{ gridLines: { display: false }, display: true, scaleLabel: { display: false, labelString: '' }, ticks: { stepSize: 10, beginAtZero: true, interval: 5, maxTicksLimit: 5 } }]
                    },

                    tooltips: {
                        yAlign: 'bottom',

                        titleFontColor: '#4b4c4c',
                        bodyFontColor: '#000',
                        backgroundColor: '#FFF',
                        borderColor: '#000',
                        borderWidth: '0.3',
                        borderStyle: 'dotted'
                    }
                }
            });
        }
    });

    $.ajax({
        url: '/IRF/NewChartClientMeetingData',
        async: false,
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {


            var xAxisData = [];
            var yData1 = [];
            var yData2 = [];
            var yData3 = [];
            var yData4 = [];

            for (i = 0; i < chData.length; i++) {
                xAxisData.push(chData[i].name);
                yData1.push(chData[i].noShowCount);
                yData2.push(chData[i].scheduledCount);
                yData3.push(chData[i].droppedCount);
                yData4.push(chData[i].completedCount);

            }

            var yDataSets = [{
                label: 'No show', data: yData1, borderWidth: 1, borderColor: 'rgba(40,157,231)', backgroundColor: 'rgba(40,157,231, 1)'
            }, {
                label: 'Scheduled', data: yData2, borderWidth: 1, borderColor: 'rgba(255, 205, 86)', backgroundColor: 'rgba(255, 205, 86, 1)'
            }, {
                label: 'Dropped', data: yData3, borderWidth: 1, borderColor: 'rgba(199,44,83)', backgroundColor: 'rgba(199,44,83,1)'
            }, {
                label: 'Completed', data: yData4, borderWidth: 1, borderColor: 'rgba(71,182,99)', backgroundColor: 'rgba(71,182,99, 1)'
            }
            ]
            var chart = new Chart(clientIndiv, {
                type: 'bar',
                data: {
                    labels: xAxisData,//['Hr Stats', 'Staffing Stats'], // responsible for how many bars are gonna show on the chart
                    // create 12 datasets, since we have 12 items
                    // data[0] = labels[0] (data for first bar - 'Standing costs') | data[1] = labels[1] (data for second bar - 'Running costs')
                    // put 0, if there is no data for the particular bar
                    datasets: yDataSets
                },
                options: {
                    responsive: true,
                    legend: {
                        labels: {
                            usePointStyle: false
                        },
                        position: 'bottom',
                        // place legend on the right side of chart
                    },
                    scales: {
                        xAxes: [{ gridLines: { display: false }, display: true, ticks: { autoSkip: false }, stacked: true, scaleLabel: { display: false, labelString: '' } }],
                        yAxes: [{ gridLines: { display: false }, display: true, stacked: true, scaleLabel: { display: false, labelString: '' }, ticks: { stepSize: 10, beginAtZero: true } }]
                    },
                    tooltips: {
                        yAlign: 'bottom',

                        titleFontColor: '#4b4c4c',
                        bodyFontColor: '#000',
                        backgroundColor: '#FFF',
                        borderColor: '#000',
                        borderWidth: '0.3',
                        borderStyle: 'dotted'
                    }
                }
            });


        }
    });

    $.ajax({
        url: '/IRF/NewChartClientFeedbackData',
        async: false,
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {


            var xAxisData = [];
            var yData1 = [];
            var yData2 = [];
            var yData3 = [];
            var yData4 = [];

            for (i = 0; i < chData.length; i++) {
                xAxisData.push(chData[i].name);
                yData1.push(chData[i].proxyCount);
                yData2.push(chData[i].selectedCount);
                yData3.push(chData[i].rejectedCount);
                yData4.push(chData[i].borderLineCount);

            }

            var yDataSets = [{
                label: 'Proxy', data: yData1, borderWidth: 1, borderColor: 'rgba(84, 172, 198 )', backgroundColor: 'rgba(84, 172, 198, 1)'
            }, {
                label: 'Selected', data: yData2, borderWidth: 1, borderColor: 'rgba(169,222,58 )', backgroundColor: 'rgba(169,222,58, 1)'
            }, {
                label: 'Rejected', data: yData3, borderWidth: 1, borderColor: 'rgba(220,53,69)', backgroundColor: 'rgba( 220,53,69, 1)'
            }, {
                label: 'Borderline', data: yData4, borderWidth: 1, borderColor: 'rgba(255, 205, 86 )', backgroundColor: 'rgba(255, 205, 86, 1)'
            }
            ]
            var chart = new Chart(clientIndivFeedback, {
                type: 'bar',
                data: {
                    labels: xAxisData,//['Hr Stats', 'Staffing Stats'], // responsible for how many bars are gonna show on the chart
                    // create 12 datasets, since we have 12 items
                    // data[0] = labels[0] (data for first bar - 'Standing costs') | data[1] = labels[1] (data for second bar - 'Running costs')
                    // put 0, if there is no data for the particular bar
                    datasets: yDataSets
                },
                options: {
                    responsive: true,
                    legend: {
                        labels: {
                            usePointStyle: false
                        },
                        position: 'bottom' // place legend on the right side of chart
                    },
                    scales: {
                        xAxes: [{
                            gridLines: { display: false }, display: true, ticks: { autoSkip: false }, stacked: true, scaleLabel: { display: false, labelString: '' }
                        }],
                        yAxes: [{ gridLines: { display: false }, display: true, stacked: true, scaleLabel: { display: false, labelString: '' }, ticks: { stepSize: 10, beginAtZero: true } }]
                    },
                    tooltips: {
                        yAlign: 'bottom',

                        titleFontColor: '#4b4c4c',
                        bodyFontColor: '#000',
                        backgroundColor: '#FFF',
                        borderColor: '#000',
                        borderWidth: '0.3',
                        borderStyle: 'dotted'
                    }
                }
            });


        }
    });

    $.ajax({
        url: '/IRF/BudgetConsumedChart',
        async: false,
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {

