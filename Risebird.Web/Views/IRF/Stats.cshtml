
@{
    ViewData["Title"] = "IRF stats";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Interview Stats
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content stats">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">

                        <div class="row">
                            <div class="card-header clearfix">
                                <div class="pull-left">   <h4 class="card-title pull-left">Interview Stats For <b>@ViewBag.IRF</b></h4></div>
                                <div class="pull-right">
                                    @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                </div>
                            </div>
                            <div style="width: 100%;">&nbsp;</div>

                            <div class="col-md-10 mr-auto" style="margin-left: auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">Interview Analysis</h4>
                                    </div>
                                    <div class="card-body">
                                        <div id="myFunnelChart" style="height: 300px; width: 100%;"></div>

                                        @*<canvas id="myFunnelChart" style="display: block;height: 350px;width: 100%;"></canvas>*@
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-5 ml-auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">Meeting Status</h4>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="myChart"></canvas>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-5 mr-auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">Interview Status</h4>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="myChartselected"></canvas>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-5 ml-auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">HR Staffing Meeting Status</h4>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="clientIndiv" style="display: block;height: 350px;width: 100%;"></canvas>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-5 mr-auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">HR Staffing Interview Status</h4>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="clientIndivFeedback" style="display: block;height: 350px;width: 100%;"></canvas>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-10 mr-auto" style="margin-left: auto">
                                <div class="card card-chart">
                                    <div class="card-header">
                                        <h4 class="card-title">Daily Meetings Cost</h4>
                                    </div>
                                    <div class="card-body">
                                        <canvas id="myCostChart" style="display: block;height: 350px;width: 100%;"></canvas>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>
<script type="text/javascript">
    $.ajax({
        url: '/IRF/NewChart',
        async: false,
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {

            var aData = chData;
            var aLabels = aData[0];
            var aDatasets1 = aData[1];
            var dataT = {
                labels: aLabels,
                datasets: [{
                    label: "Meeting Status",
                    data: aDatasets1,
                    fill: false,
                    //backgroundColor: [ "rgba(255, 159, 64, 0.2)", "rgba(75, 192, 192, 0.2)", "rgba(153, 102, 255, 0.2)", "rgba(201, 203, 207, 0.2)"],

                    backgroundColor: ["rgba(40,157,231, 1)", "rgba(255, 205, 86, 1)", "rgba(199,44,83, 1)", "rgba(71,182,99, 1)", "rgba(255, 159, 64, 0.2)", "rgba(75, 192, 192, 1)", "rgba(153, 102, 255, 1)", "rgba(201, 203, 207, 1)"],
                    borderColor: ["rgb(40,157,231)", "rgb(255, 205, 86)", "rgb(199,44,83)", "rgb(71,182,99)", "rgba(255, 159, 64)", "rgba(75, 192, 192)", "rgba(153, 102, 255)", "rgba(201, 203, 207)"],
                    borderWidth: 0
                }]
            };
            var ctx = $("#myChart").get(0).getContext("2d");
            var myNewChart = new Chart(ctx, {
                type: 'bar',
                data: dataT,
                options: {
                    responsive: true,
                    title: { display: true },
                    //title: { display: true, text: 'CHART.JS DEMO CHART' },
                    legend: { position: 'bottom' },
                    scales: {
                        xAxes: [{ gridLines: { display: false }, display: true, scaleLabel: { display: false, labelString: '' } }],
                        yAxes: [{ gridLines: { display: false }, display: true, scaleLabel: { display: false, labelString: '' }, ticks: { stepSize: 10, beginAtZero: true } }]
                    },

                    tooltips: {
                        yAlign: 'bottom',

                        titleFontColor: '#6b6b6b',
                        bodyFontColor: '#000',
                        backgroundColor: '#FFF',
                        borderColor: '#000',
                        borderWidth: '0.3',
                        borderStyle: 'dotted'
                    }
                }
            });
        }
    });

    $.ajax({
        url: '/IRF/NewChartSelected',
