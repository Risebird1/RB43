    $.ajax({
        url: '/IRF/NewChart',
        //contentType: "application/json",
        //dataType: "json",
        success: function (chData) {
            debugger;
            var aData = chData;
            var aLabels = aData[0];
            var aDatasets1 = aData[1];
            var dataT = {
                labels: aLabels,
                datasets: [{
                    label: "Meeting Status",
                    data: aDatasets1,
                    fill: false,
                    //backgroundColor: [ "rgba(255, 159, 64, 0.2)", "rgba(75, 192, 192, 0.2)", "rgba(153, 102, 255, 0.2)", "rgba(201, 203, 207, 0.2)"],

