@model Risebird.Entities.ViewModel.CandidateAudio


@{
    ViewData["Title"] = "Upload Audio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    body {
        font-family: Roboto, sans-serif;
    }

    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }


    textarea::-webkit-scrollbar {
        width: 2px;
        height: 6px;
        background-color: var(--mdc-theme-primary, #018786) !important;
    }

    textarea::-webkit-scrollbar-thumb {
        background-color: #56a9ff;
        border: 1px solid #56a9ff;
        margin: 2px;
        border-radius: 2px;
    }




    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    .multiple_row > h2 {
        font-size: 16px;
        background: #42a5f5 !important;
        padding: 4px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 0px;
        margin-bottom: 10px;
    }



    .panel-header-sm {
        height: 85px;
        padding-top: 65px;
        background: none !important;
    }




    /* Modal */
    .modal-header {
        background: #42a5f5 !important;
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        color: #fff;
    }

    .modal input, .modal .dropdown-toggle {
        background: #99d1fc0f !important;
    }
    /* Modal */




    .card .card-header .card-title, .card .card-header h4.card-title {
        margin: 0 0px 10px 0;
    }




    .mdc-card-wrapper__text-section {
        padding: 16px;
    }

    .demo-card__title {
        font-family: Roboto, sans-serif;
        -moz-osx-font-smoothing: grayscale;
        -webkit-font-smoothing: antialiased;
        font-size: 1.25rem;
        line-height: 2rem;
        font-weight: 500;
        letter-spacing: .0125em;
        text-decoration: inherit;
        text-transform: inherit;
    }


    .mdc-fab {
        width: 30px !important;
        height: 30px !important;
        background-color: #53a5f5 !important;
    }

    .sidebar:after, .off-canvas-sidebar:after {
        background: #42a5f5 !important;
    }



    .talk-bubble {
        display: inline-block;
        position: relative;
        font-size: 13px;
        height: auto;
        border-radius: 7px;
        margin: 5px 0px;
        background-color: #fff;
    }


        .talk-bubble textarea {
            resize: none;
            border: 0;
            background: #fff;
            padding: 5px;
        }

    .mdc-card {
        border-top: 3px #53a5f5 solid;
    }

    .mdc-button--raised:not(:disabled), .mdc-button--unelevated:not(:disabled) {
        background: #42a5f5 !important;
        font-family: Roboto, sans-serif;
        font-size: 12px;
        text-decoration: none;
    }

    .mdc-button--outlined:not(:disabled) {
        border-color: #42a5f5 !important;
        color: #42a5f5 !important;
    }

    .mdc-fab-secondary {
        background: #fff !important;
        color: #53a5f5 !important;
    }

    .navbar .navbar-wrapper {
        color: #143e67 !important;
    }

        .navbar .navbar-wrapper .navbar-brand {
            margin-right: 0.5rem;
        }

    .mc-button-area {
        text-align: right;
    }

    .mdc-card .form-control {
        border: 0;
        border-radius: 4px 4px 0 0;
        background: whitesmoke;
        height: 40px;
        font-size: 0.8rem;
        border-bottom: 1px rgba(0, 0, 0, 0.29) solid;
    }

        .mdc-card .form-control:focus {
            border-bottom: 2px rgb(80, 158, 235) solid;
        }

    .mdc-radio .mdc-radio__native-control:enabled:checked + .mdc-radio__background .mdc-radio__outer-circle, .mdc-radio .mdc-radio__native-control:enabled + .mdc-radio__background .mdc-radio__inner-circle {
        border-color: #53a5f5 !important;
    }






    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .table-responsive {
        overflow: hidden;
    }





    .table {
        white-space: nowrap;
    }

    .canvasjs-chart-credit {
        display: none;
    }


    .control-label {
        color: #5f5c5c !important;
        font-weight: normal !important
    }

    .card-text-label {
        font-size: 13px !important;
    }

    .mdc-checkbox__native-control:enabled:checked ~ .mdc-checkbox__background, .mdc-checkbox__native-control:enabled:indeterminate ~ .mdc-checkbox__background {
        border-color: #53a5f5 !important;
        background-color: #53a5f5 !important;
    }

    .mdc-checkbox {
        display: inline-block;
        position: relative;
        flex: 0 0 18px;
        box-sizing: content-box;
        width: 18px;
        height: 18px;
        line-height: 0;
        white-space: nowrap;
        cursor: pointer;
        vertical-align: bottom;
        padding: 15px 11px;
    }
</style>

<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js"></script>*@


<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>
<link href="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />

<script src="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

<div class="main-panel" id="main-panel">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Upload Audio
                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">

        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/IRF/UploadAudio" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <ul style="padding:0px;">
                                    <li style="list-style:none;font-size: 15px; line-height: 18px;">Kindly ensure the duration of the audio file for voice biometric is a minimum of 2 seconds and does not exceed 5 seconds.</li>
                                </ul>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.IRFName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.IRFName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                        </div>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">

                                        @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                        @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control", @accept = ".mp3, .wav, .m4a" })

                                    </div>
                                    <div class="col-md-6 col-sm-6">

                                        <div class="form-group" id="descText" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.Description, new { @class = "form-control text-box single-line", @style = " height:45px" })
                                        </div>
                                        <div class="form-group" id="descDrop" style="display:none">
                                            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.DropDescription, Model.EnrollmentList, new { @class = "form-control", @style = "margin-top:10px; height:45px" })

                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="mdc-form-field" style="margin-bottom: 10px;">


                                            <div class="mdc-checkbox">
                                                @Html.CheckBoxFor(m => m.IsVoiceBiometric, new { @class = "mdc-checkbox__native-control", @onclick = "checkBiometric()" })

                                                <div class="mdc-checkbox__background">
                                                    <svg class="mdc-checkbox__checkmark"
                                                         viewBox="0 0 24 24">
                                                        <path class="mdc-checkbox__checkmark-path"
                                                              fill="none"
                                                              d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                    </svg>
                                                    <div class="mdc-checkbox__mixedmark"></div>
                                                </div>
                                                <div class="mdc-checkbox__ripple"></div>


                                            </div>
                                            @Html.LabelFor(model => model.IsVoiceBiometric, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "font-size: 13px; padding-top: 8px;" })
                                        </div>
                                    </div>

                                </div>
                                <div class="row" id="idPhrase" style="display:none">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.PhraseDetail, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @if (Model.HasVoiceBiometricAudio)
                                            {
                                                @Html.DropDownListFor(m => m.PhraseDetail, Model.PhraseList, new { @class = "form-control", @style = "margin-top:10px; height:45px", @disabled = "disabled" })
                                                Model.PhraseDetail = Model.PhraseList.SelectedValue.ToString();
                                                @Html.HiddenFor(m=>m.PhraseDetail)
                                            }
                                            else
                                            {
                                                @Html.DropDownListFor(m => m.PhraseDetail, Model.PhraseList, new { @class = "form-control", @style = "margin-top:10px; height:45px" })

                                            }

                                        </div>
                                    </div>

                                </div>


                                @Html.HiddenFor(m => m.IRFId)
                                @Html.HiddenFor(m => m.CandidateId)
                                @Html.HiddenFor(m => m.IRFName)

                                <div class="card-footer ">
                                    <div class="row">

                                        <div class="col-md-12 mc-button-area">
                                            @if (Model.CandidateAudios == null || Model.CandidateAudios.Count() == 0)
                                            {
                                                @Html.ActionLink("Back to List", "Candidates", "IRF", new { id = Model.IRFId, irfName = Model.IRFName }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })

                                            }
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save">Upload</button>


                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>
                        @if (Model.CandidateAudios != null && Model.CandidateAudios.Count() > 0)
                        {
                            <form action="/IRF/EnrollVoiceItUser" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">
                                @Html.AntiForgeryToken()
                                <div class="canvas_div_pdf">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })



                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>Uploaded Audios for Voice Biometric</h2>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive-sm">
                                                <table class="table table-bordered mbn" id="AudioTable" style="text-align:center">
                                                    <thead>
                                                        <tr>
                                                            <th width="10%">File</th>
                                                            <th width="20%">Phrase</th>
                                                            <th width="10%">Description</th>
                                                            <th width="10%">Status</th>
                                                            <th width="35%">Result</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (Model.CandidateAudios != null)
                                                        {
                                                            @for (int i = 0; i < Model.CandidateAudios.Count(); i++)
                                                            {
                                                        <tr>

                                                            <td>
                                                                <a class="audio-rec" href='@Model.CandidateAudios[i].AudioFileLink' download>
                                                                    @Model.CandidateAudios[i].AudioFileLink.Split('/').Last()
                                                                </a>
                                                            </td>
                                                            <td>@Model.CandidateAudios[i].PhraseDetail</td>
                                                            <td>@Model.CandidateAudios[i].Description</td>
                                                            @if (Model.CandidateAudios[i].IsEnrolled)
                                                            {
                                                                <td>Enrolled</td>
                                                            }
                                                            else
                                                            {
                                                                <td>Not Enrolled</td>

                                                            }
                                                            @if (Model.CandidateAudios[i].EnrollmentMessage != null)
                                                            {
                                                                if (Model.CandidateAudios[i].EnrollmentMessage.ToLower().Contains("success"))
                                                                {
                                                                    <td>Successful</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>@Model.CandidateAudios[i].EnrollmentMessage</td>

                                                                }
                                                            }
                                                            else
                                                            {
                                                                <td>NA</td>

                                                            }
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].id)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].IRFId)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].IRFName)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].CandidateId)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].IsEnrolled)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].AudioFileLink)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].PhraseDetail)
                                                            @Html.HiddenFor(m => Model.CandidateAudios[i].VoiceItUserId)
                                                            @*@if (Model.CandidateAudios[i].VoiceItUserId != null)
        {

        }*@

                                                        </tr>

                                                            }

                                                        }

                                                    </tbody>
                                                </table>


                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>

                                    <div class="card-footer ">
                                        <div class="row">
                                            <div class="col-md-12 mc-button-area">

                                                @Html.ActionLink("Back to List", "Candidates", "IRF", new { id = Model.IRFId, irfName = Model.IRFName }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                                @if (Model.ContainsUnEnrolled)
                                                {
                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Enroll">Enroll</button>

                                                }
                                                else
                                                {
                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Enroll" disabled="disabled">Enroll</button>

                                                }
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </form>
                        }
                        


                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

    </div>
 
</div>



@*<script src="https://code.jquery.com/jquery-1.12.4.min.js" integrity="sha256-ZosEbRLbNQzLpnKIkEdrPv7lOy9C27hHQ+Xp8a4MxAQ=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.5/jspdf.min.js"></script>*@

<script>

    function checkBiometric() {
        var val = document.getElementById("IsVoiceBiometric").checked;
        if (val) {
            document.getElementById("idPhrase").style.display = "block";
            document.getElementById("descDrop").style.display = "block";
            document.getElementById("descText").style.display = "none";
        }
        else {
            document.getElementById("idPhrase").style.display = "none";
            document.getElementById("descDrop").style.display = "none";
            document.getElementById("descText").style.display = "block";
        }

    }


</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //window.location.reload(true);
                    }
                )

            }
            else if (msg.toLowerCase().includes("kindly")) {
                swal({
                    title: 'Enrollment Status!',
                    text: '@ViewBag.Message',
                    type: 'info',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //window.location.reload(true);
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.reload(true);
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}
