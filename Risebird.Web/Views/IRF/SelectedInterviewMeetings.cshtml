                    /  &nbsp;  Interview Selected Meetings

                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="row">
                                    <div class="card-header">
                                        <div class="pull-left"> <h4 class="card-title">         Selected Candidate list for <b>@ViewBag.IRF</b></h4></div>

                                        <div class="pull-right">
                                            <div>
                                                <div class="form-group" style="float:left;">
                                                    @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "select-css form-control", onchange = "FilterInterviews(this.value);" })
                                                </div>
                                                @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            </div>
                                        </div>
                                    </div>





                                </div>

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Report Link</th>
                                                <th>Resume</th>
                                                @*<th>Candidate Contact</th>*@
                                                <th>Client HR</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Per Hour Rate</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                                <th>Approval Status</th>
                                                <th>Approval CommentSSs</th>
                                                <th class="no-sort"></th>
                                                <th>Final Selection Status</th>
                                                <th>Final Selection Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Interview Date</th>
                                                <th>Candidate Name</th>
                                                <th>Report Link</th>
                                                <th>Resume</th>
                                                @*<th>Candidate Contact</th>*@
                                                <th>Client HR</th>
                                                <th>Confirmation Status</th>
                                                <th>Meeting Status</th>
                                                <th>Selection Status</th>
                                                <th>Current Employer</th>
                                                <th>Expected Per Hour Rate</th>
                                                <th>Expected Joining Time</th>
                                                <th>Preferred Location</th>
                                                <th>Staffing Agency</th>
                                                <th>Approval Status</th>
                                                <th>Approval Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Final Selection Status</th>
                                                <th>Final Selection Comments</th>
                                                <th class="no-sort"></th>
                                                <th>Action</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>


                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                <tr id=@item.imid>
                                                    <td> @item.interviewDate </td>
                                                    @if (item.IsOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.candidateEmail')">    @item.candidateName <span class="dot" style="background-color:green"></span></a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            <a onclick="">@item.candidateName <span class="dot"></span></a>
                                                        </td>
                                                    }
                                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new {  interviewId = item.imid, irfId= ViewBag.IRFintId, IsSelected = true})'>Report</a> </td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }

                                                    @*@if (item.MobileNumber != null)
                                                        {
                                                            <td>@item.MobileNumber</td>

                                                        }
                                                        else
                                                        {
                                                            <td>No Contact</td>
                                                        }*@
                                                    <td style="white-space:normal;"> @item.ClientHrContact </td>
                                                    <td> @item.confirmationStatus</td>
                                                    <td> @item.MeetingStatusStatusDesc </td>
                                                    <td> @item.intervieweStatusStatDesc </td>
                                                    <td> @item.currentEmployerName </td>
                                                    <td> @item.expectedPerHourRate </td>
                                                    <td> @item.joiningTime </td>
                                                    <td> @item.preferredLocation </td>
                                                    <td>@item.staffingAgency</td>
                                                    <td>
                                                        @item.NextLevelApprovalStat
                                                    </td>
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in">
                                                            <div class="talktext">
                                                                <textarea class="scrollbar" style="height: 50px; width:100%;" id="style-4">@item.ApprovalComments</textarea>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td></td>

                                                    <td>
                                                        @item.FinalSelectionStat
                                                    </td>
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in">
                                                            <div class="talktext">
                                                                <textarea class="scrollbar" style="height: 50px; width:100%;" id="style-4">@item.FinalComments</textarea>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td></td>
                                                    <td class="text-right action">
                                                        @if (ViewBag.ProfileName == "client")
                                                        {
                                                            <span title="Client Feedback" onclick="ModalButtonClick(@jsonObject)" id="@("myBtn_"+item.imid)" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-thumbs-up"></i></span>
                                                        }
                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                        {
                                                            <span onclick="callCandidate(@item.MobileNumber)" title="Call Candidate" class="btn btn-round btn-info btn-icon btn-sm like callButton"><i class="fa fa-phone"></i></span>
                                                            <span onclick="hangUp()" title="Hang up" class="btn btn-round btn-danger btn-icon btn-sm like hangUpButton"><i class="fa fa-phone"></i></span>

                                                        }
                                                    </td>




                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>


                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" style="    font-size: 20px;">Client Feedback</h5>
                        <span class="close" id="feedbackPopUp">&times;</span>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">
                                    <label class="control-label" for="approveDropdown">Approved For Next Round</label>
                                    <select class="form-control" id="approveDropdown" name="approveDropdown"></select>
                                </div>

                            </div>

                            <div class="col-md-6 col-sm-6 ">
                                <div id="approvalComments" class="form-group">
                                    <label class="control-label" style="display:block">Approval Comments</label>

                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="appComments" class="form-control text-box single-line scrollbar" id="appComments" style="height:35px"></textarea>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">
                                    <label class="control-label" for="selectionDropdown" style="display:block">Final Selection</label>
                                    <select class="form-control" id="selectionDropdown" name="selectionDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div id="selectionComments" class="form-group">
                                    <label class="control-label" style="display:block">Final Comments</label>
                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="selecComments" class="form-control text-box single-line scrollbar" id="selecComments" style="height:35px"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv ">
                                <div class="form-group">

                                    <label class="control-label" for="offerDropdown" style="display:block"><b>Offer Status</b></label>
                                    <select class="form-control" id="offerDropdown" name="offerDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 ">
                                <div id="offerComments" class="form-group">
                                    <label class="control-label" style="display:block">Offer Comments</label>
                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="offComments" class="form-control text-box single-line" id="offComments" style="height:32px"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">

                                    <label class="control-label" for="joiningDropdown" style="display:block">Joining Status</label>
                                    <select class="form-control" id="joiningDropdown" name="joiningDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6">
                                <div id="joiningComments" class="form-group">
                                    <label class="control-label" style="display:block">Joining Comments</label>
                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="joinComments" class="form-control text-box single-line" id="joinComments" style="height:35px"></textarea>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="">
                            <input type="button" onclick="SavePopUp()" class="btn btn-fill btn-primary pull-right" id="btnUpload" value="Save">
                        </div>
                    </div>

                </div>

            </div>
        </div>




        <!-- end row -->
    </div>

</div>


