                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">
                                    <label class="control-label" for="selectionDropdown" style="display:block">Final Selection</label>
                                    <select class="form-control" id="selectionDropdown" name="selectionDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 pr-1">
                                <div id="selectionComments" class="form-group">
                                    <label class="control-label" style="display:block">Final Comments</label>
                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="selecComments" class="form-control text-box single-line scrollbar" id="selecComments" style="height:35px"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv ">
                                <div class="form-group">

                                    <label class="control-label" for="offerDropdown" style="display:block"><b>Offer Status</b></label>
                                    <select class="form-control" id="offerDropdown" name="offerDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 ">
                                <div id="offerComments" class="form-group">
                                    <label class="control-label" style="display:block">Offer Comments</label>
                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="offComments" class="form-control text-box single-line" id="offComments" style="height:32px"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">

                                    <label class="control-label" for="joiningDropdown" style="display:block">Joining Status</label>
                                    <select class="form-control" id="joiningDropdown" name="joiningDropdown"></select>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6">
                                <div id="joiningComments" class="form-group">
                                    <label class="control-label" style="display:block">Joining Comments</label>
                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="joinComments" class="form-control text-box single-line" id="joinComments" style="height:35px"></textarea>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="">
                            <input type="button" onclick="SavePopUp()" class="btn btn-fill btn-primary pull-right" id="btnUpload" value="Save">
                        </div>
                    </div>

                </div>

            </div>
        </div>




        <!-- end row -->
    </div>

</div>


