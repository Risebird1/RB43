<script>
    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
            $("#" + id).attr("data-changes", "1");
        }
    }

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }

    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });
    });
    var list;

    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/IRF/SelectedInterviewMeetingsJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {
                    list = data.result;
                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }

    function bindtableData(data) {
        var profile = $("#hidprofile").val();
        var irfid = $("#hidirfid").val();
        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="10" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }
        for (var i = 0; i < data.length; i++) {
            html += ' <tr id="' + data[i].imid + '" data-changes="1">';
            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].imid + '" data-target=".' + data[i].imid + '" class="detail-row" onclick="changeicon(' + data[i].imid + ')">&nbsp;</td>';
            html += '  <td> ' + new Date(data[i].interviewDate).toLocaleString() + ' </td>';
            if (data[i].candidateName != null && data[i].candidateName != "") {
                if (data[i].isOnline == 1 && data[i].candidateName.length > 20) {
                    html += '   <td> <a onclick="directopenChat(' + data[i].candidateEmail + ')"><span class="dot" style="background-color:green"></span>    ' + data[i].candidateName.substring(0, 20) + '...  </a></td> ';
                }
                else {
                    if (data[i].candidateName.length > 20) {
                        html += '  <td class="cadName"> <a onclick="" data-tooltip="' + data[i].candidateName + '"><span class="dot"></span>' + data[i].candidateName.substring(0, 20) + '... </a></td>';
                    }

                    else {
                        html += '  <td class="cadName"> <a onclick=""><span class="dot"></span> ' + data[i].candidateName + ' </a> </td> ';
                    }
                }

            }
            else { html += '<td></td>'; }
            html += '  <td> <a id="reportId" target="_blank" title="Report Link" href="/Interview/AddReport?interviewId=' + data[i].imid + '&irfId=' + irfid + '">Report</a></td>';
            if (data[i].resumeLink != null && data[i].resumeLink != "") {
                html += '      <td> <a id="resumeId" target="_blank" title="Resume" href=' + data[i].resumeLink + '>Resume</a> </td>';
            }
            else {
                html += '    <td>No Resume</td>';
            }

            if (data[i].isHrOnline == 1 && data[i].clientHrContact.length > 20) {
                if (data[i].clientHrContact != null) {
                    html += '   <td>  <a onclick="directopenChat(' + data[i].clientHrContact + ')"><span class="dot" style="background-color:green"></span> ' + data[i].clientHrContact.substring(0, 20) + '... </a></td>';
                }
                else {
                    html += ' <td></td>';
                }
            }
            else {
                if (data[i].clientHrContact != null) {
                    html += '   <td>  <a onclick=""><span class="dot"></span>' + data[i].clientHrContact + ' </a></td>';
                }
                else { html += ' <td></td>'; }
            }



            html += '    <td> ' + data[i].confirmationStatus + '</td>';
            html += '  <td> ' + data[i].meetingStatusStatusDesc + ' </td>';
            html += '  <td> ' + data[i].intervieweStatusStatDesc + ' </td>';

            if (profile == "client") {
                html += '    <td class="text-right action">';
                html += '    <span title="Client Feedback" onclick="ModalButtonClickjson(' + i + ')" id="myBtn_' + data[i].imid + '" class="btn-call"><i class="fa fa-thumbs-up"></i></span>';
                html += '     </td>';
            }
            if (data[i].mobileNumber != null && data[i].mobileNumber != "") {
                html += '    <td class="text-right action"><input type="hidden" value="' + data[i].mobileNumber + '" id="txtmobile_' + data[i].imid + '" />';
                html += '   <span onclick="callCandidateJson(' + data[i].imid + ')" title="Call Candidate" class="btn-call"><i class="fa fa-phone"></i></span>';
                html += ' <span onclick="hangUp()" title="Hang up" class="btn-call btn-danger  hangUpButton"><i class="fa fa-phone"></i></span>';
                html += '     </td>';
            }

            html += '     </tr>';
            html += '   <tr class="collapse ' + data[i].imid + '">';
            html += '  <td colspan="999" class="child-section">';
            html += ' <table class="table table-striped table-responsive">';
            html += '    <tr>';
            html += ' <th>Current Employer</th>';
            html += '  <th>Expected Per Hour Rate</th>';
            html += '  <th>Expected Joining Time</th>';
            html += '   <th>Preferred Location</th>';
            html += '   <th>Staffing Agency</th>';
            html += '   <th>Approval Status</th>';
