@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "Selected Candidate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Interview Request Forms</a>
                <a class="navbar-brand">
                    Interview Selected Meetings

                </a>
            </div>
            
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">
                            Selected Candidate list for <b>@ViewBag.IRF</b>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="text-right">
                            @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                        </div>
                        <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>Interview Date</th>
                                    <th>Candidate Name</th>
                                    <th>Resume</th>
                                    <th>Client HR</th>
                                    <th>Confirmation Status</th>
                                    <th>Meeting Status</th>
                                    <th>Selection Status</th>
                                    <th>QC Status</th>
                                    <th>Training Status</th>
                                    <th>Final Interview Status</th>
                                    <th>Joining Status</th>
                                    <th>Report Link</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>Interview Date</th>
                                    <th>Candidate Name</th>
                                    <th>Resume</th>
                                    <th>Client HR</th>
                                    <th>Confirmation Status</th>
                                    <th>Meeting Status</th>
                                    <th>Selection Status</th>
                                    <th>QC Status</th>
                                    <th>Training Status</th>
                                    <th>Final Interview Status</th>
                                    <th>Joining Status</th>
                                    <th>Report Link</th>
                                    <th class="disabled-sorting text-right">Actions</th>
                                </tr>
                            </tfoot>
                            <tbody>


                                @foreach (var item in Model)
                                {
                                <tr id=@item.imid>
                                    <td> @item.interviewDate </td>
                                    <td> @item.candidateName </td>
                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                    <td> @item.ClientHrContact </td>
                                    <td> @item.comfirmationStatus</td>
                                    <td> @item.MeetingStatusStatusDesc </td>
                                    <td> @item.intervieweStatusStatDesc </td>
                                    <td> @item.QCStatusStatusDesc </td>
                                    <td> @item.PreparationStatusDesc </td>
                                    <td> @item.ClientInterviewStatus </td>
                                    <td> @item.JoiningStatusStatDesc  </td>
                                    <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "Interview", new {  interviewId = item.imid, irfId= item.IRFId})'>Report</a> </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>



<script type="text/javascript">

    $(".dataloading").hide();
    $(".datatable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $(".datatable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
</script>

<!-- Keep the Page Content Here.-->

<script type="text/javascript">
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $(".datatable").show();
        }, 2000);
    };
</script>
<loading></loading>

<!-- PAGE CONTENT WRAPPER -->
