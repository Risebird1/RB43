@*@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.MeetingVM>
@using X.PagedList.Mvc.Core;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Selected Candidate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/IRF/Index'>Skills Channel</a>&nbsp;/&nbsp;Interview Selected Meetings";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=9" />
<input type="hidden" value="@ViewBag.IRFId" id="hidirfid" />
<input type="hidden" value="@ViewBag.Profile" id="hidprofile" />
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="desktop-view">
                        <h4 class="card-title" style="margin-top:0px">      Selected Candidate list for <strong>@ViewBag.IRF</strong></h4>
                    </div>
                    <div class="mobile-view"><h4 class="card-title">         Selected Candidate list for <strong>@ViewBag.IRF</strong></h4></div>
                </div>

                <div class="pull-right client-ms">
                    <div class="selectedmeeting">

                        @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                        <div id="meeting_filter" class="dataTables_filter pull-left" style="margin-right:10px;">

                            <div id="intselmeet_2" class="searchCon">

                                <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.searchValue">

                                <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                                @*<button style="display:none;" type="button" id="x">x</button>*@

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>







    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>

                                                            <th id='start' style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;" id='start'>Interview Date</th>
                                                            <th>Candidate Name</th>
                                                            <th id="intselmeet_3">Report Link</th>
                                                            <th id="intselmeet_4">Resume</th>
                                                            @*<th>Candidate Contact</th>*@
                                                            <th>Client HR</th>
                                                            <th id="intselmeet_5">Confirmation Status</th>
                                                            <th id="intselmeet_6">Meeting Status</th>
                                                            <th id="intselmeet_7">Selection Status</th>

                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;">Interview Date</th>
                                                            <th>Candidate Name</th>
                                                            <th>Report Link</th>
                                                            <th>Resume</th>
                                                            @*<th>Candidate Contact</th>*@
                                                            <th>Client HR</th>
                                                            <th>Confirmation Status</th>
                                                            <th>Meeting Status</th>
                                                            <th>Selection Status</th>

                                                            <th>Action</th>

                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodySelectedInterviewMeeting">


                                                        @foreach (var item in Model)
                                                        {
                                                            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                            <tr id="@item.imid" data-changes="1">
                                                                <td style="width:10px;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                <td> @item.interviewDate </td>
                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                {
                                                                    @if (item.IsOnline == 1 && item.candidateName.Length > 20)
                                                                    {
                                                                        <td>
                                                                            <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>     @item.candidateName.Substring(0, 20)...  </a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        @if (item.candidateName.Length > 20)
                                                                        {



                                                                            <td class="cadName">
                                                                                <a onclick="" data-tooltip="@item.candidateName"><span class="dot"></span> @item.candidateName.Substring(0, 20)... </a>
                                                                            </td>
                                                                        }

                                                                        else
                                                                        {
                                                                            <td class="cadName">
                                                                                <a onclick=""><span class="dot"></span> @item.candidateName </a>
                                                                            </td>
                                                                        }
                                                                    }

                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }


                                                                <td> <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "IRF", new { interviewId = item.imid, irfId = ViewBag.IRFintId, IsSelected = true })'>Report</a> </td>
                                                                @if (item.resumeLink != null && item.resumeLink != "")
                                                                {
                                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }

                                                                @if (item.ClientHrContact != null && item.ClientHrContact != "")
                                                                {
                                                                    @if (item.IsHrOnline == 1 && item.ClientHrContact.Length > 18)
                                                                    {
                                                                        <td>
                                                                            <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact.Substring(0, 18)... </a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>
                                                                            <a onclick=""><span class="dot"></span> @item.ClientHrContact.Substring(0, 18)...  </a>
                                                                        </td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }

                                                                <td> @item.confirmationStatus</td>
                                                                <td> @item.MeetingStatusStatusDesc </td>
                                                                <td> @item.intervieweStatusStatDesc </td>

                                                                <td class="text-right action">
                                                                    @if (ViewBag.ProfileName == "client")
                                                                    {
                                                                        <span id="intselmeet_8" title="Client Feedback" onclick="ModalButtonClick(@jsonObject)" id="@("myBtn_" + item.imid)" class="btn-call"><i class="fa fa-thumbs-up"></i></span>
                                                                    }
                                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                    {
                                                                        <span id="intselmeet_9" onclick="callCandidate('@item.MobileNumber',@item.imid)" title="Call Candidate" class="btn-call"><i class="fa fa-phone"></i></span>
                                                                        <span id="intselmeet_10" onclick="hangUp()" title="Hang up" class="btn-call btn-danger  hangUpButton"><i class="fa fa-phone"></i></span>

                                                                    }
                                                                </td>




                                                            </tr>


                                                            <tr class="collapse @item.imid">
                                                                <td colspan="999" class="child-section">
                                                                    <table class="table table-striped table-responsive">
                                                                        <tr>
                                                                            <th>Current Employer</th>
                                                                            <th>Expected Per Hour Rate</th>
                                                                            <th>Expected Joining Time</th>
                                                                            <th>Preferred Location</th>
                                                                            <th>Staffing Agency</th>
                                                                            <th>Approval Status</th>
                                                                            <th>Approval Comments</th>

                                                                            <th>Final Selection Status</th>
                                                                            <th>Final Selection Comments</th>
                                                                        </tr>
                                                                        <tr>
                                                                            <td> @item.currentEmployerName </td>
                                                                            <td> @item.expectedPerHourRate </td>
                                                                            <td> @item.joiningTime </td>
                                                                            <td> @item.preferredLocation </td>
                                                                            <td>@item.staffingAgency</td>
                                                                            <td>
                                                                                @item.NextLevelApprovalStat
                                                                            </td>





                                                                            <td class="interview-com">
                                                                                <div id="section">
                                                                                    @if (item.ApprovalComments != null && item.ApprovalComments != "")
                                                                                    {
                                                                                        @if (item.ApprovalComments.Length > 40)
                                                                                        {
                                                                                            <div class="article">
                                                                                                <p style="margin-bottom:0px;">
                                                                                                    @item.ApprovalComments.Substring(0, 40)
                                                                                                </p>
                                                                                                <p class="moretext_@item.imid moretext">
                                                                                                    @item.ApprovalComments.Substring(40, @item.ApprovalComments.Length - 40)
                                                                                                </p>
                                                                                            </div>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <div class="article">

                                                                                                <p>
                                                                                                    @item.ApprovalComments.Substring(0, @item.ApprovalComments.Length - 1)
                                                                                                </p>
                                                                                            </div>
                                                                                        }}
                                                                                    else
                                                                                    { <div></div>}







                                                                                    <a onclick="moreless(@item.imid)" class="moreless-button" value="Readmore" id="read_@item.imid" href="#">Read more</a>


                                                                                </div>

                                                                            </td>








                                                                            <td>
                                                                                @item.FinalSelectionStat
                                                                            </td>





                                                                            <td class="interview-com">
                                                                                <div id="section">
                                                                                    @if (item.FinalComments != null && item.FinalComments != "")
                                                                                    {
                                                                                        @if (item.FinalComments.Length > 40)
                                                                                        {
                                                                                            <div class="article">
                                                                                                <p style="margin-bottom:0px;">
                                                                                                    @item.FinalComments.Substring(0, 40)
                                                                                                </p>
                                                                                                <p class="moretext_@item.imid moretext">
                                                                                                    @item.FinalComments.Substring(40, @item.FinalComments.Length - 40)
                                                                                                </p>
                                                                                            </div>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <div class="article">

                                                                                                <p>
                                                                                                    @item.FinalComments.Substring(0, @item.FinalComments.Length - 1)
                                                                                                </p>
                                                                                            </div>
                                                                                        }}
                                                                                    else
                                                                                    { <div></div>}







                                                                                    <a onclick="moreless(@item.imid)" class="moreless-button" value="Readmore" id="read_@item.imid" href="#">Read more</a>


                                                                                </div>

                                                                            </td>





                                                                        </tr>
                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right " id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("SelectedInterviewMeetings", new { Page = Page, id = ViewBag.IRFId }))
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>


                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">


                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">

                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left">Client Feedback </h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="feedbackPopUp" style="cursor:pointer;">&times;</span>
                    </button>




                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">
                                    <label class="control-label" for="approveDropdown">Approved For Next Round</label>
                                    <select class="form-control" id="approveDropdown" name="approveDropdown"></select>
                                </div>

                            </div>

                            <div class="col-md-6 col-sm-6 ">
                                <div id="approvalComments" class="form-group">
                                    <label class="control-label" style="display:block">Approval Comments</label>

                                    <div class="talk-bubble tri-right border-bubble right-in">
                                        <div class="talktext">
                                            <textarea name="appComments" class="form-control text-box single-line scrollbar" id="appComments" style="height:35px"></textarea>

                                        </div>
                                    </div>
                                </div>
