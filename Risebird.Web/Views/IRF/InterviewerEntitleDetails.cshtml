@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.AssignmentVM>
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using X.PagedList.Mvc.Core;
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interviewer.css?v=8" />
<link href="~/Newassets/css/risetube.css?v=6" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Assessment Market Place</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->



    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Assessment Group</h4></div>
                </div>

                <div class="pull-right">
                    <div>

                        <div class="newsletter card-title-space">
                            <div class="content">
                                <div class="input-group" id="myForm">
                                    @*<div class="searchbox">
                                            <input id="searchinput" type="text" class="form-control txtsearch1" placeholder="Please enter Assessment Group name" value="@ViewBag.searchvalue">
                                            <span class="input-group-btn" id="searchGo">
                                                <button class="btn btn3" id="btnSearch" value="Search" type="submit"><svg style="fill: #fff;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path></svg></button>
                                            </span>

                                        </div>*@
                                </div>
                            </div>
                        </div>

                        @*<button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add IRF" onclick="AddIRF()" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Create Skill Channel </font></span></button>*@
                        <a href="/IRF/InterviewerEntitle" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space"><span class="fa fa-chevron-left"></span> Back to List</a>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client assesment">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">

                    <div class="mdc-card-wrapper__text-section">



                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div style="clear:both;padding:10px"></div>
                            <div class="row">
                                @foreach (var item in Model)
                                {
                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                    <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                        <div class="card-content-holder border card-blue">
                                            <div class="card-header">
                                                <div class="row">
                                                    <div class="col-md-5 col-sm-5 card-header-buttons action">
                                                        @if (item.AssessmentGroup.Length > 11)
                                                        {
                                                            <h6 class="assessment-grp"><a title="@item.AssessmentGroup" style=" cursor: pointer;" href="@Url.Action("AssessmentDetails","IRF",new { id=item.id})"><span class="candidate-name candidate">@item.AssessmentGroup</span></a></h6>
                                                        }
                                                        else
                                                        {
                                                            <h6 class="assessment-grp"><a href="@Url.Action("AssessmentDetails","IRF",new { id=item.id})">@item.AssessmentGroup</a></h6>
                                                        }

                                                    </div>
                                                    <div class="col-md-7 col-sm-7 card-header-buttons action text-right">
                                                        Seniority Level: @item.Seniority
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- irf body-->
                                            <div class="card-body">


                                                <div class="statusInfo" style="max-width:100%">
                                                    <div class="group inner">
                                                        @if (item.AssessmentGroup.Length > 60)
                                                        {
                                                            <p title="@item.Overview"><span class="candidate-overview candidate"> @item.Overview</span></p>
                                                        }
                                                        else
                                                        {
                                                    <p>@item.Overview</p>
                                                        }

                                                        <p><b>Tested Skills:</b> @item.TestedSkill</p>
                                                        <p><b>Difficulty Level:</b> @item.Difficultylevel</p>
                                                    </div>
                                                </div>


                                            </div>



                                        </div>
                                    </div>
                                }
                            </div>
                            <div style="clear:both"></div>

                            @Html.PagedListPager(Model, Page => Url.Action("InterviewerEntitleDetails", new { Page = Page }))
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<div id="myModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Call Interviewer !</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
            </button>



            <div class="modal-body">

                <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>

                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">
            </div>

        </div>

    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>
<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>
<script type="text/javascript">
    //// script for loader starts here
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
        $("#btnSearch").on('click', function () {
            var value = $("#searchinput").val();
            window.location.href = "/IRF/InterviewerDetail?Searchvalue=" + value;
        });
    });
    var flag = true;
    function callingfunction(value) {
        if (flag == true) {
            window.location.href = "/IRF/InterviewerDetailById?Id=" + value;
        } else {
            flag = true;
        }
    }
    function callatag() {
        flag = false;
    }
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        //  phoneNumber = '+918126991790';
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function ModalButtonClick(candidateObj) {
        //flag = false;
        candidate = candidateObj.candidateName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(candidateObj.MobileNumber);
    }

    function AddIRF() {
        var array = [];

        $("input:checkbox[name=chkinterviewer]:checked").each(function () {
            array.push($(this).val());
        });
        if (array.length > 0) {
            window.location.href = "/IRF/Add?IntrviewerId=" + array.toString();

        }
        else {
            alert("Please Select atleast one Interviewer.");
        }
    }

    $(document).ready(function () {
        $(".candidate-name").each(function () {
            if ($(this).text().length > 11) {
                $(this).text($(this).text().substr(0, 11) + "...")
            }
        });
        $(".candidate-overview").each(function () {
            if ($(this).text().length > 60) {
                $(this).text($(this).text().substr(0, 60) + "...")
            }
        });
    });
</script>
