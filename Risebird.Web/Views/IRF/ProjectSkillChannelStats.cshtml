                                                                        }%
                                                                        }
                                                                    </a>
                                                                </td>
                                                            }
                                                            <td><span class="count">@item.PendingCount</span> </td>
                                                            <td style="color:#2680c7;cursor:pointer">
                                                                <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="ColdCandidate",uniqueid=ViewBag.uniqueid })'>
                                                                    @item.ColdCandidateCount
                                                                    { @if (item.CandidateCount > 0)
                                                                    {
