                                                                            @((item.RejectedMeetings * 100) / @item.CompletedInterviews)
                                                                        }%
                                                                        }
                                                                    </a>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td style="color:#2680c7;cursor:pointer">
                                                                    <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="Selected",uniqueid=ViewBag.uniqueid })'>
                                                                        @item.SelectedMeetings
                                                                        { @if (item.CompletedInterviews > 0)
