                                                                            @((item.SelectedMeetings * 100) / @item.CompletedInterviews)
                                                                        }%
                                                                        }
                                                                    </a>
                                                                </td>
                                                                <td style="color:#2680c7;cursor:pointer">
                                                                    <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="Rejected",uniqueid=ViewBag.uniqueid })'>
                                                                        @item.RejectedMeetings
                                                                        { @if (item.CompletedInterviews > 0)
                                                                        {
                                                                            @((item.RejectedMeetings * 100) / @item.CompletedInterviews)
                                                                        }%
                                                                        }
                                                                    </a>
                                                                </td>
                                                                <td style="color:#2680c7;cursor:pointer">
                                                                    <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="SelectedNRejected",uniqueid=ViewBag.uniqueid })'>
                                                                        @item.SelectedRejectMeetings
                                                                        { @if (item.CompletedInterviews > 0)
                                                                        {
                                                                            @((item.SelectedRejectMeetings * 100) / @item.CompletedInterviews)
                                                                        }%
                                                                        }
                                                                    </a>
                                                                </td>
                                                                <td style="color:#2680c7;cursor:pointer">
                                                                    <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="RejectedNSelected",uniqueid=ViewBag.uniqueid })'>
