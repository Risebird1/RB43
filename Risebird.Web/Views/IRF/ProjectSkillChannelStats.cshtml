<script>
    function interviewstatuslistdetails(projectid, projectname, type) {
        $.ajax({
            type: "POST",
            url: "/IRF/ProjectSkillChannelStatsDetailedView",
            data: { irfid: projectid, irfname: projectname, type: type },
            success: function (data) {
                $("#divInterviewdetailsView").html('');
                $("#divInterviewdetailsView").html(data);
            }
        });
    }
    function Changeurldetails(type, emailid, uniqueid, isclient) {
        window.location.href = "/IRF/ProjectSkillChannelStats?tabtype=" + type + "&emailid=" + emailid + "&isClientLogin=" + isclient + "&uniqueid=" + uniqueid;
    }
</script>
