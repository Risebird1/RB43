                                                            <td style="color:#2680c7">
                                                                <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="Futureschedule",uniqueid=ViewBag.uniqueid })'>
