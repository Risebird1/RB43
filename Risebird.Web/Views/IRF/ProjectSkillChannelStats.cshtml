                                                        <th>Both Selected</th>
                                                        <th>Both Rejected</th>
                                                        <th>Primary Select Secondary Reject</th>
                                                        <th>Primary Reject Secondary Select</th>
                                                    }
                                                    <th>Report Pending</th>
                                                    <th>Cold Candidate</th>
                                                    <th>Not Scheduled Count</th>
                                                    <th>Rescheduled Count</th>
                                                    <th>Future Scheduled Count</th>
                                                </tr>
                                            </thead>
