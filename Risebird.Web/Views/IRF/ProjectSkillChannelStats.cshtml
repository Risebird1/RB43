                                                            </td>
                                                            <td style="color:#2680c7;cursor:pointer">
                                                                <a target="_blank" href='@Url.Action("ProjectSkillChannelStatsDetailedView", "IRF", new { projectid=item.id,projectname=item.ProjectName,type="NotScheduled",uniqueid=ViewBag.uniqueid })'>
                                                                    @item.NotScheduledCount
