@model Risebird.Entities.ViewModel.IRFVm

@{
    ViewData["Title"] = "Add IRF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .table-responsive {
        overflow: hidden;
    }
</style>

<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>





<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Interview Request Forms</a>
                <a class="navbar-brand">Add IRF</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>           
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Add IRF</h4>
                    </div>
                    <div class="card-body">
                        @*<form action="/IRF/AddIRF" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">*@

                        @using (Html.BeginForm("AddIRF", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "irfForm", @onsubmit = "return CheckTotalWeightage()" }))
                        {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="row">

                            <div class="col-md-3 col-sm-3 pr-1">
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IRFId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                    @*<label class="control-label col-md-4 col-sm-2 desp-label" for="irfid">irf id</label>*@

                                    @Html.EditorFor(model => model.IRFId, new { htmlAttributes = new { @class = "form-control text-box single-line", @onblur = "checkUniqueness(this.value)" } })
                                    <label class="text-danger" id="uniqueMsg" style="color:red"></label>
                                    @Html.ValidationMessageFor(model => model.IRFId, "", new { @class = "text-danger" })
                                    @*<input class="form-control text-box single-line" id="IRFId" name="IRFId" type="text" value="">*@

                                </div>
                            </div>
