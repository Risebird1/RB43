<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("JDLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("JDFile").value = '';

        }

    }



    function CheckTotalWeightage() {
        
        //var ckeck = $("#irfForm").validate();
        var inCorrectCount = 0;
        var skillArray = ["SkillCollection", "Joinability", "Selectability", "SkillGeneral"];

        for (i = 0; i < skillArray.length; i++) {
            var items = $('[id^=' + skillArray[i] + '][id$="Weightage"]');
            var total = 0;
            for (j = 0; j < items.length; j++) {
                var total = total + parseInt($("#" + items[j].id).val());
            }
            if (total != 100) {
                inCorrectCount = inCorrectCount + 1;
                // Label should be populated here
                document.getElementById(skillArray[i] + "_WeightageError").innerHTML = "Weightage total should be equal to 100.";
                if (skillArray[i] == "SkillCollection") {
                    var labelName = "Tech Skills";
                }
                else if (skillArray[i] == "SkillGeneral") {
                    var labelName = "General Skills";
                }
                else {
                    var labelName = skillArray[i];
                }
                document.getElementById(skillArray[i] + "_WeightageErrorDown").innerHTML = "Weightage total for " + labelName + " should be equal to 100.";


            }
            else {
                document.getElementById(skillArray[i] + "_WeightageError").innerHTML = "";
                document.getElementById(skillArray[i] + "_WeightageErrorDown").innerHTML = "";

            }

        }

        if (inCorrectCount == 0) {
            // check interviewers list InterviewerCollection_  UserId
            var drpdowns = $('[id^="InterviewerCollection"][id$="UserId"]');
            for (i = 0; i < drpdowns.length; i++) {
                
                var interviewId = $("#" + drpdowns[i].id).val();
                if (interviewId == '') {
                    //noInterviewer
                    document.getElementById("noInterviewer").innerHTML = "There should be atleast one Interviewer.";
                    document.getElementById("noInterviewerDown").innerHTML = "There should be atleast one Interviewer.";
                    
                    return false;
                }
            }
            document.getElementById("noInterviewer").innerHTML = "";
            document.getElementById("noInterviewerDown").innerHTML = "";

            return true;
        }
        else {
            var drpdowns = $('[id^="InterviewerCollection"][id$="UserId"]');
            for (i = 0; i < drpdowns.length; i++) {

                var interviewId = $("#" + drpdowns[i].id).val();
                if (interviewId == '') {
                    //noInterviewer
                    document.getElementById("noInterviewer").innerHTML = "There should be atleast one Interviewer.";
                    document.getElementById("noInterviewerDown").innerHTML = "There should be atleast one Interviewer.";
                    break;
                   
                }
                document.getElementById("noInterviewer").innerHTML = "";
                document.getElementById("noInterviewerDown").innerHTML = "";
            }
            return false;
        }

        
    }


    function ClientChanged(clientId) {
        
        $.ajax({
            type: "GET",
            url: "/IRF/GetClientUser",
            data: { 'clientId': clientId },
            success: function (data) {
                

                var drpdwnId = $("#ClientCollection_0__ClientUserId");
                //drpdwnId.options.length = 0;
                $("#ClientCollection_0__ClientUserId option").remove();
                
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");

                        //Set Text part.
                        option.html(this.text);

                        //Set Value part.
                        option.val(this.value);

                        //Add the Option element to DropDownList.
                        drpdwnId.append(option);
                    });
                }
                
                
            }
        });

    }

    function TechSkillChanged() {
        
        //var index = id.charAt(16);
        var techSkills = $('[id^="SkillCollection"][id$="SkillId"]');
        //var arr = [];
        var skills ="";
        for (i = 0; i < techSkills.length; i++) {
            //arr.push(techSkills[i].value);
            skills = skills + ',' + techSkills[i].value;
        }
        $.ajax({
            type: "GET",
            url: "/IRF/GetInterviewers",
            data: { 'skills': skills },
            success: function (data) {

                var drpdowns = $('[id^="InterviewerCollection"][id$="UserId"]');
                for (i = 0; i < drpdowns.length; i++) {
                    $("#" + drpdowns[i].id+" option").remove();
                }

                var drpdownsEI = $('[id^="EmergencyInterviewerCollection"][id$="UserId"]');
                for (i = 0; i < drpdownsEI.length; i++) {
                    $("#" + drpdownsEI[i].id + " option").remove();
                }

                var drpdownsQC = $('[id^="QualityController"][id$="UserId"]');
                for (i = 0; i < drpdownsQC.length; i++) {
                    $("#" + drpdownsQC[i].id + " option").remove();
                }
               
                if (data.length > 0) {

                    for (i = 0; i < drpdowns.length; i++) {
                        //$("#" + drpdowns[i].id).append(option);


                        $(data).each(function () {
                            var option = $("<option />");

                            //Set Text part.
                            option.html(this.text);

                            //Set Value part.
                            option.val(this.value);

                            //Add the Option element to DropDownList.
                            
                            $("#" + drpdowns[i].id).append(option);
                            
                            InterviewerChanged(drpdowns[i].value, drpdowns[i].id);   
                            
                            //drpdwnId.append(option);
                        });
                    }
                    for (i = 0; i < drpdownsEI.length; i++) {
                        //$("#" + drpdowns[i].id).append(option);


                        $(data).each(function () {
                            var option = $("<option />");

                            //Set Text part.
                            option.html(this.text);

                            //Set Value part.
                            option.val(this.value);

                            //Add the Option element to DropDownList.

                            $("#" + drpdownsEI[i].id).append(option);

                            EmergencyInterviewerChanged(drpdownsEI[i].value, drpdownsEI[i].id);

                            //drpdwnId.append(option);
                        });
                    }

                    for (i = 0; i < drpdownsQC.length; i++) {
                        //$("#" + drpdowns[i].id).append(option);


                        $(data).each(function () {
                            var option = $("<option />");

                            //Set Text part.
                            option.html(this.text);

                            //Set Value part.
                            option.val(this.value);

                            //Add the Option element to DropDownList.

                            $("#" + drpdownsQC[i].id).append(option);

                            QCChanged(drpdownsQC[i].value, drpdownsQC[i].id);

                            //drpdwnId.append(option);
                        });
                    }


                   
                }


            }
        });

    }

    function checkStartDate(val) {

        if (val == "") {
            document.getElementById("startDateCheck").innerHTML = "";
            return;
        }
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var StartDate = new Date(year, month, date);
        

        var d = new Date();
        var currentDate = new Date(d.getFullYear(), d.getMonth(), d.getDate());
        if (StartDate < currentDate) {
            document.getElementById("btnUpload").disabled = true;
            document.getElementById("startDateCheck").style.display = "block";
            document.getElementById("startDateCheck").innerHTML = "Start Date should be greater than or equal to Current Date";
            document.getElementById("StartDate").focus();
            return;
        }
        else {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("btnUpload").disabled = false;
            
        }
        if (document.getElementById("EndDate").value != "") {
            checkEndDate(document.getElementById("EndDate").value);
        }
        
    }

    function checkEndDate(val) {
      
        if (val == "") {
            return;
        }
        var startDateValue = document.getElementById("StartDate").value;
        
        //end Date object creation
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var endDate = new Date(year, month, date);

        //start Date object creation
        
        if (startDateValue == "") {
            document.getElementById("endDateCheck").style.display = "block";
            document.getElementById("endDateCheck").innerHTML = "Kindly fill the Start Date field.";
            document.getElementById("StartDate").focus();
            return;
        }
        var yearStart = startDateValue.substring(0, 4);
        var monthStart = parseInt(startDateValue.substring(5, 7)) - 1;
        var dateStart = startDateValue.substring(8, 10);
        var startDate = new Date(yearStart, monthStart, dateStart);

        
        if (endDate <= startDate) {
            document.getElementById("btnUpload").disabled = true;
            document.getElementById("endDateCheck").style.display = "block";
            document.getElementById("endDateCheck").innerHTML = "End Date should be greater than Start Date";
            document.getElementById("EndDate").focus();
            return;
        }
        else {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("btnUpload").disabled = false;
            return;
        }

    }

    //checkUniqueness(this.value)
    function checkUniqueness(val) {
     
        if (val == "") {
            return;
        }
        else {

            $.ajax({
                type: "GET",
                url: "/IRF/CheckUniqueness",
                data: { 'value': val },
                success: function (response) {
                    if (response == false) {
                        document.getElementById("btnUpload").disabled = true;
                        document.getElementById("uniqueMsg").innerHTML = "This IRFId already exists. Kindly enter a different IRFId.";
                        document.getElementById("IRFId").focus();
                        return;
                    }
                    else {
                        document.getElementById("uniqueMsg").innerHTML = "";
                        document.getElementById("btnUpload").disabled = false;
                        return;
                    }
                        
                }
            });
        }
    }

    function AddRow() {
        document.getElementById("btnUpload").disabled = false;

        var table = document.getElementById("SkillTable");
        var rowCount = table.rows.length;
        //if (rowCount == 6) {
        //    alert("Cannot add more than 5 Tech Skills.");
        //    return;
        //}

