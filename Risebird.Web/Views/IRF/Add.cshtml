                                        @Html.EditorFor(model => model.NoOfIntterview, new { htmlAttributes = new { @class = "input form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.NoOfIntterview, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                        @*<input class="form-control text-box single-line" id="NoOfIntterview" name="NoOfIntterview" type="number" value="">*@

                                    </div>
                                    <div class="form-group">
                                        Upload Company Details
