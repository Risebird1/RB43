    function CheckConditions() {
        return CheckTotalWeightage() && checkUniqueness();
    }


    function CheckTotalWeightage() {

        //var ckeck = $("#irfForm").validate();
        var inCorrectCount = 0;
        var skillArray = ["SkillCollection", "Joinability", "Selectability", "SkillGeneral"];

        for (i = 0; i < skillArray.length; i++) {
            var items = $('[id^=' + skillArray[i] + '][id$="Weightage"]');
            var total = 0;
            for (j = 0; j < items.length; j++) {
                var total = total + parseInt($("#" + items[j].id).val());
            }
            if (total != 100) {
                inCorrectCount = inCorrectCount + 1;
                // Label should be populated here
                document.getElementById(skillArray[i] + "_WeightageError").innerHTML = "Weightage total should be equal to 100.";
                if (skillArray[i] == "SkillCollection") {
                    var labelName = "Tech Skills";
                }
                else if (skillArray[i] == "SkillGeneral") {
                    var labelName = "General Skills";
                }
                else {
                    var labelName = skillArray[i];
                }
                document.getElementById(skillArray[i] + "_WeightageErrorDown").innerHTML = "Weightage total for " + labelName + " should be equal to 100.";


            }
            else {
                document.getElementById(skillArray[i] + "_WeightageError").innerHTML = "";
                document.getElementById(skillArray[i] + "_WeightageErrorDown").innerHTML = "";

            }

        }
        var message = "";
        var newflag = false;
        var table = document.getElementById("InterviewerTable");
        var rowCount = table.rows.length;
        for (var i = 0; i < rowCount; i++) {
            if ($("#InterviewerCollection_" + i + "__PerInterviewerRate").val() == "") {
                if (message == "") {
                    message = "Per Interviewer Rate should not be blank";
                } else {
                    message = message + ",Per Interviewer Rate should not be blank";
                }
                newflag = true;
                break;
            }
        }
        var emetable = document.getElementById("EmergencyInterviewerTable");
        var emerowCount = emetable.rows.length;
        for (var i = 0; i < emerowCount; i++) {
            if ($("#EmergencyInterviewerCollection_" + i + "__PerEIRate").val() == "") {
                if (message == "") {
                    message = "Per Emergency Interviewer Rate should not be blank";
                } else {
                    message = message + ", Per Emergency Interviewer Rate should not be blank";
                }
                newflag = true;
                break;
            }
        }
        var qctable = document.getElementById("EmergencyInterviewerTable");
        var qcrowCount = qctable.rows.length;
        for (var i = 0; i < qcrowCount; i++) {
            if ($("#QualityController_" + i + "__PerQCRate").val() == "") {
                if (message == "") {
                    message = "Per QC Rate should not be blank";
                } else {
                    message = message + ", Per QC Rate should not be blank";
                }
                newflag = true;
                break;
            }
        }
        if (newflag == true) {
            alert(message);
            return false;
        }
        if (inCorrectCount == 0) {
            // check interviewers list InterviewerCollection_  UserId
