    function BindSkillsAndRate(id, data, rateElementId = null, rate = null) {
        var num = id.match(/(\d+)/);
        var index = num[0];
        var idArray = id.split('_');
        var skillElementid = idArray[0] + '_' + index + '__PrimarySkill';
        $("#" + skillElementid).val(data);
        if (rate != null && rateElementId != null) {
            $("#" + rateElementId).val(rate);

        }
    }

    function CheckDuplicate(idInitials, searchFor, value, currentIndex) {
        var users = $(searchFor);
        if (users != null) {
            for (i = 0; i < users.length; i++) {


                if (i != parseInt(currentIndex)) {
                    var elementId = idInitials + '_' + i + '__UserId';
                    userId = document.getElementById(elementId).value;
                    if (parseInt(userId) == parseInt(value)) {
                        //duplicate
                        alert("This user is already added to this list! Kindly choose another user.");
                        document.getElementById(idInitials + '_' + currentIndex + '__UserId').value = "";
                        document.getElementById(idInitials + '_' + currentIndex + '__PrimarySkill').value = "";
                        document.getElementById(idInitials + '_' + currentIndex + '__PerSuccessRate').value = "";
                        return true;
                    }
                }

            }
        }
        return false;
    }

    function InterviewerChanged(val, id) {
        var index = id.split('_')[1];
        var searchFor = '[id^="InterviewerCollection"][id$="UserId"]';
        if (CheckDuplicate('InterviewerCollection', searchFor, val, index)) {
            return;
        }
        var skillElementid = 'InterviewerCollection_' + index + '__PrimarySkill';
        var rateElementid = 'InterviewerCollection_' + index + '__PerSuccessRate';
        var companyType = $("#CompanyType").val();
        var countryType = $("#JobCountry").val();


        $.ajax({
            type: "GET",
            url: "/IRF/GetInterviewerSkills",
            data: { 'id': val },
            success: function (data) {
                $("#" + skillElementid).val(data);
            }
