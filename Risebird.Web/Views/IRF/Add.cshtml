                                        Provide Company Details
                                        <input id="companydetails" name="companydetails" value="Link" type="radio" onclick="RadioCompanyChanged(this.value)">
                                    </div>
                                    <div class="form-group" style="display:none" id="linkcdDiv">
                                        @Html.LabelFor(model => model.CompanyDetails, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.CompanyDetails, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.CompanyDetails, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="" style="display:none" id="uploadcdDiv">
                                        @Html.LabelFor(model => model.CompanyDetailFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.CompanyDetailFile, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt, .pptx" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pl-1">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PerMintuteRate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="PerMintuteRate">Per Mintute Rate(Rs.)</label>*@

                                        @Html.EditorFor(model => model.PerMintuteRate, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number", @min = "1" } })
                                        @Html.ValidationMessageFor(model => model.PerMintuteRate, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                        @*<input class="form-control text-box single-line" id="PerMintuteRate" name="PerMintuteRate" type="number" step="0.01" value="">*@

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.TotalBudget, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="PerMintuteRate">Per Mintute Rate(Rs.)</label>*@

                                        @Html.EditorFor(model => model.TotalBudget, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number", @min = "1" } })
                                        @Html.ValidationMessageFor(model => model.TotalBudget, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                        @*<input class="form-control text-box single-line" id="PerMintuteRate" name="PerMintuteRate" type="number" step="0.01" value="">*@

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RisebirdHr, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="RisebirdHr">Risebird HR</label>*@

                                        @Html.DropDownList("RisebirdHr", (SelectList)ViewBag.RiseBirdHR, new { @class = "select-css form-control" })
                                        @Html.ValidationMessageFor(model => model.RisebirdHr, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.JobLevel, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="RisebirdHr">Risebird HR</label>*@

                                        @Html.DropDownList("JobLevel", (SelectList)ViewBag.JobLevelList, new { @class = "select-css form-control" })
                                        @Html.ValidationMessageFor(model => model.RisebirdHr, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        Upload JD


                                        <div class="mdc-touch-target-wrapper" style="top: 4px;
    position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Upload" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>


                                        Provide JD Link



                                        <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Link" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>


                                    </div>
                                    <div class="form-group" style="display:none" id="linkDiv">
                                        @Html.LabelFor(model => model.JDLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.JDLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.JDLink, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="" style="display:none" id="uploadDiv">
                                        @Html.LabelFor(model => model.JDFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.JDFile, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })

                                    </div>

                                </div>
                            </div>



