                                                <svg class="mdc-checkbox__checkmark"
                                                     viewBox="0 0 24 24">
                                                    <path class="mdc-checkbox__checkmark-path"
                                                          fill="none"
                                                          d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                </svg>
                                                <div class="mdc-checkbox__mixedmark"></div>
                                            </div>
                                            <div class="mdc-checkbox__ripple"></div>


                                        </div>
                                        @Html.LabelFor(model => model.IsBiometricEnabled, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "font-size: 13px; " })
                                    </div>


                                </div>

                            </div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2 style="margin-top:0px;">Job Details</h2>
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.JDTiltle, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="name">jd title</label>*@

                                        @Html.EditorFor(model => model.JDTiltle, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.JDTiltle, "", new { @class = "text-danger" })

                                        @*<input class="form-control text-box single-line" id="JDTiltle" name="JDTiltle" type="text" value="">*@


                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CompanyType, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="companytype">companytype</label>*@
                                        @Html.DropDownList("CompanyType[0].Type", (SelectList)Model.CompanyTypeList, new { @class = "select-css form-control text-box single-line" })


                                        @Html.ValidationMessageFor(model => model.CompanyType, "", new { @class = "text-danger" })


                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ClientName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.ClientName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.ClientName, "", new { @class = "text-danger" })


                                    </div>
                                    <div class="form-group">
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="JobCountry">Job Country</label>*@
                                        @Html.LabelFor(model => model.JobCountry, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.JobCountry, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                        @*<input class="form-control text-box single-line" id="JobCountry" name="JobCountry" type="text">*@
                                        @Html.ValidationMessageFor(model => model.JobCountry, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 px-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control text-box single-line", @Value = Model.StartDate.ToString("dd/MM/yyyy"), @onblur = "checkStartDate(this.value)" } })
                                        <label class="text-danger col-lg-12 col-md-12 col-sm-12 col-xs-12" id="startDateCheck" style="display:none;"></label>
                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })

                                        @*<input class="form-control text-box single-line" id="StartDate" name="StartDate" type="date" value="">*@

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EndDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "form-control text-box single-line", @Value = Model.EndDate.ToString("dd/MM/yyyy"), @onblur = "checkEndDate(this.value)" } })

                                        <label class="text-danger col-lg-12 col-md-12 col-sm-12 col-xs-12" id="endDateCheck" style="display:none;"></label>
                                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })

                                        @*<input class="form-control text-box single-line" id="EndDate" name="EndDate" type="date" value="">*@

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NoOfPosition, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

