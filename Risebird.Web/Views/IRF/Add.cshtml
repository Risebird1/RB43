@model Risebird.Entities.ViewModel.IRFVm

@{
    ViewData["Title"] = "Add Skills Channel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}






<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a class="navbar-brand">Add Skills Channel</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        @*<form action="/IRF/AddIRF" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">*@

                        @using (Html.BeginForm("AddIRF", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "irfForm", @onsubmit = "return CheckTotalWeightage()" }))
                        {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="row">


                                <div class="card-header">
                                    <h4 class="card-title">Add Skills Channel</h4>
                                </div>

                                <div style="width: 100%;">&nbsp;</div>

                                <div class="col-md-3 col-sm-3 pr-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.IRFId, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @*<label class="control-label col-md-4 col-sm-2 desp-label" for="irfid">irf id</label>*@

                                        @Html.EditorFor(model => model.IRFId, new { htmlAttributes = new { @class = "form-control text-box single-line", @onblur = "checkUniqueness(this.value)" } })
                                        <label class="text-danger" id="uniqueMsg" style="color:red"></label>
                                        @Html.ValidationMessageFor(model => model.IRFId, "", new { @class = "text-danger" })
                                        @*<input class="form-control text-box single-line" id="IRFId" name="IRFId" type="text" value="">*@

                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 px-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="Name">Client Name</label>
                                        @Html.DropDownList("ClientId", (SelectList)ViewBag.Clients, new { @class = "select-css form-control", @onchange = "ClientChanged(this.value)" })
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 px-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.CalendlyLink, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.CalendlyLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.CalendlyLink, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-md-3 col-sm-3 pl-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.PriorityLevel, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownList("PriorityLevel", Model.PriorityLevelList, new { @class = "select-css form-control" })

                                    </div>
                                </div>
                            </div>
                            <div class="row">



                                <div class="col-md-12 col-sm-12">

                                    <div class="mdc-form-field" style="margin-bottom: 10px;">


