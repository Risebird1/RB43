                                        @Html.EditorFor(model => model.PerMintuteRate, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @min = "1" } })
                                        @Html.ValidationMessageFor(model => model.PerMintuteRate, "", new { @class = "text-danger" })

                                        @*<input class="form-control text-box single-line" id="PerMintuteRate" name="PerMintuteRate" type="number" step="0.01" value="">*@

                                    </div>
