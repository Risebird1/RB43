                                                        </button>


                                                    </td>
                                                </tr>

                                            </tbody>
                                        </table>
                                        <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:815px"></label>

                                    </div>
                                </div>

                            </div>



                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Joinability Metric</h2>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive-sm">
                                        <table class="table table-bordered mbn" id="JoinabilityTable">
                                            <thead>
                                                <tr>

                                                    <th width="15%" class="table_heading">Level</th>
                                                    <th width="25%" class="table_heading">Type</th>
                                                    <th width="40%" class="table_heading">Value</th>
                                                    <th width="10%" class="table_heading">Weightage</th>
                                                    <th width="10%" class="table_heading text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                <tr>
                                                    <td>
                                                        @Html.DropDownList("Joinability[0].LevelId", (SelectList)ViewBag.Level, new { @class = "select-css form-control" })

                                                    </td>
                                                    <td>
                                                        @Html.DropDownList("Joinability[0].Type", (SelectList)Model.JoinabilityTypeList, new { @class = "select-css form-control" })


                                                    </td>
                                                    <td>
                                                        <input class="form-control text-box single-line" id="Joinability_0__Value" name="Joinability[0].Value" type="text" value="">
