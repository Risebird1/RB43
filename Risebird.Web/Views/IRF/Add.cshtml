                                        @Html.DropDownList("CompanyType[0].Type", (SelectList)Model.CompanyTypeList, new { @class = "form-control text-box single-line" })

                                        
                                        @Html.ValidationMessageFor(model => model.CompanyType, "", new { @class = "text-danger" })


