    $(document).ready(function () {

        TechSkillChanged();
        //Perform Ajax request.
       
        var id = $("#InterviewerCollection_0__UserId").val();
        $.ajax({
            type: "GET",
            url: "/IRF/GetInterviewerSkills",
            data: { 'id': id },
            success: function (data) {
                $("#InterviewerCollection_0__SkillId").val(data);
                $("#QualityController_0__SkillId").val(data);
                $("#EmergencyInterviewerCollection_0__SkillId").val(data);

            }
        });

        var userId = $("#RecruiterCollection_0__UserId").val();
        $.ajax({
            type: "GET",
            url: "/IRF/GetRecruiterDomain",
            data: { 'userId': userId },
            success: function (data) {
                $("#RecruiterCollection_0__Domain").val(data);               

            }
        });
       
        //Get Client Users based on clietn ID
        var clientId = $("#ClientId").val();
        $.ajax({
            type: "GET",
            url: "/IRF/GetClientUser",
            data: { 'clientId': clientId },
            success: function (data) {


                var drpdwnId = $("#ClientCollection_0__ClientUserId");
                //drpdwnId.options.length = 0;
                $("#ClientCollection_0__ClientUserId option").remove();

                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");

                        //Set Text part.
                        option.html(this.text);

                        //Set Value part.
                        option.val(this.value);

                        //Add the Option element to DropDownList.
                        drpdwnId.append(option);
                    });
                }


            }
        });

        //Get Client Role based on Client User Id
        var id = $("#ClientCollection_0__ClientUserId").val();
        $.ajax({
            type: "GET",
            url: "/IRF/GetClientUserRole",
            data: { 'id': id },
            success: function (data) {
                $("#ClientCollection_0__ClientRoleId").val(data);
            }
        });

    });

    

