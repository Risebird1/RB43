<script>

    $('#IsJoinabilitySelectabilityRequired').on('change', function () {
        CheckJoinabilitySelectabilityRequired()
    });

    function CheckJoinabilitySelectabilityRequired() {
        var value = document.getElementById("IsJoinabilitySelectabilityRequired").checked;
        if (value) {
            document.getElementById("li_joinability").style.display = "block";
            document.getElementById("li_selectability").style.display = "block";
            document.getElementById('rtab-4').style.display = "block";
            document.getElementById('rtab-5').style.display = "block";
            document.getElementById('count_Joinability').style.display = "block";
            document.getElementById('count_Selectability').style.display = "block";
        }
        else {
            document.getElementById("li_joinability").style.display = "none";
            document.getElementById("li_selectability").style.display = "none";
            document.getElementById('rtab-4').style.display = "none";
            document.getElementById('rtab-5').style.display = "none";
            document.getElementById('count_Joinability').style.display = "none";
            document.getElementById('count_Selectability').style.display = "none";
        }
    }

