                    </div>

                    <div class="card-body">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="row">
                                    @*<div class="col-md-3 ml-md-auto">
            <div class="form-group">
                @Html.DropDownList("list", ViewData["list"] as SelectList, new { @class = "form-control", onchange = "FilterInterviews(this.value);" })
            </div>
        </div>*@
                                    <div class="col-auto pull-right" style="margin-left:925px">
                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;"><span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Click here to add Candidates from an excel file." onclick="location.href='@Url.Action("ImportCandidates", "IRF")'" data-original-title="Tooltip on top"> Add Candidates</span></button>
                                    
                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add a Candidate." onclick="location.href='@Url.Action("AddCandidate", "IRF", new { irfId = ViewBag.IRFId, irfName = ViewBag.IRFName})'" data-original-title="Tooltip on top"> Add Candidate</span></button>
                                    </div>


                                </div>

                            </div>
