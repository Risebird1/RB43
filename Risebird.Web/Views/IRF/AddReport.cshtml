                                            {
                                                @*if (Url.Content(Model.VideoLink).Contains(".mp4") || Url.Content(Model.VideoLink).Contains(".org"))
                                            {
                                            <video width="320" height="320" style="width:100%" controls class="vjs-tech" controlsList="nodownload">
