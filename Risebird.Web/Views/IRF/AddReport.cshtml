@model Risebird.Entities.ViewModel.InterviewReport

@using Microsoft.Extensions.Configuration;

@inject IConfiguration configuration

@{
    ViewData["Title"] = "Interview Report";
    ViewBag.PageHeader = "Interview Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/newassets/css/rbtooltip.css" rel="stylesheet" />
<style>
    .star-rating {
        border: solid 1px white;
        display: flex;
        direction: rtl;
        font-size: 2.0em;
        justify-content: space-around;
        padding: 0 .2em;
        text-align: center;
        width: 100%;
        margin-bottom: 10px;
        background-color: lightgray;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            /*color: #ccc;*/
            color: #e4e4e4;
            cursor: pointer;
        }

        .star-rating :checked ~ label {
            color: #f90;
        }

        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #fc0;
        }

    .card-title-space {
        margin: 20px 0px;
        float: right
    }

    .mb10 {
        margin-bottom: 10px
    }
</style>

<link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=6" />
<input type="hidden" value="@ViewBag.profileName" id="hidProfile" />
<div class="main-panel" id="main-panel">
