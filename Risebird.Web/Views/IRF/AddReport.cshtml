                                                    @if (Model.QuestionsCollection == null || Model.QuestionsCollection.Count() == 0)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DropDownList("QuestionsCollection[0].Comment", (SelectList)Model.QuestionsList, new { @class = "select-css form-control text-box single-line", @onchange = "QuestionChanged(this.id, this.value)" })

                                                            </td>
                                                            <td>
                                                                @Html.TextBox("QuestionsCollection[0].SkillName", null, new { @class = "form-control", @readonly = "readonly" })

                                                            </td>
                                                            <td>
                                                                @Html.DropDownList("QuestionsCollection[0].RatingId", (SelectList)Model.QuestionsLevelList, new { @class = "select-css form-control" })

                                                            </td>

                                                            <td>
                                                                <input class="form-control text-box single-line" id="QuestionsCollection_0__Timing" name="QuestionsCollection[0].Timing" type="number" min="1">

                                                            </td>

                                                            @*<td>
                                                        <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute "><i class="fas  fa fa-plus"></i></span>
                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                        <span id="btnMinus" onclick="DeleteRow(0)" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg></span>
                                                        </button>
                                                        </td>*@

                                                        </tr>
                                                    }
                                                    else
                                                    {
                                                        for (int i = 0; i < Model.QuestionsCollection.Count(); i++)
                                                        {
                                                            <tr onclick="switchtoquestionVedio(@Model.QuestionsCollection[i].Timing)" style="cursor:pointer">

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.QuestionsCollection[i].Comment, (SelectList)Model.QuestionsList, new { ID = "drop", @class = "dropques select-css form-control text-box single-line", @onchange = "QuestionChanged(this.id, this.value)", onmouseover = "dropDwnToolTips(this)" })


                                                                </td>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.QuestionsCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>

                                                                    @Html.DropDownListFor(m => m.QuestionsCollection[i].RatingId, (SelectList)Model.QuestionsLevelList, new { @class = "select-css form-control droprating" })


                                                                </td>

                                                                <td>

                                                                    @Html.EditorFor(m => m.QuestionsCollection[i].Timing, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @min = "1" } })

                                                                </td>

                                                                @*<td>
                                                        <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute "><i class="fas  fa fa-plus"></i></span>
                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                        <span id="btnMinus" onclick="DeleteRow(0)" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg></span>
                                                        </button>
                                                        </td>*@
                                                            </tr>


                                                        }

                                                    }




                                                </tbody>
                                            </table>
                                        </div>
                                    </div><!--end of col-md-12-->

                                </div>

                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-6">
                                        <div class="multiple_row">
                                            <h3 class="mb-0"><span>Tech Skill Report</span></h3>
                                        </div><!--end of multiple location-->
                                    </div><!--end of col-md-12-->


                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                        <div class="table-responsive-sm">
                                            <table class="table table-bordered mbn" id="SkillTable">
                                                <thead>
                                                    <tr>
                                                        <th>Required Level</th>
                                                        <th>Skill Name</th>
                                                        <th>Actual Level</th>
                                                        <th>Required Weightage</th>
                                                        <th>Actual Weightage</th>
                                                    </tr>
                                                </thead>


                                                <tbody>
                                                    @if (Model.TechSkillReportCollection != null)
                                                    {
                                                        @for (int i = 0; i < Model.TechSkillReportCollection.Count(); i++)
                                                        {
                                                            <tr>

                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].RequiredLevel, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                                </td>
                                                                <td>
                                                                    <div class="techinfocontainer">
                                                                        @Html.TextBoxFor(m => m.TechSkillReportCollection[i].SkillName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                        <i class="fa fa-info-circle techinfoicon tooltipquestion">
                                                                            <span class="tooltiptext">
                                                                                <p>Concepts: @Model.TechSkillReportCollection[i].Concepts</p>
                                                                                <p>Natureofquestion: @Model.TechSkillReportCollection[i].Natureofquestion</p>
                                                                                <p>Timelimit: @Model.TechSkillReportCollection[i].Timelimit</p>
                                                                            </span>
                                                                        </i>
                                                                    </div>
                                                                </td>

                                                                <td>
                                                                    @Html.DropDownListFor(m => m.TechSkillReportCollection[i].ActualLevelId, (SelectList)Model.LevelTech, new { @class = "select-css form-control", @onchange = "CalculateOverAll(this.id, this.value)" })

                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageRequired, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                <td>
                                                                    @Html.TextBoxFor(m => m.TechSkillReportCollection[i].WeightageActual, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                </td>
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].RequiredLevelId)
                                                                @Html.HiddenFor(m => m.TechSkillReportCollection[i].SkillId)
                                                            </tr>
                                                            <tr>
                                                                <td colspan="5">@Html.TextBoxFor(m => m.TechSkillReportCollection[i].TechComments, new { @class = "form-control text-box single-line", @placeholder = "Comment for Skill min 25 characters", maxlength = "75",@style="font-weight: bold !important;" })</td>
                                                            </tr>
                                                        }
                                                    }



