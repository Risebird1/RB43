@model Risebird.Entities.ViewModel.AGCampaignModel

@{
    ViewData["Title"] = "Campaign Detail";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    body {
        background: #f0f0f0 !important;
    }
    
    #skill, #assessment {
       
        width: auto;
        overflow: hidden;
     
   height:50px;
       
    }
.readmore, .readmore1{height: auto!important;}
    
</style>


<div class="campaignForm">
   


    <div>
         <h1>Campaign Summary For  <span style="color: #66bb64; font-weight: 600;font-size:28px;">  @Model.CampaignName</span></h1>
        <div style="margin:20px auto 10px auto;">



     <div class="wrapper">
 <div>
  <table class="table">
    <thead>
    <tr id=@Model.id class="row header" style="background:#9ba9c9 !important">
    
    <th>  <div class="cell" style="padding-bottom:0px;">
      Primary Assessment Group 
      </div></th>
    <th>  <div class="cell" style="padding-bottom:0px;">
       Secondary Assessment Group(s)
      </div></th>
    <th>  <div class="cell" style="padding-bottom:0px;">
      Skill Channel(s) Selected
      </div></th>
     
    </tr>
    </thead>

    <tbody> 
        <tr class="row" style="background:#e9e9e957">
     
       <td valign="top">
           <div class="cell">
          <span style="color: #2a77b5;font-weight: 600;font-size:16px;"> @Model.AssessmentGroupName</span>
      </div>
      </td>
      <td valign="top">
          <div class="cell">

       @if (Model.AssessmentGroups != null)
        {
             <div id="assessment" style="color: #4aaba5;font-weight: 500;font-size:16px;margin-right:10px;">
                    <div class="more-assessment">
            @for (int i = 0; i < Model.AssessmentGroups.Count(); i++)
            {

               @Model.AssessmentGroups[i].AssessmentGroup<br/>

            }
            </div>
                                            </div>
             <div style="clear:both"></div>
            <button id="expandbtn1" class="moreless-btn" style="display:none">Read more</button>
        }
      </div>
      </td>
     <td valign="top">
         <div class="cell">
        @if (Model.SkillChannels != null)
        {
            <div id="skill" style="color:#1dbe52;font-weight: 600; margin-right:10px;font-size:16px; font-weight: 500; font-size: 14px; padding: 3px;">
                  <div class="more-skill">
            @foreach (var item in Model.SkillChannels)
            {
               @item.IRFId<br/>

            }
            </div> 
             </div>
             <div style="clear:both"></div>
            <button id="expandbtn" class="moreless-btn"  style="display:none">Read more</button>
        }
      </div>
      </td>


    </tr>
    
  </tbody>
  </table>
  </div>

         
        </div>
    </div>
</div>
</div>



<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
      $(function(){
   $(".more-skill").each(function(){ 
  if ($(this).height() <= 50 ) {
     $('#expandbtn').css('display','none')
  }
  else{
   $('#expandbtn').css('display','block')
  }
  });  

  $(".more-assessment").each(function(){ 
  if ($(this).height() <= 50) {
      $('#expandbtn1').css('display','none')
  }
  else{
   $('#expandbtn1').css('display','block')
  }
 });  
});
      $(document).ready(function(){
      $('#skill').removeClass("readmore");  
      $('#expandbtn').click(function(){
      if($('#skill').hasClass("readmore")) {
      $('#expandbtn').html('Read more');
      $('#skill').removeClass("readmore");

    } else {
      $('#expandbtn').html('Read less');
      $('#skill').addClass("readmore");

        }
  });

     $('#assessment').removeClass("readmore1");
  $('#expandbtn1').click(function(){
     
    if($('#assessment').hasClass("readmore1")) {
      $('#expandbtn1').html('Read more');
      $('#assessment').removeClass("readmore1");
 
    } else {
      $('#expandbtn1').html('Read less');
      $('#assessment').addClass("readmore1");
    }
  });


});
  </script>

