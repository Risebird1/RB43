@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@*@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.AssignmentVM>*@
@model Risebird.Entities.ViewModel.AssignmentVM
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
//@using X.PagedList.Mvc.Core;
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interviewer.css?v=8" />

<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Assessment</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->




    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Assessment Group</h4></div>
                </div>

                <div class="pull-right">
                    <div>

                        <div class="newsletter card-title-space">
                            <div class="content">
                                <div class="input-group" id="myForm">

                                </div>
                            </div>
                        </div>
                        <a onclick="AssessmentLike(@Model.id)" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space"><span class="fa fa-chevron-left"></span> Show Interest</a>
                        <a href="/IRF/InterviewerEntitleDetails/@Model.backid" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space"><span class="fa fa-chevron-left"></span> Back</a>

                    </div>
                </div>
            </div>
        </div>
    </div>







    <div class="content client assessment">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="assessment-detail">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div class="dataloading">

                                <div style="clear:both;padding:10px"></div>

                                <div class="col-md-12 col-lg-12 ">
                                    <h1>Overview</h1>
                                    <p>@Model.Overview</p>
                                </div>

                                <div class="col-md-12 col-lg-12"><h1>Seniority Level</h1></div>
                                <div class="col-md-12 col-lg-12">@Model.Seniority</div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>Years of Experience </h1>
                                    @Model.YearsOfExperience
                                </div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>Assessment Type</h1>
                                    @Model.AssessmentTypes
                                </div>
                                <div style="clear:both; height:10px;"></div>

                               

                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>  Tested Skills Primary</h1>
                                    @Model.TestedSkill
                                </div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Evaluation
                                    </h1>
                                    @Model.Evaluations
                                </div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Delivery
                                    </h1>
                                    @Model.Delivery
                                </div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Environment
                                    </h1>
                                    @Model.Environment
                                </div>
                                <div style="clear:both; height:10px;"></div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Difficulty Level
                                    </h1>
                                    @Model.Difficultylevel
                                </div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Employer Type
                                    </h1>
                                    @Model.EmployerType
                                </div>
                                <div style="clear:both; height:10px;"></div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Employer Stage
                                    </h1>
                                    @Model.EmployerStages
                                </div>
                                <div class="col-md-6 col-lg-6 pull-left assessment-blk-h">
                                    <h1>
                                        Employer Size
                                    </h1>
                                    @Model.EmployerSizes
                                </div>

                                <div style="clear:both; height:10px;"></div>
                                <table class="table table-grey dt-responsive">
                                    <thead>
                                        <tr>
                                            <th>Question Covered</th>
                                            <th class="text-center">Skills</th>
                                            <th class="text-center">Level</th>
                                            <th class="text-center">Time(in Min.)</th>
                                            <th class="text-center">VideoLink</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Questionslist)
                                        {
                                            <tr>
                                                <td class="br-g ">@item.QuestionCovered</td>
                                                <td class="br-g text-center">@item.Skills</td>
                                                <td class="br-g text-center">@item.Levels</td>
                                                <td class="text-center">@item.Time</td>
                                                <td class="text-center">@item.VideoLink</td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>

<script>
    function AssessmentLike(id) {
        $.ajax({
            type: "POST",
            url: "/IRF/AssessmentLike",
            data: { id: id },
            success: function (data) {
                alert("Successfully Liked!");
            }
        });
    }
</script>