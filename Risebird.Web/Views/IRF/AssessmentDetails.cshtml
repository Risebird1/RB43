@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@*@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.AssignmentVM>*@
@model Risebird.Entities.ViewModel.AssignmentVM
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
//@using X.PagedList.Mvc.Core;

<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Assessment</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                            </div>
                            <div class="row">
                                <div class="card-header clearfix">
                                    <div class="pull-left">
                                        <h4 class="card-title"></h4>
                                    </div>
                                    <div class="pull-right">
                                        <div class="newsletter">
                                            <div class="content">
                                                <div class="input-group" id="myForm">

                                                </div>
                                            </div>
                                        </div>
                                        <a href="/IRF/InterviewerEntitle" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;"><span class="fa fa-chevron-left"></span> Back to List</a>
                                    </div>
                                </div>
                            </div>


                            <div style="clear:both;padding:10px"></div>
                            <div class="row">
                                <div class="col-md-12 col-lg-12">Overview</div>
                                <div class="col-md-12 col-lg-12">@Model.Overview</div>
                                <div class="col-md-12 col-lg-12">Seniority Level</div>
                                <div class="col-md-12 col-lg-12">@Model.Seniority</div>
                                <div class="col-md-12 col-lg-12">Years of Experience</div>
                                <div class="col-md-12 col-lg-12">@Model.YearsOfExperience</div>
                                <div class="col-md-12 col-lg-12">Assessment Type</div>
                                <div class="col-md-12 col-lg-12">@Model.AssessmentTypes</div>
                                <div class="col-md-6 col-lg-6">
                                    Tested Skills Primary<br />
                                    @Model.TestedSkill
                                </div>
                                <div class="col-md-6 col-lg-6">
                                    Evaluation<br />
                                    @Model.Evaluations
                                </div>
                                <div class="col-md-6 col-lg-6">
                                    Delivery<br />
                                    @Model.Delivery
                                </div>
                                <div class="col-md-6 col-lg-6">
                                    Environment<br />
                                    @Model.Environment
                                </div>
                                <div class="col-md-12 col-lg-12">
                                    Difficulty Level : @Model.Difficultylevel
                                </div>
                                <div class="col-md-12 col-lg-12">
                                    Employer Type : @Model.EmployerType
                                </div>
                                <div class="col-md-12 col-lg-12">
                                    Employer Stage : @Model.EmployerStages
                                </div>
                                <div class="col-md-12 col-lg-12">
                                    Employer Size : @Model.EmployerSizes
                                </div>
                            </div>

                            <div style="clear:both"></div>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Question Covered</th>
                                        <th>Skills</th>
                                        <th>Level</th>
                                        <th>Time(in Min.)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Questionslist)
                                    {
                                        <tr>
                                            <td>@item.QuestionCovered</td>
                                            <td>@item.Skills</td>
                                            <td>@item.Levels</td>
                                            <td>@item.Time</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>

