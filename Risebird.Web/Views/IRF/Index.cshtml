    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Interview Forms</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                            <div class="text-right">
                                <button type="button" style="margin-top:-108px;" class="btn btn-primary"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add IRF" onclick="location.href='@Url.Action("Add", "IRF")'" data-original-title="Tooltip on top"> Add IRF</span></button>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-stats" >
                        <div class="card-body ">
                        
                            <div class="statistics statistics-horizontal">
                                <div class="info info-horizontal">
                                    <div class="row">
                                        <div class="col-12 text-center">
                                            <h3 class="info-title" style="font-size:smaller;"> @item.IRFId</h3>
                                        </div>
                                    </div>
                                    <hr>

                                    <div class="row" style="font-size:smaller;">
                            
                                        <div class="col-12">
                                            <div class="group inner list-group-item-text">
                                                <span>Client Name:</span> <p>@item.ClientName</p>
                                                <span>Location:</span> <p>@item.JobCountry</p>
                                                <span>No of Openings:</span> <p>@item.NoOfPosition</p>
                                                <span>No of Interviews:</span> <p>@item.NoOfIntterview</p>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer ">
                            <div class="stats text-center">
                                <button type="button" onclick="javascript:EditIRF('@item.id');" rel="tooltip" class="btn btn-primary btn-icon btn-sm " data-original-title="" title="Edit">
                                    <i class="now-ui-icons fa fa-edit"></i>
                                </button>
                                <button type="button" onclick="javascript:AddComments('@item.id');" rel="tooltip" class="btn btn-warning btn-icon btn-sm " data-original-title="" title="Questions">
                                    <i class="now-ui-icons fa fa-comments"></i>
                                </button>
                                <button type="button" onclick="javascript:GetInterviewMeetings('@item.id', '@item.IRFId');" rel="tooltip" class="btn btn-info btn-icon btn-sm " data-original-title="" title="Meetings">
                                    <i class="now-ui-icons fa fa-meetup"></i>
                                </button>
                                <button type="button" onclick="javascript:DeleteIRF('@item.id');" rel="tooltip" class="btn btn-danger btn-icon btn-sm " data-original-title="" title="Delete">
                                    <i class="now-ui-icons fa fa-trash"></i>
                                </button>
                                @*<i class="now-ui-icons arrows-1_refresh-69"></i> Update now
                                    <i class="now-ui-icons fa fa-pencil" style="color:blue;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Edit" data-original-title="Tooltip on bottom" onclick="javascript:EditIRF('@item.id');"></i>

                                    <i class="now-ui-icons  fa-comments" style="color:black;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Questions" data-original-title="Tooltip on bottom" onclick="javascript:AddComments('@item.id');"></i>

                                    <i class="now-ui-icons fa fa-meetup" style="color:green;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Meetings" data-original-title="Tooltip on bottom" onclick="javascript:GetInterviewMeetings('@item.id', '@item.IRFId');"></i>

                                    <i class="now-ui-icons fa fa-trash" style="color:red;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Delete" data-original-title="Tooltip on bottom" onclick="javascript:DeleteIRF('@item.id');"></i>*@

                            </div>
                        </div>
                    </div>
                </div>
            }
            @*<div class="col-lg-3 col-sm-6">
                    <div class="card card-stats">
                        <div class="card-body ">
                            <div class="statistics statistics-horizontal">
                                <div class="info info-horizontal">
                                    <div class="row">
                                        <div class="col-5">
                                            <div class="icon icon-warning icon-circle">
                                                <i class="now-ui-icons business_bank"></i>
                                            </div>
                                        </div>
                                        <div class="col-7 text-right">
                                            <h3 class="info-title">
                                                <span>$</span>23,685
                                            </h3>
                                            <h6 class="stats-title">Deposit</h6>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr>
                        <div class="card-footer ">
                            <div class="stats">
                                <i class="now-ui-icons ui-1_calendar-60"></i> Last week
                            </div>
                        </div>
                    </div>
                </div>*@
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
