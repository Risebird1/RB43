        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Interview Request Forms
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Interview Request Forms</h4>
                    </div>
                    <div class="row">
                    <div class="col-md-3 ml-md-auto">
                        <div class="form-group">

                        </div>
                    </div>
                    <div class="col-auto">
                        @if (ViewBag.IsClientUser == false)
                        {
                            <button type="button" style="margin-right: 6px;" class="btn btn-primary"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add IRF" onclick="location.href='@Url.Action("Add", "IRF")'" data-original-title="Tooltip on top"> Add IRF</span></button>

                        }
                        <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#filterModal"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"> Filter</span></button>
                    </div>
                    </div>
                    <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-header" style="border-bottom: 1px solid #e9ecef;">
                                    <h5 class="modal-title" id="filterModalLabel">Advanced Filters</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <form action="@Url.Action("Index","IRF")" method="post" id="form">

                                    <div class="modal-body">
                                        <div class="row">
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-6 col-sm-4 desp-label" for="StartDate">
                                                        Start Date
                                                    </label>
                                                    <div class="col-md-6 col-sm-6">
                                                        <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-6 col-sm-4 desp-label" for=" End Date">
                                                        End Date
                                                    </label>
                                                    <div class="col-md-6 col-sm-6">
                                                        <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">RFID</label>
                                                    <div class="col-md-6 col-sm-6">
                                                        <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple">
                                                            @foreach (var item in Model.Select(x => x.IRFId).Distinct().ToList())
                                                            {
                                                                @if (item != null && item != "")
                                                                {
                                                                    <option value="@item">@item</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="control-label col-md-6 col-sm-4 desp-label" for="ArchiveStatus">Archive Status</label>
                                                    <div class="col-md-6 col-sm-6">
                                                        <select id="ArchiveStatus" name="ArchiveStatus" class="form-control multiselect" multiple="multiple">
                                                            @foreach (var item in Model.Select(x => x.ArchiveStatus).Distinct().ToList())
                                                            {
                                                                @if (item != null && item != "")
                                                                {
                                                                    <option value="@item">@item</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientRole">Client Role</label>
                                                    <div class="col-md-6 col-sm-6">
                                                        <select id="ClientRole" name="ClientRole" class="form-control multiselect" multiple="multiple">

                                                            @foreach (var item in ViewBag.RoleList)
                                                            {
                                                                @if (item != null && item != "")
                                                                {
                                                                    <option value="@item">@item</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>


                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientName">End Client Name</label>
                                                    <div class="col-md-6 col-sm-6">
                                                        <select id="ClientName" name="ClientName" class="form-control multiselect" multiple="multiple">
                                                            @foreach (var item in Model.Select(x => x.ClientName).Distinct().ToList())
                                                            {
                                                                @if (item != null && item != "")
                                                                {
                                                                    <option value="@item">@item</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                </div>

                                                <div class="form-group col-md-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6">
                                                            <button type="submit" style="margin-top: 40px; float:right" class="btn btn-primary">Apply Filter</button>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <button type="button" style="float:right;margin-top: 39px;" class="btn btn-primary" id="ResetFilter">Reset Filter</button>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>

                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-sm-6">
                    <div class="card card-stats">
                        <div class="card-body ">

                            <div class="statistics statistics-horizontal">
                                <div class="info info-horizontal">
                                    <div class="row">
                                        <div class="col-12 text-center">
                                            <h3 class="info-title" style="font-size:smaller;"> @item.IRFId</h3>
                                        </div>
                                    </div>
                                    <hr>

                                    <div class="row" style="font-size:smaller;">

                                        <div class="col-12">
                                            <div class="group inner list-group-item-text">
                                                <span>Client Name:</span> <p>@item.ClientCompName (@item.ClientName)</p>
                                                <span>Primary Skill:</span> <p>@item.JDTiltle.Split("|")[0]</p>
                                                <span>Start Date:</span> <p>@item.StartDate</p>
                                                <span>End Date:</span> <p>@item.EndDate</p>
                                                <span>Total Interviews:</span> <p>@item.TotalMeetings</p>
                                                <span>Total Invites:</span> <p>@item.TotalInvites</p>
                                                <span>Scheduled Interviews:</span> <p>@item.ScheduleMeetings</p>
                                                <span>Selected Interviews:</span> <p>@item.SelectedMeetings</p>
                                                <span>Budget Consumed:</span> <p>@item.BudgetConsumed</p>

                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="card-footer ">
                            <div class="stats text-center">
                                @if (!@item.IsClientUser)
                                {
                                    <button type="button" onclick="javascript:EditIRF('@item.id');" title="Edit" class="btn btn-primary btn-icon btn-sm">
                                        <i class="now-ui-icons fa fa-edit"></i>
                                    </button>
                                    <button type="button" onclick="javascript:AddComments('@item.id');" class="btn btn-warning btn-icon btn-sm" title="Questions">
                                        <i class="now-ui-icons fa fa-comments"></i>
                                    </button>
                                    <button type="button" onclick="location.href='@Url.Action("Invoice", "IRF", new {irfId = item.id, irfName = item.IRFId})'" class="btn btn-info btn-icon btn-sm" title="Interview Invoice">
                                        <i class="now-ui-icons fa fa-money"></i>
                                    </button>
                                }
                                <button type="button" onclick="javascript:GetCandidateList('@item.id', '@item.IRFId');" class="btn btn-info btn-icon btn-sm" title="Candidates List">
                                    <i class="now-ui-icons fa fa-list"></i>
                                </button>
                                <button type="button" onclick="javascript:GetInterviewMeetings('@item.id', '@item.IRFId');" class="btn btn-info btn-icon btn-sm" title="Meetings">
                                    <i class="now-ui-icons fa fa-meetup"></i>
                                </button>
                                <button type="button" onclick="javascript:SelectedInterviewMeetings('@item.id', '@item.IRFId');" class="btn btn-info btn-icon btn-sm" title="Selected Candidates">
                                    <i class="now-ui-icons fa fa-check"></i>
                                </button>
                                <button type="button" onclick="location.href='@Url.Action("ShowCalendly", "IRF", new {irfName = item.IRFId, calendlyLink =item.CalendlyLink})'" class="btn btn-info btn-icon btn-sm" title="Schedule Meeting">
                                    <i class="now-ui-icons  fa fa-calendar"></i>
                                </button>
                                <button type="button" onclick="location.href='@Url.Action("InterviewPlanner", "IRF", new {irfId = item.id, irfName = item.IRFId})'" class="btn btn-info btn-icon btn-sm" title="Interview Planner">
                                    <i class="now-ui-icons  fa fa-calendar-minus-o"></i>
                                </button>
                                <button type="button" onclick="javascript:stats('@item.id', '@item.IRFId');" class="btn btn-success btn-icon btn-sm" title="Stats">
                                    <i class="now-ui-icons fa fa-industry"></i>
                                </button>

                                @if (!@item.IsClientUser)
                                {
                                    if (!item.IsDeleted)
                                    {
                                        <button type="button" onclick="javascript:DeleteIRF('@item.id');" class="btn btn-danger btn-icon btn-sm" title="Archive">
                                            <i class="now-ui-icons fa fa-archive"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" onclick="javascript:UnArchiveIRF('@item.id');" class="btn btn-success btn-icon btn-sm" title="UnArchive">
                                            <i class="now-ui-icons fa fa-undo"></i>
                                        </button>
                                    }

                                }

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/IRF/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/IRF/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}



<script type="text/javascript">
    function DeleteIRF(dataID) {

        var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: "It will be archived!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, archive it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    var IdIRF = dataID;
                    $.ajax({
                        url: '/IRF/DeleteIRF?id=' + IdIRF,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error archiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Archived!',
                    type: 'success',
                    html: '<p>IRF has been archived.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/IRF/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been archived! :)',
                    'error'
                )
            }
        })
    }


    function AddComments(id) {

        var url = '/IRF/SampleQuestions?id=' + id;
        window.location.href = url;
    };
    function SelectedInterviewMeetings(id, IRFid) {

        var url = '/IRF/SelectedInterviewMeetings?id=' + id + '&irfId=' + IRFid;
        window.location.href = url;
    };
    function GetInterviewMeetings(id, IRFid) {

        var url = '/IRF/GetInterviewMeetings?id=' + id + '&irfId=' + IRFid;
        window.location.href = url;
    };
    //GetCandidateList
    function GetCandidateList(id, IRFid) {

        var url = '/IRF/GetCandidateList?id=' + id + '&irfName=' + IRFid;
        window.location.href = url;
    };
    function EditIRF(id) {

        var url = '/IRF/EditIRF?id=' + id;
        window.location.href = url;
    };
    function stats(id, IRFid) {

        var url = '/IRF/Stats?id=' + id + '&irfId=' + IRFid;
        window.location.href = url;
    };
    function UnArchiveIRF(id) {

        var url = '/IRF/UnArchiveIRF?id=' + id;
        window.location.href = url;
    };
    //UnArchiveIRF
</script>
<script>
    $(document).ready(function () {
        
        $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }
        
        $("#RFID").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        $("#ClientName").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
        $("#ArchiveStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });       
        $("#ClientRole").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '270px',
            maxHeight: 200
        });
       
    });

    function ResetFilter() {

             $.ajax({
            type: "POST",
            url: "/IRF/Index",
                 success: function (data) {
                    window.location.href = "/IRF/ResetIRFFilter";
                 }
                });
    }
        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var rFID =  @Html.Raw(Json.Serialize(RFID));
            var clientName =  @Html.Raw(Json.Serialize(ClientName));
            var archiveStatus =  @Html.Raw(Json.Serialize(ArchiveStatus));
            var clientRole =  @Html.Raw(Json.Serialize(ClientRole));
            

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#RFID").val(rFID);
            $("#ClientName").val(clientName);
            $("#ArchiveStatus").val(archiveStatus);
            $("#ClientRole").val(clientRole);
            var form = $("#form").serialize();
             $.ajax({
            type: "POST",
            url: "/IRF/Index",
            data: form,
                 success: function (data) {
                 }
                });
    }

</script>