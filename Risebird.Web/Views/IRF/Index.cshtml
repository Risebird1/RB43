@model IEnumerable<Risebird.Entities.ViewModel.IRF>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "IRF";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] RFID = new string[] { };
    string[] ArchiveStatus = new string[] { };
    string[] ClientName = new string[] { };
    string[] ClientRole = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("IRFfilters") != null)
{
    filter = JsonConvert.DeserializeObject<IRFFilter>(HttpContextAccessor.HttpContext.Session.GetString("IRFfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ArchiveStatus = filter.ArchiveStatus != null ? filter.ArchiveStatus : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    ClientRole = filter.ClientRole != null ? filter.ClientRole : new string[] { };

}
<style>
    .spanclass {
        color: black;
        font-size: 11px;
    }

    .desc {
        display: inline-block;
        width: 120px;
        white-space: nowrap;
        overflow: hidden !important;
        text-overflow: ellipsis;
    }

    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 35px;
        margin-bottom: 35px;
    }

    @@media (min-width: 1200px) {
        .container {
            width: 1125px;
        }
    }

    .thumbnail {
        border-top: 5px solid #443f3f;
    }

    .list-group-item-heading {
        font-size: 13px;
        font-weight: 700;
        border-bottom: 1px solid #ccc;
        padding-bottom: 15px;
    }

    .list-group-item-text {
        padding-top: 20px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 20px;
    }

        .list-group-item-text span {
            float: left;
            font-weight: 700;
            padding-right: 5px;
        }

    .icon span {
        padding-top: 15px;
        font-size: 19px;
        color: #5f95b1;
        padding-left: 5px;
    }

    .list-group {
        margin-bottom: 150px;
    }
</style>
<style>
    .caret {
        display: none !important;
    }

    .multiselect-container {
        width: 100% !important;
    }

    .modal-lg {
        max-width: 690px !important;
    }

    .dropdown-toggle {
        background-color: white !important;
        color: black !important;
        border: 1px solid #ccc !important;
    }

    #StartDate, #EndDate {
        width: 270px;
    }

    .modal-content .modal-body {
        padding-top: 10px;
    }
</style>
