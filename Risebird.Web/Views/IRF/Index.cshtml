@model IEnumerable<Risebird.Entities.ViewModel.IRF>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 35px;
        margin-bottom: 35px;
    }

    @@media (min-width: 1200px) {
        .container {
            width: 1125px;
        }
    }

    .thumbnail {
        border-top: 5px solid #443f3f;
    }

    .list-group-item-heading {
        font-size: 13px;
        font-weight: 700;
        border-bottom: 1px solid #ccc;
        padding-bottom: 15px;
    }

    .list-group-item-text {
        padding-top: 20px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 20px;
    }

        .list-group-item-text span {
            float: left;
            font-weight: 700;
            padding-right: 5px;
        }

    .icon span {
        padding-top: 15px;
        font-size: 19px;
        color: #5f95b1;
        padding-left: 5px;
    }

    .list-group {
        margin-bottom: 150px;
    }
</style>
<!--START BREADCRUMB-->
<ul class="breadcrumb">
    <li class="active"><strong>Interview Forms</strong></li>
</ul>
<!-- END BREADCRUMB -->
<!-- PAGE TITLE -->
<div class="page-title">
    <h2><span class="fa fa-address-card"></span> Interview Forms</h2>
    @*<a href="#" class="panel-refresh" title="Refresh"><span class="fa fa-refresh" onclick="javascript:InterviewRefresh();"></span></a>*@
    @*<i type="submit" class="fa fa-file-excel-o  @ViewBag.ActionClass.Export" style="margin-right:10px;float:right;color:green;font-size: 35px;" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("ExporttoExcel", "ActionLog")'"></i>*@
</div>
<!-- END PAGE TITLE -->
<div class="panel panel-default">
    <div class="panel-heading">
        <ul class="panel-controls">
            <li><a href="#" title="Refresh"><span class="fa fa-refresh" onclick="location.href='@Url.Action("Index", "IRF")'"></span></a></li>
            <button type="button" class="btn btn-default mb-control"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "IRF")'" data-original-title="Tooltip on top"> Add Form</span></button>
        </ul>
    </div>
</div>
<div class="container">

    <div id="products" class="row list-group">

        @foreach (var item in Model)
        {
            <div class="item  col-xs-4 col-lg-4">
                <div class="thumbnail">

                    <div class="caption">
                        <h4 class="group inner list-group-item-heading">
                            @item.IRFId
                        </h4>
                        <div class="group inner list-group-item-text">
                            <span>Client Name:</span> <p>@item.ClientName</p>
                            <span>Location:</span> <p>@item.JobCountry</p>
                            <span>No of Openings:</span> <p>@item.NoOfPosition</p>
                            <span>No of Interviews:</span> <p>@item.NoOfIntterview</p>
                        </div>
                        <div class="row">
                            <div class="col-xs-12 col-md-6 icon">
                                <i class="fa fa-pencil" style="color:blue;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Edit" data-original-title="Tooltip on bottom" onclick="javascript:EditIRF('@item.id');"></i>

                                <i class="fa fa-comments" style="color:black;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Questions" data-original-title="Tooltip on bottom" onclick="javascript:AddComments('@item.id');"></i>

                                <i class="fa fa-meetup" style="color:green;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Meetings" data-original-title="Tooltip on bottom" onclick="javascript:GetInterviewMeetings('@item.id', '@item.IRFId');"></i>

                                <i class="fa fa-trash" style="color:red;font-size: 30px;" data-toggle="tooltip" data-placement="bottom" title="Delete" data-original-title="Tooltip on bottom" onclick="javascript:DeleteIRF('@item.id');"></i>

                                @*<span class="fa fa-trash" style="color:#d9534f"></span>*@
                                @*<a class="btn border-white btn-sm btn-danger" id="deleteIRF" onclick="DeleteIRF(@item.id)">
                                    <span class="glyphicon glyphicon-trash"></span>
                                </a>
                                <a class="btn btn-primary border-white btn-sm" id="btnComments" onclick="AddComments('@item.id')">
                                    <span class="glyphicon glyphicon-comment"></span>
                                </a>
                                <a class="btn btn-primary border-white btn-sm" id="btnMeetings" onclick="GetInterviewMeetings('@item.id')">
                                    <span class="glyphicon glyphicon-calendar"></span>
                                </a>*@
                                @*<span class="fa fa-download"></span>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
@if (ViewBag.Message != null)
{
    <script>

        $(document).ready(function () {
            var message = '@ViewBag.Message';
            debugger;
            if (message.includes("Success")) {
                alert("Successful");
                //swal("Successful!", "IRF added successfully.", "success");

            }
            else
                alert("Unsuccessful");
                //swal("Sorry!", "IRF submission failed.", "error");

        });

    </script>

}

    <script>

        function AddComments(id) {
            debugger;
            var url = '/IRF/AddComments?id=' + id ;
            window.location.href = url;
        };  
        function DeleteIRF(id) {
            var url = '/IRF/DeleteIRF?id=' + id;
            window.location.href = url;
        };  

        function GetInterviewMeetings(id, IRFid) {
            debugger;
            var url = '/IRF/GetInterviewMeetings?id=' + id + '&irfId=' + IRFid;
            window.location.href = url;
        }; 

        function EditIRF(id) {
            debugger;
            var url = '/IRF/EditIRF?id=' + id;
            window.location.href = url;
        };  


    </script>
