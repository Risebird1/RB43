@model IEnumerable<Risebird.Entities.ViewModel.IRF>

@{
    ViewData["Title"] = "IRF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 35px;
        margin-bottom: 35px;
    }

    @@media (min-width: 1200px) {
        .container {
            width: 1125px;
        }
    }

    .thumbnail {
        border-top: 5px solid #443f3f;
    }

    .list-group-item-heading {
        font-size: 13px;
        font-weight: 700;
        border-bottom: 1px solid #ccc;
        padding-bottom: 15px;
    }

    .list-group-item-text {
        padding-top: 20px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 20px;
    }

        .list-group-item-text span {
            float: left;
            font-weight: 700;
            padding-right: 5px;
        }

    .icon span {
        padding-top: 15px;
        font-size: 19px;
        color: #5f95b1;
        padding-left: 5px;
    }

    .list-group {
        margin-bottom: 150px;
    }
</style>
