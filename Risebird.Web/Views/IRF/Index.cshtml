<script>

    var currentPageNumber = 1;
    @*var maxPageCount = parseInt('@Model.MaxPageCount');*@
    var allFetched = false;
    var currentDataFetched = true;
    $(document).ready(function () {

        $(window).scroll(function () {
            if (allFetched == false && currentDataFetched == true) {//maxPageCount > currentPageNumber
                if ($(window).scrollTop() > ($(document).height() - $(window).height()) * 9 / 10) {
                    currentPageNumber += 1;
                    loadPageData(currentPageNumber);
                    //document.getElementById("loader").style.display = 'none';

                }
            }

        });

    });
    function loadPageData(currentPageNumber) {
        currentDataFetched = false;
        var loader = document.getElementById("loader");
        loader.style.display = 'block';
        var searchValue = document.getElementById("idtxtSearch").value;

        $.ajax({
            url: '/IRF/IndexPartial',
            data: { 'pageNumber': (currentPageNumber), 'searchValue': searchValue},
            method: 'GET',
            success: function (response) {
                if (response != null && response != '' && response != false) {
                    var irfTable = $('#irfTilesBody');
                    loader.style.display = 'none';
                    irfTable.append(response);
                    currentDataFetched = true;
                }
                else if (response == null || response == false) {
                    allFetched = true;
                    loader.style.display = 'none';
                    currentDataFetched = false;
                }
                //else if (response == false) {
                //    allFetched = true;
                //    loader.style.display = 'none';
                //    //$('#irfTilesBody').append("Error loading!");
                //}

            }
        });

    }

    function SearchSkillChannels() {
        var searchValue = document.getElementById("idtxtSearch").value;
        window.location = "/IRF/Index?searchValue=" + searchValue;
    }

</script>
<script>

    var input = document.getElementById("idtxtSearch");
    input.addEventListener("keyup", function (event) {
        if (event.keyCode === 13) {
            SearchSkillChannels();
        }
    });
</script>

