@model Risebird.Entities.ViewModel.IRFViewModel
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Skills Channel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] RFID = new string[] { };
    string[] ArchiveStatus = new string[] { };
    string[] ClientName = new string[] { };
    string[] SubscriptionStatus = new string[] { };
    string[] ClientRole = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("IRFfilters") != null)
{
    filter = JsonConvert.DeserializeObject<IRFFilter>
(HttpContextAccessor.HttpContext.Session.GetString("IRFfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ArchiveStatus = filter.ArchiveStatus != null ? filter.ArchiveStatus : new string[] { };
    SubscriptionStatus = filter.SubscriptionStatus != null ? filter.SubscriptionStatus : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    ClientRole = filter.ClientRole != null ? filter.ClientRole : new string[] { };

}

