                                                    <div class="form-group">
                                                        <label class="control-label col-md-6 col-sm-4 desp-label" for="RFID">RFID</label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple">
                                                                @foreach (var item in Model.IRFList.Select(x => x.IRFId).Distinct().ToList())
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    @if (!Model.IsClientUser && Model.Profile != "CuratedUser")
                                                    {
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="ClientName">Client Name</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="ClientName" name="ClientName" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.IRFList.Select(x => x.ClientName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (Model.Profile=="CuratedUser")
                                                    {
                                                        <div class="form-group">
                                                            <label class="control-label col-md-6 col-sm-4 desp-label" for="SubscriptionStatus">Subscription Status</label>
                                                            <div class="col-md-6 col-sm-6">
                                                                <select id="SubscriptionStatus" name="SubscriptionStatus" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.IRFList.Select(x => x.SubscriptionStatus).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    }

                                                </div>
                                                <div class="col-md-6 col-sm-6">

                                                    <div class="form-group">
                                                        <label class="control-label col-md-6 col-sm-4 desp-label" for="ArchiveStatus">Archive Status</label>
                                                        <div class="col-md-6 col-sm-6">
                                                            <select id="ArchiveStatus" name="ArchiveStatus" class="form-control multiselect" multiple="multiple">
                                                                @foreach (var item in Model.IRFList.Select(x => x.ArchiveStatus).Distinct().ToList())
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="form-group col-md-12">

                                                        <div class="row">
                                                            <div class="col-md-12 col-sm-12">


                                                                <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                    <font style="font-size:12px;"> Reset Filter</font>
                                                                </button>



                                                                <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                    <font style="font-size:12px;"> Apply Filter</font>
                                                                </button>



                                                            </div>

                                                        </div>



                                                    </div>


                                                </div>
                                            </div>

                                        </div>
                                    </form>
                                </div>
                            </div>

                        </div>

                        <!-- end content-->
                        <!--  end card  -->
                        <!-- end col-md-12 -->
                        <!-- Start Card -->

                        <div class="row">
