                        <script type="text/javascript">

        function my_code() {
            var msg = '@Model.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@Model.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/IRF/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@Model.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        window.location.href = '/IRF/Index';
                    }
                )
            }

        }

        window.onload = my_code();
                        </script>

                    }


                    <script type="text/javascript">

                        function DeleteIRF(dataID) {

                            var IdIRF = dataID;
                            swal.fire({
                                title: 'Are you sure?',
                                text: "It will be archived!",
                                type: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes, archive it!',
                                preConfirm: function () {
                                    return new Promise(function (resolve, reject) {
                                        var IdIRF = dataID;
                                        $.ajax({
                                            url: '/IRF/DeleteIRF?id=' + IdIRF,
                                            success: function (result) {
                                                resolve(result)

                                            },
                                            error: function () {
                                                //reject("error message")
                                                swal.fire("Error archiving!", "Please try again", "error");
                                            }
                                        })
                                    })
                                },
                                allowOutsideClick: false
                            }).then(function (result) {
                                if (result.dismiss !== 'cancel') {
                                    swal.fire({
                                        title: 'Archived!',
                                        type: 'success',
                                        html: '<p>IRF has been archived.</p>',
                                        showCancelButton: false,
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'Close!',
                                        allowOutsideClick: false
                                    }).then(function () {
                                        window.location = "/IRF/Index";
                                    })
                                }
                                else if (result.dismiss === 'cancel') {
                                    swal.fire(
                                        'Cancelled',
                                        'IRF has not been archived! :)',
                                        'error'
                                    )
                                }
                            })


                        }
                        function Subscribe(irfId, irfName) {

                            swal.fire({
                                title: 'Subscribe!',
                                text: "Subscribe to " + irfName,
                                type: 'primary',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes',
                                preConfirm: function () {
                                    return new Promise(function (resolve, reject) {
                                        $.ajax({
                                            url: '/IRF/Subscribe?id=' + irfId,
                                            success: function (result) {
                                                resolve(result)

                                            },
                                            error: function () {
                                                //reject("error message")
                                                swal.fire("Error subscribing!", "Please try again.", "error");
                                            }
                                        })
                                    })
                                },
                                allowOutsideClick: false
                            }).then(function (result) {
                                if (result.dismiss !== 'cancel') {
                                    swal.fire({
                                        title: 'Subscribed!',
                                        type: 'success',
                                        html: '<p>Subscribed to ' + irfName + '.</p>',
                                        showCancelButton: false,
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'Close!',
                                        allowOutsideClick: false
                                    }).then(function () {
                                        window.location = "/IRF/Index";
                                    })
                                }
                                else if (result.dismiss === 'cancel') {
                                    swal.fire(
                                        'Cancelled',
                                        '',
                                        'error'
                                    )
                                }
                            })


                        }
                        function UnSubscribe(irfId, irfName) {

                            swal.fire({
                                title: 'Unsubscribe!',
                                text: "Are you sure you want to unsubscribe " + irfName,
                                type: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes',
                                preConfirm: function () {
                                    return new Promise(function (resolve, reject) {
                                        $.ajax({
                                            url: '/IRF/UnSubscribe?id=' + irfId,
                                            success: function (result) {
                                                resolve(result)

                                            },
                                            error: function () {
                                                //reject("error message")
                                                swal.fire("Error unsubscribing!", "Please try again.", "error");
                                            }
                                        })
                                    })
                                },
                                allowOutsideClick: false
                            }).then(function (result) {
                                if (result.dismiss !== 'cancel') {
                                    swal.fire({
                                        title: 'Unsubscribed!',
                                        type: 'success',
                                        html: '<p>Unsubscribed ' + irfName + '.</p>',
                                        showCancelButton: false,
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'Close!',
                                        allowOutsideClick: false
                                    }).then(function () {
                                        window.location = "/IRF/Index";
                                    })
                                }
                                else if (result.dismiss === 'cancel') {
                                    swal.fire(
                                        'Cancelled',
                                        '',
                                        'error'
                                    )
                                }
                            })


                        }


                        function AddComments(id) {

                            var url = '/IRF/SampleQuestions?id=' + id;
                            window.location.href = url;
                        };
                        function SelectedInterviewMeetings(id, IRFid) {

                            var url = '/IRF/SelectedInterviewMeetings?id=' + id + '&irfId=' + IRFid;
                            window.location.href = url;
                        };
                        function InterviewMeetings(id, IRFid) {

                            var url = '/IRF/InterviewMeetings?id=' + id + '&irfId=' + IRFid;
                            window.location.href = url;
                        };
                        //Candidates
                        function Candidates(id, IRFid) {

                            var url = '/IRF/Candidates?id=' + id + '&irfName=' + IRFid;
                            window.location.href = url;
                        };
                        function EditIRF(id) {

                            var url = '/IRF/EditIRF?id=' + id;
                            window.location.href = url;
                        };
                        function stats(id, IRFid) {

                            var url = '/IRF/Stats?id=' + id + '&irfId=' + IRFid;
                            window.location.href = url;
                        };
                        function UnArchiveIRF(id) {

                            var url = '/IRF/UnArchiveIRF?id=' + id;
                            window.location.href = url;
                        };

                        function PauseIRF(irfId, irfName) {

                            swal.fire({
                                title: 'Are you sure?',
                                text: "The IRF will be paused!",
                                type: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes, pause it!',
                                preConfirm: function () {
                                    return new Promise(function (resolve, reject) {
                                        $.ajax({
                                            url: '/IRF/PauseIRF?irfId=' + irfId + '&irfName=' + irfName,
                                            success: function (result) {
                                                resolve(result)

                                            },
                                            error: function () {
                                                //reject("error message")
                                                swal.fire("Error pausing!", "Please try again", "error");
                                            }
                                        })
                                    })
                                },
                                allowOutsideClick: false
                            }).then(function (result) {
                                if (result.dismiss !== 'cancel') {
                                    swal.fire({
                                        title: 'Paused!',
                                        type: 'success',
                                        html: '<p>IRF has been paused.</p>',
                                        showCancelButton: false,
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'Close!',
                                        allowOutsideClick: false
                                    }).then(function () {
                                        window.location = "/IRF/Index";
                                    })
                                }
                                else if (result.dismiss === 'cancel') {
                                    swal.fire(
                                        'Cancelled',
                                        'IRF has not been paused!',
                                        'error'
                                    )
                                }
                            })

                            changeColor('red');
                        }

                        function PlayIRF(irfId, irfName) {

                            swal.fire({
                                title: 'Are you sure?',
                                text: "The IRF will be enabled!",
                                type: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Yes, play it!',
                                preConfirm: function () {
                                    return new Promise(function (resolve, reject) {
                                        $.ajax({
                                            url: '/IRF/PlayIRF?irfId=' + irfId + '&irfName=' + irfName,
                                            success: function (result) {
                                                resolve(result)

                                            },
                                            error: function () {
                                                //reject("error message")
                                                swal.fire("Error playing!", "Please try again", "error");
                                            }
                                        })
                                    })
                                },
                                allowOutsideClick: false
                            }).then(function (result) {
                                if (result.dismiss !== 'cancel') {
                                    swal.fire({
                                        title: 'Played!',
                                        type: 'success',
                                        html: '<p>IRF has been enabled.</p>',
                                        showCancelButton: false,
                                        confirmButtonColor: '#3085d6',
                                        confirmButtonText: 'Close!',
                                        allowOutsideClick: false
                                    }).then(function () {
                                        window.location = "/IRF/Index";
                                    })
                                }
                                else if (result.dismiss === 'cancel') {
                                    swal.fire(
                                        'Cancelled',
                                        'IRF has not been enabled! :)',
                                        'error'
                                    )
                                }
                            })
                            changeColor("yellow");
                        }

                        //UnArchiveIRF
                    </script>
