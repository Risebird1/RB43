<script>
    function InvoicePopUp(id, irfName) {
        irfId = id;
        irfName = irfName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
    }

    function SavePopUp() {
        var sDate = $("#stDateInvoice").val();
        var endDate = document.getElementById("EndDateInvoice").value;

        var srNumber = $("#srNumberId").val();
        var poNumber = $("#poNumberId").val();
        var reqNumber = $("#requestNumberId").val();
        var currencyCode = $("#currencyCodeId").val();
        var projectCode = $("#projectCodeId").val();
        var discount = $("#discountId").val();
        var clientAddress = $("#clientAddressId").val();
        var isGST = document.getElementById("gstCheckId").checked
        if (sDate == "" || endDate == "" || srNumber == "" || poNumber == "" || reqNumber == "" || currencyCode == "" || projectCode == "" || discount == "" || clientAddress == "") {
            document.getElementById("popUp_Error").innerHTML = "Kindly fill all fields.";
            return;
        }
        else {
            document.getElementById("popUp_Error").innerHTML = "";
        }
        var url = '/IRF/Invoice?irfId=' + irfId + '&irfName=' + irfName + '&startDate=' + sDate + '&endDate=' + endDate + '&srNumber=' + srNumber + '&poNumber=' + poNumber + '&reqNumber=' + reqNumber + '&currencyCode=' + currencyCode + '&projectCode=' + projectCode + '&isGST=' + isGST + '&discount=' + discount + '&clientAddress=' + clientAddress;
        window.location.href = url;
    }

    function changeColor(tileColor) {
        localStorage.removeItem("localStorageforColorName");
        localStorage.setItem('localStorageforColorName', 'localStorageforColor');
        let value = localStorage.getItem('localStorageforColorName');
        if (value) {
            $(document).ready(function () {
                $("#divTile").css({ "backgroundColor": tileColor });
            });
        }
    }
    function EditSchedulerEvent(schedulerlink) {
        if (schedulerlink != '') {
            var _uniqueid = schedulerlink.split('?')[schedulerlink.split('?').length - 1].split('=')[1];
            window.location.href = "/InterviewScheduler/IRFSchedulerEventEdit?id=" + _uniqueid;
        }
    }
</script>
<script>
    function closeBroadcastModal() {
        var modal = document.getElementById("broadcastModal");
        modal.style.display = "none";
    }
    function OpenBroadcastModal(irfid, Irfname) {
        var modalBct = document.getElementById("broadcastModal");
        modalBct.style.display = "block";
        $("#hid_irfid_broadcast").val(irfid);
        $("#boradcastIrfName").text(Irfname);
        return;
    }

    function SendBroadcast() {
        var message = document.getElementById("bcMessage").value;
        var subject = document.getElementById("bcSubject").value;
        var irfid = document.getElementById("hid_irfid_broadcast").value;
        $.ajax({
            type: "POST",
            url: "/IRF/BroadcastIRFmembers",
            data: { 'message': message, 'subject': subject, 'irfid': irfid },
            success: function (data) {
                window.location.href = '/IRF/Index';
            }
        });
    }
    function closeVoiceRecordingModal() {
        var modalBct = document.getElementById("VoiceRecordingModal");
        modalBct.style.display = "none";
        cancelRecording();
    }
    function OpenVoiceRecordingModal(irfid, Irfname) {
        $.ajax({
            type: "POST",
            url: "/IRF/FetchIRFAudioLink",
            data: { 'irfid': irfid },
            success: function (data) {
                if (data !== null) {
                    document.getElementById('anchorAudioId').href = data;
                    splitData = data.split("/");
                    document.getElementById('anchorAudioId').innerHTML = splitData[splitData.length - 1];
                    document.getElementById('controlAudioId').src = data;
                }
                else {
                    document.getElementById('anchorAudioId').innerHTML = null;
                    document.getElementById('controlAudioId').src = null;
                }
            }
        });
        var modalBct = document.getElementById("VoiceRecordingModal");
        modalBct.style.display = "block";
        var html = '';
        html += '<div class="col-lg-5 col-md-5 col-sm-4 col-xs-5">';
        html += '<div class="pull-left" style="padding:10px"><button id="startRecButton" onclick="startRecording()" style="background-color:#42a5f5 !important;border-radius:50%;margin: 4px 2px;" title="Start Recording"><i class="fa fa-play" ></i></button></div>';
        html += '<div class="pull-left" style="padding:10px"><button id="stopRecButton" type="button" onclick="stopIRFRecording(' + irfid + ')" style="background-color:red !important;border-radius:50%;margin: 4px 2px;" title="Stop Recording" disabled><i class="fa fa-stop"></i></button></div>';
        html += '<div class="pull-left" style="padding:10px"><button id="cancelRecButton" type="button" onclick="cancelRecording()" style="background-color:red !important;border-radius:50%;margin: 4px 2px;" title="Cancel Recording" disabled><i class="fa fa-close"></i></button></div>';
        html += '   </div>';
        html += '<div class="col-lg-7 col-md-7 col-sm-7 col-xs-7">';
        html += '<div class="row">';
        html += '   <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:center">';
        html += '       <p style="font-size:18px" id="recordingStatus"></p>';
        html += '   </div>';
        html += '</div>';
        html += '<div class="row" id="recordingRow" style="display:none">';
        html += '   <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:center">';
        html += '       <div id="recordingsList"></div>';
        html += '   </div>';
        html += '</div>';
        html += '</div>';
        $("#divIRFaudioRecording").empty().html(html);
    }
</script>
