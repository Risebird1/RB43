@model IEnumerable<Risebird.Entities.ViewModel.CallibrationCallVM>
@{

    ViewData["Title"] = "Calibration Meetings";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div>Calibration Meetings</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Calibration Meetings</h4></div>
                </div>
                <div class="pull-left">
                    @if (ViewBag.Type == "UpComing")
                    {
                        <div class="feedback-tab-ac" onclick="Changeurldetails('UpComing','@ViewBag.ReturnBack')"><strong>UpComing</strong></div>
                        <div class="feedback-tab" onclick="Changeurldetails('Completed','@ViewBag.ReturnBack')"><strong>Completed</strong></div>
                    }
                    else
                    {
                        <div class="feedback-tab" onclick="Changeurldetails('UpComing','@ViewBag.ReturnBack')"><strong>UpComing</strong></div>
                        <div class="feedback-tab-ac" onclick="Changeurldetails('Completed','@ViewBag.ReturnBack')"><strong>Completed</strong></div>
                    }
                </div>
               
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="scrollbar int-table" id="style-2">
                                    <div id="tableID" class="second ">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th style="border-right: 0px !important;">Skill Channel</th>
                                                    <th style="border-left: 0px !important;">Meeting Date</th>
                                                    <th style="text-align:left">Meeting Link</th>
                                                    <th style="text-align:left">JD Title</th>
                                                    <th class="text-left">Created on</th>
                                                    <th class="text-center">Created By</th>
                                                    <th class="text-center">Video</th>
                                                    <th class="text-center">Transcript</th>
                                                    <th class="text-center">Channel Owner</th>
                                                    <th class="text-center">Notes</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th style="border-right: 0px !important;">Skill Channel</th>
                                                    <th style="border-left: 0px !important;">Meeting Date</th>
                                                    <th style="text-align:left">Meeting Link</th>
                                                    <th style="text-align:left">JD Title</th>
                                                    <th class="text-left">Created on</th>
                                                    <th class="text-center">Created By</th>
                                                    <th class="text-center">Video</th>
                                                    <th class="text-center">Transcript</th>
                                                    <th class="text-center">Channel Owner</th>
                                                    <th class="text-center">Notes</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @if (Model.Count() == 0)
                                                {
                                                    <tr>
                                                        <td colspan="10" class="text-center">No data available in table</td>
                                                    </tr>
                                                }

                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFName</td>
                                                        <td>@item.MeetingDate</td>
                                                        @if (!string.IsNullOrWhiteSpace(item.MeetingLink))
                                                        {
                                                            <td><a target="_blank" href="@item.MeetingLink">Meeting Link</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        <td>@item.JDTiltle</td>
                                                        <td>@item.CreatedOn</td>
                                                        <td>@item.CreatedBy</td>
                                                        @if (!string.IsNullOrWhiteSpace(item.VideoLink))
                                                        {
                                                            <td><a target="_blank" href="@item.VideoLink">Video</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.TranscriptLink))
                                                        {
                                                            <td><a target="_blank" href="@item.TranscriptLink">Transcript</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        <td>@item.ChannelOwner</td>
                                                        <td class="text-center">
                                                            @{
                                                                var notesUrl = Url.Action("CalibrationMeetingNotes", "IRF", new { id = item.id });
                                                            }
                                                            <a href="@notesUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation(); window.open(this.href, '_blank'); return false;">Notes</a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    function Changeurldetails(type,returnType) {
        window.location.href = "/IRF/CalibrationMeetingsDetails?type=" + type + "&returnBack=" + returnType;
    }
</script>
