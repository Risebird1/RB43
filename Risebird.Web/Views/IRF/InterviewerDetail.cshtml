@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interviewers</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                       

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                @*<div class="text-right">
                <button type="button" style="margin-top:-108px;" class="btn btn-primary"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interviewer" onclick="location.href='@Url.Action("AddInterviewer","User")'" data-original-title="Tooltip on top"> Add Interviewer</span></button>
            </div>*@
                            </div>
                            <div class="row">
                                <div class="card-header">
                                    <h4 class="card-title">Interviewers</h4>
                                </div>

                                <div style="width: 100%;">&nbsp;</div>
                                @foreach (var item in Model)
                                {<div class="col-lg-4 col-md-6 col-sm-6 col-xs-6">


                                        <div class="detail" Onclick="callingfunction('@item.id')">
                                            <h6>@item.FirstName @item.LastName</h6>
                                            <p>@item.EmailId</p>
                                            <p>Primary Skills:- @item.PrimarySkill</p>

                                        </div>
                                    </div>
                                }

                            </div>
                        </div>


                        </div>
                </div>
            </div>
        </div>
    </div>

</div>
<script type="text/javascript">
    //// script for loader starts here
    function callingfunction(value) {
        window.location.href = "/IRF/InterviewerDetailById?Id=" + value;


    }
</script>
