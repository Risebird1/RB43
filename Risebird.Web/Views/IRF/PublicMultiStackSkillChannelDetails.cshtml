@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Interview Channel Stats";
    ViewBag.PageHeader = "Interview Channel Stats";
    if (ViewBag.PageStatus == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}

@if (HttpContextAccessor.HttpContext.Session.GetString("MultiStackSkillChannelDetailsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<SkillChannelDetailsFilter>(HttpContextAccessor.HttpContext.Session.GetString("MultiStackSkillChannelDetailsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
