<script>
    function Startloader() {
        $(".loader").show();
        $(".dataloading").hide();
    }
    function Stoploader() {
        $(".loader").hide();
        $(".dataloading").show();
    }
    function ChangeChanneldetails(type, emailid, uniqueid, isclient) {
        if (type == "DayStats") {
            window.location.href = "/IRF/DateChannelDetails?emailid=" + emailid + "&isClientLogin=" + isclient + "&uniqueid=" + uniqueid;
        } else {
            window.location.href = "/IRF/PublicMultiStackSkillChannelDetails?emailid=" + emailid + "&isClientLogin=" + isclient + "&uniqueid=" + uniqueid;
        }
    }
</script>
<script>
    function PlayIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The IRF will be enabled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, play it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PlayIRF?irfId=' + irfId + '&irfName=' + irfName,
                        type: 'POST',
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Played!',
                    type: 'success',
                    html: '<p>IRF has been enabled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been enabled! :)',
                    'error'
                )
            }
        })
        changeColor("yellow");
    }
    function PauseIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The IRF will be paused!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, pause it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PauseIRF?irfId=' + irfId + '&irfName=' + irfName,
                        type: 'POST',
                        success: function (result) {
                            resolve(result);
                        },
                        error: function () {
                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Paused!',
                    type: 'success',
                    html: '<p>IRF has been paused.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been paused!',
                    'error'
                )
            }
        })
        changeColor('red');
    }
    function changeColor(tileColor) {
        localStorage.removeItem("localStorageforColorName");
        localStorage.setItem('localStorageforColorName', 'localStorageforColor');
        let value = localStorage.getItem('localStorageforColorName');
        if (value) {
            $(document).ready(function () {
                $("#divTile").css({ "backgroundColor": tileColor });
            });
        }
    }
</script>
@if (ViewBag.PageStatus == "Public")
{
    <script>
        $(document).ready(function () {
            document.getElementById("main-panel").classList.remove("main-panel");
        });
        function ResetFilter() {
            var email = $("#hiddemail").val();
            var uniqueid = $("#hidduniqueid").val();
            var loginStatus = $("#hiddLoginStatus").val();
            window.location.href = "/IRF/ResetPublicSkillChannelDetailsFilter?emailid=" + email + "&uniqueid=" + uniqueid + "&isClientLogin=" + loginStatus;
        }
    </script>
}
else
{
    <script>
        function ResetFilter() {
            window.location.href = "/IRF/ResetSkillChannelDetailsFilter";
        }
    </script>
}

