@model Risebird.Entities.ViewModel.IRFVm

@{
    ViewData["Title"] = "Edit Skills Channel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Skills Channel</a>
                <a class="navbar-brand">Edit Skill Channel</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        <form action="/IRF/EditIRF" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid" id="irfForm" onsubmit="return CheckTotalWeightage()">


                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="row">
                                <div class="card-header">
                                    <h4 class="card-title">Edit IRF</h4>
                                </div>
                                <div style="width: 100%;">&nbsp;</div>
                                <div class="col-md-3 col-sm-3 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IRFId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(m => m.IRFId, new { htmlAttributes = new { @class = "form-control text-box single-line", @onblur = "IRFNameChanged()" } })
                                        <label class="text-danger" id="uniqueMsg" style="color:red; position:absolute;"></label>
                                        @Html.ValidationMessageFor(model => model.IRFId, "", new { @class = "text-danger" })


                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 px-1">
                                    <div class="form-group">
                                        <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" for="Name">Client Name</label>
                                        @Html.TextBoxFor(m => m.ClientCompName, new { @class = "form-control text-box single-line", @readonly = "readonly" })


                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CalendlyLink, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.CalendlyLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.CalendlyLink, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-3 pr-r">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PriorityLevel, htmlAttributes: new { @class = "control-label  col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownList("PriorityLevel", Model.PriorityLevelList, new { @class = "form-control select-css" })

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 col-sm-12">
                            
                                    <div class="mdc-form-field  m10-b" >

                                        <div class="mdc-checkbox">
                                            @Html.CheckBoxFor(m => m.IsBiometricEnabled, new { @class = "mdc-checkbox__native-control"})


                                            <div class="mdc-checkbox__background">
                                                <svg class="mdc-checkbox__checkmark"
                                                     viewBox="0 0 24 24">
                                                    <path class="mdc-checkbox__checkmark-path"
                                                          fill="none"
                                                          d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                </svg>
                                                <div class="mdc-checkbox__mixedmark"></div>
                                            </div>
                                            <div class="mdc-checkbox__ripple"></div>


                                        </div>
                                        @Html.LabelFor(model => model.IsBiometricEnabled, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "font-size: 13px; " })
                                    </div>
                                
                             
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2 class="mt-0" >Job Details</h2>
                                    </div><!--end of multiple location-->
                                </div><!--end of col-md-12-->
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.JDTiltle, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.JDTiltle, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.JDTiltle, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CompanyType, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.DropDownListFor(m => m.CompanyType, (SelectList)Model.CompanyTypeList, new { @class = "form-control select-css" })

                                        @Html.ValidationMessageFor(model => model.CompanyType, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ClientName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.ClientName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.ClientName, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.JobCountry, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.JobCountry, new { htmlAttributes = new { @class = "form-control  text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.JobCountry, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                                <div class="col-md-4 col-sm-4 px-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control text-box single-line", @Value = Model.StartDate.ToString("dd/MM/yyyy"), @onblur = "checkStartDate(this.value)" } })
                                        <span class="text-danger col-lg-12 col-md-12 col-sm-12 col-xs-12" id="startDateCheck" style="display:none;"></span>
                                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EndDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "form-control text-box single-line", @Value = Model.EndDate.ToString("dd/MM/yyyy"), @onblur = "checkEndDate(this.value)" } })
                                        <span class="text-danger col-lg-12 col-md-12 col-sm-12 col-xs-12" id="endDateCheck" style="display:none;"></span>
                                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NoOfPosition, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.NoOfPosition, new { htmlAttributes = new { @class = "input form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.NoOfPosition, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                    </div>
                                    <div class="form-group  mb-0">
                                        @Html.LabelFor(model => model.NoOfIntterview, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.NoOfIntterview, new { htmlAttributes = new { @class = "input form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.NoOfIntterview, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>

                                    </div>
                                    <div class="form-group">
                                        Upload Company Details
                  
                                        <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="companydetails" name="companydetails" value="Upload" onclick="RadioCompanyChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>

                                        Provide Company Details
                                    
                                        <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="JcompanydetailsD" name="companydetails" value="Link" onclick="RadioCompanyChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>


                                        None
                                      
                                        <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="companydetails" name="companydetails" value="None" checked="checked" onclick="RadioCompanyChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>



                                    </div>
                                    <div class="form-group" style="display:none" id="linkcdDiv">
                                        @Html.LabelFor(model => model.CompanyDetails, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.CompanyDetails, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.CompanyDetails, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="" style="display:none" id="uploadcdDiv">
                                        @Html.LabelFor(model => model.CompanyDetailFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.CompanyDetailFile, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt, .pptx" })

                                    </div>
                                    <div class="">
                                        @{
                                            if (!String.IsNullOrEmpty(Model.CompanyDetails))
                                            {
                                                <a id="companydetailsId" target="_blank" rel="tooltip" class="btn btn-warning btn-sm  col-lg-12" data-original-title="" title="Download your uploaded file" href=@Model.CompanyDetails.ToString().Replace(" ","%20")>Uploaded Company Details</a>
                                            }
                                        }
                                    </div>

                                </div>
                                <div class="col-md-4 col-sm-4 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PerMintuteRate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.PerMintuteRate, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number", @min = "1" } })
                                        @Html.ValidationMessageFor(model => model.PerMintuteRate, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.TotalBudget, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.TotalBudget, new { htmlAttributes = new { @class = "input form-control text-box single-line", @type = "number", @min = "1" } })
                                        @Html.ValidationMessageFor(model => model.TotalBudget, "", new { @class = "text-danger" })
                                        <div class="spinner">
                                            <button type="button" class="up button">&rsaquo;</button>
                                            <button type="button" class="down button">&lsaquo;</button>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RisebirdHr, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.DropDownListFor(m => m.RisebirdHr, (SelectList)ViewBag.RiseBirdHR, new { @class = "form-control select-css" })
                                        @Html.ValidationMessageFor(model => model.RisebirdHr, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group mb-0" >
                                        @Html.LabelFor(model => model.JobLevel, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownList("JobLevel", (SelectList)ViewBag.JobLevelList, new { @class = "form-control select-css" })
                                        @Html.ValidationMessageFor(model => model.RisebirdHr, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="form-group mb-0">

                                        Upload JD

                                        <div class="mdc-touch-target-wrapper" style="top: 4px;  position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Upload" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>



                                        Provide JD link

                                        <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Link" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>

                                        None

                                        <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="None" checked="checked" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="form-group mb-0" style="display:none" id="linkDiv">
                                        @Html.LabelFor(model => model.JDLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })
                                        @Html.EditorFor(model => model.JDLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.JDLink, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="" style="display:none" id="uploadDiv">
                                        @Html.LabelFor(model => model.JDFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.JDFile, new { type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })

                                    </div>
                                    <div class="upload">
                                        @{
                                            if (!String.IsNullOrEmpty(Model.JDLink))
                                            {
                                   <a style="text-decoration:none;" id="audioId" target="_blank" rel="tooltip" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded  col-lg-12" data-original-title="" title="Download your uploaded file" href=@Model.JDLink.ToString().Replace(" ","%20")>Uploaded JD</a>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Tech Skill Metric</h2>
                                    </div><!--end of multiple location-->
                                </div><!--end of col-md-12-->


                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive-sm">
                                        <table class="table table-bordered mbn" id="SkillTable">
                                            <thead>
                                                <tr>

                                                    <th width="15%" class="table_heading">Level</th>
                                                    <th width="65%" class="table_heading">Skill Name</th>
                                                    <th width="10%" class="table_heading">Weightage</th>
                                                    <th width="10%" class="table_heading text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                {
                                                    <tr>

                                                        <td>

                                                            @Html.DropDownListFor(m => m.SkillCollection[i].LevelId, (SelectList)ViewBag.LevelTech, new { @class = "form-control select-css" })

                                                        </td>
                                                        <td>
                                                            @Html.DropDownListFor(m => m.SkillCollection[i].SkillId, (SelectList)ViewBag.Skill, new { @class = "select-css form-control", @onchange = "TechSkillChanged()" })
                                                        </td>

                                                        <td>
                                                            @Html.EditorFor(m => m.SkillCollection[i].Weightage, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                                        </td>

                                                        <td class="action text-center">
                                                            <div>

                                                                <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>

                                                                @*<button class="mdc-fab app-fab--absolute" aria-label="Add">
                                                                    <span id="btnPlus" onclick="AddRow()" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                                                                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z">
                                                                    </path>
                                                                    </svg>
                                                                    </span>
                                                                </button>*@


                                                                <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                                    <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage','', 'TechDelete')" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                                </button>




                                                                <!--<span id="btnPlus" onclick="AddRow()" class="btn btn-round btn-default btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
    <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage','', 'TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>-->
                                                            </div>
                                                        </td>
                                                    </tr>

                                                }


                                            </tbody>
                                        </table>
                                        <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:807px"></label>

                                    </div>
                                </div><!--end of col-md-12-->

                            </div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Joinability Metric</h2>
                                    </div><!--end of multiple location-->
                                </div><!--end of col-md-12-->


                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive-sm">
                                        <table class="table table-bordered mbn" id="JoinabilityTable">
                                            <thead>
                                                <tr>

                                                    <th width="15%" class="table_heading">Level</th>
                                                    <th width="25%" class="table_heading">Type</th>
                                                    <th width="40%" class="table_heading">Value</th>
                                                    <th width="10%" class="table_heading">Weightage</th>
                                                    <th width="10%" class="table_heading text-center">Action</th>
                                                </tr>
                                            </thead>


                                            <tbody>

                                                @for (int i = 0; i < Model.Joinability.Count(); i++)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.DropDownListFor(m => m.Joinability[i].LevelId, (SelectList)ViewBag.Level, new { @class = "form-control select-css" })

                                                        </td>
                                                        <td>
                                                            @Html.DropDownListFor(m => m.Joinability[i].Type, (SelectList)Model.JoinabilityTypeList, new { @class = "form-control select-css" })

                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(m => m.Joinability[i].Value, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })

                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(m => m.Joinability[i].Weightage, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                                        </td>
                                                        <td class="action text-center">

                                                            <div>
                                                                <span id="btnPlus" onclick="AddJoinabilityRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>


                                                                @*<button class="mdc-fab app-fab--absolute" aria-label="Add">
