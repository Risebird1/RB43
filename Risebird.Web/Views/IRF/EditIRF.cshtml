                                    <div class="tab-box" id="tab-2">
                                        <div class="tab-main-box ">
                                            <div class="row">
                                                <div class="col-md-4 col-sm-4 pr-1">
                                                    <div class="form-group">
                                                        <div class="mandate">
                                                            @Html.LabelFor(model => model.JDTiltle, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })<span class="red">*</span>
                                                        </div>
                                                        @Html.EditorFor(model => model.JDTiltle, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
