    function validateName() {
        var letterNumber = /^[0-9a-zA-Z]+$/;

        var val = document.getElementById("IRFId").value;
        
        if (val == "") {
            document.getElementById("IRFId").focus();
            document.getElementById("error_IRFName").innerHTML = "The Skill Channel ID should be an exact 10 characters long.";
            return false;
        }
        else if (val.length != 10) {
            document.getElementById("IRFId").focus();
            document.getElementById("error_IRFName").innerHTML = "The Skill Channel ID should be an exact 10 characters long.";
            return false;
        }
        else if (!(val.match(letterNumber))) {
            document.getElementById("IRFId").focus();
            document.getElementById("error_IRFName").innerHTML = "Only Letters and Numbers are allowed.";
            return false;
        }
        else {

            $.ajax({
                type: "GET",
                url: "/IRF/CheckUniqueness",
                data: { 'value': val},
                success: function (response) {
                    if (response == false) {
                        document.getElementById("error_IRFName").innerHTML = "This IRFId already exists. Kindly enter a different IRFId.";
                        document.getElementById("IRFId").focus();
                        return false;
                    }
                    else {
                        document.getElementById("error_IRFName").innerHTML = "";
                        return true;
                    }

                }
            });
            return true;
        }
    }


