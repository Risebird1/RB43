                                                    </div>
                                                    @Html.LabelFor(model => model.IsBiometricEnabled, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label tab-checkbox", @style = "font-size: 13px; " })
                                                </div>

                                            </div>
                                            <div class="col-md-3 col-sm-3 pull-left">

                                                <div class="mdc-form-field" style="margin-bottom: 10px;">


