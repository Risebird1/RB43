                                            <option value="Approved Visa Type">Approved Visa Type</option>
                                            <option value="Max Notice period (Days)">Max Notice period (Days)</option>
                                        </select>*@
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(m => m.Joinability[i].Value, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "text" } })

                                                            @*<input class="form-control text-box single-line" id="@("Joinability_"+i+"__Value")" name="Joinability[@i].Value" type="number" value="100">*@
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(m => m.Joinability[i].Weightage, new { htmlAttributes = new { @class = "form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                                            @*<input class="form-control text-box single-line" id="@("Joinability_"+i+"__Weightage")" name="Joinability[@i].Weightage" type="number" max="100" min="1" value="100">*@
                                                        </td>
                                                        <td>
                                                            @*<a class="btn btn-primary border-white btn-sm" id="btnPlus" onclick="AddJoinabilityRow()">
                                            <span class="glyphicon glyphicon-plus"></span>
                                        </a>

                                        <a class="btn border-white btn-sm btn-danger delete-joinability" id="btnMinus" onclick="DeleteJoinabilityRow(0)">
                                            <span class="glyphicon glyphicon-trash"></span>
                                        </a>*@
                                                            <div class="form-control">
                                                                <span id="btnPlus" onclick="AddJoinabilityRow()" class="btn btn-round btn-default btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="DeleteRowSkills(this, 'Joinability','LevelId','Type','Value','Weightage')" class="btn btn-round btn-danger btn-icon btn-sm delete-joinability"><i class="far fa  fa-trash"></i></span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                        <label class="text-danger" id="Joinability_WeightageError" style="color:red; margin-left:900px"></label>

                                    </div>
                                </div><!--end of col-md-12-->

