                                    <div class="table-responsive">
                                        <table class="table table-bordered mbn" id="SelectabilityTable">
                                            <thead>
                                                <tr>

                                                    <th class="table_heading">Level</th>
                                                    <th class="table_heading">Type</th>
                                                    <th class="table_heading">Value</th>
                                                    <th class="table_heading">Weightage</th>
                                                    <th class="table_heading">Action</th>
                                                </tr>
                                            </thead>


                                            <tbody>

                                                @for (int i = 0; i < Model.Selectability.Count(); i++)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.DropDownListFor(m => m.Selectability[i].LevelId, (SelectList)ViewBag.Level, new { @class = "form-control" })

                                                        </td>
                                                        <td>
                                                            @Html.DropDownListFor(m => m.Selectability[i].Type, (SelectList)Model.SelectabilityTypeList, new { @class = "form-control" })


                                                            @*<select class="form-control" id="@("Selectability_"+i+"__Type")" name="Selectability[@i].Type">
                                            <option value="Technology Stack">Technology Stack</option>
                                            <option value="Career Progression">Career Progression</option>
                                            <option value="Industry">Industry</option>
                                            <option value="Domain">Domain</option>
