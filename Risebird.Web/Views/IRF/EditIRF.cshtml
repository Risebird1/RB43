    function InterviewerChanged(val, id) {

        var index = id.charAt(22);
        var skillElementid = 'InterviewerCollection_' + index + '__PrimarySkill';
        $.ajax({
            type: "GET",
            url: "/IRF/GetInterviewerSkills",
            data: { 'id': val },
            success: function (data) {
                $("#" + skillElementid).val(data);
            }
        });


    }

