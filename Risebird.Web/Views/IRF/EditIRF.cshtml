                                                            @*<label class="text-danger" id="uniqueMsg" style="color:red; position:absolute;"></label>*@
                                                            @Html.ValidationMessageFor(model => model.IRFId, "", new { @id = "error_IRFName", @class = "text-danger", @style = "position:absolute" })

                                                        </div>
                                                    </div>

