    function BindSkillsAndRate(id, data, rateElementId = null, rate = null) {
        var num = id.match(/(\d+)/);
        var index = num[0];
        var idArray = id.split('_');
        var skillElementid = idArray[0] + '_' + index + '__PrimarySkill';
        $("#" + skillElementid).val(data);
        if (rate != null && rateElementId != null) {
            $("#" + rateElementId).val(rate);

        }
    }

    function InterviewerChanged(val, id) {
        var index = id.split('_')[1];
