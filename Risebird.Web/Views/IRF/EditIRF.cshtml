                                                            @Html.LabelFor(model => model.JobCountry, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })<span class="red">*</span>
                                                        </div>
                                                        @{
                                                            var countryTypeList = new List<SelectListItem>();
                                                            countryTypeList.Add(new SelectListItem() { Value = "1", Text = "India" });
                                                            countryTypeList.Add(new SelectListItem() { Value = "2", Text = "Outside India" });
                                                        }

                                                        @Html.DropDownListFor(model => model.JobCountry, countryTypeList, "Select", new { @class = "select-css form-control text-box single-line", @onchange = "TechSkillChanged()" })
                                                        @*@Html.EditorFor(model => model.JobCountry, new { htmlAttributes = new { @class = "form-control  text-box single-line" } })*@
                                                        @Html.ValidationMessageFor(model => model.JobCountry, "", new { @id = "error_JobCountry", @class = "text-danger" })
                                                    </div>
