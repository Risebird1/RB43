    var irfName = document.getElementById("IRFId").value;
    function IRFNameChanged() {

        var name = document.getElementById("IRFId").value;
        //var result = checkUniqueness(name);
        //if (result == false);
        //{
        //    return;
        //}
        var element = document.getElementById("btnUploadSaveAs");

        if (name != irfName) {
            document.getElementById("btnUpload").disabled = true;
            if (element != null) {
                element.disabled = false;
            }

        }
        else {
            document.getElementById("btnUpload").disabled = false;
            if (element != null) {
                element.disabled = true;
            }
        }
    }

