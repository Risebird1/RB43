@model Risebird.Entities.ViewModel.TechSkillComments

@{
    ViewData["Title"] = "Sample Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }
    .buttons {
        border: none;
        font-family: inherit;
        font-size: inherit;
        color: inherit;
        background: none;
        cursor: pointer;
        padding: 8px 16px;
        display: inline-block;
        margin: 20px 5px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        outline: none;
        position: relative;
        -webkit-transition: all 0.3s;
        -moz-transition: all 0.3s;
        transition: all 0.3s;
        font-family: Arial, sans-serif;
    }

        .buttons:after {
            content: '';
            position: absolute;
            z-index: -1;
            -webkit-transition: all 0.3s;
            -moz-transition: all 0.3s;
            transition: all 0.3s;
        }

    .button-2 {
        background: #4fa4fb;
        color: #fff;
        -webkit-box-shadow: 0 3px #3884d2;
        -moz-box-shadow: 0 3px #3884d2;
        box-shadow: 0 3px #3884d2;
        -webkit-transition: none;
        -moz-transition: none;
        transition: none;
    }

    .button-2b {
        border-radius: 5px 5px 5px 5px;
        box-shadow: 0 3px #3884d2;
    }

        .button-2b:hover {
            box-shadow: 0 4px #3884d2;
            top: 0px;
        }

        .button-2b:active {
            outline: 0;
            border: 0;
        }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .table-responsive {
        overflow: hidden;
    }
</style>
<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Interview Request Forms</a>
                <a class="navbar-brand">Sample Questions</a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Sample Questions</h4>
                    </div>
                    <div class="card-body">
                        <form action="/IRF/SampleQuestions" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">

                            <div class="row">

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive">
                                        <table class="table table-bordered mbn" id="SkillTable">
                                            <thead>
                                                <tr>
                                                    <th class="table_heading">Skill Name</th>
                                                    <th class="table_heading">Questions</th>
                                                    <th class="table_heading">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.SkillCollection.Count() == 0)
                                                {
                                                    <tr>
                                                        <td>

                                                            @Html.DropDownList("SkillCollection[0].Skill", Model.Skills, new { @class = "form-control" })

                                                        </td>



                                                        <td>
                                                            <textarea htmlattributes="{ class = form-control text-box single-line }" id="SkillCollection_0__Comment" name="SkillCollection[0].Comment" style="width:100%" class="valid" aria-invalid="false"></textarea>

                                                        </td>

                                                        <td>

                                                            <span id="btnPlus" onclick="AddRowComments()" class="btn btn-round btn-default btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                            <span id="btnMinus" onclick="DeleteRow(this, 'SkillCollection','Skill','Comment')" class="btn btn-round btn-danger btn-icon btn-sm delete-comment"><i class="far fa  fa-trash"></i></span>

                                                        </td>
                                                    </tr>

                                                }
                                                else
                                                {
                                                    for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                    {
                                                        <tr>
                                                            <td>

                                                                @Html.DropDownListFor(m => m.SkillCollection[i].Skill, Model.Skills, new { @class = "form-control" })
                                                            </td>

                                                            <td>
                                                                @Html.TextAreaFor(m => m.SkillCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%" })
                                                            </td>

                                                            <td>

                                                                <span id="btnPlus" onclick="AddRowComments()" class="btn btn-round btn-default btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="DeleteRow(this, 'SkillCollection','Skill','Comment')" class="btn btn-round btn-danger btn-icon btn-sm delete-comment"><i class="far fa  fa-trash"></i></span>
                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div><!--end of col-md-12-->

                            </div>

                            <div class="card-footer ">
                                <div class="row">
                                    <label class="col-md-5"></label>
                                    <div class="col-md-7 text-right">
                                        @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "buttons button-2 button-2b", @role = "button" })
                                        <button type="submit" class="buttons button-2 button-2b" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>


                            @Html.HiddenFor(m => m.IRFId)
                        </form>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>

<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
    function AddRowComments() {

        var table = document.getElementById("SkillTable");

        var $ttc = $("#SkillTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#SkillTable tr").length - 1;

        $tr.find("textarea,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("textarea[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#SkillTable").find("tbody tr:last").after($tr);

        var $ttlast = $("#SkillTable").find("tbody tr:last");
        $ttlast.find("textarea").val("");

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        //// Check document for changes
        //$.validator.unobtrusive.parse(document);

    }

    function DeleteRow(element, collectionName, tdOne, tdTwo) {

        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {

            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            //ClientCollection_1__ClientRoleId
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    //name="ClientCollection[3].ClientUserId"
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                }

            }

        }


    }


</script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>



@if (Model.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@Model.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@Model.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function () //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/Project/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@Model.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        //window.location.href = '/Project/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}