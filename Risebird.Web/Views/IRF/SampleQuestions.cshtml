@model Risebird.Entities.ViewModel.TechSkillComments

@{
    ViewData["Title"] = "Sample Questions";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isDeletetable = false;
    bool isDisplayable = false;
}
<script>
    var Header = "<a href='/IRF/Index'>Skills Channel</a>&nbsp;/&nbsp;Sample Questions";
    $('#txtpageHeader').empty().html(Header);
</script>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">

    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/IRF/SampleQuestions" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">
                            @Html.AntiForgeryToken()
                            <div class="row">
                                <div class="card-header">
                                    <h4 class="card-title">Sample Questions (Add Your Questions Here)</h4>
                                </div>
                                
                                <div style="width:100%; float:left;height:10px;"></div>
                                @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="sample-qs">
                                        <table class="table mbn" id="SkillTable">
                                            <thead>
                                                <tr>
                                                    <th class="table_heading b-right">Skill Name</th>
                                                    <th class="table_heading b-right">Questions</th>
                                                    <th colspan="2" class="table_heading text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.SkillCollection.Count() == 0)
                                                {
                                                    <tr >
                                                        <td class="b-right">

                                                            @Html.DropDownList("SkillCollection[0].Skill", (SelectList)ViewBag.Skills, new { @class = "select-css form-control" })

                                                        </td>

                                                        <td class="b-right">
                                                            <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                                <div class="talktext">
                                                                    <textarea htmlattributes="{ class = form-control text-box single-line }" id="SkillCollection_0__Comment" style="width:100%" name="SkillCollection[0].Comment" class="valid" aria-invalid="false"></textarea>

                                                                </div>
                                                            </div>



                                                        </td>

                                                        <td class="text-center action-area">
                                                            <div class="sample-btn">
                                                                @*<span id="btnPlus_0" onclick="AddRowComments()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>*@
                                                                <span style="float:right;" id="btnMinus_0" onclick="DeleteRow(this, 'SkillCollection','Skill','Comment', 'UserId')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                            </div>
                                                        </td>
                                                        <td class="HiddenUserIdElement">
                                                        </td>
                                                    </tr>

                                                }
                                                else
                                                {
                                                    for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                    {

                                                        @if(((Model.SkillCollection[i].UserId.HasValue && Model.SkillCollection[i].UserId.Value == Model.UserId) || Model.SkillCollection[i].UserId==null) || Model.Profile=="Admin")
                                                        {
                                                            isDisplayable = true;

                                                        }
                                                        else
                                                        {
                                                            isDisplayable = false;
                                                        }
                                                        string rowDisplayStatus = isDisplayable ? "visible" : "collapse";
                                                        <tr style="visibility: @rowDisplayStatus;" >
                                                                
                                                            <td>
                                                                @if ((Model.SkillCollection[i].UserId.HasValue && Model.SkillCollection[i].UserId.Value == Model.UserId)@*|| Model.Profile=="Admin"*@)
                                                                {
                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].Skill, (SelectList)ViewBag.Skills, new { @class = "select-css form-control" })

                                                                }
                                                                else
                                                                {
                                                                    var newList = new List<SelectListItem>();
                                                                    newList.Add(new SelectListItem() { Value = Model.SkillCollection[i].Skill, Text = ((SelectList)ViewBag.Skills).Where(x => x.Value == Model.SkillCollection[i].Skill).FirstOrDefault()?.Text });

                                                                    if (newList != null && newList.Count() > 0)
                                                                    {
                                                                        @Html.DropDownListFor(m => m.SkillCollection[i].Skill, newList, new { @class = "select-css form-control" })
                                                                    }
                                                                    else
                                                                    {
                                                                        var handleList = new List<SelectListItem>();
                                                                        handleList.Add(new SelectListItem() { Value = Model.SkillCollection[i].Skill, Text = Model.SkillCollection[i].SkillName });

                                                                        @Html.DropDownListFor(m => m.SkillCollection[i].Skill, handleList, new { @class = "select-css form-control", @disabled = "disabled" })

                                                                    }
                                                                }

                                                              
                                                            </td>

                                                                <td >
                                                                    <div class="talk-bubble tri-right border-bubble right-in" style="width:100%;">
                                                                        <div class="talktext">
                                                                            @if (Model.SkillCollection[i].UserId.HasValue && Model.SkillCollection[i].UserId.Value == Model.UserId)
                                                                            {
                                                                                @Html.TextAreaFor(m => m.SkillCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%" })

                                                                            }
                                                                            else
                                                                            {
                                                                                @Html.TextAreaFor(m => m.SkillCollection[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" }, @style = "width:100%", @readonly = "readonly" })

                                                                            }

                                                                        </div>
                                                                    </div>


                                                                </td>

                                                                <td  class="text-center">
                                                                    <div class="sample-btn">
                                                                        @*<span id="btnPlus_@i" onclick="AddRowComments()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>*@

                                                                        @if (((Model.Profile == "Interviewer" || Model.Profile == "HR") && Model.SkillCollection[i].UserId == Model.UserId) || (Model.Profile == "Admin"))
                                                                        {
                                                                            isDeletetable = true;

                                                                        }
                                                                        else
                                                                        {
                                                                            isDeletetable = false;
                                                                        }
                                                                        @{
                                                                            string displayStatus = isDeletetable ? "block" : "none";
                                                                        }
                                                                        <span id="btnMinus_@i" style="display:@displayStatus;float:right;" onclick="DeleteRow(this, 'SkillCollection','Skill','Comment','UserId')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                                    </div>

                                                                </td>
                                                                @Html.HiddenFor(m => m.SkillCollection[i].UserId)
                                                            </tr>

                                                        
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div><!--end of col-md-12-->

                            </div>

                            <div class="card-footer ">
                                <div class="row">
                                    
                                    <div class="col-md-12 mc-button-area">
                                        <div class="pull-left">
                                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add a Question" onclick="AddRow()" data-original-title="Tooltip on top"><font style="font-family:arial;"> Add Question</font></span>
                                            </button>
                                        </div>
                                        @if (Model.Profile == "Interviewer")
                                        {

                                            <button type="button" onclick="location.href='@Url.Action("MyInterview", "Interview")'" class="mdc-button mdc-button--raised mdc-ripple-upgraded">Back to List</button>

                                            @*@Html.ActionLink("Back to List", "MyInterview", "Interview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })*@
                                        }
                                        else
                                        {
                                            <button type="button" onclick="location.href='@Url.Action("Index", "IRF")'" class="mdc-button mdc-button--raised mdc-ripple-upgraded">Back</button>

                                            @*@Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })*@

                                        }
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>


                            @Html.HiddenFor(m => m.IRFId)
                            @Html.HiddenFor(m => m.UserId)
                        </form>

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>

</div>




@if (Model.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@Model.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@Model.Message', "success");
            }
            else {
                swal.fire("Failed", '@Model.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}

<script>

    $(document).ready(function () {
        if ('@Model.SkillCollection.Count()' == '0') {
            var x = document.createElement("INPUT");
            x.setAttribute("type", "hidden");
            x.setAttribute("id", 'SkillCollection_0__UserId');
            document.getElementsByClassName("HiddenUserIdElement")[0].appendChild(x);
            $("#SkillCollection_0__UserId").val(@Model.UserId);
            $("#SkillCollection_0__UserId").prop('name', 'SkillCollection[0].UserId');;
            if (document.getElementById('btnMinus_0').style.display == 'none') {
                document.getElementById('btnMinus_0').style.display = "block";

            }

        }
    });

    //$('form').submit(function () {
    //    if ($(this).valid()) {
    //        $(':submit', this).attr('disabled', 'disabled');
    //    }
    //});


    function AddRow() {

        var $ttc = $("#SkillTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        
        //var $tr = $ttc.clone();
        var trIndexReplaced = $("#SkillTable tr").length - 1;

        $tr.find("textarea,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })

        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("textarea[type=text]").val("");
        //$tr.find("textarea[type=text]").removeProp("readonly");
        $tr.find("input[type=hidden]").val(@Model.UserId);

        var rowCount = $('#SkillTable tr').length;

        var finalIndex = rowCount-1;

        $tr.find("input[type=hidden]").prop('id', 'SkillCollection_' + finalIndex + '__UserId');
        $tr.find("input[type=hidden]").prop('name', 'SkillCollection[' + finalIndex + '].UserId');
        $tr.find('span:last').prop('style', 'display:block');
        $tr.find('span:last').prop('id', 'btnMinus_' + finalIndex);
        //$tr.prop('id', 'tr_' + finalIndex);
        $tr.prop('style', 'visibility : visible');
        //$tr.find('td:last').find('span:first').prop('id', 'btnPlus_' + finalIndex);





        // add cloned row as last row
        $("#SkillTable").find("tbody tr:last").after($tr);

        var $ttlast = $("#SkillTable").find("tbody tr:last");
        $ttlast.find("textarea").val("");
        $ttlast.find("textarea").removeProp("readonly");

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        var options = '@Model.SkillsOptionsData';
        optionsData = JSON.parse(options.replace(/&quot;/g, '"'));

        $("#SkillCollection_" + finalIndex + "__Skill" + " option").remove();

        $(optionsData).each(function () {
            var option = $("<option />");

            //Set Text part.
            option.html(this.Name);

            //Set Value part.
            option.val(this.id);

            //Add the Option element to DropDownList.

            $("#SkillCollection_" + finalIndex + "__Skill").append(option);
        });
        //// Check document for changes
        //$.validator.unobtrusive.parse(document);

    }


    function DeleteRow(element, collectionName, tdOne, tdTwo, tdThree) {
        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {

            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            //ClientCollection_1__ClientRoleId
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    //name="ClientCollection[3].ClientUserId"
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                    elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;

                }

            }

        }


    }


</script>