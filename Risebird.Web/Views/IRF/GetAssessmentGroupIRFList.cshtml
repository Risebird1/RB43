@model IEnumerable<Risebird.Entities.ViewModel.AssessmentIRFListVM>
<div>
    @if (Model != null && Model.Count() != 0)
    {
        <div id="style-2" class="scrollers" style="overflow-y:auto">

            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                <thead>
                    <tr>
                        <th>IRFId</th>
                        <th class="text-center">Primary Skill</th>
                        <th class="text-center">Total Meetings</th>
                        <th>Scheduled</th>
                        <th>Completed</th>
                        <th>Selected</th>
                        <th>Rejected</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IRFId</td>
                            <td>@item.PrimarySkillInvite</td>
                            <td>@item.TotalMeetings</td>
                            <td>@item.ScheduledMeetings</td>
                            <td>@item.CompletedMeetings</td>
                            <td>@item.SelectedMeetings</td>
                            <td>@item.RejectedMeetings</td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    }
    else
    {
        <div>
            No  Skill Channel for this Assessment Group
        </div>
    }
</div>

<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>
<style>
    .sb-content {
        overflow-y: scroll;
        box-sizing: border-box;
    }
</style>
