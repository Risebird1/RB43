@model Risebird.Entities.ViewModel.TechSkillComments

@{
    ViewData["Title"] = "Comment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>
<div style="margin-bottom:10px">
    <form action="/IRF/AddComments" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid">
        <div class="row">
            <div class="col-md-12 edit-build nova-cont">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h2 class="panel-title">Add Questions</h2>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-horizontal">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <div class="multiple-row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h2>Tech Skill Matrix</h2>
                                            </div><!--end of multiple location-->
                                        </div><!--end of col-md-12-->


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive">
                                                <table class="table table-bordered mbn" id="SkillTable">
                                                    <thead>
                                                        <tr>
                                                            <th class="table_heading">Skill Name</th>
                                                            <th class="table_heading">Questions</th>
                                                            <th class="table_heading">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        <tr>
                                                            <td>

                                                                @Html.DropDownList("SkillCollection[0].Skill", (SelectList)ViewBag.Skills, new { @class = "form-control" })

                                                            </td>

                                                            <td>
                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Comment" name="SkillCollection[0].Comment" type="text" value="">
                                                            </td>

                                                            <td width="8%">
                                                                <a class="btn btn-primary border-white btn-sm" id="btnPlus" onclick="AddRowComments()">
                                                                    <span class="glyphicon glyphicon-plus"></span>
                                                                </a>

                                                                <a class="btn border-white btn-sm btn-danger delete-comment" id="btnMinus">
                                                                    <span class="glyphicon glyphicon-trash"></span>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div><!--end of col-md-12-->

                                    </div>





                                    <div class="form-group col-sm-12">
                                        <div class="pull-right">
                                            <input type="submit" id="btnUpload" value="Submit" class="btn btn btn-primary">
                                        </div>
                                        <div>
                                            <a href="/IRF/Index">Back to List</a>
                                        </div>
                                    </div>
                                </div>



                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @Html.HiddenFor(m => m.IRFId)
    </form>
</div>
<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #5f95b1;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }
</style>
<script>
    
    function AddRowComments() {
        var table = document.getElementById("SkillTable");
        var rowCount = table.rows.length;
        if (rowCount == 6) {
            alert("Cannot add more than 5 Interviewers.");
            return;
        }

        var $ttc = $("#SkillTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#SkillTable tr").length - 1;

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#SkillTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        // Check document for changes
        $.validator.unobtrusive.parse(document);

    }

