                                                                }
                                                                <td>
                                                                    @if (item.CurrentStatus == "Selected")
                                                                    {
                                                                        <p class="select">@item.CurrentStatus</p>
                                                                    }

                                                                    else if (item.CurrentStatus == "Rejected")
                                                                    {
                                                                        <p class="reject">@item.CurrentStatus</p>
                                                                    }
                                                                    else
                                                                    {
                                                                        <p>@item.CurrentStatus</p>
                                                                    }
                                                                </td>

                                                                <td>
                                                                    @if ((item.CurrentMeetingStatus == 4) && (item.confirmationStatus.HasValue && item.confirmationStatus == 1) && ((item.CurrentInterviewStatus != 4 && item.CurrentInterviewStatus != 2) || (item.QCStatus == 1 && (item.CurrentInterviewStatus == 4 || item.CurrentInterviewStatus == 2))))
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                            <span onclick="location.href = '@Url.Action("AddReport", "Interview", new {  interviewId = item.InterviewId, irfId= item.IRFId, isClient = true,actiontype="IRFCandidate"})'" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="#fff" d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z"></path></svg></span>
                                                                        </button>

                                                                    }
                                                                    else
                                                                    {
                                                                        <p></p>
                                                                    }
                                                                </td>

                                                            </tr>

                                                        }


                                                    </tbody>
                                                </table>

                                            </div>

                                        </div>


                                    </div>
                                </div>


                            </div>
                        </div>


                    </div>
                </div>

            </div>
        </div>


    </div>
</div>

