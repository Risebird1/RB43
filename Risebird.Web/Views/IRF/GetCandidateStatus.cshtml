                                                                    <option value="@(Risebird.Entities.Enum.MeetingStatus.Completed.GetDescription())">@(Risebird.Entities.Enum.MeetingStatus.Completed.GetDescription())</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
