                                                                Interview Status
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                    <option value="@(Risebird.Entities.Enum.InterviewStatus.Proxy.GetDescription())">@(Risebird.Entities.Enum.InterviewStatus.Proxy.GetDescription())</option>
                                                                    <option value="@(Risebird.Entities.Enum.InterviewStatus.Selected.GetDescription())">@(Risebird.Entities.Enum.InterviewStatus.Selected.GetDescription())</option>
                                                                    <option value="@(Risebird.Entities.Enum.InterviewStatus.Rejected.GetDescription())">@(Risebird.Entities.Enum.InterviewStatus.Rejected.GetDescription())</option>
