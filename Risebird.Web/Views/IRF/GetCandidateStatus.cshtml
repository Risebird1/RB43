                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>





                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">


                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>


                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>


                                                                </div>

                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

