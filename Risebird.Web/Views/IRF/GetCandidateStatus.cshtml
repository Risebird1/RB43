                        </span>
                        <span id="getstatus_2">
                            <i type="submit" class="far fa-file-excel excel-file   pull-left" data-toggle="tooltip" data-placement="bottom"  data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("GetCandidateStatusExportToExcel", "IRF", new { id = ViewBag.id })'"></i>
                        </span>
                        <span id="getstatus_3">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" data-bs-toggle="modal" data-bs-target="#filterModal" style="vertical-align:top">

