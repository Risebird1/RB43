<script>
    function DeleteCandidate(id) {

        //var IdIRF = dataID;
        var irfName = '@ViewBag.IRFName';
        var irfId = '@ViewBag.IRFId';

        swal.fire({
            title: 'Are you sure?',
            text: "The candidate will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/IRF/DeleteCandidate?id=' + id + '&irfId=' + irfId + '&IRFName=' + irfName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The candidate has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                    //window.location = "/IRF/Candidates?id=" + irfId + '&irfName=' + irfName;
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your file has been not deleted :)',
                    'error'
                )
            }
        })
    }
</script>

<script>
