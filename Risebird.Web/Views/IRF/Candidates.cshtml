                                                <th>Current Salary</th>
                                                <th>Expected Salary</th>
                                                <th>Notice</th>

                                                <th style="text-align:center">Call</th>

                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Resume</th>
                                                <th>Invite Sent</th>
                                                <th>Invite Confirmation</th>
                                                <th>Joinability Score</th>
                                                <th>Selectability Score</th>
                                                <th> Actions </th>
                                                <th>Type</th>
                                                <th>Location(Applied for)</th>
                                                <th>Skill</th>
                                                <th>Work Auth</th>
                                                <th>Current Location</th>
                                                <th>Current Employer</th>
                                                @*<th>Phone</th>*@
                                                <th>Total Experience</th>
                                                <th>Current Salary</th>
                                                <th>Expected Salary</th>
                                                <th>Notice</th>

                                                <th style="text-align:center">Call</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                string joinabilityColor;
                                                string selectabilityColor;
                                                if (item.JoinabilityScore >= 70)
                                                {
                                                    joinabilityColor = "green";
                                                }
                                                else if (item.JoinabilityScore >= 40 && item.JoinabilityScore < 70)
                                                {
                                                    joinabilityColor = "orange";
                                                }
                                                else
                                                {
                                                    joinabilityColor = "red";
                                                }
                                                if (item.SelectabilityScore >= 70)
                                                {
                                                    selectabilityColor = "green";
                                                }
                                                else if (item.SelectabilityScore >= 40 && item.SelectabilityScore < 70)
                                                {
                                                    selectabilityColor = "orange";
                                                }
                                                else
                                                {
                                                    selectabilityColor = "red";
                                                }
                                            <tr id=@item.id>

                                                <td> @item.Name</td>
                                                <td> @item.EmailId</td>
                                                @if (item.ResumeLink != null && item.ResumeLink != "")
                                                {
                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a> </td>
                                                }
                                                else
                                                {
                                                    <td>No Resume</td>
                                                }
                                                <td>@item.TotalInvites</td>
                                                <td>@item.InviteConfirmation</td>
                                                <td style="color:@joinabilityColor">
                                                    <b>@item.JoinabilityScore</b>
                                                </td>
                                                <td style="color:@selectabilityColor">
                                                    <b>@item.SelectabilityScore</b>
                                                </td>
                                                <td class="text-right">

                                                    @if (ViewBag.Profile != "Recruiter")
                                                    {
                                                        <span onclick="location.href = '@Url.Action("SendInvite", "IRF", new { IRFName = ViewBag.IRFName, irfId = ViewBag.IRFId, emailId = item.EmailId, endDate = item.EndDate })'" title="Send Invite" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-envelope"></i></span>
                                                        <span onclick="location.href = '@Url.Action("CancelInvite", "IRF", new { IRFName = ViewBag.IRFName, irfId = ViewBag.IRFId, emailId = item.EmailId })'" title="Cancel Invite" class="btn btn-round btn-danger btn-icon btn-sm like"><i class="fa fa-times"></i></span>

                                                    }
                                                    <span onclick="location.href = '@Url.Action("EditCandidate", "IRF", new { id = item.id, irfName = ViewBag.IRFName, irfId = ViewBag.IRFId })'" title="Edit" class="btn btn-round btn-warning btn-icon btn-sm edit"><i class="fas fa-edit"></i></span>
                                                    <span onclick="javascript:DeleteCandidate('@item.id');" title="Delete" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-trash"></i></span>
                                                    <span onclick="location.href = '@Url.Action("CandidateReport", "IRF", new { candidateId = item.CandidateMasterId, irfId= item.IRFId})'" title="Report" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-file-pdf-o"></i></span>
                                                    <span onclick="location.href = '@Url.Action("UploadAudio", "IRF", new { candidateId = item.CandidateMasterId, irfId= item.IRFId, rfName=ViewBag.IRFName})'" title="Audio files" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-microphone"></i></span>
                                                    <span onclick="location.href = '@Url.Action("EnrollVoiceItUser", "IRF", new { candidateId = item.CandidateMasterId,candidateEmail=item.EmailId, irfId= item.IRFId, irfName = ViewBag.IRFName})'" title="Enroll User for Biometric verification" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-sign-in"></i></span>


                                                </td>
                                               
                                                <td>@item.Type</td>
                                                <td>@item.Location</td>
                                                <td>@item.Skill</td>
                                                <td>@item.WorkAuth</td>
                                                <td>@item.CurrentLocation</td>
                                                <td>@item.CurrentEmployer</td>
                                                @*<td>@item.Phone</td>*@
                                                <td>@item.TotalExperience</td>
                                                <td>@item.CurrentSalary</td>
                                                <td>@item.ExpectedSalary</td>
                                                <td>@item.Notice</td>

                                                <td>
                                                    @if (item.Phone != null && item.Phone != string.Empty )
                                                    {
                                                        <button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CallButtonClick(@jsonObject)" data-original-title="Tooltip on top"> Call Candidate</span></button>
                                                    }

                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
