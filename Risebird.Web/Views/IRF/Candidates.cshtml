    });
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>

    function FilterInterviews(filterValue) {

        $.ajax({
            type: "GET",
            url: "/Interview/GetFilteredInterviews",
            data: { 'filterValue': filterValue },
            success: function (data) {

                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: false,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>

<script>
    var span = document.getElementById("importPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

</script>
<script>
    function ModalButtonClick() {

        // Get the modal
        var modal = document.getElementById("myModal");

        // When the user clicks the button, open the modal
        modal.style.display = "block";

    }

</script>
<script>
    function DeleteCandidate(id) {

        //var IdIRF = dataID;
        var irfName = '@ViewBag.IRFName';
        var irfId = '@ViewBag.IRFId';

        swal.fire({
            title: 'Are you sure?',
            text: "The candidate will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/IRF/DeleteCandidate?id=' + id + '&irfId=' + irfId + '&IRFName=' + irfName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The candidate has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                    //window.location = "/IRF/Candidates?id=" + irfId + '&irfName=' + irfName;
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your file has been not deleted :)',
                    'error'
                )
            }
        })
    }
</script>

<script>
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function CallButtonClick(candidateObj) {
        candidate = candidateObj.Name;
        // Get the modal
        var modal = document.getElementById("myCallModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(candidateObj.Phone);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }


</script>
