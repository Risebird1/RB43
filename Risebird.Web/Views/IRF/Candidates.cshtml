                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/IRF/Index';
                        location.reload(true);
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        //window.location.href = '/IRF/Index';
                        location.reload(true);

                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}

    
