

@model Risebird.Entities.ViewModel.InvoiceModel





<meta charset="utf-8" />
<link rel="apple-touch-icon" sizes="76x76" href="~/Newassets/img/apple-icon.png">
<link rel="icon" type="image/png" href="~/Newassets/img/favicon.png">
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<!--     Fonts and icons     -->


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">

                <a class="navbar-brand">
                    Invoice
                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body" style="padding:112px">
                        <div class="row">
                            <input type="button" class="btn btn-fill btn-primary pull-right" id="create_pdf"  value="Generate PDF" onclick="getPDF()">
                            @Html.ActionLink("Back", "Index", "IRF", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                        </div>
                            <div class="canvas_div_pdf">
                                <div style="text-align:center">
                                    <img src="~/images/risebird.png">
                                    <h3 style="font-family: 'Merriweather'"><b>RISEBIRD TALENT Solutions (OPC) Private Limited</b></h3>
                                    <h4 style="font-size:18px">
                                        @Model.RisebirdAddress

                                    </h4>
                                </div>
                                <div style="text-align:left">
                                    <p style="font-family: 'Merriweather'; font-size:50px"><b>INTERVIEW INVOICE</b></p>
                                    <p style="font-family:'Merriweather'">
                                        <span style="font-size:18px"><b>Invoice No. @Model.InvoiceNumber</b></span><br />
                                        <span style="font-size:32px; color:blue">
                                            <b>
                                                INVOICE REFERENCE  CODE: @Model.InvoiceReferenceCode
                                            </b>
                                        </span>

                                    </p>

                                </div>
                                <div class="row">
                                    <div class="col-md-8">
                                        <table>
                                            <tr>
                                                <td style="font-size:18px;font-family:Roboto">
                                                    <b>PREPARED FOR</b>
                                                </td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:19px;font-family:Arial">
                                                    <b>@Model.ClientName</b>
                                                </td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:22px;font-family:Calibri">
                                                    @Html.Raw(Model.ClientAddress)
                                                </td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:22px;font-family:Roboto">GSTIN: 29AAACB6820C2Z0</td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:22px;font-family:Roboto">PO Number: @Model.PONumber</td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:22px;font-family:Roboto">SR Number: @Model.SRNumber</td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:22px;font-family:Roboto">Request Number: @Model.RequestNumber</td>

                                            </tr>
                                            <tr>
                                                <td style="font-size:22px;font-family:Roboto">Project Code: @Model.ProjectCode</td>

                                            </tr>

                                        </table>
                                    </div>
                                    <div class="col-md-4">
                                        <table style="font-size:18px;font-family:Roboto">
                                            <tr>
                                                <td>
                                                    <b>PREPARED DATE</b>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td id="preparedDate"></td>


                                            </tr>
                                            <tr>
                                                <td>
                                                    <b>SUBMISSION DATE</b>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td id="submissionDate"></td>

                                            </tr>

                                            <tr>
                                                <td>
                                                    <b>EXPIRY DATE</b>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td id="expiryDate"></td>


                                            </tr>
                                        </table>
                                    </div>

                                </div>
                                <br />
                                <p style="font-size:22px;font-family:Roboto"><b>PURPOSE</b> : Candidate screening services using Expert-Led Video Interviews</p>
                                <table style="border-style:solid;border-color:rgb(229,229,229);border-width:1px" class="tableBill">
                                    <thead style="font-size:20px;font-family:Roboto;background-color:rgb(217,196,177)">
                                        <tr style="height:100px">
                                            <th>Total Number of interviews- (@Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy"))</th>
                                            <th>Number of Interviews for Partial invoice- (@Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")) </th>
                                            <th>Actual Price Per Interview- @Model.CurrencyCode</th>
                                            <th>Discount offered</th>
                                            <th>Discounted Price per Interview</th>
                                            <th>Partial Payable- (@Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")) - @Model.CurrencyCode</th>

                                        </tr>
                                    </thead>
                                    <tbody style="font-family:Arial;font-size:18px">
                                        <tr style="height:35px">
                                            <td>@Model.InterviewCount</td>
                                            <td>@Model.PartialInterviewCount</td>
                                            <td>@Model.PricePerInterview</td>
                                            <td>@Model.Discount%</td>
                                            <td>@Model.DiscountedPricePerInterview</td>
                                            <td>@Model.PartialPayable</td>



                                        </tr>
                                        <tr style="height:35px">
                                            <td></td>
                                            <td colspan="4">
                                                Billable Amount- @Model.CurrencyCode
                                            </td>
                                            <td>
                                                @Model.PartialPayable

                                            </td>
                                        </tr>
                                        <tr style="height:35px">
                                            <td></td>
                                            <td colspan="4">
                                                IGST- @Model.IGSTSymbol
                                            </td>
                                            <td>
                                                @Model.IGST

                                            </td>
                                        </tr>
                                        <tr style="font-size:24px;font-family:Merriweather; background-color:lightgray; height:60px">
                                            <td colspan="5" style="text-align:center;">
                                                <b>Net Payable- @Model.CurrencyCode</b>
                                            </td>
                                            <td><b>@Model.Netpayable@*2,24,672*@</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <br />

                                <ol type="1" style="font-family:Arial;font-size:18px">
                                    <li>Any disputes beyond 7 days of delivery of interview will not be entertained and the invoice will be treated as accepted in full</li>
                                    <li>TAN: @Model.RisebirdTAN</li>
                                    <li>PAN: @Model.RisebirdPAN</li>
                                    <li>GSTIN: @Model.RisebirdGSTIN</li>
                                    <li>CIN: @Model.RisebirdCIN</li>
                                    <li>
                                        Account Details –
                                        <ol type="a">
                                            <li>Bank Name – @Model.RisebirdBankName</li>
                                            <li>Account Name  - @Model.RisebirdAccountName</li>
                                            <li>Account Number – @Model.RisebirdAccountNumber</li>
                                            <li>IFSC – @Model.RisebirdIFSC</li>
                                            <li>ICICI Bank SWIFT Code: @Model.RisebirdICICIBankSwiftCode</li>
                                        </ol>
                                    </li>
                                    <li>Delay in payment will attract interest @Html.Raw("@") 1.5% per month until realization of payment.</li>
                                    <li>All interview recordings and feedback reports will be deleted from our records after the receipt of payment or 30 days of submitting the invoice or whichever is earlier.</li>
                                    <li>In case of drive or where we have used Persistent communication infrastructure or where candidate has restricted the recording or in exception case where candidate has requested for phone call due to some emergency - Video/Audio links shall not be available</li>

                                </ol>



                            </div>


                        </div>

                        <!-- end content-->
                    </div>

                
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

       
        <!-- end row -->

    </div>
    <footer class="footer">
        <div class=" container-fluid ">
           
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>









<script>
    $(document).ready(function () {
        var todayDate = new Date();
        var newDate = new Date();
        newDate.setDate(todayDate.getDate() + 7);
        var currentArr = todayDate.toString().split(' ');
        var expiryArr = newDate.toString().split(' ');
        var currentDate = currentArr[2] + " " + currentArr[1] + ", " + currentArr[3];
        var expiryDate = expiryArr[2] + " " + expiryArr[1] + ", " + expiryArr[3];
        document.getElementById("preparedDate").innerHTML = currentDate;
        document.getElementById("submissionDate").innerHTML = currentDate;
        document.getElementById("expiryDate").innerHTML = expiryDate;


    })

    function getPDF() {
        var HTML_Width = ($(".canvas_div_pdf").width());
        var HTML_Height = ($(".canvas_div_pdf").height());
        var top_left_margin = 15;
        var PDF_Width = HTML_Width + (top_left_margin * 2);
        var PDF_Height = (PDF_Width * 1.5) + (top_left_margin * 2);
        var canvas_image_width = HTML_Width;
        var canvas_image_height = HTML_Height;

        var totalPDFPages = Math.ceil(HTML_Height / PDF_Height) - 1;


        html2canvas($(".canvas_div_pdf")[0], { allowTaint: true }).then(function (canvas) {
            canvas.getContext('2d');


            var imgData = canvas.toDataURL("image/jpeg", 1.0);
            var pdf = new jsPDF('p', 'pt', [PDF_Width, PDF_Height]);
            pdf.addImage(imgData, 'JPG', top_left_margin, top_left_margin, canvas_image_width, canvas_image_height);


            for (var i = 1; i <= totalPDFPages; i++) {
                pdf.addPage(PDF_Width, PDF_Height);
                pdf.addImage(imgData, 'JPG', top_left_margin, -(PDF_Height * i) + (top_left_margin * 4), canvas_image_width, canvas_image_height);
            }

            pdf.save("Invoice.pdf");
        });
    };
</script>




