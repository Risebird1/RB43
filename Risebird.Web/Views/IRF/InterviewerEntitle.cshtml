<div id="myModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Call Interviewer !</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
            </button>



            <div class="modal-body">

                <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>

                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">
            </div>

        </div>

    </div>
</div>

<div id="AssessmentgroupModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Assessment Group</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeAssessmentgroupModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                @using (Html.BeginForm("InterviewerEntitle", "IRF", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {

                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="form-horizontal w-full">
                            <div class="clearfix">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            </div>

                            <div class="clearfix">
                                <div class="form-group col-lg-6  col-md-6 col-sm-6 px-1 pull-left">
                                    @Html.LabelFor(model => model._skilldetails.PrimarySkills, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                    @Html.DropDownListFor(m => m._skilldetails.SelectedSkillIds, new SelectList(Model._skilldetails.PrimarySkills, "Value", "Text", Model._skilldetails.SelectedSkillIds), new { @id = "select", @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model._skilldetails.SelectedSkillIds, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group col-lg-6  col-md-6 col-sm-6 pl-1 pull-left">
                                    @Html.LabelFor(model => model._skilldetails.AssessmentGroupName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                    @Html.EditorFor(model => model._skilldetails.AssessmentGroupName, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                    @Html.ValidationMessageFor(model => model._skilldetails.AssessmentGroupName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="card-footer" style="margin-top: 15px;">
                                    <div class="row">
                                        <div class="col-md-12 mc-button-area">
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                            <input style="color: #fff; line-height: 13px;" type="button" onclick="closeAssessmentgroupModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>
<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>
<script type="text/javascript">
    //// script for loader starts here
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
        $("#btnSearch").on('click', function () {
            var value = $("#searchinput").val();
            window.location.href = "/IRF/InterviewerDetail?Searchvalue=" + value;
        });
    });
    var flag = true;
    function callingfunction(value) {
        if (flag == true) {
            window.location.href = "/IRF/InterviewerDetailById?Id=" + value;
        } else {
            flag = true;
        }
    }
    function callatag() {
        flag = false;
    }
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        //  phoneNumber = '+918126991790';
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function ModalButtonClick(candidateObj) {
        //flag = false;
        candidate = candidateObj.candidateName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(candidateObj.MobileNumber);
    }

    function AddIRF() {
        var array = [];

        $("input:checkbox[name=chkinterviewer]:checked").each(function () {
            array.push($(this).val());
        });
        if (array.length > 0) {
            window.location.href = "/IRF/Add?IntrviewerId=" + array.toString();

        }
        else {
            alert("Please Select atleast one Interviewer.");
        }
    }
    function CreateAssignmetGroup() {
        var modal = document.getElementById("AssessmentgroupModel");
        modal.style.display = "block";
    }
    function closeAssessmentgroupModel() {
        var modal = document.getElementById("AssessmentgroupModel");
        modal.style.display = "none";
    }

    function isnumerical(event) {
        if (47 < event.keyCode && event.keyCode < 58) {
            return true;
        }
        return false;
    }
</script>
<script src="ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>
<script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery("#select").select2({ multiple: true });
    });

</script>