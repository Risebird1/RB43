                                                            <input id="searchinput" type="text" class="form-control txtsearch1" placeholder="Please enter interviewer's name or skill" value="@ViewBag.searchvalue">
                                                            <span class="input-group-btn" id="searchGo">
                                                                <button class="btn btn3" id="btnSearch" value="Search" type="submit"><svg style="fill: #fff;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path></svg></button>
                                                            </span>

                                                        </div>*@
                                                </div>
                                            </div>
                                        </div>

                                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to create assessment group" onclick="CreateAssignmetGroup()" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Create Assessment Group </font></span></button>
