@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
<script type="text/javascript">

    $(document).ready(function () {
        $("#btnSearch").on('click', function () {
            var value = $("#searchinput").val();
            window.location.href = "/IRF/InterviewerDetail?Searchvalue=" + value;
        });
    });

    function AddIRF() {
        var array = [];

        $("input:checkbox[name=chkinterviewer]:checked").each(function () {
            array.push($(this).val());
        });
        if (array.length > 0) {
            window.location.href = "/IRF/Add?IntrviewerId=" + array.toString();

        }
        else {
            alert("Please Select atleast one Interviewer.");
        }
    }
    function CreateAssignmetGroup() {
        var modal = document.getElementById("AssessmentgroupModel");
        modal.style.display = "block";
    }
    function closeAssessmentgroupModel() {
        var modal = document.getElementById("AssessmentgroupModel");
        modal.style.display = "none";
    }

    function isnumerical(event) {
        if (47 < event.keyCode && event.keyCode < 58) {
            return true;
        }
        return false;
    }
</script>
<script src="ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>
<script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery("#select").select2({ multiple: true });
    });
    function EditAssessment(assessmentid) {
        $.ajax({
            url: '/IRF/EditAssessment',
            data: { 'assessmentid': assessmentid },
            success: function (data) {
                $('#assessmentgrouplist').html('');
                $('#assessmentgrouplist').html(data);
                CreateAssignmetGroup();
            }
        });
    }
</script>
<script>
    function searchResult() {
        $('#entitleTable').DataTable();
    }
    function RefreshSearch() {
        $('#entitleTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#entitleTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };
    var closeMember = document.getElementById("membersPopUp");
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewerMemberModal");
        modal.style.display = "none";
    }
    function getIRFMembers(id) {
        $.ajax({
            url: '/IRF/GetAssessmentGroupInterviewerMembers',
            data: { 'Assessmentid': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);
            }
        });
    }
    var closelist = document.getElementById("listmembersPopUp");
    closelist.onclick = function () {
        var modal = document.getElementById("SkillChannelListModal");
        modal.style.display = "none";
    }
    function getIRFList(id) {
        $.ajax({
            url: '/IRF/GetAssessmentGroupIRFList',
            data: { 'Assessmentid': id },
            success: function (data) {
                var modal = document.getElementById("SkillChannelListModal");
                modal.style.display = "block";
                $('#listmemberTableBody').html('');
                $('#listmemberTableBody').html(data);
            }
        });
    }
    function getQuestionsList(id) {
        $.ajax({
            url: '/IRF/GetAssessmentGroupQuestionList',
            type: 'POST',
            data: { 'Assessmentid': id },
            success: function (data) {
                var modal = document.getElementById("QuestionsListModal");
                modal.style.display = "block";
                bindquestiondata(data);
            }
        });
    }
    function closeQuestionsListModal() {
        var modal = document.getElementById("QuestionsListModal");
        modal.style.display = "none";
    }
    function bindquestiondata(data) {
        var html = '';
        html += '<div id="style-2" class="scrollers" style="overflow-y:auto">';
        html += '<table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">';
        html += '<thead>';
        html += ' <tr>';
        html += '       <th>IRFId</th>';
        html += '       <th class="text-center">Skill</th>';
        html += '       <th class="text-center">Question</th>';
        html += ' </tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            html += ' <tr>';
            html += '       <td>' + data[i].irfId + '</td>';
            html += '       <td>' + data[i].primarySkillInvite + '</td>';
            html += '       <td>' + data[i].comment + '</td>';
            html += '             </tr>';
        }
        html += ' </tbody> ';
        html += ' </table>';
        html += ' </div>';
        if (data.length == 0) {
            html += '  <div>No  Skill Channel for this Assessment Group</div>';
        }
        $("#questionlistTableBody").empty().html(html);
    }
</script>