    function getQuestionsList(id) {
        $.ajax({
            url: '/IRF/GetAssessmentGroupQuestionList',
            type: 'POST',
            data: { 'Assessmentid': id },
            success: function (data) {
                var modal = document.getElementById("QuestionsListModal");
                modal.style.display = "block";
                bindquestiondata(data);
            }
        });
    }
    function closeQuestionsListModal() {
        var modal = document.getElementById("QuestionsListModal");
        modal.style.display = "none";
    }
    function bindquestiondata(data) {
        var html = '';
        html += '<div id="style-2" class="scrollers" style="overflow-y:auto">';
        html += '<table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">';
        html += '<thead>';
        html += ' <tr>';
        html += '       <th>IRFId</th>';
        html += '       <th class="text-center">Skill</th>';
        html += '       <th class="text-center">Question</th>';
        html += ' </tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            html += ' <tr>';
            html += '       <td>' + data[i].irfId + '</td>';
            html += '       <td>' + data[i].primarySkillInvite + '</td>';
            html += '       <td>' + data[i].comment + '</td>';
            html += '             </tr>';
        }
        html += ' </tbody> ';
        html += ' </table>';
        html += ' </div>';
        if (data.length == 0) {
            html += '  <div>No  Skill Channel for this Assessment Group</div>';
        }
        $("#questionlistTableBody").empty().html(html);
    }
    function ShareVerificationInterviewer(id) {
        swal.fire({
            title: 'Are you sure you want to share verification test to interviewers?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Share it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/ShareVerificationToInterviewer',
                        type: 'POST',
                        data: { 'Assessmentid': id },
                        success: function (data) {
                            if (data == "Success") {
                                alert("successfully share the verification request for assessment.");
                            } else {
                                alert("Fail to share the verification request for assessment.");
                            }
                        }
                    });
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not shared verfication test link!',
                    'error'
                )
            }
        })
    }
     function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
