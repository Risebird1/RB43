<div id="InterviewerModal" class="modal modal-bg">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left">Interviewer Details</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" onclick="closeInterviewerModal()" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body">

