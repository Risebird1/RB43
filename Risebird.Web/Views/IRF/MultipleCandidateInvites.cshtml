<script>
    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
     $('.' + id).addClass("in");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
      $('.' + id).removeClass("in");
            $("#" + id).attr("data-changes", "1");
        }
    }

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }

    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });
    });

    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/IRF/MultipleCandidateInvitesJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }

    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="10" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }
        for (var i = 0; i < data.length; i++) {

            html += ' <tr id="' + data[i].imid + '" data-changes="1">';
            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].imid + '" data-target=".' + data[i].imid + '" class="detail-row" onclick="changeicon(' + data[i].imid + ')">&nbsp;</td>';
            html += '   <td> ' + data[i].inviteCount + ' </td>';
            if (data[i].candidateName != null && data[i].candidateName != "") {
                if (data[i].candidateName.length > 25) {
                    html += '   <td class="cadName"> ' + data[i].candidateName.substring(0, 25) + '...</td>';
                }
                else {
                    html += ' <td class="cadName"> ' + data[i].candidateName + '</td>';
                }
            }
            else { html += '<td></td>'; }
            html += '  <td>' + new Date(data[i].interviewDate).toLocaleString() + ' </td>';
            if (data[i].jdTiltle.split("|")[0] != null && data[i].jdTiltle.split("|")[0] != "") {
                if (data[i].jdTiltle.split("|")[0].length > 30) {
                    html += '  <td>' + data[i].jdTiltle.split("|")[0].substring(0, 30) + '... </td>';
                }
                else {
                    html += '  <td> ' + data[i].jdTiltle.split("|")[0] + ' </td>';
                }
            }
            else { html += '<td></td>'; }
            if (data[i].confirmationStatus.trim() == "Cancelled") {
                html += ' <td class="text-center"><a style="color:red">' + data[i].confirmationStatus + '</a> </td>';

            }
            else {
                html += '   <td class="text-center">' + data[i].confirmationStatus + '</td>';
            }
            html += '   <td>' + data[i].meetingStatusStatusDesc + '</td>';
            html += '   <td>' + data[i].intervieweStatusStatDesc + '</td>';

            html += '    <td class="text-right action">';
            if (data[i].isAdmin && data[i].meetingStatusStatusDesc != "Completed") {

                html += '   <span class="mdc-fab app-fab--absolute trash-btn" onclick="location.href = "/Interview/DeleteInterview?id = ' + data[i].imid + '&controllerName=IRF&irfId=' + data[i].irfId + '" title="Delete Interview"><i class="far fa  fa-trash"></i></span>';

            }
            html += ' </td>';
            html += '   </tr>';


            html += '   <tr class="collapse ' + data[i].imid + '">';
            html += '   <td colspan="999" class="child-section">';
            html += '   <table width="100%" class="table table-striped " cellpadding="0" cellspacing="0">';

            html += ' <tr>';
            html += '   <th>Candidate Email</th>';
            html += '  <th>Client HR</th>';
            html += '   <th>Candidate Contact</th>';
            html += '   <th>Staffing Agenecy</th>';
            html += '   <th>IRF ID</th>';
            html += '   </tr>';
            html += '  <tr>';
            html += '   <td> ' + data[i].candidateEmail + '</td>';
            if (data[i].clientHrContact != null) {
                html += '  <td>' + data[i].clientHrContact + ' </td>';
            }
            else {
                html += '  <td></td>';
            }

            html += ' <td>' + data[i].mobileNumber + '</td>';
            if (data[i].staffingAgency != null) {
                html += ' <td>' + data[i].staffingAgency + '</td>';
            }
            else { html += '  <td></td>'; }
            html += '   <td>' + data[i].irfId + '</td>';


            html += ' </tr>';

            html += ' </table>';
            html += '   </td>';
            html += '  </tr>';

        }
        $("#tblbodyMultipleCandidateInvites").empty().html(html);
    }



    function bindPages(pagecount, startpage, endpage, totalcount) {
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/IRF/MultipleCandidateInvites?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/IRF/MultipleCandidateInvites?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/IRF/MultipleCandidateInvites?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/IRF/MultipleCandidateInvites?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/IRF/MultipleCandidateInvites?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#dupmeeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#dupmeeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#dupmeeting").show();
        }, 500);
    };
    //// script for loader ends here
</script>

