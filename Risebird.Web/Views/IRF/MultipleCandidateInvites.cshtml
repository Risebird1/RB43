@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.MeetingVM>
@using X.PagedList.Mvc.Core;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Multiple Candidate Invites";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/IRF/Index'>Skills Channel</a>&nbsp;/&nbsp;<a id='intmulmeet_1'>Multiple Candidate Invites</a>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=9" />
<div class="main-panel" id="main-panel">

    <!-- <div class="panel-header panel-header-sm">
    </div>-->



    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title" style="margin-top:0px;"> </h4>
                    <div class="mobile-view"><h4 class="card-title"> Multiple Candidate Invites</h4></div>
                </div>


                <div class="pull-right client-ms">

                    <button id="intmulmeet_7" type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("Index", "IRF")'" data-original-title="Tooltip on top"> Back</span>
                    </button>

                    <div id="meeting_filter" class="dataTables_filter pull-left" style="margin-right:10px;">

                        <div id="intmulmeet_2"  class="searchCon">

                            <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                            <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.searchValue">
                            <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>



                            @*<button style="display:none;" type="button" id="x">x</button>*@

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>






    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">



                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">



                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="dupmeeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th id='start' style="border-right: 0px !important;"></th>
                                                            <th style="border-left: 0px !important;" id='start'>Invite Count</th>
                                                            <th>Candidate Name</th>

                                                            <th>Interview Date</th>
                                                            <th id="intmulmeet_3">Primary Skill</th>
                                                            <th id="intmulmeet_4">Confirmation Status</th>
                                                            <th id="intmulmeet_5">Meeting Status</th>
                                                            <th id="intmulmeet_6">Interview Status</th>

                                                            <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th style="border-right: 0px !important;"></th>
                                                            <th style="border-right: 0px !important;">Invite Count</th>
                                                            <th>Candidate Name</th>

                                                            <th>Interview Date</th>
                                                            <th>Primary Skill</th>
                                                            <th>Confirmation Status</th>
                                                            <th>Meeting Status</th>
                                                            <th>Interview Status</th>

                                                            <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyMultipleCandidateInvites">
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr id="@item.imid" data-changes="1">
                                                                <td style="width:10px;" data-toggle="collapse" id="@item.imid" data-target=".@item.imid" class="detail-row" onclick="changeicon('@item.imid')">&nbsp;</td>
                                                                <td> @item.InviteCount </td>
                                                                @if (item.candidateName != null && item.candidateName != "")
                                                                {
                                                                    @if (item.candidateName.Length > 25)
                                                                    {
                                                                        <td class="cadName"> @item.candidateName.Substring(0, 25)...</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td class="cadName"> @item.candidateName</td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                <td> @item.interviewDate </td>

                                                                @if (item.JDTiltle.Split("|")[0] != null && item.JDTiltle.Split("|")[0] != "")
                                                                {
                                                                    @if (item.JDTiltle.Split("|")[0].Length > 30)
                                                                    {
                                                                        <td> @item.JDTiltle.Split("|")[0].Substring(0, 30)... </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td> @item.JDTiltle.Split("|")[0] </td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                @if (item.confirmationStatus.Trim() == "Cancelled")
                                                                {
                                                                    <td class="text-center">

                                                                        <a style="color:red"> @item.confirmationStatus</a>
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td class="text-center"> @item.confirmationStatus</td>
                                                                }
                                                                <td> @item.MeetingStatusStatusDesc</td>
                                                                <td> @item.intervieweStatusStatDesc</td>

                                                                <td class="text-center action">
                                                                    @if (item.IsAdmin && item.MeetingStatusStatusDesc != "Completed")
                                                                    {

                                                                        <span class="mdc-fab app-fab--absolute trash-btn" onclick="location.href = '@Url.Action("DeleteInterview", "Interview", new { id = item.imid,controllerName="IRF",irfId= item.IRFId})'" title="Delete Interview"><i class="far fa  fa-trash"></i></span>

                                                                    }
                                                                </td>
                                                            </tr>


                                                            <tr class="collapse @item.imid">
                                                                <td colspan="999" class="child-section">
                                                                    <table width="100%" class="table table-striped " cellpadding="0" cellspacing="0">

                                                                        <tr>
                                                                            <th>Candidate Email</th>
                                                                            <th>Client HR</th>
                                                                            <th>Candidate Contact</th>
                                                                            <th>Staffing Agenecy</th>
                                                                            <th>IRF ID</th>
                                                                        </tr>
                                                                        <tr>
                                                                            <td> @item.candidateEmail</td>
                                                                            <td> @item.ClientHrContact </td>
                                                                            <td>@item.MobileNumber</td>
                                                                            <td>@item.staffingAgency</td>
                                                                            <td> @item.IRFId</td>

                                                                        </tr>

                                                                    </table>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>


                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right " id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("MultipleCandidateInvites", new { Page = Page, irfId = ViewBag.IRFID }))
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->
        </div>

    </div>
</div>
