<script type="text/javascript">
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }
    });

    function ResetFilter() {
        window.location.href = "/IRF/ResetSkillChannelDetailsFilter";
    }
    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);

        var form = $("#form").serialize();
    }
</script>


<script>
    function searchResult() {
        $('#irfTable').DataTable();
    }
    function RefreshSearch() {
        $('#irfTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#irfTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });
    };
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#irfTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#irfTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#irfTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>

<script>
    var closeMember = document.getElementById("flagsModalClose");
    closeMember.onclick = function () {
        var modal = document.getElementById("flagsModal");
        modal.style.display = "none";
    }
    function OpenModalForFlags(irfName, jdTitle, scheduledPercentage, completionRate, selectionRate, unassigninterview, statuspending, candidatepending, missingVideoLink, missingzoomLink) {
        $('#flagsModalBody').html('');
        var modal = document.getElementById("flagsModal");
        modal.style.display = "block";
        var modalHeading = '';
        if (jdTitle != null && jdTitle != '') {
            modalHeading = 'Flags for ' + irfName + '(' + jdTitle + ')';
        }
        else {
            modalHeading = 'Flags for ' + irfName;
        }
        $('#flagsModalHeading').text(modalHeading);
        //code for setting up a bar chart
        var chartData = [];
        if (scheduledPercentage != null && scheduledPercentage != '') {
            if (parseFloat(scheduledPercentage) < 75) {

                var scheduledDataObj = { country: "", visits: "" }
                scheduledDataObj.country = "Scheduled Rate(%)";
                scheduledDataObj.visits = parseFloat(scheduledPercentage);
                chartData.push(scheduledDataObj);
            }
        }

        if (completionRate != null && completionRate != '') {
            if (parseFloat(completionRate) < 60) {
                var completionDataObj = { country: "", visits: "" }
                completionDataObj.country = "Completion Rate(%)";
                completionDataObj.visits = parseFloat(completionRate);
                chartData.push(completionDataObj);
            }
        }

        if (selectionRate != null && selectionRate != '') {
            if (parseFloat(selectionRate) < 20) {
                var selectionDataObj = { country: "", visits: "" }
                selectionDataObj.country = "Selection Rate(%)";
                selectionDataObj.visits = parseFloat(selectionRate);
                chartData.push(selectionDataObj);
            }
        }
        am4core.ready(function () {
            // Themes begin
            am4core.useTheme(am4themes_animated);
            // Themes end
            // Create chart instance
            var chart = am4core.create("flagsModalBody", am4charts.XYChart);
            // Add data
            chart.data = chartData;
            // Create axes
            CreateChartAxes(chart);
        });
        var html = '';
        html += '<table style="width:100%"><tr><td style="border:1px solid black">Unassigned Interviews</td><td style="border:1px solid black">' + unassigninterview + '</td></tr>';
        html += '<tr><td style = "border:1px solid black" > Status Pending</td><td style="border:1px solid black">' + statuspending + '</td></tr>';
        html += '<tr><td style = "border:1px solid black" > PENDING CANDIDATE FEEDBACK</td><td style="border:1px solid black">' + candidatepending + '</td></tr>';
        html += ' <tr><td style="border:1px solid black">Missing Video Link</td><td style="border:1px solid black">' + missingVideoLink + '</td></tr>';
        html += '<tr><td style="border:1px solid black">Missing Zoom Link</td><td style="border:1px solid black">' + missingzoomLink + '</td></tr>';
        html += '</table>';
        $("#flagsModalBodyCount").empty().html(html);
    }

    function CreateChartAxes(chart) {
        chart.logo.disabled = true;
        var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
        categoryAxis.dataFields.category = "country";
        categoryAxis.renderer.inside = true;
        categoryAxis.renderer.labels.template.valign = 0;
        categoryAxis.renderer.grid.template.location = 0;
        //categoryAxis.renderer.minGridDistance = 30;
        categoryAxis.renderer.minGridDistance = 100;
        chart.fontSize = 13;
        categoryAxis.renderer.labels.template.fill = am4core.color("#828080");

        categoryAxis.renderer.labels.template.adapter.add("dy", function (dy, target) {
            if (target.dataItem && target.dataItem.index & 2 == 2) {
                return dy;
            }
            return dy;
        });
        categoryAxis.renderer.labels.template.fill = am4core.color("#828080");
        categoryAxis.renderer.labels.template.paddingBottom = -17;
        categoryAxis.renderer.grid.template.disabled = true;
        var valueAxis = chart.yAxes.push(new am4charts.ValueAxis());
        valueAxis.renderer.grid.template.disabled = true;
        valueAxis.min = 0;
        //valueAxis.max = 30;
        valueAxis.max = 100;
        // Create series
        var series = chart.series.push(new am4charts.ColumnSeries());
        series.dataFields.valueY = "visits";
        series.dataFields.categoryX = "country";
        series.name = "Visits";
        series.colorField = "color";
        series.columns.template.tooltipText = "{valueY.percent}[/] ({valueY})";
        series.tooltip.label.adapter.add("text", function (text, target) {
            if (target.dataItem && target.dataItem.valueY == 0) {

                return "";
            }
            else {

                return text;
            }
        });
        series.columns.template.fillOpacity = .8;
        series.columns.template.tooltipY = 0;
        series.tooltip.background.strokeOpacity = 0
        series.tooltip.pointerOrientation = "vertical";
        series.columns.template.showTooltipOn = "always";
        series.tooltip.background.filters.clear();
        series.tooltip.getFillFromObject = false;

        series.tooltip.label.fill = am4core.color("#9a9a9a");
        series.tooltip.background.cornerRadius = 0;
        series.tooltip.label.textAlign = "middle";
        series.tooltip.background.fill = 0;
        var columnTemplate = series.columns.template;
        columnTemplate.strokeWidth = 0;
        columnTemplate.strokeOpacity = 1;//07BEF3
        chart.colors.list = [
            am4core.color("#07BEF3"),
            am4core.color("#00F96B"),
            am4core.color("#F64042")

        ];
        series.columns.template.events.once("inited", function (event) {
            event.target.fill = chart.colors.getIndex(event.target.dataItem.index);
        });
    }
    var closeIRFModel = document.getElementById("IRfModalClose");
    closeIRFModel.onclick = function () {
        var modal = document.getElementById("IRFListModel");
        modal.style.display = "none";
    }
    function OpenModelForIRF(HrEmail) {
        $(".loader").show();
        $.ajax({
            type: "POST",
            url: "/IRF/SkillChannelDetailsIRFCount",
            data: { 'HrEmail': HrEmail },
            success: function (data) {
                var modal = document.getElementById("IRFListModel");
                modal.style.display = "block";
                $("#IRFModalHeading").text("IRFs for " + HrEmail);
                $(".loader").hide();
                bindIRFList(data);
            }
        });
    }
    function bindIRFList(data) {
        var html = '';
        html += '<table style="width:100%"><tr><td style="border:1px solid black">Skill Channel</td><td style="border:1px solid black">JdTitle</td><td style="border:1px solid black">Client</td><td style="border:1px solid black">Flags</td>';
        html += '<td style="border:1px solid black">Total Candidates</td><td style="border:1px solid black">Completed Interviews</td><td style="border:1px solid black">Selected Interviews</td>';
        html += '<td style="border:1px solid black">Rejected Interviews</td><td style="border:1px solid black">Report Pending</td><td style="border:1px solid black">Not Scheduled Count</td>';
        html += '<td style="border:1px solid black">Rescheduled Count</td><td style="border:1px solid black">Future Scheduled Count</td></tr> ';
        for (var i = 0; i < data.length; i++) {
            html += '<tr><td style="border:1px solid black">' + data[i].irfId + '</td>';
            html += '<td style="border:1px solid black">' + data[i].jdTiltle + '</td>';
            html += '<td style="border:1px solid black">' + data[i].clientCompName + '</td>';
            if (data[i].flags > 0) {
                html += '<td style="color:blue!important" onclick="OpenModalForFlags(' + "'" + data[i].risebirdHREmail + "'" + ',' + "''" + ',' + "'" + data[i].scheduledPercentage + "'" + ',' + "'" + data[i].completionRate + "'" + ',' + "'" + data[i].selectionRate + "'" + ',' + "'" + data[i].unassignedInterviewsCount + "'" + ',' + "'" + data[i].unfilledMeetingStatusCount + "'" + ',' + "'" + data[i].unfilledCommentsCount + "'" + ',' + "'" + data[i].missingVideoLink + "'" + ',' + "'" + data[i].missingZoomLink + "'" + ')">' + data[i].flags + '</td>';
            }
            else {
                html += '<td>' + data[i].flags + '</td>';
            }
            html += '<td style="border:1px solid black">' + data[i].candidateCount + '</td>';
            html += '<td style="border:1px solid black">' + data[i].completedInterviews + '</td>';
            html += '<td style="border:1px solid black">' + data[i].selectedMeetings + '</td>';
            html += '<td style="border:1px solid black">' + data[i].rejectedMeetings + '</td>';
            html += '<td style="border:1px solid black">' + data[i].pendingCount + '</td>';
            html += '<td style="border:1px solid black">' + data[i].notScheduledCount + '</td>';
            html += '<td style="border:1px solid black">' + data[i].reScheduledCount + '</td>';
            html += '<td style="border:1px solid black">' + data[i].futureScheduledMeetings + '</td>';
        }
        html += '</table>';
        $("#IRFModalBodyCount").empty().html(html);
    }
</script>




