<script>

    function EditIRF(id, templateId) {
        if ('@ViewBag.profile' == 'Client' && templateId != null && templateId > 0) {
            var url = '/IRF/EditIRF?id=' + id + '&templateId=' + templateId;
            window.location.href = url;
        }
        else {
            $.ajax({
                url: '/IRF/CheckEditCondition?IRFId=' + id,
                type: 'POST',
                success: function (result) {
                    if (result == "Success") {
                        var url = '/IRF/EditIRF?id=' + id;
                        window.location.href = url;
                    }
                    else {
                        swal.fire("You are not authorize to edit this skill channel, Please contact Admin or Channel Owner.");
                    }
                }
            });
        }

    };
</script>

