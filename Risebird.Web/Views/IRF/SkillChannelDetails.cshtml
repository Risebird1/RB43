@model IEnumerable<Risebird.Entities.ViewModel.IRF>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Skill Channel Stats";
    ViewBag.PageHeader = "Skill Channel Stats";
    if (ViewBag.PageStatus == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}

@if (HttpContextAccessor.HttpContext.Session.GetString("SkillChannelDetailsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<SkillChannelDetailsFilter>(HttpContextAccessor.HttpContext.Session.GetString("SkillChannelDetailsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
<style>
    .DetailLink td {
        color: darkblue;
    }

    .DetailLink:hover {
        text-decoration: underline;
        cursor: pointer;
    }
</style>
<style>
    .modal-dialog {
        height: 900px !important;
    }

    .modal-content {
        /* 80% of window height */
        height: 60%;
    }

</style>

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css" />
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/123941/stacktable.js"></script>
<script>
    $('table').stacktable();
</script>
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Skill Channel Stats</h4></div>
                </div>
                <input type="hidden" value="@ViewBag.Type" id="hidtype" />
                <div class="pull-left">
                    @if (ViewBag.profile != "Client")
                    {
                        @if (ViewBag.Type == "ChannelOwner")
                        {
                            <div class="feedback-tab-ac" onclick="Changeurldetails('ChannelOwner')"><strong>Channel Owner</strong></div>
                            <div class="feedback-tab" onclick="Changeurldetails('IRF')"><strong>Skill Channel</strong></div>
                        }
                        else
                        {
                            <div class="feedback-tab" onclick="Changeurldetails('ChannelOwner')"><strong>Channel Owner</strong></div>
                            <div class="feedback-tab-ac" onclick="Changeurldetails('IRF')"><strong>Skill Channel</strong></div>
                        }
                    }
                    else if (ViewBag.PageStatus == "Public")
                    {
                        @if (ViewBag.Type == "IRF")
                        {
                            <div class="feedback-tab" onclick="ChangeChanneldetails('DayStats','@ViewBag.emailid','@ViewBag.uniqueid', '@ViewBag.IsClientLogin')"><strong>Day Stats</strong></div>
                            <div class="feedback-tab-ac" onclick="ChangeChanneldetails('IRF','@ViewBag.emailid','@ViewBag.uniqueid', '@ViewBag.IsClientLogin')"><strong>Skill Channel</strong></div>
                        }
                    }
                </div>
                <div class="pull-right">
                    <div style="float:right">
                        <button type="button" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-toggle="modal" data-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                        @if (ViewBag.PageStatus == "Public" || ViewBag.IsCLientLogin == true)
                        {
                            <input type="hidden" value="@ViewBag.emailid" id="hiddemail" />
                            <input type="hidden" value="@ViewBag.uniqueid" id="hidduniqueid" />
                            <input type="hidden" value="@ViewBag.IsCLientLogin" id="hiddLoginStatus" />
                            @if (ViewBag.PageStatus == "Public")
                            {
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="location.href='@Url.Action("PublicCandidateStatus", "Candidate", new { emailid=ViewBag.emailid,id=ViewBag.uniqueid })'" data-original-title="Back to Dashboard"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                                </button>

                            }

                        }
                        else
                        {
                            @if (ViewBag.profile == "HR")
                            {
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="location.href='/HR/MyInterviews'" data-original-title="Back to Dashboard"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="location.href='/Dashboard'" data-original-title="Back to Dashboard"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                                </button>
                            }
                        }
                        @if (ViewBag.PageStatus != "Public")
                        {
                            <span class="interview_2"> <i type="submit" class="far fa-file-excel excel-file card-title-space " data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("SkillChannelDetailstoExcel", "IRF", new { type = ViewBag.Type })'"></i></span>
                        }
                    </div>
                    <div class="note-filter" style="text-align: right;width: auto;padding-top: 8px;"> Note: To visualize break-up of candidates 'Added' before 30 days, use Filter option</div>

                </div>

            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            @if (ViewBag.PageStatus == "Public" || ViewBag.IsClientLogin == true)
                                            {
                                                <form action="@Url.Action("PublicSkillChannelDetails","IRF",new { emailid=ViewBag.emailid, uniqueid = ViewBag.uniqueid, isClientLogin = ViewBag.IsClientLogin })" method="post" id="form" onsubmit="return checkfilterDate();">
                                                    <div class="modal-body">
                                                        <div class="row">
                                                            <div class="col-md-6 col-sm-6 border-rv">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                        Start Date
                                                                    </label>
                                                                    <div class="col-md-12 col-sm-12">
                                                                        <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6 col-sm-6">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                        End Date
                                                                    </label>
                                                                    <div class="col-md-12 col-sm-12">
                                                                        <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12 col-sm-12">
                                                                <div class="form-group">
                                                                    <div>
                                                                        <div class="col-md-12 col-sm-12 pull-right">
                                                                            <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                                <font style="font-size:12px;"> Reset Filter</font>
                                                                            </button>
                                                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                                <font style="font-size:12px;"> Apply Filter</font>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </form>
                                            }
                                            else
                                            {
                                                <form action="@Url.Action("SkillChannelDetails","IRF",new { type=ViewBag.Type})" method="post" id="form">
                                                    <div class="modal-body">
                                                        <div class="row">
                                                            <div class="col-md-6 col-sm-6 border-rv">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                        Start Date
                                                                    </label>
                                                                    <div class="col-md-12 col-sm-12">
                                                                        <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6 col-sm-6">
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                        End Date
                                                                    </label>
                                                                    <div class="col-md-12 col-sm-12">
                                                                        <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12 col-sm-12">
                                                                <div class="form-group">
                                                                    <div>
                                                                        <div class="col-md-12 col-sm-12 pull-right">
                                                                            <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                                <font style="font-size:12px;"> Reset Filter</font>
                                                                            </button>
                                                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                                <font style="font-size:12px;"> Apply Filter</font>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                </div>
                                <div class="scrollbar int-table" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="irfTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    @if (ViewBag.Type != "ChannelOwner")
                                                    {
                                                        <th>Skill Channel</th>
                                                        @* <th>Created On</th>

                                                    <th>Client</th>
                                                    <th>Billing Owner</th>*@


                                                    }

                                                    <th>Risebird Channel Owner</th>

                                                    @if (ViewBag.Type == "ChannelOwner")
                                                    {
                                                        <th>Skill Channels</th>
                                                    }
                                                    <th>Red Flags</th>
                                                    @if (ViewBag.Type != "ChannelOwner")
                                                    {
                                                        <th>JD Title</th>
                                                        <th>Client</th>
                                                    }
                                                    <th>Total Candidates</th>
                                                    <th>Completed Interviews</th>
                                                    <th>Selected Interviews</th>
                                                    <th>Rejected Interviews</th>
                                                    <th>Report Pending</th>
                                                    <th>Cold Candidate</th>
                                                    <th>Not Scheduled Count</th>
                                                    <th>Rescheduled Count</th>
                                                    <th>Future Scheduled Count</th>
                                                    <th>Status</th>
                                                    @if (ViewBag.Type != "ChannelOwner" && ViewBag.profile != "Client")
                                                    {
                                                        <th>Client Rating</th>
                                                    }
                                                    @if (ViewBag.profile == "Client" || ((ViewBag.profile == "Admin" || ViewBag.profile == "SupportAdmin" || ViewBag.profile == "SeniorHR" || ViewBag.profile == "SeniorInterviewerManagement") && ViewBag.Type != "ChannelOwner"))
                                                    {
                                                        <th>Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    @if (ViewBag.Type != "ChannelOwner")
                                                    {
                                                        <th>Skill Channel</th>
                                                        @*  <th>Created On</th>

                                                    <th>Client</th>
                                                    <th>Billing Owner</th>*@

                                                    }

                                                    <th>Risebird Channel Owner</th>

                                                    @if (ViewBag.Type == "ChannelOwner")
                                                    {
                                                        <th>Skill Channels</th>
                                                    }
                                                    <th>Red Flags</th>
                                                    @if (ViewBag.Type != "ChannelOwner")
                                                    {
                                                        <th>JD Title</th>
                                                        <th>Client</th>
                                                    }
                                                    <th>Total Candidates</th>
                                                    <th>Completed Interviews</th>
                                                    <th>Selected Interviews</th>
                                                    <th>Rejected Interviews</th>
                                                    <th>Report Pending</th>
                                                    <th>Cold Candidate</th>
                                                    <th>Not Scheduled Count</th>
                                                    <th>Rescheduled Count</th>
                                                    <th>Future Scheduled Count</th>
                                                    <th>Status</th>
                                                    @if (ViewBag.Type != "ChannelOwner" && ViewBag.profile != "Client")
                                                    {
                                                        <th>Client Rating</th>
                                                    }
                                                    @if (ViewBag.profile == "Client" || ((ViewBag.profile == "Admin" || ViewBag.profile == "SupportAdmin" || ViewBag.profile == "SeniorHR" || ViewBag.profile == "SeniorInterviewerManagement") && ViewBag.Type != "ChannelOwner"))
                                                    {
                                                        <th>Action</th>
                                                    }

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            @if (ViewBag.Type != "ChannelOwner")
                                                            {
                                                                <td>@item.IRFId</td>
                                                                @* <td>@item.CreatedOn</td>

                                                    <td>@item.ClientCompName</td>
                                                    <td>@item.BillingOwnerEmailId</td>*@

                                                            }

                                                            <td> @item.RisebirdHREmail </td>

                                                            @if (ViewBag.Type == "ChannelOwner")
                                                            {
                                                                <td> @item.IRFId</td>
                                                            }

                                                            @if (ViewBag.profile != "Client")
                                                            {
                                                                @if (item.Flags > 0)
                                                                {
                                                                    @if (ViewBag.Type != "ChannelOwner")
                                                                    {
                                                                        <td style="color:red!important;cursor:pointer" onclick="OpenModalForFlags('@item.id','@item.IRFId', '', '@item.ScheduledPercentage', '@item.CompletionRate', '@item.SelectionRate',@item.UnassignedInterviewsCount,@item.UnfilledMeetingStatusCount,@item.UnfilledCommentsCount,@item.MissingVideoLink,@item.MissingZoomLink,@item.FeedbackCount)">@item.Flags</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td style="color:red!important;cursor:pointer" onclick="OpenModalForFlags('@item.id','@item.RisebirdHREmail', '', '@item.ScheduledPercentage', '@item.CompletionRate', '@item.SelectionRate',@item.UnassignedInterviewsCount,@item.UnfilledMeetingStatusCount,@item.UnfilledCommentsCount,@item.MissingVideoLink,@item.MissingZoomLink,@item.FeedbackCount)">@item.Flags</td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td>@item.Flags</td>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                @if (item.Flags > 0)
                                                                {
                                                                    <td style="color:red!important;cursor:pointer" onclick="OpenModalForClientFlags('@item.id','@item.IRFId', '', '@item.ScheduledPercentage', '@item.CompletionRate', '@item.SelectionRate','@item.NotScheduledCount','@item.ReScheduledCount')">@item.Flags</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>@item.Flags</td>
                                                                }
                                                            }
                                                            @*<td style="color:blue!important;cursor:pointer" onclick="OpenModelForIRF('@item.RisebirdHREmail')">@item.IRFId</td>*@
                                                            @if (ViewBag.Type != "ChannelOwner")
                                                            {
                                                                <td> @item.JDTiltle </td>
                                                                <td>@item.ClientCompName</td>
                                                            }
                                                            <td> @item.CandidateCount </td>
                                                            <td>
                                                                @item.CompletedInterviews
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.CompletedInterviews * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                            <td>
                                                                @item.SelectedMeetings
                                                                { @if (item.CompletedInterviews > 0)
                                                                {
                                                                    @((item.SelectedMeetings * 100) / @item.CompletedInterviews)
                                                                }% }
                                                            </td>
                                                            <td>
                                                                @item.RejectedMeetings
                                                                { @if (item.CompletedInterviews > 0)
                                                                {
                                                                    @((item.RejectedMeetings * 100) / @item.CompletedInterviews)
                                                                }% }
                                                            </td>

                                                            <td> @item.PendingCount </td>
                                                            <td>
                                                                @item.ColdCandidateCount
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.ColdCandidateCount * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                            <td>
                                                                @item.NotScheduledCount
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.NotScheduledCount * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                            <td>
                                                                @item.ReScheduledCount
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.ReScheduledCount * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                            <td>
                                                                @item.FutureScheduledMeetings
                                                                { @if (item.CandidateCount > 0)
                                                                {
                                                                    @((item.FutureScheduledMeetings * 100) / @item.CandidateCount)
                                                                }% }
                                                            </td>
                                                            <td>@item.IRFStatus</td>
                                                            @if (ViewBag.Type != "ChannelOwner" && ViewBag.profile != "Client")
                                                            {   
                                                                <td>@item.ClientIRFRatings</td>
                                                            }
                                                            @if (ViewBag.profile == "Client")
                                                            {
                                                                <td>
                                                                    @if (item.IsPaused)
                                                                    {
                                                                        <button id="play" class="mdc-fab app-fab--absolute  " aria-label="Play" style="background:#319d31!important;">
                                                                            <span onclick="PlayIRF('@item.id', '@item.IRFId');" title="Play" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button id="pause" class="mdc-fab app-fab--absolute trash-btn" aria-label="Pause">
                                                                            <span onclick="PauseIRF('@item.id', '@item.IRFId');" title="Pause" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg></span>
                                                                        </button>
                                                                    }
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Recruiter Stats">

                                                                        <a href="@Url.Action("StaffingAgencyStats", "Client", new {irfId = item.id, irfName = item.IRFId})" target="_blank">
                                                                            @*<span title="Recruiter Stats" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" /><a target="_blank" href="@Url.Action("StaffingAgencyStats", "Client", new {irfId = item.id, irfName = item.IRFId})'"></a></svg></span>*@
                                                                            <span title="Recruiter Stats" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="square" stroke-linejoin="arcs"><path d="M5.52 19c.64-2.2 1.84-3 3.22-3h6.52c1.38 0 2.58.8 3.22 3" /><circle cx="12" cy="10" r="3" /><circle cx="12" cy="12" r="10" /></svg></span>
                                                                        </a>

                                                                    </button>

                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Client HR Stats">

