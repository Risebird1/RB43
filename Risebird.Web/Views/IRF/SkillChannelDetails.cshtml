            html += '<tr><td style="border: 1px solid black">Not Scheduled Candidate</td><td style="border: 1px solid black">' + notScheduledCount + '</td><td><a href="/Candidate/IRFFlagDetails?id=' + irfid + '&type=64868&' + irfName + '=irfName" target="_blank">Not-Schedule</a></td></tr>';
        }
        if (reScheduledCount != 0) {
            html += '<tr><td style="border: 1px solid black">ReScheduled Candidate</td><td style="border: 1px solid black">' + reScheduledCount + '</td><td><a href="/Candidate/IRFFlagDetails?id=' + irfid + '&type=34657&irfName=' + irfName + '" target="_blank">Re-Schedule</a></td></tr>';
        }
        if (selectionRate < 20) {
            html += '<tr><td style = "border:1px solid black"> Selected Candidate<i title="Selected Candidate is less then 20%" class="fa fa-info-circle"></i></td><td style="border: 1px solid black">' + selectionRate + '%</td><td><a href="/Candidate/IRFFlagDetails?id=' + irfid + '&type=73532&irfName=' + irfName + '" target="_blank">Selected</a></td></tr>';
        }
        if (completionRate < 60) {
            html += '<tr><td style = "border:1px solid black"> Completed Interview<i title="Completed Interview is less then 60%" class="fa fa-info-circle"></i></td><td style="border: 1px solid black">' + completionRate + '%</td><td><a href="/Candidate/IRFFlagDetails?id=' + irfid + '&type=27538&irfName=' + irfName + '" target="_blank">Completed</a></td></tr>';
        }

        html += '</tbody>';
        html += '</table>';
        $("#flagsModalBodyCount").empty().html(html);
    }
    var closeMemberFeedback = document.getElementById("clientreviewPopUp");
    closeMemberFeedback.onclick = function () {
        var modal = document.getElementById("clientreviewModal");
        modal.style.display = "none";
    }
    function getClientFeedback(id) {
        $.ajax({
            url: '/IRF/GetIRFClientReview',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("clientreviewModal");
                modal.style.display = "block";
                $('#clientreviewTableBody').html('');
                $('#clientreviewTableBody').html(data);
            }
        });
    }
    function getdetailedview(irfid, typeindex) {
        var type = "";
        if (parseInt(typeindex) == 1) {
            type = "MissingZoom";
        } else if (parseInt(typeindex) == 2) {
            type = "MissingVideo";
        }
        else if (parseInt(typeindex) == 3) {
            type = "StatusPending";
        }
        else if (parseInt(typeindex) == 4) {
            type = "UnassignedInterview";
        }
        //window.location.href = "/IRF/SkillChannelDetailedView?type=" + type + "&irfid=" + irfid;
        window.open('/IRF/SkillChannelDetailedView?type=' + type + '&irfid=' + irfid, '_blank');
    }
</script>
