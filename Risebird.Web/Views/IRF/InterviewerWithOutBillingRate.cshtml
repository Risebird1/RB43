@model IEnumerable<Risebird.Entities.ViewModel.InterviewersBillingRateVM>

@{
    ViewData["Title"] = "SkillChannel Interviewer Billing";
    ViewBag.PageHeader = "SkillChannel Interviewer Billing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">SkillChannel Interviewer Billing</h4></div>
                </div>
                <div class="pull-left">
                    <div class="feedback-tab" onclick="Changeurldetails('SkillChannel')"><strong>Skill Channels Interviewers</strong></div>
                    <div class="feedback-tab-ac" onclick="Changeurldetails('WithOutBilling')"><strong>Interviewers WithOut Billing Rate</strong></div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">
                                <div>
                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="unconfirmedCandidatesTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel ID</th>
                                                    <th>Client</th>
                                                    <th>JD Title</th>
                                                    <th>Job Country</th>
                                                    <th>Company Type</th>
                                                    <th>Plan Type</th>
                                                    <th>Interviewer</th>
                                                    @if (ViewBag.Profile == "Finance" || ViewBag.Profile == "Admin")
                                                    {
                                                        <th>Billing(USD)</th>
                                                    }
                                                    <th class="text-center">Mobile</th>
                                                    <th>Resume Link</th>
                                                    <th>Company Name</th>
                                                    <th>Available</th>
                                                    <th>Total Interviews</th>
                                                    <th>Red Marker</th>
                                                    <th>Source</th>
                                                    <th>IsActive</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel ID</th>
                                                    <th>Client</th>
                                                    <th>JD Title</th>
                                                    <th>Job Country</th>
                                                    <th>Company Type</th>
                                                    <th>Plan Type</th>
                                                    <th>Interviewer</th>
                                                    @if (ViewBag.Profile == "Finance" || ViewBag.Profile == "Admin")
                                                    {
                                                        <th>Billing(USD)</th>
                                                    }
                                                    <th class="text-center">Mobile</th>
                                                    <th>Resume Link</th>
                                                    <th>Company Name</th>
                                                    <th>Available</th>
                                                    <th>Total Interviews</th>
                                                    <th>Red Marker</th>
                                                    <th>Source</th>
                                                    <th>IsActive</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.IRFName</td>
                                                            <td>@item.ClientName</td>
                                                            <td>@item.JDTitle</td>
                                                            <td>@item.JobCountry</td>
                                                            <td>@item.CompanyType</td>
                                                            <td>@item.Heuristicsscore</td>
                                                            <td>@item.EmailId</td>

                                                            @if (ViewBag.Profile == "Finance" || ViewBag.Profile == "Admin")
                                                            {
                                                                <td><input type="text" class="form-control" value="@item.BillingRate" onchange="SaveInterviewerBillingRate(this.value,'@item.UserId', '@item.IRFId')" /></td>
                                                            }
                                                            <td class="text-center flex-w">
                                                                <span class="call-area">
                                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                    {
                                                                        <span data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.InterviewerName','@item.MobileNumber','@item.EmailId')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="20" /></span>
                                                                    }
                                                                </span>@item.MobileNumber
                                                            </td>
                                                            @if (item.ResumeLink != null && item.ResumeLink != "")
                                                            {
                                                                <td class="text-center">
                                                                    <a style="background:none!important;border:0px!important; text-decoration: underline; color: #039BE5!important;" id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink><img style="position:relative;left:-5px;" src="~/img/resume-icon.png" width="21" />Resume</a>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td class="text-center">No Resume</td>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(item.CompanyName))
                                                            {
                                                                @if (item.CompanyName.Length > 20)
                                                                {
                                                                    <td title="@item.CompanyName"><span style="font-size:13px; color:brown">@item.CompanyName.Substring(0, 19) ....</span></td>
                                                                }
                                                                else
                                                                {
                                                                    <td><span style="font-size:13px; color:brown">@item.CompanyName</span></td>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                            @if (item.IsAvailable)
                                                            {
                                                                <td class="text-center"><span class="avail">Yes</span></td>
                                                            }
                                                            else
                                                            {
                                                                <td class="text-center"><span class="noavail">No</span></td>
                                                            }

                                                            <td class="text-center">
                                                                <span style="width: 30px !important;height: 30px !important;background:#d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;">@item.TotalInterviews</span>
                                                            </td>
                                                            <td style="color:red"><d onclick="InsightsDetails('@item.EmailId')" style="cursor:pointer">@item.RedMarker</d></td>
                                                            @if (!string.IsNullOrEmpty(item.Source))
                                                            {
                                                                @if (item.Source == "ml")
                                                                {
                                                                    <td>
                                                                        Mail
                                                                    </td>
                                                                }
                                                                else if (item.Source == "wp")
                                                                {
                                                                    <td>
                                                                        Whatsapp
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>
                                                                        @item.Source
                                                                    </td>
                                                                }

                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                            <td>@item.IsActive</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>
                    <!-- end row -->
                </div>
            </div>
        </div>
    </div>
</div>
<div id="interviewerMemberModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="memberHeading">Interviewer Details</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="membersPopUp" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="memberTableBody">
            </div>
        </div>
    </div>
</div>
<script>
    function searchResult() {
        $('#unconfirmedCandidatesTable').DataTable();
    }
    function RefreshSearch() {
        $('#unconfirmedCandidatesTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#unconfirmedCandidatesTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            order: [[1, 'desc']]
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#unconfirmedCandidatesTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#unconfirmedCandidatesTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    }
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#unconfirmedCandidatesTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    function SaveInterviewerBillingRate(billingrate, Userid, IRFid) {
        $.ajax({
            type: 'POST',
            url: '/IRF/SaveInterviewerBillingRate',
            data: { 'billingrate': billingrate, 'Userid': Userid, 'IRFid': IRFid },
            success: function (data) {

            }
        });
    }
    function Changeurldetails(type) {
        if (type == "WithOutBilling") {
            window.location.href = "/IRF/InterviewerWithOutBillingRate";
        } else {
            window.location.href = "/Dashboard/SkillChannelInterviewerBilling";
        }
    }
</script>
