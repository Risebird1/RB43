        function InitAIQuestionSets() {
            $("#dmV4QuestionSetsToggle").on("click", function () {
                var panel = document.getElementById("dmV4QuestionSetsPanel");
                if (!panel) return;
                var expanded = $(this).attr("aria-expanded") === "true";
                $(this).attr("aria-expanded", expanded ? "false" : "true");
                panel.hidden = expanded;
            });

            $("#dmV4CreateQuestionSetsBtn").on("click", function () {
                CreateAIQuestionSets();
            });

            $("#dmV4UseQuestionSetsToggle").on("change", function () {
                SetAIQuestionSetsEnabled($(this).is(":checked"));
            });

            LoadAIQuestionSets();
        }

        // The channel's opt-in. A refusal from the server is authoritative, so the checkbox is put
        // back to whatever state the server reports rather than the state that was clicked.
        function SetAIQuestionSetsEnabled(enabled) {
            if (!aiQuestionSetsEnabled) return;
            var irfid = $("#dmV4QuestionSetsPanel").data("irf-id");
            var $toggle = $("#dmV4UseQuestionSetsToggle");
            $toggle.prop("disabled", true);
            $("#dmV4UseQuestionSetsMessage").text("Saving...");

            $.ajax({
                type: "POST",
                url: "/IRF/SetAIQuestionSetsEnabled",
                data: { 'irfid': irfid, 'enabled': enabled },
                success: function (data) {
                    $toggle.prop("disabled", false);
                    var nowEnabled = !!(data && data.success && data.enabled);
                    $toggle.prop("checked", nowEnabled);
                    $("#dmV4UseQuestionSetsLabel").text(nowEnabled ? "On" : "Off");
                    $("#dmV4UseQuestionSetsMessage").text((data && data.message) ? data.message : "");
                    if (!data || !data.success) {
                        swal.fire({ text: (data && data.message) ? data.message : "This setting could not be changed." });
                    }
                },
                error: function () {
                    $toggle.prop("disabled", false);
                    $toggle.prop("checked", !enabled);
                    $("#dmV4UseQuestionSetsLabel").text(!enabled ? "On" : "Off");
                    $("#dmV4UseQuestionSetsMessage").text("This setting could not be changed.");
                }
            });
        }

        function LoadAIQuestionSets() {
            if (!aiQuestionSetsEnabled) return;
            var irfid = $("#dmV4QuestionSetsPanel").data("irf-id");
            $.ajax({
                type: "POST",
                url: "/IRF/GetAIQuestionSetsByIRF",
                data: { 'irfid': irfid },
                success: function (data) {
                    if (!data || !data.success) {
                        $("#dmV4QuestionSetsMessage").text((data && data.message) ? data.message : "Question sets could not be loaded.");
                        return;
                    }
                    RenderAIQuestionSets(data.sets || []);
                },
                error: function () {
                    $("#dmV4QuestionSetsMessage").text("Question sets could not be loaded.");
                }
            });
        }

        function RenderAIQuestionSets(sets) {
            var $count = $("#dmV4QuestionSetsCount");
            var $list = $("#dmV4QuestionSetsList");

            if (!sets.length) {
                $count.text("no sets yet");
                $list.empty();
                $("#dmV4QuestionSetsMessage").text("No sets have been created for this channel yet.");
                return;
            }

            $count.text(sets.length + (sets.length === 1 ? " set" : " sets"));
            $("#dmV4QuestionSetsMessage").text("");

            var html = '';
            for (var i = 0; i < sets.length; i++) {
                var set = sets[i];
                html += '<div style="border:1px solid #e4e7eb;border-radius:6px;margin-bottom:10px;">';
                html += '<div style="padding:8px 12px;background:#f7f9fa;font-weight:600;font-size:13px;">';
                html += 'Set ' + EscapeSetHtml(set.setName);
                html += ' <span style="font-weight:400;color:#7b8794;">· ' + (set.questions ? set.questions.length : 0) + ' questions';
                html += ' · ' + set.totalMinutes + ' min · ' + set.totalPoints + ' points';
                html += ' · assigned to ' + set.assignedInterviews + ' interview(s)</span>';
                html += '</div>';
                html += '<table class="table table-bordered mbn" cellpadding="0" cellspacing="0" style="margin:0;">';
                html += '<thead><tr><th width="30%" class="table_heading">Rubric parameter</th><th width="70%" class="table_heading">Question</th></tr></thead><tbody>';
                // Questions arrive in ask order. Do not re-sort them here.
                var questions = set.questions || [];
                for (var j = 0; j < questions.length; j++) {
                    html += '<tr><td>' + EscapeSetHtml(questions[j].skillName) + '</td><td>' + EscapeSetHtml(questions[j].questionText) + '</td></tr>';
                }
                html += '</tbody></table></div>';
            }
            $list.html(html);
        }

        function CreateAIQuestionSets() {
            if (!aiQuestionSetsEnabled) return;
            var irfid = $("#dmV4QuestionSetsPanel").data("irf-id");
            var $btn = $("#dmV4CreateQuestionSetsBtn");
            $btn.prop("disabled", true);
            $("#dmV4QuestionSetsMessage").text("Creating balanced sets...");

            $.ajax({
                type: "POST",
                url: "/IRF/CreateAIQuestionSets",
                data: { 'irfid': irfid },
                success: function (data) {
                    $btn.prop("disabled", false);
                    if (!data || !data.success) {
                        swal.fire({ text: (data && data.message) ? data.message : "The question sets could not be created." });
                        $("#dmV4QuestionSetsMessage").text((data && data.message) ? data.message : "");
                        return;
                    }
                    $("#dmV4QuestionSetsMessage").text(data.message || "");
                    LoadAIQuestionSets();

                    // Creating papers does not put them into use. Say so, or a channel sits with sets
                    // it never deals and nobody can tell that from a channel that failed to create any.
                    if (!$("#dmV4UseQuestionSetsToggle").is(":checked")) {
                        $("#dmV4UseQuestionSetsMessage").text("These sets are not in use yet. Switch this channel on to start dealing them.");
                    }
                },
                error: function () {
                    $btn.prop("disabled", false);
                    swal.fire({ text: "The question sets could not be created." });
                }
            });
        }

        function EscapeSetHtml(value) {
            return $("<div>").text(value == null ? "" : value).html();
        }
        function GetInstruction() {
            var irfId = $("#id").val();
            $.ajax({
                url: '/IRF/GetTextInstruction',
                data: { 'irfId': irfId },
                type: "POST",
                success: function (data) {
                    let text = "";
                    text += "<ui>";
                    for (let i = 0; i < data.length; i++) {
                        text += "<li>" + data[i].message + "</li>";
                    }
                    text += "</ui>";
                    $('#lblComments').empty().html(text);

                }
            });
        }

        $(document).ready(function () {
            var irfid = document.getElementById("id").value;
            $.ajax({
                type: "POST",
                url: "/IRF/GetFormatanddifficultylevel",
                data: { 'irfid': irfid },
                success: function (data) {
                    document.getElementById("Difficulty").value = data.difficultylevel;
                    if (data.format != null) {
                        for (var i = 0; i < data.format.split(",").length; i++) {
                            $("input[value='" + data.format.split(",")[i] + "']").prop('checked', true);
                        }
                    }
                    if (typeof window.dmV4SyncFormatCheckboxes === 'function') {
