@* V4 rubric details drawer (concepts & expectations) *@
<div id="dmV4RubricOverlay" class="dm-v4-drawer-overlay" aria-hidden="true"></div>
<aside id="dmV4RubricDrawer" class="dm-v4-drawer dm-v4-drawer--rubric" aria-hidden="true" role="dialog" aria-labelledby="dmV4DrawerTitle">
    <div class="dm-v4-drawer__head dm-v4-drawer__head--split">
        <div class="dm-v4-drawer__head-text">
            <div class="dm-v4-drawer__eyebrow" id="dmV4DrawerEyebrow">Skill details</div>
            <h3 class="dm-v4-drawer__title" id="dmV4DrawerTitle">—</h3>
        </div>
        <button type="button" class="dm-v4-drawer__close" id="dmV4DrawerHeadClose" aria-label="Close">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"/></svg>
        </button>
    </div>
    <div class="dm-v4-drawer__body">
        <label class="dm-v4-field-label" for="dmV4DrawerConcepts">Concepts</label>
        <textarea id="dmV4DrawerConcepts" class="form-control" rows="4" maxlength="500"></textarea>
        <label class="dm-v4-field-label" for="dmV4DrawerExpectations" style="margin-top:16px;">Expectations</label>
        <textarea id="dmV4DrawerExpectations" class="form-control" rows="4" maxlength="500"></textarea>
    </div>
    <div class="dm-v4-drawer__foot dm-v4-drawer__foot--rubric">
        <p class="dm-v4-drawer__foot-hint">Save writes concepts and expectations to the score rubric.</p>
        <div class="dm-v4-drawer__foot-actions">
