                                                                            <a class="dm-v4-iv-outcomes__link" target="_blank" rel="noopener" title="Rejected candidates on this channel" href="@Url.Action("InterviewerStatsDetailsForClient", "Interviewer", new { userId = iv.UserId, statType = StatsTypes.Rejected, irfId = Model.id, irfName = Model.IRFId, interviewerEmailId = ivStatsInterviewerId, usePl = isClientShareView ? "Public" : null, maskCandidate = "1" })">Rejected @ivRejectedCount</a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="dm-v4-iv-outcomes__empty" title="No rejected outcomes">Rejected 0</span>
                                                                        }
                                                                    </div>
                                                                    @if (!isPanelCompactView && !isSmeView && canEditDmIvOps)
                                                                    {
                                                                        <div class="dm-v4-iv-bad-quality-extra dm-v4-iv-bad-quality-extra--counts" hidden aria-hidden="true">
                                                                            <div class="dm-v4-iv-qc-counts" aria-label="QC verdict counts on this channel">
                                                                                <div class="dm-v4-iv-qc-count dm-v4-iv-qc-count--suspicious" title="QCMergedAIDetails suspicious verdicts">
                                                                                    <span class="dm-v4-iv-qc-count__label">Suspicious</span>
                                                                                    <span class="dm-v4-iv-qc-count__value dm-v4-mono">
                                                                                        @if (ivCompletedCount > 0)
                                                                                        {
                                                                                            @($"{iv.QcVerdictSuspiciousCount}/{ivCompletedCount}")
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            @iv.QcVerdictSuspiciousCount
                                                                                        }
                                                                                    </span>
                                                                                </div>
                                                                                <div class="dm-v4-iv-qc-count dm-v4-iv-qc-count--redo" title="QCMergedAIDetails redo verdicts">
                                                                                    <span class="dm-v4-iv-qc-count__label">Redo</span>
                                                                                    <span class="dm-v4-iv-qc-count__value dm-v4-mono">@iv.QcVerdictRedoCount</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <div class="dm-v4-iv-cell dm-v4-iv-cell--capacity">
                                                                    <div class="dm-v4-iv-capacity" data-capacity="@(ivCapExplicit ? iv.InterviewCapacity.ToString() : "")" data-cap-configured="@(ivCapExplicit ? "1" : "0")" data-cap-effective="@(ivCapShowUnlimited ? "" : ivCapVal.ToString())" data-cap-from-default="@(ivCapUsesDefault ? "1" : "0")" data-assigned="@ivAssigned">
                                                                        @if (ivCapShowUnlimited)
                                                                        {
                                                                            <span class="dm-v4-cap-unlimited" title="No interview limit configured">Unlimited</span>
                                                                        }
                                                                        else if (dmCapEnforced && ivCapExplicitZero && canEditIvOps)
                                                                        {
                                                                            <button type="button" class="dm-v4-cap-set-btn" title="Interview limit is 0 — interviewer cannot be assigned">@Html.Raw(dmV4PlusIcon) Set limit</button>
                                                                            <div class="dm-v4-cap-status dm-v4-cap-status--full">Cannot be assigned</div>
                                                                        }
                                                                        else if (dmCapEnforced && ivCapExplicitZero)
                                                                        {
                                                                            <span class="dm-v4-cap-unlimited dm-v4-cap-unlimited--blocked">0 · Cannot assign</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="dm-v4-cap-display">
                                                                                <span class="dm-v4-mono dm-v4-iv-cap-assigned">@ivAssigned</span>
                                                                                <span class="dm-v4-iv-cap-sep">/</span>
                                                                                @if (canEditIvOps)
                                                                                {
                                                                                    <button type="button" class="dm-v4-cap-pill v4-cap-pill" data-cap="@ivCapVal" title="Click to set this interviewer's interview limit">
                                                                                        <span class="dm-v4-cap-pill-val">@ivCapVal</span>
                                                                                        @if (ivCapUsesDefault)
                                                                                        {
                                                                                            <span class="dm-v4-cap-pill-default">(default)</span>
                                                                                        }
                                                                                        @Html.Raw(dmV4MoneyEditIcon)
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="dm-v4-mono dm-v4-cap-readonly">@ivCapVal</span>
                                                                                }
                                                                            </div>
                                                                            @if (ivCapVal > 0)
                                                                            {
                                                                                <div class="dm-v4-cap-bar"><span class="dm-v4-cap-bar-fill dm-v4-cap-bar-fill--@ivCapBar" style="width:@(ivCapPct)%"></span></div>
                                                                                if (dmCapEnforced && ivAssigned >= ivCapVal)
                                                                                {
                                                                                    <div class="dm-v4-cap-status dm-v4-cap-status--full">FULL · CAPPED</div>
                                                                                }
                                                                                else if (dmCapEnforced && ivCapPct >= 80)
                                                                                {
                                                                                    <div class="dm-v4-cap-status dm-v4-cap-status--near">NEAR LIMIT</div>
                                                                                }
                                                                            }
                                                                        }
                                                                    </div>
                                                                </div>
