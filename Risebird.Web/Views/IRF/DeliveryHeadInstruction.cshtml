                                                            {
                                                                <span class="dm-v4-badge dm-v4-badge--green" id="dmV4VoiceRecordedBadge">RECORDED</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="dm-v4-badge dm-v4-badge--green" id="dmV4VoiceRecordedBadge" hidden>RECORDED</span>
                                                            }
                                                        </div>
                                                        <p class="dm-v4-voice-hero__copy">
                                                            Record context, expectations and edge-cases the interviewer panel should hear before this candidate. We'll transcribe automatically — you can re-use the transcript to seed the rubric or sample questions.
                                                        </p>
                                                        <audio id="dmV4VoiceAudio" preload="metadata" src="@(dmV4HasVoice ? Model.AudioComment : "")" style="display:none;"></audio>
                                                        <div class="dm-v4-voice-preview-grid@(dmV4HasVoice ? "" : " dm-v4-voice-preview-grid--empty")">
                                                            <div class="dm-v4-voice-preview-card dm-v4-voice-preview-card--recording">
                                                                <div class="dm-v4-voice-preview-card__head">
                                                                    <span class="dm-v4-voice-preview-card__label">Recording</span>
                                                                    <span class="dm-v4-voice-preview-card__meta" id="dmV4VoiceTime" @(dmV4HasVoice ? "" : "hidden")>0:00 / —</span>
                                                                </div>
                                                                <div class="dm-v4-voice-wave-row" id="dmV4VoiceWaveRow" @(dmV4HasVoice ? "" : "hidden")>
                                                                    <button type="button" class="dm-v4-voice-play-btn" id="dmV4VoicePlayBtn" aria-label="Play recording">
                                                                        <svg class="dm-v4-voice-play-icon dm-v4-voice-play-icon--play" viewBox="0 0 12 12" fill="currentColor" width="8" height="8" aria-hidden="true"><path d="M3 2l6 4-6 4V2z" /></svg>
                                                                        <svg class="dm-v4-voice-play-icon dm-v4-voice-play-icon--pause" viewBox="0 0 12 12" fill="currentColor" width="8" height="8" aria-hidden="true"><path d="M3 2h2v8H3V2zm4 0h2v8H7V2z" /></svg>
                                                                    </button>
                                                                    <div class="dm-v4-voice-waveform" id="dmV4VoiceWaveform" aria-hidden="true">
                                                                        @for (var dmV4Bar = 0; dmV4Bar < 64; dmV4Bar++)
                                                                        {
                                                                            var dmV4BarH = 6 + (int)(Math.Abs(Math.Sin(dmV4Bar * 0.5) * Math.Sin(dmV4Bar * 0.18)) * 28) + (dmV4Bar % 3 == 0 ? 4 : 0);
                                                                            <span class="dm-v4-voice-waveform__bar" style="height:@(dmV4BarH)px" data-bar="@dmV4Bar"></span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <p class="dm-v4-voice-preview-card__empty" id="dmV4VoiceRecordingEmpty" @(dmV4HasVoice ? "hidden" : "")>No recording yet. Use the mic button or Record below.</p>
                                                            </div>
                                                            <div class="dm-v4-voice-preview-card dm-v4-voice-preview-card--transcript" id="dmV4VoiceTranscriptWrap">
                                                                <div class="dm-v4-voice-preview-card__head">
                                                                    <span class="dm-v4-voice-preview-card__label">Transcript</span>
                                                                    <span class="dm-v4-badge dm-v4-badge--indigo">WHISPER</span>
                                                                </div>
                                                                <p class="dm-v4-voice-transcript__empty" id="dmV4VoiceTranscriptEmpty" @(dmV4HasTranscript ? "hidden" : "")>Record voice instructions to transcribe automatically, or type a brief below.</p>
