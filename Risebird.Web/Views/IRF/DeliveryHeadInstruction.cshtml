                                                 data-is-ai-preset="@(Model.IsAIInterview && Model.AIInterviewType == (int)AIInterviewTypeEnum.Preset ? "1" : "0")"
                                                 data-rubric-skills="@string.Join("|||", rubricSkillNames)">
                                                <div class="dm-v4-questions-ai-banner">
                                                    <div class="dm-v4-questions-ai-banner__left">
                                    @*                     <span class="dm-v4-questions-ai-icon"><i class="fa fa-magic"></i></span> *@
