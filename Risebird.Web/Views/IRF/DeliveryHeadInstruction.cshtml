@model Risebird.Entities.ViewModel.IRFVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "Interviews";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<h3 class="tab_drawer_heading" rel="tab-3">Tech Skill</h3>

<div class="main-panel " id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                      
@using (Html.BeginForm("DeliveryHeadInstruction", "IRF", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "irfForm", @onsubmit = "return CheckConditions()" }))
 {
<h3 class="tab_drawer_heading" rel="tab-3">Tech Skill</h3>
<div class="tab-box" id="tab-3">
    <div class="tab-main-box">
        <div class="row">

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="table-responsive-sm">
                    <input type="text" id="txtinterviewerskills" value="@ViewBag.InterviewerSkills" hidden />

                    <table class="table table-bordered mbn" id="SkillTable">
                        <thead>
                            <tr>

                                <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                                <th width="35%" class="table_heading">Skill Name<span class="red">*</span></th>
                                <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>
                                <th width="10%" class="table_heading">Concepts</th>
                                <th width="30%" class="table_heading">Nature of questions</th>
                                <th width="10%" class="table_heading">Time limit</th>
                                <th width="10%" class="table_heading text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SkillCollection == null || Model.SkillCollection.Count() == 0)
                            {
                                <tr>
                                    <td>
                                        @Html.DropDownList("SkillCollection[0].LevelId", (SelectList)ViewBag.LevelTech, "Select", new { @class = "select-css form-control " })

                                    </td>
                                    <td>
                                        @Html.DropDownList("SkillCollection[0].SkillId", (SelectList)ViewBag.Skill, "Select", new { @class = "select-css form-control " })
                                    </td>
                                    <td>
                                        <input class="form-control text-box single-line" id="SkillCollection_0__Weightage" name="SkillCollection[0].Weightage" type="number" max="100" min="1" value="100">
                                    </td>
                                    <td>
                                        <input class="form-control text-box single-line" id="SkillCollection_0__Concepts" name="SkillCollection[0].Concepts" type="text" maxlength="50">
                                    </td>
                                    <td>
                                        <input class="form-control text-box single-line" id="SkillCollection_0__Natureofquestion" name="SkillCollection[0].Natureofquestion" type="text" maxlength="50">
                                    </td>
                                    <td>
                                        <input class="form-control text-box single-line" id="SkillCollection_0__Timelimit" name="SkillCollection[0].Timelimit" type="number" max="30" min="1">
                                    </td>
                                    <td class="action text-center">

                                        <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                        <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>


                                    </td>
                                </tr>

                            }
                            else
                            {
                                for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                {
                                    <tr>

                                        <td>

                                            @Html.DropDownListFor(m => m.SkillCollection[i].LevelId, (SelectList)ViewBag.LevelTech, new { @class = "form-control select-css" })

                                        </td>
                                        <td>
                                            @Html.DropDownListFor(m => m.SkillCollection[i].SkillId, (SelectList)ViewBag.Skill, new { @class = "select-css form-control" })
                                        </td>

                                        <td>
                                            @Html.EditorFor(m => m.SkillCollection[i].Weightage, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                        </td>
                                        <td>
                                            @Html.EditorFor(m => m.SkillCollection[i].Concepts, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                        </td>
                                        <td>
                                            @Html.EditorFor(m => m.SkillCollection[i].Natureofquestion, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                        </td>
                                        <td>
                                            @Html.EditorFor(m => m.SkillCollection[i].Timelimit, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "30", @min = "1" } })
                                        </td>
                                        <td class="action text-center">
                                            <div>

                                                <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                            </div>
                                        </td>
                                    </tr>

                                }
                            }


                        </tbody>
                    </table>
                    <label class="text-danger" id="SkillCollection_WeightageError"></label>
                    <label class="text-danger" id="SkillCollection_WeightageErrorDown" style="color:white!important; margin-left:415px"></label>
                </div>
            </div>

        </div>
    </div>
</div>
}
</div>
</div>
</div>
</div>
</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>
<script src="~/js/SkillChannelAddEdit.js"></script>
<script src="~/js/addeditskillchannelcommonmethods.js"></script>
<script>
    function AddRow() {
     //document.getElementById("btnUpload").disabled = false;

     var table = document.getElementById("SkillTable");
     var rowCount = table.rows.length;
     //if (rowCount == 6) {
     //    alert("Cannot add more than 5 Tech Skills.");
     //    return;
     //}

     var $ttc = $("#SkillTable").find("tbody tr:last");
     var $tr = $ttc.clone();
     var trIndexReplaced = $("#SkillTable tr").length - 1;

     $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
         var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
         return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
     }).attr("id", function () { // change id also
         var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
         return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
     });
     $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
         var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
         return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
     })



     // reset fields in the new row
     $tr.find("select").val("");
     $tr.find("input[type=text]").val("");
     $tr.find("input[type=hidden]").val("");

     $tr.find("a").val("");

     // add cloned row as last row
     $("#SkillTable").find("tbody tr:last").after($tr);

     // Find the affected form
     var $form = $tr.closest("FORM");

     // Unbind existing validation
     $form.unbind();
     $form.data("validator", null);

     // Check document for changes
     // $.validator.unobtrusive.parse(document);
     // document.getElementById("btnUpload").disabled = false;

 }


 function DeleteRowSkills(element, collectionName, tdOne, tdTwo, tdThree, tdFour, tdFive, tdSix, tdSeven) {

     if ($(element).parents('tbody').find('tr').length === 1) {

         alert('Must have atleast one Row');
         return false;
     }

     else {
         document.getElementById("btnUpload").disabled = false;

         //var currentvalue = $(this).attr('value');
         var closestRow = $(element).closest('tr');
         var currentIndex = closestRow[0].sectionRowIndex;
         var totalRows = $(element).parents('tbody').find('tr').length;
         var maxIndex = totalRows - 1;
         if (currentIndex == maxIndex) {
             $(element).closest('tr').remove();
         }
         //ClientCollection_1__ClientRoleId
         else {
             $(element).closest('tr').remove();
             var startIndex = currentIndex + 1;
             var endIndex = maxIndex + 1;
             for (i = startIndex; i < endIndex; i++) {
                 var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                 elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                 //name="ClientCollection[3].ClientUserId"
                 elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                 var elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                 elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                 elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                 var elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                 elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                 elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;

                 if (tdFour != '') {
                     var elem4 = document.getElementById(collectionName + "_" + i + "__" + tdFour);
                     elem4.id = collectionName + "_" + (i - 1) + "__" + tdFour;
                     elem4.name = collectionName + "[" + (i - 1) + "]." + tdFour;
                 }
                 if (tdFive != null && tdFive != '') {
                     var elem5 = document.getElementById(collectionName + "_" + i + "__" + tdFive);
                     elem5.id = collectionName + "_" + (i - 1) + "__" + tdFive;
                     elem5.name = collectionName + "[" + (i - 1) + "]." + tdFive;
                 }
                 if (tdSix != null && tdSix != '') {
                     var elem6 = document.getElementById(collectionName + "_" + i + "__" + tdSix);
                     elem6.id = collectionName + "_" + (i - 1) + "__" + tdSix;
                     elem6.name = collectionName + "[" + (i - 1) + "]." + tdSix;
                 }
                 if (tdSeven != null && tdSeven != '') {
                     var elem7 = document.getElementById(collectionName + "_" + i + "__" + tdSeven);
                     elem7.id = collectionName + "_" + (i - 1) + "__" + tdSeven;
                     elem7.name = collectionName + "[" + (i - 1) + "]." + tdSeven;
                 }


             }

         }

     }

 }
</script>
