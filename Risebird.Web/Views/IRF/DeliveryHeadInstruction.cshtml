<div class="main-panels " id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->
    @if (!openSubmitEmailPopup)
    {
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div style="margin-top:30px;">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div class="interviewWrapper dataloading dm-v4-page@(isClientShareView ? " dm-v4-page--client-share" : "")@(isSmeView ? " dm-v4-page--sme" : "")" data-client-share="@(isClientShareView ? "1" : "0")" data-sme-view="@(isSmeView ? "1" : "0")">
                                <div class="col-md-12 pull-left pad10 dm-v4-chrome-wrap" style="padding-bottom:0;">
                                    <div class="dm-v4-chrome">
                                        <div class="dm-v4-breadcrumb">
                                            <span>RB-Interviews</span>
                                            <span>/</span>
                                            <span>@(string.IsNullOrEmpty(Model.IRFId) ? "JOB" : Model.IRFId)</span>
                                            <span>/</span>
                                            <strong>DM Approval</strong>
                                        </div>
                                        <div class="dm-v4-chrome__actions">
                                            @if (Model.DMApproved)
                                            {
                                                <span class="dm-v4-status-pill dm-v4-status-pill--approved"><span class="dm-v4-status-pill__dot"></span>Approved</span>
                                            }
                                            else
                                            {
                                                <span class="dm-v4-status-pill dm-v4-status-pill--pending"><span class="dm-v4-status-pill__dot"></span>Pending DM approval</span>
                                            }
                                            @if (!Model.DMApproved && (ViewBag.profileName == "Client" || ViewBag.profileName == "Public"))
                                            {
                                                <button style="outline: none !important;border: none!important;font-weight: 600;" type="button" class="dm-v4-status-pill dm-v4-status-pill--approved" onclick="ApproveDH(@Model.id)">
                                                  <span class="dm-v4-status-pill__dot"></span><span> Approve</span>
                                                </button>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.JDLink))
                                            {
                                                <a class="dm-v4-btn dm-v4-btn--ghost" href="@Model.JDLink" target="_blank" rel="noopener"><i class="fa fa-link"></i> JD link</a>
                                            }
                                        </div>
                                    </div>
                                    <div class="dm-v4-job-header">
                                        <div>
                                            <div class="dm-v4-job-eyebrow">
                                                <span>Job · @(string.IsNullOrEmpty(Model.IRFId) ? Model.id.ToString() : Model.IRFId)</span>
                                                <span class="dm-v4-badge dm-v4-badge--indigo">TECH</span>
                                            </div>
                                            <h1>@(string.IsNullOrEmpty(Model.JDTiltle) ? "Instructions for Interviewer Guidance" : Model.JDTiltle)</h1>
                                            <div class="dm-v4-job-subline">
                                                Client <strong>@(Model.ClientName ?? "—")</strong>
                                                @if (Model.StartDate != default)
                                                {
                                                    <span> · @Model.StartDate.ToString("dd MMM yyyy")</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="dm-v4-content col-md-12 pull-left pad10" style="padding-bottom:0;">

                                    @* 1 · Voice brief (V4 hero — existing record / playback flow) *@
                                    @{
                                        var dmV4HasVoice = !string.IsNullOrEmpty(Model.AudioComment);
                                        var dmV4HasTranscript = !string.IsNullOrWhiteSpace(Model.VoiceInstructionTranscript);
                                    }
                                    <div class="col-md-12 pull-left pad10 dm-v4-block dm-v4-block--order-voice" style="padding:0;">
                                        <section class="dm-v4-section dm-v4-section--pinned">
                                            <div class="dm-v4-voice-hero" id="dmV4VoiceHero">
                                                <div class="dm-v4-voice-hero__blob" aria-hidden="true"></div>
                                                <div class="dm-v4-voice-hero__inner">
                                                    <button type="button" class="dm-v4-voice-record-btn" onclick="OpenVoiceRecordingModal(@Model.id)" title="Record voice instructions" aria-label="Record voice instructions">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
                                                            <rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor" />
                                                            <path d="M5 11a7 7 0 0014 0M12 18v3M9 21h6" stroke-linecap="round" />
                                                        </svg>
                                                    </button>
                                                    <div class="dm-v4-voice-hero__main">
                                                        <div class="dm-v4-voice-hero__title-row">
                                                            <span class="dm-v4-voice-hero__title">Voice instructions</span>
                                                            <span class="dm-v4-badge dm-v4-badge--indigo">PLAYS BEFORE INTERVIEW</span>
