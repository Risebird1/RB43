@await Html.PartialAsync("~/Views/Common/_InterviewerInsights.cshtml")
<script src="~/js/dm-v4-questions.js?v=20260825gist-ai"></script>

<div id="dmV4ResumeSummaryOverlay" class="dm-v4-drawer-overlay" aria-hidden="true"></div>
<aside id="dmV4ResumeSummaryDrawer" class="dm-v4-drawer dm-v4-drawer--verdict" aria-hidden="true" role="dialog" aria-labelledby="dmV4ResumeSummaryTitle" style="max-width:520px;">
    <div class="dm-v4-drawer__head dm-v4-drawer__head--split">
        <div class="dm-v4-drawer__head-text">
            <div class="dm-v4-drawer__eyebrow">AI-powered</div>
            <h3 class="dm-v4-drawer__title" id="dmV4ResumeSummaryTitle">Resume Summary</h3>
        </div>
        <button type="button" class="dm-v4-drawer__close" id="dmV4ResumeSummaryClose" aria-label="Close">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round"/></svg>
        </button>
    </div>
    <div class="dm-v4-drawer__body" id="id_candidateResumeSummaryBody" style="overflow-y:auto;">
        <p class="text-muted" style="text-align:center;padding:40px 0;">Click "Resume Summary" on an interviewer to load.</p>
    </div>
    <div class="dm-v4-drawer__foot">
        <button type="button" class="dm-v4-btn dm-v4-btn--ghost dm-v4-btn--sm" id="dmV4ResumeSummaryDone">Close</button>
    </div>
</aside>
<script>
    (function () {
        var $overlay = $('#dmV4ResumeSummaryOverlay');
        var $drawer = $('#dmV4ResumeSummaryDrawer');
        function openResumeSummaryDrawer() {
            $overlay.addClass('is-open').attr('aria-hidden', 'false');
            $drawer.addClass('is-open').attr('aria-hidden', 'false');
        }
        function closeResumeSummaryDrawer() {
            $overlay.removeClass('is-open').attr('aria-hidden', 'true');
            $drawer.removeClass('is-open').attr('aria-hidden', 'true');
        }
        $('#dmV4ResumeSummaryClose, #dmV4ResumeSummaryDone').on('click', closeResumeSummaryDrawer);
        $overlay.on('click', closeResumeSummaryDrawer);
        $(document).on('keydown', function (e) { if (e.key === 'Escape' && $drawer.hasClass('is-open')) closeResumeSummaryDrawer(); });
        window.openResumeSummaryDrawer = openResumeSummaryDrawer;
        window.closeResumeSummaryDrawer = closeResumeSummaryDrawer;
        if (typeof patchDmV4ResumeSummaryDrawerClose === 'function') {
            patchDmV4ResumeSummaryDrawerClose();
        }
    })();
</script>

