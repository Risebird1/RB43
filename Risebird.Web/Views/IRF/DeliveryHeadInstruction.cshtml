                                                                        <button type="button" class="dm-v4-vet-btn @(!clientVetOn ? "is-on" : "")" data-vet-value="0" @(!rbVetDisplayOn || !canToggleClientVet ? "disabled" : "")>No</button>
                                                                    </div>
                                                                    <div class="dm-v4-iv-vet-sub dm-v4-iv-vet-sub--client">
                                                                        @(!iv.IsActive
                                                                            ? (ivStatusTone == "inactive" ? "Inactive on panel" : "Blocked — needs RB Vet first")
                                                                            : (rbVetDisplayOn
                                                                                ? (clientVetOn ? "Signed off by client" : "Awaiting client sign-off")
                                                                                : "Blocked — needs RB Vet first"))
                                                                    </div>
                                                                    <input type="hidden" class="dm-v4-client-action-hidden" value="@(iv.ClientAction ?? "")" />
                                                                </div>
                                                                }
                                                                else if (isSmeView)
                                                                {
                                                                <div class="dm-v4-iv-cell dm-v4-iv-cell--vet dm-v4-iv-cell--rb-vet">
                                                                    <div class="dm-v4-vet-toggle" data-vet="rb">
                                                                        <button type="button" class="dm-v4-vet-btn @(rbVetDisplayOn ? "is-on" : "")" data-vet-value="1" @(canEditIvOps ? "" : "disabled")>Yes</button>
                                                                        <button type="button" class="dm-v4-vet-btn @(!rbVetDisplayOn ? "is-on" : "")" data-vet-value="0" @(canEditIvOps ? "" : "disabled")>No</button>
                                                                    </div>
                                                                    <div class="dm-v4-iv-vet-sub">@(!iv.IsActive
                                                                        ? (ivStatusTone == "available" ? "Awaiting RB review" : "Inactive on panel")
                                                                        : (rbVetDisplayOn ? "Risebird verified" : "Awaiting RB review"))</div>
                                                                    <input type="hidden" class="dm-v4-rb-vet-hidden" value="@(rbVetDisplayOn ? "true" : "false")" />
                                                                </div>
                                                                }
                                                                else if (isClientShareView)
                                                                {
                                                                <div class="dm-v4-iv-cell dm-v4-iv-cell--vet dm-v4-iv-cell--client-vet">
                                                                    <div class="dm-v4-vet-toggle" data-vet="client" title="@(!rbVetDisplayOn ? "Needs RB Vet first." : "")">
                                                                        <button type="button" class="dm-v4-vet-btn @(clientVetOn ? "is-on" : "")" data-vet-value="1" @(!rbVetDisplayOn || !canToggleClientVet ? "disabled" : "")>Yes</button>
                                                                        <button type="button" class="dm-v4-vet-btn @(!clientVetOn ? "is-on" : "")" data-vet-value="0" @(!rbVetDisplayOn || !canToggleClientVet ? "disabled" : "")>No</button>
                                                                    </div>
                                                                    <div class="dm-v4-iv-vet-sub dm-v4-iv-vet-sub--client">
                                                                        @(clientVetOn ? "Approved for your panel" : "Awaiting your approval")
                                                                    </div>
                                                                    <input type="hidden" class="dm-v4-client-action-hidden" value="@(iv.ClientAction ?? "")" />
                                                                </div>
                                                                }
                                                            </div>
                                                            }
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        </section>
