@using System.Text.RegularExpressions
@using Newtonsoft.Json
@functions {
    string DmV4VerdictTone(string verdict)
    {
        if (string.IsNullOrWhiteSpace(verdict)) return "muted";
        var v = verdict.Trim().ToLowerInvariant();
        if (v.Contains("yes") || v.Contains("pass") || v.Contains("recommend")) return "pass";
        if (v.Contains("no") || v.Contains("fail") || v.Contains("block") || v.Contains("reject")) return "fail";
        return "warn";
    }
    string DmV4VerdictLabel(string verdict, string tone)
    {
        if (string.IsNullOrWhiteSpace(verdict)) return "Pending";
        if (tone == "pass") return "Yes";
        if (tone == "fail") return "No";
        return "Conditional Yes";
    }
    string DmV4VerdictIconSvg(string tone)
    {
        if (tone == "pass") return @"<svg viewBox=""0 0 16 16"" fill=""none"" stroke=""currentColor"" stroke-width=""1.8"" width=""11"" height=""11""><path d=""M3.5 8.5l3 3L13 5"" stroke-linecap=""round"" stroke-linejoin=""round""/></svg>";
        if (tone == "fail") return @"<svg viewBox=""0 0 16 16"" fill=""none"" stroke=""currentColor"" stroke-width=""1.6"" width=""11"" height=""11""><path d=""M4 4l8 8M12 4l-8 8"" stroke-linecap=""round""/></svg>";
        if (tone == "warn") return @"<svg viewBox=""0 0 16 16"" fill=""none"" stroke=""currentColor"" stroke-width=""1.5"" width=""11"" height=""11""><path d=""M8 2l6.5 11.5h-13L8 2z"" stroke-linejoin=""round""/><path d=""M8 6.5v3M8 11.5v.5"" stroke-linecap=""round""/></svg>";
        return @"<svg viewBox=""0 0 16 16"" fill=""none"" stroke=""currentColor"" stroke-width=""1.4"" width=""11"" height=""11""><circle cx=""8"" cy=""8"" r=""6""/><path d=""M8 7v4M8 5v.5"" stroke-linecap=""round""/></svg>";
    }
    string DmV4VerdictHeroTitle(string tone)
    {
        if (tone == "pass") return "PASS · Recommended for panel";
        if (tone == "fail") return "BLOCK · Do not assign";
        if (tone == "warn") return "REVIEW · Manual sign-off advised";
        return "PENDING · AI screening not run";
    }
    string DmV4VerdictFlagsTitle(string tone)
    {
        if (tone == "pass") return "Why we recommend";
        if (tone == "fail") return "Why we block";
        if (tone == "warn") return "What needs review";
        return "Screening notes";
    }
    string DmV4VerdictReason(string verdict)
    {
        if (string.IsNullOrWhiteSpace(verdict)) return "AI screening not run for this skill channel yet.";
        var tone = DmV4VerdictTone(verdict);
        if (tone == "pass") return "Meets rubric and resume signals for this role.";
        if (tone == "fail") return "Below threshold — review before assigning interviews.";
        return "Manual sign-off advised before panel activation.";
    }
    string DmV4AiReasoningFull(TransInterviewer iv)
    {
        if (iv == null || string.IsNullOrWhiteSpace(iv.OpenAIScreeningResponse)) return null;
        var text = iv.OpenAIScreeningResponse.Trim();
        if (text.StartsWith("{", StringComparison.Ordinal))
        {
            try
            {
                var parsed = JsonConvert.DeserializeObject<InterviewerResumeFitmentAnalysisSchema>(text);
                if (!string.IsNullOrWhiteSpace(parsed?.completeFitmentAnalysis))
                    return parsed.completeFitmentAnalysis.Trim();
            }
            catch { }
        }
        return text;
    }
    string DmV4VerdictReasonSnippet(TransInterviewer iv, int maxLen = 30)
    {
        var full = DmV4AiReasoningFull(iv);
        if (!string.IsNullOrWhiteSpace(full))
        {
            var flat = Regex.Replace(full, @"\s+", " ").Trim();
            return flat.Length <= maxLen ? flat : flat.Substring(0, maxLen) + "…";
        }
        return DmV4VerdictReason(iv?.AIVerdict);
    }
    bool DmV4ClientVetYes(TransInterviewer iv) => string.Equals(iv?.ClientAction, "Shortlisted", StringComparison.OrdinalIgnoreCase);
    bool DmV4RbVetDisplayYes(TransInterviewer iv, bool channelLocked) => DmIvVetDisplayHelper.ResolveRbVetYes(channelLocked, iv);
    bool DmV4RbVetStoredYes(TransInterviewer iv) => DmIvVetDisplayHelper.ResolveRbVetStored(iv);
    bool DmV4ClientVetDisplayYes(TransInterviewer iv, bool channelLocked, bool rbVetDisplayOn) =>
        DmIvVetDisplayHelper.ResolveClientVetYes(channelLocked, iv, rbVetDisplayOn);
    bool DmV4ClientVetStoredYes(TransInterviewer iv, bool rbVetStoredOn) =>
        DmIvVetDisplayHelper.ResolveClientVetStored(iv, rbVetStoredOn);
    string DmV4IvStatusTone(TransInterviewer iv)
    {
        if (iv == null) return "muted";
        if (iv.IsActive) return "active";
        if (DmIvActiveHelper.IsAwaitingRbVet(iv.IsSMEVerified, iv.ClientAction)) return "available";
        return "inactive";
    }
    string DmV4IvStatusLabel(TransInterviewer iv)
    {
        var tone = DmV4IvStatusTone(iv);
        if (tone == "active") return "Active";
        if (tone == "available") return "Available";
        return "Inactive";
    }
    DmIvInactiveReasonResult DmV4InactiveReasonBadge(TransInterviewer iv, bool channelLocked) =>
        !iv.IsActive ? DmIvInactiveReasonHelper.Resolve(iv, channelLocked) : null;
    DmIvActiveBadQualityBadge DmV4ActiveBadQualityBadge(TransInterviewer iv) =>
        DmIvBadQualityFlagHelper.ResolveActiveBadge(iv);
    /// <summary>True when TransInterviewer.InterviewCapacity is set (explicit per-row override).</summary>
    bool DmV4CapExplicit(TransInterviewer iv) =>
        iv?.InterviewCapacity != null;
    DmIvCapRowState DmV4CapState(TransInterviewer iv, int channelDefaultCap, bool limitedPolicy) =>
        DmIvCapHelper.GetCapStateForRow(limitedPolicy, iv?.InterviewCapacity, iv?.TotalFuture ?? 0, channelDefaultCap);
    int DmV4CapVal(TransInterviewer iv, int channelDefaultCap, bool limitedPolicy) =>
        DmV4CapState(iv, channelDefaultCap, limitedPolicy).EffectiveCap;
    bool DmV4CapShowUnlimited(TransInterviewer iv, int channelDefaultCap, bool limitedPolicy) =>
        DmV4CapState(iv, channelDefaultCap, limitedPolicy).ShowUnlimited;
    bool DmV4CapUsesDefault(TransInterviewer iv, int channelDefaultCap, bool limitedPolicy) =>
        DmV4CapState(iv, channelDefaultCap, limitedPolicy).UsesChannelDefault;
    bool DmV4CapExplicitZero(TransInterviewer iv) =>
        iv?.InterviewCapacity != null && iv.InterviewCapacity.Value == 0;
    string DmV4IsoTimestamp(DateTime? value) =>
        value.HasValue && value.Value.Year >= 1900 ? value.Value.ToString("o") : "";
    /// <summary>Same label as Interviewer Insights popup (CompanyName, else EmploymentComment).</summary>
    string DmV4IvCompanyDisplay(TransInterviewer iv)
    {
        if (!string.IsNullOrWhiteSpace(iv?.CompanyName)) return iv.CompanyName.Trim();
        if (!string.IsNullOrWhiteSpace(iv?.EmploymentComment)) return iv.EmploymentComment.Trim();
        return null;
    }
    /// <summary>Same roles as /IRF/UploadInterviewerResume and /IRF/EditIRFInterviewers.</summary>
    bool DmV4CanUploadIvResume(string profileName)
    {
        var p = (profileName ?? "").Trim().Trim('"');
        return p == "Admin" || p == "SupportAdmin" || p == "InterviewerManagement"
            || p == "SeniorInterviewerManagement" || p == "SeniorHR";
    }
    bool DmV4IvHasResume(TransInterviewer iv) => !string.IsNullOrWhiteSpace(iv?.ResumeLink);
    bool DmV4IvHasCodedCv(TransInterviewer iv) => !string.IsNullOrWhiteSpace(iv?.CodedResumeLink);
    bool DmV4IvHasOpenAiCodedCv(TransInterviewer iv) => DmIvCodedCvHelper.HasDisplayCodedCv(iv?.CodedResumeLink);
    string DmV4IvDisplayCodedCvLink(TransInterviewer iv) => DmIvCodedCvHelper.GetDisplayCodedCvLink(iv?.CodedResumeLink);
    string DmV4LevelLabel(int? levelId)
    {
        if (levelId == null || levelId == 0) return "Proficient";
        if (Enum.IsDefined(typeof(LevelTechEnum), levelId.Value))
            return Enum.GetName(typeof(LevelTechEnum), levelId.Value);
        return "Proficient";
    }
    string DmV4LevelChipClass(int? levelId) => "dm-v4-level-chip dm-v4-level-chip--" + DmV4LevelLabel(levelId).ToLowerInvariant();
    int? DmV4SkillLevelId(string skillName)
    {
        var skill = Model.SkillCollection?.FirstOrDefault(x => string.Equals(x.SkillName, skillName, StringComparison.OrdinalIgnoreCase));
        return skill?.LevelId;
    }
}
@using Risebird.Entities.Data
@using Risebird.Entities.Enum
@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Delivery Head Instruction";
    bool isClientShareView = ViewBag.IsClientShareView == true;
    bool isSmeView = ViewBag.IsSmeView == true;
    bool isPanelCompactView = isSmeView;
    bool openSubmitEmailPopup = false;
    bool isAiPresetChannel = Model != null && Model.IsAIInterview && Model.AIInterviewType == (int)AIInterviewTypeEnum.Preset;
    // Confidentiality guard 1 of 3 (the Razor gate). Sets, scores and difficulty must never reach a
    // candidate or a client: the client-share path renders with isClientShareView true, so the whole
    // section is never emitted there. Guard 2 is the JavaScript flag below, which keeps those pages
    // from requesting sets at all, and guard 3 is the endpoint, which returns nothing for a channel
    // that is not preset regardless of caller. Keep all three.
    bool showQuestionSets = !openSubmitEmailPopup && !isClientShareView && isAiPresetChannel;
}
<script>
    window.dmV4ClientShareView = @(isClientShareView ? "true" : "false");
    window.dmV4SmeView = @(isSmeView ? "true" : "false");
    window.dmV4ClientShareType = '@DeliveryHeadInstructionViewMode.ClientShareTypeParam';
</script>
<script>
    var Header = "Delivery Head Instruction";
    $('#txtpageHeader').empty().html(Header);
</script>

