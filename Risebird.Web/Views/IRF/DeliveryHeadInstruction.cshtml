<script>
    /**
    *	Multiple Hidden Areas in a Form.
    *
    *	Instructions:
    *
    * 1. Add the 'trigger' class to checkboxes that will act as a trigger to show/hide area.
    * 2. Create a wrapper <div> around the field(s) you want to hide and give this an ID (whatever you want) and the class 'hidden'.
    * 3. Moving back to the checkbox, add a data-trigger attribute and set its value to the ID of the wrapper div that contains the fields you want to hide.
    * e.g. <input type="checkbox" name="checkbox" id="checkbox" class="trigger" data-trigger="my_hidden_fields">
    *      <div id="my_hidden_fields" class="hidden">
    *        Name: <input type="text" name="name">
    *      </div>
    *
    * The code below will automatically setup event listeners for any checkboxes with the 'trigger' class.
    * All elements with the 'hidden' class will be hidden when the page loads.
    * When a checkbox is checked the code will take the value from the data-trigger attribute on the
    * checkbox and use this to select the wrapper <div> that needs to be shown/hidden.
    */


    $(function () {
        // Hide the hidden sections.
        // Use JS to do this in case the user doesn't have JS
        // enabled.
        $('.hidden').hide();
        if (typeof window.applyDmV4Layout === 'function') {
            window.applyDmV4Layout();
        }
        // Setup an event listener for each trigger checkbox that
        // fires when the state of the checkbox changes.
        $('.trigger').change(function () {
            // Get the ID of the hidden area from the data-trigger
            // attribute.
            var hiddenId = $(this).attr("data-trigger");
            // Check to see if the checkbox is checked.
            // If it is, show the fields and populate the input.
            // If not, hide the fields.
            if ($(this).is(':checked')) {
                // Show the hidden fields.
                $("#" + hiddenId).show();
                $("#" + hiddenId + "_1" + ".collapsible-panel").show();
                $("#" + hiddenId + "_1" + ".expand-panel").hide();

            } else {
                // Make sure that the hidden fields are indeed
                // hidden.
                $("#" + hiddenId).hide();
                $("#" + hiddenId + "_1" + ".collapsible-panel").hide();
                $("#" + hiddenId + "_1" + ".expand-panel").show();
                // You may also want to clear the value of the
                // hidden fields here. Just in case somebody
                // shows the fields, enters data to them and then
                // unticks the checkbox.
                //
                // This would do the job:
                //
                // $("#hidden_field").val("");
            }
        });
    });

    function dmV4SetVoiceModalSavedLink(url) {
        var $saved = $('#playUploadedAudioTwo');
        var anchor = document.getElementById('anchorAudioId');
        var audio = document.getElementById('controlAudioId');
        if (!url || !String(url).trim()) {
            $saved.addClass('dm-v4-voice-modal__saved--empty');
            if (anchor) {
                anchor.removeAttribute('href');
                var nameEl = anchor.querySelector('.dm-v4-voice-modal__file-name');
                if (nameEl) nameEl.textContent = '';
            }
            if (audio) audio.removeAttribute('src');
            return;
        }
        $saved.removeClass('dm-v4-voice-modal__saved--empty');
        if (audio) audio.src = url;
        if (anchor) {
            anchor.href = url;
            var fileName = url.split('/').pop() || 'audio';
            var nameEl = anchor.querySelector('.dm-v4-voice-modal__file-name');
            if (nameEl) nameEl.textContent = fileName;
        }
    }

    function dmV4SetRecordingStatus(message, state) {
        var el = document.getElementById('recordingStatus');
        if (!el) return;
        var base = 'dm-v4-voice-recorder__status';
        el.className = base + (state ? ' ' + base + '--' + state : '');
        if (message) {
            el.textContent = message;
            el.hidden = false;
        } else {
            el.textContent = '';
            el.hidden = true;
        }
    }

    function dmV4ResetVoiceRecorderUi() {
        var $root = $('#divIRFaudioRecording');
        $root.removeClass('is-recording is-uploading');
        $('#dmV4RecorderIdle').prop('hidden', false);
        $('#dmV4RecorderLive').prop('hidden', true);
        $('#dmV4RecorderWaveform').removeClass('is-active');
        $('#dmV4RecorderTimer').text('0:00');
        dmV4SetRecordingStatus('', null);
        var startBtn = document.getElementById('startRecButton');
        var stopBtn = document.getElementById('stopRecButton');
        var cancelBtn = document.getElementById('cancelRecButton');
        if (startBtn) startBtn.disabled = false;
        if (stopBtn) stopBtn.disabled = true;
        if (cancelBtn) cancelBtn.disabled = true;
        if (window.dmV4VoiceRecorderTimerStop) window.dmV4VoiceRecorderTimerStop();
        window.dmV4VoiceRecordingStartedAt = 0;
    }

    function dmV4StopVoiceModalAudio() {
        ['controlAudioId', 'dmV4VoiceAudio'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            try {
                el.pause();
                el.currentTime = 0;
            } catch (e) { }
        });
    }

    function OpenVoiceRecordingModal(irfid) {
        dmV4ResetVoiceRecorderUi();
        $('#divIRFaudioRecording').attr('data-irf-id', irfid);
        var stopBtn = document.getElementById('stopRecButton');
        if (stopBtn) stopBtn.setAttribute('onclick', 'stopIRFRecording(' + irfid + ')');
        dmV4SetVoiceModalSavedLink('');
        $.ajax({
            type: "POST",
            url: "/IRF/FetchIRFAudioLink",
            data: { 'irfid': irfid },
            success: function (data) {
                dmV4SetVoiceModalSavedLink(data || '');
            }
        });
        if (typeof dmV4RefreshVoiceBrief === 'function') {
            dmV4RefreshVoiceBrief(irfid);
        }
        document.getElementById("VoiceRecordingModal").style.display = "block";
        document.body.classList.add('dm-v4-voice-modal-open');
    }

    function closeVoiceRecordingModal(irfid) {
        dmV4StopVoiceModalAudio();
        document.getElementById("VoiceRecordingModal").style.display = "none";
        document.body.classList.remove('dm-v4-voice-modal-open');
        try { cancelRecording(); } catch (e) { }
        dmV4ResetVoiceRecorderUi();
        if (typeof dmV4RefreshVoiceBrief === 'function') {
            dmV4RefreshVoiceBrief(irfid);
        } else {
            location.reload();
        }
    }

    (function () {
        if (window.dmV4VoiceModalDismissHooksInstalled) return;
        window.dmV4VoiceModalDismissHooksInstalled = true;
        $(document).on('keydown.dmV4VoiceModal', function (e) {
            if (e.key === 'Escape' && $('#VoiceRecordingModal').is(':visible')) {
                var irfId = $('#divIRFaudioRecording').data('irf-id') || '@Model.id';
                closeVoiceRecordingModal(irfId);
            }
        });
        $('#VoiceRecordingModal').on('click.dmV4VoiceModal', function (e) {
            if (e.target === this) {
                var irfId = $('#divIRFaudioRecording').data('irf-id') || '@Model.id';
                closeVoiceRecordingModal(irfId);
            }
        });

        if (window.dmV4VoiceRecorderHooksInstalled) return;
        window.dmV4VoiceRecorderHooksInstalled = true;

        var timerId = null;
        var startedAt = 0;

        function formatRecTime(sec) {
            sec = Math.max(0, Math.floor(sec));
            var m = Math.floor(sec / 60);
            var s = sec % 60;
            return m + ':' + (s < 10 ? '0' : '') + s;
        }

        window.dmV4VoiceRecorderTimerStop = function () {
            if (timerId) {
                clearInterval(timerId);
                timerId = null;
            }
        };

        function showLivePanel() {
            $('#dmV4RecorderIdle').prop('hidden', true);
            $('#dmV4RecorderLive').prop('hidden', false);
            $('#divIRFaudioRecording').addClass('is-recording');
            $('#dmV4RecorderWaveform').addClass('is-active');
        }

        function showIdlePanel() {
            $('#dmV4RecorderIdle').prop('hidden', false);
            $('#dmV4RecorderLive').prop('hidden', true);
            $('#divIRFaudioRecording').removeClass('is-recording');
            $('#dmV4RecorderWaveform').removeClass('is-active');
            window.dmV4VoiceRecorderTimerStop();
        }

        function onRecordingPrepare() {
            showLivePanel();
            startedAt = 0;
            $('#dmV4RecorderTimer').text('0:00');
            window.dmV4VoiceRecorderTimerStop();
            dmV4SetRecordingStatus('Connecting microphone…', 'active');
        }

        function onRecordingActualStart() {
            startedAt = Date.now();
            window.dmV4VoiceRecordingStartedAt = startedAt;
            $('#dmV4RecorderTimer').text('0:00');
            window.dmV4VoiceRecorderTimerStop();
            timerId = setInterval(function () {
                $('#dmV4RecorderTimer').text(formatRecTime((Date.now() - startedAt) / 1000));
            }, 250);
            dmV4SetRecordingStatus('Recording in progress — speak clearly, then tap Stop', 'active');
        }

        function onRecordingEnd() {
            window.dmV4VoiceRecorderTimerStop();
            window.dmV4VoiceRecordingStartedAt = 0;
            $('#divIRFaudioRecording').removeClass('is-recording');
            $('#dmV4RecorderWaveform').removeClass('is-active');
        }

        window.dmV4OnVoiceRecordingStarted = onRecordingActualStart;
        window.dmV4OnVoiceRecordingStartFailed = function () {
            dmV4SetRecordingStatus('Microphone access failed. Check permissions and try again.', null);
            window.setTimeout(dmV4ResetVoiceRecorderUi, 2500);
        };

        var origStart = window.startRecording;
        if (typeof origStart === 'function') {
            window.startRecording = function () {
                origStart.apply(this, arguments);
                onRecordingPrepare();
            };
        }

        var origStop = window.stopIRFRecording;
        if (typeof origStop === 'function') {
            window.stopIRFRecording = function (id) {
                onRecordingEnd();
                $('#divIRFaudioRecording').addClass('is-uploading');
                origStop.apply(this, arguments);
                dmV4SetRecordingStatus('Saving your recording…', 'uploading');
            };
        }

        var origCancel = window.cancelRecording;
        if (typeof origCancel === 'function') {
            window.cancelRecording = function () {
                if (typeof gumStream !== 'undefined' && gumStream) {
                    try { origCancel.apply(this, arguments); } catch (e) { }
                }
                onRecordingEnd();
                dmV4ResetVoiceRecorderUi();
            };
        }

        window.dmV4OnVoiceUploadComplete = function (data) {
            $('#divIRFaudioRecording').removeClass('is-uploading');
            if (data) {
                dmV4SetVoiceModalSavedLink(data);
                if (typeof window.dmV4ApplyVoiceRecordingToHero === 'function') {
                    window.dmV4ApplyVoiceRecordingToHero(data);
                }
            }
            showIdlePanel();
            dmV4SetRecordingStatus('Upload complete — transcribing…', 'uploading');
            $('#playUploadedAudioTwo').addClass('dm-v4-voice-modal__saved--flash');
            $('#dmV4ModalTranscriptSection').show();
            window.setTimeout(function () {
                $('#playUploadedAudioTwo').removeClass('dm-v4-voice-modal__saved--flash');
            }, 1200);
            var irfId = $('#divIRFaudioRecording').data('irf-id') || $('#divIRFaudioRecording').attr('data-irf-id');
            if (irfId && typeof dmV4TranscribeVoiceInstruction === 'function') {
                dmV4TranscribeVoiceInstruction(parseInt(irfId, 10));
            }
        };

        var origCreate = window.createIRFDownloadLink;
        if (typeof origCreate === 'function') {
            window.createIRFDownloadLink = function (blob) {
                origCreate.apply(this, arguments);
            };
        }
    })();
</script>
