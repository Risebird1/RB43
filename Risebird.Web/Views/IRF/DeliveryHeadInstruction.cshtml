                    }
                }
            });
        });
        function GetquestionList() {
            $.ajax({
                type: "POST",
                url: "/IRF/GetSkillChannelSampleQuestions",
                data: { irfid: $("#id").val() },
                success: function (data) {
                    bindquestionsData(data);
                }
            });
        }
        function bindquestionsData(data) {
            var html = '';
            html += ' <div class="table-responsive scrollbar style-2" style="overflow-x:scroll"><table class="table table-bordered mbn" id="SkillQuestionTable" cellpadding="0" cellspacing="0">';
            html += '  <thead>';
            html += '  <tr>';
            html += '  <th width="20%" class="table_heading">Skill<span class="red">*</span></th>';
            html += '  <th width="70%" class="table_heading">Question<span class="red">*</span></th>';
            html += '  <th width="10%" class="table_heading">Action <span class="red">*</span></th>';
            html += '  </tr>';
            html += '  </thead>';
            html += '  <tbody>';
            for (i = 0; i < data.length; i++) {
                html += '   <tr>';
                html += '  <td>' + data[i].skillName;
                if (data[i].isAIGenerated) {
                    html += ' <span class="dm-v4-badge dm-v4-badge--ai">AI</span>';
                }
                html += '</td>';

                html += '<td>';
                html += ' <div>';
                if (data[i].comment != null && data[i].comment != "") {
                    if (data[i].comment.length > 100) {
                        html += '<div class="article">';
                        html += '<p style="margin-bottom:0px;">' + data[i].comment.substring(0, 100) + '</p>';
                        html += '<p class="moretext_' + data[i].id + ' moretext">' + data[i].comment.substring(100, data[i].comment.length) + '</p>';
                        html += '</div>';
                    }
                    else {
                        html += '<div class="article" style="white-space:break-spaces;"><p>' + data[i].comment.substring(0, data[i].comment.length) + '</p></div>';
                    }
                }
                else {
                    html += '<div></div>';
                }
                html += ' <a onclick="moreless(' + data[i].id + ')" class="moreless-button" value="Readmore" id="read_' + data[i].id + '" href="#">Read more</a>';
                if (data[i].idealAnswer) {
                    html += '<details class="dm-v4-ideal-answer"><summary>Ideal Answer (AI)</summary><div class="dm-v4-ideal-answer__body">' + $('<div/>').text(data[i].idealAnswer).html() + '</div></details>';
                }
                html += '</div>';
                html += ' </td>';
                html += '  <td style="text-align:center"><div><span  onclick="DeleteSampleQuestion(' + data[i].id + ')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span></div></td>';
                html += '  </tr>';
            }
            html += '</tbody>';
            html += ' </table></div>';
            $("#divquestionslist").empty().html(html);
        }
        function DeleteSampleQuestion(questionid) {
            swal.fire({
                title: 'Are you sure?',
                text: 'Want to remove question from the Skill channel',
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Remove it!',
                preConfirm: function () {
                    return new Promise(function (resolve, reject) {
                        $.ajax({
                            type: "POST",
                            url: "/IRF/DeleteSkillChannelSampleQuestions",
                            data: { questionid: questionid },
                            success: function (result) {
                                resolve(result);
                            }
                        })
                    })
                },
                allowOutsideClick: false
            }).then(function (result) {
                if (result.dismiss !== 'cancel') {
                    // A question dealt into a question set an interview is locked to cannot be
                    // removed, so the server's answer decides what is reported here.
                    var res = result.value || {};
                    var removed = res.success !== false;
                    swal.fire({
                        title: removed ? 'Removed!' : 'Not removed',
                        type: removed ? 'success' : 'error',
                        html: '<p>' + (res.message || 'Question has been removed.') + '</p>',
                        showCancelButton: false,
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'Close!',
                        allowOutsideClick: false
                    }).then(function () {
                        location.reload(true);
                    })
                }
                else if (result.dismiss === 'cancel') {
                    swal.fire(
                        'Cancelled',
                        'remove cancelled! :)',
                        'error'
                    )
                }
            })
        }
    </script>
