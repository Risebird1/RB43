                    resultString += "," + $(this).val();
                }
            });
        }
        $.ajax({
            type: "POST",
            url: "/IRF/UpdateFormat",
            data: { 'irfid': irfid, format: resultString },
            success: function (data) {
            }
        });
    }
</script>
<script>

    function replaceButtonWithResumeLink(buttonElementId, redactedResumeLink) {
        // Create a new anchor element
        var anchor = document.createElement('a');

        // Get the button element
        var button = document.getElementById(buttonElementId);

        // Copy attributes from the button to the anchor
        anchor.href = redactedResumeLink; // Set the desired href attribute for the anchor
        anchor.innerHTML = 'Resume Link'; // Copy the button content to the anchor
        anchor.id = buttonElementId;
        anchor.target = '_blank';
        // Replace the button with the anchor
        button.parentNode.replaceChild(anchor, button);
    }
    function UploadOrConvertIntoCodedInterviewerResume(elementId, userid, irfid, interviewer, resumeLink = null) {

        document.getElementById(elementId).innerHTML = 'Redacting...';

        $.ajax({
            url: '/Interviewer/InterviewerResumeupdate',
            data: { userid: userid, irfid: irfid, resumeLink: resumeLink },
            async: true,
            success: function (data) {
                if (resumeLink != null) {
                    if (data != null && data != '' && data != 'failed') {
                        swal.fire({
                            title: 'Redacted!',
                            type: 'success',
                            html: '<p>The Resume for ' + interviewer + ' has been redacted.</p>',
                            showCancelButton: false,
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'Close!',
                            allowOutsideClick: false
                        }).then(function () {

                            replaceButtonWithResumeLink(elementId, data);
                        })

                    }
                    else {
                        swal.fire({
                            title: 'Failed!',
                            type: 'error',
                            html: '<p>The Resume for ' + interviewer + ' could not be redacted.</p>',
                            showCancelButton: false,
                            confirmButtonColor: '#3085d6',
                            confirmButtonText: 'Close!',
                            allowOutsideClick: false
                        }).then(function () {
                            document.getElementById(elementId).innerHTML = 'Redaction Failed!';
                        })
                    }
                }
                else {
                    var modal = document.getElementById("Resumepopup");
                    modal.style.display = "block";
                    $('#divresumepopup').html('');
                    $('#divresumepopup').html(data);
                    $('#txtheaderinterviewer').text(interviewer);
                }

            }
        });
    }
</script>
