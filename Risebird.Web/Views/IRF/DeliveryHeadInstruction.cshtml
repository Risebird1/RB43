<script>
    function RemoveInterviewerFromSkillChannel(interviewerEmail, irfid) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Want to remove interviewer from the Skill channel interviews',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Remove it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        type: "POST",
                        url: "/Interview/RemoveInterviewerFromIRF",
                        data: { interviewerEmail: interviewerEmail, irfid: irfid },
                        success: function (result) {
                            resolve(result);
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Removed!',
                    type: 'success',
                    html: '<p>The Interviewer has been removed.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'remove cancelled! :)',
                    'error'
                )
            }
        })
    }
    function UploadInterviewerResume(userid, irfid, interviewer) {
        $.ajax({
            url: '/Interviewer/InterviewerResumeupdate',
            data: { userid: userid, irfid: irfid },
            success: function (data) {
                var modal = document.getElementById("Resumepopup");
                modal.style.display = "block";
                $('#divresumepopup').html('');
                $('#divresumepopup').html(data);
                $('#txtheaderinterviewer').text(interviewer);
            }
        });
    }
</script>