                                    @* 5 · Sample questions (collapsed by default) — V4 wireframe *@
                                    <div class="col-md-12 pull-left pad10 dm-v4-block dm-v4-block--order-questions" style="padding-bottom:0px;padding-left:0;padding-right:0;">
                                        @{
                                            var sampleQsList = Model.DeliveryHeadSampleQuestions?.ToList() ?? new List<SkillComment>();
                                            var rubricSkillNames = Model.SkillCollection?.Where(s => !string.IsNullOrWhiteSpace(s.SkillName)).Select(s => s.SkillName).Distinct(StringComparer.OrdinalIgnoreCase).ToList() ?? new List<string>();
                                            int totalRubricSkills = rubricSkillNames.Count > 0 ? rubricSkillNames.Count : Math.Max(1, sampleQsList.Select(q => q.SkillName).Distinct(StringComparer.OrdinalIgnoreCase).Count());
                                            int skillsWithQuestions = rubricSkillNames.Count(sn => sampleQsList.Any(q => string.Equals(q.SkillName, sn, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(q.Comment)));
                                            var qsBySkill = sampleQsList.Where(q => !string.IsNullOrWhiteSpace(q.SkillName)).GroupBy(q => q.SkillName, StringComparer.OrdinalIgnoreCase).ToList();
                                            int qsGlobalIndex = 0;
                                            var aiQGenEnabled = Configuration.GetValue<bool>("FeatureFlags:EnableAIQuestionGeneration");
                                        }
