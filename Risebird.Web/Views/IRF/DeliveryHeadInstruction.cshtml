<div id="VoiceRecordingModal" class="modal modal-bg dm-v4-voice-modal" role="dialog" aria-labelledby="dmV4VoiceModalTitle" aria-modal="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content dm-v4-voice-modal__content">
            <div class="dm-v4-voice-modal__blob" aria-hidden="true"></div>
            <div class="dm-v4-voice-modal__head">
                <div class="dm-v4-voice-modal__head-main">
                    <div class="dm-v4-voice-modal__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                            <rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor" />
                            <path d="M5 11a7 7 0 0014 0M12 18v3M9 21h6" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="dm-v4-voice-modal__head-text">
                        <div class="dm-v4-voice-modal__eyebrow">Voice instructions</div>
                        <h5 class="dm-v4-voice-modal__title" id="dmV4VoiceModalTitle">Record audio brief</h5>
                    </div>
                </div>
                <button type="button" class="dm-v4-voice-modal__close" aria-label="Close" onclick="closeVoiceRecordingModal(@Model.id)">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke-linecap="round" /></svg>
                </button>
            </div>
            <div class="modal-body dm-v4-voice-modal__body">
                <ul class="dm-v4-voice-modal__steps" aria-label="Recording steps">
                    <li><span class="dm-v4-voice-modal__step-num">1</span> Allow microphone access</li>
                    <li><span class="dm-v4-voice-modal__step-num">2</span> Record your brief</li>
                    <li><span class="dm-v4-voice-modal__step-num">3</span> Stop to upload automatically</li>
                </ul>
                <div class="dm-v4-voice-modal__studio">
                    <div id="divIRFaudioRecording" class="dm-v4-voice-recorder" data-irf-id="@Model.id">
                        <div class="dm-v4-voice-recorder__idle" id="dmV4RecorderIdle">
                            <div class="dm-v4-voice-recorder__start-zone">
                                <div class="dm-v4-voice-recorder__mic-wrap">
                                    <span class="dm-v4-voice-recorder__pulse" aria-hidden="true"></span>
                                    <button type="button" class="dm-v4-voice-record-btn dm-v4-voice-record-btn--modal" id="startRecButton" onclick="startRecording()" title="Start recording" aria-label="Start recording">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="28" height="28" aria-hidden="true">
                                            <rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor" />
                                            <path d="M5 11a7 7 0 0014 0M12 18v3M9 21h6" stroke-linecap="round" />
                                        </svg>
                                    </button>
                                </div>
                                <span class="dm-v4-voice-recorder__start-label">Record</span>
                            </div>
                            <p class="dm-v4-voice-recorder__hint">Tap Record to capture your voice brief</p>
                            <p class="dm-v4-voice-recorder__subhint">Plays for interviewers before each session on this skill channel.</p>
                        </div>
                        <div class="dm-v4-voice-preview-card dm-v4-voice-recorder__live" id="dmV4RecorderLive" hidden>
                            <div class="dm-v4-voice-recorder__transport">
                                <div class="dm-v4-voice-recorder__toolbar">
                                    <div class="dm-v4-voice-recorder__toolbar-meta">
                                        <span class="dm-v4-voice-recorder__rec-pill"><span class="dm-v4-voice-recorder__rec-dot" aria-hidden="true"></span> Recording</span>
                                        <span class="dm-v4-voice-recorder__timer" id="dmV4RecorderTimer" aria-label="Elapsed time">0:00</span>
                                    </div>
                                    <button type="button" class="dm-v4-voice-stop-btn dm-v4-voice-stop-btn--toolbar" id="stopRecButton" onclick="stopIRFRecording(@Model.id)" title="Stop and save" disabled aria-label="Stop recording">
                                        <span class="dm-v4-voice-stop-btn__sq" aria-hidden="true"></span>
                                        <span class="dm-v4-voice-stop-btn__label">Stop</span>
                                    </button>
                                </div>
                                <div class="dm-v4-voice-recorder__wave-track" aria-hidden="true">
                                    <div class="dm-v4-voice-waveform dm-v4-voice-waveform--live" id="dmV4RecorderWaveform">
                                        @for (var dmV4RecBar = 0; dmV4RecBar < 48; dmV4RecBar++)
                                        {
                                            var dmV4RecH = 6 + (int)(Math.Abs(Math.Sin(dmV4RecBar * 0.55) * Math.Sin(dmV4RecBar * 0.2)) * 24) + (dmV4RecBar % 4 == 0 ? 3 : 0);
                                            <span class="dm-v4-voice-waveform__bar" style="height:@(dmV4RecH)px" data-i="@dmV4RecBar"></span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="dm-v4-voice-recorder__live-actions">
                                <button type="button" class="dm-v4-btn dm-v4-btn--ghost dm-v4-btn--sm" id="cancelRecButton" onclick="cancelRecording()" title="Cancel recording" disabled>Discard take</button>
                            </div>
                        </div>
                        <p class="dm-v4-voice-recorder__status" id="recordingStatus" role="status" aria-live="polite" hidden></p>
                        <div class="row" id="recordingRow" style="display:none">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div id="recordingsList" class="dm-v4-voice-recorder__preview-list"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="playUploadedAudioTwo" class="dm-v4-voice-modal__saved dm-v4-voice-modal__saved--empty">
                    <div class="dm-v4-voice-preview-card dm-v4-voice-modal__saved-card">
                        <div class="dm-v4-voice-preview-card__head">
                            <span class="dm-v4-voice-preview-card__label">Current upload</span>
                            <span class="dm-v4-badge dm-v4-badge--green">ON FILE</span>
                        </div>
                        <div class="dm-v4-voice-modal__saved-player">
                            <audio id="controlAudioId" class="dm-v4-voice-modal__saved-audio" asp-append-version="true" controls preload="metadata"></audio>
                        </div>
                        <a id="anchorAudioId" class="dm-v4-voice-modal__file-link" asp-append-version="true" download>
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12" aria-hidden="true"><path d="M8 2v8M5 8l3 3 3-3M3 13h10" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            <span class="dm-v4-voice-modal__file-name"></span>
                        </a>
                    </div>
                    <p class="dm-v4-voice-modal__saved-empty-msg">No file uploaded yet. Record above to replace any previous brief.</p>
                </div>
                <div class="dm-v4-voice-modal__transcript" id="dmV4ModalTranscriptSection" style="display:none;">
                    <div class="dm-v4-voice-preview-card dm-v4-voice-preview-card--transcript">
                        <div class="dm-v4-voice-preview-card__head">
                            <span class="dm-v4-voice-preview-card__label">Transcript</span>
                            <span class="dm-v4-badge dm-v4-badge--indigo">EDIT &amp; SAVE</span>
                        </div>
                        <textarea class="dm-v4-voice-transcript__input" id="dmV4ModalTranscriptInput" rows="6" placeholder="Transcription will appear here after you stop recording…"></textarea>
                        <div class="dm-v4-voice-transcript__actions">
                            <button type="button" class="dm-v4-btn dm-v4-btn--primary dm-v4-btn--sm" id="dmV4ModalSaveTranscriptBtn">Save transcript</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="dm-v4-voice-modal__foot">
                <p class="dm-v4-voice-modal__foot-hint">Recording and transcript update on the page as soon as upload finishes.</p>
                <button type="button" class="dm-v4-btn dm-v4-btn--primary dm-v4-btn--sm" onclick="closeVoiceRecordingModal(@Model.id)">Done</button>
            </div>
        </div>
    </div>
</div>
