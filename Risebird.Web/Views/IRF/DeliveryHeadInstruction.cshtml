                                    @* 5b · AI interview question sets — preset AI interview channels only.
                                       Nothing here renders for a non-preset channel, so those pages are
                                       byte-for-byte what they were before this feature existed. *@
                                    @if (showQuestionSets)
                                    {
                                        <div class="col-md-12 pull-left pad10 dm-v4-block" style="padding-bottom:0px;padding-left:0;padding-right:0;">
                                            <div class="dm-v4-collapse" id="dmV4QuestionSetsCollapse">
