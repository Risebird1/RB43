<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<style>
    #campaignTable th:nth-child(4),
    #campaignTable td:nth-child(4) {
        min-width: 210px;
        max-width: 260px;
        white-space: normal;
        vertical-align: top;
    }

    .camp-created-by {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .camp-created-by__name {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
        word-break: break-word;
    }

    .camp-created-by__at {
        font-size: 10px;
        color: #64748b;
        line-height: 1.35;
    }

    .camp-bc-status {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    .camp-bc-pill {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .02em;
        line-height: 1.2;
        white-space: nowrap;
    }

    .camp-bc-pill--done { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .camp-bc-pill--running { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .camp-bc-pill--stopped { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .camp-bc-pill--scheduled { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .camp-bc-pill--pending { background: #fef9c3; color: #854d0e; border: 1px solid #fde047; }

    .camp-bc-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 4px;
    }

    .camp-bc-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 0;
        padding: 4px 2px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        background: #fff;
    }

    .camp-bc-stat__val {
        font-size: 12px;
        font-weight: 700;
        line-height: 1.1;
    }

    .camp-bc-stat__lbl {
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        margin-top: 2px;
        line-height: 1;
    }

    .camp-bc-stat--ok .camp-bc-stat__val { color: #15803d; }
    .camp-bc-stat--fail .camp-bc-stat__val { color: #b91c1c; }
    .camp-bc-stat--skip .camp-bc-stat__val { color: #a16207; }
    .camp-bc-stat--total .camp-bc-stat__val { color: #1e293b; }

    .camp-bc-progress {
        height: 5px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .camp-bc-progress__bar {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #22c55e 0%, #16a34a 100%);
        min-width: 0;
        max-width: 100%;
    }

    .camp-bc-meta {
        font-size: 10px;
        color: #64748b;
        line-height: 1.35;
        word-break: break-word;
    }

    .camp-bc-note {
        font-size: 10px;
        color: #64748b;
        line-height: 1.35;
    }
</style>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    
    <!-- End Navbar -->
    <div class="mobile-view">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px 0px 10px 0px;padding:0px;">
            <div class="card-header bg-w clearfix" style="padding:10px;">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                     <h4 class="card-title"> Campaigns</h4>
                </div>

               
            </div>
        </div>
    </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div>

                                    <div id="tableID" class="second">
                                        <table id="campaignTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Primary Assessment Group</th>
                                                    <th>Created By</th>
                                                    <th>Batch Call Status</th>
                                                    <th>Actions</th>
                                                    

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Primary Assessment Group</th>
                                                    <th>Created By</th>
                                                    <th>Batch Call Status</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                    <tr>
                                                        <td> @item.CampaignName </td>
                                                        <td> @item.AssessmentGroupName </td>
                                                        <td>
                                                            <div class="camp-created-by">
                                                                <span class="camp-created-by__name">@(string.IsNullOrWhiteSpace(item.CreatedBy) ? "\u2014" : item.CreatedBy)</span>
                                                                @if (item.CreatedAt.HasValue)
                                                                {
                                                                    <span class="camp-created-by__at">at @item.CreatedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td>
                                                            @if (item.BatchCallLogId.HasValue)
                                                            {
                                                                int attempted = item.BatchCallAttempted ?? 0;
                                                                int succeeded = item.BatchCallSucceeded ?? 0;
                                                                int failed = item.BatchCallFailed ?? 0;
                                                                int skipped = item.BatchCallSkipped ?? 0;
                                                                int successPct = attempted > 0 ? (int)Math.Round(succeeded * 100.0 / attempted) : 0;

                                                                <div class="camp-bc-status">
                                                                    <span class="camp-bc-pill @CampBcPillClass(item.BatchCallStatus)">@CampBcStatusLabel(item.BatchCallStatus)</span>
                                                                    <div class="camp-bc-stats">
                                                                        <div class="camp-bc-stat camp-bc-stat--ok" title="Succeeded">
                                                                            <span class="camp-bc-stat__val">@succeeded</span>
                                                                            <span class="camp-bc-stat__lbl">OK</span>
                                                                        </div>
                                                                        <div class="camp-bc-stat camp-bc-stat--fail" title="Failed">
                                                                            <span class="camp-bc-stat__val">@failed</span>
                                                                            <span class="camp-bc-stat__lbl">Fail</span>
                                                                        </div>
                                                                        <div class="camp-bc-stat camp-bc-stat--skip" title="Skipped">
                                                                            <span class="camp-bc-stat__val">@skipped</span>
                                                                            <span class="camp-bc-stat__lbl">Skip</span>
                                                                        </div>
                                                                        <div class="camp-bc-stat camp-bc-stat--total" title="Total attempted">
                                                                            <span class="camp-bc-stat__val">@attempted</span>
                                                                            <span class="camp-bc-stat__lbl">Total</span>
                                                                        </div>
                                                                    </div>
                                                                    @if (attempted > 0)
                                                                    {
                                                                        <div class="camp-bc-progress" title="@successPct% succeeded">
                                                                            <div class="camp-bc-progress__bar" style="width:@successPct%;"></div>
                                                                        </div>
                                                                    }
                                                                    <div class="camp-bc-meta">
                                                                        @if (item.BatchCallCompletedAt.HasValue)
                                                                        {
                                                                            <span>Completed @item.BatchCallCompletedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
                                                                        }
                                                                        else if (item.BatchCallInitiatedAt.HasValue)
                                                                        {
                                                                            <span>Started @item.BatchCallInitiatedAt.Value.ToString("dd MMM yyyy, HH:mm")</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                            else if (item.BatchCallTriggeredAt.HasValue)
                                                            {
                                                                <div class="camp-bc-status">
                                                                    <span class="camp-bc-pill camp-bc-pill--running">In Progress</span>
                                                                    <span class="camp-bc-note">Placing availability calls to unresponded interviewers.</span>
                                                                    <div class="camp-bc-meta">Triggered @item.BatchCallTriggeredAt.Value.ToString("dd MMM yyyy, HH:mm")</div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="camp-bc-status">
                                                                    <span class="camp-bc-pill camp-bc-pill--scheduled">Scheduled</span>
                                                                    <span class="camp-bc-note">Auto batch call runs 1 hour after campaign creation.</span>
                                                                    @if (item.CreatedAt.HasValue)
                                                                    {
                                                                        var eligibleAt = item.CreatedAt.Value.AddHours(1);
                                                                        if (DateTime.Now < eligibleAt)
                                                                        {
                                                                            <div class="camp-bc-meta">Eligible at @eligibleAt.ToString("dd MMM yyyy, HH:mm")</div>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </td>
                                                        <td>
                                                            <a style="text-decoration:none;" target="_blank" href="@Url.Action("CampaignDetails", "IRF" , new { campaignId = item.id})" title="Campaign Details">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Campaign Details" style="position:relative;top:3px;">
                                                                    <span title="Campaign Details" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px;" class='fa fa-eye' style='color: white'></i>
                                                                    </span>
                                                                </button>
                                                            </a>
                                                            <a style="text-decoration:none;" target="_blank" href="@Url.Action("GetOpenClickCampaignMailDetails", "Dashboard" , new {campaignId = item.id})" title="Campaign Mail Activity">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Campaign Mail Activity" style="position:relative;top:3px;">
                                                                    <span title="Campaign Mail Activity" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px;" class='fa fa-envelope' style='color: white'></i>
                                                                    </span>
                                                                </button>
                                                            </a>
                                                            @{
                                                                bool alreadyTriggered = item.BatchCallTriggeredAt.HasValue;
                                                                bool hourElapsed = item.CreatedAt.HasValue && DateTime.Now.Subtract(item.CreatedAt.Value).TotalHours >= 1;
                                                                // A manual trigger is an explicit operator override, so it is allowed any time the batch
                                                                // call has not already run — the 1-hour delay only governs the automated timer job.
                                                                bool canTrigger = !alreadyTriggered;
                                                                string btnTitle = alreadyTriggered ? "Batch call already triggered"
                                                                    : !hourElapsed ? "Call unresponded interviewers now (overrides the 1-hour auto-call delay)"
                                                                    : "Call unresponded interviewers for availability";
                                                            }
                                                            <button class="mdc-fab app-fab--absolute btn-trigger-batch-call"
                                                                    aria-label="Trigger Availability Calls"
                                                                    style="position:relative;top:3px;@(canTrigger ? "background:#17a2b8 !important;border-color:#17a2b8 !important;" : "opacity:0.45;cursor:not-allowed;")"
                                                                    title="@btnTitle"
                                                                    data-campaign-id="@item.id"
                                                                    data-campaign-name="@item.CampaignName"
                                                                    @(canTrigger ? "" : "disabled")>
                                                                <span class="mdc-fab__icon material-icons">
                                                                    <i style="font-size:14px;" class="fa fa-phone"></i>
                                                                </span>
                                                            </button>
                                                        </td>

                                                    </tr>


                                                }
                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>

<script>
    function RefreshSearch() {
        $('#campaignTable').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#campaignTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top:8px;right: 15px;' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

</script>

