<script>
    $(document).on('click', '.btn-trigger-batch-call:not([disabled])', function () {
        var btn = $(this);
        var campaignId = btn.data('campaign-id');
        var campaignName = btn.data('campaign-name');

        Swal.fire({
            title: 'Trigger Availability Calls?',
            html: 'This starts a new batch-call attempt that places Plivo calls to all unresponded interviewers in campaign <strong>' + campaignName + '</strong>.<br><br>'
                + 'The calls are handled by a background service, so this returns immediately.<br><br>Do you want to proceed?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#17a2b8',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, call them',
            cancelButtonText: 'Cancel'
        }).then(function (result) {
            if (!result.value) return;

            btn.prop('disabled', true).css('opacity', '0.45');
            btn.find('i').removeClass('fa-phone').addClass('fa-spinner fa-spin');

            // The portal only opens the attempt and hands the calling off to the CampaignBatchCall
            // Azure Function (fire-and-forget), so this request returns in a moment.
            Swal.fire({
                title: 'Starting batch call…',
                html: 'Handing the calls for <strong>' + campaignName + '</strong> off to the background calling service.',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                onOpen: function () { Swal.showLoading(); }
            });

            var token = $('input[name="__RequestVerificationToken"]').val();
            if (!token) {
                token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            }

            $.ajax({
                url: '@Url.Action("TriggerCampaignBatchCall", "IRF")',
                type: 'POST',
                data: { __RequestVerificationToken: token, campaignId: campaignId },
                timeout: 600000,
                success: function (res) {
                    btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-phone');
                    if (res.success) {
                        if (res.started === false) {
                            // Nothing to do (e.g. no unresponded interviewers).
                            Swal.fire({
                                title: 'Nothing to call',
                                html: res.message || 'No unresponded interviewers to call.',
                                type: 'info',
                                confirmButtonColor: '#17a2b8'
                            }).then(function () { location.reload(); });
                        } else {
                            // Calls are placed in the background; the request returns immediately.
                            Swal.fire({
                                title: 'Batch Call Started',
                                html: res.message || 'Availability calls are being placed in the background. Refresh in a few minutes to see the final status.',
                                type: 'success',
                                allowOutsideClick: false,
                                confirmButtonColor: '#17a2b8'
                            }).then(function () { location.reload(); });
                        }
                    } else {
                        btn.prop('disabled', false).css('opacity', '1');
                        Swal.fire('Error', res.error || 'Failed to trigger batch calls.', 'error');
                    }
                },
                error: function (xhr, textStatus) {
                    btn.find('i').removeClass('fa-spinner fa-spin').addClass('fa-phone');
                    btn.prop('disabled', false).css('opacity', '1');
                    if (textStatus === 'timeout') {
                        // The server keeps placing the calls even though the browser stopped waiting.
                        Swal.fire({
                            title: 'Still in progress',
                            html: 'The calls are taking longer than expected and are still being placed in the background.<br>Refresh this page in a few minutes to see the final batch-call status.',
                            type: 'info',
                            confirmButtonColor: '#17a2b8'
                        }).then(function () { location.reload(); });
                    } else {
                        Swal.fire('Error', 'Request failed. Please try again.', 'error');
                    }
                }
            });
        });
    });

    function camp_bc_escapeHtml(s) {
        if (s === null || s === undefined) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function camp_bc_outcomeBadge(outcome) {
        var o = (outcome || '').toLowerCase();
        var color = o === 'succeeded' ? '#166534' : (o === 'failed' ? '#991b1b' : '#92400e');
        var bg = o === 'succeeded' ? '#dcfce7' : (o === 'failed' ? '#fee2e2' : '#fef3c7');
        return '<span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:700;color:' + color + ';background:' + bg + ';">' + camp_bc_escapeHtml(outcome || '-') + '</span>';
    }

    var _campBcCurrentCampaignId = 0;
    var _campBcCurrentCampaignName = '';

    // Shows all batch-call attempts for a campaign. Each attempt can be expanded to per-call details.
    function viewCampaignAttempts(campaignId, campaignName) {
        _campBcCurrentCampaignId = campaignId;
        _campBcCurrentCampaignName = campaignName;
        Swal.fire({
            title: 'Batch call attempts',
            html: 'Loading…',
            width: 820,
            onOpen: function () { Swal.showLoading(); }
        });

        $.ajax({
            url: '@Url.Action("GetCampaignBatchCallAttempts", "IRF")',
            type: 'GET',
            data: { campaignId: campaignId },
            success: function (res) {
                if (!res || !res.success) {
                    Swal.fire('Error', (res && res.error) || 'Failed to load attempts.', 'error');
                    return;
                }
                var attempts = res.attempts || [];
                var html = '<div style="text-align:left;">'
                    + '<div style="font-size:12px;color:#64748b;margin-bottom:10px;">Campaign: <strong>' + camp_bc_escapeHtml(campaignName) + '</strong> &middot; ' + attempts.length + ' attempt(s)</div>';
                if (attempts.length === 0) {
                    html += '<div style="padding:14px;color:#64748b;">No batch-call attempts yet.</div>';
                } else {
                    html += '<table style="width:100%;border-collapse:collapse;font-size:12px;">'
                        + '<thead><tr style="background:#f1f5f9;color:#334155;">'
                        + '<th style="padding:6px;text-align:left;">Attempt</th>'
                        + '<th style="padding:6px;">Status</th>'
                        + '<th style="padding:6px;">OK</th>'
                        + '<th style="padding:6px;">Fail</th>'
                        + '<th style="padding:6px;">Skip</th>'
                        + '<th style="padding:6px;">Total</th>'
                        + '<th style="padding:6px;"></th>'
                        + '</tr></thead><tbody>';
                    attempts.forEach(function (a) {
                        html += '<tr style="border-bottom:1px solid #e2e8f0;">'
                            + '<td style="padding:6px;text-align:left;">'
                                + '<div style="font-weight:600;color:#1e293b;">#' + (a.attemptNumber || '-') + '</div>'
                                + '<div style="font-size:10px;color:#64748b;word-break:break-all;">' + camp_bc_escapeHtml(a.attemptName) + '</div>'
                                + '<div style="font-size:10px;color:#94a3b8;">by ' + camp_bc_escapeHtml(a.initiatedBy) + ' &middot; ' + camp_bc_escapeHtml(a.initiatedAt) + '</div>'
                            + '</td>'
                            + '<td style="padding:6px;text-align:center;">' + camp_bc_escapeHtml(a.status) + '</td>'
                            + '<td style="padding:6px;text-align:center;color:#166534;font-weight:600;">' + a.succeeded + '</td>'
                            + '<td style="padding:6px;text-align:center;color:#991b1b;font-weight:600;">' + a.failed + '</td>'
                            + '<td style="padding:6px;text-align:center;color:#92400e;font-weight:600;">' + a.skipped + '</td>'
                            + '<td style="padding:6px;text-align:center;">' + a.attempted + '</td>'
                            + '<td style="padding:6px;text-align:center;"><a href="javascript:void(0)" style="color:#17a2b8;" onclick="viewAttemptDetails(' + a.id + ')">details</a></td>'
                            + '</tr>';
                    });
                    html += '</tbody></table>';
                }
                html += '</div>';
                Swal.fire({ title: 'Batch call attempts', html: html, width: 820, confirmButtonColor: '#17a2b8' });
            },
            error: function () {
                Swal.fire('Error', 'Failed to load attempts.', 'error');
            }
        });
    }

    // Per-call detail for a single attempt.
    function viewAttemptDetails(batchCallLogId) {
        Swal.fire({ title: 'Call details', html: 'Loading…', width: 820, onOpen: function () { Swal.showLoading(); } });
        $.ajax({
            url: '@Url.Action("GetCampaignBatchCallAttemptDetails", "IRF")',
            type: 'GET',
            data: { batchCallLogId: batchCallLogId },
            success: function (res) {
                if (!res || !res.success) {
                    Swal.fire('Error', (res && res.error) || 'Failed to load call details.', 'error');
                    return;
                }
                var details = res.details || [];
                var html = '<div style="text-align:left;">';
                if (details.length === 0) {
                    html += '<div style="padding:14px;color:#64748b;">No call details recorded for this attempt.</div>';
                } else {
                    html += '<table style="width:100%;border-collapse:collapse;font-size:12px;">'
                        + '<thead><tr style="background:#f1f5f9;color:#334155;">'
                        + '<th style="padding:6px;text-align:left;">Interviewer</th>'
                        + '<th style="padding:6px;text-align:left;">Phone</th>'
                        + '<th style="padding:6px;">Outcome</th>'
                        + '<th style="padding:6px;text-align:left;">When</th>'
                        + '</tr></thead><tbody>';
                    details.forEach(function (d) {
                        html += '<tr style="border-bottom:1px solid #e2e8f0;">'
                            + '<td style="padding:6px;text-align:left;">'
                                + '<div style="font-weight:600;color:#1e293b;">' + camp_bc_escapeHtml(d.name || '-') + '</div>'
                                + '<div style="font-size:10px;color:#64748b;">' + camp_bc_escapeHtml(d.email || '') + '</div>'
                                + (d.error ? '<div style="font-size:10px;color:#991b1b;">' + camp_bc_escapeHtml(d.error) + '</div>' : '')
                            + '</td>'
                            + '<td style="padding:6px;text-align:left;">' + camp_bc_escapeHtml(d.phone || '-') + '</td>'
                            + '<td style="padding:6px;text-align:center;">' + camp_bc_outcomeBadge(d.outcome) + '</td>'
                            + '<td style="padding:6px;text-align:left;">' + camp_bc_escapeHtml(d.calledAt) + '</td>'
                            + '</tr>';
                    });
                    html += '</tbody></table>';
                }
                html += '</div>';
                Swal.fire({
                    title: 'Call details',
                    html: html,
                    width: 820,
                    showCancelButton: true,
                    confirmButtonText: 'Back to attempts',
                    confirmButtonColor: '#17a2b8',
                    cancelButtonText: 'Close'
                }).then(function (r) {
                    if (r.value) { viewCampaignAttempts(_campBcCurrentCampaignId, _campBcCurrentCampaignName); }
                });
            },
            error: function () {
                Swal.fire('Error', 'Failed to load call details.', 'error');
            }
        });
    }
</script>
@Html.AntiForgeryToken()
