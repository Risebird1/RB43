<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    
    <!-- End Navbar -->
    <div class="mobile-view">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px 0px 10px 0px;padding:0px;">
            <div class="card-header bg-w clearfix" style="padding:10px;">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                     <h4 class="card-title"> Campaigns</h4>
                </div>

               
            </div>
        </div>
    </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div>

                                    <div id="tableID" class="second">
                                        <table id="campaignTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Primary Assessment Group</th>
                                                    <th>Created By</th>
                                                    <th>Created At</th>
                                                    <th>Batch Call Status</th>
                                                    <th>Actions</th>
                                                    

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Primary Assessment Group</th>
                                                    <th>Created By</th>
                                                    <th>Created At</th>
                                                    <th>Batch Call Status</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                    <tr>
                                                        <td> @item.CampaignName </td>
                                                        <td> @item.AssessmentGroupName </td>
                                                        <td> @item.CreatedBy </td>
                                                        <td> @item.CreatedAt </td>
                                                        <td>
                                                            @if (item.BatchCallLogId.HasValue)
                                                            {
                                                                <span class="badge" style="background-color: @(item.BatchCallStatus == "Completed" ? "#28a745" : "#ffc107"); color: @(item.BatchCallStatus == "Completed" ? "#fff" : "#333"); padding: 4px 8px; border-radius: 4px; font-size: 12px;">
                                                                    @item.BatchCallStatus
                                                                </span>
                                                                <br />
                                                                <small style="color: #666;">
                                                                    <i class="fa fa-check-circle" style="color:#28a745;"></i> @item.BatchCallSucceeded
                                                                    &nbsp;
                                                                    <i class="fa fa-times-circle" style="color:#dc3545;"></i> @item.BatchCallFailed
                                                                    &nbsp;
                                                                    <i class="fa fa-minus-circle" style="color:#999;"></i> @item.BatchCallSkipped
                                                                    &nbsp; / @item.BatchCallAttempted total
                                                                </small>
                                                                @if (item.BatchCallCompletedAt.HasValue)
                                                                {
                                                                    <br />
                                                                    <small style="color: #888;">@item.BatchCallCompletedAt.Value.ToString("dd MMM yyyy, HH:mm")</small>
                                                                }
                                                            }
                                                            else if (item.BatchCallTriggeredAt.HasValue)
                                                            {
                                                                <span class="badge" style="background-color: #17a2b8; color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 12px;">
                                                                    In Progress
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <small style="color:#999;">Scheduled (1hr after creation)</small>
                                                            }
                                                        </td>
                                                        <td>
                                                            <a style="text-decoration:none;" target="_blank" href="@Url.Action("CampaignDetails", "IRF" , new { campaignId = item.id})" title="Campaign Details">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Campaign Details" style="position:relative;top:3px;">
                                                                    <span title="Campaign Details" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px;" class='fa fa-eye' style='color: white'></i>
                                                                    </span>
                                                                </button>
                                                            </a>
                                                            <a style="text-decoration:none;" target="_blank" href="@Url.Action("GetOpenClickCampaignMailDetails", "Dashboard" , new {campaignId = item.id})" title="Campaign Mail Activity">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Campaign Mail Activity" style="position:relative;top:3px;">
                                                                    <span title="Campaign Mail Activity" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px;" class='fa fa-envelope' style='color: white'></i>
                                                                    </span>
                                                                </button>
                                                            </a>
                                                            @{
                                                                bool alreadyTriggered = item.BatchCallTriggeredAt.HasValue;
                                                                bool hourElapsed = item.CreatedAt.HasValue && DateTime.Now.Subtract(item.CreatedAt.Value).TotalHours >= 1;
                                                                bool canTrigger = !alreadyTriggered && hourElapsed;
                                                                string btnTitle = alreadyTriggered ? "Batch call already triggered"
                                                                    : !hourElapsed ? "Available 1 hour after campaign creation"
                                                                    : "Call unresponded interviewers for availability";
                                                            }
                                                            <button class="mdc-fab app-fab--absolute btn-trigger-batch-call"
                                                                    aria-label="Trigger Availability Calls"
                                                                    style="position:relative;top:3px;@(canTrigger ? "background:#17a2b8 !important;border-color:#17a2b8 !important;" : "opacity:0.45;cursor:not-allowed;")"
                                                                    title="@btnTitle"
                                                                    data-campaign-id="@item.id"
                                                                    data-campaign-name="@item.CampaignName"
                                                                    @(canTrigger ? "" : "disabled")>
                                                                <span class="mdc-fab__icon material-icons">
                                                                    <i style="font-size:14px;" class="fa fa-phone"></i>
                                                                </span>
                                                            </button>
                                                        </td>

                                                    </tr>


                                                }
                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>

<script>
    function RefreshSearch() {
        $('#campaignTable').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#campaignTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top:8px;right: 15px;' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

</script>

