<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<style>
    #campaignTable th:nth-child(4),
    #campaignTable td:nth-child(4) {
        min-width: 210px;
        max-width: 260px;
        white-space: normal;
        vertical-align: top;
    }

    .camp-created-by {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .camp-created-by__name {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
        word-break: break-word;
    }

    .camp-created-by__at {
        font-size: 10px;
        color: #64748b;
        line-height: 1.35;
    }

    .camp-bc-status {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    .camp-bc-pill {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 5px;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .02em;
        line-height: 1.2;
        white-space: nowrap;
    }

    .camp-bc-pill--done { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .camp-bc-pill--running { background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .camp-bc-pill--stopped { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .camp-bc-pill--scheduled { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .camp-bc-pill--pending { background: #fef9c3; color: #854d0e; border: 1px solid #fde047; }

    .camp-bc-attempts-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        align-self: flex-start;
        margin-top: 4px;
        font-size: 11px;
        font-weight: 600;
        color: #17a2b8;
        cursor: pointer;
        text-decoration: none;
    }

    .camp-bc-attempts-link:hover { text-decoration: underline; }

    .camp-bc-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 4px;
    }

    .camp-bc-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 0;
        padding: 4px 2px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        background: #fff;
    }

    .camp-bc-stat__val {
        font-size: 12px;
        font-weight: 700;
        line-height: 1.1;
    }

    .camp-bc-stat__lbl {
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        margin-top: 2px;
        line-height: 1;
    }

    .camp-bc-stat--ok .camp-bc-stat__val { color: #15803d; }
    .camp-bc-stat--fail .camp-bc-stat__val { color: #b91c1c; }
    .camp-bc-stat--skip .camp-bc-stat__val { color: #a16207; }
    .camp-bc-stat--total .camp-bc-stat__val { color: #1e293b; }

    .camp-bc-progress {
        height: 5px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .camp-bc-progress__bar {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #22c55e 0%, #16a34a 100%);
        min-width: 0;
        max-width: 100%;
    }

    .camp-bc-meta {
        font-size: 10px;
        color: #64748b;
        line-height: 1.35;
        word-break: break-word;
    }

    .camp-bc-note {
        font-size: 10px;
        color: #64748b;
        line-height: 1.35;
    }
</style>

