    ViewData["Title"] = "Campaigns";
    ViewBag.PageHeader = "Campaigns";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // dynamic filter = null;
    // string strtDte = string.Empty;
    // string endDte = string.Empty;
    // string[] activityType = new string[] { };
    // string[] performedBy = new string[] { };

}

@functions {
    string CampBcPillClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "camp-bc-pill--pending";
        switch (status.Trim().ToLowerInvariant())
        {
            case "completed": return "camp-bc-pill--done";
            case "running": return "camp-bc-pill--running";
            case "stopped": return "camp-bc-pill--stopped";
            default: return "camp-bc-pill--pending";
        }
    }

    string CampBcStatusLabel(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Pending";
        return status.Trim();
    }
}

