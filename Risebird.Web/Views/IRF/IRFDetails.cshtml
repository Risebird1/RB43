<!-- Include Partial Views -->
@await Html.PartialAsync("~/Views/Common/_HMInstructionURL.cshtml")

<!-- Include Scripts -->
<script src="~/js/checkintervieweravailabilitybymail.js?v=2024"></script>
<script src="~/js/filtervalidation.js?v=2024"></script>

<script>

    function searchResult() {
        $('#irfDetailsTable').DataTable();
    }
    function RefreshSearch() {
        $('#irfDetailsTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#irfDetailsTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });
    };

    function PlayIRF(id, irfId) {
        swal.fire({
            title: 'Are you sure?',
            text: "Do you want to play this IRF!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, go ahead',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/PlayIRF',
                        data: { 'irfId': id, 'IRFName': irfId },
                        success: function (result) {
                            swal.fire(result);
                        }
                    });
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.value) {
                setTimeout(function () {
                    window.location.reload();
                }, 2000);
            }
        });
    }

    function PauseIRF(id, irfId) {
        swal.fire({
            title: 'Are you sure?',
            text: "Do you want to pause this IRF!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, go ahead',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/PauseIRF',
                        data: { 'irfId': id, 'IRFName': irfId },
                        success: function (result) {
                            swal.fire(result);
                        }
                    });
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.value) {
                setTimeout(function () {
                    window.location.reload();
                }, 2000);
            }
        });
    }

    function openTask(id, irfId) {
        var modal = document.getElementById("myTask");
        modal.style.display = "block";
        $("#hidcollectiveIRFid").val(id);
        $("#hidcollectiveIRFName").val(irfId);
        FetchDataInfo('completion');
    }

    function openHMLink(id) {
        var currentPort = window.location.port;
        var url = window.location.protocol + '//' + window.location.hostname + (currentPort ? ":" + currentPort : "") + "/IRF/DeliveryHeadInstruction?irfid=" + id;
        window.open(url, '_blank');
    }

    function getClientFeedback(id) {
        $.ajax({
            url: '/IRF/GetIRFClientReview',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("clientreviewModal");
                modal.style.display = "block";
                $('#clientreviewTableBody').html('');
                $('#clientreviewTableBody').html(data);
            }
        });
    }

    function Candidates(id, IRFid) {
        var url = '/Candidate/GetCandidates?id=' + id + '&irfName=' + IRFid;
        window.open(url, '_blank');
    }

    function EditIRF(id, templateId) {
        if ('@ViewBag.profile' == 'Client' && templateId != null && templateId > 0) {
            var url = '/IRF/EditIRF?id=' + id + '&templateId=' + templateId;
            window.open(url, '_blank'); 
        }
        else {
            $.ajax({
                url: '/IRF/CheckEditCondition?IRFId=' + id,
                type: 'POST',
                success: function (result) {
                    if (result == "Success") {
                        var url = '/IRF/EditIRF?id=' + id;
                        window.open(url, '_blank'); 
                    }
                    else {
                        swal.fire("You are not authorized to edit this skill channel. Please contact Admin or Channel Owner.");
                    }
                }
            });
        }
    }


    function getIRFMembers(id, Name) {
        $.ajax({
            url: '/IRF/GetIRFInterviewerMembers',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);
            }
        });
    }

    function EditSchedulerEvent(schedulerlink) {
        if (schedulerlink != '') {
            var _uniqueid = schedulerlink.split('?')[schedulerlink.split('?').length - 1].split('=')[1];
            window.location.href = "/InterviewScheduler/IRFSchedulerEventEdit?id=" + _uniqueid;
        }
    }

    function FetchDataInfo(type) {
        var irfid = $("#hidcollectiveIRFid").val();
        $.ajax({
            url: '/Task/SkillChannelCollectiveDetails',
            data: { 'irfId': irfid, 'type': type },
            success: function (data) {
                $('#memberTableBody2').html('');
                $('#memberTableBody2').html(data);
            }
        });
    }

    // Close modal handlers
    var closeTaskModel = document.getElementById("taskModalClose");
    if (closeTaskModel) {
        closeTaskModel.onclick = function () {
            var modal = document.getElementById("myTask");
            modal.style.display = "none";
        }
    }
</script>