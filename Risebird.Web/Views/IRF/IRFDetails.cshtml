@model IEnumerable<Risebird.Entities.ViewModel.IRF>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "IRF Details";
    ViewBag.PageHeader = "IRF Details";
    if (ViewBag.PageStatus == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}

@if (HttpContextAccessor.HttpContext.Session.GetString("IRFDetailsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<SkillChannelDetailsFilter>(HttpContextAccessor.HttpContext.Session.GetString("IRFDetailsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}

<style>
    .DetailLink td {
        color: darkblue;
    }

    .DetailLink:hover {
        text-decoration: underline;
        cursor: pointer;
    }
</style>

<style>
    .modal-dialog {
        height: 900px !important;
    }

    .modal-content {
        /* 80% of window height */
        height: 60%;
    }
</style>

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css" />
<link rel="stylesheet" type="text/css" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script src="https://s3-us-west-2.amazonaws.com/s.cdpn.io/123941/stacktable.js"></script>
<script>
    $('table').stacktable();
</script>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">IRF Details</h4></div>
                </div>
                <div class="pull-right">
                    <div style="float:right">
                        <button type="button" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-toggle="modal" data-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
