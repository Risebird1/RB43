<script>
    function AssessmentGroupCategoryChanged(categoryId) {

        $.ajax({
            type: "GET",
            url: "/IRF/GetAssessmentGroupsByCategory",
            data: { 'categoryId': categoryId },
            success: function (data) {
                var drpdwnId = $("#IRFRecommendations_AssessmentGroupId");
                if (data.length > 0) {
                    $("#IRFRecommendations_AssessmentGroupId option").remove();

                    $(data).each(function () {
                        var option = $("<option />");
                        //Set Text part.
                        option.html(this.text);
                        //Set Value part.
                        option.val(this.value);
                        //Add the Option element to DropDownList.
                        drpdwnId.append(option);
                    });
                }

            }
        });

    }

