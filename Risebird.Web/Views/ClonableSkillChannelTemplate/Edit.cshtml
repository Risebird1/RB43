        isTemplateJoinSelectGenskillsRequired = true;
    }
    $(document).ready(function () {
        RecommendationStatusChanged(recommendationRadioValue);
        $("#btnPrev").click(function () {

            var activeTab = $(".active").text();
            if (activeTab.trim() == "Tech Skill") {
                $(".tab-menu li a").removeClass("active");
                $("#rtab-1").addClass("active");
                document.getElementById("tab-1").style.display = "block";
                document.getElementById("tab-2").style.display = "none";
                document.getElementById("btnPrev").style.display = "none";
            }
            else if (activeTab.trim() == "Interviewer") {
                $(".tab-menu li a").removeClass("active");
                $("#rtab-2").addClass("active");
                document.getElementById("tab-2").style.display = "block";
                document.getElementById("tab-3").style.display = "none";
            }
            else if (activeTab.trim() == "Questions") {
                $(".tab-menu li a").removeClass("active");
                $("#rtab-3").addClass("active");
                document.getElementById("tab-3").style.display = "block";
                if (!isTemplateJoinSelectGenskillsRequired) {
                    document.getElementById("btnNext").style.display = "block";
                    document.getElementById("btnUpload").style.display = "none";
                }
                document.getElementById("tab-4").style.display = "none";
            }

            else if (activeTab.trim() == "Joinability") {
                $(".tab-menu li a").removeClass("active");
                $("#rtab-4").addClass("active");
                document.getElementById("tab-4").style.display = "block";
                document.getElementById("tab-5").style.display = "none";
            }

            else if (activeTab.trim() == "Selectability") {
                $(".tab-menu li a").removeClass("active");
                $("#rtab-5").addClass("active");
                document.getElementById("tab-5").style.display = "block";
                document.getElementById("tab-6").style.display = "none";
            }

            else if (activeTab.trim() == "General Skill") {
                $(".tab-menu li a").removeClass("active");
                $("#rtab-6").addClass("active");
                document.getElementById("tab-6").style.display = "block";
                document.getElementById("tab-7").style.display = "none";
                document.getElementById("btnNext").style.display = "block";
                document.getElementById("btnUpload").style.display = "none";

            }

        });
        $("#btnNext").click(function () {
            var flag = false;
            var activeTab = $(".active").text();
            if ((activeTab.trim() == "Recommendations")) {
                flag = checkTabValidation(activeTab);
                if (!flag) {
                    document.getElementById("btnPrev").style.display = "block";
                    $(".tab-menu li a").removeClass("active");
                    $("#rtab-2").addClass("active");
                    document.getElementById("tab-2").style.display = "block";
                    document.getElementById("tab-1").style.display = "none";
                }
            }
            else if (activeTab.trim() == "Tech Skill") {
                flag = checkTabValidation(activeTab);
                if (!flag) {
                    $(".tab-menu li a").removeClass("active");
                    $("#rtab-3").addClass("active");
                    document.getElementById("tab-3").style.display = "block";
                    document.getElementById("tab-2").style.display = "none";
                }
            }
            else if (activeTab.trim() == "Interviewer") {
                flag = checkTabValidation(activeTab);
                if (!flag) {
                    $(".tab-menu li a").removeClass("active");
                    $("#rtab-4").addClass("active");
                    document.getElementById("tab-4").style.display = "block";
                    document.getElementById("tab-3").style.display = "none";
                    if (!isTemplateJoinSelectGenskillsRequired) {
                        document.getElementById("btnNext").style.display = "none";
                        document.getElementById("btnUpload").style.display = "block";
                    }
                }

            }
            else if (activeTab.trim() == "Questions") {
                $(".tab-menu li a").removeClass("active");
                if (isTemplateJoinSelectGenskillsRequired) {
                    $("#rtab-5").addClass("active");
                    document.getElementById("tab-5").style.display = "block";
                }
