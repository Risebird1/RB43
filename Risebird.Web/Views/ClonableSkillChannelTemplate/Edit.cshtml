@model Risebird.Entities.ViewModel.ClonableSkillChannelVM
@using Risebird.Entities.Enum;

@{
    ViewData["Title"] = "Edit Clone Template";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />

<div class="main-panel" id="main-panel">


    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <form action="/ClonableSkillChannelTemplate/Edit" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid" onsubmit="return CheckTotalWeightage()">


                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div>
                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Edit Clone Template</h4></div>
                                </div>
                                <div class="tabCon">
                                    <div class="tab-menu">
                                        <ul class="tabs">
                                            <li><a href="#" class="active text-center" id="rtab-1" onclick="headerClickchange('tab-1')">Recommendations</a></li>
                                            <li><a href="#" id="rtab-2" class="" onclick="headerClickchange('tab-2')">Tech Skill </a><span id="count_SkillCollection" class="skillcount">@Model.SkillCollection.Count()</span></li>
                                            <li><a href="#" id="rtab-3" class="" onclick="headerClickchange('tab-3')">Interviewer</a><span id="count_Interviewer" class="skillcount">@Model.InterviewerCollection.Count()</span></li>
                                            <li><a href="#" id="rtab-4" class="text-center" onclick="headerClickchange('tab-4')">Questions</a><span id="count_QuestionsTable" class="skillcount">@(Model.ClonableTemplateQuestionsCollection!=null ? Model.ClonableTemplateQuestionsCollection.Count() : 0)</span></li>

                                            @if (Model.IsTemplateJoinSelectGenskillsRequired)
                                            {
                                                <li id="li_joinability"><a href="#" id="rtab-5" class="" onclick="headerClickchange('tab-5')">Joinability</a><span id="count_Joinability" class="skillcount">@Model.Joinability.Count()</span></li>
                                                <li id="li_selectability"><a href="#" id="rtab-6" class="" onclick="headerClickchange('tab-6')">Selectability</a><span id="count_Selectability" class="skillcount">@Model.Selectability.Count()</span></li>
                                                <li id="li_generalSkill"><a href="#" id="rtab-7" class="" onclick="headerClickchange('tab-7')">General Skill</a><span id="count_SkillGeneral" class="skillcount">@Model.SkillGeneral.Count()</span></li>

                                            }

                                        </ul>
                                    </div>

                                    <div>

                                        <h3 class="tab_drawer_heading" rel="tab-1">Recommendations</h3>
                                        <div class="tab-box" id="tab-1" style="display:block;">
                                            <div class="tab-main-box">
                                                <h5>Template Details</h5>
                                                <div class="form-group col-md-6 col-sm-6 pr-1">
                                                    @Html.LabelFor(model => model.TemplateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    @Html.EditorFor(m => m.TemplateName, new { htmlAttributes = new { @class = "form-control text-box single-line", @onblur = "validateName()" } })
                                                    <div style="position:relative">
                                                        @Html.ValidationMessageFor(model => model.TemplateName, "", new { @id = "error_TemplateName", @class = "text-danger", @style = "position:absolute" })
                                                    </div>
                                                </div>
                                                <br />
                                                <h5>Recommendation Details</h5>
                                                <div class="row">
                                                    <div class="form-group">
                                                        @Html.RadioButtonFor(model => model.IRFRecommendations.StatusRadioValue, "true", new { @onchange = "RecommendationStatusChanged(this.value)", @style = "position:relative;top:3px;margin:0px 5px;"@*, @checked = true*@ }) Active<br />
                                                        @Html.RadioButtonFor(model => model.IRFRecommendations.StatusRadioValue, "false", new { @onchange = "RecommendationStatusChanged(this.value)", @style = "position:relative;top:3px;margin:0px 5px;" }) Inactive<br />

                                                    </div>
                                                </div>
                                                <div class="row" id="recommendationFields">

                                                    <div class="col-md-6 col-sm-6 pr-1">

                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFRecommendations.CategoryId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @if (Model.IRFRecommendations.CategoryId.HasValue)
                                                            {
                                                                @Html.DropDownListFor(model => model.IRFRecommendations.CategoryId, Model.IRFRecommendations.CategoryList, "Select", new { @class = "select-css form-control text-box single-line", @disabled = "disabled" @*, @onchange = "AssessmentGroupCategoryChanged(this.value)"*@})@*(SelectList)ViewBag.CategoryList*@

                                                            }
                                                            else
                                                            {
                                                                <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label">Category has not been specified for this Assessment Group</label>

                                                            }

                                                            @Html.ValidationMessageFor(model => model.IRFRecommendations.CategoryId, "", new { @class = "text-danger" })


                                                        </div>
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFRecommendations.AssessmentGroupId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>

                                                            @if (Model.IRFRecommendations.AssessmentGroupsList != null && Model.IRFRecommendations.AssessmentGroupsList.Count() > 0)
                                                            {
                                                                @Html.DropDownListFor(model => model.IRFRecommendations.AssessmentGroupId, Model.IRFRecommendations.AssessmentGroupsList, new { @class = "select-css form-control text-box single-line", @disabled = "disabled" })

                                                            }
                                                            else
                                                            {
                                                                @Html.EditorFor(m => m.IRFRecommendations.AssessmentGroupName, new { htmlAttributes = new { @class = "form-control text-box single-line", @readonly = "readonly" } })

                                                            }
                                                            @Html.ValidationMessageFor(model => model.IRFRecommendations.CategoryId, "", new { @class = "text-danger" })


                                                        </div>
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFRecommendations.CompetencyLevelId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @Html.DropDownListFor(model => model.IRFRecommendations.CompetencyLevelId, Model.CompetencyLevelList, "Select", new { @class = "select-css form-control text-box single-line" })

                                                            @Html.ValidationMessageFor(model => model.IRFRecommendations.CompetencyLevelId, "", new { @id = "error_CompetencyLevel", @class = "text-danger" })


                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6 pr-1">
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFRecommendations.CountryType, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>

                                                            @Html.DropDownListFor(model => model.IRFRecommendations.CountryType, Html.GetEnumSelectList<CountryTypeEnum>(), "Select", new { @class = "select-css form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.IRFRecommendations.CountryType, "", new { @id = "error_CountryType", @class = "text-danger" })

                                                        </div>
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFRecommendations.SeniorityLevelId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @Html.DropDownListFor(model => model.IRFRecommendations.SeniorityLevelId, Model.SeniorityLevelList@*Html.GetEnumSelectList<JobLevels>()*@, "Select", new { @class = "select-css form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.IRFRecommendations.SeniorityLevelId, "", new { @id = "error_SeniorityLevel", @class = "text-danger" })

                                                        </div>
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.IRFRecommendations.CompanyType, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @Html.DropDownListFor(model => model.IRFRecommendations.CompanyType, Html.GetEnumSelectList<CompanyType>(), "Select", new { @class = "select-css form-control text-box single-line" })
                                                            @Html.ValidationMessageFor(model => model.IRFRecommendations.CompanyType, "", new { @id = "error_CompanyType", @class = "text-danger" })
                                                        </div>

                                                        @Html.HiddenFor(m => m.IRFRecommendations.id)
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                        <h3 class="tab_drawer_heading" rel="tab-2">Tech Skill</h3>
                                        <div class="tab-box" id="tab-2">
                                            <div class="tab-main-box">
                                                <div class="row">

                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table table-bordered mbn" id="SkillTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                                                                        <th width="30%" class="table_heading">Skill Name<span class="red">*</span></th>
                                                                        <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>
                                                                        <th width="20%" class="table_heading">Concepts</th>
                                                                        <th width="30%" class="table_heading">Nature of questions</th>
                                                                        <th width="10%" class="table_heading">Time limit</th>
                                                                        <th width="10%" class="table_heading text-center">Action</th>

                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.SkillCollection == null || Model.SkillCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.DropDownList("SkillCollection[0].LevelId", Model.LevelTech, new { @class = "select-css form-control " })

                                                                            </td>
                                                                            <td>
                                                                                @Html.DropDownList("SkillCollection[0].SkillId", Model.Skills, new { @class = "select-css form-control " })
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Weightage" name="SkillCollection[0].Weightage" type="number" max="100" min="1" value="100">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Concepts" name="SkillCollection[0].Concepts" type="text" maxlength="50">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Natureofquestion" name="SkillCollection[0].Natureofquestion" type="text" maxlength="50">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Timelimit" name="SkillCollection[0].Timelimit" type="number" max="30" min="1">
                                                                            </td>
                                                                            <td class="action text-center">

                                                                                <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>


                                                                            </td>
                                                                        </tr>
                                                                    }

                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                                        {
                                                                            <tr>

                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].LevelId, Model.LevelTech, new { @class = "form-control select-css" })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].SkillId, Model.Skills, new { @class = "select-css form-control" })
                                                                                </td>

                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Weightage, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Concepts, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Natureofquestion, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Timelimit, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "30", @min = "1" } })
                                                                                </td>
                                                                                <td class="action text-center">
                                                                                    <div>
                                                                                        <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                        <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>

                                                                        }
                                                                    }

                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="SkillCollection_WeightageError" style="color:red!important; margin-left:807px;font-size:12px!important;"></label>
                                                            <label class="text-danger" id="SkillCollection_WeightageErrorDown" style="color:white!important; margin-left:415px"></label>
                                                        </div>
                                                    </div><!--end of col-md-12-->

                                                </div>
                                            </div>
                                        </div>

                                        <h3 class="tab_drawer_heading" rel="tab-3">Interviewer</h3>
                                        <div class="tab-box" id="tab-3">
                                            <div class="tab-main-box">
                                                <div class="row">

                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table table-bordered mbn" id="InterviewerTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th width="20%" class="table_heading">EmailId <span class="red">*</span></th>
                                                                        <th width="40%" class="table_heading">Skills</th>
                                                                        <th width="10%" class="table_heading">Per Interviewer Rate<span style="color:red">*</span></th>

                                                                        <th width="10%" class="table_heading"> Relevant </th>
                                                                        <th width="10%" class="table_heading">Resume</th>

                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.InterviewerCollection == null || Model.InterviewerCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.TextBoxFor(m => m.InterviewerCollection[0].EmailId, new { @class = "form-control", @readonly = "readonly" })
                                                                                @Html.HiddenFor(m => m.InterviewerCollection[0].UserId)
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBox("InterviewerCollection[0].PrimarySkill", null, new { @class = "form-control", @readonly = "readonly" })
                                                                            </td>
                                                                            <td>
                                                                                @if (Model.LoggedEmail == "talent@risebird.io" || Model.LoggedEmail == "vaibhaw_sachan@risebird.io" || Model.LoggedEmail == "shahkar_alam@risebird.io" || Model.LoggedEmail == "parvathi_sg@risebird.io")
                                                                                {
                                                                                    @Html.TextBox("InterviewerCollection[0].PerSuccessRate", null, new { @class = "form-control", @type = "number", @min = "1" })
                                                                                }
                                                                                else
                                                                                {
                                                                                    @Html.TextBox("InterviewerCollection[0].PerSuccessRate", null, new { @class = "form-control", @type = "number", @min = "1", @readonly = "readonly" })
                                                                                }
                                                                            </td>
                                                                            <td class="text-center">
                                                                                @Html.CheckBox("InterviewerCollection[0].IsActive", new { @checked = "checked" })
                                                                            </td>
                                                                            @if (Model.InterviewerCollection[0].ResumeLink.Length > 40)
                                                                            {
                                                                                @if (!string.IsNullOrEmpty(Model.InterviewerCollection[0].ResumeLink))
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a href="@Model.InterviewerCollection[0].ResumeLink" target="_blank" data-tooltip="@Model.InterviewerCollection[0].ResumeLink">Resume</a>
                                                                                    </td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a onclick="" data-tooltip="@Model.InterviewerCollection[0].ResumeLink">Resume</a>
                                                                                    </td>
                                                                                }

                                                                            }


                                                                            else
                                                                            {
                                                                                @if (!string.IsNullOrEmpty(Model.InterviewerCollection[0].ResumeLink))
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a href="@Model.InterviewerCollection[0].ResumeLink" target="_blank">Resume</a>
                                                                                    </td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td class="cadName">
                                                                                        <a onclick="">Resume</a>
                                                                                    </td>
                                                                                }

                                                                            }



                                                                        </tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.InterviewerCollection.Count(); i++)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @Html.TextBoxFor(m => m.InterviewerCollection[i].EmailId, new { @class = "form-control", @readonly = "readonly" })
                                                                                    @Html.HiddenFor(m => m.InterviewerCollection[i].UserId)
                                                                                </td>
                                                                                <td>
                                                                                    @Html.TextBoxFor(m => m.InterviewerCollection[i].PrimarySkill, new { @class = "form-control", @readonly = "readonly" })
                                                                                </td>
                                                                                <td>
                                                                                    @if (Model.LoggedEmail == "talent@risebird.io" || Model.LoggedEmail == "vaibhaw_sachan@risebird.io" || Model.LoggedEmail == "shahkar_alam@risebird.io" || Model.LoggedEmail == "parvathi_sg@risebird.io")
                                                                                    {
                                                                                        @Html.TextBoxFor(m => m.InterviewerCollection[i].PerSuccessRate, new { @class = "form-control", @type = "number", @min = "1" })
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @Html.TextBoxFor(m => m.InterviewerCollection[i].PerSuccessRate, new { @class = "form-control", @type = "number", @min = "1", @readonly = "readonly" })
                                                                                    }
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    @Html.CheckBoxFor(m => m.InterviewerCollection[i].IsActive)
                                                                                </td>
                                                                                @if (Model.InterviewerCollection[i].ResumeLink.Length > 40)
                                                                                {
                                                                                    @if (!string.IsNullOrEmpty(Model.InterviewerCollection[i].ResumeLink))
                                                                                    {
                                                                                        <td class="cadName">
                                                                                            <a href="@Model.InterviewerCollection[i].ResumeLink" target="_blank" data-tooltip="@Model.InterviewerCollection[i].ResumeLink">Resume</a>
                                                                                        </td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="cadName">
                                                                                            <a onclick="" data-tooltip="@Model.InterviewerCollection[i].ResumeLink">Resume</a>
                                                                                        </td>
                                                                                    }

                                                                                }


                                                                                else
                                                                                {
                                                                                    @if (!string.IsNullOrEmpty(Model.InterviewerCollection[i].ResumeLink))
                                                                                    {
                                                                                        <td class="cadName">
                                                                                            <a href="@Model.InterviewerCollection[i].ResumeLink" target="_blank">Resume</a>
                                                                                        </td>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <td class="cadName">
                                                                                            <a onclick="">Resume</a>
                                                                                        </td>
                                                                                    }

                                                                                }

                                                                            </tr>
                                                                        }

                                                                    }



                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="noInterviewer"></label>

                                                        </div>
                                                    </div><!--end of col-md-12-->
                                                </div>

                                            </div>
                                        </div>

                                        <h3 class="tab_drawer_heading" rel="tab-4">Questions</h3>
                                        <div class="tab-box" id="tab-4">
                                            <div class="tab-main-box">
                                                <div class="row">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        @if (Model.ClonableTemplateQuestionsCollection == null || Model.ClonableTemplateQuestionsCollection.Count() == 0)
                                                        {
                                                            <p>No sample questions for the selected Assessment Group.</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="table-responsive-sm">
                                                                <table class="table table-bordered mbn" id="QuestionsTable">
                                                                    <thead>
                                                                        <tr>
                                                                            <th width="30%" class="table_heading">Skill</th>
                                                                            <th width="60%" class="table_heading">Question</th>
                                                                            <th width="10%" class="table_heading">Select</th>

                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @for (int i = 0; i < Model.ClonableTemplateQuestionsCollection.Count(); i++)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.ClonableTemplateQuestionsCollection[i].SkillName, new { htmlAttributes = new { @class = "form-control text-box single-line", @readonly = "readonly" } })
                                                                                    @Html.HiddenFor(m => m.ClonableTemplateQuestionsCollection[i].SkillId)
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.ClonableTemplateQuestionsCollection[i].Question, new { htmlAttributes = new { @class = "form-control text-box single-line", @readonly = "readonly" } })
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    @Html.CheckBoxFor(m => m.ClonableTemplateQuestionsCollection[i].IsSelected)
                                                                                </td>
                                                                            </tr>

                                                                        }

                                                                    </tbody>
                                                                </table>
                                                            </div>

                                                        }


                                                    </div><!--end of col-md-12--><!--end of col-md-12-->
                                                </div>

                                            </div>
                                        </div>
                                        @if (Model.IsTemplateJoinSelectGenskillsRequired)
                                        {
                                            <h3 class="tab_drawer_heading" rel="tab-5">Joinability</h3>
                                            <div class="tab-box" id="tab-5">
                                                <div class="tab-main-box">
                                                    <div class="row">
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                            <div class="table-responsive-sm">
                                                                <table class="table table-bordered mbn" id="JoinabilityTable">
                                                                    <thead>
                                                                        <tr>

                                                                            <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                                                                            <th width="25%" class="table_heading">Type<span class="red">*</span></th>
                                                                            <th width="40%" class="table_heading">Value<span class="red">*</span></th>
                                                                            <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>
