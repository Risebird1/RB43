    function checkTabValidation(activeTab) {
        var flag = false;
        if (activeTab.trim() == "Recommendations") {
            if (recommendationRadioValue) {
                if ($('#IRFRecommendations_CompetencyLevelId').val() == "") {
                    $('#error_CompetencyLevel').text("The Competency Level field is required.");
                    flag = true;
                }
                else {
                    $('#error_CompetencyLevel').text("");
                }
                if ($('#IRFRecommendations_SeniorityLevelId').val() == "") {
                    $('#error_SeniorityLevel').text("The Seniority Level field is required.");
                    flag = true;
                }
                else {
                    $('#error_SeniorityLevel').text("");
                }

                if ($('#IRFRecommendations_CountryType').val() == "") {
                    $('#error_CountryType').text("The Country Type field is required.");
                    flag = true;
                }
                else {
                    $('#error_CountryType').text("");
                }
                if ($('#IRFRecommendations_CompanyType').val() == "") {
                    $('#error_CompanyType').text("The Company Type field is required.");
                    flag = true;
                }
                else {
                    $('#error_CompanyType').text("");
                }
            }

            if ($('#TemplateName').val() == "") {
                $('#error_TemplateName').text("Template Name is required");
                flag = true;
            }
            else {
                $('#error_TemplateName').text("");
            }

            return flag;
        }
        else if (activeTab.trim() == "Tech Skill") {
            flag = checkWeightageTab("SkillCollection");
            return flag;
        }
        else if (activeTab.trim() == "Joinability") {
            flag = checkWeightageTab("Joinability");
            return flag;
        }
        else if (activeTab.trim() == "Selectability") {
            flag = checkWeightageTab("Selectability");
            return flag;
        }
        else if (activeTab.trim() == "General Skill") {
            flag = checkWeightageTab("SkillGeneral");
            return flag;
        }
        else if (activeTab.trim() == "Interviewer") {
            flag = checkInterviewerDetails();
            return flag;
        }


    }
    function headerClickchange(newHeader) {
        var activeTab = $(".active").text();
        var flag = false;
        if (activeTab.trim() == "Recommendations") {
            flag = checkTabValidation(activeTab);
            if (!flag) {
                $(".tab-menu li a").removeClass("active");
                $("#r" + newHeader).addClass("active");
                document.getElementById("tab-1").style.display = "none";
                document.getElementById(newHeader).style.display = "block";
            }
        }
        else if (activeTab.trim() == "Tech Skill") {
            flag = checkTabValidation(activeTab);
            if (!flag) {

                $(".tab-menu li a").removeClass("active");
                $("#r" + newHeader).addClass("active");
                document.getElementById("tab-2").style.display = "none";
                document.getElementById(newHeader).style.display = "block";
            }
        }
        else if (activeTab.trim() == "Interviewer") {
            flag = checkTabValidation(activeTab);
            if (!flag) {
                $(".tab-menu li a").removeClass("active");
                $("#r" + newHeader).addClass("active");
                document.getElementById("tab-3").style.display = "none";
                document.getElementById(newHeader).style.display = "block";
            }
        }
        else if (activeTab.trim() == "Questions") {
            $(".tab-menu li a").removeClass("active");
            $("#r" + newHeader).addClass("active");
            document.getElementById("tab-4").style.display = "none";
            document.getElementById(newHeader).style.display = "block";
        }
        else if (activeTab.trim() == "Joinability") {
            flag = checkTabValidation(activeTab);
            if (!flag) {
                $(".tab-menu li a").removeClass("active");
                $("#r" + newHeader).addClass("active");
                document.getElementById("tab-5").style.display = "none";
                document.getElementById(newHeader).style.display = "block";
            }
        }
        else if (activeTab.trim() == "Selectability") {
            flag = checkTabValidation(activeTab);
            if (!flag) {

                $(".tab-menu li a").removeClass("active");
                $("#r" + newHeader).addClass("active");
                document.getElementById("tab-6").style.display = "none";
                document.getElementById(newHeader).style.display = "block";
            }
        }
        else if (activeTab.trim() == "General Skill") {
            flag = checkTabValidation(activeTab);
            if (!flag) {

                $(".tab-menu li a").removeClass("active");
                $("#r" + newHeader).addClass("active");
                document.getElementById("tab-7").style.display = "none";
                document.getElementById(newHeader).style.display = "block";
            }
        }



        if (!flag) {
            if (newHeader == "tab-1") {
                document.getElementById("btnPrev").style.display = "none";
            }
            else {
                document.getElementById("btnPrev").style.display = "block";
            }

            if ((isTemplateJoinSelectGenskillsRequired && newHeader == "tab-7") || (!isTemplateJoinSelectGenskillsRequired && newHeader == "tab-4")) {
                document.getElementById("btnNext").style.display = "none";
                document.getElementById("btnUpload").style.display = "block";
            }
            else {
                document.getElementById("btnNext").style.display = "block";
                document.getElementById("btnUpload").style.display = "none";
            }

        }
    }

    function checkWeightageTab(tab_skill) {
        var inCorrectCount = 0;
        var items = $('[id^=' + tab_skill + '][id$="Weightage"]');
        $("#count_" + tab_skill).text(items.length);
        var total = 0;
        for (j = 0; j < items.length; j++) {
            var total = total + parseInt($("#" + items[j].id).val());
        }

        if (total != 100) {
            inCorrectCount = inCorrectCount + 1;
            // Label should be populated here
            document.getElementById(tab_skill + "_WeightageError").innerHTML = "Weightage total should be equal to 100.";
            if (tab_skill == "SkillCollection") {
                var labelName = "Tech Skills";
            }
            else if (tab_skill == "SkillGeneral") {
                var labelName = "General Skills";
            }
            else {
                var labelName = tab_skill;
            }
            document.getElementById(tab_skill + "_WeightageErrorDown").innerHTML = "Weightage total for " + labelName + " should be equal to 100.";
            return true;
        }
        var drpdowns = $('[id^=' + tab_skill + '][id$="LevelId"]');
