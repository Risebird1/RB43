@model IEnumerable<Risebird.Entities.ViewModel.ClonableSkillChannelVM>

@if (Model != null && Model.Count() > 0)
{
    <div class="table-responsive scrollbar style-2" style="overflow-x:scroll">
        <table class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th width="70%" class="table_heading">Skill Name</th>
                    <th width="10%" class="table_heading">Client Name</th>
                    <th width="10%" class="table_heading">JD Title</th>
                    <th width="10%" class="table_heading">Assessment Group</th>
                    <th width="10%" class="table_heading">Interview Counts</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IRFId</td>
                        <td>@item.ClientName</td>
                        <td>@item.JDTiltle</td>
                        <td>@item.AssessmentGroupName</td>
                        <td>@item.InterviewCounts</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-center"> No Skill Channels added in this Template.</p>
}



