@model Risebird.Entities.ViewModel.DriveWeekendDataVM
@{
    ViewData["Title"] = "Weekend Drive";
    ViewBag.PageHeader = "Skills Channel / Weekend Drive";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var page = Model ?? new Risebird.Entities.ViewModel.DriveWeekendDataVM();
}



<script>

    var Header = "<a href='/IRF/Index' class='breadcrumscolor'>Skills Channel</a>&nbsp;/&nbsp; Weekend Drive";

    $('#txtpageHeader').empty().html(Header);

</script>



<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />

<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<link rel="stylesheet" href="~/css/drive-weekend.css?v=20260811d" />



<div class="main-panel" id="main-panel">

    <div class="pt30">

        <div class="col-md-12 nopad">

            <div class="mdc-card card bl-bg">

                <div class="drive-page-header">

                    <div>

                        <h4 class="drive-title">Weekend Drive</h4>

                        <p class="drive-subtitle">Confirmed weekend interviews at/above drive threshold — outreach &amp; staffing tracker</p>

                    </div>

                    <div class="drive-toolbar">

                        <div class="drive-pill-toggle" role="group" aria-label="Weekend toggle">

                            <button type="button" class="drive-weekend-toggle active" data-weekend="This">This weekend</button>

                            <button type="button" class="drive-weekend-toggle" data-weekend="Next">Next weekend</button>

                        </div>

                        <a href="/IRF/Index" class="mdc-button mdc-button--outlined mdc-ripple-upgraded" style="font-size:12px;padding:6px 12px;text-decoration:none;"><span class="fa fa-chevron-left"></span> Back to Skills Channel</a>

                    </div>

                </div>



                <div class="drive-legend">

                    <span><i class="fas fa-phone-volume"></i> MAG call</span>

                    <span><i class="fas fa-envelope"></i> MAG email</span>

                    <span><i class="fas fa-bullhorn"></i> Campaign</span>

                    <span><i class="fas fa-user-clock"></i> Stuck</span>

                    <span><i class="fas fa-user-plus"></i> Invite</span>

                    <span><i class="fas fa-bell"></i> Open slots</span>

                    <span><i class="fas fa-link"></i> Cross-MAG entry</span>

                    <span class="ms-auto"><i class="fas fa-check-double"></i> Actions taken auto-save</span>

                </div>



                <div class="drive-card-body">

                    <div class="drive-loader" id="driveWeekendLoader" style="display:none;">

                        <img src="~/Newassets/img/lazyload.gif" alt="Loading weekend drive data" />

                    </div>

                    <div id="driveWeekendContainer">
                        @await Html.PartialAsync("_DriveWeekendData", page)
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div id="driveToastHost" class="drive-toast-host" aria-live="polite" aria-atomic="true"></div>

@await Html.PartialAsync("~/Views/Common/_AssessmentGroupsListPartial.cshtml")

@await Html.PartialAsync("~/Views/Interview/BroadcastModal.cshtml")

@await Html.PartialAsync("~/Views/Common/_GenerateInterviewerApplicationUrl.cshtml")



@section Scripts {

    <script src="~/js/BroadcastMessage.js"></script>

    <script src="~/js/checkintervieweravailabilitybymail.js"></script>

    <script src="~/js/AssessmentGroupFunctionalities.js"></script>

    <script>

        window.driveWeekendDataUrl = '@Url.Action("DriveWeekendData", "InterviewDemand")';

    </script>

    <script src="~/js/drive-weekend-demand.js?v=20260811d"></script>

    <script type="text/javascript">

        function SendOpenInterview(irfId) {

            swal.fire({

                title: 'Are you sure you want to send open interview notification?',

                type: 'warning',

                showCancelButton: true,

                confirmButtonColor: '#3085d6',

                cancelButtonColor: '#d33',

                confirmButtonText: 'Yes, send!',

                preConfirm: function () {

                    return $.post('/Interviewer/SendOpenURLNotification', { irfId: irfId });

                },

                allowOutsideClick: false

            }).then(function (result) {

                if (result.value === 'Success') {

                    swal.fire('Sent!', 'Mails sent successfully.', 'success');

                } else if (result.value) {

                    swal.fire('Failed to send!', result.value, 'error');

                }

            });

        }



        $(function () {

            if (typeof initDriveSpotlightPicker === 'function') {

                initDriveSpotlightPicker();

            }

            if (typeof initRowActions === 'function') {

                initRowActions();

            }

        });

    </script>

}


