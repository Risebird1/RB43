@model Risebird.Entities.ViewModel.DriveWeekendDataVM
@using System.Linq
@using System.Text.Json
@{
    var page = Model ?? new Risebird.Entities.ViewModel.DriveWeekendDataVM();
    var rows = page.Rows ?? new List<Risebird.Entities.ViewModel.DriveIRFVM>();
    var belowRows = page.BelowThresholdRows ?? new List<Risebird.Entities.ViewModel.DriveIRFVM>();
    var weekendStart = page.WeekendStart;
    var weekendEnd = page.WeekendEnd;
    var stats = page.Stats;
    var threshold = stats?.Threshold ?? 5;
    var totalExpected = rows.Sum(x => x.ExpectedTotal);
    var totalUnassigned = rows.Sum(x => x.UnassignedMorning + x.UnassignedEvening);
}

@if (weekendStart != default)
{
    <div class="drive-summary">
        <span class="drive-weekend-range">
            <i class="far fa-calendar-alt"></i>
            @weekendStart.ToString("ddd, dd MMM") – @weekendEnd.ToString("ddd, dd MMM yyyy")
        </span>
        <span class="drive-stat"><strong>@rows.Count</strong> drive IRF@(rows.Count == 1 ? "" : "s")</span>
        <span class="drive-stat"><strong>@totalExpected</strong> interviews expected</span>
        <span class="drive-stat drive-stat-warn"><strong>@totalUnassigned</strong> unassigned</span>
    </div>
}

<div class="drive-spec-note">
    <i class="fas fa-info-circle"></i>
    <span>
        <strong>Drive IRFs</strong> need at least <strong>@threshold</strong> confirmed interviews on the same skill channel this weekend.
        Outreach and staffing actions apply only to those rows.
    </span>
</div>

@if (!rows.Any())
{
    <div class="drive-empty">
        <div><i class="fas fa-calendar-check"></i></div>
        @if (stats != null && stats.TotalInterviews > 0 && stats.BelowThresholdIrfCount > 0)
        {
            <p>
                Found @stats.TotalInterviews confirmed interview@(stats.TotalInterviews == 1 ? "" : "s") across @stats.TotalIrfGroups IRF@(stats.TotalIrfGroups == 1 ? "" : "s"),
                but no single IRF reached the drive threshold of @threshold.
            </p>
            <p class="text-muted" style="font-size:11px;margin-top:6px;">
                Example: 8 interviews across 8 IRFs means ~1 each — none qualify until one IRF has @threshold+ interviews.
            </p>
        }
        else
        {
            <p>No confirmed weekend interviews found for this date range.</p>
            <p class="text-muted" style="font-size:11px;margin-top:6px;">Try switching to the other weekend.</p>
        }
    </div>
}
else
{
    <div class="drive-section-title">Drive IRFs (threshold met)</div>
    @await Html.PartialAsync("_DriveWeekendTable", rows)
}

@if (belowRows.Any())
{
    <div class="drive-below-threshold">
        <div class="drive-section-title drive-section-title-muted">
            Below drive threshold (@threshold+ required per IRF) — @belowRows.Count IRF@(belowRows.Count == 1 ? "" : "s")
        </div>
        <div class="drive-table-wrap">
            <table class="table drive-table drive-table-muted">
                <thead>
                    <tr>
                        <th>IRF / Skill</th>
                        <th>Client</th>
                        <th>Demand</th>
                        <th>Unassigned</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in belowRows)
                    {
                        var unassignedTotal = i.UnassignedMorning + i.UnassignedEvening;
                        var unassignedClass = unassignedTotal > 0 ? "drive-unassigned-warn" : "drive-unassigned-ok";
                        <tr>
                            <td>
                                <div class="drive-irf-id">@i.IRFId</div>
                                <div class="drive-irf-skill" title="@i.PrimarySkill">@i.PrimarySkill</div>
                            </td>
                            <td>
                                <div>@i.ClientName</div>
                                @if (!string.IsNullOrEmpty(i.EndClientName))
                                {
                                    <div class="drive-meta-sub">@i.EndClientName</div>
                                }
                            </td>
                            <td>
                                <span class="drive-badge drive-badge-m" title="Morning">M @i.ExpectedMorning</span>
                                <span class="drive-badge drive-badge-e" title="Evening">E @i.ExpectedEvening</span>
                                <span class="drive-badge drive-badge-total">@i.ExpectedTotal</span>
                            </td>
                            <td class="@unassignedClass">
                                M @i.UnassignedMorning / E @i.UnassignedEvening
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
