@model IEnumerable<Risebird.Entities.Data.SkillChannelTasks>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=2024" />
<div id="style-2" class="scrollers" style="overflow-y:auto">

    <div id="tableID">
        <table id="statusTable" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>

                    <th>Date</th>
                    <th>Status</th>
                    <th>Comments</th>
                    

                </tr>
            </thead>
            <tfoot>
                <tr>

                    <th>Date</th>
                    <th>Status</th>
                    <th>Comments</th>
                   

                </tr>
            </tfoot>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id=@item.id>

                        <td> @item.CreatedOn</td>
                        @if (item.StatusValue == "In Progress")
                        {
                            <td><span style="font-size:13px;"> @item.StatusValue</span></td>
                        }
                        else if (item.StatusValue == "Completed")
                        {
                            <td>
                                <span style="font-size:13px;"> @item.StatusValue</span>
                            </td>
                        }

                        else
                        {
                            <td> @item.StatusValue</td>
                        }

                        <td>
                            <div>
                                <div>
                                    @if (item.Comments != null && item.Comments.Length > 18)
                                    {

                                        <a href="#" data-tooltip="@item.Comments">
                                            <textarea style="  height: 50px;width: 100%;font-size: 13px!important;resize: none; background:none; border:0px;">@item.Comments</textarea>
                                        </a>
                                    }

                                    else
                                    {
                                        <textarea style="height:50px;width: 100%;font-size: 13px!important;resize: none; background:none; border:0px;">@item.Comments</textarea>
                                    }
                                </div>
                            </div>

                        </td>
                        
                    </tr>


                }
            </tbody>
        </table>
    </div>

</div>
<script src="~/Newassets/js/scrollBar.js?v=2024"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>

<script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>