@model IEnumerable<Risebird.Entities.ViewModel.SkillChannelTaskSpeedDetailsVM>

<div class="secondtable-h" id="style-2">
    <div class="table-responsive">
        <table id="meeting" class="table table-bordered table-hover" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>Interview date</th>
                    <th>Candidate</th>
                    <th>Interviewer</th>
                    @if (ViewBag.AccuracyType == "Reschedule")
                    {
                        <th>Resume</th>
                    }
                    <th>Action</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th>Interview date</th>
                    <th>Candidate</th>
                    <th>Interviewer</th>
                    @if (ViewBag.AccuracyType == "Reschedule")
                    {
                        <th>Resume</th>
                    }
                    <th>Action</th>
                </tr>
            </tfoot>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.interviewDate</td>
                        <td>@item.candidateEmail</td>
                        <td>@item.interviewer</td>
                        @if (ViewBag.AccuracyType == "Reschedule")
                        {
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.ResumeLink))
                                {
                                    <a target="_blank" href="@item.ResumeLink">Resume</a>
                                }
                            </td>
                        }
                        <td>
                            @if (ViewBag.AccuracyType == "ProxyInterview" || ViewBag.AccuracyType == "QcPending")
                            {
                                <a target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.imid, irfId=item.irfIntId})">
                                    <button class="mdc-fab app-fab--absolute" aria-label="Feedback Report">
                                        <span title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                    </button>
                                </a>
                            }
                            else if (ViewBag.AccuracyType == "ReportPending")
                            {
                                <a target="_blank" href="@Url.Action("AddReport", "Interview" , new { interviewId=item.imid, irfId=item.irfIntId})">
                                    <button class="mdc-fab app-fab--absolute" aria-label="Feedback Report">
                                        <span title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                    </button>
                                </a>
                            }
                            else if (ViewBag.AccuracyType == "Reschedule")
                            {
                                //Reschedule Link
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>