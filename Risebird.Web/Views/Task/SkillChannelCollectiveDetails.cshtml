<div id="updateStatusModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon fas fa-user-friends" style="font-size:20px;color:#fff;"></span>
                </div>
                <h5 class="modal-title pull-left" id="updateStatusHeading"> </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="margin-right:-8px;">
                <span aria-hidden="true" id="updateStatusPopUp" style="cursor:pointer;color:#fff">&times;</span>
            </button>


            <div class="modal-body">

                <div class="col-md-12 col-sm-12 modal-info">
                    <div class="form-group">

                        <label class="control-labeled">
                            Status
                        </label>

                        <select class="select-css form-control" id="statusDrpDwn" asp-items="Html.GetEnumSelectList<TaskUpdateStatusOptions>()"></select>
                    </div>

                    <div class="form-group">

                        <label class="control-labeled w-full">
                            Comments
                        </label>
                        <input type="text" id="idComments" class="w-full" style="height:80px">

                    </div>

                </div>

                <div class="modal-footer">
                    <div class="w-full text-right">
                        <div class="col-md-12 col-sm-12">
                            <input type="button" onclick="SaveTaskStatus()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnUpload" value="Save">
                        </div>
                    </div>



                </div>
            </div>
        </div>

    </div>

</div>

<div id="statusListModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">


            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-list" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="statusListHeading"></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="statusListPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body" id="statusListTableBody">
            </div>
        </div>

    </div>
</div>

<script>
    var irfStatusId;//since the property irfId already exists, hence this name
    var statusId;
    var StatusTabName;
    var StatusMainTaskName;

    //var candidateStatusName;
    var spanStatusModal = document.getElementById("updateStatusPopUp");
    // When the user clicks on <span> (x), close the modal
    spanStatusModal.onclick = function () {
        var modal = document.getElementById("updateStatusModal");
        modal.style.display = "none";
    }



    function OpenTaskStatusModal(irfId, tabName, mainTaskName) {

        irfStatusId = irfId;
        //candidateStatusId = candidateId;
        StatusTabName = tabName;
        StatusMainTaskName = mainTaskName;

        // Get the modal
        var modal = document.getElementById("updateStatusModal");

        document.getElementById("updateStatusHeading").innerHTML = "Add status for " + mainTaskName;

        // When the user clicks the button, open the modal
        modal.style.display = "block";

    }


    function SaveTaskStatus() {
        var comment = document.getElementById("idComments").value;
        var statusValue = document.getElementById("statusDrpDwn").value;


        var formdata = new FormData();
        formdata.append('irfId', irfStatusId);
        ///formdata.append('candidateId', candidateStatusId);
        formdata.append('comment', comment);
        // formdata.append('audio_file', audio_file);
        formdata.append('status', statusValue);
        formdata.append('StatusTabName', StatusTabName);
        formdata.append('StatusMainTaskName', StatusMainTaskName);

        $.ajax({
            type: "POST",
            url: "/Task/AddStatus",
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {
                debugger;
                //swal.fire(data);
                if (data) {
                    swal.fire("Successful", "Task status updated successfully", "success");

                }
                else {
                    swal.fire("Failed", "Failed to update task status", "success");

                }
                //location.reload(true);
            }
        });
    }

</script>

<script>
    debugger;
    var closeStatusList = document.getElementById("statusListPopUp");
    closeStatusList.onclick = function () {
        var modal = document.getElementById("statusListModal");
        modal.style.display = "none";
    }

    function GetTaskStatusList(irfId, tabName, taskValue, irfName = null) {
        debugger;
        $.ajax({
            url: '/Task/GetTaskStatusList',
            data: { 'irfId': irfId, 'tabName': tabName, 'irfName': irfName, 'taskValue': taskValue },
            success: function (data) {
                var modal = document.getElementById("statusListModal");
                modal.style.display = "block";
                var appendText = 'Status list for ' + irfName + ' (' + taskValue + ')';
                $('#statusListHeading').html('');
                $('#statusListHeading').html(appendText);
                $('#statusListTableBody').html('');
                $('#statusListTableBody').html(data);


            }
        });
    }


</script>

<script>
    var within_first_modal = false;
    $('.btn-second-modal').on('click', function () {
        if ($(this).hasClass('within-first-modal')) {
            within_first_modal = true;
            $('#myTask').modal('hide');
            $('#myTask').css('display', 'none');
        }
        $('#second-modal').modal('show');
    });

    $('.btn-second-modal-close').on('click', function () {
        $('#second-modal').modal('hide');
        if (within_first_modal) {
            $('#myTask').modal('show');
            within_first_modal = false;
        }
    });
</script>
