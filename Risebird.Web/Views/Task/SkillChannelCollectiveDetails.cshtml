<script>
    var irfStatusId;//since the property irfId already exists, hence this name
    var statusId;
    var StatusTabName;
    var StatusMainTaskName;

    //var candidateStatusName;
    var spanStatusModal = document.getElementById("updateStatusPopUp");
    // When the user clicks on <span> (x), close the modal
    spanStatusModal.onclick = function () {
        var modal = document.getElementById("updateStatusModal");
        modal.style.display = "none";
    }



    function OpenTaskStatusModal(irfId, tabName, mainTaskName) {

        irfStatusId = irfId;
        //candidateStatusId = candidateId;
        StatusTabName = tabName;
        StatusMainTaskName = mainTaskName;

        // Get the modal
        var modal = document.getElementById("updateStatusModal");

        document.getElementById("updateStatusHeading").innerHTML = "Add status for " + mainTaskName;

        // When the user clicks the button, open the modal
        modal.style.display = "block";

    }


    function SaveTaskStatus() {
        var comment = document.getElementById("idComments").value;
        var statusValue = document.getElementById("statusDrpDwn").value;


        var formdata = new FormData();
        formdata.append('irfId', irfStatusId);
        ///formdata.append('candidateId', candidateStatusId);
        formdata.append('comment', comment);
        // formdata.append('audio_file', audio_file);
        formdata.append('status', statusValue);
        formdata.append('StatusTabName', StatusTabName);
        formdata.append('StatusMainTaskName', StatusMainTaskName);

        $.ajax({
            type: "POST",
            url: "/Task/AddStatus",
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {
                swal.fire(data);
                //location.reload(true);
            }
        });
    }

</script>

<script>
    var closeStatusList = document.getElementById("statusListPopUp");
    closeStatusList.onclick = function () {
        var modal = document.getElementById("statusListModal");
        modal.style.display = "none";
    }

    function GetTaskStatusList(irfId, tabName, taskValue, irfName) {
        debugger;
        $.ajax({
            url: '/Task/GetTaskStatusList',
            data: { 'irfId': irfId, 'tabName': tabName, 'irfName': irfName, 'taskValue': taskValue },
            success: function (data) {
                var modal = document.getElementById("statusListModal");
                modal.style.display = "block";
                var appendText = 'Status list for ' + irfName + ' (' + taskValue + ')';
                $('#statusListHeading').html('');
                $('#statusListHeading').html(appendText);
                $('#statusListTableBody').html('');
                $('#statusListTableBody').html(data);


            }
        });
    }


</script>

<script>
    var within_first_modal = false;
    $('.btn-second-modal').on('click', function () {
        if ($(this).hasClass('within-first-modal')) {
            within_first_modal = true;
            $('#myTask').modal('hide');
            $('#myTask').css('display', 'none');
        }
        $('#second-modal').modal('show');
    });

    $('.btn-second-modal-close').on('click', function () {
        $('#second-modal').modal('hide');
        if (within_first_modal) {
            $('#myTask').modal('show');
            within_first_modal = false;
        }
    });
</script>
