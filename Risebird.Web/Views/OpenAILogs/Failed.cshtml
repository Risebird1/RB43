@using System.Linq
@model List<Risebird.Entities.Data.OpenAIApiLog>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Failed OpenAI API Calls";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Failed OpenAI API Calls</h2>
            <hr />
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="row mb-3">
        <div class="col-md-12">
            <form method="get" class="form-inline">
                <div class="form-group mr-3">
                    <label for="startDate" class="mr-2">Start Date:</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                </div>
                <div class="form-group mr-3">
                    <label for="endDate" class="mr-2">End Date:</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                </div>
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-secondary ml-2">View All</a>
                <a asp-action="Summary" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" class="btn btn-info ml-2">View Summary</a>
            </form>
        </div>
    </div>

    <!-- Failed Calls Summary -->
    <div class="row mb-4">
        <div class="col-md-12">
            @if (Model.Any())
            {
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">⚠ @Model.Count Failed API Calls</h4>
                    <p>These API calls did not complete successfully. Review the error messages to diagnose issues.</p>
                </div>
            }
            else
            {
                <div class="alert alert-success" role="alert">
                    <h4 class="alert-heading">✓ No Failed Calls</h4>
                    <p>All API calls in the selected date range completed successfully!</p>
                </div>
            }
        </div>
    </div>

    <!-- Failed Calls Table -->
    @if (Model.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h4>Failed API Calls</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Date/Time</th>
                                        <th>Operation Type</th>
                                        <th>Endpoint</th>
                                        <th>Status Code</th>
                                        <th>Error Message</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model)
                                    {
                                        <tr>
                                            <td>@log.LogDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td><span class="badge badge-info">@log.OperationType</span></td>
                                            <td><code style="font-size: 0.85em;">@log.ApiEndpoint</code></td>
                                            <td><span class="badge badge-danger">@log.StatusCode</span></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                                {
                                                    var errorPreview = log.ErrorMessage.Length > 100 ? log.ErrorMessage.Substring(0, 100) + "..." : log.ErrorMessage;
                                                    <span class="text-danger">@errorPreview</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No error message</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-sm btn-primary">View Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>
</div>
