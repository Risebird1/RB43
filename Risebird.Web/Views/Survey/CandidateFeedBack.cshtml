@model IEnumerable<Risebird.Entities.ViewModel.SurveyVM>
@{
    ViewData["Title"] = "Candidate FeedBack";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent   bg-primary navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Candidate FeedBack</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->


    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Candidate FeedBack</h4></div>
                </div>

                <div class="pull-right">
                    <a href="/User/Interviewers" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">Back to List</a>

                </div>
            </div>
        </div>
    </div>




    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <table id="interviewer" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email Address</th>
                                            <th>Interviewer EmailAddress</th>
                                            <th id='start'>Question1</th>
                                            <th>Question2</th>
                                            <th>Question3</th>
                                            <th>Question4</th>
                                            <th>Question5</th>
                                            <th>Question6</th>
                                            <th>Comment</th>

                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email Address</th>
                                            <th>Interviewer EmailAddress</th>
                                            <th>Question1</th>
                                            <th>Question2</th>
                                            <th>Question3</th>
                                            <th>Question4</th>
                                            <th>Question5</th>
                                            <th>Question6</th>
                                            <th>Comment</th>

                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr id=@item.interviewid>
                                                <td>@item.Name</td>
                                                <td>@item.EmailAddress</td>
                                                <td>@item.interviewerEmail</td>
                                                <td>@item.Question1</td>
                                                <td>@item.Question2</td>
                                                @if (item.Question3 == "1")
                                                {
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in">
                                                            <div class="talktext">
                                                                <textarea>No, I am satisfied with the interviewer and evaluation process</textarea>

                                                            </div>
                                                        </div>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in">
                                                            <div class="talktext">
                                                                <textarea>Yes, I didn't get a fair chance and I can do better</textarea>

                                                            </div>
                                                        </div>
                                                    </td>
                                                }
                                                <td>
                                                    <div class="talk-bubble tri-right border-bubble right-in">
                                                        <div class="talktext">
                                                            <textarea>@item.Question4</textarea>

                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="talk-bubble tri-right border-bubble right-in">
                                                        <div class="talktext">
                                                            <a href="#" data-tooltip="@item.Question5">  <textarea>@item.Question5</textarea></a>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@item.Question6</td>
                                                <td>
                                                    <div class="talk-bubble tri-right border-bubble right-in">
                                                        <div class="talktext">
                                                            <textarea>@item.CommentforInterviewer</textarea>

                                                        </div>
                                                    </div>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

        <div id="myCallModal" class="modal modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">


                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">


                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left">Call Interviewer!</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                    </button>






                    <div class="modal-body">

                        <h5 class="modal-title text-center " id="callingLabel">Calling...</h5>


                        <div class="">
                            <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 20px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>

<script>
    function dropDwnToolTips(id) {

        if (id.value == 0) {
            id.title = "";
        }
        else {
            id.title = id.value
        }
    }


</script>

<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/User/Interviewers';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/User/Interviewers';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


