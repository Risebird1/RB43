<script>

    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

    function moreless1(id) {
        $('.moretext1_' + id).slideToggle();
        if ($('#read1_' + id).val() == 'Readmore') {
            $('#read1_' + id).empty().html('Read more');
            $('#read1_' + id).val('Readless');
        } else {
            $('#read1_' + id).empty().html('Read less');
            $('#read1_' + id).val('Readmore');
        }
    }

</script>
<script>
    function SetRating() {
        var indexCount = $('#txtrate').val();
        for (var i = 0; i < indexCount; i++) {
            var Question1_Value = document.getElementById("Question1_" + i).value;
            if (Question1_Value != null && Question1_Value != "" && parseInt(Question1_Value) > 0) {
                $('#Question1_' + Question1_Value + '_' + i).attr('checked', 'checked');
            }
            var Question2_Value = document.getElementById("Question2_" + i).value;
            if (Question2_Value != null && Question2_Value != "" && parseInt(Question2_Value) > 0) {
                $('#Question2_' + Question2_Value + '_' + i).attr('checked', 'checked');
            }
            var Question6_Value = document.getElementById("Question6_" + i).value;
            if (Question6_Value != null && Question6_Value != "" && parseInt(Question6_Value) > 0) {
                $('#Question6_' + Question6_Value + '_' + i).attr('checked', 'checked');
            }
        }
    }
    function Changeurldetails(type, pagevalue) {
        if (pagevalue == 'IRF') {
            var irfvalue = $("#_hidIRF").val();
            window.location.href = "/Survey/CandidateFeedBackByIRFId?IRFId=" + irfvalue + "&type=" + type;
        } else {
            window.location.href = "/Survey/CandidateFeedBack?type=" + type;
        }
    }
</script>
<script>
    function OpenRedoFormModel(interviewid, interviewstatus, type, uniqueid) {
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { 'interviewid': interviewid, 'interviewstatus': interviewstatus, 'type': type, 'uniqueid': uniqueid },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }
    function openRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "none";
    }
</script>