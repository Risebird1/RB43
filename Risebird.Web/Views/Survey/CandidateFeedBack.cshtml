@model IEnumerable<Risebird.Entities.ViewModel.SurveyVM>
@using X.PagedList.Mvc.Core;
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Candidate FeedBack";
    ViewBag.PageHeader = "Candidate FeedBack";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string[] ProfileSource = new string[] { };
    string[] HREmail = new string[] { };
}

<input type="hidden" id="txtrate" value="@Model.Count()" />
@if (HttpContextAccessor.HttpContext.Session.GetString("CandidateFeedBackfilters") != null)
{
    filter = JsonConvert.DeserializeObject<CandidateTimelineFilter>(HttpContextAccessor.HttpContext.Session.GetString("CandidateFeedBackfilters"));
    ProfileSource = filter.ProfileSource != null ? filter.ProfileSource : new string[] { };
    HREmail = filter.HREmail != null ? filter.HREmail : new string[] { };
}

