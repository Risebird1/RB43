@model IEnumerable<Risebird.Entities.ViewModel.ClientAudioFeedbackDetails>
@using X.PagedList.Mvc.Core;
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Client FeedBacks";
    ViewBag.PageHeader = "Client FeedBacks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" id="txtrate" value="@Model.Count()" />

<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css" />

<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 6.9rem;
        right: -.3rem;
    }
</style>
<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad">
                <div class="card-header bg-w clearfix">
                    <img style="visibility:hidden" src="" data-position="right" />
                    <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                    <div class="pull-left">
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title"> FeedBack</h4></div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            @if (ViewBag.type == "Audio Feedback")
                            {
                                <div class="feedback-tab-ac" onclick="Changeurldetails('Audio Feedback','@ViewBag.PageName')"><strong>Audio Feedback </strong></div>
                                <div class="feedback-tab" onclick="Changeurldetails('Broadcast Messages','@ViewBag.PageName')"><strong>Broadcast Messages</strong></div>

                            }
                            else
                            {
                                <div class="feedback-tab" onclick="Changeurldetails('Audio Feedback','@ViewBag.PageName')"><strong>Audio Feedback</strong></div>
                                <div class="feedback-tab-ac" onclick="Changeurldetails('Broadcast Messages','@ViewBag.PageName')"><strong>Broadcast Messages</strong></div>

                            }
                        </div>
                    </div>


                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div id="candidatefeedback_table" data-intro="<span style='font-size:16px;'>Overview the summary of Client Feedbacks</span><hr class='btop' />1. Candidate Name<br/> 2. JD Title<br/> 3. Rating <br/> 4. Comment <br/><a href='/CommonPool/Index' class='btn btn-primary allmeetingnext-btn'>NEXT</a>" data-position="top">
                                <div class="dataloading">
                                    <div style="overflow-x:scroll;overflow-y:hidden" class="scrollbar survey" id="style-2">
                                        <table id="clientFeedbacks" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            @if (ViewBag.type == "Audio Feedback")
                                            {
                                                <thead>
                                                    <tr>
                                                        <th>Skill Channel Name</th>
                                                        <th>Interview Date</th>
                                                        <th>Interviewer Email</th>
                                                        <th>Candidate Email</th>
                                                        <th>AudioURL</th>
                                                        <th>Created At</th>
                                                        <th>Created By</th>

                                                    </tr>
                                                </thead>
                                                <tfoot>
                                                    <tr>
                                                        <th>Skill Channel Name</th>'
                                                        <th>Interview Date</th>
                                                        <th>Interviewer Email</th>
                                                        <th>Candidate Email</th>
                                                        <th>AudioURL</th>
                                                        <th>Created At</th>
                                                        <th>Created By</th>
                                                    </tr>
                                                </tfoot>
                                                <tbody>
                                                   
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>@item.SkillChannelName</td>
                                                            <td>@item.interviewDate</td>
                                                            <td class="candidate-details">@item.Intervieweremail</td>
                                                            <td>@item.candidateEmail</td>
                                                            
                                                            <td>
                                                                <audio controls>
                                                                    <source src="@item.audioURL" type="audio/ogg">
                                                                    <source src="@item.audioURL" type="audio/mpeg">
                                                                    Your browser does not support the audio tag.
                                                                </audio>
                                                            </td>
                                                            <td>@item.createdAt</td>
                                                            <td>@item.createdBy</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            }
                                            else
                                            {
                                                <thead>
                                                    <tr>
                                                        <th>Skill Channel Name</th>
                                                        <th>Interview Date</th>
                                                        <th>Interviewer Email</th>
                                                        <th>Candidate Email</th>
                                                        <th>Subject</th>
                                                        <th>Message</th>
                                                        <th>Sent At</th>
                                                        <th>Sent By</th>
                                                    </tr>
                                                </thead>
                                                <tfoot>
                                                    <tr>
                                                        <th>Skill Channel Name</th>
                                                        <th>Interview Date</th>
                                                        <th>Interviewer Email</th>
                                                        <th>Candidate Email</th>
                                                        <th>Subject</th>
                                                        <th>Message</th>
                                                        <th>Sent At</th>
                                                        <th>Sent By</th>
                                                    </tr>
                                                </tfoot>
                                                <tbody>
                                                    
                                                    @foreach (var item in Model)
                                                    {
                                                        var jsonObj = JsonConvert.SerializeObject(item.Message);
                                                        <tr>
                                                            <td>@item.SkillChannelName</td>
                                                            <td>@item.interviewDate</td>
                                                            <td class="interviewer-details">@item.Intervieweremail</td>
                                                            <td>@item.candidateEmail</td>
                                                            <td>@item.Subject</td>
                                                            <td>
                                                                <a onclick="OpenHtmlDocument(@jsonObj)" style="color:blue"><u>Content</u></a>
                                                            </td>
                                                            <td>@item.SentAt</td>
                                                            <td>@item.SentBy</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            }
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->



        </div>

    </div>
</div>
<script>
    function searchResult() {
        $('#clientFeedbacks').DataTable();
    }
    function RefreshSearch() {
        $('#clientFeedbacks').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();

    });

    function applyDataTable() {
        $('#clientFeedbacks').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

    $(document).ready(function () {
        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#clientFeedbacks").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#clientFeedbacks").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#clientFeedbacks").show();
        }, 2000);
    };

</script>

<script>
    function Changeurldetails(type, pagevalue) {
      
        if (type == 'Audio Feedback') {
            window.location.href = "/Survey/ClientFeedbacks";
        } else {
            window.location.href = "/Survey/BroadCastMessages";
        }
    }
    function OpenHtmlDocument(htmlData) {
        var mailBody = htmlData;
        let child = window.open("about:blank", "mailContent");
        child.document.write(mailBody);
        child.document.close();
    }
</script>