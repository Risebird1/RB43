@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Newassets/css/bootstrap.min.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/interview.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />
    <title>Skill Channel Review</title>
    <style>
        .star-rating {
            border: solid 1px white;
            display: flex;
            flex-direction: row-reverse;
            font-size: 2.0em;
            justify-content: space-around;
            padding: 0 .2em;
            text-align: center;
            width: 100%;
            margin-bottom: 10px;
            background-color: lightgray;
        }

            .star-rating input {
                display: none;
            }

            .star-rating label {
                color: white;
                cursor: pointer;
            }

            .star-rating :checked ~ label {
                color: #f90;
            }

            .star-rating label:hover,
            .star-rating label:hover ~ label {
                color: #fc0;
            }

        .card-title-space {
            margin: 20px 0px;
            float: right
        }

        .mb10 {
            margin-bottom: 10px
        }
    </style>
</head>
<body>
    <div class="text-center" style="background: linear-gradient(to right, #0c2646 0%, #204065 60%, #2a5788 100%); padding: 15px 5px 5px 10px; width: 100%; display: inline-block; position: relative;">
        <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" style="width:180px;" /></div>
        <div style="float:right">
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="loader text-center" style="position:absolute;display:none;width: 1000px;">
                <img style="margin: 0px 15%; width: auto" src="~/Newassets/img/lazyload.gif" />
            </div>
            <div class="col-md-8 offset-md-2" id="divCompletereview" style="display:none">
                <img style=" width: 180px; margin: 0px auto; text-align: center; display: block; padding: 50px 0px;" src="../../img/thanks.png" />
                <h1 style="text-align:center; font-weight:400;line-height:50px;"><b>THANK YOU</b><br />for your feedback.</h1>
            </div>
            <div class="col-md-8 offset-md-2" id="divreview">
                <p>
                    <b>How would you rate Skill channel: @ViewBag.IRFId ?</b>
                    <br />(Rating 1 represents “Highly Unsatisfied” and Rating 5 represents “Highly Satisfied”)
                </p>
                <input type="hidden" id="txtfeedbackreting" />
                <div class="star-rating">
                    <input type="radio" id="Q1_5" name="rating1" value="5" onclick="ChangeRating(5)" />
                    <label for="Q1_5" class="star">&#9733;</label>
                    <input type="radio" id="Q1_4" name="rating1" value="4" onclick="ChangeRating(4)" />
                    <label for="Q1_4" class="star">&#9733;</label>
                    <input type="radio" id="Q1_3" name="rating1" value="3" onclick="ChangeRating(3)" />
                    <label for="Q1_3" class="star">&#9733;</label>
                    <input type="radio" id="Q1_2" name="rating1" value="2" onclick="ChangeRating(2)" />
                    <label for="Q1_2" class="star">&#9733;</label>
                    <input type="radio" id="Q1_1" name="rating1" value="1" onclick="ChangeRating(1)" />
                    <label for="Q1_1" class="star">&#9733;</label>
                </div>
                <textarea type="text" id="txtfeedbackComment" rows="3" placeholder="Please Enter Additional Comments" class="form-control"></textarea>
                <br />
                <input type="hidden" id="hidEmailid" value="@ViewBag.Emailid" />
                <input type="hidden" id="hidIRFId" value="@ViewBag.IRFId" />
                <input type="button" value="Submit" class="callsubmit" onclick="SubmitTest()" />
            </div>
        </div>
    </div>
</body>
<script src="~/Newassets/js/core/jquery.min.js?v=7"></script>
<script>
    function SubmitTest() {
        if ($("#txtfeedbackComment").val().trim() != '') {
            $.ajax({
                type: "POST",
                url: "/Survey/SaveClientIRFReview",
                data: { rating: $("#txtfeedbackreting").val(), comments: $("#txtfeedbackComment").val(), Emailid: $("#hidEmailid").val(), IRFId: $("#hidIRFId").val() },
                success: function (data) {
                    if (data == "success") {
                        document.getElementById("divCompletereview").style.display = "block";
                        document.getElementById("divreview").style.display = "none";
                    } else {
                        alert("Please provide feedback again.");
                    }
                }
            });
        } else {
            alert("Feedback Comment is required.");
        }
    }
    function ChangeRating(id) {
        $("#txtfeedbackreting").val(id);
    }
</script>
</html>

