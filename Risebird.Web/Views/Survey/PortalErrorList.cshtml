@model IEnumerable<Risebird.Entities.ViewModel.LogData>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Portal Errors";
    ViewBag.PageHeader = "Portal Errors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css" />

<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad">
                <div class="card-header bg-w clearfix">
                    <img style="visibility:hidden" src="" data-position="right" />
                    <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                    <div class="pull-left">
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title"> Portal Errors</h4></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div id="candidatefeedback_table">
                                <div class="dataloading">
                                    <div style="overflow-x:scroll;overflow-y:hidden" class="scrollbar survey" id="style-2">
                                        <table id="interviewer" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Date Time</th>
                                                    <th>Class Name</th>
                                                    <th>Method Name</th>
                                                    <th>Line Number</th>
                                                    <th>Log Message</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Date Time</th>
                                                    <th>Class Name</th>
                                                    <th>Method Name</th>
                                                    <th>Line Number</th>
                                                    <th>Log Message</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @{
                                                    var i = 0;
                                                }
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.Timestamp</td>
                                                        <td class="interview-com">
                                                            <div id="section">
                                                                @if (item.ClassName != null && item.ClassName != "")
                                                                {
                                                                    @if (item.ClassName.Length > 60)
                                                                    {
                                                                        <div class="article" style="white-space:initial;width:150px;">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.ClassName.Substring(0, 60)
                                                                            </p>
                                                                            <p class="moretext_@i moretext">
                                                                                @item.ClassName.Substring(60, @item.ClassName.Length - 60)
                                                                            </p>
                                                                        </div>
                                                                        <a onclick="moreless('@i')" class="moreless-button" value="Readmore" id="read_@i" href="#">Read more</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article" style="white-space:initial;width:150px;">
                                                                            <p>
                                                                                @item.ClassName
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div></div>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="interview-com">
                                                            <div id="section">
                                                                @if (item.MethodName != null && item.MethodName != "")
                                                                {
                                                                    @if (item.MethodName.Length > 60)
                                                                    {
                                                                        <div class="article" style="white-space:initial;width:150px;">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.MethodName.Substring(0, 60)
                                                                            </p>
                                                                            <p class="moretext_1_@i moretext">
                                                                                @item.MethodName.Substring(60, @item.MethodName.Length - 60)
                                                                            </p>
                                                                        </div>
                                                                        <a onclick="moreless('1_@i')" class="moreless-button" value="Readmore" id="read_1_@i" href="#">Read more</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article" style="white-space:initial;width:150px;">
                                                                            <p>
                                                                                @item.MethodName
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div></div>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td>@item.LineNumber</td>
                                                        <td class="interview-com">
                                                            <div id="section">
                                                                @if (item.LogMessage != null && item.LogMessage != "")
                                                                {
                                                                    @if (item.LogMessage.Length > 60)
                                                                    {
                                                                        <div class="article" style="white-space:initial;width:150px;">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.LogMessage.Substring(0, 60)
                                                                            </p>
                                                                            <p class="moretext_2_@i moretext">
                                                                                @item.LogMessage.Substring(60, @item.LogMessage.Length - 60)
                                                                            </p>
                                                                        </div>
                                                                        <a onclick="moreless('2_@i')" class="moreless-button" value="Readmore" id="read_2_@i" href="#">Read more</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article" style="white-space:initial;width:150px;">
                                                                            <p>
                                                                                @item.LogMessage
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div></div>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    i++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->



        </div>

    </div>
</div>

<script>
    function searchResult() {
        $('#interviewer').DataTable();
    }
    function RefreshSearch() {
        $('#interviewer').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();

    });

    function applyDataTable() {
        $('#interviewer').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });

    $(document).ready(function () {
        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
</script>

<script>
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
</script>
