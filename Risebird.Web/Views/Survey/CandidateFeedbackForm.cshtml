<script>
    function ChangeCheckBox(groupName) {
        var result = $('input[name="' + groupName + '"]:checked');
        var resultString = '';
        if (result.length > 0) {
            result.each(function () {
                if (resultString == '') {
                    resultString += $(this).val();
                } else {
                    resultString += "," + $(this).val();
                }
            });
            $('#' + groupName).val(resultString);
        }
        else {
            $('#' + groupName).val("");
        }
    }
</script>


<script>

    $(document).on('show', '.accordion', function (e) {
        $(e.target).prev('.accordion-heading').addClass('accordion-opened');
    });

    $(document).on('hide', '.accordion', function (e) {
        $(this).find('.accordion-heading').not($(e.target)).removeClass('accordion-opened');
    });
</script>

<script>
    $(".accordion-heading a").on("click", function () {
        $($(this).data("target")).addClass("page--active");
    });

    $(".page__close").on("click", function () {
        $(".page").removeClass("page--active");

    });

</script>
<script>
    function AddCandidateFeedbackForm()
    { 
        var Rating = $("#Rating").val();
        var CandidateInteractionQuality = $("#CandidateInteractionQuality").val();
        var LimitedHandoncoding = $("#LimitedHandoncoding").val();
        var WeakInfrastructure = $("#WeakInfrastructure").val();
        var UnethicalPractices = $("#UnethicalPractices").val();
        var PoorCommunicationSkills = $("#PoorCommunicationSkills").val();
        var TimeManagement = $("#TimeManagement").val();
        var Interviewid = $("#Interviewid").val();
        $.ajax({
            type: "POST",
            data: { Rating: Rating, 
                TimeManagement: TimeManagement,
                CandidateInteractionQuality: CandidateInteractionQuality,
                LimitedHandoncoding: LimitedHandoncoding,
                WeakInfrastructure:WeakInfrastructure,
                UnethicalPractices:UnethicalPractices,
                PoorCommunicationSkills: PoorCommunicationSkills,
                Interviewid:Interviewid
            },
            url: "/Survey/CandidateFeedbackForm",
            success: function () {

                $("#thankMessage").show();
                $("#candidateFeedbackHide").hide();
                $("#containerHide").hide();
            }
        });
    }

    function ChangeQuestion1(id)
    {

   var  Rating= $("#Rating").val(id);
        if (Rating.val() == 5) {
           document.getElementById("containerHide").style.display = "none";
            AddCandidateFeedbackForm();
            $("#candidateFeedbackHide").hide();
           
        }
        else 
        {
            var Rating = $("#Rating").val();
            var Interviewid = $("#Interviewid").val();
            $.ajax({
                type: "POST",
                data: {
                    Rating: Rating,
                    Interviewid: Interviewid
                },
                url: "/Survey/CandidateFeedbackForm",
                success: function () {

                }
            });
            $("#candidateFeedbackHide").show();
           $("#redoWrap").show();
        }
        $('#ratingInterviewer input:radio').attr('disabled','disabled');
       
    }
    
    function RedoInterview() {
        var Interviewid = $("#Interviewid").val();
        $.ajax({
            type: "POST",
            data: {
                Interviewid: Interviewid
            },
            url: "/Dashboard/AddRedoInterviews",
            success: function () {
            }
        });
    }
</script>





