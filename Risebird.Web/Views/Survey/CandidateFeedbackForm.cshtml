                                                                <input type="checkbox" id="checkboxFortyEight" name="PoorCommunicationSkills" onclick="ChangeCheckBox('PoorCommunicationSkills')" value="Unable to articulate questions" /> <label for="checkboxFortyEight">Unable to articulate questions</label>
                                                            }
                                                        </li>
                                                        <li>
                                                            @if (Model.PoorCommunicationSkills.Split(",").Contains("Confusing candidates"))
                                                            {
                                                                <input type="checkbox" id="checkboxFortyNine" name="PoorCommunicationSkills" checked onclick="ChangeCheckBox('PoorCommunicationSkills')" value="Confusing candidates" /> <label for="checkboxFortyNine">Confusing candidates</label>
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" id="checkboxFortyNine" name="PoorCommunicationSkills" onclick="ChangeCheckBox('PoorCommunicationSkills')" value="Confusing candidates" />

                                                                <label for="checkboxFortyNine">Confusing candidates</label>
                                                            }
                                                        </li>
