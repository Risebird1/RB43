@model Risebird.Entities.Data.PlivoModels.PlivoAssistantSetupVM
@{
    ViewData["Title"] = "Plivo AI Assistant Setup";

    var voices = new[]
    {
        ("alloy",   "Alloy — neutral, clear"),
        ("echo",    "Echo — warm, male"),
        ("fable",   "Fable — expressive, UK accent"),
        ("onyx",    "Onyx — deep, authoritative male"),
        ("nova",    "Nova — friendly, female ✦ recommended"),
        ("shimmer", "Shimmer — soft, female")
    };

    var allConfigs = ViewBag.AllConfigs as List<Risebird.Entities.Data.PlivoModels.PlivoAssistantConfig>
                    ?? new List<Risebird.Entities.Data.PlivoModels.PlivoAssistantConfig>();
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col">
            <h4 class="fw-bold mb-0">
                <i class="fas fa-robot text-primary me-2"></i>Plivo AI Assistant Setup
            </h4>
            <p class="text-muted mt-1 mb-0">
                This is the equivalent of Vapi's "Create Assistant" — configure the AI's
                instructions, voice, and behaviour here. Every outbound Plivo call will
                use the <strong>active</strong> assistant config.
            </p>
        </div>
        <div class="col-auto d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>Call Logs
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ── Left: edit form ─────────────────────────────────────────────── -->
        <div class="col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-sliders-h me-2"></i>
                    @(Model.Id.HasValue ? $"Edit: {Model.AssistantName}" : "Create New Assistant")
                </div>
                <div class="card-body p-4">
                    <form asp-action="SetupAssistant" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="AssistantName" class="form-label fw-semibold">
                                Assistant Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="AssistantName" class="form-control"
                                   placeholder="e.g. InterviewBookingAssistant" required />
                            <div class="form-text">Unique identifier — used to look up this config.</div>
                        </div>

                        <!-- Instructions / System Prompt -->
                        <div class="mb-3">
                            <label asp-for="Instructions" class="form-label fw-semibold">
                                Instructions (System Prompt) <span class="text-danger">*</span>
                            </label>
                            <div class="mb-2">
                                <small class="text-muted">
                                    Supported dynamic tokens (resolved at call-time):
                                    <code>{{candidateName}}</code>
                                    <code>{{clientName}}</code>
                                    <code>{{jobTitle}}</code>
                                    <code>{{irfId}}</code>
                                    <code>{{candidateEmail}}</code>
                                    <code>{{todayDate}}</code>
                                </small>
                            </div>
                            <textarea asp-for="Instructions" class="form-control font-monospace"
                                      rows="22" required
                                      style="font-size:0.8rem; resize:vertical;"></textarea>
                        </div>

                        <!-- Voice + Model row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Voice" class="form-label fw-semibold">Voice</label>
                                <select asp-for="Voice" class="form-select">
                                    @foreach (var (val, label) in voices)
                                    {
                                        <option value="@val" selected="@(Model.Voice == val)">@label</option>
                                    }
                                </select>
                                <div class="form-text">
                                    <a href="https://platform.openai.com/docs/guides/voice" target="_blank">
                                        Preview voices →
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Model" class="form-label fw-semibold">OpenAI Model</label>
                                <select asp-for="Model" class="form-select">
                                    <option value="gpt-4o-realtime-preview">gpt-4o-realtime-preview (recommended)</option>
                                    <option value="gpt-4o-mini-realtime-preview">gpt-4o-mini-realtime-preview (cheaper)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Temperature" class="form-label fw-semibold">
                                    Temperature <span class="text-muted fw-normal">(0 – 1)</span>
                                </label>
                                <input asp-for="Temperature" type="number" step="0.1" min="0" max="1"
                                       class="form-control" />
                                <div class="form-text">Lower = more predictable. 0.7–0.8 is typical.</div>
                            </div>
                        </div>

                        <!-- VAD + token row -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="MaxResponseTokens" class="form-label fw-semibold">
                                    Max Response Tokens
                                </label>
                                <input asp-for="MaxResponseTokens" type="number" min="50" max="4096"
                                       class="form-control" />
                                <div class="form-text">Keep low (300–600) for natural conversational turns.</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VadThreshold" class="form-label fw-semibold">
                                    VAD Threshold <span class="text-muted fw-normal">(0 – 1)</span>
                                </label>
                                <input asp-for="VadThreshold" type="number" step="0.05" min="0" max="1"
                                       class="form-control" />
                                <div class="form-text">Lower = picks up quieter speech.</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SilenceDurationMs" class="form-label fw-semibold">
                                    Silence Before Response (ms)
                                </label>
                                <input asp-for="SilenceDurationMs" type="number" min="200" max="2000"
                                       class="form-control" />
                                <div class="form-text">300–700 ms works best for phone calls.</div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>
                                @(Model.Id.HasValue ? "Save Changes" : "Create Assistant")
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ── Right: all configs + how-it-works ──────────────────────────── -->
        <div class="col-xl-4">

            <!-- All configs list -->
            @if (allConfigs.Any())
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header">
                        <i class="fas fa-list me-2"></i>Saved Assistants
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var cfg in allConfigs)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between py-2 px-3">
                                <div>
                                    <div class="fw-semibold">
                                        @cfg.AssistantName
                                        @if (cfg.IsActive)
                                        {
                                            <span class="badge bg-success ms-1">Active</span>
                                        }
                                    </div>
                                    <small class="text-muted">@cfg.Voice · @cfg.Model</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <a asp-action="SetupAssistant" asp-route-id="@cfg.Id"
                                       class="btn btn-outline-primary btn-sm">Edit</a>
                                    @if (!cfg.IsActive)
                                    {
                                        <form asp-action="SetActiveAssistant" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cfg.Id" />
                                            <button type="submit" class="btn btn-outline-success btn-sm">
                                                Set Active
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- How it works -->
            <div class="card shadow-sm border-0 border-start border-4 border-primary">
                <div class="card-body p-3">
                    <h6 class="fw-bold mb-3">
                        <i class="fas fa-info-circle text-primary me-1"></i>
                        How this replaces Vapi's "assistant"
                    </h6>
                    <p class="small text-muted mb-2">
                        On <strong>Vapi</strong> you POSTed a JSON payload to
                        <code>api.vapi.ai/assistant</code> and got back an
                        <code>assistantId</code>. Vapi then owned the entire AI pipeline.
                    </p>
                    <p class="small text-muted mb-2">
                        On <strong>Plivo</strong>, Plivo only handles telephony.
                        When a call is answered, our server opens a WebSocket to
                        <strong>OpenAI Realtime API</strong> and sends a
                        <code>session.update</code> event — that event carries
                        <em>exactly</em> what you configure here:
                    </p>
                    <ul class="small text-muted mb-2 ps-3">
                        <li><strong>Instructions</strong> → your system prompt</li>
                        <li><strong>Voice</strong> → the OpenAI TTS voice</li>
                        <li><strong>VAD settings</strong> → controls when the AI starts/stops listening</li>
                        <li><strong>Temperature / tokens</strong> → controls AI creativity &amp; verbosity</li>
                    </ul>
                    <p class="small text-muted mb-0">
                        Changes saved here take effect <strong>immediately</strong> for
                        all new calls — no deployment needed.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>
