@model IEnumerable<Risebird.Entities.ViewModel.Wallet>

@{
    ViewData["Title"] = "Client Wallet: Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>

                </div>
                <a class="navbar-brand card-title">RisebirdPay</a>

            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">

                </div>

                <div class="pull-right">
                    <div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space icon-svg" onclick="OpenAddClientmodel()"><font style=" font-family: Roboto, sans-serif; font-size:12px;"><svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4V7zm-1-5C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" /></svg> Add Client</font></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg razorpay_con ">

                    @*<div class="mdc-card-wrapper__text-section razorpay_btn">
                            <div style="padding:0px">
                                <button class="form-control" id="btnall" onclick="FetchTransaction('All')">
                                    <i class="fa fa-money-bill"></i>

                                    All Transaction
                                </button>
                            </div>
                            <div style="padding:0px">
                                <button class="form-control" id="btncredit" onclick="FetchTransaction('CREDIT')">
                                    <i class="fas fa-credit-card"></i>CREDIT
                                </button>
                            </div>
                            <div style="padding:0px"><button class="form-control" id="btndebit" onclick="FetchTransaction('DEBIT')"><i class="fa fa-credit-card "></i> Debit</button></div>

                        </div>*@
                    <div id="divtransaction" class="razorpay_details" style="left:0%;width:100%">
                        <!--Bind transaction details-->
                        <div class="table-responsive">
                            <table width="100%">
                                <thead>
                                    <tr>
                                        <th>Client Name</th>
                                        <th>Risebird Pay Balance</th>
                                        <th>Per Success Rate </th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Name<input type="hidden" id="clientname_@item.id" value="@item.Name" /></td>
                                            <td>@item.Balance</td>
                                            <td>@item.PerSuccessRate</td>
                                            <td>
                                                <button class="mdc-fab app-fab--absolute" aria-label="Add Points">
                                                    <span onclick="OpenAddpointmodel(@item.id)" title="Add Points" class="fa fa-plus-circle"></span>
                                                </button>
                                                <button class="mdc-fab app-fab--absolute" aria-label="Deduct Points">
                                                    <span onclick="OpenDeductpointmodel(@item.id)" title="Deduct Points" class="fa fa-minus-circle"></span>
                                                </button>
                                                <button class="mdc-fab app-fab--absolute" aria-label="View Details">
                                                    <span onclick="location.href = '@Url.Action("ClientDetails", "RisebirdPay", new { id = item.id})'" title="View Details" class="fa fa-fw fa-eye"></span>
                                                </button>
                                                <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                    <span onclick="OpenEditClientmodel(@item.id,@item.PerSuccessRate,@item.Balance)" title="Edit" class="fa fa-pencil"></span>
                                                    
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>

</div>

<div id="Addclientmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i style=" font-size: 23px;" class="fas fa-coins publicsharing-icon"></i>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Add Client</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseAddClientmodel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Client Name</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" id="txtclient" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Initial Balance</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="number" id="txtbalance" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Description</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" id="txtdescription" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Per Succssrate(Points)</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="number" id="txtpersuccess" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">GST</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" id="txtGST" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Office Address</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" id="txtaddress" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="AddClient()" class="mdc-button mdc-button--raised mdc-ripple-upgraded  card-title-space" value="Add Client">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="CloseAddClientmodel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="Addpointmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i style=" font-size: 23px;" class="fas fa-coins publicsharing-icon"></i>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Add Points</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseAddpointmodel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Points</label>
                        <input type="number" id="txtpoints" class="form-control" />
                        <input type="hidden" id="txtClientid" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Comments</label>
                        <input type="text" id="txtcomment" class="form-control" />
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="AddPoints()" class="mdc-button mdc-button--raised mdc-ripple-upgraded  card-title-space" value="Add Points">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="CloseAddpointmodel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="Deductpointmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i style=" font-size: 23px;" class="fas fa-coins publicsharing-icon"></i>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Deduct Points</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseDeductpointmodel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Points</label>
                        <input type="number" id="txtpointsdeduct" class="form-control" />
                        <input type="hidden" id="txtClientiddeduct" />
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Comments</label>
                        <input type="text" id="txtcommentdeduct" class="form-control" />
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="DeductPoints()" class="mdc-button mdc-button--raised mdc-ripple-upgraded  card-title-space" value="Deduct Points">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="CloseDeductpointmodel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="EditClientmodel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i style=" font-size: 23px;" class="fas fa-coins publicsharing-icon"></i>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Edit Client Details</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseEditClientmodel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Client Name</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" id="txtclientNameedit" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6 border-rv">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">Risebird Pay Balance</label>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" id="txtbalanceedit" class="form-control" readonly="readonly" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="video-url">
                        <label>Per SuccessRate</label>
                        <input type="number" id="txtperSuccessedit" class="form-control" />
                        <input type="hidden" id="txtClientidedit" />
                    </div>
                </div>

                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="UpdateClient()" class="mdc-button mdc-button--raised mdc-ripple-upgraded  card-title-space" value="Submit">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="CloseEditClientmodel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function OpenAddClientmodel() {
        var model = document.getElementById("Addclientmodel");
        model.style.display = 'block';

    }
    function CloseAddClientmodel() {
        var model = document.getElementById("Addclientmodel");
        model.style.display = 'none';
    }
    function AddClient() {

    }
    function OpenAddpointmodel(id) {
        var model = document.getElementById("Addpointmodel");
        model.style.display = 'block';
        $("#txtClientid").val(id);
    }
    function CloseAddpointmodel() {
        var model = document.getElementById("Addpointmodel");
        model.style.display = 'none';
    }
    function AddPoints() {
        var point = $("#txtpoints").val();
        if (point.trim() != "" && parseInt(point) > 0) {
            $.ajax({
                type: "POST",
                url: "/RisebirdPay/AddWalletPoints",
                data: { points: point, comment: $("#txtcomment").val(), ClientId: $("#txtClientid").val() },
                success: function (data) {
                    if (data == "Success") {
                        alert("Points added successfully.");
                        CloseAddpointmodel();
                        initialcall();
                    } else if (data == "failed") {
                        alert("Fail to add points");
                    }
                }
            });
        } else {
            alert("Please Enter valid value in point field.");
        }
    }

    function OpenEditClientmodel(id, PerSuccessRate, Balance) {
        var model = document.getElementById("EditClientmodel");
        model.style.display = 'block';
        $("#txtclientNameedit").val($("#clientname_" + id).val());
        $("#txtperSuccessedit").val(PerSuccessRate);
        $("#txtbalanceedit").val(Balance);
        $("#txtClientidedit").val(id);
    }
    function CloseEditClientmodel() {
        var model = document.getElementById("EditClientmodel");
        model.style.display = 'none';
    }
    function UpdateClient() {
        var point = $("#txtperSuccessedit").val();
        if (point.trim() != "" && parseInt(point) > 0) {
            $.ajax({
                type: "POST",
                url: "/RisebirdPay/EditClient",
                data: { PerSuccessRate: point, ClientId: $("#txtClientidedit").val() },
                success: function (data) {
                    if (data == "Success") {
                        alert("Client information updates successfully.");
                        CloseEditClientmodel();
                        initialcall();
                    } else if (data == "failed") {
                        alert("Fail to add points");
                    }
                }
            });
        } else {
            alert("Please Enter valid value in point field.");
        }
    }

    function OpenDeductpointmodel(id) {
        var model = document.getElementById("Deductpointmodel");
        model.style.display = 'block';
        $("#txtClientiddeduct").val(id);
    }
    function CloseDeductpointmodel() {
        var model = document.getElementById("Deductpointmodel");
        model.style.display = 'none';
    }
    function DeductPoints() {
        var point = $("#txtpointsdeduct").val();
        if (point.trim() != "" && parseInt(point) > 0) {
            $.ajax({
                type: "POST",
                url: "/RisebirdPay/DeductWalletPoints",
                data: { points: point, comment: $("#txtcommentdeduct").val(), ClientId: $("#txtClientiddeduct").val() },
                success: function (data) {
                    if (data == "Success") {
                        alert("Points deduct successfully.");
                        CloseDeductpointmodel();
                        initialcall();
                    } else if (data == "failed") {
                        alert("Fail to add points");
                    }
                }
            });
        } else {
            alert("Please Enter valid value in point field.");
        }
    }
    function initialcall() {
        var url = "RisebirdPay/Index";
        window.location.href = url;
    }
</script>

