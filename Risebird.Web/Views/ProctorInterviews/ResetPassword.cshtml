@model Risebird.Entities.ViewModel.VMResetPassword
@{
    ViewData["Title"] = "Reset Password";
    ViewBag.PageHeader = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">

    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">

        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/ProctorInterviews/ResetPassword" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.VmName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.VmName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                        </div>
                                    </div>


                                </div>
                                <div class="row">
                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.userName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.userName, new { @class = "form-control text-box single-line" })
                                            @Html.ValidationMessageFor(x => Model.userName)

                                        </div>
                                    </div>


                                </div>
                                <div class="row">

                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group reset-password" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.Password, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            <div>
                                                @Html.PasswordFor(m => m.Password, new { @class = "form-control text-box single-line password" })
                                                <span class="fa fa-eye field-icon" id="eyeicon" title="Password show/hide" style="font-size:18px;" onclick="eyeFunction();"></span>
                                            </div>
                                            @Html.ValidationMessageFor(x => Model.Password)

                                        </div>
                                    </div>

                                </div>
                                <div class="row">

                                    <div class="col-md-6 col-sm-6">
                                        <div class="form-group" style="margin-bottom:10px;">
                                            @Html.LabelFor(model => model.confirmPassword, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.PasswordFor(m => m.confirmPassword, new { @class = "form-control text-box single-line" })
                                            @Html.ValidationMessageFor(x => Model.confirmPassword)

                                        </div>
                                    </div>

                                </div>


                                @Html.HiddenFor(m => m.VmName)
                                @Html.HiddenFor(m => m.ResourceGroupName)
                                @Html.HiddenFor(m => m.VmId)

                                <div class="card-footer ">
                                    <div class="row">

                                        <div class="col-md-12 mc-button-area">

                                            @Html.ActionLink("Back", "Index", "ProctorInterviews", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Reset">Reset</button>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </form>



                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

    </div>

</div>
<script type="text/javascript">
    function eyeFunction() {
        var x = document.getElementById("Password");
        if (x.type === "password") {
            x.type = "text";
            document.getElementById("eyeicon").className = "fa fa-eye-slash field-icon";
        } else {
            x.type = "password";
            document.getElementById("eyeicon").className = "fa fa-eye field-icon";
        }
    }
</script>