                                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnSubmit" onclick="Submitform()" value="Submit">Save</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
</div>


<script>

    function searchResult() {
        $('#questionsTable').DataTable();
    }
    function RefreshSearch() {
        $('#questionsTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {

        var table = $('#questionsTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };


</script>
<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>

<script>
    (function ($) {
        $(window).on("load", function () {
            $(".scrollbox-curated").mCustomScrollbar();
        });
    })(jQuery);


    function Submitform() {
        var message = '';
        var noQuestion = false;
        var prioritydetails = false;
        var priorityblank = false;
        var priority = [];
        var totalcount = document.getElementById("questionsTable").rows.length - 1 ;

        if (totalcount != null && totalcount > 0) {
            for (var i = 0; i < totalcount; i++) {
                //if (document.getElementById("questionset_" + i + "__VideoFile").files.length > 0 || document.getElementById("questionset_" + i + "__VideoLink").value != '') {

                //}
                if (document.getElementById("QuestionList_" + i + "__Question").value == '') {
                    noQuestion = true;
                }
                if (document.getElementById("QuestionList_" + i + "__Priority").value != '') {
                    if (parseInt(document.getElementById("QuestionList_" + i + "__Priority").value) == 0) {
                        priorityblank = true;
                    } else {
                        priority.push(parseInt(document.getElementById("QuestionList_" + i + "__Priority").value));
                    }
                } else {
                    prioritydetails = true;
                }
            }
            var result = hasDuplicates(priority);
            if (noQuestion == true) {
                if (message == '') {
                    message = 'Please enter Question';
                } else {
                    message = message + ', Please enter Question';
                }
            }
            if (priorityblank == true) {
                if (message == '') {
                    message = 'Priority should not be 0';
                } else {
                    message = message + ', Priority should not be 0';
                }
            }
            if (prioritydetails == true) {
                if (message == '') {
                    message = 'Priority should not be blank';
                } else {
                    message = message + ', Priority should not be blank';
                }
            }
            if (result == true) {
                if (message == '') {
                    message = 'Priority should be unique';
                } else {
                    message = message + ', Priority should be unique';
                }
            }
            if (noQuestion == true || priorityblank == true || prioritydetails == true || result == true) {
                alert(message);
            } else {
                document.getElementById("Questionsform").submit();
            }
        }
        else {
            alert("No questions added!")
            return;
        }
        
    }
    function hasDuplicates(arr) {
        return arr.some(function (item) {
            return arr.indexOf(item) !== arr.lastIndexOf(item);
        });
    }
</script>

<script>

    function AddRow() {
        var table = document.getElementById("questionsTable");

        var $ttc = $("#questionsTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#questionsTable tr").length - 1;

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        //$tr.find("select").val("");
        //$tr.find("textarea[type=text]").val("");
        $tr.find("input[type=hidden]").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=number]").val("");

        //$tr.find("a").val("");

        // add cloned row as last row
        $("#questionsTable").find("tbody tr:last").after($tr);

        var $ttlast = $("#questionsTable").find("tbody tr:last");
        //$ttlast.find("textarea").val("");

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        //// Check document for changes
        //$.validator.unobtrusive.parse(document);

    }

    function DeleteRow(element, collectionName) {
        var tdOne = 'Question';
        var tdTwo = 'Detail';
        var tdThree = 'Priority';
        var tdFour = 'VideoLink';
        var tdFive = 'Skill';
        var tdSix = 'Level';
        var tdSeven = 'Time';

        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {

            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            //ClientCollection_1__ClientRoleId
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;

                    var elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                    var elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;

                    var elem4 = document.getElementById(collectionName + "_" + i + "__" + tdFour);
                    elem4.id = collectionName + "_" + (i - 1) + "__" + tdFour;
                    elem4.name = collectionName + "[" + (i - 1) + "]." + tdFour;

                    var elem5 = document.getElementById(collectionName + "_" + i + "__" + tdFive);
                    elem5.id = collectionName + "_" + (i - 1) + "__" + tdFive;
                    elem5.name = collectionName + "[" + (i - 1) + "]." + tdFive;

                    var elem6 = document.getElementById(collectionName + "_" + i + "__" + tdSix);
                    elem6.id = collectionName + "_" + (i - 1) + "__" + tdSix;
                    elem6.name = collectionName + "[" + (i - 1) + "]." + tdSix;

                    var elem7 = document.getElementById(collectionName + "_" + i + "__" + tdSeven);
                    elem7.id = collectionName + "_" + (i - 1) + "__" + tdSeven;
                    elem7.name = collectionName + "[" + (i - 1) + "]." + tdSeven;

                }

            }

        }


    }


</script>