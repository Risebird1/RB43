                                                <tr>
                                                    <th class="text-center" style="        font-size: 15px !important;
        width:200px;
">Question</th>
                                                    <th class="text-center" style="font-size:15px!important; width:200px;">Detail</th>
                                                    <th class="text-center" style="font-size:15px!important;">Priority</th>
                                                    <th class="text-center" style="font-size:15px!important;">VideoLink</th>
                                                    <th class="text-center" style="font-size:15px!important;">Skill</th>
                                                    <th class="text-center" style="font-size:15px!important;width:100px;">Level</th>
                                                    <th class="text-center" style="font-size:15px!important;">Time</th>
