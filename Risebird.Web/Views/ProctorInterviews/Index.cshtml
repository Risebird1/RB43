@if (Model.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@Model.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@Model.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/ProctorInterviews/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@Model.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        window.location.href = '/ProctorInterviews/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}
<script>
    function StartStopVM(vmId, name, rgName, action) {
        document.getElementById("actionButton_" + vmId).style.display = "none";
        if (action == 'start') {
            //starting
            document.getElementById("statusId_" + vmId).innerHTML = "Starting";
            document.getElementById("statusImage_" + vmId).src = "/img/Cards_Png/01_Green-White.png";
        }
        else if (action == 'deallocate') {
            //deallocating
            document.getElementById("statusId_" + vmId).innerHTML = "Deallocating";
            document.getElementById("rdpButton_" + vmId).style.display = "none";
            document.getElementById("statusImage_" + vmId).src = "/img/Cards_Png/01_Grey-White.png";

        }
        $.ajax({
            url: '/ProctorInterviews/StartStopVM',
            method: 'POST',
            data: { 'vmId': vmId, 'name': name, 'rgName': rgName, 'action': action },
            success: function (response) {
                //update status in the tile
                location.reload(true);


            }
        });
    }

</script>

<script>
    var closeMember = document.getElementById("nonExistingPopUp");
    // When the user clicks on <span> (x), close the modal
    closeMember.onclick = function () {
        var modal = document.getElementById("nonExistingModal");
        modal.style.display = "none";
    }
    function GetNonExistingVMs() {
        $.ajax({
            url: '/ProctorInterviews/GetNonExistingVMs',
            success: function (data) {
                var modal = document.getElementById("nonExistingModal");
                modal.style.display = "block";
                $('#nonExistingTableBody').html('');
                $('#nonExistingTableBody').html(data);


            }
        });
    }

</script>
<script>
    $(document).ready(function () {
        setTimeout("location.reload(true);", 45000);
    });
</script>


<script type="text/javascript">
    var editVmId;
    var editvmName;
    var spanedit = document.getElementById("editPopUp");
    // When the user clicks on <span> (x), close the modal
    spanedit.onclick = function () {
        var modal = document.getElementById("editModal");
        modal.style.display = "none";
    }

    var spanedit1 = document.getElementById("editPopUpclose");
    // When the user clicks on <span> (x), close the modal
    spanedit1.onclick = function () {
        var modal = document.getElementById("editModal");
        modal.style.display = "none";
    }


    function EditModal(id, customeName, password, vmName, userName) {
        // Get the modal
        editVmId = id;
        editvmName = vmName;
        var modal = document.getElementById("editModal");
        modal.style.display = "block";
        document.getElementById("idCustomName").value = customeName;
        document.getElementById("idPassword").value = password;
        document.getElementById("idUserName").value = userName;
        return;

    }

    function EditNamePassword() {
        var customName = document.getElementById("idCustomName").value;

        if (customName.length > 20) {
            document.getElementById("customName_Error").innerHTML = "Name should be less than or equal to 20 characters."
            return;
        }
        else {
            document.getElementById("customName_Error").innerHTML = "";
        }

        var userName = document.getElementById("idUserName").value;

        var password = document.getElementById("idPassword").value;

        if (customName.length == 0 && password.length == 0 && userName.length == 0) {
            document.getElementById("emptyFields_Error").innerHTML = "Kindly fill atleast one field to save.";
            return;
        }
        else {
            document.getElementById("emptyFields_Error").innerHTML = "";
        }
        $.ajax({
            type: "POST",
            url: "/ProctorInterviews/EditNamePassword",
            data: {
                'id': editVmId, 'customName': customName, 'password': password, 'vmName': editvmName, 'userName': userName
            },
            success: function (data) {
                location.reload(true);

            }
        });
    }

</script>
<script>
    function RemoveVM(vmId, vmName) {

        swal.fire({
            title: 'Are you sure you want to remove ' + vmName + '?',
            text: "The Virtual Machine will be removed!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, remove it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/ProctorInterviews/RemoveVM?vmId=' + vmId,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            swal.fire("Error removing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Removed!',
                    type: 'success',
                    html: '<p>The Virtual Machine(' + vmName + ') has been removed!</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/ProctorInterviews/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'The virtual machine ' + vmName + ' has not been removed!',
                    'error'
                )
            }
        })


    }

</script>


<script>

    function showhidepass(id) {
        var value = document.getElementById("password-field_" + id);
        if (value.getAttribute("type") == "text") {
            value.setAttribute("type", "password");
            $("#secret_" + id).show();
            $("#password-field_" + id).addClass('passshow');

            $("#toggle-password_" + id).removeClass("fa-eye-slash");
        }
        else {
            value.setAttribute("type", "text");
            $("#password-field_" + id).removeClass('passshow');
            $("#toggle-password_" + id).addClass("fa-eye-slash");
            $("#secret_" + id).hide();

        }

    }




</script>


