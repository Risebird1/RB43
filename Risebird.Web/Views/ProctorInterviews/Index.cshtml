@model Risebird.Entities.ViewModel.VirtualMachineVM
@{
    ViewData["Title"] = "Proctor Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/irf.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Proctor Interviews
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <!--  <div class="panel-header panel-header-sm"></div>-->



    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Proctor Interviews</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add existing VMs" onclick="javascript:GetNonExistingVMs();" data-original-title="Tooltip on top"><font style="font-family:arial;"> Add Existing VMs</font></span>
                        </button>






                    </div>
                </div>
            </div>
        </div>
    </div>






    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">
                    <div class="mdc-card-wrapper__text-section">


                        <!-- end content-->
                        <!--  end card  -->
                        <!-- end col-md-12 -->
                        <!-- Start Card -->

                        <div class="row">
                            @foreach (var item in Model.VMList)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                    <div class="card-content-holder border card-blue">
                                        <div class="card-header">
                                            <div class="row">
                                                <div class=" col-md-7 col-sm-7 first">
                                                    @if (item.CustomName != null)
                                                    {
                                                        <h6>@item.CustomName</h6>
                                                    }
                                                    else
                                                    {
                                                        <h6> @item.Name </h6>

                                                    }
                                                </div>
                                                <div class="col-md-5 col-sm-5 card-header-buttons action">
                                                    @if (Model.Profile == "Admin")
                                                    {
                                                        <button id="edit_@item.id" class="mdc-fab app-fab--absolute item1" aria-label="Start VM" onclick="javascript:EditModal('@item.id','@(item.CustomName !=null ?item.CustomName:"")', '@(item.Password !=null ?item.Password:"")','@item.Name');">
                                                            <i class="fa fa-edit"></i>
                                                        </button>
                                                    }

                                                </div>

                                            </div>
                                        </div>

                                        <!-- irf body-->
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="statusImg">
                                                    <img id="statusImage_@item.id" src="@Url.Content(@item.ImageUrl)" class="img-responsive">
                                                </div>
                                                <div class="statusInfo">
                                                    <div class="group inner list-group-item-text">

                                                        <div class="row">
                                                            <span>VM Name:</span>@item.Name
                                                        </div> <br /> <br />

                                                        <div class="row second"> <span>Public IP Address:</span>@item.PublicIP</div> <br /> <br />
                                                        <div class="row three">
                                                            <div style="padding: 11px 5px 5px 0px;"> <span>Password:</span></div>

                                                            <div class="pull-left">
                                                                <input id="password-field" type="password" class="form-control h-auto" name="password" value="@item.Password" style="background:none;">
                                                                <span toggle="#password-field" class="fa fa-fw fa-eye field-icon toggle-password" id="toggle-password"></span>
                                                            </div>

                                                            <!--- <div id="password-field" title="=" Password"> @item.Password </div>-->
                                                        </div> <br />
                                                    </div>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="card-footer action">
                                                        <div class="row">

                                                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6 " id="irf-card-footer">

                                                                @if (@item.StatusDesc.ToLower() == "running")
                                                                {
                                                                    <h6 id="statusId_@item.id" style="color:green;text-align:left"> @item.StatusDesc</h6>
                                                                }
                                                                else if (@item.StatusDesc.ToLower() == "deallocated")
                                                                {
                                                                    <h6 id="statusId_@item.id" style="color:black;text-align:left"> @item.StatusDesc</h6>
                                                                }
                                                                else
                                                                {
                                                                    <h6 id="statusId_@item.id" style="color:grey;text-align:left"> @item.StatusDesc</h6>
                                                                }
                                                            </div>

                                                            <div class="stats-bttm-btn  col-lg-6 col-md-6 col-sm-6 col-xs-6 ">

                                                                @if (item.StatusDesc.ToLower() == "running")
                                                                {
                                                                    <button id="actionButton_@item.id" class="mdc-fab app-fab--absolute item1 trash-btn" title="Stop VM" aria-label="Stop VM" onclick="javascript:StartStopVM('@item.id','@item.Name', '@item.ResourceGroupName', 'powerOff');">
                                                                        <i class="fa fa-stop"></i>
                                                                    </button>

                                                                    <button id="rdpButton_@item.id" class="mdc-fab app-fab--absolute" title="Download RDP" aria-label="Download RDP" onclick="location.href='@Url.Action("GetRDPFile", "ProctorInterviews", new { vmId = item.id})'">
                                                                        <i class="fa fa-desktop"></i>
                                                                    </button>

                                                                }
                                                                else if (item.StatusDesc.ToLower() == "deallocated" || item.StatusDesc.ToLower() == "stopped")
                                                                {

                                                                    <button id="actionButton_@item.id" class="mdc-fab app-fab--absolute item1 go-btn" title="Start VM" aria-label="Start VM" onclick="javascript:StartStopVM('@item.id','@item.Name', '@item.ResourceGroupName', 'start');">
                                                                        <i class="fa fa-play"></i>
                                                                    </button>
                                                                }
                                                                <button id="passwordButton_@item.id" class="mdc-fab app-fab--absolute" title="Reset Password" aria-label="Reset Password" onclick="location.href='@Url.Action("ResetPassword", "ProctorInterviews", new { name = item.Name, rgName = item.ResourceGroupName, vmId = item.id})'">
                                                                    <i class="fa fa-key"></i>
                                                                </button>
                                                                @if (Model.Profile == "Admin")
                                                                {
                                                                    @*<button id="shareButton_@item.id" class="mdc-fab app-fab--absolute" aria-label="Share VM" onclick="location.href='@Url.Action("VMUsers", "ProctorInterviews", new { vmId = item.id, vmName = item.Name})'">
                                                                            <i class="fa fa-share"></i>
                                                                        </button>*@
                                                                }

                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <!-- End Card-->

                                                            <div id="nonExistingModal" class="modal modal-bg">
                                                                <!-- Modal content -->
                                                                <div class="modal-dialog modal-lg" role="document">
                                                                    <div class="modal-content">


                                                                        <div class="filheader">
                                                                            <div class="filavatar">
                                                                                <span class="publicsharing-icon fas fa-question fa-2x"></span>
                                                                            </div>
                                                                            <h5 class="modal-title pull-left">Existing VMs</h5>
                                                                        </div>
                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                            <span aria-hidden="true" id="nonExistingPopUp" style="cursor:pointer;">&times;</span>
                                                                        </button>

                                                                        <div class="modal-body" id="nonExistingTableBody">





                                                                        </div>
                                                                    </div>

                                                                </div>
                                                            </div>


                                                            <div id="editModal" class="modal modal-bg">
                                                                <!-- Modal content -->
                                                                <div class="modal-dialog modal-lg" role="document">
                                                                    <div class="modal-content">

                                                                        <div class="filheader">
                                                                            <div class="filavatar">

                                                                                <svg class="broadcastfilter-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 18 18"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M2 12.88V16h3.12L14 7.12 10.88 4 2 12.88zm14.76-8.51c.33-.33.33-.85 0-1.18l-1.95-1.95c-.33-.33-.85-.33-1.18 0L12 2.88 15.12 6l1.64-1.63z" /></svg>


                                                                            </div>
                                                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Edit</h5>
                                                                        </div>
                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                            <span aria-hidden="true" id="editPopUp">&times;</span>
                                                                        </button>

                                                                        <div class="modal-body">


                                                                            <div class="col-md-12 col-sm-12">
                                                                                <div class="form-group">
                                                                                    <label class="control-label  desp-label" for="CustomName">Name </label>
                                                                                    <input class="form-control w-full" type="text" name="textField" id="idCustomName" />
                                                                                    <label class="text-danger" id="customName_Error" style="color:red"></label>

                                                                                </div>

                                                                                <div class="form-group">
                                                                                    <label class="control-label  desp-label" for="Password">Password </label>
                                                                                    <input class="form-control w-full" type="text" name="textField" id="idPassword" />
                                                                                    <label class="text-danger" id="emptyFields_Error" style="color:red"></label>

                                                                                </div>

                                                                            </div>


                                                                            <div class="col-md-12 col-sm-12 text-right">
                                                                                <button type="button" onclick="EditNamePassword()" class="mdc-button mdc-button--raised mdc-ripple-upgraded sendButton">Save</button>
                                                                                <button type="button" id="editPopUpclose" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" style=" background-color: #FF3636 !important; margin-left: 10px;">Close</button>

                                                                            </div>


                                                                        </div>



                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- end row -->


                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (Model.Message != null)
                                    {
                                        <script type="text/javascript">

        function my_code() {
            var msg = '@Model.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@Model.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/ProctorInterviews/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@Model.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        window.location.href = '/ProctorInterviews/Index';
                    }
                )
            }

        }

        window.onload = my_code();
                                        </script>

                                    }
                                    <script>
                                        function StartStopVM(vmId, name, rgName, action) {
                                            document.getElementById("actionButton_" + vmId).style.display = "none";
                                            if (action == 'start') {
                                                //starting
                                                document.getElementById("statusId_" + vmId).innerHTML = "Starting";
                                                document.getElementById("statusImage_" + vmId).src = "/img/Cards_Png/01_Green-White.png";
                                            }
                                            else if (action == 'powerOff') {
                                                //deallocating
                                                document.getElementById("statusId_" + vmId).innerHTML = "Deallocating";
                                                document.getElementById("rdpButton_" + vmId).style.display = "none";
                                                document.getElementById("statusImage_" + vmId).src = "/img/Cards_Png/01_Grey-White.png";

                                            }
                                            $.ajax({
                                                url: '/ProctorInterviews/StartStopVM',
                                                method: 'POST',
                                                data: { 'vmId': vmId, 'name': name, 'rgName': rgName, 'action': action },
                                                success: function (response) {
                                                    //update status in the tile
                                                    if (!response) {
                                                        document.getElementById("statusId_" + vmId).innerHTML = "Failed";

                                                    }


                                                }
                                            });
                                        }

                                    </script>

                                    <script>
                                        var closeMember = document.getElementById("nonExistingPopUp");
                                        // When the user clicks on <span> (x), close the modal
                                        closeMember.onclick = function () {
                                            var modal = document.getElementById("nonExistingModal");
                                            modal.style.display = "none";
                                        }
                                        function GetNonExistingVMs() {
                                            $.ajax({
                                                url: '/ProctorInterviews/GetNonExistingVMs',
                                                success: function (data) {
                                                    var modal = document.getElementById("nonExistingModal");
                                                    modal.style.display = "block";
                                                    $('#nonExistingTableBody').html('');
                                                    $('#nonExistingTableBody').html(data);


                                                }
                                            });
                                        }

                                    </script>
                                    <script>
                                        $(document).ready(function () {
                                            setTimeout("location.reload(true);", 45000);
                                        });
                                    </script>


                                    <script type="text/javascript">
                                        var editVmId;
                                        var editvmName;
                                        var spanedit = document.getElementById("editPopUp");
                                        // When the user clicks on <span> (x), close the modal
                                        spanedit.onclick = function () {
                                            var modal = document.getElementById("editModal");
                                            modal.style.display = "none";
                                        }

                                        var spanedit1 = document.getElementById("editPopUpclose");
                                        // When the user clicks on <span> (x), close the modal
                                        spanedit1.onclick = function () {
                                            var modal = document.getElementById("editModal");
                                            modal.style.display = "none";
                                        }


                                        function EditModal(id, customeName, password, vmName) {
                                            // Get the modal
                                            editVmId = id;
                                            editvmName = vmName;
                                            var modal = document.getElementById("editModal");
                                            modal.style.display = "block";
                                            document.getElementById("idCustomName").value = customeName;
                                            document.getElementById("idPassword").value = password;
                                            return;

                                        }

                                        function EditNamePassword() {
                                            var customName = document.getElementById("idCustomName").value;
                                            if (customName.length > 20) {
                                                document.getElementById("customName_Error").innerHTML = "Name should be less than or equal to 20 characters."
                                                return;
                                            }
                                            else {
                                                document.getElementById("customName_Error").innerHTML = "";
                                            }
                                            var password = document.getElementById("idPassword").value;

                                            if (customName.length == 0 && password.length == 0) {
                                                document.getElementById("emptyFields_Error").innerHTML = "Kindly fill atleast one field to save.";
                                                return;
                                            }
                                            else {
                                                document.getElementById("emptyFields_Error").innerHTML = "";
                                            }
                                            $.ajax({
                                                type: "POST",
                                                url: "/ProctorInterviews/EditNamePassword",
                                                data: {
                                                    'id': editVmId, 'customName': customName, 'password': password, 'vmName': editvmName
                                                },
                                                success: function (data) {
                                                    location.reload(true);

                                                }
                                            });
                                        }

                                    </script>



<script>
    $("#toggle-password").click(function () {

        $(this).toggleClass("fa-eye fa-eye-slash");
        var input = $($(this).attr("toggle"));
        if (input.attr("type") == "password") {
            input.attr("type", "text");
        } else {
            input.attr("type", "password");
        }
    });
</script>