@model List<Risebird.Entities.Data.VapiCallLog>
@{
    ViewData["Title"] = "Vapi Interview Calls";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Voice AI Interview Booking Calls</h4>
                    <p class="card-category">Manage automated interview scheduling calls via Vapi.ai</p>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <button class="btn btn-primary" onclick="showInitiateCallModal()">
                            <i class="fa fa-phone"></i> Initiate New Call
                        </button>
                        <button class="btn btn-info" onclick="setupAssistant()">
                            <i class="fa fa-cog"></i> Setup Assistant
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped" id="callsTable">
                            <thead>
                                <tr>
                                    <th>Call ID</th>
                                    <th>Candidate</th>
                                    <th>Phone</th>
                                    <th>Status</th>
                                    <th>Started</th>
                                    <th>Duration</th>
                                    <th>Booked</th>
                                    <th>Interview Time</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Count > 0)
                                {
                                    foreach (var call in Model)
                                    {
                                        <tr>
                                            <td>
                                                <small>@call.VapiCallId?.Substring(0, Math.Min(8, call.VapiCallId.Length ?? 0))</small>
                                            </td>
                                            <td>
                                                <strong>@call.CandidateName</strong><br />
                                                <small>@call.CandidateEmail</small>
                                            </td>
                                            <td>@call.CandidatePhone</td>
                                            <td>
                                                <span class="badge badge-@(GetStatusBadgeClass(call.CallStatus))">
                                                    @call.CallStatus
                                                </span>
                                            </td>
                                            <td>
                                                @if (call.CallStartedAt.HasValue)
                                                {
                                                    @call.CallStartedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")
                                                }
                                            </td>
                                            <td>
                                                @if (call.DurationSeconds.HasValue)
                                                {
                                                    @TimeSpan.FromSeconds(call.DurationSeconds.Value).ToString(@"mm\:ss")
                                                }
                                            </td>
                                            <td>
                                                @if (call.InterviewBooked == true)
                                                {
                                                    <span class="badge badge-success">Yes</span>
                                                }
                                                else if (call.InterviewBooked == false)
                                                {
                                                    <span class="badge badge-danger">No</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                @if (call.BookedInterviewDateTime.HasValue)
                                                {
                                                    @call.BookedInterviewDateTime.Value.ToString("MMM dd, yyyy HH:mm")
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-info" onclick="viewCallDetails('@call.VapiCallId')">
                                                    <i class="fa fa-eye"></i> View
                                                </button>
                                                @if (!string.IsNullOrEmpty(call.RecordingUrl))
                                                {
                                                    <a href="@call.RecordingUrl" target="_blank" class="btn btn-sm btn-secondary">
                                                        <i class="fa fa-play"></i> Recording
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center">No calls found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Initiate Call Modal -->
<div class="modal fade" id="initiateCallModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Initiate Interview Booking Call</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="callForm">
                    <div class="form-group">
                        <label>Interview ID</label>
                        <input type="number" class="form-control" id="interviewId" required />
                    </div>
                    <div class="form-group">
                        <label>Candidate ID</label>
                        <input type="number" class="form-control" id="candidateId" required />
                    </div>
                    <div class="form-group">
                        <label>Candidate Name</label>
                        <input type="text" class="form-control" id="candidateName" required />
                    </div>
                    <div class="form-group">
                        <label>Candidate Email</label>
                        <input type="email" class="form-control" id="candidateEmail" required />
                    </div>
                    <div class="form-group">
                        <label>Candidate Phone (with country code, e.g., +919876543210)</label>
                        <input type="tel" class="form-control" id="candidatePhone" placeholder="+919876543210" required />
                    </div>
                    <div class="form-group">
                        <label>Job Title</label>
                        <input type="text" class="form-control" id="jobTitle" required />
                    </div>
                    <div class="form-group">
                        <label>Preferred Date/Time (optional)</label>
                        <input type="datetime-local" class="form-control" id="preferredDateTime" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="initiateCall()">
                    <i class="fa fa-phone"></i> Start Call
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Call Details Modal -->
<div class="modal fade" id="callDetailsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Call Details</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="callDetailsContent">
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showInitiateCallModal() {
            $('#initiateCallModal').modal('show');
        }

        function initiateCall() {
            const data = {
                interviewId: parseInt($('#interviewId').val()),
                candidateId: parseInt($('#candidateId').val()),
                candidateName: $('#candidateName').val(),
                candidateEmail: $('#candidateEmail').val(),
                candidatePhone: $('#candidatePhone').val(),
                jobTitle: $('#jobTitle').val(),
                preferredDateTime: $('#preferredDateTime').val() || null
            };

            $.ajax({
                url: '/VapiInterviewCall/InitiateInterviewCall',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.success) {
                        alert('Call initiated successfully! Call ID: ' + response.callId);
                        $('#initiateCallModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Failed to initiate call: ' + response.message);
                    }
                },
                error: function (xhr) {
                    alert('Error initiating call: ' + xhr.responseText);
                }
            });
        }

        function viewCallDetails(callId) {
            $('#callDetailsModal').modal('show');

            $.ajax({
                url: '/VapiInterviewCall/GetCallStatus',
                type: 'GET',
                data: { callId: callId },
                success: function (response) {
                    if (response.success) {
                        let html = '<div class="call-details">';
                        html += '<h6>Call Information</h6>';
                        html += '<p><strong>Status:</strong> ' + (response.localData?.callStatus || 'N/A') + '</p>';
                        html += '<p><strong>Duration:</strong> ' + (response.localData?.durationSeconds ? formatDuration(response.localData.durationSeconds) : 'N/A') + '</p>';
                        html += '<p><strong>Ended Reason:</strong> ' + (response.localData?.endedReason || 'N/A') + '</p>';
                        
                        if (response.localData?.transcript) {
                            html += '<h6 class="mt-3">Transcript</h6>';
                            html += '<div class="transcript-box" style="max-height: 300px; overflow-y: auto; padding: 10px; background: #f5f5f5; border-radius: 4px;">';
                            html += '<pre>' + response.localData.transcript + '</pre>';
                            html += '</div>';
                        }

                        if (response.localData?.summary) {
                            html += '<h6 class="mt-3">Summary</h6>';
                            html += '<p>' + response.localData.summary + '</p>';
                        }

                        html += '</div>';
                        $('#callDetailsContent').html(html);
                    } else {
                        $('#callDetailsContent').html('<p class="text-danger">Failed to load call details</p>');
                    }
                },
                error: function () {
                    $('#callDetailsContent').html('<p class="text-danger">Error loading call details</p>');
                }
            });
        }

        function setupAssistant() {
            if (!confirm('This will create a new Vapi assistant. Continue?')) return;

            $.ajax({
                url: '/VapiInterviewCall/SetupAssistant',
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        alert('Assistant created! ID: ' + response.assistantId + '\n\n' + response.message);
                    } else {
                        alert('Failed to create assistant: ' + response.message);
                    }
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.responseText);
                }
            });
        }

        function formatDuration(seconds) {
            const minutes = Math.floor(seconds / 60);
            const secs = seconds % 60;
            return minutes + ':' + (secs < 10 ? '0' : '') + secs;
        }
    </script>
}

@functions {
    string GetStatusBadgeClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "secondary";
        
        return status.ToLower() switch
        {
            "in-progress" => "info",
            "ended" => "success",
            "queued" => "warning",
            "ringing" => "info",
            "no-answer" => "danger",
            "busy" => "warning",
            "failed" => "danger",
            _ => "secondary"
        };
    }
}
