<script>


    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("PageVideoLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("VideoFile").value = '';

        }

    }

    function AddRow() {

        var $ttc = $("#QuestionsTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#QuestionsTable tr").length - 1;

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })

        var rowCount = $('#QuestionsTable tr').length;

        var finalIndex = rowCount - 1;

        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#QuestionsTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        @*var options = '@Model.QuestionsListData';
        optionsData = JSON.parse(options.replace(/&quot;/g, '"').replace(/&gt;/g, '>').replace(/&lt;/g, '<'));
        $("#QuestionsCollection_" + finalIndex + "__Comment" + " option").remove();

        $(optionsData).each(function () {
            var option = $("<option />");

            //Set Text part.
            option.html(this.Item1);

            //Set Value part.
            option.val(this.Item1);

            //Add the Option element to DropDownList.

            $("#QuestionsCollection_" + finalIndex + "__Comment").append(option);
        });
        $("#QuestionsCollection_" + finalIndex + "__SkillName").val(optionsData[0].Item2);*@
        //$("#QuestionsCollection_" + finalIndex + "__Comment").on("change", QuestionChanged("#QuestionsCollection_" + finalIndex + "__Comment", optionsData[0].Item1));
        // Check document for changes
        //$.validator.unobtrusive.parse(document);

    }

    function DeleteRow(element, collectionName, tdOne, tdTwo, tdThree, tdFour) {

        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {
            document.getElementById("btnUpload").disabled = false;

            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            //ClientCollection_1__ClientRoleId
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {
                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    //name="ClientCollection[3].ClientUserId"
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;
                    var elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                    var elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;

                    var elem4 = document.getElementById(collectionName + "_" + i + "__" + tdFour);
                    elem4.id = collectionName + "_" + (i - 1) + "__" + tdFour;
                    elem4.name = collectionName + "[" + (i - 1) + "]." + tdFour;



                }

            }

        }




    }


    function InterviewerChanged(val, id) {

        var index = id.charAt(22);
        var skillElementid = 'InterviewerCollection_' + index + '__PrimarySkill';
        $.ajax({
            type: "GET",
            url: "/IRF/GetInterviewerSkills",
            data: { 'id': val },
            success: function (data) {
                $("#" + skillElementid).val(data);
            }
        });


    }

    function MeetingStatusChanged(value) {
        if (value != null && value != '') {
            document.getElementById('InterviewerComment').disabled = false;
            document.getElementById("interviewerComment_Error").innerHTML = "";

        }
        else {

            document.getElementById('InterviewerComment').value = '';
            document.getElementById('InterviewerComment').disabled = true;
            document.getElementById("interviewerComment_Error").innerHTML = "Select an appropriate value for Meeting Status above to add comments here.";

        }
        if (value != 2) {
            document.getElementById("meetingStatus_Error").innerHTML = "";
        }
        if (value != 4) {
            document.getElementById("InterviewStatus").value = '';
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById("InterviewStatus").disabled = false;
        }
    }

    function CheckConditions() {

        return (CheckInterviewStatus() && CheckMeetingStatus() && CheckInterviewerComments());
    }

    function CheckInterviewerComments() {
        var interviewStatusElem = document.getElementById("InterviewStatus");
        if (interviewStatusElem.value == 2|| interviewStatusElem.value == 4) {
            var comments = document.getElementById("InterviewerComment").value;
            if (comments.length >= 250) {
                document.getElementById("interviewerComment_Error").innerHTML = "";
                return true;
            }
            else {
                //interviewerComment_Error
                document.getElementById("InterviewerComment").focus();
                document.getElementById("interviewerComment_Error").innerHTML="Kindly enter a minimum of 250 characters.";
                return false;
            }
        }
        else
            return true;
    }

    function CheckMeetingStatus() {
        var meetingStatusElem = document.getElementById("MeetingStatus");
        if (meetingStatusElem.value == 2 || (meetingStatusElem.value == null || meetingStatusElem.value == '')) {
            document.getElementById("meetingStatus_Error").innerHTML = "Kindly change the Meeting Status to an appropriate value.";
            meetingStatusElem.focus();
            return false;
        }
        else {
            document.getElementById("meetingStatus_Error").innerHTML = "";
            return true;

        }

    }

    function CheckInterviewStatus() {
        var meetingStatusElem = document.getElementById("MeetingStatus");
        if (meetingStatusElem.value == 4) {
            var interviewStatusElem = document.getElementById("InterviewStatus");
            if (interviewStatusElem.value == null || interviewStatusElem.value == '') {
                document.getElementById("interviewStatus_Error").innerHTML = "Kindly change the Interview Status to an appropriate value.";
                interviewStatusElem.focus();
                return false;
            }
            else {
                document.getElementById("interviewStatus_Error").innerHTML = '';
            }
        }
        return true;
    }
