<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

<script>
    var closeMember = document.getElementById("membersPopUp");
    // When the user clicks on <span> (x), close the modal
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewerMemberModal");
        modal.style.display = "none";
    }
    function getIRFMembers(id) {

        $.ajax({
            url: '/IRF/GetIRFInterviewerMembers',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);


            }
        });
    }

</script>


<script type="text/javascript">

    $(document).ready(function () {
            $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }

            $("#PrimarySkill").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });


            $("#RFID").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });
            $("#ClientHR").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#ConfirmationStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#MeetingStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#InterviewStatus").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });

            $("#Interviewer").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
            });

            $("#ClientName").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#Client").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });



    });

    function ResetFilter() {

        window.location.href = "/Interview/ResetInterviewFilter";
    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
        var rFID =  @Html.Raw(Json.Serialize(RFID));
        var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
        var confirmationStatus =  @Html.Raw(Json.Serialize(ConfirmationStatus));
        var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
        var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
        var interviewer =  @Html.Raw(Json.Serialize(Interviewer));
        var clientName =  @Html.Raw(Json.Serialize(ClientName));
        var client =  @Html.Raw(Json.Serialize(Client));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#PrimarySkill").val(primarySkillsArr);
        $("#RFID").val(rFID);
        $("#ClientHR").val(clientHR);
        $("#ConfirmationStatus").val(confirmationStatus);
        $("#MeetingStatus").val(meetingStatus);
        $("#InterviewStatus").val(interviewStatus);
        $("#Interviewer").val(interviewer);
        $("#ClientName").val(clientName);
        $("#Client").val(client);
        var form = $("#form").serialize();

    }


</script>


@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}




<script>
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();

    });



    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }



    $(document).ready(function () {

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });




</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script type="text/javascript">
    function openCandidateFeedbackModel() {
        var modal = document.getElementById("CandidateFeedbackModel");
        modal.style.display = "block";
    }
    function closeCandidateFeedbackModel() {
        var modal = document.getElementById("CandidateFeedbackModel");
        modal.style.display = "none";
    }
    function CandidateFeedback(interviewid) {
        $.ajax({
            type: "POST",
            url: "/Interview/FetchCandidateFeedback",
            data: { interviewid: interviewid },
            success: function (data) {
                openCandidateFeedbackModel();
                $("#txtinterviewid").val(interviewid);
                BindCandidateFeedback(data);
            }
        });
    }
    function BindCandidateFeedback(Data) {
        var html = '';
        document.getElementById("btnresendform").style.display = "none";
        if (Data == null) {
            html = 'No Feedback record found';
            document.getElementById("btnresendform").style.display = "block";
        } else {
            html += '<p><b>Overall, how would you rate the video interview experience?</b></p>';
            html += '<p>FeedBack: ' + Data.question1 + ' out of 5</p>';
            html += '<p><b>How would you rate the evaluation process of interviewer?</b></p>';
            html += '<p>FeedBack: ' + Data.question2 + ' out of 5</p>';
            html += '<p><b>Given a chance would you like to reappear for the video interview?</b></p>';
            if (Data.question3 == "1") {
                html += '<p>FeedBack: No, I am satisfied with the interviewer and evaluation process</p>';
            } else {
                html += '<p>FeedBack: Yes, I did not get a fair chance and I can do better</p> ';
            }
            html += '<p><b>What did you like about the video interviews event?</b></p>';
            html += '<p>FeedBack: ' + Data.question4 + '</p>';
            html += '<p><b>What did you dislike about the video interviews event?</b></p>';
            html += '<p>FeedBack: ' + Data.question5 + '</p>';
            html += '<p><b>How friendly was the Risebird staff from scheduling to completion of interviews ?</b></p>';
            html += '<p>FeedBack: ' + Data.question6 + ' out of 5</p>';
            if (Data.commentforInterviewer != null) {
                html += '<p><b>Comments:</b> ' + Data.commentforInterviewer + '</p>';
            } else {
                html += '<p><b>Comments:</b> </p>';
            }
        }
        $("#divcandidatefeedback").empty().html(html);
    }
    function ResendFeedbackForm() {
        var interviewid = $("#txtinterviewid").val();
        var candidateemail = $("#txtcandidateemail_" + interviewid).val();
        $.ajax({
            type: "POST",
            url: "/Interview/ResendFeedbackform",
            data: { interviewid: interviewid, CandidateEmail: candidateemail },
            success: function (data) {
                alert(data);
                closeCandidateFeedbackModel();
            }
        });
    }
</script>
<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
<script>
    $(document).ready(function () {
        $('.sendButton').attr('disabled', true);
        $('input[type="text"],textarea').on('keyup', function () {
            var textarea_value = $("#bcMessage").val();
            var text_value = $('input[name="textField"]').val();
            if (textarea_value != '' && text_value != '') {
                $('.sendButton').attr('disabled', false);

            } else {
                $('.sendButton').attr('disabled', true);
            }
        });
    });
</script>
