@model IEnumerable<Risebird.Entities.ViewModel.InstaMeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Insta Interviews";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] RFID = new string[] { };
    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] Interviewer = new string[] { };
    string[] ClientName = new string[] { };
    string[] Client = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("InstaInterviewfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("InstaInterviewfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    Client = filter.Client != null ? filter.Client : new string[] { };
}
<script>
    var Header = "Insta Interviews";
    $('#txtpageHeader').empty().html(Header);
</script>

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />


<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Insta Interviews</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <span class="interview_3">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-toggle="modal" data-target="#filterModal">

                                <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        </span>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "InstaInterview",new { Requestedid=ViewBag.Requestid})'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Interview</font></span>
                        </button>

                        @Html.ActionLink("Back to List", "InstaIRF", "InstaInterview", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="interviewerMemberModal" class="modal modal-bg">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">


                <div class="filheader">
                    <div class="filavatar">
                        <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                    </div>
                    <h5 class="modal-title pull-left" id="memberHeading">Interviewer Details</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" id="membersPopUp" style="cursor:pointer;">&times;</span>
                </button>

                <div class="modal-body" id="memberTableBody">





                </div>
            </div>

        </div>
    </div>

    <div class="content interview client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">

                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("Index","InstaInterview",new { id=ViewBag.Requestid})" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Jd Title</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="PrimarySkill" name="Jd Title" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.RequiredSkill).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                            }
                                                                        }
                                                                    </select>


                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                    Meeting Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="MeetingStatus" name="MeetingStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Where(x => !string.IsNullOrEmpty(x.MeetingStatusStatusDesc)).Select(x => x.MeetingStatusStatusDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                    Interviewer
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Interviewer" name="Interviewer" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.Interviewer).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label  col-md-12 col-sm-12 desp-label" for="ConfirmationStatus">
                                                                    Confirmation Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.ConfirmationStatus).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                    Interview Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>


                                                                    </div>

                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <div id="tableID" class="second instainterview">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Report</th>
                                                    <th>Requested Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Required Skill</th>
                                                    <th>Assessment Group</th>
                                                    <th>Interviewer</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom Id</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD </th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Report</th>
                                                    <th>Requested Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Required Skill</th>
                                                    <th>Assessment Group</th>
                                                    <th>Interviewer</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom Id</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                    <tr id=@item.id>
                                                        <td class="text-center action">
                                                            @if (ViewBag.profile == "Client")
                                                            {
                                                                <a id="reportId" target="_blank" title="Report Link" href='@Url.Action("AddReport", "InstaInterview", new { interviewId = item.id, Requestedid = ViewBag.Requestid })'>Report</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="interview_9">
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                        <span onclick="location.href = '@Url.Action("AddReport", "InstaInterview", new { interviewId = item.id,Requestedid=ViewBag.Requestid})'" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                                    </button>
                                                                </span>
                                                            }
                                                        </td>
                                                        <td> @item.RequestedDate </td>
                                                        <td>@item.CandidateName</td>
                                                        <td class="interview-com">
                                                            <div id="section">
                                                                @if (item.RequiredSkill != null && item.RequiredSkill != "")
                                                                {
                                                                    @if (item.RequiredSkill.Length > 26)
                                                                    {
                                                                        <div class="article">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.RequiredSkill.Substring(0, 26)
                                                                            </p>
                                                                            <p class="moretext_@item.id moretext">
                                                                                @item.RequiredSkill.Substring(26, @item.RequiredSkill.Length - 26)
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article">

                                                                            <p>
                                                                                @item.RequiredSkill.Substring(0, @item.RequiredSkill.Length - 1)
                                                                            </p>
                                                                        </div>
                                                                    }}
                                                                else
                                                                { <div></div>}

                                                                <a onclick="moreless(@item.id)" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>


                                                            </div>

                                                        </td>

                                                        <td> @item.AssessmentGroup</td>
                                                        <td>@item.Interviewer</td>
                                                        @if (item.ZoomLink != null && item.ZoomLink != "")
                                                        {
                                                            <td> <a class="interview_10" id="zoomlinkId" target="_blank" title="Zoom Link" href=@item.ZoomLink>Zoom Link</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td><span style="color:red">No Zoom Link</span></td>
                                                        }
                                                        <td>@item.AccountEmail</td>
                                                        <td class="text-center"> @item.ConfirmationStatus</td>
                                                        @if (item.MeetingStatusStatusDesc != "0")
                                                        {
                                                            <td>@item.MeetingStatusStatusDesc</td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (item.intervieweStatusStatDesc != "0")
                                                        {
                                                            <td>@item.intervieweStatusStatDesc</td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (item.ResumeLink != null && item.ResumeLink != "")
                                                        {
                                                            <td><a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }
                                                        @if (item.JDLink != null && item.JDLink != "")
                                                        {
                                                            <td>  <a id="jdlinkId" target="_blank" title="JD" href=@item.JDLink>JD</a></td>
                                                        }
                                                        else
                                                        {
                                                            <td>No JD</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>

                    <div id="myModal" class="modal modal-bg">
                        <!-- Modal content -->
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">



                                <div class="filheader">
                                    <div class="filavatar">
                                        <span class="publicsharing-icon">


                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                                        </span>
                                    </div>
                                    <h5 class="modal-title pull-left"> Call Candidate!</h5>
                                </div>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                                </button>



                                <div class="modal-body">
                                    <div>
                                        <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>

                                    </div>

                                    <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto; display: block;" class="btn btn-fill btn-danger" value="Hang Up">

                                </div>

                            </div>

                        </div>
                    </div>


                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>


