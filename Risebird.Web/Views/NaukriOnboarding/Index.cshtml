    function positionMagDropdown() {
        var $dd = $('#magDropdown');
        var $wrap = $('#step2MagArea');
        if (!$dd.length || !$wrap.length || !$dd.is(':visible')) return;
        $dd.removeClass('mag-dropdown--up');
        var rect = $wrap[0].getBoundingClientRect();
        var ddH = Math.min($dd.outerHeight() || 280, 360);
        var spaceBelow = window.innerHeight - rect.bottom;
        if (spaceBelow < ddH + 12 && rect.top > ddH + 12) {
            $dd.addClass('mag-dropdown--up');
        }
        var listMax = Math.max(120, Math.min(270, (window.innerHeight - rect.bottom - 80)));
        if ($dd.hasClass('mag-dropdown--up')) {
            listMax = Math.max(120, Math.min(270, rect.top - 80));
        }
        $('#magList').css('max-height', listMax + 'px');
    }

    $('#btnChangeMag').on('click', function (e) {
