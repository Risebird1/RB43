    .nk-funnel-pill-count { font-size:10px; font-weight:700; color:#1e293b; background:#f1f5f9; border:1px solid #e2e8f0; border-radius:12px; min-width:24px; text-align:center; padding:1px 7px; line-height:1.35; }
    .nk-funnel-pill.active .nk-funnel-pill-count { color:#0d6efd; background:#fff; border-color:#fff; }
    .nk-pill-glyph { font-size:10px; color:#fff; flex-shrink:0; }

    .nk-funnel-pill.active.mode-reached { background:#198754; border-color:#198754; box-shadow:0 2px 8px rgba(25,135,84,.28); }
    .nk-funnel-pill.active.mode-reached .nk-funnel-pill-count { color:#198754; }
    .nk-funnel-pill.active.mode-not { background:#b54708; border-color:#b54708; box-shadow:0 2px 8px rgba(181,71,8,.28); }
    .nk-funnel-pill.active.mode-not .nk-funnel-pill-count { color:#b54708; }

    /* "Reached at least" cumulative funnel strip */
    .nk-reach-strip { margin-bottom:2px; }
    .nk-reach-head { display:flex; align-items:baseline; gap:10px; margin-bottom:8px; flex-wrap:wrap; }
