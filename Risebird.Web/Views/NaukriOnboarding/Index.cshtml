        e.stopPropagation();
        var agId = $(this).attr('data-ag');
        if (!agId) return;
        $.ajax({
            url: '@Url.Action("ClearPriorityMag", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, assessmentGroupId: agId },
