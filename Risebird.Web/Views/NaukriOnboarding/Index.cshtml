@model List<Risebird.Entities.ViewModel.NaukriProspectiveInterviewerVM>
@{
    ViewData["Title"] = "Naukri Prospective Interviewer Onboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int page = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 25;
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    string selStatus = ViewBag.Status as string ?? string.Empty;
    string selName = ViewBag.CandidateName as string ?? string.Empty;
    string selMag = ViewBag.MagName as string ?? string.Empty;
    string selSource = ViewBag.Source as string ?? string.Empty;
    string selAutoStatus = ViewBag.AutomationStatus as string ?? string.Empty;
    string selCallStatus = ViewBag.CallStatus as string ?? string.Empty;
    string selDisposition = ViewBag.Disposition as string ?? string.Empty;
    string selFunnelStage = ViewBag.FunnelStage as string ?? string.Empty;
    string selOnboardingType = ViewBag.OnboardingType as string ?? string.Empty;
    string selAssignedTo = ViewBag.AssignedTo as string ?? string.Empty;
    var assignees = ViewBag.Assignees as List<Risebird.Entities.ViewModel.NaukriAssigneeVM> ?? new List<Risebird.Entities.ViewModel.NaukriAssigneeVM>();
    string selDateFrom = ViewBag.DateFrom as string ?? string.Empty;
    string selDateTo = ViewBag.DateTo as string ?? string.Empty;
    string profileName = ViewBag.ProfileName as string ?? string.Empty;
    bool canDelete = profileName == "Admin" || profileName == "SupportAdmin";
    int MaxCallsTotal = 5;

    var funnelCounts = ViewBag.FunnelCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var funnelReach = ViewBag.FunnelReach as Dictionary<string, int> ?? new Dictionary<string, int>();
    // Happy-path stages in pipeline order, used by the cumulative "reached at least" funnel strip.
    var reachStages = new (string Key, string Label)[] {
        ("EmailParsed",        "Email Parsed"),
        ("PhoneParsed",        "Phone Parsed"),
        ("DuplicateChecked",   "Duplicate Checked"),
        ("MAGConfirmed",       "MAG Confirmed"),
        ("InterestCollection", "Interest Collection"),
        ("IntentConfirmed",    "Intent Confirmed"),
        ("EmploymentVerified", "Employment Verified"),
        ("ResumeFitment",      "AI Resume Fitment"),
        ("AcknowledgementSent","Acknowledgement Sent"),
        ("Onboarded",          "Onboarded")
    };
    int reachTop = funnelReach.TryGetValue("EmailParsed", out var rt) ? rt : 0;
    int reachTotal = funnelReach.TryGetValue("Total", out var rtot) ? rtot : 0;
    Func<string,int> reachOf = k => funnelReach.TryGetValue(k, out var v) ? v : 0;
    // Ordered funnel stages: (value, display label). "_none_" maps to records with no stage yet.
    // Linear happy path first, then the terminal exits (Duplicate / Not Interested / Cold / Not Qualified).
    var funnelStages = new (string Value, string Key, string Label)[] {
        ("_none_",             "New",                "New"),
        ("EmailParsed",        "EmailParsed",        "Email Parsed"),
        ("PhoneParsed",        "PhoneParsed",        "Phone Parsed"),
        ("DuplicateChecked",   "DuplicateChecked",   "Duplicate Checked"),
        ("MAGConfirmed",       "MAGConfirmed",       "MAG Confirmed"),
        ("InterestCollection", "InterestCollection", "Interest Collection"),
        ("IntentConfirmed",    "IntentConfirmed",    "Intent Confirmed"),
        ("EmploymentVerified", "EmploymentVerified", "Employment Verified"),
        ("ResumeFitment",      "ResumeFitment",      "AI Resume Fitment"),
        ("AcknowledgementSent","AcknowledgementSent","Acknowledgement Sent"),
        ("Onboarded",          "Onboarded",          "Onboarded"),
        ("Duplicate",          "Duplicate",          "Duplicate"),
        ("NotInterested",      "NotInterested",      "Not Interested"),
        ("Cold",               "Cold",               "Cold"),
        ("NotQualified",       "NotQualified",       "Not Qualified")
    };

    bool hasFilters = !string.IsNullOrEmpty(selStatus) || !string.IsNullOrEmpty(selName)
                   || !string.IsNullOrEmpty(selMag) || !string.IsNullOrEmpty(selSource)
                   || !string.IsNullOrEmpty(selAutoStatus)
                   || !string.IsNullOrEmpty(selCallStatus) || !string.IsNullOrEmpty(selDisposition)
                   || !string.IsNullOrEmpty(selFunnelStage)
                   || !string.IsNullOrEmpty(selOnboardingType)
                   || !string.IsNullOrEmpty(selAssignedTo)
                   || !string.IsNullOrEmpty(selDateFrom) || !string.IsNullOrEmpty(selDateTo);

    int first = totalCount == 0 ? 0 : (page - 1) * pageSize + 1;
    int last = Math.Min(page * pageSize, totalCount);

    string pageUrl(int p)
    {
        var q = $"?page={p}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(selStatus)) q += $"&status={Uri.EscapeDataString(selStatus)}";
        if (!string.IsNullOrEmpty(selName)) q += $"&candidateName={Uri.EscapeDataString(selName)}";
        if (!string.IsNullOrEmpty(selMag)) q += $"&magName={Uri.EscapeDataString(selMag)}";
        if (!string.IsNullOrEmpty(selSource)) q += $"&source={Uri.EscapeDataString(selSource)}";
        if (!string.IsNullOrEmpty(selAutoStatus)) q += $"&automationStatus={Uri.EscapeDataString(selAutoStatus)}";
        if (!string.IsNullOrEmpty(selCallStatus)) q += $"&callStatus={Uri.EscapeDataString(selCallStatus)}";
        if (!string.IsNullOrEmpty(selDisposition)) q += $"&disposition={Uri.EscapeDataString(selDisposition)}";
        if (!string.IsNullOrEmpty(selFunnelStage)) q += $"&funnelStage={Uri.EscapeDataString(selFunnelStage)}";
        if (!string.IsNullOrEmpty(selOnboardingType)) q += $"&onboardingType={Uri.EscapeDataString(selOnboardingType)}";
        if (!string.IsNullOrEmpty(selAssignedTo)) q += $"&assignedTo={Uri.EscapeDataString(selAssignedTo)}";
        if (!string.IsNullOrEmpty(selDateFrom)) q += $"&dateFrom={Uri.EscapeDataString(selDateFrom)}";
        if (!string.IsNullOrEmpty(selDateTo)) q += $"&dateTo={Uri.EscapeDataString(selDateTo)}";
        return Url.Action("Index", "NaukriOnboarding") + q;
    }

    // Common (non-funnel) filters shared by the funnel URL helpers.
    string funnelBaseQuery()
    {
        var q = $"?page=1&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(selStatus)) q += $"&status={Uri.EscapeDataString(selStatus)}";
        if (!string.IsNullOrEmpty(selName)) q += $"&candidateName={Uri.EscapeDataString(selName)}";
        if (!string.IsNullOrEmpty(selMag)) q += $"&magName={Uri.EscapeDataString(selMag)}";
        if (!string.IsNullOrEmpty(selSource)) q += $"&source={Uri.EscapeDataString(selSource)}";
        if (!string.IsNullOrEmpty(selAutoStatus)) q += $"&automationStatus={Uri.EscapeDataString(selAutoStatus)}";
        if (!string.IsNullOrEmpty(selCallStatus)) q += $"&callStatus={Uri.EscapeDataString(selCallStatus)}";
        if (!string.IsNullOrEmpty(selDisposition)) q += $"&disposition={Uri.EscapeDataString(selDisposition)}";
        if (!string.IsNullOrEmpty(selOnboardingType)) q += $"&onboardingType={Uri.EscapeDataString(selOnboardingType)}";
        if (!string.IsNullOrEmpty(selAssignedTo)) q += $"&assignedTo={Uri.EscapeDataString(selAssignedTo)}";
        if (!string.IsNullOrEmpty(selDateFrom)) q += $"&dateFrom={Uri.EscapeDataString(selDateFrom)}";
        if (!string.IsNullOrEmpty(selDateTo)) q += $"&dateTo={Uri.EscapeDataString(selDateTo)}";
        return q;
    }

    // Build a URL that toggles the funnel-stage filter (exact-match).
    string funnelUrl(string stageValue)
    {
        var q = funnelBaseQuery();
        // Toggle: clicking the active stage clears the filter.
        bool clearing = stageValue == selFunnelStage;
        if (!string.IsNullOrEmpty(stageValue) && !clearing)
            q += $"&funnelStage={Uri.EscapeDataString(stageValue)}";
        return Url.Action("Index", "NaukriOnboarding") + q;
    }

    string funnelLabel(string stage)
    {
        if (string.IsNullOrWhiteSpace(stage)) return "New";
        foreach (var fs in new (string Key, string Label)[] {
            ("New","New"),
            ("EmailParsed","Email Parsed"), ("PhoneParsed","Phone Parsed"),
            ("DuplicateChecked","Duplicate Checked"), ("MAGConfirmed","MAG Confirmed"),
            ("InterestCollection","Interest Collection"), ("IntentConfirmed","Intent Confirmed"),
            ("EmploymentVerified","Employment Verified"), ("ResumeFitment","AI Resume Fitment"),
            ("AcknowledgementSent","Acknowledgement Sent"), ("Onboarded","Onboarded"),
            ("Duplicate","Duplicate"), ("NotInterested","Not Interested"),
            ("Cold","Cold"), ("NotQualified","Not Qualified"),
            // Legacy values (pre-revamp rows that may not have been migrated yet)
            ("Parsed","Email Parsed"), ("MAGMapped","MAG Confirmed"),
            ("InvitationSent","Interest Collection"), ("AwaitingResponse","Interest Collection"),
            ("Unsubscribe","Not Interested") })
        {
            if (string.Equals(fs.Key, stage, StringComparison.OrdinalIgnoreCase)) return fs.Label;
        }
        return stage;
    }
}

