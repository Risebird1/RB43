    $('#magSearchInput').on('input', function () { renderMagList($(this).val()); })
        .on('click', function (e) { e.stopPropagation(); });

    function renderMagList(filter) {
        var $list = $('#magList').empty();
        var lf = (filter || '').toLowerCase();
        var currentMag = currentRecord ? (currentRecord.magName || '') : '';
        var count = 0;
        $.each(allMags, function (idx, m) {
            var display = m.magName + (m.assessmentGroupName ? ' \u2192 ' + m.assessmentGroupName : '');
            if (lf && display.toLowerCase().indexOf(lf) === -1) return;
            var cls = 'mag-item' + (m.magName === currentMag ? ' active' : '');
            var $item = $('<div class="' + cls + '" data-mag-idx="' + idx + '">').html('<span>' + $('<span>').text(m.magName).html() + '</span><span class="mag-ag">' + $('<span>').text(m.assessmentGroupName || '').html() + '</span>');
            $list.append($item);
            count++;
        });
        if (count === 0) $list.append('<div class="mag-no-results">No matching MAGs found</div>');
    }

    $(document).on('click', '#magList .mag-item', function (e) {
        e.stopPropagation();
        var idx = $(this).attr('data-mag-idx');
        if (idx === undefined || idx === null) return;
        var m = allMags[parseInt(idx)];
        if (!m || !currentRecordId) return;
        var oldMag = currentRecord ? (currentRecord.magName || '') : '';
        if (m.magName === oldMag) { $('#magDropdown').hide(); return; }

        $.ajax({
            url: '@Url.Action("UpdateField", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, fieldName: 'MagName', oldValue: oldMag, newValue: m.magName },
            success: function (res) {
                if (res.success) {
                    var magFull = m.magName + (m.assessmentGroupName ? ' \u2192 ' + m.assessmentGroupName : '');
                    $('#step2MagDisplay').text(magFull);
                    $('#mgmMag').text(magFull).attr('title', magFull);
                    selectedMag = m;
                    if (currentRecord) {
                        currentRecord.magName = m.magName;
                        currentRecord.resolvedAssessmentGroupId = m.assessmentGroupId;
                        currentRecord.assessmentGroupName = m.assessmentGroupName;
                    }
                } else { alert(res.error || 'Failed to update MAG.'); }
                $('#magDropdown').hide();
            },
            error: function () { alert('Request failed. Please try again.'); }
        });
    });

    $('#btnConfirmMag').on('click', function () {
        if (!currentRecordId) return;
        var r = currentRecord;
        var agId = r ? (r.resolvedAssessmentGroupId || 0) : 0;
        var magName = r ? (r.magName || '') : '';
        if (!magName) {
            alert('No MAG selected. Please pick a MAG first.');
            return;
        }
        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Saving...');
        $.ajax({
            url: '@Url.Action("ConfirmMag", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, magName: magName, assessmentGroupId: agId },
            success: function (res) {
                if (res && res.success) {
                    if (currentRecord) {
                        currentRecord.resolvedAssessmentGroupId = res.assessmentGroupId;
                        currentRecord.applicationLink = res.applicationLink;
                        currentRecord.funnelStage = 'MAGConfirmed';
                    }
                    markStep(2, 'completed', '<i class="fas fa-check-circle text-success me-1"></i>MAG confirmed: <strong>' + $('<span>').text(magName).html() + '</strong> (AG #' + res.assessmentGroupId + ')');
                    showManualSectionIfReady();
                } else {
                    alert((res && res.error) || 'Failed to confirm MAG.');
                    $btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i>Confirm MAG');
                }
            },
            error: function () {
                alert('Request failed. Please try again.');
                $btn.prop('disabled', false).html('<i class="fas fa-check me-1"></i>Confirm MAG');
            }
        });
    });

    function syncPipeline(r) {
        var step1Done = false, step2Done = false, step3Done = false;
        var step1Blocked = false;
        var prospectResponded = r.selfRegistrationCompleted === true || r.onboardingCompleted === true || !!r.prospectResponse;

        initStep2Mag(r);

        // Step 1: Parse Resume
        if (r.resumeParseCompleted === true) {
            var statusMsg = '';
            if (r.isExistingInterviewer === true) {
                statusMsg = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This email already exists in the system (UserId: ' + r.existingUserId + ').</span>'
                          + '<br/><span style="color:#842029;font-size:12px;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Please edit the email to an alternative email address for this prospect to continue.</span>';
                markStep(1, 'failed', buildStep1Html(r.parsedEmail, r.parsedPhone, statusMsg));
                $('#step1Subtitle').html('<span style="color:#842029;font-size:11px;font-weight:500;">Duplicate email \u2014 edit to proceed</span>');
                step1Blocked = true;
            } else {
                statusMsg = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>New prospect \u2014 ready to proceed.</span>';
                markStep(1, 'completed', buildStep1Html(r.parsedEmail, r.parsedPhone, statusMsg));
                step1Done = true;
            }
        } else if (!r.hasResumeLink) {
            $('#step1Subtitle').html('No resume available. <strong>Upload a resume to proceed.</strong>');
            $('#btnParseResume').prop('disabled', true);
        }

        // Step 2: Select MAG
        if (r.resolvedAssessmentGroupId > 0) {
            var magLabel = (r.magName || '\u2014') + (r.assessmentGroupName ? ' \u2192 ' + r.assessmentGroupName : '');
            if (r.invitationEmailSent === true || r.applicationLink) {
                markStep(2, 'completed', '<i class="fas fa-check-circle text-success me-1"></i>MAG confirmed: <strong>' + $('<span>').text(magLabel).html() + '</strong> (AG #' + r.resolvedAssessmentGroupId + ')');
                step2Done = true;
            } else {
                $('#step2Subtitle').html('MAG auto-resolved: <strong>' + $('<span>').text(magLabel).html() + '</strong>. Confirm or change, then proceed.');
            }
        }

        // Step 3: Send Invitation Email (now before the call)
        if (r.invitationEmailSent === true) {
            var html3 = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Invitation email sent</span>';
            if (r.invitationEmailSentAt) html3 += ' on ' + r.invitationEmailSentAt;
            if (r.applicationLink) html3 += '<br/><span style="font-size:11px;"><strong>MAG Link:</strong> <a href="' + r.applicationLink + '" target="_blank" style="word-break:break-all;">' + r.applicationLink + '</a></span>';
            markStep(3, 'completed', html3);
            $('#btnSendInvitation').hide(); $('#btnResendInvitation').show();
            step3Done = true;
        }

        // Step 4: Track Progress
        if (r.selfRegistrationCompleted === true || r.onboardingCompleted === true) {
            var html4 = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Prospect has self-registered and is onboarded!</span>';
            if (r.onboardedUserId) html4 += '<br/><strong>UserId:</strong> ' + r.onboardedUserId;
            markStep(4, 'completed', html4);
        } else if (r.prospectResponse) {
            var respLabel = {'NeedClarity':'Needs More Details','ManualSupport':'Requested Manual Help','NotInterested':'Not Interested'}[r.prospectResponse] || r.prospectResponse;
            var respClass = r.prospectResponse === 'NotInterested' ? 'text-danger' : 'text-info';
            var html4r = '<span class="' + respClass + '"><i class="fas fa-reply me-1"></i>Prospect responded: <strong>' + respLabel + '</strong></span>';
            if (r.prospectResponseAt) html4r += ' on ' + r.prospectResponseAt;
            if (r.prospectResponse === 'ManualSupport') {
                html4r += '<br/><span style="color:#e67e22;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Prospect needs manual assistance with onboarding. Reach out to help.</span>';
            } else if (r.prospectResponse === 'NeedClarity') {
                html4r += '<br/><span style="color:#3498db;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Prospect needs more information. Contact them to clarify.</span>';
            }
            markStep(4, 'failed', html4r);
        }

        // ── Explicit step enablement pass ──
        // New flow: Parse → MAG → Email → [wait 1hr] → Call → Track Progress
        if (step1Blocked) {
            $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
        } else {
            if (step1Done) { $('#step2Card').removeClass('disabled failed'); $('#step2Number').removeClass('failed'); }
            if (step2Done) { $('#step3Card').removeClass('disabled'); }
            if (step3Done) {
                $('#step4Card').removeClass('disabled');
                $('#step4Subtitle').html('Waiting for prospect to respond or self-register...');
                // Enable call card only if prospect hasn't already responded to the email
                if (!prospectResponded) {
                    $('#plivoCallCard').removeClass('disabled');
                }
            }
        }

        // Show "call skipped" notice when prospect already responded via email
        if (step3Done && prospectResponded) {
            var skipReason = r.selfRegistrationCompleted === true ? 'Prospect self-registered — no call needed.'
                : r.prospectResponse === 'NotInterested' ? 'Prospect declined via email — no call needed.'
                : 'Prospect responded to email — no call needed.';
            $('#plivoCallSubtitle').html('<span class="text-success" style="font-size:11px;"><i class="fas fa-check-circle me-1"></i>' + skipReason + '</span>');
            $('#btnInitiateCall').hide();
            $('#plivoCallCard').css('border-color', '#198754').css('background', '#f0fdf4');
            $('#plivoCallIcon').css('background', '#198754');
        }

        // ── Manual onboarding section sync ──
        syncManualOnboarding(r, step1Done, step2Done);

        // Sync Plivo button disabled state
        if ($('#plivoCallCard').hasClass('disabled')) {
            $('#btnInitiateCall').prop('disabled', true);
        } else if (r.parsedPhone) {
            var pStatus = r.plivoCallStatus || '';
            var pDisp = r.plivoProspectDisposition || '';
            if (pStatus === 'triggered' || pStatus === 'initiated') {
                $('#btnInitiateCall').prop('disabled', true);
            } else if ((pStatus === 'completed' || pStatus === 'answered') && (pDisp === 'interested' || pDisp === 'unsubscribe')) {
                // Call completed — no retry
            } else {
                $('#btnInitiateCall').prop('disabled', false);
            }
        }
    }

    var defaultSubtitles = {
        1: 'Extracts email &amp; phone from the resume PDF and checks if the interviewer already exists in the system',
        2: 'Confirm or change the Master Assessment Group for the prospect',
        3: 'Generates a MAG application link and sends the prospect an email with registration link and response options',
        4: 'Tracks the prospect\u2019s response and self-registration progress'
    };

    function markStep(step, state, message) {
        var card = $('#step'+step+'Card'), num = $('#step'+step+'Number'), result = $('#step'+step+'Result');
        card.removeClass('pending completed failed disabled'); num.removeClass('pending completed failed running');
        if (state === 'completed') {
            card.addClass('completed'); num.addClass('completed');
            if (step===1) { $('#btnParseResume').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Parsed'); $('#step1Subtitle').html('<span class="text-success" style="font-size:11px;">Resume parsed successfully</span>'); }
            if (step===2) { $('#btnConfirmMag').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Confirmed'); $('#step2Subtitle').html('<span class="text-success" style="font-size:11px;">MAG confirmed</span>'); }
            if (step===3) { $('#btnSendInvitation').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Sent'); $('#step3Subtitle').html('<span class="text-success" style="font-size:11px;">Invitation email sent successfully</span>'); }
            if (step===4) { $('#btnCheckProgress').prop('disabled',true); $('#step4Subtitle').html('<span class="text-success" style="font-size:11px;">Prospect onboarded</span>'); }
        } else if (state === 'failed') { card.addClass('failed'); num.addClass('failed'); }
        else if (state === 'running') { num.addClass('running'); }
        if (message) result.html(message).show();

        if (step === 1 && state === 'completed') { $('#step2Card').removeClass('disabled'); }
        if (step === 2 && state === 'completed') { $('#step3Card').removeClass('disabled'); }
        if (step === 3 && state === 'completed') { $('#step4Card').removeClass('disabled'); $('#plivoCallCard').removeClass('disabled'); $('#btnInitiateCall').prop('disabled', false); }
    }

    /* ── Status change ──────────────────────────────────────── */

    $(document).on('click', '.btn-mgm-status', function () {
        var status = $(this).data('status'); if (!currentRecordId) return;
        $.ajax({ url: '@Url.Action("UpdateStatus", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, status: status },
            success: function (res) { if (res.success) { updateStatusBadge(res.status); if (currentRecord) currentRecord.ticketStatus = res.status; } }
        });
    });

    /* ── Resume Upload ──────────────────────────────────────── */

    $('#btnUploadResume').on('click', function () { $('#resumeUploadArea').toggle(); });
    $('#btnCancelUpload').on('click', function () { $('#resumeUploadArea').hide(); $('#resumeFileInput').val(''); $('#uploadResult').hide(); });

    $('#btnConfirmUpload').on('click', function () {
        if (!currentRecordId) return;
        var fileInput = document.getElementById('resumeFileInput');
        if (!fileInput.files || fileInput.files.length === 0) { alert('Please select a file.'); return; }

        var formData = new FormData();
        formData.append('id', currentRecordId);
        formData.append('resumeFile', fileInput.files[0]);
        formData.append('__RequestVerificationToken', verificationToken);

        $('#uploadProgress').show(); $('#uploadResult').hide(); $('#btnConfirmUpload').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("UploadResume", "NaukriOnboarding")', type: 'POST',
            data: formData, processData: false, contentType: false, timeout: 120000,
            success: function (res) {
                $('#uploadProgress').hide(); $('#btnConfirmUpload').prop('disabled', false);
                if (res.success) {
                    $('#uploadResult').html('<span class="text-success" style="font-size:11px;"><i class="fas fa-check-circle me-1"></i>Uploaded.</span>').show();
                    $('#btnViewResume').attr('href', res.resumeLink).show();
                    $('#btnParseResume').prop('disabled', false);
                    $('#step1Subtitle').text('Resume uploaded. Click Parse Resume to extract contact details.');
                    if (currentRecord) { currentRecord.resumeLink = res.resumeLink; currentRecord.hasResumeLink = true; }
                    setTimeout(function(){ $('#resumeUploadArea').hide(); }, 2000);
                } else {
                    $('#uploadResult').html('<span class="text-danger" style="font-size:11px;"><i class="fas fa-times-circle me-1"></i>' + (res.error || 'Upload failed.') + '</span>').show();
                }
            },
            error: function () {
                $('#uploadProgress').hide(); $('#btnConfirmUpload').prop('disabled', false);
                $('#uploadResult').html('<span class="text-danger" style="font-size:11px;"><i class="fas fa-times-circle me-1"></i>Upload failed.</span>').show();
            }
        });
    });

    /* ── Step 1: Parse Resume ───────────────────────────────── */

    $('#btnParseResume').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Parsing...'); $('#step1Number').removeClass('pending').addClass('running');
        $('#step1Subtitle').text('Extracting email and phone from resume...');

        $.ajax({ url: '@Url.Action("ParseResume", "NaukriOnboarding")', type: 'POST', timeout: 120000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    var statusMsg = '';
                    if (res.isExistingInterviewer) {
                        statusMsg = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This email already exists in the system (UserId: ' + res.existingUserId + ').</span>'
                                  + '<br/><span style="color:#842029;font-size:12px;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Please edit the email to an alternative email for this prospect to continue.</span>';
                        markStep(1, 'failed', buildStep1Html(res.parsedEmail, res.parsedPhone, statusMsg));
                        $('#step1Subtitle').html('<span style="color:#842029;font-size:11px;font-weight:500;">Duplicate email \u2014 edit to proceed</span>');
                        $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
                    } else {
                        statusMsg = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message||'New prospect.') + '</span>';
                        markStep(1, 'completed', buildStep1Html(res.parsedEmail, res.parsedPhone, statusMsg));
                    }
                    $('#mgmParsedEmail').text(res.parsedEmail || '\u2014');
                    $('#mgmParsedPhone').text(res.parsedPhone || '\u2014');
                    if (currentRecord) { currentRecord.parsedEmail = res.parsedEmail; currentRecord.parsedPhone = res.parsedPhone; currentRecord.resumeParseCompleted = true; currentRecord.isExistingInterviewer = res.isExistingInterviewer; }
                    if (!res.isExistingInterviewer) showManualSectionIfReady();
                } else {
                    var errHtml = res.error || 'Parse failed.';
                    if (res.needsUpload) errHtml += '<br/><em style="font-size:11px;">Upload a valid resume to proceed.</em>';
                    markStep(1, 'failed', errHtml);
                    btn.prop('disabled',false).html('<i class="fas fa-file-invoice me-1"></i>Retry');
                    $('#step1Subtitle').text('Extracts email & phone from the resume PDF and checks if the interviewer already exists');
                }
            },
            error: function (xhr, status) {
                var msg = status === 'timeout' ? 'Request timed out. Please try again.' : 'Request failed.';
                markStep(1, 'failed', msg);
                btn.prop('disabled',false).html('<i class="fas fa-file-invoice me-1"></i>Retry');
                $('#step1Subtitle').html(defaultSubtitles[1]);
            }
        });
    });

    /* ── Step 2: Send Invitation Email (MAG link generated automatically) ── */

    $('#btnSendInvitation').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Sending...'); $('#step3Number').removeClass('pending').addClass('running');
        $('#step3Subtitle').text('Generating MAG link & sending invitation email...');
        $.ajax({ url: '@Url.Action("SendInvitationEmail", "NaukriOnboarding")', type: 'POST', timeout: 60000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function(res) {
                if (res.success) {
                    var html3 = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message || 'Email sent.') + '</span>';
                    if (res.applicationLink) html3 += '<br/><span style="font-size:11px;"><strong>MAG Link:</strong> <a href="' + res.applicationLink + '" target="_blank" style="word-break:break-all;">' + res.applicationLink + '</a></span>';
                    markStep(3, 'completed', html3);
                    if (currentRecord) { currentRecord.invitationEmailSent = true; currentRecord.applicationLink = res.applicationLink; }
                    $('#btnSendInvitation').hide(); $('#btnResendInvitation').show();
                    $('#step4Card').removeClass('disabled');
                    $('#plivoCallCard').removeClass('disabled'); $('#btnInitiateCall').prop('disabled', false);
                    $('#step4Subtitle').html('Waiting for prospect to respond or self-register...');
                    loadEmailEvents();
                } else {
                    markStep(3, 'failed', res.error || 'Failed to send email.');
                    btn.prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Retry');
                    $('#step3Subtitle').html(defaultSubtitles[3]);
                }
            },
            error: function(){ markStep(3, 'failed', 'Request failed.'); btn.prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Retry'); $('#step3Subtitle').html(defaultSubtitles[3]); }
        });
    });

    $('#btnResendInvitation').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Sending...');
        $.ajax({ url: '@Url.Action("SendInvitationEmail", "NaukriOnboarding")', type: 'POST', timeout: 60000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function(res) {
                if (res.success) { btn.html('<i class="fas fa-check me-1"></i>Resent').prop('disabled',true); loadEmailEvents(); }
                else { alert(res.error || 'Failed.'); btn.prop('disabled',false).html('<i class="fas fa-redo me-1"></i>Resend'); }
            },
            error: function(){ alert('Request failed.'); btn.prop('disabled',false).html('<i class="fas fa-redo me-1"></i>Resend'); }
        });
    });

    /* ── Step 4: Check Progress ─────────────────────────────── */

    $('#btnCheckProgress').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Checking...');
        $('#step4Number').removeClass('pending').addClass('running');
        $('#step4Subtitle').text('Checking if the prospect has self-registered...');
        $.ajax({ url: '@Url.Action("CheckSelfRegistration", "NaukriOnboarding")', type: 'GET', data: { id: currentRecordId },
            success: function(res) {
                btn.prop('disabled',false).html('<i class="fas fa-sync-alt me-1"></i>Check Progress');
                $('#step4Number').removeClass('running').addClass('pending');
                if (res.success && res.completed) {
                    markStep(4, 'completed', '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Prospect has self-registered and is onboarded!</span><br/><strong>UserId:</strong> ' + (res.userId || '\u2014'));
                    updateStatusBadge('Onboarded');
                    if (currentRecord) { currentRecord.selfRegistrationCompleted = true; currentRecord.onboardingCompleted = true; currentRecord.onboardedUserId = res.userId; }
                } else if (res.success) {
                    $('#step4Result').html('<span class="text-muted" style="font-size:12px;"><i class="fas fa-clock me-1"></i>' + (res.reason || 'Prospect has not yet completed self-registration.') + '</span>').show();
                    $('#step4Subtitle').text('Waiting for prospect to respond or self-register...');
                } else {
                    $('#step4Result').html('<span class="text-danger" style="font-size:12px;">' + (res.error || 'Error checking.') + '</span>').show();
                    $('#step4Subtitle').html(defaultSubtitles[4]);
                }
            },
            error: function(){ btn.prop('disabled',false).html('<i class="fas fa-sync-alt me-1"></i>Check Progress'); $('#step4Number').removeClass('running').addClass('pending'); $('#step4Subtitle').html(defaultSubtitles[4]); alert('Request failed.'); }
        });
    });

    /* ── Step 1 editable result builder ──────────────────────── */

    function buildStep1Html(email, phone, statusMsg) {
        var e = email || '\u2014', p = phone || '\u2014';
        return '<div class="d-flex align-items-center flex-wrap gap-2 mb-1">'
            + '<span><strong>Email:</strong> <span class="s1-email-val">' + e + '</span>'
            + ' <button type="button" class="inline-edit-btn btn-s1-edit" data-field="email" title="Edit email"><i class="fas fa-pencil-alt"></i></button></span>'
            + '<span class="text-muted">|</span>'
            + '<span><strong>Phone:</strong> <span class="s1-phone-val">' + p + '</span>'
            + ' <button type="button" class="inline-edit-btn btn-s1-edit" data-field="phone" title="Edit phone"><i class="fas fa-pencil-alt"></i></button></span>'
            + '</div>'
            + '<div class="s1-edit-area" style="display:none;margin-bottom:6px;"></div>'
            + (statusMsg ? '<div class="s1-status-msg">' + statusMsg + '</div>' : '');
    }

    /* ── Inline Edit: Email & Phone (delegated from Step 1 result) ── */

    $(document).on('click', '.btn-s1-edit', function () {
        var field = $(this).data('field');
        var current = field === 'email'
            ? ((currentRecord && currentRecord.parsedEmail) || '')
            : ((currentRecord && currentRecord.parsedPhone) || '');
        var label = field === 'email' ? 'Email' : 'Phone';
        var inputType = field === 'email' ? 'email' : 'tel';

        var editHtml = '<div class="inline-edit-group">'
            + '<strong style="font-size:12px;min-width:48px;">' + label + ':</strong> '
            + '<input type="' + inputType + '" class="s1-edit-input" data-field="' + field + '" value="' + current.replace(/"/g, '&quot;') + '" />'
            + '<button type="button" class="btn btn-sm btn-primary btn-s1-save" data-field="' + field + '"><i class="fas fa-check"></i></button>'
            + '<button type="button" class="btn btn-sm btn-outline-secondary btn-s1-cancel"><i class="fas fa-times"></i></button>'
            + '</div>';
        $('#step1Result .s1-edit-area').html(editHtml).show();
        $('#step1Result .s1-edit-area .s1-edit-input').focus();
    });

    $(document).on('click', '.btn-s1-cancel', function () {
        $('#step1Result .s1-edit-area').hide().empty();
    });

    $(document).on('click', '.btn-s1-save', function () {
        var field = $(this).data('field');
        var fieldName = field === 'email' ? 'ParsedEmail' : 'ParsedPhone';
        var newVal = $('#step1Result .s1-edit-input[data-field="' + field + '"]').val().trim();
        if (!newVal) { alert((field === 'email' ? 'Email' : 'Phone') + ' cannot be empty.'); return; }

        var oldVal = field === 'email'
            ? ((currentRecord && currentRecord.parsedEmail) || '')
            : ((currentRecord && currentRecord.parsedPhone) || '');
        if (newVal === oldVal) { $('#step1Result .s1-edit-area').hide().empty(); return; }

        var btn = $(this); btn.prop('disabled', true);
        $.ajax({
            url: '@Url.Action("SaveManualOverride", "NaukriOnboarding")', type: 'POST', timeout: 30000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, fieldName: fieldName, oldValue: oldVal, newValue: newVal },
            success: function (res) {
                btn.prop('disabled', false);
                if (res.success) {
                    $('#step1Result .s1-edit-area').hide().empty();
                    if (field === 'email') {
                        currentRecord.parsedEmail = newVal;
                        currentRecord.isExistingInterviewer = res.isExistingInterviewer;
                        currentRecord.existingUserId = res.existingUserId;
                        $('#step1Result .s1-email-val').text(newVal);
                        $('#mgmParsedEmail').text(newVal);
                        var newStatusMsg = '';
                        if (res.isExistingInterviewer) {
                            newStatusMsg = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This email also exists in the system (UserId: ' + res.existingUserId + ').</span>'
                                         + '<br/><span style="color:#842029;font-size:12px;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Try a different email address for this prospect.</span>';
                            $('#step1Card').removeClass('completed pending').addClass('failed');
                            $('#step1Number').removeClass('completed pending').addClass('failed');
                            $('#step1Subtitle').html('<span style="color:#842029;font-size:11px;font-weight:500;">Duplicate email \u2014 edit to proceed</span>');
                            $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
                        } else {
                            newStatusMsg = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message || 'Email updated. Interviewer is new to the system.') + '</span>';
                            $('#step1Card').removeClass('failed pending').addClass('completed');
                            $('#step1Number').removeClass('failed pending').addClass('completed');
                            $('#step1Subtitle').html('<span class="text-success" style="font-size:11px;">Email verified \u2014 new to the system</span>');
                            $('#btnParseResume').prop('disabled', true).html('<i class="fas fa-check me-1"></i>Parsed');
                            $('#step2Card').removeClass('disabled failed').addClass('pending');
                            $('#step2Number').removeClass('failed').addClass('pending');
                            $('#step2Subtitle').html(defaultSubtitles[2]);
                            showManualSectionIfReady();
                        }
                        $('#step1Result .s1-status-msg').html(newStatusMsg);
                    } else {
                        currentRecord.parsedPhone = newVal;
                        $('#step1Result .s1-phone-val').text(newVal);
                        $('#mgmParsedPhone').text(newVal);
                    }
                    
                } else { alert(res.error || 'Failed to update.'); }
            },
            error: function () { btn.prop('disabled', false); alert('Request failed.'); }
        });
    });

