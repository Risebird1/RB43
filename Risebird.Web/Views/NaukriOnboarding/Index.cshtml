                        </div>
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span class="label"><i class="fas fa-phone me-1"></i>Parsed Phone:</span>
                                <span class="value" id="mgmParsedPhone">\u2014</span>
                            </div>
