    .nk-reach-bars { display:flex; align-items:flex-end; gap:6px; }
    .nk-reach-col { flex:1 1 0; min-width:54px; display:flex; flex-direction:column; align-items:center; gap:3px; padding:4px 2px; border-radius:8px; transition:background .12s; }
