    var allMags = [], magsLoaded = false;
    var selectedMag = null;

    function loadMags(callback) {
        if (magsLoaded) { if (callback) callback(); return; }
        $.ajax({
            url: '@Url.Action("GetAllMags", "NaukriOnboarding")', type: 'GET',
            success: function (res) {
                if (res.success && res.data) { allMags = res.data; magsLoaded = true; }
                if (callback) callback();
            }
        });
    }

    /* ── Priority intent-collection MAGs ─────────────────────────── */
    var priorityMags = [], priorityMax = 2;

    function loadPriorityMags() {
        $.ajax({
            url: '@Url.Action("GetPriorityMags", "NaukriOnboarding")', type: 'GET',
            success: function (res) {
                if (res && res.success) {
                    priorityMags = res.data || [];
                    if (res.max) priorityMax = res.max;
                    renderPriorityChips();
                }
            }
        });
    }

    function renderPriorityChips() {
        var $c = $('#nkPriorityChips').empty();
        if (!priorityMags.length) {
            $c.append('<span class="nk-priority-empty">No priority MAGs set.</span>');
        } else {
            $.each(priorityMags, function (i, m) {
                var $chip = $('<span class="nk-priority-chip">');
                $chip.append($('<span>').text(m.magName));
                $chip.append('<button type="button" class="nk-priority-chip-x" title="Remove priority" data-ag="' + m.assessmentGroupId + '"><i class="fas fa-times"></i></button>');
                $c.append($chip);
            });
        }
        var atMax = priorityMags.length >= priorityMax;
        $('#nkPriorityAddBtn').prop('disabled', atMax)
            .attr('title', atMax ? ('Max ' + priorityMax + ' priority MAGs. Remove one first.') : 'Add a priority MAG');
    }

    function renderPriorityList(filter) {
        var $list = $('#nkPriorityList').empty();
        var lf = (filter || '').toLowerCase();
        var activeAgIds = priorityMags.map(function (m) { return m.assessmentGroupId; });
        var count = 0;
        $.each(allMags, function (idx, m) {
            var display = m.magName + (m.assessmentGroupName ? ' \u2192 ' + m.assessmentGroupName : '');
            if (lf && display.toLowerCase().indexOf(lf) === -1) return;
            var already = activeAgIds.indexOf(m.assessmentGroupId) !== -1;
            var $item = $('<div class="mag-item' + (already ? ' disabled' : '') + '" data-mag-idx="' + idx + '">')
                .html('<span>' + $('<span>').text(m.magName).html() + '</span><span class="mag-ag">' + $('<span>').text(m.assessmentGroupName || (already ? 'already priority' : '')).html() + '</span>');
            $list.append($item);
            count++;
        });
        if (count === 0) $list.append('<div class="mag-no-results">No matching MAGs found</div>');
    }

