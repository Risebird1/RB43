    .ht-dot.resumeparse { background:#17a2b8; } .ht-dot.resumeupload { background:#0dcaf0; }
    .ht-dot.resumeanalysis { background:#fd7e14; }
    .ht-dot.employmentverification { background:#28a745; }
    .ht-dot.onboarded { background:#198754; }
    .ht-dot.ackemailresent { background:#6f42c1; }
    .ht-dot.magchange { background:#e67e22; } .ht-dot.emailchange { background:#3498db; } .ht-dot.phonechange { background:#9b59b6; }
    .ht-dot.recordcreated { background:#20c997; } .ht-dot.deleted { background:#dc3545; }
    .ht-dot.plivocallinitiated { background:#6f42c1; } .ht-dot.plivocallcompleted { background:#198754; }
    .ht-body { flex:1; } .ht-transition { font-size:13px; font-weight:600; color:#212529; }
    .ht-meta { font-size:11.5px; color:#6c757d; margin-top:2px; }

    #historyModal.modal { z-index:1080; }
    #historyModal .modal-dialog { margin:0.75rem auto; max-width:560px; }
    #historyModal .modal-content { font-family:'Roboto',sans-serif; border:none; border-radius:10px; overflow:hidden; box-shadow:0 16px 48px rgba(15,23,42,0.12); }
    #historyModal .hm-header { background:linear-gradient(165deg,#eef2f7 0%,#e2e8f0 45%,#dce4ed 100%); border-bottom:1px solid #cbd5e1; padding:1rem 1.25rem; }
    #historyModal .hm-eyebrow { font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#64748b; margin:0 0 0.35rem 0; }
    #historyModal .hm-title { font-size:17px; font-weight:700; color:#334155; line-height:1.25; margin:0; }
    #historyModal .hm-title i { color:#475569; opacity:0.9; }
    #historyModal #historyModalSubject { font-size:12px; color:#64748b; line-height:1.4; display:block; margin-top:0.35rem; }
    #historyModal .hm-body { background:#f1f5f9; padding:0.75rem 1rem; font-size:14px; color:#334155; max-height:min(420px,calc(100vh - 14rem)); overflow-y:auto; }
    #historyModal .hm-footer { background:#f8fafc; padding:0.5rem 1rem; }

    .mag-dropdown-wrap { position:relative; display:inline-block; }
    #magDropdown { display:none; position:absolute; z-index:1060; background:#fff; border:1px solid #dee2e6; border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,.18); width:380px; max-height:360px; left:0; top:100%; margin-top:4px; }
    #magDropdown .mag-search-wrap { padding:8px 10px; border-bottom:1px solid #eee; }
    #magDropdown .mag-search-wrap input { font-size:12px; }
    #magList { max-height:270px; overflow-y:auto; padding:4px; }
    #magList .mag-item { padding:6px 10px; font-size:12px; cursor:pointer; border-radius:4px; transition:background .12s; display:flex; justify-content:space-between; align-items:center; }
    #magList .mag-item:hover { background:#e9ecef; }
    #magList .mag-item.active { background:#0d6efd; color:#fff; }
    #magList .mag-item .mag-ag { font-size:10px; opacity:.7; }
    #magList .mag-no-results { padding:12px; text-align:center; color:#6c757d; font-size:12px; }
</style>

<div id="loadingOverlay">
    <div class="spinner-content">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        <div class="loading-text">Loading records...</div>
    </div>
</div>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="content client">
            <div class="container-fluid py-4">

                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h4 class="fw-bold mb-0"><i class="fas fa-user-graduate text-primary me-2"></i>Prospective Interviewer Onboarding</h4>
                        <p class="text-muted mb-0 mt-1">Prospective interviewers sourced from Naukri / LinkedIn, processed via Relay.app</p>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <a href="@Url.Action("ProspectProgress", "NaukriOnboarding")" class="btn btn-sm btn-outline-primary"><i class="fas fa-chart-line me-1"></i>Progress Tracker</a>
                        <button type="button" class="btn btn-sm nk-page-refresh" onclick="location.reload()" title="Reload this page"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                    </div>
                </div>

                @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

                @{ var cardOpen = Model.Count(r => string.Equals(r.Status, "Open", StringComparison.OrdinalIgnoreCase));
                   var cardIP = Model.Count(r => string.Equals(r.Status, "InProgress", StringComparison.OrdinalIgnoreCase));
                   var cardVerified = Model.Count(r => string.Equals(r.Status, "Verified", StringComparison.OrdinalIgnoreCase));
                   var cardOnboarded = Model.Count(r => string.Equals(r.Status, "Onboarded", StringComparison.OrdinalIgnoreCase));
                   var cardRejected = Model.Count(r => string.Equals(r.Status, "Rejected", StringComparison.OrdinalIgnoreCase)); }
                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-primary">@totalCount</div><div class="stat-label">@(hasFilters ? "Matched" : "Total")</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-warning">@cardOpen</div><div class="stat-label">Open</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-info">@cardIP</div><div class="stat-label">In Progress</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-success">@cardVerified</div><div class="stat-label">Verified</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value" style="color:#0f5132;">@cardOnboarded</div><div class="stat-label">Onboarded</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-danger">@cardRejected</div><div class="stat-label">Rejected</div></div></div>
                </div>

                <form asp-action="Index" asp-controller="NaukriOnboarding" method="get" id="filterForm">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex align-items-center gap-2" style="flex-wrap:nowrap;width:100%;">
                                <select name="status" class="form-select nk-filter-control" style="flex:1 1 0;min-width:120px;max-width:155px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All statuses</option>
                                    @if (selStatus == "Open") { <option value="Open" selected>Open</option> } else { <option value="Open">Open</option> }
                                    @if (selStatus == "InProgress") { <option value="InProgress" selected>In Progress</option> } else { <option value="InProgress">In Progress</option> }
                                    @if (selStatus == "Verified") { <option value="Verified" selected>Verified</option> } else { <option value="Verified">Verified</option> }
                                    @if (selStatus == "Onboarded") { <option value="Onboarded" selected>Onboarded</option> } else { <option value="Onboarded">Onboarded</option> }
                                    @if (selStatus == "Rejected") { <option value="Rejected" selected>Rejected</option> } else { <option value="Rejected">Rejected</option> }
                                    @if (selStatus == "Closed") { <option value="Closed" selected>Closed</option> } else { <option value="Closed">Closed</option> }
                                </select>
                                <input type="text" name="candidateName" class="form-control nk-filter-control" placeholder="Candidate name..." style="flex:1 1 0;min-width:130px;" value="@selName" />
                                <input type="text" name="magName" class="form-control nk-filter-control" placeholder="MAG name..." style="flex:1 1 0;min-width:120px;" value="@selMag" />
                                <select name="source" class="form-select nk-filter-control" style="flex:1 1 0;min-width:110px;max-width:140px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All sources</option>
                                    @if (selSource == "Naukri") { <option value="Naukri" selected>Naukri</option> } else { <option value="Naukri">Naukri</option> }
                                    @if (selSource == "LinkedIn") { <option value="LinkedIn" selected>LinkedIn</option> } else { <option value="LinkedIn">LinkedIn</option> }
                                </select>
                                <select name="automationStatus" class="form-select nk-filter-control" style="flex:1 1 0;min-width:130px;max-width:165px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All automation</option>
                                    @{ var autoOpts = new[] {
                                        ("_any_", "Any (automated)"),
                                        ("_none_", "Not automated"),
                                        ("EmailSent", "Email Sent"),
                                        ("CallTriggered", "Calling"),
                                        ("AwaitingRetry", "Retry Pending"),
                                        ("Cold", "Cold"),
                                        ("ManualRequired", "Manual Required"),
                                        ("Completed", "Completed"),
                                        ("Error", "Error")
                                    };}
                                    @foreach (var (val, label) in autoOpts)
                                    {
                                        if (selAutoStatus == val) { <option value="@val" selected>@label</option> } else { <option value="@val">@label</option> }
                                    }
                                </select>
                                <input type="date" name="dateFrom" class="form-control nk-filter-control" style="flex:1 1 0;min-width:120px;" value="@selDateFrom" onchange="document.getElementById('filterForm').submit()" />
                                <span class="text-muted flex-shrink-0" style="font-size:11px;">\u2013</span>
                                <input type="date" name="dateTo" class="form-control nk-filter-control" style="flex:1 1 0;min-width:120px;" value="@selDateTo" onchange="document.getElementById('filterForm').submit()" />
                                <button style="background:#07363c4f !important;border:0px;padding:7px 10px;" type="submit" class="btn btn-primary btn-sm flex-shrink-0"><i class="fas fa-filter me-1"></i>Apply</button>
                                <a style="padding:7px 10px!important;border:0px;background:#da7c7c !important;color:#fff" asp-action="Index" asp-controller="NaukriOnboarding" class="btn btn-sm btn-outline-secondary flex-shrink-0"><i class="fas fa-times me-1"></i>Clear</a>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                <span>@(hasFilters ? "No records match the selected filters." : "No Naukri prospects yet. Once Relay.app routes a Naukri email, it will appear here.")</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive nk-scroll">
                                <table id="nkTable" class="table table-hover table-sm mb-0 align-top">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="col-num">#</th><th class="col-date">Received</th>
                                            <th style="min-width:60px;">Source</th>
                                            <th class="col-name">Candidate</th><th class="col-role">Current Role</th>
                                            <th class="col-exp">Exp</th><th class="col-location">Location</th>
                                            <th class="col-mag">MAG</th><th class="col-skills">Key Skills</th>
                                            <th style="min-width:90px;">Call</th>
                                            <th style="min-width:80px;">Auto</th>
                                            <th class="col-status">Status</th><th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model)
                                        {
                                            string rStatus = r.Status?.ToLower() ?? "open";
                                            string statusCss = rStatus switch {
                                                "open" => "status-open", "inprogress" => "status-inprogress",
                                                "verified" => "status-verified", "onboarded" => "status-onboarded",
                                                "rejected" => "status-rejected", "closed" => "status-closed",
                                                _ => "bg-light border" };

                                            <tr id="row-@r.Id">
                                                <td class="col-num text-muted" style="font-size:12px">@r.Id</td>
                                                <td class="col-date" style="font-size:12px">@(r.ReceivedAt.HasValue ? r.ReceivedAt.Value.ToString("dd MMM yy, HH:mm") : "\u2014")</td>
                                                <td style="font-size:11px;">
                                                    @{
                                                        string srcLabel = r.Source ?? "Naukri";
                                                        string srcBadge = string.Equals(srcLabel, "LinkedIn", StringComparison.OrdinalIgnoreCase)
                                                            ? "background:#0a66c2;color:#fff;" : "background:#4a90d9;color:#fff;";
                                                    }
                                                    <span class="badge" style="@srcBadge font-size:10px;">@srcLabel</span>
                                                </td>
                                                <td class="col-name">
                                                    <span class="fw-semibold" style="font-size:12px;white-space:break-spaces;">@(r.CandidateName ?? "\u2014")</span>
                                                    @if (!string.IsNullOrEmpty(r.ParsedEmail)) { <br /><span class="text-muted" style="font-size:10px;white-space:break-spaces;">@r.ParsedEmail</span> }
                                                </td>
                                                <td class="col-role" style="font-size:12px;white-space:break-spaces;">@(r.CurrentRole ?? "\u2014")</td>
                                                <td class="col-exp" style="font-size:12px;">@(r.ExperienceYears ?? "\u2014")</td>
                                                <td class="col-location" style="font-size:12px;">@(r.Location ?? "\u2014")</td>
                                                <td class="col-mag" style="font-size:12px;">
                                                    @{
                                                        var magTitle = r.MagName ?? "\u2014";
                                                        if (!string.IsNullOrEmpty(r.AssessmentGroupName)) { magTitle = magTitle + " \u2192 " + r.AssessmentGroupName; }
                                                    }
                                                    <div class="skills-wrap mag-cell-inner" style="word-break:normal;" title="@magTitle">
                                                        @(r.MagName ?? "\u2014")
                                                        @if (!string.IsNullOrEmpty(r.AssessmentGroupName)) { <br /><span class="text-muted" style="font-size:10px;">@r.AssessmentGroupName</span> }
                                                    </div>
                                                </td>
                                                <td class="col-skills"><div class="skills-wrap" style="white-space:break-spaces;" title="@(r.KeySkills ?? "\u2014")">@(r.KeySkills ?? "\u2014")</div></td>
                                                <td style="font-size:11px;white-space:nowrap;">
                                                    @if (string.IsNullOrEmpty(r.PlivoCallStatus))
                                                    {
                                                        <span class="text-muted" style="font-size:10px;">—</span>
                                                    }
                                                    else
                                                    {
                                                        string callBadge = r.PlivoCallStatus switch {
                                                            "triggered" => "background:#cfe2ff;color:#0a3278;border:1px solid #0d6efd;",
                                                            "completed" => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "answered" => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "no-answer" => "background:#fff3cd;color:#856404;border:1px solid #ffc107;",
                                                            "busy" => "background:#fff3cd;color:#856404;border:1px solid #ffc107;",
                                                            "failed" => "background:#f8d7da;color:#842029;border:1px solid #dc3545;",
                                                            "trigger-failed" => "background:#f8d7da;color:#842029;border:1px solid #dc3545;",
                                                            "initiated" => "background:#e2e3e5;color:#41464b;border:1px solid #6c757d;",
                                                            _ => "background:#e9ecef;color:#495057;border:1px solid #ced4da;"
                                                        };
                                                        <span class="intent-badge" style="@callBadge font-size:10px;">@r.PlivoCallStatus</span>
                                                        if (!string.IsNullOrEmpty(r.PlivoProspectDisposition))
                                                        {
                                                            string dispColor = r.PlivoProspectDisposition switch {
                                                                "interested" => "text-success",
                                                                "not_interested" => "text-danger",
                                                                "unsubscribe" => "text-danger",
                                                                _ => "text-muted"
                                                            };
                                                            <br/><span class="@dispColor" style="font-size:9.5px;"><i class="fas fa-phone-alt me-1"></i>@r.PlivoProspectDisposition</span>
                                                        }
                                                    }
                                                </td>
                                                <td style="font-size:10px;white-space:nowrap;">
                                                    @if (!string.IsNullOrEmpty(r.AutomationStatus))
                                                    {
                                                        string autoBg = r.AutomationStatus switch {
                                                            "EmailSent" or "Completed" => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "Cold" => "background:#f8d7da;color:#842029;border:1px solid #dc3545;",
                                                            "ManualRequired" or "Error" => "background:#fff3cd;color:#856404;border:1px solid #ffc107;",
                                                            "CallTriggered" or "ParsingResume" or "SelectingChannel" or "SendingEmail" => "background:#cfe2ff;color:#0a3278;border:1px solid #0d6efd;",
                                                            "AwaitingRetry" or "CallFailed" => "background:#e2e3e5;color:#41464b;border:1px solid #6c757d;",
                                                            _ => "background:#e9ecef;color:#495057;border:1px solid #ced4da;"
                                                        };
                                                        string autoLabel = r.AutomationStatus switch {
                                                            "ParsingResume" => "Parsing",
                                                            "SelectingChannel" => "Selecting",
                                                            "CallTriggered" => "Calling",
                                                            "CallFailed" => "Call Failed",
                                                            "AwaitingRetry" => "Retry Pending",
                                                            "SendingEmail" => "Emailing",
                                                            "EmailSent" => "Email Sent",
                                                            "ManualRequired" => "Manual",
                                                            "Cold" => "Cold",
                                                            "Completed" => "Done",
                                                            "Error" => "Error",
                                                            _ => r.AutomationStatus
                                                        };
                                                        <span class="intent-badge" style="@autoBg font-size:9.5px;" title="Automation: @r.AutomationStatus">
                                                            <i class="fas fa-robot me-1"></i>@autoLabel
                                                        </span>
                                                        if (r.PlivoCallAttemptsTotal > 0)
                                                        {
                                                            <br/><span class="text-muted" style="font-size:9px;">@r.PlivoCallAttemptsTotal / @MaxCallsTotal calls</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted" style="font-size:9px;">—</span>
                                                    }
                                                </td>
                                                <td class="col-status">
                                                    <span class="intent-badge @statusCss" style="font-size:12px;white-space:break-spaces;">@(r.Status ?? "Open")</span>
                                                    @if (r.ResumeAIAnalysisCompleted == true)
                                                    {
                                                        string aiBadgeClass = "text-info";
                                                        string aiLabel = "AI";
                                                        try
                                                        {
                                                            if (!string.IsNullOrWhiteSpace(r.ResumeAIAnalysisResult))
                                                            {
                                                                var aiData = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(r.ResumeAIAnalysisResult);
                                                                string vrd = aiData?.verdict;
                                                                string sc = aiData?.fitmentScore?.ToString();
                                                                if (!string.IsNullOrEmpty(vrd))
                                                                {
                                                                    bool isYes = vrd.IndexOf("yes", StringComparison.OrdinalIgnoreCase) >= 0;
                                                                    aiBadgeClass = isYes ? "text-success" : "text-danger";
                                                                    aiLabel = isYes ? "Yes" : "No";
                                                                }
                                                                if (!string.IsNullOrEmpty(sc)) aiLabel += " \u00B7 " + sc;
                                                            }
                                                        }
                                                        catch { }
                                                        <br /><span style="font-size:9px;" class="@aiBadgeClass" title="AI Verdict"><i class="fas fa-robot"></i> @aiLabel</span>
                                                    }
                                                    @if (r.OnboardingCompleted == true) { <br /><span style="font-size:9px;" class="text-success"><i class="fas fa-check-double"></i> Onboarded</span> }
                                                </td>
                                                <td class="col-actions">
                                                    <div class="action-btns d-flex align-items-center flex-wrap gap-1">
                                                        <button type="button" title="Manage \u2014 review, verify &amp; onboard"
                                                                class="btn btn-primary btn-manage-record"
                                                                data-record-id="@r.Id">
                                                            <i class="fas fa-bars me-1"></i>Manage
                                                        </button>
                                                        @if (canDelete)
                                                        {
                                                            <button type="button" title="Delete this record"
                                                                    class="btn btn-danger btn-sm btn-delete-record"
                                                                    data-record-id="@r.Id">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                        <div class="text-muted" style="font-size:12px;">
                            Showing @first\u2013@last of @totalCount records
                            <span class="ms-3">Page size:
                                @foreach (var sz in new[] { 10, 25, 50, 100 })
                                { if (pageSize == sz) { <strong class="ms-1">@sz</strong> } else { <a href="javascript:void(0)" class="ms-1 text-decoration-none" onclick="changePageSize(@sz)">@sz</a> } }
                            </span>
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@pageUrl(page - 1)">Prev</a></li>
                                @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++) { <li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@pageUrl(p)">@p</a></li> }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")"><a class="page-link" href="@pageUrl(page + 1)">Next</a></li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- ══════════════════════ Manage Modal ══════════════════════ -->
<div class="modal fade" id="manageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header mgm-header">
                <div class="modal-title-wrap pe-2">
                    <h5 class="modal-title"><i class="fas fa-user-graduate me-2"></i>Onboard Naukri Prospect</h5>
                </div>
                <div class="d-flex align-items-start gap-2 ms-auto flex-shrink-0">
                    <div style="position:relative;top:17px;right:30px;"><span class="lbl">Record no.</span> <span id="mgmRecordNo">#\u2014</span></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <div class="mgm-status-strip px-3 px-md-4 py-2 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap mgm-status-badge-wrap">
                    <strong class="text-muted" style="font-size:12.5px;">Status</strong>
                    <span class="badge" id="mgmStatusBadge">Open</span>
                    <span class="badge" id="mgmAutomationBadge" style="display:none;font-size:11px;"></span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap mgm-status-btns" id="mgmStatusActions">
                    <span class="text-muted" style="font-size:12px;">Change to</span>
                    <button type="button" class="btn btn-outline-primary btn-sm btn-mgm-status" data-status="InProgress"><i class="fas fa-hourglass-half me-1"></i>In Progress</button>
                    <button type="button" class="btn btn-outline-danger btn-sm btn-mgm-status" data-status="Rejected"><i class="fas fa-ban me-1"></i>Reject</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm btn-mgm-status" data-status="Closed"><i class="fas fa-times-circle me-1"></i>Close</button>
                    <button type="button" class="btn btn-outline-warning btn-sm btn-mgm-status" data-status="Open"><i class="fas fa-redo me-1"></i>Reopen</button>
                </div>
            </div>

            <div class="modal-body pt-3" id="mgmBody">
                <div class="text-center py-4 text-muted" id="mgmLoading"><i class="fas fa-spinner fa-spin me-2"></i>Loading record details...</div>

                <div id="mgmContent" style="display:none;">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mgm-meta">
                                <span><strong>Candidate:</strong> <span id="mgmName"></span></span><br/>
                                <span><strong>Current Role:</strong> <span id="mgmRole"></span></span><br/>
                                <span><strong>Experience:</strong> <span id="mgmExp"></span></span><br/>
                                <span><strong>Location:</strong> <span id="mgmLocation"></span></span><br/>
                                <span><strong>Notice Period:</strong> <span id="mgmNotice"></span></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mgm-meta">
                                <span><strong>MAG:</strong>
                                    <span id="mgmMag" class="mgm-ellipsis-mag"></span>
                                </span><br/>
                                <span><strong>Education:</strong> <span id="mgmEducation"></span></span><br/>
                                <span><strong>Salary:</strong> <span id="mgmSalary"></span></span><br/>
                                <span><strong>Past Exp:</strong> <span id="mgmPastExp"></span></span><br/>
                                <span><strong>Received:</strong> <span id="mgmReceived"></span></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span><i class="fas fa-envelope me-1"></i>Parsed Email:</span>
                                <span class="value" id="mgmParsedEmail">\u2014</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span><i class="fas fa-phone me-1"></i>Parsed Phone:</span>
                                <span class="value" id="mgmParsedPhone">\u2014</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span><i class="fas fa-building me-1"></i>Company:</span>
                                <span class="value" id="mgmCompany">\u2014</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span><i class="fas fa-briefcase me-1"></i>Employed:</span>
                                <span class="value" id="mgmEmployed">\u2014</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12"><div class="mgm-section-title">Key Skills</div><div style="font-size:12px;" id="mgmSkills" class="mgm-ellipsis-skills"></div></div>
                    </div>
                    <div class="mb-3"><div class="mgm-section-title">Email Subject</div><div style="font-size:12.5px;" id="mgmSubject"></div></div>

                    <hr/>

                    <h6 class="fw-bold mb-3" style="font-size:13px;"><i class="fas fa-tasks me-2 text-primary"></i>Onboarding Pipeline</h6>

                    <!-- Step 1: Parse Resume -->
                    <div class="mgm-action-card pending" id="step1Card">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number pending" id="step1Number">1</span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;">
                                        <strong style="font-size:13px;">Parse Resume &amp; Check Duplicate</strong>
                                        <div class="text-muted mt-1" style="font-size:11.5px;" id="step1Subtitle">Extracts email &amp; phone from the resume PDF and checks if the interviewer already exists in the system</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                        <a href="#" target="_blank" class="btn btn-outline-secondary btn-sm mgm-btn-view-resume" id="btnViewResume" style="display:none;"><i class="fas fa-file-alt me-1"></i>View Resume</a>
                                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnUploadResume" style="font-size:11px;padding:4px 10px;"><i class="fas fa-cloud-upload-alt me-1"></i>Upload Resume</button>
                                        <button type="button" class="btn btn-info btn-sm mgm-action-btn text-white" id="btnParseResume"><i class="fas fa-file-invoice me-1"></i>Parse Resume</button>
                                    </div>
                                </div>
                                <div id="resumeUploadArea" style="display:none;" class="mt-2 p-2 border rounded bg-light">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="file" id="resumeFileInput" accept=".pdf,.doc,.docx" class="form-control form-control-sm" style="max-width:300px;font-size:11px;" />
                                        <button type="button" class="btn btn-sm btn-success" id="btnConfirmUpload" style="font-size:11px;padding:3px 10px;"><i class="fas fa-cloud-upload-alt me-1"></i>Upload</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCancelUpload" style="font-size:11px;padding:3px 8px;">Cancel</button>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size:10px;">Accepts PDF, DOC, DOCX files.</div>
                                    <div id="uploadProgress" style="display:none;" class="mt-1"><i class="fas fa-spinner fa-spin me-1"></i><span style="font-size:11px;">Uploading...</span></div>
                                    <div id="uploadResult" style="display:none;" class="mt-1"></div>
                                </div>
                                <div class="mgm-result-block" id="step1Result" style="display:none;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Select MAG -->
                    <div class="mgm-action-card pending disabled" id="step2Card">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number pending" id="step2Number">2</span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;">
                                        <strong style="font-size:13px;">Select MAG</strong>
                                        <div class="text-muted mt-1" style="font-size:11.5px;" id="step2Subtitle">Confirm or change the Master Assessment Group for the prospect</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-primary btn-sm mgm-action-btn" id="btnConfirmMag"><i class="fas fa-check me-1"></i>Confirm MAG</button>
                                    </div>
                                </div>
                                <div class="mt-2 mag-dropdown-wrap" id="step2MagArea">
                                    <div class="d-flex align-items-center gap-2 mb-2" id="step2CurrentMag">
                                        <span style="font-size:12px;"><strong>Current MAG:</strong> <span id="step2MagDisplay">—</span></span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" id="btnChangeMag" style="font-size:10px;"><i class="fas fa-pencil-alt me-1"></i>Change</button>
                                    </div>
                                    <div id="magDropdown">
                                        <div class="mag-search-wrap"><input type="text" class="form-control form-control-sm" id="magSearchInput" placeholder="Search MAG..." autocomplete="off" /></div>
                                        <div id="magList"></div>
                                    </div>
                                </div>
                                <div class="mgm-result-block" id="step2Result" style="display:none;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Recruitment Call (between Step 2 and Step 3) -->
                    <div class="mgm-action-card pending disabled" id="plivoCallCard" style="border-color:#6f42c1;background:#faf8ff;">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number" id="plivoCallIcon" style="background:#6f42c1;color:#fff;"><i class="fas fa-phone-alt" style="font-size:12px;"></i></span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;">
                                        <strong style="font-size:13px;">Recruitment Call (Plivo AI Agent)</strong>
                                        <div class="text-muted mt-1" style="font-size:11.5px;" id="plivoCallSubtitle">Call the prospect to gauge interest in freelance interviewing with Risebird</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-sm mgm-action-btn text-white" id="btnInitiateCall" style="background:#6f42c1;border-color:#6f42c1;"><i class="fas fa-phone-alt me-1"></i>Call Prospect</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnViewCallDetails" style="display:none;font-size:11px;padding:4px 10px;"><i class="fas fa-info-circle me-1"></i>Details</button>
                                    </div>
                                </div>
                                <div class="mgm-result-block" id="plivoCallResult" style="display:none;"></div>
                                <div id="plivoCallDetailsPanel" style="display:none;" class="mt-2 p-2 border rounded bg-white">
                                    <div class="row g-2" style="font-size:12px;">
                                        <div class="col-md-6"><strong>Disposition:</strong> <span id="plivoDetDisposition">—</span></div>
                                        <div class="col-md-6"><strong>Onboarding Pref:</strong> <span id="plivoDetPreference">—</span></div>
                                        <div class="col-md-6"><strong>KYC Accepted:</strong> <span id="plivoDetKyc">—</span></div>
                                        <div class="col-md-6"><strong>Duration:</strong> <span id="plivoDetDuration">—</span></div>
                                        <div class="col-md-6"><strong>Called At:</strong> <span id="plivoDetCalledAt">—</span></div>
                                        <div class="col-md-6"><strong>Called By:</strong> <span id="plivoDetCalledBy">—</span></div>
                                    </div>
                                    <div class="mt-2" id="plivoDetSummaryWrap" style="display:none;">
                                        <strong>Summary:</strong>
                                        <div id="plivoDetSummary" style="font-size:11.5px;background:#f8f9fa;border-radius:4px;padding:8px;margin-top:4px;max-height:120px;overflow-y:auto;"></div>
                                    </div>
                                    <div class="mt-2" id="plivoDetTranscriptWrap" style="display:none;">
                                        <strong>Transcript:</strong>
                                        <div id="plivoDetTranscript" style="font-size:11px;background:#f8f9fa;border-radius:4px;padding:8px;margin-top:4px;max-height:150px;overflow-y:auto;white-space:pre-wrap;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Send Invitation Email -->
                    <div class="mgm-action-card pending disabled" id="step3Card">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number pending" id="step3Number">3</span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;">
                                        <strong style="font-size:13px;">Send Invitation Email</strong>
                                        <div class="text-muted mt-1" style="font-size:11.5px;" id="step3Subtitle">Generates a MAG application link and sends the prospect an email with registration link and response options</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-primary btn-sm mgm-action-btn" id="btnSendInvitation"><i class="fas fa-paper-plane me-1"></i>Send Email</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm mgm-action-btn" id="btnResendInvitation" style="display:none;"><i class="fas fa-redo me-1"></i>Resend</button>
                                    </div>
                                </div>
                                <div class="mgm-result-block" id="step3Result" style="display:none;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Track Progress -->
                    <div class="mgm-action-card pending disabled" id="step4Card">
                        <div class="d-flex align-items-start gap-3">
                            <span class="mgm-step-number pending" id="step4Number">4</span>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                                    <div class="flex-grow-1" style="min-width:180px;">
                                        <strong style="font-size:13px;">Prospect Progress</strong>
                                        <div class="text-muted mt-1" style="font-size:11.5px;" id="step4Subtitle">Tracks the prospect's response and self-registration progress</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-outline-info btn-sm" id="btnCheckProgress"><i class="fas fa-sync-alt me-1"></i>Check Progress</button>
                                    </div>
                                </div>
                                <div class="mgm-result-block" id="step4Result" style="display:none;"></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer mgm-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-refresh-manage" id="btnRefreshManage"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-history" id="btnViewHistory"><i class="fas fa-history me-1"></i>History</button>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- History Modal -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header hm-header border-0 align-items-start">
                <div class="min-w-0 flex-grow-1 pe-2">
                    <p class="hm-eyebrow">Audit trail</p>
                    <h2 class="hm-title mb-0"><i class="fas fa-history me-2"></i>Record history</h2>
                    <small class="text-muted" id="historyModalSubject"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body hm-body">
                <div id="historyLoading" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Loading&hellip;</div>
                <div id="historyEmpty" class="text-center text-muted py-4" style="display:none;">No history recorded yet.</div>
                <ul class="history-timeline" id="historyList" style="display:none;"></ul>
            </div>
            <div class="modal-footer hm-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var currentRecordId = null, currentRecord = null;
    var canDelete = @(canDelete ? "true" : "false");
    var verificationToken = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val() || '';

    function showLoading() { document.getElementById('loadingOverlay').classList.add('show'); }
    document.getElementById('filterForm').addEventListener('submit', showLoading);
    document.querySelectorAll('.pagination .page-link').forEach(function (l) { l.addEventListener('click', showLoading); });
    function changePageSize(size) { showLoading(); var f = document.getElementById('filterForm'); f.querySelector('[name="pageSize"]').value = size; f.querySelector('[name="page"]').value = 1; f.submit(); }

    /* ── Table actions ──────────────────────────────────────────── */

    $(document).on('click', '.btn-manage-record', function () { openManageModal($(this).data('record-id')); });

    $(document).on('click', '.btn-delete-record', function () {
        var id = $(this).data('record-id');
        if (!confirm('Delete record #' + id + '? This cannot be undone.')) return;
        $.ajax({
            url: '@Url.Action("DeleteRecord", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: id },
            success: function (res) { if (res.success) { $('#row-' + id).fadeOut(300, function () { $(this).remove(); }); } else { alert(res.error || 'Could not delete.'); } },
            error: function () { alert('Delete request failed.'); }
        });
    });

    /* ── Modal ──────────────────────────────────────────────────── */

    function openManageModal(id) {
        currentRecordId = id; currentRecord = null;
        $('#mgmRecordNo').text('#' + id); $('#mgmLoading').show(); $('#mgmContent').hide(); resetPipeline();
        new bootstrap.Modal(document.getElementById('manageModal')).show();
        loadRecordDetails(id);
    }

    function loadRecordDetails(id) {
        $.ajax({
            url: '@Url.Action("GetRecordDetails", "NaukriOnboarding")', type: 'GET', data: { id: id }, timeout: 30000,
            success: function (res) {
                $('#mgmLoading').hide();
                if (!res.success) { $('#mgmContent').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>' + (res.error || 'Unknown error') + '</div>').show(); return; }
                currentRecord = res.record; populateModal(res.record); $('#mgmContent').show();
            },
            error: function (xhr, status) {
                $('#mgmLoading').hide();
                var msg = status === 'timeout' ? 'Request timed out.' : 'Failed to load record details.';
                $('#mgmContent').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>' + msg + ' <button class="btn btn-sm btn-outline-danger ms-2" onclick="loadRecordDetails(' + id + ');$(\'#mgmLoading\').show();$(\'#mgmContent\').hide();">Retry</button></div>').show();
            }
        });
    }

    function populateModal(r) {
        $('#mgmName').text(r.candidateName || '\u2014');
        $('#mgmRole').text(r.currentRole || '\u2014');
        $('#mgmExp').text(r.experienceYears || '\u2014');
        $('#mgmLocation').text(r.location || '\u2014');
        $('#mgmNotice').text(r.noticePeriod || '\u2014');
        var magFull = (r.magName || '\u2014') + (r.assessmentGroupName ? ' \u2192 ' + r.assessmentGroupName : '');
        $('#mgmMag').text(magFull).attr('title', magFull);
        $('#mgmEducation').text(r.education || '\u2014');
        $('#mgmSalary').text(r.salary || '\u2014');
        $('#mgmPastExp').text(r.pastExperience || '\u2014');
        $('#mgmReceived').text(r.receivedAt || '\u2014');
        $('#mgmSubject').text(r.subject || '\u2014');
        var skillsFull = r.keySkills || '\u2014';
        $('#mgmSkills').text(skillsFull).attr('title', skillsFull);
        updateStatusBadge(r.status || 'Open');

        $('#mgmParsedEmail').text(r.parsedEmail || '\u2014');
        $('#mgmParsedPhone').text(r.parsedPhone || '\u2014');

        if (r.employmentCompanyName) { $('#mgmCompany').text(r.employmentCompanyName); }
        if (r.employmentIsEmployed === true) { $('#mgmEmployed').html('<span class="employed-yes"><i class="fas fa-check-circle me-1"></i>Yes</span>'); }
        else if (r.employmentIsEmployed === false) { $('#mgmEmployed').html('<span class="employed-no"><i class="fas fa-times-circle me-1"></i>No</span>'); }

        if (r.hasResumeLink) { $('#btnViewResume').attr('href', r.resumeLink).show(); } else { $('#btnViewResume').hide(); }
        syncAutomationBadge(r);
        syncPlivoCallUI(r);
        syncPipeline(r);
    }

    function syncAutomationBadge(r) {
        var badge = $('#mgmAutomationBadge');
        if (!r.automationStatus) { badge.hide(); return; }
        var labels = {
            'ParsingResume':'Parsing Resume','SelectingChannel':'Selecting Channel',
            'CallTriggered':'Call Triggered','CallFailed':'Call Failed','AwaitingRetry':'Retry Pending',
            'SendingEmail':'Sending Email','EmailSent':'Email Sent','ManualRequired':'Manual Required',
            'Cold':'Cold','Completed':'Completed','Error':'Error'
        };
        var colors = {
            'EmailSent':'#198754','Completed':'#198754','Cold':'#dc3545','ManualRequired':'#e67e22','Error':'#e67e22',
            'CallTriggered':'#0d6efd','ParsingResume':'#0d6efd','SelectingChannel':'#0d6efd','SendingEmail':'#0d6efd',
            'AwaitingRetry':'#6c757d','CallFailed':'#6c757d'
        };
        var label = labels[r.automationStatus] || r.automationStatus;
        var color = colors[r.automationStatus] || '#6c757d';
        badge.html('<i class="fas fa-robot me-1"></i>' + label +
            (r.plivoCallAttemptsTotal > 0 ? ' (' + r.plivoCallAttemptsTotal + '/5 calls)' : ''))
            .css({ background: color, color: '#fff', display: 'inline-block' }).show();
    }

    function updateStatusBadge(s) {
        var b = $('#mgmStatusBadge'); b.text(s).removeClass('bg-warning bg-primary bg-success bg-secondary bg-danger text-dark');
        switch ((s||'').toLowerCase()) {
            case 'open': b.addClass('bg-warning text-dark'); break;
            case 'inprogress': b.addClass('bg-primary'); break;
            case 'verified': b.addClass('bg-success'); break;
            case 'onboarded': b.addClass('bg-success'); break;
            case 'rejected': b.addClass('bg-danger'); break;
            case 'closed': b.addClass('bg-secondary'); break;
            default: b.addClass('bg-light text-dark');
        }
    }

    function resetPipeline() {
        ['step1Card','step2Card','step3Card','step4Card'].forEach(function(id){ $('#'+id).removeClass('completed failed disabled').addClass('pending'); });
        ['step1Number','step2Number','step3Number','step4Number'].forEach(function(id){ $('#'+id).removeClass('completed failed running').addClass('pending'); });
        $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
        $('#step1Result, #step2Result, #step3Result, #step4Result').hide().empty();
        $('#plivoCallResult').hide().empty(); $('#plivoCallDetailsPanel').hide();
        $('#btnInitiateCall').show().prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Prospect');
        $('#btnViewCallDetails').hide();
        $('#plivoCallCard').css('border-color', '#6f42c1').css('background', '#faf8ff');
        $('#plivoCallIcon').css('background', '#6f42c1');
        $('#plivoCallSubtitle').html('Call the prospect to gauge interest in freelance interviewing with Risebird');
        for (var s = 1; s <= 4; s++) $('#step'+s+'Subtitle').html(defaultSubtitles[s]);
        $('#btnParseResume').prop('disabled',false).html('<i class="fas fa-file-invoice me-1"></i>Parse Resume');
        $('#btnConfirmMag').prop('disabled',false).html('<i class="fas fa-check me-1"></i>Confirm MAG');
        $('#btnSendInvitation').prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Send Email').show();
        $('#btnResendInvitation').hide();
        $('#btnCheckProgress').prop('disabled',false).html('<i class="fas fa-sync-alt me-1"></i>Check Progress');
        $('#resumeUploadArea').hide(); $('#resumeFileInput').val(''); $('#uploadProgress, #uploadResult').hide();
        $('#mgmParsedEmail').text('\u2014'); $('#mgmParsedPhone').text('\u2014');
        $('#mgmCompany').text('\u2014'); $('#mgmEmployed').text('\u2014');
        $('#magDropdown').hide();
        $('#step2MagDisplay').text('\u2014');
    }

    /* ── MAG edit dropdown (Step 2) ──────────────────────────────── */
    var allMags = [], magsLoaded = false;
    var selectedMag = null;

    function loadMags(callback) {
        if (magsLoaded) { if (callback) callback(); return; }
        $.ajax({
            url: '@Url.Action("GetAllMags", "NaukriOnboarding")', type: 'GET',
            success: function (res) {
                if (res.success && res.data) { allMags = res.data; magsLoaded = true; }
                if (callback) callback();
            }
        });
    }

    function initStep2Mag(r) {
        var magFull = (r.magName || '\u2014') + (r.assessmentGroupName ? ' \u2192 ' + r.assessmentGroupName : '');
        $('#step2MagDisplay').text(magFull);
        selectedMag = r.resolvedAssessmentGroupId > 0
            ? { magName: r.magName, assessmentGroupId: r.resolvedAssessmentGroupId, assessmentGroupName: r.assessmentGroupName }
            : null;
        $('#magDropdown').hide();
    }

    $('#btnChangeMag').on('click', function (e) {
        e.stopPropagation();
        var $dd = $('#magDropdown');
        if ($dd.is(':visible')) { $dd.hide(); return; }
        loadMags(function () {
            renderMagList('');
            $dd.show();
            $('#magSearchInput').val('').focus();
        });
    });

    $(document).on('click', function (e) {
        if (!$(e.target).closest('.mag-dropdown-wrap').length) $('#magDropdown').hide();
    });

    $('#magSearchInput').on('input', function () { renderMagList($(this).val()); });

    function renderMagList(filter) {
        var $list = $('#magList').empty();
        var lf = (filter || '').toLowerCase();
        var currentMag = currentRecord ? (currentRecord.magName || '') : '';
        var count = 0;
        $.each(allMags, function (_, m) {
            var display = m.magName + (m.assessmentGroupName ? ' \u2192 ' + m.assessmentGroupName : '');
            if (lf && display.toLowerCase().indexOf(lf) === -1) return;
            var cls = 'mag-item' + (m.magName === currentMag ? ' active' : '');
            var $item = $('<div class="' + cls + '">').html('<span>' + $('<span>').text(m.magName).html() + '</span><span class="mag-ag">' + $('<span>').text(m.assessmentGroupName || '').html() + '</span>');
            $item.data('mag', m);
            $list.append($item);
            count++;
        });
        if (count === 0) $list.append('<div class="mag-no-results">No matching MAGs found</div>');
    }

    $(document).on('click', '#magList .mag-item', function () {
        var m = $(this).data('mag');
        if (!m || !currentRecordId) return;
        var oldMag = currentRecord ? (currentRecord.magName || '') : '';
        if (m.magName === oldMag) { $('#magDropdown').hide(); return; }

        $.ajax({
            url: '@Url.Action("UpdateField", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, fieldName: 'MagName', oldValue: oldMag, newValue: m.magName },
            success: function (res) {
                if (res.success) {
                    var magFull = m.magName + (m.assessmentGroupName ? ' \u2192 ' + m.assessmentGroupName : '');
                    $('#step2MagDisplay').text(magFull);
                    $('#mgmMag').text(magFull).attr('title', magFull);
                    selectedMag = m;
                    if (currentRecord) {
                        currentRecord.magName = m.magName;
                        currentRecord.resolvedAssessmentGroupId = m.assessmentGroupId;
                        currentRecord.assessmentGroupName = m.assessmentGroupName;
                    }
                } else { alert(res.error || 'Failed to update MAG.'); }
                $('#magDropdown').hide();
            }
        });
    });

    $('#btnConfirmMag').on('click', function () {
        if (!currentRecordId) return;
        var r = currentRecord;
        var agId = r ? r.resolvedAssessmentGroupId : 0;
        var magName = r ? r.magName : '';
        if (!agId || agId <= 0) {
            alert('No MAG resolved. Please select a MAG first.');
            return;
        }
        markStep(2, 'completed', '<i class="fas fa-check-circle text-success me-1"></i>MAG confirmed: <strong>' + $('<span>').text(magName).html() + '</strong> (AG #' + agId + ')');
    });

    function syncPipeline(r) {
        var step1Done = false, step2Done = false, step3Done = false;
        var step1Blocked = false;

        initStep2Mag(r);

        // Step 1: Parse Resume
        if (r.resumeParseCompleted === true) {
            var statusMsg = '';
            if (r.isExistingInterviewer === true) {
                statusMsg = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This email already exists in the system (UserId: ' + r.existingUserId + ').</span>'
                          + '<br/><span style="color:#842029;font-size:12px;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Please edit the email to an alternative email address for this prospect to continue.</span>';
                markStep(1, 'failed', buildStep1Html(r.parsedEmail, r.parsedPhone, statusMsg));
                $('#step1Subtitle').html('<span style="color:#842029;font-size:11px;font-weight:500;">Duplicate email \u2014 edit to proceed</span>');
                step1Blocked = true;
            } else {
                statusMsg = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>New prospect \u2014 ready to proceed.</span>';
                markStep(1, 'completed', buildStep1Html(r.parsedEmail, r.parsedPhone, statusMsg));
                step1Done = true;
            }
        } else if (!r.hasResumeLink) {
            $('#step1Subtitle').html('No resume available. <strong>Upload a resume to proceed.</strong>');
            $('#btnParseResume').prop('disabled', true);
        }

        // Step 2: Select MAG
        if (r.resolvedAssessmentGroupId > 0) {
            var magLabel = (r.magName || '\u2014') + (r.assessmentGroupName ? ' \u2192 ' + r.assessmentGroupName : '');
            if (r.invitationEmailSent === true || r.applicationLink) {
                markStep(2, 'completed', '<i class="fas fa-check-circle text-success me-1"></i>MAG confirmed: <strong>' + $('<span>').text(magLabel).html() + '</strong> (AG #' + r.resolvedAssessmentGroupId + ')');
                step2Done = true;
            } else {
                $('#step2Subtitle').html('MAG auto-resolved: <strong>' + $('<span>').text(magLabel).html() + '</strong>. Confirm or change, then proceed.');
            }
        }

        // Step 3: Send Invitation Email
        if (r.invitationEmailSent === true) {
            var html3 = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Invitation email sent</span>';
            if (r.invitationEmailSentAt) html3 += ' on ' + r.invitationEmailSentAt;
            if (r.applicationLink) html3 += '<br/><span style="font-size:11px;"><strong>MAG Link:</strong> <a href="' + r.applicationLink + '" target="_blank" style="word-break:break-all;">' + r.applicationLink + '</a></span>';
            markStep(3, 'completed', html3);
            $('#btnSendInvitation').hide(); $('#btnResendInvitation').show();
            step3Done = true;
        }

        // Step 4: Track Progress
        if (r.selfRegistrationCompleted === true || r.onboardingCompleted === true) {
            var html4 = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Prospect has self-registered and is onboarded!</span>';
            if (r.onboardedUserId) html4 += '<br/><strong>UserId:</strong> ' + r.onboardedUserId;
            markStep(4, 'completed', html4);
        } else if (r.prospectResponse) {
            var respLabel = {'NeedClarity':'Needs More Details','ManualSupport':'Requested Manual Help','NotInterested':'Not Interested'}[r.prospectResponse] || r.prospectResponse;
            var respClass = r.prospectResponse === 'NotInterested' ? 'text-danger' : 'text-info';
            var html4r = '<span class="' + respClass + '"><i class="fas fa-reply me-1"></i>Prospect responded: <strong>' + respLabel + '</strong></span>';
            if (r.prospectResponseAt) html4r += ' on ' + r.prospectResponseAt;
            if (r.prospectResponse === 'ManualSupport') {
                html4r += '<br/><span style="color:#e67e22;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Prospect needs manual assistance with onboarding. Reach out to help.</span>';
            } else if (r.prospectResponse === 'NeedClarity') {
                html4r += '<br/><span style="color:#3498db;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Prospect needs more information. Contact them to clarify.</span>';
            }
            markStep(4, 'failed', html4r);
        }

        // ── Explicit step enablement pass ──
        if (step1Blocked) {
            $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
        } else {
            if (step1Done) { $('#step2Card').removeClass('disabled failed'); $('#step2Number').removeClass('failed'); }
            if (step2Done) { $('#plivoCallCard').removeClass('disabled'); $('#step3Card').removeClass('disabled'); }
            if (step3Done) { $('#step4Card').removeClass('disabled'); $('#step4Subtitle').html('Waiting for prospect to respond or self-register...'); }
        }

        // Sync Plivo button disabled state with card disabled state
        if ($('#plivoCallCard').hasClass('disabled')) {
            $('#btnInitiateCall').prop('disabled', true);
        } else if (r.parsedPhone) {
            var pStatus = r.plivoCallStatus || '';
            var pDisp = r.plivoProspectDisposition || '';
            if (pStatus === 'triggered' || pStatus === 'initiated') {
                $('#btnInitiateCall').prop('disabled', true);
            } else if ((pStatus === 'completed' || pStatus === 'answered') && (pDisp === 'interested' || pDisp === 'unsubscribe')) {
                // Call completed positively or unsubscribed — no retry
            } else {
                $('#btnInitiateCall').prop('disabled', false);
            }
        }
    }

    var defaultSubtitles = {
        1: 'Extracts email &amp; phone from the resume PDF and checks if the interviewer already exists in the system',
        2: 'Confirm or change the Master Assessment Group for the prospect',
        3: 'Generates a MAG application link and sends the prospect an email with registration link and response options',
        4: 'Tracks the prospect\u2019s response and self-registration progress'
    };

    function markStep(step, state, message) {
        var card = $('#step'+step+'Card'), num = $('#step'+step+'Number'), result = $('#step'+step+'Result');
        card.removeClass('pending completed failed disabled'); num.removeClass('pending completed failed running');
        if (state === 'completed') {
            card.addClass('completed'); num.addClass('completed');
            if (step===1) { $('#btnParseResume').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Parsed'); $('#step1Subtitle').html('<span class="text-success" style="font-size:11px;">Resume parsed successfully</span>'); }
            if (step===2) { $('#btnConfirmMag').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Confirmed'); $('#step2Subtitle').html('<span class="text-success" style="font-size:11px;">MAG confirmed</span>'); }
            if (step===3) { $('#btnSendInvitation').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Sent'); $('#step3Subtitle').html('<span class="text-success" style="font-size:11px;">Invitation email sent successfully</span>'); }
            if (step===4) { $('#btnCheckProgress').prop('disabled',true); $('#step4Subtitle').html('<span class="text-success" style="font-size:11px;">Prospect onboarded</span>'); }
        } else if (state === 'failed') { card.addClass('failed'); num.addClass('failed'); }
        else if (state === 'running') { num.addClass('running'); }
        if (message) result.html(message).show();

        if (step === 1 && state === 'completed') { $('#step2Card').removeClass('disabled'); }
        if (step === 2 && state === 'completed') { $('#plivoCallCard').removeClass('disabled'); $('#step3Card').removeClass('disabled'); $('#btnInitiateCall').prop('disabled', false); }
        if (step === 3 && state === 'completed') { $('#step4Card').removeClass('disabled'); }
    }

    /* ── Status change ──────────────────────────────────────── */

    $(document).on('click', '.btn-mgm-status', function () {
        var status = $(this).data('status'); if (!currentRecordId) return;
        $.ajax({ url: '@Url.Action("UpdateStatus", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, status: status },
            success: function (res) { if (res.success) { updateStatusBadge(res.status); if (currentRecord) currentRecord.status = res.status; } }
        });
    });

    /* ── Resume Upload ──────────────────────────────────────── */

    $('#btnUploadResume').on('click', function () { $('#resumeUploadArea').toggle(); });
    $('#btnCancelUpload').on('click', function () { $('#resumeUploadArea').hide(); $('#resumeFileInput').val(''); $('#uploadResult').hide(); });

    $('#btnConfirmUpload').on('click', function () {
        if (!currentRecordId) return;
        var fileInput = document.getElementById('resumeFileInput');
        if (!fileInput.files || fileInput.files.length === 0) { alert('Please select a file.'); return; }

        var formData = new FormData();
        formData.append('id', currentRecordId);
        formData.append('resumeFile', fileInput.files[0]);
        formData.append('__RequestVerificationToken', verificationToken);

        $('#uploadProgress').show(); $('#uploadResult').hide(); $('#btnConfirmUpload').prop('disabled', true);

        $.ajax({
            url: '@Url.Action("UploadResume", "NaukriOnboarding")', type: 'POST',
            data: formData, processData: false, contentType: false, timeout: 120000,
            success: function (res) {
                $('#uploadProgress').hide(); $('#btnConfirmUpload').prop('disabled', false);
                if (res.success) {
                    $('#uploadResult').html('<span class="text-success" style="font-size:11px;"><i class="fas fa-check-circle me-1"></i>Uploaded.</span>').show();
                    $('#btnViewResume').attr('href', res.resumeLink).show();
                    $('#btnParseResume').prop('disabled', false);
                    $('#step1Subtitle').text('Resume uploaded. Click Parse Resume to extract contact details.');
                    if (currentRecord) { currentRecord.resumeLink = res.resumeLink; currentRecord.hasResumeLink = true; }
                    setTimeout(function(){ $('#resumeUploadArea').hide(); }, 2000);
                } else {
                    $('#uploadResult').html('<span class="text-danger" style="font-size:11px;"><i class="fas fa-times-circle me-1"></i>' + (res.error || 'Upload failed.') + '</span>').show();
                }
            },
            error: function () {
                $('#uploadProgress').hide(); $('#btnConfirmUpload').prop('disabled', false);
                $('#uploadResult').html('<span class="text-danger" style="font-size:11px;"><i class="fas fa-times-circle me-1"></i>Upload failed.</span>').show();
            }
        });
    });

    /* ── Step 1: Parse Resume ───────────────────────────────── */

    $('#btnParseResume').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Parsing...'); $('#step1Number').removeClass('pending').addClass('running');
        $('#step1Subtitle').text('Extracting email and phone from resume...');

        $.ajax({ url: '@Url.Action("ParseResume", "NaukriOnboarding")', type: 'POST', timeout: 120000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    var statusMsg = '';
                    if (res.isExistingInterviewer) {
                        statusMsg = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This email already exists in the system (UserId: ' + res.existingUserId + ').</span>'
                                  + '<br/><span style="color:#842029;font-size:12px;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Please edit the email to an alternative email for this prospect to continue.</span>';
                        markStep(1, 'failed', buildStep1Html(res.parsedEmail, res.parsedPhone, statusMsg));
                        $('#step1Subtitle').html('<span style="color:#842029;font-size:11px;font-weight:500;">Duplicate email \u2014 edit to proceed</span>');
                        $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
                    } else {
                        statusMsg = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message||'New prospect.') + '</span>';
                        markStep(1, 'completed', buildStep1Html(res.parsedEmail, res.parsedPhone, statusMsg));
                    }
                    $('#mgmParsedEmail').text(res.parsedEmail || '\u2014');
                    $('#mgmParsedPhone').text(res.parsedPhone || '\u2014');
                    if (currentRecord) { currentRecord.parsedEmail = res.parsedEmail; currentRecord.parsedPhone = res.parsedPhone; currentRecord.resumeParseCompleted = true; currentRecord.isExistingInterviewer = res.isExistingInterviewer; }
                } else {
                    var errHtml = res.error || 'Parse failed.';
                    if (res.needsUpload) errHtml += '<br/><em style="font-size:11px;">Upload a valid resume to proceed.</em>';
                    markStep(1, 'failed', errHtml);
                    btn.prop('disabled',false).html('<i class="fas fa-file-invoice me-1"></i>Retry');
                    $('#step1Subtitle').text('Extracts email & phone from the resume PDF and checks if the interviewer already exists');
                }
            },
            error: function (xhr, status) {
                var msg = status === 'timeout' ? 'Request timed out. Please try again.' : 'Request failed.';
                markStep(1, 'failed', msg);
                btn.prop('disabled',false).html('<i class="fas fa-file-invoice me-1"></i>Retry');
                $('#step1Subtitle').html(defaultSubtitles[1]);
            }
        });
    });

    /* ── Step 2: Send Invitation Email (MAG link generated automatically) ── */

    $('#btnSendInvitation').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Sending...'); $('#step3Number').removeClass('pending').addClass('running');
        $('#step3Subtitle').text('Generating MAG link & sending invitation email...');
        $.ajax({ url: '@Url.Action("SendInvitationEmail", "NaukriOnboarding")', type: 'POST', timeout: 60000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function(res) {
                if (res.success) {
                    var html3 = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message || 'Email sent.') + '</span>';
                    if (res.applicationLink) html3 += '<br/><span style="font-size:11px;"><strong>MAG Link:</strong> <a href="' + res.applicationLink + '" target="_blank" style="word-break:break-all;">' + res.applicationLink + '</a></span>';
                    markStep(3, 'completed', html3);
                    if (currentRecord) { currentRecord.invitationEmailSent = true; currentRecord.applicationLink = res.applicationLink; }
                    $('#btnSendInvitation').hide(); $('#btnResendInvitation').show();
                    $('#step4Card').removeClass('disabled');
                    $('#step4Subtitle').html('Waiting for prospect to respond or self-register...');
                } else {
                    markStep(3, 'failed', res.error || 'Failed to send email.');
                    btn.prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Retry');
                    $('#step3Subtitle').html(defaultSubtitles[3]);
                }
            },
            error: function(){ markStep(3, 'failed', 'Request failed.'); btn.prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Retry'); $('#step3Subtitle').html(defaultSubtitles[3]); }
        });
    });

    $('#btnResendInvitation').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Sending...');
        $.ajax({ url: '@Url.Action("SendInvitationEmail", "NaukriOnboarding")', type: 'POST', timeout: 60000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function(res) {
                if (res.success) { btn.html('<i class="fas fa-check me-1"></i>Resent').prop('disabled',true); }
                else { alert(res.error || 'Failed.'); btn.prop('disabled',false).html('<i class="fas fa-redo me-1"></i>Resend'); }
            },
            error: function(){ alert('Request failed.'); btn.prop('disabled',false).html('<i class="fas fa-redo me-1"></i>Resend'); }
        });
    });

    /* ── Step 4: Check Progress ─────────────────────────────── */

    $('#btnCheckProgress').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Checking...');
        $('#step4Number').removeClass('pending').addClass('running');
        $('#step4Subtitle').text('Checking if the prospect has self-registered...');
        $.ajax({ url: '@Url.Action("CheckSelfRegistration", "NaukriOnboarding")', type: 'GET', data: { id: currentRecordId },
            success: function(res) {
                btn.prop('disabled',false).html('<i class="fas fa-sync-alt me-1"></i>Check Progress');
                $('#step4Number').removeClass('running').addClass('pending');
                if (res.success && res.completed) {
                    markStep(4, 'completed', '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Prospect has self-registered and is onboarded!</span><br/><strong>UserId:</strong> ' + (res.userId || '\u2014'));
                    updateStatusBadge('Onboarded');
                    if (currentRecord) { currentRecord.selfRegistrationCompleted = true; currentRecord.onboardingCompleted = true; currentRecord.onboardedUserId = res.userId; }
                } else if (res.success) {
                    $('#step4Result').html('<span class="text-muted" style="font-size:12px;"><i class="fas fa-clock me-1"></i>' + (res.reason || 'Prospect has not yet completed self-registration.') + '</span>').show();
                    $('#step4Subtitle').text('Waiting for prospect to respond or self-register...');
                } else {
                    $('#step4Result').html('<span class="text-danger" style="font-size:12px;">' + (res.error || 'Error checking.') + '</span>').show();
                    $('#step4Subtitle').html(defaultSubtitles[4]);
                }
            },
            error: function(){ btn.prop('disabled',false).html('<i class="fas fa-sync-alt me-1"></i>Check Progress'); $('#step4Number').removeClass('running').addClass('pending'); $('#step4Subtitle').html(defaultSubtitles[4]); alert('Request failed.'); }
        });
    });

    /* ── Step 1 editable result builder ──────────────────────── */

    function buildStep1Html(email, phone, statusMsg) {
        var e = email || '\u2014', p = phone || '\u2014';
        return '<div class="d-flex align-items-center flex-wrap gap-2 mb-1">'
            + '<span><strong>Email:</strong> <span class="s1-email-val">' + e + '</span>'
            + ' <button type="button" class="inline-edit-btn btn-s1-edit" data-field="email" title="Edit email"><i class="fas fa-pencil-alt"></i></button></span>'
            + '<span class="text-muted">|</span>'
            + '<span><strong>Phone:</strong> <span class="s1-phone-val">' + p + '</span>'
            + ' <button type="button" class="inline-edit-btn btn-s1-edit" data-field="phone" title="Edit phone"><i class="fas fa-pencil-alt"></i></button></span>'
            + '</div>'
            + '<div class="s1-edit-area" style="display:none;margin-bottom:6px;"></div>'
            + (statusMsg ? '<div class="s1-status-msg">' + statusMsg + '</div>' : '');
    }

    /* ── Inline Edit: Email & Phone (delegated from Step 1 result) ── */

    $(document).on('click', '.btn-s1-edit', function () {
        var field = $(this).data('field');
        var current = field === 'email'
            ? ((currentRecord && currentRecord.parsedEmail) || '')
            : ((currentRecord && currentRecord.parsedPhone) || '');
        var label = field === 'email' ? 'Email' : 'Phone';
        var inputType = field === 'email' ? 'email' : 'tel';

        var editHtml = '<div class="inline-edit-group">'
            + '<strong style="font-size:12px;min-width:48px;">' + label + ':</strong> '
            + '<input type="' + inputType + '" class="s1-edit-input" data-field="' + field + '" value="' + current.replace(/"/g, '&quot;') + '" />'
            + '<button type="button" class="btn btn-sm btn-primary btn-s1-save" data-field="' + field + '"><i class="fas fa-check"></i></button>'
            + '<button type="button" class="btn btn-sm btn-outline-secondary btn-s1-cancel"><i class="fas fa-times"></i></button>'
            + '</div>';
        $('#step1Result .s1-edit-area').html(editHtml).show();
        $('#step1Result .s1-edit-area .s1-edit-input').focus();
    });

    $(document).on('click', '.btn-s1-cancel', function () {
        $('#step1Result .s1-edit-area').hide().empty();
    });

    $(document).on('click', '.btn-s1-save', function () {
        var field = $(this).data('field');
        var fieldName = field === 'email' ? 'ParsedEmail' : 'ParsedPhone';
        var newVal = $('#step1Result .s1-edit-input[data-field="' + field + '"]').val().trim();
        if (!newVal) { alert((field === 'email' ? 'Email' : 'Phone') + ' cannot be empty.'); return; }

        var oldVal = field === 'email'
            ? ((currentRecord && currentRecord.parsedEmail) || '')
            : ((currentRecord && currentRecord.parsedPhone) || '');
        if (newVal === oldVal) { $('#step1Result .s1-edit-area').hide().empty(); return; }

        var btn = $(this); btn.prop('disabled', true);
        $.ajax({
            url: '@Url.Action("SaveManualOverride", "NaukriOnboarding")', type: 'POST', timeout: 30000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, fieldName: fieldName, oldValue: oldVal, newValue: newVal },
            success: function (res) {
                btn.prop('disabled', false);
                if (res.success) {
                    $('#step1Result .s1-edit-area').hide().empty();
                    if (field === 'email') {
                        currentRecord.parsedEmail = newVal;
                        currentRecord.isExistingInterviewer = res.isExistingInterviewer;
                        currentRecord.existingUserId = res.existingUserId;
                        $('#step1Result .s1-email-val').text(newVal);
                        $('#mgmParsedEmail').text(newVal);
                        var newStatusMsg = '';
                        if (res.isExistingInterviewer) {
                            newStatusMsg = '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>This email also exists in the system (UserId: ' + res.existingUserId + ').</span>'
                                         + '<br/><span style="color:#842029;font-size:12px;font-weight:500;"><i class="fas fa-info-circle me-1"></i>Try a different email address for this prospect.</span>';
                            $('#step1Card').removeClass('completed pending').addClass('failed');
                            $('#step1Number').removeClass('completed pending').addClass('failed');
                            $('#step1Subtitle').html('<span style="color:#842029;font-size:11px;font-weight:500;">Duplicate email \u2014 edit to proceed</span>');
                            $('#step2Card, #step3Card, #step4Card, #plivoCallCard').addClass('disabled');
                        } else {
                            newStatusMsg = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message || 'Email updated. Interviewer is new to the system.') + '</span>';
                            $('#step1Card').removeClass('failed pending').addClass('completed');
                            $('#step1Number').removeClass('failed pending').addClass('completed');
                            $('#step1Subtitle').html('<span class="text-success" style="font-size:11px;">Email verified \u2014 new to the system</span>');
                            $('#btnParseResume').prop('disabled', true).html('<i class="fas fa-check me-1"></i>Parsed');
                            $('#step2Card').removeClass('disabled failed').addClass('pending');
                            $('#step2Number').removeClass('failed').addClass('pending');
                            $('#step2Subtitle').html(defaultSubtitles[2]);
                        }
                        $('#step1Result .s1-status-msg').html(newStatusMsg);
                    } else {
                        currentRecord.parsedPhone = newVal;
                        $('#step1Result .s1-phone-val').text(newVal);
                        $('#mgmParsedPhone').text(newVal);
                    }
                    
                } else { alert(res.error || 'Failed to update.'); }
            },
            error: function () { btn.prop('disabled', false); alert('Request failed.'); }
        });
    });

