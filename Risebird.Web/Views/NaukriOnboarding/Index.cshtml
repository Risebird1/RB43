                <div class="min-w-0 flex-grow-1 pe-2">
                    <p class="hm-eyebrow">Audit trail</p>
                    <h2 class="hm-title mb-0"><i class="fas fa-history me-2"></i>Record history</h2>
                    <small class="text-muted" id="historyModalSubject"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body hm-body">
                <div id="historyLoading" class="text-center py-4"><div class="spinner-border spinner-border-sm"></div> Loading&hellip;</div>
                <div id="historyEmpty" class="text-center text-muted py-4" style="display:none;">No history recorded yet.</div>
                <ul class="history-timeline" id="historyList" style="display:none;"></ul>
            </div>
            <div class="modal-footer hm-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk assign by MAG -->
<div class="modal fade" id="bulkAssignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-0">
                <div>
                    <h5 class="fw-bold mb-0"><i class="fas fa-people-arrows text-dark me-2"></i>Bulk assign tickets by MAG</h5>
                    <small class="text-muted">Distribute all prospects of the selected MAG(s) to a single operator.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:13px;">Assign to operator</label>
                        <select id="baOperator" class="form-select form-select-sm">
                            <option value="">Loading operators…</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" style="font-size:13px;">Which tickets</label>
                        <select id="baScope" class="form-select form-select-sm">
                            <option value="unassigned" selected>Only unassigned tickets</option>
                            <option value="active">All active tickets (open / in-progress)</option>
                            <option value="all">Every ticket in the MAG</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="form-label fw-semibold mb-0" style="font-size:13px;">Select MAG(s)</label>
                    <input type="text" id="baMagSearch" class="form-control form-control-sm" placeholder="Search MAG…" style="max-width:220px;" />
                </div>
                <div id="baMagLoading" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Loading MAGs…</div>
                <div id="baMagListWrap" class="d-none" style="max-height:340px;overflow:auto;border:1px solid #e2e8f0;border-radius:8px;">
                    <table class="table table-sm table-hover mb-0 align-middle" style="font-size:12.5px;">
                        <thead class="table-light" style="position:sticky;top:0;z-index:1;">
                            <tr>
                                <th style="width:36px;"><input type="checkbox" id="baSelectAll" title="Select all shown" /></th>
                                <th>MAG</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Unassigned</th>
                                <th class="text-end">Active</th>
                            </tr>
                        </thead>
                        <tbody id="baMagList"></tbody>
                    </table>
                </div>
                <div id="baMagEmpty" class="text-center text-muted py-4 d-none">No MAGs with prospects found.</div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-between">
                <span id="baSelectionInfo" class="text-muted" style="font-size:12.5px;">No MAG selected.</span>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="baAssignBtn" class="btn btn-dark btn-sm" disabled><i class="fas fa-people-arrows me-1"></i>Assign</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    var currentRecordId = null, currentRecord = null;
    var canDelete = @(canDelete ? "true" : "false");
    var verificationToken = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val() || '';

    function showLoading() { document.getElementById('loadingOverlay').classList.add('show'); }
    document.getElementById('filterForm').addEventListener('submit', showLoading);
    document.querySelectorAll('.pagination .page-link').forEach(function (l) { l.addEventListener('click', showLoading); });
    function changePageSize(size) { showLoading(); var f = document.getElementById('filterForm'); f.querySelector('[name="pageSize"]').value = size; f.querySelector('[name="page"]').value = 1; f.submit(); }

    /* ── Table actions ──────────────────────────────────────────── */

    $(document).on('click', '.btn-manage-record', function () { openManageModal($(this).data('record-id')); });

    $(document).on('click', '.btn-delete-record', function () {
        var id = $(this).data('record-id');
        if (!confirm('Delete record #' + id + '? This cannot be undone.')) return;
        $.ajax({
            url: '@Url.Action("DeleteRecord", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: id },
            success: function (res) { if (res.success) { $('#row-' + id).fadeOut(300, function () { $(this).remove(); }); } else { alert(res.error || 'Could not delete.'); } },
            error: function () { alert('Delete request failed.'); }
        });
    });

    /* ── Modal ──────────────────────────────────────────────────── */

    function openManageModal(id) {
        currentRecordId = id; currentRecord = null;
        $('#mgmRecordNo').text('#' + id); $('#mgmLoading').show(); $('#mgmContent').hide(); resetPipeline();
        new bootstrap.Modal(document.getElementById('manageModal')).show();
        loadRecordDetails(id);
    }

    function loadRecordDetails(id) {
        $.ajax({
            url: '@Url.Action("GetRecordDetails", "NaukriOnboarding")', type: 'GET', data: { id: id }, timeout: 30000,
            success: function (res) {
                $('#mgmLoading').hide();
                if (!res.success) { $('#mgmContent').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>' + (res.error || 'Unknown error') + '</div>').show(); return; }
                currentRecord = res.record; populateModal(res.record); $('#mgmContent').show();
            },
            error: function (xhr, status) {
                $('#mgmLoading').hide();
                var msg = status === 'timeout' ? 'Request timed out.' : 'Failed to load record details.';
                $('#mgmContent').html('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>' + msg + ' <button class="btn btn-sm btn-outline-danger ms-2" onclick="loadRecordDetails(' + id + ');$(\'#mgmLoading\').show();$(\'#mgmContent\').hide();">Retry</button></div>').show();
            }
        });
    }

    function populateModal(r) {
        $('#mgmName').text(r.candidateName || '\u2014');
        $('#mgmRole').text(r.currentRole || '\u2014');
        $('#mgmExp').text(r.experienceYears || '\u2014');
        $('#mgmLocation').text(r.location || '\u2014');
        $('#mgmNotice').text(r.noticePeriod || '\u2014');
        var magFull = (r.magName || '\u2014') + (r.assessmentGroupName ? ' \u2192 ' + r.assessmentGroupName : '');
        $('#mgmMag').text(magFull).attr('title', magFull);
        $('#mgmEducation').text(r.education || '\u2014');
        $('#mgmSalary').text(r.salary || '\u2014');
        $('#mgmPastExp').text(r.pastExperience || '\u2014');
        $('#mgmReceived').text(r.receivedAt || '\u2014');
        $('#mgmSubject').text(r.subject || '\u2014');
        var skillsFull = r.keySkills || '\u2014';
        $('#mgmSkills').text(skillsFull).attr('title', skillsFull);
        updateStatusBadge(r.ticketStatus || 'Open');

        $('#mgmParsedEmail').text(r.parsedEmail || '\u2014');
        $('#mgmParsedPhone').text(r.parsedPhone || '\u2014');

        if (r.employmentCompanyName) { $('#mgmCompany').text(r.employmentCompanyName); }
        if (r.employmentIsEmployed === true) { $('#mgmEmployed').html('<span class="employed-yes"><i class="fas fa-check-circle me-1"></i>Yes</span>'); }
        else if (r.employmentIsEmployed === false) { $('#mgmEmployed').html('<span class="employed-no"><i class="fas fa-times-circle me-1"></i>No</span>'); }

        if (r.hasResumeLink) { $('#btnViewResume').attr('href', r.resumeLink).show(); } else { $('#btnViewResume').hide(); }
        syncAutomationBadge(r);
        syncPlivoCallUI(r);
        syncPipeline(r);
        syncAssignee(r);
        loadEmailEvents();
    }

    // ── Ticket assignment ─────────────────────────────────────────────────────────
    // Cache of eligible operators, loaded once and reused by the modal + inline editors.
    var naukriAssignees = null;
    function loadAssignees(cb) {
        if (naukriAssignees) { if (cb) cb(naukriAssignees); return; }
        $.ajax({
            url: '@Url.Action("GetEligibleAssignees", "NaukriOnboarding")', type: 'GET', timeout: 20000,
            success: function (res) {
                naukriAssignees = (res && res.success && res.assignees) ? res.assignees : [];
                if (cb) cb(naukriAssignees);
            },
            error: function () { naukriAssignees = []; if (cb) cb(naukriAssignees); }
        });
    }

    function assigneeOptionsHtml(selectedId) {
        var html = '<option value="">— Unassigned —</option>';
        (naukriAssignees || []).forEach(function (a) {
            var sel = (String(a.userId) === String(selectedId)) ? ' selected' : '';
            html += '<option value="' + a.userId + '"' + sel + '>' + $('<div>').text(a.displayName).html() + '</option>';
        });
        return html;
    }

    // Modal assignee widget.
    function syncAssignee(r) {
        var name = r.assignedToName || r.assignedToEmail;
        $('#mgmAssigneeName')
            .text(name || 'Unassigned')
            .attr('title', r.assignedToEmail || '')
            .toggleClass('fst-italic text-muted', !name);
        loadAssignees(function () {
            $('#mgmAssigneeSelect').html(assigneeOptionsHtml(r.assignedToUserId));
        });
    }

    $(document).on('click', '#mgmAssigneeSave', function () {
        var newId = $('#mgmAssigneeSelect').val();
        if (!newId) { alert('Please select an operator to assign.'); return; }
        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: '@Url.Action("UpdateAssignment", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId, assignedToUserId: newId },
            success: function (res) {
                $btn.prop('disabled', false);
                if (!res.success) { alert(res.error || 'Could not reassign.'); return; }
                if (currentRecord) {
                    currentRecord.assignedToUserId = parseInt(newId, 10);
                    currentRecord.assignedToEmail = res.assignedToEmail;
                    currentRecord.assignedToName = res.assignedToName;
                    syncAssignee(currentRecord);
                }
                updateRowAssignee(currentRecordId, newId, res.assignedToEmail, res.assignedToName);
            },
            error: function () { $btn.prop('disabled', false); alert('Failed to reassign. Please try again.'); }
        });
    });

    // Inline (list row) assignee editor.
    $(document).on('click', '.nk-assignee-edit', function () {
        var $cell = $(this).closest('.nk-assignee-cell');
        var current = $(this).data('current') || '';
        $cell.find('.nk-assignee-view').addClass('d-none');
        var $box = $cell.find('.nk-assignee-edit-box').removeClass('d-none');
        var $sel = $box.find('.nk-assignee-select');
        $sel.html('<option value="">Loading…</option>');
        loadAssignees(function () { $sel.html(assigneeOptionsHtml(current)); });
    });

    $(document).on('click', '.nk-assignee-cancel', function () {
        var $cell = $(this).closest('.nk-assignee-cell');
        $cell.find('.nk-assignee-edit-box').addClass('d-none');
        $cell.find('.nk-assignee-view').removeClass('d-none');
    });

    $(document).on('click', '.nk-assignee-save', function () {
        var $cell = $(this).closest('.nk-assignee-cell');
        var recId = $cell.data('record-id');
        var newId = $cell.find('.nk-assignee-select').val();
        if (!newId) { alert('Please select an operator to assign.'); return; }
        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: '@Url.Action("UpdateAssignment", "NaukriOnboarding")', type: 'POST',
            data: { __RequestVerificationToken: verificationToken, id: recId, assignedToUserId: newId },
            success: function (res) {
                $btn.prop('disabled', false);
                if (!res.success) { alert(res.error || 'Could not reassign.'); return; }
                updateRowAssignee(recId, newId, res.assignedToEmail, res.assignedToName);
            },
            error: function () { $btn.prop('disabled', false); alert('Failed to reassign. Please try again.'); }
        });
    });

    // Refresh a row's assignee display (used after both inline + modal reassign).
    function updateRowAssignee(recId, userId, email, name) {
        var $cell = $('.nk-assignee-cell[data-record-id="' + recId + '"]');
        if (!$cell.length) return;
        var display = name || email || 'Unassigned';
        var $view = $cell.find('.nk-assignee-view');
        $view.find('.nk-assignee-name')
            .removeClass('text-muted fst-italic')
            .attr('title', email || '')
            .html('<i class="fas fa-user-circle me-1 text-secondary"></i>' + $('<div>').text(display).html());
        $cell.find('.nk-assignee-edit').data('current', userId).attr('data-current', userId);
        $cell.find('.nk-assignee-edit-box').addClass('d-none');
        $view.removeClass('d-none');
    }

    // ── Bulk assign by MAG ─────────────────────────────────────────────────────────
    var baMags = null;
    function baUpdateSelectionInfo() {
        var checked = $('#baMagList input.ba-mag-check:checked');
        var totalTickets = 0;
        checked.each(function () { totalTickets += (parseInt($(this).data('active'), 10) || 0); });
        if (checked.length === 0) {
            $('#baSelectionInfo').text('No MAG selected.');
            $('#baAssignBtn').prop('disabled', true);
        } else {
            $('#baSelectionInfo').text(checked.length + ' MAG(s) selected · ~' + totalTickets + ' active ticket(s).');
            $('#baAssignBtn').prop('disabled', !$('#baOperator').val());
        }
    }

    function baRenderMags(filter) {
        var q = (filter || '').toLowerCase();
        var $tb = $('#baMagList').empty();
        var shown = 0;
        (baMags || []).forEach(function (m) {
            var label = (m.magName || '') + ' ' + (m.assessmentGroupName || '');
            if (q && label.toLowerCase().indexOf(q) < 0) return;
            shown++;
            var agLine = m.assessmentGroupName ? '<div class="text-muted" style="font-size:10.5px;">' + $('<div>').text(m.assessmentGroupName).html() + '</div>' : '';
            $tb.append(
                '<tr>' +
                '<td><input type="checkbox" class="ba-mag-check" value="' + $('<div>').text(m.magName).html() + '" data-active="' + m.active + '"></td>' +
                '<td><span class="fw-semibold">' + $('<div>').text(m.magName || '\u2014').html() + '</span>' + agLine + '</td>' +
                '<td class="text-end">' + m.total + '</td>' +
                '<td class="text-end">' + m.unassigned + '</td>' +
                '<td class="text-end">' + m.active + '</td>' +
                '</tr>'
            );
        });
        $('#baMagEmpty').toggleClass('d-none', shown > 0);
        $('#baSelectAll').prop('checked', false);
        baUpdateSelectionInfo();
    }

    function baLoad() {
        // Operators
        $('#baOperator').html('<option value="">Loading operators…</option>');
        loadAssignees(function () {
            $('#baOperator').html('<option value="">— Select operator —</option>' + assigneeOptionsHtml(''));
        });
        // MAG summary
        $('#baMagLoading').removeClass('d-none');
        $('#baMagListWrap').addClass('d-none');
        $('#baMagEmpty').addClass('d-none');
        $.ajax({
            url: '@Url.Action("GetMagAssignmentSummary", "NaukriOnboarding")', type: 'GET', timeout: 120000,
            success: function (res) {
                $('#baMagLoading').addClass('d-none');
                if (res && res.success === false) {
                    $('#baMagEmpty').removeClass('d-none').text('Failed to load MAGs: ' + (res.error || 'unknown error'));
                    return;
                }
                baMags = (res && res.mags) ? res.mags : [];
                $('#baMagListWrap').removeClass('d-none');
                baRenderMags($('#baMagSearch').val());
            },
            error: function (xhr, status) {
                $('#baMagLoading').addClass('d-none');
                var detail = status === 'timeout' ? 'request timed out' : ('HTTP ' + (xhr.status || '?'));
                $('#baMagEmpty').removeClass('d-none').text('Failed to load MAGs (' + detail + '). Ensure usp_GetNaukriMagAssignmentSummary is deployed and reload.');
            }
        });
    }

    $('#bulkAssignModal').on('shown.bs.modal', function () { baLoad(); });
    $('#baMagSearch').on('input', function () { baRenderMags($(this).val()); });
    $('#baOperator').on('change', baUpdateSelectionInfo);
    $(document).on('change', '#baMagList .ba-mag-check', baUpdateSelectionInfo);
    $('#baSelectAll').on('change', function () {
        $('#baMagList input.ba-mag-check:visible').prop('checked', $(this).is(':checked'));
        baUpdateSelectionInfo();
    });

    $('#baAssignBtn').on('click', function () {
        var opId = $('#baOperator').val();
        var scope = $('#baScope').val();
        var mags = $('#baMagList input.ba-mag-check:checked').map(function () { return $(this).val(); }).get();
        if (!opId) { alert('Select an operator.'); return; }
        if (mags.length === 0) { alert('Select at least one MAG.'); return; }
        var opName = $('#baOperator option:selected').text();
        if (!confirm('Assign tickets from ' + mags.length + ' MAG(s) to ' + opName + '?\nScope: ' + $('#baScope option:selected').text())) return;

        var $btn = $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Assigning…');
        $.ajax({
            url: '@Url.Action("BulkAssignByMag", "NaukriOnboarding")', type: 'POST',
            traditional: true,
            data: { __RequestVerificationToken: verificationToken, magNames: mags, assignedToUserId: opId, scope: scope },
            success: function (res) {
                $btn.prop('disabled', false).html('<i class="fas fa-people-arrows me-1"></i>Assign');
                if (!res.success) { alert(res.error || 'Bulk assign failed.'); return; }
                alert(res.message || (res.affected + ' ticket(s) assigned.'));
                location.reload();
            },
            error: function () {
                $btn.prop('disabled', false).html('<i class="fas fa-people-arrows me-1"></i>Assign');
                alert('Bulk assign failed. Please try again.');
            }
        });
    });

    // Fetches SendGrid delivery + engagement events for BOTH the invitation and the acknowledgement
    // emails, and renders them in the relevant pipeline steps (plus a compact badge in the header).
    function loadEmailEvents() {
        $('#mgmInviteEmailStatus').empty();
        $('#mgmInviteEvents').empty();
        $('#mgmAckEvents').empty();
        if (!currentRecordId) return;
        $.ajax({
            url: '@Url.Action("GetProspectEmailEvents", "NaukriOnboarding")', type: 'GET',
            data: { id: currentRecordId },
            success: function (res) {
                if (!res || !res.success || !res.hasEmail) return;
                $('#mgmInviteEmailStatus').html(buildEmailBadge('Invitation', res.invitation));
                renderEmailEventBlock('#mgmInviteEvents', 'Invitation email', res.invitation);
                renderEmailEventBlock('#mgmAckEvents', 'Acknowledgement email', res.acknowledgement);
            }
        });
    }

    // Compact one-line delivery summary (used in the modal header next to the parsed email).
    function buildEmailBadge(label, d) {
        if (!d || !d.sent) return '<span style="color:#6c757d;"><i class="fas fa-clock me-1"></i>' + label + ' not sent yet</span>';
        var ev = (d.deliveryEvent || '').toLowerCase();
        var style, icon, text;
        if (d.hasBounced || ev === 'bounce' || ev === 'dropped') {
            style = 'color:#842029;font-weight:600;'; icon = 'fa-exclamation-triangle';
            text = (ev === 'dropped' ? 'Dropped' : 'Bounced') + (d.deliveryReason ? ' \u2014 ' + d.deliveryReason : '') + ' \u00b7 try a different email';
        } else if (ev === 'delivered') { style = 'color:#0f5132;font-weight:600;'; icon = 'fa-check-circle'; text = 'Delivered'; }
        else if (ev === 'deferred') { style = 'color:#92660e;font-weight:600;'; icon = 'fa-hourglass-half'; text = 'Deferred'; }
        else if (ev === 'processed') { style = 'color:#1e40af;font-weight:600;'; icon = 'fa-paper-plane'; text = 'Sent (processing)'; }
        else { style = 'color:#495057;'; icon = 'fa-envelope'; text = 'Sent'; }
        var html = '<span style="' + style + '"><i class="fas ' + icon + ' me-1"></i>' + label + ': ' + $('<span>').text(text).html() + '</span>';
        if (d.opened) html += ' <span style="color:#0a3278;" title="Opened"><i class="fas fa-envelope-open me-1"></i>Opened</span>';
        if (d.clicked) html += ' <span style="color:#0a3278;" title="Clicked a link"><i class="fas fa-mouse-pointer me-1"></i>Clicked</span>';
        if (d.sentAt) html += ' <span style="color:#9aa0a6;">(' + d.sentAt + ')</span>';
        return html;
    }

    // Full SendGrid status card + collapsible event timeline for one email.
    function renderEmailEventBlock(sel, label, d) {
        var $el = $(sel); if (!$el.length) return; $el.empty();
        if (!d || !d.sent) return; // nothing sent yet — keep the step clean
        var ev = (d.deliveryEvent || '').toLowerCase();
        var dStyle, dIcon, dText;
        if (d.hasBounced || ev === 'bounce' || ev === 'dropped') {
            dStyle = 'background:#f8d7da;color:#842029;border:1px solid #dc3545;'; dIcon = 'fa-exclamation-triangle';
            dText = (ev === 'dropped' ? 'Dropped' : 'Bounced');
        } else if (ev === 'delivered') { dStyle = 'background:#d1e7dd;color:#0f5132;border:1px solid #198754;'; dIcon = 'fa-check-circle'; dText = 'Delivered'; }
        else if (ev === 'deferred') { dStyle = 'background:#fff3cd;color:#92660e;border:1px solid #ffc107;'; dIcon = 'fa-hourglass-half'; dText = 'Deferred'; }
        else if (ev === 'processed') { dStyle = 'background:#cfe2ff;color:#1e40af;border:1px solid #0d6efd;'; dIcon = 'fa-paper-plane'; dText = 'Sent (processing)'; }
        else { dStyle = 'background:#e9ecef;color:#495057;border:1px solid #ced4da;'; dIcon = 'fa-envelope'; dText = 'Sent'; }

        var chips = ['<span class="evt-chip" style="' + dStyle + '"><i class="fas ' + dIcon + ' me-1"></i>' + dText + '</span>'];
        if (d.opened) chips.push('<span class="evt-chip" style="background:#e7f1ff;color:#0a3278;border:1px solid #0d6efd;"><i class="fas fa-envelope-open me-1"></i>Opened</span>');
        if (d.clicked) chips.push('<span class="evt-chip" style="background:#e7f1ff;color:#0a3278;border:1px solid #0d6efd;"><i class="fas fa-mouse-pointer me-1"></i>Clicked</span>');

        var html = '<div class="evt-card">'
            + '<div class="evt-head"><span class="evt-title"><i class="fas fa-envelope me-1"></i>' + label + '</span>'
            + (d.sentAt ? '<span class="evt-sent">sent ' + d.sentAt + '</span>' : '') + '</div>'
            + '<div class="evt-chips">' + chips.join(' ') + '</div>';

        if ((d.hasBounced || ev === 'bounce' || ev === 'dropped')) {
            html += '<div class="evt-warn"><i class="fas fa-info-circle me-1"></i>'
                + (d.deliveryReason ? $('<span>').text(d.deliveryReason).html() + ' — ' : '')
                + 'this email did not reach the prospect; try a different address.</div>';
        }

        if (d.events && d.events.length) {
            var rows = d.events.map(function (e) {
                var em = (e.ev || '').toLowerCase(), c = '#6c757d';
                if (em === 'delivered') c = '#198754';
                else if (em.indexOf('bounce') >= 0 || em.indexOf('drop') >= 0) c = '#dc3545';
                else if (em === 'deferred') c = '#e6a817';
                else if (em === 'open') c = '#0d6efd';
                else if (em === 'click') c = '#0a58ca';
                else if (em === 'processed') c = '#3b82f6';
                var extra = e.reason ? ' — ' + $('<span>').text(e.reason).html()
                    : (e.response ? ' — ' + $('<span>').text(e.response).html() : '');
                return '<div class="evt-row"><span class="evt-dot" style="background:' + c + ';"></span>'
                    + '<span class="evt-name" style="color:' + c + ';">' + $('<span>').text(e.ev || '').html() + '</span>'
                    + '<span class="evt-extra">' + extra + '</span>'
                    + '<span class="evt-time">' + (e.at || '') + '</span></div>';
            }).join('');
            var tid = sel.replace('#', '') + 'Timeline';
            html += '<div class="evt-toggle" onclick="$(\'#' + tid + '\').slideToggle(120)">'
                + '<i class="fas fa-stream me-1"></i>' + d.events.length + ' event' + (d.events.length > 1 ? 's' : '') + ' — show / hide timeline</div>'
                + '<div id="' + tid + '" class="evt-timeline" style="display:none;">' + rows + '</div>';
        } else {
            html += '<div class="evt-pending"><i class="fas fa-clock me-1"></i>No delivery events received from SendGrid yet.</div>';
        }
        html += '</div>';
        $el.html(html);
    }

    function syncAutomationBadge(r) {
        var badge = $('#mgmAutomationBadge');
        if (!r.automationStatus) { badge.hide(); return; }
        var labels = {
            'ParsingResume':'Parsing Resume','SelectingChannel':'Selecting Channel',
            'CallTriggered':'Call Triggered','CallFailed':'Call Failed','AwaitingRetry':'Retry Pending',
            'SendingEmail':'Sending Email','EmailSent':'Email Sent','ManualRequired':'Manual Required',
            'Cold':'Cold','Completed':'Completed','Error':'Error'
        };
        var colors = {
            'EmailSent':'#198754','Completed':'#198754','Cold':'#dc3545','ManualRequired':'#e67e22','Error':'#e67e22',
            'CallTriggered':'#0d6efd','ParsingResume':'#0d6efd','SelectingChannel':'#0d6efd','SendingEmail':'#0d6efd',
            'AwaitingRetry':'#6c757d','CallFailed':'#6c757d'
        };
        var label = labels[r.automationStatus] || r.automationStatus;
        var color = colors[r.automationStatus] || '#6c757d';
        var extra = '';
