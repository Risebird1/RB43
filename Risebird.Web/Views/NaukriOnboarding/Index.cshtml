    function updateStatusBadge(s) {
        var b = $('#mgmStatusBadge'); b.text(s).removeClass('bg-warning bg-primary bg-success bg-secondary bg-danger text-dark');
        switch ((s||'').toLowerCase()) {
            case 'open': b.addClass('bg-warning text-dark'); break;
            case 'inprogress': b.addClass('bg-primary'); break;
            case 'verified': b.addClass('bg-success'); break;
            case 'onboarded': b.addClass('bg-success'); break;
            case 'rejected': b.addClass('bg-danger'); break;
            case 'closed': b.addClass('bg-secondary'); break;
            default: b.addClass('bg-light text-dark');
        }
    }

