    .evt-timeline { margin-top:6px; border-left:2px solid #e9ecef; padding-left:10px; }
    .evt-row { display:flex; align-items:baseline; gap:7px; font-size:11px; padding:2px 0; }
    .evt-dot { width:8px; height:8px; border-radius:50%; flex:0 0 8px; position:relative; left:-15px; }
    .evt-name { font-weight:600; text-transform:capitalize; margin-left:-8px; }
    .evt-extra { color:#64748b; flex:1 1 auto; min-width:0; word-break:break-word; }
    .evt-time { color:#9aa0a6; white-space:nowrap; font-size:10px; }
    .mgm-info-row { display:flex; align-items:flex-start; gap:10px; padding:8px 12px; border-radius:8px; background:#fff; border:1px solid #e9ecef; margin-bottom:8px; font-size:12.5px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
    .mgm-info-row .label { font-weight:600; color:#495057; flex:0 0 108px; min-width:0; }
    .mgm-info-row .value { color:#212529; flex:1 1 auto; min-width:0; word-break:break-word; overflow-wrap:anywhere; line-height:1.45; }
    .employed-yes { color:#198754; font-weight:600; }
    .employed-no { color:#dc3545; font-weight:600; }
    .skills-wrap { font-size:11px; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;text-overflow: ellipsis; word-break:break-word; max-width:100%; }
    .mag-cell-inner { max-width:100%; min-width:0; }
    #mgmMag.mgm-ellipsis-mag { display:inline-block; max-width:min(340px,70vw); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:bottom; }
    #mgmSkills.mgm-ellipsis-skills { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; word-break:break-word; max-width:100%; }

    .inline-edit-btn { background:none; border:none; color:#6c757d; padding:2px 4px; cursor:pointer; font-size:11px; vertical-align:middle; transition:color .15s; }
    .inline-edit-btn:hover { color:#0d6efd; }
    .inline-edit-group { display:inline-flex; align-items:center; gap:4px; }
    .inline-edit-group input { font-size:12px; padding:2px 8px; height:28px; border-radius:4px; border:1px solid #ced4da; min-width:160px; }
    .inline-edit-group .btn { font-size:10px; padding:2px 8px; line-height:1.4; border-radius:4px; }

    .btn-history { font-size:11px; padding:2px 6px; line-height:1.4; flex-shrink:0; }

    .history-timeline { list-style:none; padding:0; margin:0; }
    .history-timeline li { display:flex; gap:12px; padding:10px 0; border-bottom:1px solid #f0f0f0; align-items:flex-start; }
    .history-timeline li:last-child { border-bottom:none; }
    .ht-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; margin-top:4px; }
    .ht-dot.open, .ht-dot.statuschange { background:#ffc107; }
    .ht-dot.inprogress { background:#0d6efd; }
    .ht-dot.verified { background:#198754; } .ht-dot.closed { background:#6c757d; }
    .ht-dot.resumeparse { background:#17a2b8; } .ht-dot.resumeupload { background:#0dcaf0; }
    .ht-dot.resumeanalysis { background:#fd7e14; }
    .ht-dot.employmentverification { background:#28a745; }
    .ht-dot.onboarded { background:#198754; }
    .ht-dot.ackemailresent { background:#6f42c1; }
    .ht-dot.magchange { background:#e67e22; } .ht-dot.emailchange { background:#3498db; } .ht-dot.phonechange { background:#9b59b6; }
    .ht-dot.recordcreated { background:#20c997; } .ht-dot.deleted { background:#dc3545; }
    .ht-dot.plivocallinitiated { background:#6f42c1; } .ht-dot.plivocallcompleted { background:#198754; }
    .ht-body { flex:1; } .ht-transition { font-size:13px; font-weight:600; color:#212529; }
    .ht-meta { font-size:11.5px; color:#6c757d; margin-top:2px; }

    #historyModal.modal { z-index:1080; }
    #historyModal .modal-dialog { margin:0.75rem auto; max-width:560px; }
    #historyModal .modal-content { font-family:'Roboto',sans-serif; border:none; border-radius:10px; overflow:hidden; box-shadow:0 16px 48px rgba(15,23,42,0.12); }
    #historyModal .hm-header { background:linear-gradient(165deg,#eef2f7 0%,#e2e8f0 45%,#dce4ed 100%); border-bottom:1px solid #cbd5e1; padding:1rem 1.25rem; }
    #historyModal .hm-eyebrow { font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:#64748b; margin:0 0 0.35rem 0; }
    #historyModal .hm-title { font-size:17px; font-weight:700; color:#334155; line-height:1.25; margin:0; }
    #historyModal .hm-title i { color:#475569; opacity:0.9; }
    #historyModal #historyModalSubject { font-size:12px; color:#64748b; line-height:1.4; display:block; margin-top:0.35rem; }
    #historyModal .hm-body { background:#f1f5f9; padding:0.75rem 1rem; font-size:14px; color:#334155; max-height:min(420px,calc(100vh - 14rem)); overflow-y:auto; }
    #historyModal .hm-footer { background:#f8fafc; padding:0.5rem 1rem; }

    .mag-dropdown-wrap { position:relative; display:inline-block; z-index:20; }
    #magDropdown {
        display:none;
        position:absolute;
        z-index:1090;
        background:#fff;
        border:1px solid #dbeafe;
        border-radius:10px;
        box-shadow:0 10px 28px rgba(15,23,42,.16);
        width:min(420px, calc(100vw - 2rem));
        max-height:min(360px, calc(100vh - 8rem));
        left:0;
        top:100%;
        margin-top:6px;
    }
    #magDropdown.mag-dropdown--up { top:auto; bottom:100%; margin-top:0; margin-bottom:6px; }
    #magDropdown .mag-search-wrap { padding:8px 10px; border-bottom:1px solid #eee; }
    #magDropdown .mag-search-wrap input { font-size:12px; }
    #magList { max-height:270px; overflow-y:auto; padding:4px; }
    #magList .mag-item { padding:6px 10px; font-size:12px; cursor:pointer; border-radius:4px; transition:background .12s; display:flex; justify-content:space-between; align-items:center; }
    #magList .mag-item:hover { background:#e9ecef; }
    #magList .mag-item.active { background:#0d6efd; color:#fff; }
    #magList .mag-item .mag-ag { font-size:10px; opacity:.7; }
    #magList .mag-no-results { padding:12px; text-align:center; color:#6c757d; font-size:12px; }

    /* Priority intent-collection panel */
    .nk-priority-divider { margin:12px 0 10px; border:0; border-top:1px dashed #fde0c2; }
    .nk-priority-head { display:flex; flex-wrap:wrap; align-items:baseline; gap:8px; margin-bottom:8px; }
    .nk-priority-title { font-size:12px; font-weight:700; color:#b54708; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; }
    .nk-priority-sub { font-size:11px; color:#94734a; line-height:1.3; }
    .nk-priority-sub strong { color:#b54708; }
    .nk-priority-body { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
    .nk-priority-chips { display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
    .nk-priority-empty { font-size:11px; color:#94a3b8; font-style:italic; }
    .nk-priority-chip {
        display:inline-flex; align-items:center; gap:7px;
        background:#fff7ed; border:1px solid #fed7aa; color:#9a3412;
        border-radius:999px; padding:4px 6px 4px 11px; font-size:11.5px; font-weight:600;
        box-shadow:0 1px 2px rgba(180,71,8,.08);
    }
    .nk-priority-chip .nk-priority-chip-ag { font-weight:500; color:#c2754a; }
    .nk-priority-chip .nk-priority-chip-x {
        display:inline-flex; align-items:center; justify-content:center;
        width:16px; height:16px; border-radius:50%; background:#fed7aa; color:#9a3412;
        cursor:pointer; font-size:9px; border:0; line-height:1; transition:background .12s;
    }
    .nk-priority-chip .nk-priority-chip-x:hover { background:#fb923c; color:#fff; }
    .nk-priority-addbtn {
        display:inline-flex; align-items:center; font-size:11.5px; font-weight:600;
        color:#b54708; background:#fff; border:1px dashed #fdba74; border-radius:999px;
        padding:5px 12px; cursor:pointer; transition:all .12s;
    }
    .nk-priority-addbtn:hover { background:#fff7ed; border-color:#fb923c; }
    .nk-priority-addbtn:disabled { opacity:.5; cursor:not-allowed; }
    #nkPriorityDropdown {
        display:none; position:absolute; z-index:1090; background:#fff;
        border:1px solid #fde0c2; border-radius:10px; box-shadow:0 10px 28px rgba(15,23,42,.16);
        width:min(420px, calc(100vw - 2rem)); left:0; top:100%; margin-top:6px;
    }
    #nkPriorityDropdown.mag-dropdown--up { top:auto; bottom:100%; margin-top:0; margin-bottom:6px; }
    #nkPrioritySearch { font-size:12px; margin:8px; width:calc(100% - 16px); }
    #nkPriorityList { max-height:260px; overflow-y:auto; padding:4px; }
    #nkPriorityList .mag-item { padding:6px 10px; font-size:12px; cursor:pointer; border-radius:4px; transition:background .12s; display:flex; justify-content:space-between; align-items:center; }
    #nkPriorityList .mag-item:hover { background:#fff7ed; }
    #nkPriorityList .mag-item.disabled { opacity:.45; cursor:not-allowed; }
    #nkPriorityList .mag-item .mag-ag { font-size:10px; opacity:.7; }
    #nkPriorityList .mag-no-results { padding:12px; text-align:center; color:#6c757d; font-size:12px; }

</style>

<div id="loadingOverlay">
    <div class="spinner-content">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        <div class="loading-text">Loading records...</div>
    </div>
</div>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="content client">
            <div class="container-fluid py-4">

                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h4 class="fw-bold mb-0"><i class="fas fa-user-graduate text-primary me-2"></i>Prospective Interviewer Onboarding</h4>
                        <p class="text-muted mb-0 mt-1">Prospective interviewers sourced from Naukri / LinkedIn, processed via Relay.app</p>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#bulkAssignModal" title="Distribute a MAG's tickets to a single operator"><i class="fas fa-people-arrows me-1"></i>Bulk Assign</button>
                        <a href="@Url.Action("Performance", "NaukriOnboarding")" class="btn btn-sm btn-outline-info" title="Operator activity between dates"><i class="fas fa-user-clock me-1"></i>Performance</a>
                        <a href="@Url.Action("BatchCall", "NaukriOnboarding")" class="btn btn-sm btn-outline-success"><i class="fas fa-phone-volume me-1"></i>Batch Call</a>
                        <a href="@Url.Action("ProspectProgress", "NaukriOnboarding")" class="btn btn-sm btn-outline-primary"><i class="fas fa-chart-line me-1"></i>Progress Tracker</a>
                        <button type="button" class="btn btn-sm nk-page-refresh" onclick="location.reload()" title="Reload this page"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                    </div>
                </div>

                @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

                @{
                   // Global status breakdown across all matched records (not just the current page).
                   // 'Onboarded' is carved out of Closed so the four cards partition the total:
                   //   Open + In Progress + Closed + Onboarded = Total.
                   int cardOpen = ViewBag.OpenCount != null ? (int)ViewBag.OpenCount : 0;
                   int cardIP = ViewBag.InProgressCount != null ? (int)ViewBag.InProgressCount : 0;
                   int cardClosed = ViewBag.ClosedCount != null ? (int)ViewBag.ClosedCount : 0;
                   int cardOnboarded = ViewBag.OnboardedCount != null ? (int)ViewBag.OnboardedCount : 0; }
                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat" title="All @(hasFilters ? "matched" : "") records. Open + In Progress + Closed + Onboarded add up to this."><div class="stat-value text-primary">@totalCount</div><div class="stat-label">@(hasFilters ? "Matched" : "Total")</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat" title="Open tickets (not yet onboarded)"><div class="stat-value text-warning">@cardOpen</div><div class="stat-label">Open</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat" title="In-progress tickets (not yet onboarded)"><div class="stat-value text-info">@cardIP</div><div class="stat-label">In Progress</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat" title="Closed without onboarding (e.g. not interested, unsubscribed). Onboarded prospects are counted separately."><div class="stat-value text-secondary">@cardClosed</div><div class="stat-label">Closed</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat" title="Successfully onboarded (a closed/successful outcome, shown separately from Closed)"><div class="stat-value" style="color:#0f5132;">@cardOnboarded</div><div class="stat-label">Onboarded</div></div></div>
                </div>

                <div class="card border-0 shadow-sm mb-4 nk-funnel-panel">
                    <div class="card-body py-3 px-3">
                        @if (reachTop > 0)
                        {
                            <div class="nk-reach-strip">
                                <div class="nk-reach-head">
                                    <span class="nk-reach-title"><i class="fas fa-stream me-1"></i>Reached at least</span>
                                    <span class="nk-reach-sub">cumulative — how far prospects have ever progressed (credits records that later branched off)</span>
                                </div>
                                <div class="nk-reach-bars">
                                    @{ int reachPrev = 0; }
                                    @for (int ri = 0; ri < reachStages.Length; ri++)
                                    {
                                        var rs = reachStages[ri];
                                        int rc = reachOf(rs.Key);
                                        int pctTop = reachTop > 0 ? (int)Math.Round(100.0 * rc / reachTop) : 0;
                                        int pctStep = (ri > 0 && reachPrev > 0) ? (int)Math.Round(100.0 * rc / reachPrev) : 100;
                                        reachPrev = rc;
                                        <div class="nk-reach-col" title="@rs.Label — @rc reached (@pctTop% of entrants@(ri > 0 ? $", {pctStep}% of previous step" : ""))">
                                            <div class="nk-reach-count">@rc.ToString("N0")</div>
                                            <div class="nk-reach-track"><div class="nk-reach-fill" style="width:@(Math.Max(pctTop,2))%;"></div></div>
                                            <div class="nk-reach-pct">@pctTop%</div>
                                            <div class="nk-reach-label">@rs.Label</div>
                                        </div>
                                    }
                                </div>
                                @{
                                    int rDup = reachOf("Duplicate"); int rNi = reachOf("NotInterested");
                                    int rCold = reachOf("Cold"); int rNq = reachOf("NotQualified");
                                    int rNs = reachOf("NotStarted");
                                }
                                <div class="nk-reach-foot">
                                    <span class="nk-reach-foot-lbl">Off the happy path:</span>
                                    <span class="nk-reach-chip" style="--c:#dc3545;">Duplicate @rDup.ToString("N0")</span>
                                    <span class="nk-reach-chip" style="--c:#e35d6a;">Not Interested @rNi.ToString("N0")</span>
                                    <span class="nk-reach-chip" style="--c:#adb5bd;">Cold @rCold.ToString("N0")</span>
                                    <span class="nk-reach-chip" style="--c:#d9480f;">Not Qualified @rNq.ToString("N0")</span>
                                    <span class="nk-reach-chip" style="--c:#94a3b8;">Not started @rNs.ToString("N0")</span>
                                    <span class="nk-reach-chip" style="--c:#0d6efd;">Entered pipeline @reachTop.ToString("N0") of @reachTotal.ToString("N0")</span>
                                </div>
                            </div>
                            <hr class="nk-reach-divider" />
                        }
                        <div class="nk-funnel-head">
                            <span class="nk-funnel-title"><i class="fas fa-filter me-1"></i>Funnel Stages</span>
                            <span class="nk-funnel-total" title="Sum across all stages equals the @(hasFilters ? "matched" : "total") records">@totalCount total</span>
                            <span class="nk-funnel-divider"></span>
                            @{ int nkKnownSum = 0; }
                            @foreach (var fs in funnelStages)
                            {
                                int c = funnelCounts.TryGetValue(fs.Key, out var cv) ? cv : 0;
                                nkKnownSum += c;
                                bool active = string.Equals(selFunnelStage, fs.Value, StringComparison.OrdinalIgnoreCase);
                                <a href="@funnelUrl(fs.Value)" class="nk-funnel-pill @(active ? "active" : "")" title="Currently at &ldquo;@fs.Label&rdquo;">
                                    <span class="nk-funnel-pill-label">@fs.Label</span>
                                    <span class="nk-funnel-pill-count">@c</span>
                                </a>
                            }
                            @{ int nkOther = totalCount - nkKnownSum; }
                            @if (nkOther > 0)
                            {
                                <span class="nk-funnel-pill" style="cursor:default;" title="Records on an unrecognised/legacy funnel value — run the RevampNaukriFunnelStagesV2 migration to reclassify these.">
                                    <span class="nk-funnel-pill-label">Other</span>
                                    <span class="nk-funnel-pill-count">@nkOther</span>
                                </span>
                            }
                        </div>

                        <hr class="nk-priority-divider" />
                        <div class="nk-priority" id="nkPriorityPanel">
                            <div class="nk-priority-head">
                                <span class="nk-priority-title"><i class="fas fa-bolt me-1"></i>Priority Intent Collection</span>
                                <span class="nk-priority-sub">
                                    Aggressively call prospects in these MAGs who are stuck at <strong>Interest Collection</strong>
                                    to capture intent fast. Bypasses the usual call caps, runs 8&nbsp;AM&ndash;10&nbsp;PM IST, and resets daily. Max 2 MAGs.
                                </span>
                            </div>
                            <div class="nk-priority-body">
                                <div class="nk-priority-chips" id="nkPriorityChips">
                                    <span class="nk-priority-empty">No priority MAGs set.</span>
                                </div>
                                <div class="mag-dropdown-wrap" id="nkPriorityAddWrap">
                                    <button type="button" class="nk-priority-addbtn" id="nkPriorityAddBtn"><i class="fas fa-plus me-1"></i>Add priority MAG</button>
                                    <div id="nkPriorityDropdown">
                                        <input type="text" id="nkPrioritySearch" class="form-control form-control-sm" placeholder="Search MAG..." />
                                        <div id="nkPriorityList"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Index" asp-controller="NaukriOnboarding" method="get" id="filterForm">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex align-items-center gap-2" style="flex-wrap:nowrap;width:100%;">
                                <select name="status" class="form-select nk-filter-control" style="flex:1 1 0;min-width:120px;max-width:155px;" onchange="document.getElementById('filterForm').submit()" title="Operational ticket status">
                                    <option value="">All statuses</option>
                                    @if (selStatus == "Open") { <option value="Open" selected>Open</option> } else { <option value="Open">Open</option> }
                                    @if (selStatus == "InProgress") { <option value="InProgress" selected>In Progress</option> } else { <option value="InProgress">In Progress</option> }
                                    @if (selStatus == "Closed") { <option value="Closed" selected>Closed</option> } else { <option value="Closed">Closed</option> }
                                </select>
                                <input type="text" name="candidateName" class="form-control nk-filter-control" placeholder="Name..." value="@selName" />
                                <input type="text" name="magName" class="form-control nk-filter-control" placeholder="MAG..." value="@selMag" />
                                <select name="source" class="form-select nk-filter-control" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All sources</option>
                                    @if (selSource == "Naukri") { <option value="Naukri" selected>Naukri</option> } else { <option value="Naukri">Naukri</option> }
                                    @if (selSource == "LinkedIn") { <option value="LinkedIn" selected>LinkedIn</option> } else { <option value="LinkedIn">LinkedIn</option> }
                                </select>
                                <select name="automationStatus" class="form-select nk-filter-control nk-filter-grid__wide" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All automation</option>
                                    @{ var autoOpts = new[] {
                                        ("_any_", "Picked up by automation"),
                                        ("_none_", "Not yet picked up"),
                                        ("EmailSent", "Email sent \u2013 awaiting reply"),
                                        ("CallTriggered", "AI call in progress"),
                                        ("AwaitingRetry", "Waiting to retry"),
                                        ("Cold", "No response (cold)"),
                                        ("ManualRequired", "Needs manual review"),
                                        ("Completed", "Automation completed"),
                                        ("Error", "Processing error")
                                    };}
                                    @foreach (var (val, label) in autoOpts)
                                    {
                                        if (selAutoStatus == val) { <option value="@val" selected>@label</option> } else { <option value="@val">@label</option> }
                                    }
                                </select>
                                <select name="callStatus" class="form-select nk-filter-control" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All calls</option>
                                    @{ var callOpts = new[] { ("completed", "Completed"), ("triggered", "Triggered"), ("initiated", "Initiated"), ("trigger-failed", "Failed"), ("no_answer", "No Answer"), ("busy", "Busy") }; }
                                    @foreach (var (val, label) in callOpts)
                                    {
                                        if (selCallStatus == val) { <option value="@val" selected>@label</option> } else { <option value="@val">@label</option> }
                                    }
                                </select>
                                <select name="disposition" class="form-select nk-filter-control" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All dispositions</option>
                                    @{ var dispOpts = new[] { ("interested", "Interested"), ("not_interested", "Not Interested"), ("unsubscribe", "Unsubscribe") }; }
                                    @foreach (var (val, label) in dispOpts)
                                    {
                                        if (selDisposition == val) { <option value="@val" selected>@label</option> } else { <option value="@val">@label</option> }
                                    }
                                </select>
                                <select name="funnelStage" class="form-select nk-filter-control nk-filter-grid__wide" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All funnel stages</option>
                                    @foreach (var fs in funnelStages)
                                    {
                                        if (selFunnelStage == fs.Value) { <option value="@fs.Value" selected>@fs.Label</option> } else { <option value="@fs.Value">@fs.Label</option> }
                                    }
                                </select>
                                <select name="onboardingType" class="form-select nk-filter-control nk-filter-grid__wide" onchange="document.getElementById('filterForm').submit()" title="How the interviewer was onboarded">
                                    <option value="">All onboarding types</option>
                                    @{ var onbTypeOpts = new[] {
                                        ("SelfOnboarded",      "Self-Onboarded"),
                                        ("IntentAutoProcessed","Intent + Auto Processed"),
                                        ("ManuallyOnboarded",  "Manually Onboarded"),
                                        ("_none_",             "Not onboarded yet")
                                    };}
                                    @foreach (var (val, label) in onbTypeOpts)
                                    {
                                        if (selOnboardingType == val) { <option value="@val" selected>@label</option> } else { <option value="@val">@label</option> }
                                    }
                                </select>
                                <select name="assignedTo" class="form-select nk-filter-control nk-filter-grid__wide" onchange="document.getElementById('filterForm').submit()" title="Filter by assigned operator">
                                    <option value="">All assignees</option>
                                    @if (selAssignedTo == "_unassigned_") { <option value="_unassigned_" selected>Unassigned</option> } else { <option value="_unassigned_">Unassigned</option> }
                                    @foreach (var a in assignees)
                                    {
                                        if (selAssignedTo == a.Email) { <option value="@a.Email" selected>@a.DisplayName</option> } else { <option value="@a.Email">@a.DisplayName</option> }
                                    }
                                </select>
                                <input type="date" name="dateFrom" class="form-control nk-filter-control" value="@selDateFrom" onchange="document.getElementById('filterForm').submit()" title="From date" />
                                <input type="date" name="dateTo" class="form-control nk-filter-control" value="@selDateTo" onchange="document.getElementById('filterForm').submit()" title="To date" />
                                <div class="nk-filter-actions">
                                    <button style="background:#07363c4f !important;border:0;" type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter me-1"></i>Apply</button>
                                    <a style="border:0;background:#da7c7c !important;color:#fff" asp-action="Index" asp-controller="NaukriOnboarding" class="btn btn-sm btn-outline-secondary"><i class="fas fa-times me-1"></i>Clear</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card shadow-sm border-0 nk-table-card">
                    <div class="card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                <span>@(hasFilters ? "No records match the selected filters." : "No Naukri prospects yet. Once Relay.app routes a Naukri email, it will appear here.")</span>
                            </div>
                        }
                        else
                        {
                            <div class="nk-scroll">
                                <table id="nkTable" class="table table-hover mb-0 align-top">
                                    <colgroup>
                                        <col class="col-num" /><col class="col-date" /><col class="col-source" />
                                        <col class="col-name" /><col class="col-role" /><col class="col-exp" /><col class="col-location" />
                                        <col class="col-mag" /><col class="col-skills" /><col class="col-call" /><col class="col-auto" />
                                        <col class="col-funnel" /><col class="col-status" /><col class="col-assignee" /><col class="col-actions" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="col-num">#</th><th class="col-date">Received</th>
                                            <th class="col-source">Source</th>
                                            <th class="col-name">Candidate</th><th class="col-role">Current Role</th>
                                            <th class="col-exp">Exp</th><th class="col-location">Location</th>
                                            <th class="col-mag">MAG</th><th class="col-skills">Key Skills</th>
                                            <th class="col-call">Call</th>
                                            <th class="col-auto">Auto</th>
                                            <th class="col-funnel">Funnel Stage</th>
                                            <th class="col-status">Status</th>
                                            <th class="col-assignee">Assigned To</th>
                                            <th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model)
                                        {
                                            string rTicket = string.IsNullOrWhiteSpace(r.TicketStatus) ? "Open" : r.TicketStatus;
                                            string rStatus = rTicket.ToLower();
                                            string statusCss = rStatus switch {
                                                "open" => "status-open", "inprogress" => "status-inprogress",
                                                "closed" => "status-closed",
                                                _ => "bg-light border" };

                                            <tr id="row-@r.Id">
                                                <td class="col-num text-muted" style="font-size:12px">@r.Id</td>
                                                <td class="col-date" style="font-size:12px">@(r.ReceivedAt.HasValue ? r.ReceivedAt.Value.ToString("dd MMM yy, HH:mm") : "\u2014")</td>
                                                <td style="font-size:11px;">
                                                    @{
                                                        string srcLabel = r.Source ?? "Naukri";
                                                        string srcBadge = string.Equals(srcLabel, "LinkedIn", StringComparison.OrdinalIgnoreCase)
                                                            ? "background:#0a66c2;color:#fff;" : "background:#4a90d9;color:#fff;";
                                                    }
                                                    <span class="badge" style="@srcBadge font-size:10px;">@srcLabel</span>
                                                </td>
                                                <td class="col-name">
                                                    <span class="fw-semibold" style="font-size:12px;white-space:break-spaces;">@(r.CandidateName ?? "\u2014")</span>
                                                    @if (!string.IsNullOrEmpty(r.ParsedEmail)) { <br /><span class="text-muted" style="font-size:10px;white-space:break-spaces;">@r.ParsedEmail</span> }
                                                </td>
                                                <td class="col-role" style="font-size:12px;white-space:break-spaces;">@(r.CurrentRole ?? "\u2014")</td>
                                                <td class="col-exp" style="font-size:12px;">@(r.ExperienceYears ?? "\u2014")</td>
                                                <td class="col-location" style="font-size:12px;">@(r.Location ?? "\u2014")</td>
                                                <td class="col-mag" style="font-size:12px;">
                                                    @{
                                                        var magTitle = r.MagName ?? "\u2014";
                                                        if (!string.IsNullOrEmpty(r.AssessmentGroupName)) { magTitle = magTitle + " \u2192 " + r.AssessmentGroupName; }
                                                    }
                                                    <div class="skills-wrap mag-cell-inner" style="word-break:normal;" title="@magTitle">
                                                        @(r.MagName ?? "\u2014")
                                                        @if (!string.IsNullOrEmpty(r.AssessmentGroupName)) { <br /><span class="text-muted" style="font-size:10px;">@r.AssessmentGroupName</span> }
                                                    </div>
                                                </td>
                                                <td class="col-skills"><div class="skills-wrap" style="white-space:break-spaces;" title="@(r.KeySkills ?? "\u2014")">@(r.KeySkills ?? "\u2014")</div></td>
                                                <td style="font-size:11px;white-space:nowrap;">
                                                    @if (string.IsNullOrEmpty(r.PlivoCallStatus))
                                                    {
                                                        <span class="text-muted" style="font-size:10px;">—</span>
                                                    }
                                                    else
                                                    {
                                                        string callBadge = r.PlivoCallStatus switch {
                                                            "triggered" => "background:#cfe2ff;color:#0a3278;border:1px solid #0d6efd;",
                                                            "completed" => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "answered" => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "no-answer" => "background:#fff3cd;color:#856404;border:1px solid #ffc107;",
                                                            "busy" => "background:#fff3cd;color:#856404;border:1px solid #ffc107;",
                                                            "failed" => "background:#f8d7da;color:#842029;border:1px solid #dc3545;",
                                                            "trigger-failed" => "background:#f8d7da;color:#842029;border:1px solid #dc3545;",
                                                            "initiated" => "background:#e2e3e5;color:#41464b;border:1px solid #6c757d;",
                                                            _ => "background:#e9ecef;color:#495057;border:1px solid #ced4da;"
                                                        };
                                                        <span class="intent-badge" style="@callBadge font-size:10px;">@r.PlivoCallStatus</span>
                                                        if (!string.IsNullOrEmpty(r.PlivoProspectDisposition))
                                                        {
                                                            string dispColor = r.PlivoProspectDisposition switch {
                                                                "interested" => "text-success",
                                                                "not_interested" => "text-danger",
                                                                "unsubscribe" => "text-danger",
                                                                _ => "text-muted"
                                                            };
                                                            <br/><span class="@dispColor" style="font-size:9.5px;"><i class="fas fa-phone-alt me-1"></i>@r.PlivoProspectDisposition</span>
                                                        }
                                                    }
                                                </td>
                                                <td style="font-size:10px;white-space:nowrap;">
                                                    @if (!string.IsNullOrEmpty(r.AutomationStatus))
                                                    {
                                                        string autoBg = r.AutomationStatus switch {
                                                            "EmailSent" or "Completed" or "AwaitingAcknowledgement" => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "Cold" => "background:#f8d7da;color:#842029;border:1px solid #dc3545;",
                                                            "ManualRequired" or "Error" => "background:#fff3cd;color:#856404;border:1px solid #ffc107;",
                                                            "CallTriggered" or "ParsingResume" or "ResolvingMAG" or "SelectingChannel" or "SendingEmail" or "AutoOnboarding" => "background:#cfe2ff;color:#0a3278;border:1px solid #0d6efd;",
                                                            "AwaitingRetry" or "CallFailed" => "background:#e2e3e5;color:#41464b;border:1px solid #6c757d;",
                                                            _ => "background:#e9ecef;color:#495057;border:1px solid #ced4da;"
                                                        };
                                                        bool emailSentAwaitingResponse = r.AutomationStatus == "EmailSent"
                                                            && r.InvitationEmailSent == true
                                                            && string.IsNullOrEmpty(r.PlivoCallStatus)
                                                            && string.IsNullOrEmpty(r.ProspectResponse);
                                                        string autoLabel = r.AutomationStatus switch {
                                                            "ParsingResume" => "Parsing resume",
                                                            "ResolvingMAG" => "Resolving MAG",
                                                            "SelectingChannel" => "Resolving MAG",
                                                            "CallTriggered" => "AI calling",
                                                            "CallFailed" => "Call failed",
                                                            "AwaitingRetry" => "Waiting to retry",
                                                            "SendingEmail" => "Sending email",
                                                            "EmailSent" => emailSentAwaitingResponse ? "Awaiting reply" : "Email sent",
                                                            "AutoOnboarding" => "Onboarding",
                                                            "AwaitingAcknowledgement" => "Awaiting acceptance",
                                                            "ManualRequired" => "Needs manual review",
                                                            "Cold" => "No response",
                                                            "Completed" => "Completed",
                                                            "Error" => "Processing error",
                                                            _ => r.AutomationStatus
                                                        };
                                                        <span class="intent-badge" style="@autoBg font-size:9.5px;" title="Automation: @r.AutomationStatus">
                                                            <i class="fas fa-robot me-1"></i>@autoLabel
                                                        </span>
                                                        if (r.PlivoCallAttemptsTotal > 0)
                                                        {
                                                            <br/><span class="text-muted" style="font-size:9px;">@r.PlivoCallAttemptsTotal / @MaxCallsTotal calls</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted" style="font-size:9px;">—</span>
                                                    }
                                                </td>
                                                <td style="font-size:11px;white-space:nowrap;">
                                                    @{
                                                        string fStage = string.IsNullOrWhiteSpace(r.FunnelStage) ? "New" : r.FunnelStage;
                                                        string fCss = fStage switch {
                                                            "Onboarded"           => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "AcknowledgementSent" => "background:#e9d8fd;color:#553c9a;border:1px solid #805ad5;",
                                                            "ResumeFitment"       => "background:#fde6d3;color:#9c4221;border:1px solid #ed8936;",
                                                            "EmploymentVerified"  => "background:#d1f0e0;color:#1c6b47;border:1px solid #28a745;",
                                                            "IntentConfirmed"     => "background:#cfe2ff;color:#0a3278;border:1px solid #0d6efd;",
                                                            "InterestCollection"  => "background:#e0ecff;color:#1e40af;border:1px solid #3b82f6;",
                                                            "MAGConfirmed"        => "background:#fde9c8;color:#92660e;border:1px solid #e6a817;",
                                                            "DuplicateChecked"    => "background:#d9f2e6;color:#0c5d3c;border:1px solid #34c38f;",
                                                            "PhoneParsed"         => "background:#d6eef2;color:#0c5460;border:1px solid #20a8bd;",
                                                            "EmailParsed"         => "background:#d0f0f5;color:#0c5460;border:1px solid #17a2b8;",
                                                            "Duplicate"           => "background:#fde2e1;color:#842029;border:1px solid #dc3545;",
                                                            "NotInterested"       => "background:#f8d7da;color:#842029;border:1px solid #e35d6a;",
                                                            "Cold"                => "background:#e2e3e5;color:#41464b;border:1px solid #adb5bd;",
                                                            "NotQualified"        => "background:#f5d0c5;color:#7a2e0e;border:1px solid #d9480f;",
                                                            // legacy
                                                            "AwaitingResponse"    => "background:#e0ecff;color:#1e40af;border:1px solid #3b82f6;",
                                                            "InvitationSent"      => "background:#e2e3ff;color:#3730a3;border:1px solid #6366f1;",
                                                            "MAGMapped"           => "background:#fde9c8;color:#92660e;border:1px solid #e6a817;",
                                                            "Parsed"              => "background:#d0f0f5;color:#0c5460;border:1px solid #17a2b8;",
                                                            "Unsubscribe"         => "background:#f8d7da;color:#842029;border:1px solid #e35d6a;",
                                                            _                      => "background:#e9ecef;color:#495057;border:1px solid #ced4da;"
                                                        };
                                                    }
                                                    <span class="intent-badge" style="@fCss font-size:10px;white-space:nowrap;">@funnelLabel(fStage)</span>
                                                    @if (!string.IsNullOrWhiteSpace(r.OnboardingType))
                                                    {
                                                        string obLabel = r.OnboardingType switch {
                                                            "SelfOnboarded"       => "Self",
                                                            "IntentAutoProcessed" => "Auto",
                                                            "ManuallyOnboarded"   => "Manual",
                                                            _                      => r.OnboardingType
                                                        };
                                                        string obTitle = r.OnboardingType switch {
                                                            "SelfOnboarded"       => "Self-Onboarded (via MAG link)",
                                                            "IntentAutoProcessed" => "Intent + Auto Processed",
                                                            "ManuallyOnboarded"   => "Manually Onboarded",
                                                            _                      => r.OnboardingType
                                                        };
                                                        string obCss = r.OnboardingType switch {
                                                            "SelfOnboarded"       => "background:#d1e7dd;color:#0f5132;border:1px solid #198754;",
                                                            "IntentAutoProcessed" => "background:#cfe2ff;color:#0a3278;border:1px solid #0d6efd;",
                                                            "ManuallyOnboarded"   => "background:#fff3cd;color:#664d03;border:1px solid #ffc107;",
                                                            _                      => "background:#e9ecef;color:#495057;border:1px solid #ced4da;"
                                                        };
                                                        <div class="mt-1"><span class="intent-badge" style="@obCss font-size:9px;white-space:nowrap;" title="@obTitle"><i class="fas fa-user-check me-1"></i>@obLabel</span></div>
                                                    }
                                                </td>
                                                <td class="col-status">
                                                    <span class="intent-badge @statusCss" style="font-size:12px;white-space:break-spaces;">@(string.Equals(rTicket, "InProgress", StringComparison.OrdinalIgnoreCase) ? "In Progress" : rTicket)</span>
                                                    @if (r.ResumeAIAnalysisCompleted == true)
                                                    {
                                                        string aiBadgeClass = "text-info";
                                                        string aiLabel = "AI";
                                                        try
                                                        {
                                                            if (!string.IsNullOrWhiteSpace(r.ResumeAIAnalysisResult))
                                                            {
                                                                var aiData = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(r.ResumeAIAnalysisResult);
                                                                string vrd = aiData?.verdict;
                                                                string sc = aiData?.fitmentScore?.ToString();
                                                                if (!string.IsNullOrEmpty(vrd))
                                                                {
                                                                    bool isYes = vrd.IndexOf("yes", StringComparison.OrdinalIgnoreCase) >= 0;
                                                                    aiBadgeClass = isYes ? "text-success" : "text-danger";
                                                                    aiLabel = isYes ? "Yes" : "No";
                                                                }
                                                                if (!string.IsNullOrEmpty(sc)) aiLabel += " \u00B7 " + sc;
                                                            }
                                                        }
                                                        catch { }
                                                        <br /><span style="font-size:9px;" class="@aiBadgeClass" title="AI Verdict"><i class="fas fa-robot"></i> @aiLabel</span>
                                                    }
                                                    @if (string.Equals(r.FunnelStage, "Onboarded", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <br /><span style="font-size:9px;" class="text-success" title="Onboarded — the prospect accepted the acknowledgement (or self-registered) and exists in UserList."><i class="fas fa-check-double"></i> Onboarded</span>
                                                    }
                                                    else if (r.OnboardingCompleted == true)
                                                    {
                                                        <br /><span style="font-size:9px;" class="text-warning" title="Interviewer profile created and acknowledgement email sent — awaiting the prospect's acceptance to complete onboarding. NOT yet onboarded."><i class="fas fa-user-clock"></i> Awaiting acceptance</span>
                                                    }
                                                </td>
                                                <td class="col-assignee nk-assignee-cell" data-record-id="@r.Id">
                                                    <div class="nk-assignee-view d-flex align-items-center gap-1">
                                                        @if (!string.IsNullOrWhiteSpace(r.AssignedToEmail))
                                                        {
                                                            <span class="nk-assignee-name" style="font-size:11px;white-space:break-spaces;" title="@r.AssignedToEmail">
                                                                <i class="fas fa-user-circle me-1 text-secondary"></i>@(string.IsNullOrWhiteSpace(r.AssignedToName) ? r.AssignedToEmail : r.AssignedToName)
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="nk-assignee-name text-muted fst-italic" style="font-size:11px;"><i class="fas fa-user-slash me-1"></i>Unassigned</span>
                                                        }
                                                        <button type="button" class="btn btn-link p-0 nk-assignee-edit" title="Reassign this prospect"
                                                                data-record-id="@r.Id" data-current="@r.AssignedToUserId" style="font-size:11px;line-height:1;">
                                                            <i class="fas fa-pen"></i>
                                                        </button>
                                                    </div>
                                                    <div class="nk-assignee-edit-box d-none">
                                                        <select class="form-select form-select-sm nk-assignee-select" style="font-size:11px;min-width:150px;">
                                                            <option value="">Loading…</option>
                                                        </select>
                                                        <div class="d-flex gap-1 mt-1">
                                                            <button type="button" class="btn btn-success btn-sm nk-assignee-save" style="font-size:10px;padding:1px 6px;">Save</button>
                                                            <button type="button" class="btn btn-outline-secondary btn-sm nk-assignee-cancel" style="font-size:10px;padding:1px 6px;">Cancel</button>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="col-actions">
                                                    <div class="action-btns d-flex align-items-center flex-wrap gap-1">
                                                        <button type="button" title="Manage \u2014 review, verify &amp; onboard"
                                                                class="btn btn-primary btn-manage-record"
                                                                data-record-id="@r.Id">
                                                            <i class="fas fa-bars me-1"></i>Manage
                                                        </button>
                                                        @if (canDelete)
                                                        {
                                                            <button type="button" title="Delete this record"
                                                                    class="btn btn-danger btn-sm btn-delete-record"
                                                                    data-record-id="@r.Id">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                        <div class="text-muted" style="font-size:12px;">
                            Showing @first\u2013@last of @totalCount records
                            <span class="ms-3">Page size:
                                @foreach (var sz in new[] { 10, 25, 50, 100 })
                                { if (pageSize == sz) { <strong class="ms-1">@sz</strong> } else { <a href="javascript:void(0)" class="ms-1 text-decoration-none" onclick="changePageSize(@sz)">@sz</a> } }
                            </span>
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@pageUrl(page - 1)">Prev</a></li>
                                @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++) { <li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@pageUrl(p)">@p</a></li> }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")"><a class="page-link" href="@pageUrl(page + 1)">Next</a></li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

