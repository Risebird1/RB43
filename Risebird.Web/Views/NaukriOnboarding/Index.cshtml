                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mgm-info-row">
                                <span class="label"><i class="fas fa-briefcase me-1"></i>Employed:</span>
                                <span class="value" id="mgmEmployed">\u2014</span>
