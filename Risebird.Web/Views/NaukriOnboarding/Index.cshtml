    /* ── Refresh ────────────────────────────────────────────── */

    $('#btnRefreshManage').on('click', function () { if (currentRecordId) { $('#mgmLoading').show(); $('#mgmContent').hide(); resetPipeline(); loadRecordDetails(currentRecordId); } });

    /* ── History modal ───────────────────────────────────────────────── */
    var eventLabels = {
        'StatusChange':             { icon: 'fas fa-sync-alt',       color: '#6c757d', label: 'Status changed' },
        'ResumeParse':              { icon: 'fas fa-file-alt',       color: '#17a2b8', label: 'Resume parsed' },
        'ResumeUpload':             { icon: 'fas fa-upload',         color: '#0dcaf0', label: 'Resume uploaded' },
        'ResumeAnalysis':           { icon: 'fas fa-robot',          color: '#fd7e14', label: 'Resume analyzed' },
        'EmploymentVerification':   { icon: 'fas fa-building',       color: '#28a745', label: 'Employment verified' },
        'Onboarded':                { icon: 'fas fa-user-check',     color: '#198754', label: 'Onboarded' },
        'AckEmailResent':           { icon: 'fas fa-envelope',       color: '#6f42c1', label: 'Ack email resent' },
        'MagChange':                { icon: 'fas fa-pencil-alt',     color: '#e67e22', label: 'MAG changed' },
        'EmailChange':              { icon: 'fas fa-at',             color: '#3498db', label: 'Email changed' },
        'PhoneChange':              { icon: 'fas fa-phone',          color: '#9b59b6', label: 'Phone changed' },
        'RecordCreated':            { icon: 'fas fa-plus-circle',    color: '#20c997', label: 'Record created' },
        'Deleted':                  { icon: 'fas fa-trash',          color: '#dc3545', label: 'Record deleted' },
        'SkillChannelSelected':     { icon: 'fas fa-link',           color: '#0d6efd', label: 'Skill channel selected' },
        'MAGLinkGenerated':         { icon: 'fas fa-link',           color: '#0d6efd', label: 'MAG link generated' },
        'InvitationEmailSent':      { icon: 'fas fa-paper-plane',    color: '#6f42c1', label: 'Invitation email sent' },
        'ProspectResponse':         { icon: 'fas fa-reply',          color: '#e67e22', label: 'Prospect responded' },
        'SelfRegistered':           { icon: 'fas fa-user-check',     color: '#198754', label: 'Self-registered' },
        'PlivoCallInitiated':       { icon: 'fas fa-phone-alt',      color: '#6f42c1', label: 'Plivo call initiated' },
        'PlivoCallCompleted':       { icon: 'fas fa-phone-square',   color: '#198754', label: 'Plivo call completed' }
    };

    function openHistoryModal(recordId) {
        if (!recordId) return;
        $('#historyModalSubject').text('Record #' + recordId);
        $('#historyLoading').show(); $('#historyList').hide().empty(); $('#historyEmpty').hide();

        var modalEl = document.getElementById('historyModal');
        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        $(modalEl).one('shown.bs.modal', function () {
            var backs = document.querySelectorAll('.modal-backdrop.show');
            if (backs.length > 1) backs[backs.length - 1].style.zIndex = '1075';
        });
        modal.show();

        $.ajax({
            url: '@Url.Action("GetHistory", "NaukriOnboarding")',
            type: 'GET', data: { id: recordId },
            success: function (data) {
                $('#historyLoading').hide();
                if (!data || data.length === 0) { $('#historyEmpty').show(); return; }
                var $ul = $('#historyList');
                $.each(data, function (_, h) {
                    var cfg = eventLabels[h.eventType] || eventLabels['StatusChange'];
                    var dotCls = h.eventType.toLowerCase();
                    if (h.eventType === 'StatusChange') dotCls = (h.toValue || 'open').toLowerCase();

                    var arrow;
                    if (h.eventType === 'RecordCreated') {
                        arrow = '<span class="text-muted">Record created as </span><strong>' + h.toValue + '</strong>';
                    } else if (h.eventType === 'ResumeUpload') {
                        arrow = '<span class="text-muted">Uploaded: </span><strong>' + h.toValue + '</strong>';
                    } else if (h.fromValue === '—' || !h.fromValue) {
                        arrow = '<strong>' + h.toValue + '</strong>';
                    } else {
                        arrow = '<strong>' + h.fromValue + '</strong>'
                            + ' <i class="fas fa-long-arrow-alt-right mx-1 text-muted" style="font-size:10px"></i> '
                            + '<strong>' + h.toValue + '</strong>';
                    }

                    $ul.append(
                        '<li><span class="ht-dot ' + dotCls + '"></span>'
                        + '<div class="ht-body"><div class="ht-transition">'
                        + '<i class="' + cfg.icon + ' me-2" style="font-size:11px;color:' + cfg.color + '" title="' + cfg.label + '"></i>'
                        + arrow + '</div>'
                        + '<div class="ht-meta"><i class="fas fa-user me-1"></i>' + h.changedBy
                        + ' &nbsp;&middot;&nbsp; <i class="fas fa-clock me-1"></i>' + h.changedAt
                        + '</div></div></li>'
                    );
                });
                $ul.show();
            },
            error: function () {
                $('#historyLoading').hide();
                $('#historyEmpty').text('Could not load history. Please try again.').show();
            }
        });
    }

    $('#btnViewHistory').on('click', function () { openHistoryModal(currentRecordId); });

    /* ══════════ Manual Onboarding Section ══════════ */

    function showManualSectionIfReady() {
        // The manual onboarding controls (EV → AI → Send Acknowledgement → Onboarding) are always
        // available so an operator can run them on demand; the banner only highlights cases that
        // explicitly need manual help.
        $('#manualOnboardSection').show();
        if (!currentRecord) return;
        var r = currentRecord;
        var pref = (r.plivoOnboardingPreference || '').toLowerCase();
        var resp = (r.prospectResponse || '');
        var needsManual = pref === 'manual_onboarding' || pref === 'need_clarity' || pref === 'facing_errors'
                       || resp === 'ManualSupport' || resp === 'NeedClarity';
        if (needsManual) $('#manualOnboardBanner').show();
    }

    function syncManualOnboarding(r, step1Done, step2Done) {
        var needsManual = false;
        var reason = '';
        var pref = (r.plivoOnboardingPreference || '').toLowerCase();
        var disp = (r.plivoProspectDisposition || '').toLowerCase();
        var resp = (r.prospectResponse || '');

        if (pref === 'manual_onboarding' || pref === 'need_clarity' || pref === 'facing_errors') {
            needsManual = true;
            var prefLabels = { 'manual_onboarding': 'manual onboarding', 'need_clarity': 'clarity on the process', 'facing_errors': 'help with errors' };
            reason = 'The prospect indicated a preference for <strong>' + (prefLabels[pref] || pref) + '</strong> during the call.';
        }
        if (resp === 'ManualSupport') {
            needsManual = true;
            reason = 'The prospect clicked <strong>Manual Support</strong> in the invitation email.';
        }
        if (resp === 'NeedClarity') {
            needsManual = true;
            reason = 'The prospect clicked <strong>Need Clarity</strong> in the invitation email.';
        }

        // The manual onboarding section is always available so an operator can run the steps on demand.
        $('#manualOnboardSection').show();

        if (needsManual) {
            $('#manualOnboardBanner').show();
            $('#manualOnboardReason').html(reason);
            // Auto-expand manual steps
            $('#manualStepsBody').show();
            $('#btnToggleManualSteps').html('<i class="fas fa-chevron-up me-1" id="manualToggleIcon"></i>Collapse');
        }

        // Sync existing EV / AI / Onboard state
        if (r.employmentVerified === true) {
            if (r.employmentIsEmployed === true || r.employmentCompanyName) {
                var evHtml = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Verified</span>';
                if (r.employmentCompanyName) evHtml += ' &mdash; <strong>' + $('<span>').text(r.employmentCompanyName).html() + '</strong>';
                evHtml += ' <span class="employed-yes">(Employed)</span>';
                mMarkStep(1, 'completed', evHtml);
            } else {
                var evHtml2 = '<span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Verified</span>';
                evHtml2 += ' <span class="employed-no">(Not Employed)</span>';
                mMarkStep(1, 'failed', evHtml2);
                $('#btnTriggerEV').hide(); $('#btnRetryEV').show().prop('disabled', false);
            }
        }

        if (r.resumeAIAnalysisCompleted === true) {
            var verdict = r.aiVerdict || 'N/A';
            var isPositive = verdict.toLowerCase().indexOf('yes') >= 0;
            var aiHtml = '<span class="' + (isPositive ? 'text-success' : 'text-danger') + '"><i class="fas ' + (isPositive ? 'fa-check-circle' : 'fa-times-circle') + ' me-1"></i>Verdict: <strong>' + $('<span>').text(verdict).html() + '</strong></span>';
            if (r.aiFitmentScore != null) aiHtml += ' &mdash; Score: <strong>' + r.aiFitmentScore + '</strong>';
            mMarkStep(2, isPositive ? 'completed' : 'failed', aiHtml);
        }

        // M3 (Send Acknowledgement): profile created + acknowledgement email sent.
        if (r.onboardingCompleted === true) {
            // If the prospect has ALREADY accepted (FunnelStage = 'Onboarded'), the acknowledgement
            // step is moot — whether or not the email-sent flag was recorded, the outcome is achieved.
            // Showing "email failed — use Resend" in that case is misleading (the reported bug), and
            // resending an acknowledgement to a live, onboarded interviewer makes no sense.
            var fs = (r.funnelStage || '').toLowerCase();
            var alreadyOnboarded = (fs === 'onboarded');

            var ackHtml = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Profile created &amp; mapped.</span>';
            if (r.onboardedUserId) ackHtml += '<br/><strong>UserId:</strong> ' + r.onboardedUserId;
            if (r.onboardedProfileId) ackHtml += ' &mdash; <strong>ProfileId:</strong> ' + r.onboardedProfileId;
            if (r.acknowledgementEmailSent === true) {
                ackHtml += '<br/><span class="text-success"><i class="fas fa-paper-plane me-1"></i>Acknowledgement email sent.</span>';
            } else if (alreadyOnboarded) {
                ackHtml += '<br/><span class="text-success"><i class="fas fa-check-circle me-1"></i>Acknowledgement accepted &mdash; onboarding complete.</span>';
            } else {
                ackHtml += '<br/><span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Acknowledgement email failed &mdash; use Resend.</span>';
            }
            mMarkStep(3, 'completed', ackHtml);
            // Only offer Resend while the prospect has not yet accepted.
            if (alreadyOnboarded) { $('#btnResendAck').hide(); }
            else { $('#btnResendAck').show().prop('disabled', false); }

            // M4 (Onboarding): completes only when the interviewer ACCEPTS the acknowledgement email.
            if (alreadyOnboarded) {
                var obHtml = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Interviewer accepted the acknowledgement &mdash; onboarding complete!</span>';
                if (r.onboardedUserId) obHtml += '<br/><strong>UserId:</strong> ' + r.onboardedUserId;
                mMarkStep(4, 'completed', obHtml);
            } else {
                $('#mStep4Card').removeClass('disabled');
                mMarkStep(4, 'pending', '<span class="text-warning"><i class="fas fa-hourglass-half me-1"></i>Awaiting the interviewer\'s acceptance of the acknowledgement email. Use <strong>Refresh Status</strong> to check.</span>');
            }
        }
    }

    function mMarkStep(step, state, message) {
        var card = $('#mStep'+step+'Card'), num = $('#mStep'+step+'Number'), result = $('#mStep'+step+'Result');
        card.removeClass('pending completed failed disabled');
        if (state === 'completed') {
            card.addClass('completed');
            if (step === 1) { $('#btnTriggerEV').hide(); $('#btnRetryEV').hide(); $('#mStep1Subtitle').html('<span class="text-success" style="font-size:11px;">Employment verified</span>'); }
            if (step === 2) { $('#btnRunAIAnalysis').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Analyzed'); $('#mStep2Subtitle').html('<span class="text-success" style="font-size:11px;">AI analysis complete</span>'); }
            if (step === 3) { $('#btnManualOnboard').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Acknowledgement Sent'); $('#mStep3Subtitle').html('<span class="text-success" style="font-size:11px;">Profile created &amp; acknowledgement sent</span>'); }
            if (step === 4) { $('#btnCheckOnboarding').prop('disabled',true).html('<i class="fas fa-check me-1"></i>Onboarded'); $('#mStep4Subtitle').html('<span class="text-success" style="font-size:11px;">Interviewer onboarded</span>'); }
        } else if (state === 'failed') {
            card.addClass('failed');
        } else { card.addClass('pending'); }
        if (message) result.html(message).show();

        if (step === 1 && state === 'completed') { $('#mStep2Card').removeClass('disabled'); }
        if (step === 2 && state === 'completed') { $('#mStep3Card').removeClass('disabled'); }
        if (step === 3 && state === 'completed') { $('#mStep4Card').removeClass('disabled'); }
    }

    $('#btnToggleManualSteps').on('click', function () {
        var $body = $('#manualStepsBody');
        if ($body.is(':visible')) {
            $body.slideUp(200);
            $(this).html('<i class="fas fa-chevron-down me-1" id="manualToggleIcon"></i>Expand');
        } else {
            $body.slideDown(200);
            $(this).html('<i class="fas fa-chevron-up me-1" id="manualToggleIcon"></i>Collapse');
        }
    });

    /* ── M1: Employment Verification ── */

    $('#btnTriggerEV, #btnRetryEV').on('click', function () {
        if (!currentRecordId || !currentRecord) return;
        var email = currentRecord.parsedEmail, phone = currentRecord.parsedPhone;
        if (!email) { alert('No email parsed. Complete Step 1 first.'); return; }
        if (!phone) { alert('No phone number parsed. EV requires a phone number.'); return; }

        var btn = $('#btnTriggerEV'); var retryBtn = $('#btnRetryEV');
        btn.show().prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Verifying...');
        retryBtn.hide();
        $('#mStep1Subtitle').text('Running employment verification...');

        $.ajax({
            url: '/Aadhaar/EvVerification', type: 'POST', timeout: 60000,
            data: { mobilenumber: phone, candidateemail: email },
            success: function (result) {
                var verified = true;
                var companyName = result.companyName || '';
                var isEmployed = (result.message == null && companyName !== '');
                var details = result.message || '';

                if (isEmployed) {
                    var evHtml = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Verified</span>';
                    evHtml += ' &mdash; <strong>' + $('<span>').text(companyName).html() + '</strong>';
                    evHtml += ' <span class="employed-yes">(Employed)</span>';
                    mMarkStep(1, 'completed', evHtml);
                    $('#mgmCompany').text(companyName);
                    $('#mgmEmployed').html('<span class="employed-yes">Yes</span>');
                } else {
                    var evHtml2 = '<span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Verification completed</span>';
                    evHtml2 += ' &mdash; <span class="employed-no">Not Employed / Not Found</span>';
                    if (details) evHtml2 += '<br/><span style="font-size:11px;">' + $('<span>').text(details).html() + '</span>';
                    mMarkStep(1, 'failed', evHtml2);
                    btn.hide(); retryBtn.show().prop('disabled', false);
                    $('#mgmEmployed').html('<span class="employed-no">No</span>');
                }

                // Save EV result to DB
                $.ajax({
                    url: '@Url.Action("SaveEmploymentResult", "NaukriOnboarding")', type: 'POST',
                    data: { __RequestVerificationToken: verificationToken, id: currentRecordId, verified: verified, companyName: companyName, isEmployed: isEmployed, details: details }
                });

                if (currentRecord) {
                    currentRecord.employmentVerified = true;
                    currentRecord.employmentCompanyName = companyName;
                    currentRecord.employmentIsEmployed = isEmployed;
                }
            },
            error: function () {
                mMarkStep(1, 'failed', '<span class="text-danger">EV request failed. Try again.</span>');
                btn.prop('disabled',false).html('<i class="fas fa-building me-1"></i>Verify Employment');
                $('#mStep1Subtitle').html('Verify the prospect\'s current employment via Signzy');
            }
        });
    });

    /* ── M2: AI Resume Fitment Analysis ── */

    $('#btnRunAIAnalysis').on('click', function () {
        if (!currentRecordId) return; var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Analyzing (may take 30s)...');
        $('#mStep2Subtitle').text('AI is analyzing the resume...');

        $.ajax({
            url: '@Url.Action("AnalyzeResume", "NaukriOnboarding")', type: 'POST', timeout: 120000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    var verdict = res.verdict || 'N/A';
                    var isPositive = verdict.toLowerCase().indexOf('yes') >= 0;
                    var aiHtml = '<span class="' + (isPositive ? 'text-success' : 'text-danger') + '"><i class="fas ' + (isPositive ? 'fa-check-circle' : 'fa-times-circle') + ' me-1"></i>Verdict: <strong>' + $('<span>').text(verdict).html() + '</strong></span>';
                    if (res.fitmentScore != null) aiHtml += ' &mdash; Score: <strong>' + res.fitmentScore + '</strong>';
                    if (res.completeFitmentAnalysis) aiHtml += '<br/><span style="font-size:11px;line-height:1.5;display:block;margin-top:4px;">' + $('<span>').text(res.completeFitmentAnalysis).html() + '</span>';
                    mMarkStep(2, isPositive ? 'completed' : 'failed', aiHtml);
                    if (currentRecord) { currentRecord.resumeAIAnalysisCompleted = true; currentRecord.aiVerdict = verdict; currentRecord.aiFitmentScore = res.fitmentScore; }
                } else {
                    var errMsg = res.error || 'Analysis failed.';
                    if (res.needsUpload) errMsg += ' Upload a valid resume first.';
                    mMarkStep(2, 'failed', '<span class="text-danger"><i class="fas fa-times-circle me-1"></i>' + errMsg + '</span>');
                    btn.prop('disabled',false).html('<i class="fas fa-robot me-1"></i>Retry');
                }
            },
            error: function (xhr, status) {
                var msg = status === 'timeout' ? 'Request timed out. Try again.' : 'Request failed.';
                mMarkStep(2, 'failed', '<span class="text-danger">' + msg + '</span>');
                btn.prop('disabled',false).html('<i class="fas fa-robot me-1"></i>Retry');
                $('#mStep2Subtitle').html('AI evaluates the resume against the MAG\'s specialization');
            }
        });
    });

    /* ── M3: Send Acknowledgement (create profile + map + email acknowledgement) ── */

    $('#btnManualOnboard').on('click', function () {
        if (!currentRecordId) return;
        if (!confirm('This will create a UserList and InterviewerProfile entry, map the interviewer to the Assessment Group & channels, and email them the acknowledgement (accept / decline). Onboarding completes only once the interviewer accepts it. Proceed?')) return;
        var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Sending...');
        $('#mStep3Subtitle').text('Creating profile and sending acknowledgement...');

        $.ajax({
            url: '@Url.Action("OnboardInterviewer", "NaukriOnboarding")', type: 'POST', timeout: 120000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    var ackHtml = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message || 'Profile created and acknowledgement email sent.') + '</span>';
                    if (res.userId) ackHtml += '<br/><strong>UserId:</strong> ' + res.userId;
                    if (res.profileId) ackHtml += ' &mdash; <strong>ProfileId:</strong> ' + res.profileId;
                    mMarkStep(3, 'completed', ackHtml);
                    $('#btnResendAck').show().prop('disabled', false);
                    if (currentRecord) {
                        currentRecord.onboardingCompleted = true;
                        currentRecord.onboardedUserId = res.userId;
                        currentRecord.onboardedProfileId = res.profileId;
                        currentRecord.acknowledgementEmailSent = res.acknowledgementEmailSent !== false;
                    }
                    // M4 (Onboarding) is now pending the interviewer's acceptance.
                    $('#mStep4Card').removeClass('disabled');
                    mMarkStep(4, 'pending', '<span class="text-warning"><i class="fas fa-hourglass-half me-1"></i>Awaiting the interviewer\'s acceptance of the acknowledgement email. Use <strong>Refresh Status</strong> to check.</span>');
                    loadEmailEvents();
                } else {
                    mMarkStep(3, 'failed', '<span class="text-danger"><i class="fas fa-times-circle me-1"></i>' + (res.error || 'Could not send acknowledgement.') + '</span>');
                    btn.prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Retry');
                    $('#mStep3Subtitle').html('Creates the interviewer profile, maps to the Assessment Group &amp; channels, and emails the acknowledgement (accept / decline) to the interviewer');
                }
            },
            error: function () {
                mMarkStep(3, 'failed', '<span class="text-danger">Request failed.</span>');
                btn.prop('disabled',false).html('<i class="fas fa-paper-plane me-1"></i>Retry');
                $('#mStep3Subtitle').html('Creates the interviewer profile, maps to the Assessment Group &amp; channels, and emails the acknowledgement (accept / decline) to the interviewer');
            }
        });
    });

    /* ── M3: Resend Acknowledgement ── */

    $('#btnResendAck').on('click', function () {
        if (!currentRecordId) return;
        var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Resending...');
        $.ajax({
            url: '@Url.Action("ResendAcknowledgement", "NaukriOnboarding")', type: 'POST', timeout: 60000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                btn.prop('disabled',false).html('<i class="fas fa-redo me-1"></i>Resend');
                if (res.success) {
                    if (currentRecord) currentRecord.acknowledgementEmailSent = true;
                    $('#mStep3Result').append('<br/><span class="text-success"><i class="fas fa-paper-plane me-1"></i>Acknowledgement email resent.</span>');
                    loadEmailEvents();
                } else {
                    alert(res.error || 'Could not resend the acknowledgement email.');
                }
            },
            error: function () {
                btn.prop('disabled',false).html('<i class="fas fa-redo me-1"></i>Resend');
                alert('Request failed. Please try again.');
            }
        });
    });

    /* ── M4: Onboarding — refresh acceptance status ── */

    $('#btnCheckOnboarding').on('click', function () {
        if (!currentRecordId) return;
        var btn = $(this);
        btn.prop('disabled',true).html('<i class="fas fa-spinner fa-spin me-1"></i>Refreshing...');
        $('#mgmLoading').show(); $('#mgmContent').hide();
        resetPipeline();
        loadRecordDetails(currentRecordId);
    });

    /* ── Plivo Call ─────────────────────────────────────────── */

    function syncPlivoCallUI(r) {
        var card = $('#plivoCallCard'), btn = $('#btnInitiateCall'), detBtn = $('#btnViewCallDetails');
        var result = $('#plivoCallResult'), detPanel = $('#plivoCallDetailsPanel');

        var dispLabels = {
            'interested': 'Interested', 'not_interested': 'Not Interested', 'unsubscribe': 'Unsubscribe',
            'wrong_person': 'Wrong Person', 'busy': 'Busy', 'unclear': 'Unclear',
            'no_answer': 'No Answer', 'busy_rejected': 'Busy / Rejected', 'call_failed': 'Call Failed'
        };
        var prefLabels = {
            'self_registration': 'Will self-register', 'manual_onboarding': 'Prefers manual',
            'need_clarity': 'Needs clarity', 'facing_errors': 'Facing errors'
        };
        var retryableStatuses = ['no_answer', 'no-answer', 'busy', 'busy_rejected', 'failed', 'trigger-failed'];

        result.hide().empty(); detPanel.hide();
        btn.show().html('<i class="fas fa-phone-alt me-1"></i>Call Prospect');
        detBtn.hide();
        card.css('border-color', '#6f42c1').css('background', '#faf8ff');
        $('#plivoCallIcon').css('background', '#6f42c1');
        $('#plivoCallSubtitle').html('If the prospect hasn\'t responded to the email within 1 hour, a follow-up call is placed');

        var cardDisabled = card.hasClass('disabled');
        btn.prop('disabled', cardDisabled);

        if (!r.parsedPhone) {
            btn.prop('disabled', true);
            $('#plivoCallSubtitle').html('<span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>No phone number. Parse the resume first.</span>');
            return;
        }

        if (!r.plivoCallStatus) return;

        var status = r.plivoCallStatus;
        if (status === 'triggered' || status === 'initiated') {
            card.css('border-color', '#0d6efd').css('background', '#f0f6ff');
            $('#plivoCallIcon').css('background', '#0d6efd');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>In Progress');
            $('#plivoCallSubtitle').html('<span class="text-primary"><i class="fas fa-phone-volume me-1"></i>Call in progress...</span>');
            detBtn.show();
        } else if (status === 'completed' || status === 'answered') {
            card.css('border-color', '#198754').css('background', '#f0fdf4');
            $('#plivoCallIcon').css('background', '#198754');
            detBtn.show();

            var disp = r.plivoProspectDisposition || '';
            var dispHtml = '';
            if (disp) {
                var dispLabel = dispLabels[disp] || disp;
                var dispClass = disp === 'interested' ? 'text-success' : 'text-danger';
                dispHtml = '<span class="' + dispClass + ' fw-bold"><i class="fas fa-phone-alt me-1"></i>' + dispLabel + '</span>';
            }
            var prefHtml = '';
            if (r.plivoOnboardingPreference) {
                prefHtml = ' &middot; <span class="text-info">' + (prefLabels[r.plivoOnboardingPreference] || r.plivoOnboardingPreference) + '</span>';
            }
            var kycHtml = '';
            if (r.plivoKycAccepted === true) kycHtml = ' &middot; <span class="text-success">KYC OK</span>';
            else if (r.plivoKycAccepted === false) kycHtml = ' &middot; <span class="text-danger">KYC declined</span>';

            var isNegative = disp && disp !== 'interested';
            if (isNegative && disp !== 'unsubscribe') {
                btn.prop('disabled', false).html('<i class="fas fa-redo me-1"></i>Retry Call');
            } else {
                btn.hide();
            }

            result.html('<span class="text-success"><i class="fas fa-check-circle me-1"></i>Call completed</span>' +
                (dispHtml ? '<br/>' + dispHtml + prefHtml + kycHtml : '')).show();
            $('#plivoCallSubtitle').html('<span class="text-success" style="font-size:11px;">Call completed</span>');
        } else if (retryableStatuses.indexOf(status) !== -1) {
            var isNoAnswer = (status === 'no_answer' || status === 'no-answer' || status === 'busy' || status === 'busy_rejected');
            if (isNoAnswer) {
                card.css('border-color', '#ffc107').css('background', '#fffcf0');
                $('#plivoCallIcon').css('background', '#ffc107');
                result.html('<span class="text-warning"><i class="fas fa-phone-slash me-1"></i>' + (dispLabels[status] || 'No answer') + '. You can retry.</span>').show();
                $('#plivoCallSubtitle').html('<span class="text-warning" style="font-size:11px;">Prospect did not answer</span>');
            } else {
                card.css('border-color', '#dc3545').css('background', '#fef2f2');
                $('#plivoCallIcon').css('background', '#dc3545');
                result.html('<span class="text-danger"><i class="fas fa-times-circle me-1"></i>Call failed. You can retry.</span>').show();
                $('#plivoCallSubtitle').html('<span class="text-danger" style="font-size:11px;">Call failed</span>');
            }
            btn.prop('disabled', false).html('<i class="fas fa-redo me-1"></i>Retry Call');
            detBtn.show();
        }
    }

    $('#btnInitiateCall').on('click', function () {
        if (!currentRecordId) return;
        if (!currentRecord || !currentRecord.parsedPhone) { alert('No phone number available. Parse the resume first.'); return; }
        if (!confirm('Initiate Plivo AI recruitment call to ' + (currentRecord.candidateName || 'prospect') + ' (' + currentRecord.parsedPhone + ')?')) return;

        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Calling...');
        $('#plivoCallSubtitle').html('<span class="text-primary"><i class="fas fa-phone-volume me-1"></i>Initiating call...</span>');

        $.ajax({
            url: '@Url.Action("InitiatePlivoCall", "NaukriOnboarding")', type: 'POST', timeout: 30000,
            data: { __RequestVerificationToken: verificationToken, id: currentRecordId },
            success: function (res) {
                if (res.success) {
                    $('#plivoCallResult').html('<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + (res.message || 'Call initiated.') + '</span>').show();
                    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>In Progress');
                    $('#plivoCallSubtitle').html('<span class="text-primary"><i class="fas fa-phone-volume me-1"></i>Call in progress...</span>');
                    $('#btnViewCallDetails').show();
                    if (currentRecord) { currentRecord.plivoCallStatus = 'triggered'; currentRecord.plivoConversationId = res.conversationId; }
                } else {
                    $('#plivoCallResult').html('<span class="text-danger"><i class="fas fa-times-circle me-1"></i>' + (res.error || 'Failed.') + '</span>').show();
                    btn.prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Prospect');
                    $('#plivoCallSubtitle').html('If the prospect hasn\'t responded to the email within 1 hour, a follow-up call is placed');
                }
            },
            error: function () {
                $('#plivoCallResult').html('<span class="text-danger"><i class="fas fa-times-circle me-1"></i>Request failed.</span>').show();
                btn.prop('disabled', false).html('<i class="fas fa-phone-alt me-1"></i>Call Prospect');
                $('#plivoCallSubtitle').html('If the prospect hasn\'t responded to the email within 1 hour, a follow-up call is placed');
            }
        });
    });

    $('#btnViewCallDetails').on('click', function () {
        var panel = $('#plivoCallDetailsPanel');
        if (panel.is(':visible')) { panel.slideUp(200); return; }
        panel.slideDown(200);
        loadPlivoCallDetails();
    });

    function loadPlivoCallDetails() {
        if (!currentRecordId) return;
        $.ajax({
            url: '@Url.Action("GetPlivoCallDetails", "NaukriOnboarding")', type: 'GET', data: { id: currentRecordId },
            success: function (res) {
                if (!res.success) return;
                var dispLabels = { 'interested': 'Interested', 'not_interested': 'Not Interested', 'unsubscribe': 'Unsubscribe', 'wrong_person': 'Wrong Person', 'busy': 'Busy', 'unclear': 'Unclear', 'no_answer': 'No Answer', 'busy_rejected': 'Busy / Rejected', 'call_failed': 'Call Failed' };
                var prefLabels = { 'self_registration': 'Will self-register', 'manual_onboarding': 'Prefers manual onboarding', 'need_clarity': 'Needs clarity', 'facing_errors': 'Facing errors while onboarding' };

                $('#plivoDetDisposition').text(dispLabels[res.plivoProspectDisposition] || res.plivoProspectDisposition || '—');
                $('#plivoDetPreference').text(prefLabels[res.plivoOnboardingPreference] || res.plivoOnboardingPreference || '—');
                $('#plivoDetKyc').text(res.plivoKycAccepted === true ? 'Yes' : res.plivoKycAccepted === false ? 'No' : '—');
                $('#plivoDetDuration').text(res.plivoCallDuration ? res.plivoCallDuration + 's' : '—');
                $('#plivoDetCalledAt').text(res.plivoCallAt || '—');
                $('#plivoDetCalledBy').text(res.plivoCalledBy || '—');

                if (res.plivoCallSummary) {
                    $('#plivoDetSummary').text(res.plivoCallSummary);
                    $('#plivoDetSummaryWrap').show();
                } else { $('#plivoDetSummaryWrap').hide(); }

                if (res.plivoCallTranscript) {
                    $('#plivoDetTranscript').text(res.plivoCallTranscript);
                    $('#plivoDetTranscriptWrap').show();
                } else { $('#plivoDetTranscriptWrap').hide(); }

                // Update the card UI with fresh data
                if (currentRecord) {
                    currentRecord.plivoCallStatus = res.plivoCallStatus;
                    currentRecord.plivoProspectDisposition = res.plivoProspectDisposition;
                    currentRecord.plivoOnboardingPreference = res.plivoOnboardingPreference;
                    currentRecord.plivoKycAccepted = res.plivoKycAccepted;
                    currentRecord.plivoCallDuration = res.plivoCallDuration;
                    syncPlivoCallUI(currentRecord);
                    $('#plivoCallDetailsPanel').show();
                }
            }
        });
    }

    /* Batch Call functionality moved to dedicated /NaukriOnboarding/BatchCall page */

</script>
}
