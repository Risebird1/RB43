@model List<Risebird.Entities.ViewModel.NaukriProspectiveInterviewerVM>
@{
    ViewData["Title"] = "Naukri Prospective Interviewer Onboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int page = ViewBag.Page != null ? (int)ViewBag.Page : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 25;
    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    string selStatus = ViewBag.Status as string ?? string.Empty;
    string selName = ViewBag.CandidateName as string ?? string.Empty;
    string selMag = ViewBag.MagName as string ?? string.Empty;
    string selDateFrom = ViewBag.DateFrom as string ?? string.Empty;
    string selDateTo = ViewBag.DateTo as string ?? string.Empty;
    string profileName = ViewBag.ProfileName as string ?? string.Empty;
    bool canDelete = profileName == "Admin" || profileName == "SupportAdmin";

    bool hasFilters = !string.IsNullOrEmpty(selStatus) || !string.IsNullOrEmpty(selName)
                   || !string.IsNullOrEmpty(selMag) || !string.IsNullOrEmpty(selDateFrom)
                   || !string.IsNullOrEmpty(selDateTo);

    int first = totalCount == 0 ? 0 : (page - 1) * pageSize + 1;
    int last = Math.Min(page * pageSize, totalCount);

    string pageUrl(int p)
    {
        var q = $"?page={p}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(selStatus)) q += $"&status={Uri.EscapeDataString(selStatus)}";
        if (!string.IsNullOrEmpty(selName)) q += $"&candidateName={Uri.EscapeDataString(selName)}";
        if (!string.IsNullOrEmpty(selMag)) q += $"&magName={Uri.EscapeDataString(selMag)}";
        if (!string.IsNullOrEmpty(selDateFrom)) q += $"&dateFrom={Uri.EscapeDataString(selDateFrom)}";
        if (!string.IsNullOrEmpty(selDateTo)) q += $"&dateTo={Uri.EscapeDataString(selDateTo)}";
        return Url.Action("Index", "NaukriOnboarding") + q;
    }
}

<style>
    #loadingOverlay { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.8); z-index:9999; justify-content:center; align-items:center; }
    #loadingOverlay.show { display:flex; }
    #loadingOverlay .spinner-content { text-align:center; background:#fff; padding:30px 50px; border-radius:10px; box-shadow:0 4px 20px rgba(0,0,0,0.15); }
    #loadingOverlay .spinner-border { width:3rem; height:3rem; }
    #loadingOverlay .loading-text { margin-top:15px; font-weight:500; color:#495057; }

    .nk-filter-control { min-height:30px; height:30px; color:grey; font-weight:500; font-size:12.7px !important; padding:0.2rem 0.6rem; line-height:1.5; }
    .badge { width:auto;padding:5px!important;}
    .nk-stat .stat-value { font-size:1.5rem; font-weight:700; }
    .nk-stat .stat-label { font-size:13px; font-weight:500; color:#495057; }

    #nkTable { table-layout:auto; width:100%; min-width:1200px; font-size:12px; }
    #nkTable.table-sm > thead > tr > th, #nkTable.table-sm > tbody > tr > td { padding:0.3rem 0.45rem; vertical-align:top; }
    #nkTable thead th { font-size:12px; font-weight:600; vertical-align:middle; white-space:nowrap; }

    .nk-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; max-width:100%; min-width:0; }

    .status-open { background:#fff3cd; color:#856404; border:1px solid #ffc107; }
    .status-closed { background:#d4d4d4; color:#3d3d3d; border:1px solid #999; }
    .status-inprogress { background:#cfe2ff; color:#0a3278; border:1px solid #0d6efd; }
    .status-verified { background:#d1e7dd; color:#0a3622; border:1px solid #198754; }
    .status-onboarded { background:#d1e7dd; color:#0f5132; border:1px solid #198754; }
    .status-rejected { background:#f8d7da; color:#842029; border:1px solid #dc3545; }

    .intent-badge { display:inline-block; font-size:10.5px; padding:0.22em 0.5em; border-radius:3px; font-weight:500; white-space:normal; line-height:1.3; max-width:100%; word-break:break-word; }
    .action-btns { display:flex; gap:6px; justify-content:center; flex-wrap:wrap; align-items:center; }
    #nkTable .action-btns .btn { font-size:9px !important; line-height:1.35; padding:0.28rem 0.5rem; border-radius:2px; font-weight:500; }
    #nkTable .action-btns .btn-manage-record { background:linear-gradient(135deg,#0d6efd 0%,#0a58ca 100%) !important; border:0; color:#fff !important; box-shadow:0 1px 3px rgba(13,110,253,.35); }
    #nkTable .action-btns .btn-manage-record:hover { filter:brightness(1.05); color:#fff !important; }
    #nkTable .action-btns .btn-delete-record { background:linear-gradient(180deg,#f8d7da 0%,#f1aeb5 100%) !important; border:1px solid #dc3545; color:#842029 !important; min-width:10px; padding:0.28rem 0.45rem; }
    #nkTable .action-btns .btn-delete-record:hover { background:#f5c2c7 !important; color:#58151c !important; }

    #main-panel .content.client .container-fluid { min-width:0; }

    .col-num { width:34px; } .col-date { width:108px; white-space:nowrap; }
    .col-name { max-width:160px; } .col-role { min-width:100px; max-width:160px; }
    .col-skills { min-width:120px; max-width:200px; }
    .col-mag { min-width:90px; max-width:150px; }
    .col-location { min-width:80px; max-width:130px; }
    .col-exp { width:60px; } .col-status { width:110px; white-space:nowrap; }
    .col-actions { width:100px; white-space:nowrap; }

    .mgm-header { background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%); color:#fff; border:0; padding:1rem 1.25rem; flex-wrap:wrap; gap:0.75rem; align-items:flex-start; }
    .mgm-header .modal-title-wrap { flex:1 1 220px; min-width:0; }
    .mgm-header .modal-title { font-size:1.05rem; font-weight:600; line-height:1.35; margin:0; word-wrap:break-word; }
    .mgm-header .btn-close { filter:invert(1) grayscale(100%) brightness(200%); opacity:.85; }
    #manageModal .modal-content { border:none; border-radius:12px; overflow:hidden; box-shadow:0 12px 40px rgba(0,0,0,.18),0 0 1px rgba(0,0,0,.08); }
    #manageModal .modal-body { font-size:12.5px; background:#fafbfc; }
    .mgm-meta { font-size:12.5px; color:#6c757d; }
    .mgm-meta strong { color:#212529; }
    .mgm-section-title { font-size:12px; font-weight:700; color:#6c757d; text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px; }
    .mgm-mail-body { white-space:pre-wrap; word-break:break-word; font-size:13px; line-height:1.75; background:#f8f9fa; border-radius:6px; padding:14px 18px; border:1px solid #e9ecef; max-height:200px; overflow-y:auto; }
    .mgm-action-card { border:1px solid #e9ecef; border-radius:8px; padding:16px; margin-bottom:12px; transition:border-color .2s; }
    .mgm-action-card.completed { border-color:#198754; background:#f0fdf4; }
    .mgm-action-card.failed { border-color:#dc3545; background:#fef2f2; }
    .mgm-action-card.pending { border-color:#dee2e6; }
    .mgm-action-card.disabled { opacity:.5; pointer-events:none; }
    .mgm-step-number { width:28px; height:28px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; flex-shrink:0; }
    .mgm-step-number.pending { background:#e9ecef; color:#6c757d; }
    .mgm-step-number.completed { background:#198754; color:#fff; }
    .mgm-step-number.failed { background:#dc3545; color:#fff; }
    .mgm-step-number.running { background:#0d6efd; color:#fff; }
    .mgm-action-btn { min-width:128px; font-size:12px !important; font-weight:600; padding:0.4rem 0.85rem !important; line-height:1.4 !important; border-radius:8px !important; }
    .mgm-action-btn.btn-success { box-shadow:0 2px 6px rgba(25,135,84,.25); }
    .mgm-action-btn.btn-info { box-shadow:0 2px 6px rgba(13,202,240,.3); }
    .mgm-btn-view-resume { font-size:12px !important; padding:0.4rem 0.75rem !important; line-height:1.4 !important; border-radius:8px !important; }
    .mgm-status-strip { background:linear-gradient(180deg,#fff 0%,#f4f6f8 100%); border-bottom:1px solid #e2e6ea !important; }
    .mgm-status-btns .btn { font-size:12px !important; padding:0.35rem 0.75rem !important; line-height:1.4 !important; border-radius:8px !important; font-weight:500; }
    .mgm-status-badge-wrap .badge { font-size:12.5px !important; font-weight:600; padding:0.45rem 0.85rem !important; border-radius:8px; }
    .mgm-footer .btn { font-size:12px !important; padding:0.45rem 1rem !important; border-radius:8px !important; font-weight:500; }
    .mgm-footer .btn-refresh-manage { border:1px solid #ced4da; background:#fff; color:#495057; }
    .mgm-footer .btn-refresh-manage:hover { background:#f8f9fa; border-color:#adb5bd; color:#212529; }
    .nk-page-refresh { font-size:12px !important; font-weight:600; padding:0.4rem 0.9rem !important; border-radius:8px !important; border:1px solid #9fd89f !important; background:linear-gradient(180deg,#e8f8e8 0%,#d4edda 100%) !important; color:#0f5132 !important; box-shadow:0 1px 3px rgba(25,135,84,.12); }
    .nk-page-refresh:hover { background:#d1e7dd !important; border-color:#75b879 !important; color:#0a3622 !important; }
    .mgm-action-btn:disabled { opacity:.88; cursor:not-allowed; }
    .mgm-result-block { font-size:12px; margin-top:8px; padding:8px 12px; border-radius:6px; background:#f8f9fa; border:1px solid #e9ecef; max-height:200px; overflow-y:auto; }
    .mgm-footer { border-top:1px solid #e9ecef; background:#fafbfc; }
    .mgm-info-row { display:flex; align-items:flex-start; gap:10px; padding:8px 12px; border-radius:8px; background:#fff; border:1px solid #e9ecef; margin-bottom:8px; font-size:12.5px; box-shadow:0 1px 2px rgba(0,0,0,.04); }
    .mgm-info-row .label { font-weight:600; color:#495057; flex:0 0 108px; min-width:0; }
    .mgm-info-row .value { color:#212529; flex:1 1 auto; min-width:0; word-break:break-word; overflow-wrap:anywhere; line-height:1.45; }
    .employed-yes { color:#198754; font-weight:600; }
    .employed-no { color:#dc3545; font-weight:600; }
    .skills-wrap { font-size:11px; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; word-break:break-word; }

    .inline-edit-btn { background:none; border:none; color:#6c757d; padding:2px 4px; cursor:pointer; font-size:11px; vertical-align:middle; transition:color .15s; }
    .inline-edit-btn:hover { color:#0d6efd; }
    .inline-edit-group { display:inline-flex; align-items:center; gap:4px; }
    .inline-edit-group input { font-size:12px; padding:2px 8px; height:28px; border-radius:4px; border:1px solid #ced4da; min-width:160px; }
    .inline-edit-group .btn { font-size:10px; padding:2px 8px; line-height:1.4; border-radius:4px; }

    .mag-dropdown-wrap { position:relative; display:inline-block; }
    #magDropdown { display:none; position:absolute; z-index:1060; background:#fff; border:1px solid #dee2e6; border-radius:8px; box-shadow:0 6px 20px rgba(0,0,0,.18); width:380px; max-height:360px; left:0; top:100%; margin-top:4px; }
    #magDropdown .mag-search-wrap { padding:8px 10px; border-bottom:1px solid #eee; }
    #magDropdown .mag-search-wrap input { font-size:12px; }
    #magList { max-height:270px; overflow-y:auto; padding:4px; }
    #magList .mag-item { padding:6px 10px; font-size:12px; cursor:pointer; border-radius:4px; transition:background .12s; display:flex; justify-content:space-between; align-items:center; }
    #magList .mag-item:hover { background:#e9ecef; }
    #magList .mag-item.active { background:#0d6efd; color:#fff; }
    #magList .mag-item .mag-ag { font-size:10px; opacity:.7; }
    #magList .mag-no-results { padding:12px; text-align:center; color:#6c757d; font-size:12px; }
</style>

<div id="loadingOverlay">
    <div class="spinner-content">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        <div class="loading-text">Loading records...</div>
    </div>
</div>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="content client">
            <div class="container-fluid py-4">

                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h4 class="fw-bold mb-0"><i class="fas fa-user-graduate text-primary me-2"></i>Naukri Prospective Interviewer Onboarding</h4>
                        <p class="text-muted mb-0 mt-1">Prospective interviewers sourced from Naukri.com, processed via Relay.app</p>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        <button type="button" class="btn btn-sm nk-page-refresh" onclick="location.reload()" title="Reload this page"><i class="fas fa-sync-alt me-1"></i>Refresh</button>
                    </div>
                </div>

                @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

                @{ var cardOpen = Model.Count(r => string.Equals(r.Status, "Open", StringComparison.OrdinalIgnoreCase));
                   var cardIP = Model.Count(r => string.Equals(r.Status, "InProgress", StringComparison.OrdinalIgnoreCase));
                   var cardVerified = Model.Count(r => string.Equals(r.Status, "Verified", StringComparison.OrdinalIgnoreCase));
                   var cardOnboarded = Model.Count(r => string.Equals(r.Status, "Onboarded", StringComparison.OrdinalIgnoreCase));
                   var cardRejected = Model.Count(r => string.Equals(r.Status, "Rejected", StringComparison.OrdinalIgnoreCase)); }
                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-primary">@totalCount</div><div class="stat-label">@(hasFilters ? "Matched" : "Total")</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-warning">@cardOpen</div><div class="stat-label">Open</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-info">@cardIP</div><div class="stat-label">In Progress</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-success">@cardVerified</div><div class="stat-label">Verified</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value" style="color:#0f5132;">@cardOnboarded</div><div class="stat-label">Onboarded</div></div></div>
                    <div class="col-6 col-sm-3 col-md-2"><div class="card border-0 shadow-sm text-center py-3 nk-stat"><div class="stat-value text-danger">@cardRejected</div><div class="stat-label">Rejected</div></div></div>
                </div>

                <form asp-action="Index" asp-controller="NaukriOnboarding" method="get" id="filterForm">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex align-items-center gap-2" style="flex-wrap:nowrap;width:100%;">
                                <select name="status" class="form-select nk-filter-control" style="flex:1 1 0;min-width:120px;max-width:155px;" onchange="document.getElementById('filterForm').submit()">
                                    <option value="">All statuses</option>
                                    @if (selStatus == "Open") { <option value="Open" selected>Open</option> } else { <option value="Open">Open</option> }
                                    @if (selStatus == "InProgress") { <option value="InProgress" selected>In Progress</option> } else { <option value="InProgress">In Progress</option> }
                                    @if (selStatus == "Verified") { <option value="Verified" selected>Verified</option> } else { <option value="Verified">Verified</option> }
                                    @if (selStatus == "Onboarded") { <option value="Onboarded" selected>Onboarded</option> } else { <option value="Onboarded">Onboarded</option> }
                                    @if (selStatus == "Rejected") { <option value="Rejected" selected>Rejected</option> } else { <option value="Rejected">Rejected</option> }
                                    @if (selStatus == "Closed") { <option value="Closed" selected>Closed</option> } else { <option value="Closed">Closed</option> }
                                </select>
                                <input type="text" name="candidateName" class="form-control nk-filter-control" placeholder="Candidate name..." style="flex:1 1 0;min-width:130px;" value="@selName" />
                                <input type="text" name="magName" class="form-control nk-filter-control" placeholder="MAG name..." style="flex:1 1 0;min-width:120px;" value="@selMag" />
                                <input type="date" name="dateFrom" class="form-control nk-filter-control" style="flex:1 1 0;min-width:120px;" value="@selDateFrom" onchange="document.getElementById('filterForm').submit()" />
                                <span class="text-muted flex-shrink-0" style="font-size:11px;">\u2013</span>
                                <input type="date" name="dateTo" class="form-control nk-filter-control" style="flex:1 1 0;min-width:120px;" value="@selDateTo" onchange="document.getElementById('filterForm').submit()" />
                                <button style="background:#07363c4f !important;border:0px;padding:7px 10px;" type="submit" class="btn btn-primary btn-sm flex-shrink-0"><i class="fas fa-filter me-1"></i>Apply</button>
                                <a style="padding:7px 10px!important;border:0px;background:#da7c7c !important;color:#fff" asp-action="Index" asp-controller="NaukriOnboarding" class="btn btn-sm btn-outline-secondary flex-shrink-0"><i class="fas fa-times me-1"></i>Clear</a>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                <span>@(hasFilters ? "No records match the selected filters." : "No Naukri prospects yet. Once Relay.app routes a Naukri email, it will appear here.")</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive nk-scroll">
                                <table id="nkTable" class="table table-hover table-sm mb-0 align-top">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="col-num">#</th><th class="col-date">Received</th>
                                            <th class="col-name">Candidate</th><th class="col-role">Current Role</th>
                                            <th class="col-exp">Exp</th><th class="col-location">Location</th>
                                            <th class="col-mag">MAG</th><th class="col-skills">Key Skills</th>
                                            <th class="col-status">Status</th><th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model)
                                        {
                                            string rStatus = r.Status?.ToLower() ?? "open";
                                            string statusCss = rStatus switch {
                                                "open" => "status-open", "inprogress" => "status-inprogress",
                                                "verified" => "status-verified", "onboarded" => "status-onboarded",
                                                "rejected" => "status-rejected", "closed" => "status-closed",
                                                _ => "bg-light border" };

                                            <tr id="row-@r.Id">
                                                <td class="col-num text-muted" style="font-size:12px">@r.Id</td>
                                                <td class="col-date" style="font-size:12px">@(r.ReceivedAt.HasValue ? r.ReceivedAt.Value.ToString("dd MMM yy, HH:mm") : "\u2014")</td>
                                                <td class="col-name">
                                                    <span class="fw-semibold" style="font-size:12px;white-space:break-spaces;">@(r.CandidateName ?? "\u2014")</span>
                                                    @if (!string.IsNullOrEmpty(r.ParsedEmail)) { <br /><span class="text-muted" style="font-size:10px;">@r.ParsedEmail</span> }
                                                </td>
                                                <td class="col-role" style="font-size:12px;white-space:break-spaces;">@(r.CurrentRole ?? "\u2014")</td>
                                                <td class="col-exp" style="font-size:12px;">@(r.ExperienceYears ?? "\u2014")</td>
                                                <td class="col-location" style="font-size:12px;">@(r.Location ?? "\u2014")</td>
                                                <td class="col-mag" style="font-size:12px;">
                                                    @(r.MagName ?? "\u2014")
                                                    @if (!string.IsNullOrEmpty(r.AssessmentGroupName)) { <br /><span class="text-muted" style="font-size:10px;">@r.AssessmentGroupName</span> }
                                                </td>
                                                <td class="col-skills"><div class="skills-wrap">@(r.KeySkills ?? "\u2014")</div></td>
                                                <td class="col-status">
                                                    <span class="intent-badge @statusCss" style="word-break:normal;">@(r.Status ?? "Open")</span>
                                                    @if (r.ResumeAIAnalysisCompleted == true)
                                                    {
                                                        string aiBadgeClass = "text-info";
                                                        string aiLabel = "AI";
                                                        try
                                                        {
                                                            if (!string.IsNullOrWhiteSpace(r.ResumeAIAnalysisResult))
                                                            {
                                                                var aiData = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(r.ResumeAIAnalysisResult);
                                                                string vrd = aiData?.verdict;
                                                                string sc = aiData?.fitmentScore?.ToString();
                                                                if (!string.IsNullOrEmpty(vrd))
                                                                {
                                                                    bool isYes = vrd.Equals("yes", StringComparison.OrdinalIgnoreCase);
                                                                    aiBadgeClass = isYes ? "text-success" : "text-danger";
                                                                    aiLabel = isYes ? "Yes" : "No";
                                                                }
                                                                if (!string.IsNullOrEmpty(sc)) aiLabel += " \u00B7 " + sc;
                                                            }
                                                        }
                                                        catch { }
                                                        <br /><span style="font-size:9px;" class="@aiBadgeClass" title="AI Verdict"><i class="fas fa-robot"></i> @aiLabel</span>
                                                    }
                                                    @if (r.OnboardingCompleted == true) { <br /><span style="font-size:9px;" class="text-success"><i class="fas fa-check-double"></i> Onboarded</span> }
                                                </td>
                                                <td class="col-actions">
                                                    <div class="action-btns d-flex align-items-center flex-wrap gap-1">
                                                        <button type="button" title="Manage \u2014 review, verify &amp; onboard"
                                                                class="btn btn-primary btn-manage-record"
                                                                data-record-id="@r.Id">
                                                            <i class="fas fa-bars me-1"></i>Manage
                                                        </button>
                                                        @if (canDelete)
                                                        {
                                                            <button type="button" title="Delete this record"
                                                                    class="btn btn-danger btn-sm btn-delete-record"
                                                                    data-record-id="@r.Id">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                        <div class="text-muted" style="font-size:12px;">
                            Showing @first\u2013@last of @totalCount records
                            <span class="ms-3">Page size:
                                @foreach (var sz in new[] { 10, 25, 50, 100 })
                                { if (pageSize == sz) { <strong class="ms-1">@sz</strong> } else { <a href="javascript:void(0)" class="ms-1 text-decoration-none" onclick="changePageSize(@sz)">@sz</a> } }
                            </span>
                        </div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")"><a class="page-link" href="@pageUrl(page - 1)">Prev</a></li>
                                @for (int p = Math.Max(1, page - 2); p <= Math.Min(totalPages, page + 2); p++) { <li class="page-item @(p == page ? "active" : "")"><a class="page-link" href="@pageUrl(p)">@p</a></li> }
                                <li class="page-item @(page >= totalPages ? "disabled" : "")"><a class="page-link" href="@pageUrl(page + 1)">Next</a></li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<form id="__AjaxAntiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- ══════════════════════ Manage Modal ══════════════════════ -->
<div class="modal fade" id="manageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header mgm-header">
