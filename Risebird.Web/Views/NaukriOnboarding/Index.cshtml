    .mgm-action-btn.btn-success { box-shadow:0 2px 6px rgba(25,135,84,.25); }
    .mgm-action-btn.btn-info { box-shadow:0 2px 6px rgba(13,202,240,.3); }
    .mgm-btn-view-resume { font-size:12px !important; padding:0.4rem 0.75rem !important; line-height:1.4 !important; border-radius:8px !important; }
    .mgm-status-strip { background:linear-gradient(180deg,#fff 0%,#f4f6f8 100%); border-bottom:1px solid #e2e6ea !important; }
    .mgm-status-btns .btn { font-size:12px !important; padding:0.35rem 0.75rem !important; line-height:1.4 !important; border-radius:8px !important; font-weight:500; }
    .mgm-status-badge-wrap .badge { font-size:12.5px !important; font-weight:600; padding:0.45rem 0.85rem !important; border-radius:8px; }
    .mgm-footer .btn { font-size:12px !important; padding:0.45rem 1rem !important; border-radius:8px !important; font-weight:500; }
    .mgm-footer .btn-refresh-manage { border:1px solid #ced4da; background:#fff; color:#495057; }
    .mgm-footer .btn-refresh-manage:hover { background:#f8f9fa; border-color:#adb5bd; color:#212529; }
    .nk-page-refresh { font-size:12px !important; font-weight:600; padding:0.4rem 0.9rem !important; border-radius:8px !important; border:1px solid #9fd89f !important; background:linear-gradient(180deg,#e8f8e8 0%,#d4edda 100%) !important; color:#0f5132 !important; box-shadow:0 1px 3px rgba(25,135,84,.12); }
    .nk-page-refresh:hover { background:#d1e7dd !important; border-color:#75b879 !important; color:#0a3622 !important; }
    .mgm-action-btn:disabled { opacity:.88; cursor:not-allowed; }
    .mgm-result-block { font-size:12px; margin-top:8px; padding:8px 12px; border-radius:6px; background:#f8f9fa; border:1px solid #e9ecef; max-height:200px; overflow-y:auto; }
    .mgm-footer { border-top:1px solid #e9ecef; background:#fafbfc; }

    /* SendGrid email delivery events (per pipeline step) */
    .mgm-email-events:empty { display:none; }
    .evt-card { border:1px solid #e9ecef; border-radius:8px; background:#fcfcff; padding:8px 10px; }
    .evt-head { display:flex; align-items:baseline; justify-content:space-between; gap:8px; flex-wrap:wrap; margin-bottom:6px; }
    .evt-title { font-size:11.5px; font-weight:700; color:#334155; }
    .evt-sent { font-size:10.5px; color:#9aa0a6; }
    .evt-chips { display:flex; gap:6px; flex-wrap:wrap; }
    .evt-chip { font-size:10.5px; font-weight:600; border-radius:6px; padding:2px 8px; white-space:nowrap; }
    .evt-warn { margin-top:6px; font-size:11px; color:#842029; background:#fff5f5; border:1px solid #f5c2c7; border-radius:6px; padding:5px 8px; }
    .evt-pending { margin-top:6px; font-size:10.5px; color:#94a3b8; }
