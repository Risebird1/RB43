    #mgmMag.mgm-ellipsis-mag { display:inline-block; max-width:min(340px,70vw); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:bottom; }
    #mgmSkills.mgm-ellipsis-skills { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; word-break:break-word; max-width:100%; }

    .inline-edit-btn { background:none; border:none; color:#6c757d; padding:2px 4px; cursor:pointer; font-size:11px; vertical-align:middle; transition:color .15s; }
    .inline-edit-btn:hover { color:#0d6efd; }
    .inline-edit-group { display:inline-flex; align-items:center; gap:4px; }
    .inline-edit-group input { font-size:12px; padding:2px 8px; height:28px; border-radius:4px; border:1px solid #ced4da; min-width:160px; }
    .inline-edit-group .btn { font-size:10px; padding:2px 8px; line-height:1.4; border-radius:4px; }

    .btn-history { font-size:11px; padding:2px 6px; line-height:1.4; flex-shrink:0; }

    .history-timeline { list-style:none; padding:0; margin:0; }
    .history-timeline li { display:flex; gap:12px; padding:10px 0; border-bottom:1px solid #f0f0f0; align-items:flex-start; }
