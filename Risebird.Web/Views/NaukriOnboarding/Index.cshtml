                                <span><strong>Candidate:</strong> <span id="mgmName"></span></span><br/>
                                <span><strong>Current Role:</strong> <span id="mgmRole"></span></span><br/>
                                <span><strong>Experience:</strong> <span id="mgmExp"></span></span><br/>
