<!-- Detail Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-search me-2"></i>Call Detail — <span id="detailTitle"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailBody">
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            </div>
        </div>
    </div>
</div>

@{
    var jsonData = System.Text.Json.JsonSerializer.Serialize(Model.Select(r => new {
        r.CallLogId,
        r.CandidateName,
        r.CandidateEmail,
        r.RecipientPhone,
        r.IRFId,
        r.JDTiltle,
        r.ClientName,
        r.TriggeredBy,
        r.PlivoCXConversationId,
        r.CallPurpose,
        r.CallStatus,
        r.DurationSeconds,
        r.HangupCause,
        CallInitiatedAt         = r.CallInitiatedAt.ToString("dd MMM yyyy HH:mm"),
        CallEndedAt             = r.CallEndedAt?.ToString("dd MMM yyyy HH:mm"),
        r.CandidateDisposition,
        r.AIReportedBooked,
        r.BookedInterviewDate,
        r.BookedInterviewTime,
        BookedInterviewDateTime = r.BookedInterviewDateTime?.ToString("dd MMM yyyy HH:mm"),
        r.BookingApiSuccess,
        r.BookingApiResponse,
        r.CallTranscript,
        r.ConversationSummary,
        r.MeetingCreated,
        r.MeetingId,
        MeetingScheduledAt      = r.MeetingScheduledAt?.ToString("dd MMM yyyy HH:mm"),
        r.InterviewSlot,
        r.InterviewDuration,
        r.MeetingConfirmationStatus,
        r.Interviewer,
        r.RisebirdHR,
        r.ClientHrContact,
        r.IsAutoCancelled,
        r.CancellationReason,
        r.IsCandidateResponsed,
        r.CandidateResponse,
        MeetingCreatedOn        = r.MeetingCreatedOn?.ToString("dd MMM yyyy HH:mm")
    }));
}

@section Scripts {
<script>
    var allRows = @Html.Raw(jsonData);

    // ── Current filter state from server ─────────────────────────────────────
    var serverFilters = {
        status:      '@(fStatus      ?? "")',
        purpose:     '@(fPurpose     ?? "")',
        meeting:     '@(fMeeting     ?? "")',
        disposition: '@(fDisposition ?? "")',
        clientName:  '@(fClientName  ?? "")',
        dateFrom:    '@(fDateFrom    ?? "")',
        dateTo:      '@(fDateTo      ?? "")',
        pageSize:    '@pageSize',
        page:        '1'
    };

    // Navigate to page 1 with an updated filter, keeping all other active filters.
    // filterName = 'status' | 'purpose' | 'meeting' | 'disposition' | 'pageSize'
    // forcePage  = override page number (optional, default 1)
    function applyServerFilter(filterName, value, forcePage) {
        var params = Object.assign({}, serverFilters);
        params[filterName] = value;
        params['page']     = forcePage != null ? String(forcePage) : '1';

        var qs = Object.keys(params)
            .filter(function(k) { return params[k] !== '' && params[k] != null; })
            .map(function(k)    { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
            .join('&');

        window.location = '@Url.Action("Index")' + (qs ? '?' + qs : '');
    }

    // ── Client-side search (filters within the current page only) ────────────
    document.getElementById('searchInput').addEventListener('input', function() {
        var search  = this.value.toLowerCase();
        var rows    = document.querySelectorAll('.call-row');
        var visible = 0;
        rows.forEach(function(row) {
            var show = !search || row.dataset.search.includes(search);
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        document.getElementById('rowCount').textContent =
            'Showing ' + visible + ' of ' + rows.length + ' on this page';
    });

    function showDetail(id) {
        var r = allRows.find(function(x) { return x.callLogId === id; });
        if (!r) return;

        document.getElementById('detailTitle').textContent =
            (r.candidateName || '—') + ' (' + (r.candidateEmail || '—') + ')';

        var conf = { '1':'Confirmed','2':'Cancelled','0':'Pending' };
        var html = '<div class="row g-3">';

        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-phone me-2 text-primary"></i>Call Info</h6>';
        html += row('Log ID',         r.callLogId);
        html += row('Purpose',        badge(r.callPurpose, r.callPurpose === 'reschedule' ? 'warning' : 'primary'));
        html += row('Status',         badge(r.callStatus,  statusColour(r.callStatus)));
        html += row('Duration',       r.durationSeconds ? r.durationSeconds + 's' : '—');
        html += row('Hangup Cause',   r.hangupCause || '—');
        html += row('Initiated At',   r.callInitiatedAt || '—');
        html += row('Ended At',       r.callEndedAt || '—');
        html += row('Triggered By',   r.triggeredBy || '—');
        html += row('Conversation ID',r.plivoCXConversationId || '—');
        html += '</div></div></div>';

        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-user me-2 text-info"></i>Candidate</h6>';
        html += row('Name',        r.candidateName || '—');
        html += row('Email',       r.candidateEmail || '—');
        html += row('Phone',       r.recipientPhone || '—');
        html += row('IRF',         (r.irfId || '—') + ' — ' + (r.jdTiltle || ''));
        html += row('Client',      r.clientName || '—');
        html += row('Disposition', badge(r.candidateDisposition || '—', dispColour(r.candidateDisposition)));
        html += '</div></div></div>';

        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-calendar-check me-2 text-success"></i>Booking</h6>';
        html += row('AI Reported Booked', badge(r.aIReportedBooked ? 'YES' : 'NO', r.aIReportedBooked ? 'success' : 'secondary'));
        html += row('Interview Date',     r.bookedInterviewDate || '—');
        html += row('Interview Time',     r.bookedInterviewTime || '—');
        html += row('DateTime (parsed)',  r.bookedInterviewDateTime || '—');
        html += row('API Success',        badge(r.bookingApiSuccess ? 'YES' : 'NO', r.bookingApiSuccess ? 'success' : 'danger'));
        html += row('API Response',       '<small class="text-muted font-monospace" style="word-break:break-all">' + (r.bookingApiResponse || '—') + '</small>');
        html += '</div></div></div>';

        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-calendar me-2 text-warning"></i>Interview Meeting</h6>';
        html += row('Meeting Created', badge(r.meetingCreated, r.meetingCreated === 'YES' ? 'success' : 'secondary'));
        html += row('Meeting ID',      r.meetingId || '—');
        html += row('Scheduled At',    r.meetingScheduledAt || '—');
        html += row('Slot',            r.interviewSlot || '—');
        html += row('Duration',        r.interviewDuration ? r.interviewDuration + ' min' : '—');
        html += row('Confirmation',    badge(conf[r.meetingConfirmationStatus] || r.meetingConfirmationStatus || '—',
                                            r.meetingConfirmationStatus === '1' ? 'success' : r.meetingConfirmationStatus === '2' ? 'danger' : 'warning'));
        html += row('Interviewer',     r.interviewer || '—');
        html += row('Risebird HR',     r.risebirdHR || '—');
        html += row('Client HR',       r.clientHrContact || '—');
        html += row('Auto-Cancelled',  r.isAutoCancelled ? badge('YES','danger') : 'No');
        html += row('Cancel Reason',   r.cancellationReason || '—');
        html += row('Candidate Responded', r.isCandidateResponsed ? 'Yes' : 'No');
        html += row('Candidate Response',  r.candidateResponse || '—');
        html += row('Meeting Created On',  r.meetingCreatedOn || '—');
        html += '</div></div></div>';

        if (r.conversationSummary) {
            html += '<div class="col-12"><div class="card border-0 bg-light"><div class="card-body">';
            html += '<h6 class="fw-bold mb-2"><i class="fas fa-align-left me-2 text-secondary"></i>Conversation Summary</h6>';
            html += '<pre class="mb-0" style="white-space:pre-wrap;font-size:0.85rem;max-height:200px;overflow-y:auto">' + escHtml(r.conversationSummary) + '</pre>';
            html += '</div></div></div>';
        }

        if (r.callTranscript) {
            html += '<div class="col-12"><div class="card border-0 bg-light"><div class="card-body">';
            html += '<h6 class="fw-bold mb-2"><i class="fas fa-file-alt me-2 text-secondary"></i>Call Transcript</h6>';
            html += '<pre class="mb-0" style="white-space:pre-wrap;font-size:0.82rem;max-height:300px;overflow-y:auto">' + escHtml(r.callTranscript) + '</pre>';
            html += '</div></div></div>';
        }

        html += '</div>';
        document.getElementById('detailBody').innerHTML = html;
        new bootstrap.Modal(document.getElementById('detailModal')).show();
    }

    function row(label, value) {
        return '<div class="d-flex justify-content-between mb-1 small">' +
               '<span class="text-muted">' + label + '</span>' +
               '<span class="text-end" style="max-width:60%">' + (value ?? '—') + '</span></div>';
    }
    function badge(text, colour) {
        return '<span class="badge bg-' + colour + '">' + text + '</span>';
    }
    function statusColour(s) {
        var m = {completed:'success',triggered:'info',initiated:'secondary',
                 'no-answer':'warning','failed':'danger','trigger-failed':'danger'};
        return m[s] || 'secondary';
    }
    function dispColour(d) {
        return d === 'interested' ? 'success' : d === 'uninterested' ? 'danger' : 'secondary';
    }
    function escHtml(t) {
        return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
</script>
}
