@model List<Risebird.Entities.ViewModel.PlivoCXCallLogDetailVM>
@{
    ViewData["Title"] = "Plivo CX Call Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var first = Model.FirstOrDefault();
    int totalCalls     = ViewBag.TotalCount  != null ? (int)ViewBag.TotalCount  : 0;
    int completed      = first?.OverallCompleted      ?? 0;
    int meetingCreated = first?.OverallMeetingCreated ?? 0;
    int noAnswer       = first?.OverallNoAnswer       ?? 0;
    double rate        = totalCalls > 0 ? Math.Round((double)meetingCreated / totalCalls * 100, 1) : 0;

    int currentPage = ViewBag.Page       != null ? (int)ViewBag.Page       : 1;
    int pageSize    = ViewBag.PageSize   != null ? (int)ViewBag.PageSize   : 50;
    int totalPages  = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;

    int rangeStart  = totalCalls > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    int rangeEnd    = Math.Min(currentPage * pageSize, totalCalls);

    // Active filter values (null = no filter)
    string fStatus      = ViewBag.Status      as string;
    string fPurpose     = ViewBag.Purpose     as string;
    string fMeeting     = ViewBag.Meeting     as string;
    string fDisposition = ViewBag.Disposition as string;
    string fClientName  = ViewBag.ClientName  as string;
    string fDateFrom    = ViewBag.DateFrom    as string;
    string fDateTo      = ViewBag.DateTo      as string;

    // Helper: build a page URL carrying all current filters
    Func<int, int, string> pageUrl = (p, ps) =>
        Url.Action("Index", new {
            page        = p,
            pageSize    = ps,
            status      = fStatus,
            purpose     = fPurpose,
            meeting     = fMeeting,
            disposition = fDisposition,
            clientName  = fClientName,
            dateFrom    = fDateFrom,
            dateTo      = fDateTo
        }) ?? string.Empty;
}
<style>
    #searchInput.cx-filter-control,
    .cx-filter-control.form-select {
        min-height: 30px;
        color: grey;
        font-weight: 500;
        font-size: 12.7px !important;
        padding: 0.375rem 0.75rem;
        line-height: 1.5;
    }
    .cx-filter-control.form-select { min-width: 160px; }
    .plivo-cx-stat .stat-value { font-size: 1.5rem; font-weight: 700; }
    .plivo-cx-stat .stat-label { font-size: 13px; font-weight: 500; color: #495057; }
    #callTable .badge.cx-badge { width: auto; font-size: 11px !important; padding: 0.35em 0.65em; font-weight: 500; }
    #callTable td .cx-meeting-created { font-weight: 600; }
    .badge { width: auto; }
    .btn.btn-sm { font-size: 11px; padding: 3px 5px; background: #d4cece85; }
    .bg-success {
        --bs-bg-opacity: 1;
        background-color: rgb(31 160 100 / 85%) !important;
        font-size: 10px !important;
        line-height: 13px;
    }
    .table > thead > tr > th { font-size: 13px; }
    .bg-secondary { --bs-bg-opacity: 1; background-color: rgb(112 118 124 / 83%) !important; }
    .bg-warning {
        --bs-bg-opacity: 1;
        background-color: rgb(241 198 70 / 66%) !important;
        border: 0px;
        font-size: 11px !important;
    }
    #callTable .badge.cx-status-completed {
        background: linear-gradient(135deg, #127132bd 0%, #15c952 100%) !important;
        color: #fff !important;
        padding: 2px 8px;
        line-height: 16px;
        font-weight: 500;
        border: 1px solid rgba(255,255,255,.25);
        box-shadow: 0 1px 3px rgba(0,0,0,.12);
        font-size: 10px !important;
    }
    #callTable .cx-disposition-interested {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; font-weight: 500; color: #198754;
        background: none !important; padding: 0; border: none;
    }
    #callTable .cx-disposition-interested i { font-size: 14px; }
    #callTable .badge.cx-meeting-confirmed {
        background: #d4edda !important; color: #155724;
        padding: 0.35em 0.65em; font-weight: 500;
        border: 1px solid #c3e6cb; font-size: 12px;
    }
    #callTable .cx-value-yes {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; font-weight: 500; color: #198754;
        background: none !important; padding: 0; border: none;
    }
    #callTable .cx-value-yes i { font-size: 14px; }
    #callTable .cx-value-no {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; font-weight: 500; color: #dc3545;
        background: none !important; padding: 0; border: none;
        animation: none !important; transition: none !important;
    }
    #callTable .cx-value-no i { font-size: 14px; animation: none !important; transition: none !important; }
</style>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="content client">
            <div class="container-fluid py-4">

    <!-- Header -->
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h4 class="fw-bold mb-0">
                <i class="fas fa-robot text-success me-2"></i>Plivo CX AI Call Logs
            </h4>
            <p class="text-muted mb-0 mt-1">
                Outbound scheduling & rescheduling calls — AI conversation managed by
                <a href="https://cx.plivo.com" target="_blank">Plivo CX</a>.
            </p>
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#initiateCallModal">
                <i class="fas fa-calendar-plus me-1"></i>New Schedule Call
            </button>
            <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#initiateRescheduleModal">
                <i class="fas fa-calendar-alt me-1"></i>New Reschedule Call
            </button>
            <a asp-action="WebhookTest" class="btn btn-outline-info" target="_blank">
                <i class="fas fa-stethoscope me-1"></i>Config
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 plivo-cx-stat">
                <div class="stat-value text-primary">@totalCalls</div>
                <div class="stat-label">Total Calls</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 plivo-cx-stat">
                <div class="stat-value text-success">@completed</div>
                <div class="stat-label">Completed</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 plivo-cx-stat">
                <div class="stat-value text-info">@meetingCreated</div>
                <div class="stat-label">AI Reported Booked</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 plivo-cx-stat">
                <div class="stat-value text-success">@meetingCreated</div>
                <div class="stat-label">Meeting Created</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 plivo-cx-stat">
                <div class="stat-value text-danger">@noAnswer</div>
                <div class="stat-label">Failed / No Answer</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 plivo-cx-stat">
                <div class="stat-value text-warning">@rate%</div>
                <div class="stat-label">Conversion Rate</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <input type="text" id="searchInput" class="form-control cx-filter-control"
                           placeholder="Search name / email / IRF…" style="min-width:220px;height:30px;" />
                </div>
                @{
                    // Pre-compute selected flags to avoid string-literal ternaries inside HTML tag context.
                    bool sSel_completed     = fStatus == "completed";
                    bool sSel_triggered     = fStatus == "triggered";
                    bool sSel_initiated     = fStatus == "initiated";
                    bool sSel_noAnswer      = fStatus == "no-answer";
                    bool sSel_failed        = fStatus == "failed";
                    bool sSel_trigFailed    = fStatus == "trigger-failed";
                    bool pSel_schedule      = fPurpose == "schedule";
                    bool pSel_reschedule    = fPurpose == "reschedule";
                    bool mSel_yes           = fMeeting == "YES";
                    bool mSel_no            = fMeeting == "NO";
                    bool dSel_interested    = fDisposition == "interested";
                    bool dSel_uninterested  = fDisposition == "uninterested";
                    bool dSel_cantSay       = fDisposition == "cant_say";
                }
                <div class="col-auto">
                    <select id="statusFilter" class="form-select cx-filter-control" onchange="applyServerFilter('status', this.value)">
                        <option value="">All statuses</option>
                        @if (sSel_completed)   { <option value="completed"      selected>Completed</option>     } else { <option value="completed">Completed</option>     }
                        @if (sSel_triggered)   { <option value="triggered"      selected>Triggered</option>     } else { <option value="triggered">Triggered</option>     }
                        @if (sSel_initiated)   { <option value="initiated"      selected>Initiated</option>     } else { <option value="initiated">Initiated</option>     }
                        @if (sSel_noAnswer)    { <option value="no-answer"      selected>No Answer</option>     } else { <option value="no-answer">No Answer</option>     }
                        @if (sSel_failed)      { <option value="failed"         selected>Failed</option>        } else { <option value="failed">Failed</option>        }
                        @if (sSel_trigFailed)  { <option value="trigger-failed" selected>Trigger Failed</option>} else { <option value="trigger-failed">Trigger Failed</option>}
                    </select>
                </div>
                <div class="col-auto">
                    <select id="purposeFilter" class="form-select cx-filter-control" onchange="applyServerFilter('purpose', this.value)">
                        <option value="">All purposes</option>
                        @if (pSel_schedule)   { <option value="schedule"   selected>Schedule</option>   } else { <option value="schedule">Schedule</option>   }
                        @if (pSel_reschedule) { <option value="reschedule" selected>Reschedule</option> } else { <option value="reschedule">Reschedule</option> }
                    </select>
                </div>
                <div class="col-auto">
                    <select id="meetingFilter" class="form-select cx-filter-control" onchange="applyServerFilter('meeting', this.value)">
                        <option value="">All meetings</option>
                        @if (mSel_yes) { <option value="YES" selected>Meeting Created</option> } else { <option value="YES">Meeting Created</option> }
                        @if (mSel_no)  { <option value="NO"  selected>No Meeting</option>      } else { <option value="NO">No Meeting</option>      }
                    </select>
                </div>
                <div class="col-auto">
                    <select id="dispositionFilter" class="form-select cx-filter-control" onchange="applyServerFilter('disposition', this.value)">
                        <option value="">All dispositions</option>
                        @if (dSel_interested)   { <option value="interested"   selected>Interested</option>   } else { <option value="interested">Interested</option>   }
                        @if (dSel_uninterested) { <option value="uninterested" selected>Uninterested</option> } else { <option value="uninterested">Uninterested</option> }
                        @if (dSel_cantSay)      { <option value="cant_say"     selected>Can't Say</option>    } else { <option value="cant_say">Can't Say</option>    }
                    </select>
                </div>
                @{
                    var allClientNames = (ViewBag.AllClientNames as List<string>) ?? new List<string>();
                }
                <div class="col-auto">
                    <select id="clientNameFilter" class="form-select cx-filter-control" onchange="applyServerFilter('clientName', this.value)">
                        <option value="">All clients</option>
                        @foreach (var cn in allClientNames)
                        {
                            if (fClientName == cn)
                            {
                                <option value="@cn" selected>@cn</option>
                            }
                            else
                            {
                                <option value="@cn">@cn</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto d-flex align-items-center gap-1">
                    <label class="text-muted small mb-0 text-nowrap">Call date:</label>
                    <input type="date" id="dateFromInput" class="form-control cx-filter-control"
                           style="min-width:140px;"
                           value="@(fDateFrom ?? "")"
                           onchange="applyServerFilter('dateFrom', this.value)" />
                    <span class="text-muted small">–</span>
                    <input type="date" id="dateToInput" class="form-control cx-filter-control"
                           style="min-width:140px;"
                           value="@(fDateTo ?? "")"
                           onchange="applyServerFilter('dateTo', this.value)" />
                </div>
                @{
                    bool anyFilterActive = !string.IsNullOrEmpty(fStatus)      || !string.IsNullOrEmpty(fPurpose)
                                       || !string.IsNullOrEmpty(fMeeting)      || !string.IsNullOrEmpty(fDisposition)
                                       || !string.IsNullOrEmpty(fClientName)
                                       || !string.IsNullOrEmpty(fDateFrom)     || !string.IsNullOrEmpty(fDateTo);
                    string clearUrl = Url.Action("Index", new { page = 1, pageSize }) ?? string.Empty;
                }
                @if (anyFilterActive)
                {
                    <div class="col-auto">
                        <a href="@clearUrl" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>Clear filters
                        </a>
                    </div>
                }
                <div class="col-auto ms-auto">
                    <span class="text-muted small" id="rowCount">
                        Showing @rangeStart–@rangeEnd of @totalCalls
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle" id="callTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Candidate</th>
                            <th>Phone</th>
                            <th>IRF / Role</th>
                            <th>Purpose</th>
                            <th>Status</th>
                            <th>Duration</th>
                            <th>Recording</th>
                            <th>Disposition</th>
                            <th>AI Booked</th>
                            <th>Booking API</th>
                            <th>Meeting Created</th>
                            <th>Meeting Date</th>
                            <th>Meeting Status</th>
                            <th>Initiated</th>
                            <th>Triggered By</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="callTableBody">
                        @foreach (var r in Model)
                        {
                            <tr class="call-row"
                                data-search="@(r.CandidateName?.ToLower()) @(r.CandidateEmail?.ToLower()) @(r.IRFId?.ToLower()) @(r.JDTiltle?.ToLower())"
                                data-status="@r.CallStatus"
                                data-purpose="@r.CallPurpose"
                                data-meeting="@r.MeetingCreated"
                                data-disposition="@r.CandidateDisposition">
                            @{
                                string statusBadge;
                                if      (r.CallStatus == "completed")      statusBadge = "bg-success";
                                else if (r.CallStatus == "triggered")      statusBadge = "bg-info";
                                else if (r.CallStatus == "initiated")      statusBadge = "bg-secondary";
                                else if (r.CallStatus == "no-answer")      statusBadge = "bg-warning text-dark";
                                else if (r.CallStatus == "failed")         statusBadge = "bg-danger";
                                else if (r.CallStatus == "trigger-failed") statusBadge = "bg-danger";
                                else                                       statusBadge = "bg-secondary";

                                var statusExtraClass = r.CallStatus == "completed" ? "cx-status-completed" : "";

                                string dispositionBadge;
                                if      (r.CandidateDisposition == "interested")   dispositionBadge = "bg-success";
                                else if (r.CandidateDisposition == "uninterested") dispositionBadge = "bg-danger";
                                else if (r.CandidateDisposition == "cant_say")     dispositionBadge = "bg-secondary";
                                else                                               dispositionBadge = "bg-light text-dark border";

                                var meetingBadge = r.MeetingCreated == "YES" ? "bg-success" : "bg-light text-dark border";
                                var bookingBadge = r.BookingApiSuccess ? "bg-success" : (r.AIReportedBooked ? "bg-danger" : "bg-light text-dark border");
                                var purposeBadge = r.CallPurpose == "reschedule" ? "bg-warning text-dark" : "bg-primary";

                                string confirmLabel;
                                if      (r.MeetingConfirmationStatus == "1") confirmLabel = "Confirmed";
                                else if (r.MeetingConfirmationStatus == "2") confirmLabel = "Cancelled";
                                else if (r.MeetingConfirmationStatus == "0") confirmLabel = "Pending";
                                else                                         confirmLabel = r.MeetingConfirmationStatus ?? "—";

                                string confirmBadgeClass;
                                if      (r.MeetingConfirmationStatus == "1") confirmBadgeClass = "cx-meeting-confirmed";
                                else if (r.MeetingConfirmationStatus == "2") confirmBadgeClass = "bg-danger";
                                else                                         confirmBadgeClass = "bg-warning text-dark";
                            }

                                <td class="ps-3 text-muted small">@r.CallLogId</td>

                                <td>
                                    <div class="fw-semibold">@(r.CandidateName ?? "—")</div>
                                    <small class="text-muted">@(r.CandidateEmail ?? "—")</small>
                                </td>

                                <td class="small">@(r.RecipientPhone ?? "—")</td>

                                <td>
                                    <div class="small fw-semibold">@(r.IRFId ?? "—")</div>
                                    <small class="text-muted" title="@r.JDTiltle">
                                        @(r.JDTiltle?.Length > 22 ? r.JDTiltle.Substring(0, 22) + "..." : r.JDTiltle ?? "—")
                                    </small>
                                </td>

                                <td>
                                    <span class="badge @purposeBadge cx-badge">@(r.CallPurpose ?? "schedule")</span>
                                </td>

                                <td>
                                    <span class="badge @statusBadge cx-badge @statusExtraClass">@(r.CallStatus ?? "—")</span>
                                    @if (!string.IsNullOrEmpty(r.HangupCause))
                                    {
                                        <br /><small class="text-muted">@r.HangupCause</small>
                                    }
                                </td>

                                <td class="small">@(r.DurationSeconds.HasValue ? r.DurationSeconds + "s" : "—")</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.RecordingUrl))
                                    {
                                        <audio controls preload="none" style="height:32px; width:220px; max-width:100%;">
                                            <source src="@r.RecordingUrl" type="audio/mpeg" />
                                            <source src="@r.RecordingUrl" type="audio/wav" />
                                        </audio>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(r.CandidateDisposition))
                                    {
                                        if (r.CandidateDisposition == "interested")
                                        {
                                            <span class="cx-disposition-interested"><i class="fas fa-thumbs-up"></i> Interested</span>
                                        }
                                        else
                                        {
                                            <span class="badge @dispositionBadge">@r.CandidateDisposition</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (r.AIReportedBooked)
                                    {
                                        <span class="cx-value-yes"><i class="fas fa-check"></i> Yes</span>
                                        <br /><small class="text-muted">@r.BookedInterviewDate @r.BookedInterviewTime</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (r.AIReportedBooked)
                                    {
                                        if (r.BookingApiSuccess)
                                        {
                                            <span class="badge @bookingBadge">OK</span>
                                        }
                                        else
                                        {
                                            <span class="badge @bookingBadge">Failed</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (r.MeetingCreated == "YES")
                                    {
                                        <span class="cx-value-yes"><i class="fas fa-check"></i> Yes</span>
                                    }
                                    else if (r.MeetingCreated == "NO")
                                    {
                                        <span class="cx-value-no"><i class="fas fa-times"></i> No</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="small">
                                    @if (r.MeetingScheduledAt.HasValue)
                                    {
                                        @r.MeetingScheduledAt.Value.ToString("dd MMM yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="small">
                                    @if (r.MeetingId.HasValue)
                                    {
                                        <span class="badge @confirmBadgeClass">@confirmLabel</span>
                                        @if (r.IsAutoCancelled == true)
                                        {
                                            <br /><small class="text-danger">Auto-cancelled</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td class="small">
                                    @r.CallInitiatedAt.ToString("dd MMM HH:mm")
                                </td>

                                <td class="small text-muted">
                                    @(r.TriggeredBy?.Replace("Dashboard-", ""))
                                </td>

                                <td>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            onclick="showDetail(@r.CallLogId)"
                                            title="View details">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="17" class="text-center text-muted py-5">
                                    <i class="fas fa-phone-slash fa-2x mb-2 d-block"></i>
                                    No call logs yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination footer -->
        @if (totalPages > 1 || totalCalls > 0)
        {
            <div class="card-footer d-flex align-items-center justify-content-between bg-white border-top py-2">
                <small class="text-muted">
                    Showing <strong>@rangeStart–@rangeEnd</strong> of <strong>@totalCalls</strong> calls
                </small>

                @if (totalPages > 1)
                {
                    <nav aria-label="Call log pages">
                        <ul class="pagination pagination-sm mb-0">

                            @{ var prevDisabled = currentPage <= 1 ? "disabled" : ""; }
                            <li class="page-item @prevDisabled">
                                <a class="page-link" href="@pageUrl(currentPage - 1, pageSize)" aria-label="Previous">
                                    <span aria-hidden="true">«</span>
                                </a>
                            </li>

                            @{
                                int windowHalf = 3;
                                int pageStart  = Math.Max(1, currentPage - windowHalf);
                                int pageEnd    = Math.Min(totalPages, currentPage + windowHalf);

                                if (pageStart > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@pageUrl(1, pageSize)">1</a>
                                    </li>
                                    if (pageStart > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                }

                                for (int p = pageStart; p <= pageEnd; p++)
                                {
                                    var isActive = p == currentPage ? "active" : "";
                                    <li class="page-item @isActive">
                                        <a class="page-link" href="@pageUrl(p, pageSize)">@p</a>
                                    </li>
                                }

                                if (pageEnd < totalPages)
                                {
                                    if (pageEnd < totalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@pageUrl(totalPages, pageSize)">@totalPages</a>
                                    </li>
                                }
                            }

                            @{ var nextDisabled = currentPage >= totalPages ? "disabled" : ""; }
                            <li class="page-item @nextDisabled">
                                <a class="page-link" href="@pageUrl(currentPage + 1, pageSize)" aria-label="Next">
                                    <span aria-hidden="true">»</span>
                                </a>
                            </li>

                        </ul>
                    </nav>
                }

                <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">Per page:</small>
                    <select class="form-select form-select-sm" style="width:80px"
                            onchange="applyServerFilter('pageSize', this.value, 1)">
                        @foreach (var ps in new[] { 25, 50, 100, 200 })
                        {
                            if (pageSize == ps)
                            {
                                <option value="@ps" selected>@ps</option>
                            }
                            else
                            {
                                <option value="@ps">@ps</option>
                            }
                        }
                    </select>
                </div>
            </div>
        }
    </div>

            </div>
        </div>
    </div>
            </div>
        </div>
    </div>
</div>

