@model IEnumerable<Risebird.Entities.Data.JoinabilityMatrix>
@{
    ViewData["Title"] = "Joinability";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- START BREADCRUMB -->
<ul class="breadcrumb">
    <li class="active"><strong>Joinability</strong></li>
</ul>
<!-- END BREADCRUMB -->
<!-- PAGE TITLE -->
<div class="page-title">
    <h2><span class="fa fa-user"></span>Joinability</h2>
</div>
<!-- END PAGE TITLE -->
<!-- PAGE CONTENT WRAPPER -->
<div class="page-content-wrap">
    <div class="row">
        <div class="col-md-12">
            <!-- START DEFAULT DATATABLE -->
            <div class="panel panel-default">
                <div class="panel-heading">
                    <ul class="panel-controls">
                        <li>
                            <button class="btn btn-default" onclick="window.location.href = '@Url.Action("AddJoinability","Joinability")'"><span class="fa fa-plus-circle"> Add Joinability</span></button>
                        </li>
                    </ul>
                </div>
                <div class="panel-body">
                    <table class="table datatable" id="idrisebirduser">
                        <thead>
                            <tr>
                                <th hidden></th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                                <tr id=@item.id>
                                    <td hidden>@item.id</td>
                                    <td>@item.Name</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <i type="submit" onclick="location.href='@Url.Action("EditJoinability", "Joinability", new { id = item.id})'" class="fa fa-pencil-square-o" style="color:green;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Edit" data-original-title="Tooltip on bottom"></i>
                                        <i class="fa fa-trash-o hover" style="color:red;font-size: 18px;" data-toggle="tooltip" data-placement="bottom" title="Delete" data-original-title="Tooltip on bottom" onclick="javascript:DeleteEntityfromEnvironment('@item.id');"></i>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- END DEFAULT DATATABLE -->
        </div>
    </div>
</div>
<!-- PAGE CONTENT WRAPPER -->
<loading></loading>
@if (ViewBag.Message != null && ViewBag.Message.Contains("successfully"))
{
    <script type="text/javascript">
        window.onload = function ()
        {
                                sweetAlert({
                                    title: "Risebird Users",
                                    text:'@ViewBag.Message',
                                    type: "success"
                                });
         };
    </script>
}
@if (ViewBag.Message != null && (ViewBag.Message.Contains("failed")))
{
    <script type="text/javascript">
            window.onload = function ()
            {
                    sweetAlert({
                        title: "Risebird Users",
                    text: '@ViewBag.Message',
                   type: "error"
                   });
           };
    </script>
}
<script type="text/javascript">
    $(document).ready(function () {
        $('#idenvironment').DataTable({
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [-1] /*sort false 1st one, start by the right */
            }],
            "order": []   /* Disable initial sort */
        });
    });</script>
