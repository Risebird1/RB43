@model Risebird.Entities.ViewModel.ClonableTemplateListVM
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Skill Channel Clone Templates";
    ViewBag.PageHeader = "Skill Channel Clone Templates";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string[] TemplateName = new string[] { };
    string[] CompetencyLevel = new string[] { };
    string[] SeniorityLevel = new string[] { };
    string[] CountryType = new string[] { };
    string[] CompanyType = new string[] { };
    string[] AssessmentGroup = new string[] { };

}

@if (HttpContextAccessor.HttpContext.Session.GetString("ClonableTemplatesFilters") != null)
{
    filter = JsonConvert.DeserializeObject<ClonableTemplatesFilter>(HttpContextAccessor.HttpContext.Session.GetString("ClonableTemplatesFilters"));
    TemplateName = filter.TemplateName != null ? filter.TemplateName : new string[] { };
    CompetencyLevel = filter.CompetencyLevel != null ? filter.CompetencyLevel : new string[] { };
    SeniorityLevel = filter.SeniorityLevel != null ? filter.SeniorityLevel : new string[] { };
    CountryType = filter.CountryType != null ? filter.CountryType : new string[] { };
    CompanyType = filter.CompanyType != null ? filter.CompanyType : new string[] { };
    AssessmentGroup = filter.AssessmentGroup != null ? filter.AssessmentGroup : new string[] { };
}   


<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=234567" />

<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Skill Channel Clone Templates</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal   fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>



                                            <form action="@Url.Action("Index","Template")" method="post" id="formFilter">

                                                <div class="modal-body">
                                                    <div class="row">

                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Name">Name</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="TemplateName" name="TemplateName" data-placeholder="None Selected" class="form-select test" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.Name).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CompetencyLevel">Competency Level</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CompetencyLevel" name="CompetencyLevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.CompetencyLevelDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="SeniorityLevel">Seniority Level</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="SeniorityLevel" name="SeniorityLevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.SeniorityLevelDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CountryType">Country Type</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CountryType" name="CountryType" data-placeholder="None Selected" class="form-select test" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.CountryTypeDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CompanyType">Company Type</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CompanyType" name="CompanyType" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.CompanyTypeDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="AssessmentGroup">Assessment Group</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="AssessmentGroup" name="AssessmentGroup" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.AssessmentGroupName).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">

                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">

                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 20px 0px 10px 0px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>

                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin:20px 0px 10px 0px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>

                                                                    </div>

                                                                </div>

                                                            </div>
                                                        </div>




                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="cloneTemplateTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Tech Skills</th>
                                                    <th>Interviewers</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Tech Skills</th>
                                                    <th>Interviewers</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model.ClonableTemplates != null && Model.ClonableTemplates.Count() > 0)
                                                {
                                                    foreach (var item in Model.ClonableTemplates)
                                                    {

                                                        <tr>
                                                            @if (!string.IsNullOrEmpty(item.Name))
                                                            {
                                                                <td> @item.Name </td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }

                                                            <td></td>

                                                            <td></td>

                                                            <td>
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Edit the Template">
                                                                    <span onclick="location.href='@Url.Action("Edit", "ClonableSkillChannelTemplate", new { @*id = item.CreatedFromIRFId,*@ id = item.ClonableSkillChannelId})'" title="Edit the Template" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px!important;" class="fa fa-clone"></i>
                                                                    </span>
                                                                </button>

                                                                <button class="mdc-fab app-fab--absolute" aria-label="Create Skills Channel">
                                                                    <span onclick="location.href='@Url.Action("Create", "IRF", new { templateId = item.ClonableSkillChannelId })'" title="Create Skills Channel" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px!important;" class="fa fa-plus-circle"></i>
                                                                    </span>
                                                                </button>
                                                            </td>


                                                        </tr>


                                                    }
                                                }

                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>

@if (Model.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@Model.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@Model.Message', "success");
            }
            else {
                swal.fire("Failed", '@Model.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}

<script>

    function searchResult() {
        $('#cloneTemplateTable').DataTable();
    }
    function RefreshSearch() {
        $('#cloneTemplateTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {

        var table = $('#cloneTemplateTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#cloneTemplateTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#cloneTemplateTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#cloneTemplateTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>

    $(document).ready(function () {

        $("#ResetFilter").click(function () {
            ResetFilter();
        })

        if ('@filter' != '') {
            ApplySessionFilter();
        }

    });

    function ResetFilter() {

        $.ajax({
            type: "POST",
            async: false,
            url: "/Template/ResetClonableTemplateFilter",
            success: function (result) {
                location.reload(true);
            }
        });
    }

    function ApplySessionFilter() {
        var templateName =  @Html.Raw(Json.Serialize(TemplateName));
        var competencyLevel =  @Html.Raw(Json.Serialize(CompetencyLevel));
        var seniorityLevel =  @Html.Raw(Json.Serialize(SeniorityLevel));
        var countryType =  @Html.Raw(Json.Serialize(CountryType));
        var companyType =  @Html.Raw(Json.Serialize(CompanyType));
        var assessmentGroup =  @Html.Raw(Json.Serialize(AssessmentGroup));

        $("#TemplateName").val(templateName);
        $("#CompetencyLevel").val(competencyLevel);
        $("#SeniorityLevel").val(seniorityLevel);
        $("#CountryType").val(countryType);
        $("#CompanyType").val(companyType);
        $("#AssessmentGroup").val(assessmentGroup);
    }

</script>




