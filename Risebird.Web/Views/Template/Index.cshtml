<script>
    function Delete(id, templateName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Template (" + templateName + ") will be archived!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Template/DeleteTemplate',
                        method: 'POST',
                        data: { 'id': id },
                        success: function (result) {
                            if (result) {
                                resolve(result)

                            }
                            else {
                                swal.fire("Error archiving!", "Please try again", "error");

                            }
                        },
                        error: function () {
                            swal.fire("Error archiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The template has been archived.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Delete cancelled!',
                    'error'
                )
            }
        })
    }

    function Restore(id, templateName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Template (" + templateName + ") will be Unarchived!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, restore it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Template/RestoreTemplate',
                        method: 'POST',
                        data: { 'id': id },
                        success: function (result) {
                            if (result) {
                                resolve(result)

                            }
                            else {
                                swal.fire("Error Unarchiving!", "Please try again", "error");

                            }
                        },
                        error: function () {
                            swal.fire("Error Unarchiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Restored!',
                    type: 'success',
                    html: '<p>The template has been Unarchived!.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Restore cancelled!',
                    'error'
                )
            }
        })
    }


</script>

