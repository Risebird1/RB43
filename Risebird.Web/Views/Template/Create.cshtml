@model Risebird.Entities.ViewModel.SkillChannelTemplateVM

@{
    ViewData["Title"] = "Create Template";
    ViewBag.PageHeader = "Templates / Create Template";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<script>
    var Header = "<a href='/Template/Index'>Templates</a>&nbsp;/&nbsp;Create Template";
    $('#txtpageHeader').empty().html(Header);
</script>


<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />


<div class="main-panel " id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">

                        <form action="/Template/Create" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid" onsubmit="return CheckConditions()">

                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div asp-validation-summary="All" class="text-danger"></div>
                            </div>
                            <div class="row">
                                <div class="form-group col-md-6">
                                    <label asp-for="TemplateName" class="form-label"></label>
                                    <div class="col-sm-12 nopad">
                                        <div class="custom-file">
                                            <input asp-for="TemplateName" type="text" class="form-control text-box single-line">
                                            <span asp-validation-for="TemplateName" class="text-danger"></span>

                                        </div>
                                    </div>
                                </div>

                                <div class="form-group col-md-6">
                                    <label asp-for="AssessmentGroupId" class="form-label"></label>

                                    @Html.DropDownListFor(model => model.AssessmentGroupId, Model.AssessmentGroupList, "Select Assessment Group", new { @class = "select-css form-control", @onchange = "AssessmentGroupChanged()" })
                                    <span asp-validation-for="AssessmentGroupId" class="text-danger"></span>
                                </div>
                            </div>

                            <br />

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 nopad">
                                <div class="multiple_row">
                                    <h2>Tech Skill(s)</h2>
                                </div><!--end of multiple location-->
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered mbn" id="SkillTable">
                                    <thead>
                                        <tr>
                                            <th width="5%" class="table_heading">Select</th>
                                            <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                                            <th width="65%" class="table_heading">Skill Name<span class="red">*</span></th>
                                            <th width="10%" class="table_heading">Weightage<span class="red">*</span></th>
                                            <th width="5%" class="table_heading text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr>
                                            <td class="text-center">
                                                @Html.CheckBox("TechSkillCollection[0].IsSelected", new { @checked = "checked" })
                                            </td>
                                            <td>
                                                @Html.DropDownList("TechSkillCollection[0].LevelId", Model.LevelTech, "Select", new { @class = "select-css form-control " })
                                            </td>
                                            <td>
                                                @Html.DropDownList("TechSkillCollection[0].SkillId", Model.Skills, "Select", new { @class = "select-css form-control " })
                                            </td>
                                            <td>
                                                <input class="form-control text-box single-line" id="TechSkillCollection_0__Weightage" name="TechSkillCollection[0].Weightage" type="number" max="100" min="1" value="100">
                                            </td>
                                            <td class="action text-center">

                                                <span id="btnMinus" onclick="DeleteRow(this, 'TechSkillCollection', 'LevelId', 'SkillId', 'IsSelected', 'Weightage')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                            </td>
                                        </tr>

                                    </tbody>
                                </table>
                                <label class="text-danger" id="TechSkillCollection_Error" style="color:red; margin-left:433px; font-size:16px"></label>

                            </div>
                            <div class="row">
                                <div class="col-md-12 text-right"><button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnAddTechSkill" value="Add Tech Skill(s)" onclick="AddRow()"> Add Tech Skill</button></div>
                            </div>

                            <br />

                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 nopad">
                                <div class="multiple_row">
                                    <h2>Interviewer</h2>
                                </div><!--end of multiple location-->
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered mbn" id="InterviewerTable">
                                    <thead>
                                        <tr>
                                            <th width="5%" class="table_heading">Select</th>
                                            <th width="30%" class="table_heading">User<span class="red">*</span></th>
                                            <th width="60%" class="table_heading">Skills</th>
                                            <th width="5%" class="table_heading text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr>
                                            <td class="text-center">
                                                @Html.CheckBox("InterviewerCollection[0].IsSelected", new { @checked = "checked" })
                                            </td>
                                            <td>
                                                @Html.DropDownList("InterviewerCollection[0].UserId", new List<SelectListItem>(), new { @class = "select-css form-control ", @onchange = "InterviewerChanged(this.value, this.id)" })
                                            </td>

                                            <td>

                                                @Html.TextBox("InterviewerCollection[0].PrimarySkill", null, new { @class = "form-control", @readonly = "readonly" })

                                            </td>

                                            <td class="action text-center">
                                                <span id="btnMinus" onclick="DeleteRow(this, 'InterviewerCollection', 'UserId', 'PrimarySkill', 'IsSelected')" class=" mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                            </td>
                                        </tr>
                                    </tbody>

                                </table>
                                <label class="text-danger" id="InterviewerCollection_Error" style="color:red; margin-left:433px; font-size:16px"></label>

                            </div>
                                <div class="row">
                                    <div class="col-md-12"> 
                                        <button type="button" style="display:none;margin:0px 5px 20px 0px;" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnAddInterviewer" value="Add Interviewer(s)" onclick="AddRowInterviewer()"> Add Interviewer</button>
                                    </div>
                                   
                                    <div class="col-md-12">
                                        <div class="card-footer clearfix">
                                            <div class="pull-left">
                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="location.href='@Url.Action("Index", "Template")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back </font></span>
                                                </button>
                                            </div>
                                            <div class="pull-right">
                                                <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded  pull-right" id="btnSubmit" value="Submit">Submit</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        </form>
                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>
@*<script src="ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>*@




<script>

    function CheckConditions() {

        return (CheckIfInterviewersAdded() && CheckIfSkillsAdded());
    }

    function AssessmentGroupChanged() {
        var Assessmentgroupid = $("#AssessmentGroupId").val();
        if (Assessmentgroupid != null && Assessmentgroupid != '') {
            $.ajax({
                type: "GET",
                url: "/IRF/GetInterviewers",
                data: { 'assessmentgroupid': Assessmentgroupid },
                success: function (data) {

                    var drpdowns = $('[id^="InterviewerCollection"][id$="UserId"]');
                    var skillText = $('[id^="InterviewerCollection"][id$="PrimarySkill"]');
                    for (i = 0; i < drpdowns.length; i++) {
                        $("#" + drpdowns[i].id + " option").remove();
                        $("#" + skillText[i].id).val("");
                    }

                    if (data.length > 0) {

                        for (i = 0; i < drpdowns.length; i++) {
                            //$("#" + drpdowns[i].id).append(option);
                            if (data[0].value != null && data[0].value != '') {

                                var option = $("<option />");

                                //Set Text part.
                                option.html("Select Interviewer");

                                //Set Value part.
                                option.val('');

                                //Add the Option element to DropDownList.

                                $("#" + drpdowns[i].id).append(option);
                            }



                            $(data).each(function () {
                                var option = $("<option />");

                                //Set Text part.
                                option.html(this.text);

                                //Set Value part.
                                option.val(this.value);

                                //Add the Option element to DropDownList.

                                $("#" + drpdowns[i].id).append(option);

                            });

                        }


                    }


                }
            });

        }
        else {
            var drpdowns = $('[id^="InterviewerCollection"][id$="UserId"]');
            var skillText = $('[id^="InterviewerCollection"][id$="PrimarySkill"]');
            for (i = 0; i < drpdowns.length; i++) {
                $("#" + drpdowns[i].id + " option").remove();
                $("#" + skillText[i].id).val("");
            }
        }



    }


    function InterviewerChanged(val, id) {
        var index = id.split('_')[1];
        
        var skillElementid = 'InterviewerCollection_' + index + '__PrimarySkill';
        $.ajax({
            type: "GET",
            url: "/Template/GetInterviewerSkillsByUserId",
            data: { 'userId': val },
            success: function (data) {
                $("#" + skillElementid).val(data);
            }
        });


    }

    function AddRow() {

        var $ttc = $("#SkillTable").find("tbody tr:last");
        var $tr = $ttc.clone();

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })

        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");
        $tr.find("input[type=checkbox]").prop("checked", true);

        // add cloned row as last row
        $("#SkillTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        // Check document for changes
        // $.validator.unobtrusive.parse(document);
        // document.getElementById("btnUpload").disabled = false;

    }

    function AddRowInterviewer() {
        //document.getElementById("btnUpload").disabled = false;

        var table = document.getElementById("InterviewerTable");
        //var rowCount = table.rows.length;

        var $ttc = $("#InterviewerTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        //var trIndexReplaced = $("#InterviewerTable tr").length - 1;

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");
        $tr.find("input[type=checkbox]").prop("checked", true);

        // add cloned row as last row
        $("#InterviewerTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        // Check document for changes
        //$.validator.unobtrusive.parse(document);
        //document.getElementById("btnUpload").disabled = false;

    }
    function DeleteRow(element, collectionName, tdOne, tdTwo, tdThree, tdFour = '' ) {
        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {
            //document.getElementById("btnUpload").disabled = false;

            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {

                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;

                    if (tdTwo != null && tdTwo != "") {
                        elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                        elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                        elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;
                    }
                    if (tdThree != null && tdThree != "") {
                        elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                        elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                        elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;
                    }
                    if (tdFour != null && tdFour != "") {
                        elem4 = document.getElementById(collectionName + "_" + i + "__" + tdFour);
                        elem4.id = collectionName + "_" + (i - 1) + "__" + tdFour;
                        elem4.name = collectionName + "[" + (i - 1) + "]." + tdFour;
                    }


                }

            }

        }


    }

    $(document).ready(function () {
        $.validator.addMethod("__dummy__", function (value, element) {
            return true;
        });

        
        $('#AssessmentGroupId').change(function () {
            var assessmentGroupId = $("#AssessmentGroupId").val();
            if (assessmentGroupId == null || assessmentGroupId == '') {
                document.getElementById('btnAddInterviewer').style.display = 'none';
                //document.getElementById('btnAddTechSkill').style.display = 'none';

            }
            else {
                document.getElementById('btnAddInterviewer').style.display = 'block';
                //document.getElementById('btnAddTechSkill').style.display = 'block';
            }

        });

    });

    function CheckIfInterviewersAdded() {

        var assessmentGroupElem = document.getElementById("AssessmentGroupId");
        if (assessmentGroupElem.value != null && assessmentGroupElem.value !='') {
            var interviewerItems = $('[id^="InterviewerCollection"][id$="UserId"]');
            for (i = 0; i < interviewerItems.length; i++) {
                var temp = $("#InterviewerCollection_" + i + "__UserId").val();
                if (temp == null || temp == '') {
                    document.getElementById('InterviewerCollection_Error').innerHTML = "Please select an Interviewer for all the added rows under Interviewers."
                    document.getElementById('InterviewerCollection_Error').focus();
                    return false;
                }

            }

        }
        document.getElementById('InterviewerCollection_Error').innerHTML = "";
        return true;
    }

    function CheckIfSkillsAdded() {
        var techSkillItems = $('[id^="TechSkillCollection"][id$="SkillId"]');
        for (i = 0; i < techSkillItems.length; i++) {
            var skill = $("#TechSkillCollection_" + i + "__SkillId").val();
            var level = $("#TechSkillCollection_" + i + "__LevelId").val();
            var weightage = $("#TechSkillCollection_" + i + "__Weightage").val();
            if ((skill == null || skill == '') || (level == null || level == '') || (weightage == null || weightage == '')) {
                document.getElementById('TechSkillCollection_Error').innerHTML = "Please select a value for all the added rows under Tech Skills."
                document.getElementById('TechSkillCollection_Error').focus();
                return false;
            }

        }
        document.getElementById('TechSkillCollection_Error').innerHTML = "";
        return true;
    }
</script>





