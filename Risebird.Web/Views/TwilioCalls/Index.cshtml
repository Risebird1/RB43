@{
    ViewData["Title"] = "CallTwilio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div >
    
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Profile</h4>
                    </div>
                    <div class="card-body">

                        <div class="pull-right">
                            <button onclick="callCustomer('+919284487005')" type="button" class="btn btn-primary btn-lg call-customer-button">
                                <span class="glyphicon glyphicon-earphone" aria-hidden="true"></span>
                                Call customer
                            </button>
                            <button onclick="hangUp()" type="button" class="btn btn-primary btn-lg call-customer-button">
                                <span class="glyphicon glyphicon-earphone" aria-hidden="true"></span>
                                Hang Up
                            </button>
                        </div>
                        <div style="margin-left:250px">
                            <h3>Recordings</h3>
                            <ol id="recordingsList"></ol>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    
</div>

<script src="~/js/Recorder/Record.js"></script>