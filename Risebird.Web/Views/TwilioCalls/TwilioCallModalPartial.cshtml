@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    // Plivo is offered (and is the default) only when all PlivoSettings values are present; otherwise Twilio only.
    var plivoConfigured = !string.IsNullOrWhiteSpace(Configuration["PlivoSettings:AUTH_ID"])
                          && !string.IsNullOrWhiteSpace(Configuration["PlivoSettings:AUTH_TOKEN"])
                          && !string.IsNullOrWhiteSpace(Configuration["PlivoSettings:APPLICATION_ID"])
                          && !string.IsNullOrWhiteSpace(Configuration["PlivoSettings:EndpointUsername"]);
}
<div id="myCallModal" class="modal modal-wrap modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left" id = "idCallingTitle"> Call </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body">
                <h5 class="modal-title text-center" id="callingLabel"></h5>
                <div class="rb-call-provider" style="text-align:center;margin:6px 0 4px;font-size:13px;">
                    <span style="margin-right:6px;">Call via:</span>
                    <button type="button" class="btn btn-sm rb-call-provider-btn" data-provider="plivo" onclick="setCallProvider('plivo')" style="margin:0 2px;" disabled="@(!plivoConfigured)" title="@(plivoConfigured ? "Call via Plivo" : "Plivo is not configured")">Plivo</button>
                    <button type="button" class="btn btn-sm rb-call-provider-btn" data-provider="twilio" onclick="setCallProvider('twilio')" style="margin:0 2px;">Twilio</button>
                </div>
                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;
                       display: block;" class="btn btn-fill btn-danger" value="Hang Up">
            </div>

        </div>
    </div>
</div>
<script>
    window.rbPlivoConfigured = @(plivoConfigured ? "true" : "false");
    window.rbDefaultProvider = '@(plivoConfigured ? "plivo" : "twilio")';
</script>
@if (plivoConfigured)
{
    <script src="~/js/PlivoCallMaker.js" asp-append-version="true"></script>
}