@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var plivoConfigured =
        !string.IsNullOrWhiteSpace(Configuration["Plivo:AuthId"])
        && !string.IsNullOrWhiteSpace(Configuration["Plivo:AuthToken"])
        && (!string.IsNullOrWhiteSpace(Configuration["Plivo:ApplicationId"]) || !string.IsNullOrWhiteSpace(Configuration["Plivo:APPLICATION_ID"]))
        && !string.IsNullOrWhiteSpace(Configuration["Plivo:EndpointUsername"]);
    var defaultProvider = plivoConfigured ? "plivo" : "twilio";
}
<div id="myCallModal" class="modal modal-wrap modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left" id = "idCallingTitle"> Call </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body">
                <div id="rbCallProviderToggle" class="rb-call-provider-toggle text-center">
                    <button type="button" id="rbProviderTwilio" class="btn btn-sm" onclick="setCallProvider('twilio')">Twilio</button>
                    <button type="button" id="rbProviderPlivo" class="btn btn-sm" onclick="setCallProvider('plivo')" @(plivoConfigured ? null : "disabled=\"disabled\"")>Plivo</button>
                </div>
                <h5 class="modal-title text-center" id="callingLabel"></h5>
                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;
                       display: block;" class="btn btn-fill btn-danger" value="Hang Up">
            </div>

        </div>
    </div>
</div>
<style>
    .rb-call-provider-toggle { margin-bottom: 12px; }
    .rb-call-provider-toggle button { margin: 0 4px; border: 1px solid #c5c5c5; background: #fff; }
    .rb-call-provider-toggle button.active { background: #1976d2; color: #fff; border-color: #1976d2; }
    .rb-call-provider-toggle button:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
<script>
    window.rbPlivoConfigured = @(plivoConfigured ? "true" : "false");
    window.rbDefaultProvider = "@defaultProvider";
</script>
@if (plivoConfigured)
{
    <script src="https://cdn.plivo.com/sdk/browser/v2/plivo.min.js"></script>
    <script src="~/js/PlivoCallMaker.js" asp-append-version="true"></script>
}
