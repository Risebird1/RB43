                <div class="text-center py-4 text-muted" id="pendingResumesEmpty" style="display:none">
                    <i class="fas fa-inbox me-2"></i>No pending resumes found for this ticket.
                </div>
            </div>
            <!-- Debug Logs Panel (hidden by default) -->
            <div class="border-top bg-dark text-light p-3" id="debugLogsPanel" style="display: none; max-height: 300px; overflow-y: auto;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="fas fa-bug me-2"></i>Processing Logs</h6>
                    <button type="button" class="btn btn-sm btn-outline-light" id="closeDebugLogsBtn">
