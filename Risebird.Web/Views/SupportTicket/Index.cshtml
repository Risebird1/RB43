                                    <div class="context-field">
                                        <label class="context-label d-flex justify-content-between align-items-center">
                                            <span>Email Body</span>
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" onclick="$('#ctxMailBody').toggle()">
                                                <i class="fas fa-eye me-1"></i>Toggle
