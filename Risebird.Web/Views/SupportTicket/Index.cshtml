    }

    #createChannelModal .prm-modal-footer {
        background: #fff;
        border-top: 1px solid #e2e8f0;
        padding: 0.5rem 1rem;
    }

    #createChannelModal .prm-footer-btn {
        font-size: 12px;
        font-weight: 600;
        font-family: 'Roboto', sans-serif;
        padding: 5px 14px;
        border-radius: 6px;
        border: 1px solid transparent;
    }

    #createChannelModal .prm-footer-btn-outline {
        color: #475569;
        background: #fff;
        border-color: #cbd5e1;
    }

        #createChannelModal .prm-footer-btn-outline:hover {
            background: #f1f5f9;
            border-color: #94a3b8;
            color: #1e293b;
        }

    #createChannelModal .prm-footer-btn-solid {
        background: #334155;
        border-color: #334155;
        color: #fff;
    }

        #createChannelModal .prm-footer-btn-solid:hover {
            background: #1e293b;
            border-color: #1e293b;
            color: #fff;
        }

    #createChannelModal .prm-cc-msg .alert {
        border-radius: 8px;
        font-size: 13px;
    }
</style>

<!-- Loading Overlay -->
<div id="loadingOverlay">
    <div class="spinner-content">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="loading-text">Loading tickets...</div>
    </div>
</div>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="content client">
            <div class="container-fluid py-4">

                <!-- Page header -->
                <div class="row mb-3 align-items-center">
                    <div class="col">
                        <h4 class="fw-bold mb-0">
                            <i class="fas fa-headset text-primary me-2"></i>Customer Support Tickets
                        </h4>
                        <p class="text-muted mb-0 mt-1">Inbound support requests identified and enriched by Relay.app</p>
                    </div>
                    <div class="col-auto d-flex gap-2">
                        @* <button type="button"
                        class="btn btn-warning btn-sm btn-review-resumes"
                        data-ticket-id="-1"
                        data-ticket-subject="TEST: Sample Resume Submission"
                        title="Test the Review Resumes modal with dummy data">
                        <i class="fas fa-flask me-1"></i>Test Review Modal
                        </button> *@
                        <button style="background: #bceabc;border:0px;color:green" class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
                            <i class="fas fa-sync-alt me-1"></i>Refresh
                        </button>
                    </div>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Tabs -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <a class="nav-link @(isManualTab ? "active" : "")"
                           href="@Url.Action("Index", "SupportTicket", new { tab = "all" })">
                            <i class="fas fa-user-check me-1"></i>Manual Review
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isSystemTab ? "active" : "")"
                           href="@Url.Action("Index", "SupportTicket", new { tab = "system" })">
                            <i class="fas fa-robot me-1"></i>System Only
                            @if (systemCount > 0)
                            {
                                <span class="badge bg-secondary ms-1">@systemCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isHybridTab ? "active" : "")"
                           href="@Url.Action("Index", "SupportTicket", new { tab = "hybrid" })">
                            <i class="fas fa-exchange-alt me-1"></i>Hybrid
                            @if (hybridCount > 0)
                            {
                                <span class="badge bg-secondary ms-1">@hybridCount</span>
                            }
                        </a>
                    </li>
                </ul>

                @if (isManualTab)
                {
                    <!-- Summary stat cards (Manual Review tab only) -->
                    var cardOpen = Model.Count(t => string.Equals(t.Status, "Open", StringComparison.OrdinalIgnoreCase));
                    var cardIP = Model.Count(t => string.Equals(t.Status, "InProgress", StringComparison.OrdinalIgnoreCase));
                    var cardClose = Model.Count(t => string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase));
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-sm-3">
                            <div class="card border-0 shadow-sm text-center py-3 st-stat">
                                <div class="stat-value text-primary">@totalCount</div>
                                <div class="stat-label">@(hasFilters ? "Matched" : "Total") Tickets</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="card border-0 shadow-sm text-center py-3 st-stat">
                                <div class="stat-value text-warning">@cardOpen</div>
                                <div class="stat-label">Open (page)</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="card border-0 shadow-sm text-center py-3 st-stat">
                                <div class="stat-value text-info">@cardIP</div>
                                <div class="stat-label">In Progress (page)</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="card border-0 shadow-sm text-center py-3 st-stat">
                                <div class="stat-value text-success">@cardClose</div>
                                <div class="stat-label">Closed (page)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Filters (Manual Review tab only) -->
                    <form asp-action="Index" asp-controller="SupportTicket" method="get" id="filterForm">
                        <input type="hidden" name="tab" value="all" />
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@pageSize" />
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-body py-2 px-3">
                                <div class="d-flex align-items-center gap-2" style="flex-wrap:nowrap;width:100%;">

                                    <select name="status" id="statusFilter"
                                            class="form-select st-filter-control"
                                            style="flex:1 1 0;min-width:110px;max-width:145px;"
                                            onchange="document.getElementById('filterForm').submit()">
                                        <option value="">All statuses</option>
                                        @if (sSel_open)
                                        {
                                            <option value="Open" selected>Open</option>
                                        }
                                        else
                                        {
                                            <option value="Open">Open</option>
                                        }
                                        @if (sSel_ip)
                                        {
                                            <option value="InProgress" selected>In Progress</option>
                                        }
                                        else
                                        {
                                            <option value="InProgress">In Progress</option>
                                        }
                                        @if (sSel_closed)
                                        {
                                            <option value="Closed" selected>Closed</option>
                                        }
                                        else
                                        {
                                            <option value="Closed">Closed</option>
                                        }
                                    </select>

                                    <select name="intent" id="intentFilter"
                                            class="form-select st-filter-control"
                                            style="flex:0 0 200px;width:200px;"
                                            onchange="document.getElementById('filterForm').submit()">
                                        <option value="">All intents</option>
                                        @if (iSel_01)
                                        {
                                            <option value="New interview request" selected>New interview request</option>
                                        }
                                        else
                                        {
                                            <option value="New interview request">New interview request</option>
                                        }
                                        @if (iSel_02)
                                        {
                                            <option value="New candidate submission" selected>New candidate submission</option>
                                        }
                                        else
                                        {
                                            <option value="New candidate submission">New candidate submission</option>
                                        }
                                        @if (iSel_03)
                                        {
                                            <option value="Candidate status update" selected>Candidate status update</option>
                                        }
                                        else
                                        {
                                            <option value="Candidate status update">Candidate status update</option>
                                        }
                                        @if (iSel_04)
                                        {
                                            <option value="Candidate reports" selected>Candidate reports</option>
                                        }
                                        else
                                        {
                                            <option value="Candidate reports">Candidate reports</option>
                                        }
                                        @if (iSel_05)
                                        {
                                            <option value="Stop interviews" selected>Stop interviews</option>
                                        }
                                        else
                                        {
                                            <option value="Stop interviews">Stop interviews</option>
                                        }
                                        @if (iSel_06)
                                        {
                                            <option value="Cold candidate" selected>Cold candidate</option>
                                        }
                                        else
                                        {
                                            <option value="Cold candidate">Cold candidate</option>
                                        }
                                        @if (iSel_07)
                                        {
                                            <option value="Interviewer misalignment" selected>Interviewer misalignment</option>
                                        }
                                        else
                                        {
                                            <option value="Interviewer misalignment">Interviewer misalignment</option>
                                        }
                                        @if (iSel_08)
                                        {
                                            <option value="Interviewer replacement" selected>Interviewer replacement</option>
                                        }
                                        else
                                        {
                                            <option value="Interviewer replacement">Interviewer replacement</option>
                                        }
                                        @if (iSel_09)
                                        {
                                            <option value="Interviewer false negative" selected>Interviewer false negative</option>
                                        }
                                        else
                                        {
                                            <option value="Interviewer false negative">Interviewer false negative</option>
                                        }
                                        @if (iSel_10)
                                        {
                                            <option value="Interviewer false positive" selected>Interviewer false positive</option>
                                        }
                                        else
                                        {
                                            <option value="Interviewer false positive">Interviewer false positive</option>
                                        }
                                        @if (iSel_11)
                                        {
                                            <option value="Score rubric concerns" selected>Score rubric concerns</option>
                                        }
                                        else
                                        {
                                            <option value="Score rubric concerns">Score rubric concerns</option>
                                        }
                                        @if (iSel_12)
                                        {
                                            <option value="Candidate bad experience with Risebird" selected>Candidate bad experience with Risebird</option>
                                        }
                                        else
                                        {
                                            <option value="Candidate bad experience with Risebird">Candidate bad experience with Risebird</option>
                                        }
                                        @if (iSel_13)
                                        {
                                            <option value="Candidate bad experience with interviewer" selected>Candidate bad experience with interviewer</option>
                                        }
                                        else
                                        {
                                            <option value="Candidate bad experience with interviewer">Candidate bad experience with interviewer</option>
                                        }
                                        @if (iSel_14)
                                        {
                                            <option value="Delay in scheduling" selected>Delay in scheduling</option>
                                        }
                                        else
                                        {
                                            <option value="Delay in scheduling">Delay in scheduling</option>
                                        }
                                        @if (iSel_15)
                                        {
                                            <option value="Delay in getting interviews started" selected>Delay in getting interviews started</option>
                                        }
                                        else
                                        {
                                            <option value="Delay in getting interviews started">Delay in getting interviews started</option>
                                        }
                                        @if (iSel_16)
                                        {
                                            <option value="Delay in report sharing" selected>Delay in report sharing</option>
                                        }
                                        else
                                        {
                                            <option value="Delay in report sharing">Delay in report sharing</option>
                                        }
                                        @if (iSel_17)
                                        {
                                            <option value="Good experience with Risebird" selected>Good experience with Risebird</option>
                                        }
                                        else
                                        {
                                            <option value="Good experience with Risebird">Good experience with Risebird</option>
                                        }
                                        @if (iSel_18)
                                        {
                                            <option value="Poor experience with Risebird support team" selected>Poor experience with Risebird support team</option>
                                        }
                                        else
                                        {
                                            <option value="Poor experience with Risebird support team">Poor experience with Risebird support team</option>
                                        }
                                        @if (iSel_19)
                                        {
                                            <option value="Interviewer no-show" selected>Interviewer no-show</option>
                                        }
                                        else
                                        {
                                            <option value="Interviewer no-show">Interviewer no-show</option>
                                        }
                                        @if (iSel_20)
                                        {
                                            <option value="Quality control issues" selected>Quality control issues</option>
                                        }
                                        else
                                        {
                                            <option value="Quality control issues">Quality control issues</option>
                                        }
                                    </select>

                                    <input type="text" id="senderEmailInput" name="senderEmail"
                                           class="form-control st-filter-control"
                                           placeholder="Sender email…"
                                           style="flex:1 1 0;min-width:130px;"
                                           value="@selEmail" />

                                    <input type="date" name="dateFrom" class="form-control st-filter-control"
                                           style="flex:1 1 0;min-width:120px;" value="@selDateFrom"
                                           onchange="document.getElementById('filterForm').submit()" />

                                    <span class="text-muted flex-shrink-0" style="font-size:11px;">–</span>

                                    <input type="date" name="dateTo" class="form-control st-filter-control"
                                           style="flex:1 1 0;min-width:120px;" value="@selDateTo"
                                           onchange="document.getElementById('filterForm').submit()" />

                                    <button style="background: #07363c4f !important;border:0px;padding: 7px 10px;" type="submit" class="btn btn-primary btn-sm flex-shrink-0">
                                        <i class="fas fa-filter me-1"></i>Apply
                                    </button>
                                    <a style="padding: 7px 10px!important;border:0px;    background: #da7c7c !important;color:#fff" asp-action="Index" asp-controller="SupportTicket" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                                        <i class="fas fa-times me-1"></i>Clear
                                    </a>

                                </div>
                            </div>
                        </div>
                    </form>
                } @* end isManualTab *@

                <!-- Tickets table -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center text-muted py-5">
                                @if (isSystemTab)
                                {
                                    <i class="fas fa-robot fa-3x mb-3 d-block"></i>
                                    <span>No system-only tickets found.</span>
                                }
                                else if (isHybridTab)
                                {
                                    <i class="fas fa-exchange-alt fa-3x mb-3 d-block"></i>
                                    <span>No hybrid tickets found.</span>
                                }
                                else
                                {
                                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                    @if (hasFilters)
                                    {
                                        <span>No tickets match the selected filters.</span>
                                    }
                                    else
                                    {
                                        <span>No support tickets yet. Once Relay.app routes an email, it will appear here.</span>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive st-tickets-scroll">
                                <table id="ticketsTable" class="table table-hover table-sm mb-0 align-top">

                                    <thead class="table-light">
                                        <tr>
                                            <th class="col-num">#</th>
                                            <th class="col-date">Received At</th>
                                            <th class="col-email">Sender Email</th>
                                            <th class="col-client">Client</th>
                                            <th class="col-assigned">Assigned To</th>
                                            <th class="col-subject">Subject</th>
                                            <th class="col-intent">Intent</th>
                                            <th class="col-spec">Specialization</th>
                                            <th class="col-attach" title="JD / PDF / Resume">Attach.</th>
                                            <th class="col-mail">Mail Content</th>
                                            @if (showIrfCol)
                                            {
                                                <th class="col-irf">Ingested IRF</th>
                                            }
                                            <th class="col-status">Status</th>
                                            <th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in Model)
                                        {
                                            string tStatus = t.Status?.ToLower();
                                            string statusCss = tStatus == "open" ? "status-open"
                                            : tStatus == "inprogress" ? "status-inprogress"
                                            : tStatus == "closed" ? "status-closed"
                                            : "bg-light border";
                                            string driveLink = t.DriveFolderLink;
                                            <tr class="ticket-row" data-ticket-id="@t.Id">

                                                <td class="col-num text-muted" style="font-size:12px">@t.Id</td>

                                                <td class="col-date" style="font-size:12px">
                                                    @(t.ReceivedAt.HasValue ? t.ReceivedAt.Value.ToString("dd MMM yy, HH:mm") : "—")
                                                </td>

                                                <td class="col-email">
                                                    <a href="mailto:@t.SenderEmail" class="text-decoration-none st-email-ellipsis"
                                                       title="@t.SenderEmail">@t.SenderEmail</a>
                                                </td>

                                                <td class="col-client">
                                                    @if (!string.IsNullOrEmpty(t.ClientName))
                                                    {
                                                        <span class="fw-semibold st-cell-ellipsis" title="@t.ClientName">@t.ClientName</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic">Unknown</span>
                                                    }
                                                </td>

                                                <td class="col-assigned">
                                                    <!-- display row -->
                                                    <div class="assign-view" id="assign-view-@t.Id">
                                                        @if (!string.IsNullOrEmpty(t.AssignedTo))
                                                        {
                                                            <a href="mailto:@t.AssignedTo"
                                                               class="assign-name text-decoration-none text-dark st-assign-ellipsis"
                                                               title="@t.AssignedTo">
                                                                <i class="fas fa-user-circle text-secondary me-1" style="font-size:11px"></i>@t.AssignedTo
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="assign-name text-muted fst-italic" style="font-size:12px">
                                                                <i class="fas fa-user-slash me-1" style="font-size:11px"></i>Unassigned
                                                            </span>
                                                        }
                                                        <button type="button"
                                                                class="btn btn-outline-secondary btn-sm btn-edit-assign"
                                                                data-ticket-id="@t.Id"
                                                                title="Change assignee">
                                                            <i class="fas fa-pencil-alt"></i>
                                                        </button>
                                                    </div>
                                                    <!-- inline edit form (hidden until pencil clicked) -->
                                                    <div class="assign-edit-form" id="assign-edit-@t.Id">
                                                        <select class="form-select"
                                                                id="assign-select-@t.Id">
                                                            <option value="">Loading…</option>
                                                        </select>
                                                        <div class="assign-edit-row">
                                                            <button style="background: #489d48;padding: 1px 5px;" type="button"
                                                                    class="btn btn-success btn-sm btn-assign-ok"
                                                                    data-ticket-id="@t.Id"
                                                                    title="Save assignment">
                                                                <i class="fas fa-check me-1"></i>Save
                                                            </button>
                                                            <button style="background:#eb4d4d;color:#fff;padding: 1px 5px;" type="button"
                                                                    class="btn btn-outline-secondary btn-sm btn-assign-x"
                                                                    data-ticket-id="@t.Id"
                                                                    title="Cancel">
                                                                Cancel
                                                            </button>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="col-subject">@t.Subject</td>

                                                <td class="col-intent">
                                                    @if (!string.IsNullOrEmpty(t.Intent))
                                                    {
                                                        <span class="intent-badge bg-light border">@t.Intent</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>

                                                <td class="col-spec">
                                                    @if (!string.IsNullOrEmpty(t.PrimarySpecialization))
                                                    {
                                                        <span class="spec-badge bg-light text-dark border">@t.PrimarySpecialization</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>

                                                <td class="col-attach">
                                                    <div class="attach-icons">
                                                        <i class="fas fa-file-alt attach-icon @(t.AttachmentJobDescription ? "yes" : "no")"
                                                           title="@(t.AttachmentJobDescription ? "JD attached" : "No JD")"></i>
                                                        <i class="fas fa-file-pdf attach-icon @(t.AttachmentPdf ? "yes" : "no")"
                                                           title="@(t.AttachmentPdf ? "PDF attached" : "No PDF")"></i>
                                                        <i class="fas fa-user attach-icon @(t.AttachmentResumes ? "yes" : "no")"
                                                           title="@(t.AttachmentResumes ? "Resume(s) attached" : "No resumes")"></i>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(driveLink))
                                                    {
                                                        <a href="@driveLink" target="_blank" class="drive-link text-warning text-decoration-none"
                                                           title="Open Drive folder"><i class="fab fa-google-drive"></i></a>
                                                    }
                                                </td>

                                                <td class="col-mail">
                                                    @if (!string.IsNullOrWhiteSpace(t.MailContent))
                                                    {
                                                        <div class="mail-preview-text">@t.MailContent</div>
                                                        <button type="button"
                                                                class="btn btn-outline-secondary btn-sm btn-view-mail"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#mailDetailModal"
                                                                data-sender="@t.SenderEmail"
                                                                data-subject="@t.Subject"
                                                                data-intent="@(t.Intent ?? "—")"
                                                                data-specialization="@(t.PrimarySpecialization ?? "—")"
                                                                data-mailbodyintent="@(t.MailBodyIntent ?? "—")"
                                                                data-received="@(t.ReceivedAt.HasValue ? t.ReceivedAt.Value.ToString("dd MMM yyyy, HH:mm") : "—")"
                                                                data-body="@t.MailContent"
                                                                data-summarymail="@(t.SummaryMail ?? "")"
                                                                data-summarycandidates="@(t.SummaryCandidates ?? "")"
                                                                data-summaryinterviews="@(t.SummaryInterviewScores ?? "")">
                                                            <i class="fas fa-expand-alt me-1"></i>View full
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>

                                                @if (showIrfCol)
                                                {
                                                    <td class="col-irf">
                                                        @if (t.IngestedIRFId.HasValue && !string.IsNullOrEmpty(t.IngestedIRFName))
                                                        {
                                                            var irfTitle = t.IngestedIRFName + (string.IsNullOrEmpty(t.IngestedIRFJDTitle) ? "" : " (" + t.IngestedIRFJDTitle.Trim() + ")");
                                                            <span class="irf-badge" title="@irfTitle">
                                                                @t.IngestedIRFName
                                                                @if (!string.IsNullOrEmpty(t.IngestedIRFJDTitle))
                                                                {
                                                                    <span class="jd-title">(@t.IngestedIRFJDTitle.Trim())</span>
                                                                }
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">—</span>
                                                        }
                                                    </td>
                                                }

                                                <td class="col-status">
                                                    <span style="word-break: normal; " class="intent-badge @statusCss">@(t.Status ?? "Open")</span>
                                                </td>

                                                <td class="col-actions">
                                                    <div class="action-btns">
                                                        @if (tStatus == "open")
                                                        {
                                                            <button type="button" title="Mark In Progress"
                                                                    class="btn btn-outline-primary btn-sm status-change-btn"
                                                                    data-ticket-id="@t.Id" data-new-status="InProgress">
                                                                <i class="fas fa-play"></i>
                                                            </button>
                                                            <button type="button" title="Close Ticket"
                                                                    class="btn btn-outline-success btn-sm status-change-btn"
                                                                    data-ticket-id="@t.Id" data-new-status="Closed">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        }
                                                        else if (tStatus == "inprogress")
                                                        {
                                                            <button type="button" title="Mark Open"
                                                                    class="btn btn-outline-warning btn-sm status-change-btn"
                                                                    data-ticket-id="@t.Id" data-new-status="Open">
                                                                <i class="fas fa-undo"></i>
                                                            </button>
                                                            <button type="button" title="Close Ticket"
                                                                    class="btn btn-outline-success btn-sm status-change-btn"
                                                                    data-ticket-id="@t.Id" data-new-status="Closed">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" title="Reopen Ticket"
                                                                    class="btn btn-outline-warning btn-sm status-change-btn"
                                                                    data-ticket-id="@t.Id" data-new-status="Open">
                                                                <i class="fas fa-undo"></i>
                                                            </button>
                                                        }
                                                        <button type="button" title="View History"
                                                                class="btn btn-outline-secondary btn-sm btn-history"
                                                                data-ticket-id="@t.Id"
                                                                data-ticket-subject="@t.Subject">
                                                            <i class="fas fa-history"></i>
                                                        </button>
                                                        @if (t.HasPendingResumes || t.AttachmentResumes)
                                                        {
                                                            <button type="button" title="Review & Ingest Resumes"
                                                                    class="btn btn-outline-warning btn-sm btn-review-resumes"
                                                                    data-ticket-id="@t.Id"
                                                                    data-ticket-subject="@t.Subject"
                                                                    data-ticket-status="@t.Status">
                                                                <i class="fas fa-file-upload"></i>
                                                            </button>
                                                        }
                                                        @if (showIrfCol && t.IngestedIRFId.HasValue && !string.IsNullOrEmpty(t.IngestedIRFName))
                                                        {
                                                            <a href="@Url.Action("Resumes", "Candidate", new { irfId = t.IngestedIRFId.Value, irfName = t.IngestedIRFName })"
                                                               target="_blank"
                                                               class="btn btn-outline-info btn-sm btn-resumes"
                                                               title="View ingested resumes">
                                                                <i class="fas fa-file-alt"></i>
                                                            </a>
                                                        }
                                                    </div>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                        }
                    </div>

                    @if (totalCount > 0)
                    {
                        <div class="card-footer d-flex align-items-center justify-content-between bg-white border-top py-2 flex-wrap gap-2">
                            <small class="text-muted">
                                Showing <strong>@first–@last</strong> of <strong>@totalCount</strong> ticket@(totalCount == 1 ? "" : "s")
                                @if (hasFilters)
                                {
                                    <span>(filtered)</span>
                                }
                            </small>

                            @if (totalPages > 1)
                            {
                                <nav aria-label="Ticket pagination">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                                            <a class="page-link" href="@pageUrl(page - 1)" aria-label="Previous">
                                                <span aria-hidden="true">«</span>
                                            </a>
                                        </li>
                                        @{
                                            int startP = Math.Max(1, page - 3);
                                            int endP = Math.Min(totalPages, page + 3);
                                            if (startP > 1)
                                            {
                                                <li class="page-item"><a class="page-link" href="@pageUrl(1)">1</a></li>
                                                if (startP > 2)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                                }
                                            }
                                            for (int p = startP; p <= endP; p++)
                                            {
                                                <li class="page-item @(p == page ? "active" : "")">
                                                    <a class="page-link" href="@pageUrl(p)">@p</a>
                                                </li>
                                            }
                                            if (endP < totalPages)
                                            {
                                                if (endP < totalPages - 1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                                }
                                                <li class="page-item"><a class="page-link" href="@pageUrl(totalPages)">@totalPages</a></li>
                                            }
                                        }
                                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                            <a class="page-link" href="@pageUrl(page + 1)" aria-label="Next">
                                                <span aria-hidden="true">»</span>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            }

                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">Per page:</small>
                                <select class="form-select form-select-sm" style="width:80px" onchange="changePageSize(this.value)">
                                    @if (ps10)
                                    {
                                        <option value="10" selected>10</option>
                                    }
                                    else
                                    {
                                        <option value="10">10</option>
                                    }
                                    @if (ps25)
                                    {
                                        <option value="25" selected>25</option>
                                    }
                                    else
                                    {
                                        <option value="25">25</option>
                                    }
                                    @if (ps50)
                                    {
                                        <option value="50" selected>50</option>
                                    }
                                    else
                                    {
                                        <option value="50">50</option>
                                    }
                                    @if (ps100)
                                    {
                                        <option value="100" selected>100</option>
                                    }
                                    else
                                    {
                                        <option value="100">100</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100"></div>

