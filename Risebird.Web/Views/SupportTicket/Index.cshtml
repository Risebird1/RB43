@model List<Risebird.Entities.ViewModel.SupportTicketVM>
@{
    ViewData["Title"] = "Customer Support Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #ticketsTable th               { font-size: 13px; white-space: nowrap; }
    #ticketsTable td               { font-size: 13px; vertical-align: middle; }
    .intent-badge                  { font-size: 11px; padding: 0.35em 0.7em; border-radius: 20px; font-weight: 500; }
    .status-open                   { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
    .status-closed                 { background: #d1e7dd; color: #0a3622; border: 1px solid #198754; }
    .status-inprogress             { background: #cfe2ff; color: #0a3278; border: 1px solid #0d6efd; }
    .mail-preview                  { max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #555; }
    .stat-card .stat-val           { font-size: 1.6rem; font-weight: 700; }
    .stat-card .stat-lbl           { font-size: 12px; color: #6c757d; }
    .ticket-row:hover              { background: #f8f9ff !important; cursor: default; }
    .col-actions                   { width: 80px; text-align: center; }
</style>

<div class="main-panel" id="main-panel">
<div class="pt30">
<div class="content client">
<div class="container-fluid py-4">

    <!-- Header -->
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h4 class="fw-bold mb-0">
                <i class="fas fa-headset text-primary me-2"></i>Customer Support Tickets
            </h4>
            <p class="text-muted mb-0 mt-1">
                Inbound support requests identified and routed by Relay.app
            </p>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
                <i class="fas fa-sync-alt me-1"></i>Refresh
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary cards -->
    @{
        int total      = Model.Count;
        int open       = Model.Count(t => string.Equals(t.Status, "Open",       StringComparison.OrdinalIgnoreCase));
        int inProgress = Model.Count(t => string.Equals(t.Status, "InProgress", StringComparison.OrdinalIgnoreCase));
        int closed     = Model.Count(t => string.Equals(t.Status, "Closed",     StringComparison.OrdinalIgnoreCase));
        int unresolved = Model.Count(t => t.ClientId == null);
    }
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-3">
            <div class="card border-0 shadow-sm text-center py-3 stat-card">
                <div class="stat-val text-primary">@total</div>
                <div class="stat-lbl">Total Tickets</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card border-0 shadow-sm text-center py-3 stat-card">
                <div class="stat-val text-warning">@open</div>
                <div class="stat-lbl">Open</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card border-0 shadow-sm text-center py-3 stat-card">
                <div class="stat-val text-info">@inProgress</div>
                <div class="stat-lbl">In Progress</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="card border-0 shadow-sm text-center py-3 stat-card">
                <div class="stat-val text-success">@closed</div>
                <div class="stat-lbl">Closed</div>
            </div>
        </div>
    </div>

    <!-- Tickets table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                    No support tickets yet. Once Relay.app routes an email, it will appear here.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table id="ticketsTable" class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Received At</th>
                                <th>Sender Email</th>
                                <th>Client</th>
                                <th>Subject</th>
                                <th>Intent</th>
                                <th>Mail Content</th>
                                <th>Status</th>
                                <th class="col-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr class="ticket-row">
                                    <td>@t.Id</td>
                                    <td style="white-space:nowrap">
                                        @(t.ReceivedAt.HasValue
                                            ? t.ReceivedAt.Value.ToString("dd MMM yyyy, HH:mm")
                                            : "—")
                                    </td>
                                    <td>
                                        <a href="mailto:@t.SenderEmail" class="text-decoration-none">
                                            @t.SenderEmail
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(t.ClientName))
                                        {
                                            <span class="fw-semibold">@t.ClientName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Unknown</span>
                                        }
                                    </td>
                                    <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"
                                        title="@t.Subject">
                                        @t.Subject
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(t.Intent))
                                        {
                                            <span class="intent-badge bg-light border">@t.Intent</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="mail-preview" title="@t.MailContent">
                                            @t.MailContent
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            string statusCss = t.Status?.ToLower() switch
                                            {
                                                "open"       => "status-open",
                                                "inprogress" => "status-inprogress",
                                                "closed"     => "status-closed",
                                                _            => "bg-light border"
                                            };
                                        }
                                        <span class="intent-badge @statusCss">@(t.Status ?? "Open")</span>
                                    </td>
                                    <td class="col-actions">
                                        @* Action buttons — will be wired up in a future sprint *@
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
</div>
</div>
</div>

@section Scripts {
    <script>
        // Wire up DataTables for search / sort
        $(document).ready(function () {
            if ($('#ticketsTable tbody tr').length > 0) {
                $('#ticketsTable').DataTable({
                    order:      [[1, 'desc']],
                    pageLength: 25,
                    language: {
                        search:     'Search tickets:',
                        lengthMenu: 'Show _MENU_ tickets'
                    },
                    columnDefs: [
                        { orderable: false, targets: [8] }  // Actions column
                    ]
                });
            }
        });
    </script>
}
