                    </h2>
                </div>
                <button type="button" class="btn-close prm-modal-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body prm-modal-body pt-3">
                <div class="card prm-panel border-0 shadow-none mb-3">
                    <div class="prm-panel-header">
                        <h3 class="prm-panel-title"><i class="fas fa-layer-group me-2"></i>Primary specialization</h3>
