@model List<Risebird.Entities.Data.WhatsAppCampaignModels.WhatsAppCampaignVM>
@using Risebird.Business.PlivoCX
@using Risebird.Entities.Data.WhatsAppCampaignModels
@{
    ViewData["Title"] = "WhatsApp Campaigns";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ist = PlivoCXCampaignRules.ResolveTimeZone(PlivoCXCampaignRules.IndiaTimeZoneId);
    string search = ViewBag.Search as string;
}
@await Html.PartialAsync("_WhatsAppCampaignStyles")

@* Standard portal page frame (main-panel), so the page sits beside the side menu like the rest of the app. *@
<div class="main-panel" id="main-panel">
<div class="pt30">
<div class="content client">
<div class="pcx-page">
    <div class="pcx-wrap">
        <div class="pcx-head">
            <div>
                <p class="pcx-eyebrow">WhatsApp · Interakt</p>
                <h3>WhatsApp campaigns</h3>
                <p class="pcx-sub">Send the schedule invite (C1), reschedule invite (C2) or confirmation reminder (C3) to a list of candidates, re-send on a schedule, and see who booked or confirmed. <a href="@Url.Action("Index", "PlivoCXCampaign")">PlivoCX call campaigns &rarr;</a></p>
            </div>
            <div class="pcx-actions">
                @if (new[] { "Admin", "SupportAdmin" }.Contains(Microsoft.AspNetCore.Http.SessionExtensions.GetString(Context.Session, "profileName")?.Trim().Replace("\"", "")))
                {
                    <a class="pcx-btn" href="@Url.Action("Index", "WhatsAppOptOut")">Opt-outs</a>
                }
                <a class="pcx-btn primary" href="@Url.Action("Create", "WhatsAppCampaign")">+ Create campaign</a>
            </div>
        </div>

        <div class="pcx-card">
            <div class="pcx-card-b" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
                <form method="get" action="@Url.Action("Index", "WhatsAppCampaign")" style="flex:1;max-width:440px;">
                    <input class="pcx-input" type="search" name="search" value="@search" placeholder="Search campaigns…" aria-label="Search campaigns" />
                </form>
                <span class="pcx-muted">@(Model.Count == 1 ? "1 campaign" : Model.Count + " campaigns")</span>
            </div>
            <div class="pcx-table-wrap">
                <table class="pcx-table">
                    <thead>
                        <tr>
                            <th>Campaign</th>
                            <th>Source</th>
                            <th>Template</th>
                            <th>Status</th>
                            <th class="pcx-num">Cand.</th>
                            <th class="pcx-num">Sent</th>
                            <th class="pcx-num">Booked / Confirmed</th>
                            <th class="pcx-num">No response</th>
                            <th class="pcx-num">No number</th>
                            <th class="pcx-num">Pending</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr><td colspan="12" class="pcx-empty">@(string.IsNullOrWhiteSpace(search) ? "No WhatsApp campaigns yet. Create one to start sending." : "No campaign matches \"" + search + "\".")</td></tr>
                        }
                        @foreach (var c in Model)
                        {
                            var created = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(c.CreatedAt, DateTimeKind.Utc), ist);
                            <tr>
                                <td class="strong"><a href="@Url.Action("Detail", "WhatsAppCampaign", new { id = c.Id })" style="color:inherit;">@c.Name</a></td>
                                <td>
                                    <div>@c.IRFName</div>
                                    <div class="pcx-muted pcx-small">@c.ClientName</div>
                                </td>
                                <td>@WhatsAppCampaignPurpose.TemplateLabel(c.Purpose)<div class="pcx-muted pcx-small">@c.EventName</div></td>
                                <td><span class="pcx-chip @c.Status">@c.Status</span></td>
                                <td class="pcx-num">@c.Candidates</td>
                                <td class="pcx-num">@c.Sent</td>
                                <td class="pcx-num" title="@(c.Declined > 0 ? c.Declined + " declined" : "")">@c.Converted</td>
                                <td class="pcx-num">@c.NoResponse</td>
                                <td class="pcx-num">@c.NoNumber</td>
                                <td class="pcx-num">@c.Pending</td>
                                <td>
                                    <div>@created.ToString("dd MMM")</div>
                                    <div class="pcx-muted pcx-small">@c.CreatedBy</div>
                                </td>
                                <td style="white-space:nowrap;">
                                    <a class="pcx-link" href="@Url.Action("Detail", "WhatsAppCampaign", new { id = c.Id })">Open</a>
                                    <span class="pcx-muted">·</span>
                                    <a class="pcx-link" href="@(Url.Action("Detail", "WhatsAppCampaign", new { id = c.Id }) + "#policy")">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>
</div>
</div>
