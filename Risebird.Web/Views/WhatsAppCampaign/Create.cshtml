@using Risebird.Entities.Data.PlivoCXModels
@using Risebird.Entities.Data.WhatsAppCampaignModels
@{
    ViewData["Title"] = "Create WhatsApp Campaign";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var irfs = ViewBag.IRFs as List<PlivoCXCampaignIRFOption> ?? new List<PlivoCXCampaignIRFOption>();
    var limits = ViewBag.Limits as Dictionary<string, int> ?? new Dictionary<string, int>();
    string startSource = ViewBag.Source as string ?? PlivoCXCampaignSource.IRF;
    var defaultName = "WhatsApp campaign — " + DateTime.Now.ToString("d MMM");
    var sources = new[] { PlivoCXCampaignSource.IRF, PlivoCXCampaignSource.NotScheduled, PlivoCXCampaignSource.Reschedule, PlivoCXCampaignSource.Unconfirmed };
}
@await Html.PartialAsync("_WhatsAppCampaignStyles")

@* Standard portal page frame (main-panel), so the page sits beside the side menu like the rest of the app. *@
<div class="main-panel" id="main-panel">
<div class="pt30">
<div class="content client">
<div class="pcx-page">
    <div class="pcx-wrap">
        <div class="pcx-head">
            <div>
                <p class="pcx-eyebrow">WhatsApp · Campaigns</p>
                <h3>Create WhatsApp campaign</h3>
            </div>
            <a class="pcx-btn" href="@Url.Action("Index", "WhatsAppCampaign")">All WhatsApp campaigns</a>
        </div>

        <div class="pcx-card"><div class="pcx-card-b">
            @Html.AntiForgeryToken()
            <div id="wacError" class="pcx-alert err" style="display:none;"></div>

            <div class="pcx-field">
                <label class="pcx-label" for="wacName">Campaign name</label>
                <input class="pcx-input" id="wacName" maxlength="200" value="@defaultName" />
            </div>

            <div class="pcx-field">
                <span class="pcx-label">Candidate source — decides the template</span>
                <div class="pcx-seg" id="wacSource" role="tablist">
                    <button type="button" data-source="IRF">By IRF · C1</button>
                    <button type="button" data-source="NotScheduled">Not scheduled · C1</button>
                    <button type="button" data-source="Reschedule">Reschedule · C2</button>
                    <button type="button" data-source="Unconfirmed">Not confirmed · C3</button>
                </div>
                @if ((ViewBag.ChannelScoped as bool?) == true)
                {
                    <div class="pcx-muted pcx-small" style="margin-top:5px;">The Not-scheduled and Reschedule lists show only the skill channels assigned to you, as on those pages.</div>
                }
            </div>

            <div class="pcx-field">
                <span class="pcx-label">Template this campaign sends</span>
                @foreach (var s in sources)
                {
                    var purpose = WhatsAppCampaignPurpose.ForSource(s);
                    <div class="wac-tpl" data-source="@s" style="display:none;">
                        <div class="pcx-small" style="margin-bottom:4px;"><b>@WhatsAppCampaignPurpose.TemplateLabel(purpose)</b> · Interakt event <code>@WhatsAppCampaignPurpose.EventFor(purpose)</code>
                            @if (WhatsAppCampaignPurpose.IsLimited(purpose))
                            {
                                <span class="pcx-muted"> · at most @(limits.TryGetValue(purpose, out var l) ? l : 3) per candidate per IRF, counted across every route</span>
                            }
                        </div>
                        <p class="wac-template">@WhatsAppCampaignPurpose.TemplateText(purpose)</p>
                    </div>
                }
            </div>

            <div class="pcx-field">
                <span class="pcx-label">IRF / list filter</span>
                <div id="wacFilterIRF" style="display:flex;gap:8px;flex-wrap:wrap;">
                    <input class="pcx-input" id="wacIrfFilter" placeholder="Filter IRFs…" style="max-width:220px;" aria-label="Filter IRFs" />
                    <select class="pcx-select" id="wacIrf" style="flex:1;min-width:260px;" aria-label="IRF">
                        <option value="">Choose an IRF…</option>
                        @foreach (var i in irfs)
                        {
                            <option value="@i.Id">@(i.IRFId + " · " + i.JobTitle + " — " + i.ClientName)</option>
                        }
                    </select>
                </div>
                <div id="wacFilterList" style="display:none;gap:8px;flex-wrap:wrap;align-items:center;">
                    <input class="pcx-input" id="wacListSearch" placeholder="Search name, email, IRF…" style="max-width:280px;" aria-label="Search the list" />
                    <select class="pcx-select" id="wacListClient" style="max-width:240px;" aria-label="Client"><option value="">All clients</option></select>
                    <span id="wacDates" style="display:none;gap:6px;align-items:center;">
                        <span class="pcx-muted">Meetings from</span>
                        <input class="pcx-input" type="date" id="wacStart" style="width:150px;" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")" />
                        <span class="pcx-muted">to</span>
                        <input class="pcx-input" type="date" id="wacEnd" style="width:150px;" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <button type="button" class="pcx-btn sm" id="wacReload">Load</button>
                    </span>
                </div>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin:6px 0 8px;">
                <label style="margin:0;font-weight:600;"><input type="checkbox" id="wacAll" /> <span id="wacCount">0 of 0 selected</span></label>
                <span class="pcx-muted pcx-small"><span id="wacLoadedAt"></span> · unsubscribed, at-limit and number-less candidates are not eligible and are never sent to</span>
            </div>

            <div class="pcx-table-wrap" style="max-height:520px;overflow-y:auto;border:1px solid #eef2f6;border-radius:8px;">
                <table class="pcx-table">
                    <thead>
                        <tr><th style="width:34px;"></th><th>Candidate</th><th>Email</th><th>WhatsApp</th><th>IRF</th><th class="pcx-num">Used</th><th style="text-align:right;">Eligibility</th></tr>
                    </thead>
                    <tbody id="wacRows">
                        <tr><td colspan="7" class="pcx-empty">Choose an IRF or a list to see candidates.</td></tr>
                    </tbody>
                </table>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-top:14px;border-top:1px solid #eef2f6;padding-top:14px;">
                <span class="pcx-muted">Starts as a <b>Draft</b>. Nothing is sent until you set the policy, send a test, and press <b>Send now</b> or <b>Start automatic</b>.</span>
                <button type="button" class="pcx-btn primary" id="wacCreate">Create campaign</button>
            </div>
        </div></div>
    </div>
</div>
</div>
</div>
</div>

<script>
(function () {
    var URLS = {
        IRF:          '@Url.Action("CandidatesForIRF", "WhatsAppCampaign")',
        NotScheduled: '@Url.Action("CandidatesFromNotScheduled", "WhatsAppCampaign")',
        Reschedule:   '@Url.Action("CandidatesFromReschedule", "WhatsAppCampaign")',
        Unconfirmed:  '@Url.Action("CandidatesFromUnconfirmed", "WhatsAppCampaign")'
    };
    var LABELS = { 'eligible': 'eligible', 'has-meeting': 'has meeting', 'no-number': 'no WhatsApp number', 'not-eligible': 'not eligible' };

    var source = '@startSource', rows = [], loadSeq = 0, loaded = false;

    function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
    function showError(msg) { $('#wacError').text(msg).toggle(!!msg); }

    function setSource(s) {
        source = s;
        $('#wacSource button').removeClass('on').filter('[data-source="' + s + '"]').addClass('on');
        $('.wac-tpl').hide().filter('[data-source="' + s + '"]').show();
        $('#wacFilterIRF').toggle(s === 'IRF');
        $('#wacFilterList').css('display', s === 'IRF' ? 'none' : 'flex');
        $('#wacDates').css('display', s === 'Reschedule' ? 'inline-flex' : 'none');
        load();
    }

    function message(html) { $('#wacRows').html('<tr><td colspan="7" class="pcx-empty">' + html + '</td></tr>'); }

    // The centralized lists run the same slow procedures as their pages (minutes across every
    // channel), so the loading row counts up instead of looking frozen.
    var timer = null;
    function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }

    function load(refresh) {
        rows = []; loaded = false; stopTimer(); $('#wacLoadedAt').empty(); updateCount();
        $('#wacListClient').empty().append('<option value="">All clients</option>');
        var url = URLS[source], data = {};
        if (source === 'IRF') {
            var irf = $('#wacIrf').val();
            if (!irf) { message('Choose an IRF to see its candidates.'); return; }
            data = { irfId: irf };
        } else if (source === 'Reschedule') {
            data = { startDate: $('#wacStart').val(), endDate: $('#wacEnd').val() };
        }
        if (refresh) data.refresh = true;
        var seq = ++loadSeq, started = Date.now();
        var slowNote = source === 'IRF' ? '' : ' <span class="pcx-small">This list covers every skill channel you can see and can take a few minutes, as on its own page.</span>';
        function tick() {
            var s = Math.floor((Date.now() - started) / 1000);
            message('<i class="fa fa-spinner fa-spin"></i> Loading candidates… ' + (s >= 5 ? Math.floor(s / 60) + ':' + ('0' + s % 60).slice(-2) : '') + (s >= 5 ? '<br/>' + slowNote : ''));
        }
        tick(); timer = setInterval(function () { if (seq === loadSeq) tick(); else stopTimer(); }, 1000);
        $.get(url, data).done(function (res) {
            if (seq !== loadSeq) return;
            stopTimer();
            if (!res || !res.ok) { message(esc(res && res.message || 'Could not load candidates.')); return; }
            rows = res.candidates || []; loaded = true;
            var clients = {};
            rows.forEach(function (r) { if (r.clientName) clients[r.clientName] = 1; });
            var sel = $('#wacListClient').empty().append('<option value="">All clients</option>');
            Object.keys(clients).sort().forEach(function (c) { sel.append($('<option>').val(c).text(c)); });
            if (res.loadedAt) $('#wacLoadedAt').html('loaded ' + esc(res.loadedAt) + ' · <a href="#" class="pcx-link" id="wacRefresh">Refresh</a>');
            render();
        }).fail(function () {
            if (seq !== loadSeq) return;
            stopTimer();
            message('Could not load candidates. Try again.');
        });
    }

    function visible() {
        if (source === 'IRF') return rows;
        var q = ($('#wacListSearch').val() || '').toLowerCase(), client = $('#wacListClient').val();
        return rows.filter(function (r) {
            if (client && r.clientName !== client) return false;
            if (!q) return true;
            return [r.name, r.email, r.phone, r.irfName, r.jobTitle].join(' ').toLowerCase().indexOf(q) >= 0;
        });
    }

    // Only eligible and has-meeting rows can be ticked: the others would be added settled and never sent to.
    function pickable(r) { return r.candidateId > 0 && (r.eligibility === 'eligible' || r.eligibility === 'has-meeting'); }

    function render() {
        var list = visible();
        if (!rows.length) {
            if (loaded) message(source === 'IRF' ? 'This IRF has no candidates.' : 'Nobody is on this list right now.');
            updateCount();
            return;
        }
        if (!list.length) { $('#wacRows').html('<tr><td colspan="7" class="pcx-empty">No candidate matches the filter.</td></tr>'); updateCount(); return; }
        var html = list.map(function (r) {
            var idx = rows.indexOf(r), can = pickable(r);
            var used = r.sendLimit > 0 ? (r.sendsUsed + '/' + r.sendLimit + ' used') : '—';
            return '<tr>' +
                '<td><input type="checkbox" class="wac-pick" data-i="' + idx + '"' + (r.selected && can ? ' checked' : '') + (can ? '' : ' disabled') + ' aria-label="Include ' + esc(r.name) + '" /></td>' +
                '<td>' + esc(r.name || '—') + '</td>' +
                '<td>' + esc(r.email || '—') + '</td>' +
                '<td style="white-space:nowrap;">' + esc(r.phone || '—') + '</td>' +
                '<td><div>' + esc(r.irfName || '') + '</div><div class="pcx-muted pcx-small">' + esc(r.originalDate ? 'meeting ' + r.originalDate : (r.jobTitle || '')) + '</div></td>' +
                '<td class="pcx-num wac-used">' + esc(used) + '</td>' +
                '<td style="text-align:right;"><span class="pcx-chip ' + esc(r.eligibility) + '">' + esc(LABELS[r.eligibility] || r.eligibility) + '</span>' +
                    (r.note ? '<div class="pcx-muted pcx-small">' + esc(r.note) + '</div>' : '') + '</td>' +
                '</tr>';
        }).join('');
        $('#wacRows').html(html);
        updateCount();
    }

    function updateCount() {
        var list = visible().filter(pickable);
        var picked = rows.filter(function (r) { return r.selected && pickable(r); }).length;
        $('#wacCount').text(picked + ' of ' + rows.length + ' selected');
        var visPicked = list.filter(function (r) { return r.selected; }).length;
        $('#wacAll').prop('checked', list.length > 0 && visPicked === list.length).prop('indeterminate', visPicked > 0 && visPicked < list.length);
    }

    $('#wacSource').on('click', 'button', function () { setSource($(this).data('source')); });
    $('#wacIrf').on('change', function () { load(false); });
    $('#wacReload').on('click', function () { load(false); });
    $('#wacLoadedAt').on('click', '#wacRefresh', function (e) { e.preventDefault(); load(true); });
    $('#wacListSearch').on('input', render);
    $('#wacListClient').on('change', render);
    $('#wacIrfFilter').on('input', function () {
        var q = this.value.toLowerCase();
        $('#wacIrf option').each(function () { if (this.value) $(this).toggle($(this).text().toLowerCase().indexOf(q) >= 0); });
    });
    $('#wacRows').on('change', '.wac-pick', function () { rows[$(this).data('i')].selected = this.checked; updateCount(); });
    $('#wacAll').on('change', function () {
        var on = this.checked;
        visible().forEach(function (r) { if (pickable(r)) r.selected = on; });
        render();
    });

    $('#wacCreate').on('click', function () {
        showError('');
        var picked = rows.filter(function (r) { return r.selected && pickable(r); });
        var name = $.trim($('#wacName').val());
        if (!name) { showError('Give the campaign a name.'); return; }
        if (!picked.length) { showError('Tick at least one candidate.'); return; }
        var btn = $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Creating…');
        var payload = {
            Name: name,
            SourceType: source,
            IRFId: source === 'IRF' ? parseInt($('#wacIrf').val(), 10) : null,
            Candidates: picked
        };
        $.post('@Url.Action("Create", "WhatsAppCampaign")', {
            payload: JSON.stringify(payload),
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        }).done(function (res) {
            if (res && res.ok) { window.location = res.redirect; return; }
            showError(res && res.message || 'The campaign could not be created.');
            btn.prop('disabled', false).text('Create campaign');
        }).fail(function () {
            showError('The campaign could not be created. Try again.');
            btn.prop('disabled', false).text('Create campaign');
        });
    });

    setSource(source);
})();
</script>
