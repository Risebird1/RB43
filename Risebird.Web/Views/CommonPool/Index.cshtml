                if (data == "Success") {
                    if (islock == 0) {
                        swal.fire("Profile Unlocked Successfully");
                        document.getElementById("unlock_" + interviewid).style.display = "block";
                        document.getElementById("lock_" + interviewid).style.display = "none";
                        document.getElementById("commonpool_" + interviewid).style.border = "3px solid green";

                    } else {
                        swal.fire("Profile Locked Successfully");
                        document.getElementById("lock_" + interviewid).style.display = "block";
                        document.getElementById("unlock_" + interviewid).style.display = "none";
                        document.getElementById("commonpool_" + interviewid).style.border = "3px solid black";
                    }
                }
            }
        });
    }
