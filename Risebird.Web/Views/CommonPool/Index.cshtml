                                                                            @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                            {
                                                                                @if (item != null && item != "")
                                                                                {
                                                                                    <option value="@item">@item</option>
                                                                                }
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                        Client HR
                                                                    </label>
                                                                    <div class="col-md-12 col-sm-12">
                                                                        <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                            @foreach (var item in ViewBag.ClientHrContactList)
                                                                            {
                                                                                @if (item != null && item != "")
                                                                                {
                                                                                    <option value="@item">@item</option>
                                                                                }
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <input type="text" id="txtsearch" name="SearchFillter" value="@ViewBag.searchvalue" hidden />

                                                            </div>
