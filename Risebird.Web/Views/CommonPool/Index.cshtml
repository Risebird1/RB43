            $("#CandidateName").val(candidateName);
            $("#ClientName").val(clientName);
            $("#CandidateLocation").val(candidateLocation);
            $("#IsShortListed").val(IsShortListed);
            $("#IsIntrested").val(IsIntrested);
            $("#CandidateAvailable").val(CandidateAvailable);

    }


