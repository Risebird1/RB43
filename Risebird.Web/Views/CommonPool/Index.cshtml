                                                                            <option value="NotAvailable">NotAvailable</option>

                                                                        </select>
                                                                    </div>
                                                                </div>



                                                            </div>
                                                        }
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CandidateLocation">
                                                                    Candidate Location
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
