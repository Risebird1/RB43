    function Lockvideo(interviewid, islock, emailid) {
        $.ajax({
            url: '/CommonPool/LockorUnlockVideo',
            data: { 'imid': interviewid, 'islock': islock, 'emailid': emailid },
            success: function (data) {
                if (data == "Success") {
                    swal.fire("Successfully");
                    if (islock == 0) {
                        document.getElementById("unlock_" + interviewid).style.display = "block";
                        document.getElementById("lock_" + interviewid).style.display = "none";

                    } else {
                        document.getElementById("lock_" + interviewid).style.display = "block";
                        document.getElementById("unlock_" + interviewid).style.display = "none";

                    }
                }
            }
        });
    }
    function closeLockForUserpopup() {
        var modal = document.getElementById("LockForUserpopup");
        modal.style.display = "none";
    }
    function Lockvideopopup(imid, islock, ClientName) {
        $("#hidimid").val(imid);
        $.ajax({
            url: '/CommonPool/FetchClientUsers',
            data: { 'ClientName': ClientName },
            success: function (data) {
                var drp = $("#ddlClientUser");
                for (i = 0; i < drp.length; i++) {
                    $("#ddlClientUser option").remove();
                }
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");
                        option.html(this);
                        option.val(this);
                        drp.append(option);
                    });
                }
                var modal = document.getElementById("LockForUserpopup");
                modal.style.display = "block";
            }
        });
    }
    function Lockvalues() {
        var selectemailid = $("#ddlClientUser").val();
        var imid = $("#hidimid").val();
        closeLockForUserpopup();
        Lockvideo(imid, 1, selectemailid);
    }
