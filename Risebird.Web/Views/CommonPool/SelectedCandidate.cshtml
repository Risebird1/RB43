@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Interviews";
    ViewBag.PageHeader = "Selected Candidate";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] RFID = new string[] { };
    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] Interviewer = new string[] { };
    string[] ClientName = new string[] { };
    string[] Client = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("CommonPoolSelectedCandidatefilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("CommonPoolSelectedCandidatefilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    Client = filter.Client != null ? filter.Client : new string[] { };
}

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />


<div class="main-panel" id="main-panel">

    @*<div class="mobile-view">*@
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Selected Candidate</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <a href="/Interview/Index" class="mdc-button mdc-button--raised mdc-ripple-upgraded">Back</a>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">

                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </div>
    @*</div>*@


    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">

                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("SelectedCandidate","CommonPool")" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Primary Skill</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">

                                                                        @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                            }
                                                                        }
                                                                    </select>


                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                    Client
                                                                    HR
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                        @foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Client">
                                                                    Client
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Client" name="Client" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                        @foreach (var item in Model.Select(x => x.Client).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="RFID">RFID</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="RFID" name="RFID" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">

                                                                        @foreach (var item in Model.Select(x => x.IRFId).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                    Interview Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                        @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>


                                                                    </div>

                                                                </div>
                                                            </div>
                                                        </div>




                                                    </div>
                                                </div>


                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <div id="tableID" class="second">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Move To CP</th>
                                                    <th style="text-align:center">Availability</th>
                                                    <th style="text-align:center;padding-right:0px;">Action</th>
                                                    <th id='start'>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>Client HR</th>
                                                    <th>Client Name</th>
                                                    <th>Video Link</th>

                                                    <th style="text-align:center">Call</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Move To CP</th>
                                                    <th style="text-align:center">Availability</th>
                                                    <th style="text-align:center">Action</th>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>Client HR</th>
                                                    <th>Client Name</th>
                                                    <th>Video Link</th>

                                                    <th style="text-align:center">Call</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                    <tr id=@item.imid>
                                                        @if (item.MoveToCP)
                                                        {
                                                            <td class="text-center action">
                                                                <div class="switch-btn">
                                                                    <span class="on-off">Off</span>
                                                                    <div class="material-toggle" onclick="ChangeCheckbox(@item.imid)">

                                                                        <input class="switch" id="MoveToCP_@item.imid" type="checkbox" checked="checked" value="false" name="Move To CommonPool">
                                                                        <label for="MoveToCP" class=""></label>

                                                                    </div>
                                                                    <span class="on-off">On</span>
                                                                </div>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center action">
                                                                <div class="switch-btn">
                                                                    <span class="on-off">Off</span>
                                                                    <div class="material-toggle" onclick="ChangeCheckbox(@item.imid)">

                                                                        <input class="switch" id="MoveToCP_@item.imid" type="checkbox" value="false" name="Move To CommonPool">
                                                                        <label for="MoveToCP" class=""></label>

                                                                    </div>
                                                                    <span class="on-off">On</span>
                                                                </div>
                                                            </td>
                                                        }
                                                        @if (item.CandidateAvailable == "Available")
                                                        {
                                                            <td class="text-center action">
                                                                <div class="switch-btn">
                                                                    <span class="on-off">No</span>
                                                                    <div class="material-toggle" onclick="ChangeAvailableCheckbox(@item.imid)">

                                                                        <input class="switch" id="CanAva_@item.imid" type="checkbox" checked="checked" value="false" name="Move To CommonPool">
                                                                        <label for="CandidateAvailable" class=""></label>

                                                                    </div>
                                                                    <span class="on-off">Yes</span>
                                                                </div>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center action">
                                                                <div class="switch-btn">
                                                                    <span class="on-off">No</span>
                                                                    <div class="material-toggle" onclick="ChangeAvailableCheckbox(@item.imid)">

                                                                        <input class="switch" id="CanAva_@item.imid" type="checkbox" value="false" name="Move To CommonPool">
                                                                        <label for="CandidateAvailable" class=""></label>

                                                                    </div>
                                                                    <span class="on-off">Yes</span>
                                                                </div>
                                                            </td>
                                                        }
                                                        <td class="text-center">

                                                            @if (item.CandidateAvailable == "Available")
                                                            {
                                                                <div id="lockbutton_@item.imid">
                                                                    @if (item.IsLock)
                                                                    {

                                                                        <span id="lock_@item.imid" style="display:block">
                                                                            <button class="lock-un">
                                                                                <span title="Unlock" onclick="Lockvideo(@item.imid,0,'')">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="rgb(136,136,136)" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" /></svg>

                                                                                </span>
                                                                            </button>
                                                                        </span>
                                                                        <span id="unlock_@item.imid" style="display:none">
                                                                            <button class="lock-un">
                                                                                <span title="Lock" onclick="Lockvideopopup(@item.imid,1,'@item.Client')">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="rgb(136,136,136)" d="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z" /></svg>
                                                                                </span>
                                                                            </button>
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span id="lock_@item.imid" style="display:none">
                                                                            <button class="lock-un">
                                                                                <span title="Unlock" onclick="Lockvideo(@item.imid,0,'')">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="rgb(136,136,136)" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" /></svg>
                                                                                </span>
                                                                            </button>
                                                                        </span>
                                                                        <span id="unlock_@item.imid" style="display:block">
                                                                            <button class="lock-un">
                                                                                <span title="Lock" onclick="Lockvideopopup(@item.imid,1,'@item.Client')">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"><path fill="rgb(136,136,136)" d="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z" /></svg>
                                                                                </span>
                                                                            </button>
                                                                        </span>
                                                                    }
                                                                </div>
                                                            }

                                                        </td>
                                                        <td title=@item.IRFId> @item.IRFId </td>
                                                        <td> @item.interviewDate </td>
                                                        @if (item.IsOnline == 1)
                                                        {
                                                            <td>
                                                                <a onclick="directopenChat('@item.candidateEmail')"><span class="dot" style="background-color:green"></span>    @item.candidateName </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @item.candidateName
                                                            </td>
                                                        }
                                                        <td> @item.candidateEmail<input type="text" hidden id="txtcandidateemail_@item.imid" value="@item.candidateEmail" /></td>
                                                        <td> @item.JDTiltle.Split("|")[0] </td>
                                                        @if (item.InterviewStatus != 4 && item.InterviewStatus != 2)
                                                        {
                                                            <td> @item.intervieweStatusStatDesc</td>
                                                        }
                                                        else if (item.InterviewStatus == 4)
                                                        {
                                                            <td>
                                                                <a style="color:darkorange; font-weight: bold"> @item.intervieweStatusStatDesc</a>
                                                            </td>
                                                        }
                                                        else if (item.InterviewStatus == 2)
                                                        {
                                                            <td>
                                                                <a style="color:green;font-weight: bold"> @item.intervieweStatusStatDesc</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.resumeLink != null && item.resumeLink != "")
                                                        {
                                                            <td>

                                                                <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }

                                                        @if (item.IsHrOnline == 1)
                                                        {
                                                            <td>
                                                                <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @item.ClientHrContact
                                                            </td>
                                                        }
                                                        <td> @item.Client </td>

                                                        @if (item.VideoLink != null && item.VideoLink != "")
                                                        {
                                                            <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Video</td>
                                                        }

                                                        <td class="text-center">
                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                            {
                                                                <!--- <button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="ModalButtonClick(@jsonObject)" data-original-title="Tooltip on top"> Call Candidate</span></button>-->
                                                                <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="ModalButtonClick(@jsonObject)" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span></span>
                                                            }

                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>

                    <div id="myModal" class="modal modal-bg">
                        <!-- Modal content -->
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">



                                <div class="filheader">
                                    <div class="filavatar">
                                        <span>


                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                                        </span>
                                    </div>
                                    <h5 class="modal-title pull-left"> Call Candidate!</h5>
                                </div>
                                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                                </button>



                                <div class="modal-body">
                                    <div>
                                        <h5 class="modal-title text-center mt-20" id="callingLabel">Calling...</h5>

                                    </div>

                                    <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto; display: block;" class="btn btn-fill btn-danger" value="Hang Up">

                                </div>

                            </div>

                        </div>
                    </div>


                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>

<div id="LockForUserpopup" class="modal modal-bg" style="z-index:3">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">


                        <svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Lock For User</h5>
