    <script>
        var isIE11 = !!window.MSInputMethodContext && !!document.documentMode;
        var $selectMultiSelects = $("#edit-StatesPp-id, select[multiple='multiple']");
        var $jsonMultiSelects = $(" #bsMultiSelectJson, #bsMultiSelectJson2");
        var $multiSelects = $selectMultiSelects.add($jsonMultiSelects);
        function install() {
            $selectMultiSelects.bsMultiSelect(
                {
                    cssPatch: window.cssPatch,
                    setSelected: function (o, v) {
                        o.selected = v;
                        if (!isIE11)
                            $('.toast').toast('show').find('.toast-body').css('text-decoration', v ? 'none' : 'line-through').text(o.text);
                    },
                }
            );
            $jsonMultiSelects.bsMultiSelect({
                cssPatch: window.cssPatch,
                setSelected: function (o, i) {
                    o.selected = i;
                    if (!isIE11)
                        $('.toast').toast('show').find('.toast-body').css('text-decoration', i ? 'none' : 'line-through').text(o.text);
                },
                placeholder: "Placeholder from config object",
                getDisabled: function () {
                    return $('#optionDisable').prop("checked");
                },
                buildConfiguration: function (element, configuration) {
                    configuration.label = $('#' + element.id + 'Label').get(0);
                    configuration.getSize = function () {
                        var v = $("#bs-size-name-id").val();
                        return v == "LG" ? "lg" : (v == "SM" ? "sm" : null);
                    }
                }
            });
        }
        install();
    </script>






    <!-- Control Center for Now Ui Dashboard: parallax effects, scripts for the example pages etc -->


    <script type="text/javascript" src="~/js/settings.js"></script>
    <script src="~/Newassets/js/now-ui-dashboard.js?v=1.4.1" type="text/javascript"></script>

    <script>
        $(document).ready(function () {
            var location = window.location.href;
            $('ul li  a').removeClass("active-menu");
            var loopvalue = $("ul li a").length;
            for (var i = 0; i < loopvalue; i++) {
                if ($("ul li a")[i].getAttribute("href") != null && $("ul li a")[i].getAttribute("href") != "#" && $("ul li a")[i].getAttribute("href").toUpperCase() == "/" + location.split("/")[3].toUpperCase() + "/" + (location.split("/")[4] != null ? location.split("/")[4].toUpperCase().split("?")[0] : "")) {
                    if ($('ul li a')[i].getAttribute("class") != null && $('ul li a')[i].getAttribute("class") == "admin-submenu") {
                        $('.dropmenu label.admin-active').addClass("active-menu");
                        $('.dropmenu label.admin-active').append('<span class="shape1"></span><span class="shape2"></span>');
                        $('.dropmenu label.interviewer-active').removeClass("active-menu");
                        $('.drop-wrap ul li a').removeClass("active-menu");
                    }
                    if ($('ul li a')[i].getAttribute("class") != null && $('ul li a')[i].getAttribute("class") == "interviewer-submenu") {
                        $('.dropmenu label.interviewer-active').addClass("active-menu");
                        $('.dropmenu label.interviewer-active').append('<span class="shape1"></span><span class="shape2"></span>');
                        $('.dropmenu label.admin-active').removeClass("active-menu");
                        $('.drop-wrap ul li a').removeClass("active-menu");
                    }
                    $("ul li a")[i].setAttribute("class", "active-menu");
                    $('.drop-wrap ul li  a').removeClass("active-menu");
                    $('ul li a.active-menu').append('<span class="shape1"></span><span class="shape2"></span>');
                    break;
                }
            }
        });
    </script>


