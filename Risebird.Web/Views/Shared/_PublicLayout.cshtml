<script>

    $(document).ready(function () {
        // Show hide popover
        $(".user").click(function () {
            $(this).find(".menu-container").fadeToggle("slow");
        });
    });
    $(document).on("click", function (event) {
        var $trigger = $(".user");
        if ($trigger !== event.target && !$trigger.has(event.target).length) {
            $(".menu-container").slideUp("fast");
        }
    });

</script>
