@if (@HttpContextAccessor.HttpContext.Session.GetString("profileName") != null)
{
    var profileName = HttpContextAccessor.HttpContext.Session.GetString("profileName");
    profileName = profileName.Trim('"');
    @if (profileName != "Admin")
    {
        <script>
            var closeStatusList = document.getElementById("supportModalPopUp");
            closeStatusList.onclick = function () {
                var modal = document.getElementById("supportModal");
                modal.style.display = "none";
            }
            var closeStatusmailList = document.getElementById("supportmailModalPopUp");
            closeStatusmailList.onclick = function () {
                var modal = document.getElementById("supportmailModal");
                modal.style.display = "none";
            }
            function GetSupportModal() {
                $.ajax({
                    url: '/Support/SuportIndex',
                    success: function (data) {
                        var modal = document.getElementById("supportModal");
                        modal.style.display = "block";
                        $('#supportTableBody').html('');
                        $('#supportTableBody').html(data);
                    }
                });
            }
            function GetSupportmailModal() {
                var modal = document.getElementById("supportmailModal");
                modal.style.display = "block";
                $("#txtsupportmailTo").val('');
                $("#txtsupportmailSubject").val('');
                $("#txtsupportmailBody").val('');
            }

            function SendSupportMail() {
                var To = $("#txtsupportmailTo").val();
                var Subject = $("#txtsupportmailSubject").val();
                var Body = $("#txtsupportmailBody").val();
                if (To.trim() != '' && Subject.trim() != '' && Body.trim() != '') {
                    $.ajax({
                        url: '/Mail/SuportMail',
                        type: 'POST',
                        data: { To: To, Subject: Subject, Body: Body },
                        success: function (data) {
                            if (data == "Success") {
                                swal.fire({
                                    title: 'Risebird Notification', text: 'Mail sent successfully', type: 'success',
                                    showConfirmButton: true
                                });
                                var modal = document.getElementById("supportmailModal");
                                modal.style.display = "none";
                            } else {
                                swal.fire({
                                    title: 'Risebird Notification', text: 'Fail to send the email, please try again.', showConfirmButton: true
                                });
                            }
                        }
                    });
                } else {
                    swal.fire("All fields are required fields");
                }
            }

        </script>
    }
}

