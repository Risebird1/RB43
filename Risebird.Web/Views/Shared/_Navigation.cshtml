@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.Data
@using Microsoft.AspNetCore.Http
@using System.Security.Principal
@inject IHttpContextAccessor HttpContextAccessor
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">


@if (String.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("Currenttheme")))
{

    <link rel="stylesheet" type="text/css" id="theme" href="~/Newassets/css/dark-theme.css" />
}
else
{

    <link rel="stylesheet" type="text/css" id="theme" href="@HttpContextAccessor.HttpContext.Session.GetString("Currenttheme")" />

}


<div class="sidebar" data-color="blue">
    <!--
        Tip 1: You can change the color of the sidebar using: data-color="blue | green | orange | red | yellow"
    -->
    <div class="logo">
        <a href="#" class="simple-text logo-mini">

            <img style="position:relative;top:10px;height:24px;" src="~/img/favicon-32x32.png" />
        </a>
        <a href="#" class="simple-text logo-normal">
            <img class="logoimage" src="https://risebirdportal.blob.core.windows.net/logo/risebird.ico" style="width: 50%; padding-top:20px;  ">
        </a>
        <div class="navbar-minimize">
            <button id="minimizeSidebar" class="btn btn-simple btn-icon btn-neutral btn-round">
                <i class="now-ui-icons text_align-center visible-on-sidebar-regular"></i>
                <i class="now-ui-icons design_bullet-list-67 visible-on-sidebar-mini"></i>
            </button>
        </div>
    </div>
    <div class="sidebar-wrapper " id="sidebar-wrapper">
        <div class="user">
            <div class="photo">
                <img src="~/img/man.png" />
            </div>
            <div class="info">
                <a data-toggle="collapse" href="#collapseExample" class="collapsed" id="header">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (@HttpContextAccessor.HttpContext.Session.GetString("email") != null)
                        {
                            var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
                            var email = emailid.Trim('"');
                            <span>
                                @email

                                <b class="caret"></b>
                            </span>

                        }
                        else
                        {
                            <span>
                                "Logged In User";
                                <b class="caret"></b>
                            </span>
                        }
                    }

                </a>
                <div class="clearfix"></div>
                <div class="collapse" id="collapseExample">
                    <ul class="nav">

                        <li><a asp-area="" asp-controller="Session" asp-action="SignOut">Sign out</a></li>
                    </ul>

                </div>
            </div>
        </div>


        <ul class="nav" id="content">
            @if (JsonConvert.DeserializeObject<List<Menu>>(@HttpContextAccessor.HttpContext.Session.GetString("userMenus")) != null)
            {
                var menuList = JsonConvert.DeserializeObject<List<Menu>>(HttpContextAccessor.HttpContext.Session.GetString("userMenus"));
                var adminMenuList = menuList.Where(a => a.idParentFunction == 6).ToList();
                var menuList1 = menuList.Where(a => a.idParentFunction != 6).ToList();
                foreach (var m in menuList1)
                {
                    if (!string.IsNullOrEmpty(m.sUrl))
                    {
                        if (m.sUrl == "/IRF/Index")
                        {
                            <li class="skillchannelmenu">
                                <a href="@m.sUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z" /></svg>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Dashboard/Index")
                        {
                            <li class="Dashboardmenu">
                                <a href="@m.sUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" /></svg>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Dashboard/ClientIndex")
                        {
                            <li class="Dashboardmenu">
                                <a href="@m.sUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" /></svg>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Project/Index")
