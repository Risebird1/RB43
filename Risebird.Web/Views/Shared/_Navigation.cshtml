<div class="sidebar" data-color="orange">
    <!--
        Tip 1: You can change the color of the sidebar using: data-color="blue | green | orange | red | yellow"
    -->
    <div class="logo">
        <a href="#" class="simple-text logo-mini">
            Rb
        </a>
        <a href="#" class="simple-text logo-normal">
            Risebird
        </a>
        <div class="navbar-minimize">
            <button id="minimizeSidebar" class="btn btn-simple btn-icon btn-neutral btn-round">
                <i class="now-ui-icons text_align-center visible-on-sidebar-regular"></i>
                <i class="now-ui-icons design_bullet-list-67 visible-on-sidebar-mini"></i>
            </button>
        </div>
    </div>
    <div class="sidebar-wrapper" id="sidebar-wrapper">
        <div class="user">
            <div class="photo">
                <img src="~/Newassets/img/Ankit mehta.jpg" />
            </div>
            <div class="info">
                <a data-toggle="collapse" href="#collapseExample" class="collapsed">
                    <span>
                        Ankit Mehta
                        <b class="caret"></b>
                    </span>
                </a>
                <div class="clearfix"></div>
                <div class="collapse" id="collapseExample">
                    <ul class="nav">
                        <li>
                            <a href="#">
                                <span class="sidebar-mini-icon">MP</span>
                                <span class="sidebar-normal">My Profile</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <span class="sidebar-mini-icon">EP</span>
                                <span class="sidebar-normal">Edit Profile</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <span class="sidebar-mini-icon">S</span>
                                <span class="sidebar-normal">Settings</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>


        <ul class="nav">
            @if (JsonConvert.DeserializeObject<List<Menu>>(@HttpContextAccessor.HttpContext.Session.GetString("userMenus")) != null)
            {
                var menuList = JsonConvert.DeserializeObject<List<Menu>>(HttpContextAccessor.HttpContext.Session.GetString("userMenus"));
                var adminMenuList = menuList.Where(a => a.idParentFunction == 6).ToList();
                var menuList1 = menuList.Where(a => a.idParentFunction != 6).ToList();
                foreach (var m in menuList1)
                {
                    if (!string.IsNullOrEmpty(m.sUrl))
                    {
                    <li>
                        <a href="@m.sUrl">
                            <i class="now-ui-icons @m.sIcon"></i>
                            <p>@m.functionName</p>
                        </a>
                    </li>
                    }
                    else
                    {
                    <li>
                        <a data-toggle="collapse" href="#@m.functionName">
                            <i class="now-ui-icons @m.sIcon"></i>
                            <p>
                                @m.functionName
                                <b class="caret"></b>
                            </p>
                        </a>
                        <div class="collapse " id="@m.functionName">
                            <ul class="nav">
                                @foreach (var item in adminMenuList)
                                {
                                    <li>
                                        <a href="@item.sUrl">
                                            <span class="sidebar-mini-icon">  @(new string(item.functionName.ToString().Split(' ').Select(x => x[0]).ToArray()))</span>
                                            <span class="sidebar-normal">     @item.functionName </span>
                                        </a>
                                    </li>
                                }

                            </ul>
                        </div>
                    </li>
