@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.Data
@using Microsoft.AspNetCore.Http
@using System.Security.Principal
@inject IHttpContextAccessor HttpContextAccessor

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div class="sidebar" data-color="blue">
    <!--
        Tip 1: You can change the color of the sidebar using: data-color="blue | green | orange | red | yellow"
    -->
    <div class="logo">
        <a href="#" class="simple-text logo-mini">
            Rb
        </a>
        <a href="#" class="simple-text logo-normal" >
            Risebird
        </a>
        <div class="navbar-minimize">
            <button id="minimizeSidebar" class="btn btn-simple btn-icon btn-neutral btn-round">
                <i class="now-ui-icons text_align-center visible-on-sidebar-regular"></i>
                <i class="now-ui-icons design_bullet-list-67 visible-on-sidebar-mini"></i>
            </button>
        </div>
    </div>
    <div class="sidebar-wrapper " id="sidebar-wrapper">
        <div class="user">
            <div class="photo">
                <img src="~/img/man.png" />
            </div>
            <div class="info">
                <a data-toggle="collapse" href="#collapseExample" class="collapsed" id="header">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (@HttpContextAccessor.HttpContext.Session.GetString("email") != null)
                        {
                            var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
                            var email = emailid.Trim('"');
                    <span>
                        @email

                        <b class="caret"></b>
                    </span>

                        }
                        else
                        {
                            <span>
                                "Logged In User";
                                <b class="caret"></b>
                            </span>                            
                        }
                    }
                    
                </a>
                <div class="clearfix"></div>
                <div class="collapse" id="collapseExample">
                    <ul class="nav">
                     
                        <li><a asp-area="" asp-controller="Session" asp-action="SignOut">Sign out</a></li>
                    </ul>
                        @*<ul class="nav">
                            <li>
                                <a href="#">
                                    <span class="sidebar-mini-icon">MP</span>
                                    <span class="sidebar-normal">My Profile</span>
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <span class="sidebar-mini-icon">EP</span>
                                    <span class="sidebar-normal">Edit Profile</span>
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <span class="sidebar-mini-icon">S</span>
                                    <span class="sidebar-normal">Settings</span>
                                </a>
                            </li>
                        </ul>*@
                    </div>
            </div>
        </div>


        <ul class="nav" id="content">
            @if (JsonConvert.DeserializeObject<List<Menu>>(@HttpContextAccessor.HttpContext.Session.GetString("userMenus")) != null)
            {
                var menuList = JsonConvert.DeserializeObject<List<Menu>>(HttpContextAccessor.HttpContext.Session.GetString("userMenus"));
                var adminMenuList = menuList.Where(a => a.idParentFunction == 6).ToList();
                var menuList1 = menuList.Where(a => a.idParentFunction != 6).ToList();
                foreach (var m in menuList1)
                {
                    if (!string.IsNullOrEmpty(m.sUrl))
                    {
                        if (m.sUrl == "/IRF/Index")
                        {
                            <li class="skillchannelmenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/RiseTube/Index")
                        {
                            <li class="risetubemenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/RiseTube/VideoPage")
                        {
                            <li class="disabled risetubemenu" style="cursor: not-allowed;">
                                <a href="@m.sUrl" style="pointer-events: none;">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Support/Index")
                        {
                            <li class="supportmenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/AllPriorityClientMeetings")
                        {
                            <li class="iacm">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/SelectedPriorityClientMeetings")
                        {
                            <li class="iscm">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/CandidateInterviews")
                        {
                            <li class="icimenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/MyInterview")
                        {
                            <li class="myint">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/OpenInterview")
                        {
                            <li class="inoi">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/MyQualityControlledInterviews")
                        {
                            <li class="inmqci">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Mail/Mail")
                        {
                            <li class="mailmenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/QCOpenInterviews")
                        {
                            <li class="iqcomenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li>
                            <a data-toggle="collapse" href="#@m.functionName">
                                <i class="now-ui-icons @m.sIcon"></i>
                                <p>
                                    @m.functionName
                                    <b class="caret"></b>
                                </p>
                            </a>
                            <div class="collapse " id="@m.functionName">
                                <ul class="nav">
                                    @foreach (var item in adminMenuList)
                                    {
                                        <li>
                                            <a href="@item.sUrl">
                                                <span class="sidebar-mini-icon">  @(new string(item.functionName.ToString().Split(' ').Select(x => x[0]).ToArray()))</span>
                                                <span class="sidebar-normal">     @item.functionName </span>
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </li>

                    }

                }
            }
        </ul>
    </div>
</div>