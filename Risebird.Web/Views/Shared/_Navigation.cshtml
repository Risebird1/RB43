<script>
        $(document).ready(function () {

        $('.sidebar-mini .sidebar').hover(function () {
            $('.logo-mini img').attr("src", "https://risebirdportal.blob.core.windows.net/logo/risebird.png");
        }, function(){
                if ($('#logo-img').val() == "") {
           $('.logo-mini img').attr("src", "https://risebirdportal.blob.core.windows.net/logo/risebird.png");
           }
                else {
                    $('.logo-mini img').attr("src", "@HttpContextAccessor.HttpContext.Session.GetString("Logo")");

                }
    });

    });

</script>
<div class="sidebar" data-color="blue">
    <!--
        Tip 1: You can change the color of the sidebar using: data-color="blue | green | orange | red | yellow"
    -->
    <input id="logo-img" type="hidden" value="@HttpContextAccessor.HttpContext.Session.GetString("Logo")"/>
    <div class="logo">
        <a href="#" class="simple-text logo-mini">

            @if (String.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("Logo")))
            {
                <img style="position:relative;top:0px;" src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" />}
            else
            { <img style="position:relative;top:0px;" src="@HttpContextAccessor.HttpContext.Session.GetString("Logo")" />}

        </a>
        <a href="#" class="simple-text logo-normal">

            @if (String.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("Logo")))
            {
                <img class="logoimage" style=" width: 75%; padding-top: 3px;" src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" />}
            else
            { <img class="logoimage" style=" width: 75%; padding-top: 3px;" src="@HttpContextAccessor.HttpContext.Session.GetString("Logo")" />}



        </a>
