                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/MyQualityControlledInterviews")
                        {
                            <li class="inmqci">
                                <a href="@m.sUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Mail/Mail")
                        {
                            <li class="mailmenu">
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interviewer/MyProfile")
                        {
                            <li class="myinterviewermenu">
                                <a href="@m.sUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 18 18"><path d="M9 8c1.66 0 2.99-1.34 2.99-3S10.66 2 9 2C7.34 2 6 3.34 6 5s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else if (m.sUrl == "/Interview/QCOpenInterviews")
                        {
                            <li class="iqcomenu">
                                <a href="@m.sUrl">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" /></svg>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@m.sUrl">
                                    <i class="now-ui-icons @m.sIcon"></i>
                                    <p>@m.functionName</p>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li>
                            <a data-toggle="collapse" href="#@m.functionName">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 18 18"><path d="M9 8c1.66 0 2.99-1.34 2.99-3S10.66 2 9 2C7.34 2 6 3.34 6 5s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg>
                                <p>
                                    @m.functionName
                                    <b class="caret"></b>
                                </p>
                            </a>
                            <div class="collapse " id="@m.functionName">
                                <ul class="nav">
                                    @foreach (var item in adminMenuList)
                                    {
                                        <li>
                                            <a href="@item.sUrl">
                                                <span class="sidebar-mini-icon">  @(new string(item.functionName.ToString().Split(' ').Select(x => x[0]).ToArray()))</span>
                                                <span class="sidebar-normal">     @item.functionName </span>
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </div>
                        </li>

                    }

                }
            }
        </ul>
    </div>
</div>
