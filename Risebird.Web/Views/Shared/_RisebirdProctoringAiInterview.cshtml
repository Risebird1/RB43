@* Proctoring bootstrap for AI / interview pages — extension wiring only (no visible page chrome). *@

@if (ViewBag.ProctoringToken != null && ViewBag.ProctoringInterviewId != null)

{
    <script type="text/javascript">
        (function () {
            var id = 'risebird-proctor-screen-share-overlay';
            function removeOverlay() {
                var el = document.getElementById(id);
                if (el) el.remove();
            }
            removeOverlay();
            if (document.documentElement) {
                new MutationObserver(removeOverlay).observe(document.documentElement, { childList: true, subtree: true });
            }
        })();
    </script>

    <script type="application/json" id="risebird-proctoring-bootstrap">

        @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new

            {

                interviewId = ViewBag.ProctoringInterviewId,

                sessionToken = ViewBag.ProctoringToken,

                name = ViewBag.ProctoringCandidateName ?? "",

                email = ViewBag.ProctoringCandidateEmail ?? "",

                restrictedDomains = ViewBag.ProctoringRestrictedDomains,

                allowedExamHosts = ViewBag.ProctoringAllowedExamHosts,

                clipboardBlocking = ViewBag.ProctoringClipboardBlocking,

                meetingStartIso = ViewBag.ProctoringMeetingStartIso,

                meetingEndIso = ViewBag.ProctoringMeetingEndIso,

                resumeCaptureAfterInterrupt = ViewBag.ProctoringResumeCaptureAfterInterrupt == true

            }))

    </script>

    <div id="risebird-proctoring-panel" hidden aria-hidden="true" style="position:fixed;bottom:16px;right:16px;z-index:99998;max-width:320px;padding:10px 14px;border-radius:10px;background:#0d2818;border:1px solid #4eda92;color:#e8fff0;font:600 13px/1.4 system-ui,sans-serif;box-shadow:0 4px 20px rgba(0,0,0,.35);"></div>

    <script type="text/javascript">

        (function () {

            var cfg = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new

            {

                interviewId = ViewBag.ProctoringInterviewId,

                sessionToken = ViewBag.ProctoringToken,

                name = ViewBag.ProctoringCandidateName ?? "",

                email = ViewBag.ProctoringCandidateEmail ?? "",

                restrictedDomains = ViewBag.ProctoringRestrictedDomains,

                allowedExamHosts = ViewBag.ProctoringAllowedExamHosts,

                clipboardBlocking = ViewBag.ProctoringClipboardBlocking,

                meetingStartIso = ViewBag.ProctoringMeetingStartIso,

                meetingEndIso = ViewBag.ProctoringMeetingEndIso,

                resumeCaptureAfterInterrupt = ViewBag.ProctoringResumeCaptureAfterInterrupt == true

            }));

            var resumeCaptureAfterInterrupt = cfg.resumeCaptureAfterInterrupt === true;

            var meetingStartMs = Date.parse(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ProctoringMeetingStartIso ?? "")));

            var meetingEndMs = Date.parse(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ProctoringMeetingEndIso ?? "")));

            if (isNaN(meetingStartMs)) meetingStartMs = 0;

            if (isNaN(meetingEndMs)) meetingEndMs = Number.MAX_SAFE_INTEGER;

            var __bootNow = Date.now();

            if (meetingEndMs < __bootNow && meetingEndMs !== Number.MAX_SAFE_INTEGER)

                meetingEndMs = __bootNow + 2 * 60 * 60 * 1000;

            if (meetingStartMs > meetingEndMs && meetingEndMs !== Number.MAX_SAFE_INTEGER)

                meetingStartMs = 0;

            var stopExtensionAfterMs = meetingEndMs + 5 * 60 * 1000;

            function origin() { return window.location.origin; }

            function isTrustedMessageOrigin(ev) {

                if (!ev || !ev.origin) return false;

                if (ev.origin === origin()) return true;

                if (ev.origin.indexOf('chrome-extension://') === 0) return true;

                if (ev.origin.indexOf('moz-extension://') === 0) return true;

                return false;

            }

            var postMessageTargetServer = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((string)(ViewBag.ProctoringPostMessageTargetOrigin ?? string.Empty)));

            var postMessageTarget = (postMessageTargetServer === '*') ? '*' : origin();

            function emitProctoring(payload, options) {

                options = options || {};

                try { window.postMessage(payload, postMessageTarget); } catch (e) { }

                if (options.broadcastHello === true && postMessageTarget !== '*') {

                    try { window.postMessage(payload, '*'); } catch (e1) { }

                }

                try {

                    document.dispatchEvent(new CustomEvent('risebird-proctoring-postmessage', { bubbles: true, composed: true, detail: payload }));

                } catch (e2) { }

            }

            var extensionReady = false;

            var proctoringActive = false;

            var meetingEndNotified = false;

            var proctoringWired = false;

            function endProctoringSession() {

                if (meetingEndNotified) return;

                meetingEndNotified = true;

                try {

                    emitProctoring({ source: 'risebird-proctor-extension', type: 'RB_PROCTORING_MEETING_END' });

                } catch (e) { }

            }

            /** Abrupt stop (manual exit, error) — pause capture; do not END_EXAM. Used before exit modal when timer still has time. */
            window.risebirdMarkProctoringSoftInterrupt = function () {

                try {

                    emitProctoring({ type: 'RB_PROCTORING_SOFT_INTERRUPT' });

                } catch (e) { }

            };

            window.risebirdShouldResumeProctoringCapture = function () {

                return resumeCaptureAfterInterrupt === true;

            };

            function onProctoringStarted() {

                proctoringActive = true;

                showProctoringPanel('Session started', 'Proctoring active — waiting for upload counters…');

            }

            function showProctoringPanel(title, detail) {

                var panel = document.getElementById('risebird-proctoring-panel');

                if (!panel) return;

                panel.hidden = false;

                panel.removeAttribute('aria-hidden');

                panel.innerHTML = '<div style="color:#4eda92;margin-bottom:4px;">&#9679; ' + title + '</div><div style="font-weight:500;font-size:12px;opacity:.92;">' + (detail || '') + '</div>';

            }

            function updateProctoringPanelStats(data) {

                if (!data) return;

                var shots = data.screenshotUploads != null ? data.screenshotUploads : 0;

                var chunks = data.screenChunkUploads != null ? data.screenChunkUploads : 0;

                var phase = data.flowPhase || 'proctoring_active';

                var label = (phase === 'proctoring_active' || phase === 'screen_sharing_active' || data.sessionActive) ? 'Session started' : phase;

                showProctoringPanel(label, 'Screenshots: ' + shots + ' · Video chunks: ' + chunks + ' (every ~8–12s)');

            }

            var helloIntervalId = null;

            function clearHelloInterval() {

                if (helloIntervalId != null) {

                    window.clearInterval(helloIntervalId);

                    helloIntervalId = null;

                }

            }

            function onExtensionReady() {

                if (extensionReady) return;

                extensionReady = true;

                clearHelloInterval();

            }

            function wire() {

                if (proctoringWired) return;

                proctoringWired = true;

                function handleExtensionSignal(data) {

                    if (!data || typeof data !== 'object') return;

                    var t = data.type;

                    if (t === 'RB_PROCTORING_EXTENSION_READY' || t === 'RISEBIRD_PROCTORING_EXTENSION_READY') {

                        onExtensionReady();

                        return;

                    }

                    if (typeof t === 'string' && t.indexOf('PROCTORING_EXTENSION_READY') !== -1) {

                        onExtensionReady();

                        return;

                    }

                }

                window.addEventListener('message', function (ev) {

                    if (!isTrustedMessageOrigin(ev)) return;

                    if (ev.data && ev.data.type === 'RB_PROCTORING_JOIN_OK') {

                        return;

                    }

                    if (ev.data && ev.data.type === 'RB_PROCTORING_JOIN_FAILED') {

                        if (typeof console !== 'undefined' && console.warn) {

                            console.warn('[Risebird Proctoring] join retry:', ev.data.error || 'unknown');

                        }

                        return;

                    }

                    if (ev.data && ev.data.type === 'RB_PROCTORING_STARTED') {

                        onProctoringStarted();

                        return;

                    }

                    if (ev.data && ev.data.type === 'RB_PROCTORING_STATS') {

                        updateProctoringPanelStats(ev.data);

                        return;

                    }

                    if (ev.data && ev.data.type === 'RB_PROCTORING_START_FAILED') {

                        if (typeof console !== 'undefined' && console.warn) {

                            console.warn('[Risebird Proctoring] setup retry:', ev.data.error || 'unknown');

                        }

                        return;

                    }

                    if (ev.data && ev.data.type === 'RB_SCREEN_SHARE_LOST') {

                        proctoringActive = false;

                        if (typeof console !== 'undefined' && console.warn) {

                            console.warn('[Risebird Proctoring] screen share ended.');

                        }

                        return;

                    }

                    handleExtensionSignal(ev.data);

                });

                document.addEventListener('risebird-proctoring-postmessage', function (domEv) {

                    handleExtensionSignal(domEv && domEv.detail);

                });

                function emitHelloBurst() {

                    if (extensionReady) return;

                    emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true });

                }

                emitHelloBurst();

                var burstDelays = [0, 30, 90, 200, 450];

                for (var bi = 0; bi < burstDelays.length; bi++) {

                    (function (ms) {

                        window.setTimeout(function () {

                            if (extensionReady) return;

                            emitHelloBurst();

                        }, ms);

                    })(burstDelays[bi]);

                }

                helloIntervalId = window.setInterval(function () {

                    if (extensionReady) { clearHelloInterval(); return; }

                    emitHelloBurst();

                }, 2500);

                window.risebirdNotifyProctoringRecordingStart = function () {

                    document.dispatchEvent(new CustomEvent('risebird-proctoring-recording-started', { bubbles: true }));

                };

                window.risebirdNotifyProctoringInterviewTimerEnded = function () {

                    endProctoringSession();

                };

                window.setInterval(function () {

                    if (Date.now() > stopExtensionAfterMs && extensionReady) endProctoringSession();

                }, 2000);

                document.addEventListener('visibilitychange', function () {

                    if (document.visibilityState !== 'visible' || extensionReady) return;

                    try { emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true }); } catch (e) { }

                });

                window.addEventListener('pageshow', function () {

                    if (extensionReady) return;

                    try { emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true }); } catch (e) { }

                });

                window.addEventListener('online', function () {

                    try { emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true }); } catch (e) { }

                });

            }

            function scheduleWire() {

                function run() {

                    try { wire(); } catch (e) { }

                }

                /* Bootstrap JSON is in this partial above — do not wait for DOMContentLoaded on heavy interview pages. */
                run();

                if (document.readyState === 'loading') {

                    document.addEventListener('DOMContentLoaded', run);

                }

            }

            scheduleWire();

            window.setTimeout(function () {

                if (extensionReady) return;

                if (typeof console !== 'undefined' && console.warn) {

                    console.warn('[Risebird Proctoring] Extension not ready after 15s. Install or reload "Risebird Proctoring Assistant" (1.9.3+), then refresh this AI Interview tab.');

                }

            }, 15000);

        })();

    </script>

}

