@* Proctoring bootstrap for AI / interview pages — extension wiring only (no visible page chrome). *@
@if (ViewBag.ProctoringToken != null && ViewBag.ProctoringInterviewId != null)
{
    <script type="application/json" id="risebird-proctoring-bootstrap">
@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new {
            interviewId = ViewBag.ProctoringInterviewId,
            sessionId = ViewBag.ProctoringSessionId ?? "",
            sessionToken = ViewBag.ProctoringToken,
            name = ViewBag.ProctoringCandidateName ?? "",
            email = ViewBag.ProctoringCandidateEmail ?? "",
            backendUrl = ViewBag.ProctoringBackendBaseUrl ?? "",
            restrictedDomains = ViewBag.ProctoringRestrictedDomains,
            allowedExamHosts = ViewBag.ProctoringAllowedExamHosts,
            clipboardBlocking = ViewBag.ProctoringClipboardBlocking,
            meetingStartIso = ViewBag.ProctoringMeetingStartIso,
            meetingEndIso = ViewBag.ProctoringMeetingEndIso
        }))
    </script>
    <div id="risebird-proctoring-panel" hidden aria-hidden="true"></div>
    <script type="text/javascript">
        (function () {
            var cfg = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new {
                interviewId = ViewBag.ProctoringInterviewId,
                sessionId = ViewBag.ProctoringSessionId ?? "",
                sessionToken = ViewBag.ProctoringToken,
                name = ViewBag.ProctoringCandidateName ?? "",
                email = ViewBag.ProctoringCandidateEmail ?? "",
                backendUrl = ViewBag.ProctoringBackendBaseUrl ?? "",
                restrictedDomains = ViewBag.ProctoringRestrictedDomains,
                allowedExamHosts = ViewBag.ProctoringAllowedExamHosts,
                clipboardBlocking = ViewBag.ProctoringClipboardBlocking
            }));
            var bootstrapSid = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((string)(ViewBag.ProctoringSessionId ?? string.Empty)));
            var bootstrapApiUrl = '/AIInterview/GetProctoringBootstrap?sid=' + encodeURIComponent(bootstrapSid || '');
            var meetingStartMs = Date.parse(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ProctoringMeetingStartIso ?? "")));
            var meetingEndMs = Date.parse(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ProctoringMeetingEndIso ?? "")));
            if (isNaN(meetingStartMs)) meetingStartMs = 0;
            if (isNaN(meetingEndMs)) meetingEndMs = Number.MAX_SAFE_INTEGER;
            var __bootNow = Date.now();
            // DB interview window often ends before "take interview now"; stale end blocks RB_COMPLETE_TEST_SETUP forever.
            if (meetingEndMs < __bootNow && meetingEndMs !== Number.MAX_SAFE_INTEGER)
                meetingEndMs = __bootNow + 2 * 60 * 60 * 1000;
            if (meetingStartMs > meetingEndMs && meetingEndMs !== Number.MAX_SAFE_INTEGER)
                meetingStartMs = 0;
            var stopExtensionAfterMs = meetingEndMs + 5 * 60 * 1000;
            function origin() { return window.location.origin; }
            function isTrustedMessageOrigin(ev) {
                if (!ev || !ev.origin) return false;
                if (ev.origin === origin()) return true;
                // Extension background / content scripts often send with chrome-extension:// origin.
                if (ev.origin.indexOf('chrome-extension://') === 0) return true;
                if (ev.origin.indexOf('moz-extension://') === 0) return true;
                return false;
            }
            // postMessage second arg must match this document's origin or '*', or the browser drops the event (extension never sees HELLO/JOIN).
            // Server-computed origin can differ from window.location.origin behind proxies / alternate hostnames.
            var postMessageTargetServer = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((string)(ViewBag.ProctoringPostMessageTargetOrigin ?? string.Empty)));
            var postMessageTarget = (postMessageTargetServer === '*') ? '*' : origin();
            // options.broadcastHello: duplicate HELLO via postMessage(..., '*') for older extension builds; never use for JOIN.
            function emitProctoring(payload, options) {
                options = options || {};
                try { window.postMessage(payload, postMessageTarget); } catch (e) { }
                if (options.broadcastHello === true && postMessageTarget !== '*') {
                    try { window.postMessage(payload, '*'); } catch (e1) { }
                }
                try {
                    document.dispatchEvent(new CustomEvent('risebird-proctoring-postmessage', { bubbles: true, composed: true, detail: payload }));
                } catch (e2) { }
            }
            var joinSent = false;
            var monitoringStarted = false;
            var meetingEndNotified = false;
            var proctoringWired = false;
            var proctorSessionKey = 'rb-proctoring-' + (cfg.sessionId || cfg.interviewId || 'default');
            var priorSetupDone = false;
            var priorJoinDone = false;
            try {
                priorSetupDone = window.sessionStorage.getItem(proctorSessionKey + '-setup-done') === '1';
                priorJoinDone = window.sessionStorage.getItem(proctorSessionKey + '-join-done') === '1';
            } catch (e) { }
            var modalHost = null;
            var modalStatusEl = null;
            var modalSubStatusEl = null;
            function ensureProctoringModal() {
                if (modalHost) return;
                modalHost = document.createElement('div');
                modalHost.id = 'risebird-proctoring-startup-modal';
                modalHost.style.position = 'fixed';
                modalHost.style.inset = '0';
                modalHost.style.background = 'rgba(0, 0, 0, 0.55)';
                modalHost.style.zIndex = '99999';
                modalHost.style.display = 'none';
                modalHost.style.alignItems = 'center';
                modalHost.style.justifyContent = 'center';
                modalHost.innerHTML = ''
                    + '<div style="width: min(500px, 92vw); background: #fff; border-radius: 10px; box-shadow: 0 10px 35px rgba(0,0,0,.25);">'
                    + '  <div style="padding: 16px 18px; border-bottom: 1px solid #ececec;">'
                    + '    <h3 style="margin: 0; font-size: 18px; color: #111827;">Proctoring Setup</h3>'
                    + '  </div>'
                    + '  <div style="padding: 16px 18px;">'
                    + '    <p id="risebird-proctoring-modal-status" style="margin: 0; font-size: 14px; color: #111827;"></p>'
                    + '    <p id="risebird-proctoring-modal-substatus" style="margin: 8px 0 0; font-size: 12px; color: #4b5563;"></p>'
                    + '  </div>'
                    + '</div>';
                document.body.appendChild(modalHost);
                modalStatusEl = document.getElementById('risebird-proctoring-modal-status');
                modalSubStatusEl = document.getElementById('risebird-proctoring-modal-substatus');
            }
            function showProctoringModal(statusText, subText) {
                ensureProctoringModal();
                if (modalStatusEl) modalStatusEl.textContent = statusText || 'Initializing proctoring...';
                if (modalSubStatusEl) modalSubStatusEl.textContent = subText || '';
                modalHost.style.display = 'flex';
            }
            function hideProctoringModal() {
                if (!modalHost) return;
                modalHost.style.display = 'none';
            }
            async function fetchBootstrapFromBackend() {
                if (!bootstrapSid) return;
                try {
                    var res = await fetch(bootstrapApiUrl, { method: 'GET', credentials: 'same-origin' });
                    if (!res.ok) return;
                    var json = await res.json();
                    if (!json || json.ok !== true || !json.payload) return;
                    cfg.interviewId = json.payload.interviewId || cfg.interviewId;
                    cfg.sessionId = json.payload.sessionId || cfg.sessionId;
                    cfg.sessionToken = json.payload.sessionToken || cfg.sessionToken;
                    cfg.name = json.payload.candidateName || cfg.name;
                    cfg.email = json.payload.candidateEmail || cfg.email;
                    cfg.backendUrl = json.payload.backendUrl || cfg.backendUrl;
                    cfg.restrictedDomains = json.payload.restrictedDomains || cfg.restrictedDomains;
                    cfg.allowedExamHosts = json.payload.allowedExamHosts || cfg.allowedExamHosts;
                    if (typeof json.payload.clipboardBlocking !== 'undefined') cfg.clipboardBlocking = json.payload.clipboardBlocking;
                } catch (e) {
                    // Fallback to server-rendered cfg.
                }
            }
            function endProctoringSession() {
                if (meetingEndNotified) return;
                meetingEndNotified = true;
                try {
                    emitProctoring({ source: 'risebird-proctor-extension', type: 'RB_PROCTORING_MEETING_END' });
                } catch (e) { }
            }
            function tryStartMonitoring(reason) {
                if (monitoringStarted) return;
                if (!joinSent) return;
                if (priorSetupDone) {
                    monitoringStarted = true;
                    return;
                }
                var now = Date.now();
                if (now > meetingEndMs) return;
                var byRecording = reason === 'recording';
                var bySchedule = now >= meetingStartMs;
                // AI interviews often open before DB interviewDate; still start proctoring once extension has joined.
                var byImmediate = reason === 'immediate';
                if (!byRecording && !bySchedule && !byImmediate) return;
                monitoringStarted = true;
                try { window.sessionStorage.setItem(proctorSessionKey + '-setup-done', '1'); priorSetupDone = true; } catch (e3) { }
                emitProctoring({ type: 'RB_COMPLETE_TEST_SETUP' });
            }
            var helloIntervalId = null;
            function clearHelloInterval() {
                if (helloIntervalId != null) {
                    window.clearInterval(helloIntervalId);
                    helloIntervalId = null;
                }
            }
            function onExtensionReady() {
                if (joinSent) return;
                clearHelloInterval();
                joinSent = true;
                emitProctoring({ type: 'RB_PROCTORING_JOIN', payload: cfg });
                try { window.sessionStorage.setItem(proctorSessionKey + '-join-done', '1'); priorJoinDone = true; } catch (e4) { }
                tryStartMonitoring('immediate');
                if (!priorSetupDone) {
                    showProctoringModal('Proctoring started.', 'Your session is now being monitored.');
                    window.setTimeout(hideProctoringModal, 1200);
                } else {
                    hideProctoringModal();
                }
            }
            function wire() {
                if (proctoringWired) return;
                proctoringWired = true;
                if (!priorSetupDone) {
                    showProctoringModal('Starting proctoring...', 'Fetching secure session details and connecting extension.');
                }
                function handleExtensionSignal(data) {
                    if (!data || typeof data !== 'object') return;
                    var t = data.type;
                    if (t === 'RB_PROCTORING_EXTENSION_READY' || t === 'RISEBIRD_PROCTORING_EXTENSION_READY') {
                        onExtensionReady();
                        return;
                    }
                    if (typeof t === 'string' && t.indexOf('PROCTORING_EXTENSION_READY') !== -1) {
                        onExtensionReady();
                        return;
                    }
                }
                window.addEventListener('message', function (ev) {
                    // Do not require ev.source === window: extension content scripts / injected bridges
                    // often dispatch with a different source. Origin may be the page or chrome-extension://.
                    if (!isTrustedMessageOrigin(ev)) return;
                    handleExtensionSignal(ev.data);
                });
                document.addEventListener('risebird-proctoring-postmessage', function (domEv) {
                    handleExtensionSignal(domEv && domEv.detail);
                });
                function emitHelloBurst() {
                    if (joinSent) return;
                    emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true });
                }
                emitHelloBurst();
                var burstDelays = [90, 220, 500, 950, 1600];
                for (var bi = 0; bi < burstDelays.length; bi++) {
                    (function (ms) {
                        window.setTimeout(function () {
                            if (joinSent) return;
                            emitHelloBurst();
                        }, ms);
                    })(burstDelays[bi]);
                }
                helloIntervalId = window.setInterval(function () {
                    if (joinSent) { clearHelloInterval(); return; }
                    emitHelloBurst();
                }, 2500);
                if (postMessageTarget === '*' && typeof console !== 'undefined' && console.info) {
                    console.info('[Risebird Proctoring] postMessage target is * (localhost). Extension manifest must match this page, e.g. http://localhost:*/* and https://localhost:*/*');
                }
                // JOIN immediately so the extension receives candidate + session without waiting for READY or user interaction.
                if (!priorJoinDone) {
                    try { onExtensionReady(); } catch (e0) { }
                    window.setTimeout(function () {
                        if (joinSent || priorSetupDone) return;
                        showProctoringModal(
                            'Waiting for proctoring extension...',
                            'Please keep this tab open. If needed, install/enable the Risebird proctoring extension.'
                        );
                    }, 3500);
                } else {
                    joinSent = true;
                    hideProctoringModal();
                }
                document.addEventListener('risebird-proctoring-recording-started', function () {
                    tryStartMonitoring('recording');
                });
                window.risebirdNotifyProctoringRecordingStart = function () {
                    document.dispatchEvent(new CustomEvent('risebird-proctoring-recording-started', { bubbles: true }));
                };
                window.risebirdNotifyProctoringInterviewTimerEnded = function () {
                    endProctoringSession();
                };
                window.setInterval(function () {
                    tryStartMonitoring('schedule');
                    if (Date.now() > stopExtensionAfterMs && joinSent) endProctoringSession();
                }, 2000);
                function onLeave() {
                    clearHelloInterval();
                    endProctoringSession();
                }
                window.addEventListener('pagehide', onLeave);
                window.addEventListener('beforeunload', onLeave);
                // Tab may open in the background (e.g. after Chrome Web Store); timers and extension injection can be delayed.
                document.addEventListener('visibilitychange', function () {
                    if (document.visibilityState !== 'visible' || joinSent) return;
                    try { emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true }); } catch (e) { }
                });
                window.addEventListener('pageshow', function () {
                    if (joinSent) return;
                    try { emitProctoring({ type: 'RB_PROCTORING_HELLO' }, { broadcastHello: true }); } catch (e) { }
                });
            }
            function scheduleWire() {
                async function run() {
                    if (!priorSetupDone) {
                        showProctoringModal('Starting proctoring...', 'Fetching secure session details and connecting extension.');
                    }
                    await fetchBootstrapFromBackend();
                    try { wire(); } catch (e) { }
                }
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { run(); });
                else run();
            }
            scheduleWire();
        })();
    </script>
}
