@using System.Security.Principal
@inject IHttpContextAccessor HttpContextAccessor
@if (User.Identity.IsAuthenticated)
{
    @if (@HttpContextAccessor.HttpContext.Session.GetString("email") != null)
    {
        var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
   
        <ul class="nav navbar-nav navbar-right">
            <li class="navbar-text">emailid</li>
            <li><a asp-area="" asp-controller="Account" asp-action="SignOut">Sign out</a></li>
        </ul>
    }
     else
     {
         <ul class="nav navbar-nav navbar-right">
             <li class="navbar-text">@User.Identity.Name</li>
             <li><a asp-area="" asp-controller="Account" asp-action="SignOut">Sign out</a></li>
         </ul>
     }
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li><a asp-area="" asp-controller="Account" asp-action="Signin">Sign in</a></li>
    </ul>
}
