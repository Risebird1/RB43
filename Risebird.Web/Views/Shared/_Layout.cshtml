    <style>
        .swal2-popup .swal2-styled {
            box-shadow: none !important
        }

            .swal2-popup .swal2-actions:not(.swal2-loading) .swal2-styled:active, .swal2-popup .swal2-styled.swal2-confirm {
                font-size: 14px !important;
                min-width: 105px;
                height: 40px;
                padding: 0px 20px !important;
                border: 0px !important;
            }

        .sweet-alert h2 {
            margin-bottom: 10px !important;
        }

        .swal2-popup .swal2-content {
            font-size: 1.1em;
        }

        .swal2-popup .swal2-title {
            font-size: 1.8em !important;
            text-transform: capitalize !important;
            font-weight: 400 !important;
        }

        .swal2-icon {
            margin: 0em auto 1em !important;
        }

        .swal2-popup .swal2-styled {
            padding: .425em 1em !important;
        }

            .swal2-popup .swal2-styled.swal2-cancel {
                background-color: rgb(221, 51, 51) !important;
            }

        [data-tooltip]:before {
            background: #908f8f !important;
            color: #fff !important;
            border: 1px #fff solid !important;
        }

        .confirm.btn, .multiselect.btn {
            line-height: normal !important
        }

        .form-control[disabled], .form-control[readonly], select, option {
            font-weight: bold !important;
        }

        .notification {
            position: relative;
            display: inline-block;
        }

            .notification .badge {
                position: absolute;
                top: -8px;
                left: -10px;
                border-radius: 50%;
                background-color: red !important;
                color: white !important;
            }
    </style>
