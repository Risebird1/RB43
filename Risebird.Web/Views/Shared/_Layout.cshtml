@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="76x76" href="~/Newassets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="~/Newassets/img/favicon.png">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewData["Title"] - Risebird</title>
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <!--     Fonts and icons     -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,200" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.1/css/all.css" integrity="sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr" crossorigin="anonymous">
    <!-- CSS Files -->

    <link href="~/Newassets/css/bootstrap.min.css?v=3" rel="stylesheet" />
    <link href="~/Newassets/css/chat.css?v=3" rel="stylesheet" />
    <link href="~/Newassets/css/now-ui-dashboard.css?ver=1.12.4-wp" rel="stylesheet" />
    <link href="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />

    <link href="https://fonts.googleapis.com/css?family=Open+Sans|300italic,400italic,600italic,700italic,400,300,500,600,700&subset=latin,latin-ext" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

    <link href="https:/cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css?v=3" />
 
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css?v=6" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />

    <!-- Start of  Zendesk Widget script -->
    <script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key=e028bcf9-a477-4550-812a-0ec957f2188d"></script>
    <!-- End of  Zendesk Widget script -->
    <script src="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.js"></script>

    <script src="~/Newassets/js/core/jquery.min.js?v=7"></script>
    <script src="~/Newassets/js/core/popper.min.js?v=7"></script>
    <script src="~/Newassets/js/core/bootstrap.min.js?v=7"></script>

    <script src="~/Newassets/js/plugins/perfect-scrollbar.jquery.min.js?v=6"></script>
    <script src="~/Newassets/js/plugins/moment.min.js?v=6"></script>

    <script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js?v=6"></script>
    <script src="~/assets/Validations/jquery.validate.min.js?v=6"></script>
    <script src="~/assets/Validations/jquery.validate.unobtrusive.min.js?v=6"></script>

    <script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js?v=1"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.6.0/Chart.min.js?v=6" type="text/javascript"></script>
    <script src="https://code.jquery.com/jquery-1.11.3.min.js?v=3"></script>
    <script src="~/js/canvasjs.min.js?v=3"></script>
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.js?v=6"></script>
    <script src="https://code.jquery.com/jquery-1.12.4.js?v=6"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js?v=6"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.3/jspdf.min.js?v=6"></script>

    <script type="text/javascript" src="~/js/plugins/mcustomscrollbar/jquery.mCustomScrollbar.js?v=6"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js?v=6" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>

    <style>
        .swal2-popup .swal2-title {
            font-size: 1.3em !important;
        }

        .swal2-popup .swal2-styled {
            padding: .425em 1em !important;
        }

            .swal2-popup .swal2-styled.swal2-cancel {
                background-color: rgb(221, 51, 51) !important;
            }

        [data-tooltip]:before {
            background: #908f8f !important;
            color: #fff !important;
            border: 1px #fff solid !important;
        }
    </style>
</head>
<body class=" sidebar-mini ">

    <audio id="chatAudio" controls="controls" hidden>
        <source src="~/audio/done-for-you.ogg" type="audio/ogg" />
    </audio>



    <div class="wrapper ">
        @Html.AntiForgeryToken()
        <!-- Navigation -->
        @Html.Partial("_Navigation")
        <!-- Navigation end -->

        @RenderBody()
    </div>


    <!--   Core JS Files   -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.13/js/bootstrap-multiselect.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/0.9.13/css/bootstrap-multiselect.css">
    <!--  Plugin for Switches, full documentation here: http://www.jque.re/plugins/version3/bootstrap.switch/ -->
    <script src="~/Newassets/js/plugins/bootstrap-switch.js"></script>
    <!--  Plugin for Sweet Alert -->
    <script src="~/Newassets/js/plugins/sweetalert2.min.js"></script>
    <!-- Forms Validations Plugin -->
    <script src="~/Newassets/js/plugins/jquery.validate.min.js"></script>
    <!--  Plugin for the Wizard, full documentation here: https://github.com/VinceG/twitter-bootstrap-wizard -->
    <script src="~/Newassets/js/plugins/jquery.bootstrap-wizard.js"></script>
    <!--	Plugin for Select, full documentation here: http://silviomoreto.github.io/bootstrap-select -->
    <script src="~/Newassets/js/plugins/bootstrap-selectpicker.js"></script>
    <!--  Plugin for the DateTimePicker, full documentation here: https://eonasdan.github.io/bootstrap-datetimepicker/ -->
    <script src="~/Newassets/js/plugins/bootstrap-datetimepicker.js"></script>
    <!--  DataTables.net Plugin, full documentation here: https://datatables.net/    -->
    <script src="~/Newassets/js/plugins/jquery.dataTables.min.js"></script>
    <script src="~/Newassets/js/plugins/jquery.dataTables.min.js"></script>
    <!--	Plugin for Tags, full documentation here: https://github.com/bootstrap-tagsinput/bootstrap-tagsinputs  -->
    <script src="~/Newassets/js/plugins/bootstrap-tagsinput.js"></script>
    <!-- Plugin for Fileupload, full documentation here: http://www.jasny.net/bootstrap/javascript/#fileinput -->
    <script src="~/Newassets/js/plugins/jasny-bootstrap.min.js"></script>
    <!--  Full Calendar Plugin, full documentation here: https://github.com/fullcalendar/fullcalendar    -->
    <script src="~/Newassets/js/plugins/fullcalendar.min.js"></script>
    <!-- Vector Map plugin, full documentation here: http://jvectormap.com/documentation/ -->
    <script src="~/Newassets/js/plugins/jquery-jvectormap.js"></script>
    <!--  Plugin for the Sliders, full documentation here: http://refreshless.com/nouislider/ -->
    <script src="~/Newassets/js/plugins/nouislider.min.js"></script>
    <!--	Plugin for Select, full documentation here: http://silviomoreto.github.io/bootstrap-select -->
    <!--  Google Maps Plugin    -->
    <!-- <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_KEY_HERE"></script> -->
    <!-- Chart JS -->
    <script src="~/Newassets/js/plugins/chartjs.min.js"></script>
    <!--  Notifications Plugin    -->
    <script src="~/Newassets/js/plugins/bootstrap-notify.js"></script>
    <!-- Control Center for Now Ui Dashboard: parallax effects, scripts for the example pages etc -->
    <script src="~/Newassets/js/now-ui-dashboard.min.js?v=1.4.1" type="text/javascript"></script>
    <script type="text/javascript" src="~/js/settings.js"></script>



    @RenderSection("Scripts", required: false)
</body>
</html>
