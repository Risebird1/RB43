    <div id="MyChatModel" class="modal mymodal modal-bg" style="padding-top:30px;">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header modalMinimize">
                    <div>
                        <h5 class="modal-title" style="color:#fff"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" /></svg> Chat <input type="text" value="" hidden id="txtself" /></h5>
                    </div>
                    <div>
                        <button class="close" title="Minimize"> <i class='fa fa-minus'></i> </button>
                    </div>
                    @*<div>
                            <span onclick="closeChatPopUp()" style="cursor:pointer;" title="Close" class="close" id="SharePopUp">&times;</span>
                        </div>*@

                </div>
                <div class="modal-body nopad">
                    <div>

                        <div class="clearfix"></div>
                        <div class="right-in" style="width:100%">
                            <div class="container-chat">
                                <div class=" col-md-4 chatlist pull-left nopad">

                                    @*<div class="search">
                                            <input type="text" placeholder="search" />
                                            <i class="fa fa-search"></i>
                                        </div>*@
                                    <div class="scroll-box-wrap">
                                        <div class="col-md-12 scroll-box-list" id="divchatboxmenu"></div>

                                    </div>
                                </div>
                                <div class="col-md-8 pull-left chat  nopad">



                                    <div class="chat-header clearfix">
                                        <div class="pull-right">
                                            @if (User.Identity.IsAuthenticated)
                                            {
                                                @if (@HttpContextAccessor.HttpContext.Session.GetString("email") != null)
                                                {
                                                    var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
                                                    var email = emailid.Trim('"');
                                                    @if (email.ToUpper() == "TALENT@RISEBIRD.IO")
                                                    {
                                                        <a class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" id="btncreategroup" clickmethod="1" onclick="FetchGroup()"><img src="../../img/create-new.png" /> Group</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" hidden id="btncreategroup" clickmethod="1" onclick="FetchGroup()">Create/Edit Group</a>

                                                    }
                                                }
                                            }
                                        </div>



                                        <div class="pull-left">
                                            <img id="imgavtar" src="data:image/jpeg;base64," style="display:none" alt="avatar">
                                            <div class="chat-about">
                                                <div class="chat-with"><lable id="lblChatname"></lable></div>

                                            </div>
                                            @*<i class="fa fa-star"></i>*@
                                        </div>


                                    </div>





                                    <div class=" scroll-box">


                                        <div class="col-md-12" id="divchatbox">

                                        </div>
                                    </div>


                                    <div>

                                        <form>
                                            <div id="msger-inputarea">
                                                <input type="text" id="txtmessage" class="form-control msger-input" placeholder="Enter Your Message" style="display:none" onkeypress="return MessagekeyChat(event);" />
                                                <input type="button" id="btnchatConversation" class="msger-send-btn" style="display:none" value="send" onclick="SendConversation()" />
                                            </div>
                                        </form>







                                        <!--    <div class="col-md-9" style="padding-right:0px">
                                             <input type="text" id="txtmessage" class="form-control" placeholder="Start writting here....." style="display:none" />
                                         </div>
                                         <div class="col-md-3" style="padding-left:0px">
                                             <input type="button" id="btnchatConversation" style="background-color:blue;color:white;display:none" value="send" onclick="SendConversation()" class="form-control" />
                                         </div>
                                        -->



                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>




                </div>

            </div>
        </div>
    </div>
    <div class="minmaxCon"></div>

    <script>
        var flag = true;
        var flagdisplay = true;
        var whosend = "U";
        function closeChatPopUp() {
            var modal = document.getElementById("MyChatModel");
            modal.style.display = "none";
            flag = false;
        }
        function checkConversation() {
            $.ajax({
                type: "POST",
                url: "/Chat/GetConversation",
                data: { userid: $("#txtself").val(), contact: "", status: "Chat" },
                success: function (data) {
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].messageInfo == "Send") {
                            //var modal = document.getElementById("MyChatModel");
                            //modal.style.display = "block";
                            flagdisplay = false;
                            // $(".modalMinimize").click();
                            $('#chatAudio')[0].play();
                        }
                    }
                    setTimeout(checkConversation(''), 5000);
                }
            });
        }
        //$("#btncreategroup").attr('clickmethod') == 1
        function OpenChatPopUp() {
            flag = false;
            $.ajax({
                type: "POST",
                url: "/Chat/ChatBox",
                success: function (data) {
                    var modal = document.getElementById("MyChatModel");
                    modal.style.display = "block";
                    var html = '';
                    for (var i = 0; i < data.result.length; i++) {
                        html += '<div class="f-w">';
                        html += ' <img src="data:image/jpeg;base64," alt="avatar">';
                        html += '<div>';
                        if (data.result[i].isOnline == 1) {
                            html += '<div class="about" ><a onclick="Details(' + i + ')" style="cursor:pointer"><span class="user-name"> ' + data.result[i].sender + '</span><span class="dot" style="background-color:green;"></span> Online</a></div> ';
                        }
                        else {
                            html += '<div class="about" > <a onclick="Details(' + i + ')" style="cursor:pointer"><span class="user-name"> ' + data.result[i].sender + '</span><span class="dot">Offline</span></a></div>';
                        }
                        if (data.result[i].status == "Sent") {
                            html += '<svg class="bi bi-circle-fill bugger" width=".7em" height=".7em" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">';
                            html += '<circle cx="8" cy="8" r="8"/>';
                            html += '</svg>';
                            //html += '<svg class="bi bi-info-circle-fill bugger" width="1em" height="1em" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">';
                            //html += '<path fill-rule="evenodd" d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412l-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM8 5.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>';
                            //html += '</svg>';
                        }
                        html += '</div>';
                        html += '</div>';
                        html += '<input type="text" hidden value="' + data.result[i].sender + '" id="txthiddenSorce_' + i + '" />';
                        html += '<input type="text" hidden value="' + data.result[i].whoSend + '" id="txtWhoSend_' + i + '" />';
                    }
                    $("#txtself").val(data.self);
                    //$("#lblChatname").text("");
                    //document.getElementById("txtmessage").style.display = "none";
                    //document.getElementById("btnchatConversation").style.display = "none";
                    //var msg = document.getElementById("msger-inputarea");
                    //msg.style.display = "none";
                    $("#divchatboxmenu").empty().html(html);
                    setTimeout(OpenChatPopUp(), 5000);
                    //Details(0);
                    flag = true;
                }
            });
        }
        var sendvalue = '';
        function Details(id) {
            var Sender = $("#txthiddenSorce_" + id).val();
            document.getElementById("txtmessage").style.display = "block";
            document.getElementById("btnchatConversation").style.display = "block";
            var msg = document.getElementById("msger-inputarea");
            msg.style.display = "flex";
            whosend = $("#txtWhoSend_" + id).val();
            $("#btncreategroup").attr('clickmethod', '1');
            ChatConversation(Sender);

        }
        function directopenChat(Sender) {
            var modal = document.getElementById("MyChatModel");
            modal.style.display = "block";
            flag = true;
            document.getElementById("txtmessage").style.display = "block";
            document.getElementById("btnchatConversation").style.display = "block";
            var msg = document.getElementById("msger-inputarea");
            msg.style.display = "flex";
            ChatConversation(Sender);
            $(".modalMinimize").click();
        }
        function ChatConversation(Sender) {
            if ($("#btncreategroup").attr('clickmethod') == 1) {
                if (Sender != "" && Sender != null) {
                    sendvalue = Sender;
                } else {
                    Sender = sendvalue;
                }
                $.ajax({
                    type: "POST",
                    url: "/Chat/GetConversation",
                    data: { contact: Sender, userid: $("#txtself").val(), WhoSend: whosend },
                    success: function (data) {
                        var html = '';
                        var countvalue = 0;
                        for (var i = 0; i < data.length; i++) {
                            html += '<div class="row" style="padding: 10px 20px 10px 10px">';
                            if (data[i].self != 1) {
                                if (whosend == "G") {
                                    html += '<div class="col-md-6"><div class="msg-bubble fadeInUp"><strong>' + data[i].senderName + '</strong>: ' + data[i].message + '</div></div><div class="col-md-6"></div>';

                                } else {
                                    html += '<div class="col-md-6"><div class="msg-bubble fadeInUp">' + data[i].message + '</div></div><div class="col-md-6"></div>';

                                }
                                countvalue = i;
                            } else {
                                html += '<div class="col-md-6"></div><div class="col-md-6"><div class="msg-bubble-right fadeInUp">' + data[i].message + '</div></div>';
                            }
                            html += '</div>';

                        }

                        var createheader = '';
                        if (data.length > 0) {
                            if (data[countvalue].isOnline == 1) {
                                createheader += Sender + ' (Online)';
                            } else {
                                createheader += Sender + ' (Offline)';
                            }
                        }
                        else {
                            createheader += Sender;
                        }
                        $("#divchatbox").empty().html(html);
                        $("#lblChatname").text(createheader);
                        var avtar = document.getElementById("imgavtar");
                        avtar.style.display = "block";
                        $('#divchatbox').scrollTop($('#divchatbox')[0].scrollHeight);
                        if (flag == true) {
                            setTimeout(ChatConversation(''), 5000);
                        }
                        else {
                            flag = true;
                        }
                    }
                });
            }
        }
        function SendConversation() {
            var Sender = sendvalue;
            if ($("#txtmessage").val() != "") {
                $.ajax({
                    type: "POST",
                    url: "/Chat/AddConversation",
                    data: { contact: Sender, userid: $("#txtself").val(), message: $("#txtmessage").val() },
                    success: function (data) {
                        ChatConversation('');
                        $("#txtmessage").val('');
                    }
                });
            }
        }


        $(document).ready(function () {
            checkConversation();
            var $content, $modal, $apnData, $modalCon;
            $content = $(".min");
            $(".mdlFire").click(function (e) {
                e.preventDefault();
                var $id = $(this).attr("data-target");
                $($id).modal({
                    backdrop: false,
                    keyboard: false
                });

            });
            $(".modalMinimize").on("click", function () {
                if (flagdisplay == false) {
                    OpenChatPopUp();
                }
                $modalCon = $(this).closest(".mymodal").attr("id");
                $apnData = $(this).closest(".mymodal");
                $modal = "#" + $modalCon;
                $(".modal-backdrop").addClass("display-none");
                $($modal).toggleClass("min");
                if ($($modal).hasClass("min")) {
                    $(".minmaxCon").append($apnData);
                    $(this).find("i").toggleClass('fa-minus').toggleClass('fa-clone');
                } else {
                    $(".container").append($apnData);
                    $(this).find("i").toggleClass('fa-clone').toggleClass('fa-minus');
                };
            });
            $("button[data-dismiss='modal']").click(function () {
                $(this).closest(".mymodal").removeClass("min");
                $(".container").removeClass($apnData);
                $(this).next('.modalMinimize').find("i").removeClass('fa fa-clone').addClass('fa fa-minus');
            });
            var modal = document.getElementById("MyChatModel");
            modal.style.display = "block";
            $(".modalMinimize").click();
            OpenChatPopUp();
        });
        function MessagekeyChat(event) {
            event = event || window.event;
            var keyCode = event.keyCode
            if (keyCode == 13) {
                SendConversation();
                event.preventDefault();
            }
        }
        function FetchGroup() {
            $("#btncreategroup").attr('clickmethod', '0');
            flag = false;
            document.getElementById("txtmessage").style.display = "none";
            document.getElementById("btnchatConversation").style.display = "none";
            var msg = document.getElementById("msger-inputarea");
            msg.style.display = "none";
            $.ajax({
                type: "POST",
                url: "/Chat/FetchGroup",
                success: function (data) {
                    var html = '';
                    html += '<div class="f-w">';
                    html += '<div class="col-md-12"><div class="pull-left "><input placeholder="Enter name of group" type="text" id="txtgroupname" class="input-box" /></div><div class="pull-left mdc-button mdc-button--raised mdc-ripple-upgraded add-btn-m"><input  class="add-btn" type="button" value="Add Group" onclick="AddGroup()" /></div></div>';

                    html += '</div>';
                    for (var i = 0; i < data.length; i++) {
                        html += '<div class="f-w" >';
                        html += '<div class="col-md-12"><div class="pull-left "><a class="user-group" onclick="FetchUser(' + data[i].id + ')">' + data[i].groupName + '</a></div><div class="pull-left"><input class="del-btn" type="button" value="Delete" onclick="DeleteGroup(' + data[i].id + ')" /></div></div>';

                        html += '</div>';
                    }
                    $("#divchatbox").empty().html(html);
                    $("#lblChatname").text('');
                    var avtar = document.getElementById("imgavtar");
                    avtar.style.display = "none";

                }
            });
        }
        function AddGroup() {
            if ($("#txtgroupname").val().trim() != "") {
                $.ajax({
                    type: "POST",
                    url: "/Chat/AddGroup",
                    data: { GroupName: $("#txtgroupname").val() },
                    success: function (data) {
                        FetchGroup();
                    }
                });
            } else {
                alert("Please Enter GroupName");
            }
        }
        function DeleteGroup(Id) {
            $.ajax({
                type: "POST",
                url: "/Chat/DeleteGroup",
                data: { GroupId: Id },
                success: function (data) {
                    FetchGroup();
                }
            });
        }
        function FetchUser(Id) {
            $.ajax({
                type: "POST",
                url: "/Chat/FetchUser",
                data: { GroupId: Id },
                success: function (data) {
                    var html = '';
                    html += '<div class="row" style="padding: 10px 20px 10px 20px;" >';
                    html += '<div><div class="pull-left "><input placeholder="Enter name of user" type="text" id="txtgroupEmailid" class="input-box" /></div><div class="pull-left mdc-button mdc-button--raised mdc-ripple-upgraded add-btn-m "><input class="add-btn" type="button" value="Add User" onclick="AddUser(' + Id + ')" /></div></div>';

                    html += '</div>';
                    for (var i = 0; i < data.length; i++) {

                        html += '<div class="row" style="padding:10px 20px;">';
                        html += '<div><div class="pull-left user-group">' + data[i].emailid + '</div><div class="pull-left"><input class="del-btn" type="button" value="Delete" onclick="DeleteUser(' + data[i].id + ',' + Id + ')" /></div></div>';

                        html += '</div>';



                    }
                    $("#divchatbox").empty().html(html);
                    $("#lblChatname").text('');
                     var avtar = document.getElementById("imgavtar");
                    avtar.style.display = "none";

                }
            });
        }
        function AddUser(GroupId) {
            if ($("#txtgroupEmailid").val().trim() != "") {
                $.ajax({
                    type: "POST",
                    url: "/Chat/AddUser",
                    data: { GroupId: GroupId, Emailid: $("#txtgroupEmailid").val() },
                    success: function (data) {
                        if (data == "success") {
                            FetchUser(GroupId);
                        } else {
                            alert(data);
                        }
                    }
                });
            } else {
                alert("Please Enter Emailid");
            }
        }
        function DeleteUser(Id, GroupId) {
            $.ajax({
                type: "POST",
                url: "/Chat/DeleteUser",
                data: { Userid: Id },
                success: function (data) {
                    FetchUser(GroupId);
                }
            });
        }
        function closebrowser() {
            $.ajax({
                type: "GET",
                url: "/Session/SignOut",
                success: function (data) {

                }
            });
        }
    </script>


