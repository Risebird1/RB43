<body class="sidebar-mini" style="padding-right:0px!important;">

    <audio id="chatAudio" controls="controls" hidden>
        <source src="~/audio/done-for-you.ogg" type="audio/ogg" />
    </audio>

    <div class="wrapper">
        @Html.AntiForgeryToken()


        <nav class="navbar navbar-expand-lg navbar-transparent btn-primary  navbar-absolute top-panel" style="height:53px;">
            <div class="pull-left">
                <div class="navbar-wrapper w-full">
                    <div class="navbar-toggle">
                        <button type="button" class="navbar-toggler">
                            <span class="navbar-toggler-bar bar1"></span>
                            <span class="navbar-toggler-bar bar2"></span>
                            <span class="navbar-toggler-bar bar3"></span>
                        </button>
                    </div>
                    <div id="txtpageHeader" class="navbar-brand" style=" line-height:50px!important;">@ViewBag.PageHeader</div>
                </div>

            </div>

            <div class="mob_h">
                <div class="pull-right">
                    <div class="pull-left">
                        @if (@HttpContextAccessor.HttpContext.Session.GetString("profileName") != null)
                        {
                            var profileName = HttpContextAccessor.HttpContext.Session.GetString("profileName");
                            profileName = profileName.Trim('"');
                            @if (profileName == "Admin" || profileName == "SeniorHR" || profileName == "SupportAdmin" || profileName == "Client")
                            {
                                <div class="pull-left">
                                    <div class="desktop-view topbar-item">
                                        @if (profileName != "Client")
                                        {
                                            var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
                                            var email = emailid.Trim('"');
                                            if (profileName == "Admin" || profileName == "SupportAdmin" || email.ToLower() == "vaibhaw_sachan@risebird.io")
                                            {
                                                <span style="cursor:pointer;" onclick="location.href='@Url.Action("ClientInterviewsReview", "Survey")'" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg><font style="font-family: arial;font-size: 14px !important;text-transform: capitalize;padding-right:20px;"> Client Review</font></span>
                                            }
                                            @if (profileName == "Admin")
                                            {
                                                <span style="cursor:pointer;" onclick="location.href='@Url.Action("SchedulerList", "InterviewScheduler")'" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg><font style="font-family: arial;font-size: 14px !important;text-transform: capitalize;padding-right:20px;"> RB Scheduler</font></span>
                                            }
                                            <span style="cursor:pointer;" onclick="location.href='@Url.Action("RequirementManagement", "DashBoard")'" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg><font style="font-family: arial;font-size: 14px !important;text-transform: capitalize;padding-right:20px;"> Channel Management</font></span>
                                            <span style="cursor:pointer;" onclick="location.href='@Url.Action("Index", "ActivityTracker")'" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M19.07 4.93l-1.41 1.41C19.1 7.79 20 9.79 20 12c0 4.42-3.58 8-8 8s-8-3.58-8-8c0-4.08 3.05-7.44 7-7.93v2.02C8.16 6.57 6 9.03 6 12c0 3.31 2.69 6 6 6s6-2.69 6-6c0-1.66-.67-3.16-1.76-4.24l-1.41 1.41C15.55 9.9 16 10.9 16 12c0 2.21-1.79 4-4 4s-4-1.79-4-4c0-1.86 1.28-3.41 3-3.86v2.14c-.6.35-1 .98-1 1.72 0 1.1.9 2 2 2s2-.9 2-2c0-.74-.4-1.38-1-1.72V2h-1C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10c0-2.76-1.12-5.26-2.93-7.07z" /></svg><font style="font-family:arial;text-transform:capitalize;font-size:14px!important;padding-right:10px;"> ActivityTracker</font></span>
                                        }
                                        <span style="cursor:pointer;" onclick="location.href='@Url.Action("SkillChannelDetails", "IRF")'" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" /></svg><font style="font-family:arial;text-transform:capitalize;font-size:14px!important;"> Skill Channel Stats</font></span>

                                        <span class="divider-lm"> | </span>
                                    </div>
                                    @if (profileName != "Client")
                                    {
                                        @if (profileName == "Admin")
                                        {
                                            <span class="mobile-view-chn fa fa-tasks" style="font-size:15px;" onclick="location.href='@Url.Action("SchedulerList", "InterviewScheduler")'" data-original-title="Tooltip on top"><font style="font-family:arial;"> RB Scheduler</font></span>
                                        }
                                        <span class="mobile-view-chn fa fa-tasks" style="font-size:15px;" onclick="location.href='@Url.Action("SchedulerList", "InterviewScheduler")'" data-original-title="Tooltip on top"><font style="font-family:arial;"> RB Scheduler</font></span>
