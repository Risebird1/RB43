                                    }
                                    <span class="mobile-view-skchn" onclick="location.href='@Url.Action("SkillChannelDetails", "IRF")'" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" /></svg><font style="font-family:arial;"> Skill Channel Stats</font></span>
                                </div>
                            }
