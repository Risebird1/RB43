    <div id="MyChatModel" class="modal mymodal" style="display: none;position: fixed;z-index: 1;padding-top: 50px;left: 0;
        top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgb(0,0,0);background-color: rgba(0,0,0,0.4);">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" style="color:#fff"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" /></svg> Chat <input type="text" value="" hidden id="txtself" /></h5>
                    </div>
                    <div>
                        <button class="close modalMinimize"> <i class='fa fa-minus'></i> </button>
                    </div>
                    <div>
                        <span onclick="closeChatPopUp()" style="cursor:pointer;" class="close" id="SharePopUp">&times;</span>
                    </div>

                </div>
                <div class="modal-body" style="padding: 2px 16px;">
                    <div>

                        <div class="pull-left"> <h5><lable id="lblChatname"></lable></h5></div>
                        <div class="pull-right">
                            <a class="back" onclick="OpenChatPopUp()"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.41 16.09l-4.58-4.59 4.58-4.59L14 5.5l-6 6 6 6z" /></svg> Back to list</a>
                        </div>

                        <div class="talk-bubble tri-right border-bubble right-in" style="width:100%">

                            <div id="divchatbox" class="scroll-box">

                            </div>
                            <div>

                                <form>
                                    <div id="msger-inputarea">
                                        <input type="text" id="txtmessage" class="form-control msger-input" placeholder="Start writting here....." style="display:none" />
                                        <input type="button" id="btnchatConversation" class="msger-send-btn form-control" style="display:none" value="send" onclick="SendConversation()" />
                                    </div>
                                </form>







                                <!--    <div class="col-md-9" style="padding-right:0px">
                                     <input type="text" id="txtmessage" class="form-control" placeholder="Start writting here....." style="display:none" />
                                 </div>
                                 <div class="col-md-3" style="padding-left:0px">
                                     <input type="button" id="btnchatConversation" style="background-color:blue;color:white;display:none" value="send" onclick="SendConversation()" class="form-control" />
                                 </div>
                                -->



                            </div>
                        </div>
                    </div>




                </div>
                <div class="modal-footer" style="padding: 5px;
        background-color: #fff;
        color: white;"> </div>
            </div>
        </div>
    </div>
    <div class="minmaxCon"></div>

    <script>
        var flag = true;
        var flagdisplay = true;
        function closeChatPopUp() {
            var modal = document.getElementById("MyChatModel");
            modal.style.display = "none";
            flag = false;
        }
        function checkConversation() {
            $.ajax({
                type: "POST",
                url: "/Account/GetConversation",
                data: { userid: $("#txtself").val(), contact: "", status: "Chat" },
                success: function (data) {
                    for (var i = 0; i < data.length; i++) {
                        if (data[i].messageInfo == "Send") {
                            var modal = document.getElementById("MyChatModel");
                            modal.style.display = "block";
                            flagdisplay = false;
                            $(".modalMinimize").click();
                        }
                    }
                    setTimeout(checkConversation(''), 5000);
                }
            });
        }
        function OpenChatPopUp() {
            flag = false;
            $.ajax({
                type: "POST",
                url: "/Account/ChatBox",
                success: function (data) {
                    var modal = document.getElementById("MyChatModel");
                    modal.style.display = "block";


                    var html = '';
                    for (var i = 0; i < data.result.length; i++) {
                        if (data.result[i].isOnline == 1) {
                            html += ' <p><a onclick="Details(' + i + ')"><span class="dot" style="background-color:green;"></span>  ' + data.result[i].sender + '</a></p>';
                        }
                        else {
                            html += ' <p><a onclick=""><span class="dot" ></span>  ' + data.result[i].sender + '</a></p>';
                        }
                        html += '<input type="text" hidden value="' + data.result[i].sender + '" id="txthiddenSorce_' + i + '" />';
                    }
                    $("#txtself").val(data.self);
                    $("#lblChatname").text("");
                    document.getElementById("txtmessage").style.display = "none";
                    document.getElementById("btnchatConversation").style.display = "none";
                    var msg = document.getElementById("msger-inputarea");
                    msg.style.display = "none";
                    $("#divchatbox").empty().html(html);
                    flag = true;
                }
            });
        }
        var sendvalue = '';
        function Details(id) {
            var Sender = $("#txthiddenSorce_" + id).val();
            document.getElementById("txtmessage").style.display = "block";
            document.getElementById("btnchatConversation").style.display = "block";
            var msg = document.getElementById("msger-inputarea");
            msg.style.display = "block";
            ChatConversation(Sender);
        }
        function directopenChat(Sender) {
            var modal = document.getElementById("MyChatModel");
            modal.style.display = "block";
            flag = true;
            document.getElementById("txtmessage").style.display = "block";
            document.getElementById("btnchatConversation").style.display = "block";
            ChatConversation(Sender);
        }
        function ChatConversation(Sender) {
            if (Sender != "" && Sender != null) {
                sendvalue = Sender;
            } else {
                Sender = sendvalue;
            }
            $.ajax({
                type: "POST",
                url: "/Account/GetConversation",
                data: { contact: Sender, userid: $("#txtself").val() },
                success: function (data) {
                    var html = '';
                    var countvalue = 0;
                    for (var i = 0; i < data.length; i++) {
                        html += '<div class="row" style="padding: 10px 20px 10px 20px">';
                        if (data[i].self != 1) {
                            html += '<div class="msg-bubble fadeInUp" class="form-control col-md-6">' + data[i].message + '</div>';
                            countvalue = i;
                        } else {
                            html += '<div class="col-md-6"></div><div style="text-align:Right;height: auto;background-color: aquamarine;padding-top:15px" class="form-control col-md-6 msg-bubble fadeInUp">' + data[i].message + '</div>';
                        }
                        html += '</div>';

                    }
                    var createheader = '';
                    if (data[countvalue].isOnline == 1) {
                        createheader += Sender + ' (Online)';
                    } else {
                        createheader += Sender + ' (Offline)';
                    }
                    $("#divchatbox").empty().html(html);
                    $("#lblChatname").text(createheader);
                    $('#divchatbox').scrollTop($('#divchatbox')[0].scrollHeight);
                    if (flag == true) {
                        setTimeout(ChatConversation(''), 5000);
                    }
                    else {
                        flag = true;
                    }
                }
            });

        }
        function SendConversation() {
            var Sender = sendvalue;
            if ($("#txtmessage").val() != "") {
                $.ajax({
                    type: "POST",
                    url: "/Account/AddConversation",
                    data: { contact: Sender, userid: $("#txtself").val(), message: $("#txtmessage").val() },
                    success: function (data) {
                        ChatConversation('');
                        $("#txtmessage").val('');
                    }
                });
            }
        }


        $(document).ready(function () {
            checkConversation();
            var $content, $modal, $apnData, $modalCon;
            $content = $(".min");
            $(".mdlFire").click(function (e) {
                e.preventDefault();
                var $id = $(this).attr("data-target");
                $($id).modal({
                    backdrop: false,
                    keyboard: false
                });

            });

            $(".modalMinimize").on("click", function () {
                if (flagdisplay == false) {
                    OpenChatPopUp();
                }
                $modalCon = $(this).closest(".mymodal").attr("id");
                $apnData = $(this).closest(".mymodal");
                $modal = "#" + $modalCon;
                $(".modal-backdrop").addClass("display-none");
                $($modal).toggleClass("min");
                if ($($modal).hasClass("min")) {
                    $(".minmaxCon").append($apnData);
                    $(this).find("i").toggleClass('fa-minus').toggleClass('fa-clone');
                } else {
                    $(".container").append($apnData);
                    $(this).find("i").toggleClass('fa-clone').toggleClass('fa-minus');
                };
            });
            $("button[data-dismiss='modal']").click(function () {
                $(this).closest(".mymodal").removeClass("min");
                $(".container").removeClass($apnData);
                $(this).next('.modalMinimize').find("i").removeClass('fa fa-clone').addClass('fa fa-minus');
            });
            $("#txtmessage").keypress(function () {
                var keyCode = this.which ? this.which : this.keyCode
                if (keyCode == 13) {
                    SendConversation();
                }

            });
        });
    </script>


