                buildConfiguration: function (element, configuration) {
                    configuration.label = $('#' + element.id + 'Label').get(0);
                    configuration.getSize = function () {
                        var v = $("#bs-size-name-id").val();
                        return v == "LG" ? "lg" : (v == "SM" ? "sm" : null);
