    string currentLoggedInUser = string.Empty;
    @if (HttpContextAccessor.HttpContext.Session.GetString("email") != null)
    {
        currentLoggedInUser = HttpContextAccessor.HttpContext.Session.GetString("email").Replace("\"", "");
    }
    //string importLocation = "@microsoft/applicationinsights-web";
}
