@using Microsoft.AspNetCore.Http
@using System.Security.Principal
@inject IHttpContextAccessor HttpContextAccessor
<style>
    .abcprofile {
        /* width: 100px; */
        width: 40px;
        border: 3px solid #FFF;
        /*border-radius: 20%;*/
        margin-top: 7px;
        /*height: 30px;*/
    }

    i:hover.abcd {
        color: red;
        cursor: pointer;
    }

    .abcprofile img {
        width: 100%;
    }

    .abccolor {
        color: white;
        margin-top: 6px;
        margin-left: 5px;
    }

    .list-group .list-group-item {
        line-height: 7px;
    }
    .img-thumbnailnew {
    display: inline-block;
    max-width: 100%;
    height: auto;
    padding: 4px;
    line-height: 1.42857143;
    background-color: #fff;
    border: 1px solid #ddd;
    -webkit-transition: all .2s ease-in-out;
    -o-transition: all .2s ease-in-out;
    transition: all .2s ease-in-out;
}
 
</style>


<!-- START X-NAVIGATION VERTICAL -->
<ul class="x-navigation x-navigation-horizontal x-navigation-panel">
    <!-- TOGGLE NAVIGATION -->
    <li class="xn-icon-button">
        <a href="#" class="x-navigation-minimize"><span class="fa fa-dedent"></span></a>
    </li>
    <!-- END TOGGLE NAVIGATION -->
    <!-- SIGN OUT -->
    <li class="xn-icon-button dropdown pull-right">
       
        @if (User.Identity.IsAuthenticated)
        {
            @if (@HttpContextAccessor.HttpContext.Session.GetString("email") != null)
            {
                var emailid = HttpContextAccessor.HttpContext.Session.GetString("email");
               
                var email = emailid.Trim('"');
               
                <span style="height:50px;">
                    <a id="user-profile" style="color:white;" href="#" class="dropdown-toggle" data-toggle="dropdown"><img src="~/img/man.png" class="img-responsive img-thumbnailnew img-circle" style="height:50px;" /> @email</a>
                </span>
                <ul class="dropdown-menu dropdown-block" role="menu">
                    <li><a asp-area="" asp-controller="Account" asp-action="SignOut">Sign out</a></li>
                </ul>

            }
            else
            {
               
                <span style="height:50px;">
                    <a id="user-profile" style="color:white;" href="#" class="dropdown-toggle" data-toggle="dropdown"><img src="~/img/man.png" class="img-responsive img-thumbnailnew img-circle" style="height:50px;" /> @User.Identity.Name</a>
                </span>
                <ul class="dropdown-menu dropdown-block" role="menu">
                    <li><a asp-area="" asp-controller="Account" asp-action="SignOut">Sign out</a></li>
                </ul>
            }
           
        }
        else
        {
            <div class="profile-data-title"><a style="color:white;" asp-area="" asp-controller="Account" asp-action="SignIn">Sign In</a></div>
        }
        @*</div>*@
    </li>   
</ul>
