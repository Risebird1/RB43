@if (Model.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@Model.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@Model.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/InterviewerSkills/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@Model.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        window.location.href = '/InterviewerSkills/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script type="text/javascript">

    function DeleteInterviewerSkills(id, iscName) {

        swal.fire({
            title: 'Are you sure?',
            text: iscName + " will be archived!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, archive it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/InterviewerSkills/DeleteInterviewerSkills?id=' + id,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error archiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Archived!',
                    type: 'success',
                    html: '<p>Interviewer Skills Channel ' + iscName + ' has been archived.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/InterviewerSkills/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Interviewer Skills Channel ' + iscName + ' has not been archived! :)',
                    'error'
                )
            }
        })


    }


    //Interviewer
    function InterviewerList(Id, InterviewerSkillid) {

        var url = '/InterviewerSkills/GetISCInterviewers?id=' + Id + '&InterviewerSkillidName=' + InterviewerSkillid;
        window.location.href = url;
    };
    function EditInterviewerSkills(id) {

        var url = '/InterviewerSkills/EditInterviewerSkills?id=' + id;
        window.location.href = url;
    };

    function UnArchiveISC(id) {

        var url = '/InterviewerSkills/UnArchiveISC?id=' + id;
        window.location.href = url;
    };

    function PauseInterviewerSkills(InterviewerSkillId, InterviewerSkillName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Interviewer Skills will be paused!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, pause it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/InterviewerSkills/PauseInterviewerSkills?InterviewerSkillId=' + InterviewerSkillId + '&InterviewerSkillName=' + InterviewerSkillName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Paused!',
                    type: 'success',
                    html: '<p>Interviewer Skills has been paused.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/InterviewerSkills/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Interviewer Skills has not been paused! :)',
                    'error'
                )
            }
        })

        //changeColor('red');
    }

    function PlayInterviewerSkills(InterviewerSkillId, InterviewerSkillName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Interviewer Skills will be enabled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, play it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/InterviewerSkills/PlayInterviewerSkills?InterviewerSkillId=' + InterviewerSkillId + '&InterviewerSkillName=' + InterviewerSkillName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Played!',
                    type: 'success',
                    html: '<p>Interviewer Skills has been enabled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/InterviewerSkills/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Interviewer Skills has not been enabled! :)',
                    'error'
                )
            }
        })
        //changeColor("yellow");
    }
    function InterviewMeetings(id, IRFid) {
        var url = '/InterviewerSkills/ISCInterviewMeetings?id=' + id + '&irfId=' + IRFid;
        window.location.href = url;
    };
    function SelectedInterviewMeetings(id, IRFid) {

        var url = '/InterviewerSkills/ISCSelectedInterviewMeetings?id=' + id + '&irfId=' + IRFid;
        window.location.href = url;
    };
</script>
