@model Risebird.Entities.ViewModel.InterviewerSkillsViewModel

@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interviewer Skills";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] RFID = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("InterviewerSkillsFilter") != null)
{
    filter = JsonConvert.DeserializeObject<IRFFilter>
(HttpContextAccessor.HttpContext.Session.GetString("InterviewerSkillsFilter"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
}
<script>
    var Header = "<div id='intskill_1'>Interviewer Skills Channel</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interviewer Skills Channel</h4></div>
                </div>
                <div class="pull-right">

                    <button style="display: none;margin-top: 2px;" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space filter" data-toggle="modal" data-target="#filterModal">
                        <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
