        console.log("Inside the changeColor()-- color is::" + tileColor);

        if (value) {
            console.log("local storge value is::" + value);
            $(document).ready(function () {
                $("#divTile").css({ "backgroundColor": tileColor });
                alert("Color Changed!!!!");
            });
        }

        // console.log("Div Value::"+document.getElementById("divTile"));
