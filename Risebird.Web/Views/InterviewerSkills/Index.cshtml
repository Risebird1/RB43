                                                 {InterviewerSkillName=item.InterviewerSkillId, calendlyLink=item.CalendlyLink})'" title="Schedule Meeting" class="mdc-fab__icon material-icons">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M13 9H9v4h4V9zm2-7h-1V1h-2v1H6V1H4v1H3c-.55 0-1 .45-1 1v12c0 .55.45 1 1 1h12c.55 0 1-.45 1-1V3c0-.55-.45-1-1-1zm-1 12H4V6h10v8z" /></svg>
                                                        </span>
                                                    </button>






                                                    @if (item.IsPaused)
                                                    {


                                                        <button id="intskill_13" class="mdc-fab app-fab--absolute item6" aria-label="PlayInterviewerSkills">
                                                            <span onclick="PlayInterviewerSkills('@item.id', '@item.InterviewerSkillId');" title="Play" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
                                                        </button>


