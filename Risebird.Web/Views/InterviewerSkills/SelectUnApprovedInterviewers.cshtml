@model Risebird.Entities.ViewModel.UnapprovedInterviewersCollectionVM
@{
    ViewData["Title"] = "Select Interviewers";
    ViewBag.PageHeader = "UnApproved Interviewer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link href="~/Newassets/css/risetube.css?v=133" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    @*<nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                @Html.ActionLink("ISC Interviewers", "GetISCInterviewers", "InterviewerSkills", new { id = @Model.ISCId, InterviewerSkillidName = @Model.ISCName }, htmlAttributes: new { @class = "navbar-brand breadcrumscolor" })
                <a class="navbar-brand"> / &nbsp; UnApproved Interviewer</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>*@
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title col-md-12">Select interviewers for <strong>'@Model.ISCName'</strong></h4>

                </div>
                <div class="pull-right">
                    @Html.ActionLink("Back", "Index", "InterviewerSkills", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                             
                            </div>

                </div>
            </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div style="width:100%;">&nbsp;</div>
                            <div>
                                <div id="tableID">
                                    @if (Model.UnApprovedInterviewersCollection == null || Model.UnApprovedInterviewersCollection.Count() == 0)
                                    {
                                        <p style="text-align:center; font-size:20px"> Interviewers with the matching Assessment group unavailable.</p>
                                    }
                                    else
                                    {
                                        @using (Html.BeginForm("SelectUnApprovedInterviewers", "InterviewerSkills", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                        {

                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered" cellspacing="0" style="text-align:center">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>EmailId</th>
                                                            <th>Skills</th>
                                                            <th>Resume</th>
                                                            <th>Add</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>EmailId</th>
                                                            <th>Assessment Group</th>
                                                            <th>Resume</th>
                                                            <th>Add</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody>


                                                        @for (int i = 0; i < Model.UnApprovedInterviewersCollection.Count(); i++)
                                                        {
                                                            <tr>
                                                                <td>@Model.UnApprovedInterviewersCollection[i].FirstName</td>
                                                                <td>@Model.UnApprovedInterviewersCollection[i].EmailId</td>
                                                                @if (Model.UnApprovedInterviewersCollection[i].AssessmentGroupName.Length > 30)
                                                                {
                                                                    <td class="video-title" title="@Model.UnApprovedInterviewersCollection[i].AssessmentGroupName">


                                                                        <a onclick="" data-tooltip="@Model.UnApprovedInterviewersCollection[i].AssessmentGroupName">  @Model.UnApprovedInterviewersCollection[i].AssessmentGroupName.Substring(0, 30) ...</a>
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>@Model.UnApprovedInterviewersCollection[i].AssessmentGroupName</td>
                                                                }
                                                                @if (Model.UnApprovedInterviewersCollection[i].ResumeLink != null && Model.UnApprovedInterviewersCollection[i].ResumeLink != "")
                                                                {
                                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@Model.UnApprovedInterviewersCollection[i].ResumeLink>Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }
                                                                <td>@Html.CheckBoxFor(m => m.UnApprovedInterviewersCollection[i].IsAdded)</td>
                                                                @Html.HiddenFor(m => m.UnApprovedInterviewersCollection[i].UserId)
                                                                @Html.HiddenFor(m => m.UnApprovedInterviewersCollection[i].InterviewerProfileId)

                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            @Html.HiddenFor(m => m.ISCId)
                                            @Html.HiddenFor(m => m.ISCName)



                                            <div class="card-footer ">
                                                <div class="row">

                                                    <div class="col-md-12 mc-button-area">


                                                        @Html.ActionLink("Back", "GetISCInterviewers", "InterviewerSkills", new { id = Model.ISCId, InterviewerSkillidName = Model.ISCName }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })

                                                        <input type="submit" value="Submit" id="btnSubmit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" />

                                                    </div>
                                                </div>
                                            </div>

                                        }
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>



