            maxHeight: 200
        });


    });

    function ResetFilter() {

        window.location.href = "/InterviewerSkills/ResetInterviewerRisetubeFilter";
    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var AssessmentGrouparr = @Html.Raw(Json.Serialize(AssessmentGroups));
        var Senioritylevel =  @Html.Raw(Json.Serialize(Senioritylevel));
        var compentencyLevel = @Html.Raw(Json.Serialize(CompentencyLevel));
        var profileType =  @Html.Raw(Json.Serialize(ProfileType));
        var indianRate =  @Html.Raw(Json.Serialize(IndianRate));
        var outSideIndiaRate =  @Html.Raw(Json.Serialize(OutSideIndiaRate));
        var companyType =  @Html.Raw(Json.Serialize(CompanyType));
        var domain =  @Html.Raw(Json.Serialize(Domain));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#AssessmentGroup").val(AssessmentGrouparr);
        $("#Senioritylevel").val(Senioritylevel);
        $("#CompentencyLevel").val(compentencyLevel);
        $("#ProfileType").val(profileType);
        $("#IndianRate").val(indianRate);
        $("#OutSideIndiaRate").val(outSideIndiaRate);
        $("#CompanyType").val(companyType);
        $("#Domain").val(domain);
    }


</script>


<script>
    var input = document.getElementById("txtsearch");
    input.addEventListener("keyup", function (event) {
        if (event.keyCode === 13) {
            event.preventDefault();
            document.getElementById("btnSearch").click();
        }
    });
</script>




<script>
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function CallButtonClick(name, phoneNumber) {
        candidate = name;
        // Get the modal
        var modal = document.getElementById("myCallModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(phoneNumber);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myCallModal");
        modal.style.display = "none";
    }


</script>
@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"HR\"")
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/js/hopscotch.min.js" type="text/javascript"></script>

    <script type="text/javascript">
        hopscotch.registerHelper('addOverlay', function () {
            $('body').append('<div class="overlay"></div>');
        });

        hopscotch.registerHelper('removeOverlay', function () {
            $('.overlay').fadeOut(function () {
                $(this).remove();
                $('.helper').remove();
            });
        });

        hopscotch.listen('show', function () {
            var elementObject = $(hopscotch.getCurrTarget(tour));
            var element = $('#' + elementObject[0].id);
           

            element.prev().removeClass('overlay-relative');
            element.addClass('overlay-relative');

            if ($('.helper').length !== 0) {

                // Use Helper Layer for hilight target element.
                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });

            } else {

                // Add Helper Layer for highlight target element.
                var newHelper = '<div class="helper"></div>';
                $('body').append(newHelper);

                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });
            }

        });

        var tour = {
            id: "hello-hopscotch",
            showCloseButton: false,
            steps: [
                {
                    title: "Interviewer Search",
                    content: "View all Interviewer Search detail here  and click on continue to know its features",
                    target: "intsearch_1",
                    placement: "bottom",
                    showPrevButton: true,

                    highlight: true,
                    zindex: 999999,
                    yOffset: 10,

                    onCTA: function () {
                        hopscotch.showStep(2);
                        $('#intsearch_1').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {
                        $('#intsearch_1').removeClass('overlay-relative');
                        $('.helper').remove();

                    }
                },
                {
                    title: "Search",
                    content: "Enter Skill or Candidate name and Search result",
                    target: "intsearch_2",
                    placement: "left",
                    showPrevButton: true,

                    zindex: 999999,
                    xOffset: 0,
                    yOffset: -10,
                    onPrev: function () {

                        $('#intsearch_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                    onNext: function () {

                        $('#intsearch_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },


                },
                {
                    title: "Filter",
                    content: "Filter here based on available attributes or reset filter if applied earlier",
                    target: "intsearch_3",
                    showPrevButton: true,
                    placement: "left",
                    zindex: 999999,
                    xOffset: 5,
                    yOffset: -20,
                    onPrev: function () {

                        $('#intsearch_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {

                        $('#intsearch_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                },
                {
                    title: "Candidate Detail",
                    content: "Click here to see the Candidate Video & detailed feedback",
                    target: "intsearch_4",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    onNext: function () {
                        $('#intsearch_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#intsearch_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

                  {
                       title: "Interviewer Menu",
                       content: "Click on Interviewer menu to see its features",
                      target: "#interviewer_menu",
                        placement: "top",
                      showPrevButton: true,
                     zindex: 999999,
                      yOffset: 10,
                      xOffset: -5,
                    onNext: function () {
                       $('#interviewer_menu').removeClass('overlay-relative');
                          $('.helper').remove();
                      },
                        onPrev: function () {
                          $('#interviewer_menu').removeClass('overlay-relative');
                           $('.helper').remove();
                      }
                 },

            ],
            onStart: ["addOverlay"],
            onEnd: ["removeOverlay"],
        };

        hopscotch.startTour(tour);

    </script>

}

