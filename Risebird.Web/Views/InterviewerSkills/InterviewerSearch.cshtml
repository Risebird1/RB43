                                                            }
                                                            else
                                                            {
                                                                <a> No Resume</a>
                                                            }
                                                        </span>
                                                    </div>




                                                    <div class="video-info col-sm-12 col-md-12 col-lg-12 nopad pull-left">
                                                        <span>Rate - IND / US:</span>
                                                        <span><span style="color: #000;font-weight: bold;padding-left: 3px;">(@item.PerHourRateIndia INR / @item.PerHourRateOutside)</span></span>
                                                    </div>
