                                    </div>
                                </div>

                            </div>


                            <div class="video-block section-padding" id="VideoList">
                                <div class="row">
                                    @foreach (var item in Model)
                                    {
                                        var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                        <div class="col-xl-3 col-sm-6 mb-3">
                                            <div class="video-card">
                                                <div class="video-card-image">
                                                    @if (item.MeetingPatchCount > 0)
                                                    {
                                                        <div class="count-bg"><span>@item.MeetingPatchCount</span></div>
                                                    }
                                                    @if (item.VideoLink.Contains(".mp4"))
                                                    {
                                                        @if (item.ThumbnailImage != null)
                                                        {
                                                            <img src="@item.ThumbnailImage" class="thumbnailImage" />
                                                        }
                                                        <video controls class="video-thumb" controlsList="nodownload">
                                                            <source src="@item.VideoLink" type="video/mp4">
                                                        </video>
                                                        <a class="play-icon" onclick="location.href='@Url.Action("InterviewerVideoPage", "InterviewerSkills", new { id = item.imid})'" style=" cursor: pointer;"></a>
                                                    }
                                                    else
                                                    {
                                                        @if (item.ThumbnailImage != null)
                                                        {
                                                            <img src="@item.ThumbnailImage" class="thumb-height" />
                                                        }
                                                        else
                                                        {
                                                            <img src="~/RiseTube/img/video-icon.png" class="thumb-height" />
                                                        }
                                                        <a class="play-icon" onclick="location.href='@Url.Action("InterviewerVideoPage", "InterviewerSkills", new { id = item.imid})'" style=" cursor: pointer;"></a>
                                                    }


                                                </div>
                                                <div class="video-card-body">
                                                    <div class="video-title">

                                                        @if (@item.candidateName.Length > 20)
                                                        {
                                                            <a data-tooltip="@item.candidateName" onclick="location.href='@Url.Action("InterviewerVideoPage", "InterviewerSkills", new { id = item.imid })'" style=" cursor: pointer;"><span class="candidate-name candidate">@item.candidateName</span> </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="candidate">@item.candidateName</span>}
                                                        @if (!String.IsNullOrEmpty(item.AssessmentGroup))
                                                        {

                                                            @if (@item.AssessmentGroup.Length > 28)
                                                            {
                                                                <a href="#" data-tooltip="@item.AssessmentGroup"> <span class="join-time  designation">@item.AssessmentGroup</span></a>}

                                                            else
                                                            { <span class="designation">@item.AssessmentGroup</span>}
                                                        }
                                                        else
                                                        { <span class="designation"></span>}


                                                    </div>
                                                    <div class="video-info col-sm-6 col-md-6 col-lg-6 nopad pull-left">
                                                        <span>Tech Score: @item.TechSkillScore</span>
                                                    </div>
                                                    <div class="video-info col-sm-6 col-md-6 col-lg-6 nopad pull-left">
                                                        <span>
                                                            Resume:
                                                            @if (!String.IsNullOrEmpty(item.resumeLink))
                                                            {
                                                                <a target="_blank" href=@item.resumeLink>Resume</a>
                                                            }
                                                            else
                                                            {
                                                                <a> No Resume</a>
                                                            }
                                                        </span>
                                                    </div>




                                                    <div class="video-info col-sm-12 col-md-12 col-lg-12 nopad pull-left">
                                                        <span>Rate - IND / Outside IND:</span>
                                                        <span>(@item.PerHourRateIndia INR / @item.PerHourRateOutside)</span>
                                                    </div>
                                                    <div class="video-info col-sm-8 col-md-8 col-lg-8 nopad pull-left">
                                                        <span>Level- Upto to @item.Senioritylevel</span>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    }


                                </div>
                            </div>
                            <hr>

                            @{
                                var page = ViewBag.Page;
                                var startCount = (page - 1) * 12 + 1;
                                var endCount = (page) * 12;
                            }
                            @if (ViewBag.MeetingsCount == 0)
                            {
                                <p>
                                    No selected candidates are available as per requirement!
                                </p>
                            }
                            else if (ViewBag.Pages == page && ViewBag.Remainder == 0)
                            {
                                var endNum = page * 12;
                                <p>
                                    @startCount - @endNum of @ViewBag.MeetingsCount
                                </p>
                            }
                            else if (ViewBag.Pages == page && ViewBag.Remainder != 1)
                            {
                                var endNum = (page - 1) * 12 + ViewBag.Remainder;
                                <p>
                                    @startCount - @endNum of @ViewBag.MeetingsCount
                                </p>
                            }
                            else if (ViewBag.Pages == page && ViewBag.Remainder == 1)
                            {
                                <p>
                                    @startCount of @ViewBag.MeetingsCount
                                </p>
                            }
                            else
                            {
                                <p>
                                    @startCount - @endCount of @ViewBag.MeetingsCount
                                </p>
                            }

                            <div class="pagination-container">
                                <ul class="pagination">

                                    @{
                                        var startFrom = 0;
                                        var endWith = 0;
                                        if (page % 3 != 0)
                                        {
                                            startFrom = ((page / 3) * 3) + 1;
                                        }
                                        else
                                        {
                                            startFrom = (((page - 1) / 3) * 3) + 1;
                                        }
                                        var pages = ViewBag.Pages;

                                        if (pages - startFrom > 2)
                                        {
                                            endWith = startFrom + 2;
                                        }
                                        else
                                        {
                                            endWith = pages;
                                        }

                                    }

                                    @if (page > 3)
                                    {
                                        <li>
                                            <a href="@Url.Action("RisetubeInterviewer", "InterviewerSkills", new { page = startFrom - 1, searchvalue = ViewBag.searchvalue })"
                                               class="PagedList-skipToPrevious">
                                                &laquo;
                                            </a>
                                        </li>

                                    }
                                    @for (int i = startFrom; i <= endWith; i++)

                                    {

                                        <li class="@(i == ViewBag.page ? "page-item active" : "page-item")">
                                            @Html.ActionLink(i.ToString(), "RisetubeInterviewer", "InterviewerSkills", new { Page = i, searchvalue = ViewBag.searchvalue }, htmlAttributes: new { @class = "" })

                                        </li>
                                    }


                                    @if (pages > endWith)
                                    {
                                        <li class="PagedList-skipToNext">
                                            <a href="@Url.Action("RisetubeInterviewer", "InterviewerSkills", new { page = endWith + 1, searchvalue = ViewBag.searchvalue })">
                                                &raquo;
                                            </a>
                                        </li>

                                    }


                                </ul>
                            </div>


                        </div>




                    </div>
                </div>

            </div>
        </div>

        <div id="myCallModal" class="modal modal-wrap modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">




                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">


                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Call Candidate !</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                    </button>




                    <div class="modal-body">

                        <h5 class="modal-title text-center mt-20" id="callingLabel"></h5>

                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 0px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">

                    </div>

                </div>

            </div>
        </div>
    </div>

</div>




