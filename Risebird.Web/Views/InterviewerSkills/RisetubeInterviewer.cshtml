        });

        $("#ResetFilter").click(function () {
            ResetFilter();
        })

        if ('@filter' != "") {
            ApplySessionFilter();
        }

        $("#AssessmentGroup").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
