                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="AssessmentGroup" name="AssessmentGroup" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.AssessmentGroup).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
