                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Senioritylevel">
                                                                Seniority level
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Senioritylevel" name="Senioritylevel" class="form-control multiselect" multiple="multiple">

                                                                    @foreach (var item in Model.Select(x => x.Senioritylevel).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }

