                                                                                                    <div class="col-lg-12 col-md-12 col-sm-12 nopad">
                                                                                                        <div id="scoreChart" style="height: 200px; width: 100%;">


                                                                                                        </div>
                                                                                                        <div class="transparent-chart">&nbsp;</div>
                                                                                                    </div>
                                                                                                </div>

                                                                                                @if (Model.FeedbackAudioLink != null)
                                                                                                {
                                                                                                    <div class="audio-wrap">

                                                                                                        <h1>Audio Feedback</h1>
                                                                                                        <audio src='@Model.FeedbackAudioLink' controls></audio>
                                                                                                        <!--end of col-md-12-->
                                                                                                    </div>
                                                                                                }
                                                                                            </div>
                                                                                            <div class="interviewer-comment itemcomment">

                                                                                                <div class="form-group" style="margin-bottom:0px; ">
                                                                                                    @Html.LabelFor(model => model.IreportModel.InterviewerComment, htmlAttributes: new { @class = "control-label bolder col-md-12 col-sm-12" })


                                                                                                    <div class="talk-bubble tri-right border-bubble right-in inComment" style="width:100%;">
                                                                                                        @if (Model.InterviewerComment != null)
                                                                                                        {
                                                                                                            <a href="#" data-tooltip="@Model.InterviewerComment">

                                                                                                                <div class="talktext">


                                                                                                                    @Html.TextAreaFor(m => m.IreportModel.InterviewerComment, new { htmlAttributes = new { @class = "form-control text-box comment single-line" }, @style = "height:195px;", @readonly = "readonly" })

                                                                                                                </div>
                                                                                                            </a>
                                                                                                        }

                                                                                                        else
