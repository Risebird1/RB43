                                                                            {
                                                                                <a onclick="directopenChat('@Model.candidateEmail')">   @Model.candidateName <span class="dot" style="background-color:green"></span></a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <a onclick="">   @Model.candidateName <span class="dot"></span></a>
                                                                            }
                                                                        </div>
                                                                        <div style="        float: left;
        padding: 0px 10px 0px 0px;
">
                                                                            @if (@Model.JDTiltle.Length > 5)
                                                                            {

                                                                                <a href="#" data-tooltip="@Model.JDTiltle">
                                                                                    <span class="job_title join-time"> (@Model.JDTiltle.Split("|")[0])</span>
                                                                                </a>}
                                                                            else
                                                                            {
                                                                                <span>@Model.JDTiltle</span>
                                                                            }
                                                                        </div>
                                                                        <div style="float:left"><i style="font-weight:normal" class="fas fa-calendar-alt"></i> <span class="date-calendar">@Model.interviewDate</span></div>

                                                                        @if (Model.VideoLink != null)
                                                                        {
                                                                            <div class="shortlist pull-left" style="text-align: end;padding:0px 10px;">
                                                                                @if (Model.IsShortlisted > 0)
                                                                                {<i class="fa fa-check"></i>
                                                                                    <input type="button" class="share-wrap btnShortlist shortlist" id="btnShortlist" value="ShortListed(@Model.ShortListCount)" Shortvalue="2" />
                                                                                }
                                                                                else
                                                                                { <i class="fa fa-check"></i>
                                                                                    <input type="button" class="share-wrap btnShortlist shortlist" id="btnShortlist" value="ShortList(@Model.ShortListCount)" Shortvalue="1" />

                                                                                }
                                                                            </div>
                                                                        }



                                                                        <div style="float: right;
        padding: 0px 10px 15px 10px;
">
