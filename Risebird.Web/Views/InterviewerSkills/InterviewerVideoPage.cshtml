                                                                {
                                                                    @if (@Model.VideoLink.Contains(".mp4") || @Model.VideoLink.Contains(".org"))
                                                                    {
                                                                        <video controls class="vjs-tech video-width btnvideo" controlsList="nodownload" autoplay>
                                                                            <source src="@Model.VideoLink" type="video/mp4">"  autoplay>
                                                                            <source src="@Model.VideoLink" type="video/mp4">
                                                                        </video>
                                                                    }
                                                                    else if (Model.VideoLink.Contains("/manifest"))
                                                                    {
                                                                        <video id="vid1" class="azuremediaplayer amp-default-skin amp-big-play-centered btnvideo" controls data-setup='{"logo": { "enabled": false }, "techOrder": ["azureHtml5JS", "flashSS", "silverlightSS", "html5"], "nativeControlsForTouch": false}' disablePictureInPicture controlsList="nofullscreen nodownload playsinline " autoplay>
                                                                            <source src="@Model.VideoLink" type="application/vnd.ms-sstr+xml" />
                                                                        </video>
                                                                    }
                                                                    else
                                                                    {
                                                                        <iframe width="100%" class="vjs-tech btnvideo" height="315" src="@Model.VideoLink" allowfullscreen></iframe>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span> Video deleted !!!</span>
                                                                }
                                                            </div>
                                                        </div>


                                                        <div>
