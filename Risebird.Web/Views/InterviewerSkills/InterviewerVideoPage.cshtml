                                                                                    <div>
                                                                                        <div class="relatedvideo">
                                                                                            @foreach (var videolist in Model.MeetingPatch)
                                                                                            {
                                                                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(videolist);
                                                                                                @if (Model.MeetingPatch.FirstOrDefault().Priority == videolist.Priority)
                                                                                                {
                                                                                                    <div class="video-card video-card-list videosidelist" onclick="changeVideo(@videolist.Priority)">
                                                                                                        <input type="text" hidden value="@videolist.VideoLink" id="txtvideopri_@videolist.Priority" />
                                                                                                        <div class="video-card-image active-video" id="divvideoclick_@videolist.Priority" onclick="changeVideo(@videolist.Priority)" disabled="true">

                                                                                                            @if (videolist.VideoLink.Contains(".mp4"))
                                                                                                            {
                                                                                                                <video style=" background:black!important;width:100%; height:100%;  pointer-events: none;" disablePictureInPicture controlsList="nofullscreen nodownload">
                                                                                                                    <source src="@videolist.VideoLink" type="video/mp4">
                                                                                                                </video>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <a class="play-icon" style=" cursor: pointer;"></a>
                                                                                                            }
                                                                                                        </div>
                                                                                                        <div class="video-card-body" onclick="changeVideo(@videolist.Priority)">
                                                                                                            <div class="video-title">
                                                                                                                @if (@videolist.VideoTitle.Length > 11)
                                                                                                                {
                                                                                                                    <a data-tooltip="@videolist.VideoTitle" style=" cursor: pointer;"><span class="candidate-name candidate">@videolist.VideoTitle</span> </a>
                                                                                                                }
                                                                                                                else
                                                                                                                {
                                                                                                                    <span class="candidate">@videolist.VideoTitle</span>
                                                                                                                }
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <div class="video-card video-card-list videosidelist" onclick="changeVideo(@videolist.Priority)">
                                                                                                        <input type="text" hidden value="@videolist.VideoLink" id="txtvideopri_@videolist.Priority" />
                                                                                                        <div class="video-card-image" id="divvideoclick_@videolist.Priority" onclick="changeVideo(@videolist.Priority)">

                                                                                                            @if (videolist.VideoLink.Contains(".mp4"))
                                                                                                            {
                                                                                                                <video style=" background:black!important;width:100%; height:100% " disablePictureInPicture controlsList="nofullscreen nodownload ">
                                                                                                                    <source src="@videolist.VideoLink" type="video/mp4">
                                                                                                                </video>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <a class="play-icon" style=" cursor: pointer;"></a>
                                                                                                                @*<a class="play-icon" onclick="location.href='@Url.Action("VideoPage", "Risetube", new { id = videolist.imid })'" style=" cursor: pointer;"></a>*@
                                                                                                            }

                                                                                                        </div>
                                                                                                        <div class="video-card-body" onclick="changeVideo(@videolist.Priority)">
                                                                                                            <div class="video-title">
                                                                                                                @if (@videolist.VideoTitle.Length > 11)
                                                                                                                {
                                                                                                                    <a data-tooltip="@videolist.VideoTitle" style=" cursor: pointer;"><span class="candidate-name candidate">@videolist.VideoTitle</span> </a>
                                                                                                                }
                                                                                                                else
                                                                                                                {
                                                                                                                    <span class="candidate">@videolist.VideoTitle</span>
                                                                                                                }
                                                                                                            </div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                }
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>

                                                                    <div class="col-md-12">
