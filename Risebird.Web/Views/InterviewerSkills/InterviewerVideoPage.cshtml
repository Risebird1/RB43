<script>
    function GetSentimentAnalysis(imid) {
        document.getElementById('link8').innerHTML = '';
        $.ajax({
            url: '/RiseTube/GetSentimentAnalysis',
            data: { 'imid': imid },
            success: function (data) {

                if (data.anger != "NaN") {
                    var sentimentObj = [{ y: data.anger, label: "Anger" },
                    { y: data.contempt, label: "Contempt" },
                    { y: data.disgust, label: "Disgust" },
                    { y: data.fear, label: "Fear" },
                    { y: data.happiness, label: "Happiness" },
                    { y: data.neutral, label: "Neutral" },
                    { y: data.sadness, label: "Sadness" },
                    { y: data.surprise, label: "Surprise" }]


                    var chart = new CanvasJS.Chart("link8", {
                        theme: "light2",
                        width: 350,//in pixels
                        height: 200,//in pixels
                        animationEnabled: true,
                        title: null,
                        data: [{
                            type: "pie",
                            startAngle: 60,
                            innerRadius: 55,
                            indexLabelFontSize: 15,
                            indexLabel: "{label}  {y}%",
                            toolTipContent: "<b>{label} </b>({y}%)",

                            dataPoints: sentimentObj
                        }]
                    });
                    chart.render();
                }
            }

        });
    }

</script>
<script>
    function datecal() {
        var dtToday = new Date();
        var time = dtToday.getHours() + ":" + dtToday.getMinutes();
        var month = dtToday.getMonth() + 1;
        var day = dtToday.getDate();
        var year = dtToday.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();

        var maxDate = year + '-' + month + '-' + day + 'T' + time;

        $('#txtOnlinestart').attr('min', maxDate);
    }

    function endcal() {


        var maxDate = $('#txtOnlinestart').val();
        if (maxDate == '') {
            var dtToday = new Date();
            var time = dtToday.getHours() + ":" + dtToday.getMinutes();
            var month = dtToday.getMonth() + 1;
            var day = dtToday.getDate();
            var year = dtToday.getFullYear();
            if (month < 10)
                month = '0' + month.toString();
            if (day < 10)
                day = '0' + day.toString();

            maxDate = year + '-' + month + '-' + day + 'T' + time;
        }
        $('#txtOnlineend').attr('min', maxDate);
    }
</script>
