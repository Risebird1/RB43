                                                                                        <div class="row">
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12  desp-label" })

                                                                                                    @Html.TextBoxFor(m => m.IreportModel.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.interviewDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                                                                    @Html.TextBoxFor(m => m.IreportModel.interviewDate, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="row">
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.expectedPerHourRate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                                                                    @Html.TextBoxFor(m => m.IreportModel.expectedPerHourRate, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                    @Html.ValidationMessageFor(model => model.IreportModel.expectedPerHourRate, "", new { @class = "text-danger" })
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.PreferredLocation, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                                                                                    @Html.TextBoxFor(m => m.IreportModel.PreferredLocation, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                        <div class="row">
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.currentEmployerName, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                                                                                    @Html.TextBoxFor(m => m.IreportModel.currentEmployerName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                </div>
                                                                                            </div>

                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.joiningTime, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })

                                                                                                    @Html.TextBoxFor(m => m.IreportModel.joiningTime, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                        <div class="row">
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">
                                                                                                    @Html.LabelFor(model => model.IreportModel.resumeLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 upload-label" })

                                                                                                    @{
                                                                                                        if (Model.IreportModel.resumeLink != null && Model.IreportModel.resumeLink != "")
                                                                                                        { <a id="resumeID" target="_blank" title="Resume" href=@Model.IreportModel.resumeLink.ToString().Replace(" ", " %20") class=" col-lg-12 col-md-12 col-sm-12 col-xs-12 click">Click here</a> }
                                                                                                    }
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-md-6 col-sm-6">
                                                                                                <div class="form-group">


                                                                                                    @{
                                                                                                        if (Model.IreportModel.AadharFileLink != null && Model.IreportModel.AadharFileLink != "")
                                                                                                        { @Html.LabelFor(model => model.IreportModel.AadharFileLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 upload-label" })<a id="resumeID" target="_blank" title="Resume" href=@Model.IreportModel.AadharFileLink.ToString().Replace(" ", "%20") class=" col-lg-12 col-md-12 col-sm-12 col-xs-12 click">Click here</a> }
                                                                                                    }
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>






                                                                                        <div>
                                                                                            <form>
                                                                                                <div class="form-group comment-area">
                                                                                                    <div class="talk-bubble tri-right border-bubble right-in">
                                                                                                        <div class="talktext">
                                                                                                            <textarea spellcheck="true" class="form-control status-box comment2" rows="1" id="txtComment" placeholder="Enter your comment here..." style="height:51px"></textarea>
                                                                                                            <div id="words"></div>
                                                                                                        </div>
                                                                                                    </div>
                                                                                                    <div class="button-group pull-right"> <a href="#" class="mdc-button mdc-button--raised mdc-ripple-upgraded post " id="btnComment">POST</a> </div>
                                                                                                </div>
                                                                                            </form>
                                                                                            <div id="divcomments">
                                                                                                <div class="chat">
                                                                                                    <div class="chat-history">
                                                                                                        <ul class="posts">
                                                                                                            @foreach (var itemvalue in Model.Comments)
                                                                                                            {
                                                                                                                <li>
                                                                                                                    <div class="message-data"> <span class="message-data-name"> <b>@itemvalue.UserName </b></span> </div>
                                                                                                                    <div class="message my-message  borders comment-tri-right left-tp"> @itemvalue.Comment</div>
                                                                                                                </li>
                                                                                                            }
                                                                                                        </ul>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                    </div>
                                                                                    <h3 class="d_active tab_drawer_heading" rel="link3">Tech Skill</h3>
                                                                                    <div class="tab-pane tab_content" id="link3">
