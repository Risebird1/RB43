<script>
    function GetMeetingAudioText(imid) {
        document.getElementById('link9').innerHTML = '';
        $.ajax({
            url: '/RiseTube/GetMeetingAudioText',
            data: { 'imid': imid },
            success: function (data) {
                if (data.convertedText == null || data.convertedText == '') {
                    document.getElementById('link9').innerHTML = 'Not available';
                }
                else {

                    var innerText = '<label class="matchtxt">Total Keywords Match Found:</label><span class="matcnum ">' + data.total + '</span><br>  <div class="matchdiv"><div style="overflow-y:scroll" class="scroller" id="style-2">' + data.convertedText + '</div></div>'

                    document.getElementById('link9').innerHTML = innerText;

                }

            }

        });
    }

</script>
