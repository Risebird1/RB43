                    </div>
                </div>
            </div>
        </div>
    </div>





    <div class="content client interviewerSkill">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bg-w">
                    <div class="mdc-card-wrapper__text-section">


                        @if (ViewBag.ResultStatus == "VideoPresent")
                        {
                            <div id="wrapper">
