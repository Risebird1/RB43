                                                                            <input type="text" hidden value="@Model.JDTiltle" id="txthiddenSkill" />
                                                                        </div>

                                                                    </h1>
                                                                </div>
                                                            }

                                                            <div class="row">

                                                                @if (Model.VideoLink != null)
                                                                {


