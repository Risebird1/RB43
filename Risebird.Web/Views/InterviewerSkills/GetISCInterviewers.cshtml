@model IEnumerable<Risebird.Entities.ViewModel.ISCInterviewer>
@{
    ViewData["Title"] = "Interviewers";
    ViewBag.PageHeader = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
  
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Interviewers for <b>'@ViewBag.ISCName'</b></h4></div>
                </div>

                <div class="pull-right">

                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to select Interviewers." onclick="location.href='@Url.Action("SelectUnApprovedInterviewers", "InterviewerSkills", new { iscId = ViewBag.ISCId, iscName = ViewBag.ISCName})'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Select Interviewers</font></span>
                    </button>

                    @Html.ActionLink("Back", "Index", "InterviewerSkills", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button",@style="margin-right:10px;"})
                </div>
            </div>
        </div>
    </div>

    <div class="content client interviewer">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar" style="margin-bottom:10px;">


                            </div>
                            <div>

                                <div id="tableID">
                                    <table id="interviewersTbl" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>

                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Resume</th>
                                                <th>Actions</th>
                                                <th>Current Location</th>
                                                <th>Current Role</th>
                                                <th>Preffered Domain</th>
                                                <th>Total Experience</th>
                                                <th class="text-center">Call</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Resume</th>
                                                <th>Actions</th>
                                                <th>Current Location</th>
                                                <th>Current Role</th>
                                                <th>Preffered Domain</th>
                                                <th>Total Experience</th>
                                                <th class="text-center">Call</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                            <tr>

                                                @if (item.FirstName.Length > 25)
                                                {


                                                    <td class="cadName" style="width:25%">
                                                        <a onclick="" data-tooltip="@item.FirstName"> @item.FirstName.Substring(0, 25)... </a>
                                                    </td>
                                                }


                                                else
                                                {
                                                    <td class="cadName" style="width:25%">
                                                        <a onclick=""> @item.FirstName </a>
                                                    </td>
                                                }
                                                @if (item.EmailId.Length >20)
                                                {


                                                    <td class="cadEmail"  style="width:20%">
                                                        <a onclick="" data-tooltip="@item.EmailId"> @item.EmailId.Substring(0, 20)... </a>
                                                    </td>
                                                }


                                                else
                                                {
                                                    <td class="cadEmail" style="width:20%">
                                                        <a onclick=""> @item.EmailId </a>
                                                    </td>
                                                }

                                             
                                                @if (item.ResumeLink != null && item.ResumeLink != "")
                                                {
                                                    <td> <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a> </td>
                                                }
                                                else
                                                {
                                                    <td>No Resume</td>
                                                }

                                            <td class="action" style="align-items:center">
                                                @if (item.imid != null && item.imid>0)
                                                {
                                                    <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                        <span onclick="location.href = '@Url.Action("AddReport", "Interviewer", new { interviewId = item.imid, iscId = item.ISCId, backUrl = ViewBag.CurrentUrl})'" title="Report" class="mdc-fab__icon material-icons">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg>
                                                        </span>
                                                    </button>
                                                }

                                                <button class="mdc-fab app-fab--absolute" aria-label="Send Invite">
                                                    <span onclick="location.href = '@Url.Action("SendInvite", "InterviewerSkills", new { iscName = ViewBag.ISCName, iscId = ViewBag.ISCId, emailId = item.EmailId, endDate = item.EndDate, interviewerProfileId = item.InterviewerProfileId})'" title="Send Invite" class="mdc-fab__icon material-icons">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                                                    </span>
                                                </button>

                                                <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Cancel Invite">
                                                    <span onclick="location.href = '@Url.Action("CancelInvite", "InterviewerSkills", new { iscName = ViewBag.ISCName, iscId = ViewBag.ISCId, emailId = item.EmailId })'" title="Cancel Invite" class="mdc-fab__icon material-icons">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
                                                    </span>
                                                </button>



                                                <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                    <span onclick="javascript:DeleteISCInterviewer('@item.id', '@ViewBag.ISCId', '@ViewBag.ISCName');" title="Remove" class="mdc-fab__icon material-icons">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg>
                                                    </span>
                                                </button>

                                            </td>

                                                <td>@item.City</td>
                                                <td>@item.CurrentRole</td>
                                                <td>@item.PreferredDomain</td>
                                                <td>@item.Experience</td>
                                               
                                                <td class="text-center">
                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty) { 
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Click here to call the interviewer.">
                                                            <span onclick="ModalButtonClick('@item.MobileNumber', '@item.FirstName')" data-original-title="Tooltip on top" title="Click here to call the interviewer." class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg></span>
                                                        </button>
                                                    }
                                                </td>

                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>





        <!-- end row -->
    </div>

</div>

<div id="myModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">


                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Call Interviewer!</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body text-center">

                <label id="callingLabel" class="modal-title text-center"><b>Calling...</b></label>

                <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto; display: block;" class="btn btn-fill btn-danger" value="Hang Up">

            </div>

        </div>

    </div>
</div>
    <script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>


    @if (ViewBag.Message != null)
    {
        <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/IRF/Index';
                        location.reload(true);
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        //window.location.href = '/IRF/Index';
                        location.reload(true);

                    }
                )
            }

        }

        window.onload = my_code();
        </script>

    }


    <script>
        function searchResult() {
            $('#interviewersTbl').DataTable();
        }
            function RefreshSearch() {
        $('#interviewersTbl').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });
 
    function applyDataTable() {
        $('#interviewersTbl').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

       
    </script>

    <script type="text/javascript">
        //// script for loader starts here
        $(".dataloading").hide();
        $("#interviewersTbl").hide();
        var loader;
        function ShowProgress() {
            $(".dataloading").hide();
            $("#interviewersTbl").hide();
            loader = document.getElementsByClassName("loader")[0];
            loader.style.display = "block";
            var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
            var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
            loader.style.top = top + "px";
            loader.style.left = left + "px";
        };
        ShowProgress();

        window.onload = function () {
            setTimeout(function () {
                loader.style.display = "none";
                $(".dataloading").show();
                $("#interviewersTbl").show();
            }, 2000);
        };
        //// script for loader ends here

        function DeleteISCInterviewer(id, iscId, iscName) {


            swal.fire({
                title: 'Are you sure?',
                text: "The interviewer will be removed from " + iscName,
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, remove it!',
                preConfirm: function () {
                    return new Promise(function (resolve, reject) {
                        //var IdIRF = dataID;
                        $.ajax({
                            url: '/InterviewerSkills/DeleteISCInterviewer?id=' + id + '&iscId=' + iscId + '&iscName=' + iscName,
                            success: function (result) {
                                resolve(result)

                            },
                            error: function () {
                                //reject("error message")
                                swal.fire("Error removing!", "Please try again", "error");
                            }
                        })
                    })
                },
                allowOutsideClick: false
            }).then(function (result) {
                if (result.dismiss !== 'cancel') {
                    swal.fire({
                        title: 'Removed!',
                        type: 'success',
                        html: '<p>The interviewer has been removed.</p>',
                        showCancelButton: false,
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'Close!',
                        allowOutsideClick: false
                    }).then(function () {
                        location.reload(true);
                    })
                }
                else if (result.dismiss === 'cancel') {
                    swal.fire(
                        'Cancelled',
                        'The interviewer could not be removed!',
                        'error'
                    )
                }
            })
        }
    </script>

    <script>
        var interviewer = "";
        var span = document.getElementById("callPopUp");
        // When the user clicks on <span> (x), close the modal
        span.onclick = function () {
            hangUp();
            var modal = document.getElementById("myModal");
            modal.style.display = "none";
        }
        $(document).ready(function () {
            $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
                // Set up the Twilio Client Device with the token
                Twilio.Device.setup(data.token);
            });
        });

        /* Callback to let us know Twilio Client is ready */
        Twilio.Device.ready(function (device) {

        });

        function callInterviewer(phoneNumber) {
            var params = { "phoneNumber": phoneNumber };
            Twilio.Device.connect(params);
        }
        function hangUp() {
            Twilio.Device.disconnectAll();
        }

        Twilio.Device.connect(function (connection) {
            var appendText = "In call with " + "<b>" + interviewer + "</b>";
            document.getElementById("callingLabel").innerHTML = appendText;
        });

        function afterTimeOut() {
            var modal = document.getElementById("myModal");
            modal.style.display = "none";
        }

        Twilio.Device.disconnect(function (connection) {
            var appendText = "Call disconnected! ";
            document.getElementById("callingLabel").innerHTML = appendText;
            setTimeout(afterTimeOut, 2000);

        });

        function ModalButtonClick(phoneNumber, interviewerMail) {
            interviewer = interviewerMail;
            // Get the modal
            var modal = document.getElementById("myModal");
            // When the user clicks the button, open the modal
            modal.style.display = "block";
            var appendText = "Calling... " + "<b>" + interviewer + "</b>";
            document.getElementById("callingLabel").innerHTML = appendText;
            callInterviewer(phoneNumber);
        }
        function closeCallPopUp() {
            hangUp();
            var modal = document.getElementById("myModal");
            modal.style.display = "none";
        }


    </script>







