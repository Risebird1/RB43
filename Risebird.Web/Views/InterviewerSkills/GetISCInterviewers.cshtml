    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">





                                <div class="row">

                                    <div class="card-header">
                                        <div class="pull-left">  <h4 class="card-title">Interviewers for <b>'@ViewBag.ISCName'</b></h4></div>

                                        <div class="pull-right">
                                            <div>


                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                    <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to select Interviewers." onclick="location.href='@Url.Action("SelectUnApprovedInterviewers", "InterviewerSkills", new { iscId = ViewBag.ISCId, iscName = ViewBag.ISCName})'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Select Interviewers</font></span>
                                                </button>

                                                @Html.ActionLink("Back to List", "Index", "InterviewerSkills", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button", @style = "margin-top:2px" })
                                            </div>
                                        </div>
                                    </div>

                                </div>



                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                <div id="tableID">
                                    <table id="interviewersTbl" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>

                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Resume</th>
                                                <th>Actions</th>
                                                <th>Current Location</th>
                                                <th>Current Role</th>
                                                <th>Preffered Domain</th>
                                                <th>Total Experience</th>
                                                <th>Mobile Number</th>
                                                @*<th style="text-align:center">Call</th>*@

                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Resume</th>
                                                <th>Actions</th>
                                                <th>Current Location</th>
                                                <th>Current Role</th>
                                                <th>Preffered Domain</th>
                                                <th>Total Experience</th>
                                                <th>Mobile Number</th>
                                                @*<th style="text-align:center">Call</th>*@

                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {

                                                <tr>

                                                    <td> @item.FirstName</td>
                                                    <td> @item.EmailId</td>
                                                    @if (item.ResumeLink != null && item.ResumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }

                                                    <td class="action" style="align-items:center">
                                                        <button class="mdc-fab app-fab--absolute" aria-label="Send Invite">
                                                            <span onclick="location.href = '@Url.Action("SendInvite", "InterviewerSkills", new { iscName = ViewBag.ISCName, iscId = ViewBag.ISCId, emailId = item.EmailId, endDate = item.EndDate, interviewerProfileId = item.InterviewerProfileId})'" title="Send Invite" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                                                            </span>
                                                        </button>

                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Cancel Invite">
                                                            <span onclick="location.href = '@Url.Action("CancelInvite", "InterviewerSkills", new { iscName = ViewBag.ISCName, iscId = ViewBag.ISCId, emailId = item.EmailId })'" title="Cancel Invite" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
                                                            </span>
                                                        </button>
                                                        @*<button class="mdc-fab app-fab--absolute" aria-label="Send Invite">
                                                                <span onclick="location.href = '@Url.Action("SendInvite", "IRF", new { IRFName = ViewBag.IRFName, irfId = ViewBag.IRFId, emailId = item.EmailId, endDate = item.EndDate })'" title="Send Invite" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                                                                </span>
                                                            </button>*@


                                                        @*<button class="mdc-fab app-fab--absolute trash-btn" aria-label="Cancel Invite">
                                                                <span onclick="location.href = '@Url.Action("CancelInvite", "IRF", new { IRFName = ViewBag.IRFName, irfId = ViewBag.IRFId, emailId = item.EmailId })'" title="Cancel Invite" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
                                                                </span>
                                                            </button>*@


                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                            <span onclick="javascript:DeleteISCInterviewer('@item.id', '@ViewBag.ISCId', '@ViewBag.ISCName');" title="Remove" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg>
                                                            </span>
                                                        </button>



                                                        @*<button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                <span onclick="location.href = '@Url.Action("InterviewerReport", "InterviewerSkills", new { candidateId = item.CandidateMasterId, irfId= item.IRFId})'" title="Report" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg>
                                                                </span>
                                                            </button>*@




                                                    </td>

                                                    <td>@item.City</td>
                                                    <td>@item.CurrentRole</td>
                                                    <td>@item.PreferredDomain</td>
                                                    <td>@item.Experience</td>
                                                    <td>@item.MobileNumber</td>



                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>





        <!-- end row -->
    </div>

</div>

