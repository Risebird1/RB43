    function TechSkillChanged() {
        var Assessmentgroupid = $("#AssessmentGroupId").val();
        var skills = "";
        var interviewerSkills;
        $.ajax({
            type: "GET",
            url: "/InterviewerSkills/GetInterviewersByAssessmentGroup",
            data: { 'assessmentgroupid': Assessmentgroupid },
            success: function (data) {
                $.ajax({
                    type: "GET",
                    async: false,
                    url: "/IRF/GetInterviewerSkills",
                    data: { 'id': data[0].value },
                    success: function (result) {
                        interviewerSkills = result;
                    }
                });
                var drpdowns = $('[id^="InterviewerCollection"][id$="UserId"]');
                for (i = 0; i < drpdowns.length; i++) {
                    $("#" + drpdowns[i].id + " option").remove();
                }
                if (data.length > 0) {
                    for (i = 0; i < drpdowns.length; i++) {
                        $(data).each(function () {
                            var option = $("<option />");
                            option.html(this.text);
                            option.val(this.value);
                            $("#" + drpdowns[i].id).append(option);
                        });
                        //interviewerids = $("#txtinterviewerids").val();
