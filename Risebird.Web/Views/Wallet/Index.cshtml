@{
    ViewData["Title"] = "Wallet Details";
    ViewBag.PageHeader = "Wallet Details";
    if (ViewBag.PageStatus == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
}
@if (ViewBag.PageStatus == "Public")
{
    <style>

        .sidebar-mini .main-panel {
            width: calc(100% - 0px);
        }

    </style>
}
<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title-space" style="color:#fff; margin:0;">
                        <i class="fa fa-wallet"></i> Wallet Details
                    </h4>
                </div>
                <div class="pull-right">
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg razorpay_con">
                    <input type="hidden" value="@ViewBag.BillingType" id="txtBillingType" />
                    <input type="hidden" value="@ViewBag.ClientId" id="txtClientId" />
                    <input type="hidden" value="@ViewBag.BillingOwnerId" id="txtBillingOwnerId" />

                    <div class="row date-filter-row" style="padding: 20px; background: #f5f5f5; margin: 15px; border-radius: 5px;">
                        <div class="col-md-12">
                            <label class="date-filter-label">Date filter</label>
                            <div class="date-filter-controls">
                                <div class="form-group">
                                    <label for="txtStartDate">Start Date</label>
                                    <input type="date" id="txtStartDate" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label for="txtEndDate">End Date</label>
                                    <input type="date" id="txtEndDate" class="form-control" />
                                </div>
                                <div class="form-group date-filter-actions">
                                    <label>&nbsp;</label>
                                    <button type="button" class="btn btn-primary" id="btnApplyDateFilter" onclick="ApplyDateFilterAndFetch()">
                                        <i class="fa fa-filter"></i> Apply Filter
                                    </button>
                                    <button type="button" class="btn btn-secondary" id="btnClearDateFilter" onclick="ClearDateFilterAndFetch()">
                                        <i class="fa fa-times"></i> Clear
                                    </button>
                                </div>
                            </div>
                            <div id="dateFilterValidationMsg" class="text-danger small mt-2" style="display: none;"></div>
                        </div>
                    </div>
                    <!-- Balance Display -->
                    @* <div class="row" style="padding: 20px; background: #f5f5f5; margin: 15px; border-radius: 5px;">
                        <div class="col-md-6">
                            <h4 style="margin: 0; color: #333;">Current Balance</h4>
                            <h2 style="margin: 10px 0 0 0; color: #4CAF50; font-weight: bold;" id="currentBalance">
                                @(ViewBag.CurrentBalance != null ? ViewBag.CurrentBalance.ToString("N0") : "0")
                            </h2>
                        </div>
                        <div class="col-md-6 text-right" style="padding-top: 20px;">
                            <span style="color: #666; font-size: 14px;">
                                Billing Type: 
                                <strong>@(ViewBag.BillingType == 1 ? "Billing Owner" : "Client")</strong>
                            </span>
                        </div>
                    </div> *@

                    <!-- Filter Buttons -->
                    <div class="mdc-card-wrapper__text-section razorpay_btn">
                        <div style="padding:0px">
                            <button class="form-control" id="btnall" onclick="FetchTransaction('All')">
                                <i class="fa fa-money-bill"></i> All Transactions
                            </button>
                        </div>
                        <div style="padding:0px">
                            <button class="form-control" id="btncredit" onclick="FetchTransaction('CREDIT')">
                                <i class="fas fa-credit-card"></i> CREDIT
                            </button>
                        </div>
                        <div style="padding:0px">
                            <button class="form-control" id="btndebit" onclick="FetchTransaction('DEBIT')">
                                <i class="fa fa-credit-card"></i> DEBIT
                            </button>
                        </div>
                        <div class="balance-section">
                            <h4 style="margin: 0; color: #333; white-space: nowrap;">Current Balance:</h4>
                            @{
                                var balance = ViewBag.CurrentBalance != null ? (decimal)ViewBag.CurrentBalance : 0;
                                var balanceColor = balance >= 0 ? "#4CAF50" : "#e74c3c";
                            }
                            <h2 style="margin: 0; color: @balanceColor; font-weight: bold; white-space: nowrap;" id="currentBalance">
                                @balance.ToString("N0")
                            </h2>
                        </div>
                    </div>
                    <!-- Transaction Details -->
                    <div id="divtransaction" class="razorpay_details" style="margin-top:0px;padding:0px 20px 20px 20px;">
                        <div class="text-center" style="padding: 40px;">
                            <i class="fa fa-spinner fa-spin fa-3x" style="color: #b4cee8;"></i>
                            <p style="margin-top: 15px; color: #666;">Loading transactions...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var _currentActionType = 'All';

    jQuery(document).ready(function ($) {
        FetchTransaction('All');
    });

    function validateDateFilter() {
        var startVal = $("#txtStartDate").val();
        var endVal = $("#txtEndDate").val();
        var $msg = $("#dateFilterValidationMsg");
        $msg.hide().text('');
        if (!startVal || !endVal) return true;
        var start = new Date(startVal);
        var end = new Date(endVal);
        if (start > end) {
            $msg.text('Start date must be less than or equal to end date.').show();
            return false;
        }
        return true;
    }

    function ApplyDateFilterAndFetch() {
        if (!validateDateFilter()) return;
        FetchTransaction(_currentActionType);
    }

    function ClearDateFilterAndFetch() {
        $("#txtStartDate").val('');
        $("#txtEndDate").val('');
        $("#dateFilterValidationMsg").hide().text('');
        FetchTransaction(_currentActionType);
    }

    function FetchTransaction(actiontype) {
        _currentActionType = actiontype;

        var startVal = $("#txtStartDate").val();
        var endVal = $("#txtEndDate").val();
        if (startVal && endVal && !validateDateFilter()) return;

        // Update button states
        if (actiontype == "All") {
            $("#btnall").addClass("active-razorbtn");
            $("#btncredit").removeClass("active-razorbtn");
            $("#btndebit").removeClass("active-razorbtn");
        } else if (actiontype == "DEBIT") {
            $("#btnall").removeClass("active-razorbtn");
            $("#btncredit").removeClass("active-razorbtn");
            $("#btndebit").addClass("active-razorbtn");
        }
        else if (actiontype == "CREDIT") {
            $("#btnall").removeClass("active-razorbtn");
            $("#btncredit").addClass("active-razorbtn");
            $("#btndebit").removeClass("active-razorbtn");
        }

        // Show loading
        $("#divtransaction").html('<div class="text-center" style="padding: 40px;"><i class="fa fa-spinner fa-spin fa-3x" style="color: #b4cee8;"></i><p style="margin-top: 15px; color: #666;">Loading transactions...</p></div>');

        var payload = {
            billingType: $("#txtBillingType").val(),
            clientId: $("#txtClientId").val() || null,
            billingOwnerId: $("#txtBillingOwnerId").val() || null,
            actiontype: actiontype
        };
        if (startVal) payload.startDate = startVal;
        if (endVal) payload.endDate = endVal;

        $.ajax({
            type: "POST",
            url: "/Wallet/GetWalletDetails",
            data: payload,
            success: function (response) {
                $("#divtransaction").html(response);
            },
            error: function (xhr, status, error) {
                $("#divtransaction").html('<div class="alert alert-danger" style="margin: 20px;">An error occurred while loading transactions. Please try again.</div>');
                console.error("Error:", error);
            }
        });
    }
</script>

<style>
    html, body {
        overflow-x: hidden !important;
    }

    .main-panel {
        overflow-x: hidden !important;
        max-width: 100vw;
    }

        .main-panel > .ps__rail-x,
        .ps__rail-x {
            display: none !important;
        }

    .content {
        overflow-x: hidden !important;
    }

    .row {
        margin-left: 0;
        margin-right: 0;
    }

    .active-razorbtn {
        background-color: #4CAF50 !important;
        color: white !important;
    }

    .razorpay_btn {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 5px;
        margin: 15px;
    }

        .razorpay_btn button {
            flex: 1;
            min-width: 100px;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 5px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 500;
        }

            .razorpay_btn button:hover {
                background-color: #f0f0f0;
                border-color: #4CAF50;
            }

    .balance-section {
        margin-left: auto;
        margin-right: 40px;
        text-align: right;
        display: flex;
        align-items: center;
        gap: 10px;
        flex: none;
    }

    @@media (max-width: 768px) {
        .razorpay_btn {
            flex-wrap: wrap;
        }

            .razorpay_btn > div:not(.balance-section) {
                flex: 1 1 30%;
            }

            .razorpay_btn button {
                width: 100%;
                padding: 8px;
                font-size: 12px;
            }

        .balance-section {
            width: 100%;
            justify-content: center;
            margin-left: 0;
            margin-top: 10px;
        }

            .balance-section h4 {
                font-size: 14px;
            }

            .balance-section h2 {
                font-size: 20px;
            }
    }

    .razorpay_details {
        min-height: 200px;
    }

    .table th {
        background-color: #f8f9fa !important;
        color: #333;
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 3px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-info {
        background-color: #17a2b8;
        color: white;
    }

    .badge-warning {
        background-color: #ffc107;
        color: #333;
    }

    .badge-secondary {
        background-color: #6c757d;
        color: white;
    }

    .date-filter-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
        display: block;
    }

    .date-filter-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 15px;
    }

    .date-filter-controls .form-group {
        margin-bottom: 0;
    }

    .date-filter-controls .form-group label {
        font-size: 13px;
        color: #555;
        margin-bottom: 5px;
        display: block;
    }

    .date-filter-controls .form-control {
        min-width: 160px;
    }

    .date-filter-actions .btn {
        margin-right: 8px;
    }

    .date-filter-actions .btn:last-child {
        margin-right: 0;
    }

    @@media (max-width: 768px) {
        .date-filter-controls {
            flex-direction: column;
            align-items: stretch;
        }

        .date-filter-controls .form-control {
            min-width: 100%;
        }
    }
</style>

