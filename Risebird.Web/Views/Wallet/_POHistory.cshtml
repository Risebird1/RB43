@model List<Risebird.Entities.ViewModel.ClientPOVM>

<style>
    .po-hist-summary {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .po-hist-stat {
        flex: 1;
        min-width: 140px;
        background: #f5f7fa;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 10px 14px;
        text-align: center;
    }
    .po-hist-stat .stat-label {
        font-size: 11px;
        color: #888;
        font-family: Roboto, sans-serif;
        font-weight: 500;
        letter-spacing: .3px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    .po-hist-stat .stat-value {
        font-size: 15px;
        font-weight: 700;
        font-family: Roboto, sans-serif;
        color: #333;
    }
    .po-hist-stat.stat-pending .stat-value { color: #c62828; }
    .po-hist-stat.stat-received .stat-value { color: #2e7d32; }
    .po-hist-stat.stat-credit .stat-value  { color: #1565c0; }

    .po-hist-table thead th {
        background: #e8eaf6 !important;
        color: #3949ab !important;
        font-size: 12px;
        font-family: Roboto, sans-serif;
        font-weight: 600;
        white-space: nowrap;
        padding: 8px 10px !important;
        border: 1px solid #c5cae9 !important;
        vertical-align: middle !important;
    }
    .po-hist-table tbody td {
        font-size: 12px;
        font-family: Roboto, sans-serif;
        color: #444;
        vertical-align: middle !important;
        padding: 7px 10px !important;
    }
    .po-hist-table tbody tr:hover { background: #f3f4ff; }
    .po-hist-note {
        font-size: 12px;
        color: #777;
        font-family: Roboto, sans-serif;
        margin-bottom: 14px;
    }
    .po-pdf-link {
        font-size: 12px;
        color: #1976d2;
        text-decoration: none;
        white-space: nowrap;
    }
    .po-pdf-link:hover { text-decoration: underline; }
</style>

<p class="po-hist-note">Overall PO history for this client (all periods).</p>

@if (Model != null && Model.Any())
{
    var totalPOCredit     = Model.Sum(x => x.POCreditAmount);
    var totalCashReceived = Model.Sum(x => x.CashCreditReceived);
    var totalPending      = totalPOCredit - totalCashReceived;

    <div class="po-hist-summary">
        <div class="po-hist-stat stat-credit">
            <div class="stat-label">Total PO Credit</div>
            <div class="stat-value">&#8377; @totalPOCredit.ToString("N0")</div>
        </div>
        <div class="po-hist-stat stat-received">
            <div class="stat-label">Cash Received</div>
            <div class="stat-value">&#8377; @totalCashReceived.ToString("N0")</div>
        </div>
        <div class="po-hist-stat stat-pending">
            <div class="stat-label">Pending</div>
            <div class="stat-value">&#8377; @totalPending.ToString("N0")</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered po-hist-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>PO Number</th>
                    @if ((int)ViewBag.BillingType == 1) { <th>Billing Owner</th> }
                    <th class="text-right">PO Credit</th>
                    <th class="text-right">Cash Received</th>
                    <th class="text-right">Pending</th>
                    <th>Added By</th>
                    <th>Added On</th>
                    <th>Document</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model)
                {
                    <tr>
                        <td style="white-space:nowrap;">@po.PeriodLabel</td>
                        <td>@(string.IsNullOrEmpty(po.PONumber) ? "—" : po.PONumber)</td>
                        @if ((int)ViewBag.BillingType == 1)
                        {
                            <td>@(string.IsNullOrEmpty(po.BillingOwnerEmail) ? "—" : po.BillingOwnerEmail)</td>
                        }
                        <td class="text-right" style="white-space:nowrap;">
                            @(po.POCreditAmount > 0 ? "₹ " + po.POCreditAmount.ToString("N0") : "—")
                        </td>
                        <td class="text-right" style="white-space:nowrap;color:@(po.CashCreditReceived > 0 ? "#2e7d32" : "inherit");">
                            @(po.CashCreditReceived > 0 ? "₹ " + po.CashCreditReceived.ToString("N0") : "—")
                        </td>
                        <td class="text-right" style="white-space:nowrap;color:@(po.PendingCashCredit > 0 ? "#c62828" : "#2e7d32");font-weight:600;">
                            @(po.POCreditAmount > 0 ? "₹ " + po.PendingCashCredit.ToString("N0") : "—")
                        </td>
                        <td style="white-space:nowrap;">@(po.CreatedBy ?? "—")</td>
                        <td style="white-space:nowrap;">@(po.CreatedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(po.PODocumentUrl))
                            {
                                <a href="@po.PODocumentUrl" target="_blank" class="po-pdf-link">
                                    <i class="fa fa-file-pdf-o" style="margin-right:3px;"></i>View PDF
                                </a>
                            }
                            else { <span style="color:#aaa;">—</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div style="text-align:center;padding:30px 20px;color:#999;font-size:13px;font-family:Roboto,sans-serif;">
        <i class="fa fa-inbox fa-2x" style="display:block;margin-bottom:8px;"></i>
        No PO history found for this client.
    </div>
}
