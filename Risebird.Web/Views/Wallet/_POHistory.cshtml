@model List<Risebird.Entities.ViewModel.ClientPOVM>
@using System.Globalization

<style>
    .po-hist-summary {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }
    .po-hist-stat {
        flex: 1;
        min-width: 140px;
        background: #f5f7fa;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 10px 14px;
        text-align: center;
    }
    .po-hist-stat .stat-label {
        font-size: 11px;
        color: #888;
        font-family: Roboto, sans-serif;
        font-weight: 500;
        letter-spacing: .3px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    .po-hist-stat .stat-value {
        font-size: 15px;
        font-weight: 700;
        font-family: Roboto, sans-serif;
        color: #333;
    }
    .po-hist-stat.stat-pending .stat-value  { color: #c62828; }
    .po-hist-stat.stat-received .stat-value { color: #2e7d32; }
    .po-hist-stat.stat-credit .stat-value   { color: #1565c0; }

    .po-hist-table thead th {
        background: #e8eaf6 !important;
        color: #3949ab !important;
        font-size: 12px;
        font-family: Roboto, sans-serif;
        font-weight: 600;
        white-space: nowrap;
        padding: 8px 10px !important;
        border: 1px solid #c5cae9 !important;
        vertical-align: middle !important;
    }
    .po-hist-table tbody td {
        font-size: 12px;
        font-family: Roboto, sans-serif;
        color: #444;
        vertical-align: middle !important;
        padding: 7px 10px !important;
    }
    .po-hist-table tbody tr:hover { background: #f3f4ff; }
    .po-hist-table tbody tr.po-carry-fwd  { background: #fffde7; }
    .po-hist-table tbody tr.po-carry-fwd:hover { background: #fff9c4; }
    .po-hist-table tbody tr.po-completed  { opacity: .7; }
    .po-hist-note {
        font-size: 12px;
        color: #777;
        font-family: Roboto, sans-serif;
        margin-bottom: 14px;
    }
    .po-pdf-link {
        font-size: 12px;
        color: #1976d2;
        text-decoration: none;
        white-space: nowrap;
    }
    .po-pdf-link:hover { text-decoration: underline; }
    .po-tag {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 10px;
        letter-spacing: .3px;
        white-space: nowrap;
    }
    .po-tag-current   { background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; }
    .po-tag-carry     { background: #fff8e1; color: #e65100; border: 1px solid #ffcc80; }
    .po-tag-completed { background: #f1f8e9; color: #33691e; border: 1px solid #aed581; }
    .po-tag-expired  { background: #ffebee; color: #b71c1c; border: 1px solid #ef9a9a; }
    .po-tag-expiring { background: #fff3e0; color: #e65100; border: 1px solid #ffcc80; }
    .po-hist-table tbody tr.po-expired  { background: #ffebee; }
    .po-hist-table tbody tr.po-expiring { background: #fff8e1; }
</style>

@{
    var filterMonth   = ViewBag.FilterMonth   as int?;
    var filterYear    = ViewBag.FilterYear    as int?;
    var ownerFiltered = ViewBag.OwnerFiltered is bool b  && b;
    var fifoApplied   = ViewBag.FifoApplied   is bool fa && fa;
    var billingType   = (int)(ViewBag.BillingType ?? 3);

    string periodNote;
    if (filterMonth.HasValue && filterYear.HasValue)
    {
        var mn = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(filterMonth.Value);
        periodNote = ownerFiltered
            ? $"PO history for this billing owner — showing <strong>{mn} {filterYear}</strong> POs and any carry-forward balance from previous months."
            : $"PO history for <strong>{mn} {filterYear}</strong> — showing consumption per billing owner with carry-forward.";
    }
    else
    {
        periodNote = billingType == 1
            ? "Overall PO history — consumption shown per billing owner (oldest PO consumed first, carry-forward applied)."
            : "Overall PO history for this client (all periods, carry-forward applied).";
    }

    // Classify a PO relative to the filter period
    string ClassifyPO(Risebird.Entities.ViewModel.ClientPOVM po)
    {
        if (!filterMonth.HasValue || !filterYear.HasValue) return "overall";
        var poDate     = new DateTime(po.POYear,  po.POMonth,  1);
        var filterDate = new DateTime(filterYear.Value, filterMonth.Value, 1);
        if (poDate == filterDate) return "current";
        if (poDate < filterDate)
        {
            var hasBalance = fifoApplied ? po.WalletRemaining > 0 : po.PendingCashCredit > 0;
            return hasBalance ? "carryforward" : "completed";
        }
        return "future";
    }
}

<p class="po-hist-note">@Html.Raw(periodNote)</p>

@if (filterMonth.HasValue && filterYear.HasValue)
{
    <div style="margin-bottom:10px;font-size:12px;color:#555;">
        <span class="po-tag po-tag-current" style="margin-right:6px;">Current Month</span> PO raised in the selected month &nbsp;·&nbsp;
        <span class="po-tag po-tag-carry" style="margin-right:6px;">Carry Forward</span> Previous PO with remaining balance &nbsp;·&nbsp;
        <span class="po-tag po-tag-completed">Fully Consumed</span> Previous PO fully utilised
    </div>
}

@if (Model != null && Model.Any())
{
    // Summary uses ALL POs so Credit / Consumed / Remaining represent the full picture.
    // In month-filter mode the "Consumed" figure shows cumulative consumption up to that
    // month (thanks to the FIFO ledger replaying all months chronologically).
    var totalPOCredit  = Model.Sum(x => x.POCreditAmount);
    var totalConsumed  = fifoApplied
        ? Model.Sum(x => x.WalletConsumed)
        : Model.Sum(x => Math.Min(x.CashCreditReceived, x.POCreditAmount));
    var totalRemaining = fifoApplied
        ? Model.Sum(x => x.WalletRemaining)
        : Model.Sum(x => x.POCreditAmount - Math.Min(x.CashCreditReceived, x.POCreditAmount));

    <div class="po-hist-summary">
        <div class="po-hist-stat stat-credit">
            <div class="stat-label">Total PO Credit</div>
            <div class="stat-value">&#8377; @totalPOCredit.ToString("N0")</div>
        </div>
        <div class="po-hist-stat stat-received">
            <div class="stat-label">Total Consumed</div>
            <div class="stat-value">&#8377; @totalConsumed.ToString("N0")</div>
        </div>
        <div class="po-hist-stat stat-pending">
            <div class="stat-label">Total Remaining</div>
            <div class="stat-value">&#8377; @totalRemaining.ToString("N0")</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered po-hist-table">
            <thead>
                <tr>
                    <th>Period</th>
                    @if (filterMonth.HasValue) { <th>Type</th> }
                    <th>PO Number</th>
                    @if (billingType == 1 && !ownerFiltered) { <th>Billing Owner</th> }
                    <th class="text-right">PO Quantity</th>
                    <th class="text-right">PO Credit</th>
                    <th class="text-right">Consumed</th>
                    <th class="text-right">Remaining</th>
                    <th>Usage</th>
                    <th>Added By</th>
                    <th>Added On</th>
                    <th>Expire Date</th>
                    <th>Expiry Status</th>
                    <th>Document</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model.OrderBy(x => x.POYear).ThenBy(x => x.POMonth).ThenBy(x => x.CreatedOn ?? DateTime.MaxValue))
                {
                    var classification = ClassifyPO(po);

                    // In month-filter mode, hide future POs entirely
                    if (filterMonth.HasValue && classification == "future") { continue; }

                    // Use FIFO-computed values when available; fall back to cash-credit-received.
                    // Cap consumed at POCreditAmount on individual rows — overflow shows only in owner total.
                    var consumed  = fifoApplied
                        ? Math.Min(po.WalletConsumed, po.POCreditAmount)
                        : Math.Min(po.CashCreditReceived, po.POCreditAmount);
                    var remaining = Math.Max(0m, po.POCreditAmount - consumed);
                    var usedPct   = po.POCreditAmount > 0 ? Math.Min(100, (int)Math.Round(consumed / po.POCreditAmount * 100)) : 0;

                    string rowCss = classification switch {
                        "carryforward" => "po-carry-fwd",
                        "completed"    => "po-completed",
                        _              => ""
                    };
                    if (po.IsExpired) rowCss += " po-expired";
                    else if (po.IsExpiringSoon) rowCss += " po-expiring";

                    <tr class="@rowCss">
                        <td style="white-space:nowrap;">@po.PeriodLabel</td>
                        @if (filterMonth.HasValue)
                        {
                            <td>
                                @if (classification == "current")
                                { <span class="po-tag po-tag-current">Current Month</span> }
                                else if (classification == "carryforward")
                                { <span class="po-tag po-tag-carry">Carry Forward</span> }
                                else if (classification == "completed")
                                { <span class="po-tag po-tag-completed">Fully Consumed</span> }
                                else
                                { <span style="color:#aaa;">—</span> }
                            </td>
                        }
                        <td>@(string.IsNullOrEmpty(po.PONumber) ? "—" : po.PONumber)</td>
                        @if (billingType == 1 && !ownerFiltered)
                        {
                            <td>@(string.IsNullOrEmpty(po.BillingOwnerEmail) ? "—" : po.BillingOwnerEmail)</td>
                        }
                        <td class="text-right">@(po.POQuantity.HasValue ? po.POQuantity.Value.ToString("N0") : "—")</td>
                        <td class="text-right" style="white-space:nowrap;font-weight:600;color:#1565c0;">
                            @(po.POCreditAmount > 0 ? "₹ " + po.POCreditAmount.ToString("N0") : "—")
                        </td>
                        <td class="text-right" style="white-space:nowrap;color:@(consumed > 0 ? "#2e7d32" : "inherit");">
                            @(consumed > 0 ? "₹ " + consumed.ToString("N0") : "—")
                        </td>
                        <td class="text-right" style="white-space:nowrap;font-weight:600;color:@(remaining > 0 ? "#1565c0" : "#2e7d32");">
                            @(po.POCreditAmount > 0 ? "₹ " + remaining.ToString("N0") : "—")
                        </td>
                        <td style="min-width:100px;">
                            @if (po.POCreditAmount > 0)
                            {
                                <div style="display:flex;align-items:center;gap:6px;">
                                    <div style="flex:1;height:6px;background:#eee;border-radius:3px;overflow:hidden;">
                                        <div style="width:@usedPct%;height:100%;background:@(usedPct >= 100 ? "#2e7d32" : usedPct >= 80 ? "#c62828" : "#1976d2");border-radius:3px;"></div>
                                    </div>
                                    <span style="font-size:11px;color:#555;white-space:nowrap;">@usedPct%</span>
                                </div>
                            }
                            else { <span style="color:#aaa;">—</span> }
                        </td>
                        <td style="white-space:nowrap;">@(po.CreatedBy ?? "—")</td>
                        <td style="white-space:nowrap;">@(po.EffectiveAddedDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td style="white-space:nowrap;">@(po.ExpireDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td><span class="badge @po.ExpiryStatusCss" style="font-size:10px;">@po.ExpiryStatusDesc</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(po.PODocumentUrl))
                            {
                                <a href="@po.PODocumentUrl" target="_blank" class="po-pdf-link">
                                    <i class="fa fa-file-pdf-o" style="margin-right:3px;"></i>View PDF
                                </a>
                            }
                            else { <span style="color:#aaa;">—</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div style="text-align:center;padding:30px 20px;color:#999;font-size:13px;font-family:Roboto,sans-serif;">
        <i class="fa fa-inbox fa-2x" style="display:block;margin-bottom:8px;"></i>
        No PO history found.
    </div>
}
