@model List<Risebird.Entities.ViewModel.ClientPOVM>

<div class="wallet-history-panel">
    <p class="text-muted" style="font-size:13px;margin-bottom:12px;">
        Overall PO history for this client (all periods).
    </p>
    @if (Model != null && Model.Any())
    {
        var totalPOCredit = Model.Sum(x => x.POCreditAmount);
        var totalCashReceived = Model.Sum(x => x.CashCreditReceived);
        <div style="margin-bottom:12px;">
            <span class="badge badge-info">Total PO Credit: &#8377;@totalPOCredit.ToString("N0")</span>
            <span class="badge badge-success">Total Cash Received: &#8377;@totalCashReceived.ToString("N0")</span>
            <span class="badge badge-warning">Pending: &#8377;@((totalPOCredit - totalCashReceived).ToString("N0"))</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm journey">
                <thead>
                    <tr>
                        <th>Period</th>
                        <th>PO Number</th>
                        @if ((int)ViewBag.BillingType == 1) { <th>Billing Owner</th> }
                        <th class="text-right">PO Credit</th>
                        <th class="text-right">Cash Received</th>
                        <th class="text-right">Pending</th>
                        <th>Status</th>
                        <th>Added By</th>
                        <th>Added On</th>
                        <th>Document</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var po in Model)
                    {
                        <tr>
                            <td>@po.PeriodLabel</td>
                            <td>@(string.IsNullOrEmpty(po.PONumber) ? "—" : po.PONumber)</td>
                            @if ((int)ViewBag.BillingType == 1)
                            {
                                <td>@(string.IsNullOrEmpty(po.BillingOwnerEmail) ? "—" : po.BillingOwnerEmail)</td>
                            }
                            <td class="text-right">@(po.POCreditAmount > 0 ? "₹ " + po.POCreditAmount.ToString("N0") : "—")</td>
                            <td class="text-right">@(po.CashCreditReceived > 0 ? "₹ " + po.CashCreditReceived.ToString("N0") : "—")</td>
                            <td class="text-right">@(po.POCreditAmount > 0 ? "₹ " + po.PendingCashCredit.ToString("N0") : "—")</td>
                            <td><span class="badge @po.StatusCss">@po.StatusDesc</span></td>
                            <td>@po.CreatedBy</td>
                            <td>@(po.CreatedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(po.PODocumentUrl))
                                {
                                    <a href="@po.PODocumentUrl" target="_blank">View PDF</a>
                                }
                                else { <span>—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No PO history found for this client.</div>
    }
</div>
