@model List<Risebird.Entities.ViewModel.WalletVM>

<style>
    .cash-hist-table th {
        background: #e8eaf6 !important;
        color: #3949ab !important;
        font-size: 12px;
        font-family: Roboto, sans-serif;
        font-weight: 600;
        white-space: nowrap;
        padding: 8px 10px !important;
        border: 1px solid #c5cae9 !important;
        vertical-align: middle !important;
    }
    .cash-hist-table td {
        font-size: 12px;
        font-family: Roboto, sans-serif;
        color: #444;
        vertical-align: middle !important;
        padding: 7px 10px !important;
        /* allow long text to wrap */
        word-break: break-word;
        white-space: normal;
    }
    /* columns that should never wrap */
    .cash-hist-table td.nowrap { white-space: nowrap; }
    /* cap max-width on heavy-text columns */
    .cash-hist-table td.col-ref     { max-width: 200px; }
    .cash-hist-table td.col-owner   { max-width: 180px; }
    .cash-hist-table td.col-addedby { max-width: 180px; }
    .cash-hist-table tbody tr:hover { background: #f3f4ff; }
</style>

<div class="wallet-history-panel">
    <p class="text-muted" style="font-size:13px;margin-bottom:12px;">
        Overall cash credit additions posted to wallet (all periods).
    </p>
    @if (Model != null && Model.Any())
    {
        var totalCash = Model.Sum(x => x.Credit);
        <div style="display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;">
            <span style="background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7;border-radius:6px;padding:5px 14px;font-size:13px;font-family:Roboto,sans-serif;font-weight:600;">
                &#8377; @totalCash.ToString("N0") <span style="font-weight:400;color:#555;font-size:12px;">Total Cash Added</span>
            </span>
            <span style="background:#e3f2fd;color:#1565c0;border:1px solid #90caf9;border-radius:6px;padding:5px 14px;font-size:13px;font-family:Roboto,sans-serif;font-weight:600;">
                @Model.Count <span style="font-weight:400;color:#555;font-size:12px;">Entries</span>
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm journey cash-hist-table">
                <thead>
                    <tr>
                        <th>Transaction Date</th>
                        <th>Reference</th>
                        @if ((int)ViewBag.BillingType == 1) { <th>Billing Owner</th> }
                        <th>Linked PO</th>
                        <th class="text-right">Amount</th>
                        <th>Type</th>
                        <th>Added By</th>
                        <th>Wallet Entry Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="nowrap">@(item.TransactionDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td class="col-ref">@(string.IsNullOrEmpty(item.TransactionRefNumber) ? "—" : item.TransactionRefNumber)</td>
                            @if ((int)ViewBag.BillingType == 1)
                            {
                                <td class="col-owner">@(string.IsNullOrEmpty(item.BillingOwnerEmail) ? "—" : item.BillingOwnerEmail)</td>
                            }
                            <td class="col-ref">@(string.IsNullOrEmpty(item.PONumber) ? "—" : item.PONumber)</td>
                            <td class="text-right nowrap" style="font-weight:600;color:#1565c0;">&#8377; @item.Credit.ToString("N0")</td>
                            <td class="nowrap">@item.TransactionType</td>
                            <td class="col-addedby">@item.CreatedBy</td>
                            <td class="nowrap">@(item.CreatedOn?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No cash credit history found for this client.</div>
    }
</div>
