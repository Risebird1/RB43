<div id="AddWalletBalanceModal" class="modal modal-bg" style="display:none;">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <!-- Header -->
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i class="fas fa-wallet publicsharing-icon" style="font-size:23px;"></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Add Wallet Balance</h5>
            </div>

            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseAddWalletBalanceModal()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>

            <!-- Body -->
            <div class="modal-body">

                <!-- Credit Balance -->
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Credit Balance</label>
                        <input type="number" id="txtCreditBalance" class="form-control" />
                        <input type="hidden" id="txtClientIdWallet" value="@ViewBag.Clientid" />
                        <input type="hidden" id="txtBillingType" value="@ViewBag.BillingType" />
                    </div>
                </div>

                <!-- Billing Type -->
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Billing Type</label>
                        <input type="text"
                               class="form-control"
                               style="background:#fff;"
                               value="@(ViewBag.BillingType == 1 ? "Billing Owner" : "Client")"
                               readonly />
                    </div>
                </div>

                <!-- Client HR User (ONLY for Billing Owner) -->
                @if (ViewBag.BillingType == 1)

                {
                    <div class="col-md-12" id="divClientHRUser">
                        <div class="form-group">
                            <label>Client HR User</label>

                            @Html.DropDownList(
                                     "ClientUserId",
                                     ViewBag.ClientUser as SelectList,
                                     "-- Select User --",
                                     new { @class = "select-css form-control" }
                                     )
                        </div>
                    </div>
                }

                <!-- Buttons -->
                <div class="col-md-12">
                    <div class="text-right mt-10">
                        <input type="button"
                               class="mdc-button mdc-button--raised card-title-space"
                               style="color:#fff; line-height:13px;"
                               onclick="AddWalletBalance()"
                               value="Add Balance" />

                        <input type="button"
                               class="mdc-button mdc-button--raised card-title-space"
                               style="color:#fff; line-height:13px;"
                               onclick="CloseAddWalletBalanceModal()"
                               value="Close" />
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
