<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label>Credit Balance</label>
            <input type="number" id="txtCreditBalance" class="form-control" />
            <input type="hidden" id="hidClientIdWallet" value="@ViewBag.Clientid" />
            <input type="hidden" id="hidBillingType" value="@ViewBag.BillingType" />
        </div>
    </div>
    <!-- Billing Type -->
    <div class="col-md-12">
        <div class="form-group">
            <label>Billing Type</label>
            <input type="text" class="form-control" style="background:#fff;" value="@(ViewBag.BillingType == 1 ? "Billing Owner" : "Client")" readonly />
        </div>
    </div>
    <!-- Client HR User (ONLY for Billing Owner) -->
    @if (ViewBag.BillingType == 1)
    {
        <div class="col-md-12" id="divClientHRUser">
            <div class="form-group">
                <label>Client HR User</label>
                @Html.DropDownList("BillingOwnerUserId", ViewBag.ClientUser as SelectList, new { @class = "select-css form-control" })
            </div>
        </div>
    }
    else
    {
        <input type="hidden" id="BillingOwnerUserId" />
    }
    <!-- Buttons -->
    <div class="col-md-12">
        <div class="text-right mt-10">
            <input type="button" class="mdc-button mdc-button--raised card-title-space" style="color:#fff; line-height:13px;" onclick="AddWalletBalance()" value="Add Balance" />
            <input type="button" class="mdc-button mdc-button--raised card-title-space" style="color:#fff; line-height:13px;" onclick="CloseAddWalletBalanceModal()" value="Close" />
        </div>
    </div>
</div>