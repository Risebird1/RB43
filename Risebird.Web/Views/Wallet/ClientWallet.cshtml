                            <option value="">— Standalone cash credit —</option>
                        </select>
                        <small class="text-muted">Select a registered PO to post cash credit against it in wallet.</small>
                        <div id="divSelectedPOStatus" style="margin-top:8px;display:none;">
                            <table style="font-size:12px;width:100%;background:#f8f9fa;border-radius:4px;padding:8px;border:1px solid #dee2e6;">
                                <tr>
                                    <td style="color:#666;padding:2px 6px;">Status</td>
                                    <td style="padding:2px 6px;"><span id="spnPOStatusBadge" class="badge"></span></td>
                                    <td style="color:#666;padding:2px 6px;">Period</td>
                                    <td id="spnPOPeriod" style="padding:2px 6px;font-weight:600;"></td>
                                </tr>
                                <tr>
                                    <td style="color:#666;padding:2px 6px;">PO Credit</td>
                                    <td id="spnPOCredit" style="padding:2px 6px;font-weight:600;"></td>
                                    <td style="color:#666;padding:2px 6px;">Cash Received</td>
                                    <td id="spnPOCash" style="padding:2px 6px;font-weight:600;"></td>
                                </tr>
                                <tr>
                                    <td style="color:#666;padding:2px 6px;">Pending</td>
                                    <td id="spnPOPending" style="padding:2px 6px;font-weight:600;color:#c62828;"></td>
                                    <td style="color:#666;padding:2px 6px;">Remarks</td>
                                    <td id="spnPORemarks" style="padding:2px 6px;"></td>
