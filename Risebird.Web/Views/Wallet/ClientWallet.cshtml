@model Risebird.Entities.ViewModel.ClientWalletDashboardVM
@using Risebird.Entities.Enum
@{
    ViewData["Title"] = "Wallet";
    ViewBag.PageHeader = "Wallet";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var scopeLabel = Model.BillingType == 1 ? "User Scope" : "Client Scope";
    var cashLabel = Model.CashRemaining < 0 ? "owed by Risebird" : "available";
    var poUtil = Model.POCreditUtilizationPercent;
}

<link href="~/Newassets/css/irf.css?v=54321" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<style>
    .wallet-page .summary-card {
        background: #fff;
        border: 1px solid #e8e8e8;
        border-radius: 8px;
        padding: 18px 20px;
        min-height: 130px;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }
    .wallet-page .summary-card h6 {
        font-size: 11px;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: #666;
        margin-bottom: 8px;
        font-weight: 700;
    }
    .wallet-page .summary-card .amount {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 4px;
    }
    .wallet-page .summary-card .sub {
        font-size: 12px;
        color: #888;
    }
    .wallet-page .progress {
        height: 8px;
        margin-top: 10px;
        background: #eee;
    }
    .wallet-page .info-box {
        background: #e8f4fd;
        border-left: 4px solid #2196F3;
        padding: 12px 16px;
        margin: 15px 0;
        border-radius: 4px;
        font-size: 13px;
        color: #333;
    }
    .wallet-page .action-bar .btn-action {
        margin: 4px 6px 4px 0;
    }
    .wallet-page .month-filter {
        display: inline-flex;
        gap: 8px;
        align-items: center;
    }
    .wallet-page .month-filter select {
        min-width: 120px;
    }
    .wallet-page .stat-pill {
        display: inline-block;
        background: #f5f5f5;
        border-radius: 20px;
        padding: 6px 14px;
        margin-right: 8px;
        font-size: 13px;
    }
    .wallet-page .stat-pill strong { color: #333; }

    /* Per-owner wallets — compact layout (base journey table −2px) */
    .owner-wallets-table {
        font-size: 12px;
        margin-bottom: 0;
        table-layout: auto;
    }
    .owner-wallets-table th,
    .owner-wallets-table td {
        width: auto !important;
        text-align: inherit;
    }
    .owner-wallets-table thead th {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .2px;
        padding: 6px 8px !important;
        vertical-align: middle !important;
        line-height: 1.25;
        background: #e8eaf6 !important;
        color: #3949ab !important;
        border-color: #c5cae9 !important;
        white-space: normal;
    }
    .owner-wallets-table tbody td {
        font-size: 12px;
        padding: 6px 8px !important;
        vertical-align: middle !important;
    }
    .owner-wallets-table .col-owner { min-width: 120px; text-align: left !important; }
    .owner-wallets-table .col-email { min-width: 140px; max-width: 180px; text-align: left !important; font-size: 11px; color: #555; word-break: break-all; }
    .owner-wallets-table .col-num { text-align: right !important; white-space: nowrap; min-width: 72px; }
    .owner-wallets-table .col-state { white-space: nowrap; min-width: 88px; text-align: center !important; }
    .owner-wallets-table .col-actions { white-space: nowrap; min-width: 200px; text-align: center !important; }
    .owner-wallets-table .badge {
        font-size: 9px !important;
        padding: 3px 6px !important;
        min-width: 72px !important;
    }
    .owner-wallets-table .btn-owner-act {
        font-size: 10px;
        padding: 2px 6px;
        margin: 1px;
        line-height: 1.3;
    }
    .owner-wallets-table .po-low-tag {
        display: inline-block;
        margin-left: 4px;
        background: #e65100;
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        padding: 1px 5px;
        border-radius: 8px;
        vertical-align: middle;
        white-space: nowrap;
    }
    .owner-wallets-formula {
        font-size: 10px;
        color: #888;
        margin: 0 0 10px;
    }
</style>

<div class="main-panel wallet-page" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title" style="margin:0;">
                        Wallet — @Model.ClientName
                        @if (!string.IsNullOrEmpty(Model.BillingModelDesc))
                        {
                            <span style="font-size:14px;color:#555;"> · @Model.BillingModelDesc · @scopeLabel</span>
                        }
                    </h4>
                </div>
                <div class="pull-right client-ms">
                    <a href="@Url.Action("List", "Client")" class="mdc-button mdc-button--outlined mdc-ripple-upgraded btn-action" style="text-decoration:none;">
                        <span class="mdc-button__label"><span class="fa fa-arrow-left"></span> Back to Client</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg" style="padding:15px;">

                    @if (Model.BillingType == 1)
                    {
                        <div class="info-box">
                            <strong>User scope:</strong> One wallet per billing owner. POs and invoices are mapped to the billing owner.
                            @if (Model.BillingModel == (int)BillingModelEnum.M3)
                            {
                                <span>For M3, cash balance can go negative on delivery. Add PO credit points to restore coverage.</span>
                            }
                        </div>
                    }

                    <!-- Overall summary (always all-time) -->
                    <div class="row" style="margin-bottom:10px;">
                        <div class="col-md-12">
                            <small class="text-muted" style="font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Overall Summary</small>
                        </div>
                    </div>
                    <div class="row" style="margin-bottom:20px;">
                        <div class="col-md-6">
                            <div class="summary-card">
                                <h6>Cash Credit Balance (Signed · Single Ledger)</h6>
                                <div class="amount" style="color:@(Model.CashRemaining < 0 ? "#e74c3c" : "#2e7d32");">
                                    @(Model.CashRemaining < 0 ? "- " : "")&#8377; @Math.Abs(Model.CashRemaining).ToString("N0")
                                </div>
                                <div class="sub">@cashLabel</div>
                                <div class="sub" style="margin-top:8px;line-height:1.6;">
                                    Added: &#8377;@Model.CashCreditAdded.ToString("N0") ·
                                    Consumed: &#8377;@Model.CashDebitConsumed.ToString("N0") ·
                                    <strong style="color:@(Model.CashRemaining < 0 ? "#e74c3c" : "#2e7d32");">
                                        Remaining: @(Model.CashRemaining < 0 ? "- " : "")&#8377;@Math.Abs(Model.CashRemaining).ToString("N0")
                                    </strong>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" style="margin-top:10px;" onclick="OpenCashCreditHistory()">
                                    <i class="fa fa-history"></i> Cash Add History
                                </button>
                            </div>
                        </div>
                        @if (Model.SupportsPO)
                        {
                            <div class="col-md-6">
                                <div class="summary-card">
                                    <h6>PO Credit Limit (@(Model.BillingModel == (int)BillingModelEnum.M2 ? "M2" : "M3"))</h6>
                                    <div class="amount" style="color:#1565c0;">&#8377; @Model.POCreditLimit.ToString("N0")</div>
                                    <div class="sub" style="margin-top:8px;line-height:1.6;">
                                        PO Cash Received: &#8377;@Model.POCashReceived.ToString("N0") ·
                                        <strong style="color:#1565c0;">PO Cash Remaining: &#8377;@Model.POCashRemaining.ToString("N0")</strong>
                                    </div>
                                    <div class="sub" style="margin-top:4px;line-height:1.6;">
                                        Consumed: &#8377;@Model.POConsumed.ToString("N0") ·
                                        <strong>Remaining: &#8377;@Model.PORemaining.ToString("N0")</strong>
                                        @if (Model.POCreditLimit > 0) { <span> · @poUtil% utilized</span> }
                                    </div>
                                    @if (Model.POCreditLimit > 0)
                                    {
                                        <div class="progress">
                                            <div class="progress-bar @(poUtil >= 80 ? "bg-danger" : "bg-warning")"
                                                 style="width:@poUtil%"></div>
                                        </div>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-primary" style="margin-top:10px;" onclick="OpenPOHistory()">
                                        <i class="fa fa-history"></i> PO History
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Details filter (month-wise or all data) -->
                    <div class="info-box" style="background:#f8f9fa;border-color:#ddd;margin-top:5px;">
                        <div class="month-filter" style="flex-wrap:wrap;">
                            <label style="margin:0 8px 0 0;font-size:13px;font-weight:600;">Details view:</label>
                            <label style="margin:0 12px 0 0;font-weight:normal;cursor:pointer;">
                                <input type="radio" name="detailsScope" id="scopeMonth" value="month" @(Model.IsAllDetailsView ? "" : "checked") /> Month-wise
                            </label>
                            <label style="margin:0 12px 0 0;font-weight:normal;cursor:pointer;">
                                <input type="radio" name="detailsScope" id="scopeAll" value="all" @(Model.IsAllDetailsView ? "checked" : "") /> All data
                            </label>
                            <span id="monthFilterGroup" style="display:@(Model.IsAllDetailsView ? "none" : "inline-flex");gap:8px;align-items:center;margin-left:10px;">
                                <select id="selMonth" class="form-control input-sm">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(m == Model.SelectedMonth)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                    }
                                </select>
                                <select id="selYear" class="form-control input-sm">
                                    @for (int y = DateTime.Now.Year; y >= 2020; y--)
                                    {
                                        <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                                    }
                                </select>
                            </span>
                            <button type="button" class="btn btn-sm btn-primary" onclick="ApplyDetailsFilter()" style="margin-left:8px;">Apply</button>
                        </div>
                    </div>

                    <!-- Period stats for details section -->
                    <div style="margin-bottom:15px;margin-top:15px;">
                        <span class="stat-pill"><strong>@Model.DetailsPeriodLabel</strong></span>
                        @if (!Model.IsAllDetailsView)
                        {
                            <span class="stat-pill">Credit: &#8377;@Model.MonthCredit.ToString("N0")</span>
                            <span class="stat-pill">Debit: &#8377;@Model.MonthDebit.ToString("N0")</span>
                        }
                        else
                        {
                            <span class="stat-pill">Credit: &#8377;@Model.OverallCredit.ToString("N0")</span>
                            <span class="stat-pill">Debit: &#8377;@Model.OverallDebit.ToString("N0")</span>
                        }
                    </div>

                    <!-- Action buttons -->
                    <div class="action-bar" style="margin-bottom:20px;">
                        @if (!Model.SupportsPO)
                        {
                            <button type="button" class="mdc-button mdc-button--raised btn-action" onclick="OpenCashCreditModal()">
                                <span class="fa fa-plus"></span> Add Cash Credit Points
                            </button>
                        }
                        @if (Model.SupportsPO)
                        {
                            <button type="button" class="mdc-button mdc-button--raised btn-action" onclick="OpenPOCreditModal()">
                                <span class="fa fa-plus"></span> Add PO Credit Points
                            </button>
                        }
                        @if (Model.SupportsPO)
                        {
                            <button type="button" class="mdc-button mdc-button--outlined btn-action" onclick="OpenPOHistory()">
                                <span class="fa fa-history"></span> PO History
                            </button>
                        }
                        <button type="button" class="mdc-button mdc-button--outlined btn-action" onclick="OpenCashCreditHistory()">
                            <span class="fa fa-history"></span> Cash Add History
                        </button>
                        <button type="button" class="mdc-button mdc-button--outlined btn-action" onclick="OpenWalletLogModal(null)">
                            <span class="fa fa-list"></span> View Wallet Balance Log
                        </button>
                    </div>
                    @if (Model.SupportsPO)
                    {
                        <p class="text-muted" style="font-size:12px;margin-top:-10px;">
                            <em>Add PO Credit Points</em> registers the PO amount. Mark the invoice as <strong>Complete</strong> or <strong>Paid</strong> to unlock <em>Add Cash Credit</em>.
                        </p>
                    }

                    @if (Model.SupportsPO && Model.PORecords.Any())
                    {
                        <h5 style="margin:20px 0 12px;font-weight:600;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                            PO Register — @Model.DetailsPeriodLabel
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnBulkExpire" style="display:none;" onclick="OpenBulkExpireModal()">
                                <i class="fa fa-calendar"></i> Bulk Update Expire Date
                            </button>
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered journey">
                                <thead>
                                    <tr>
                                        <th style="width:32px;"><input type="checkbox" id="chkSelectAllPO" title="Select all" /></th>
                                        <th>PO Number</th>
                                        @if (Model.IsAllDetailsView) { <th>Period</th> }
                                        @if (Model.BillingType == 1) { <th>Billing Owner</th> }
                                        <th class="text-right">PO Quantity</th>
                                        <th class="text-right">PO Credit</th>
                                        <th class="text-right">Cash Received</th>
                                        <th class="text-right">Pending Cash</th>
                                        <th>Added Date</th>
                                        <th>Expire Date / Status</th>
                                        <th>Document</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var po in Model.PORecords)
                                    {
                                        var addedDateVal = po.EffectiveAddedDate;
                                        var rowExpired = po.IsExpired;
                                        <tr class="@(rowExpired ? "table-danger" : po.IsExpiringSoon ? "table-warning" : "")">
                                            <td class="text-center">
                                                <input type="checkbox" class="chk-po-row" value="@po.id"
                                                       data-addeddate="@(addedDateVal?.ToString("yyyy-MM-dd") ?? "")"
                                                       data-month="@po.POMonth" data-year="@po.POYear" />
                                            </td>
                                            <td>@(string.IsNullOrEmpty(po.PONumber) ? "—" : po.PONumber)</td>
                                            @if (Model.IsAllDetailsView)
                                            {
                                                <td>@po.PeriodLabel</td>
                                            }
                                            @if (Model.BillingType == 1)
                                            {
                                                <td>@(string.IsNullOrEmpty(po.BillingOwnerEmail) ? "—" : po.BillingOwnerEmail)</td>
                                            }
                                            <td class="text-right">@(po.POQuantity.HasValue ? po.POQuantity.Value.ToString("N0") : "—")</td>
                                            <td class="text-right">@(po.POCreditAmount > 0 ? "₹ " + po.POCreditAmount.ToString("N0") : "—")</td>
                                            <td class="text-right">@(po.CashCreditReceived > 0 ? "₹ " + po.CashCreditReceived.ToString("N0") : "—")</td>
                                            <td class="text-right">@(po.POCreditAmount > 0 ? "₹ " + po.PendingCashCredit.ToString("N0") : "—")</td>
                                            <td>@(addedDateVal?.ToString("dd MMM yyyy") ?? "—")</td>
                                            <td>
                                                @if (po.ExpireDate.HasValue)
                                                {
                                                    <span>@po.ExpireDate.Value.ToString("dd MMM yyyy")</span>
                                                    <span class="badge @po.ExpiryStatusCss" style="margin-left:4px;font-size:10px;">@po.ExpiryStatusDesc</span>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(po.PODocumentUrl))
                                                {
                                                    <a href="@po.PODocumentUrl" target="_blank" class="btn btn-sm btn-link">View PDF</a>
                                                }
                                                else { <span>—</span> }
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)"
                                                   onclick="OpenEditPOModal(this)"
                                                   class="btn btn-sm btn-outline-secondary"
                                                   style="margin:2px;"
                                                   data-poid="@po.id"
                                                   data-ponumber="@(po.PONumber ?? "")"
                                                   data-amount="@po.POCreditAmount.ToString("0.##")"
                                                   data-month="@po.POMonth"
                                                   data-year="@po.POYear"
                                                   data-quantity="@(po.POQuantity?.ToString() ?? "")"
                                                   data-addeddate="@(addedDateVal?.ToString("yyyy-MM-dd") ?? "")"
                                                   data-expiredate="@(po.ExpireDate?.ToString("yyyy-MM-dd") ?? "")"
                                                   data-cashreceived="@po.CashCreditReceived.ToString("0.##")">Edit</a>
                                                @if (po.Status < 4)
                                                {
                                                    <a href="javascript:void(0)" onclick="MarkPOStatus(@po.id, @Model.ClientId, 4)" class="btn btn-sm btn-outline-primary" style="margin:2px;">Mark Complete</a>
                                                }
                                                @if (po.Status == 4)
                                                {
                                                    <a href="javascript:void(0)" onclick="MarkPOStatus(@po.id, @Model.ClientId, 5)" class="btn btn-sm btn-outline-warning" style="margin:2px;">Mark Paid</a>
                                                }
                                                @if ((po.Status == 4 || po.Status == 5) && po.POCreditAmount > 0 && po.PendingCashCredit > 0)
                                                {
                                                    <a href="javascript:void(0)" onclick="OpenCashCreditForPO(@po.id, @(po.BillingOwnerId ?? 0), @po.PendingCashCredit.ToString("0.##"))" class="btn btn-sm btn-outline-success" style="margin:2px;">Add Cash Credit</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (Model.SupportsPO && !Model.PORecords.Any())
                    {
                        <div class="info-box" style="background:#fff;border-color:#eee;color:#666;margin-top:15px;">
                            No PO records for <strong>@Model.DetailsPeriodLabel</strong>.
                        </div>
                    }

                    <!-- Per-owner wallets -->
                    @if (Model.BillingType == 1 && Model.OwnerWallets.Any())
                    {
                        <h5 style="margin:20px 0 4px;font-weight:600;font-size:16px;">Per-Owner Wallets — @Model.DetailsPeriodLabel</h5>
                        <p class="owner-wallets-formula">
                            <strong>Remaining</strong> = PO Opening Balance + PO Credit − Consumed − Expired Not Consumed
                            &nbsp;|&nbsp; Opening = carry-forward before period &nbsp;|&nbsp; Expired Not Consumed = lost credit on expired POs (FIFO)
                        </p>
                        <div class="table-responsive">
                            @{
                                var _highConsIds   = ViewBag.HighConsumptionOwnerIds as System.Collections.Generic.HashSet<int?> ?? new System.Collections.Generic.HashSet<int?>();
                                var _openingBals   = ViewBag.POOpeningBalances as System.Collections.Generic.Dictionary<int, decimal>;
                                var _showOpening   = _openingBals != null && _openingBals.Any(kv => kv.Value != 0m);
                                var _showExpiredNc = Model.SupportsPO;
                            }
                            <table class="table table-striped table-bordered journey owner-wallets-table">
                                <thead>
                                    <tr>
                                        <th class="col-owner">Billing Owner</th>
                                        <th class="col-email">Email</th>
                                        @if (_showOpening)
                                        {
                                            <th class="col-num" title="PO credit carry-forward before selected period">PO Opening<br/>Balance</th>
                                        }
                                        <th class="col-num">PO<br/>Credit</th>
                                        <th class="col-num" title="Wallet debits in selected period">Consumed</th>
                                        @if (_showExpiredNc)
                                        {
                                            <th class="col-num" title="Unconsumed credit on expired POs (FIFO)">Expired Not<br/>Consumed</th>
                                        }
                                        <th class="col-num" title="PO Opening Balance + PO Credit − Consumed − Expired Not Consumed">Remaining</th>
                                        <th class="col-num">Cash</th>
                                        <th class="col-state">State</th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var owner in Model.OwnerWallets)
                                    {
                                        var _isHighConsumption = _highConsIds.Contains((int?)owner.BillingOwnerId);
                                        var _hasOpeningBal = owner.POOpeningBalance != 0m;
                                        var _remaining = owner.UsableRemaining;
                                        if (owner.POCredit == 0 && owner.Consumed == 0 && _remaining == 0 && owner.CashBalance == 0 && owner.ExpiredNotConsumed == 0 && !_hasOpeningBal) { continue; }
                                        var _showRemaining = owner.POCredit != 0 || owner.Consumed != 0 || owner.ExpiredNotConsumed != 0 || _hasOpeningBal;
                                        var _remColor = _remaining < 0 ? "#c62828" : _remaining > 0 ? "#1565c0" : "inherit";
                                        <tr class="@(_isHighConsumption ? "table-warning" : "")">
                                            <td class="col-owner">
                                                @owner.BillingOwnerName
                                                @if (_isHighConsumption)
                                                {
                                                    <span class="po-low-tag" title="Latest PO is ≥ 90% consumed — consider adding a new PO">⚠ PO Low</span>
                                                }
                                            </td>
                                            <td class="col-email">@owner.BillingOwnerEmail</td>
                                            @if (_showOpening)
                                            {
                                                var _obColor = owner.POOpeningBalance == 0m ? "inherit" : owner.POOpeningBalance < 0 ? "#c62828" : "#5c6bc0";
                                                <td class="col-num" style="color:@_obColor;font-weight:600;">
                                                    @(_hasOpeningBal ? "₹ " + owner.POOpeningBalance.ToString("N0") : "—")
                                                </td>
                                            }
                                            <td class="col-num">@(owner.POCredit > 0 ? "₹ " + owner.POCredit.ToString("N0") : "—")</td>
                                            <td class="col-num">@(owner.Consumed > 0 ? "₹ " + owner.Consumed.ToString("N0") : "—")</td>
                                            @if (_showExpiredNc)
                                            {
                                                <td class="col-num" style="color:@(owner.ExpiredNotConsumed > 0 ? "#c62828" : "inherit");font-weight:600;"
                                                    title="Unconsumed credit lost on expired POs">
                                                    @(owner.ExpiredNotConsumed > 0 ? "₹ " + owner.ExpiredNotConsumed.ToString("N0") : "—")
                                                </td>
                                            }
                                            <td class="col-num" style="color:@_remColor;font-weight:600;" title="@($"₹ {owner.POOpeningBalance:N0} + ₹ {owner.POCredit:N0} − ₹ {owner.Consumed:N0} − ₹ {owner.ExpiredNotConsumed:N0} = ₹ {_remaining:N0}")">
                                                @(_showRemaining ? "₹ " + _remaining.ToString("N0") : "—")
                                            </td>
                                            <td class="col-num">@(owner.CashBalance != 0 ? "₹ " + owner.CashBalance.ToString("N0") : "—")</td>
                                            <td class="col-state">
                                                <span class="badge @owner.StateCss">@owner.State</span>
                                            </td>
                                            <td class="col-actions">
                                                <a href="javascript:void(0)" onclick="OpenWalletLogModal(@owner.BillingOwnerId)" class="btn btn-sm btn-outline-secondary btn-owner-act">View log</a>
                                                @if (Model.SupportsPO)
                                                {
                                                    var _oName = (owner.BillingOwnerName ?? "").Replace("'", "\\'");
                                                    var _oEmail = owner.BillingOwnerEmail ?? "";
                                                    <a href="javascript:void(0)" onclick="OpenOwnerPOHistory(@owner.BillingOwnerId, '@_oName', '@_oEmail')" class="btn btn-sm btn-outline-info btn-owner-act">PO History</a>
                                                    <a href="javascript:void(0)" onclick="OpenPOCreditModal(@owner.BillingOwnerId)" class="btn btn-sm btn-outline-primary btn-owner-act">Add PO</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (Model.BillingType == 1)
                    {
                        <div class="info-box" style="background:#fff;border-color:#eee;color:#666;">
                            No per-owner wallet activity for <strong>@Model.DetailsPeriodLabel</strong>.
                        </div>
                    }
                    else if (Model.BillingType == 3)
                    {
                        <div class="info-box" style="background:#f9f9f9;border-color:#ccc;">
                            Client-level wallet — billing owner is not required. All PO and wallet entries apply to the client.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

