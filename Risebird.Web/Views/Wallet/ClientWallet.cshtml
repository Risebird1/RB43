@if (ViewBag.Message != null)
{
    <script>
        $(function () {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes('success')) swal.fire('Success', msg, 'success');
            else swal.fire('Error', msg, 'error');
        });
    </script>
}

<script>
    var _clientId = @Model.ClientId;
    var _billingType = @Model.BillingType;
    var _requiresOwner = @(Model.BillingType == 1 ? "true" : "false");

    function ApplyDetailsFilter() {
        var scope = $('input[name="detailsScope"]:checked').val() || 'month';
        var url = '/Wallet/ClientWallet?clientId=' + _clientId + '&scope=' + scope;
        if (scope === 'month') {
            url += '&month=' + $('#selMonth').val() + '&year=' + $('#selYear').val();
        } else {
            url += '&month=' + @Model.SelectedMonth + '&year=' + @Model.SelectedYear;
        }
        window.location.href = url;
    }

    $(function () {
        $('input[name="detailsScope"]').change(function () {
            $('#monthFilterGroup').toggle($('#scopeMonth').is(':checked'));
        });

        $('#chkSelectAllPO').on('change', function () {
            $('.chk-po-row').prop('checked', this.checked);
            toggleBulkExpireButton();
        });
        $(document).on('change', '.chk-po-row', toggleBulkExpireButton);
    });

    function toggleBulkExpireButton() {
        var count = $('.chk-po-row:checked').length;
        $('#btnBulkExpire').toggle(count > 0);
    }

    function OpenBulkExpireModal() {
        var count = $('.chk-po-row:checked').length;
        if (!count) { swal.fire('Validation', 'Select at least one PO.', 'warning'); return; }
        $('#txtBulkExpireDate').val('');
        $('#lblBulkSelectedCount').text(count + ' PO(s) selected.');
        $('#bulkExpireModal').modal('show');
    }

    function SubmitBulkExpire() {
        var expireVal = $('#txtBulkExpireDate').val();
        if (!expireVal) { swal.fire('Validation', 'Select an expire date for bulk update.', 'warning'); return; }
        var ids = [];
        $('.chk-po-row:checked').each(function () {
            ids.push($(this).val());
        });

        $.post('/Wallet/BulkUpdatePOExpireDate', {
            clientId: _clientId,
            poIds: ids.join(','),
            expireDate: expireVal
        }, function (r) {
            if (r.success) swal.fire('Success', r.message, 'success').then(function () { location.reload(); });
            else swal.fire('Error', r.message, 'error');
        });
    }

    function OpenWalletLogModal(billingOwnerId) {
        $('#walletLogBody').html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        $('#walletLogModal').modal('show');
        $.post('/Wallet/GetWalletDetails', {
            billingType: _billingType,
            clientId: _clientId,
            billingOwnerId: billingOwnerId || null,
            actiontype: 'All'
        }, function (html) {
            $('#walletLogBody').html(html);
        });
    }

    function OpenPOHistory() {
        var scope = $('input[name="detailsScope"]:checked').val() || 'month';
        var month = null, year = null, periodLabel = 'Overall';
        if (scope === 'month') {
            month = $('#selMonth').val();
            year  = $('#selYear').val();
            periodLabel = $('#selMonth option:selected').text() + ' ' + year;
        }
        $('#poHistoryModal .modal-title').text('PO History — ' + periodLabel);
        $('#poHistoryBody').html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        $('#poHistoryModal').modal('show');
        $.get('/Wallet/GetPOHistory', { clientId: _clientId, month: month, year: year }, function (html) {
            $('#poHistoryBody').html(html);
        });
    }

    function OpenOwnerPOHistory(ownerId, ownerName, ownerEmail) {
        var scope = $('input[name="detailsScope"]:checked').val() || 'month';
        var month = null, year = null, periodLabel = 'Overall';
        if (scope === 'month') {
            month = $('#selMonth').val();
            year  = $('#selYear').val();
            periodLabel = $('#selMonth option:selected').text() + ' ' + year;
        }
        $('#poHistoryModal .modal-title').text('PO History — ' + ownerName + ' · ' + periodLabel);
        $('#poHistoryBody').html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        $('#poHistoryModal').modal('show');
        $.get('/Wallet/GetPOHistory', {
            clientId: _clientId,
            billingOwnerId: ownerId,
            ownerEmail: ownerEmail || '',
            month: month,
            year: year
        }, function (html) {
            $('#poHistoryBody').html(html);
        });
    }

    function OpenCashCreditHistory() {
        $('#cashHistoryBody').html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-2x"></i></div>');
        $('#cashHistoryModal').modal('show');
        $.get('/Wallet/GetCashCreditHistory', { clientId: _clientId }, function (html) {
            $('#cashHistoryBody').html(html);
        });
    }

    function OpenCashCreditModal() {
        $('#hidCashPOId').val('');
        $('#ddlCashPO').val('');
        LoadOpenPOs();
        $('#cashCreditModal').modal('show');
    }

    function OpenCashCreditForPO(poId, ownerId, pending) {
        $('#hidCashPOId').val(poId);
        if (ownerId > 0) $('#ddlCashOwner').val(ownerId);
        LoadOpenPOs(poId);
        $('#txtCashAmount').val(Math.floor(pending));
        $('#cashCreditModal').modal('show');
    }

    var _openPOItems = [];

    function LoadOpenPOs(selectedId) {
        var ownerId = _requiresOwner ? $('#ddlCashOwner').val() : null;
        $('#divSelectedPOStatus').hide();
        $.get('/Wallet/GetOpenClientPOs', { clientId: _clientId, billingOwnerId: ownerId }, function (r) {
            var $ddl = $('#ddlCashPO');
            $ddl.empty().append('<option value="">— Standalone cash credit —</option>');
            _openPOItems = [];
            if (r.success && r.items) {
                _openPOItems = r.items;
                r.items.forEach(function (item) {
                    $ddl.append('<option value="' + item.id + '">' + item.label + '</option>');
                });
            }
            var pre = selectedId || $('#hidCashPOId').val();
            if (pre) { $ddl.val(pre); ShowSelectedPOStatus(); }
        });
    }

    function ShowSelectedPOStatus() {
        var selectedId = parseInt($('#ddlCashPO').val());
        var $panel = $('#divSelectedPOStatus');
        if (!selectedId) { $panel.hide(); return; }
        var po = _openPOItems.find(function (x) { return x.id === selectedId; });
        if (!po) { $panel.hide(); return; }
        $('#spnPOStatusBadge').attr('class', 'badge ' + po.statusCss).text(po.statusDesc);
        $('#spnPOPeriod').text(po.periodLabel || '—');
        $('#spnPOCredit').text(po.poCreditAmount > 0 ? '₹ ' + Number(po.poCreditAmount).toLocaleString('en-IN') : '—');
        $('#spnPOCash').text(po.cashCreditReceived > 0 ? '₹ ' + Number(po.cashCreditReceived).toLocaleString('en-IN') : '—');
        $('#spnPOPending').text(po.pending > 0 ? '₹ ' + Number(po.pending).toLocaleString('en-IN') : '—');
        $('#spnPORemarks').text(po.remarks || '—');
        $panel.show();
    }

    function OpenPOCreditModal(ownerId) {
        $('#txtPOAmount').val('');
        $('#txtPOQuantity').val('');
        $('#txtPORef').val('');
        $('#txtPOCreditFile').val('');
        $('#txtPOMonth').val('@($"{Model.SelectedYear:D4}-{Model.SelectedMonth:D2}")');
        $('#txtPOAddedDate').val('@DateTime.Now.ToString("yyyy-MM-dd")');
        $('#txtPOExpireDate').val('');
        if (ownerId) $('#ddlPOOwner').val(ownerId);
        else if (_requiresOwner) $('#ddlPOOwner').val('');
        $('#poCreditModal').modal('show');
    }

    function OpenEditPOModal(el) {
        var $el = $(el);
        var month = parseInt($el.data('month'));
        var year = parseInt($el.data('year'));
        var cashReceived = parseFloat($el.data('cashreceived')) || 0;
        $('#hidEditPOId').val($el.data('poid'));
        $('#txtEditPORef').val($el.data('ponumber') || '');
        $('#txtEditPOAmount').val($el.data('amount'));
        $('#txtEditPOQuantity').val($el.data('quantity') || '');
        $('#txtEditPOMonth').val(year + '-' + String(month).padStart(2, '0'));
        $('#txtEditPOAddedDate').val($el.data('addeddate') || '');
        $('#txtEditPOExpireDate').val($el.data('expiredate') || '');
        $('#txtEditPOFile').val('');
        if (cashReceived > 0) {
            $('#lblEditPOCashHint').text('Cash already received: ₹ ' + cashReceived.toLocaleString('en-IN') + '. Credit cannot be set below this.');
        } else {
            $('#lblEditPOCashHint').text('');
        }
        $('#editPOModal').modal('show');
    }

    function SubmitEditPO() {
        var poId = parseInt($('#hidEditPOId').val());
        if (!poId) { swal.fire('Validation', 'Invalid PO.', 'warning'); return; }
        var amt = parseInt($('#txtEditPOAmount').val());
        if (!amt || amt <= 0) { swal.fire('Validation', 'Enter valid PO credit amount.', 'warning'); return; }
        var my = parseMonthYear($('#txtEditPOMonth').val());
        var qtyVal = $('#txtEditPOQuantity').val();
        var fd = new FormData();
        fd.append('poId', poId);
        fd.append('clientId', _clientId);
        fd.append('creditAmount', amt);
        fd.append('month', my.month);
        fd.append('year', my.year);
        fd.append('transactionRefNumber', $('#txtEditPORef').val());
        if (qtyVal !== '') fd.append('poQuantity', parseInt(qtyVal));
        if ($('#txtEditPOAddedDate').val()) fd.append('addedDate', $('#txtEditPOAddedDate').val());
        fd.append('expireDate', $('#txtEditPOExpireDate').val() || '');
        var f = $('#txtEditPOFile')[0].files[0];
        if (f) fd.append('poFile', f);
        $.ajax({
            url: '/Wallet/UpdateClientPO', type: 'POST', data: fd, processData: false, contentType: false,
            success: function (r) {
                if (r.success) swal.fire('Success', r.message, 'success').then(function () { location.reload(); });
                else swal.fire('Error', r.message, 'error');
            }
        });
    }

    function parseMonthYear(val) {
        if (!val) return { month: @Model.SelectedMonth, year: @Model.SelectedYear };
        var p = val.split('-');
        return { year: parseInt(p[0]), month: parseInt(p[1]) };
    }

    function SubmitCashCredit() {
        var ownerId = _requiresOwner ? $('#ddlCashOwner').val() : null;
        if (_requiresOwner && !ownerId) { swal.fire('Validation', 'Select billing owner.', 'warning'); return; }
        var amt = parseInt($('#txtCashAmount').val());
        if (!amt || amt <= 0) { swal.fire('Validation', 'Enter valid credit amount.', 'warning'); return; }
        var clientPOId = $('#ddlCashPO').val() || $('#hidCashPOId').val() || null;
        $.post('/Wallet/AddCashCreditPoints', {
            clientId: _clientId,
            creditAmount: amt,
            transactionDate: $('#txtCashDate').val(),
            transactionRefNumber: $('#txtCashRef').val(),
            billingOwnerId: ownerId,
            clientPOId: clientPOId
        }, function (r) {
            if (r.success) { swal.fire('Success', r.message, 'success').then(function () { location.reload(); }); }
            else swal.fire('Error', r.message, 'error');
        });
    }

    function MarkPOStatus(poId, clientId, status) {
        var label = status === 4 ? 'Complete' : 'Paid';
        swal.fire({
            title: 'Mark as ' + label + '?',
            text: 'This will update the invoice status to ' + label + '.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, mark ' + label
        }).then(function (result) {
            if (!result.isConfirmed) return;
            $.post('/Wallet/UpdatePOStatus', { poId: poId, clientId: clientId, status: status }, function (r) {
                if (r.success) {
                    swal.fire('Updated', r.message, 'success').then(function () { location.reload(); });
                } else {
                    swal.fire('Error', r.message, 'error');
                }
            });
        });
    }

    function SubmitPOCredit() {
        var ownerId = _requiresOwner ? $('#ddlPOOwner').val() : null;
        if (_requiresOwner && !ownerId) { swal.fire('Validation', 'Select billing owner.', 'warning'); return; }
        var amt = parseInt($('#txtPOAmount').val());
        if (!amt || amt <= 0) { swal.fire('Validation', 'Enter valid PO credit amount.', 'warning'); return; }
        var my = parseMonthYear($('#txtPOMonth').val());
        var qtyVal = $('#txtPOQuantity').val();
        var fd = new FormData();
        fd.append('clientId', _clientId);
        fd.append('creditAmount', amt);
        fd.append('month', my.month);
        fd.append('year', my.year);
        fd.append('transactionRefNumber', $('#txtPORef').val());
        if (ownerId) fd.append('billingOwnerId', ownerId);
        if (qtyVal !== '') fd.append('poQuantity', parseInt(qtyVal));
        if ($('#txtPOAddedDate').val()) fd.append('addedDate', $('#txtPOAddedDate').val());
        fd.append('expireDate', $('#txtPOExpireDate').val() || '');
        var f = $('#txtPOCreditFile')[0].files[0];
        if (f) fd.append('poFile', f);
        $.ajax({ url: '/Wallet/AddPOCreditPoints', type: 'POST', data: fd, processData: false, contentType: false,
            success: function (r) {
                if (r.success) swal.fire('Success', r.message, 'success').then(function () { location.reload(); });
                else swal.fire('Error', r.message, 'error');
            }
        });
    }
</script>
