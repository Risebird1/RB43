@model Risebird.Entities.ViewModel.McqAssessmentReport
@*
    The MCQ assessment section of an AI interview report.
    
    A partial because two views render this report: AIInterview/Report.cshtml for the page
    and AIInterview/GenerateAIReportPDFFile.cshtml for the PDF, each with its own model
    construction. Keeping one copy is what stops the PDF and the page disagreeing.
    
    Renders nothing when the model is null - a channel with no MCQ section.

    Layout follows the HackerEarth assessment report supplied as the
    design reference: a score header, per-section performance bars comparing the
    candidate against the section's own weighting, a sections summary table, and a
    detailed submission report that shows every question with the candidate's choice
    marked against the correct one.

    Two things from that reference are deliberately NOT reproduced: the global percentile
    band ("Top 1% out of 1819 candidates") and the rank. Both require a cohort of other
    candidates who have sat the same paper, and these papers are generated per candidate -
    so there is no cohort, and any figure shown there would be invented. Everything below
    is computed from this candidate's own submission.

    The data behind this block never lives in this database as rows. It is fetched from
    screen.risebird.io for the one session being rendered and cached as a JSON snapshot -
    see Tables\AIInterviewMcqAssessment.sql.
*@
@if (Model != null)
{
    var mcq = Model;
    var mcqSections = mcq.OrderedSections;

    // "not-captured" and "error" are recorded when the section could not be delivered or its
    // result could not be read - our failure, not the candidate's. Declared here because both the
    // banner and the score tile have to be worded from it: an unscored section caused by an outage
    // must never read like a candidate who skipped or failed the assessment.
    var mcqStatusKey = (mcq.Status ?? string.Empty).Trim().ToLowerInvariant();
    var mcqIsSystemFailure = mcqStatusKey == "not-captured" || mcqStatusKey == "error";
    var mcqNeverStarted = mcqStatusKey == "provisioned";

    <style>
        .rb-mcq-report-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 14px;
            margin-bottom: 22px;
        }

        .rb-mcq-tile {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 16px 18px;
            background: #fff;
        }

        .rb-mcq-tile-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .rb-mcq-tile-value {
            font-size: 26px;
            font-weight: 700;
            color: #111827;
            line-height: 1.1;
        }

        .rb-mcq-tile-sub {
            font-size: 12px;
            color: #6b7280;
            margin-top: 6px;
        }

        .rb-mcq-verdict {
            display: inline-block;
            font-size: 12px;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 999px;
            margin-top: 8px;
        }

            .rb-mcq-verdict.is-pass {
                background: #e7f6ed;
                color: #1a7f4b;
            }

            .rb-mcq-verdict.is-borderline {
                background: #fff5e5;
                color: #a35b00;
            }

            .rb-mcq-verdict.is-fail {
                background: #fdecec;
                color: #b42318;
            }

        /* ---- Section-wise performance ----------------------------------------------------
           One table, not a bar block and a table repeating the same figures. The comparison
           the bars gave is kept as a slim bar inside the score cell, which also survives the
           PDF renderer better than the grid rows it replaces.
           Section headings shared by both blocks below. */
        .rb-mcq-section-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin: 0 0 10px;
            padding-bottom: 8px;
            border-bottom: 2px solid #eceef1;
        }

        .rb-mcq-section-title {
            font-size: 14px;
            font-weight: 700;
            color: #1e3c72;
            margin: 0;
            letter-spacing: .1px;
        }

        .rb-mcq-section-note {
            font-size: 12px;
            color: #6b7280;
            margin: 0;
        }

        /* Sections summary table */
        .rb-mcq-table-wrap {
            overflow-x: auto;
            margin-bottom: 26px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 1px 2px rgba(17,24,39,.04);
        }

        .rb-mcq-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            min-width: 660px;
            font-variant-numeric: tabular-nums;
        }

            .rb-mcq-table th {
                text-align: left;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .5px;
                text-transform: uppercase;
                color: #4b5b78;
                background: #f5f7fb;
                border-bottom: 1px solid #e5e7eb;
                padding: 11px 14px;
                white-space: nowrap;
            }

            .rb-mcq-table td {
                border-bottom: 1px solid #f0f1f3;
                padding: 12px 14px;
                color: #374151;
                vertical-align: middle;
            }

            .rb-mcq-table tbody tr:last-child td {
                border-bottom: 0;
            }

            /* Figures right-aligned so columns read down the page; the section name stays left. */
            .rb-mcq-table th.is-num,
            .rb-mcq-table td.is-num {
                text-align: right;
            }

            .rb-mcq-table tfoot td {
                font-weight: 700;
                color: #111827;
                background: #f5f7fb;
                border-top: 1px solid #e5e7eb;
                border-bottom: 0;
            }

        .rb-mcq-sec-name {
            font-size: 13px;
            font-weight: 600;
            color: #111827;
        }

        .rb-mcq-sec-desc {
            font-size: 11px;
            color: #6b7280;
            margin-top: 3px;
            max-width: 320px;
        }

        /* Score cell: the number leads, the bar supports it. */
        .rb-mcq-score-cell {
            min-width: 140px;
        }

        .rb-mcq-score-value {
            font-size: 13px;
            font-weight: 700;
            color: #111827;
        }

        .rb-mcq-bar-track {
            position: relative;
            height: 6px;
            background: #eef0f4;
            border-radius: 999px;
            overflow: hidden;
            margin-top: 6px;
        }

        .rb-mcq-bar-fill {
            display: block;
            height: 100%;
            border-radius: 999px;
            background: #1e3c72;
        }

            .rb-mcq-bar-fill.is-mid {
                background: #a35b00;
            }

            .rb-mcq-bar-fill.is-weak {
                background: #b42318;
            }

        .rb-mcq-pill {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 999px;
            white-space: nowrap;
        }

            .rb-mcq-pill.is-pass {
                background: #e7f6ed;
                color: #1a7f4b;
            }

            /* Matches the bar's middle band, so the pill and the bar never disagree about
               where a section sits. */
            .rb-mcq-pill.is-mid {
                background: #fff8ec;
                color: #a35b00;
            }

            .rb-mcq-pill.is-fail {
                background: #fdecec;
                color: #b42318;
            }

        /* ---- Detailed submission report --------------------------------------------------
           Each section gets a quiet band header so a long report stays navigable, and each
           question is a plain card - the colour is spent on the answer rows, where it means
           something, rather than on the card chrome. */
        .rb-mcq-qsection-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: #1e3c72;
            background: #f5f7fb;
            border: 1px solid #e5e7eb;
            border-bottom: 0;
            border-radius: 8px 8px 0 0;
            padding: 9px 14px;
            margin: 22px 0 0;
        }

        .rb-mcq-qsection-meta {
            font-size: 11px;
            color: #6b7280;
            background: #f5f7fb;
            border: 1px solid #e5e7eb;
            border-top: 0;
            border-radius: 0 0 8px 8px;
            padding: 0 14px 9px;
            margin: 0 0 14px;
        }

        .rb-mcq-q {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 16px 18px;
            margin-bottom: 12px;
            background: #fff;
            box-shadow: 0 1px 2px rgba(17,24,39,.04);
        }

        .rb-mcq-q-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f0f1f3;
        }

        .rb-mcq-q-num {
            flex: 0 0 auto;
            min-width: 26px;
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            color: #1e3c72;
            background: #eef2f9;
            border: 1px solid #dfe6f2;
            border-radius: 6px;
            padding: 3px 8px;
            font-variant-numeric: tabular-nums;
        }

        .rb-mcq-q-text {
            flex: 1 1 auto;
            font-size: 14px;
            font-weight: 500;
            color: #111827;
            line-height: 1.55;
            white-space: pre-wrap;
        }

        .rb-mcq-q-meta {
            flex: 0 0 auto;
            text-align: right;
            font-size: 11px;
            color: #6b7280;
            white-space: nowrap;
        }

        .rb-mcq-opt {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            line-height: 1.5;
            padding: 9px 12px;
            border: 1px solid #eceef1;
            border-left: 3px solid #eceef1;
            border-radius: 7px;
            margin-bottom: 7px;
            color: #374151;
        }

            /* A left accent as well as the tint, so which rows matter survives greyscale
               printing and the PDF export. */
            .rb-mcq-opt.is-correct {
                border-color: #cdeadb;
                border-left-color: #1a7f4b;
                background: #f4fbf7;
            }

            .rb-mcq-opt.is-wrong-pick {
                border-color: #f3d3d0;
                border-left-color: #b42318;
                background: #fdf5f4;
            }

        .rb-mcq-opt-key {
            flex: 0 0 auto;
            font-weight: 700;
            color: #6b7280;
            min-width: 16px;
        }

        .rb-mcq-opt-tag {
            flex: 0 0 auto;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 2px 7px;
            border-radius: 4px;
            margin-left: auto;
        }

            .rb-mcq-opt-tag.is-correct {
                background: #1a7f4b;
                color: #fff;
            }

            .rb-mcq-opt-tag.is-wrong-pick {
                background: #b42318;
                color: #fff;
            }

            .rb-mcq-opt-tag.is-answer {
                background: #e7f6ed;
                color: #1a7f4b;
            }

        .rb-mcq-stale {
            font-size: 12px;
            color: #a35b00;
            background: #fff8ec;
            border: 1px solid #f3d9a8;
            border-radius: 7px;
            padding: 9px 12px;
            margin-bottom: 16px;
        }
    </style>

    <div class="rb-report-section" style="margin-bottom:20px;">
        <div class="rb-section-header" style="margin-bottom:5px;">
            @* rb-part-sub-h: this heading sits inside the Knowledge Evaluation part, so it
               takes the part header's typography a step down rather than the page's
               full-size section heading. Both host views define the class. *@
            <h2 class="rb-part-sub-h"><i class="fa fa-list-alt"></i> Assessment Section</h2>
        </div>

        <div class="rb-analysis-content" style="overflow:hidden;">

            @if (mcq.IsFromCache)
            {
                @* Says plainly that this is the last known result rather than a live read, and why,
                   so nobody makes a hiring call on a stale figure believing it is current - and
                   nobody goes hunting an outage when the live system simply has no result yet. *@
                <div class="rb-mcq-stale">
                    <i class="fa fa-info-circle"></i>
                    Showing the last saved result
                    @if (mcq.CachedOn.HasValue)
                    {
                        <text>from @mcq.CachedOn.Value.ToString("dd MMM yyyy, HH:mm")</text>
                    }
                    &mdash;
                    @switch (mcq.CacheReason)
                    {
                        case Risebird.Entities.ViewModel.McqCacheReason.Unreachable:
                            <text>the assessment system could not be reached just now.</text>
                            break;
                        case Risebird.Entities.ViewModel.McqCacheReason.NoLiveResult:
                            <text>the assessment system has no current result for this session.</text>
                            break;
                        case Risebird.Entities.ViewModel.McqCacheReason.NotConfigured:
                            <text>live lookup is not configured on this environment.</text>
                            break;
                        default:
                            <text>a live result was not available.</text>
                            break;
                    }
                </div>
            }


            @if (!mcq.IsCompleted)
            {
                @*
                    Why the status decides the wording rather than one generic sentence:
                    "not-captured" and "error" are recorded when the assessment could not be
                    delivered or its result could not be read - failures on our side. Reporting
                    those as "the candidate did not submit" blames a candidate for our outage, in a
                    document someone makes a hiring decision from. The two cases have to read
                    differently even though both leave the section unscored.
                *@
                <div class="rb-mcq-stale">
                    <i class="fa fa-exclamation-triangle"></i>
                    @if (mcqIsSystemFailure)
                    {
                        <text>
                            This section could not be delivered or its result could not be retrieved.
                            That is a system issue and is not attributable to the candidate &mdash; do not
                            read the absence of a score as a result.
                        </text>
                    }
                    else if (mcqNeverStarted)
                    {
                        <text>
                            The assessment was made available but the candidate did not start it.
                        </text>
                    }
                    else
                    {
                        <text>
                            The candidate started this section but did not submit it.
                            Any figures below cover only what was answered.
                        </text>
                    }
                </div>
            }

            @{
                // Verdict bands mirror the reference's "Qualified the 60 passing score"
                // line. 60% is the same threshold the reference used; it is a display
                // banding only and does not gate anything.
                var scorePct = mcq.ScorePercent;

                // A verdict only means something against a paper that was actually sat. Banding a
                // candidate who never opened the section, or whose result could not be read, as
                // "well below the passing score" would be reporting a fact that was never measured.
                var isScoreMeaningful = mcq.IsCompleted && mcq.TotalQuestions > 0;

                var verdictClass = !isScoreMeaningful ? "is-borderline"
                    : scorePct >= 60 ? "is-pass"
                    : scorePct >= 40 ? "is-borderline" : "is-fail";
                var verdictText = !isScoreMeaningful
                    ? (mcqIsSystemFailure ? "Not scored - the assessment could not be delivered"
                                          : "Not scored - the assessment was not completed")
                    : scorePct >= 60 ? "Qualified the 60% passing score"
                    : scorePct >= 40 ? "Below the 60% passing score" : "Well below the 60% passing score";

                var attemptedTotal = mcqSections.Sum(s => s.Attempted);
                var timeUsedMinutes = mcq.Elapsed.HasValue ? mcq.Elapsed.Value.TotalMinutes : 0;
            }

            <div class="rb-mcq-report-grid">
                <div class="rb-mcq-tile">
                    <div class="rb-mcq-tile-label">Total Score</div>
                    @if (isScoreMeaningful)
                    {
                        <div class="rb-mcq-tile-value">@scorePct.ToString("0.#")<span style="font-size:15px;color:#6b7280;"> / 100</span></div>
                        <div class="rb-mcq-tile-sub">@mcq.CorrectAnswers of @mcq.TotalQuestions correct</div>
                    }
                    else
                    {
                        <div class="rb-mcq-tile-value" style="font-size:18px;color:#6b7280;">
                            @(mcqIsSystemFailure ? "Unavailable" : attemptedTotal > 0 ? "Not scored" : "Not attempted")
                        </div>
                        <div class="rb-mcq-tile-sub">
                            @*
                                An unsubmitted attempt still has the answers the candidate gave -
                                they are written per question as the section runs. Saying "no
                                answers were recorded" over real work would understate the
                                candidate in the one document a hiring call is made from.
                            *@
                            @if (mcqIsSystemFailure)
                            {
                                <text>The assessment could not be delivered to this candidate</text>
                            }
                            else if (attemptedTotal > 0)
                            {
                                <text>@attemptedTotal of @mcq.TotalQuestions answered before the section ended</text>
                            }
                            else
                            {
                                <text>No answers were recorded for this section</text>
                            }
                        </div>
                    }
                    <span class="rb-mcq-verdict @verdictClass">@verdictText</span>
                </div>

                @* Questions Attempted removed: the Total Score tile already carries
                   "N of M correct", so the attempted count restated the same paper twice.
                   The per-section table below still breaks attempted out by section. *@

                <div class="rb-mcq-tile">
                    <div class="rb-mcq-tile-label">Time Taken</div>
                    <div class="rb-mcq-tile-value">
                        @if (mcq.Elapsed.HasValue)
                        {
                            <text>@timeUsedMinutes.ToString("0")<span style="font-size:15px;color:#6b7280;"> min</span></text>
                        }
                        else
                        {
                            <span style="font-size:18px;color:#6b7280;">Not recorded</span>
                        }
                    </div>
                    <div class="rb-mcq-tile-sub">
                        @if (mcq.AllottedMinutes.HasValue)
                        {
                            <text>of @mcq.AllottedMinutes minutes allotted</text>
                        }
                    </div>
                </div>

                @* Integrity Signals removed: tab-switch counts and candidate flags are
                   proctoring findings, and the proctoring report covers them in far more
                   detail than a two-line tile could. Keeping a summary here invited a
                   hiring call on the weaker of the two accounts. *@
            </div>

            @if (mcqSections.Any())
            {
                <div class="rb-mcq-section-head">
                    <h3 class="rb-mcq-section-title">Section-wise performance</h3>
                    <p class="rb-mcq-section-note">Pass mark 60% &middot; 40&ndash;59% needs review</p>
                </div>

                @*
                    One table rather than a bar chart followed by a table of the same numbers.
                    The score cell carries the bar, so the at-a-glance comparison survives while
                    each figure is still readable as a column.
                *@
                <div class="rb-mcq-table-wrap">
                    <table class="rb-mcq-table">
                        <thead>
                            <tr>
                                <th>Section</th>
                                <th class="is-num">Score</th>
                                <th class="is-num">Correct</th>
                                <th class="is-num">Attempted</th>
                                <th class="is-num">Questions</th>
                                <th class="is-num">Time (min)</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sec in mcqSections)
                            {
                                var pct = (double)sec.ScorePercent;

                                // Three bands, used for the bar and the pill alike so they cannot
                                // tell the reader different things about the same section.
                                var band = pct >= 60 ? "pass" : (pct >= 40 ? "mid" : "weak");
                                var barClass = band == "pass" ? "" : (band == "mid" ? "is-mid" : "is-weak");
                                var pillClass = band == "pass" ? "is-pass" : (band == "mid" ? "is-mid" : "is-fail");
                                var pillText = band == "pass" ? "Pass" : (band == "mid" ? "Review" : "Below par");

                                // Clamped so a stray value can never draw outside the track.
                                var barWidth = Math.Max(0, Math.Min(100, pct));

                                <tr>
                                    <td>
                                        <div class="rb-mcq-sec-name">@sec.SectionTitle</div>
                                        @if (!string.IsNullOrWhiteSpace(sec.SectionDescription))
                                        {
                                            <div class="rb-mcq-sec-desc">@sec.SectionDescription</div>
                                        }
                                    </td>
                                    <td class="is-num rb-mcq-score-cell">
                                        <span class="rb-mcq-score-value">@sec.ScorePercent.ToString("0.#")%</span>
                                        <span class="rb-mcq-bar-track">
                                            <span class="rb-mcq-bar-fill @barClass" style="width:@barWidth.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;"></span>
                                        </span>
                                    </td>
                                    <td class="is-num">@sec.Correct</td>
                                    <td class="is-num">@sec.Attempted</td>
                                    <td class="is-num">@sec.QuestionCount</td>
                                    <td class="is-num">@((sec.TimeSpentSeconds / 60.0).ToString("0.#"))</td>
                                    <td><span class="rb-mcq-pill @pillClass">@pillText</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Overall</td>
                                <td class="is-num">@mcq.ScorePercent.ToString("0.#")%</td>
                                <td class="is-num">@mcq.CorrectAnswers</td>
                                <td class="is-num">@attemptedTotal</td>
                                <td class="is-num">@mcq.TotalQuestions</td>
                                <td class="is-num">@((mcqSections.Sum(s => s.TimeSpentSeconds) / 60.0).ToString("0.#"))</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            @if (mcq.Questions != null && mcq.Questions.Any())
            {
                <div class="rb-mcq-section-head" style="margin-top:26px;">
                    <h3 class="rb-mcq-section-title">Detailed submission report</h3>
                    <p class="rb-mcq-section-note">
                        Every question as it was served, with the candidate's choice marked against the correct answer.
                    </p>
                </div>

                @* Grouped by section so the report reads the way the paper was sat.
                   Questions with no section (a paper generated before sectioning) fall
                   into one unnamed group rather than disappearing. *@
                @foreach (var group in mcq.Questions
                    .GroupBy(q => new { q.SectionKey, q.SectionTitle })
                    .OrderBy(g =>
                    {
                        // Paper order. A group whose key is not in the section list (a
                        // paper generated before sectioning) sorts last rather than
                        // first, which is what FindIndex's -1 would otherwise do.
                        var index = mcqSections.FindIndex(s => s.SectionKey == g.Key.SectionKey);
                        return index < 0 ? int.MaxValue : index;
                    }))
                {
                    var groupQuestions = group.OrderBy(q => q.QuestionNumber).ToList();
                    <div class="rb-mcq-qsection-title">
                        @(string.IsNullOrWhiteSpace(group.Key.SectionTitle) ? "Questions" : group.Key.SectionTitle)
                    </div>
                    <div class="rb-mcq-qsection-meta">
                        @groupQuestions.Count(q => q.WasAttempted) of @groupQuestions.Count attempted
                        &nbsp;&middot;&nbsp; @groupQuestions.Count(q => q.IsCorrect) correct
                    </div>

                    @foreach (var q in groupQuestions)
                    {
                        <div class="rb-mcq-q">
                            <div class="rb-mcq-q-head">
                                <span class="rb-mcq-q-num">@q.QuestionNumber</span>
                                <div class="rb-mcq-q-text">@q.Question</div>
                                <div class="rb-mcq-q-meta">
                                    @if (q.TimeSpentSeconds.HasValue && q.TimeSpentSeconds.Value > 0)
                                    {
                                        <div>@TimeSpan.FromSeconds(q.TimeSpentSeconds.Value).ToString(@"mm\:ss")</div>
                                    }
                                    <div style="font-weight:700;color:@(q.IsCorrect ? "#1a7f4b" : "#b42318");">
                                        @(q.IsCorrect ? "1 / 1" : "0 / 1")
                                    </div>
                                    @if (q.RedFlag == true)
                                    {
                                        <div style="color:#a35b00;">Flagged</div>
                                    }
                                </div>
                            </div>

                            @{
                                var selected = q.SelectedOptionNumbers;
                                var correct = q.CorrectOptionNumbers;
                                var optionKeys = new[] { "A", "B", "C", "D" };
                                var options = q.Options;
                            }

                            @for (var i = 0; i < options.Count; i++)
                            {
                                var optionNumber = i + 1;
                                if (string.IsNullOrWhiteSpace(options[i])) { continue; }

                                var isCorrectOption = correct.Contains(optionNumber);
                                var wasPicked = selected.Contains(optionNumber);
                                var rowClass = wasPicked && isCorrectOption
                                    ? "is-correct"
                                    : (wasPicked ? "is-wrong-pick" : (isCorrectOption ? "is-correct" : ""));

                                <div class="rb-mcq-opt @rowClass">
                                    <span class="rb-mcq-opt-key">@optionKeys[i].</span>
                                    <span>@options[i]</span>
                                    @if (wasPicked && isCorrectOption)
                                    {
                                        <span class="rb-mcq-opt-tag is-correct">Correctly attempted</span>
                                    }
                                    else if (wasPicked)
                                    {
                                        <span class="rb-mcq-opt-tag is-wrong-pick">Candidate's answer</span>
                                    }
                                    else if (isCorrectOption)
                                    {
                                        <span class="rb-mcq-opt-tag is-answer">Correct answer</span>
                                    }
                                </div>
                            }

                            @if (!q.WasAttempted)
                            {
                                <div style="font-size:12px;color:#6b7280;margin-top:8px;">Not attempted.</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(q.Explanation))
                            {
                                <div style="font-size:12px;color:#4b5563;margin-top:10px;padding-top:10px;border-top:1px dashed #e5e7eb;">
                                    <strong>Explanation:</strong> @q.Explanation
                                </div>
                            }
                        </div>
                    }
                }
            }
        </div>
    </div>
}
