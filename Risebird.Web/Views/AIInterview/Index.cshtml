<script>
    @* let totalSecondsLeft = parseInt("@Model.TimeLeftInSeconds" || "900");
    let interviewId = parseInt("@Model.InterviewId");
    const timerDisplay = document.getElementById("timer");
    const timeField = document.getElementById("timeLeftField");

