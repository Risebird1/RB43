                                    </p>
                                    <p style="font-size: 14px; color: #666;">
                                        <strong>Time taken:</strong> ${timeTaken.toFixed(2)} seconds
                                    </p>
                                </div>
                            `,
                            icon: 'success',
                            confirmButtonText: 'Continue',
                            confirmButtonColor: '#4eda92',
                            allowOutsideClick: false
                        }).then(() => {
                            // After showing result, trigger form submission with confirmation
                            const form = document.getElementById('chatForm');
                            if (form) {
                                Swal.fire({
                                    title: 'Submit Answer?',
                                    text: 'Are you sure you want to submit your listening comprehension assessment?',
                                    icon: 'question',
                                    showCancelButton: true,
                                    confirmButtonColor: '#4eda92',
                                    cancelButtonColor: '#d33',
                                    confirmButtonText: 'Submit Answer',
                                    cancelButtonText: 'Cancel',
                                    reverseButtons: false,
                                    focusConfirm: true
                                }).then((result) => {
                                    if (result.isConfirmed || result.value === true) {
                                        // User confirmed - submit the form
                                        form.submit();
                                    } else {
                                        // User cancelled
                                        console.log("Listening comprehension assessment submission cancelled");
                                    }
                                });
                            }
                        });
                        
                        // Return true to allow the modal to close
                        return true;
                    }
                }
            });
        }

        // Add hidden form fields to store listening comprehension data
        function addListeningHiddenFormFields() {
            const form = document.getElementById('chatForm');
            if (!form) return;

            const hiddenFields = [
                { name: 'IsListeningComprehensionQuestion', value: 'true' },
                { name: 'ListeningAudioUrl', value: '' },
                { name: 'ListeningAudioTranscription', value: '' },
                { name: 'ListeningSummary', value: '' },
                { name: 'ListeningStartTime', value: '' },
                { name: 'ListeningEndTime', value: '' },
                { name: 'ListeningTimeTaken', value: '' }
            ];

            hiddenFields.forEach(field => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = field.name;
                input.id = field.name;
                input.value = field.value;
                form.appendChild(input);
            });
        }

        // Initialize listening comprehension assessment
        setTimeout(() => {
            addListeningHiddenFormFields();
            showListeningComprehensionModal();
        }, 1000); // Show modal 1 second after page load

    })();
</script>