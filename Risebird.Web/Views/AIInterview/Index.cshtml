        .rb-cp-connecting .lg { color: #5E6C85; font-size: 11px; }
        @@keyframes rbCpSpin { to { transform: rotate(360deg); } }
        @@media (prefers-reduced-motion: reduce) { .rb-cp-connecting .sp { animation: none; } }
        .rb-cp-ide { background: #1B2230; border-radius: 5px; overflow: hidden; border: 1px solid #10151F; }
        .rb-cp-ide .bar { background: #141A25; padding: 7px 12px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #0C1017; }
        .rb-cp-ide .bar .d { width: 10px; height: 10px; border-radius: 50%; }
        .rb-cp-ide .bar .u { margin-left: 12px; font-family: ui-monospace, Menlo, monospace; font-size: 11px; color: #7E8DA6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .rb-cp-ide .body { display: grid; grid-template-columns: 200px minmax(0, 1fr); min-height: 300px; }
        @@media (max-width: 640px) { .rb-cp-ide .body { grid-template-columns: 1fr; } }
        .rb-cp-ide .fs { background: #171E2B; padding: 10px 0; font-family: ui-monospace, Menlo, monospace; font-size: 11px; color: #8494AD; border-right: 1px solid #0F141D; overflow: auto; max-height: 360px; }
        .rb-cp-ide .fs div { padding: 2.5px 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .rb-cp-ide .fs .sel { background: #212B3D; color: #E6EDF7; }
        .rb-cp-ide .open { padding: 22px; display: flex; flex-direction: column; gap: 14px; justify-content: center; color: #C6D2E4; }
        .rb-cp-ide .open p { margin: 0; font-size: 13px; color: #93A3BC; }
        .rb-cp-ide .term { background: #10151F; border-top: 1px solid #0C1017; padding: 10px 15px; font-family: ui-monospace, Menlo, monospace; font-size: 11.5px; color: #93A3BC; line-height: 1.7; white-space: pre-wrap; }
        .rb-cp-ide .term .g2 { color: #8FD6A8; }
        .rb-cp-done { margin-top: 14px; display: flex; gap: 9px; flex-wrap: wrap; align-items: center; }
        .rb-cp-cred { background: #141A25; border: 1px solid #2B3648; border-radius: 4px; padding: 10px 12px; display: grid; gap: 6px; }
        .rb-cp-cred div { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
        .rb-cp-cred span { font-size: 11.5px; color: #7E8DA6; text-transform: uppercase; letter-spacing: .06em; }
        .rb-cp-cred code { font-family: ui-monospace, Menlo, monospace; font-size: 13px; color: #E6EDF7; background: none; word-break: break-all; }
        .rb-cp-copy { background: none; border: 1px solid #3A4A66; color: #C6D2E4; border-radius: 3px; font-size: 11px; padding: 3px 9px; cursor: pointer; }
        .rb-cp-copy:hover { border-color: #7FB3F5; color: #fff; }
        .rb-cp-err { color: #DC3545; font-size: 12.5px; }
    </style>

    <div class="rb-cp-overlay" id="codeProjectOverlay" role="dialog" aria-modal="true" aria-labelledby="cpTitle">
        <header class="rb-cp-top">
            <span class="brand">Code Project</span>
        </header>
        <main class="rb-cp-main">
            <div class="rb-cp-headrow">
                <h1 id="cpTitle">Loading your task…</h1>
                <span class="rb-cp-badge" id="cpSkill" style="display:none"></span>
                <span class="rb-cp-badge" id="cpStack" style="display:none"></span>
            </div>

            <div class="rb-cp-split">
                <section class="rb-cp-panel" aria-label="Your task">
                    <div class="ph"><h2>Your task</h2><span class="r"><span class="rb-cp-timer" id="cpClock" aria-live="off">--:--</span></span></div>
                    <div class="rb-cp-pb rb-cp-stmt">
                        <p id="cpStatement"></p>
                        <div id="cpImplementWrap" style="display:none">
                            <h3>Implement</h3>
                            <ul id="cpRequirements"></ul>
                        </div>
                        <div id="cpEditWrap" style="display:none">
                            <h3>Files to change</h3>
                            <ul id="cpEditable"></ul>
                        </div>
                        <h3>Submit</h3>
                        <p>Commit from the terminal on your machine. Commit as often as you like — we grade your last commit when you press <b>Submit</b> or when time runs out.</p>
                        <div class="rb-cp-tree" id="cpCommitHint">git add -A
git commit -m "implement the requirements"</div>
                        <div class="rb-cp-note">Your work stays on the machine. If your connection drops, open it again and everything will be exactly as you left it. The timer keeps running.</div>
                    </div>
                </section>

                <section class="rb-cp-panel" aria-label="Environment">
                    <div class="ph"><h2>Environment</h2><span class="r" id="cpEnvStatus"><span class="rb-cp-badge">Not started</span></span></div>
                    <div class="rb-cp-pb">
                        <div class="rb-cp-idle" id="cpIdle">
                            <div class="ic" aria-hidden="true">▣</div>
                            <p id="cpIdleText">A private machine with the project and its tools already installed.</p>
                            <button type="button" class="rb-cp-btn" id="cpLaunchBtn">Launch environment</button>
                            <p class="rb-cp-err" id="cpIdleErr" style="display:none;margin-top:12px"></p>
                        </div>

                        <div class="rb-cp-connecting" id="cpConnecting" style="display:none">
                            <div>
                                <div class="sp" aria-hidden="true"></div>
                                <p id="cpConnMsg" aria-live="polite">Allocating machine…</p>
                                <p class="lg" id="cpConnLog"></p>
                            </div>
                        </div>

                        <div class="rb-cp-ide" id="cpIde" style="display:none">
                            <div class="bar">
                                <span class="d" style="background:#E0555F"></span><span class="d" style="background:#E6B450"></span><span class="d" style="background:#4FB477"></span>
                                <span class="u" id="cpIdeUrl">Secure session</span>
                            </div>
                            <div class="body">
                                <div class="fs" id="cpFiles" aria-label="Project files"></div>
                                <div class="open">
                                    <p>Your machine is ready. It opens in a new tab over a secure connection — no RDP port is exposed. Sign in there with:</p>
                                    <div class="rb-cp-cred" id="cpCred" style="display:none">
                                        <div><span>Username</span><code id="cpUser"></code><button type="button" class="rb-cp-copy" data-copy="cpUser">Copy</button></div>
                                        <div><span>Password</span><code id="cpPass"></code><button type="button" class="rb-cp-copy" data-copy="cpPass">Copy</button></div>
                                    </div>
                                    <div><a class="rb-cp-btn" id="cpOpenLink" href="#" target="_blank" rel="noopener">Open my machine ↗</a></div>
                                    <p>The project is in <code>C:\workspace</code>. Files in blue are the ones to change.</p>
                                </div>
                            </div>
                            <div class="term" id="cpTerm"></div>
                        </div>

                        <div class="rb-cp-done" id="cpDone" style="display:none">
                            <button type="button" class="rb-cp-btn grn" id="cpSubmitBtn">Submit &amp; finish →</button>
                            <span class="rb-cp-err" id="cpSubmitErr" style="display:none"></span>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script>
        (function () {
            var sessionId = @Json.Serialize(Model.SessionId.ToString());
            var questionId = @Json.Serialize(Model.CurrentQuestionId);
            var envUrl = '@Url.Action("CodeProjectEnvironment", "AIInterview")';
            var launchUrl = '@Url.Action("CodeProjectLaunch", "AIInterview")';
            var submitUrl = '@Url.Action("SubmitCodeProject", "AIInterview")';
            var overlay = document.getElementById('codeProjectOverlay');
            var $ = function (id) { return document.getElementById(id); };

            var launching = false, submitted = false, pollTimer = null, clockTimer = null, deadline = null;
            var qs = '?sid=' + encodeURIComponent(sessionId) + '&questionId=' + encodeURIComponent(questionId);

            // The candidate must not answer the interview question underneath while the project is open.
            ['startRecordingBtn', 'stopRecordingBtn', 'submitAnswerBtn', 'sendBtn'].forEach(function (id) {
                var el = $(id); if (el) el.disabled = true;
            });

            function show(id, on) { var el = $(id); if (el) el.style.display = on ? '' : 'none'; }
            function badge(text, cls) { $('cpEnvStatus').innerHTML = '<span class="rb-cp-badge ' + (cls || '') + '"></span>'; $('cpEnvStatus').firstChild.textContent = text; }
            function post(url) {
                return fetch(url + qs, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(function (r) { return r.json(); });
            }

            function renderTask(task) {
                if (!task) return;
                var text = task.questionText || '';
                var firstLine = text.split(/\r?\n/)[0];
                $('cpTitle').textContent = firstLine.length > 90 ? firstLine.substring(0, 90) + '…' : (firstLine || 'Code project');
                $('cpStatement').textContent = text;
                if (task.skillName) { $('cpSkill').textContent = task.skillName; show('cpSkill', true); }
                if (task.stackImageCode) { $('cpStack').textContent = task.framework || task.stackImageCode; show('cpStack', true); }

                var reqs = $('cpRequirements'); reqs.innerHTML = '';
                (task.requirements || []).forEach(function (r) { var li = document.createElement('li'); li.textContent = r; reqs.appendChild(li); });
                show('cpImplementWrap', (task.requirements || []).length > 0);

                var edit = $('cpEditable'); edit.innerHTML = '';
                (task.editableFiles || []).forEach(function (f) { var li = document.createElement('li'); var c = document.createElement('code'); c.textContent = f; li.appendChild(c); edit.appendChild(li); });
                show('cpEditWrap', (task.editableFiles || []).length > 0);

                var files = $('cpFiles'); files.innerHTML = '';
                var editable = (task.editableFiles || []).map(function (f) { return f.toLowerCase(); });
                (task.files || []).forEach(function (f) {
                    var d = document.createElement('div');
                    d.textContent = f; d.title = f;
                    if (editable.indexOf(f.toLowerCase()) >= 0) d.className = 'sel';
                    files.appendChild(d);
                });

                var term = [];
                if (task.buildCommand) term.push('<span class="g2">PS C:\\workspace&gt;</span> ' + escapeHtml(task.buildCommand));
                if (task.testCommand) term.push('<span class="g2">PS C:\\workspace&gt;</span> ' + escapeHtml(task.testCommand));
                term.push('<span class="g2">PS C:\\workspace&gt;</span> git commit -am "…"');
                $('cpTerm').innerHTML = term.join('\n');

                if (!deadline) setClock((task.timeLimitMinutes || 15) * 60);
            }

            function escapeHtml(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

            function setClock(seconds) {
                var s = Math.max(0, seconds | 0);
                var m = Math.floor(s / 60), r = s % 60;
                $('cpClock').textContent = String(m).padStart(2, '0') + ':' + String(r).padStart(2, '0');
                $('cpClock').classList.toggle('low', deadline !== null && s <= 120);
            }

            // Server-authoritative: secondsRemaining is computed from the handover time.
            function startClock(secondsRemaining) {
                deadline = Date.now() + secondsRemaining * 1000;
                if (clockTimer) clearInterval(clockTimer);
                var tick = function () {
                    var left = Math.round((deadline - Date.now()) / 1000);
                    setClock(left);
                    if (left <= 0) { clearInterval(clockTimer); submit(true); }
                };
                tick();
                clockTimer = setInterval(tick, 1000);
            }

            function renderEnv(env) {
                if (!env) return;
                var state = env.state;
                if (state === 'handedover') {
                    stopPolling();
                    show('cpIdle', false); show('cpConnecting', false); show('cpIde', true); show('cpDone', true);
                    badge('Connected', 'ok');
                    if (env.connectUrl) {
                        $('cpOpenLink').href = env.connectUrl;
                        try { $('cpIdeUrl').textContent = new URL(env.connectUrl).host; } catch (e) { }
                    }
                    // The Bastion page asks for these; the link itself carries no credentials.
                    if (env.username && env.password) {
                        $('cpUser').textContent = env.username;
                        $('cpPass').textContent = env.password;
                        show('cpCred', true);
                    }
                    if (typeof env.secondsRemaining === 'number' && deadline === null) startClock(env.secondsRemaining);
                    return;
                }
                if (state === 'failed') {
                    stopPolling();
                    launching = false;
                    show('cpConnecting', false); show('cpIdle', true);
                    badge('Unavailable', 'err');
                    $('cpIdleText').textContent = 'Your environment could not be started.';
                    $('cpIdleErr').textContent = (env.message || 'Please try again.') + ' You can continue to the next question; the reviewer will see that the environment was unavailable.';
                    show('cpIdleErr', true);
                    var btn = $('cpLaunchBtn');
                    btn.disabled = false; btn.textContent = 'Continue interview';
                    btn.onclick = function () { submit(false); };
                    return;
                }
                if (launching) {
                    show('cpIdle', false); show('cpConnecting', true);
                    badge('Connecting', 'run');
                    $('cpConnMsg').textContent = env.message || (state === 'ready' ? 'Opening secure session…' : 'Allocating machine…');
                } else {
                    badge(state === 'ready' ? 'Ready' : 'Preparing', state === 'ready' ? 'ok' : '');
                }
            }

            function stopPolling() { if (pollTimer) { clearTimeout(pollTimer); pollTimer = null; } }

            function refresh() {
                return fetch(envUrl + qs, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data || !data.success) return;
                        renderTask(data.task);
                        renderEnv(data.environment);
                        // A reload after handover goes straight back to the connected view.
                        if (data.environment && data.environment.state === 'handedover') launching = true;
                    })
                    .catch(function () { });
            }

            // Launch hands over as soon as the machine is ready; until then keep asking.
            function launchStep() {
                post(launchUrl).then(function (data) {
                    if (!data || !data.success) { pollTimer = setTimeout(launchStep, 4000); return; }
                    renderEnv(data.environment);
                    var s = data.environment && data.environment.state;
                    if (s !== 'handedover' && s !== 'failed') pollTimer = setTimeout(launchStep, 3000);
                }).catch(function () { pollTimer = setTimeout(launchStep, 5000); });
            }

            document.querySelectorAll('.rb-cp-copy').forEach(function (b) {
                b.addEventListener('click', function () {
                    var text = ($(b.getAttribute('data-copy')) || {}).textContent || '';
                    if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () {
                        b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy'; }, 1500);
                    });
                });
            });

            $('cpLaunchBtn').addEventListener('click', function () {
                if (launching) return;
                launching = true;
                this.disabled = true;
                show('cpIdleErr', false);
                show('cpIdle', false); show('cpConnecting', true);
                badge('Connecting', 'run');
                launchStep();
            });

            function submit(timeExpired) {
                if (submitted) return;
                submitted = true;
                stopPolling();
                if (clockTimer) clearInterval(clockTimer);
                var btn = $('cpSubmitBtn');
                if (btn) { btn.disabled = true; btn.textContent = timeExpired ? 'Time is up — submitting…' : 'Submitting…'; }

                // Grade first (reads the last commit off the machine), then advance the interview.
                // If grading is slow or fails, the answer post grades again server-side.
                var finish = function () {
                    var form = $('chatForm');
                    if (!form) { window.location.reload(); return; }
                    ['audioInput', 'videoInput'].forEach(function (id) { var el = $(id); if (el) el.value = ''; });
                    if (typeof answerSubmitInFlight !== 'undefined') answerSubmitInFlight = true;
                    form.submit();
                };
                post(submitUrl).then(finish, finish);
            }

            $('cpSubmitBtn').addEventListener('click', function () {
                var go = function () { submit(false); };
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Submit your project?',
                        text: 'We grade your last commit. Uncommitted changes are not included, and you cannot return to this question.',
                        icon: 'question', showCancelButton: true,
                        confirmButtonColor: '#2E9E5B', cancelButtonColor: '#d33',
                        confirmButtonText: 'Submit', cancelButtonText: 'Keep working'
                    }).then(function (r) { if (r.isConfirmed || r.value === true) go(); });
                } else if (window.confirm('Submit your project? We grade your last commit.')) {
                    go();
                }
            });

            setTimeout(function () {
                if (overlay) overlay.classList.add('is-open');
                refresh();
            }, 1000);
        })();
    </script>
}

@*
    ================================================================================
    MCQ assessment section
    ================================================================================
    One question in the delivery order is flagged as the MCQ section. When it comes up, the
    interview hands the viewport to a full-screen overlay containing the real MCQ test, served
    in an iframe from screen.risebird.io.

    Why an iframe rather than reproducing the test here:

      - The requirement is that the section must not look foreign to the MCQ UI. An iframe of the
        actual page is not an imitation of that UI, it IS that UI - same stylesheet, same question
        card, same navigator, same behaviour. A reimplementation would look right the day it
        shipped and drift from then on.
      - The test, its questions and its answer key stay on the MCQ side. Nothing about the paper
        is copied into this application, and the browser never receives the answer key.
      - The MCQ team keeps ownership of the test. A change to the exam page reaches this section
        with no deployment here.

    The overlay is opened automatically and cannot be dismissed by the candidate: this is a
    proctored, timed section, and leaving it half-done has to be a submit, not a close. The
    interview's own proctoring (screen capture, focus tracking) keeps running underneath.

    The iframe reports back by postMessage. The portal never trusts it for anything but "the
    candidate is done" - the score is read server-to-server from the MCQ API afterwards, so a
    forged message can end the section early but cannot invent a result.
*@
@if (Model.IsMcqAssessmentQuestion)
{
    <style>
        .rb-mcq-overlay {
            position: fixed;
            inset: 0;
            z-index: 3000;
            background: #0f172a;
            display: none;
        }

            .rb-mcq-overlay.is-open {
                display: flex;
                flex-direction: column;
            }

        .rb-mcq-topbar {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 10px 18px;
            background: #111827;
            color: #fff;
            font-size: 13px;
        }

        .rb-mcq-topbar-title {
            font-weight: 600;
        }

        .rb-mcq-topbar-sections {
            color: #9ca3af;
            font-size: 12px;
        }

        .rb-mcq-frame {
            flex: 1 1 auto;
            width: 100%;
            border: 0;
            background: #f7f8fc;
        }

        .rb-mcq-briefing {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: #0f172a;
            z-index: 2;
        }

        .rb-mcq-briefing-card {
            background: #fff;
            border-radius: 14px;
            padding: 32px 36px;
            max-width: 560px;
            box-shadow: 0 20px 60px rgba(0,0,0,.4);
        }

            .rb-mcq-briefing-card h2 {
                font-size: 20px;
                font-weight: 700;
                margin: 0 0 8px;
                color: #111827;
            }

            .rb-mcq-briefing-card p {
                font-size: 14px;
                line-height: 1.6;
                color: #4b5563;
                margin: 0 0 16px;
            }

        .rb-mcq-section-list {
            margin: 0 0 20px;
            padding: 0;
            list-style: none;
        }

            .rb-mcq-section-list li {
                font-size: 13px;
                color: #374151;
                padding: 8px 12px;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                margin-bottom: 8px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .rb-mcq-meta {
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 20px;
        }

        .rb-mcq-start-btn {
            width: 100%;
            padding: 13px;
            border: 0;
            border-radius: 9px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>

    <div class="rb-mcq-overlay" id="mcqOverlay" role="dialog" aria-modal="true" aria-label="Assessment section">
        <div class="rb-mcq-topbar">
            <span class="rb-mcq-topbar-title">Assessment Section</span>
            <span class="rb-mcq-topbar-sections">
                @if (Model.McqSectionTitles != null && Model.McqSectionTitles.Count > 0)
                {
                    @string.Join("  |  ", Model.McqSectionTitles)
                }
            </span>
        </div>

        @* Only the server-known "this channel has no usable MCQ section" case renders the notice.
           A provisioning failure is discovered later, when Start is pressed, and is handled there. *@
        @if (Model.McqSectionUnavailable)
        {
            @* The section could not be prepared. The candidate is mid-interview and being
               proctored, so the only acceptable outcome is a clear way forward - never a dead
               panel. The server records the section as not completed. *@
            <div class="rb-mcq-briefing">
                <div class="rb-mcq-briefing-card">
                    <h2>Assessment section unavailable</h2>
                    <p>
                        This part of the interview could not be loaded. This is not a problem with
                        anything you did, and it will not count against you. Please continue with
                        the rest of your interview.
                    </p>
                    <button type="button" class="rb-mcq-start-btn" id="mcqSkipUnavailable">Continue interview</button>
                </div>
            </div>
        }
        else
        {
            @* The briefing sits above the iframe until the candidate starts, so the timer on the
               MCQ side does not begin running while they are still reading what the section is. *@
            <div class="rb-mcq-briefing" id="mcqBriefing">
                <div class="rb-mcq-briefing-card">
                    <h2>Assessment section</h2>
                    <p>
                        The next part of your interview is a written assessment. It is divided into
                        sections, each with its own set of questions. Your answers are saved as you
                        go, and you can move between questions freely within the assessment.
                    </p>

                    @if (Model.McqSectionTitles != null && Model.McqSectionTitles.Count > 0)
                    {
                        <ul class="rb-mcq-section-list">
                            @foreach (var sectionTitle in Model.McqSectionTitles)
                            {
                                <li><i class="fa fa-check-circle" style="color:#2a5298;"></i> @sectionTitle</li>
                            }
                        </ul>
                    }

                    <div class="rb-mcq-meta">
                        @if (Model.McqTotalMinutes > 0)
                        {
                            <text>@Model.McqTotalMinutes minutes &nbsp;-&nbsp; </text>
                        }
                        Recording and screen monitoring continue during this section
                    </div>

                    @* Your paper is built when you press this, not on page load: generating a
                       sectioned paper takes a while, and doing it before the candidate is ready
                       would burn their clock and leave them on a blank screen. *@
                    <button type="button" class="rb-mcq-start-btn" id="mcqStartBtn">Start assessment</button>
                    <div id="mcqPrepStatus" style="display:none;font-size:12px;color:#6b7280;margin-top:12px;text-align:center;"></div>
                </div>
            </div>

            @* src is set on Start, not here: loading it now would start the section's clock on the
               MCQ side while the candidate is still reading the briefing. *@
            <iframe id="mcqFrame"
                    class="rb-mcq-frame"
                    title="Assessment section"
                    allow="fullscreen"
                    referrerpolicy="origin"></iframe>
        }
    </div>

    <script>
        (function () {
            var overlay = document.getElementById('mcqOverlay');
            var frame = document.getElementById('mcqFrame');
            var briefing = document.getElementById('mcqBriefing');
            var startBtn = document.getElementById('mcqStartBtn');
            var skipBtn = document.getElementById('mcqSkipUnavailable');
            var prepStatus = document.getElementById('mcqPrepStatus');
            var sessionId = @Json.Serialize(Model.SessionId.ToString());
            var submitted = false;

            // Set once the section has been provisioned. Only messages from that origin are acted
            // on - without the check, any page holding a handle on this window could end the
            // section early.
            var expectedOrigin = null;

            if (overlay) overlay.classList.add('is-open');

            // The candidate must not be able to answer the interview question underneath while
            // the assessment is open, so the usual record/submit controls are taken out of reach.
            function lockInterviewControls() {
                ['startRecordingBtn', 'stopRecordingBtn', 'submitAnswerBtn', 'sendBtn'].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.disabled = true;
                });
            }
            lockInterviewControls();

            function setPrepStatus(text) {
                if (!prepStatus) return;
                prepStatus.style.display = text ? 'block' : 'none';
                prepStatus.textContent = text || '';
            }

            // Provisioning generates the paper, so it is slow the first time - the candidate is
            // told what is happening rather than left watching a disabled button.
            function startAssessment() {
                if (!startBtn) return;
                startBtn.disabled = true;
                startBtn.textContent = 'Preparing your assessment...';
                setPrepStatus('Building your question paper. This can take up to a minute - please do not close this window.');

                fetch('@Url.Action("PrepareMcqSection", "AIInterview")?sid=' + encodeURIComponent(sessionId), {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (!data || data.unavailable || !data.embedUrl) {
                            // Nothing to sit. Offer the way forward rather than a dead panel.
                            startBtn.textContent = 'Continue interview';
                            startBtn.disabled = false;
                            startBtn.onclick = finishSection;
                            setPrepStatus('This section could not be prepared. It will not count against you.');
                            return;
                        }

                        try { expectedOrigin = new URL(data.embedUrl, window.location.href).origin; } catch (e) { }

                        if (frame) frame.src = data.embedUrl;
                        if (briefing) briefing.style.display = 'none';
                    })
                    .catch(function () {
                        startBtn.textContent = 'Try again';
                        startBtn.disabled = false;
                        setPrepStatus('Could not reach the assessment service. Check your connection and try again.');
                    });
            }

            if (startBtn) startBtn.addEventListener('click', startAssessment);

            // Submits this interview question. The answer body is built server-side from the MCQ
            // API, so nothing about the result is taken from the page.
            function finishSection() {
                if (submitted) return;
                submitted = true;

                var form = document.getElementById('chatForm');
                if (!form) { window.location.reload(); return; }

                // No marker is posted for "this was the MCQ section": the server decides that from
                // CurrentQuestionId, because the flag waives the recorded-answer checks and so must
                // not be something the browser can assert.

                // No audio or video is captured for this question - there is nothing spoken to
                // record - so the recording inputs are cleared to keep the post small.
                ['audioInput', 'videoInput'].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.value = '';
                });

                if (overlay) {
                    overlay.innerHTML =
                        '<div class="rb-mcq-briefing"><div class="rb-mcq-briefing-card">' +
                        '<h2>Assessment submitted</h2>' +
                        '<p>Returning you to your interview...</p>' +
                        '</div></div>';
                }

                form.submit();
            }

            if (skipBtn) skipBtn.addEventListener('click', finishSection);

            window.addEventListener('message', function (event) {
                if (expectedOrigin && event.origin !== expectedOrigin) return;

                var data = event.data;
                if (!data || data.source !== 'risebird-mcq-section') return;

                if (data.type === 'section-complete' || data.type === 'section-unavailable') {
                    finishSection();
                }
            });
        })();
    </script>
}
