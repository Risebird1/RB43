    /* =============================
       Audio Phone UI Styles
       ============================= */

    .rb-audio-phone-section {
        flex: 1.8;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding-top: 8px;
    }

    .rb-phone-card {
        position: relative;
        width: 290px;
        background: #fff;
        border-radius: 44px;
        border: 10px solid #1a1a2e;
        box-shadow: 0 25px 70px rgba(0,0,0,0.35), inset 0 0 0 1px rgba(255,255,255,0.08), 0 0 0 2px #2d2d5e;
        overflow: hidden;
        min-height: 530px;
        display: flex;
        flex-direction: column;
    }

    .rb-phone-notch {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 26px;
        background: #1a1a2e;
        border-radius: 0 0 18px 18px;
        z-index: 10;
    }

    .rb-phone-status {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 18px 0;
        font-size: 0.68rem;
        font-weight: 700;
        color: rgba(255,255,255,0.9);
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 5;
    }

    .rb-phone-status-icons {
        display: flex;
        gap: 5px;
        align-items: center;
        font-size: 0.65rem;
    }

    .rb-phone-avatar-area {
        position: relative;
        width: 100%;
        flex: 1;
        background: linear-gradient(160deg, #1a1a3e 0%, #2d1b69 40%, #4a1942 70%, #1a1a3e 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        overflow: hidden;
    }

    .rb-phone-avatar-area::before {
        content: '';
        position: absolute;
        top: 15%;
        left: 15%;
        width: 180px;
        height: 180px;
        background: radial-gradient(circle, rgba(78,218,146,0.12) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .rb-phone-avatar-area::after {
        content: '';
        position: absolute;
        bottom: 10%;
        right: 10%;
        width: 130px;
        height: 130px;
        background: radial-gradient(circle, rgba(86,224,203,0.09) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    /* AI interviewer block: avatar + waves below, positioned toward top so not hidden by candidate video */
    .rb-phone-ai-block {
        position: absolute;
        top: 72px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        z-index: 2;
    }

    .rb-ai-interviewer-avatar {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4eda92 0%, #56e0cb 50%, #667eea 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        border: 3px solid rgba(255,255,255,0.3);
        box-shadow: 0 8px 32px rgba(0,0,0,0.3), 0 0 0 6px rgba(78,218,146,0.12);
        position: relative;
        transition: box-shadow 0.4s ease, transform 0.3s ease;
    }

    /* Meet-style strong highlight when AI is speaking - clearly visible */
    .rb-ai-interviewer-avatar.speaking {
        box-shadow: 0 8px 32px rgba(0,0,0,0.25), 0 0 0 4px rgba(78,218,146,0.9), 0 0 0 12px rgba(78,218,146,0.5), 0 0 24px 8px rgba(78,218,146,0.35);
        animation: avatarPulse 1.5s ease-in-out infinite;
        transform: scale(1.02);
    }

    @@keyframes avatarPulse {
        0%, 100% { box-shadow: 0 8px 32px rgba(0,0,0,0.25), 0 0 0 4px rgba(78,218,146,0.9), 0 0 0 12px rgba(78,218,146,0.5), 0 0 24px 8px rgba(78,218,146,0.35); transform: scale(1.02); }
        50% { box-shadow: 0 8px 32px rgba(0,0,0,0.25), 0 0 0 6px rgba(78,218,146,0.85), 0 0 0 18px rgba(78,218,146,0.45), 0 0 32px 12px rgba(78,218,146,0.4); transform: scale(1.03); }
    }

    .rb-phone-inner-header {
        position: absolute;
        top: 34px;
        left: 12px;
        right: 12px;
        z-index: 5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rb-phone-nav-back {
        width: 32px;
        height: 32px;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        border: none;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.85rem;
        transition: background 0.2s;
    }

    .rb-phone-nav-back:hover { background: rgba(255,255,255,0.25); }

    .rb-phone-nav-avatars { display: flex; align-items: center; }

    .rb-phone-nav-avatar-item {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.75rem;
        color: white;
        margin-left: -8px;
    }

    .rb-phone-nav-avatar-item:first-child { margin-left: 0; background: linear-gradient(135deg, #4eda92, #56e0cb); }
    .rb-phone-nav-avatar-item:last-child  {     background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }

    .rb-phone-mini-candidate {
        position: absolute;
        bottom: 8px;
        right: 12px;
        width: 128px;
        height: 139px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 14px;
        border: 2.5px solid rgba(255,255,255,0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.6rem;
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        z-index: 3;
        overflow: hidden;
        transition: box-shadow 0.4s ease, border-color 0.4s ease;
    }

    /* Candidate live video (proctoring) - fills the candidate area */
    .rb-phone-candidate-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        z-index: 1;
        background: #1a1a2e;
    }
    .rb-phone-mini-candidate .rb-phone-candidate-fallback-icon {
        position: relative;
        z-index: 0;
    }
    .rb-phone-mini-candidate.has-video .rb-phone-candidate-fallback-icon {
        display: none;
    }

    /* Meet-style highlight when candidate is speaking (recording) */
    .rb-phone-mini-candidate.speaking {
        border-color: rgba(255,255,255,0.95);
        box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 4px rgba(102,126,234,0.5), 0 0 0 10px rgba(118,75,162,0.25);
        animation: candidateAvatarPulse 1.5s ease-in-out infinite;
    }

    @@keyframes candidateAvatarPulse {
        0%, 100% { box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 4px rgba(102,126,234,0.5), 0 0 0 10px rgba(118,75,162,0.25); }
        50% { box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 6px rgba(102,126,234,0.4), 0 0 0 14px rgba(118,75,162,0.2); }
    }

    /* Candidate audio waves (shown when candidate is recording) */
    .rb-candidate-audio-waves {
        position: absolute;
        bottom: 4px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
        z-index: 4;
        pointer-events: none;
    }

    .rb-candidate-audio-waves .wave-bar {
        width: 2px;
        height: 12px;
        background: rgba(255,255,255,0.95);
        border-radius: 1px;
        animation: waveAnimation 1.2s ease-in-out infinite;
    }

    .rb-candidate-audio-waves .wave-bar:nth-child(1) { animation-delay: 0s; }
    .rb-candidate-audio-waves .wave-bar:nth-child(2) { animation-delay: 0.1s; }
    .rb-candidate-audio-waves .wave-bar:nth-child(3) { animation-delay: 0.2s; }
    .rb-candidate-audio-waves .wave-bar:nth-child(4) { animation-delay: 0.3s; }
    .rb-candidate-audio-waves .wave-bar:nth-child(5) { animation-delay: 0.4s; }

    /* AI waves: just below AI interviewer circle (when inside .rb-phone-ai-block) - visible when AI is speaking */
    .rb-phone-ai-block .rb-phone-audio-waves-wrap {
        position: relative;
        bottom: -15px;
        left: auto;
        transform: none;
        z-index: 3;
    }
    .rb-phone-ai-block .rb-audio-waves {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        margin-left: 0;
    }
    .rb-phone-ai-block .rb-audio-waves .wave-bar {
        width: 4px;
        height: 18px;
        background: #4eda92;
        border-radius: 2px;
        animation: waveAnimation 1.2s ease-in-out infinite;
        box-shadow: 0 0 8px rgba(78,218,146,0.5);
    }
    .rb-phone-audio-waves-wrap {
        position: absolute;
        bottom: 22px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
    }

    .rb-phone-bottom-panel {
        position: relative;
