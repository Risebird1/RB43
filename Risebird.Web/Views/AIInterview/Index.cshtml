        /* Tooltip Styles */
        .rb-footer-btn::before {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 100%;
            right: 0%;
            left: 100px;
            max-width: auto;
            width: max-content;
            transform: translateX(-50%);
            padding: 6px 7px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            white-space: nowrap;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 100;
            margin-bottom: 8px;
            border: 0px !important;
            box-shadow: none !important;
        }

        .rb-footer-btn::after {
            content: '';
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-top-color: rgba(0, 0, 0, 0.8);
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            margin-bottom: 3px;
        }

        .rb-footer-btn:hover::before,
        .rb-footer-btn:hover::after {
            opacity: 1;
            visibility: visible;
        }

    .rb-btn-primary {
        background: linear-gradient(90deg, #4eda92 0%, #56e0cb 100%);
