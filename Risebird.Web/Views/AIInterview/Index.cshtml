<script>
    // Chat Box Popup Expand/Collapse Functionality
    document.addEventListener('DOMContentLoaded', function() {
        const expandBtn = document.getElementById('expandChatBtn');
        const chatBoxPopup = document.getElementById('chatBoxPopup');
        const closeChatPopup = document.getElementById('closeChatPopup');
        const codeEditorPopup = document.getElementById('codeEditorPopup');
        const codeLanguagePopup = document.getElementById('codeLanguagePopup');
        const messageTextarea = document.getElementById('messageTextarea');
        let codeEditorPopupInstance = null;
        
        // Only proceed if popup elements exist (when showChatBox is true)
        if (!expandBtn || !chatBoxPopup) {
            return;
        }
        
        // Initialize popup CodeMirror editor if it doesn't exist
        function initializePopupEditor() {
            if (!codeEditorPopupInstance && codeEditorPopup && typeof CodeMirror !== 'undefined') {
                // Clear any existing content
                codeEditorPopup.innerHTML = '';
                const existingCode = typeof codeEditor !== 'undefined' && codeEditor ? codeEditor.getValue() : '';
                
                codeEditorPopupInstance = CodeMirror(codeEditorPopup, {
                    value: existingCode || messageTextarea.value || '',
                    mode: typeof codeEditor !== 'undefined' && codeEditor ? codeEditor.getOption('mode') : 'text',
                    theme: 'default',
                    lineNumbers: true,
                    lineWrapping: true,
                    indentUnit: 4,
                    indentWithTabs: false,
                    smartIndent: true,
                    autoCloseBrackets: true,
                    matchBrackets: true,
                    styleActiveLine: true,
                    readOnly: typeof codeEditor !== 'undefined' && codeEditor ? codeEditor.getOption('readOnly') : true,
                    placeholder: typeof codeEditor !== 'undefined' && codeEditor ? codeEditor.getOption('placeholder') : 'Start recording to enable code editor...',
                    viewportMargin: Infinity,
                    extraKeys: {
                        "Ctrl-Space": "autocomplete",
                        "Tab": function(cm) {
                            if (cm.somethingSelected()) {
                                cm.indentSelection("add");
                            } else {
                                cm.replaceSelection("    ", "end");
                            }
                        },
                        "Shift-Tab": function(cm) {
                            cm.indentSelection("subtract");
                        },
                        "Ctrl-C": function() { return false; },
                        "Ctrl-V": function() { return false; },
                        "Ctrl-X": function() { return false; },
                        "Cmd-C": function() { return false; },
                        "Cmd-V": function() { return false; },
                        "Cmd-X": function() { return false; },
                        "Ctrl-Enter": function() {
                            syncPopupToMain();
                            const submitBtn = document.querySelector('.rb-chatbox-sendbtn');
                            if (submitBtn) {
                                submitBtn.click();
                            }
                        },
                        "Cmd-Enter": function() {
                            syncPopupToMain();
                            const submitBtn = document.querySelector('.rb-chatbox-sendbtn');
                            if (submitBtn) {
                                submitBtn.click();
                            }
                        }
                    }
                });
                
                // Sync popup editor to main editor and textarea
                codeEditorPopupInstance.on('change', function() {
                    syncPopupToMain();
                });
                
                // Auto-resize popup editor
                codeEditorPopupInstance.on('change', function() {
                    setTimeout(function() {
                        if (codeEditorPopupInstance) {
                            codeEditorPopupInstance.setSize('100%', 'auto');
                            const scrollHeight = codeEditorPopupInstance.getScrollInfo().height;
                            const newHeight = Math.min(Math.max(scrollHeight, 400), window.innerHeight - 250);
                            codeEditorPopupInstance.getWrapperElement().style.height = newHeight + 'px';
                            codeEditorPopupInstance.refresh();
                        }
                    }, 50);
                });
                
                // Language selector change handler for popup
                if (codeLanguagePopup) {
                    codeLanguagePopup.addEventListener('change', function() {
                        const mode = this.value;
                        const modeMap = {
                            'javascript': 'javascript',
                            'python': 'python',
                            'java': 'text/x-java',
                            'csharp': 'text/x-csharp',
                            'cpp': 'text/x-c++src',
                            'htmlmixed': 'htmlmixed',
                            'css': 'css',
                            'sql': 'sql',
                            'xml': 'xml',
                            'json': { name: 'javascript', json: true },
                            'text': 'text'
                        };
                        
                        if (modeMap[mode]) {
                            codeEditorPopupInstance.setOption('mode', modeMap[mode]);
                        }
                        
                        // Sync language selection to main editor
                        const mainLangSelector = document.getElementById('codeLanguage');
                        if (mainLangSelector && typeof codeEditor !== 'undefined' && codeEditor) {
                            mainLangSelector.value = mode;
                            codeEditor.setOption('mode', modeMap[mode]);
                        }
                    });
                }
            }
        }
        
        // Sync popup editor content to main editor and textarea
        function syncPopupToMain() {
            if (codeEditorPopupInstance && messageTextarea) {
                const popupContent = codeEditorPopupInstance.getValue();
                messageTextarea.value = popupContent;
                
                // Sync to main editor if it exists
                if (typeof codeEditor !== 'undefined' && codeEditor) {
                    codeEditor.setValue(popupContent);
                }
                
                if (typeof updateSendButton === 'function') {
                    updateSendButton();
                }
            }
        }
        
        // Sync main editor to popup editor
        function syncMainToPopup() {
            if (codeEditorPopupInstance && typeof codeEditor !== 'undefined' && codeEditor) {
                const mainContent = codeEditor.getValue();
                codeEditorPopupInstance.setValue(mainContent);
                
                // Sync language selection
                const mainLangSelector = document.getElementById('codeLanguage');
                const popupLangSelector = document.getElementById('codeLanguagePopup');
                if (mainLangSelector && popupLangSelector) {
                    popupLangSelector.value = mainLangSelector.value;
                }
                
                // Sync read-only state
                const isReadOnly = codeEditor.getOption('readOnly');
                codeEditorPopupInstance.setOption('readOnly', isReadOnly);
                
                // Sync language mode
                const currentMode = codeEditor.getOption('mode');
                codeEditorPopupInstance.setOption('mode', currentMode);
                
                // Sync placeholder
                const placeholder = codeEditor.getOption('placeholder');
                codeEditorPopupInstance.setOption('placeholder', placeholder);
            }
        }
        
        // Open popup
        function openChatPopup() {
            if (!chatBoxPopup) {
                return;
            }
            
            // Show popup first
            chatBoxPopup.classList.add('show');
            document.body.style.overflow = 'hidden';
            
            // Initialize editor if not already initialized
            if (!codeEditorPopupInstance) {
                initializePopupEditor();
            }
            
            // Sync content from main editor
            syncMainToPopup();
            
            // Refresh popup editor after a short delay to ensure proper rendering
            setTimeout(function() {
                if (codeEditorPopupInstance) {
                    codeEditorPopupInstance.refresh();
                    codeEditorPopupInstance.setSize('100%', 'auto');
                    const scrollHeight = codeEditorPopupInstance.getScrollInfo().height;
                    const newHeight = Math.min(Math.max(scrollHeight, 400), window.innerHeight - 250);
                    codeEditorPopupInstance.getWrapperElement().style.height = newHeight + 'px';
                    codeEditorPopupInstance.refresh();
                    codeEditorPopupInstance.focus();
                } else if (codeEditorPopup && typeof CodeMirror !== 'undefined') {
                    // Retry initialization if it failed
                    initializePopupEditor();
                    setTimeout(function() {
                        if (codeEditorPopupInstance) {
                            codeEditorPopupInstance.refresh();
                            codeEditorPopupInstance.focus();
                        }
                    }, 100);
                }
            }, 150);
        }
        
        // Close popup
        function closeChatPopupFunc() {
            if (chatBoxPopup) {
                syncPopupToMain();
                chatBoxPopup.classList.remove('show');
                // Restore body scroll
                document.body.style.overflow = '';
            }
        }
        
        // Event listeners
        if (expandBtn) {
            expandBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                try {
                    openChatPopup();
                } catch (error) {
                    console.error('Error opening chat popup:', error);
                    // Fallback: try to show popup anyway
                    if (chatBoxPopup) {
                        chatBoxPopup.classList.add('show');
                        document.body.style.overflow = 'hidden';
                    }
                }
            });
        }
        
        if (closeChatPopup) {
            closeChatPopup.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeChatPopupFunc();
            });
        }
        
        // Close popup when clicking outside
        if (chatBoxPopup) {
            chatBoxPopup.addEventListener('click', function(e) {
                if (e.target === chatBoxPopup) {
                    closeChatPopupFunc();
                }
            });
        }
        
        // Close popup on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && chatBoxPopup && chatBoxPopup.classList.contains('show')) {
                closeChatPopupFunc();
            }
        });
        
        // Handle window resize for popup editor
        window.addEventListener('resize', function() {
            if (chatBoxPopup && chatBoxPopup.classList.contains('show') && codeEditorPopupInstance) {
                setTimeout(function() {
                    if (codeEditorPopupInstance) {
                        codeEditorPopupInstance.setSize('100%', 'auto');
                        const scrollHeight = codeEditorPopupInstance.getScrollInfo().height;
                        const newHeight = Math.min(Math.max(scrollHeight, 400), window.innerHeight - 250);
                        codeEditorPopupInstance.getWrapperElement().style.height = newHeight + 'px';
                        codeEditorPopupInstance.refresh();
                    }
                }, 100);
            }
        });
        
        // Sync popup editor state when main editor state changes (e.g., when recording starts/stops)
        // This will be called from the recording start/stop functions
        window.syncEditorStateToPopup = function() {
            if (codeEditorPopupInstance && typeof codeEditor !== 'undefined' && codeEditor) {
                const isReadOnly = codeEditor.getOption('readOnly');
                codeEditorPopupInstance.setOption('readOnly', isReadOnly);
                
                const placeholder = codeEditor.getOption('placeholder');
                codeEditorPopupInstance.setOption('placeholder', placeholder);
                
                // Sync language selector state
                const mainLangSelector = document.getElementById('codeLanguage');
                const popupLangSelector = document.getElementById('codeLanguagePopup');
                if (mainLangSelector && popupLangSelector) {
                    popupLangSelector.disabled = mainLangSelector.disabled;
                    popupLangSelector.value = mainLangSelector.value;
                }
                
                // Sync editor content
                const mainContent = codeEditor.getValue();
                codeEditorPopupInstance.setValue(mainContent);
                
                // Sync language mode
                const currentMode = codeEditor.getOption('mode');
                codeEditorPopupInstance.setOption('mode', currentMode);
            }
        };
    });

