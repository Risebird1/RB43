<script>
    let mediaRecorderAudio;
    let audioChunks = [];
    let answerSubmitInFlight = false;
    let answerSubmitFallbackTimers = [];
    const recordBtn = document.getElementById("recordBtn");
    const audioInput = document.getElementById("audioInput");
    const videoInput = document.getElementById("videoInput");
    const form = document.getElementById("chatForm") || document.querySelector("form");
    const overlay = document.getElementById("waitOverlay");
    const recordingOverlay = document.getElementById("recordingOverlay");
    const showChatBox = @Json.Serialize(Model.showChatBox);
    const isCodingQuestionPage = @Json.Serialize(Model.IsCodingQuestion);
    let codingRecordingToastEl = null;

    function ensureCodingRecordingToast() {
        if (codingRecordingToastEl) return codingRecordingToastEl;
        codingRecordingToastEl = document.getElementById('codingRecordingToast');
        if (!codingRecordingToastEl) {
            codingRecordingToastEl = document.createElement('div');
            codingRecordingToastEl.id = 'codingRecordingToast';
            codingRecordingToastEl.className = 'rb-coding-rec-toast';
            codingRecordingToastEl.setAttribute('role', 'status');
            codingRecordingToastEl.setAttribute('aria-live', 'polite');
            codingRecordingToastEl.innerHTML =
                '<span class="rb-coding-rec-dot" aria-hidden="true"></span>' +
                '<div><strong>Recording in progress</strong>' +
                '<div class="rb-coding-rec-sub">Audio and video are being recorded for this session.</div></div>';
            document.body.appendChild(codingRecordingToastEl);
        }
        return codingRecordingToastEl;
    }

    function syncMessageFromEditor() {
        if (typeof codeEditor !== 'undefined' && codeEditor) {
            const messageTextarea = document.getElementById('messageTextarea');
            if (messageTextarea) {
                messageTextarea.value = codeEditor.getValue();
            }
        }
    }

    function showSubmitLoadingState() {
        const sendBtn = document.querySelector('.rb-chatbox-sendbtn');
        if (sendBtn) {
            sendBtn.classList.add('loading');
            sendBtn.disabled = true;
        }
        if (overlay) overlay.style.display = "flex";
    }

    function isCodingAnswer() {
        const codingField = document.querySelector('input[name="IsCodingQuestion"]');
        return Boolean(codingField && String(codingField.value).toLowerCase() === 'true');
    }

    // Coding answers are recorded on video like any spoken answer; only typing and
    // listening assessments submit without one.
    function answerSubmitNeedsVideo() {
        const typingField = document.querySelector('input[name="IsTypingSpeedQuestion"]');
        const listeningField = document.querySelector('input[name="IsListeningComprehensionQuestion"]');
        if (typingField && String(typingField.value).toLowerCase() === 'true') return false;
        if (listeningField && String(listeningField.value).toLowerCase() === 'true') return false;
        return true;
    }

    function answerRecordingHasUsableAudio() {
        return Boolean(audioInput && audioInput.files && audioInput.files.length > 0 && audioInput.files[0].size > 1000);
    }

    function answerRecordingHasUsableVideo() {
        return Boolean(videoInput && videoInput.files && videoInput.files.length > 0 && videoInput.files[0].size > 1000);
    }

    // Detect whether the audio phone UI is active (IsAdaptive mode)
    const isAudioPhoneMode = !!document.querySelector('.rb-audio-phone-section');

    function pickAudioRecorderMimeType() {
        const types = [
            'audio/webm;codecs=opus',
            'video/webm;codecs=opus',
            'audio/webm',
            'video/webm',
            'audio/ogg;codecs=opus',
            'audio/mp4'
        ];
        for (let i = 0; i < types.length; i++) {
            if (MediaRecorder.isTypeSupported(types[i])) return types[i];
        }
        return '';
    }

    // H.264 in MP4 is listed first because Amazon Rekognition (used for sentiment
    // analysis on flagged answers) cannot decode VP8/VP9 at all. WebM stays as the
    // fallback for browsers that can't record MP4.
    function pickVideoRecorderMimeType() {
        const types = [
            'video/mp4;codecs=avc1.42E01E,mp4a.40.2',
            'video/mp4;codecs=avc1.42E01E',
            'video/mp4',
            'video/webm;codecs=vp9,opus',
            'video/webm;codecs=vp8,opus',
            'video/webm;codecs=vp9',
            'video/webm;codecs=vp8',
            'video/webm'
        ];
        for (let i = 0; i < types.length; i++) {
            if (MediaRecorder.isTypeSupported(types[i])) return types[i];
        }
        return '';
    }

    function getCandidateVideoStream() {
        const source = (window.stream && window.stream.active)
            ? window.stream
            : (window._audioPhoneCandidateStream && window._audioPhoneCandidateStream.active)
                ? window._audioPhoneCandidateStream
                : null;
        if (!source) return null;
        const videoTracks = source.getVideoTracks().filter(function (t) { return t.readyState === 'live'; });
        if (!videoTracks.length) return null;
        // Clone audio tracks so the answer video recorder does not contend with mediaRecorderAudio.
        const audioTracks = source.getAudioTracks()
            .filter(function (t) { return t.readyState === 'live'; })
            .map(function (t) { return t.clone(); });
        return new MediaStream(videoTracks.concat(audioTracks));
    }

    function getCandidateAudioStream() {
        if (isAudioPhoneMode && window._audioPhoneCandidateStream && window._audioPhoneCandidateStream.active) {
            const audioTracks = window._audioPhoneCandidateStream.getAudioTracks().filter(function (t) { return t.readyState === 'live'; });
            if (audioTracks.length) {
                return new MediaStream(audioTracks);
            }
        }
        if (window.stream && window.stream.active) {
            const audioTracks = window.stream.getAudioTracks().filter(function (t) { return t.readyState === 'live'; });
            if (audioTracks.length) {
                return new MediaStream(audioTracks);
            }
        }
        return null;
    }

    // Speech-to-text models hallucinate confident, repetitive sentences when handed silence,
    // so a recording with no speech in it must never be sent for transcription. Peak amplitude
    // is sampled while recording; normal speech peaks well above this, room noise well below.
    const SPEECH_PEAK_THRESHOLD = 0.02;
    let answerAudioPeak = 0;
    let answerAudioSampleCount = 0;
    let answerAudioMonitor = null;

    function startSilenceMonitor(stream) {
        stopSilenceMonitor();
        answerAudioPeak = 0;
        answerAudioSampleCount = 0;

        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx || !stream) return;

            const ctx = new AudioCtx();
            if (ctx.state === 'suspended' && typeof ctx.resume === 'function') {
                ctx.resume().catch(function () { /* handled by the sample guard below */ });
            }

            const analyser = ctx.createAnalyser();
            analyser.fftSize = 2048;
            ctx.createMediaStreamSource(stream).connect(analyser);

            const buffer = new Float32Array(analyser.fftSize);
            const timer = window.setInterval(function () {
                // A suspended context only ever yields zeros, which would look like silence
                if (ctx.state !== 'running') return;
                analyser.getFloatTimeDomainData(buffer);
                let peak = 0;
                for (let i = 0; i < buffer.length; i++) {
                    const level = Math.abs(buffer[i]);
                    if (level > peak) peak = level;
                }
                if (peak > answerAudioPeak) answerAudioPeak = peak;
                answerAudioSampleCount++;
            }, 200);

            answerAudioMonitor = { ctx: ctx, timer: timer };
        } catch (e) {
            // Monitoring is best effort and must never stop a recording from starting
            console.warn('Could not monitor audio levels', e);
        }
    }

    function stopSilenceMonitor() {
        if (!answerAudioMonitor) return;
        window.clearInterval(answerAudioMonitor.timer);
        try { answerAudioMonitor.ctx.close(); } catch (e) { /* already closed */ }
        answerAudioMonitor = null;
    }

    // Only claims silence when the monitor actually ran. If it never sampled anything the
    // recording is sent for transcription as before, so a monitoring failure loses nothing.
    function answerRecordingWasSilent() {
        return answerAudioSampleCount > 0 && answerAudioPeak < SPEECH_PEAK_THRESHOLD;
    }

    function clearAnswerSubmitFallbacks() {
        answerSubmitFallbackTimers.forEach(function (id) { window.clearTimeout(id); });
        answerSubmitFallbackTimers = [];
    }

    function stopAudioRecordingForSubmit() {
        if (!mediaRecorderAudio || mediaRecorderAudio.state !== 'recording') return;
        try { mediaRecorderAudio.requestData(); } catch (e) { /* ignore */ }
        mediaRecorderAudio.stop();
    }

    function tryFinalizeAnswerSubmit() {
        if (answerSubmitInFlight || !form) return false;
        // A candidate may solve a coding question without narrating it, so audio is optional there
        if (!answerRecordingHasUsableAudio() && !isCodingAnswer()) return false;
        const needsVideo = answerSubmitNeedsVideo();
        if (needsVideo && !answerRecordingHasUsableVideo()) return false;
        answerSubmitInFlight = true;
        syncMessageFromEditor();
        showSubmitLoadingState();
        form.submit();
        setTimeout(function () {
            if (typeof clearEditorContent === 'function') clearEditorContent();
        }, 0);
        return true;
    }

    function scheduleAnswerSubmitFallback() {
        clearAnswerSubmitFallbacks();
        [800, 2000, 5000].forEach(function (delayMs) {
            const timerId = window.setTimeout(function () {
                tryFinalizeAnswerSubmit();
            }, delayMs);
            answerSubmitFallbackTimers.push(timerId);
        });
    }

    // ---- helpers for phone UI visual state ----
    function setPhoneUiRecording(isRecording) {
        if (!isAudioPhoneMode) return;
        const micStatus = document.getElementById('micStatus');
        const aiAvatar = document.getElementById('aiAvatarCircle');
        const candidateAvatar = document.getElementById('candidateAvatarCircle');
        const candidateWaves = document.getElementById('candidateAudioWaves');
        if (isRecording) {
            recordBtn.innerHTML = '<i class="fa fa-stop"></i>';
            recordBtn.classList.add('rb-mic-active');
            if (micStatus) { micStatus.textContent = 'Recording… tap to submit'; micStatus.classList.add('recording'); }
            if (aiAvatar) { aiAvatar.style.opacity = '0.6'; }
            // Meet-style: highlight candidate avatar and show audio waves when candidate is speaking
            if (candidateAvatar) candidateAvatar.classList.add('speaking');
            if (candidateWaves) candidateWaves.style.display = 'flex';
        } else {
            recordBtn.innerHTML = '<i class="fa fa-microphone"></i>';
            recordBtn.classList.remove('rb-mic-active');
            if (micStatus) { micStatus.textContent = 'Processing…'; micStatus.classList.remove('recording'); }
            if (aiAvatar) { aiAvatar.style.opacity = '1'; }
            if (candidateAvatar) candidateAvatar.classList.remove('speaking');
            if (candidateWaves) candidateWaves.style.display = 'none';
        }
    }

    function showRecordingOverlay() {
        if (isAudioPhoneMode) return; // phone UI provides its own visual feedback
        // Coding questions: compact toast instead of the full-screen recording banner
        if (isCodingQuestionPage) {
            const toast = ensureCodingRecordingToast();
            toast.classList.add('is-visible');
            return;
        }
        if (recordingOverlay) {
            recordingOverlay.style.display = "flex";
            const recordingMessage = document.getElementById("recordingMessage");
            if (recordingMessage) {
                if (showChatBox === true) {
                    recordingMessage.textContent = "You may write the code in the editor and explain it, and your entire response will be recorded.";
                } else {
                    recordingMessage.textContent = "Your answer is being recorded...";
                }
            }
        }
    }
    function hideRecordingOverlay() {
        if (codingRecordingToastEl) {
            codingRecordingToastEl.classList.remove('is-visible');
        }
        const toast = document.getElementById('codingRecordingToast');
        if (toast) {
            toast.classList.remove('is-visible');
        }
        if (recordingOverlay) recordingOverlay.style.display = "none";
    }

    // Starts the audio + video answer recorders. Extracted from the record button so the
    // coding IDE can start the same recording pipeline without simulating a click.
    async function beginAnswerRecording() {
            {
                clearAnswerSubmitFallbacks();
                answerSubmitInFlight = false;
                audioChunks = [];
                let stream = getCandidateAudioStream();
                if (!stream) {
                    stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                }
                const audioMimeType = pickAudioRecorderMimeType();
                try {
                    mediaRecorderAudio = audioMimeType
                        ? new MediaRecorder(stream, { mimeType: audioMimeType })
                        : new MediaRecorder(stream);
                } catch (recErr) {
                    mediaRecorderAudio = new MediaRecorder(stream);
                }

                startSilenceMonitor(stream);

                mediaRecorderAudio.ondataavailable = e => {
                    if (e.data && e.data.size > 0) {
                        audioChunks.push(e.data);
                    }
                };

                mediaRecorderAudio.onstop = async () => {
                    timerStopped = true;
                    clearInterval(countdownInterval);
                    stopSilenceMonitor();

                    const audioMime = (mediaRecorderAudio && mediaRecorderAudio.mimeType) || pickAudioRecorderMimeType() || 'audio/webm';
                    const resolvedMime = audioMime.indexOf('audio/') === 0
                        ? audioMime.split(';')[0]
                        : (audioMime.indexOf('webm') >= 0 ? 'audio/webm' : audioMime);
                    const audioExt = resolvedMime.indexOf('webm') >= 0 ? 'webm'
                        : resolvedMime.indexOf('ogg') >= 0 ? 'ogg'
                        : resolvedMime.indexOf('mp4') >= 0 ? 'm4a'
                        : 'webm';
                    const audioBlob = new Blob(audioChunks, { type: resolvedMime });

                    // A candidate solving a coding question in silence is normal. Sending that
                    // silence for transcription produces hallucinated text, so the audio is
                    // dropped and only the written code is submitted.
                    if (isCodingAnswer() && (audioBlob.size < 1000 || answerRecordingWasSilent())) {
                        audioChunks = [];
                        if (audioInput) {
                            audioInput.value = '';
                        }
                        if (overlay) overlay.style.display = "flex";
                        stopRecording();
                        if (!tryFinalizeAnswerSubmit()) {
                            scheduleAnswerSubmitFallback();
                        }
                        return;
                    }

                    if (audioBlob.size < 1000) {
                        audioChunks = [];

                        if (overlay) overlay.style.display = "none";
                        Swal.fire({
                            title: 'Recording too short',
                            text: 'Please speak for at least a few seconds, then submit again.',
                            icon: 'warning',
                            confirmButtonColor: '#4eda92'
                        });
                        return;
                    }
                    const file = new File([audioBlob], 'voice-input.' + audioExt, { type: resolvedMime });

                    // populate the file input with blob data (check if audioInput exists)
                    if (audioInput) {
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);
                        audioInput.files = dataTransfer.files;
                    } else {
                        console.error("audioInput element not found. Cannot submit audio recording.");
                        return;
                    }

                    audioChunks = [];

                    if (isAudioPhoneMode) {
                        setPhoneUiRecording(false);
                    } else if (recordBtn) {
                        recordBtn.textContent = "⭕";
                        recordBtn.setAttribute('data-tooltip', 'Record Audio');
                    }

                    if (overlay) overlay.style.display = "flex";
                    stopRecording();
                    // Disable CodeMirror editor when audio recording stops (only if it exists)
                    if (typeof codeEditor !== 'undefined' && codeEditor) {
                        codeEditor.setOption('readOnly', true);
                        codeEditor.setOption('placeholder', 'Start recording to enable code editor...');
                    }
                    // Disable language selector when audio recording stops (only if it exists)
                    const langSelector = document.getElementById('codeLanguage');
                    if (langSelector) {
                        langSelector.disabled = true;
                    }
                    // Sync popup editor state
                    if (typeof syncEditorStateToPopup === 'function') {
                        syncEditorStateToPopup();
                    }
                    if (!tryFinalizeAnswerSubmit()) {
                        scheduleAnswerSubmitFallback();
                    }
                };

                mediaRecorderAudio.start(250);
                if (typeof window.risebirdNotifyProctoringRecordingStart === 'function') window.risebirdNotifyProctoringRecordingStart();
                startRecording();
                // Enable CodeMirror editor when recording starts
                if (typeof codeEditor !== 'undefined' && codeEditor) {
                    codeEditor.setOption('readOnly', false);
                    codeEditor.setOption('placeholder', 'Write your code here... (Select language or use Plain Text for any language)');
                    codeEditor.focus();
                }
                // Enable language selector when recording starts
                const langSelector = document.getElementById('codeLanguage');
                if (langSelector) {
                    langSelector.disabled = false;
                }
                // Sync popup editor state
                if (typeof syncEditorStateToPopup === 'function') {
                    syncEditorStateToPopup();
                }

                if (isAudioPhoneMode) {
                    setPhoneUiRecording(true);
                } else if (recordBtn) {
                    recordBtn.textContent = "☐";
                    recordBtn.setAttribute('data-tooltip', 'Click to record your answer. Click again to Stop Recording');
                }
            }
    }

    if (recordBtn) {
        recordBtn.addEventListener("click", async () => {
            if (!mediaRecorderAudio || mediaRecorderAudio.state === "inactive") {
                await beginAnswerRecording();
            }
            else if (mediaRecorderAudio.state === "recording") {
                // Show confirmation dialog - recording continues until user decides
                Swal.fire({
                    title: 'Submit Response?',
                    text: 'Are you sure you want to submit your response?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#4eda92',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Submit Your Response',
                    cancelButtonText: 'Cancel',
                    reverseButtons: false,
                    focusConfirm: true
                }).then((result) => {
                    if (result.isConfirmed || result.value === true) {
                        if (mediaRecorderAudio && mediaRecorderAudio.state === "recording") {
                            console.log("Calling mediaRecorderAudio.stop()");
                            stopAudioRecordingForSubmit();
                        } else {
                            console.log("ERROR: MediaRecorder not active or null");
                        }
                    } else if (result.isDismissed || result.value === false) {
                        console.log("User cancelled, recording continues...");
                    } else {
                        console.log("Unexpected result:", result);
                    }
                });
            }
        });
    }
</script>






<script>
    // Update send button state based on editor content (defined early for use in other scripts)
    function updateSendButton() {
        const sendBtn = document.querySelector('.rb-chatbox-sendbtn');
        const messageTextarea = document.getElementById('messageTextarea');

        if (sendBtn && messageTextarea) {
            const hasContent = messageTextarea.value.trim().length > 0;
            sendBtn.disabled = !hasContent;
            if (hasContent) {
                sendBtn.style.opacity = '1';
                sendBtn.style.transform = 'scale(1)';
            } else {
                sendBtn.style.opacity = '0.5';
                sendBtn.style.transform = 'scale(1)';
            }
        }
    }

    // Global function to clear editor content - accessible from all handlers
    function clearEditorContent() {
        // Clear main CodeMirror editor
        if (typeof codeEditor !== 'undefined' && codeEditor) {
            codeEditor.setValue('');
        }
        // Clear popup CodeMirror editor
        if (typeof codeEditorPopupInstance !== 'undefined' && codeEditorPopupInstance) {
            codeEditorPopupInstance.setValue('');
        }
        // Clear textarea
        const messageTextarea = document.getElementById('messageTextarea');
        if (messageTextarea) {
            messageTextarea.value = '';
        }
        // Set flag to clear editor on next page load (in case page reloads)
        sessionStorage.setItem('clearEditorOnLoad', 'true');
    }

    // Chatbox CodeMirror editor and send button logic
    document.addEventListener('DOMContentLoaded', function () {
        debugger;
        const messageTextarea = document.getElementById('messageTextarea');
        const sendBtn = document.querySelector('.rb-chatbox-sendbtn');
        const form = document.querySelector('.rb-chatbox-form');

        function showLoading() {
            if (sendBtn) {
                sendBtn.classList.add('loading');
                sendBtn.disabled = true;
            }
            // codeEditor will be set later, check if it exists
            if (typeof codeEditor !== 'undefined' && codeEditor) {
                codeEditor.setOption('readOnly', true);
            }
            // Sync popup editor state
            if (typeof syncEditorStateToPopup === 'function') {
                syncEditorStateToPopup();
            }
        }

        function hideLoading() {
            if (sendBtn) {
                sendBtn.classList.remove('loading');
                sendBtn.disabled = false;
            }
            if (typeof codeEditor !== 'undefined' && codeEditor) {
                codeEditor.setOption('readOnly', false);
            }
            // Sync popup editor state
            if (typeof syncEditorStateToPopup === 'function') {
                syncEditorStateToPopup();
            }
        }

        function submitForm() {
            // Sync CodeMirror content to textarea before submission
            if (typeof codeEditor !== 'undefined' && codeEditor && messageTextarea) {
                messageTextarea.value = codeEditor.getValue();
            }

            if (messageTextarea && messageTextarea.value.trim().length > 0 && form) {
                // Show confirmation dialog before submitting text answer
                Swal.fire({
                    title: 'Submit Answer?',
                    text: 'Are you sure you want to submit your answer?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#4eda92',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Submit Answer',
                    cancelButtonText: 'Cancel',
                    reverseButtons: false,
                    focusConfirm: true
                }).then((result) => {
                    if (result.isConfirmed || result.value === true) {
                        // User confirmed - submit the form
                        showLoading();
                        if (sendBtn) {
                            sendBtn.style.opacity = '0.7';
                            sendBtn.style.transform = 'scale(0.95)';
                        }
                        // Submit form (textarea value is already synced)
                        form.submit();
                        // Clear editor content after form submission starts
                        setTimeout(function() {
                            clearEditorContent();
                        }, 0);
                    } else {
                        // User cancelled - do nothing
                        console.log("Answer submission cancelled");
                    }
                });
            }
        }

        // Initialize send button state
        if (sendBtn) {
            updateSendButton();
            hideLoading();
        }

        if (sendBtn) {
            sendBtn.addEventListener('click', function(e) {
                e.preventDefault();
                submitForm();
            });
        }

        // Handle form submission - will be set up after codeEditor is initialized
        if (form) {
            form.addEventListener('submit', function () {
                // Sync editor content before form submission
                if (typeof codeEditor !== 'undefined' && codeEditor && messageTextarea) {
                    messageTextarea.value = codeEditor.getValue();
                }
                // Clear editor content after syncing - use setTimeout to ensure form submission has started
                setTimeout(function() {
                    clearEditorContent();
                }, 0);
                // Keep loading state active during form submission
            });
            form.addEventListener('error', function () {
                hideLoading();
            });
        }
    });
</script>
<script>
    let mediaRecorder, recordedBlobs;
    let isRecording = false;
    const video = document.getElementById('video');
    const btnRecord = document.getElementById('btnRecord');
    const btnRecordToggle = document.getElementById('btnRecordToggle');
    let blobtransfer;
    // In Adaptive (audio-phone) mode the camera is already opened once for the
    // candidate preview (candidateVideoEl) and that single stream is reused for
    // recording. The hidden #video element must NOT open a second camera stream:
    // mobile devices expose the camera as a single-consumer resource, so a second
    // getUserMedia() contends with the first and the answer recorder ends up with a
    // blank/frame-less video track (the candidate's answer video is effectively
    // empty and never persists). Desktops tolerate the duplicate open, which is why
    // this only broke on phones. Only open here when NOT in audio-phone mode.
    if (navigator.mediaDevices && video && !document.querySelector('.rb-audio-phone-section')) {
        navigator.mediaDevices.getUserMedia({ video: true, audio: true })
            .then(function(stream) {
                video.srcObject = stream;
                window.stream = stream;
            })
            .catch(function(err) {
                alert('Could not access camera/microphone: ' + err);
            });
    }
    if (btnRecordToggle) {
        btnRecordToggle.onclick = function() {
            if (!isRecording) {
                startRecording();
            } else {
                stopRecording();
            }
        };
    }
    function startRecording() {
        const videoStream = getCandidateVideoStream();
        if (videoStream) {
            beginVideoRecording(videoStream);
            return;
        }
        // Shared camera stream is not ready yet. This is common on phones, where the
        // camera initializes more slowly than on laptops. Instead of silently recording
        // audio-only and losing the candidate's answer video, acquire the (single) shared
        // camera stream once and reuse it, then start recording.
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: true, audio: true })
                .then(function (stream) {
                    if (!window.stream || !window.stream.active) window.stream = stream;
                    if (isAudioPhoneMode && (!window._audioPhoneCandidateStream || !window._audioPhoneCandidateStream.active)) {
                        window._audioPhoneCandidateStream = stream;
                        const candidateVideoEl = document.getElementById('candidateVideoEl');
                        const candidateAvatarCircle = document.getElementById('candidateAvatarCircle');
                        if (candidateVideoEl) {
                            candidateVideoEl.srcObject = stream;
                            candidateVideoEl.style.display = 'block';
                            candidateVideoEl.play().catch(function () {});
                            if (candidateAvatarCircle) candidateAvatarCircle.classList.add('has-video');
                        }
                    }
                    const readyStream = getCandidateVideoStream();
                    if (readyStream) {
                        beginVideoRecording(readyStream);
                    } else {
                        console.warn('Answer video stream unavailable — camera did not provide a live video track.');
                    }
                })
                .catch(function (err) {
                    console.warn('Could not start answer video recording:', err);
                });
        }
    }
    function beginVideoRecording(videoStream) {
        chunks = [];
        const videoMimeType = pickVideoRecorderMimeType();
        const options = videoMimeType ? { mimeType: videoMimeType } : undefined;

        try {
            mediaRecorder = options
                ? new MediaRecorder(videoStream, options)
                : new MediaRecorder(videoStream);
        } catch (e) {
            try {
                mediaRecorder = new MediaRecorder(videoStream);
            } catch (e2) {
                alert('MediaRecorder not supported: ' + e2);
                return;
            }
        }
        mediaRecorder.ondataavailable = function(event) {
            if (event.data && event.data.size > 0) {
                chunks.push(event.data);
            }
        };
        mediaRecorder.onstop = (ev) => {
            const videoMime = (mediaRecorder && mediaRecorder.mimeType) || videoMimeType || 'video/webm';
            const videoExt = videoMime.indexOf('mp4') >= 0 ? 'mp4' : 'webm';
            let blob = new Blob(chunks, { type: videoMime });
            let videoURL = window.URL.createObjectURL(blob);
            const filevideo = new File([blob], 'videoinput.' + videoExt, { type: videoMime });

            // Check if videoInput exists before setting files
            if (videoInput) {
                const dataTransfervideo = new DataTransfer();
                dataTransfervideo.items.add(filevideo);
                videoInput.files = dataTransfervideo.files;
            } else {
                console.error("videoInput element not found. Cannot submit video recording.");
                return;
            }

            chunks = [];
            if (!tryFinalizeAnswerSubmit()) {
                scheduleAnswerSubmitFallback();
            }
        };
        mediaRecorder.start(250);
        isRecording = true;
        if (typeof window.risebirdNotifyProctoringRecordingStart === 'function') window.risebirdNotifyProctoringRecordingStart();
        showRecordingOverlay();
        // Enable CodeMirror editor when recording starts
        if (typeof codeEditor !== 'undefined' && codeEditor) {
            codeEditor.setOption('readOnly', false);
            codeEditor.setOption('placeholder', 'Write your code here... (Select language or use Plain Text for any language)');
            codeEditor.focus();
        }
        // Enable language selector when recording starts
        const langSelector = document.getElementById('codeLanguage');
        if (langSelector) {
            langSelector.disabled = false;
        }
        // Sync popup editor state
        if (typeof syncEditorStateToPopup === 'function') {
            syncEditorStateToPopup();
        }
        btnRecordToggle.innerHTML = '<i class="fa fa-stop"></i> Rec';
        btnRecordToggle.className = 'rb-record-btn rb-recording';
        btnRecord.style.display = 'block';
        btnRecord.style.animation = 'pulse 1.5s infinite';
    }
    function stopRecording() {
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            if (mediaRecorder.state === 'recording') {
                try { mediaRecorder.requestData(); } catch (e) { /* ignore */ }
            }
            mediaRecorder.stop();
        }
        isRecording = false;
        hideRecordingOverlay();
        // Disable CodeMirror editor when recording stops
        if (typeof codeEditor !== 'undefined' && codeEditor) {
            codeEditor.setOption('readOnly', true);
            codeEditor.setOption('placeholder', 'Start recording to enable code editor...');
        }
        // Disable language selector when recording stops
        const langSelector = document.getElementById('codeLanguage');
        if (langSelector) {
            langSelector.disabled = true;
        }
        // Sync popup editor state
        if (typeof syncEditorStateToPopup === 'function') {
            syncEditorStateToPopup();
        }
        btnRecordToggle.innerHTML = '<i class="fa fa-circle"></i>  Rec';
        btnRecordToggle.className = 'rb-record-btn';
        btnRecord.style.display = 'none';
        btnRecord.style.animation = 'none';
    }
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        let video = document.getElementById('video');
        let footerVideoToggle = document.getElementById('footerVideoToggle');
        let footerVideoIcon = document.getElementById('footerVideoIcon');
        let mediaStreamObj = null;
        let videoOn = true;

        // Set initial state to OFF
        if (footerVideoIcon) footerVideoIcon.className = 'fa fa-video-camera';
        if (video) video.style.opacity = 1;

        if (footerVideoToggle && video) {
            footerVideoToggle.addEventListener('click', function () {
                if (!videoOn) {
                    // Turn video ON
                    if (!mediaStreamObj) {
                        navigator.mediaDevices.getUserMedia({ video: true, audio: true })
                            .then(function(stream) {
                                mediaStreamObj = stream;
                                if (video) {
                                    video.srcObject = stream;
                                    mediaStreamObj.getTracks().forEach(track => {
                                        if (track.kind === 'video') track.enabled = true;
                                    });
                                    videoOn = true;
                                    footerVideoIcon.className = 'fa fa-video-camera';
                                    video.style.opacity = 1;
                                }
                            })
                            .catch(function(err) {
                                alert('Could not access camera/microphone: ' + err);
                            });
                    } else {
                        mediaStreamObj.getTracks().forEach(track => {
                            if (track.kind === 'video') track.enabled = true;
                        });
                        videoOn = true;
                        footerVideoIcon.className = 'fa fa-video-camera';
                        if (video) video.style.opacity = 1;
                    }
                } else {
                    // Turn video OFF
                    if (mediaStreamObj) {
                        mediaStreamObj.getTracks().forEach(track => {
                            if (track.kind === 'video') track.enabled = false;
                        });
                    }
                    videoOn = false;
                    footerVideoIcon.className = 'fas fa-video-slash';
                    if (video) video.style.opacity = 0;
                }
            });
        }
    });
</script>

