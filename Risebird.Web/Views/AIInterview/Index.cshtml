    }

    .rb-phone-nav-avatar-item {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.75rem;
        color: white;
        margin-left: -8px;
    }

        .rb-phone-nav-avatar-item:first-child {
            margin-left: 0;
            background: linear-gradient(135deg, #4eda92, #56e0cb);
        }

        .rb-phone-nav-avatar-item:last-child {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

    .rb-phone-mini-candidate {
        position: absolute;
        bottom: 8px;
        right: 12px;
        width: 128px;
        height: 139px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 14px;
        border: 2.5px solid rgba(255,255,255,0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.6rem;
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        z-index: 3;
        overflow: hidden;
        transition: box-shadow 0.4s ease, border-color 0.4s ease;
    }

    /* Candidate live video (proctoring) - fills the candidate area */
    .rb-phone-candidate-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        z-index: 1;
        background: #1a1a2e;
    }

    .rb-phone-mini-candidate .rb-phone-candidate-fallback-icon {
        position: relative;
        z-index: 0;
    }

    .rb-phone-mini-candidate.has-video .rb-phone-candidate-fallback-icon {
        display: none;
    }

    /* Meet-style highlight when candidate is speaking (recording) */
    .rb-phone-mini-candidate.speaking {
        border-color: rgba(255,255,255,0.95);
        box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 4px rgba(102,126,234,0.5), 0 0 0 10px rgba(118,75,162,0.25);
        animation: candidateAvatarPulse 1.5s ease-in-out infinite;
    }

    @@keyframes candidateAvatarPulse {
        0%, 100% {
            box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 4px rgba(102,126,234,0.5), 0 0 0 10px rgba(118,75,162,0.25);
        }

        50% {
            box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 6px rgba(102,126,234,0.4), 0 0 0 14px rgba(118,75,162,0.2);
        }
    }

    /* Candidate audio waves (shown when candidate is recording) */
    .rb-candidate-audio-waves {
        position: absolute;
        bottom: 4px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
        z-index: 4;
        pointer-events: none;
    }

        .rb-candidate-audio-waves .wave-bar {
            width: 2px;
            height: 12px;
            background: rgba(255,255,255,0.95);
            border-radius: 1px;
            animation: waveAnimation 1.2s ease-in-out infinite;
        }

            .rb-candidate-audio-waves .wave-bar:nth-child(1) {
                animation-delay: 0s;
            }

            .rb-candidate-audio-waves .wave-bar:nth-child(2) {
                animation-delay: 0.1s;
            }

            .rb-candidate-audio-waves .wave-bar:nth-child(3) {
                animation-delay: 0.2s;
            }

            .rb-candidate-audio-waves .wave-bar:nth-child(4) {
                animation-delay: 0.3s;
            }

            .rb-candidate-audio-waves .wave-bar:nth-child(5) {
