<script>
    @* let totalSecondsLeft = parseInt("@Model.TimeLeftInSeconds" || "900");
    let interviewId = parseInt("@Model.InterviewId");
    const timerDisplay = document.getElementById("timer");
    const timeField = document.getElementById("timeLeftField");

    function updateTimerUI() {
        const minutes = Math.floor(totalSecondsLeft / 60);
        const seconds = totalSecondsLeft % 60;
        timerDisplay.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        timeField.value = totalSecondsLeft; // ✅ save raw seconds
    } *@


    let totalSecondsLeft = parseInt("@Model.TimeLeftInSeconds" || "900");
    let interviewId = parseInt("@Model.InterviewId");

    const timerDisplay = document.getElementById("timer");
    const timeField = document.getElementById("timeLeftField");
    let timerStopped = false;

    function updateTimerUI() {
        const minutes = Math.floor(totalSecondsLeft / 60);
        const seconds = totalSecondsLeft % 60;
        const formatted = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        timerDisplay.textContent = formatted;
        timeField.value = totalSecondsLeft;
        // Keep audio phone UI timer in sync
        const audioTimerDisplay = document.getElementById('audioTimerDisplay');
        if (audioTimerDisplay) audioTimerDisplay.textContent = formatted;
    }

    async function postTimeLeftToServer(seconds) {
        await fetch("/AIInterview/UpdateTimeLeft", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                sessionId: "@Model.SessionId",
                timeLeftInSeconds: seconds,
                interviewId: interviewId
            })
        });
    }

    let countdownInterval = setInterval(() => {
        if (!timerStopped && totalSecondsLeft > 0) {
            totalSecondsLeft--;
            updateTimerUI();

            if (totalSecondsLeft % 60 === 0) {
                postTimeLeftToServer(totalSecondsLeft);
            }
        }
    }, 1000);

    updateTimerUI();
</script>


<script>
    function playAssistantAudio(blob) {
        const audioElement = document.getElementById("assistantAudio");
        const audioUrl = URL.createObjectURL(blob);
        audioElement.src = audioUrl;
        audioElement.hidden = false;
        // Don't highlight here: waves and aiAvatarCircle.speaking are added only on the audio 'play' event, so they stay in sync with actual playback (like video autoplay)
        audioElement.play();
    }

    // Chat Log Scrolling Functionality
    document.addEventListener('DOMContentLoaded', function() {
        const chatLog = document.getElementById('chatLog');
        const scrollToBottomBtn = document.getElementById('scrollToBottom');
        const audioElement = document.getElementById('assistantAudio');
        const audioWaves = document.getElementById('audioWaves');

        // Audio event listeners for wave animation + phone UI avatar (highlight only when audio actually plays)
        if (audioElement && audioWaves) {
            audioElement.addEventListener('play', function() {
                audioWaves.style.display = 'flex';
                const aiAvatar = document.getElementById('aiAvatarCircle');
                if (aiAvatar) aiAvatar.classList.add('speaking');
            });

            audioElement.addEventListener('pause', function() {
                audioWaves.style.display = 'none';
                const aiAvatar = document.getElementById('aiAvatarCircle');
                if (aiAvatar) aiAvatar.classList.remove('speaking');
            });

            audioElement.addEventListener('ended', function() {
                audioWaves.style.display = 'none';
                const aiAvatar = document.getElementById('aiAvatarCircle');
                if (aiAvatar) aiAvatar.classList.remove('speaking');

                // Prompt candidate to record their answer in phone UI
                const micStatus = document.getElementById('micStatus');
                if (micStatus && !micStatus.classList.contains('recording')) {
                    micStatus.textContent = 'Tap to record answer';
                }
            });

            // Autoplay initial assistant audio (like video autoplay); highlight happens at same time via 'play' above
            if (window._initialAssistantAudioBlob && typeof playAssistantAudio === 'function') {
                playAssistantAudio(window._initialAssistantAudioBlob);
                window._initialAssistantAudioBlob = null;
            }
        }

        if (chatLog && scrollToBottomBtn) {
            // Function to scroll to bottom
            function scrollToBottom() {
                chatLog.scrollTo({
                    top: chatLog.scrollHeight,
                    behavior: 'smooth'
                });
            }

            // Function to check if scroll to bottom button should be shown
            function checkScrollPosition() {
                const isNearBottom = chatLog.scrollTop + chatLog.clientHeight >= chatLog.scrollHeight - 100;

                if (!isNearBottom && chatLog.scrollHeight > chatLog.clientHeight) {
                    scrollToBottomBtn.classList.add('show');
                } else {
                    scrollToBottomBtn.classList.remove('show');
                }
            }

            // Scroll to bottom button click handler
            scrollToBottomBtn.addEventListener('click', scrollToBottom);

            // Check scroll position on scroll
            chatLog.addEventListener('scroll', checkScrollPosition);

            // Check scroll position on window resize
            window.addEventListener('resize', checkScrollPosition);

            // Initial check
            checkScrollPosition();

            // Auto-scroll to bottom when new messages are added
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                        // Check if we're near the bottom before auto-scrolling
                        const isNearBottom = chatLog.scrollTop + chatLog.clientHeight >= chatLog.scrollHeight - 150;
                        if (isNearBottom) {
                            setTimeout(scrollToBottom, 100);
                        }
                    }
                });
            });

            observer.observe(chatLog, {
                childList: true,
                subtree: true
            });
        }

        // Audio mode: start candidate camera for proctoring (video on in candidate area); reuse same stream's audio for recording
        if (document.querySelector('.rb-audio-phone-section')) {
            const candidateVideoEl = document.getElementById('candidateVideoEl');
            const candidateAvatarCircle = document.getElementById('candidateAvatarCircle');
            if (candidateVideoEl && candidateAvatarCircle && navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ video: true, audio: true })
                    .then(function(stream) {
                        window._audioPhoneCandidateStream = stream;
                        candidateVideoEl.srcObject = stream;
                        candidateVideoEl.style.display = 'block';
                        candidateVideoEl.play().catch(function() {});
                        candidateAvatarCircle.classList.add('has-video');
                    })
                    .catch(function(err) {
                        console.warn('Candidate camera not available for proctoring:', err);
                    });
            }
        }

        // Mobile only: tap question preview to show full question, tap again or tap overlay to hide
        var questionPreviewEl = document.getElementById('rbPhoneQuestionPreview');
        var questionFullOverlay = document.getElementById('rbPhoneQuestionFullOverlay');
        if (questionPreviewEl && questionFullOverlay) {
            function isMobileView() { return window.matchMedia('(max-width: 992px)').matches; }
            function toggleFullQuestion() {
                if (!isMobileView()) return;
                questionFullOverlay.classList.toggle('is-visible');
                questionFullOverlay.setAttribute('aria-hidden', questionFullOverlay.classList.contains('is-visible') ? 'false' : 'true');
            }
            function hideFullQuestion() {
                questionFullOverlay.classList.remove('is-visible');
                questionFullOverlay.setAttribute('aria-hidden', 'true');
            }
            questionPreviewEl.addEventListener('click', function(e) {
                if (!isMobileView()) return;
                e.preventDefault();
                toggleFullQuestion();
            });
            questionFullOverlay.addEventListener('click', function(e) {
                e.stopPropagation();
                hideFullQuestion();
            });
            questionPreviewEl.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    if (isMobileView()) toggleFullQuestion();
                }
            });
        }
    });
</script>
