<script>
    // Custom Modal Functions
    function showCustomModal(title, message, isSuccess = false) {
        const modal = document.getElementById('customModal');
        const modalMessage = document.getElementById('modalMessage');
        const warningIcon = document.getElementById('warningIcon');
        const successIcon = document.getElementById('successIcon');
        modalMessage.innerHTML = message;
        if (isSuccess) {
            modal.classList.add('success');
            warningIcon.style.display = 'none';
            successIcon.style.display = 'flex';
        } else {
            modal.classList.remove('success');
            warningIcon.style.display = 'flex';
            successIcon.style.display = 'none';
        }

        modal.style.display = 'flex';
    }
    function hideCustomModal() {
        const modal = document.getElementById('customModal');
        modal.style.display = 'none';
    }
    // Exit Interview Confirmation
    document.addEventListener('DOMContentLoaded', function() {
        const exitBtn = document.getElementById('exitInterviewBtn');
        const modal = document.getElementById('customModal');
        const modalClose = document.getElementById('modalClose');
        const modalCancel = document.getElementById('modalCancel');
        const modalConfirm = document.getElementById('modalConfirm');

        if (exitBtn) {
                            exitBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                showCustomModal('Exit Interview?', 'Are you sure? <span style="display:block;font-size: 17px !important;color: #a79f9f !important;padding-top: 5px;">you want to exit the interview?</span>');
                });
        }

        // Cancel button
        modalCancel.addEventListener('click', hideCustomModal);
        // Confirm button
        modalConfirm.addEventListener('click', function() {
            hideCustomModal();

            if (totalSecondsLeft > 0 && typeof window.risebirdMarkProctoringSoftInterrupt === 'function') {
                window.risebirdMarkProctoringSoftInterrupt();
            }

            // Hide the entire AI interview section
            const interviewContainer = document.querySelector('.rb-aiinterview-container');
            if (interviewContainer) {
                interviewContainer.style.display = 'none';
            }

            // Load the ExitModalPartial dynamically
            loadExitModal();
        });
    });

    // Function to load ExitModalPartial dynamically
    function loadExitModal() {
        $.ajax({
            url: '@Url.Action("ExitModalPartial", "AIInterview", new { seId = Model.SessionId })',
            type: 'GET',
            success: function(data) {
                // Replace the body content with the ExitModalPartial
                $('body').html(data);
            },
            error: function(xhr, status, error) {
                console.error('Error loading exit modal:', error);
                // Fallback: show simple completion message
                // showFallbackCompletionMessage(); // This function is no longer needed
            }
        });
    }
</script>

