            {
                if (cl.Role != null && cl.Role.ToLower() == "bot") botMsgCount++;
            }
            // Current question = number of questions AI has asked (ChatLog uses Role "Bot" per question). Active dot = this number.
            int currentQuestionNum = botMsgCount >= 1 ? botMsgCount : 1;
            int totalQuestions = 5;
            // Sliding window of 5 dots: Q1-5 show 1..5, Q6-10 show 6..10, Q11-15 show 11..15, etc.
            int rowStart = ((currentQuestionNum - 1) / 5) * 5 + 1;
            string questionPreview = !string.IsNullOrWhiteSpace(Model.CurrentQuestion) ? Model.CurrentQuestion : "Preparing your next question...";

            <div class="rb-audio-phone-section">

