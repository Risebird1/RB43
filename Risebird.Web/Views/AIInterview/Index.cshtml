<script>
    // Initialize CodeMirror Editor
    let codeEditor;
    let currentLanguage = 'text';
    let languageValidationEnabled = true;
    let validationTimeout;
    
    // Language-specific patterns for validation
    const languagePatterns = {
        'javascript': {
            keywords: ['function', 'var', 'let', 'const', 'if', 'else', 'for', 'while', 'return', 'class', 'import', 'export', 'async', 'await'],
            operators: ['===', '!==', '&&', '||', '=>'],
            syntax: ['{', '}', '(', ')', '[', ']', ';', '=', '==']
        },
        'python': {
            keywords: ['def', 'class', 'if', 'elif', 'else', 'for', 'while', 'import', 'from', 'return', 'try', 'except', 'with', 'as', 'lambda'],
            operators: ['==', '!=', 'and', 'or', 'not', 'in', 'is'],
            syntax: [':', '(', ')', '[', ']', '{', '}', '=', '#']
        },
        'java': {
            keywords: ['public', 'private', 'class', 'interface', 'extends', 'implements', 'static', 'void', 'return', 'if', 'else', 'for', 'while'],
            operators: ['==', '!=', '&&', '||', 'instanceof'],
            syntax: ['{', '}', '(', ')', '[', ']', ';', '=', '.', '@@']
        },
        'csharp': {
            keywords: ['public', 'private', 'class', 'interface', 'namespace', 'using', 'static', 'void', 'return', 'if', 'else', 'for', 'foreach', 'while'],
            operators: ['==', '!=', '&&', '||', '=>'],
            syntax: ['{', '}', '(', ')', '[', ']', ';', '=', '.', '@@']
        },
        'cpp': {
            keywords: ['#include', 'using', 'namespace', 'class', 'public', 'private', 'int', 'void', 'return', 'if', 'else', 'for', 'while'],
            operators: ['==', '!=', '&&', '||', '::', '->'],
            syntax: ['{', '}', '(', ')', '[', ']', ';', '=', '<', '>', '#']
        },
        'sql': {
            keywords: ['SELECT', 'FROM', 'WHERE', 'INSERT', 'UPDATE', 'DELETE', 'CREATE', 'ALTER', 'TABLE', 'JOIN', 'INNER', 'LEFT', 'RIGHT', 'GROUP BY', 'ORDER BY'],
            operators: ['=', '!=', '<>', 'AND', 'OR', 'NOT', 'IN', 'LIKE', 'BETWEEN'],
            syntax: ['(', ')', ',', ';', "'", '"']
        },
        'htmlmixed': {
            keywords: ['<html', '<head', '<body', '<div', '<span', '<p', '<a', '<img', '<script', '<style'],
            operators: [],
            syntax: ['<', '>', '/', '=', '"', "'"]
        },
        'css': {
            keywords: ['@@media', '@@import', '@@keyframes', 'margin', 'padding', 'color', 'background', 'font', 'display', 'position'],
            operators: [':', ';', '{', '}', '!important'],
            syntax: [':', ';', '{', '}', '(', ')', '#', '.']
        },
        'xml': {
            keywords: [],
            operators: [],
            syntax: ['<', '>', '/', '=', '"', "'", '<?', '?>']
        },
        'json': {
            keywords: [],
            operators: [],
            syntax: ['{', '}', '[', ']', ':', ',', '"']
        }
    };

    // Validate code against selected language
    function validateCodeLanguage(code, language) {
        if (language === 'text' || !languageValidationEnabled) {
            return { valid: true, message: '' };
        }

        const patterns = languagePatterns[language];
        if (!patterns) {
            return { valid: true, message: '' };
        }

        const codeLower = code.toLowerCase();
        let foundKeywords = 0;
        let foundSyntax = 0;

        // Check for language-specific keywords
        patterns.keywords.forEach(keyword => {
            const regex = new RegExp('\\b' + keyword.toLowerCase() + '\\b', 'g');
            if (regex.test(codeLower)) {
                foundKeywords++;
            }
        });

        // Check for language-specific syntax
        patterns.syntax.forEach(syntax => {
            if (code.includes(syntax)) {
                foundSyntax++;
            }
        });

        // If no language-specific patterns found, it might be wrong language
        if (foundKeywords === 0 && foundSyntax === 0 && code.trim().length > 10) {
            return {
                valid: false,
                message: `Code doesn't appear to be ${language.toUpperCase()}. Switch to "Plain Text" to use any language.`
            };
        }

        // Check for patterns from other languages (conflict detection)
        const otherLanguages = Object.keys(languagePatterns).filter(lang => lang !== language);
        for (let otherLang of otherLanguages) {
            const otherPatterns = languagePatterns[otherLang];
            let otherKeywordsFound = 0;
            
            otherPatterns.keywords.slice(0, 3).forEach(keyword => {
                const regex = new RegExp('\\b' + keyword.toLowerCase() + '\\b', 'g');
                if (regex.test(codeLower)) {
                    otherKeywordsFound++;
                }
            });

            // If found multiple keywords from another language, warn user
            if (otherKeywordsFound >= 2 && foundKeywords < 2) {
                return {
                    valid: false,
                    message: `Code appears to be ${otherLang.toUpperCase()} but ${language.toUpperCase()} is selected. Switch to "Plain Text" or select the correct language.`
                };
            }
        }

        return { valid: true, message: '' };
    }

    // Show/hide language warning
    function showLanguageWarning(message) {
        const warning = document.getElementById('codeLangWarning');
        if (warning) {
            warning.textContent = '⚠️ ' + message;
            warning.classList.add('show');
        }
    }

    function hideLanguageWarning() {
        const warning = document.getElementById('codeLangWarning');
        if (warning) {
            warning.classList.remove('show');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        debugger;
        const editorContainer = document.getElementById('codeEditor');
        const messageTextarea = document.getElementById('messageTextarea');
        const langSelector = document.getElementById('codeLanguage');
        
        // Check if CodeMirror is loaded
        if (typeof CodeMirror === 'undefined') {
            console.error('CodeMirror library not loaded. Please check CDN links.');
            return;
        }
        
        if (editorContainer && messageTextarea) {
            try {
                // Initialize CodeMirror - disabled by default until recording starts
                codeEditor = CodeMirror(editorContainer, {
                //value: messageTextarea.value || '',
                value: '@Model.Message' || '',
                mode: 'text',
                theme: 'default',
                lineNumbers: true,
                lineWrapping: true,
                indentUnit: 4,
                indentWithTabs: false,
                smartIndent: true,
                autoCloseBrackets: true,
                matchBrackets: true,
                styleActiveLine: true,
                readOnly: true, // Disabled by default - will be enabled when recording starts
                placeholder: 'Start recording to enable code editor...',
                extraKeys: {
                    "Ctrl-Space": "autocomplete",
                    "Tab": function(cm) {
                        if (cm.somethingSelected()) {
                            cm.indentSelection("add");
                        } else {
                            cm.replaceSelection("    ", "end");
                        }
                    },
                    "Shift-Tab": function(cm) {
                        cm.indentSelection("subtract");
                    },
                    // Disable copy-paste shortcuts
                    "Ctrl-C": function() { return false; },
                    "Ctrl-V": function() { return false; },
                    "Ctrl-X": function() { return false; },
                    "Cmd-C": function() { return false; },
                    "Cmd-V": function() { return false; },
                    "Cmd-X": function() { return false; }
                }
            });
            
            // Disable right-click context menu (which contains copy/paste options)
            codeEditor.on('contextmenu', function(cm, event) {
                event.preventDefault();
                return false;
            });
            
            // Prevent paste events
            codeEditor.on('paste', function(cm, event) {
                event.preventDefault();
                return false;
            });
            
            // Prevent copy events
            codeEditor.on('copy', function(cm, event) {
                event.preventDefault();
                return false;
            });
            
            // Prevent cut events
            codeEditor.on('cut', function(cm, event) {
                event.preventDefault();
                return false;
            });

            // Sync CodeMirror content to hidden textarea on change
            codeEditor.on('change', function() {
                const code = codeEditor.getValue();
                messageTextarea.value = code;
                updateSendButton();
                
                // Debounce validation to avoid performance issues
                clearTimeout(validationTimeout);
                validationTimeout = setTimeout(function() {
                    // Validate language if not plain text
                    if (currentLanguage !== 'text' && languageValidationEnabled && code.trim().length > 10) {
                        const validation = validateCodeLanguage(code, currentLanguage);
                        if (!validation.valid) {
                            showLanguageWarning(validation.message);
                        } else {
                            hideLanguageWarning();
                        }
                    } else if (code.trim().length === 0) {
                        hideLanguageWarning();
                    }
                }, 500); // Wait 500ms after user stops typing
            });

            // Additional DOM-level protection against paste
            const editorWrapper = codeEditor.getWrapperElement();
            if (editorWrapper) {
                // Prevent paste via keyboard shortcuts
                editorWrapper.addEventListener('paste', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }, true);
                
                // Prevent paste via context menu
                editorWrapper.addEventListener('contextmenu', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }, true);
                
                // Prevent copy
                editorWrapper.addEventListener('copy', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }, true);
                
                // Prevent cut
                editorWrapper.addEventListener('cut', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }, true);
            }
            
            // Disable language selector by default (will be enabled when recording starts)
            if (langSelector) {
                langSelector.disabled = true;
            }

            // Language selector change handler
            if (langSelector) {
                langSelector.addEventListener('change', function() {
                    const mode = this.value;
                    currentLanguage = mode;
                    
                    // Map language names to CodeMirror modes
                    const modeMap = {
                        'javascript': 'javascript',
                        'python': 'python',
                        'java': 'text/x-java',
                        'csharp': 'text/x-csharp',
                        'cpp': 'text/x-c++src',
                        'htmlmixed': 'htmlmixed',
                        'css': 'css',
                        'sql': 'sql',
                        'xml': 'xml',
                        'json': { name: 'javascript', json: true },
                        'text': 'text'
                    };
                    
                    if (modeMap[mode]) {
                        codeEditor.setOption('mode', modeMap[mode]);
                    }
                    
                    // Clear warning when switching languages
                    hideLanguageWarning();
                    
                    // Validate existing code when language changes
                    const code = codeEditor.getValue();
                    if (mode !== 'text' && languageValidationEnabled && code.trim().length > 0) {
                        const validation = validateCodeLanguage(code, mode);
                        if (!validation.valid) {
                            showLanguageWarning(validation.message);
                        }
                    }
                });
            }

            // Auto-resize editor
            function autoResizeEditor() {
                codeEditor.setSize(null, 'auto');
                const scrollHeight = codeEditor.getScrollInfo().height;
                const newHeight = Math.min(Math.max(scrollHeight, 36), 300);
                codeEditor.getWrapperElement().style.height = newHeight + 'px';
                codeEditor.refresh();
            }

            codeEditor.on('change', autoResizeEditor);
            codeEditor.on('focus', autoResizeEditor);
            
            // Initial resize
            setTimeout(autoResizeEditor, 100);

            // Set up Ctrl+Enter to submit after editor is initialized
            const form = document.querySelector('.rb-chatbox-form');
            if (form) {
                codeEditor.setOption('extraKeys', {
                    ...codeEditor.getOption('extraKeys'),
                    "Ctrl-Enter": function() {
                        const messageTextarea = document.getElementById('messageTextarea');
                        if (messageTextarea) {
                            messageTextarea.value = codeEditor.getValue();
                        }
                        const submitBtn = document.querySelector('.rb-chatbox-sendbtn');
                        if (submitBtn) {
                            submitBtn.click();
                        }
                    },
                    "Cmd-Enter": function() {
                        const messageTextarea = document.getElementById('messageTextarea');
                        if (messageTextarea) {
                            messageTextarea.value = codeEditor.getValue();
                        }
                        const submitBtn = document.querySelector('.rb-chatbox-sendbtn');
                        if (submitBtn) {
                            submitBtn.click();
                        }
                    }
                });
            }
            } catch (error) {
                console.error('Error initializing CodeMirror:', error);
                // Fallback: show textarea if CodeMirror fails
                if (editorContainer) {
                    editorContainer.innerHTML = '<textarea id="fallbackTextarea" style="width:100%;min-height:36px;border:none;outline:none;padding:10px 0;font-size:1.1rem;" placeholder="Write your code here..."></textarea>';
                    const fallbackTextarea = document.getElementById('fallbackTextarea');
                    if (fallbackTextarea && messageTextarea) {
                        fallbackTextarea.addEventListener('input', function() {
                            messageTextarea.value = fallbackTextarea.value;
                            updateSendButton();
                        });
                    }
                }
            }
        }
    });
</script>
<script>
    document.addEventListener('keydown', function (e) {
        // Block Ctrl+C, Ctrl+V, Ctrl+X, Ctrl+S, Ctrl+U
        if ((e.ctrlKey || e.metaKey) && ['c', 'v', 'x', 's', 'u'].includes(e.key.toLowerCase())) {
            e.preventDefault();
        }
    });
</script>