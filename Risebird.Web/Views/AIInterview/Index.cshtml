                <div class="rb-timer-bar">
                    <div class="rb-timer-bar-fill"></div>
                    </div>

             @*    <div style="position: fixed; top: 10px; right: 20px; background: #222; color: #fff; padding: 10px 20px; border-radius: 8px; font-size: 1.2rem;">
                    ⏳ Time Left: <span id="timer">--:--</span>
                </div> *@
