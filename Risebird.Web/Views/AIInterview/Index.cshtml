@using Risebird.Entities.ViewModel
@using System.Text.Json
@model ChatMessageViewModel
@{
    ViewData["Title"] = "AI Interview";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}

<div class="rb-aiinterview-container">
    <!-- Header -->
    <div class="rb-header">
        <div class="rb-logo-title">
            <span class="rb-title">AI Interview</span>
        </div>
        <div class="rb-header-controls">
            <span class="rb-timer">
                <i class="fa fa-clock-o"></i> Interview Time Left <b>05:13</b>
                <div class="rb-timer-bar"><div class="rb-timer-bar-fill"></div></div>
            </span>
            <button class="rb-extend-time">Extend Time</button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="rb-main">
        <!-- Left: Video -->
        <div class="rb-video-section">
            <div class="rb-video-feed">
                <div class="videoContainer">
                    <video id="video" autoplay muted style="width:100%;height:370px;object-fit:cover;border-radius:16px;background:#000;"></video>
                </div>
                <span class="rb-candidate-name">Andrews (You)</span>

                <div class="videoButtons" style="display:flex;gap:10px;justify-content:center;margin-top:12px;">
                    <button id="btnRecordToggle" type="button" title="Toggle Recording" class="rb-record-btn">
                        <span id="btnRecord"><i class="fa fa-circle"></i> Rec</span>
                    </button>
                </div>
            </div>
            <!-- Footer -->
            <div class="rb-footer">
                @*                 <button class="rb-footer-btn" title="End"><i class="fa fa-sign-out"></i></button>
 *@                <button id="footerVideoToggle" class="rb-footer-btn" title="Toggle Video">
                    <i id="footerVideoIcon" class="fa fa-video-camera"></i>
                </button>
                @*                 <button class="rb-footer-btn" title="Mic"><i class="fa fa-microphone"></i></button>
 *@                <button class="rb-footer-btn" title="Upload"><i class="fa fa-upload"></i></button>
            </div>
        </div>
        <!-- Right: Chat and Interviewer Info -->
        <div class="rb-question-section">
            <!-- Chat Section (now in place of question box) -->
            <div class="rb-chat-section mt-3">
                <div class="rb-chatbox-container">
                    <div class="rb-chatgpt-welcome">
                        Let's start the interview
                    </div>
                    <form asp-action="Index" method="post" class="rb-chatbox-form" enctype="multipart/form-data" autocomplete="off">
                        <input type="hidden" asp-for="SessionId" />
                        <div class="rb-chatbox-inputrow">
                            <textarea asp-for="Message" class="rb-chatbox-textarea" placeholder="Ask anything..." rows="1" autocomplete="off"></textarea>
                            <button type="button" class="rb-chatbox-micbtn" id="recordBtn" title="Voice Input">
                                <i class="fa fa-microphone"></i>
                            </button>
                            <input type="file" name="AudioFile" accept="audio/*" class="form-control" id="audioInput" hidden />
                            <input type="file" name="VideoFile" accept="video/*" class="form-control" id="videoInput" hidden />

                            <button type="submit" class="rb-chatbox-sendbtn" title="Send">
                                <i class="fa fa-arrow-up"></i>
                            </button>
                        </div>
                        <audio id="assistantAudio" controls hidden></audio>
                    </form>
                    <div class="chat-log border rounded p-3 bg-light mt-3">
                        @foreach (var line in Model.ChatLog)
                        {
                            <div class="mb-2">
                                <strong>@line.Role:</strong>
                                <p>@line.Message</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="rb-interviewer-info">
                <span>AI Interviewer</span>
                <div class="rb-interviewer-avatar">
                    <span>H</span>
                </div>
            </div>
        </div>
    </div>
    <script>
        function playAssistantAudio(blob) {
            debugger;
            const audioElement = document.getElementById("assistantAudio");
            const audioUrl = URL.createObjectURL(blob);
            audioElement.src = audioUrl;
            audioElement.hidden = false;
            audioElement.play();
        }
    </script>
    @if (ViewData["AssistantAudioBase64"] is string base64Audio)
    {
        <script>
            const base64 = @Html.Raw(Json.Serialize(ViewData["AssistantAudioBase64"]));
            const audioBlob = new Blob([
                Uint8Array.from(atob(base64), c => c.charCodeAt(0))
            ], { type: 'audio/mp3' });

            playAssistantAudio(audioBlob);
        </script>
    }

    

    <script>
        let mediaRecorderAudio;
        let audioChunks = [];
        const recordBtn = document.getElementById("recordBtn");
        const audioInput = document.getElementById("audioInput");
        const videoInput = document.getElementById("videoInput");
        const form = document.querySelector("form"); // 🔥 grabs the first form on the page

        recordBtn.addEventListener("click", async () => {
            if (!mediaRecorderAudio || mediaRecorderAudio.state === "inactive") {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorderAudio = new MediaRecorder(stream);

                mediaRecorderAudio.ondataavailable = e => {
                    audioChunks.push(e.data);
                };

                mediaRecorderAudio.onstop = async () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                    const file = new File([audioBlob], "voice-input.wav", { type: 'audio/wav' });

                    // populate the file input with blob data
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    audioInput.files = dataTransfer.files;

                    audioChunks = [];
                    recordBtn.textContent = "🎙️ Record";
                    stopRecording();
                    // 🔥 Submit the form automatically

                };

                mediaRecorderAudio.start();
                startRecording();
                recordBtn.textContent = "🛑 Stop Recording";
            } else if (mediaRecorderAudio.state === "recording") {
                mediaRecorderAudio.stop(); // triggers onstop, which submits
            }
        });
    </script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const textarea = document.querySelector('.rb-chatbox-textarea');
            const sendBtn = document.querySelector('.rb-chatbox-sendbtn');
            const form = document.querySelector('.rb-chatbox-form');

            // Enable/disable send button
            if (textarea && sendBtn) {
                function toggleSendBtn() {
                    sendBtn.disabled = textarea.value.trim().length === 0;
                }
                textarea.addEventListener('input', toggleSendBtn);
                toggleSendBtn();
            }

            // Submit on Enter, new line on Shift+Enter
            if (textarea && form) {
                textarea.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                    }
                });

                // Clear textarea after submit
                form.addEventListener('submit', function () {
                    setTimeout(function () {
                        textarea.value = '';
                        if (sendBtn) sendBtn.disabled = true;
                    }, 10); // Let the form post, then clear
                });
            }
        });
    </script>
    <script>
        let mediaRecorder, recordedBlobs;
        let isRecording = false;
        const video = document.getElementById('video');
        const btnRecord = document.getElementById('btnRecord');
        const btnRecordToggle = document.getElementById('btnRecordToggle');
        let blobtransfer;
        if (navigator.mediaDevices && video) {
            navigator.mediaDevices.getUserMedia({ video: true, audio: true })
                .then(function(stream) {
                    video.srcObject = stream;
                    window.stream = stream;
                })
                .catch(function(err) {
                    alert('Could not access camera/microphone: ' + err);
                });
        }

        if (btnRecordToggle) {
            btnRecordToggle.onclick = function() {
                if (!isRecording) {
                    // Start Recording
                    startRecording();
                } else {
                    // Stop Recording
                    stopRecording();
                }
            };

            function startRecording() {
                chunks = [];
                let options = { mimeType: 'video/mp4;codecs=vp9,opus' };
                try {
                    mediaRecorder = new MediaRecorder(window.stream, options);
                } catch (e) {
                    alert('MediaRecorder not supported: ' + e);
                    return;
                }

                mediaRecorder.ondataavailable = function(event) {
                    if (event.data && event.data.size > 0) {
                        chunks.push(event.data);
                    }
                };
                mediaRecorder.onstop = (ev) => {
                    let blob = new Blob(chunks, { 'type': 'video/mp4;' });
                    let videoURL = window.URL.createObjectURL(blob);
                    console.log(videoURL);
                    const filevideo = new File([blob], "videoinput.mp4", { type: 'video/mp4' });
                    const dataTransfervideo = new DataTransfer();
                    dataTransfervideo.items.add(filevideo);
                    videoInput.files = dataTransfervideo.files;
                    chunks = [];

                    form.submit();
                    //blobtransfer = blob;
                }
                // mediaRecorder.onstop = function() {
                //     // Recording stopped - you can now upload or preview the video
                //     console.log('Recording stopped. Blobs:', chunks);
                //     // Example: let superBuffer = new Blob(recordedBlobs, {type: 'video/webm'});
                // };

                mediaRecorder.start();
                isRecording = true;

                // Update UI
                btnRecordToggle.innerHTML = '<i class="fa fa-stop"></i> Rec';
                btnRecordToggle.className = 'rb-record-btn rb-recording';
                btnRecord.style.display = 'block';
                btnRecord.style.animation = 'pulse 1.5s infinite';
            }

            function stopRecording() {
                if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                    mediaRecorder.stop();
                }

                isRecording = false;
                // Update UI
                btnRecordToggle.innerHTML = '<i class="fa fa-circle"></i>  Rec';
                btnRecordToggle.className = 'rb-record-btn';
                btnRecord.style.display = 'none';
                btnRecord.style.animation = 'none';
            }
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let video = document.getElementById('video');
            let footerVideoToggle = document.getElementById('footerVideoToggle');
            let footerVideoIcon = document.getElementById('footerVideoIcon');
            let mediaStreamObj = null;
           let videoOn = true;

            // Set initial state to OFF
            if (footerVideoIcon) footerVideoIcon.className = 'fa fa-video-camera';
            if (video) video.style.opacity = 1;

            if (footerVideoToggle && video) {
                footerVideoToggle.addEventListener('click', function () {
                    if (!videoOn) {
                        // Turn video ON
                        if (!mediaStreamObj) {
                            navigator.mediaDevices.getUserMedia({ video: true, audio: true })
                                .then(function(stream) {
                                    mediaStreamObj = stream;
                                    if (video) {
                                        video.srcObject = stream;
                                        mediaStreamObj.getTracks().forEach(track => {
                                            if (track.kind === 'video') track.enabled = true;
                                        });
                                        videoOn = true;
                                        footerVideoIcon.className = 'fa fa-video-camera';
                                        video.style.opacity = 1;
                                    }
                                })
                                .catch(function(err) {
                                    alert('Could not access camera/microphone: ' + err);
                                });
                        } else {
                            mediaStreamObj.getTracks().forEach(track => {
                                if (track.kind === 'video') track.enabled = true;
                            });
                            videoOn = true;
                            footerVideoIcon.className = 'fa fa-video-camera';
                            if (video) video.style.opacity = 1;
                        }
                    } else {
                        // Turn video OFF
                        if (mediaStreamObj) {
                            mediaStreamObj.getTracks().forEach(track => {
                                if (track.kind === 'video') track.enabled = false;
                            });
                        }
                        videoOn = false;
                        footerVideoIcon.className = 'fas fa-video-slash';
                       if (video) video.style.opacity = 0;
                    }
                });
            }
        });
    </script>
