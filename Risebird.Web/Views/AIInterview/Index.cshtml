    let totalSecondsLeft = parseInt("@Model.TimeLeftInSeconds" || "900");
    let interviewId = parseInt("@Model.InterviewId");

    const timerDisplay = document.getElementById("timer");
    const timeField = document.getElementById("timeLeftField");
    let timerStopped = false;

    function updateTimerUI() {
        const minutes = Math.floor(totalSecondsLeft / 60);
        const seconds = totalSecondsLeft % 60;
        timerDisplay.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        timeField.value = totalSecondsLeft;
    }

    async function postTimeLeftToServer(seconds) {
        await fetch("/AIInterview/UpdateTimeLeft", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                sessionId: "@Model.SessionId",
                timeLeftInSeconds: seconds,
                interviewId: interviewId
            })
        });
    }

    let countdownInterval = setInterval(() => {
        if (!timerStopped && totalSecondsLeft > 0) {
            totalSecondsLeft--;
            updateTimerUI();

            if (totalSecondsLeft % 60 === 0) {
                postTimeLeftToServer(totalSecondsLeft);
            }
        }
    }, 1000);

    updateTimerUI();
</script>


    <script>
        function playAssistantAudio(blob) {
            debugger;
            const audioElement = document.getElementById("assistantAudio");
            const audioWaves = document.getElementById("audioWaves");
            const audioUrl = URL.createObjectURL(blob);
            audioElement.src = audioUrl;
            audioElement.hidden = false;
            audioElement.play();
            
            // Show audio waves when playing starts
            if (audioWaves) {
                audioWaves.style.display = 'flex';
            }
        }

        // Chat Log Scrolling Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const chatLog = document.getElementById('chatLog');
            const scrollToBottomBtn = document.getElementById('scrollToBottom');
            const audioElement = document.getElementById('assistantAudio');
            const audioWaves = document.getElementById('audioWaves');
            
            // Audio event listeners for wave animation
            if (audioElement && audioWaves) {
                audioElement.addEventListener('play', function() {
                    audioWaves.style.display = 'flex';
                });
                
                audioElement.addEventListener('pause', function() {
                    audioWaves.style.display = 'none';
                });
                
                audioElement.addEventListener('ended', function() {
                    audioWaves.style.display = 'none';
                });
            }
            
            if (chatLog && scrollToBottomBtn) {
                // Function to scroll to bottom
                function scrollToBottom() {
                    chatLog.scrollTo({
                        top: chatLog.scrollHeight,
                        behavior: 'smooth'
                    });
                }

                // Function to check if scroll to bottom button should be shown
                function checkScrollPosition() {
                    const isNearBottom = chatLog.scrollTop + chatLog.clientHeight >= chatLog.scrollHeight - 100;
                    
                    if (!isNearBottom && chatLog.scrollHeight > chatLog.clientHeight) {
                        scrollToBottomBtn.classList.add('show');
                    } else {
                        scrollToBottomBtn.classList.remove('show');
                    }
                }

                // Scroll to bottom button click handler
                scrollToBottomBtn.addEventListener('click', scrollToBottom);

                // Check scroll position on scroll
                chatLog.addEventListener('scroll', checkScrollPosition);

                // Check scroll position on window resize
                window.addEventListener('resize', checkScrollPosition);

                // Initial check
                checkScrollPosition();

                // Auto-scroll to bottom when new messages are added
                const observer = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
                            // Check if we're near the bottom before auto-scrolling
                            const isNearBottom = chatLog.scrollTop + chatLog.clientHeight >= chatLog.scrollHeight - 150;
                            if (isNearBottom) {
                                setTimeout(scrollToBottom, 100);
                            }
                        }
                    });
                });

                observer.observe(chatLog, {
                    childList: true,
                    subtree: true
                });
            }
        });
    </script>
