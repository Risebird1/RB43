@using Risebird.Entities.ViewModel
@model ChatMessageViewModel
@{
    ViewData["Title"] = "AI Interview";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}

<h2>AI Interview Assistant</h2>

<div class="mt-4 mb-4">
    <form asp-action="Index" method="post">
        <input type="hidden" asp-for="SessionId" />
        <div class="form-group">
            <textarea asp-for="Message" class="form-control" placeholder="Type your answer..." rows="3"></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Send</button>
    </form>
</div>

<div class="chat-log border rounded p-3 bg-light">
    @foreach (var line in Model.ChatLog)
    {
        <div class="mb-2">
            <strong>@line.Role:</strong>
            <p>@line.Message</p>
        </div>
    }
</div>
