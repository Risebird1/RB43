    // ===============================================
    // LISTENING COMPREHENSION ASSESSMENT FUNCTIONALITY
    // ===============================================
    (function() {
        const isListeningComprehensionQuestion = @Json.Serialize(Model.IsListeningComprehensionQuestion);

        if (!isListeningComprehensionQuestion) {
            return; // Not a listening comprehension question, skip this functionality
        }

        // Only the audio URL is sent to the browser. The transcription and the expected
        // answer are deliberately NOT emitted here - they are grading material and would be
        // readable in the page source. The server reads both from the database at scoring time.
        const audioUrl = @Json.Serialize(Model.ListeningAudioUrl);

        // Candidate gets three minutes to write the summary, counted from the moment the first
        // full playback ends.
        const LISTENING_TIME_LIMIT_SECONDS = 180;
        const MAX_AUDIO_PLAYS = 2;

        // Store listening assessment data
        let listeningStartTime = null;
        let listeningEndTime = null;
        let listeningInProgress = false;
        let audioPlayCount = 0;
        let timerStarted = false;
        let listeningTimeExpired = false;

        // Show listening comprehension modal when page loads
        function showListeningComprehensionModal() {
            let timerInterval = null;
            let startTime = null;
            let audioElement = null;

            Swal.fire({
                title: 'Listening Comprehension Assessment',
                html: `
                    <div style="text-align: left; margin-bottom: 20px;">
                        <p style="margin-bottom: 15px; font-size: 14px; color: #666;">
                            This question assesses your listening comprehension. You can listen to the audio twice, then summarize what you heard.
                        </p>
                        <div id="listeningInstructions" style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid #4eda92;">
                            <strong>Instructions:</strong>
                            <ul style="margin: 10px 0 0 20px; font-size: 13px; color: #555;">
                                <li>Click "Start" to begin the assessment</li>
                                <li>Use the audio player controls to play the audio</li>
                                <li>You can listen to the audio up to 2 times</li>
                                <li>The audio cannot be skipped or rewound while playing</li>
                                <li>You get <strong>3 minutes</strong> to write your summary</li>
                                <li>The 3-minute timer starts only after the first playback finishes</li>
                                <li>The text area unlocks after the first playback finishes</li>
                                <li>Your answer is submitted automatically when the time is up</li>
                                <li>Video recording will track your response</li>
                                <li>Click "Submit" when finished</li>
                            </ul>
                        </div>
                        <div id="listeningAudioContainer" style="display: none; background: #e8f2ff; padding: 20px; border-radius: 8px; margin-bottom: 15px; text-align: center;">
                            <audio id="listeningAudio" style="width: 100%; max-width: 400px;" controls></audio>
                            <p id="audioPlayCountMsg" style="margin-top: 10px; font-size: 13px; color: #666;">
                                <i class="fa fa-info-circle"></i> <span id="playsRemaining">You can play the audio 2 times.</span>
                            </p>
                        </div>
                        <div id="listeningTimerDisplay" style="display: none; text-align: center; margin-bottom: 15px; font-size: 18px; font-weight: bold; color: #4eda92;">
                            Time remaining: <span id="listeningTimerValue">3:00</span>
                        </div>
                        <textarea id="listeningSummaryArea"
                                  placeholder="Write your summary here after listening to the audio..."
                                  style="width: 100%; height: 150px; padding: 10px; border: 2px solid #ddd; border-radius: 8px; font-family: 'Segoe UI', Arial, sans-serif; font-size: 14px; resize: vertical; display: none;"
                                  disabled></textarea>
                    </div>
                `,
                showCancelButton: false,
                showConfirmButton: true,
                confirmButtonText: '<i class="fa fa-play"></i> Start',
                confirmButtonColor: '#4eda92',
                allowOutsideClick: false,
                allowEscapeKey: false,
                width: '700px',
                preConfirm: () => {
                    const summaryArea = document.getElementById('listeningSummaryArea');
                    const audioContainer = document.getElementById('listeningAudioContainer');
                    const timerDisplay = document.getElementById('listeningTimerDisplay');
                    const instructions = document.getElementById('listeningInstructions');
                    const confirmBtn = Swal.getConfirmButton();

                    if (!listeningInProgress) {
                        // Start the listening comprehension test
                        listeningInProgress = true;

                        // Update UI
                        instructions.style.display = 'none';
                        audioContainer.style.display = 'block';
                        summaryArea.style.display = 'block';

                        // Setup audio element
                        audioElement = document.getElementById('listeningAudio');
                        audioElement.src = audioUrl;

                        // Track play count and control replays. The 'ended' event is the only
                        // thing that increments the count, so seeking has to be blocked outright -
                        // otherwise a candidate could scrub back and re-hear the audio any number
                        // of times without ever completing a playback.
                        let lastAllowedTime = 0;
                        let playbackLocked = false;

                        audioElement.addEventListener('play', function () {
                            if (playbackLocked || audioPlayCount >= MAX_AUDIO_PLAYS) {
                                audioElement.pause();
                                audioElement.currentTime = 0;
                                Swal.showValidationMessage(`Audio can only be played ${MAX_AUDIO_PLAYS} times!`);
                            } else {
                                // Clear any earlier warning so it does not keep the confirm button disabled.
                                try { Swal.resetValidationMessage(); } catch (e) { }
                            }
                        });

                        audioElement.addEventListener('timeupdate', function () {
                            // Remember the furthest legitimately reached position.
                            if (!audioElement.seeking) {
                                lastAllowedTime = audioElement.currentTime;
                            }
                        });

                        audioElement.addEventListener('seeking', function () {
                            // Snap back on any attempt to jump forward or backward mid-playback.
                            if (Math.abs(audioElement.currentTime - lastAllowedTime) > 1) {
                                audioElement.currentTime = lastAllowedTime;
                            }
                        });

                        audioElement.addEventListener('ended', function () {
                            audioPlayCount++;
                            lastAllowedTime = 0;

                            const playsRemainingElement = document.getElementById('playsRemaining');
                            if (playsRemainingElement) {
                                const remaining = MAX_AUDIO_PLAYS - audioPlayCount;
                                if (remaining > 0) {
                                    playsRemainingElement.textContent = `You can play the audio ${remaining} more time${remaining > 1 ? 's' : ''}.`;
                                    playsRemainingElement.style.color = '#4eda92';
                                } else {
                                    playsRemainingElement.textContent = `Audio playback limit reached (${MAX_AUDIO_PLAYS}/${MAX_AUDIO_PLAYS}).`;
                                    playsRemainingElement.style.color = '#dc3545';
                                    // Hard-disable playback, not just the pointer styling.
                                    playbackLocked = true;
                                    audioElement.controls = false;
                                    audioElement.style.pointerEvents = 'none';
                                    audioElement.style.opacity = '0.6';
                                }
                            }

                            // After first playback, start the one-minute countdown and unlock the text area
                            if (audioPlayCount === 1) {
                                if (!timerStarted) {
                                    timerStarted = true;
                                    listeningStartTime = new Date();
                                    startTime = Date.now();
                                    timerDisplay.style.display = 'block';

                                    // One-minute countdown. Auto-submits when it hits zero.
                                    timerInterval = setInterval(() => {
                                        const elapsed = Math.floor((Date.now() - startTime) / 1000);
                                        const remainingSeconds = LISTENING_TIME_LIMIT_SECONDS - elapsed;
                                        const timerValueElement = document.getElementById('listeningTimerValue');

                                        if (remainingSeconds <= 0) {
                                            if (timerValueElement) {
                                                timerValueElement.textContent = '0:00';
                                                timerValueElement.style.color = '#dc3545';
                                            }
                                            clearInterval(timerInterval);
                                            timerInterval = null;
                                            listeningTimeExpired = true;

                                            // Stop the audio if it is still playing on the second pass.
                                            try { audioElement.pause(); } catch (e) { }

                                            // A lingering validation message (e.g. from an attempted
                                            // third playback) leaves the confirm button disabled, which
                                            // would swallow the click below and trap the candidate.
                                            try {
                                                Swal.resetValidationMessage();
                                                Swal.enableButtons();
                                            } catch (e) { }

                                            confirmBtn.click(); // Trigger submit
                                        } else {
                                            const minutes = Math.floor(remainingSeconds / 60);
                                            const seconds = remainingSeconds % 60;
                                            if (timerValueElement) {
                                                timerValueElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                                                if (remainingSeconds <= 15) {
                                                    timerValueElement.style.color = '#dc3545';
                                                }
                                            }
                                        }
                                    }, 1000);
                                }

                                // Enable text area after first playback
                                summaryArea.disabled = false;
                                summaryArea.focus();
                            }
                        });

                        // Change button to Submit
                        confirmBtn.innerHTML = '<i class="fa fa-check"></i> Submit';
                        confirmBtn.style.backgroundColor = '#28a745';

                        // Start video recording automatically
                        if (typeof startRecording === 'function') {
                            startRecording();
                        }

                        // Do NOT auto-play audio - let candidate control it

                        // Return false to prevent modal from closing
                        return false;
                    } else {
                        // Submit the listening comprehension test
                        if (timerInterval) {
                            clearInterval(timerInterval);
                        }

                        // Stop video recording when test is submitted
                        if (typeof stopRecording === 'function') {
                            stopRecording();
                        }

                        listeningEndTime = new Date();
                        const candidateSummary = summaryArea.value;

                        // Require a summary only on a manual submit. When the time runs out the
                        // answer goes in as-is - blocking here would leave the candidate stuck on
                        // a modal they can no longer clear.
                        if (!listeningTimeExpired && (!candidateSummary || candidateSummary.trim().length === 0)) {
                            Swal.showValidationMessage('Please write a summary before submitting!');
                            return false;
                        }

                        // Calculate time taken. listeningStartTime is set when the first playback
                        // ends; fall back to the end time if the candidate somehow submits before that.
                        const timeTaken = listeningStartTime
                            ? (listeningEndTime - listeningStartTime) / 1000
                            : 0;

                        // Store data in hidden form fields. The transcription is intentionally not
                        // posted back - the server reads it from the database.
                        document.getElementById('ListeningAudioUrl').value = audioUrl;
                        document.getElementById('ListeningSummary').value = candidateSummary;
                        document.getElementById('ListeningStartTime').value = listeningStartTime
                            ? listeningStartTime.toISOString()
                            : listeningEndTime.toISOString();
                        document.getElementById('ListeningEndTime').value = listeningEndTime.toISOString();
                        document.getElementById('ListeningTimeTaken').value = timeTaken.toFixed(2);
                        document.getElementById('ListeningAudioPlayCount').value = audioPlayCount;
                        document.getElementById('ListeningIsTimeExpired').value = listeningTimeExpired ? 'true' : 'false';

                        // Show confirmation and submit
                        Swal.fire({
                            title: listeningTimeExpired ? "Time's up!" : 'Assessment Complete!',
                            html: `
                                <div style="text-align: left;">
                                    <p style="margin-bottom: 15px; color: #666;">
                                        ${listeningTimeExpired
                                            ? 'Your three minutes are up. Your answer has been recorded as typed.'
                                            : 'Your listening comprehension assessment has been recorded.'}
                                    </p>
                                    <p style="font-size: 14px; color: #666;">
                                        <strong>Time taken:</strong> ${timeTaken.toFixed(2)} seconds
                                    </p>
                                </div>
                            `,
                            icon: listeningTimeExpired ? 'warning' : 'success',
                            confirmButtonText: 'Continue',
                            confirmButtonColor: '#4eda92',
                            allowOutsideClick: false
                        }).then(() => {
                            const form = document.getElementById('chatForm');
                            if (!form) return;

                            // On a timeout there is nothing left to confirm - the time is gone,
                            // so submit straight away.
                            if (listeningTimeExpired) {
                                form.submit();
                                return;
                            }

                            // After showing result, trigger form submission with confirmation
                            if (form) {
                                Swal.fire({
                                    title: 'Submit Answer?',
                                    text: 'Are you sure you want to submit your listening comprehension assessment?',
                                    icon: 'question',
                                    showCancelButton: true,
                                    confirmButtonColor: '#4eda92',
                                    cancelButtonColor: '#d33',
                                    confirmButtonText: 'Submit Answer',
                                    cancelButtonText: 'Cancel',
                                    reverseButtons: false,
                                    focusConfirm: true
                                }).then((result) => {
                                    if (result.isConfirmed || result.value === true) {
                                        // User confirmed - submit the form
                                        form.submit();
                                    } else {
                                        // User cancelled
                                        console.log("Listening comprehension assessment submission cancelled");
                                    }
                                });
                            }
                        });

                        // Return true to allow the modal to close
                        return true;
                    }
                }
            });
        }

        // Add hidden form fields to store listening comprehension data
        function addListeningHiddenFormFields() {
            const form = document.getElementById('chatForm');
            if (!form) return;

            const hiddenFields = [
                { name: 'IsListeningComprehensionQuestion', value: 'true' },
                { name: 'ListeningAudioUrl', value: '' },
                { name: 'ListeningSummary', value: '' },
                { name: 'ListeningStartTime', value: '' },
                { name: 'ListeningEndTime', value: '' },
                { name: 'ListeningTimeTaken', value: '' },
                { name: 'ListeningAudioPlayCount', value: '0' },
                { name: 'ListeningIsTimeExpired', value: 'false' }
            ];

            hiddenFields.forEach(field => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = field.name;
                input.id = field.name;
                input.value = field.value;
                form.appendChild(input);
            });
        }

        // Initialize listening comprehension assessment
        setTimeout(() => {
            addListeningHiddenFormFields();
            showListeningComprehensionModal();
        }, 1000); // Show modal 1 second after page load

    })();

    // ============================================
    // CODING QUESTION ASSESSMENT
    // ============================================
    (function () {
        const isCodingQuestion = @Json.Serialize(Model.IsCodingQuestion);

        if (!isCodingQuestion) {
            return; // Not a coding question, skip this functionality
        }

        const DEFAULT_TIME_LIMIT_MINUTES = 15;
        const configuredTimeLimit = @Json.Serialize(Model.CodingTimeLimitInMinutes);
        const timeLimitMinutes = (configuredTimeLimit && configuredTimeLimit > 0) ? configuredTimeLimit : DEFAULT_TIME_LIMIT_MINUTES;
        const questionText = @Json.Serialize(Model.CurrentQuestion);
        const sessionId = @Json.Serialize(Model.SessionId);
        const questionId = @Json.Serialize(Model.CurrentQuestionId);
        const executionEnabled = @Json.Serialize(CodeExecution.IsEnabled);
        const codingLanguages = @Json.Serialize(
            CodeLanguageCatalog.Languages.Select(l => new
            {
                id = l.Id,
                label = l.Label,
                mode = l.CodeMirrorMode,
                template = l.Template
            }));

        let codingStartTime = null;
        let codingEndTime = null;
        let codingInProgress = false;
        let codingSubmitted = false;
        let codingTimerAndRecordingStarted = false;
        let codingEditorOpened = false;
        let codingEditor = null;
        let countdownInterval = null;
        let codingRunCount = 0;
        let lastRunOutput = '';
        let lastRunStatus = '';
        let runInFlight = false;

        function formatClock(totalSeconds) {
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;
            return minutes + ':' + seconds.toString().padStart(2, '0');
        }

        function currentCode() {
            if (codingEditor) {
                return codingEditor.getValue();
            }
            const fallback = document.getElementById('codingFallbackArea');
            return fallback ? fallback.value : '';
        }

        function setCode(value) {
            if (codingEditor) {
                codingEditor.setValue(value || '');
                codingEditor.refresh();
                return;
            }
            const fallback = document.getElementById('codingFallbackArea');
            if (fallback) {
                fallback.value = value || '';
            }
        }

        function languageById(id) {
            return codingLanguages.find(l => l.id === id) || null;
        }

        function populateLanguageDropdown() {
            const select = document.getElementById('codingLanguage');
            if (!select) return;

            select.innerHTML = '';
            codingLanguages.forEach(lang => {
                const option = document.createElement('option');
                option.value = lang.id;
                option.textContent = lang.label;
                select.appendChild(option);
            });
        }

        // Swapping language reloads the starter template, but only while the candidate
        // has not written anything beyond a previous template.
        function applyLanguage(languageId, forceTemplate) {
            const lang = languageById(languageId);
            if (!lang) return;

            if (codingEditor) {
                codingEditor.setOption('mode', lang.mode || 'text');
            }

            const existing = currentCode().trim();
            const isUntouched = existing.length === 0 || codingLanguages.some(l => (l.template || '').trim() === existing);

            if (forceTemplate || isUntouched) {
                setCode(lang.template || '');
            }
        }

        function buildCodingEditor() {
            const container = document.getElementById('codingEditorContainer');
            if (!container) return;

            if (typeof CodeMirror === 'undefined') {
                // Fall back to a plain textarea so the candidate is never blocked
                container.innerHTML = '<textarea id="codingFallbackArea" style="width:100%; height:100%; min-height:280px; font-family:Consolas,Monaco,monospace; font-size:13px; padding:10px; border:0; outline:none; resize:none;"></textarea>';
                return;
            }

            codingEditor = CodeMirror(container, {
                value: '',
                mode: 'text',
                theme: 'default',
                lineNumbers: true,
                lineWrapping: true,
                indentUnit: 4,
                indentWithTabs: false,
                smartIndent: true,
                autoCloseBrackets: true,
                matchBrackets: true,
                styleActiveLine: true,
                extraKeys: {
                    "Tab": function (cm) {
                        if (cm.somethingSelected()) {
                            cm.indentSelection("add");
                        } else {
                            cm.replaceSelection("    ", "end");
                        }
                    },
                    "Shift-Tab": function (cm) {
                        cm.indentSelection("subtract");
                    },
                    "Ctrl-C": function () { return false; },
                    "Ctrl-V": function () { return false; },
                    "Ctrl-X": function () { return false; },
                    "Cmd-C": function () { return false; },
                    "Cmd-V": function () { return false; },
                    "Cmd-X": function () { return false; }
                }
            });

            codingEditor.setSize('100%', '100%');

            // Mirror every keystroke into the posted field. Capturing only at submit time means
            // a single failure there loses the whole answer, so the form always holds the latest code.
            codingEditor.on('change', function () {
                const codeField = document.getElementById('CodingSubmittedCode');
                if (codeField) {
                    codeField.value = codingEditor.getValue();
                }
            });

            codingEditor.on('contextmenu', function (cm, event) {
                event.preventDefault();
                return false;
            });
            ['paste', 'copy', 'cut'].forEach(function (evt) {
                codingEditor.on(evt, function (cm, event) {
                    event.preventDefault();
                    return false;
                });
            });

            setTimeout(function () { codingEditor.refresh(); }, 50);
        }

        function selectedLanguage() {
            const langSelector = document.getElementById('codingLanguage');
            return langSelector ? langSelector.value : '';
        }

        function setRunStatus(text, isOk) {
            const statusHost = document.getElementById('codingRunStatus');
            if (!statusHost) return;
            statusHost.textContent = text || '';
            statusHost.className = 'rb-ide-status' + (text ? (isOk ? ' is-ok' : ' is-bad') : '');
        }

        function writeOutput(text) {
            const outputHost = document.getElementById('codingOutput');
            if (outputHost) {
                outputHost.textContent = text;
            }
        }

        async function runCode() {
            if (runInFlight || codingSubmitted) return;

            const code = currentCode();
            if (!code || code.trim().length === 0) {
                writeOutput('Write some code before running it.');
                setRunStatus('Nothing to run', false);
                return;
            }

            const runBtn = document.getElementById('codingRunBtn');
            runInFlight = true;
            if (runBtn) runBtn.disabled = true;
            setRunStatus('Running...', true);
            writeOutput('Compiling and running your code...');

            try {
                const response = await fetch('/AIInterview/RunCode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: sessionId,
                        questionId: questionId,
                        language: selectedLanguage(),
                        code: code,
                        stdin: (document.getElementById('codingStdin') || {}).value || ''
                    })
                });

                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }

                const result = await response.json();
                codingRunCount += 1;
                lastRunOutput = result.output || '';
                lastRunStatus = result.status || (result.success ? 'Success' : 'Error');

                writeOutput(lastRunOutput || '(no output)');
                setRunStatus(lastRunStatus, !!result.success);
            } catch (err) {
                console.error('Code execution failed', err);
                lastRunStatus = 'Runner unavailable';
                lastRunOutput = 'Could not reach the code runner. Your code is safe — you can still submit it.';
                writeOutput(lastRunOutput);
                setRunStatus(lastRunStatus, false);
            } finally {
                runInFlight = false;
                if (runBtn) runBtn.disabled = false;
            }
        }

        // True while the editor still holds nothing but a starter template, whichever
        // language it belongs to. Submitting that is the same as submitting nothing.
        function isUntouchedTemplate(code) {
            const trimmed = (code || '').trim();
            if (trimmed.length === 0) return true;
            return codingLanguages.some(l => (l.template || '').trim() === trimmed);
        }

        function captureCodingFields(isTimeExpired) {
            codingEndTime = new Date();
            const timeTaken = codingStartTime ? (codingEndTime - codingStartTime) / 1000 : 0;

            document.getElementById('CodingSubmittedCode').value = currentCode();
            document.getElementById('CodingLanguage').value = selectedLanguage();
            document.getElementById('CodingStartTime').value = codingStartTime ? codingStartTime.toISOString() : '';
            document.getElementById('CodingEndTime').value = codingEndTime.toISOString();
            document.getElementById('CodingTimeTaken').value = timeTaken.toFixed(2);
            document.getElementById('CodingIsTimeExpired').value = isTimeExpired ? 'true' : 'false';
            document.getElementById('CodingTimeLimitInMinutes').value = timeLimitMinutes;
            document.getElementById('CodingStdInput').value = (document.getElementById('codingStdin') || {}).value || '';
            document.getElementById('CodingLastRunOutput').value = lastRunOutput;
            document.getElementById('CodingLastRunStatus').value = lastRunStatus;
            document.getElementById('CodingRunCount').value = codingRunCount;

            return timeTaken;
        }

        // When the clock runs out the answer is submitted as-is, without a confirmation prompt
        function handleTimeExpired() {
            if (codingSubmitted) return;
            codingSubmitted = true;

            if (countdownInterval) {
                clearInterval(countdownInterval);
            }
            captureCodingFields(true);
            closeCodingIde();

            Swal.fire({
                title: "Time's up!",
                text: 'Your time limit for this coding question has ended. Your code is being submitted.',
                icon: 'info',
                confirmButtonText: 'Continue',
                confirmButtonColor: '#4eda92',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(() => {
                submitCodingAnswer();
            });
        }

        function startCountdown() {
            const timerValue = document.getElementById('codingTimerValue');
            let remaining = timeLimitMinutes * 60;
            if (timerValue) {
                timerValue.textContent = formatClock(remaining);
            }

            countdownInterval = setInterval(() => {
                remaining -= 1;
                if (timerValue) {
                    timerValue.textContent = formatClock(Math.max(remaining, 0));
                }
                if (remaining <= 60) {
                    const timerHost = document.getElementById('codingTimerDisplay');
                    if (timerHost) {
                        timerHost.classList.add('is-critical');
                    }
                }
                if (remaining <= 0) {
                    clearInterval(countdownInterval);
                    handleTimeExpired();
                }
            }, 1000);
        }

        // Page load: start the coding countdown + audio/video recording only.
        // The editor stays closed until the candidate presses Start.
        function startCodingRecordingAndTimer() {
            if (codingTimerAndRecordingStarted) return;
            codingTimerAndRecordingStarted = true;
            codingStartTime = new Date();

            const timerDisplay = document.getElementById('codingTimerDisplay');
            if (timerDisplay) {
                timerDisplay.style.display = 'block';
            }

            startCountdown();

            if (typeof beginAnswerRecording === 'function') {
                beginAnswerRecording().catch(function (err) {
                    console.error('Could not start recording for the coding question', err);
                });
            } else if (typeof startRecording === 'function') {
                startRecording();
            }
        }

        // Start button: open the code editor (recording + timer already running from page load).
        function beginCodingSession() {
            if (codingEditorOpened || codingSubmitted) return;
            codingEditorOpened = true;
            codingInProgress = true;

            if (!codingTimerAndRecordingStarted) {
                startCodingRecordingAndTimer();
            }

            document.getElementById('codingInstructions').style.display = 'none';
            document.getElementById('codingWorkspace').style.display = 'flex';
            const codingPlaceholder = document.getElementById('codingEditorPlaceholder');
            if (codingPlaceholder) {
                codingPlaceholder.style.display = 'none';
            }
            document.getElementById('codingSubmitBtn').style.display = 'inline-block';

            if (executionEnabled) {
                document.getElementById('codingRunBtn').style.display = 'inline-block';
            } else {
                document.getElementById('codingRunnerNote').textContent = 'Running code is unavailable in this environment — write your solution and submit it.';
                writeOutput('Running code is unavailable in this environment. Write your solution and submit it.');
            }

            buildCodingEditor();
            applyLanguage(selectedLanguage(), true);

            if (codingEditor) {
                codingEditor.focus();
            }
        }

        // The shared pipeline waits for the media files before posting. If a device or permission
        // problem means they never arrive, post anyway rather than stranding the candidate with
        // a full coding answer they cannot submit.
        function forceSubmitIfRecordingNeverArrives() {
            setTimeout(function () {
                if (typeof answerSubmitInFlight !== 'undefined' && answerSubmitInFlight) return;
                const form = document.getElementById('chatForm');
                if (!form) return;
                if (typeof answerSubmitInFlight !== 'undefined') {
                    answerSubmitInFlight = true;
                }
                form.submit();
            }, 10000);
        }

        // Hands off to the shared recording pipeline: stopping the audio recorder cascades into
        // stopping the video recorder, attaching both files, and posting the form once they are ready.
        function submitCodingAnswer() {
            if (typeof stopAudioRecordingForSubmit === 'function'
                && typeof mediaRecorderAudio !== 'undefined'
                && mediaRecorderAudio
                && mediaRecorderAudio.state === 'recording') {
                stopAudioRecordingForSubmit();
                if (typeof scheduleAnswerSubmitFallback === 'function') {
                    scheduleAnswerSubmitFallback();
                }
                forceSubmitIfRecordingNeverArrives();
                return;
            }

            // Recording never started (permissions, unsupported device) — submit the code anyway
            if (typeof stopRecording === 'function') {
                stopRecording();
            }
            if (typeof tryFinalizeAnswerSubmit === 'function' && tryFinalizeAnswerSubmit()) {
                return;
            }
            const form = document.getElementById('chatForm');
            if (form) {
                form.submit();
            }
        }

        function confirmAndSubmit() {
            if (codingSubmitted) return;

            const code = currentCode();
            if (isUntouchedTemplate(code)) {
                Swal.fire({
                    title: 'Nothing to submit',
                    text: 'The editor still contains only the starter template. Write your solution in the code editor — the Input (stdin) box below is only for test input your program reads.',
                    icon: 'warning',
                    confirmButtonColor: '#4eda92'
                });
                if (codingEditor) {
                    codingEditor.focus();
                }
                return;
            }

            Swal.fire({
                title: 'Submit Answer?',
                text: 'Are you sure you want to submit your coding answer? You cannot return to this question.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#4eda92',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Submit Answer',
                cancelButtonText: 'Keep Coding'
            }).then((result) => {
                if (!(result.isConfirmed || result.value === true)) {
                    return;
                }

                codingSubmitted = true;
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                }

                captureCodingFields(false);
                closeCodingIde();
                submitCodingAnswer();
            });
        }

        function closeCodingIde() {
            const overlay = document.getElementById('codingIdeOverlay');
            if (overlay) {
                overlay.classList.remove('is-open');
            }
        }

        function openCodingIde() {
            const overlay = document.getElementById('codingIdeOverlay');
            if (!overlay) return;

            const questionHost = document.getElementById('codingQuestionText');
            if (questionHost) {
                questionHost.textContent = questionText || '';
            }

            const limitLabel = document.getElementById('codingLimitLabel');
            if (limitLabel) {
                limitLabel.textContent = timeLimitMinutes + ' minute' + (timeLimitMinutes > 1 ? 's' : '');
            }

            populateLanguageDropdown();

            const langSelector = document.getElementById('codingLanguage');
            if (langSelector) {
                langSelector.addEventListener('change', function () {
                    applyLanguage(this.value, false);
                });
            }

            const codingStartBtn = document.getElementById('codingStartBtn');
            if (codingStartBtn) {
                codingStartBtn.addEventListener('click', beginCodingSession);
            }
            document.getElementById('codingRunBtn').addEventListener('click', runCode);
            document.getElementById('codingSubmitBtn').addEventListener('click', confirmAndSubmit);

            // Ctrl/Cmd+Enter runs the code, matching common editor muscle memory
            overlay.addEventListener('keydown', function (event) {
                if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
                    event.preventDefault();
                    if (codingInProgress && executionEnabled) {
                        runCode();
                    }
                }
            });

            overlay.classList.add('is-open');
        }

        function addCodingHiddenFormFields() {
            const form = document.getElementById('chatForm');
            if (!form) return;

            const hiddenFields = [
                { name: 'IsCodingQuestion', value: 'true' },
                { name: 'CodingTimeLimitInMinutes', value: timeLimitMinutes },
                { name: 'CodingLanguage', value: '' },
                { name: 'CodingSubmittedCode', value: '' },
                { name: 'CodingStartTime', value: '' },
                { name: 'CodingEndTime', value: '' },
                { name: 'CodingTimeTaken', value: '' },
                { name: 'CodingIsTimeExpired', value: 'false' },
                { name: 'CodingStdInput', value: '' },
                { name: 'CodingLastRunOutput', value: '' },
                { name: 'CodingLastRunStatus', value: '' },
                { name: 'CodingRunCount', value: '0' }
            ];

            hiddenFields.forEach(field => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = field.name;
                input.id = field.name;
                input.value = field.value;
                form.appendChild(input);
            });
        }

        setTimeout(() => {
            addCodingHiddenFormFields();
            openCodingIde();
            // Coding questions: timer + recording begin on page load.
            // Editor opens only when the candidate clicks Start.
            startCodingRecordingAndTimer();
        }, 1000);

        // Problem statement / Transcript tabs (coding split layout)
        document.querySelectorAll('.rb-coding-tab').forEach(function (tab) {
            tab.addEventListener('click', function () {
                var name = tab.getAttribute('data-coding-tab');
                document.querySelectorAll('.rb-coding-tab').forEach(function (t) {
                    var on = t.getAttribute('data-coding-tab') === name;
                    t.classList.toggle('is-active', on);
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                document.querySelectorAll('.rb-coding-panel').forEach(function (panel) {
                    panel.classList.toggle('is-active', panel.getAttribute('data-coding-panel') === name);
                });
            });
        });

    })();
</script>

@*
    ================================================================================
    Code project question
    ================================================================================
    The candidate gets a real machine with a small runnable project instead of the in-page
    editor. Left: the task. Right: the environment — launch, connect, commit.

      - The machine was usually started while the candidate was on the previous question
        (look-ahead), so Launch is quick. If not, the panel shows progress until it is ready.
      - The clock starts on handover, not on provisioning, and is kept server-side: a reload or
        a reconnect resumes the same countdown rather than restarting it.
      - Grading reads the candidate's last commit off the machine and runs hidden tests in a
        container. The candidate never sees the hidden tests or their results.
      - Like the MCQ section, the overlay cannot be dismissed, and nothing about "this was a
        code project" is posted by the page: the server decides that from CurrentQuestionId.
*@
@if (Model.IsCodeProjectQuestion)
{
