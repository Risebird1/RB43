        }

        // Get sample text from database (fetched in controller)
        const sampleText = @Html.Raw(Json.Serialize(Model.TypingSampleTextFromDB ?? ""));
        
        // Debug: Log sample text to console
        console.log('Typing Assessment - Sample Text Length:', sampleText ? sampleText.length : 0);
        console.log('Typing Assessment - Sample Text:', sampleText);
        
        // Validate sample text exists
        if (!sampleText || sampleText.trim() === '') {
            console.error('ERROR: No sample text available for typing assessment!');
            Swal.fire({
                title: 'Configuration Error',
                text: 'No typing sample text is available. Please contact the administrator to add sample texts to the database.',
                icon: 'error',
                confirmButtonText: 'OK'
            });
            return; // Exit if no sample text
        }
        
        // Store typing assessment data
        let typingStartTime = null;
        let typingEndTime = null;
