@using Risebird.CommonHelper
@using Risebird.Entities.Data
@using Risebird.Web.Helpers
@using System.Linq
@model Risebird.Entities.ViewModel.ProctoringSessionEventsResultViewModel
@{
    Layout = null;
    ViewData["Title"] = "Proctoring report";
    var candidateName = string.IsNullOrWhiteSpace(Model.CandidateName) ? "Candidate" : Model.CandidateName.Trim();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Proctoring Report — @candidateName · #@Model.InterviewId</title>
    @*
      Same CSS stack as ProctoringSessionEvents.cshtml (_PublicLayout2 head), so fonts / Bootstrap / dashboard
      tokens match the live page. Paths starting with ~/ become absolute via NormalizeHtmlForPdf.
      Theme: default blue-theme (same as layout when session has no Currenttheme).
    *@
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,200" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.1/css/all.css" integrity="sha384-fnmOCqbTlWIlj8LyTjo7mOUStjsKC4pOpQbqyi7RrhN7udi9RwhKkMHpvLbHG9Sr" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Newassets/css/chat.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/now-ui-dashboard.css?v=765432" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&amp;display=swap" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans|300italic,400italic,600italic,700italic,400,300,500,600,700&amp;subset=latin,latin-ext" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=10" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/blue-theme.css" />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />
    @await Html.PartialAsync("~/Views/AIInterview/_ProctoringSessionEventsStyles.cshtml")
</head>
<body class="proctoring-report proctoring-pdf" style="padding-right:0px!important;">
    @await Html.PartialAsync("~/Views/AIInterview/_ProctoringSessionEventsContent.cshtml", Model)
</body>
</html>
