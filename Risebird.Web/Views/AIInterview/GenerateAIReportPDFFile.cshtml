@model Risebird.Entities.ViewModel.AIInterviewReportWrapperClass
@{
    ViewData["Title"] = "AI Interview Report";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<style>
    /* ── Force zero gap from layout ──────────────────── */
    body, .wrapper { margin: 0 !important; padding: 0 !important; background: #f4f6f8 !important; }
    .navbar { display: none !important; }

    /* ── PDF root ────────────────────────────────────── */
    #pdfdownload {
        width: 794px;
        margin: 0 auto;
        background: #ffffff;
        font-family: 'Segoe UI', Arial, sans-serif;
        font-size: 14px;
        color: #1a1a1a;
        line-height: 1.55;
        overflow: visible;
    }

    /* ══ HEADER ══════════════════════════════════════════ */
    .hdr {
        background: linear-gradient(135deg, #0b0b18 0%, #141428 55%, #1c2744 100%);
        padding: 0;
    }
    .hdr-top {
        padding: 18px 28px 12px;
        border-bottom: 1px solid rgba(78,218,146,.2);
        overflow: hidden;
    }
    .hdr-left  { display: inline-block; vertical-align: middle; width: 58%; }
    .hdr-right { display: inline-block; vertical-align: middle; width: 41%; text-align: right; }
    .hdr-title {
        font-size: 19px; font-weight: 700; color: #fff;
        letter-spacing: -.4px;
    }
    .hdr-title i { color: #4eda92; margin-right: 7px; }
    .hdr-sub { font-size: 11.5px; color: #8899aa; margin-top: 2px; }
    .hdr-date { font-size: 11.5px; color: #8899aa; }
    .hdr-date i { color: #4eda92; margin-right: 4px; }
    .hdr-pill {
        display: inline-block;
        background: rgba(78,218,146,.12);
        border: 1px solid rgba(78,218,146,.35);
        color: #4eda92;
        font-size: 10px; font-weight: 700;
        padding: 2px 9px; border-radius: 12px;
        margin-top: 5px; letter-spacing: .6px; text-transform: uppercase;
    }
    /* Candidate row */
    .hdr-cand { padding: 14px 28px 18px; overflow: hidden; }
    .hdr-cl { display: inline-block; vertical-align: top; width: 58%; }
    .hdr-cr { display: inline-block; vertical-align: top; width: 41%; text-align: right; }
    .hdr-name  { font-size: 21px; font-weight: 700; color: #fff; letter-spacing: -.5px; }
    .hdr-email { font-size: 14px; color: #8899aa; margin-top: 3px; }
    .hdr-email i { color: #4eda92; margin-right: 4px; }
    .hdr-lbl { font-size: 10px; font-weight: 600; color: #556; text-transform: uppercase; letter-spacing: .6px; }
    .hdr-val { font-size: 13.5px; color: #dde; margin-top: 2px; }
    .hdr-match {
        display: inline-block;
        background: linear-gradient(135deg, #4eda92, #56e0cb);
        color: #fff; font-size: 12.5px; font-weight: 700;
        padding: 3px 13px; border-radius: 14px; margin-top: 7px;
    }

    /* ══ STATS TABLE ═══════════════════════════════════ */
    .stats-wrap {
        background: #f0faf6;
        border-top: 3px solid #4eda92;
        border-bottom: 1px solid #d4ede3;
        padding: 0;
    }
    .stats-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }
    .stats-cell {
        padding: 8px 10px;
        border-right: 1px solid #d4ede3;
        vertical-align: middle;
        text-align: center;
    }
    .stats-cell:last-child { border-right: none; }
    .stats-icon {
        display: block;
        width: 26px; height: 26px; line-height: 26px;
        background: linear-gradient(135deg, #4eda92, #56e0cb);
        border-radius: 50%;
        color: #fff; font-size: 11px;
        margin: 0 auto 4px;
    }
    .stats-val { font-size: 19px; font-weight: 700; color: #0b0b18; line-height: 1; }
    .stats-val small { font-size: 11px; font-weight: 400; color: #888; }
    .stats-lbl { font-size: 11px; color: #666; font-weight: 600; margin-top: 3px; }

    /* ══ SECTION HEADER ════════════════════════════════ */
    .sec-wrap { padding: 22px 28px 8px; }
    .sec-head {
        font-size: 16px; font-weight: 700;
        color: #0b0b18; text-transform: none;
        letter-spacing: -.2px;
        padding-bottom: 9px;
        border-bottom: 2px solid #4eda92;
        margin-bottom: 16px; overflow: hidden;
    }
    .sec-num {
        display: inline-block;
        width: 22px; height: 22px; line-height: 22px;
        text-align: center;
        background: #4eda92; color: #fff;
        font-size: 11px; font-weight: 700;
        border-radius: 0;
        margin-right: 8px;
        vertical-align: middle; position: relative; top: -1px;
    }

    /* ══ COMM REASONING ════════════════════════════════ */
    .reasoning-box {
        background: #f8fffe; border: 1px solid #cceedd;
        border-left: 4px solid #4eda92;
        border-radius: 6px; padding: 11px 15px;
        margin-bottom: 10px; overflow: hidden;
    }
    .reasoning-title {
        font-size: 11px; font-weight: 700; color: #4eda92;
        text-transform: uppercase; letter-spacing: .5px; margin-bottom: 5px;
    }
    .reasoning-text {
        font-size: 13px; color: #333;
        white-space: pre-line; word-wrap: break-word; overflow-wrap: break-word;
    }

    /* ══ QUESTIONS LIST ════════════════════════════════ */
    .ql-row {
        padding: 10px 0 20px;
        overflow: hidden;
        word-wrap: break-word; overflow-wrap: break-word;
        page-break-inside: avoid;
    }

    /* Question number + text — use table so text wraps cleanly */
    .ql-q-table {outline:none;border:0px;width: 100%; border-collapse: collapse; }
    .ql-q-num-cell {
        width: 32px; vertical-align: top;
        padding-top: 2px;
    }
    .ql-num {
        display: inline-block;
        min-width: 22px; height: 22px; line-height: 22px;
        text-align: center; padding: 0 4px;
        background: #f0f4f8;
        color: #1a1a2e; font-size: 11px; font-weight: 700;
        border-left: 3px solid #4eda92;
        border-radius: 3px;
    }
    .ql-q-text-cell { vertical-align: top; }
    .ql-qtext {
        font-size: 15px; font-weight: 600; color: #111;
        word-wrap: break-word; overflow-wrap: break-word;
        padding-bottom: 6px;
    }

    .ql-meta { padding-left: 26px; margin-top: 5px; overflow: hidden; }

    /* Verdict / Score / Comm pills */
    .ql-pill {
        display: inline-block;
        font-size: 11px; font-weight: 600;
        padding: 2px 9px; border-radius: 11px;
        margin-right: 5px; margin-bottom: 4px;
        vertical-align: middle; white-space: nowrap;
    }
    .pill-select  { background: #e6f9f0; color: #1a7a4a; border: 1px solid #b3e8cf; }
    .pill-reject  { background: #fdecea; color: #b71c1c; border: 1px solid #f5c6c2; }
    .pill-hold    { background: #fff8e1; color: #795500; border: 1px solid #ffd97a; }
    .pill-default { background: #e8f0fe; color: #1a56c4; border: 1px solid #b3c8f8; }
    .pill-score   { background: #e3f2fd; color: #1565c0; border: 1px solid #b3d4f5; }
    .pill-comm    { background: #fce4ec; color: #880e4f; border: 1px solid #f8bbd0; }

    .ql-comment {
        font-size: 14px; color: #555; font-style: italic;
        margin-top: 4px; word-wrap: break-word; overflow-wrap: break-word;
    }
    .ql-comm-comment {
        font-size: 14px; color: #880e4f; font-style: italic;
        margin-top: 3px; word-wrap: break-word; overflow-wrap: break-word;
    }
    .ql-comm-comment i { margin-right: 3px; }

    /* ══ VERDICT BOX ═══════════════════════════════════ */
    .vbox {
        border: 1px solid #cceedd; border-radius: 8px;
        overflow: hidden;
    }
    .vbox-row {
        padding: 11px 16px;
        border-bottom: 1px solid #dff0e8;
        word-wrap: break-word; overflow-wrap: break-word;
        overflow: hidden;
    }
    .vbox-row:last-child { border-bottom: none; }
    .vbox-row:nth-child(odd)  { background: #f8fffe; }
    .vbox-row:nth-child(even) { background: #ffffff; }
    .vbox-key {
        font-size: 10.5px; font-weight: 700; color: #4eda92;
        text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px;
    }
    .vbox-val {
        font-size: 13.5px; color: #222;
        white-space: pre-line; word-wrap: break-word; overflow-wrap: break-word;
    }

    /* ══ Q&A RESPONSES ═════════════════════════════════ */
    .qa-card {
        border: 1px solid #d8eee6; border-radius: 10px;
        margin-bottom: 20px; overflow: hidden;
        page-break-inside: avoid;
        box-shadow: 0 2px 8px rgba(78,218,146,.10);
    }
    .qa-q {
        background: #ffffff;
        padding: 13px 16px 11px;
        overflow: hidden; word-wrap: break-word; overflow-wrap: break-word;
        border-bottom: 2px solid #4eda92;
    }
    .qa-q-inner { width: 100%; border-collapse: collapse; }
    .qa-q-num-cell { width: 32px; vertical-align: top; padding-top: 2px; }
    .qa-qnum {
        display: inline-block;
        min-width: 22px; height: 22px; line-height: 22px;
        text-align: center; padding: 0 4px;
        background: #f0f4f8;
        color: #1a1a2e; font-size: 11px; font-weight: 700;
        border-left: 3px solid #4eda92;
        border-radius: 3px;
    }
    .qa-qtext {
        font-size: 14px; font-weight: 400; color: #0b1f2e;
        word-wrap: break-word; overflow-wrap: break-word; line-height: 1.6;
        letter-spacing: .1px;
    }
    .qa-ans { padding: 13px 16px; background: #fafffe; overflow: hidden; }
    .qa-ans-lbl {
        font-size: 10.5px; font-weight: 700; color: #4eda92;
        text-transform: uppercase; letter-spacing: .5px;
        border-left: 3px solid #4eda92; padding-left: 7px;
        margin-bottom: 8px;
    }
    .qa-ans-text {
        font-size: 14px; color: #333; line-height: 1.75;
        white-space: pre-line; word-wrap: break-word; overflow-wrap: break-word;
        background: #f7f9fb; border-radius: 6px; padding: 11px 14px;
        border: 1px solid #e8f4ee;
    }

    /* ══ FOOTER ════════════════════════════════════════ */
    .pdf-footer {
        background: #f4f6f8; border-top: 1px solid #dde;
        padding: 9px 28px; overflow: hidden;
    }
    .pdf-footer-l {
        display: inline-block; vertical-align: middle;
        width: 58%; font-size: 10.5px; color: #999;
    }
    .pdf-footer-r {
        display: inline-block; vertical-align: middle;
        width: 41%; text-align: right;
        font-size: 10.5px; color: #999;
    }

    /* ══ KILL ALL BOOTSTRAP TABLE BORDERS ════════════ */
    #pdfdownload .ql-q-table,
    #pdfdownload .ql-q-table tr,
    #pdfdownload .ql-q-table td,
    #pdfdownload .qa-q-inner,
    #pdfdownload .qa-q-inner tr,
    #pdfdownload .qa-q-inner td {
        border: none !important;
        border-top: none !important;
        border-bottom: none !important;
        border-left: none !important;
        border-right: none !important;
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
    }

    /* ══ TYPING SPEED ══════════════════════════════════ */
    .ts-card {
        border: 1px solid #cceedd; border-radius: 10px;
        margin-bottom: 20px; overflow: hidden;
        page-break-inside: avoid;
        box-shadow: 0 2px 8px rgba(78,218,146,.10);
    }
    .ts-card-head {
        background: linear-gradient(135deg, #0b0b18 0%, #141428 60%, #1a3040 100%);
        padding: 11px 16px; overflow: hidden;
    }
    .ts-card-title {
        font-size: 13px; font-weight: 600; color: #fff;
        display: inline-block; vertical-align: middle; width: 72%;
        word-wrap: break-word; overflow-wrap: break-word;
    }
    .ts-card-badge {
        display: inline-block; vertical-align: middle;
        font-size: 11px; font-weight: 700;
        padding: 3px 11px; border-radius: 12px;
        float: right; margin-top: 1px;
    }
    .ts-badge-pass { background: linear-gradient(135deg,#1a7a4a,#27ae72); color: #fff; }
    .ts-badge-fail { background: linear-gradient(135deg,#b71c1c,#e53935); color: #fff; }
    .ts-stats-row {
        background: #f0faf6; border-bottom: 2px solid #d4ede3;
        overflow: hidden; padding: 0;
    }
    .ts-stats-tbl { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .ts-stat-cell {
        padding: 12px 10px; border-right: 1px solid #d4ede3;
        text-align: center; vertical-align: middle;
    }
    .ts-stat-cell:last-child { border-right: none; }
    .ts-stat-icon {
        display: block; width: 30px; height: 30px; line-height: 30px;
        background: linear-gradient(135deg, #4eda92, #56e0cb);
        border-radius: 50%; color: #fff; font-size: 12px;
        margin: 0 auto 5px;
    }
    .ts-stat-val { font-size: 20px; font-weight: 700; color: #0b0b18; line-height: 1; }
    .ts-stat-val small { font-size: 11px; font-weight: 400; color: #888; }
    .ts-stat-lbl { font-size: 11px; color: #666; font-weight: 600; margin-top: 4px; }
    .ts-body { padding: 14px 16px; background: #fff; }
    /* text boxes */
    .ts-text-box {
        background: #f7f9fb; border-radius: 6px;
        padding: 10px 14px; margin-bottom: 12px;
        border-left: 4px solid #4eda92;
    }
    .ts-text-box-typed { border-left-color: #17a2b8; background: #f4fbff; }
    .ts-text-lbl {
        font-size: 10.5px; font-weight: 700; color: #1a1a1a;
        text-transform: uppercase; letter-spacing: .6px; margin-bottom: 6px;
        display: flex; align-items: center; gap: 5px;
    }
    .ts-text-lbl-typed { color: #1a1a1a; }
    .ts-text-val {
        font-size: 13px; color: #333; line-height: 1.65;
        white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word;
    }
    /* grade row */
    .ts-grade-row {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 12px;
    }
    .ts-grade-badge {
        display: inline-block; padding: 5px 16px; border-radius: 20px;
        font-size: 13px; font-weight: 700; letter-spacing: .3px;
        border: 2px solid transparent;
    }
    .ts-grade-excellent { background: #e6f9f0; color: #1a7a4a; border-color: #4eda92; }
    .ts-grade-good      { background: #fff8e1; color: #795500; border-color: #ffc107; }
    .ts-grade-poor      { background: #fdecea; color: #b71c1c; border-color: #ef9a9a; }
    /* metrics table */
    .ts-metrics-tbl { width: 100%; border-collapse: collapse; margin-bottom: 12px; border-radius: 6px; overflow: hidden; }
    .ts-metrics-tbl tr:first-child td { border-top: none; }
    .ts-metrics-tbl td { padding: 7px 12px; font-size: 13px; border: 1px solid #c8eef5; }
    .ts-metrics-tbl td:first-child { width: 160px; font-weight: 700; background: #f4fbff; color: #1a1a1a; font-size: 10.5px; text-transform: uppercase; letter-spacing: .4px; }
    .ts-metrics-tbl tr:nth-child(even) td:last-child { background: #f9fdff; }
    /* error breakdown table */
    .ts-err-tbl { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    .ts-err-tbl td {
        text-align: center; vertical-align: middle;
        border: 1px solid #c8eef5; padding: 8px 6px;
        background: #fff;
    }
    .ts-err-tbl tr.err-val-row  td { font-size: 24px; font-weight: 700; line-height: 1; padding-bottom: 4px; border-bottom: none; }
    .ts-err-tbl tr.err-lbl-row  td { border-top: none; padding-top: 3px; font-size: 10.5px; font-weight: 600; color: #1a1a1a; background: #f4fbff; text-transform: uppercase; letter-spacing: .3px; }
    /* comment boxes */
    .ts-comment-box {
        background: #f4fbff; border: 1px solid #c8eef5;
        border-left: 4px solid #17a2b8; border-radius: 6px;
        padding: 10px 14px; margin-bottom: 10px;
    }
    .ts-comment-lbl {
        font-size: 10.5px; font-weight: 700; color: #1a1a1a;
        text-transform: uppercase; letter-spacing: .5px; margin-bottom: 5px;
    }
    .ts-comment-text { font-size: 13px; color: #333; line-height: 1.6; }
    /* tips */
    .ts-tips-box {
        background: linear-gradient(135deg, #e8f4fd 0%, #edf8ff 100%);
        border: 1px solid #b3d8f0; border-left: 4px solid #17a2b8;
        border-radius: 6px; padding: 11px 14px;
    }
    .ts-tips-lbl {
        font-size: 10.5px; font-weight: 700; color: #0c7bb3;
        text-transform: uppercase; letter-spacing: .5px; margin-bottom: 7px;
    }
    .ts-tips-list { margin: 0; padding-left: 18px; font-size: 12.5px; color: #0c5460; line-height: 1.75; }

    /* ══ PAGE BREAK ════════════════════════════════════ */
    .pb { page-break-before: always; }
    .pb-pad { padding-top: 18px; }
</style>

<div id="main-panel" style="display:none;">
<div id="pdfdownload">

    <!-- ══════════════════ HEADER ══════════════════════ -->
    <div class="hdr">
        <div class="hdr-top">
            <div class="hdr-left">
                <div class="hdr-title"><i class="fa fa-bolt"></i>AI Interview Report</div>
                <div class="hdr-sub">Comprehensive candidate evaluation — powered by Risebird AI</div>
            </div><!--
            --><div class="hdr-right">
                <div class="hdr-date"><i class="fa fa-calendar"></i>@DateTime.Now.ToString("MMMM dd, yyyy")</div>
                <div><span class="hdr-pill"><i class="fa fa-lock" style="margin-right:3px;"></i>Confidential</span></div>
            </div>
        </div>
        <div class="hdr-cand">
            <div class="hdr-cl">
                <div class="hdr-name">@(Model.CandidateName ?? "—")</div>
                @if (!string.IsNullOrEmpty(Model.CandidateEmail))
                {
                    <div class="hdr-email"><i class="fa fa-envelope"></i>@Model.CandidateEmail</div>
                }
            </div><!--
            --><div class="hdr-cr">
                <div class="hdr-lbl">Interview Date</div>
                <div class="hdr-val">@(Model.InterviewDate != default(DateTime) ? Model.InterviewDate.ToString("dd MMM yyyy") : "—")</div>
                @if (Model.MatchScorePercentage > 0)
                {
                    <div><span class="hdr-match"><i class="fa fa-check-circle" style="margin-right:4px;"></i>@Model.MatchScorePercentage% Match Score</span></div>
                }
            </div>
        </div>
    </div>

    <!-- ══════════════════ STATS ═══════════════════════ -->
    <div class="stats-wrap">
        <table class="stats-table">
            <tr>
                <td class="stats-cell">
                    <span class="stats-icon"><i class="fa fa-list-ol"></i></span>
                    <div class="stats-val">@(Model.videoQuestionDetails?.Count ?? 0)</div>
                    <div class="stats-lbl">Total Questions</div>
                </td>
                <td class="stats-cell">
                    <span class="stats-icon"><i class="fa fa-video-camera"></i></span>
                    <div class="stats-val">@(Model.videoQuestionDetails?.Count ?? 0)</div>
                    <div class="stats-lbl">Video Responses</div>
                </td>
                <td class="stats-cell">
                    <span class="stats-icon"><i class="fa fa-code"></i></span>
                    @if (Model.AIInterviewEvaluation != null && Model.AIInterviewEvaluation.OverallTechnicalScore != 0)
                    {
                        <div class="stats-val">@Model.AIInterviewEvaluation.OverallTechnicalScore <small>/ 10</small></div>
                    }
                    else
                    {
                        <div class="stats-val" style="color:#bbb;">—</div>
                    }
                    <div class="stats-lbl">Technical Score</div>
                </td>
                <td class="stats-cell">
                    <span class="stats-icon"><i class="fa fa-comments"></i></span>
                    @if (Model.AIInterviewEvaluation != null && Model.AIInterviewEvaluation.OverallCommunicationScore != 0)
                    {
                        <div class="stats-val">@Model.AIInterviewEvaluation.OverallCommunicationScore <small>/ 10</small></div>
                    }
                    else
                    {
                        <div class="stats-val" style="color:#bbb;">—</div>
                    }
                    <div class="stats-lbl">Communication Score</div>
                </td>
            </tr>
        </table>
    </div>

    @if (Model.AIInterviewEvaluation != null)
    {
        <!-- ══ SECTION 1 — EVALUATION SUMMARY ═══════════ -->
        @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning))
        {
            <div class="sec-wrap" style="padding-bottom:12px;">
                <div class="sec-head"><span class="sec-num">1</span>Evaluation Summary</div>
                <div class="reasoning-box">
                    <div class="reasoning-title"><i class="fa fa-microphone" style="margin-right:5px;"></i>Overall Communication Analysis</div>
                    <div class="reasoning-text">@Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning</div>
                </div>
            </div>
        }

        <!-- ══ SECTION 2 — QUESTIONS DISCUSSED ══════════ -->
        @if (Model.AIInterviewEvaluation.QuestionRatings != null && Model.AIInterviewEvaluation.QuestionRatings.Any())
        {
            int qdSecNum = !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning) ? 2 : 1;
            <div class="sec-wrap" style="padding-bottom:12px;">
                <div class="sec-head"><span class="sec-num">@qdSecNum</span>Questions Discussed</div>
                @{int qIdx = 1;}
                @foreach (var q in Model.AIInterviewEvaluation.QuestionRatings)
                {
                    <div class="ql-row">
                        <table class="ql-q-table" border="0" cellpadding="0" cellspacing="0" style="border:none!important;background:transparent!important;"><tr style="border:none!important;">
                            <td class="ql-q-num-cell" style="border:none!important;background:transparent!important;"><span class="ql-num">@qIdx</span></td>
                            <td class="ql-q-text-cell" style="border:none!important;background:transparent!important;"><div class="ql-qtext">@(q.Question ?? "—")</div></td>
                        </tr></table>
                        @if (!string.IsNullOrWhiteSpace(q.Verdict) || q.Score != 0 || q.CommunicationScore != 0 || !string.IsNullOrWhiteSpace(q.Comment) || !string.IsNullOrWhiteSpace(q.CommunicationComment))
                        {
                            <div class="ql-meta">
                                @if (!string.IsNullOrWhiteSpace(q.Verdict))
                                {
                                    string verdictLower = q.Verdict.ToLower();
                                    string pillClass = verdictLower.Contains("select") ? "pill-select" :
                                                       verdictLower.Contains("reject") ? "pill-reject" :
                                                       verdictLower.Contains("hold")   ? "pill-hold"   : "pill-default";
                                    <span class="ql-pill @pillClass">
                                        <i class="fa @(verdictLower.Contains("select") ? "fa-check" : verdictLower.Contains("reject") ? "fa-times" : "fa-circle")" style="margin-right:3px;"></i>@q.Verdict
                                    </span>
                                }
                                @if (q.Score != 0)
                                {
                                    <span class="ql-pill pill-score"><i class="fa fa-star-o" style="margin-right:3px;"></i>Score: @q.Score / 10</span>
                                }
                                @if (q.CommunicationScore != 0)
                                {
                                    <span class="ql-pill pill-comm"><i class="fa fa-comments" style="margin-right:3px;"></i>Communication Score: @q.CommunicationScore / 10</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(q.Comment))
                                {
                                    <div class="ql-comment"><i class="fa fa-comment-o" style="margin-right:4px;color:#4eda92;"></i>@q.Comment</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(q.CommunicationComment))
                                {
                                        <div class="ql-comm-comment"><i class="fa fa-comments"></i><b style="font-size:14px;">Communication comment : </b>@q.CommunicationComment</div>
                                }
                            </div>
                        }
                    </div>
                    qIdx++;
                }
            </div>
        }

        <!-- ══ SECTION 3 — AI ASSESSMENT ════════════════ -->
        @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict) || !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment))
        {
            int asSecNum = 1;
            if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning)) asSecNum++;
            if (Model.AIInterviewEvaluation.QuestionRatings != null && Model.AIInterviewEvaluation.QuestionRatings.Any()) asSecNum++;
            <div class="sec-wrap" style="padding-bottom:16px;">
                <div class="sec-head"><span class="sec-num">@asSecNum</span>AI Interviewer Assessment</div>
                <div class="vbox">
                    @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict))
                    {
                        <div class="vbox-row">
                            <div class="vbox-key"><i class="fa fa-gavel" style="margin-right:5px;"></i>Final Verdict</div>
                            <div class="vbox-val">@Model.AIInterviewEvaluation.FinalVerdict</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment))
                    {
                        <div class="vbox-row">
                            <div class="vbox-key"><i class="fa fa-comment" style="margin-right:5px;"></i>Final Comment</div>
                            <div class="vbox-val">@Model.AIInterviewEvaluation.FinalComment</div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- ══════════════════ TYPING SPEED ASSESSMENT ════ -->
    @{
        int tsSecNum = 1;
        if (Model.AIInterviewEvaluation != null)
        {
            if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning)) tsSecNum++;
            if (Model.AIInterviewEvaluation.QuestionRatings != null && Model.AIInterviewEvaluation.QuestionRatings.Any()) tsSecNum++;
            if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict) || !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment)) tsSecNum++;
        }
        bool hasTypingData = Model.TypingSpeedAssessments != null && Model.TypingSpeedAssessments.Any();
    }
    <div class="sec-wrap" style="padding-bottom:16px;">
        <div class="sec-head"><span class="sec-num">@tsSecNum</span><i class="fa fa-keyboard-o" style="margin-right:7px;"></i>Typing Speed Assessment</div>
        @if (hasTypingData)
        {
            @foreach (var tsa in Model.TypingSpeedAssessments)
            {
                Risebird.Entities.ViewModel.TypingAssessmentOpenAIResponse tsAnalysis = null;
                if (!string.IsNullOrEmpty(tsa.OpenAIAnalysisJson))
                {
                    try { tsAnalysis = Newtonsoft.Json.JsonConvert.DeserializeObject<Risebird.Entities.ViewModel.TypingAssessmentOpenAIResponse>(tsa.OpenAIAnalysisJson); } catch { }
                }
                string gradeClass = "ts-grade-poor";
                if (tsAnalysis?.scores?.overall_grade != null)
                {
                    var g = tsAnalysis.scores.overall_grade;
                    gradeClass = (g == "Excellent" || g == "Very Good") ? "ts-grade-excellent" : g == "Good" ? "ts-grade-good" : "ts-grade-poor";
                }
                <div class="ts-card">
                    <!-- Card header: question title + pass/fail -->
                    <div class="ts-card-head">
                        <span class="ts-card-title"><i class="fa fa-keyboard-o" style="margin-right:5px;color:#4eda92;"></i>@(tsa.QuestionText ?? "Typing Speed Assessment")</span>
                        @if (tsa.IsPassed == true)
                        {
                            <span class="ts-card-badge ts-badge-pass"><i class="fa fa-check" style="margin-right:3px;"></i>Passed</span>
                        }
                        else if (tsa.IsPassed == false)
                        {
                            <span class="ts-card-badge ts-badge-fail"><i class="fa fa-times" style="margin-right:3px;"></i>Not Passed</span>
                        }
                    </div>

                    <!-- Key stats row -->
                    <div class="ts-stats-row">
                        <table class="ts-stats-tbl">
                            <tr>
                                <td class="ts-stat-cell">
                                    <span class="ts-stat-icon"><i class="fa fa-tachometer"></i></span>
                                    <div class="ts-stat-val">@tsa.WordsPerMinute.ToString("N1") <small>WPM</small></div>
                                    <div class="ts-stat-lbl">Words / Min</div>
                                </td>
                                <td class="ts-stat-cell">
                                    <span class="ts-stat-icon" style="background:@(tsa.AccuracyPercentage >= tsa.PassingAccuracyPercentage ? "linear-gradient(135deg,#1a7a4a,#27ae72)" : "linear-gradient(135deg,#b71c1c,#e53935)");"><i class="fa fa-bullseye"></i></span>
                                    <div class="ts-stat-val" style="color:@(tsa.AccuracyPercentage >= tsa.PassingAccuracyPercentage ? "#1a7a4a" : "#b71c1c");">
                                        @tsa.AccuracyPercentage.ToString("N1") <small>%</small>
                                    </div>
                                    <div class="ts-stat-lbl">Char Accuracy</div>
                                </td>
                                <td class="ts-stat-cell">
                                    <span class="ts-stat-icon"><i class="fa fa-clock-o"></i></span>
                                    <div class="ts-stat-val">@tsa.TimeTakenInSeconds.ToString("N0") <small>s</small></div>
                                    <div class="ts-stat-lbl">Time Taken</div>
                                </td>
                                <td class="ts-stat-cell">
                                    <span class="ts-stat-icon"><i class="fa fa-font"></i></span>
                                    <div class="ts-stat-val">@tsa.CorrectCharacters <small>/ @tsa.TotalCharacters</small></div>
                                    <div class="ts-stat-lbl">Correct Chars</div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Body -->
                    <div class="ts-body">

                        <!-- Sample Text -->
                        @if (!string.IsNullOrWhiteSpace(tsa.SampleText))
                        {
                            <div class="ts-text-box">
                                <div class="ts-text-lbl"><i class="fa fa-file-text-o"></i> Sample Text</div>
                                <div class="ts-text-val">@tsa.SampleText</div>
                            </div>
                        }

                        <!-- Candidate Typed -->
                        @if (!string.IsNullOrWhiteSpace(tsa.TypedText))
                        {
                            <div class="ts-text-box ts-text-box-typed">
                                <div class="ts-text-lbl ts-text-lbl-typed"><i class="fa fa-keyboard-o"></i> Candidate Typed</div>
                                <div class="ts-text-val">@tsa.TypedText</div>
                            </div>
                        }

                        @if (tsAnalysis != null && tsAnalysis.scores != null)
                        {
                            <!-- Grade badge -->
                            <div style="margin-bottom:12px;">
                                <span class="ts-grade-badge @gradeClass">
                                    <i class="fa fa-certificate" style="margin-right:5px;"></i>Grade: @tsAnalysis.scores.overall_grade
                                </span>
                            </div>

                            <!-- Accuracy metrics -->
                            <table class="ts-metrics-tbl">
                                <tr>
                                    <td><i class="fa fa-check-circle" style="margin-right:4px;"></i>Word Accuracy</td>
                                    <td>
                                        <strong style="font-size:15px;color:@(tsAnalysis.scores.word_level_accuracy_percent >= 97 ? "#1a7a4a" : "#b71c1c");">@tsAnalysis.scores.word_level_accuracy_percent.ToString("N1")%</strong>
                                        <span style="margin-left:8px;color:#aaa;font-size:11px;">(Required: 97%)</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-font" style="margin-right:4px;"></i>Character Accuracy</td>
                                    <td><strong style="font-size:15px;">@tsAnalysis.scores.character_level_accuracy_percent.ToString("N1")%</strong></td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-clock-o" style="margin-right:4px;"></i>Time Taken</td>
                                    <td><strong>@tsa.TimeTakenInSeconds.ToString("N1")</strong> seconds <span style="color:#aaa;font-size:11px;">(Max: 120s)</span></td>
                                </tr>
                            </table>

                            @if (tsAnalysis.counts != null)
                            {
                                <!-- Error breakdown -->
                                <div style="font-size:10.5px;font-weight:700;color:#1a1a1a;background:#f4fbff;display:inline-block;padding:3px 10px;border-radius:4px;border:1px solid #c8eef5;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">
                                    <i class="fa fa-bar-chart" style="margin-right:5px;"></i>Error Breakdown
                                </div>
                                <table class="ts-err-tbl">
                                    <tr class="err-val-row">
                                        <td style="color:#1a7a4a; border-top:3px solid #4eda92;">@tsAnalysis.counts.correct_words</td>
                                        <td style="color:#b71c1c; border-top:3px solid #e53935;">@tsAnalysis.counts.incorrect_words</td>
                                        <td style="color:#b71c1c; border-top:3px solid #e53935;">@tsAnalysis.counts.missing_words</td>
                                        <td style="color:#e65100; border-top:3px solid #ff7043;">@tsAnalysis.counts.spelling_errors</td>
                                        <td style="color:#795500; border-top:3px solid #ffc107;">@tsAnalysis.counts.capitalization_errors</td>
                                        <td style="color:#795500; border-top:3px solid #ffc107;">@tsAnalysis.counts.punctuation_errors</td>
                                    </tr>
                                    <tr class="err-lbl-row">
                                        <td style="background:#f0faf6;">Correct</td>
                                        <td style="background:#fff5f5;">Incorrect</td>
                                        <td style="background:#fff5f5;">Missing</td>
                                        <td style="background:#fff8f5;">Spelling</td>
                                        <td style="background:#fffde7;">Capitals</td>
                                        <td style="background:#fffde7;">Punctuation</td>
                                    </tr>
                                </table>
                            }

                            @if (tsAnalysis.verdict != null)
                            {
                                @if (!string.IsNullOrEmpty(tsAnalysis.verdict.speed_comment))
                                {
                                    <div class="ts-comment-box">
                                        <div class="ts-comment-lbl"><i class="fa fa-tachometer" style="margin-right:5px;"></i>Speed</div>
                                        <div class="ts-comment-text">@tsAnalysis.verdict.speed_comment</div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(tsAnalysis.verdict.accuracy_comment))
                                {
                                    <div class="ts-comment-box">
                                        <div class="ts-comment-lbl"><i class="fa fa-bullseye" style="margin-right:5px;"></i>Accuracy</div>
                                        <div class="ts-comment-text">@tsAnalysis.verdict.accuracy_comment</div>
                                    </div>
                                }
                                @if (tsAnalysis.verdict.actionable_tips != null && tsAnalysis.verdict.actionable_tips.Any())
                                {
                                    <div class="ts-tips-box">
                                        <div class="ts-tips-lbl"><i class="fa fa-lightbulb-o" style="margin-right:5px;"></i>Tips for Improvement</div>
                                        <ul class="ts-tips-list">
                                            @foreach (var tip in tsAnalysis.verdict.actionable_tips)
                                            {
                                                <li>@tip</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <!-- Fallback: basic metrics when no AI analysis -->
                            <table class="ts-metrics-tbl">
                                <tr>
                                    <td><i class="fa fa-tachometer" style="margin-right:4px;"></i>Words / Min</td>
                                    <td><strong>@tsa.WordsPerMinute.ToString("N1")</strong> <span style="color:#888;font-size:11px;">(Required: @tsa.PassingWPM WPM)</span></td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-check-circle" style="margin-right:4px;"></i>Accuracy</td>
                                    <td><strong style="color:@(tsa.AccuracyPercentage >= tsa.PassingAccuracyPercentage ? "#1a7a4a" : "#b71c1c");">@tsa.AccuracyPercentage.ToString("N1")%</strong> <span style="color:#888;font-size:11px;">(Required: @tsa.PassingAccuracyPercentage%)</span></td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-clock-o" style="margin-right:4px;"></i>Time Taken</td>
                                    <td><strong>@tsa.TimeTakenInSeconds.ToString("N1")</strong> seconds</td>
                                </tr>
                                <tr>
                                    <td><i class="fa fa-font" style="margin-right:4px;"></i>Characters</td>
                                    <td>@tsa.CorrectCharacters correct / @tsa.TotalCharacters total</td>
                                </tr>
                            </table>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div style="padding:18px 15px;text-align:center;color:#aaa;font-size:13px;border:1px dashed #d4ede3;border-radius:6px;background:#f8fffe;">
                <i class="fa fa-keyboard-o" style="font-size:22px;margin-bottom:8px;display:block;color:#cde;"></i>
                No typing speed assessment was recorded for this interview.
            </div>
        }
    </div>

    <!-- ══════════════════ Q&A RESPONSES ═══════════════ -->
    @if (Model.videoQuestionDetails != null && Model.videoQuestionDetails.Any())
    {
        int qaSecNum = 1;
        if (Model.AIInterviewEvaluation != null)
        {
            if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning)) qaSecNum++;
            if (Model.AIInterviewEvaluation.QuestionRatings != null && Model.AIInterviewEvaluation.QuestionRatings.Any()) qaSecNum++;
            if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict) || !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment)) qaSecNum++;
        }
        if (Model.TypingSpeedAssessments != null && Model.TypingSpeedAssessments.Any()) qaSecNum++;
        <div class="pb pb-pad"></div>
        <div class="sec-wrap" style="padding-bottom:16px;">
            <div class="sec-head">
                <span class="sec-num">@qaSecNum</span><i class="fa fa-video-camera" style="margin-right:7px;"></i>Video Responses
            </div>
            <div style="font-size:14px;color:#1a1a2e;font-weight:400;margin-bottom:14px;padding-left:2px;">
                <i class="fa fa-comments" style="margin-right:7px;color:#4eda92;font-size:14px;"></i>Question &amp; Answer Responses
            </div>
            @{int qNum = 1;}
            @foreach (var vd in Model.videoQuestionDetails)
            {
                <div class="qa-card">
                    <div class="qa-q">
                        <table class="qa-q-inner" border="0" cellpadding="0" cellspacing="0" style="border:none!important;background:transparent!important;"><tr style="border:none!important;">
                            <td class="qa-q-num-cell" style="border:none!important;background:transparent!important;"><span class="qa-qnum">@qNum</span></td>
                            <td style="border:none!important;background:transparent!important;"><div class="qa-qtext">@(vd.question ?? "Question not available")</div></td>
                        </tr></table>
                    </div>
                    <div class="qa-ans">
                        <div class="qa-ans-lbl">Candidate Answer</div>
                        @{
                            var ans = (vd.CandidateAnswer ?? "Answer not available")
                                .Replace("\\r\\n", "\n").Replace("\\n", "\n").Replace("\\r", "\n").Trim();
                        }
                        <div class="qa-ans-text">@ans</div>
                    </div>
                </div>
                qNum++;
            }
        </div>
    }


</div><!-- #pdfdownload -->
</div><!-- #main-panel -->

<input type="hidden" id="CandidateName" value="@Html.Raw(Model.CandidateName ?? "")" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.min.js"></script>
<script>
    document.getElementById('main-panel').style.display = 'block';

    window.onload = function () { getPDF(); };

    function getPDF() {
        var d    = new Date();
        var name = document.getElementById('CandidateName').value || 'AIInterviewReport';
        var fn   = name + '_AIReport_' + d.getDate() + '_' + (d.getMonth()+1) + '_' + d.getFullYear() + '.pdf';
        var el   = document.getElementById('pdfdownload');

        html2pdf()
            .from(el)
            .set({
                margin:      [0, 0, 0, 0],
                filename:    fn,
                image:       { type: 'jpeg', quality: 0.97 },
                html2canvas: {
                    scale:           2,
                    useCORS:         true,
                    allowTaint:      true,
                    logging:         false,
                    letterRendering: true,
                    width:           794
                },
                jsPDF:     { unit: 'mm', format: 'a4', orientation: 'p' },
                pagebreak: { mode: 'css', avoid: ['.qa-card', '.ql-row', '.vbox-row'] }
            })
            .save();

        setTimeout(function () { window.close(); }, 9000);
    }
</script>
