        font-size: 13px;
        color: var(--muted);
        text-align: right;
        line-height: 1.5
    }

        .meta-id b {
            color: var(--ink);
            font-weight: 600
        }

        .meta-id .mono {
            color: var(--ink-2)
        }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 36px;
        padding: 0 14px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
        font: 500 13px/1 'Inter',sans-serif;
        cursor: pointer;
        transition: all .15s;
    }

        .btn:hover {
            border-color: #cbd5e1;
            background: #f8fafc
        }

    .btn-primary {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff
    }

        .btn-primary:hover {
            background: var(--brand-ink);
            border-color: var(--brand-ink)
        }

    /* ---------- page layout ---------- */
    .page {
        max-width: 1440px;
        margin: 0 auto;
        padding: 32px
    }

    .row {
        display: grid;
        gap: 20px
    }

    /* ---------- header / verdict ---------- */
    .hero {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 28px 32px;
        display: grid;
        grid-template-columns: minmax(0,1fr) 300px;
        gap: 32px;
    }

    @@media (max-width: 1100px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 24px
        }

        .session-grid {
            grid-template-columns: repeat(2,1fr) !important;
            gap: 16px !important
        }

            .session-grid > div {
                border-right: none !important;
                padding-right: 0 !important
            }

        .kpis {
            grid-template-columns: repeat(2,1fr) !important
        }

        .two-col {
            grid-template-columns: 1fr !important
        }

        .page {
            padding: 20px !important
        }

        .incident {
            grid-template-columns: 72px 26px minmax(0,1fr) auto auto 20px !important;
            gap: 10px !important
        }

            .incident .title {
                white-space: normal !important
            }
    }

    .hero-l {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0
    }

    .candidate {
        display: flex;
        align-items: center;
        gap: 16px
    }

    .avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg,#dbe5ff,#c7d4ff);
        display: grid;
        place-items: center;
        color: var(--brand-ink);
        font-weight: 700;
        font-size: 20px;
        border: 1px solid #c7d4ff;
    }

    .candidate h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: var(--ink)
    }

    .candidate .sub {
        margin-top: 3px;
        font-size: 13px;
        color: var(--muted)
    }

        .candidate .sub .dot {
            margin: 0 8px;
            color: var(--muted-2)
        }

    .session-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 0;
        border-top: 1px solid var(--line);
        padding-top: 18px
    }

        .session-grid > div {
            padding-right: 16px;
            border-right: 1px solid var(--line-2)
        }

            .session-grid > div:last-child {
                border-right: none;
                padding-right: 0
            }

        .session-grid label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--muted);
            font-weight: 600;
            margin-bottom: 6px
        }

        .session-grid .v {
            font-size: 14px;
            color: var(--ink);
            font-weight: 500
        }

            .session-grid .v.mono {
                font-size: 13px
            }

    /* verdict card */
    .verdict {
        min-width: 280px;
        border-radius: 14px;
        padding: 22px 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: linear-gradient(180deg,#fff5f5 0%,#ffe9ea 100%);
        border: 1px solid #fbcfd2;
        color: var(--danger-ink);
    }

        .verdict.med {
            background: linear-gradient(180deg,#fffaf0,#fef3c7);
            border-color: #fcd9a4;
            color: var(--warn-ink)
        }

        .verdict.low {
            background: linear-gradient(180deg,#f3fdf6,#dcfce7);
            border-color: #bbf0c8;
            color: var(--ok-ink)
        }

    .verdict-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 700;
        opacity: .85
    }

    .verdict-row {
        display: flex;
        align-items: baseline;
        gap: 14px
    }

    .verdict-level {
        font-size: 36px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -.02em
    }

    .verdict-score {
        font-size: 14px;
        font-weight: 600;
        opacity: .8
    }

    .verdict-bar {
        height: 6px;
        border-radius: 99px;
        background: rgba(0,0,0,.08);
        overflow: hidden;
        position: relative
    }

        .verdict-bar > span {
            display: block;
            height: 100%;
            background: currentColor;
            border-radius: 99px
        }

    .verdict-summary {
        font-size: 13px;
        line-height: 1.5;
        color: var(--danger-ink);
        opacity: .9
    }

    .verdict.med .verdict-summary {
        color: var(--warn-ink)
    }

    .verdict.low .verdict-summary {
        color: var(--ok-ink)
    }

    /* ---------- KPI strip ---------- */
    .kpis {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 16px;
        margin-top: 20px
    }

    .kpi {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

        .kpi label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--muted);
            font-weight: 600
        }

        .kpi .no {
            font-size: 28px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -.02em;
            line-height: 1.1
        }

            .kpi .no small {
                font-size: 14px;
                font-weight: 500;
                color: var(--muted);
                margin-left: 4px
            }

        .kpi .delta {
            font-size: 12px;
            color: var(--muted)
        }

            .kpi .delta.bad {
                color: var(--danger)
            }

            .kpi .delta.warn {
                color: var(--warn)
            }

    /* ---------- section card ---------- */
    .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 24px
    }

        .card h2 {
            margin: 0 0 4px;
            font-size: 16px;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -.01em
        }

        .card .desc {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 18px
        }

    .card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 18px
    }

        .card-head h2 {
            margin: 0
        }

        .card-head .desc {
            margin: 4px 0 0
        }

    /* ---------- two-col ---------- */
    .two-col {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 20px;
        margin-top: 20px
    }

    /* ---------- violations breakdown ---------- */
    .breakdown {
        display: flex;
        flex-direction: column;
        gap: 14px
    }

    .br-row {
        display: grid;
        grid-template-columns: 28px minmax(0,1fr) auto;
        align-items: center;
        gap: 14px
    }

        .br-row .ic {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            background: var(--info-soft);
            color: var(--info-ink);
        }

        .br-row.high .ic {
            background: var(--danger-soft);
            color: var(--danger)
        }

        .br-row.med .ic {
            background: var(--warn-soft);
            color: var(--warn)
        }

        .br-row.low .ic {
            background: var(--brand-soft);
            color: var(--brand)
        }

        .br-row .body {
            min-width: 0
        }

        .br-row .name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 6px
        }

            .br-row .name .freq {
                color: var(--muted);
                font-weight: 500;
                font-size: 12px
            }

    .br-bar {
        height: 6px;
        background: var(--line-2);
        border-radius: 99px;
        overflow: hidden;
        position: relative
    }

        .br-bar > span {
            display: block;
            height: 100%;
            border-radius: 99px;
            background: var(--muted-2)
        }

    .br-row.high .br-bar > span {
        background: var(--danger)
    }

    .br-row.med .br-bar > span {
        background: var(--warn)
    }

    .br-row.low .br-bar > span {
        background: var(--brand)
    }

    .br-row .count {
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        font-size: 14px;
        color: var(--ink)
    }

    /* ---------- timeline ---------- */
    .timeline-wrap {
        position: relative;
        padding: 8px 0 36px
    }

    .timeline-axis {
        position: relative;
        height: 14px;
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        margin-top: 8px
    }

    .timeline-track {
        position: relative;
        height: 88px;
        background: linear-gradient(180deg,#fafbfc,#f1f5f9);
        border: 1px solid var(--line-2);
        border-radius: 10px;
        overflow: hidden;
    }

    .timeline-row {
        position: absolute;
        left: 0;
        right: 0;
        height: 14px;
        display: flex;
        align-items: center
    }

        .timeline-row .lab {
            position: absolute;
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            color: var(--muted);
            background: rgba(255,255,255,.85);
            padding: 1px 6px;
            border-radius: 4px;
            z-index: 2;
        }

    .timeline-tick {
        position: absolute;
        width: 4px;
        height: 10px;
        border-radius: 2px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        transition: transform .1s;
    }

        .timeline-tick:hover {
            transform: translateY(-50%) scaleY(1.6);
            z-index: 3
        }

    .tick-tab {
        background: #dc2626
    }

    .tick-focus {
        background: #ea580c
    }

    .tick-window {
        background: #a855f7
    }

    .tick-browser {
        background: #0891b2
    }

    .tick-copy {
        background: #2563eb
    }

    .tick-right {
        background: #0ea5e9
    }

    .tick-monitor {
        background: #14b8a6
    }

    .tick-face {
        background: #db2777
    }

    .tick-audio {
        background: #f59e0b
    }

    .tick-network {
        background: #65a30d
    }

    .timeline-grid-line {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 1px;
        background: rgba(15,23,42,.05)
    }

    .timeline-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 18px;
        font-size: 12px;
        color: var(--muted)
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: inline-block
    }

    /* ---------- minute heatmap (small) ---------- */
    .heat-wrap {
        margin-top: 8px
    }

    .heat-row {
        display: flex;
        gap: 3px;
        align-items: center
    }

        .heat-row .lbl {
            width: 140px;
            font-size: 12px;
            color: var(--ink-2);
            font-weight: 500
        }

    .heat-cells {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 14px;
        gap: 3px;
        flex: 1
    }

    .heat-cell {
        height: 14px;
        border-radius: 3px;
        background: #f1f5f9
    }

    .heat-0 {
        background: #f1f5f9
    }

    .heat-1 {
        background: #fde2e2
    }

    .heat-2 {
        background: #fbb4b4
    }

    .heat-3 {
        background: #f87171
    }

    .heat-4 {
        background: #dc2626
    }

    .heat-axis {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: var(--muted);
        margin-left: 140px;
        margin-top: 6px;
        font-variant-numeric: tabular-nums
    }

    /* ---------- incidents list ---------- */
    .filters {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap
    }

    .chip {
        height: 30px;
        padding: 0 12px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink-2);
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .chip:hover {
            border-color: #cbd5e1
        }

        .chip.active {
            background: var(--ink);
            border-color: var(--ink);
            color: #fff
        }

        .chip .ct {
            opacity: .6;
            font-variant-numeric: tabular-nums
        }

        .chip.active .ct {
            opacity: .7
        }

    .incidents {
        display: flex;
        flex-direction: column
    }

    .incident {
        border-top: 1px solid var(--line-2);
        display: grid;
        grid-template-columns: 84px 28px minmax(0,1fr) 110px 90px 28px;
        gap: 16px;
        align-items: center;
        padding: 14px 4px;
        cursor: pointer;
    }

        .incident:first-child {
            border-top: none
        }

        .incident:hover {
            background: #f8fafc
        }

        .incident .time {
            font-family: 'JetBrains Mono',monospace;
            font-size: 12px;
            color: var(--muted)
        }

        .incident .icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            background: var(--info-soft);
            color: var(--info-ink);
        }

        .incident.sev-high .icon {
            background: var(--danger-soft);
            color: var(--danger)
        }

        .incident.sev-med .icon {
            background: var(--warn-soft);
            color: var(--warn)
        }

        .incident.sev-low .icon {
            background: var(--brand-soft);
            color: var(--brand)
        }

        .incident .title {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap
        }

            .incident .title .note {
                font-weight: 400;
                color: var(--muted);
                margin-left: 6px;
                font-size: 13px
            }

        .incident .dur {
            font-size: 12px;
            color: var(--muted);
            font-variant-numeric: tabular-nums
        }

    .pill {
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 9px;
        border-radius: 99px;
        font-size: 11px;
        font-weight: 600;
        background: var(--info-soft);
        color: var(--info-ink);
    }

        .pill.high {
            background: var(--danger-soft);
            color: var(--danger-ink)
        }

        .pill.med {
            background: var(--warn-soft);
            color: var(--warn-ink)
        }

        .pill.low {
            background: var(--brand-soft);
            color: var(--brand-ink)
        }

        .pill.ok {
            background: var(--ok-soft);
            color: var(--ok-ink)
        }

    .chev {
        width: 20px;
        height: 20px;
        display: grid;
        place-items: center;
        color: var(--muted-2);
        transition: transform .2s;
    }

    .incident.open .chev {
        transform: rotate(90deg);
        color: var(--ink)
    }

    .incident-detail {
        grid-column: 1/-1;
        padding: 14px 4px 22px 124px;
        display: none;
        color: var(--ink-2);
        font-size: 13px;
        line-height: 1.6;
    }

    .incident.open + .incident-detail {
        display: block
    }

    .incident-detail .ev-grid {
        display: grid;
        grid-template-columns: 130px 1fr;
        gap: 6px 16px;
        margin-top: 6px
    }

        .incident-detail .ev-grid dt {
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-weight: 600
        }

        .incident-detail .ev-grid dd {
            margin: 0;
            color: var(--ink);
            font-size: 13px
        }

    .incident-detail code {
        font-family: 'JetBrains Mono',monospace;
        background: var(--bg);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 12px
    }

    /* ---------- captures ---------- */
    .cap-tabs {
        display: flex;
        gap: 6px;
        background: var(--bg);
        padding: 4px;
        border-radius: 10px;
        width: fit-content
    }

    .cap-tab {
        height: 32px;
        padding: 0 14px;
        border-radius: 8px;
        border: none;
        background: transparent;
        font: 600 13px 'Inter',sans-serif;
        color: var(--muted);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .cap-tab.active {
            background: #fff;
            color: var(--ink);
            box-shadow: 0 1px 2px rgba(15,23,42,.06)
        }

        .cap-tab .ct {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 99px;
            background: var(--info-soft);
            color: var(--info-ink);
            font-size: 11px;
            font-weight: 600;
        }

        .cap-tab.active .ct {
            background: var(--brand-soft);
            color: var(--brand-ink)
        }

    .cap-panel {
        display: none;
        margin-top: 20px
    }

        .cap-panel.active {
            display: block
        }

    .cap-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px
    }

    @@media (max-width: 1100px) {
        .cap-grid {
            grid-template-columns: repeat(2,1fr)
        }
    }

    .cap-card {
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        cursor: pointer;
        transition: transform .12s, box-shadow .12s;
        display: flex;
        flex-direction: column;
    }

        .cap-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -10px rgba(15,23,42,.18)
        }

    .cap-thumb {
        aspect-ratio: 16/10;
        background: #0f172a;
        position: relative;
        overflow: hidden;
        display: grid;
        place-items: center;
        color: #475569;
    }

        .cap-thumb svg.bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%
        }

        .cap-thumb .stamp {
            position: absolute;
            left: 8px;
            top: 8px;
            background: rgba(15,23,42,.7);
            color: #fff;
            font: 600 10px 'JetBrains Mono',monospace;
            padding: 3px 7px;
            border-radius: 4px;
            letter-spacing: .02em;
        }

        .cap-thumb .sev-tag {
            position: absolute;
            right: 8px;
            top: 8px;
            height: 20px;
            padding: 0 8px;
            border-radius: 99px;
            font: 600 10px 'Inter',sans-serif;
            display: inline-flex;
            align-items: center;
        }

            .cap-thumb .sev-tag.high {
                background: #fee2e2;
                color: #991b1b
            }

            .cap-thumb .sev-tag.med {
                background: #fef3c7;
                color: #92400e
            }

            .cap-thumb .sev-tag.low {
                background: #e8edff;
                color: #1d3aba
            }

    .cap-meta {
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 3px
    }

        .cap-meta .ttl {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap
        }

        .cap-meta .sub {
            font-size: 11px;
            color: var(--muted)
        }

    /* video panel */
    .video-wrap {
        background: #0f172a;
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 16/9;
        position: relative;
        background-image: radial-gradient(circle at 30% 40%, rgba(255,255,255,.04), transparent 50%), radial-gradient(circle at 70% 60%, rgba(39,71,214,.15), transparent 50%);
    }

        .video-wrap .placeholder {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #94a3b8;
        }

        .video-wrap .play-btn {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(255,255,255,.1);
            border: 2px solid rgba(255,255,255,.3);
            display: grid;
            place-items: center;
            color: #fff;
            cursor: pointer;
            backdrop-filter: blur(8px);
            transition: all .15s;
        }

            .video-wrap .play-btn:hover {
                background: rgba(255,255,255,.2);
                transform: scale(1.05)
            }

        .video-wrap .label {
            font-size: 13px;
            color: #cbd5e1
        }

            .video-wrap .label b {
                color: #fff;
                font-weight: 600
            }

    .video-controls {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 14px 18px;
        background: linear-gradient(transparent, rgba(15,23,42,.85));
        display: flex;
        align-items: center;
        gap: 14px;
        color: #fff;
    }

    .video-time {
        font: 500 12px 'JetBrains Mono',monospace;
        color: #cbd5e1;
        font-variant-numeric: tabular-nums
    }

    .video-scrub {
        flex: 1;
        height: 6px;
        background: rgba(255,255,255,.15);
        border-radius: 99px;
        position: relative;
        cursor: pointer;
    }

        .video-scrub > .progress {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 34%;
            background: #3b82f6;
            border-radius: 99px
        }

        .video-scrub .marker {
            position: absolute;
            top: -3px;
            width: 3px;
            height: 12px;
            border-radius: 1px;
            background: #dc2626;
            cursor: pointer
        }

            .video-scrub .marker.med {
                background: #f59e0b
            }

            .video-scrub .marker.low {
                background: #60a5fa
            }

    .video-meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        font-size: 12px;
        color: var(--muted)
    }

        .video-meta-row .legend {
            display: flex;
            gap: 14px
        }

            .video-meta-row .legend span {
                display: inline-flex;
                align-items: center;
                gap: 6px
            }

            .video-meta-row .legend i {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                display: inline-block
            }

    /* ---------- raw log ---------- */
    details.raw {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        margin-top: 20px;
        overflow: hidden
    }

        details.raw > summary {
            list-style: none;
            cursor: pointer;
            padding: 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

            details.raw > summary::-webkit-details-marker {
                display: none
            }

        details.raw summary h2 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--ink)
        }

        details.raw summary .desc {
            font-size: 13px;
            color: var(--muted);
            margin-top: 3px
        }

        details.raw .arrow {
            transition: transform .2s;
            color: var(--muted)
        }

        details.raw[open] .arrow {
            transform: rotate(180deg)
        }

    .raw-head {
        display: flex;
        align-items: flex-start;
        gap: 14px
    }

    .raw-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px
    }

        .raw-table thead th {
            text-align: left;
            padding: 10px 16px;
            background: #f8fafc;
            color: var(--muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-size: 11px;
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            position: sticky;
            top: 0;
        }

        .raw-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--line-2);
            color: var(--ink-2);
            vertical-align: top
        }

        .raw-table tbody tr:hover {
            background: #fafbfc
        }

        .raw-table .reason {
            color: var(--ink-2);
            max-width: 520px
        }

    .raw-scroll {
        max-height: 520px;
        overflow: auto
    }

    .raw-table .id {
        font-family: 'JetBrains Mono',monospace;
        color: var(--muted)
    }

    .raw-table .ist {
        font-family: 'JetBrains Mono',monospace;
        color: var(--ink-2)
    }

    .media-section {
        margin-top: 20px;
    }

    .media-row {
        margin-top: 18px;
    }

    .media-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

        .media-title h3 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
        }

    .media-count {
        font-size: 12px;
        color: var(--muted);
    }

    .media-alert {
        margin: 8px 0 10px;
        padding: 8px 10px;
        border-radius: 8px;
        border: 1px solid #fcd9a4;
        background: #fff7e6;
        color: #92400e;
        font-size: 12px;
    }

    .media-strip {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 6px;
    }

    .media-strip-wrap {
        flex-wrap: wrap;
        overflow-x: visible;
        overflow-y: visible;
        padding-bottom: 0;
    }

    .media-card {
        min-width: 210px;
        width: 210px;
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        flex: 0 0 auto;
    }

    .media-thumb {
        width: 100%;
        height: 120px;
        background: #0f172a;
        display: block;
        object-fit: cover;
    }

    .media-meta {
        padding: 8px 10px 10px;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .media-meta .tt {
            font-size: 12px;
            font-weight: 600;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .media-meta .st {
            font-size: 11px;
            color: var(--muted);
            font-variant-numeric: tabular-nums;
        }

    /* ---------- footer note ---------- */
    .footnote {
        padding: 32px 0;
        text-align: center;
        font-size: 12px;
        color: var(--muted)
    }

    /* utilities */
    .right {
        margin-left: auto
    }

    .stack {
        display: flex;
        flex-direction: column;
        gap: 18px
    }

    .row-gap-20 {
        display: flex;
        flex-direction: column;
        gap: 20px
    }
</style>
<div class="rb-pe-wrap">
    <header class="topbar">
        <div class="topbar-left">
            <div class="brand">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9.5 8 11 4.5-1.5 8-6 8-11V5l-8-3z"></path></svg>
                Risebird
            </div>
            <div class="breadcrumbs">
                <span>AI Interview</span>
                <span class="crumb-sep">/</span>
                <span>Interview #@Model.InterviewId</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-current">Proctoring report</span>
            </div>
        </div>
        <div class="topbar-right">
            <div class="meta-id">
                <div><b>Interview</b> #@Model.InterviewId</div>
                <div>Session <span class="mono">@Model.SessionId</span></div>
            </div>
            <a class="btn" href="@Url.Action("ProctoringSessionEvents", "AIInterview", new { seId = Model.SessionId, downloadPdf = true })" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Export PDF
            </a>
            <a class="btn btn-primary" href="@Url.Action("Report", "AIInterview", new { seId = Model.SessionId })">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Back to AI report
            </a>
        </div>
    </header>
    <section class="hero">
        <div class="hero-l">
            <div class="candidate">
                <div class="avatar">@initials</div>
                <div>
                    <h1>@candidateName</h1>
                    <div class="sub">
                        @candidateEmail
                        <span class="dot">•</span>
                        <span style="color:#1e293b;font-weight:500">AI Interview</span>
                    </div>
                </div>
            </div>
            <div class="session-grid">
                <div>
                    <label>Session start</label>
                    <div class="v">@(sessionStart != null ? IndiaTimeHelper.FormatIstForDisplay(sessionStart.CreatedAtUtc) : "—")</div>
                </div>
                <div>
                    <label>Duration</label>
                    <div class="v">@(sessionDuration.HasValue ? sessionDuration.Value.ToString(@"hh\h\ mm\m\ ss\s") : "—")</div>
                </div>
                <div>
                    <label>Total events</label>
                    <div class="v">@totalEvents <span style="color:#64748b;font-weight:400">· @violationCount violations</span></div>
                </div>
                <div>
                    <label>Session ID</label>
                    <div class="v mono" style="font-size:12px">@Model.SessionId</div>
                </div>
            </div>
        </div>
        <aside class="verdict" id="verdictCard">
            <div class="verdict-label">Integrity assessment</div>
            <div class="verdict-row">
                <div class="verdict-level" id="verdictLevel">@(violationCount > 0 ? "High risk" : "Low risk")</div>
                <div class="verdict-score">Score <b id="verdictScore">@(totalEvents > 0 ? System.Math.Max(0, 100 - ((violationCount * 100) / totalEvents)) : 100)</b>/100</div>
            </div>
            <div class="verdict-bar"><span style="width:@(totalEvents > 0 ? (violationCount * 100 / totalEvents) : 0)%"></span></div>
            <div class="verdict-summary">
                Proctoring summary generated from recorded session events.
            </div>
        </aside>
    </section>
    <div class="kpis">
        <div class="kpi">
            <label>Total violations</label>
            <div class="no">@violationCount<small>/ @totalEvents events</small></div>
            <div class="delta @(totalEvents > 0 && ((double)violationCount / totalEvents) > 0.4 ? "bad" : "")">
                @if (totalEvents > 0)
                {
                    @($"{System.Math.Round((double)violationCount * 100 / totalEvents)}% of all events")
                }
                else
                {
                    @("No events captured")
                }
            </div>
        </div>
        <div class="kpi">
            <label>Violation rate</label>
            <div class="no">@violationRatePerMin.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)<small>/min</small></div>
            <div class="delta @(violationRatePerMin > 0.2 ? "warn" : "")">
                @(violationRatePerMin > 0.2 ? "High compared to baseline (<=0.2/min)" : "Within expected range")
            </div>
        </div>
        <div class="kpi">
            <label>Info events</label>
            <div class="no">@infoCount</div>
            <div class="delta">Non-violation telemetry rows</div>
        </div>
        <div class="kpi">
            <label>Duration</label>
            <div class="no" style="font-size:22px">@sessionDurationText</div>
            <div class="delta">From first to last recorded event</div>
        </div>
        <div class="kpi">
            <label>Distinct event types</label>
            <div class="no">@distinctEventTypes</div>
            <div class="delta">Unique values in event kind</div>
        </div>
    </div>

    @if (Model.Events == null || !Model.Events.Any())
    {
        <div class="rb-pe-empty">
            <i class="fa fa-inbox" style="font-size:2rem;opacity:.35;display:block;margin-bottom:12px;"></i>
            No proctoring events have been stored for this interview yet.
        </div>
    }
    else
    {
        var allEvents = Model.Events.OrderBy(x => x.CreatedAtUtc).ToList();
        var screenshotRows = allEvents
        .Where(x => string.Equals(x.EventKind, "screenshot", System.StringComparison.OrdinalIgnoreCase))
        .Select(x => new { Event = x, BlobUrl = ExtractBlobUrl(x.MetadataJson) })
        .Where(x => !string.IsNullOrWhiteSpace(x.BlobUrl))
        .ToList();
        var screenshotBlobFailures = allEvents
        .Where(x => string.Equals(x.EventKind, "screenshot", System.StringComparison.OrdinalIgnoreCase))
        .Select(x => ExtractMetaString(x.MetadataJson, "uploadError"))
        .Count(x => !string.IsNullOrWhiteSpace(x));
        var videoRows = allEvents
        .Where(x => string.Equals(x.EventKind, "screen_chunk", System.StringComparison.OrdinalIgnoreCase))
        .Select(x => new { Event = x, BlobUrl = ExtractBlobUrl(x.MetadataJson) })
        .Where(x => !string.IsNullOrWhiteSpace(x.BlobUrl))
        .ToList();
        var screenChunkBlobFailures = allEvents
        .Where(x => string.Equals(x.EventKind, "screen_chunk", System.StringComparison.OrdinalIgnoreCase))
        .Select(x => ExtractMetaString(x.MetadataJson, "uploadError"))
        .Count(x => !string.IsNullOrWhiteSpace(x));
        var highEvents = allEvents.Count(x => string.Equals(x.Level, "violation", System.StringComparison.OrdinalIgnoreCase));
        var medEvents = allEvents.Count(x => string.Equals(x.Level, "info", System.StringComparison.OrdinalIgnoreCase));
        var lowEvents = allEvents.Count - highEvents - medEvents;
        if (lowEvents < 0) { lowEvents = 0; }
        <section class="card" style="margin-top:20px">
            <div class="card-head">
                <div>
                    <h2>Flagged incidents</h2>
                    <div class="desc">Consecutive related events grouped into single incidents. Click any row for full evidence.</div>
                </div>
                <div class="filters" id="incFilters">
                    <button class="chip active" data-incf="all">All <span class="ct" id="ctAll">·@allEvents.Count</span></button>
                    <button class="chip" data-incf="high">High <span class="ct">·@highEvents</span></button>
                    <button class="chip" data-incf="med">Medium <span class="ct">·@medEvents</span></button>
                    <button class="chip" data-incf="low">Low <span class="ct">·@lowEvents</span></button>
                </div>
            </div>
            <div class="incidents" id="incidents">
                @foreach (var ev in allEvents)
                {
                    var reasonText = ProctoringEventDisplayHelper.GetReasonTextForDisplay(ev);
                    var reason = string.IsNullOrWhiteSpace(reasonText) ? "No reason available." : reasonText;
                    var kind = string.IsNullOrWhiteSpace(ev.EventKind) ? "telemetry" : ev.EventKind;
                    var level = (ev.Level ?? "").ToLowerInvariant();
                    var sev = level == "violation" ? "high" : (level == "info" ? "med" : "low");
                    var sevLabel = sev == "high" ? "High" : (sev == "med" ? "Medium" : "Low");
                    var iconSvg = sev == "high"
                    ? "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M3 7V5a2 2 0 0 1 2-2h2\"></path><path d=\"M17 3h2a2 2 0 0 1 2 2v2\"></path><path d=\"M21 17v2a2 2 0 0 1-2 2h-2\"></path><path d=\"M7 21H5a2 2 0 0 1-2-2v-2\"></path></svg>"
                    : (sev == "med"
                    ? "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"></rect><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line></svg>"
                    : "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z\"></path><circle cx=\"15\" cy=\"12\" r=\"1.5\" fill=\"currentColor\"></circle></svg>");
                    <div class="incident sev-@sev" data-sev="@sev" data-id="@ev.Id">
                        <div class="time">@ev.CreatedAtUtc.ToString("HH:mm:ss")</div>
                        <div class="icon">@Html.Raw(iconSvg)</div>
                        <div class="title">@reason</div>
                        <div class="dur">—</div>
                        <span class="pill @sev">@sevLabel</span>
                        <div class="chev">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </div>
                    </div>
                    <div class="incident-detail">
                        <dl class="ev-grid">
                            <dt>Type</dt>
                            <dd>@kind</dd>
                            <dt>Host</dt>
                            <dd><code>@Model.SessionId</code></dd>
                            <dt>Tab</dt>
                            <dd>AI Interview - Risebird</dd>
                            <dt>Detection source</dt>
                            <dd><code>@(string.IsNullOrWhiteSpace(ev.EventKind) ? "telemetry" : ev.EventKind)</code></dd>
                            <dt>Evidence</dt>
                            <dd>@reason</dd>
                            <dt>Event count</dt>
                            <dd>1</dd>
                            <dt>Severity rationale</dt>
                            <dd>@(level == "violation" ? "Marked as violation in session telemetry." : "Informational/non-violation telemetry row.")</dd>
                        </dl>
                    </div>
                }
            </div>
        </section>

        <section class="card media-section">
            <div class="card-head">
                <div>
                    <h2>Captured media evidence</h2>
                    <div class="desc">Screenshots and recorded screen chunks stored in Azure Blob for this session.</div>
                </div>
            </div>

            <div class="media-row">
                <div class="media-title">
                    <h3>Screenshots</h3>
                    <span class="media-count">@screenshotRows.Count item(s)</span>
                </div>
                @if (screenshotBlobFailures > 0)
                {
                    <div class="media-alert">@screenshotBlobFailures screenshot upload(s) failed to persist to blob storage.</div>
                }
                @if (screenshotRows.Any())
                {
                    <div class="media-strip media-strip-wrap">
                        @foreach (var shot in screenshotRows)
                        {
                            <a class="media-card" href="@shot.BlobUrl" target="_blank" rel="noopener">
                                <img class="media-thumb" src="@shot.BlobUrl" alt="Screenshot at @shot.Event.CreatedAtUtc.ToString("HH:mm:ss")" loading="lazy" />
                                <div class="media-meta">
                                    <div class="tt">Screenshot</div>
                                    <div class="st">@IndiaTimeHelper.FormatIstForDisplay(shot.Event.CreatedAtUtc)</div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="desc">No screenshot blobs found in telemetry metadata.</div>
                }
            </div>

            <div class="media-row">
                <div class="media-title">
                    <h3>Captured video chunks</h3>
                    <span class="media-count">@videoRows.Count item(s)</span>
                </div>
                @if (screenChunkBlobFailures > 0)
                {
                    <div class="media-alert">@screenChunkBlobFailures screen chunk upload(s) failed to persist to blob storage.</div>
                }
                @if (videoRows.Any())
                {
                    <div class="media-strip media-strip-wrap">
                        @foreach (var chunk in videoRows)
                        {
                            <a class="media-card" href="@chunk.BlobUrl" target="_blank" rel="noopener">
                                <video class="media-thumb" src="@chunk.BlobUrl" preload="metadata" muted playsinline></video>
                                <div class="media-meta">
                                    <div class="tt">Screen chunk</div>
                                    <div class="st">@IndiaTimeHelper.FormatIstForDisplay(chunk.Event.CreatedAtUtc)</div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="desc">No video chunk blobs found in telemetry metadata.</div>
                }
            </div>
        </section>
    }
</div>
<script>
    (function () {
        var root = document.getElementById("incidents");
        var filters = document.getElementById("incFilters");
        if (!root || !filters) return;

        root.addEventListener("click", function (e) {
            var row = e.target.closest(".incident");
            if (!row) return;
            row.classList.toggle("open");
        });

        filters.addEventListener("click", function (e) {
            var btn = e.target.closest(".chip");
            if (!btn) return;
            var mode = btn.getAttribute("data-incf");
            filters.querySelectorAll(".chip").forEach(function (c) { c.classList.remove("active"); });
            btn.classList.add("active");

            root.querySelectorAll(".incident").forEach(function (row) {
                var show = mode === "all" || row.getAttribute("data-sev") === mode;
                row.style.display = show ? "" : "none";
                row.classList.remove("open");
                var detail = row.nextElementSibling;
                if (detail && detail.classList.contains("incident-detail")) {
                    detail.style.display = show ? "" : "none";
                }
            });
        });
    })();
</script>
