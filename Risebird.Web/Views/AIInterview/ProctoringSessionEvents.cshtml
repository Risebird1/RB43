@using Risebird.CommonHelper
@using Risebird.Entities.Data
@using Risebird.Web.Helpers
@using System.Linq
@model Risebird.Entities.ViewModel.ProctoringSessionEventsResultViewModel
@{
    ViewData["Title"] = "Proctoring session events";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}
@await Html.PartialAsync("~/Views/AIInterview/_ProctoringSessionEventsStyles.cshtml")
@await Html.PartialAsync("~/Views/AIInterview/_ProctoringSessionEventsContent.cshtml", Model)
<script>
    (function () {
        var root = document.getElementById("incidents");
        var filters = document.getElementById("incFilters");
        if (!root || !filters) return;

        root.addEventListener("click", function (e) {
            var row = e.target.closest(".incident");
            if (!row) return;
            row.classList.toggle("open");
        });

        filters.addEventListener("click", function (e) {
            var btn = e.target.closest(".chip");
            if (!btn) return;
            var mode = btn.getAttribute("data-incf");
            filters.querySelectorAll(".chip").forEach(function (c) { c.classList.remove("active"); });
            btn.classList.add("active");

            root.querySelectorAll(".incident").forEach(function (row) {
                var show = mode === "all" || row.getAttribute("data-sev") === mode;
                row.style.display = show ? "" : "none";
                row.classList.remove("open");
                var detail = row.nextElementSibling;
                if (detail && detail.classList.contains("incident-detail")) {
                    detail.style.display = show ? "" : "none";
                }
            });
        });
    })();
</script>
