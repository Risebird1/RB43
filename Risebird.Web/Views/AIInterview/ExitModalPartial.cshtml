@model Risebird.Entities.ViewModel.AIInterviewExitModalViewModel
@{
    ViewData["Title"] = "Interview Complete";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="exit-page-container">
                <!-- Header Section -->
                <div class="exit-page-header text-center mb-4">
                    <div class="exit-icon mb-3">
                        <i class="fa @(Model?.IconClass ?? "fa-check-circle")" style="color: @(Model?.IconColor ?? "#28a745"); font-size: 3rem;"></i>
                    </div>
                    <h2 class="exit-title">@(Model?.Title ?? "Interview Complete")</h2>
                </div>

                <!-- Content Section -->
                <div class="exit-content text-center mb-4">
                    <p class="exit-message">@(Model?.Message ?? "The interview has been completed successfully.")</p>
                    
                    @if (!string.IsNullOrEmpty(Model?.CandidateName))
                    {
                        <div class="candidate-info mt-3">
                            <strong>Candidate:</strong> @Model.CandidateName
                        </div>
                    }
                    
                    @if (Model?.InterviewDate.HasValue == true)
                    {
                        <div class="interview-date mt-2">
                            <strong>Interview Date:</strong> @Model.InterviewDate.Value.ToString("MMMM dd, yyyy")
                        </div>
                    }
                    
                    <div class="exit-time mt-2">
                        <strong>@(Model.IsFromIndex ? "Exit Time:" : "Completion Time:")</strong> @Model.ExitTime.ToString("MMMM dd, yyyy HH:mm")
                    </div>
                    
                  
                </div>

                <!-- Dynamic Action Section -->
                <div class="exit-actions text-center">
                    @if (Model.IsFromIndex)
                    {
                        <a href="@Url.Action("Index", "AIInterview", new { sid = Model.SessionId })" class="btn @(Model?.ButtonClass ?? "btn-success") btn-lg" onclick="window.close();">
                            @(Model?.ButtonText ?? "Close")
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "AIInterview", new { sid = Model.SessionId })" class="btn @(Model?.ButtonClass ?? "btn-success") btn-lg">
                            @(Model?.ButtonText ?? "Close")
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .exit-page-container {
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 4px 32px rgba(78, 218, 146, 0.2);
        margin-top: 50px;
    }
    
    .exit-title {
        color: #333;
        font-weight: 600;
        margin-bottom: 20px;
        font-size: 1.7rem;
    }
    
    .exit-message {
        font-size: 1.1rem;
        color: #666;
        line-height: 1.6;
    }
    
    .candidate-info, .interview-date, .exit-time, .session-info {
        color: #555;
        font-size: 1rem;
        margin-bottom: 8px;
    }
    
    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
    }
</style>