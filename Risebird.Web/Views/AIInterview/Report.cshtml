        padding: 12px 14px;
        margin-bottom: 10px;
        border: 1px solid #d7e3f0;
        border-radius: 12px;
        background: linear-gradient(180deg, #f7fbff 0%, #ffffff 100%);
    }
    .rb-ssa-toolbar-title {
        font-size: 14px;
        font-weight: 700;
        color: #17324d;
        margin-bottom: 2px;
    }
    .rb-ssa-toolbar-title i {
        color: #42a5f5;
        margin-right: 6px;
    }
    .rb-ssa-toolbar-sub {
        font-size: 12px;
        color: #6b7d90;
    }
    .rb-ssa-panel {
        border: 1px solid #d7e3f0 !important;
        border-radius: 14px !important;
        background: linear-gradient(180deg, #f7fbff 0%, #ffffff 42%) !important;
        padding: 14px 16px 16px !important;
        box-shadow: 0 8px 24px rgba(32, 64, 101, 0.06);
    }
    .rb-ssa-head {
        display: flex;
        align-items: center;
