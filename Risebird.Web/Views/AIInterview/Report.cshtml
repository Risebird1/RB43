                                                                                var happyValue = Model.sentimentViewModel.HAPPY ?? 0;
                                                                            }
                                                                            <span class="confidence-level-value">@happyPercent%</span>
                                                                        </div>
                                                                        <div class="confidence-progress-bar-container">
