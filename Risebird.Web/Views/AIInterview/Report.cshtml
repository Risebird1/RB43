                });
            });

            // Read more / less handlers (event delegation)
            if (!root._rbClampBound) {
                root._rbClampBound = true;
                root.addEventListener('click', function (e) {
                    var btn = e.target.closest ? e.target.closest('.rb-adaptive-clamp__toggle') : null;
                    if (!btn) return;
                    e.preventDefault();
                    var id = btn.getAttribute('data-clamp');
                    var box = id ? document.getElementById(id) : btn.parentElement;
                    if (!box) return;
