<script>
    function runProctoringScreenshotAnalysis() {
        var btn = document.getElementById('rbScreenshotAnalysisBtn');
        var panel = document.getElementById('rbScreenshotAnalysisPanel');
        var statusEl = document.getElementById('rbScreenshotAnalysisStatus');
        var summaryEl = document.getElementById('rbScreenshotAnalysisSummary');
        var verdictEl = document.getElementById('rbScreenshotAnalysisVerdict');
        var originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Analyzing...';
        panel.style.display = 'block';
        statusEl.className = 'rb-ssa-status';
        statusEl.textContent = 'Reviewing screenshots for eye gaze and integrity risks...';
        summaryEl.innerHTML = '<div class="rb-ssa-loading"><span class="rb-ssa-dot"></span><span class="rb-ssa-dot"></span><span class="rb-ssa-dot"></span></div>';
        if (verdictEl) {
            verdictEl.style.display = 'none';
            verdictEl.innerHTML = '';
            verdictEl.className = 'rb-ssa-verdict';
        }
        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });

        fetch('@Url.Action("AnalyzeProctoringScreenshots", "AIInterview")?seId=@Model.SessionId', { method: 'POST' })
            .then(function (r) { return r.json().then(function (data) { return { httpOk: r.ok, data: data }; }); })
            .then(function (res) {
                if (!res.httpOk || !res.data || res.data.ok !== true) {
                    statusEl.className = 'rb-ssa-status rb-ssa-status-error';
                    statusEl.textContent = 'Analysis failed: ' + ((res.data && res.data.error) || 'Unexpected server error.');
                    summaryEl.innerHTML = '';
                    return;
                }
                statusEl.className = 'rb-ssa-status rb-ssa-status-ok';
                statusEl.textContent = 'Based on ' + res.data.screenshotsAnalyzed + ' screenshot' + (res.data.screenshotsAnalyzed === 1 ? '' : 's');
                summaryEl.innerHTML = renderProctoringAnalysisSummary(res.data.analysis, verdictEl);
            })
            .catch(function (err) {
                statusEl.className = 'rb-ssa-status rb-ssa-status-error';
                statusEl.textContent = 'Analysis failed: ' + err;
                summaryEl.innerHTML = '';
            })
            .finally(function () {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            });
    }

    function proctoringHumanizeLabel(key) {
        return String(key || '')
            .replace(/[_-]+/g, ' ')
            .replace(/([a-z])([A-Z])/g, '$1 $2')
            .replace(/\s+/g, ' ')
            .trim()
            .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
    }

    function proctoringFormatValue(value) {
        if (value === null || value === undefined) return '—';
        if (typeof value === 'boolean') return value ? 'Yes' : 'No';
        if (typeof value === 'number') return String(value);
        if (typeof value === 'string') {
            var t = value.trim();
            return t.length ? t : '—';
        }
        if (Array.isArray(value)) {
            if (!value.length) return 'None detected';
            return value.map(function (item) {
                if (item == null) return '';
                if (typeof item === 'object') {
                    return Object.keys(item).map(function (k) {
                        var v = item[k];
                        if (v == null || typeof v === 'object') return null;
                        return proctoringHumanizeLabel(k) + ': ' + String(v);
                    }).filter(Boolean).join(' · ');
                }
                return String(item);
            }).filter(function (s) { return s && String(s).trim(); }).join('; ');
        }
        if (typeof value === 'object') {
            var keys = Object.keys(value);
            if (!keys.length) return '—';
            return keys.map(function (k) {
                var v = value[k];
                if (v != null && typeof v === 'object') return null;
                return proctoringHumanizeLabel(k) + ': ' + proctoringFormatValue(v);
            }).filter(Boolean).join(' · ') || '—';
        }
        return String(value);
    }

    function proctoringPick(analysis, keys) {
        if (!analysis || typeof analysis !== 'object') return undefined;
        for (var i = 0; i < keys.length; i++) {
            if (Object.prototype.hasOwnProperty.call(analysis, keys[i]) && analysis[keys[i]] != null && analysis[keys[i]] !== '') {
                return analysis[keys[i]];
            }
            var lower = keys[i].toLowerCase();
            var found = Object.keys(analysis).find(function (k) { return k.toLowerCase() === lower; });
            if (found != null && analysis[found] != null && analysis[found] !== '') return analysis[found];
        }
        return undefined;
    }

    function proctoringNormalizeRisk(analysis) {
        var verdictRaw = String(proctoringPick(analysis, ['verdict', 'overallVerdict', 'decision', 'integrityVerdict']) || '').toLowerCase();
        var riskRaw = String(proctoringPick(analysis, ['riskLevel', 'risk', 'risk_level', 'severity']) || '').toLowerCase();
        var apps = proctoringPick(analysis, ['suspiciousApps', 'suspicious_apps', 'apps', 'flaggedApps']);
        var gazeStatus = String(proctoringPick(analysis, ['eyeGazeStatus', 'gazeStatus', 'eye_gaze_status']) || '').toLowerCase();
        var appsStatus = String(proctoringPick(analysis, ['suspiciousAppsStatus', 'appsStatus']) || '').toLowerCase();
        var textBlob = JSON.stringify(analysis || {}).toLowerCase();

        var hasApps = (Array.isArray(apps) && apps.length > 0)
            || /detected|found|yes|true/.test(appsStatus)
            || /whatsapp|chatgpt|telegram|discord|cheat|external app/.test(textBlob);
        var gazeBad = /suspicious|off.?screen|looking away|averted|abnormal/.test(gazeStatus)
            || /off.?screen|looking away|averted gaze|suspicious gaze/.test(textBlob);

        var level = 'low';
        if (/high|critical|severe|fail|high_risk/.test(verdictRaw) || /high|critical|severe/.test(riskRaw) || (hasApps && gazeBad)) level = 'high';
        else if (/medium|moderate|review|caution|review_needed|warn/.test(verdictRaw) || /medium|moderate/.test(riskRaw) || hasApps || gazeBad) level = 'medium';

        var label = level === 'high' ? 'HIGH RISK' : (level === 'medium' ? 'REVIEW NEEDED' : 'CLEAR');
        var tone = level === 'high' ? 'danger' : (level === 'medium' ? 'warn' : 'ok');
        var blurb = level === 'high'
            ? 'Integrity concerns are strong enough to escalate.'
            : (level === 'medium'
                ? 'Potential concerns found — manual review recommended.'
                : 'No material integrity issues detected.');
        return { level: level, label: label, tone: tone, blurb: blurb, hasApps: hasApps, gazeBad: gazeBad };
    }

    function proctoringDecisionBadge(text) {
        var t = String(text || '').toLowerCase();
        if (!t || t === '—' || t === 'none detected' || t === 'normal' || t === 'clear' || t === 'none' || t === 'low' || t === 'no') {
            return { cls: 'ok', label: 'Clear' };
        }
        if (/high|critical|detected|suspicious|fail|violation|cheat|off.?screen/.test(t)) {
            return { cls: 'danger', label: 'Flagged' };
        }
        if (/medium|review|caution|warn|possible|partial/.test(t)) {
            return { cls: 'warn', label: 'Review' };
        }
        return { cls: 'info', label: 'Noted' };
    }

    function proctoringBuildDecisiveRows(analysis) {
        var risk = proctoringNormalizeRisk(analysis);
        var gaze = proctoringPick(analysis, ['eyeGaze', 'eye_gaze', 'gaze', 'gazeAnalysis', 'attention']);
        var gazeStatus = proctoringPick(analysis, ['eyeGazeStatus', 'gazeStatus']);
        var apps = proctoringPick(analysis, ['suspiciousApps', 'suspicious_apps', 'apps', 'flaggedApps']);
        var appsStatus = proctoringPick(analysis, ['suspiciousAppsStatus', 'appsStatus']);
        var findings = proctoringPick(analysis, ['keyFindings', 'findings', 'observations']);
        var recommendation = proctoringPick(analysis, ['recommendation', 'nextAction', 'action', 'recommendedAction']);
        var summary = proctoringPick(analysis, ['summary', 'overview', 'conclusion']);

        var rows = [];
        rows.push({
            icon: 'fa-eye',
            category: 'Eye Gaze',
            decision: gazeStatus ? proctoringFormatValue(gazeStatus) : (risk.gazeBad ? 'SUSPICIOUS' : 'NORMAL'),
            detail: proctoringFormatValue(gaze),
            tone: risk.gazeBad ? 'danger' : 'ok'
        });
        rows.push({
            icon: 'fa-desktop',
            category: 'Suspicious Apps',
            decision: appsStatus ? proctoringFormatValue(appsStatus) : (risk.hasApps ? 'DETECTED' : 'NONE'),
            detail: proctoringFormatValue(apps),
            tone: risk.hasApps ? 'danger' : 'ok'
        });
        rows.push({
            icon: 'fa-exclamation-triangle',
            category: 'Risk Level',
            decision: risk.label,
            detail: proctoringFormatValue(proctoringPick(analysis, ['riskLevel', 'risk', 'severity']) || risk.blurb),
            tone: risk.tone === 'danger' ? 'danger' : (risk.tone === 'warn' ? 'warn' : 'ok')
        });
        if (findings != null) {
            rows.push({
                icon: 'fa-list-ul',
                category: 'Key Findings',
                decision: Array.isArray(findings) && findings.length ? findings.length + ' point' + (findings.length === 1 ? '' : 's') : 'None',
                detail: proctoringFormatValue(findings),
                tone: 'info'
            });
        }
        if (recommendation != null) {
            rows.push({
                icon: 'fa-gavel',
                category: 'Recommendation',
                decision: 'Action',
                detail: proctoringFormatValue(recommendation),
                tone: risk.tone === 'ok' ? 'ok' : 'warn'
            });
        } else if (summary != null) {
            rows.push({
                icon: 'fa-file-text-o',
                category: 'Summary',
                decision: 'Assessment',
                detail: proctoringFormatValue(summary),
                tone: 'info'
            });
        }

        // Include leftover fields not already covered, compactly
        if (analysis && typeof analysis === 'object' && !Array.isArray(analysis)) {
            var used = {
                verdict: 1, overallverdict: 1, decision: 1, integrityverdict: 1,
                risklevel: 1, risk: 1, risk_level: 1, severity: 1,
                eyegaze: 1, eye_gaze: 1, gaze: 1, gazeanalysis: 1, attention: 1,
                eyegazestatus: 1, gazestatus: 1, eye_gaze_status: 1,
                suspiciousapps: 1, suspicious_apps: 1, apps: 1, flaggedapps: 1,
                suspiciousappsstatus: 1, appsstatus: 1,
                keyfindings: 1, findings: 1, observations: 1,
                recommendation: 1, nextaction: 1, action: 1, recommendedaction: 1,
                summary: 1, overview: 1, conclusion: 1, raw: 1
            };
            Object.keys(analysis).forEach(function (key) {
                if (used[key.toLowerCase()]) return;
                var val = analysis[key];
                if (val == null || val === '') return;
                rows.push({
                    icon: 'fa-info-circle',
                    category: proctoringHumanizeLabel(key),
                    decision: 'Noted',
                    detail: proctoringFormatValue(val),
                    tone: 'info'
                });
            });
        }

        return { risk: risk, rows: rows };
    }

    function renderProctoringAnalysisSummary(analysis, verdictEl) {
        var built = proctoringBuildDecisiveRows(analysis);
        var risk = built.risk;
        var rows = built.rows;

        if (verdictEl) {
            verdictEl.style.display = 'inline-flex';
            verdictEl.className = 'rb-ssa-verdict rb-ssa-verdict-' + risk.tone;
            verdictEl.innerHTML = '<i class="fa ' +
                (risk.tone === 'ok' ? 'fa-check-circle' : (risk.tone === 'warn' ? 'fa-exclamation-circle' : 'fa-times-circle')) +
                '"></i><span>' + escapeProctoringHtml(risk.label) + '</span>';
        }

        if (!rows.length) {
            return '<div class="rb-ssa-empty">No analysis details available.</div>';
        }

        var html = '' +
            '<div class="rb-ssa-banner rb-ssa-banner-' + risk.tone + '">' +
                '<div class="rb-ssa-banner-main">' +
                    '<div class="rb-ssa-banner-label">Integrity Verdict</div>' +
                    '<div class="rb-ssa-banner-title">' + escapeProctoringHtml(risk.label) + '</div>' +
                    '<div class="rb-ssa-banner-text">' + escapeProctoringHtml(risk.blurb) + '</div>' +
                '</div>' +
                '<div class="rb-ssa-metrics">' +
                    '<div class="rb-ssa-metric"><span>Gaze</span><strong class="' + (risk.gazeBad ? 'is-bad' : 'is-good') + '">' + (risk.gazeBad ? 'Suspicious' : 'Normal') + '</strong></div>' +
                    '<div class="rb-ssa-metric"><span>Apps</span><strong class="' + (risk.hasApps ? 'is-bad' : 'is-good') + '">' + (risk.hasApps ? 'Detected' : 'None') + '</strong></div>' +
                    '<div class="rb-ssa-metric"><span>Risk</span><strong class="is-' + risk.tone + '">' + escapeProctoringHtml(risk.level.toUpperCase()) + '</strong></div>' +
                '</div>' +
            '</div>' +
            '<div class="rb-ssa-table-wrap">' +
            '<table class="rb-ssa-table">' +
            '<thead><tr><th>Category</th><th>Decision</th><th>Finding</th></tr></thead><tbody>';

        rows.forEach(function (row) {
            var badge = proctoringDecisionBadge(row.decision);
            html += '<tr>' +
                '<td class="rb-ssa-cat"><i class="fa ' + row.icon + '"></i>' + escapeProctoringHtml(row.category) + '</td>' +
                '<td class="rb-ssa-decision"><span class="rb-ssa-badge rb-ssa-badge-' + badge.cls + '">' + escapeProctoringHtml(String(row.decision)) + '</span></td>' +
                '<td class="rb-ssa-finding">' + escapeProctoringHtml(row.detail) + '</td>' +
                '</tr>';
        });

        html += '</tbody></table></div>';
        return html;
    }

    function escapeProctoringHtml(text) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(text == null ? '' : String(text)));
        return div.innerHTML;
    }
</script>
<style>
    .rb-ssa-section-wrap {
        margin: 14px 0 18px;
    }
    .rb-ssa-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
