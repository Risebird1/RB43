<script>
    let interviewIdVariable;
    let sessionIdVariable;
    let questionIdVariable;
    function openUpdateCandidateAnswerModel() {
        var modal = document.getElementById("UpdateCandidateAnswerModel");
        modal.style.display = "block";
    }
    function closeUpdateCandidateAnswerModel() {
        var modal = document.getElementById("UpdateCandidateAnswerModel");
        modal.style.display = "none";
    }
    function UpdateCandidateAnswer(questionId, interviewId, sessionId, candidateAnswer) {
        openUpdateCandidateAnswerModel();
        questionIdVariable = questionId;
        interviewIdVariable = interviewId;
        sessionIdVariable = sessionId;
        $("#txt_CandidateAnswer").val(candidateAnswer);
    }

    function SaveCandidateAnswerById() {
        var candidateAnswerVariable = $("#txt_CandidateAnswer").val();
        $.ajax({
            type: "POST",
            url: "/AIInterview/SaveCandidateAnswerById",
            data: { 'questionId': questionIdVariable, 'candidateAnswer': candidateAnswerVariable },
            success: function (data) {
                closeUpdateCandidateAnswerModel();
                if (data) {
                    alert('Successful.');
                    setTimeout(function () {
                        location.reload();
                    }, 2000);
                }
                else {
                    alert('Failed!');
                }

            }
        });
    }
</script>
<script>
    /* Audio Adaptive only: restyle AI Analysis HTML to match video-report checklist look */
    document.addEventListener('DOMContentLoaded', function () {
        var root = document.getElementById('rb-adaptive-ai-analysis');
        if (!root) return;

        // AI HTML often wraps content in <div style="... max-width:800px; margin:0 auto;"> — use full width
        Array.prototype.forEach.call(root.querySelectorAll('div[style]'), function (el) {
            var style = el.getAttribute('style');
            if (!style || !/max-width\s*:\s*800px/i.test(style)) return;
            var next = style
                .replace(/max-width\s*:\s*800px\s*;?/gi, '')
                .replace(/margin\s*:\s*0\s*auto\s*;?/gi, '')
                .replace(/;\s*;/g, ';')
                .replace(/^\s*;\s*|\s*;\s*$/g, '')
                .trim();
            if (next) el.setAttribute('style', next);
            else el.removeAttribute('style');
        });

        function trimPreambleBeforeCompetency() {
            function textOf(el) {
                return ((el && el.textContent) || '').replace(/\s+/g, ' ').trim();
            }

            function isCompetencyStart(el) {
                if (!el || el.nodeType !== 1) return false;
                var t = textOf(el);
                if (/competenc(y|ies)?\s*rating/i.test(t) && t.length < 120) return true;
                if (/technical skills analysis|skill[- ]?wise\s*(breakdown|analysis)|score\s*rubric/i.test(t) && t.length < 120) return true;
                if (el.tagName === 'TABLE') {
                    var header = '';
                    Array.prototype.forEach.call(el.querySelectorAll('th'), function (th) {
                        header += ' ' + (th.textContent || '');
                    });
                    if (!header.trim() && el.rows.length) {
                        Array.prototype.forEach.call(el.rows[0].cells, function (cell) {
                            header += ' ' + (cell.textContent || '');
                        });
                    }
                    return /competenc|skill\s*name|self.?rating|ai.?rating|rubric/i.test(header);
                }
                return false;
            }

            // Prefer an explicit competency/score heading, else first matching table
            var start = null;
            var nodes = root.querySelectorAll('h1, h2, h3, h4, h5, p, div, table, strong, b, span');
            for (var i = 0; i < nodes.length; i++) {
                if (isCompetencyStart(nodes[i])) {
                    start = nodes[i];
                    break;
                }
            }
            if (!start) return;

            // Walk up to a direct child of root so we can remove preceding siblings cleanly
            var cut = start;
            while (cut.parentElement && cut.parentElement !== root) {
                cut = cut.parentElement;
            }
            if (cut.parentElement !== root) return;

            var prev = cut.previousSibling;
            while (prev) {
                var remove = prev;
                prev = prev.previousSibling;
                root.removeChild(remove);
            }

            // Strip leading preamble inside the same wrapper as the competency block
            if (cut !== start) {
                var cur = start;
                while (cur && cur !== cut) {
                    var p = cur.parentElement;
                    if (!p) break;
                    var sib = cur.previousSibling;
                    while (sib) {
                        var rm = sib;
                        sib = sib.previousSibling;
                        p.removeChild(rm);
                    }
                    cur = p;
                }
            }
        }

        trimPreambleBeforeCompetency();

        function decorateLabels(el) {
            if (!el || el.nodeType !== 1) return;
            if (el.classList && (el.classList.contains('rb-adaptive-label') || el.classList.contains('rb-adaptive-pill'))) return;

            if (el.children && el.children.length) {
                var hasNestedBlock = false;
                for (var i = 0; i < el.children.length; i++) {
                    var tag = el.children[i].tagName;
                    if (tag === 'TABLE' || tag === 'UL' || tag === 'OL' || tag === 'H2' || tag === 'H3' || tag === 'H4' || tag === 'DIV') {
                        hasNestedBlock = true;
                        break;
                    }
                }
                if (hasNestedBlock) {
                    Array.prototype.forEach.call(el.children, decorateLabels);
                    return;
                }
            }

            var html = el.innerHTML;
            if (!html) return;
            var text = el.textContent || '';
            if (!/Strength|Weakness|AI ANALYSIS|EVIDENCE|Verdict|Areas of Improvement/i.test(text)) return;

            var next = html
                .replace(/\b(AI\s*ANALYSIS\s*:\s*VERDICT)\s*:?/gi, '<span class="rb-adaptive-label rb-adaptive-label--verdict">$1</span>')
                .replace(/\b(EVIDENCE\s+FROM\s+TRANSCRIPT)\s*:?/gi, '<span class="rb-adaptive-label rb-adaptive-label--evidence">$1</span>')
                .replace(/\b(Strengths?)\s*:/gi, '<span class="rb-adaptive-label rb-adaptive-label--strength">$1:</span>')
                .replace(/\b(Weaknesses?)\s*:/gi, '<span class="rb-adaptive-label rb-adaptive-label--weakness">$1:</span>')
                .replace(/\b(Areas of Improvement)\s*:/gi, '<span class="rb-adaptive-label rb-adaptive-label--weakness">$1:</span>')
                .replace(/(Verdict\s*:?\s*)(Positive)\b/gi, '$1<span class="rb-adaptive-pill rb-adaptive-pill--positive">$2</span>')
                .replace(/(Verdict\s*:?\s*)(Negative)\b/gi, '$1<span class="rb-adaptive-pill rb-adaptive-pill--negative">$2</span>');
            if (next !== html) el.innerHTML = next;
        }

        function isQuestionHeading(el) {
            var t = (el.textContent || '').replace(/\s+/g, ' ').trim();
            if (!t || t.length > 400) return false;
            if (/^\d+[\.\)]\s+\S/.test(t)) return true;
            if (/^Q\d+[\.:)\s]/i.test(t)) return true;
            if (/^Question\s*\d+/i.test(t)) return true;
            return false;
        }

        var heads = [];
        Array.prototype.forEach.call(root.querySelectorAll('h2, h3, h4, p, li'), function (el) {
            if (el.closest('table')) return;
            if (el.querySelector('h2, h3, h4, table')) return;
            if (isQuestionHeading(el)) {
                el.classList.add('rb-adaptive-q-head');
                heads.push(el);
            }
        });

        heads.forEach(function (head) {
            if (head.parentElement && head.parentElement.classList.contains('rb-adaptive-q-block')) return;
            var block = document.createElement('div');
            block.className = 'rb-adaptive-q-block';
            head.parentNode.insertBefore(block, head);
            block.appendChild(head);

            var sibling = block.nextSibling;
            while (sibling) {
                if (sibling.nodeType === 1) {
                    if (sibling.classList && sibling.classList.contains('rb-adaptive-q-head')) break;
                    if (sibling.classList && sibling.classList.contains('rb-adaptive-q-block')) break;
                    var tag = sibling.tagName;
                    if (tag === 'HR' || tag === 'TABLE') break;
                    if ((tag === 'H2' || tag === 'H3' || tag === 'H4') && isQuestionHeading(sibling)) break;
                }
                var move = sibling;
                sibling = sibling.nextSibling;
                block.appendChild(move);
            }
        });

        function ratingPillClass(text) {
            var t = (text || '').toLowerCase().trim();
            if (!t) return null;
            if (/excellent|outstanding|strong|selected|hire|high/.test(t)) return 'rb-adaptive-rating-pill--excellent';
            if (/good|above average|proficient|pass|positive/.test(t)) return 'rb-adaptive-rating-pill--good';
            if (/average|moderate|fair|ok|adequate/.test(t)) return 'rb-adaptive-rating-pill--average';
            if (/below|needs improvement|borderline|caution/.test(t)) return 'rb-adaptive-rating-pill--below';
            if (/poor|weak|fail|reject|negative|low/.test(t)) return 'rb-adaptive-rating-pill--poor';
            return 'rb-adaptive-rating-pill--neutral';
        }

        function enhanceRatingTables() {
            var clampId = 0;

            function parseScore(raw) {
                if (!raw) return null;
                var m = String(raw).match(/(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/);
                if (m) return { value: parseFloat(m[1]), max: parseFloat(m[2]) };
                m = String(raw).match(/^(\d+(?:\.\d+)?)\s*%$/);
                if (m) return { value: parseFloat(m[1]), max: 100 };
                m = String(raw).match(/^(\d+(?:\.\d+)?)$/);
                if (m) return { value: parseFloat(m[1]), max: null };
                return null;
            }

            function escapeHtml(s) {
                return String(s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function barHtml(value, max) {
                if (max == null || max <= 0) max = 10;
                var pct = Math.max(0, Math.min(100, (value / max) * 100));
                var tone = pct >= 70 ? 'rb-adaptive-bar__fill--high' : (pct >= 40 ? 'rb-adaptive-bar__fill--mid' : 'rb-adaptive-bar__fill--low');
                return '<div class="rb-adaptive-bar" title="' + value + ' / ' + max + '">' +
                    '<span class="rb-adaptive-score">' + value + '</span>' +
                    '<span class="rb-adaptive-bar__track"><span class="rb-adaptive-bar__fill ' + tone + '" style="width:' + pct.toFixed(1) + '%;"></span></span>' +
                    '</div>';
            }

            function starsHtml(value, max) {
                if (max == null || max <= 0) max = 5;
                var filled = Math.round((value / max) * 5);
                filled = Math.max(0, Math.min(5, filled));
                var html = '<span class="rb-adaptive-stars" aria-label="' + value + ' of ' + max + '">';
                for (var i = 1; i <= 5; i++) {
                    html += '<i class="fa fa-star' + (i <= filled ? '' : ' rb-star-empty') + '"></i>';
                }
                return html + '</span>';
            }

            function applyClamp(cell, raw, limit) {
                limit = limit || 140;
                if (!raw || raw.length <= limit) {
                    cell.classList.add('rb-adaptive-text-col');
                    cell.textContent = raw;
                    return;
                }
                clampId += 1;
                var id = 'rb-clamp-' + clampId;
                var shortText = raw.substring(0, limit).replace(/\s+\S*$/, '') + '…';
                cell.classList.add('rb-adaptive-text-col');
                cell.innerHTML =
                    '<div class="rb-adaptive-clamp" id="' + id + '">' +
                    '<div class="rb-adaptive-clamp__short">' + escapeHtml(shortText) + '</div>' +
                    '<div class="rb-adaptive-clamp__full">' + escapeHtml(raw) + '</div>' +
                    '<button type="button" class="rb-adaptive-clamp__toggle" data-clamp="' + id + '" aria-expanded="false">Read more</button>' +
                    '</div>';
            }

            function isTextColumn(col, idx, scored, raw) {
                if (/question|comment|remark|feedback|evidence|description|observation|note|detail|analysis|reason/.test(col)) return true;
                if (idx === 0 && raw && raw.length > 40 && !scored) return true;
                if (!scored && raw && raw.length > 60 && !/rating|verdict|grade|level|status|result/.test(col)) return true;
                return false;
            }

            // Style section titles above rating/rubric tables
            Array.prototype.forEach.call(root.querySelectorAll('h2, h3, h4, p, strong, b, div'), function (el) {
                if (el.querySelector('table, h2, h3, h4')) return;
                var t = ((el.textContent || '').replace(/\s+/g, ' ').trim());
                if (!t || t.length > 80) return;
                if (/competenc(y|ies)?\s*rating|score\s*rubric|skill[- ]?wise|technical skills analysis|rubric score/i.test(t)) {
                    el.classList.add('rb-adaptive-table-title');
                }
            });

            Array.prototype.forEach.call(root.querySelectorAll('table'), function (table) {
                table.removeAttribute('width');
                table.style.width = '100%';
                table.style.maxWidth = '100%';
                table.style.tableLayout = 'fixed';
                Array.prototype.forEach.call(table.querySelectorAll('[width]'), function (el) {
                    el.removeAttribute('width');
                });

                var headerText = '';
                Array.prototype.forEach.call(table.querySelectorAll('th'), function (th) {
                    headerText += ' ' + (th.textContent || '');
                });
                if (!headerText.trim() && table.rows.length) {
                    Array.prototype.forEach.call(table.rows[0].cells, function (cell) {
                        headerText += ' ' + (cell.textContent || '');
                    });
                }
                var h = headerText.toLowerCase();
                var isRatingTable = /competenc|skill|score|rating|weight|self.?rating|ai.?rating|max.?rating|weighted|rubric|question|comment|remark|expected|observed/.test(h);
                var isRubricLike = /rubric|expected|observed|competenc|skill\s*name|self.?rating|ai.?rating|weight/.test(h) &&
                    !(/question/.test(h) && /verdict|comment/.test(h));

                if (!table.parentElement || !table.parentElement.classList.contains('rb-adaptive-table-wrap')) {
                    var wrap = document.createElement('div');
                    wrap.className = 'rb-adaptive-table-wrap';
                    table.parentNode.insertBefore(wrap, table);
                    wrap.appendChild(table);
                }

                if (!isRatingTable) return;

                table.classList.add('rb-adaptive-rating-table');
                // Score Rubric tables keep plain cells — normalized later to video UI columns
                if (isRubricLike) {
                    table.classList.add('rb-ai-rubric-table');
                    return;
                }

                var headers = [];
                var headerCells = table.querySelectorAll('thead th');
                var headerRowIsTd = false;
                if (!headerCells.length && table.rows.length) {
                    headerCells = table.rows[0].querySelectorAll('th, td');
                    headerRowIsTd = table.rows[0].querySelector('th') == null;
                }
                Array.prototype.forEach.call(headerCells, function (cell, idx) {
                    headers[idx] = ((cell.textContent || '').toLowerCase().trim());
                    if (headerRowIsTd) cell.classList.add('rb-adaptive-th');
                });

                var maxColIdx = -1;
                headers.forEach(function (col, idx) {
                    if (/^max|max score|max rating/.test(col)) maxColIdx = idx;
                });

                var bodyRows = table.tBodies.length
                    ? Array.prototype.slice.call(table.tBodies[0].rows)
                    : Array.prototype.slice.call(table.rows, table.querySelector('th') || headerRowIsTd ? 1 : 0);

                // If first row was used as header via td, skip it
                if (headerRowIsTd && bodyRows.length && bodyRows[0] === table.rows[0]) {
                    bodyRows = bodyRows.slice(1);
                }

                bodyRows.forEach(function (row) {
                    var rowMax = null;
                    if (maxColIdx >= 0 && row.cells[maxColIdx]) {
                        var mx = parseScore((row.cells[maxColIdx].textContent || '').trim());
                        if (mx) rowMax = mx.value;
                    }

                    Array.prototype.forEach.call(row.cells, function (cell, idx) {
                        if (cell.querySelector('.rb-adaptive-bar, .rb-adaptive-rating-pill, .rb-adaptive-stars, .rb-adaptive-clamp')) return;
                        var raw = (cell.textContent || '').replace(/\s+/g, ' ').trim();
                        if (!raw) return;
                        var col = headers[idx] || '';
                        var scored = parseScore(raw);

                        // Long question / comment / competency text → wrap + read more
                        if (isTextColumn(col, idx, scored, raw)) {
                            applyClamp(cell, raw, /question|comment|remark|feedback|evidence|analysis/.test(col) ? 120 : 160);
                            return;
                        }

                        if (idx === 0) {
                            cell.classList.add('rb-adaptive-text-col');
                            if (raw.length > 160) {
                                applyClamp(cell, raw, 160);
                            }
                            return;
                        }

                        // Text rating / status → pill
                        if (/rating|verdict|grade|level|result|status/.test(col) && !scored) {
                            var pillClass = ratingPillClass(raw);
                            if (pillClass && !/★|⭐|☆/.test(raw)) {
                                cell.classList.add('rb-adaptive-metric-col');
                                cell.innerHTML = '<span class="rb-adaptive-rating-pill ' + pillClass + '">' + escapeHtml(raw) + '</span>';
                            } else if (raw.length > 80) {
                                applyClamp(cell, raw, 100);
                            }
                            return;
                        }

                        // Numeric score → bar / stars
                        if (scored && (/score|ai.?rating|self.?rating|rating|weight|percent|%/.test(col) || scored.max != null)) {
                            cell.classList.add('rb-adaptive-metric-col');
                            var max = scored.max != null ? scored.max : (rowMax != null ? rowMax : 10);
                            if (/rating/.test(col) && max <= 5) {
                                cell.innerHTML = starsHtml(scored.value, max);
                            } else if (/max/.test(col)) {
                                cell.innerHTML = '<span class="rb-adaptive-score">' + escapeHtml(raw) + '</span>';
                            } else {
                                cell.innerHTML = barHtml(scored.value, max);
                            }
                            return;
                        }

                        if (/^\d+(\.\d+)?%?$/.test(raw) || /^\d+(\.\d+)?\s*\/\s*\d+/.test(raw)) {
                            cell.classList.add('rb-adaptive-metric-col');
                            cell.innerHTML = '<span class="rb-adaptive-score">' + escapeHtml(raw) + '</span>';
                            return;
                        }

                        // Remaining long prose in any cell
                        if (raw.length > 100) {
                            applyClamp(cell, raw, 120);
                        }
