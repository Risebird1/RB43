                                break;
                            }
                        }
                    }
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + escapeHtml(item) + '</td>' +
                        '<td class="rb-ai-r-level">' + levelPillHtml(expected) + '</td>' +
                        '<td class="rb-ai-r-level">' + levelPillHtml(observed) + '</td>' +
                        '<td class="rb-ai-r-score">' + escapeHtml(score || '—') + '</td>';
                    tbody.appendChild(tr);
                });

                if (!tbody.children.length) return table;

                var parent = table.parentNode;
                if (parent) parent.replaceChild(built, table);
                return built;
            }

            var rubricTable = null;
            Array.prototype.forEach.call(root.querySelectorAll('table'), function (table) {
                if (rubricTable) return;
                if (table.closest('.rb-adaptive-q-section') || table.closest('.rb-ai-q-list')) return;
                var header = '';
                Array.prototype.forEach.call(table.querySelectorAll('th'), function (th) { header += ' ' + (th.textContent || ''); });
                if (!header.trim() && table.rows.length) {
                    Array.prototype.forEach.call(table.rows[0].cells, function (cell) { header += ' ' + (cell.textContent || ''); });
                }
                var h = header.toLowerCase();
                if (/question/.test(h) && /verdict|comment/.test(h) && !/competenc|rubric|expected|observed/.test(h)) return;
                if (/rubric|expected|observed|competenc|skill\s*name|self.?rating|ai.?rating|weight/.test(h)) {
                    rubricTable = table;
                }
            });

            var hasSummary = fields.techScore || fields.commScore || fields.verdict || fields.finalComment || fields.commReason || fields.llmSuspected || fields.llmEvidence;
            if (!rubricTable && !hasSummary) return;
            if (root.querySelector('.rb-adaptive-overview')) return;

            var overview = document.createElement('div');
            overview.className = 'rb-adaptive-overview';

            if (fields.techScore || fields.commScore) {
                var metrics = document.createElement('div');
                metrics.className = 'rb-adaptive-metrics';
                if (fields.techScore) {
                    metrics.innerHTML += '<div class="rb-adaptive-metric-card"><span class="rb-adaptive-metric-card__label">Overall Skill Score</span><span class="rb-adaptive-metric-card__value">' + escapeHtml(fields.techScore) + '</span></div>';
                }
                if (fields.commScore) {
                    metrics.innerHTML += '<div class="rb-adaptive-metric-card"><span class="rb-adaptive-metric-card__label">Communication Score</span><span class="rb-adaptive-metric-card__value">' + escapeHtml(fields.commScore) + '</span></div>';
                }
                overview.appendChild(metrics);
            }

            var twoCol = document.createElement('div');
            twoCol.className = 'rb-ai-two-col';

            var left = document.createElement('div');
            left.className = 'rb-adaptive-panel';
            left.innerHTML =
                '<div class="rb-adaptive-panel__head">' +
                '<img src="/img/techskill-score.png" alt="" />' +
                '<span class="rb-ai-panel__title">Score Rubric</span>' +
                '</div>';
            if (rubricTable) {
                var wrap = rubricTable.closest('.rb-adaptive-table-wrap') || rubricTable;
                var probe = wrap.previousElementSibling;
                if (probe && /rubric|competenc|skill/i.test(t(probe)) && t(probe).length < 80) {
                    probe.parentNode.removeChild(probe);
                }
                rubricTable = normalizeRubricTableToVideoFormat(rubricTable);
                wrap = rubricTable.closest('.rb-adaptive-table-wrap') || rubricTable;
                if (wrap === rubricTable) {
                    var newWrap = document.createElement('div');
                    newWrap.className = 'rb-ai-table-wrap';
                    newWrap.appendChild(rubricTable);
                    wrap = newWrap;
                } else if (wrap.classList) {
                    wrap.classList.add('rb-ai-table-wrap');
                }
                left.appendChild(wrap);
            } else {
                left.innerHTML += '<p class="rb-ai-no-data-inline">No rubric summary found.</p>';
            }
            twoCol.appendChild(left);

            var right = document.createElement('div');
            right.className = 'rb-adaptive-panel rb-adaptive-panel--comment';
            var rightHtml =
                '<div class="rb-adaptive-panel__head">' +
                '<img src="/img/interviewer-comment.png" alt="" />' +
                '<span class="rb-ai-panel__title">AI Interviewer Comment</span>' +
                '</div>';
            if (fields.verdict) {
                rightHtml += '<div class="rb-ai-comment-label">Final Verdict</div><div style="margin-bottom:8px;"><span class="rb-adaptive-verdict-badge ' + verdictClass(fields.verdict) + '">' + escapeHtml(fields.verdict) + '</span></div>';
            }
            if (fields.finalComment) {
                rightHtml += '<div class="rb-ai-comment-label">Final Comment</div>' + clampHtml(fields.finalComment, 150);
            }
            if (fields.commReason) {
                rightHtml += '<div class="rb-ai-comment-label">Communication Score Reasoning</div>' + clampHtml(fields.commReason, 150);
            }
            if (fields.llmSuspected || fields.llmEvidence) {
                rightHtml += '<div class="rb-ai-comment-label">LLM Detection</div>';
                if (fields.llmSuspected) {
                    rightHtml += '<div class="rb-adaptive-field__value" style="margin-bottom:6px;"><strong>Suspected:</strong> ' + escapeHtml(fields.llmSuspected) + '</div>';
                }
                if (fields.llmEvidence) {
                    rightHtml += '<div class="rb-ai-comment-label" style="margin-top:6px;">Evidence</div>' + clampHtml(fields.llmEvidence, 120);
                }
            }
            if (!fields.verdict && !fields.finalComment && !fields.commReason && !fields.llmSuspected && !fields.llmEvidence) {
                rightHtml += '<p class="rb-ai-no-data-inline">No comment found.</p>';
            }
            right.innerHTML = rightHtml;
            twoCol.appendChild(right);

            overview.appendChild(twoCol);
            root.insertBefore(overview, root.firstChild);

            var seen = {};
            toRemove.forEach(function (el) {
                if (!el || !el.parentNode || seen[el]) return;
                if (overview.contains(el)) return;
                seen[el] = true;
                el.parentNode.removeChild(el);
            });

            // Remove leftover duplicate summary lines still in the raw HTML
            Array.prototype.forEach.call(root.querySelectorAll('p, div, li, h2, h3, h4, strong, b, span'), function (el) {
                if (!el.parentNode || overview.contains(el) || el.closest('table')) return;
                if (el.querySelector('table, .rb-adaptive-overview, .rb-adaptive-q-block, .rb-adaptive-panel')) return;
                var raw = t(el);
                if (!raw) return;
                if (/^(Overall\s+Technical\s+Score|(?:Overall\s+)?Communication\s+Score|Final\s+Verdict|Final\s+Comment|Communication\s+Score\s+Reasoning|Communication\s+Comments?|LLM\s+Detection|LLM\s+Response\s+Suspected|Evidence\s+Comment)\s*:?\s*$/i.test(raw) ||
                    /^(Overall\s+Technical\s+Score|(?:Overall\s+)?Communication\s+Score|Final\s+Verdict|Final\s+Comment|Communication\s+Score\s+Reasoning|Communication\s+Comments?|LLM\s+Detection|LLM\s+Response\s+Suspected|Evidence\s+Comment)\s*:/i.test(raw)) {
                    el.parentNode.removeChild(el);
                }
            });

            // After competency/rubric table: drop stray <hr>, LLM Detection headings, and empty leftovers
            Array.prototype.forEach.call(root.querySelectorAll('hr'), function (hr) {
                if (!hr.parentNode || overview.contains(hr)) return;
                hr.parentNode.removeChild(hr);
            });

            Array.prototype.forEach.call(root.querySelectorAll('h1, h2, h3, h4, h5, p, div, strong, b, span'), function (el) {
                if (!el.parentNode || overview.contains(el) || el.closest('table')) return;
                if (el.querySelector && el.querySelector('table, .rb-adaptive-overview, .rb-adaptive-q-block, .rb-adaptive-panel, .rb-adaptive-q-head')) return;
                var raw = t(el);
                if (!raw) {
                    // remove empty wrappers left behind
                    if ((el.tagName === 'P' || el.tagName === 'DIV') && !el.children.length) {
                        el.parentNode.removeChild(el);
                    }
                    return;
                }
                if (/^LLM\s*Detection$/i.test(raw) ||
                    /^LLM\s+Response\s+Suspected\s*:/i.test(raw) ||
                    /^Evidence\s+Comment\s*:/i.test(raw)) {
                    el.parentNode.removeChild(el);
                }
            });
        }

        function convertQuestionByQuestionToCards() {
            function txt(el) { return ((el && el.textContent) || '').replace(/\s+/g, ' ').trim(); }
            function escapeHtml(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
            function verdictPillClass(v) {
                var x = (v || '').toLowerCase();
                if (/reject|incorrect|fail|poor|negative|no\b/.test(x)) return 'rb-ai-verdict-pill--reject';
                if (/select|correct|pass|positive|hire|strong|excellent|good/.test(x)) return 'rb-ai-verdict-pill--select';
                if (/average|fair|moderate|partial/.test(x)) return 'rb-ai-verdict-pill--avg';
                return 'rb-ai-verdict-pill--neutral';
            }
            function colIdx(headers, re) {
                for (var i = 0; i < headers.length; i++) {
                    if (re.test(headers[i])) return i;
                }
                return -1;
            }
            function findSectionTitle(node) {
                var el = node;
                for (var hops = 0; hops < 4 && el; hops++) {
                    var prev = el.previousElementSibling;
                    while (prev) {
                        var t = txt(prev);
                        if (t && t.length < 100 && /question[- ]?by[- ]?question|question\s+ratings?/i.test(t)) return prev;
                        if (prev.querySelector && prev.querySelector('table')) break;
                        if (t && t.length > 2) break;
                        prev = prev.previousElementSibling;
                    }
                    el = el.parentElement;
                    if (el === root) break;
                }
                return null;
            }

            Array.prototype.slice.call(root.querySelectorAll('table')).forEach(function (table) {
                if (table.closest('.rb-adaptive-overview') || table.closest('.rb-adaptive-panel') || table.closest('.rb-ai-q-list')) return;

                var headerCells = table.querySelectorAll('thead th');
                var headerRowIsTd = false;
                if (!headerCells.length && table.rows.length) {
                    headerCells = table.rows[0].querySelectorAll('th, td');
                    headerRowIsTd = table.rows[0].querySelector('th') == null;
                }
                if (!headerCells.length) return;

                var headers = [];
                Array.prototype.forEach.call(headerCells, function (cell, idx) {
                    headers[idx] = txt(cell).toLowerCase();
                });
                var headerJoined = headers.join(' ');
                var hasQuestion = /question/.test(headerJoined);
                var hasScoreOrVerdict = /score|verdict|rating/.test(headerJoined);
                var hasComment = /comment|remark|feedback/.test(headerJoined);
                var isCompetency = /competenc|skill\s*name|self.?rating|ai.?rating|rubric|weight/.test(headerJoined);
                if (!hasQuestion || !(hasScoreOrVerdict || hasComment) || isCompetency) return;

                var qIdx = colIdx(headers, /^#+$|^no\.?$|^q\.?$|number|s\.?\s*no/i);
                if (qIdx < 0) qIdx = colIdx(headers, /^question$/);
                var questionIdx = colIdx(headers, /question/);
                if (questionIdx < 0) return;
                // If # and Question are the same column (header is just "Question"), keep num from row index
                if (qIdx === questionIdx) qIdx = -1;
                var scoreIdx = colIdx(headers, /^score$|skill\s*score|rating\s*score/);
                if (scoreIdx < 0) scoreIdx = colIdx(headers, /score/);
                var verdictIdx = colIdx(headers, /verdict|rating(?!\s*score)|result|status/);
                var commentIdx = colIdx(headers, /comment|remark|feedback/);
                var commScoreIdx = colIdx(headers, /comm.*score|communication\s*score/);
                var commCommentIdx = colIdx(headers, /comm.*comment|communication\s*comment/);

                var bodyRows = table.tBodies.length
                    ? Array.prototype.slice.call(table.tBodies[0].rows)
                    : Array.prototype.slice.call(table.rows, (table.querySelector('thead') || headerRowIsTd) ? 1 : 0);
                if (headerRowIsTd && bodyRows.length && bodyRows[0] === table.rows[0]) {
                    bodyRows = bodyRows.slice(1);
                }
                if (!bodyRows.length) return;

                var titleEl = findSectionTitle(table.parentElement && table.parentElement.classList.contains('rb-adaptive-table-wrap')
                    ? table.parentElement
                    : table);
                var titleText = titleEl ? txt(titleEl) : 'Question-by-Question Ratings';

                var panel = document.createElement('div');
                panel.className = 'rb-ai-panel rb-ai-panel--full rb-adaptive-q-section';
                panel.innerHTML =
                    '<div class="rb-ai-panel__head">' +
                    '<img src="/img/question-asked.png" alt="" />' +
                    '<span class="rb-ai-panel__title">' + escapeHtml(titleText) + '</span>' +
                    '</div>';

                var list = document.createElement('div');
                list.className = 'rb-ai-q-list';

                bodyRows.forEach(function (row, rowIndex) {
                    var cells = row.cells;
                    if (!cells || !cells.length) return;
                    function cellText(i) {
                        if (i < 0 || !cells[i]) return '';
                        return txt(cells[i]);
                    }
                    var num = qIdx >= 0 ? cellText(qIdx) : String(rowIndex + 1);
                    num = (num.match(/\d+/) || [String(rowIndex + 1)])[0];
                    var question = cellText(questionIdx);
                    if (!question) return;
                    var score = scoreIdx >= 0 ? cellText(scoreIdx) : '';
                    var verdict = verdictIdx >= 0 ? cellText(verdictIdx) : '';
                    var comment = commentIdx >= 0 ? cellText(commentIdx) : '';
                    var commScore = commScoreIdx >= 0 ? cellText(commScoreIdx) : '';
                    var commComment = commCommentIdx >= 0 ? cellText(commCommentIdx) : '';

                    var card = document.createElement('div');
                    card.className = 'rb-ai-q-card';
                    var html =
                        '<div class="rb-ai-q-card__head">' +
                        '<span class="rb-ai-q-card__num">' + escapeHtml(num) + '</span>' +
                        '<div class="rb-ai-q-card__text">' + escapeHtml(question) + '</div>' +
                        '</div>';

                    var metaParts = [];
                    if (verdict) {
                        metaParts.push(
                            '<span class="rb-ai-meta-chip"><strong>Rating</strong> ' +
                            '<span class="rb-ai-verdict-pill ' + verdictPillClass(verdict) + '">' + escapeHtml(verdict) + '</span></span>'
                        );
                    }
                    if (score) {
                        metaParts.push('<span class="rb-ai-meta-chip"><strong>Score</strong> ' + escapeHtml(score) + '</span>');
                    }
                    if (commScore) {
                        metaParts.push('<span class="rb-ai-meta-chip"><strong>Comm.</strong> ' + escapeHtml(commScore) + '</span>');
                    }
                    if (metaParts.length) {
                        html += '<div class="rb-ai-q-card__meta">' + metaParts.join('') + '</div>';
                    }
                    if (comment) {
                        html += '<div class="rb-ai-q-card__note"><span class="rb-ai-q-card__note-label">Comment</span>' + escapeHtml(comment) + '</div>';
                    }
                    if (commComment) {
                        html += '<div class="rb-ai-q-card__note"><span class="rb-ai-q-card__note-label">Comm. Comment</span>' + escapeHtml(commComment) + '</div>';
                    }
                    card.innerHTML = html;
                    list.appendChild(card);
                });

                if (!list.children.length) return;
                panel.appendChild(list);

                var replaceTarget = table;
                if (table.parentElement && table.parentElement.classList.contains('rb-adaptive-table-wrap')) {
                    replaceTarget = table.parentElement;
                }
                replaceTarget.parentNode.insertBefore(panel, replaceTarget);
                replaceTarget.parentNode.removeChild(replaceTarget);
                if (titleEl && titleEl.parentNode) {
                    titleEl.parentNode.removeChild(titleEl);
                }
            });
        }

        convertQuestionByQuestionToCards();
        enhanceRatingTables();
        layoutRubricAndSummary();
        styleCompetencyHeadingLikeRubric();
        cleanupLeftoverLlmAndHrs();
        decorateLabels(root);

        function styleCompetencyHeadingLikeRubric() {
            function txt(el) { return ((el && el.textContent) || '').replace(/\s+/g, ' ').trim(); }
            Array.prototype.forEach.call(root.querySelectorAll('h1, h2, h3, h4, h5, p, div, strong, b'), function (el) {
                if (el.closest('.rb-adaptive-overview') || el.closest('.rb-adaptive-panel')) return;
                if (el.querySelector && el.querySelector('table')) return;
                var raw = txt(el);
                if (!raw || raw.length > 90) return;
                if (!/competenc(y|ies)?\s*rating|questions?\s+discussed/i.test(raw)) return;

                var head = document.createElement('div');
                head.className = 'rb-adaptive-panel__head rb-adaptive-table-title';
                var title = /questions?\s+discussed/i.test(raw)
                    ? 'Questions Discussed &amp; Competency Rating'
                    : 'Competency Ratings';
                head.innerHTML =
                    '<img src="/img/question-asked.png" alt="" />' +
                    '<span class="rb-ai-panel__title">' + title + '</span>';

                // Wrap heading + following table in a section card like Score Rubric panel
                var card = document.createElement('div');
                card.className = 'rb-adaptive-section-card';
                el.parentNode.insertBefore(card, el);
                card.appendChild(head);

                var node = el.nextSibling;
                el.parentNode.removeChild(el);

                // Move immediate following table/wrap into the card
                while (node) {
                    var next = node.nextSibling;
                    if (node.nodeType === 3 && !String(node.textContent || '').trim()) {
                        card.appendChild(node);
                        node = next;
                        continue;
                    }
                    if (node.nodeType === 1) {
                        if (node.tagName === 'TABLE' || (node.classList && node.classList.contains('rb-adaptive-table-wrap'))) {
                            card.appendChild(node);
                            break;
                        }
                        if (node.querySelector && node.querySelector('table.rb-adaptive-rating-table, table')) {
                            card.appendChild(node);
                            break;
                        }
                        break;
                    }
                    break;
                }
            });
        }

        function cleanupLeftoverLlmAndHrs() {
            function txt(el) { return ((el && el.textContent) || '').replace(/\s+/g, ' ').trim(); }
            function isLlmJunk(raw) {
                if (!raw) return false;
                return /^LLM\s*Detection$/i.test(raw) ||
                    /^LLM\s+Detection\s*:/i.test(raw) ||
                    /^LLM\s+Response\s+Suspected\s*:/i.test(raw) ||
                    /^Evidence\s+Comment\s*:/i.test(raw) ||
                    /^Suspected\s*:/i.test(raw);
            }

            // Remove all hrs outside overview
            Array.prototype.forEach.call(root.querySelectorAll('hr'), function (hr) {
                if (!hr.parentNode || hr.closest('.rb-adaptive-overview')) return;
                hr.parentNode.removeChild(hr);
            });

            // Remove LLM Detection blocks anywhere below overview / after tables
            Array.prototype.slice.call(root.querySelectorAll('h1, h2, h3, h4, h5, p, div, strong, b, span, li')).forEach(function (el) {
                if (!el.parentNode || el.closest('.rb-adaptive-overview') || el.closest('table')) return;
                if (el.closest('.rb-adaptive-panel') || el.closest('.rb-adaptive-section-card')) return;
                if (el.closest('.rb-adaptive-q-section') || el.closest('.rb-ai-q-card') || el.closest('.rb-ai-panel')) return;
                if (el.querySelector && el.querySelector('table, .rb-adaptive-overview, .rb-adaptive-q-block, .rb-adaptive-panel, .rb-adaptive-q-head, .rb-adaptive-clamp, .rb-adaptive-section-card, .rb-adaptive-q-section, .rb-ai-q-list')) return;
                var raw = txt(el);
                if (isLlmJunk(raw)) {
                    el.parentNode.removeChild(el);
                }
            });

            // After first rating table / section card: strip consecutive junk siblings (hr, llm h3/text)
            var anchors = root.querySelectorAll('.rb-adaptive-overview, .rb-adaptive-section-card, .rb-adaptive-q-section, table.rb-adaptive-rating-table');
            Array.prototype.forEach.call(anchors, function (anchor) {
                var cut = anchor;
                while (cut.parentElement && cut.parentElement !== root) cut = cut.parentElement;
                if (cut.parentElement !== root) return;
                var sib = cut.nextSibling;
                while (sib) {
                    var next = sib.nextSibling;
                    if (sib.nodeType === 3) {
                        if (!String(sib.textContent || '').trim()) {
                            cut.parentNode.removeChild(sib);
                        } else if (/LLM\s*Detection/i.test(sib.textContent || '')) {
                            cut.parentNode.removeChild(sib);
                        } else {
                            break;
                        }
                        sib = next;
                        continue;
                    }
                    if (sib.nodeType !== 1) { sib = next; continue; }
                    if (sib.classList && (sib.classList.contains('rb-adaptive-q-block') || sib.classList.contains('rb-adaptive-section-card') || sib.classList.contains('rb-adaptive-overview') || sib.classList.contains('rb-adaptive-q-section'))) break;
                    if (sib.querySelector && sib.querySelector('.rb-adaptive-q-head, .rb-adaptive-q-block, .rb-adaptive-q-section, table')) break;
                    var tag = sib.tagName;
                    var raw = txt(sib);
                    if (tag === 'HR' || isLlmJunk(raw) || !raw) {
                        cut.parentNode.removeChild(sib);
                        sib = next;
                        continue;
                    }
                    // Stop when real content (questions etc.) begins
                    if (/question|competenc|analysis|strength|weakness|evidence from transcript/i.test(raw) && !isLlmJunk(raw)) break;
                    if (/LLM/i.test(raw) && raw.length < 80) {
                        cut.parentNode.removeChild(sib);
                        sib = next;
                        continue;
                    }
                    break;
                }
            });
        }

    });
</script>
<script>
    function GetSentimentAnalysis(videoId) {
        $.ajax({
            type: "POST",
            url: "/Candidate/GetSentimentAnalysis",
            data: { 'videoId': videoId },
            success: function (data) {
                if (data && data.success) {
                    alert('Successful.');
                    setTimeout(function () {
                        location.reload();
                    }, 2000);
                }
                else {
                    alert((data && data.message) ? data.message : 'Sentiment analysis failed.');
                }
            },
            error: function () {
                alert('Sentiment analysis could not be completed. The request may have timed out; reload the report to check whether it finished.');
            }
        });
    }
</script>

<script>
    // Animate sentiment gauge on page load
    document.addEventListener('DOMContentLoaded', function () {
        // Large gauge in score card
        const gaugeFill = document.querySelector('.sentiment-gauge-fill');
        if (gaugeFill) {
            const score = parseInt(gaugeFill.getAttribute('data-score')) || 0;
            const positiveScore = score > 0 ? score : 0;
            const circumference = 565.48; // 2 * π * 90
            const offset = circumference - (circumference * positiveScore / 100);

            // Set initial value (full circle)
            gaugeFill.style.strokeDashoffset = circumference.toString();

            // Animate to actual value
            setTimeout(() => {
                gaugeFill.style.strokeDashoffset = offset.toString();
            }, 100);
        }

        // Small gauge in metrics section
        const metricGauge = document.querySelector('.sentiment-metric-gauge');
        if (metricGauge) {
            const score = parseInt(metricGauge.getAttribute('data-score')) || 0;
            const positiveScore = score > 0 ? score : 0;
            const circumference = 251.33; // 2 * π * 40
            const offset = circumference - (circumference * positiveScore / 100);
            const gaugeFillCircle = metricGauge.querySelector('.sentiment-metric-gauge-fill');

            if (gaugeFillCircle) {
                // Set initial value (full circle)
                gaugeFillCircle.style.strokeDashoffset = circumference.toString();

                // Animate to actual value
                setTimeout(() => {
                    gaugeFillCircle.style.strokeDashoffset = offset.toString();
                }, 150);
            }
        }

        // Animate modifier tag gauges and progress bars
        const modifierTagGauges = document.querySelectorAll('.modifier-tag-gauge-fill');
        modifierTagGauges.forEach((gauge, index) => {
            const percent = parseFloat(gauge.getAttribute('data-percent')) || 0;
            const circumference = 2 * Math.PI * 20; // radius = 20
            const offset = circumference - (circumference * percent / 100);

            setTimeout(() => {
                gauge.style.strokeDashoffset = offset;
            }, 200 + (index * 100));
        });

        // Animate modifier tag progress bars
        const modifierTagProgressBars = document.querySelectorAll('.modifier-tag-progress-fill');
        modifierTagProgressBars.forEach((bar, index) => {
            const width = parseFloat(bar.getAttribute('data-width')) || 0;
            setTimeout(() => {
                bar.style.width = width + '%';
            }, 300 + (index * 100));
        });

        // Alternative approach: Move popups to body element to avoid stacking context issues
        const modifierTags = document.querySelectorAll('.modifier-tag');
        modifierTags.forEach(tag => {
            let activePopup = null;
            let popupClone = null;
            let hideTimeout = null;

            tag.addEventListener('mouseenter', function () {
                // Clear any pending hide timeout
                if (hideTimeout) {
                    clearTimeout(hideTimeout);
                    hideTimeout = null;
                }

                const originalPopup = this.querySelector('.modifier-popup');
                if (!originalPopup) return;

                // Clone the popup and append to body to avoid parent container issues
                if (!popupClone) {
                    popupClone = originalPopup.cloneNode(true);
                    popupClone.classList.add('modifier-popup-active');
                    popupClone.style.display = 'none';
                    document.body.appendChild(popupClone);

                    // Set up popup hover handlers
                    popupClone.addEventListener('mouseenter', function () {
                        if (hideTimeout) {
                            clearTimeout(hideTimeout);
                            hideTimeout = null;
                        }
                        this.style.opacity = '1';
                        this.style.display = 'block';
                    });

                    popupClone.addEventListener('mouseleave', function () {
                        this.style.opacity = '0';
                        this.style.visibility = 'hidden';
                        this.style.display = 'none';
                        this.style.maxHeight = '';
                        this.style.overflowY = '';
                    });
                }

                activePopup = popupClone;

                // Show and measure
                activePopup.style.display = 'block';
                activePopup.style.visibility = 'visible';
                activePopup.style.opacity = '0';
                activePopup.style.position = 'fixed';
                activePopup.style.zIndex = '999999';
                activePopup.style.left = '-9999px';
                activePopup.style.top = '-9999px';
                activePopup.style.maxWidth = '380px';
                activePopup.style.width = 'auto';

                // Force layout
                void activePopup.offsetWidth;

                const rect = this.getBoundingClientRect();
                const popupRect = activePopup.getBoundingClientRect();
                const viewportWidth = window.innerWidth;
                const viewportHeight = window.innerHeight;
                const popupWidth = popupRect.width || 300;
                const popupHeight = popupRect.height || 200;

                // Calculate position
                const centerX = rect.left + (rect.width / 2);
                const popupLeft = centerX - (popupWidth / 2);
                const popupRight = centerX + (popupWidth / 2);

                let finalLeft;
                if (popupRight > viewportWidth - 20) {
                    finalLeft = viewportWidth - popupWidth - 20;
                    if (finalLeft < 20) {
                        finalLeft = 20;
                        activePopup.style.maxWidth = (viewportWidth - 40) + 'px';
                    }
                } else if (popupLeft < 20) {
                    finalLeft = 20;
                } else {
                    finalLeft = popupLeft;
                }

                // Vertical positioning - prioritize showing above for top row items
                let finalTop;
                const spaceBelow = viewportHeight - rect.bottom - 20;
                const spaceAbove = rect.top - 20;

                // Check if item is in top portion of viewport (first 30% or less than 150px from top)
                const isTopRow = rect.top < (viewportHeight * 0.3) || rect.top < 150;

                // If it's a top row item or there's more space above than below, show above
                if (isTopRow || (spaceAbove >= popupHeight && spaceAbove > spaceBelow)) {
                    finalTop = rect.top - popupHeight - 12;
                    // If popup would go off top, adjust
                    if (finalTop < 20) {
                        // Show below with scrolling if there's minimum space
                        finalTop = rect.bottom + 8;
                        const maxHeight = viewportHeight - finalTop - 20;
                        if (maxHeight > 100) {
                            activePopup.style.maxHeight = maxHeight + 'px';
                            activePopup.style.overflowY = 'auto';
                        } else {
                            // Very little space, position at top of viewport
                            finalTop = 20;
                            activePopup.style.maxHeight = (viewportHeight - 40) + 'px';
                            activePopup.style.overflowY = 'auto';
                        }
                    } else {
                        // Enough space above, show there
                        activePopup.style.maxHeight = '';
                        activePopup.style.overflowY = '';
                    }
                } else {
                    // Show below (default)
                    finalTop = rect.bottom + 8;
                    const finalBottom = finalTop + popupHeight;
                    if (finalBottom > viewportHeight - 20) {
                        // Not enough space below, try showing above
                        if (spaceAbove >= popupHeight) {
                            finalTop = rect.top - popupHeight - 12;
                            if (finalTop < 20) finalTop = 20;
                            activePopup.style.maxHeight = '';
                            activePopup.style.overflowY = '';
                        } else {
                            // No good option, show below with scroll
                            const maxHeight = viewportHeight - finalTop - 20;
                            if (maxHeight > 100) {
                                activePopup.style.maxHeight = maxHeight + 'px';
                                activePopup.style.overflowY = 'auto';
                            } else {
                                finalTop = Math.max(20, rect.top - popupHeight - 12);
                                activePopup.style.maxHeight = '';
                                activePopup.style.overflowY = '';
                            }
                        }
                    } else {
                        // Enough space below, show there
                        activePopup.style.maxHeight = '';
                        activePopup.style.overflowY = '';
                    }
                }

                // Position and show
                activePopup.style.left = finalLeft + 'px';
                activePopup.style.top = finalTop + 'px';
                activePopup.style.opacity = '1';
                activePopup.style.pointerEvents = 'auto';

                // Animate progress bars + apply level colors
                const progressBars = activePopup.querySelectorAll('.confidence-progress-bar');
                progressBars.forEach(bar => {
                    bar.style.width = '0%';
                    const confidenceValue = parseFloat(bar.getAttribute('data-confidence')) || 0;

                    // apply color class based on value
                    bar.classList.remove('confidence-high', 'confidence-medium', 'confidence-low', 'confidence-normal');
                    if (confidenceValue >= 70) {
                        bar.classList.add('confidence-high');
                    } else if (confidenceValue >= 40) {
                        bar.classList.add('confidence-medium');
                    } else if (confidenceValue > 0) {
                        bar.classList.add('confidence-low');
                    } else {
                        bar.classList.add('confidence-normal');
                    }

                    setTimeout(() => {
                        bar.style.width = confidenceValue + '%';
                    }, 100);
                });
            });

            tag.addEventListener('mouseleave', function () {
                if (activePopup) {
                    // Delay hiding to allow mouse to move to popup
                    hideTimeout = setTimeout(() => {
                        if (activePopup) {
                            activePopup.style.opacity = '0';
                            activePopup.style.visibility = 'hidden';
                            activePopup.style.display = 'none';
                            activePopup.style.maxHeight = '';
                            activePopup.style.overflowY = '';
                            activePopup.style.maxWidth = '';
                        }
                    }, 100);
                }
            });
        });
    });
</script>
<style>
    /* Enhanced modal header and body for Aadhaar KYC popup, matching CreateMCQPopUp */
    .enhanced-modal-header {
        background: linear-gradient(135deg, #667eea 0%, #2CA8FF 100%);
        color: white;
        padding: 15px 32px;
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }


