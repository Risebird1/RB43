<script>
    // Animate sentiment gauge on page load
    document.addEventListener('DOMContentLoaded', function () {
        // Large gauge in score card
        const gaugeFill = document.querySelector('.sentiment-gauge-fill');
        if (gaugeFill) {
            const score = parseInt(gaugeFill.getAttribute('data-score')) || 0;
            const positiveScore = score > 0 ? score : 0;
            const circumference = 565.48; // 2 * π * 90
            const offset = circumference - (circumference * positiveScore / 100);

            // Set initial value (full circle)
            gaugeFill.style.strokeDashoffset = circumference.toString();

            // Animate to actual value
            setTimeout(() => {
                gaugeFill.style.strokeDashoffset = offset.toString();
            }, 100);
        }

        // Small gauge in metrics section
        const metricGauge = document.querySelector('.sentiment-metric-gauge');
        if (metricGauge) {
            const score = parseInt(metricGauge.getAttribute('data-score')) || 0;
            const positiveScore = score > 0 ? score : 0;
            const circumference = 251.33; // 2 * π * 40
            const offset = circumference - (circumference * positiveScore / 100);
            const gaugeFillCircle = metricGauge.querySelector('.sentiment-metric-gauge-fill');

            if (gaugeFillCircle) {
                // Set initial value (full circle)
                gaugeFillCircle.style.strokeDashoffset = circumference.toString();

                // Animate to actual value
                setTimeout(() => {
                    gaugeFillCircle.style.strokeDashoffset = offset.toString();
                }, 150);
            }
        }

        // Animate modifier tag gauges and progress bars
        const modifierTagGauges = document.querySelectorAll('.modifier-tag-gauge-fill');
        modifierTagGauges.forEach((gauge, index) => {
            const percent = parseFloat(gauge.getAttribute('data-percent')) || 0;
            const circumference = 2 * Math.PI * 20; // radius = 20
            const offset = circumference - (circumference * percent / 100);

            setTimeout(() => {
                gauge.style.strokeDashoffset = offset;
            }, 200 + (index * 100));
        });

        // Animate modifier tag progress bars
        const modifierTagProgressBars = document.querySelectorAll('.modifier-tag-progress-fill');
        modifierTagProgressBars.forEach((bar, index) => {
            const width = parseFloat(bar.getAttribute('data-width')) || 0;
            setTimeout(() => {
                bar.style.width = width + '%';
            }, 300 + (index * 100));
        });

        // Alternative approach: Move popups to body element to avoid stacking context issues
        const modifierTags = document.querySelectorAll('.modifier-tag');
        modifierTags.forEach(tag => {
            let activePopup = null;
            let popupClone = null;
            let hideTimeout = null;

            tag.addEventListener('mouseenter', function () {
                // Clear any pending hide timeout
                if (hideTimeout) {
                    clearTimeout(hideTimeout);
                    hideTimeout = null;
                }

                const originalPopup = this.querySelector('.modifier-popup');
                if (!originalPopup) return;

                // Clone the popup and append to body to avoid parent container issues
                if (!popupClone) {
                    popupClone = originalPopup.cloneNode(true);
                    popupClone.classList.add('modifier-popup-active');
                    popupClone.style.display = 'none';
                    document.body.appendChild(popupClone);

                    // Set up popup hover handlers
                    popupClone.addEventListener('mouseenter', function () {
                        if (hideTimeout) {
                            clearTimeout(hideTimeout);
                            hideTimeout = null;
                        }
                        this.style.opacity = '1';
                        this.style.display = 'block';
                    });

                    popupClone.addEventListener('mouseleave', function () {
                        this.style.opacity = '0';
                        this.style.visibility = 'hidden';
                        this.style.display = 'none';
                        this.style.maxHeight = '';
                        this.style.overflowY = '';
                    });
                }

                activePopup = popupClone;

                // Show and measure
                activePopup.style.display = 'block';
                activePopup.style.visibility = 'visible';
                activePopup.style.opacity = '0';
                activePopup.style.position = 'fixed';
                activePopup.style.zIndex = '999999';
                activePopup.style.left = '-9999px';
                activePopup.style.top = '-9999px';
                activePopup.style.maxWidth = '380px';
                activePopup.style.width = 'auto';

                // Force layout
                void activePopup.offsetWidth;

                const rect = this.getBoundingClientRect();
                const popupRect = activePopup.getBoundingClientRect();
                const viewportWidth = window.innerWidth;
                const viewportHeight = window.innerHeight;
                const popupWidth = popupRect.width || 300;
                const popupHeight = popupRect.height || 200;

                // Calculate position
                const centerX = rect.left + (rect.width / 2);
                const popupLeft = centerX - (popupWidth / 2);
                const popupRight = centerX + (popupWidth / 2);

                let finalLeft;
                if (popupRight > viewportWidth - 20) {
                    finalLeft = viewportWidth - popupWidth - 20;
                    if (finalLeft < 20) {
                        finalLeft = 20;
                        activePopup.style.maxWidth = (viewportWidth - 40) + 'px';
                    }
                } else if (popupLeft < 20) {
                    finalLeft = 20;
                } else {
                    finalLeft = popupLeft;
                }

                // Vertical positioning - prioritize showing above for top row items
                let finalTop;
                const spaceBelow = viewportHeight - rect.bottom - 20;
                const spaceAbove = rect.top - 20;

                // Check if item is in top portion of viewport (first 30% or less than 150px from top)
                const isTopRow = rect.top < (viewportHeight * 0.3) || rect.top < 150;

                // If it's a top row item or there's more space above than below, show above
                if (isTopRow || (spaceAbove >= popupHeight && spaceAbove > spaceBelow)) {
                    finalTop = rect.top - popupHeight - 12;
                    // If popup would go off top, adjust
                    if (finalTop < 20) {
                        // Show below with scrolling if there's minimum space
                        finalTop = rect.bottom + 8;
                        const maxHeight = viewportHeight - finalTop - 20;
                        if (maxHeight > 100) {
                            activePopup.style.maxHeight = maxHeight + 'px';
                            activePopup.style.overflowY = 'auto';
                        } else {
                            // Very little space, position at top of viewport
                            finalTop = 20;
                            activePopup.style.maxHeight = (viewportHeight - 40) + 'px';
                            activePopup.style.overflowY = 'auto';
                        }
                    } else {
                        // Enough space above, show there
                        activePopup.style.maxHeight = '';
                        activePopup.style.overflowY = '';
                    }
                } else {
                    // Show below (default)
                    finalTop = rect.bottom + 8;
                    const finalBottom = finalTop + popupHeight;
                    if (finalBottom > viewportHeight - 20) {
                        // Not enough space below, try showing above
                        if (spaceAbove >= popupHeight) {
                            finalTop = rect.top - popupHeight - 12;
                            if (finalTop < 20) finalTop = 20;
                            activePopup.style.maxHeight = '';
                            activePopup.style.overflowY = '';
                        } else {
                            // No good option, show below with scroll
                            const maxHeight = viewportHeight - finalTop - 20;
                            if (maxHeight > 100) {
                                activePopup.style.maxHeight = maxHeight + 'px';
                                activePopup.style.overflowY = 'auto';
                            } else {
                                finalTop = Math.max(20, rect.top - popupHeight - 12);
                                activePopup.style.maxHeight = '';
                                activePopup.style.overflowY = '';
                            }
                        }
                    } else {
                        // Enough space below, show there
                        activePopup.style.maxHeight = '';
                        activePopup.style.overflowY = '';
                    }
                }

                // Position and show
                activePopup.style.left = finalLeft + 'px';
                activePopup.style.top = finalTop + 'px';
                activePopup.style.opacity = '1';
                activePopup.style.pointerEvents = 'auto';

                // Animate progress bars + apply level colors
                const progressBars = activePopup.querySelectorAll('.confidence-progress-bar');
                progressBars.forEach(bar => {
                    bar.style.width = '0%';
                    const confidenceValue = parseFloat(bar.getAttribute('data-confidence')) || 0;

                    // apply color class based on value
                    bar.classList.remove('confidence-high', 'confidence-medium', 'confidence-low', 'confidence-normal');
                    if (confidenceValue >= 70) {
                        bar.classList.add('confidence-high');
                    } else if (confidenceValue >= 40) {
                        bar.classList.add('confidence-medium');
                    } else if (confidenceValue > 0) {
                        bar.classList.add('confidence-low');
                    } else {
                        bar.classList.add('confidence-normal');
                    }

                    setTimeout(() => {
                        bar.style.width = confidenceValue + '%';
                    }, 100);
                });
            });

            tag.addEventListener('mouseleave', function () {
                if (activePopup) {
                    // Delay hiding to allow mouse to move to popup
                    hideTimeout = setTimeout(() => {
                        if (activePopup) {
                            activePopup.style.opacity = '0';
                            activePopup.style.visibility = 'hidden';
                            activePopup.style.display = 'none';
                            activePopup.style.maxHeight = '';
                            activePopup.style.overflowY = '';
                            activePopup.style.maxWidth = '';
                        }
                    }, 100);
                }
            });
        });
    });
</script>
<style>
    /* Enhanced modal header and body for Aadhaar KYC popup, matching CreateMCQPopUp */
    .enhanced-modal-header {
        background: linear-gradient(135deg, #667eea 0%, #2CA8FF 100%);
