@using Risebird.Entities.Data
@using Risebird.Entities.ViewModel
@using System.Linq
@using System.Text.Json
@using System.Web
@model AIInterviewReportWrapperClass
@{
    ViewData["Title"] = "AI Interview Report";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}

<style>
    /* Color Variations based on confidence */
    .modifier-tag.confidence-high .modifier-tag-gauge-fill {
        stroke: #28a745;
    }

    .modifier-tag.confidence-high .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #28a745, #34ce57);
    }

    .modifier-tag.confidence-medium .modifier-tag-gauge-fill {
        stroke: #ffc107;
    }

    .modifier-tag.confidence-medium .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #ffc107, #ffca2c);
    }

    .modifier-tag.confidence-low .modifier-tag-gauge-fill {
        stroke: #dc3545;
    }

    .modifier-tag.confidence-low .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #dc3545, #e4606d);
    }

    .modifier-tag.confidence-normal .modifier-tag-gauge-fill {
        stroke: #4a90e2;
    }

    .modifier-tag.confidence-normal .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #4a90e2, #5ba3f5);
    }

    .table-bordered {
        border: 1px solid #b3a7a740 !important;
    }

    .rb-report-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 32px rgba(78, 218, 146, 0.1);
    }

    .rb-report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 2px solid #f0f0f0;
    }

    .rb-report-title-section h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #000;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        letter-spacing: -1.5px;
    }

    .rb-report-title i {
        color: #97caf4;
    }

    .rb-report-subtitle {
        font-size: 1.1rem;
        color: #666;
        margin: 0;
    }

    .rb-report-meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
        text-align: right;
    }

    .rb-report-actions-row {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
        align-items: center;
    }

    .rb-report-date {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #666;
        font-size: 0.9rem;
    }

    .rb-report-section {
        margin-bottom: 40px;
    }

    .rb-section-header {
        margin-bottom: 24px;
    }

        .rb-section-header h2 {
            font-size: 1.35rem;
            font-weight: 600;
            color: #000;
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0;
        }

        .rb-section-header i {
            color: #97caf4;
        }

    .rb-summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .rb-summary-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .rb-summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

    .rb-card-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #4eda92 60%, #56e0cb 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
    }

        .rb-card-icon .fa-clock:before {
            position: relative;
            font-weight: 500;
            font-size: 22px;
        }

    .rb-card-content h3 {
        margin: 0 0 4px 0;
        font-size: 1rem;
        color: #666;
        font-weight: 500;
    }

    .rb-card-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #000;
    }

    .rb-analysis-content {
        background: #fafbfc;
        border-radius: 12px;
        padding: 0px 0px 10px 0px;
    }

    .rb-analysis-item {
        background: white;
        border-radius: 8px;
        padding: 10px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
    }

    .rb-analysis-header {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 12px;
    }

        .rb-analysis-header .fa-lightbulb:before {
            font-size: 17px;
        }

    .rb-analysis-title {
        font-weight: 400;
        color: #666;
        font-size: 14px;
    }

    .rb-analysis-text {
        line-height: 1.6;
        color: #333;
    }

    .rb-video-responses {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .rb-video-item {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .rb-video-header {
        display: inline-flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        width: 50%;
        float: left;
    }

    .rb-video-info h4 {
        margin: 0 0 8px 0;
        color: #000;
        font-weight: 600;
        font-size: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rb-question-number {
        background: linear-gradient(135deg, #4eda92 0%, #56e0cb 100%);
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .rb-question-separator {
        width: 2px;
        min-height: 400px;
        background: linear-gradient(180deg, transparent 0%, #4eda92 20%, #56e0cb 50%, #4eda92 80%, transparent 100%);
        margin: 0 30px;
        border-radius: 1px;
        opacity: 0.6;
        position: relative;
        display: inline-block;
        vertical-align: top;
        align-self: stretch;
    }

    .rb-question-separator-decorative {
        height: 1px;
        background: #e0e0e0;
        margin: 40px 0;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .rb-question-separator-decorative::before {
            content: "●";
            background: white;
            color: #4eda92;
            font-size: 1.2rem;
            padding: 0 15px;
            position: relative;
            z-index: 1;
        }

        .rb-question-separator:last-child,
        .rb-question-separator-decorative:last-child {
            display: none;
        }

    .rb-video-item {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: 1px solid #f0f0f0;
        margin-bottom: 0;
    }

        .rb-video-item:not(:last-child) {
            margin-bottom: 20px;
        }

    .rb-video-question {
        margin: 0 0 10px 0px;
        color: #666;
        line-height: 1.5;
        font-size: 15px;
        word-wrap: break-word;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .rb-video-status {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.9rem;
    }

    .rb-status-complete {
        color: #28a745;
    }

    .rb-status-pending {
        color: #ffc107;
    }

    .rb-video-player {
        width: 100%;
        max-width: 450px;
        float: left;
    }

    .rb-video-element {
        width: 100%;
        max-width: 435px;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: 9px #e9ecef solid;
    }

    .rb-chat-log-report {
        background: #fafbfc;
        border-radius: 12px;
        padding: 20px;
        max-height: 500px;
        overflow-y: auto;
    }

    .rb-chat-message-report {
        margin-bottom: 16px;
        padding: 16px;
        border-radius: 8px;
        background: white;
    }

    .rb-user-message {
        border-left: 4px solid #4eda92;
    }

    .rb-bot-message {
        border-left: 4px solid #007bff;
    }

    .rb-message-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .rb-message-role {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .rb-user-message .rb-message-role {
        color: #4eda92;
    }

    .rb-bot-message .rb-message-role {
        color: #007bff;
    }

    .rb-message-time {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.8rem;
        color: #999;
    }

    .rb-message-content {
        line-height: 1.5;
        color: #333;
    }

    .rb-no-data {
        text-align: center;
        padding: 40px;
        color: #666;
    }

        .rb-no-data i {
            font-size: 3rem;
            margin-bottom: 16px;
            color: #ccc;
        }

    .rb-report-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        margin-top: 40px;
        padding-top: 24px;
        border-top: 2px solid #f0f0f0;
    }

    .rb-action-btn {
        padding: 7px 8px;
        border-radius: 4px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        background: #42a5f5 !important;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 13px;
    }

    .rb-primary-btn {
        background: #4eda92;
        color: white;
    }

        .rb-primary-btn:hover {
            background: #45c085;
            transform: translateY(-1px);
        }

    .rb-secondary-btn {
        background: #6c757d;
        color: white;
    }

        .rb-secondary-btn:hover {
            background: #5a6268;
            transform: translateY(-1px);
        }

    .rb-back-btn {
        background: #e9ecef;
        color: #333;
        border: 1px solid #dee2e6;
    }

        .rb-back-btn:hover {
            background: #e9ecef;
            transform: translateY(-1px);
        }

    .video-audio {
        display: flex;
        align-items: flex-start;
        gap: 0;
    }

    .ai-tech-score {
        box-shadow: none;
        padding-right: 0px;
    }

    .ai-tech-score-wrapper {
        width: 29%;
    }

    .ai-coment-question-wrapper {
        width: 71%;
    }

    .ai-interviewer-cmt {
        box-shadow: none;
        padding: 20px 20px 0px 0px;
    }
    /* Final Verdict — match PublicCandidateStatus / dashboard-new (.selected / .rejected) */
    .ai-final-verdict-badge {
        font-size: 12px;
        padding: 2px 8px;
        display: inline-block;
        font-weight: 600;
        border-radius: 0.2rem;
        margin-left: 6px;
        vertical-align: middle;
    }

    .ai-final-verdict-select {
        background: #90ee9094;
        color: forestgreen;
    }

    .ai-final-verdict-reject {
        background: #fdebf3;
        color: #ee4936;
    }

    .ai-final-verdict-average {
        background: #fef9c3;
        color: #ca8a04;
    }

    .skill-teal {
        color: #fff !important;
        background-color: #009688 !important;
    }

    .ratecount-score {
        position: relative;
        top: 0px;
        color: #127430;
        right: 0px;
        font-weight: 500;
        width: 95px;
        display: block;
        border: 1px #c9e8c9bd solid;
        border-radius: 3px;
        padding: 0px 5px;
        line-height: 21px;
        background: #e7ede799;
        margin-bottom: 10px;
    }

    .question-scroll {
        height: 900px;
        overflow-y: scroll;
    }

    .rb-analysis-item {
        padding-bottom: 0px !important;
        margin: 0px !important;
    }
    /* Two-section layout: video placeholder + analysis */
    .rb-section-video {
        background: #f5f5f5;
        border: 1px dashed #ccc;
        border-radius: 8px;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rb-section-analysis {
        min-height: 120px;
    }
    /* Each analysis item row: video left, rb-analysis-item right */
    .rb-analysis-row {
        margin-bottom: 16px;
    }

        .rb-analysis-row .rb-section-video {
            min-height: 160px;
        }

    .rb-candidate-email,
    .rb-candidate-date {
        font-size: 1.1rem
    }
    /* Print Styles */
    @@media print {
        .rb-report-actions {
            display: none;
        }

        .rb-report-container {
            box-shadow: none;
            padding: 0;
        }
    }

    /* Responsive Design */
    @@media (max-width: 1024px) {
        .ai-tech-score-wrapper {
            width: 30% !important;
        }

        .ai-coment-question-wrapper {
            width: 70% !important;
        }
    }

    @@media (max-width: 991px) {
        .ai-interviewer-cmt {
            box-shadow: none;
            padding: 20px 20px 0px 20px !important;
        }

        .ai-tech-score-wrapper {
            width: 41% !important;
        }

        .ai-coment-question-wrapper {
            width: 58% !important;
        }

            .ai-coment-question-wrapper .col-lg-8.col-md-7.col-sm-12 {
                width: 100% !important;
            }
    }

    @@media (max-width: 768px) {
        .rb-report-header {
            flex-direction: column;
            gap: 16px;
        }

        .sentiment-score-header {
            text-align: center;
        }

        .sentiment-avatar {
            display: none
        }

        .sentiment-gauge-container {
            position: relative;
            height: 225px;
            margin: 0 auto;
            display: flex !important;
            text-align: center !important;
            width: 300px !important;
        }

        .sentiment-details {
            flex: 1;
            min-width: 100% !important;
        }

        .video-audio {
            display: inline-block;
        }

        .rb-report-meta {
            text-align: left;
        }

        .rb-report-actions-row {
            justify-content: flex-start;
        }

        .rb-summary-cards {
            grid-template-columns: 1fr;
        }

        .rb-report-actions {
            flex-direction: column;
        }

        .rb-video-header {
            flex-direction: column;
            gap: 12px;
        }

        .rb-video-item > div {
            flex-direction: column !important;
        }

        .rb-question-separator {
            float: left;
            margin: 20px 10px;
            background: linear-gradient(90deg, transparent 0%, #4eda92 20%, #56e0cb 50%, #4eda92 80%, transparent 100%);
        }

        .rb-video-header {
            width: 48%;
            float: left;
        }

        .rb-video-info .rb-video-element {
            width: 100% !important;
            height: auto;
        }
    }

    @@media (max-width: 767px) {
        .rb-video-info .rb-video-element {
            width: 100% !important;
        }

        .rb-video-header {
            width: 100% !important;
        }

        .table-sm-font {
            font-size: 1rem !important;
        }

        .rb-question-separator {
            width: 100%;
            min-height: 2px !important;
        }

        .ai-tech-score-wrapper, .ai-coment-question-wrapper {
            width: 100% !important;
        }

        .ai-tech-score {
            box-shadow: none;
            padding-right: 0px !important;
            padding-left: 0 !important;
        }

        .ai-coment-question-wrapper {
            padding: 10px !important;
            margin: 0px !important;
        }

        .question li {
            padding: 0px 19px !important;
            background-position: -1px 10px !important;
            background-size: 5% !important;
        }

        .rb-analysis-title {
            font-size: 1.1rem !important;
        }
    }

    .question ul {
        list-style: disc;
        margin: 0;
        padding: 0
    }

    .question li {
        font-size: 15px;
        padding: 0px 10px;
        /*  list-style: none; */
        /*  background-image: url(../../img/tick-mark-icon.svg); */
        /*    background-repeat: no-repeat; */
        background-position: 10px 8px;
        background-size: 3%;
        word-wrap: break-word;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .question label {
        font-size: 14px;
        margin: 4px 0px;
        color: #9A9A9A;
        padding: 0px 0px;
        font-weight: normal;
    }

    /* Enhanced Candidate Information Card Styles */
    .rb-candidate-info-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border: 1px solid #e9ecef;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
    }

        .rb-candidate-info-card:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            transform: translateY(-1px);
        }

    .rb-candidate-header {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .rb-candidate-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #97caf4 0%, #5a9bd4 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 4px 12px rgba(151, 202, 244, 0.3);
    }

    .rb-candidate-details {
        flex: 1;
    }

    .rb-candidate-name {
        font-size: 1.3rem;
        font-weight: 700;
        color: #000;
        margin: 0 0 8px 0;
        letter-spacing: -0.5px;
    }

    .rb-candidate-meta {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }

    .rb-candidate-email,
    .rb-candidate-date {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #666;
        /*  font-size: 0.95rem; */
        padding: 8px 12px;
        background: rgba(151, 202, 244, 0.1);
        border-radius: 8px;
        border: 1px solid rgba(151, 202, 244, 0.2);
    }

        .rb-candidate-email i,
        .rb-candidate-date i {
            color: #97caf4;
            font-size: 0.9rem;
        }

        .rb-candidate-email span,
        .rb-candidate-date span {
            font-weight: 500;
        }

    .sentiment-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0px 0px;
        position: relative;
    }

        /* Background decorative element */
        .sentiment-container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 165, 0, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(30%, -30%);
            pointer-events: none;
            z-index: 0;
        }

    .sentiment-content {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 30px;
        align-items: flex-start;
        flex-wrap: wrap;
        border-top: 2px solid #f0f0f026;
        border-radius: 10px;
    }

    /* Sentiment Score Card */
    .sentiment-score-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px 20px 30px 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        min-width: 350px;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-top: 2px solid #f0f0f026;
        border-radius: 10px;
    }

        .sentiment-score-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        }

    .sentiment-score-header {
        color: #000;
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .sentiment-gauge-container {
        position: relative;
        height: 225px;
        margin: 0 auto;
    }

    .sentiment-gauge {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        position: relative;
        transform: rotate(-90deg);
    }

    .sentiment-gauge-circle {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: #f0f0f0;
        stroke-width: 12;
    }

    .sentiment-gauge-fill {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: #FF6B35;
        stroke-width: 12;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.5s ease-out;
        stroke-dasharray: 565.48;
    }

    .sentiment-score-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(90deg);
        font-size: 3rem;
        font-weight: 700;
        color: #FF6B35;
        line-height: 1;
    }

    /* Main Content Card */
    .sentiment-main-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        overflow: visible;
        flex: 1;
        min-width: 500px;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }



    .sentiment-card-header {
        background: linear-gradient(135deg, #97caf4 0%, #5a9bd4 100%);
        padding: 14px 24px;
        color: #fff;
        font-weight: 600;
        font-size: 17px;
    }

    .sentiment-card-body {
        padding: 30px;
        display: flex;
        gap: 24px;
        align-items: flex-start;
        overflow: visible;
        position: relative;
    }

    .sentiment-avatar {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #fcfcfc 0%, #dbeaf7bd 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 2px solid #afd1ee;
        transition: transform 0.3s ease;
    }

        .sentiment-avatar:hover {
            transform: scale(1.05);
        }

    .sentiment-avatar-icon {
        width: 50px;
        height: 50px;
        stroke: #9abad6;
        fill: none;
        stroke-width: 2;
    }

    .sentiment-details {
        flex: 1;
        min-width: 0;
    }



    .sentiment-candidate-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 0.875rem;
        color: #666;
    }

    .sentiment-candidate-detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .sentiment-candidate-detail-item svg {
            width: 16px;
            height: 16px;
            color: #999;
            flex-shrink: 0;
        }

    .sentiment-star {
        width: 24px;
        height: 24px;
        color: #FF6B35;
        transition: transform 0.2s ease;
    }

        .sentiment-star.empty {
            color: #E0E0E0;
        }

        .sentiment-star:hover {
            transform: scale(1.2);
        }

    .sentiment-rating-container {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Sentiment Metrics Section */
    .sentiment-metrics {
        background: #fff;
        border-radius: 8px;
        margin-top: 10px;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        align-items: start;
        padding: 6px;
    }

    .sentiment-metric-section {
        display: flex;
        flex-direction: column;
    }

    .top-modifiers-section {
        grid-column: 1 / -1;
        margin-top: 8px;
    }

    .sentiment-metric-label {
        font-size: 16px;
        font-weight: 700;
        color: #6eaade;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .sentiment-metric-value {
        font-size: 2rem;
        font-weight: 600;
        color: #333;
        line-height: 1.2;
        letter-spacing: -0.3px;
    }

    /* Sentiment gauge in metric section */
    .sentiment-metric-gauge {
        position: relative;
        width: 80px;
        height: 80px;
        margin-bottom: 8px;
    }

        .sentiment-metric-gauge svg {
            width: 80px;
            height: 80px;
            transform: rotate(-90deg);
        }

    .sentiment-metric-gauge-circle {
        fill: none;
        stroke: #F0F0F0;
        stroke-width: 5;
    }

    .sentiment-metric-gauge-fill {
        fill: none;
        stroke: #FF6B35;
        stroke-width: 5;
        stroke-linecap: round;
        transition: stroke-dashoffset 1s ease-out;
        stroke-dasharray: 251.33; /* 2 * π * 40 */
    }

    .sentiment-metric-gauge-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(0deg);
        font-size: 1.5rem;
        font-weight: 700;
        color: #FF6B35;
    }

    .sentiment-metric-value.rating {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 2rem;
        justify-content: flex-end;
    }

        .sentiment-metric-value.rating svg {
            width: 20px;
            height: 20px;
            fill: #FFB300;
            color: #FFB300;
            flex-shrink: 0;
        }

    .modifiers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 0px;
    }

    .modifier-tag {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        color: #333;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.8125rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        border: 2px solid transparent;
        flex-shrink: 0;
        white-space: normal;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        min-width: 100px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

        .modifier-tag::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            transition: all 0.3s ease;
        }

        .modifier-tag:hover {
            background: linear-gradient(135deg, #d1e9fe 0%, #bad6ee99 100%);
            color: #78a1c5;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(120, 161, 197, 0.25);
            border-color: #87b2d7;
        }

        .modifier-tag.active {
            background: linear-gradient(135deg, #FF6B35 0%, #ff8c52 100%);
            color: #fff;
            border-color: #FF6B35;
            box-shadow: 0 4px 16px rgba(255, 107, 53, 0.3);
        }

    /* Tag Content Structure */
    .modifier-tag-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .modifier-tag-name {
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        text-transform: capitalize;
    }

    /* Circular Progress Indicator */
    .modifier-tag-gauge {
        width: 50px;
        height: 50px;
        position: relative;
        margin: 4px 0;
    }

        .modifier-tag-gauge svg {
            width: 50px;
            height: 50px;
            transform: rotate(-90deg);
        }

    .modifier-tag-gauge-circle {
        fill: none;
        stroke: #e0e0e0;
        stroke-width: 4;
    }

    .modifier-tag-gauge-fill {
        fill: none;
        stroke-linecap: round;
        stroke-width: 4;
        transition: stroke-dashoffset 1s ease-out, stroke 0.3s ease;
    }

    .modifier-tag-gauge-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(0deg);
        font-size: 0.7rem;
        font-weight: 700;
        color: #333;
        line-height: 1;
    }

    .modifier-tag.active .modifier-tag-gauge-value {
        color: #fff;
    }

    .modifier-tag.active .modifier-tag-gauge-circle {
        stroke: rgba(255, 255, 255, 0.3);
    }

    /* Mini Progress Bar */
    .modifier-tag-progress {
        width: 100%;
        height: 4px;
        background: rgba(0, 0, 0, 0.1);
        border-radius: 2px;
        overflow: hidden;
        margin-top: 4px;
        position: relative;
    }

    .modifier-tag.active .modifier-tag-progress {
        background: rgba(255, 255, 255, 0.3);
    }

    .modifier-tag-progress-fill {
        height: 100%;
        border-radius: 2px;
        transition: width 1s ease-out, background 0.3s ease;
        background: linear-gradient(90deg, #4a90e2, #5ba3f5);
        position: relative;
        overflow: hidden;
    }

        .modifier-tag-progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            animation: shimmer 2s infinite;
        }

    @@keyframes shimmer {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    /* Confidence Badge */
    .modifier-tag-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.9);
        color: #666;
        margin-top: 2px;
    }

    .modifier-tag.active .modifier-tag-badge {
        background: rgba(255, 255, 255, 0.25);
        color: #fff;
    }

    .modifier-tag-badge-icon {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4a90e2;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.7;
            transform: scale(1.2);
        }
    }





    /* Modifier Detail Popup */
    .modifier-popup {
        position: absolute;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        padding: 16px;
        min-width: 300px;
        max-width: 380px;
        opacity: 0;
        visibility: hidden;
        display: none;
        pointer-events: none;
        border: 1px solid #E0E0E0;
        text-align: left;
    }

    /* Active popup that's moved to body */
    .modifier-popup-active {
        position: fixed !important;
        z-index: 999999 !important;
    }

    /* Popup visibility is handled by JavaScript - CSS hover removed to prevent conflicts */

    /* Connecting line between tag and popup */
    .modifier-popup::before {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 24px;
        width: 1px;
        height: 8px;
        background: #E0E0E0;
    }

    .modifier-popup::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 160px;
        width: 0;
        height: 0;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #fff;
    }

    .modifier-popup-header {
        font-size: 0.8rem;
        color: #666;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E0E0E0;
        line-height: 1.4;
    }

    .modifier-popup-content {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        white-space: normal;
    }

    .modifier-popup-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #F5F5F5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #E0E0E0;
    }

        .modifier-popup-avatar svg {
            width: 24px;
            height: 24px;
            stroke: #999;
            fill: none;
            stroke-width: 1.5;
        }

    .modifier-popup-details {
        flex: 1;
        min-width: 0;
        line-height: 16px;
    }

    .modifier-popup-user {
        font-weight: 600;
        color: #333;
        margin-bottom: 4px;
        font-size: 0.9375rem;
    }

    .modifier-popup-date {
        font-size: 0.75rem;
        color: #999;
        margin-bottom: 12px;
    }

    .modifier-popup-comment {
        font-size: 0.8rem;
        color: #666;
        line-height: 1.3;
    }

        .modifier-popup-comment .highlight {
            color: #949b97;
            font-weight: 700;
        }

    /* Confidence Level Progress Bar */
    .modifier-popup-confidence-level {
        margin-bottom: 12px;
        font-size: 0.8125rem;
        color: #666;
    }

    .confidence-level-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        font-size: 0.85rem;
        color: #999;
        padding-top: position: relative;
    }

    .confidence-level-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0px;
        font-size: 0.73rem;
        color: #675959;
        position: relative;
        text-transform: lowercase;
    }

        /* Up-arrow pointing to the gauge above */
        .confidence-level-label::before {
            content: '';
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 8px solid rgb(224 224 224);
            pointer-events: none;
        }

    .confidence-level-value {
        font-weight: 700;
        color: #949b97;
        font-size: 0.875rem;
    }

    .confidence-progress-bar-container {
        width: 100%;
        height: 4px;
        background-color: #F0F0F0;
        border-radius: 4px;
        overflow: hidden;
        position: relative;
    }

    .confidence-progress-bar {
        height: 100%;
        background: linear-gradient(135deg, #4eda92 60%, #56e0cb 100%);
        border-radius: 4px;
        transition: width 0.8s ease-out;
        position: relative;
        overflow: hidden;
    }

        /* Popup confidence bar colors by level */
        .confidence-progress-bar.confidence-high {
            background: linear-gradient(90deg, #28a745, #34ce57);
        }

        .confidence-progress-bar.confidence-medium {
            background: linear-gradient(90deg, #ffc107, #ffca2c);
        }

        .confidence-progress-bar.confidence-low {
            background: linear-gradient(90deg, #dc3545, #e4606d);
        }

        .confidence-progress-bar.confidence-normal {
            background: linear-gradient(90deg, #4a90e2, #5ba3f5);
        }

        .confidence-progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            animation: shimmer 2s infinite;
        }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    /* Responsive Design */
    @@media (max-width: 968px) {
        .sentiment-metrics {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .sentiment-content {
            flex-direction: column;
        }

        .sentiment-score-card {
            width: 100%;
            min-width: unset;
        }

        .sentiment-main-card {
            width: 100%;
            min-width: unset;
        }

        .sentiment-card-body {
            flex-direction: column;
        }

        .sentiment-container::before {
            width: 300px;
            height: 300px;
        }

        .sentiment-metrics {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .sentiment-metric-value {
            font-size: 2rem;
        }

        .sentiment-candidate-name {
            font-size: 1.125rem;
        }

        .sentiment-candidate-details {
            font-size: 0.8125rem;
        }

        .sentiment-stars {
            gap: 10px;
        }
    }

    /* Typing assessment: paragraph on mobile, table on desktop */
    .rb-typing-paragraph {
        display: block;
        margin-top: 12px;
        margin-bottom: 12px;
    }

    .rb-typing-table-wrap {
        display: none;
    }

    @@media (min-width: 768px) {
        .rb-typing-paragraph {
            display: none !important;
        }

        .rb-typing-table-wrap {
            display: block !important;
        }
    }
</style>
<div class="rb-report-container">
    <div class="rb-report-header">
        <div class="rb-report-title-section">
            <h1 class="rb-report-title">
                <i class="fa fa-chart-line"></i>
                AI Interview Report
            </h1>
            <p class="rb-report-subtitle">Comprehensive analysis of your interview performance</p>
        </div>
        <div class="rb-report-meta">
            <div class="rb-report-date">
                <i class="fa fa-calendar"></i>
                <span>@DateTime.Now.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="rb-report-actions-row">
                <button class="rb-action-btn rb-secondary-btn" type="button" onclick="getPDF()">
                    <i class="fa fa-download"></i> Download PDF
                </button>
                @{
                    var proctoringCount = ViewBag.ProctoringEventCount as int? ?? 0;
                }
                @if (proctoringCount > 0)
                {
                    <a style="color:#fff!important" class="rb-action-btn rb-secondary-btn" href="@Url.Action("ProctoringSessionEvents", "AIInterview", new { seId = Model.SessionId })" style="text-decoration:none;">
                        <i class="fa fa-shield-alt"></i> Proctoring events (@proctoringCount)
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="rb-report-content">
        <div class="rb-report-section">
            <div class="rb-section-header">
                <h2><i class="fa fa-clipboard-list"></i> Interview Summary</h2>
            </div>

            <!-- Enhanced Candidate Information Card -->
            <div class="rb-candidate-info-card">
                <div class="rb-candidate-header">
                    <div class="rb-candidate-avatar">
                        <i class="fa fa-user-circle"></i>
                    </div>
                    <div class="rb-candidate-details">
                        <h3 class="rb-candidate-name">@Model.CandidateName</h3>
                        <div class="rb-candidate-meta">
                            <div class="rb-candidate-email">
                                <i class="fa fa-envelope"></i>Email:
                                <span>@Model.CandidateEmail</span>
                            </div>
                            <div class="rb-candidate-email">
                                <i class="fa fa-envelope"></i>Resume:
                                <span><a style="background:none!important;border:0px!important;text-decoration: underline;color: #039BE5!important;font-size: 15px;" id="resumeId" target="_blank" title="Resume" href=@Model.resumeLink>Click here<a></a></span>
                            </div>
                            @if ((ViewBag.AccessType != null && ViewBag.AccessType == "Public") || (ViewBag.ProfileName != null && (ViewBag.ProfileName == "Admin" || ViewBag.ProfileName == "SupportAdmin" || ViewBag.ProfileName == "SeniorHR")))
                            {
                                @if (ViewBag.IRFId != null && ViewBag.CandidateMasterId != null && ViewBag.CandidateMasterId > 0)
                                {
                                    string accessType = ViewBag.AccessType ?? "";
                                    <div class="rb-candidate-email">
                                        <i class="fa fa-file-alt"></i>Resume Screening:
                                        <span><a style="background:none!important;border:0px!important;text-decoration: underline;color: #039BE5!important;font-size: 15px;" target="_blank" title="Resume Screening Results" href="@Url.Action("ScreenCandidateV2", "AIScreener", new { emailId = Model.CandidateEmail, irfId = ViewBag.IRFId, candidateMasterId = ViewBag.CandidateMasterId, accessType = accessType })">Resume Screening Results</a></span>
                                    </div>
                                }
                            }
                            <div class="rb-candidate-date">
                                <i class="fa fa-calendar-alt"></i>
                                Interview Date: <span>@Model.InterviewDate</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>







            <div class="desktop-view">
                <div class="rb-summary-cards">
                    <div class="rb-summary-card">
                        <div class="rb-card-icon">
                            <i class="fa fa-comments"></i>
                        </div>
                        <div class="rb-card-content">
                            <h3>Total Questions</h3>
                            <a href="#question-list" style="text-decoration:none"> <p class="rb-card-value">@(Model.videoQuestionDetails?.Count ?? 0)</p></a>
                        </div>
                    </div>
                    <div class="rb-summary-card">
                        <div class="rb-card-icon">
                            <i class="fa fa-video"></i>
                        </div>
                        <div class="rb-card-content">
                            <h3>@(ViewBag.IsAdaptive == true ? "Audio" : "Video") Responses</h3>
                            <a href="#video-list" style="text-decoration:none">  <p class="rb-card-value">@(Model.videoQuestionDetails?.Count ?? 0)</p></a>
                        </div>
                    </div>
                    <div class="rb-summary-card">
                        <div class="rb-card-icon">
                            <i class="fa fa-clock"></i>
                        </div>
                        <div class="rb-card-content">
                            <h3>Duration</h3>
                            <p class="rb-card-value">~45 min</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @{
            bool hasTypingData = Model.TypingSpeedAssessments != null && Model.TypingSpeedAssessments.Any();
            var typingAssessments = (ViewBag.TypingSpeedAssessments as IEnumerable<Risebird.Entities.ViewModel.TypingSpeedAssessment>) ?? Enumerable.Empty<Risebird.Entities.ViewModel.TypingSpeedAssessment>();
        }
        @if (hasTypingData)
        {
            <div class="rb-report-section" style="margin-bottom:20px;">
                <div class="rb-section-header" style="margin-bottom:5px;">
                    <h2><i class="fa fa-keyboard-o"></i> Typing Speed Assessment</h2>
                </div>
                <div class="rb-analysis-content" style="overflow: hidden;">
                    @if (typingAssessments.Any())
                    {
                        @foreach (var tsa in typingAssessments)
                        {

                            var analysis = !string.IsNullOrEmpty(tsa.OpenAIAnalysisJson)
                            ? Newtonsoft.Json.JsonConvert.DeserializeObject<Risebird.Entities.ViewModel.TypingAssessmentOpenAIResponse>(tsa.OpenAIAnalysisJson)
                            : null;

                            <div class="row rb-analysis-row" style="margin: 0 0 16px 0;">
                                <div class="col-md-4 col-sm-12" style="padding: 8px;">
                                    @if (!string.IsNullOrEmpty(tsa.VideoLink))
                                    {
                                        <div class="rb-section-video" style="background: #000; border-radius: 8px; overflow: hidden;">
                                            <video controls style="width: 100%; height: auto; display: block;">
                                                <source src="@tsa.VideoLink" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rb-section-video rb-video-placeholder">
                                            <div style="text-align: center; color: #999;">
                                                <i class="fa fa-video-camera" style="font-size: 2.5rem; margin-bottom: 8px;"></i>
                                                <p style="margin: 0; font-size: 0.9rem;">Video not available</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-8 col-sm-12 rb-section-analysis" style="padding: 8px;">
                                    <div class="rb-analysis-item" style="margin:8px 12px;padding:10px!important">
                                        <div class="rb-analysis-header" style="margin-bottom:6px;">
                                            <i class="fa fa-keyboard-o"></i>
                                            <span class="rb-analysis-title">@(tsa.QuestionText ?? "Typing Speed Assessment")</span>
                                            @if (tsa.IsPassed == true)
                                            {
                                                <span class="badge" style="background: #28a745; margin-left: 6px; font-size: 0.75rem;width:auto;margin-top:10px;">Passed ✓</span>
                                            }
                                            else if (tsa.IsPassed == false)
                                            {
                                                <span class="badge" style="background: #dc3545; margin-left: 6px; font-size: 0.75rem;width:auto;margin-top:10px;">Not Passed</span>
                                            }
                                        </div>

                                        @* Sample text and typed text: paragraph on mobile, table on desktop *@
                                        @if (!string.IsNullOrWhiteSpace(tsa.SampleText) || !string.IsNullOrWhiteSpace(tsa.TypedText))
                                        {
                                            @* Mobile: normal paragraph format *@
                                            <div class="rb-typing-paragraph">
                                                @if (!string.IsNullOrWhiteSpace(tsa.SampleText))
                                                {
                                                    <div style="margin-bottom:12px;">
                                                        <div style="font-size:1rem; font-weight: 600; color: #495057; margin-bottom: 4px;"><i class="fa fa-file-text"></i> Sample Text</div>
                                                        <p style="margin: 0; font-size:1rem; line-height: 1.6; color: #333; white-space: pre-wrap; word-break: break-word;">@tsa.SampleText</p>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(tsa.TypedText))
                                                {
                                                    <div>
                                                        <div style="font-size:1rem; font-weight: 600; color: #495057; margin-bottom: 4px;"><i class="fa fa-keyboard-o"></i> Typed Text</div>
                                                        <p style="margin: 0; font-size:1rem; line-height: 1.6; color: #333; white-space: pre-wrap; word-break: break-word;">@tsa.TypedText</p>
                                                    </div>
                                                }
                                            </div>
                                            @* Desktop: table format (same as Word/Character Accuracy) *@
                                            <div class="rb-typing-table-wrap">
                                                <table class="table table-bordered table-sm" style="font-size: 0.85rem; margin-top: 12px; margin-bottom: 12px;">
                                                    <tbody>
                                                        @if (!string.IsNullOrWhiteSpace(tsa.SampleText))
                                                        {
                                                            <tr>
                                                                <td style="width: 160px; font-weight: 600; background: #f8f9fa; padding: 6px 10px; vertical-align: top;"><i class="fa fa-file-text"></i> Sample Text</td>
                                                                <td style="padding: 6px 10px; white-space: pre-wrap; word-break: break-word;">@tsa.SampleText</td>
                                                            </tr>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(tsa.TypedText))
                                                        {
                                                            <tr>
                                                                <td style="font-weight: 600; background: #f8f9fa; padding: 6px 10px; vertical-align: top;"><i class="fa fa-keyboard-o"></i> Typed Text</td>
                                                                <td style="padding: 6px 10px; white-space: pre-wrap; word-break: break-word;">@tsa.TypedText</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        @if (analysis != null && analysis.scores != null)
                                        {
                                            <!-- AI Analysis Results -->
                                            <div style="margin-top:12px;">
                                                <!-- Overall Grade Badge -->
                                                <div style="margin-bottom:12px; padding:10px; background: @(analysis.scores.overall_grade == "Excellent" || analysis.scores.overall_grade == "Very Good" ? "#d4edda" : analysis.scores.overall_grade == "Good" ? "#fff3cd" : "#f8d7da"); border-radius:6px; border-left:4px solid @(analysis.scores.overall_grade == "Excellent" || analysis.scores.overall_grade == "Very Good" ? "#28a745" : analysis.scores.overall_grade == "Good" ? "#ffc107" : "#dc3545");">
                                                    <strong style="font-size:0.9rem; color:@(analysis.scores.overall_grade == "Excellent" || analysis.scores.overall_grade == "Very Good" ? "#155724" : analysis.scores.overall_grade == "Good" ? "#856404" : "#721c24");">
                                                        <i class="fa fa-certificate"></i> Grade: @analysis.scores.overall_grade
                                                    </strong>
                                                </div>

                                                <!-- Accuracy Scores -->
                                                <table class="table table-bordered table-sm table-sm-font" style="font-size: 0.85rem; margin-bottom: 12px;">
                                                    <tbody>
                                                        <tr>
                                                            <td style="width: 160px; font-weight: 600; background: #f8f9fa; padding: 6px 10px;">
                                                                <i class="fa fa-tachometer"></i> Words Per Minute
                                                            </td>
                                                            <td style="padding: 6px 10px;">
                                                                @{
                                                                    var wpmToShow = (analysis.meta != null && analysis.meta.words_per_minute > 0)
                                                                    ? analysis.meta.words_per_minute
                                                                    : tsa.WordsPerMinute;
                                                                }
                                                                <strong style="font-size:1.1rem; color:@(wpmToShow >= 30 ? "#28a745" : "#dc3545");">
                                                                    @wpmToShow.ToString("N1")
                                                                </strong>
                                                                <span style="margin-left:8px; color:#666; font-size:0.8rem;">(Required: 30 WPM)</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-weight: 600; background: #f8f9fa; padding: 6px 10px;">
                                                                <i class="fa fa-check-circle"></i> Word Accuracy
                                                            </td>
                                                            <td style="padding: 6px 10px;">
                                                                <strong style="font-size:1.1rem; color:@(analysis.scores.word_level_accuracy_percent >= 97 ? "#28a745" : "#dc3545");">
                                                                    @analysis.scores.word_level_accuracy_percent.ToString("N1")%
                                                                </strong>
                                                                <span style="margin-left:8px; color:#666; font-size:0.8rem;">(Required: 97%)</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-weight: 600; background: #f8f9fa; padding: 6px 10px;">
                                                                <i class="fa fa-font"></i> Character Accuracy
                                                            </td>
                                                            <td style="padding: 6px 10px;">
                                                                <strong>@analysis.scores.character_level_accuracy_percent.ToString("N1")%</strong>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-weight: 600; background: #f8f9fa; padding: 6px 10px;">
                                                                <i class="fa fa-clock-o"></i> Time Taken
                                                            </td>
                                                            <td style="padding: 6px 10px;">
                                                                <strong>@tsa.TimeTakenInSeconds.ToString("N1")</strong> seconds <span style="color:#666; font-size:0.8rem;">(Max: 120s)</span>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>

                                                @if (analysis.counts != null)
                                                {
                                                    <!-- Error Categories -->
                                                    <div style="margin-bottom:12px;">
                                                        <h5 class="table-sm-font" style="font-size:0.9rem; margin-bottom:6px; color:#666;margin-left:12px;">
                                                            <i class="fa fa-exclamation-triangle" style="font-size:12px;"></i> Error Breakdown
                                                        </h5>
                                                        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:8px;">
                                                            <div style="padding:6px 10px; background:#f8f9fa; border-radius:4px; text-align:center;">
                                                                <div class="table-sm-font" style="font-size:0.75rem; color:#666;">Correct Words</div>
                                                                <div style="font-size:1.1rem; font-weight:600; color:#28a745;">@analysis.counts.correct_words</div>
                                                            </div>
                                                            <div style="padding:6px 10px; background:#f8f9fa; border-radius:4px; text-align:center;">
                                                                <div class="table-sm-font" style="font-size:0.75rem; color:#666;">Incorrect</div>
                                                                <div style="font-size:1.1rem; font-weight:600; color:#dc3545;">@analysis.counts.incorrect_words</div>
                                                            </div>
                                                            <div style="padding:6px 10px; background:#f8f9fa; border-radius:4px; text-align:center;">
                                                                <div class="table-sm-font" style="font-size:0.75rem; color:#666;">Missing</div>
                                                                <div style="font-size:1.1rem; font-weight:600; color:#dc3545;">@analysis.counts.missing_words</div>
                                                            </div>
                                                            <div style="padding:6px 10px; background:#f8f9fa; border-radius:4px; text-align:center;">
                                                                <div class="table-sm-font" style="font-size:0.75rem; color:#666;">Spelling Errors</div>
                                                                <div style="font-size:1.1rem; font-weight:600; color:#ffc107;">@analysis.counts.spelling_errors</div>
                                                            </div>
                                                            <div style="padding:6px 10px; background:#f8f9fa; border-radius:4px; text-align:center;">
                                                                <div class="table-sm-font" style="font-size:0.75rem; color:#666;">Capitalization</div>
                                                                <div style="font-size:1.1rem; font-weight:600; color:#ffc107;">@analysis.counts.capitalization_errors</div>
                                                            </div>
                                                            <div style="padding:6px 10px; background:#f8f9fa; border-radius:4px; text-align:center;">
                                                                <div class="table-sm-font" style="font-size:0.75rem; color:#666;">Punctuation</div>
                                                                <div style="font-size:1.1rem; font-weight:600; color:#ffc107;">@analysis.counts.punctuation_errors</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                @if (analysis.verdict != null && analysis.verdict.actionable_tips != null && analysis.verdict.actionable_tips.Any())
                                                {
                                                    <!-- Actionable Tips -->
                                                    <div style="margin-top:12px; padding:10px; background:#e8f4f8; border-radius:6px; border-left:4px solid #17a2b8;">
                                                        <h5 style="font-size:0.9rem; margin-bottom:6px; color:#0c5460;">
                                                            <i class="fa fa-lightbulb-o"></i> Tips for Improvement
                                                        </h5>
                                                        <ul style="margin:0; padding-left:20px; font-size:0.85rem; line-height:1.6; color:#0c5460;">
                                                            @foreach (var tip in analysis.verdict.actionable_tips)
                                                            {
                                                                <li>@tip</li>
                                                            }
                                                        </ul>
                                                    </div>
                                                }

                                                @if (analysis.verdict != null)
                                                {
                                                    <!-- Comments -->
                                                    <div style="margin-top:12px; padding:8px; background:#f8f9fa; border-radius:4px; font-size:0.85rem;">
                                                        @if (!string.IsNullOrEmpty(analysis.verdict.speed_comment))
                                                        {
                                                            <p style="margin:0 0 6px 0; color:#666;">
                                                                <strong>Speed:</strong> @analysis.verdict.speed_comment
                                                            </p>
                                                        }
                                                        @if (!string.IsNullOrEmpty(analysis.verdict.accuracy_comment))
                                                        {
                                                            <p style="margin:0; color:#666;">
                                                                <strong>Accuracy:</strong> @analysis.verdict.accuracy_comment
                                                            </p>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Fallback to basic metrics if no AI analysis -->
                                            <div style="margin-top:4px; overflow: hidden;">
                                                <table class="table table-bordered table-sm" style="font-size: 0.8rem; margin-bottom: 0;">
                                                    <tbody>
                                                        <tr>
                                                            <td style="width: 140px; font-weight: 600; background: #f8f9fa; padding: 4px 8px;">Metrics</td>
                                                            <td style="padding: 4px 8px;">
                                                                <span>WPM: <strong>@tsa.WordsPerMinute.ToString("N1")</strong></span>
                                                                <span style="margin-left: 12px;">Accuracy: <strong>@(tsa.AccuracyPercentage.ToString("N1") + "%")</strong></span>
                                                                <span style="margin-left: 12px;">Time: <strong>@tsa.TimeTakenInSeconds</strong>s</span>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="font-weight: 600; background: #f8f9fa; padding: 4px 8px;">Started / Completed</td>
                                                            <td style="padding: 4px 8px; font-size: 0.75rem;">
                                                                @(tsa.TimeStarted != default(DateTime) ? tsa.TimeStarted.ToString("yyyy-MM-dd HH:mm") : "-")
                                                                &nbsp;→&nbsp;
                                                                @(tsa.TimeCompleted != default(DateTime) ? tsa.TimeCompleted.ToString("yyyy-MM-dd HH:mm") : "-")
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <p style="margin-top:10px; padding:8px; background:#fff3cd; border-radius:4px; font-size:0.8rem; color:#856404;">
                                                    <i class="fa fa-info-circle"></i> AI analysis not available for this assessment.
                                                </p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        }
        <div style="display:flex; align-items:center; margin: 32px 0 28px 0; gap: 0;">
            <div style="flex:1; height:2px; background: linear-gradient(90deg, transparent 0%, #4eda92 40%, #56e0cb 100%); border-radius:2px; opacity:0.5;"></div>
            <div style="display:flex; align-items:center; gap:8px; padding: 0 18px; background:#fff; position:relative; z-index:1;">
                <span style="display:inline-flex; align-items:center; justify-content:center; width:34px; height:34px; border-radius:50%; background: linear-gradient(135deg, #4eda92 0%, #56e0cb 100%); box-shadow: 0 2px 8px rgba(78,218,146,0.35);">
                    <i class="fa fa-robot" style="color:#fff; font-size:15px;"></i>
                </span>
                <span style="font-size:17px; font-weight:600; color:#000; letter-spacing:0.5px; text-transform:uppercase; white-space:nowrap;">AI Analysis &amp; Recommendations</span>
            </div>
            <div style="flex:1; height:2px; background: linear-gradient(90deg, #56e0cb 0%, #4eda92 60%, transparent 100%); border-radius:2px; opacity:0.5;"></div>
        </div>


        <div>
            <div class="rb-report-section" style="margin-bottom:20px;">

                <div class="rb-analysis-content">
                    @if (Model.AIInterviewEvaluation != null)
                    {
                        <div class="row" style="margin:0;">
                            <!-- Left: Tech Skill Score (Rubric Score Summary) -->
                            <div class="col-lg-3 col-md-5 col-sm-12 ai-tech-score-wrapper" style="padding:0px;margin:0px;">
                                @if (Model.AIInterviewEvaluation.AadharVerificationId > 0)
                                {
                                    <div class="modern-card" style="border-bottom: 1px #e4e1e1 solid;margin:0px 0px 0px 20px;padding-top: 10px;">
                                        <div class="rb-analysis-header" style="margin:0px">
                                            <img style="width: 20px;left:0px;top:-1px;position:relative;" src="/img/acknowledge-tick.png">                                            <span class="rb-analysis-title">Verification status :</span>
                                        </div>
                                        <div class="modern-card-body">
                                            @if (Model.AIInterviewEvaluation.AadharVerificationId > 0)
                                            {
                                                <div class="verification-grid">
                                                    <div class="verification-item" style="border-right: 1px #d8cdcd solid;margin: 5px 10px;">
                                                        <div class="info-label">Aadhaar Verified</div>
                                                        <div class="info-value-simple">
                                                            @if (Model.AIInterviewEvaluation.AadharVerificationId > 0)
                                                            {
                                                                <span class="status-badge success">Yes</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="status-badge error">No</span>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="verification-item" style="margin: 5px 10px;">
                                                        <div class="info-label">Match Score %</div>
                                                        <div class="info-value-simple">@Model.MatchScorePercentage</div>
                                                    </div>
                                                </div>
                                            }
                                            @if (Model.AIInterviewEvaluation.AadharVerificationId > 0)
                                            {
                                                <a href="#" class="aadhaar-link" onclick="javascript:FetchAadhaarDetails('@Model.InterviewId','@Model.CandidateEmail');">
                                                    <i class="fa fa-id-card"></i> Click Here For Candidate Verified Data
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }



                                <div class="rb-analysis-item ai-tech-score" style="padding-bottom:20px;padding-top:0px;">


                                    <div class="rb-analysis-header">
                                        @if (Model.AIResumeScreeningScore != 0)
                                        {

                                            <img style="width:21px;left:-3px; top:0px; position:relative;" src="/img/resume-screening.png">
                                            <span class="rb-analysis-title">
                                                AI Resume Screening Score:
                                                <span style="color:#000;margin-left:6px;font-weight:bold">@Model.AIResumeScreeningScore</span>

                                            </span>
                                        }
                                    </div>


                                    <div class="rb-analysis-text">
                                        <div class="question" style="margin-bottom:15px;">
                                            @if (!string.IsNullOrWhiteSpace(Model.AIResumeScreeningVerdict))
                                            {

                                                <label style="color:#000;font-weight:bold;padding-left:5px;font-size: 15px;margin:0px">AI Resume Screening Verdict:</label>

                                                <span style="color:#000;margin-left:6px;">@Model.AIResumeScreeningVerdict</span>

                                            }

                                        </div>




                                    </div>



                                    <div class="rb-analysis-text">
                                        <h4 style="color: brown;background: #df9b9b4d;height: 18px;position: relative;top:0px;padding: 14px 5px;font-size:16px;">
                                            <span style="position: relative;top: -10px;padding: 0px 12px">Score Rubic / Score Parameters:</span>
                                        </h4>

                                        @if (Model.AIInterviewEvaluation?.RubricScoreSummary != null && Model.AIInterviewEvaluation.RubricScoreSummary.Any())
                                        {
                                            @foreach (var r in Model.AIInterviewEvaluation.RubricScoreSummary)
                                            {
                                                var barWidth = r.Score;
                                                if (barWidth < 0) { barWidth = 0; }
                                                if (barWidth > 100) { barWidth = 100; }
                                                @*                                          <div class="tech-skill-wrapper" style="margin:10px 0 16px 0;border-bottom: 1px #e4e1e1 solid;">*@
                                                <div class="tech-skill-wrapper" style="margin:10px 0 0px 0;border-bottom: 1px #e4e1e1 solid;">
                                                    <div style="font-weight:500;">@r.RubricItem</div>
                                                    @if (!string.IsNullOrEmpty(r.ExpectedLevel) || !string.IsNullOrEmpty(r.ObservedLevel))
                                                    {
                                                        <span class="rqlevel" style="display:block;margin:4px 0 8px 0;">
                                                            Evaluated at <b>@(r.ExpectedLevel ?? "N/A")</b> &nbsp; | &nbsp; Observed: <b>@(r.ObservedLevel ?? "N/A")</b>
                                                        </span>
                                                    }
                                                    @*   <div class="skillBackground skill-round-xlarge skill-small" style="background:#e9ecef;border-radius:4px;height:13px;position:relative;">
                                        <div class="skill-round-xlarge skill-teal" style="background:#4eda92;border-radius:4px;height:13px;width:@(barWidth)%;">
                                        <span class="ratecount" style="position: relative;top: 16px;color: #000;right:-235px;font-weight: bold;width: 100px; display: block;">
                                        @r.Score
                                        </span>
                                        </div>
                                        </div>
                                        <span class="ratecount" style="position: relative;top: 16px;color: #000;right:-235px;font-weight: bold;width: 100px; display: block;">
                                        @r.Score
                                        </span> *@

                                                    <span class="ratecount-score">
                                                        Score : @r.Score
                                                    </span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="rb-no-data" style="padding:10px 0 0 0;">
                                                <p>No rubric summary found.</p>
                                            </div>
                                        }

                                        <div class="rb-analysis-header" style="margin-top:14px;">
                                            <img style="width:25px;left:-5px; top:5px; position:relative;" src="/img/techskill-score.png">
                                            <span class="rb-analysis-title" style="font-size:16px!important;font-weight:600">
                                                Overall Skill Score:
                                                @if (Model.AIInterviewEvaluation.OverallTechnicalScore != 0)
                                                {
                                                    <span style="color:#000;margin-left:6px;font-weight:bold">@Model.AIInterviewEvaluation.OverallTechnicalScore</span>
                                                }
                                            </span>
                                        </div>

                                        @if (Model.AIInterviewEvaluation != null && (Model.AIInterviewEvaluation.OverallCommunicationScore != 0 || !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning)))
                                        {
                                            <div class="question" style="margin-top:10px;">
                                                <div class="rb-analysis-header" style="margin:0px">
                                                    <img style="width:20px;left:-4px;top: 2px;position:relative;" src="/img/communication-score.png">
                                                    <span class="rb-analysis-title" style="font-size: 16px!important;font-weight: 600;">Overall Communication :</span>
                                                    @if (Model.AIInterviewEvaluation.OverallCommunicationScore != 0)
                                                    {
                                                        <div style="margin:0;">
                                                            @*  <label style="color:#000;font-weight:bold;">Overall Communication Score :</label> *@
                                                            <span style="color:#333;font-weight:bold;font-size: 16px;">@Model.AIInterviewEvaluation.OverallCommunicationScore</span>
                                                        </div>
                                                    }

                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning))
                                                {
                                                    <div style="margin:0;">
                                                        <label style="color:#000;font-weight:bold;">Overall CommunicationScore Reasoning :</label>
                                                        <div style="color:#333;margin:6px 0 0 0;white-space:pre-line;">@Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning</div>
                                                    </div>
                                                }
                                            </div>
                                        }





                                    </div>
                                </div>


                            </div>
                            <div class="col-lg-9 col-md-7 col-sm-12 ai-coment-question-wrapper" style="padding:0px;margin:0px;">

                                <div class="col-lg-8 col-md-7 col-sm-12" style="padding:0px!important;margin:0px!important;float:left">

                                    <div id="question-list" class="rb-analysis-item" style="box-shadow:none;padding-top:0px;">
                                        <div class="rb-analysis-header">
                                            <img style="width:27px;position: relative;left: -4px;top:11px;" src="/img/question-asked.png">
                                            <span class="rb-analysis-title" style="font-size:17px!important">Questions Discussed</span>
                                        </div>
                                        <div class="rb-analysis-text">
                                            <div class="question question-scroll">
                                                @if (Model.AIInterviewEvaluation?.QuestionRatings != null && Model.AIInterviewEvaluation.QuestionRatings.Any())
                                                {
                                                    <ol>
                                                        @foreach (var q in Model.AIInterviewEvaluation.QuestionRatings)
                                                        {
                                                            <li>
                                                                @q.Question
                                                                @if (!string.IsNullOrWhiteSpace(q.Verdict) || q.Score != 0 || !string.IsNullOrWhiteSpace(q.Comment))
                                                                {
                                                                    <div>
                                                                        @if (!string.IsNullOrWhiteSpace(q.Verdict))
                                                                        {
                                                                            <label>Rating : @q.Verdict</label>
                                                                        }
                                                                        <label>Score : @q.Score</label>
                                                                        @if (!string.IsNullOrWhiteSpace(q.Comment))
                                                                        {
                                                                            <label>Comment : @q.Comment</label>
                                                                        }
                                                                    </div>
                                                                }
                                                                @if (q.CommunicationScore != 0 || !string.IsNullOrWhiteSpace(q.CommunicationComment))
                                                                {
                                                                    <div>
                                                                        <label>Communication Score : @q.CommunicationScore</label>
                                                                        @if (!string.IsNullOrWhiteSpace(q.CommunicationComment))
                                                                        {
                                                                            <label>Communication Comment : @q.CommunicationComment</label>
                                                                        }
                                                                    </div>
                                                                }
                                                            </li>
                                                        }
                                                    </ol>
                                                }
                                                else
                                                {
                                                    <p class="nodata" style="margin:0;"><img width="25" src="/img/no-question.png" /><span style="font-size:16px;position:relative;top:3px;padding-left:5px;">No Question Found</span></p>
                                                }
                                            </div>
                                        </div>
                                    </div>


                                </div>
                                <!-- Right: Questions Discussed (Question Ratings) -->
                                <div class="col-lg-4 col-md-12 col-sm-12 col-xs-12" style="float:left;padding:0px;margin:0px;">
                                    <!-- Right: Final Verdict & Comment (like Interviewer Comment) -->
                                    <div class="rb-analysis-item ai-interviewer-cmt" style="padding-top:0px;">
                                        <div class="rb-analysis-header">
                                            <img style="width:27px;position: relative;left: -2px;top:11px;" src="/img/interviewer-comment.png">
                                            <span class="rb-analysis-title" style="font-size:17px!important">AI Interviewer Comment</span>
                                        </div>
                                        <div class="rb-analysis-text">
                                            @if (Model.AIInterviewEvaluation != null && (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict) || !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment)))
                                            {
                                                <div class="question" style="margin-top:4px;">
                                                    @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict))
                                                    {
                                                        string _fvClass = null;
                                                        var _fv = Model.AIInterviewEvaluation.FinalVerdict.Trim();
                                                        var _fvL = _fv.ToLowerInvariant();
                                                        if (_fvL.Contains("reject"))
                                                        {
                                                            _fvClass = "ai-final-verdict-reject";
                                                        }
                                                        else if (_fvL == "selected" || _fvL.Contains("strongly selected") || _fvL.Contains("marginally selected") || _fvL.Contains("marginal selected"))
                                                        {
                                                            _fvClass = "ai-final-verdict-select";
                                                        }
                                                        else if (_fvL == "average")
                                                        {
                                                            _fvClass = "ai-final-verdict-average";
