        }

        function layoutRubricAndSummary() {
            function t(el) { return ((el && el.textContent) || '').replace(/\s+/g, ' ').trim(); }
            function escapeHtml(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
            function verdictClass(v) {
                var x = (v || '').toLowerCase();
                if (/reject|not recommended|fail|no hire|poor/.test(x)) return 'rb-adaptive-verdict-badge--reject';
                if (/select|recommend|hire|pass|strong/.test(x)) return 'rb-adaptive-verdict-badge--select';
                return 'rb-adaptive-verdict-badge--neutral';
            }
            var clampSeq = 0;
            function clampHtml(raw, limit) {
                limit = limit || 160;
                raw = (raw || '').trim();
                if (!raw) return '';
                if (raw.length <= limit) {
                    return '<div class="rb-adaptive-field__value">' + escapeHtml(raw) + '</div>';
                }
                clampSeq += 1;
                var id = 'rb-summary-clamp-' + clampSeq;
                var shortText = raw.substring(0, limit).replace(/\s+\S*$/, '') + '…';
                return '<div class="rb-adaptive-field__value">' +
                    '<div class="rb-adaptive-clamp" id="' + id + '">' +
                    '<div class="rb-adaptive-clamp__short">' + escapeHtml(shortText) + '</div>' +
                    '<div class="rb-adaptive-clamp__full">' + escapeHtml(raw) + '</div>' +
                    '<button type="button" class="rb-adaptive-clamp__toggle" data-clamp="' + id + '" aria-expanded="false">Read more</button>' +
                    '</div></div>';
            }

            var fields = {
                techScore: null,
                commScore: null,
                verdict: null,
                finalComment: null,
                commReason: null,
                llmSuspected: null,
                llmEvidence: null
            };
            var toRemove = [];

            function captureFromText(raw, el) {
                if (!raw) return false;
                var m;
                var matched = false;
                // Stop each value at the next known label so combined blocks don't merge fields
                var nextLabel = '(?=\\s*(?:Overall\\s+Technical\\s+Score\\s*:|Overall\\s+Communication\\s+Score\\s*:|(?:Overall\\s+)?Communication\\s+Score(?!\\s+Reasoning)\\s*:|Final\\s+Verdict\\s*:|Final\\s+Comment\\s*:|Communication\\s+Score\\s+Reasoning\\s*:|Communication\\s+Comments?\\s*:|LLM\\s+Detection|LLM\\s+Response\\s+Suspected\\s*:|Evidence\\s+Comment\\s*:|$))';
                m = raw.match(new RegExp('Overall\\s+Technical\\s+Score\\s*:\\s*(.+?)' + nextLabel, 'i'));
                if (m) { fields.techScore = m[1].trim(); matched = true; }
                // Score only — never swallow "Communication Score Reasoning"
                m = raw.match(new RegExp('(?:Overall\\s+)?Communication\\s+Score(?!\\s+Reasoning)\\s*:\\s*(.+?)' + nextLabel, 'i'));
                if (m) { fields.commScore = m[1].trim(); matched = true; }
                m = raw.match(new RegExp('Final\\s+Verdict\\s*:\\s*(.+?)' + nextLabel, 'i'));
                if (m) { fields.verdict = m[1].trim(); matched = true; }
                m = raw.match(new RegExp('Final\\s+Comment\\s*:\\s*([\\s\\S]+?)' + nextLabel, 'i'));
                if (m) { fields.finalComment = m[1].trim(); matched = true; }
                m = raw.match(new RegExp('Communication\\s+Score\\s+Reasoning\\s*:\\s*([\\s\\S]+?)' + nextLabel, 'i'));
                if (m) { fields.commReason = m[1].trim(); matched = true; }
                if (!fields.commReason) {
                    m = raw.match(new RegExp('Communication\\s+Comments?\\s*:\\s*([\\s\\S]+?)' + nextLabel, 'i'));
                    if (m) { fields.commReason = m[1].trim(); matched = true; }
                }
                m = raw.match(new RegExp('LLM\\s+Response\\s+Suspected\\s*:\\s*(.+?)' + nextLabel, 'i'));
                if (m) { fields.llmSuspected = m[1].trim(); matched = true; }
                m = raw.match(new RegExp('Evidence\\s+Comment\\s*:\\s*([\\s\\S]+?)' + nextLabel, 'i'));
                if (m) { fields.llmEvidence = m[1].trim(); matched = true; }
                // Final Disposition variants (Status / Reason) — only when clearly a disposition line
                if (!fields.verdict) {
                    m = raw.match(/^(?:Final\s+)?Status\s*:\s*(.+)$/i);
                    if (m && m[1].trim().length <= 60 &&
                        /recommend|select|reject|hire|pass|fail|borderline|average|good|excellent|not\s+recommended|correct|incorrect/i.test(m[1])) {
                        fields.verdict = m[1].trim();
                        matched = true;
                    }
                }
                if (!fields.finalComment) {
                    m = raw.match(/^Reason\s*:\s*([\s\S]+)$/i);
                    if (m && m[1].trim().length > 20) {
                        fields.finalComment = m[1].trim();
                        matched = true;
                    }
                }
                if (/^LLM\s+Detection$/i.test(raw)) matched = true;
                if (matched && el) toRemove.push(el);
                return matched;
            }

            function splitMergedVerdictComment() {
                if (fields.verdict && /Final\s+Comment\s*:/i.test(fields.verdict)) {
                    var parts = fields.verdict.split(/Final\s+Comment\s*:/i);
                    fields.verdict = (parts[0] || '').trim();
                    if (!fields.finalComment && parts[1]) fields.finalComment = parts[1].trim();
                }
                // Verdicts are short status phrases — drop accidental trailing prose
                if (fields.verdict && fields.verdict.length > 80) {
                    var short = fields.verdict.match(/^(Not\s+Recommended|Recommended|Strongly\s+Selected|Marginally\s+Selected|Marginally\s+Rejected|Strongly\s+Rejected|Selected|Rejected|Strong\s+Hire|No\s+Hire|Hire|Pass|Fail|Borderline|Average|Good|Excellent)(?:\b|[.!]|$)/i);
                    if (short) {
                        if (!fields.finalComment) {
                            var rest = fields.verdict.substring(short[0].length).replace(/^[\s contr-]+/, '').trim();
                            if (rest) fields.finalComment = rest;
                        }
                        fields.verdict = short[1];
                    }
                }
            }

            function splitMergedCommScoreReason() {
                if (fields.commScore && /Communication\s+Score\s+Reasoning\s*:/i.test(fields.commScore)) {
                    var parts = fields.commScore.split(/Communication\s+Score\s+Reasoning\s*:/i);
                    fields.commScore = (parts[0] || '').trim();
                    if (!fields.commReason && parts[1]) fields.commReason = parts[1].trim();
                }
                if (fields.commScore && /Communication\s+Comments?\s*:/i.test(fields.commScore)) {
                    var parts2 = fields.commScore.split(/Communication\s+Comments?\s*:/i);
                    fields.commScore = (parts2[0] || '').trim();
                    if (!fields.commReason && parts2[1]) fields.commReason = parts2[1].trim();
                }
                // Metric card should show only the numeric score; move prose to reasoning
                if (fields.commScore && fields.commScore.length > 12) {
                    var num = fields.commScore.match(/(\d+(?:\.\d+)?\s*\/\s*\d+(?:\.\d+)?|\d+(?:\.\d+)?\s*%|\b\d+(?:\.\d+)?\b)/);
                    if (num) {
                        var rest = fields.commScore.replace(num[0], '').replace(/^[\s:\-–—|/]+/, '').trim();
                        if (rest && !fields.commReason) fields.commReason = rest;
                        fields.commScore = num[0].replace(/\s+/g, ' ').trim();
                    }
                }
            }

            Array.prototype.forEach.call(root.querySelectorAll('p, div, li, h2, h3, h4, span, strong, b'), function (el) {
                if (el.closest('table')) return;
                if (el.closest('.rb-adaptive-overview')) return;
                if (el.closest('.rb-adaptive-q-section') || el.closest('.rb-ai-q-card') || el.closest('.rb-ai-panel')) return;
                if (el.querySelector('table, .rb-adaptive-overview, .rb-adaptive-q-section')) return;
                var raw = t(el);
                if (!raw || raw.length > 2500) return;
                if (/Final\s+Comment\s*:|Communication\s+Score\s+Reasoning\s*:|Communication\s+Comments?\s*:|Evidence\s+Comment\s*:/i.test(raw) ||
                    /Overall\s+Technical\s+Score\s*:|(?:Overall\s+)?Communication\s+Score\s*:|Final\s+Verdict\s*:|LLM\s+Response\s+Suspected\s*:|^LLM\s+Detection$/i.test(raw)) {
                    // Label-only node → pull value from following sibling text
                    if (/^(Overall\s+Technical\s+Score|(?:Overall\s+)?Communication\s+Score(?!\s+Reasoning)|Final\s+Verdict|Final\s+Comment|Communication\s+Score\s+Reasoning|Communication\s+Comments?|LLM\s+Response\s+Suspected|Evidence\s+Comment)\s*:?\s*$/i.test(raw)) {
                        var next = el.nextElementSibling;
                        var nextText = t(next);
                        if (nextText) {
                            captureFromText(raw.replace(/\s*:?\s*$/, '') + ': ' + nextText, el);
                            if (next) toRemove.push(next);
                            return;
                        }
                    }
                    captureFromText(raw, el);
                }
            });

            // Fallback: fill any still-missing fields from full section text
            var blob = root.innerText || root.textContent || '';
            if (!fields.techScore) {
                var ts = blob.match(/Overall\s+Technical\s+Score\s*:\s*([^\n\r]+?)(?=\s*(?:Overall\s+Communication|Final\s+Verdict|Final\s+Comment|Communication\s+Score|$))/i);
                if (ts) fields.techScore = ts[1].trim();
            }
            if (!fields.verdict) {
                var fv = blob.match(/Final\s+Verdict\s*:\s*([^\n\r]+?)(?=\s*(?:Final\s+Comment\s*:|$))/i);
                if (fv) fields.verdict = fv[1].trim();
            }
            if (!fields.finalComment) {
                var fc = blob.match(/Final\s+Comment\s*:\s*([\s\S]*?)(?=Overall\s+Communication\s+Score\s*:|(?:Overall\s+)?Communication\s+Score\s*:|Communication\s+Score\s+Reasoning\s*:|LLM\s+Detection|$)/i);
                if (fc) fields.finalComment = fc[1].trim();
            }
            if (!fields.commScore) {
                var cs = blob.match(/(?:Overall\s+)?Communication\s+Score(?!\s+Reasoning)\s*:\s*([^\n\r]+?)(?=\s*(?:Communication\s+Score\s+Reasoning\s*:|Communication\s+Comments?\s*:|Final\s+Verdict\s*:|Final\s+Comment\s*:|LLM\s+|$))/i);
                if (cs) fields.commScore = cs[1].trim();
            }
            if (!fields.commReason) {
                var cr = blob.match(/Communication\s+Score\s+Reasoning\s*:\s*([\s\S]*?)(?=LLM\s+Detection|LLM\s+Response\s+Suspected\s*:|Evidence\s+Comment\s*:|Final\s+Verdict\s*:|Final\s+Comment\s*:|$)/i);
                if (cr) fields.commReason = cr[1].trim();
            }
            if (!fields.commReason) {
                var cc = blob.match(/Communication\s+Comments?\s*:\s*([\s\S]*?)(?=LLM\s+Detection|LLM\s+Response\s+Suspected\s*:|Evidence\s+Comment\s*:|Final\s+Verdict\s*:|Final\s+Comment\s*:|$)/i);
                if (cc) fields.commReason = cc[1].trim();
            }
            if (!fields.llmSuspected) {
                var ls = blob.match(/LLM\s+Response\s+Suspected\s*:\s*([^\n\r]+)/i);
                if (ls) fields.llmSuspected = ls[1].trim();
            }
            if (!fields.llmEvidence) {
                var le = blob.match(/Evidence\s+Comment\s*:\s*([\s\S]*?)(?=Questions\s+Discussed|Competenc|$)/i);
                if (le) fields.llmEvidence = le[1].trim();
            }

            splitMergedVerdictComment();
            splitMergedCommScoreReason();

            function colIndex(headers, re) {
                for (var i = 0; i < headers.length; i++) {
                    if (re.test(headers[i])) return i;
                }
                return -1;
            }

            function normalizeRubricTableToVideoFormat(table) {
                if (!table || table.getAttribute('data-rb-rubric-normalized') === '1') return table;

                var headerCells = table.querySelectorAll('thead th');
                var headerRowIsTd = false;
                if (!headerCells.length && table.rows.length) {
                    headerCells = table.rows[0].querySelectorAll('th, td');
                    headerRowIsTd = table.rows[0].querySelector('th') == null;
                }
                var headers = [];
                Array.prototype.forEach.call(headerCells, function (cell, idx) {
                    headers[idx] = ((cell.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase());
                });

                var itemIdx = colIndex(headers, /rubric\s*item|competenc|skill(?:\s*name)?|parameter|item|area|topic|^skill$/);
                if (itemIdx < 0) itemIdx = 0;
                var expectedIdx = colIndex(headers, /expected|jd\s*level|required|target|self.?rating/);
                var observedIdx = colIndex(headers, /observed|candidate\s*level|ai.?rating|actual|demonstrated/);
                var scoreIdx = colIndex(headers, /^score$|weighted|rating\s*score|max.?rating|points/);
                if (scoreIdx < 0) scoreIdx = colIndex(headers, /\bscore\b/);
                // Avoid mapping the same column twice
                if (scoreIdx === itemIdx || scoreIdx === expectedIdx || scoreIdx === observedIdx) scoreIdx = -1;
                if (expectedIdx === itemIdx) expectedIdx = -1;
                if (observedIdx === itemIdx || observedIdx === expectedIdx) observedIdx = -1;

                var bodyRows = table.tBodies.length
                    ? Array.prototype.slice.call(table.tBodies[0].rows)
                    : Array.prototype.slice.call(table.rows, (table.querySelector('thead') || headerRowIsTd) ? 1 : 0);
                if (headerRowIsTd && bodyRows.length && bodyRows[0] === table.rows[0]) {
                    bodyRows = bodyRows.slice(1);
                }

                function cellText(row, idx) {
                    if (idx < 0 || !row.cells[idx]) return '';
                    return ((row.cells[idx].textContent || '').replace(/\s+/g, ' ').trim());
                }

                function levelPillHtml(raw) {
                    var v = (raw || '').trim();
                    if (!v || v === '—' || v === '-' || v === '–') return escapeHtml('—');
                    var x = v.toLowerCase();
                    var pill = 'rb-adaptive-rating-pill--neutral';
                    if (/excellent|outstanding|strong|good|proficient|advanced|senior|expert|high|above|exceed|meet|pass|positive|hire/.test(x)) {
                        pill = 'rb-adaptive-rating-pill--good';
                    }
                    return '<span class="rb-adaptive-rating-pill ' + pill + '">' + escapeHtml(v) + '</span>';
                }

                var built = document.createElement('table');
                built.className = 'rb-ai-rubric-table';
                built.setAttribute('data-rb-rubric-normalized', '1');
                built.innerHTML =
                    '<thead><tr>' +
                    '<th>Rubric Item</th>' +
                    '<th class="rb-ai-r-level">Expected</th>' +
                    '<th class="rb-ai-r-level">Observed</th>' +
                    '<th class="rb-ai-r-score">Score</th>' +
                    '</tr></thead><tbody></tbody>';
                var tbody = built.querySelector('tbody');

                bodyRows.forEach(function (row) {
                    if (!row.cells || !row.cells.length) return;
                    var item = cellText(row, itemIdx);
                    if (!item) return;
                    var expected = expectedIdx >= 0 ? cellText(row, expectedIdx) : '';
                    var observed = observedIdx >= 0 ? cellText(row, observedIdx) : '';
                    var score = scoreIdx >= 0 ? cellText(row, scoreIdx) : '';
                    // If score empty but a trailing numeric cell exists, use it
                    if (!score) {
                        for (var c = row.cells.length - 1; c >= 0; c--) {
                            if (c === itemIdx || c === expectedIdx || c === observedIdx) continue;
                            var raw = cellText(row, c);
                            if (/^\d+(\.\d+)?(\s*\/\s*\d+(\.\d+)?)?%?$/.test(raw)) {
