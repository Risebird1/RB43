        <div>
            <div class="rb-report-section" style="margin-bottom:20px; @(ViewBag.IsAdaptive == true ? "margin-top:0;border-top:none;border-radius:0 0 10px 10px;" : "")">

                <div class="rb-analysis-content">
                    @if (Model.AIInterviewEvaluation != null)
                    {
                        <div class="rb-ai-analysis-layout">
                            @{
                                string GetQVerdictPillClass(string verdict)
                                {
                                    if (string.IsNullOrWhiteSpace(verdict)) return "rb-ai-verdict-pill--neutral";
                                    var v = verdict.Trim().ToLowerInvariant();
                                    if (v.Contains("reject")) return "rb-ai-verdict-pill--reject";
                                    if (v.Contains("select")) return "rb-ai-verdict-pill--select";
                                    if (v == "average") return "rb-ai-verdict-pill--avg";
                                    return "rb-ai-verdict-pill--neutral";
                                }
                                string GetRubricLevelPillClass(string level)
                                {
                                    if (string.IsNullOrWhiteSpace(level)) return null;
                                    var v = level.Trim();
                                    if (v == "—" || v == "-" || v == "–") return null;
                                    var x = v.ToLowerInvariant();
                                    if (x.Contains("excellent") || x.Contains("outstanding") || x.Contains("strong") ||
                                        x.Contains("good") || x.Contains("proficient") || x.Contains("advanced") ||
                                        x.Contains("senior") || x.Contains("expert") || x.Contains("high") ||
                                        x.Contains("above") || x.Contains("exceed") || x.Contains("meet") ||
                                        x.Contains("pass") || x.Contains("positive") || x.Contains("hire"))
                                        return "rb-adaptive-rating-pill--good";
                                    return "rb-adaptive-rating-pill--neutral";
                                }
                                string GetFvBadgeClass(string verdict)
                                {
                                    if (AIInterviewVerdict.IsRejectFamily(verdict)) return "ai-final-verdict-reject";
                                    if (AIInterviewVerdict.IsSelectFamily(verdict)) return "ai-final-verdict-select";
                                    if (!string.IsNullOrWhiteSpace(verdict) && verdict.Trim().Equals("average", StringComparison.OrdinalIgnoreCase))
                                        return "ai-final-verdict-average";
                                    return null;
                                }
                            }

                            <div class="rb-ai-summary-grid">
                                @if (Model.AIInterviewEvaluation.OverallTechnicalScore != 0)
                                {
                                    <div class="rb-ai-metric">
                                        <div class="rb-ai-metric__main">
                                            <div class="rb-ai-metric__label"><img src="/img/techskill-score.png" alt="" /> Overall Skill Score</div>
                                            <div class="rb-ai-metric__value">@Model.AIInterviewEvaluation.OverallTechnicalScore</div>
                                        </div>
                                    </div>
                                }
                                @if (Model.AIInterviewEvaluation.OverallCommunicationScore != 0)
                                {
                                    <div class="rb-ai-metric">
                                        <div class="rb-ai-metric__main">
                                            <div class="rb-ai-metric__label"><img src="/img/communication-score.png" alt="" /> Communication Score</div>
                                            <div class="rb-ai-metric__value">@Model.AIInterviewEvaluation.OverallCommunicationScore</div>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict))
                                {
                                    var fv = AIInterviewVerdict.Normalize(Model.AIInterviewEvaluation.FinalVerdict.Trim());
                                    var fvClass = GetFvBadgeClass(fv);
                                    <div class="rb-ai-metric">
                                        <div class="rb-ai-metric__main">
                                            <div class="rb-ai-metric__label"><img src="/img/interviewer-comment.png" alt="" /> Final Verdict</div>
                                            <div class="rb-ai-metric__value">
                                                @if (fvClass != null)
                                                {
                                                    <span class="ai-final-verdict-badge @fvClass">@fv</span>
                                                }
                                                else
                                                {
                                                    @fv
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (Model.AIResumeScreeningScore != 0)
                                {
                                    <div class="rb-ai-metric">
                                        <div class="rb-ai-metric__main">
                                            <div class="rb-ai-metric__label"><img src="/img/resume-screening.png" alt="" /> Resume Screening</div>
                                            <div class="rb-ai-metric__value">@Model.AIResumeScreeningScore</div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.AIResumeScreeningVerdict))
                                        {
                                            <div class="rb-ai-metric__sub">@Model.AIResumeScreeningVerdict</div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning))
                            {
                                <div class="rb-ai-panel rb-ai-panel--full">
                                    <div class="rb-ai-panel__head">
                                        <img src="/img/communication-score.png" alt="" />
                                        <span class="rb-ai-panel__title">Communication Analysis</span>
                                    </div>
                                    <p class="rb-ai-comment-block">@Model.AIInterviewEvaluation.OverallCommunicationScoreReasoning</p>
                                </div>
                            }

                            <div class="rb-ai-two-col">
                                <div class="rb-ai-panel">
                                    @if (Model.AIInterviewEvaluation.AadharVerificationId > 0)
                                    {
                                        <div class="rb-ai-panel__head">
                                            <img src="/img/acknowledge-tick.png" alt="" />
                                            <span class="rb-ai-panel__title">Verification</span>
                                        </div>
                                        <div class="rb-ai-verify-grid">
                                            <div class="rb-ai-verify-item">
                                                <div class="info-label">Aadhaar Verified</div>
                                                <span class="status-badge success">Yes</span>
                                            </div>
                                            <div class="rb-ai-verify-item">
                                                <div class="info-label">Match Score %</div>
                                                <div class="info-value-simple">@Model.MatchScorePercentage</div>
                                            </div>
                                        </div>
                                        <a href="#" class="aadhaar-link" onclick="javascript:FetchAadhaarDetails('@Model.InterviewId','@Model.CandidateEmail');">
                                            <i class="fa fa-id-card"></i> Candidate verified data
                                        </a>
                                    }

                                    <div class="rb-ai-panel__head" style="@(Model.AIInterviewEvaluation.AadharVerificationId > 0 ? "margin-top:12px;" : "")">
                                        <img src="/img/techskill-score.png" alt="" />
                                        <span class="rb-ai-panel__title">Score Rubric</span>
                                    </div>
                                    @if (Model.AIInterviewEvaluation?.RubricScoreSummary != null && Model.AIInterviewEvaluation.RubricScoreSummary.Any())
                                    {
                                        <div class="rb-ai-table-wrap">
                                            <table class="rb-ai-rubric-table">
                                                <thead>
                                                    <tr>
                                                        <th>Rubric Item</th>
                                                        <th class="rb-ai-r-level">Expected</th>
                                                        <th class="rb-ai-r-level">Observed</th>
                                                        <th class="rb-ai-r-score">Score</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var r in Model.AIInterviewEvaluation.RubricScoreSummary)
                                                    {
                                                        var expectedText = string.IsNullOrWhiteSpace(r.ExpectedLevel) ? "—" : r.ExpectedLevel.Trim();
                                                        var observedText = string.IsNullOrWhiteSpace(r.ObservedLevel) ? "—" : r.ObservedLevel.Trim();
                                                        var expectedPill = GetRubricLevelPillClass(expectedText);
                                                        var observedPill = GetRubricLevelPillClass(observedText);
                                                        <tr>
                                                            <td>@r.RubricItem</td>
                                                            <td class="rb-ai-r-level">
                                                                @if (expectedPill != null)
                                                                {
                                                                    <span class="rb-adaptive-rating-pill @expectedPill">@expectedText</span>
                                                                }
                                                                else
                                                                {
                                                                    @expectedText
                                                                }
                                                            </td>
                                                            <td class="rb-ai-r-level">
                                                                @if (observedPill != null)
                                                                {
                                                                    <span class="rb-adaptive-rating-pill @observedPill">@observedText</span>
                                                                }
                                                                else
                                                                {
                                                                    @observedText
                                                                }
                                                            </td>
                                                            <td class="rb-ai-r-score">@r.Score</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="rb-ai-no-data-inline">No rubric summary found.</p>
                                    }
                                </div>

                                <div class="rb-ai-panel">
                                    <div class="rb-ai-panel__head">
                                        <img src="/img/interviewer-comment.png" alt="" />
                                        <span class="rb-ai-panel__title">AI Interviewer Comment</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict) || !string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment))
                                    {
                                        @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalVerdict))
                                        {
                                            var fvPanel = AIInterviewVerdict.Normalize(Model.AIInterviewEvaluation.FinalVerdict.Trim());
                                            var fvPanelClass = GetFvBadgeClass(fvPanel);
                                            <div class="rb-ai-comment-label">Final Verdict</div>
                                            <div style="margin-bottom:8px;">
                                                @if (fvPanelClass != null)
                                                {
                                                    <span class="ai-final-verdict-badge @fvPanelClass">@fvPanel</span>
                                                }
                                                else
                                                {
                                                    <span style="font-weight:600;color:#0f172a;">@fvPanel</span>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.FinalComment))
                                        {
                                            <div class="rb-ai-comment-label">Final Comment</div>
                                            <p class="rb-ai-comment-block">@Model.AIInterviewEvaluation.FinalComment</p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="rb-ai-no-data-inline">No comment found.</p>
                                    }

                                    @if (Model.AIInterviewEvaluation.LlmDetection != null)
                                    {
                                        <div class="rb-ai-panel__head" style="margin-top:12px;">
                                            <img src="/img/lm-detection.png" alt="" />
                                            <span class="rb-ai-panel__title">LLM Detection</span>
                                        </div>
                                        <div class="rb-ai-comment-block">
                                            <strong>Suspected:</strong> @(Model.AIInterviewEvaluation.LlmDetection.LlmResponseSuspected ? "Yes" : "No")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.AIInterviewEvaluation.LlmDetection.EvidenceComment))
                                        {
                                            <div class="rb-ai-comment-label" style="margin-top:8px;">Evidence</div>
                                            <p class="rb-ai-comment-block">@Model.AIInterviewEvaluation.LlmDetection.EvidenceComment</p>
                                        }
                                        @if (Model.AIInterviewEvaluation.LlmDetection.SuspiciousInstances != null && Model.AIInterviewEvaluation.LlmDetection.SuspiciousInstances.Any())
                                        {
                                            <div class="rb-ai-comment-label" style="margin-top:8px;">Suspicious Instances</div>
                                            <p class="rb-ai-evidence-hint">Informational only — not a skill or communication score.</p>
                                            <table class="rb-ai-evidence-table">
                                                <thead>
                                                    <tr>
                                                        <th>Question</th>
                                                        <th>Evidence</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.AIInterviewEvaluation.LlmDetection.SuspiciousInstances)
                                                    {
                                                        var splitAt = item == null ? -1 : item.IndexOf(": ", StringComparison.Ordinal);
                                                        var questionPart = splitAt > 0 ? item.Substring(0, splitAt) : "—";
                                                        var evidencePart = splitAt > 0 ? item.Substring(splitAt + 2) : item;
                                                        <tr>
                                                            <td>@questionPart</td>
                                                            <td>@evidencePart</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    }
                                </div>
                            </div>

                            <div id="question-list" class="rb-ai-panel rb-ai-panel--full">
                                <div class="rb-ai-panel__head">
                                    <img src="/img/question-asked.png" alt="" />
                                    <span class="rb-ai-panel__title">Questions Discussed &amp; Competency Rating</span>
                                </div>
                                @if (Model.AIInterviewEvaluation?.QuestionRatings != null && Model.AIInterviewEvaluation.QuestionRatings.Any())
                                {
                                    <div class="rb-ai-q-list">
                                        @{ var qIdx = 1; }
                                        @foreach (var q in Model.AIInterviewEvaluation.QuestionRatings)
                                        {
                                            <div class="rb-ai-q-card">
                                                <div class="rb-ai-q-card__head">
                                                    <span class="rb-ai-q-card__num">@qIdx</span>
                                                    <div class="rb-ai-q-card__text">@q.Question</div>
                                                </div>
                                                <div class="rb-ai-q-card__meta">
                                                    @if (!string.IsNullOrWhiteSpace(q.Verdict))
                                                    {
                                                        <span class="rb-ai-meta-chip">
                                                            <strong>Rating</strong>
                                                            <span class="rb-ai-verdict-pill @GetQVerdictPillClass(q.Verdict)">@q.Verdict</span>
                                                        </span>
                                                    }
                                                    @if (q.Score != 0)
                                                    {
                                                        <span class="rb-ai-meta-chip"><strong>Score</strong> @q.Score</span>
                                                    }
                                                    @if (q.CommunicationScore != 0)
                                                    {
                                                        <span class="rb-ai-meta-chip"><strong>Comm.</strong> @q.CommunicationScore</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(q.Comment))
                                                {
                                                    <div class="rb-ai-q-card__note">
                                                        <span class="rb-ai-q-card__note-label">Comment</span>@q.Comment
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(q.CommunicationComment))
                                                {
                                                    <div class="rb-ai-q-card__note">
                                                        <span class="rb-ai-q-card__note-label">Comm. Comment</span>@q.CommunicationComment
                                                    </div>
                                                }
                                            </div>
                                            qIdx++;
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="rb-ai-no-data-inline"><img width="20" src="/img/no-question.png" alt="" style="margin-right:6px;vertical-align:middle;" />No questions found.</p>
                                }
                            </div>
                        </div>


                    }
                    else if (!string.IsNullOrWhiteSpace(Model.RawAIReportHtml))
                    {
                        <div class="@(ViewBag.IsAdaptive == true ? "rb-ai-adaptive-report" : "rb-ai-raw-report")" id="@(ViewBag.IsAdaptive == true ? "rb-adaptive-ai-analysis" : null)">
                            @Html.Raw(Model.RawAIReportHtml)
                        </div>
                    }
                    else
                    {
                        <div class="rb-no-data">
                            <i class="fa fa-info-circle"></i>
                            <p>No analysis data available for this interview session.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="desktop-view">
            @if (Model.sentimentViewModel != null)
            {
                <div class="rb-video-item" style="margin-bottom:20px;">
                    <div class="sentiment-container">
                        <div class="rb-section-header" style="margin: 0px;">
                            <h2 style="padding-bottom: 10px;margin: 0px;">
                                <i class="fa fa-smile-o"></i>Sentiment Analysis
                            </h2>
                        </div>
                        <div class="sentiment-content">
                            <!-- Sentiment Score Card -->
                            <div class="sentiment-score-card">
                                <div class="sentiment-score-header">Candidate Answer</div>
                                <div class="sentiment-gauge-container">
                                    <video controls="" style="width:300px;" class="rb-video-element">
                                        <source src="@Model.sentimentViewModel.VideoUrl" type="video/mp4">
                                        <source src="@Model.sentimentViewModel.VideoUrl" type="video/webm">
                                        Your browser does not support the video element.
                                    </video>
                                </div>
                            </div>

                            <!-- Main Content Card -->
                            <div class="sentiment-main-card">

                                <div class="sentiment-card-body">
                                    <div class="sentiment-avatar">
                                        <img style="max-width:80%" src="../../img/sentiment-analysis.png">
                                    </div>
                                    <div class="sentiment-details">


                                        <!-- Sentiment Metrics Section -->
                                        <div class="sentiment-metric-label">TOP SENTIMENTS :</div>
                                        <div class="sentiment-metrics">
                                            <div class="sentiment-metric-section top-modifiers-section">
                                                <div class="modifiers-grid">
                                                    @if (Model.sentimentViewModel.FEAR.HasValue && Model.sentimentViewModel.FEAR.Value > 0)
                                                    {
                                                        var fearValues = Model.sentimentViewModel.FEAR ?? 0;
                                                        var fearPercent = System.Math.Round(fearValues, 1);
                                                        var circumference = 2 * System.Math.PI * 20; // radius = 20
                                                        var offset = circumference - (circumference * fearValues / 100);
                                                        <div class="modifier-tag @(fearValues >= 70 ? "confidence-high" : fearValues >= 40 ? "confidence-medium" : "confidence-low")" data-keyword="fear">
                                                            <div class="modifier-tag-content">
                                                                <div class="modifier-tag-name">Fear</div>
                                                                <div class="modifier-tag-gauge">
                                                                    <svg>
                                                                        <circle class="modifier-tag-gauge-circle" cx="25" cy="25" r="20"></circle>
                                                                        <circle class="modifier-tag-gauge-fill" cx="25" cy="25" r="20"
                                                                                style="stroke-dasharray: @circumference; stroke-dashoffset: @circumference;"
                                                                                data-percent="@fearValues"></circle>
                                                                    </svg>
                                                                    <div class="modifier-tag-gauge-value">@fearPercent%</div>
                                                                </div>
                                                                <div class="confidence-level-label">
                                                                    <span>Confidence Level</span>

                                                                </div>


