                                    @* <div>
                        <a target="_blank" class="rb-action-btn rb-primary-btn" style="color:#fff!important;float:right;margin-left:12px;padding:10px 27px;line-height:1;" href="@Url.Action("GetSentimentAnalysis", "Candidate", new { videoId = videoDetail.id})">
