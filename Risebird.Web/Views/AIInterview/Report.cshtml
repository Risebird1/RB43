@using Risebird.Entities.Data
@using Risebird.Entities.ViewModel
@using System.Linq
@using System.Text.Json
@using System.Web
@model AIInterviewReportWrapperClass
@{
    ViewData["Title"] = "AI Interview Report";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    // Dark theme only for adaptive (audio) interviews — video keeps the original light UI.
    ViewBag.AiInterviewDarkTheme = ViewBag.IsAdaptive == true;
}

<style>
    /* Color Variations based on confidence */
    .modifier-tag.confidence-high .modifier-tag-gauge-fill {
        stroke: #28a745;
    }

    .modifier-tag.confidence-high .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #28a745, #34ce57);
    }

    .modifier-tag.confidence-medium .modifier-tag-gauge-fill {
        stroke: #ffc107;
    }

    .modifier-tag.confidence-medium .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #ffc107, #ffca2c);
    }

    .modifier-tag.confidence-low .modifier-tag-gauge-fill {
        stroke: #dc3545;
    }

    .modifier-tag.confidence-low .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #dc3545, #e4606d);
    }

    .modifier-tag.confidence-normal .modifier-tag-gauge-fill {
        stroke: #4a90e2;
    }

    .modifier-tag.confidence-normal .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #4a90e2, #5ba3f5);
    }

    .table-bordered {
        border: 1px solid #b3a7a740 !important;
    }

    .rb-report-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 32px rgba(78, 218, 146, 0.1);
    }

    .rb-report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 2px solid #f0f0f0;
    }

    .rb-report-title-section h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #000;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        letter-spacing: -1.5px;
    }

    .rb-report-title i {
        color: #97caf4;
    }

    .rb-report-subtitle {
        font-size: 1.1rem;
        color: #666;
        margin: 0;
    }

    .rb-report-meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
        text-align: right;
    }

    .rb-report-actions-row {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
        align-items: center;
    }

    .rb-report-date {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #666;
        font-size: 0.9rem;
    }

    .rb-report-section {
        margin-bottom: 40px;
    }

    .rb-section-header {
        margin-bottom: 24px;
    }

        .rb-section-header h2 {
            font-size: 1.35rem;
            font-weight: 600;
            color: #000;
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 0;
        }

        .rb-section-header i {
            color: #97caf4;
        }

    .rb-summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .rb-summary-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .rb-summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

    .rb-card-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #4eda92 60%, #56e0cb 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
    }

        .rb-card-icon .fa-clock:before {
            position: relative;
            font-weight: 500;
            font-size: 22px;
        }

    .rb-card-content h3 {
        margin: 0 0 4px 0;
        font-size: 1rem;
        color: #666;
        font-weight: 500;
    }

    .rb-card-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #000;
    }

    .rb-analysis-content {
        background: #fafbfc;
        border-radius: 12px;
        padding: 0px 0px 10px 0px;
    }

    .rb-analysis-item {
        background: white;
        border-radius: 8px;
        padding: 10px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.12);
    }

    .rb-analysis-header {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 12px;
    }

        .rb-analysis-header .fa-lightbulb:before {
            font-size: 17px;
        }

    .rb-analysis-title {
        font-weight: 400;
        color: #666;
        font-size: 14px;
    }

    .rb-analysis-text {
        line-height: 1.6;
        color: #333;
    }

    .rb-video-responses {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .rb-video-item {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .rb-video-header {
        display: inline-flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        width: 50%;
        float: left;
    }

    .rb-video-info h4 {
        margin: 0 0 8px 0;
        color: #000;
        font-weight: 600;
        font-size: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .rb-question-number {
        background: linear-gradient(135deg, #4eda92 0%, #56e0cb 100%);
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .rb-question-separator {
        width: 2px;
        min-height: 400px;
        background: linear-gradient(180deg, transparent 0%, #4eda92 20%, #56e0cb 50%, #4eda92 80%, transparent 100%);
        margin: 0 30px;
        border-radius: 1px;
        opacity: 0.6;
        position: relative;
        display: inline-block;
        vertical-align: top;
        align-self: stretch;
    }

    .rb-question-separator-decorative {
        height: 1px;
        background: #e0e0e0;
        margin: 40px 0;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .rb-question-separator-decorative::before {
            content: "●";
            background: white;
            color: #4eda92;
            font-size: 1.2rem;
            padding: 0 15px;
            position: relative;
            z-index: 1;
        }

        .rb-question-separator:last-child,
        .rb-question-separator-decorative:last-child {
            display: none;
        }

    .rb-video-item {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: 1px solid #f0f0f0;
        margin-bottom: 0;
    }

        .rb-video-item:not(:last-child) {
            margin-bottom: 20px;
        }

    .rb-video-question {
        margin: 0 0 10px 0px;
        color: #666;
        line-height: 1.5;
        font-size: 15px;
        word-wrap: break-word;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .rb-video-status {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.9rem;
    }

    .rb-status-complete {
        color: #28a745;
    }

    .rb-status-pending {
        color: #ffc107;
    }

    .rb-video-player {
        width: 100%;
        max-width: 450px;
        float: left;
    }

    .rb-video-element {
        width: 100%;
        max-width: 435px;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: 9px #e9ecef solid;
    }

    .rb-chat-log-report {
        background: #fafbfc;
        border-radius: 12px;
        padding: 20px;
        max-height: 500px;
        overflow-y: auto;
    }

    .rb-chat-message-report {
        margin-bottom: 16px;
        padding: 16px;
        border-radius: 8px;
        background: white;
    }

    .rb-user-message {
        border-left: 4px solid #4eda92;
    }

    .rb-bot-message {
        border-left: 4px solid #007bff;
    }

    .rb-message-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .rb-message-role {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .rb-user-message .rb-message-role {
        color: #4eda92;
    }

    .rb-bot-message .rb-message-role {
        color: #007bff;
    }

    .rb-message-time {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.8rem;
        color: #999;
    }

    .rb-message-content {
        line-height: 1.5;
        color: #333;
    }

    .rb-no-data {
        text-align: center;
        padding: 40px;
        color: #666;
    }

        .rb-no-data i {
            font-size: 3rem;
            margin-bottom: 16px;
            color: #ccc;
        }

    /* AI-generated HTML report (Adaptive interviews) rendered as-is */
    .rb-ai-raw-report {
        padding: 8px 20px 20px 20px;
        color: #333;
        line-height: 1.5;
        overflow: visible;
    }

        .rb-ai-raw-report h2,
        .rb-ai-raw-report h3,
        .rb-ai-raw-report h4 {
            color: #1a1a2e;
            margin: 14px 0 8px 0;
            font-size: 1rem;
        }

        .rb-ai-raw-report table {
            width: 100%;
            border-collapse: collapse;
            margin: 8px 0 14px 0;
            font-size: 12px;
            table-layout: fixed;
        }

        .rb-ai-raw-report th,
        .rb-ai-raw-report td {
            border: 1px solid #e0e0e0;
            padding: 5px 7px;
            text-align: left;
            vertical-align: top;
            word-wrap: break-word;
            word-break: break-word;
            overflow-wrap: break-word;
            white-space: normal;
            line-height: 1.4;
        }

        .rb-ai-raw-report th {
            background: #f4fbf7;
            color: #1a1a2e;
            font-weight: 600;
        }

        .rb-ai-raw-report tr:nth-child(even) td {
            background: #fafafa;
        }

        .rb-ai-raw-report hr {
            border: 0;
            border-top: 1px solid #eee;
            margin: 18px 0;
        }

    /* ── Audio Adaptive: AI Analysis (video-report style) ───────────────── */
    .rb-ai-adaptive-report {
        padding: 4px 8px 8px;
        background: #fff;
        color: #334155;
        line-height: 1.55;
    }

    .rb-ai-adaptive-report > *:first-child {
        margin-top: 0;
    }

    .rb-ai-adaptive-report h2,
    .rb-ai-adaptive-report h3,
    .rb-ai-adaptive-report h4 {
        color: #0f172a;
        margin: 22px 0 10px;
        font-size: 15px;
        font-weight: 700;
        line-height: 1.4;
    }

    .rb-ai-adaptive-report table {
        width: 100%;
        border-collapse: collapse;
        margin: 6px 0 12px;
        font-size: 12px;
        table-layout: fixed;
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 8px;
        overflow: visible;
        box-shadow: none;
        max-width: 100% !important;
    }

    .rb-ai-adaptive-report th,
    .rb-ai-adaptive-report td {
        border: none;
        border-bottom: 1px solid #eef2f6;
        padding: 4px 8px;
        text-align: left;
        vertical-align: middle;
        word-wrap: break-word;
        line-height: 1.3;
        color: #334155;
    }

    .rb-ai-adaptive-report tr:last-child td {
        border-bottom: none;
    }

    .rb-ai-adaptive-report th {
        background: #f1f5f9;
        color: #64748b;
        font-weight: 700;
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 5px 8px;
        border-bottom: 1px solid #e2e8f0;
        white-space: nowrap;
    }

    .rb-ai-adaptive-report tbody tr:nth-child(even) td,
    .rb-ai-adaptive-report tr:nth-child(even) td {
        background: #f8fafc;
    }

    .rb-ai-adaptive-report tbody tr:hover td {
        background: #f1f5f9;
    }

    /* Compact competency / score rating tables — wrap text, no scroll */
    .rb-ai-adaptive-report h2.rb-adaptive-table-title,
    .rb-ai-adaptive-report h3.rb-adaptive-table-title,
    .rb-ai-adaptive-report h4.rb-adaptive-table-title,
    .rb-ai-adaptive-report .rb-adaptive-table-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 10px;
        padding: 0 0 8px;
        background: transparent;
        border: none;
        border-bottom: 1px solid #eef2f6;
        border-radius: 0;
        color: #1e293b;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.03em;
        line-height: 1.3;
        text-transform: uppercase;
    }

    .rb-ai-adaptive-report h2.rb-adaptive-table-title::before,
    .rb-ai-adaptive-report h3.rb-adaptive-table-title::before,
    .rb-ai-adaptive-report h4.rb-adaptive-table-title::before {
        content: none;
    }

    .rb-ai-adaptive-report .rb-adaptive-table-title i {
        color: #3b82f6;
        font-size: 14px;
    }

    .rb-ai-adaptive-report .rb-adaptive-section-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 12px 14px;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
        margin: 0 0 14px;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table {
        width: 100% !important;
        max-width: 100% !important;
        table-layout: fixed;
        font-size: 12px;
        margin: 0 0 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: visible;
        border-collapse: collapse;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table thead th,
    .rb-ai-adaptive-report table.rb-adaptive-rating-table tr:first-child th,
    .rb-ai-adaptive-report table.rb-adaptive-rating-table tr:first-child td.rb-adaptive-th {
        background: #f1f5f9 !important;
        color: #475569 !important;
        font-size: 11px !important;
        font-weight: 700 !important;
        text-transform: none;
        letter-spacing: 0.01em;
        padding: 8px 10px !important;
        border: none !important;
        border-bottom: 1px solid #e2e8f0 !important;
        text-align: left;
        white-space: nowrap;
        vertical-align: middle;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table td {
        padding: 8px 10px !important;
        vertical-align: top;
        line-height: 1.4;
        border: none !important;
        border-bottom: 1px solid #eef2f6 !important;
        overflow: visible;
        text-overflow: clip;
        white-space: normal;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table tr:last-child td {
        border-bottom: none !important;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table td:first-child {
        text-align: left;
        font-weight: 600;
        color: #1e293b;
        width: 34%;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table td.rb-adaptive-text-col {
        text-align: left !important;
        white-space: normal !important;
        font-weight: 400;
        color: #334155;
        width: auto;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table td.rb-adaptive-metric-col {
        text-align: center !important;
        white-space: nowrap;
        vertical-align: middle;
        width: 1%;
    }

    .rb-ai-adaptive-report .rb-adaptive-clamp {
        display: block;
    }

    .rb-ai-adaptive-report .rb-adaptive-clamp__short,
    .rb-ai-adaptive-report .rb-adaptive-clamp__full {
        white-space: pre-wrap;
        word-break: break-word;
        overflow-wrap: anywhere;
        line-height: 1.45;
    }

    .rb-ai-adaptive-report .rb-adaptive-clamp.is-expanded .rb-adaptive-clamp__short {
        display: none;
    }

    .rb-ai-adaptive-report .rb-adaptive-clamp:not(.is-expanded) .rb-adaptive-clamp__full {
        display: none;
    }

    .rb-ai-adaptive-report .rb-adaptive-clamp__toggle {
        display: inline-block;
        margin-top: 4px;
        font-size: 11px;
        font-weight: 600;
        color: #2563eb;
        cursor: pointer;
        text-decoration: none;
        background: none;
        border: none;
        padding: 0;
    }

    .rb-ai-adaptive-report .rb-adaptive-clamp__toggle:hover {
        text-decoration: underline;
        color: #1d4ed8;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-score {
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
        font-size: 12px;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-bar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: 100%;
        max-width: 120px;
        margin: 0 auto;
        vertical-align: middle;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-bar__track {
        flex: 1 1 auto;
        height: 6px;
        min-width: 48px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-bar__fill {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #38bdf8 0%, #22c55e 100%);
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-bar__fill--low { background: #ef4444; }
    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-bar__fill--mid { background: #eab308; }
    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-bar__fill--high { background: #22c55e; }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-stars {
        display: inline-flex;
        gap: 1px;
        color: #f59e0b;
        font-size: 11px;
        line-height: 1;
        white-space: nowrap;
    }

    .rb-ai-adaptive-report table.rb-adaptive-rating-table .rb-adaptive-stars .rb-star-empty {
        color: #cbd5e1;
    }

    .rb-ai-adaptive-report .rb-adaptive-rating-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.02em;
        line-height: 1.3;
        white-space: normal;
        word-break: break-word;
        max-width: 100%;
    }

    .rb-ai-adaptive-report .rb-adaptive-rating-pill--excellent { background: #dcfce7; color: #15803d; }
    .rb-ai-adaptive-report .rb-adaptive-rating-pill--good { background: #dbeafe; color: #1d4ed8; }
    .rb-ai-adaptive-report .rb-adaptive-rating-pill--average { background: #fef9c3; color: #a16207; }
    .rb-ai-adaptive-report .rb-adaptive-rating-pill--below { background: #ffedd5; color: #c2410c; }
    .rb-ai-adaptive-report .rb-adaptive-rating-pill--poor { background: #fee2e2; color: #b91c1c; }
    .rb-ai-adaptive-report .rb-adaptive-rating-pill--neutral { background: #f1f5f9; color: #475569; }

    .rb-ai-adaptive-report .rb-adaptive-table-wrap {
        overflow-x: auto;
        max-height: none !important;
        margin: 0 0 14px;
        border-radius: 8px;
        width: 100%;
        max-width: 100%;
    }

    .rb-ai-adaptive-report .rb-adaptive-table-wrap > table {
        margin: 0;
        width: 100% !important;
        max-width: 100% !important;
    }

    .rb-ai-adaptive-report table {
        max-width: 100% !important;
    }

    .rb-ai-adaptive-report .rb-adaptive-overview {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 0 0 16px;
    }

    .rb-ai-adaptive-report .rb-adaptive-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .rb-ai-adaptive-report .rb-adaptive-metric-card {
        flex: 1 1 180px;
        background: rgba(151, 202, 244, 0.12);
        border: 1px solid rgba(151, 202, 244, 0.28);
        border-radius: 10px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .rb-ai-adaptive-report .rb-adaptive-metric-card__label {
        font-size: 12px;
        font-weight: 600;
        color: #475569;
    }

    .rb-ai-adaptive-report .rb-adaptive-metric-card__value {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        white-space: nowrap;
    }

    .rb-ai-adaptive-report .rb-adaptive-two-col {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        align-items: start;
        width: 100%;
    }

    .rb-ai-adaptive-report .rb-adaptive-overview .rb-ai-two-col {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        align-items: start;
        width: 100%;
