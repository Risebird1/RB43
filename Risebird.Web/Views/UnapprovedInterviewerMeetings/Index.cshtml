    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
        var scID =  @Html.Raw(Json.Serialize(SCID));
        var confirmationStatus =  @Html.Raw(Json.Serialize(ConfirmationStatus));
        var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
        var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
        var interviewer =  @Html.Raw(Json.Serialize(Interviewer));
        
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#PrimarySkill").val(primarySkillsArr);
        $("#SCID").val(scID);
        $("#ConfirmationStatus").val(confirmationStatus);
        $("#MeetingStatus").val(meetingStatus);
        $("#InterviewStatus").val(interviewStatus);
        $("#Interviewer").val(interviewer);
        var form = $("#form").serialize();
}


</script>
@if (ViewBag.Message != null)
{

    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        location.reload();

                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        location.reload();
                    }
                )
            }

        }
        window.onload = my_code();
    </script>

}


