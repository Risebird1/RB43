@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Unapproved Interviewer Meetings";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] primarySkills = new string[] { };
    string[] SCID = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] Interviewer = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("UnapprovedInterviewsFilter") != null)
{
    filter = JsonConvert.DeserializeObject<UnapprovedInterviewsFilter>(HttpContextAccessor.HttpContext.Session.GetString("UnapprovedInterviewsFilter"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    SCID = filter.SCID != null ? filter.SCID : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
}
<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 6.9rem;
        right: -.3rem;
    }
</style>
<script>
    var Header = "<div id='uninterview_1'>Unapproved Interviewer Meetings</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />

<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Unapproved Interviewer Meetings</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <span id="uninterview_3">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-toggle="modal" data-target="#filterModal">

                                <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button></span>

                            <span id="uninterview_2"> <i type="submit" class="fa fa-file-excel-o excel-file card-title-space" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("ExportMeetingsToExcel", "UnapprovedInterviewerMeetings")'"></i></span>


                            @*<button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "Interview")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Interview</font></span>
            </button>*@


                            @*<i type="submit" class="fa fa-file-excel-o excel-file card-title-space" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("InterviewsExporttoExcel", "Interview")'"></i>*@
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interview" onclick="location.href='@Url.Action("Add", "UnapprovedInterviewerMeetings")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Interview</font></span>
                            </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("Index","UnapprovedInterviewerMeetings")" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Primary Skill</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.PrimarySkill).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>


                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                    Meeting Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="MeetingStatus" name="MeetingStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.MeetingStatusStatusDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Interviewer">
                                                                    Interviewer
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Interviewer" name="Interviewer" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.interviewer).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="SCID">ISC ID</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="SCID" name="SCID" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.ISCId).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label  col-md-12 col-sm-12 desp-label" for="ConfirmationStatus">
                                                                    Confirmation Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ConfirmationStatus" name="ConfirmationStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.confirmationStatus).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                    Approval Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="InterviewStatus" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>



                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>


                                                                    </div>

                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar search-field" id="style-2">

                                    <div id="tableID" class="second">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive text-center" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th>ISC ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    @*<th>Nick Name</th>*@
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th id="uninterview_6">Interviewer</th>
                                                    <th id="uninterview_7">Confirmation Status</th>
                                                    <th id="uninterview_8"> Meeting Status</th>
                                                    <th id="uninterview_9">Interview Status</th>
                                                    <th>Encoded Resume</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom ID</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>Co-ordinating HR</th>
                                                    <th>HR Comments</th>
                                                    <th>Interview Duration</th>

                                                    @*<th style="text-align:center">Call</th>*@
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th class="disabled-sorting">Actions</th>
                                                    <th>ISC ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    @*<th>Nick Name</th>*@
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th >Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Encoded Resume</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom ID</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>Co-ordinating HR</th>
                                                    <th>HR Comments</th>
                                                    <th>Interview Duration</th>

                                                    @*<th style="text-align:center">Call</th>*@
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.imid>
                                                        <td class="text-center action">


                                                            <!--<button class="mdc-fab app-fab--absolute" aria-label="Upload Videoes">-->
                                                            @*<span onclick="OpenVideoUploadPopup(@item.imid)" title="Upload Videoes" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>*@
                                                            <!--<span onclick="location.href = '@Url.Action("UploadInterviewVideoes", "Interview", new { id = item.imid})'" title="Upload Videoes" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" /></svg></span>
    </button>-->
                                                            <span id="uninterview_4">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                                    <span onclick="location.href = '@Url.Action("Edit", "UnapprovedInterviewerMeetings", new { id = item.imid})'" title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                                </button>
                                                            </span>

                                                            @*<button class="mdc-fab app-fab--absolute " aria-label="Comment">
            <span onclick="location.href = '@Url.Action("AddComments", "Interview", new { interviewId = item.imid})'" title="HR and QC Comment" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18"><path d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z" /></svg></span>
        </button>*@
                                                            <span id="uninterview_5">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                    <span onclick="location.href = '@Url.Action("AddReport", "Interviewer", new { interviewId = item.imid, iscId = item.iscIntId, backUrl=ViewBag.CurrentUrl})'" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                                </button></span>




                                                        </td>
                                                        <td title=@item.ISCId> @item.ISCId </td>
                                                        <td> @item.interviewDate </td>

                                                        @if (item.candidateName != null && item.candidateName != "")
                                                        {

                                                            @if (item.candidateName.Length > 18)
                                                            {


                                                                <td class="cadName">
                                                                    <a onclick="" data-tooltip="@item.candidateName"> @item.candidateName.Substring(0, 18)... </a>
                                                                </td>
                                                            }


                                                            else
                                                            {
                                                                <td class="cadName">
                                                                    <a onclick=""> @item.candidateName </a>
                                                                </td>
                                                            }

                                                        }

                                                        else
                                                        {
                                                            <td></td>
                                                        }


                                                        @*<td>@item.NickName</td>*@


                                                        @if (item.candidateEmail != null && item.candidateEmail != "")
                                                        {

                                                            @if (item.candidateEmail.Length > 10)
                                                            {


                                                                <td class="cadName">
                                                                    <a onclick="" data-tooltip="@item.candidateEmail"> @item.candidateEmail.Substring(0, 10)... </a>
                                                                </td>
                                                            }


                                                            else
                                                            {
                                                                <td class="cadName">
                                                                    <a onclick=""> @item.candidateEmail </a>
                                                                </td>
                                                            }

                                                        }

                                                        else
                                                        {
                                                            <td></td>
                                                        }


                                                        <td> @item.PrimarySkill </td>


                                                        @if (item.interviewer != null && item.interviewer != "")
                                                        {

                                                            @if (item.interviewer.Length > 10)
                                                            {


                                                                <td class="cadName">
                                                                    <a onclick="" data-tooltip="@item.interviewer"> @item.interviewer.Substring(0, 10)... </a>
                                                                </td>
                                                            }


                                                            else
                                                            {
                                                                <td class="cadName">
                                                                    <a onclick=""> @item.interviewer </a>
                                                                </td>
                                                            }

                                                        }

                                                        else
                                                        {
                                                            <td></td>
                                                        }





                                                        @if (item.confirmationStatus.Trim() == "Cancelled")
                                                        {
                                                            <td class="text-center">

                                                                <a style="color:red"> @item.confirmationStatus</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center"> @item.confirmationStatus</td>
                                                        }

                                                        @if (@item.interviewDate > DateTime.Now && item.confirmationStatus.Trim() != "Cancelled")
                                                        {
                                                            <td>Scheduled</td>
                                                        }
                                                        else if (item.confirmationStatus.Trim() == "Cancelled")
                                                        {
                                                            <td></td>
                                                        }
                                                        else if (@item.interviewDate < DateTime.Now && @item.MeetingStatusStatusDesc == "Scheduled")
                                                        {
                                                            <td>Pending</td>
                                                        }
                                                        else
                                                        {
                                                            <td> @item.MeetingStatusStatusDesc</td>
                                                        }
                                                        <td> @item.intervieweStatusStatDesc</td>
                                                        @if (item.encodedresumeLink != null && item.encodedresumeLink != "")
                                                        {
                                                            <td>
                                                                <a target="_blank" title="Resume" href=@item.encodedresumeLink.Replace(" ", "%20")>Resume</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }


                                                        @if (item.zoomLink != null && item.zoomLink != "")
                                                        {
                                                            <td> <a id="zoomlinkId" target="_blank" title="Zoom Link" href=@item.zoomLink>Zoom Link</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Zoom Link</td>
                                                        }
                                                        <td> @item.ZoomId</td>


                                                        @if (item.VideoLink != null && item.VideoLink != "")
                                                        {
                                                            <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Video</td>
                                                        }




                                                        @if (item.interviewSlot != null && item.interviewSlot != "")
                                                        {
                                                            <td>@item.interviewSlot</td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Interview Slot</td>
                                                        }

                                                        @if (item.HRCoordinatorEmailId != null && item.HRCoordinatorEmailId != "")
                                                        {
                                                            <td>@item.HRCoordinatorEmailId</td>
                                                        }
                                                        else
                                                        {
                                                            <td>NA</td>
                                                        }



                                                        @if (item.HRComment != null && item.HRComment != "")
                                                        {
                                                            <td>@item.HRComment</td>
                                                        }
                                                        else
                                                        {
                                                            <td>NA</td>
                                                        }


                                                        <td> @item.interviewDuration </td>






                                                        @*<td>
                                                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                {

                                                                    <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="ModalButtonClick()" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt"> Call Candidate</span></span>

                                                                }

                                                            </td>*@
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>

