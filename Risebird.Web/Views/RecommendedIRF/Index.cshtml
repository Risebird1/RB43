<script>

    var currentPageNumber = 1;
    var maxPageCount = parseInt('@Model.MaxPageCount');
    $(document).ready(function () {

        $(window).scroll(function () {
            if (maxPageCount > currentPageNumber) {
                if ($(window).scrollTop() == $(document).height() - $(window).height()) {
                    currentPageNumber += 1;
                    loadPageData(currentPageNumber);
                    //document.getElementById("loader").style.display = 'none';

                }
            }

        });

    });
    function loadPageData(currentPageNumber) {
        var loader = document.getElementById("loader");
        loader.style.display = 'block';
        var searchValue = document.getElementById("idtxtSearch").value;

        $.ajax({
            url: '/IRF/IndexPartial',
            data: { 'pageNumber': (currentPageNumber), 'searchValue': searchValue},
            method: 'GET',
            success: function (response) {
                if (response != null && response != '' && response!=false) {
                    var irfTable = $('#irfTilesBody');
                    loader.style.display = 'none';
                    irfTable.append(response);
                }
                else {
                    loader.style.display = 'none';
                }
            }
        });
    }
    function SearchSkillChannels() {
        var searchValue = document.getElementById("idtxtSearch").value;
        window.location = "/IRF/Index?searchValue=" + searchValue;
    }

</script>
<script>

    var input = document.getElementById("idtxtSearch");
    input.addEventListener("keyup", function (event) {
        if (event.keyCode === 13) {
            SearchSkillChannels();
        }
    });
</script>

@if (Model.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@Model.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@Model.Message', "success");
            }
            else {
                swal.fire("Failed", '@Model.Message', "error");
            }
        }
    </script>
}

