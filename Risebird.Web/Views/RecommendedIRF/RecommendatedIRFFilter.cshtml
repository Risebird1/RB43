<script>
    let clientCompanyName = '@Model.ClientCompanyName';
    let clientId = '@Model.ClientId';
    let isModalOpened = false;
    let isBillingOwnerPopulated = false;
    var closeMember = document.getElementById("interviewLinkModalClose");
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewLinkModal");
        modal.style.display = "none";
    }
    function OpenModalForCreatingInterviewLink(templateId, templateName, assessmentGroupName, assessmentGroupId) {
        var modal = document.getElementById("interviewLinkModal");
        modal.style.display = "block";
        var modalHeading = '';

        if (templateName != null && templateName != '') {
            modalHeading = 'Create Interview Link from: "' + templateName + '"';
        }
        else {
            modalHeading = 'Create Interview Link';
        }
        if (isModalOpened) {
            $('#JDTiltle').val('');
            $('#JDFile').val('');
            $('#error_JDTiltle').text('');
            $('#error_JDFile').text('');
            $('#error_BillingOwner').text('');
        }

        $('#interviewLinkModalHeading').text(modalHeading);
        $('#CreatedFromTemplateId').val(templateId);
        $('#AssessmentGroupId').val(assessmentGroupId);

        if (!isBillingOwnerPopulated) {
            PopulateBillingOwner();
        }
        GenerateSkillChannelName(assessmentGroupName);
        if (!isModalOpened && clientId !== undefined) {
            isModalOpened = true;
            $('#ClientId').val(clientId);
        }
    }
    function PopulateBillingOwner() {
        $.ajax({
            type: "GET",
            url: "/IRF/GetClientUser",
            data: { 'clientId': clientId },
            success: function (data) {
                var drpbilling = $("#BillingOwner");
                $("#BillingOwner option").remove();
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");
                        option.html(this.text);
                        option.val(this.value);
                        drpbilling.append(option);
                    });
                }
                isBillingOwnerPopulated = true;
            }
        });
    }
    function GenerateSkillChannelName(assessmentGroupName) {
        $.ajax({
            type: "GET",
            url: "/IRF/GenerateSkillChannelName",
            data: { 'assessmentGroupName': assessmentGroupName, 'clientCompanyName': clientCompanyName },
            success: function (data) {
                if (data != null && data != '') {
                    document.getElementById('IRFId').value = data;
                }
            }
        });
    }
    function ValidateCreateInterviewLinkForm() {
        var jobProfile = $('#JDTiltle').val();
        var jdFile = $('#JDFile').val();
        var billingOwner = $('#BillingOwner').val();
        var flag = true;
        if (jobProfile == null || jobProfile == '') {
            document.getElementById('error_JDTiltle').innerHTML = "Job Title is required.";
            flag = false;
        }
        else if (jobProfile.length > 40) {
            document.getElementById("error_JDTiltle").innerHTML = "Job Title should not be more than 40 characters long.";
            flag = false;
        }
        else {
            document.getElementById('error_JDTiltle').innerHTML = "";
        }
        if (jdFile == null || jdFile == '') {
            document.getElementById('error_JDFile').innerHTML = "Kindly upload a file here.";
            flag = false;
        }
        else {
            document.getElementById('error_JDFile').innerHTML = "";
        }
        if (billingOwner == null || billingOwner == '') {
            document.getElementById('error_BillingOwner').innerHTML = "Billing owner is required.";
            flag = false;
        }
        else {
            document.getElementById('error_BillingOwner').innerHTML = "";
        }
        return flag;
    }
</script>
