                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>



                                            <form action="@Url.Action("RecommendatedIRFFilter", "RecommendedIRF",new { emailid=ViewBag.emailid,uniqueid=ViewBag.uniqueid})" method="post" id="formFilter">

                                                <div class="modal-body">
                                                    <div class="row">

                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CompetencyLevel">Competency Level</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CompetencyLevel" name="CompetencyLevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.CompetencyLevelDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="SeniorityLevel">Seniority Level</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="SeniorityLevel" name="SeniorityLevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.SeniorityLevelDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CountryType">Country Type</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CountryType" name="CountryType" data-placeholder="None Selected" class="form-select test" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.CountryTypeDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CompanyType">Company Type</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="CompanyType" name="CompanyType" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.CompanyTypeDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="AssessmentGroup">Assessment Group</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="AssessmentGroup" name="AssessmentGroup" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                        @foreach (var item in Model.ClonableTemplates.Select(x => x.AssessmentGroupName).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">

                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">

                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 20px 0px 10px 0px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>

                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin:20px 0px 10px 0px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>

                                                                    </div>

                                                                </div>

                                                            </div>
                                                        </div>




                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="cloneTemplateTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Tech Skills</th>
                                                    <th>Interviewers</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Tech Skills</th>
                                                    <th>Interviewers</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model.ClonableTemplates != null && Model.ClonableTemplates.Count() > 0)
                                                {
                                                    foreach (var item in Model.ClonableTemplates)
                                                    {

                                                        <tr>
                                                            @if (!string.IsNullOrEmpty(item.Name))
                                                            {
                                                                <td> @item.Name </td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }

                                                            <td>
                                                                <button type="button" class="clickhere_btn pull-left">
                                                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="openSkillpopup('@item.ClonableSkillChannelId', '@item.Name')" data-original-title="Click here to view Tech Skills"><font style="font-family: Roboto, sans-serif; font-size:12px;">   Click Here</font></span>
                                                                </button>
                                                            </td>

                                                            <td>
                                                                <button type="button" class="clickhere_btn pull-left">
                                                                    <span data-toggle="tooltip" data-placement="top" title="" onclick="openInterviewersPopup('@item.ClonableSkillChannelId', '@item.Name')" data-original-title="Click here to view Interviewers"><font style="font-family: Roboto, sans-serif; font-size:12px;">   Click Here</font></span>
                                                                </button>
                                                            </td>

                                                            <td>
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Create Skills Channel">
                                                                    <span onclick="location.href='@Url.Action("CreateRecommendationIRF", "RecommendedIRF", new { recommirfid = item.ClonableSkillChannelId,emailid=ViewBag.emailid,uniqueid=ViewBag.uniqueid })'" title="Create Skills Channel" class="mdc-fab__icon material-icons">
                                                                        <i style="font-size:14px!important;" class="fa fa-plus-circle"></i>
                                                                    </span>
                                                                </button>
                                                            </td>


                                                        </tr>


                                                    }
                                                }

                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>


    <div id="TemplateSkillModel" class="modal modal-bg" style="z-index:3">

        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="filheader">
                    <h5 class="modal-title pull-left">Tech Skills <span class="popup-text" id="skill_id_pop"></span></h5>
                </div>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span onclick="closeTemplateSkillModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
                </button>

                <div class="modal-body">
                    <div style="padding:10px" id="divTechSkillBody">

                    </div>
                    <div>
                        <div class="col-md-12 text-right">
                            <div>
                                <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeTemplateSkillModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div id="InterviewersModel" class="modal modal-bg" style="z-index:3">

        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="filheader">
                    <div class="filavatar">
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="22" viewBox="0 0 18 18"><path d="M16.5 12c1.38 0 2.49-1.12 2.49-2.5S17.88 7 16.5 7C15.12 7 14 8.12 14 9.5s1.12 2.5 2.5 2.5zM9 11c1.66 0 2.99-1.34 2.99-3S10.66 5 9 5C7.34 5 6 6.34 6 8s1.34 3 3 3zm7.5 3c-1.83 0-5.5.92-5.5 2.75V19h11v-2.25c0-1.83-3.67-2.75-5.5-2.75zM9 13c-2.33 0-7 1.17-7 3.5V19h7v-2.25c0-.85.33-2.34 2.37-3.47C10.5 13.1 9.66 13 9 13z" /></svg>
                            @*<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>*@
                        </span>
                    </div>
                    <h5 class="modal-title pull-left">Interviewers <span class="popup-text" id="interviewers_id_pop"></span></h5>
                </div>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span onclick="closeInterviewersModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
                </button>

                <div class="modal-body">
                    <div style="padding:10px" id="divInterviewersBody">

                    </div>
                    <div>
                        <div class="col-md-12 text-right">
                            <div>
                                <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeInterviewersModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@if (Model.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@Model.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@Model.Message', "success");
            }
            else {
                swal.fire("Failed", '@Model.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}

<script>

    function searchResult() {
        $('#cloneTemplateTable').DataTable();
    }
    function RefreshSearch() {
        $('#cloneTemplateTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {

        var table = $('#cloneTemplateTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#cloneTemplateTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#cloneTemplateTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#cloneTemplateTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>

    $(document).ready(function () {

        $("#ResetFilter").click(function () {
            ResetFilter();
        })

        if ('@filter' != '') {
            ApplySessionFilter();
        }

    });

    function ResetFilter() {

        $.ajax({
            type: "POST",
            async: false,
            url: "/RecommendedIRF/ResetClonableTemplateFilter",
            success: function (result) {
                location.reload(true);
            }
        });
    }

    function ApplySessionFilter() {
        var competencyLevel =  @Html.Raw(Json.Serialize(CompetencyLevel));
        var seniorityLevel =  @Html.Raw(Json.Serialize(SeniorityLevel));
        var countryType =  @Html.Raw(Json.Serialize(CountryType));
        var companyType =  @Html.Raw(Json.Serialize(CompanyType));
        var assessmentGroup =  @Html.Raw(Json.Serialize(AssessmentGroup));

        $("#CompetencyLevel").val(competencyLevel);
        $("#SeniorityLevel").val(seniorityLevel);
        $("#CountryType").val(countryType);
        $("#CompanyType").val(companyType);
        $("#AssessmentGroup").val(assessmentGroup);
    }

</script>

<script>
    function openSkillpopup(id, templateName) {
        $.ajax({
            type: "POST",
            url: "/RecommendedIRF/FetchTemplateTechSkillDetails",
            data: { id: id },
            success: function (data) {
                var modal = document.getElementById("TemplateSkillModel");
                $("#skill_id_pop").text(templateName);
                modal.style.display = "block";
                bindSkillData(data);
            }
        });
    }
    function closeTemplateSkillModel() {
        var model = document.getElementById("TemplateSkillModel");
        model.style.display = "none";
    }
    function bindSkillData(data) {
        var html = '';
        html += ' <div class="table-responsive scrollbar style-2" style="overflow-x:scroll"><table class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">';
        html += '  <thead>';
        html += '  <tr>';
        html += '  <th width="20%" class="table_heading">Level</th>';
        html += '  <th width="70%" class="table_heading">Skill Name</th>';
        html += '  <th width="10%" class="table_heading">Weightage</th>';
        html += '  </tr>';
        html += '  </thead>';
        html += '  <tbody>';
        for (i = 0; i < data.length; i++) {
            html += '   <tr>';
            html += '  <td>' + data[i].levelName + '</td>';
            html += '    <td>' + data[i].skillName + '</td>';
            html += '  <td>' + data[i].weightage + '</td>';
            html += '  </tr>';
        }
        html += '</tbody>';
        html += ' </table></div>';
        $("#divTechSkillBody").empty().html(html);
    }

</script>

<script>
    function openInterviewersPopup(id, templateName) {
        $.ajax({
            type: "POST",
            url: "/RecommendedIRF/FetchTemplateInterviewersDetails",
            data: { id: id },
            success: function (data) {
                var modal = document.getElementById("InterviewersModel");
                $("#interviewers_id_pop").text(templateName);
                modal.style.display = "block";
                bindInterviewersData(data);
            }
        });
    }
    function closeInterviewersModel() {
        var model = document.getElementById("InterviewersModel");
        model.style.display = "none";
    }
    function bindInterviewersData(data) {
        var html = '';
        html += ' <div class="table-responsive scrollbar style-2" style="overflow-x:scroll"><table class="table table-bordered mbn" id="InterviewersTable" cellpadding="0" cellspacing="0">';
        html += '  <thead>';
        html += '  <tr>';
        html += '  <th width="25%" class="table_heading">Secured Name</th>';
        html += '  <th width="55%" class="table_heading">Skills</th>';
        html += '  <th width="10%" class="table_heading">Resume</th>';
        html += '  </tr>';
        html += '  </thead>';
        html += '  <tbody>';
        for (i = 0; i < data.length; i++) {
            html += '   <tr>';
            html += '  <td>' + data[i].nickName + '</td>';
            html += '    <td>' + data[i].primarySkill + '</td>';
            //html += '  <td>' + data[i].resumeLink + '</td>';
            if (data[i].codedResumeLink == "" || data[i].codedResumeLink == null) {
                html += '<td></td>';
            } else {
                html += '  <td>' + '<a href="' + data[i].codedResumeLink + '" target="_blank" data-tooltip="' + data[i].codedResumeLink + '" >Resume</a>' + '</td>';
            }
            html += '  </tr>';
        }
        html += '</tbody>';
        html += ' </table></div>';
        $("#divInterviewersBody").empty().html(html);
    }

</script>



