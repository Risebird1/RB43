@model Risebird.Entities.ViewModel.IRFVm
@using Risebird.Entities.Enum;

@{
    if (Model.IsEdit)
    {
        ViewData["Title"] = "Edit Interviewing Channel";
    }
    else
    {
        ViewData["Title"] = "Create Interviewing Channel";
    }
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}
@if (Model.IsEdit)
{
    <script>
        var Header = "<a href='/RecommendedIRF/Index'>Recommendation IRF</a>&nbsp;/&nbsp;Edit Interviewing Channel";
        $('#txtpageHeader').empty().html(Header);
    </script>
}
else
{
    <script>
        var Header = "<a href='/RecommendedIRF/Index'>Recommendation IRF</a>&nbsp;/&nbsp;Create Interviewing Channel";
        $('#txtpageHeader').empty().html(Header);
    </script>
}
<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />

<div id="main-panel">
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <form action="@Url.Action("CreateRecommendationIRF", "RecommendedIRF",new { emailid=ViewBag.emailid,uniqueid=ViewBag.uniqueid})" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid" onsubmit="return CheckTotalWeightage()">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <input type="hidden" value="@Model.IsClone" id="hidisclone" />
                            <div>
                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Create Interviewing Channel</h4></div>
                                </div>
                                <div class="tabCon">
                                    <div class="tab-menu">
                                        <ul class="tabs">
                                            <li><a href="#" class="active text-center" rel="tab-1" id="rtab-1" onclick="headerClickchange('tab-1')">Event Details</a></li>
                                            <li><a href="#" id="rtab-3" class="text-center" onclick="headerClickchange('tab-3')">Tech Skill </a><span id="count_SkillCollection" class="skillcount" style="right: 0px !important;">@Model.SkillCollection.Count()</span></li>
                                            <li><a href="#" id="rtab-7" class="text-center" onclick="headerClickchange('tab-7')">Your Company User</a><span id="count_ClientTable" class="skillcount">@(Model.ClientCollection!=null?@Model.ClientCollection.Count() : 0)</span></li>
                                            <li><a href="#" id="rtab-8" class="" onclick="headerClickchange('tab-8')">Interviewer</a><span id="count_Interviewer" class="skillcount">@Model.InterviewerCollection.Count()</span></li>
                                            <li><a href="#" id="rtab-12" class="" onclick="headerClickchange('tab-12')">Questions</a><span id="count_question" class="skillcount">@Model.QuesionList.Count()</span></li>
                                            @if (Model.IsEdit)
                                            {
                                                <li><a href="#" id="rtab-13" class="text-center" onclick="headerClickchange('tab-13')">Audio Recording</a></li>
                                                <li><a href="#" id="rtab-14" class="text-center" onclick="headerClickchange('tab-14')">Upload Candidates</a></li>
                                            }
                                            else
                                            {
                                                <li><a href="#" id="rtab-13" class="text-center">Audio Recording</a></li>
                                                <li><a href="#" id="rtab-14" class="text-center">Upload Candidates</a></li>
                                            }
                                        </ul>
                                    </div>
                                    <div>
                                        <h3 class="tab_drawer_heading" rel="tab-1">Event Details</h3>
                                        <div class="tab-box" id="tab-1" style="display:block;">
                                            <div class="tab-main-box clearfix">
                                                <div class="row">
                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                @Html.LabelFor(model => model.ClientName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                                                            </div>
                                                            @Html.EditorFor(model => model.ClientName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                                            @Html.ValidationMessageFor(model => model.ClientName, "", new { @id = "error_ClientName", @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group">
                                                            <div class="mandate">
                                                                <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="JDTiltle">Job Title</label>
                                                            </div>
                                                            @Html.EditorFor(model => model.JDTiltle, new { htmlAttributes = new { @class = "form-control text-box single-line", @placeholder = "Add Primary Skill and Role(max 40 char)" } })
                                                            @Html.ValidationMessageFor(model => model.JDTiltle, "", new { @id = "error_JDTiltle", @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 col-sm-4">
                                                        <div class="form-group">
                                                            Upload JD <span class="red">*</span>
                                                            <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                                                <div class="mdc-radio mdc-radio--touch">
                                                                    <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Upload" onclick="RadioChanged(this.value)">
                                                                    <div class="mdc-radio__background">
                                                                        <div class="mdc-radio__outer-circle"></div>
                                                                        <div class="mdc-radio__inner-circle"></div>
                                                                    </div>
                                                                    <div class="mdc-radio__ripple"></div>
                                                                </div>
                                                            </div>
                                                            Provide JD Link <span class="red">*</span>

                                                            <div class="mdc-touch-target-wrapper" style="top: 4px; position: relative;">
                                                                <div class="mdc-radio mdc-radio--touch">
                                                                    <input class="mdc-radio__native-control" type="radio" id="JD" name="JD" value="Link" onclick="RadioChanged(this.value)">
                                                                    <div class="mdc-radio__background">
                                                                        <div class="mdc-radio__outer-circle"></div>
                                                                        <div class="mdc-radio__inner-circle"></div>
                                                                    </div>
                                                                    <div class="mdc-radio__ripple"></div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="form-group" style="display:none" id="linkDiv">
                                                            @Html.LabelFor(model => model.JDLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                            @Html.EditorFor(model => model.JDLink, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                                        </div>
                                                        <div class="" style="display:none" id="uploadDiv">
                                                            @Html.LabelFor(model => model.JDFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                            @Html.TextBoxFor(model => model.JDFile, new { type = "file", @class = "choose-file", @accept = ".doc, .docx, .pdf, .txt" })
                                                        </div>
                                                        @Html.ValidationMessageFor(model => model.JDLink, "", new { @id = "error_JDLink", @class = "text-danger" })
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                        <h3 class="tab_drawer_heading" rel="tab-3">Tech Skill</h3>
                                        <div class="tab-box" id="tab-3">
                                            <div class="tab-main-box">
                                                <div class="row">

                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table table-bordered mbn" id="SkillTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th width="15%" class="table_heading">Level<span class="red">*</span></th>
                                                                        <th width="30%" class="table_heading">Skill Name<span class="red">*</span></th>
                                                                        <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>
                                                                        <th width="20%" class="table_heading">Concepts</th>
                                                                        <th width="30%" class="table_heading">Nature of questions</th>
                                                                        <th width="10%" class="table_heading">Time limit</th>
                                                                        @*<th width="10%" class="table_heading text-center">Action</th>*@

                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.SkillCollection == null || Model.SkillCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.DropDownList("SkillCollection[0].LevelId", (SelectList)ViewBag.LevelTech, new { @class = "select-css form-control ", @readonly = "readonly" })

                                                                            </td>
                                                                            <td>
                                                                                @Html.DropDownList("SkillCollection[0].SkillId", (SelectList)ViewBag.Skill, new { @class = "select-css form-control ", @readonly = "readonly" })
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Weightage" name="SkillCollection[0].Weightage" type="number" max="100" min="1" value="100">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Concepts" name="SkillCollection[0].Concepts" type="text" maxlength="50">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Natureofquestion" name="SkillCollection[0].Natureofquestion" type="text" maxlength="50">
                                                                            </td>
                                                                            <td>
                                                                                <input class="form-control text-box single-line" id="SkillCollection_0__Timelimit" name="SkillCollection[0].Timelimit" type="number" max="30" min="1">
                                                                            </td>
                                                                            @*<td class="action text-center">
                                                                                    <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                    <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                                                </td>*@
                                                                        </tr>
                                                                    }

                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.SkillCollection.Count(); i++)
                                                                        {
                                                                            <tr>

                                                                                <td>

                                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].LevelId, (SelectList)ViewBag.LevelTech, new { @class = "form-control select-css", @readonly = "readonly" })

                                                                                </td>
                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.SkillCollection[i].SkillId, (SelectList)ViewBag.Skill, new { @class = "select-css form-control", @readonly = "readonly" })
                                                                                </td>

                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Weightage, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "100", @min = "1" } })

                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Concepts, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Natureofquestion, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @maxlength = "50" } })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.EditorFor(m => m.SkillCollection[i].Timelimit, new { htmlAttributes = new { @class = "weight form-control text-box single-line", @type = "number", @max = "30", @min = "1" } })
                                                                                </td>
                                                                                @*<td class="action text-center">
                                                                                        <div>
                                                                                            <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                            <span id="btnMinus" onclick="DeleteRowSkills(this, 'SkillCollection','LevelId','SkillId','Weightage', 'Concepts', 'Natureofquestion', 'Timelimit')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                                                        </div>
                                                                                    </td>*@
                                                                            </tr>

                                                                        }
                                                                    }

                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="SkillCollection_WeightageError" style="color:red!important; margin-left:807px;font-size:12px!important;"></label>
                                                            <label class="text-danger" id="SkillCollection_WeightageErrorDown" style="color:white!important; margin-left:415px"></label>
                                                        </div>
                                                    </div><!--end of col-md-12-->

                                                </div>
                                            </div>
                                        </div>
                                        <h3 class="tab_drawer_heading" rel="tab-7">Your Company User</h3>
                                        <div class="tab-box" id="tab-7">
                                            <div class="tab-main-box">
                                                <div class="row">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table table-bordered mbn" id="ClientTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="table_heading">User <span class="red">*</span></th>
                                                                        <th class="table_heading">Role</th>
                                                                        <th width="10%" class="table_heading text-center">Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.ClientCollection == null || Model.ClientCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.DropDownList("ClientCollection[0].ClientUserId", (SelectList)ViewBag.ClientUser, new { @class = "select-css form-control ", @onchange = "ClientUserChanged(this.value, this.id)" })
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBox("ClientCollection[0].Role", null, new { @class = "form-control", @readonly = "readonly" })
                                                                            </td>
                                                                            <td class="action text-center">
                                                                                <span id="btnPlus" onclick="AddRowClient()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                <span id="btnMinus" onclick="DeleteRow(this, 'ClientCollection', 'ClientUserId', 'Role')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.ClientCollection.Count(); i++)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.ClientCollection[i].ClientUserId, (SelectList)ViewBag.ClientUser, new { @class = "form-control select-css ", @onchange = "ClientUserChanged(this.value, this.id)" })
                                                                                </td>
                                                                                <td>
                                                                                    @Html.TextBoxFor(m => m.ClientCollection[i].Role, new { @class = "form-control", @readonly = "readonly" })
                                                                                </td>
                                                                                <td class="action text-center">
                                                                                    <span id="btnPlus" onclick="AddRowClient()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                                    <span id="btnMinus" onclick="DeleteRow(this, 'ClientCollection', 'ClientUserId', 'Role')" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                                                                </td>
                                                                            </tr>

                                                                        }
                                                                    }





                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="error_client"></label>

                                                        </div>
                                                    </div><!--end of col-md-12-->
                                                </div>
                                                @if (Model.InterviewerMembers != null && Model.InterviewerMembers.Count() != 0)
                                                {
                                                    <div class="row">
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                            <div class="multiple_row">
                                                                <h2>All Existing Interviewers</h2>
                                                            </div><!--end of multiple location-->
                                                        </div><!--end of col-md-12-->
                                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                            <div class="table-responsive-sm">
                                                                <table class="table table-bordered table-striped" style="width:100%">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Type</th>
                                                                            <th>EmailId</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>


                                                                        @foreach (var item in Model.InterviewerMembers)
                                                                        {
                                                                            <tr>
                                                                                @if (item.Type == "Interviewer")
                                                                                {
                                                                                    <td style="color: #17c317">@item.Type</td>
                                                                                }
                                                                                @if (item.Type == "Emergency Interviewer")
                                                                                {
                                                                                    <td style="color: #ff7bf5">@item.Type</td>
                                                                                }
                                                                                @if (item.Type == "QCInterviewer")
                                                                                {
                                                                                    <td style="color:yellow">@item.Type</td>
                                                                                }
                                                                                <td>@item.EmailId</td>
                                                                            </tr>
                                                                        }

                                                                    </tbody>
                                                                </table>
                                                                @*<label class="text-danger" id="error_client" style="color:red!important;font-size:12px!important; margin-left:913px"></label>*@
                                                            </div>
                                                        </div><!--end of col-md-12-->
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <h3 class="tab_drawer_heading" rel="tab-8">Interviewer</h3>
                                        <div class="tab-box" id="tab-8">
                                            <div class="tab-main-box">
                                                <div class="row">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table table-bordered mbn" id="InterviewerTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th width="20%" class="table_heading">User <span class="red">*</span></th>
                                                                        <th width="40%" class="table_heading">Skills</th>
                                                                        <th width="10%" class="table_heading">Resume<span style="color:red">*</span></th>
                                                                        @if (Model.IsEdit)
                                                                        {
                                                                            <th width="10%" class="table_heading">Active</th>
                                                                            <th width="10%" class="table_heading">Available</th>
                                                                        }
                                                                        else
                                                                        {
                                                                            <th width="10%" class="table_heading">Select</th>
                                                                        }
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.InterviewerCollection == null || Model.InterviewerCollection.Count() == 0)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @Html.DropDownList("InterviewerCollection[0].UserId", (SelectList)ViewBag.Interviewers, new { @class = "select-css form-control ", @onchange = "InterviewerChanged(this.value, this.id)" })
                                                                            </td>
                                                                            <td>
                                                                                @Html.TextBox("InterviewerCollection[0].PrimarySkill", null, new { @class = "form-control", @readonly = "readonly" })
                                                                            </td>
                                                                            <td>
                                                                                @*@if (Model.LoggedEmail == "talent@risebird.io" || Model.LoggedEmail == "vaibhaw_sachan@risebird.io" || Model.LoggedEmail == "shahkar_alam@risebird.io" || Model.LoggedEmail == "parvathi_sg@risebird.io")
                                                                                    {
                                                                                        @Html.TextBox("InterviewerCollection[0].PerSuccessRate", null, new { @class = "form-control", @type = "number", @min = "1" })
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @Html.TextBox("InterviewerCollection[0].PerSuccessRate", null, new { @class = "form-control", @type = "number", @min = "1", @readonly = "readonly" })
                                                                                    }*@
                                                                                @Html.Hidden("InterviewerCollection[0].PerSuccessRate", null)
                                                                            </td>
                                                                            @if (Model.IsEdit)
                                                                            {
                                                                                <td class="text-center">
                                                                                    @Html.CheckBox("InterviewerCollection[0].IsActive", new { @checked = "checked" })
                                                                                </td>
                                                                                <td class="text-center">
                                                                                    @Html.CheckBox("InterviewerCollection[0].IsAvailable", new { @checked = "checked" })
                                                                                </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td class="text-center">
                                                                                    @Html.CheckBox("InterviewerCollection[0].IsSelect", new { @checked = "checked" })
                                                                                </td>
                                                                            }
                                                                        </tr>
                                                                    }
                                                                    else
                                                                    {
                                                                        for (int i = 0; i < Model.InterviewerCollection.Count(); i++)
                                                                        {
                                                                            <tr>
                                                                                <td>
                                                                                    @Html.DropDownListFor(m => m.InterviewerCollection[i].UserId, (SelectList)ViewBag.Interviewers, new { @class = "form-control select-css ", @onchange = "InterviewerChanged(this.value, this.id)", @disabled = "disabled" })
                                                                                    @Html.HiddenFor(m => m.InterviewerCollection[i].UserId)
                                                                                </td>
                                                                                <td>
                                                                                    @Html.TextBoxFor(m => m.InterviewerCollection[i].PrimarySkill, new { @class = "form-control", @readonly = "readonly" })
                                                                                </td>
                                                                                <td>
                                                                                    @*@if (Model.LoggedEmail == "talent@risebird.io" || Model.LoggedEmail == "vaibhaw_sachan@risebird.io" || Model.LoggedEmail == "shahkar_alam@risebird.io" || Model.LoggedEmail == "parvathi_sg@risebird.io")
                                                                                        {
                                                                                            @Html.TextBoxFor(m => m.InterviewerCollection[i].PerSuccessRate, new { @class = "form-control", @type = "number", @min = "1" })
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            @Html.TextBoxFor(m => m.InterviewerCollection[i].PerSuccessRate, new { @class = "form-control", @type = "number", @min = "1", @readonly = "readonly" })
                                                                                        }*@
                                                                                    @if (!String.IsNullOrEmpty(Model.InterviewerCollection[i].CodedResumeLink))
                                                                                    {
                                                                                        <a href="@Model.InterviewerCollection[i].CodedResumeLink" target="_blank">Resume</a>
                                                                                    }
                                                                                    @Html.HiddenFor(m => m.InterviewerCollection[i].PerSuccessRate)
                                                                                </td>
                                                                                @if (Model.IsEdit)
                                                                                {
                                                                                    <td class="text-center">@Html.CheckBoxFor(m => m.InterviewerCollection[i].IsActive)</td>
                                                                                    <td class="text-center">@Html.CheckBoxFor(m => m.InterviewerCollection[i].IsAvailable)</td>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <td class="text-center">
                                                                                        @Html.CheckBoxFor(m => m.InterviewerCollection[i].IsSelect)
                                                                                    </td>
                                                                                }
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                            <label class="text-danger" id="noInterviewer"></label>

                                                        </div>
                                                    </div><!--end of col-md-12-->
                                                </div>

                                            </div>
                                        </div>
                                        <h3 class="tab_drawer_heading" rel="tab-12">Questions</h3>
                                        <div class="tab-box" id="tab-12">
                                            <div class="tab-main-box">
                                                <div class="row">
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="table-responsive-sm">
                                                            <table class="table mbn" id="QuestionTable">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="table_heading b-right">Skill Name</th>
                                                                        <th class="table_heading b-right">Questions</th>
                                                                        <th colspan="2" class="table_heading text-center">Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.QuesionList.Count() == 0)
