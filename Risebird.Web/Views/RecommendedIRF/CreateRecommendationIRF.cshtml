            }
        }
    }

    function checkWeightageTab(tab_skill) {
        var inCorrectCount = 0;
        var items = $('[id^=' + tab_skill + '][id$="Weightage"]');
        $("#count_" + tab_skill).text(items.length);
        var total = 0;
        for (j = 0; j < items.length; j++) {
            var total = total + parseInt($("#" + items[j].id).val());
        }

        if (total != 100) {
            inCorrectCount = inCorrectCount + 1;
            // Label should be populated here
            document.getElementById(tab_skill + "_WeightageError").innerHTML = "Weightage total should be equal to 100.";
            if (tab_skill == "SkillCollection") {
                var labelName = "Tech Skills";
            }
            else if (tab_skill == "SkillGeneral") {
                var labelName = "General Skills";
            }
            else {
                var labelName = tab_skill;
            }
            document.getElementById(tab_skill + "_WeightageErrorDown").innerHTML = "Weightage total for " + labelName + " should be equal to 100.";
            return true;
        }
        var drpdowns = $('[id^=' + tab_skill + '][id$="LevelId"]');
        for (i = 0; i < drpdowns.length; i++) {
            var interviewId = $("#" + drpdowns[i].id).val();
            if (interviewId == '' || interviewId == null) {
                document.getElementById(tab_skill + "_WeightageError").innerHTML = "Level field should not be blank.";
                return true;
            }
        }
        if (tab_skill == "SkillCollection") {
            var drpdowns1 = $('[id^=' + tab_skill + '][id$="Timelimit"]');
            var drpdowns2 = $('[id^=' + tab_skill + '][id$="Concepts"]');
            var drpdowns3 = $('[id^=' + tab_skill + '][id$="Natureofquestion"]');
            for (i = 0; i < drpdowns1.length; i++) {
                var interviewId = $("#" + drpdowns1[i].id).val();
                if ($("#" + drpdowns2[i].id).val() != '' && $("#" + drpdowns3[i].id).val() != '') {
                    if (interviewId != '') {
                        if (parseInt(interviewId) < 1 || parseInt(interviewId) > 30) {
                            document.getElementById(tab_skill + "_WeightageError").innerHTML = "Time limit should between 0 to 30.";
                            return true;
                        }
                    }
                    else {
                        document.getElementById(tab_skill + "_WeightageError").innerHTML = "Time limit should between 0 to 30.";
                        return true;
                    }
                }
            }
        }
        if (tab_skill == "SkillCollection") {
            var drpdowns1 = $('[id^=' + tab_skill + '][id$="SkillId"]');
            for (i = 0; i < drpdowns1.length; i++) {
                var interviewId = $("#" + drpdowns1[i].id).val();

                if (interviewId == '' || interviewId == null) {
                    document.getElementById(tab_skill + "_WeightageError").innerHTML = "Skill field should not be blank.";
                    return true;
                }

            }
        }
        if (tab_skill == "Joinability") {
            var drpdowns2 = $('[id^=' + tab_skill + '][id$="Type"]');
            for (i = 0; i < drpdowns2.length; i++) {
                var interviewId = $("#" + drpdowns2[i].id).val();
                if (interviewId == '' || interviewId == null) {
                    document.getElementById(tab_skill + "_WeightageError").innerHTML = "Type field should not be blank.";
                    return true;
                }
            }
        }

        if (tab_skill == "Joinability") {
            var drpdowns3 = $('[id^=' + tab_skill + '][id$="Value"]');
            for (i = 0; i < drpdowns3.length; i++) {
                var interviewId = $("#" + drpdowns3[i].id).val();
                if (interviewId == '' || interviewId == null) {
                    document.getElementById(tab_skill + "_WeightageError").innerHTML = "Value field should not be blank.";
                    return true;
                }
            }
        }

        if (tab_skill == "Selectability") {
            var drpdowns4 = $('[id^=' + tab_skill + '][id$="Type"]');
            for (i = 0; i < drpdowns4.length; i++) {
                var interviewId = $("#" + drpdowns4[i].id).val();
                if (interviewId == '' || interviewId == null) {
                    document.getElementById(tab_skill + "_WeightageError").innerHTML = "Type field should not be blank.";
                    return true;
                }
            }
        }
        if (tab_skill == "Selectability") {
            var drpdowns5 = $('[id^=' + tab_skill + '][id$="Value"]');
            for (i = 0; i < drpdowns5.length; i++) {
                var interviewId = $("#" + drpdowns5[i].id).val();
                if (interviewId == '' || interviewId == null) {
                    document.getElementById(tab_skill + "_WeightageError").innerHTML = "Value field should not be blank.";
                    return true;
                }
            }
