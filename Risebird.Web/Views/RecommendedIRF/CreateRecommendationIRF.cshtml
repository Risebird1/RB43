    function checkTabValidation(activeTab) {
        var flag = false;
        if (activeTab.trim() == "Tech Skill") {
            flag = checkWeightageTab("SkillCollection");
            return flag;
        }
        else if (activeTab.trim() == "Your Company User") {
            flag = checkClientDetails();
            return flag;
        }
        else if (activeTab.trim() == "Interviewer") {
            flag = checkInterviewerDetails();
            return flag;
        }
           }
    function headerClickchange(newHeader) {
        var activeTab = $(".active").text();
