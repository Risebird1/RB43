<script>
    function ClientChanged(clientId) {

        $.ajax({
            type: "GET",
            url: "/IRF/GetClientUser",
            data: { 'clientId': clientId },
            success: function (data) {
                var drpdwnId = $("#ClientCollection_0__ClientUserId");
                //drpdwnId.options.length = 0;
                $("#ClientCollection_0__ClientUserId option").remove();
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");
                        //Set Text part.
                        option.html(this.text);
                        //Set Value part.
                        option.val(this.value);
                        //Add the Option element to DropDownList.
                        drpdwnId.append(option);
                    });
                    ClientUserChanged(data[0].value, 'ClientCollection_0__ClientUserId')
                }
                var drpbilling = $("#BillingOwner");
                $("#BillingOwner option").remove();
                if (data.length > 0) {
                    $(data).each(function () {
                        var option = $("<option />");
                        //Set Text part.
                        option.html(this.text);
                        //Set Value part.
                        option.val(this.value);
                        //Add the Option element to DropDownList.
                        drpbilling.append(option);
                    });
                }

            }
        });

    }
</script>
