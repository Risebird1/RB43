
@{
    
    Layout = null;

}

<div id="CandidateResumeSummaryModal" class="modal modal-bg" style="z-index:199;">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="height:auto">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left" id="id_candidateResumeSummaryModalTitle"> Candidate's Resume Summary </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeCandidateResumeSummaryModal()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url" id="id_candidateResumeSummaryBody">
                        
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closeCandidateResumeSummaryModal()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    
    function GetCandidateResumeSummary(candidateId) {
        var modal = document.getElementById("CandidateResumeSummaryModal");
        modal.style.display = "block";
        $("#id_candidateResumeSummaryBody").html('');
        
        $("#id_candidateResumeSummaryModalTitle").text("Candidate's Resume Summary: " + candidateId);
        
        $.ajax({
            url: '/Candidate/GetCandidateResumeSummary',
            type: 'POST',
            data: { 'candidateId': candidateId },
            success: function (result) {
                debugger;
                if (result != null) {
                    $("#id_candidateResumeSummaryBody").html(result);
                }
                else {
                    swal.fire("Some error occured. Please try again!");
                }
            }
        });
        
    }
    function closeCandidateResumeSummaryModal() {
        var modal = document.getElementById("CandidateResumeSummaryModal");
        modal.style.display = "none";
    }
    
</script>