@using Newtonsoft.Json
@using Risebird.CommonHelper
@using Risebird.Entities.Enum
@model Risebird.Entities.ViewModel.CommunicationDetailsWrapperVM

@{
    string communicationMedium = string.Empty;
    if(Model != null)
    {
        communicationMedium = ((CommunicationMedium)Model.CommunicationMedium).GetDescription();
    }
}
<style>

    .modal-xl {
        width: 80%;
        max-width:1200px;
    }
    /*table.fixedSize {
            table-layout: fixed;
            width: 100%;
        }*/
</style>

@*<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css'>
*@
<!-- Modal -->
<div class="modal fade" style="height:1000px" id="modalCommunicationDetails" tabindex="-1" role="dialog" aria-labelledby="modalCommunicationLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCommunicationLabel">Communication Details (@communicationMedium)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" style="margin-top: 5px; margin-right: -17px;">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body" id="communicationDetails_modal_body" style="max-height:400px; overflow:auto">
                @if(Model != null && Model.CommunicationList != null && Model.CommunicationList.Count()>0)
                {
                    @if (Model.CommunicationMedium == (int)CommunicationMedium.VoiceCall)
                    {

                        <div class="scrollers" style="overflow-y:auto">
                            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Called By</th>
                                        <th>Call Recipient</th>
                                        <th>Recording</th>
                                    </tr>
                                </thead>
                                <tbody id="tblCallRecDetails">
                                    @foreach (var item in Model.CommunicationList)
                                    {
                                        <tr>
                                            <td>@item.Caller</td>
                                            <td>@item.CallRecipient</td>
                                            <td>
                                                <audio controls><source src="@item.CallRecordingUri" type="audio/mpeg" />Recording</audio>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    }

                    else if (Model.CommunicationMedium == (int)CommunicationMedium.Whatsapp)
                    {

                        <div class="scrollers" style="overflow-y:auto">
                            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Recipient</th>
                                        <th>Message</th>
                                        @*<th>Button Link</th>*@
                                        <th>Event</th>
                                        <th>InterviewDate</th>
                                    </tr>
                                </thead>
                                <tbody id="tblWhatsAppMessageDetails">
                                    @foreach (var item in Model.CommunicationList)
                                    {
                                        <tr>
                                            <td>@item.WhatsappRecipient</td>
                                            <td>@(!string.IsNullOrWhiteSpace(item.WhatsappMessage) ? item.WhatsappMessage : "NA")</td>
                                            @*<td>@(!string.IsNullOrWhiteSpace(item.WhatsappButtonLink) ? item.WhatsappButtonLink : "NA")</td>*@
                                            <td>@(!string.IsNullOrWhiteSpace(item.WhatsappEvent) ? item.WhatsappEvent : "NA")</td>
                                            <td>@(item.InterviewDate.HasValue ? item.InterviewDate.Value.ToString() : "NA")</td>
                                            
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    }
                    else if (Model.CommunicationMedium == (int)CommunicationMedium.Email)
                    {

                        <div class="scrollers" style="overflow-y:auto">
                            <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Recipient</th>
                                        <th style="width:20%">Mail Subject</th>
                                        <th>Mail Content</th>
                                        <th>Sent On</th>
                                        <th>Sent By</th>
                                        <th>Latest Activity/Status</th>
                                        <th>Activity/Status Date</th>
                                        <th>Skill Channel Name</th>
                                        <th>Interview Date</th>
                                        <th style="text-align:center">Activity Details</th>
                                    </tr>
                                </thead>
                                <tbody id="tblSentMailDetails">
                                    @{
                                        int i = 1;
                                        foreach (var item in Model.CommunicationList)
                                        {
                                            var jsonObj = JsonConvert.SerializeObject(item.MailBody);
                                            <tr>

                                                <td>@item.CandidateEmail</td>

                                                <td>
                                                    @if (item.MailSubject != null && item.MailSubject != "")
                                                    {
                                                        @if (item.MailSubject.Length > 40)
                                                        {
                                                            <div class="article">
                                                                <p style="margin-bottom:0px;">
                                                                    @item.MailSubject.Substring(0, 40)
                                                                </p>
                                                                <p class="moretext_@i moretext">
                                                                    @item.MailSubject.Substring(40, @item.MailSubject.Length - 40)
                                                                </p>
                                                            </div>
                                                            <a onclick="moreless('@i')" class="moreless-button" value="Readmore" id="read_@i" href="#">Read more</a>
                                                        }
                                                        else
                                                        {
                                                            <div class="article">
                                                                <p>
                                                                    @item.MailSubject.Substring(0, @item.MailSubject.Length)
                                                                </p>
                                                            </div>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    <a onclick="OpenHtmlDocument(@jsonObj)" style="color:blue; cursor:pointer"><u>Content</u></a>
                                                </td>
                                                <td>@item.SentOn</td>
                                                <td>@item.SentBy</td>
                                                <td>@item.latestEvent</td>
                                                <td>@item.ActivityDate</td>
                                                <td>@item.SkillChannelName</td>
                                                <td>@item.interviewDateMail</td>
                                                <td>

                                                    <button data-bs-target="#modalRecipientActivity" data-bs-toggle="modal" data-bs-dismiss="modal" data-eventfire = "ajax-modal-recipientActivity" class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Click here to view recipient activity upon recieving email." style="position:relative;top:-1px;left:2px;" data-url="@Url.Action("GetRecipientMailActivitiesByMessageId","Mail", new { recipientEmail = item.CandidateEmail, messageId = item.sg_message_id, isNestedPopUp = true})">
                                                        <span title="Click here to view recipient activity upon recieving email." class="mdc-fab__icon material-icons"><i style="font-size:16px;" class="fa fa-envelope-open"></i></span>
                                                    </button>

                                                </td>
                                            </tr>
                                            i = i + 1;
                                        }
                                    }
                                    
                                </tbody>
                            </table>
                        </div>

                    }
                }
                else
                {
                    <h5 style="text-align:center">No records available!</h5>
                }
            </div>
            
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        
        var recipientActivity_placeholderElement = $('#modal_recipientActivity_placeholder');


        $('button[data-eventfire="ajax-modal-recipientActivity"]').click(function (event) {//data-toggle
            OpenPopUp(event, recipientActivity_placeholderElement);

        });

        

    });
</script>
