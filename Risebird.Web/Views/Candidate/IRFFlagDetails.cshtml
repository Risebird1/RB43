@using Risebird.Entities.Enum
@model IEnumerable<Risebird.Entities.ViewModel.InterviewDetailsVM>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Candidates";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "Candidates for <strong>@ViewBag.IRFName</strong>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=11" />
<input type="hidden" value="@ViewBag.profile" id="hidprofile" />
<input type="hidden" value="@ViewBag.IRFName" id="hidirfname" />
<input type="hidden" value="@ViewBag.IRFId" id="hidirfid" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Candidates for <strong>'@ViewBag.IRFName'</strong></h4></div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            @if (ViewBag.type == 34657 || ViewBag.type == 64868)
                                                            {
                                                                <th>Candidate Email</th>
                                                                <th>Candidate Name</th>
                                                                @if (ViewBag.type == 34657)
                                                                {
                                                                    <th>Interview Date</th>
                                                                    <th>Confirmation Status</th>
                                                                    <th>Meeting Status</th>
                                                                    <th>Interview Status</th>
                                                                }
                                                                else
                                                                {
                                                                    <th>ClientHR</th>
                                                                }
                                                                <th>Call</th>
                                                            }
                                                            else
                                                            {
                                                                <th>Interviewer</th>
                                                                <th>Total Interview</th>
                                                                <th>Selected Interview</th>
                                                                <th>Rejected Interview</th>
                                                                <th>Action</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            @if (ViewBag.type == 34657 || ViewBag.type == 64868)
                                                            {
                                                                <th>Candidate Email</th>
                                                                <th>Candidate Name</th>
                                                                @if (ViewBag.type == 34657)
                                                                {
                                                                    <th>Interview Date</th>
                                                                    <th>Confirmation Status</th>
                                                                    <th>Meeting Status</th>
                                                                    <th>Interview Status</th>
                                                                }
                                                                else
                                                                {
                                                                    <th>ClientHR</th>
                                                                }
                                                                <th>Call</th>
                                                            }
                                                            else
                                                            {
                                                                <th>Interviewer</th>
                                                                <th>Total Interview</th>
                                                                <th>Selected Interview</th>
                                                                <th>Rejected Interview</th>
                                                                <th>Action</th>
                                                            }
                                                        </tr>
                                                    </tfoot>
                                                    <tbody>
                                                        @foreach (var item in Model)
                                                        {
                                                            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                            <tr>
                                                                @if (ViewBag.type == 34657 || ViewBag.type == 64868)
                                                                {
                                                                    <td>@item.candidateEmail</td>
                                                                    <td>@item.candidateName</td>
                                                                    @if (ViewBag.type == 34657)
                                                                    {
                                                                        <td>@item.interviewDate</td>
                                                                        <td>@item.confirmationStatusStatusDesc</td>
                                                                        <td>@item.MeetingStatusStatusDesc</td>
                                                                        <td>@item.intervieweStatusStatDesc</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>@item.ClientHRAttemptContact</td>
                                                                    }
                                                                    <td>
                                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                        {
                                                                            <span id="getstatus_12" class="call" data-toggle="tooltip" data-placement="top" onclick="CallButtonClick(@jsonObject,1)" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                                                                        }
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>@item.NickName</td>
                                                                    <td>@item.TotalInterview</td>
                                                                    <td>@item.Selected</td>
                                                                    <td>@item.Reject</td>
                                                                    <td>
                                                                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" title="Click here to send the Interviewer from IRF removal reuest">
                                                                            <span data-toggle="tooltip" data-placement="top" title="Click here to send the Interviewer removal reuest from IRF" onclick="OpenRequestModal(@item.InterviewerProfileId,@item.TotalInterview,@item.Selected,@item.Reject,'@item.interviewer')" data-original-title="Tooltip on top"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-share-fill" viewBox="0 0 16 16"><path d="M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z" /></svg></span>
                                                                        </button>
                                                                    </td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

            @*<div id="myCallModal" class="modal modal-wrap modal-bg">
                <!-- Modal content -->
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="filheader">
                            <div class="filavatar">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                                </span>
                            </div>
                            <h5 class="modal-title pull-left"> Call Candidate !</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                        </button>
                        <div class="modal-body">
                            <h5 class="modal-title text-center" id="callingLabel"></h5>
                            <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;display: block;" class="btn btn-fill btn-danger" value="Hang Up">
                        </div>
                    </div>
                </div>
            </div>*@
        </div>
    </div>
</div>
<div id="ShareRequestModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <svg class="broadcastfilter-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M21 6h-7.59l3.29-3.29L16 2l-4 4-4-4-.71.71L10.59 6H3c-1.1 0-2 .89-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.11-.9-2-2-2zm0 14H3V8h18v12zM9 10v8l7-4z"></path></svg>
                </div>
                <h5 class="modal-title pull-left" id="filterModalLabel"> Remove Request</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="ShareRequestPopUp">&times;</span>
            </button>
            <div class="modal-body">
                <input type="hidden" id="rmv_interviewerid" />
                <input type="hidden" id="rmv_totalcount" />
                <input type="hidden" id="rmv_selected" />
                <input type="hidden" id="rmv_rejected" />
                <input type="hidden" id="rmv_interviewer" />
                <div class="col-md-12 col-sm-12">
                    <div class="form-group">
                        <label class="control-label  desp-label" for="Message">Comment <span class="required">*</span></label>
                        <div>
                            <div class="text-areadiv1">
                                <textarea class="scrollbar" style="width:100%;" id="bcMessage"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 col-sm-12 text-right">
                    <button type="button" onclick="ShareRemoveRequest()" class="mdc-button mdc-button--raised mdc-ripple-upgraded sendButton">Send</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    var span = document.getElementById("importPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    var candidateId;
    var irfId;
</script>
<script src="~/js/twiliocallmaker.js"></script>
<script>
    
    var spanremoverequest = document.getElementById("ShareRequestPopUp");
    spanremoverequest.onclick = function () {
        var modal = document.getElementById("ShareRequestModal");
        modal.style.display = "none";
    }
    function OpenRequestModal(interviewerid, totalinterview, selectedinterview, rejectedinterview, interviewer) {
        var modalBct = document.getElementById("ShareRequestModal");
        modalBct.style.display = "block";
        $("#rmv_interviewerid").val(interviewerid);
        $("#rmv_totalcount").val(totalinterview);
        $("#rmv_selected").val(selectedinterview);
        $("#rmv_rejected").val(rejectedinterview);
        $("#rmv_interviewer").val(interviewer);
    }

    function ShareRemoveRequest() {
        var message = document.getElementById("bcMessage").value;
        var interviewerid = $("#rmv_interviewerid").val();
        var totalinterview = $("#rmv_totalcount").val();
        var selectedinterview = $("#rmv_selected").val();
        var rejectedinterview = $("#rmv_rejected").val();
        var interviewer = $("#rmv_interviewer").val();
        var irfid = $("#hidirfid").val();
        $.ajax({
            type: "POST",
            url: "/Candidate/SendRemovalRequest",
            data: {
                'message': message, 'interviewerid': interviewerid, 'totalinterview': totalinterview, 'selectedinterview': selectedinterview, 'rejectedinterview': rejectedinterview, 'irfid': irfid, 'interviewer': interviewer
            },
            success: function (data) {
                swal.fire(data);
                var modal = document.getElementById("ShareRequestModal");
                modal.style.display = "none";
            }
        });
    }
</script>
