@model IEnumerable<Risebird.Entities.ViewModel.Candidate>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Open Candidate Invites";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<script>
    var Header = "Open Interview Invites";
    $('#txtpageHeader').empty().html(Header);
</script>
<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Open Interview Invites</h4></div>
                </div>


                <div class="pull-right">
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-life-ring" data-toggle="tooltip" data-placement="top" title="Support" onclick="location.href='@Url.Action("Index", "Support", new { controllerName = "Candidate", actMethod ="OpenInvites" } )'" data-original-title="Tooltip on top"><font style="font-family:arial;"> Support</font></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">

                        <div class="row">
                            @foreach (var item in Model)
                            {
                                <div class="col-lg-4 col-sm-6" style="margin-top: 15px;">
                                    <div class="card card-stats border card-blue">


                                        <div class="statistics statistics-horizontal">
                                            <div class="info info-horizontal">
                                                <div class="card-header">
                                                    <div class="row">


                                                        <div class=" col-md-6 col-sm-6 first">
                                                            <h6>@item.JDTiltle.Split('|')[0]  </h6>
                                                        </div>

                                                        <div class="col-md-6 col-sm-6 card-header-buttons action">

                                                            <button class="mdc-fab app-fab--absolute itemques" aria-label="Edit">
                                                                <span onclick="window.open('@item.CalendlyLink')" title="Schedule Meeting" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" /></svg></span>
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>


                                                <div class="card-body ">
                                                    <div class="row">

                                                        <div class="col-12">
                                                            <div class="group inner list-group-item-text">
                                                                <div class="can-details second">   <span class="client-field">Client Name:</span> <span class="clientName">@item.ClientCompName (@item.ClientName)</span></div>
                                                                <div class="can-details four">  <b>Job Ends on :</b> <span>@item.EndDate.ToString("dd MMM yyyy")  </span></div>
                                                                <div class="can-details five"> <b>Jd Link:</b> <span><a href="@item.JDLink" target="_blank">Job Description</a></span></div>

                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                        <!-- end row -->

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

    </div>

</div>



