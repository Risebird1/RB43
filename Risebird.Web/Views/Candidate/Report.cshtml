@model Risebird.Entities.ViewModel.EvaluatorReport


@{
    ViewData["Title"] = "Candidate Report";
    ViewBag.PageHeader = "Candidate Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">

    <!-- Navbar -->
    <!-- End Navbar -->
    <div class="mt50">
    </div>
    <div id="reportForm" class="content dataloading client">
        <div class="row bl-bg">
         
                <div class="col-md-12">

                    <div class="pull-right mt-20"> <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="create_pdf" value="Generate PDF" onclick="getPDF()"></div>
                </div>
            
           
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">

                            <form action="/Candidate/Report" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form" id="candidateForm">
