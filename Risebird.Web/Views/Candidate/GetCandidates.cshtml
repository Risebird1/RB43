<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#candidateTableId").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#candidateTableId").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#candidateTableId").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>

        function searchResult() {
            $('#candidateTableId').DataTable();
        }
        function RefreshSearch() {
            $('#candidateTableId').DataTable().destroy();
            setTimeout(function () {
                applyDataTable();
            }, 100);
        }

        $(document).ready(function () {
            applyDataTable();
        });
        function applyDataTable() {
            var table = $('#candidateTableId').DataTable({
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records",
                },
                order: [[1, 'desc']]
            });

            // Move length selector into the toolbar so it shares the same row as the search box
            $('#candidateTableId_wrapper .dataTables_length').prependTo('.gc-table-toolbar');

            // Wire the custom PCS-style search box to DataTable
            $('#gc-candidate-search').off('input.gcSearch').on('input.gcSearch', function () {
                table.search($(this).val()).draw();
            });
        };

        function gcClearSearch() {
            $('#gc-candidate-search').val('');
            if ($.fn.DataTable.isDataTable('#candidateTableId')) {
                $('#candidateTableId').DataTable().search('').draw();
            }
        }

</script>

