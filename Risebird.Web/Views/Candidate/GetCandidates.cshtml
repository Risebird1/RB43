<script>
        // JS for thumbnail presentation only

    let mouseMoved = false;
    const button = document.querySelector('.infoButton');

    const mouseMoveHandler = event => {
        clearInterval(loop);
        document.onmousemove = null;
        button.classList.remove('infoButton_isActive');
    };

    const toggleHandler = event => {
        const classes = button.classList;
        if (classes.contains('infoButton_isActive')) {
            classes.remove('infoButton_isActive');
        } else {
            classes.add('infoButton_isActive');
        }
    }

    document.onmousemove = mouseMoveHandler;

    const loop = setInterval(toggleHandler, 1000);
</script>
<script>
    // Queues advanced (rubric-based) screening for every resume on the channel not yet screened
    // against the rubric. The work runs in the background; the verdicts appear on refresh.
    function BulkAdvancedResumeScreen(irfId) {
        if (!confirm('Screen every resume on this skill channel that has not been screened against the rubric yet? This runs in the background and can take several minutes.')) {
            return;
        }
        var btn = $('#btnBulkResumeScreen').prop('disabled', true);
        $.ajax({
            type: 'POST',
            url: '@Url.Action("BulkAdvancedScreenCandidate", "AIScreener")',
            data: { irfId: irfId },
            success: function (res) {
                alert(res && res.message ? res.message : 'Resume screening has started.');
            },
            error: function () {
                alert('Failed to start resume screening. Try again after some time.');
            },
            complete: function () {
                btn.prop('disabled', false);
            }
        });
    }
</script>
