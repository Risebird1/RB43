@model IEnumerable<Risebird.Entities.ViewModel.Candidate>
@using Risebird.Entities.Enum
@* @model X.PagedList.IPagedList<Risebird.Entities.ViewModel.Candidate> *@
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@* @using X.PagedList.Mvc.Core; *@
@{
    ViewData["Title"] = "Candidates";
    ViewBag.PageHeader = "";
    if (ViewBag.AccessType != null && ViewBag.AccessType == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";

    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";

    }

}
<script>
    var Header = "Candidates for <strong>@ViewBag.IRFName</strong>";
    $('#txtpageHeader').empty().html(Header);

    // Serialize candidate data for WhatsApp invite modal
    var candidatesData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(c => new
        {
            id = c.id,
            Name = c.Name,
            EmailId = c.EmailId,
            EndDate = c.EndDate,
            IRFId = c.IRFId,
            IRFName = c.IRFName,
            ClientHRAttemptContact = c.ClientHRAttemptContact,
            IsColdCandidate = c.IsColdCandidate
        })));
</script>

<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css?v=2024" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous" />

<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

@if (ViewBag.AccessType == "Public")
{
    <style>

        .sidebar-mini .main-panel {
        width: calc(100% - 0px);
        }

    </style>
}

<style>
    /* ===================================================================
       GETCANDIDATES – PCS-INSPIRED DESIGN SYSTEM
    =================================================================== */

    /* --- Page header bar --- */
    .gc-header-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 14px;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
    }
    .gc-header-left { display: flex; align-items: center; gap: 8px; }
    .gc-header-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #1e293b;
        font-family: 'Roboto', sans-serif;
        margin: 0;
        line-height: 1.35;
    }
    .gc-header-right {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
    }

    /* --- Nav-pill buttons (matches pcs-nav-pill) --- */
    .pcs-nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        font-size: 11.5px;
        font-family: 'Roboto', sans-serif;
        font-weight: 600;
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        text-decoration: none !important;
        white-space: nowrap;
        line-height: 1.35;
        vertical-align: middle;
        outline: none;
        box-shadow: none;
        -webkit-appearance: none;
        appearance: none;
    }
    .pcs-nav-pill:hover, .pcs-nav-pill:focus {
        background: #e2e8f0;
        color: #1e293b !important;
        text-decoration: none !important;
        border-color: #cbd5e1;
        outline: none;
        box-shadow: none;
    }
    .pcs-nav-pill svg, .pcs-nav-pill i { color: #64748b; font-size: 11px; flex-shrink: 0; }
    .pcs-nav-pill:hover svg, .pcs-nav-pill:hover i { color: #334155; }

    /* --- Export icon button --- */
    .gc-export-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 6px;
        border: 1px solid #86efac;
        background: #f0fdf4;
        color: #16a34a !important;
        font-size: 11.5px;
        font-family: 'Roboto', sans-serif;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.16s, border-color 0.16s, color 0.16s;
        text-decoration: none !important;
        vertical-align: middle;
        line-height: 1.35;
        white-space: nowrap;
        outline: none;
        box-shadow: none;
    }
    .gc-export-btn:hover { background: #dcfce7; border-color: #4ade80; color: #15803d !important; }
    .gc-export-btn i { color: inherit !important; font-size: 11px; }

    /* --- Import Candidate button --- */
    .gc-import-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        background: #f1f5f9;
        color: #475569 !important;
        font-size: 11.5px;
        font-family: 'Roboto', sans-serif;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.16s, border-color 0.16s, color 0.16s;
        text-decoration: none !important;
        vertical-align: middle;
        line-height: 1.35;
        white-space: nowrap;
        outline: none;
        box-shadow: none;
        -webkit-appearance: none;
        appearance: none;
    }
    .gc-import-btn:hover { background: #e2e8f0; border-color: #cbd5e1; color: #1e293b !important; }
    .gc-import-btn i { color: inherit !important; font-size: 11px; }

    /* --- Custom search box toolbar --- */
    .gc-table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 0 6px;
    }
    .gc-search-box {
        display: flex;
        align-items: center;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        height: 34px;
        min-width: 220px;
        max-width: 300px;
        transition: border-color 0.18s, box-shadow 0.18s;
        overflow: hidden;
    }
    .gc-search-box:focus-within {
        border-color: #94a3b8;
        box-shadow: 0 0 0 3px rgba(148,163,184,0.14);
    }
    .gc-search-ico {
        display: flex; align-items: center; justify-content: center;
        width: 32px; flex-shrink: 0; color: #94a3b8;
    }
    .gc-search-inp {
        flex: 1 1 auto; border: none; outline: none; background: transparent;
        font-size: 12px; font-family: 'Roboto', sans-serif; color: #334155;
        padding: 0; height: 100%;
    }
    .gc-search-inp::placeholder { color: #94a3b8; }
    .gc-search-reset {
        display: flex; align-items: center; justify-content: center;
        width: 26px; flex-shrink: 0; border: none; background: transparent;
        color: #94a3b8; cursor: pointer; padding: 0; transition: color 0.15s;
    }
    .gc-search-reset:hover { color: #64748b; }

    /* Hide DataTable's auto-generated search box (using our custom one) */
    #candidateTableId_wrapper .dataTables_filter { display: none !important; }
    /* Hide the now-empty top row that DataTables generated */
    #candidateTableId_wrapper > .row:first-child { display: none !important; }
    /* Length selector moved into gc-table-toolbar – style it inline */
    .gc-table-toolbar .dataTables_length {
        display: flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        font-size: 12px;
        color: #475569;
        font-family: 'Roboto', sans-serif;
    }
    .gc-table-toolbar .dataTables_length label { margin: 0; font-weight: 500; }
    .gc-table-toolbar .dataTables_length select {
        height: 34px;
        padding: 2px 8px;
        font-size: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        color: #475569;
        background: #fff;
        cursor: pointer;
    }

    /* --- Compact Corporate Table (mirrors PCS #candidateTable) --- */
    #candidateTableId {
        font-family: 'Roboto', sans-serif;
        font-size: 12px;
        border-collapse: collapse;
    }
    #candidateTableId thead th {
        font-size: 11px !important;
        font-weight: 700 !important;
        color: #475569 !important;
        background: #f1f5f9 !important;
        border-bottom: 2px solid #cbd5e1 !important;
        white-space: nowrap;
        padding: 7px 10px !important;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }
    #candidateTableId tfoot th {
        background: #f8fafc !important;
        font-size: 11px !important;
        color: #64748b !important;
        padding: 5px 10px !important;
    }
    #candidateTableId tbody td {
        font-size: 11.5px;
        color: #334155;
        vertical-align: middle !important;
        padding: 5px 10px !important;
        border-color: #f1f5f9 !important;
        line-height: 1.35;
    }
    #candidateTableId tbody tr:hover td { background-color: #f8fafc !important; }
    #candidateTableId tbody td p { margin: 0; padding: 0; line-height: 1.3; }
    /* Candidate name/email in cells */
    #candidateTableId .name-field {
        font-size: 12.5px;
        font-weight: 600;
        color: #1e3a5f;
        font-family: 'Roboto', sans-serif;
        margin: 0; line-height: 1.35;
    }
    #candidateTableId .email-field {
        font-size: 10.5px;
        color: #64748b !important;
        font-family: 'Roboto', sans-serif;
        margin: 0; line-height: 1.25;
    }
    /* Compact name/email cell – remove old margin-top bloat */
    #candidateTableId .cadName { margin-top: 0 !important; }
    #candidateTableId .cadEmail { margin-top: 2px !important; }
    /* Cold-mark button placed beside name */
    .gc-name-top {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    /* infoButton is now a flex sibling – reset the absolute-positioning hacks from dashboard-new.css */
    .gc-info-btn {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        flex-shrink: 0;
    }

    .gc-cold-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: #fffbeb;
        color: #d97706;
        border: 1px solid #fde68a;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 5px;
        white-space: nowrap;
        flex-shrink: 0;
    }
    /* Compact status badges */
    #candidateTableId .current {
        font-size: 10.5px !important;
        padding: 2px 6px !important;
        border-radius: 4px;
        font-weight: 600;
        display: inline-block;
    }
    /* DataTable pagination & length – match PCS compact style */
    #candidateTableId_wrapper .dataTables_length select {
        font-size: 11.5px;
        border: 1px solid #e2e8f0;
        border-radius: 5px;
        padding: 2px 6px;
        color: #475569;
    }
    #candidateTableId_wrapper .dataTables_info {
        font-size: 11px;
        color: #64748b;
        padding-top: 6px !important;
    }
    #candidateTableId_wrapper .dataTables_paginate .paginate_button {
        font-size: 11.5px !important;
        padding: 3px 8px !important;
        border-radius: 5px !important;
        color: #475569 !important;
    }
    #candidateTableId_wrapper .dataTables_paginate .paginate_button.current,
    #candidateTableId_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: #f1f5f9 !important;
        border: 1px solid #e2e8f0 !important;
        color: #1e293b !important;
    }

    /* ===================================================================
       ACTION CELL – pcs-btn-act (identical to PublicCandidateStatus)
    =================================================================== */

    /* Flex container for the action <td> */
    .gc-act-cell {
        display: flex !important;
        flex-wrap: wrap;
        align-items: center;
        gap: 3px;
        padding: 5px 8px !important;
        vertical-align: middle !important;
    }

    /* Base button – matches PCS pcs-btn-act exactly */
    .pcs-btn-act {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 5px;
        border: 1px solid #e2e8f0;
        background: #e5e7eb;
        color: #111827;
        cursor: pointer;
        transition: background 0.16s, border-color 0.16s, color 0.16s;
        text-decoration: none !important;
        flex-shrink: 0;
        padding: 0;
        box-shadow: none;
        font-size: 12px;
        line-height: 1;
    }
    .pcs-btn-send{
        position:relative;
       top: -1px;
    }
    .pcs-btn-act:hover {
        color: #1e293b;
        text-decoration: none !important;
    }
    .pcs-btn-act svg, .pcs-btn-act img {
        width: 13px;
        height: 13px;
        flex-shrink: 0;
        display: block;
            color: #80868ed9;
    }

    .pcs-btn-act i {
     color: #80868ed9;
     font-size: 12px;
    }

    .pcs-btn-act i:hover,.pcs-btn-act svg:hover {
     color: #111827;
     font-size: 12px;
     }

    /* Colour modifiers (identical token values to PCS) */
    .pcs-btn-act.pcs-btn-schedule { position:relative;top:-1px; }
    .pcs-btn-act.pcs-btn-schedule:hover { background: #dbeafe; border-color: #93c5fd; }

  

    .pcs-btn-act.pcs-btn-wa { color: #16a34a; border-color: #bbf7d0; background: #f0fdf4; }
    .pcs-btn-act.pcs-btn-wa:hover { background: #dcfce7; border-color: #86efac; }

    .pcs-btn-act.pcs-btn-cancel { color: #dc2626; border-color: #fecaca; background: #fff5f5; }
    .pcs-btn-act.pcs-btn-cancel:hover { background: #fee2e2; border-color: #fca5a5; }

    .pcs-btn-act.pcs-btn-call { color: #059669; border-color: #a7f3d0; background: #ecfdf5; }
    .pcs-btn-act.pcs-btn-call:hover { background: #d1fae5; border-color: #6ee7b7; }

    .pcs-btn-act.pcs-btn-status { color: #7c3aed; border-color: #ddd6fe; background: #f5f3ff; }
    .pcs-btn-act.pcs-btn-status:hover { background: #ede9fe; }


    /* Recolour hard-coded fill="#fff" SVG paths to currentColor */
    .pcs-btn-act svg path[fill]:not([fill="none"]),
    .pcs-btn-act svg rect[fill]:not([fill="none"]),
    .pcs-btn-act svg circle[fill]:not([fill="none"]) { fill: currentColor; }
</style>

<input type="hidden" value="@ViewBag.profile" id="hidprofile" />
<input type="hidden" value="@ViewBag.IRFName" id="hidirfname" />
<input type="hidden" value="@ViewBag.IRFId" id="hidirfid" />
<input type="hidden" value="@ViewBag.emailid" id="hidemail" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="gc-header-bar">
                <div class="gc-header-left">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    <h4 class="gc-header-title">Candidates for <strong>@ViewBag.IRFName</strong></h4>
                </div>

                <div class="gc-header-right">
                    @if (ViewBag.AccessType != "Public")
                    {
                        <a class="gc-export-btn" title="Export to Excel" onclick="location.href='@Url.Action("CandidateDataExporttoExcel", "Candidate", new { irfId = ViewBag.IRFId, irfName = ViewBag.IRFName})'">
                            <i class="far fa-file-excel"></i> Export to Excel
                        </a>
                    }
                    @if (ViewBag.ButtonAccess && ViewBag.AccessType != "Public")
                    {
                        <button type="button" class="gc-import-btn" title="Import candidates from Excel" onclick="ModalButtonClick(false)">
                            <i class="far fa-file-excel"></i> Import Candidates
                        </button>
                        <button type="button" class="pcs-nav-pill" title="Import candidates with invite" onclick="ModalButtonClick(true)">
                            <i class="far fa-file-excel"></i> Import (Invite)
                        </button>
                        <button type="button" class="pcs-nav-pill" style="background:#f0fdf4;border-color:#bbf7d0;color:#16a34a;" title="Send WhatsApp Invite" onclick="OpenWhatsAppInviteModal()">
                            <img src="~/img/whatsapp.png" style="max-width:13px;vertical-align:middle;flex-shrink:0;" />
                            WhatsApp Invite
                        </button>
                        <button type="button" class="pcs-nav-pill" title="Add new candidate" onclick="javascript:AddCandidate('@ViewBag.IRFId', '@ViewBag.IRFName');">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                            Add Candidate
                        </button>
                    }

                    @if (ViewBag.profile == "Admin" || ViewBag.profile == "HR" || ViewBag.profile == "Client" || ViewBag.profile == "SeniorHR" || ViewBag.profile == "SupportAdmin")
                    {
                        @if (ViewBag.ClientRole != "HRs" && ViewBag.AccessType != "Public")
                        {
                            <button type="button" class="pcs-nav-pill" title="View candidate resumes" onclick="location.href='@Url.Action("Resumes", "Candidate", new { irfId = ViewBag.IRFId, irfName = ViewBag.IRFName})'">
                                <i class="fa fa-file-alt" style="font-size:10px;"></i> Resumes
                            </button>
                            <button type="button" class="pcs-nav-pill" style="background:#e0f5f1;border-color:#9fe0d4;color:#128873;" title="AI Phone Screen — call &amp; screen candidates" onclick="location.href='@Url.Action("Outcomes", "PhoneScreener", new { id = ViewBag.IRFId, irfName = ViewBag.IRFName})'">
                                <i class="fa fa-phone-alt" style="font-size:10px;"></i> AI Phone Screen
                            </button>
                        }
                    }

                    @if (ViewBag.AccessType != "Public" && (ViewBag.profile == "Admin" || ViewBag.profile == "SeniorHR" || ViewBag.profile == "SupportAdmin"))
                    {
                        @* Advanced resume screening: the weighted rubric resumes on this channel are
                           scored against, and a bulk run over every resume not yet screened on it. *@
                        <button type="button" class="pcs-nav-pill" title="The weighted criteria every resume on this skill channel is scored against" onclick="window.open('@Url.Action("ScreeningCriteria", "AIScreener", new { irfId = ViewBag.IRFId })', '_blank')">
                            <i class="fa fa-sliders-h" style="font-size:10px;"></i> Screening Rubric
                        </button>
                        <button type="button" class="pcs-nav-pill" id="btnBulkResumeScreen" title="Screen every resume on this skill channel that has not been screened against the rubric yet" onclick="BulkAdvancedResumeScreen('@ViewBag.IRFId')">
                            <i class="fa fa-file-signature" style="font-size:10px;"></i> Screen All Resumes
                        </button>
                    }

                    @if (ViewBag.AccessType != "Public")
                    {
                        <button id="getstatus_13" type="button" class="pcs-nav-pill" title="Back to IRF list" onclick="location.href='@Url.Action("Index", "IRF")'">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                            Back
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div id="PublicUrlShareModel" class="modal modal-bg">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="filheader">
                    <div class="filavatar">
                        <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                    </div>
                    <h5 class="modal-title pull-left">Secure Share Url</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span onclick="closePublicUrlShareModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
                </button>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="video-url">
                            <label class="label-field desp-label"> Candidate Details for Skill Channel Url:  <b id="txtUrl"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtUrl')">
                                <p class="special-text">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                    <span id="special_text" class="special-text__tooltip">
                                        Copy Link
                                    </span>
                                </p>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-12 ">
                        <div class="text-right">
                            <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closePublicUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div>



                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <!-- PCS-style search toolbar -->
                                        <div class="gc-table-toolbar">
                                            <div class="gc-search-box">
                                                <span class="gc-search-ico" aria-hidden="true">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                                                </span>
                                                <input type="search" class="gc-search-inp" id="gc-candidate-search" placeholder="Search candidates…" autocomplete="off" />
                                                <button type="button" class="gc-search-reset" onclick="gcClearSearch()" title="Clear search" aria-label="Clear search">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">

                                                <table id="candidateTableId" class="table table-striped table-bordered" cellspacing="0" width="100%">
