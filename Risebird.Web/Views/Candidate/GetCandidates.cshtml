<script>
        var spanImport = document.getElementById("importResultPopUp");
        // When the user clicks on <span> (x), close the modal
        spanImport.onclick = function () {
            var modal = document.getElementById("importResultModal");
            modal.style.display = "none";
            location.reload();
        }
        function ImportQuickCandidates() {
            document.getElementById("btnImport").disabled = true;
            var irfExcelId = '@ViewBag.IRFId';
            var irfExcelName = '@ViewBag.IRFName';
            var excel_file = $("#idExcelFile")[0].files[0];
            var isSendInvite = document.getElementById("IsSendInvite").value;


            var formdata = new FormData();
            formdata.append('IRFId', irfExcelId);
            formdata.append('IsSendInvite', isSendInvite);
            formdata.append('excel_file', excel_file);
            formdata.append('IRFName', irfExcelName);

            $.ajax({
                type: "POST",
                url: "/Candidate/ImportQuickCandidates",
                contentType: false,
                processData: false,
                data: formdata,
                success: function (data) {

                    document.getElementById('myModal').style.display = "none";
                    var importMsg = data.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
                    document.getElementById('importResultModal').style.display = "block";
                    $('#importResultTableBody').html('');
                    $('#importResultTableBody').html(importMsg);
                }
            });
        }
</script>
