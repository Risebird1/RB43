    function FetchRecording(candidateEmailid) {
        $.ajax({
            type: "POST",
            url: "/User/FetchRecordings",
            data: { 'candidateEmailid': candidateEmailid, 'irfid': $("#hidirfid").val() },
            success: function (data) {
                bindCallData(data);
                var modal = document.getElementById("myCallRecords");
                modal.style.display = "block";
