    </div>
    <div id="PublicUrlShareModel" class="modal modal-bg">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="filheader">
                    <div class="filavatar">
                        <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                    </div>
                    <h5 class="modal-title pull-left">Secure Share Url</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span onclick="closePublicUrlShareModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
                </button>
                <div class="modal-body">
                    <div class="col-md-12">
                        <div class="video-url">
                            <label class="label-field desp-label"> Candidate Details for Skill Channel Url:  <b id="txtUrl"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtUrl')">
                                <p class="special-text">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                    <span id="special_text" class="special-text__tooltip">
                                        Copy Link
                                    </span>
                                </p>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-12 ">
                        <div class="text-right">
                            <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closePublicUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div>



                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">

                                                <table id="candidateTableId" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            @* <th style="border-right: 0px !important;"></th> *@

                                                            <th>Candidate Details</th>
                                                            @* @if (ViewBag.profile != "Client")
                                                            {
                                                            <th id="getstatus_2">RB Attempts</th>
                                                            } *@
                                                            <th id="getstatus_3" style="width:7%">Resume</th>

                                                            @if (ViewBag.profile == "Client")
                                                            {
                                                                <th>Redacted Resume</th>

                                                            }

                                                            <th id="getstatus_4">Invite Sent</th>
                                                            <th id="getstatus_5">Confirmation</th>

                                                            <th>Interview Time</th>
                                                            @if (ViewBag.profile != "Client")
                                                            {
                                                                <th>Candidate Journey</th>
                                                                <th>Current Interview Status</th>

                                                            }
                                                            @*<th>Communications</th>*@
                                                            <th> Actions </th>
                                                            @if (ViewBag.profile != "Client")
                                                            {
                                                                <th style="text-align:center">Schedule Call</th>
                                                            }

                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            @* <th style="border-right: 0px !important;"></th> *@
                                                            <th>Candidate Details</th>
                                                            @* @if (ViewBag.profile != "Client")
                                                            {
                                                            <th>RB Attempts</th>
                                                            } *@
                                                            <th>Resume</th>
                                                            @if (ViewBag.profile == "Client")
                                                            {
                                                                <th>Redacted Resume</th>

                                                            }
                                                            <th>Invite Sent</th>
                                                            <th>Confirmation</th>


                                                            <th>Interview Date</th>
                                                            @if (ViewBag.profile != "Client")
                                                            {
                                                                <th width="20%">Candidate Journey</th>
                                                                <th>Current Interview Status</th>

                                                            }
                                                            @* <th>Communications</th>*@


                                                            <th> Actions </th>
                                                            @if (ViewBag.profile != "Client")
                                                            {
                                                                <th style="text-align:center">Schedule Call</th>

                                                            }
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyCandidate">

                                                        @foreach (var item in Model)
                                                        {
                                                            var colorcode = "";

                                                            if (item.HasEmailDroppedOrBounced == true)
                                                            {
                                                                colorcode = "#fa77775e";
                                                            }
                                                            else
                                                            {
                                                                colorcode = "#fff";
                                                            }


                                                            var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                                            <tr id="@item.id" data-changes="1" style="background:@colorcode">
                                                                @* <td style="width:10px;" data-toggle="collapse" id="@item.id" data-target=".@item.id" class="detail-row" onclick="changeicon('@item.id')">&nbsp;</td> *@

                                                                <td valign="top" style="position:relative;">

                                                                    @if (item.Name != null && item.Name != "")
                                                                    {
                                                                        @if (item.Name.Length > 20)
                                                                        {
                                                                            <div class="cadName" style="margin-top:10px;">
                                                                                @if (item.HasEmailDroppedOrBounced == true)
                                                                                {
                                                                                    <div class="absCenter">
                                                                                        <button class="infoButton">
                                                                                            <div class="infoButton-btn">
                                                                                                <span class="infoButton-btn-text">i</span>
                                                                                            </div>
                                                                                            <div class="infoButton-container">
                                                                                                <div class="infoButton-container-message"><b style="color:red">Bounce/Dropped :</b> emails indicates a temporary delivery failure</div>
                                                                                            </div>
                                                                                        </button>
                                                                                    </div>

                                                                                }
                                                                                <a onclick="" data-tooltip="@item.Name"><span class="name-field"> @item.Name.Substring(0, 20)..</span> </a>
                                                                            </div>
                                                                        }

                                                                        else
                                                                        {
                                                                            <div class="cadName" style="margin-top:15px;">
                                                                                @if (item.HasEmailDroppedOrBounced == true)
                                                                                {
                                                                                    <div class="absCenter">
                                                                                        <button class="infoButton">
                                                                                            <div class="infoButton-btn">
                                                                                                <span class="infoButton-btn-text">i</span>
                                                                                            </div>
                                                                                            <div class="infoButton-container">
                                                                                                <div class="infoButton-container-message"><b style="color:red">Bounce/Dropped :</b> emails indicates a temporary delivery failure</div>
                                                                                            </div>
                                                                                        </button>
                                                                                    </div>
                                                                                }
                                                                                <a onclick=""><span class="name-field"> @item.Name</span> </a>
                                                                            </div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span></span>
                                                                    }

                                                                    @if (item.EmailId != null && item.EmailId != "")
                                                                    {
                                                                        @if (item.EmailId.Length > 30)
                                                                        {

                                                                            <div class="cadEmail">
                                                                                <a onclick="" data-tooltip="@item.EmailId"><span class="email-field">Emaild: @item.EmailId.Substring(0, 30)... </span> </a>

                                                                            </div>
                                                                        }

                                                                        else
                                                                        {
                                                                            <div class="cadEmail">
                                                                                <a onclick="" data-tooltip="@item.EmailId"><span>Emaild: @item.EmailId</span> </a>
                                                                            </div>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span></span>
                                                                    }
                                                                    <div>@item.IRFName</div>
                                                                    @if (ViewBag.profile != "Client")
                                                                    {
                                                                        <span style="margin: 5px 0px;    display: inline-block;">
                                                                            @if (item.Phone != null && item.Phone != string.Empty)
                                                                            {
                                                                                <span data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CallButtonClick(@jsonObject,1)">
                                                                                    <img src="~/img/calling.png" width="17" />
                                                                                </span>

                                                                            }
                                                                            @item.Phone
                                                                        </span>
                                                                    }
                                                                    @if (item.IsColdCandidate)
                                                                    {
                                                                        <span class="cold-mark" style="top:-86px;">Cold Candidate Marked</span>
                                                                    }

                                                                </td>

                                                                @* @if (ViewBag.profile != "Client")
                                                            {
                                                            <td class="text-center">@item.AttemptsCount</td>
                                                            } *@

                                                                @if (item.ResumeLink != null && item.ResumeLink != "")
                                                                {
                                                                    @if (item.ResumeLink != null && item.ResumeLink != "")
                                                                    {
                                                                        <td> <a style="padding:0px;" id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink><img style="position:relative;left:-4px;" src="/img/resume-icon.png" width="16">Resume</a> </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Resume</td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                @if (ViewBag.profile == "Client")
                                                                {
                                                                    @if (!string.IsNullOrEmpty(item.CodedResumeLink))
                                                                    {
                                                                        <td class="cadName">
                                                                            <a href="@item.CodedResumeLink" target="_blank" data-tooltip="@item.CodedResumeLink">Resume</a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {

                                                                        if (!item.IsResumeRedactAttempted && !string.IsNullOrEmpty(item.ResumeLink))
                                                                        {
                                                                            <td>
                                                                                <a class="upload-resume-btn" onclick="UploadOrConvertIntoCodedResume(this.id, @item.id, '@item.EmailId', '@item.ResumeLink')" id=@(item.id + "__CodedResumeLink")>Convert Resume(Into Coded)</a>
                                                                            </td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td></td>
                                                                        }
                                                                    }

                                                                }

                                                                <td class="text-center">@item.TotalInvites</td>
                                                                <td class="text-center">@item.InviteConfirmation</td>
                                                                <td>@item.interviewDate</td>
                                                                @if (ViewBag.profile != "Client")
                                                                {
                                                                    <td class="text-center">


                                                                        @if (item.StatusValue == "In Progress")
                                                                        {
                                                                            <span class="current progress" style="font-size:12px; height:19px;font-weight: 500;"> @item.StatusValue</span>
                                                                        }
                                                                        else if (item.StatusValue == "New")
                                                                        {

                                                                            <span class="current new" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>

                                                                        }

                                                                        else if (item.StatusValue == "Added")
                                                                        {
                                                                            <span class="current added" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                        }

                                                                        else if (item.StatusValue == "Waiting For Response")
                                                                        {

                                                                            <span class="current waiting" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>

                                                                        }
                                                                        else if (item.StatusValue == "Scheduled")
                                                                        {

                                                                            <span class="current scheduled" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>

                                                                        }
                                                                        else if (item.StatusValue == "Cancelled")
                                                                        {
                                                                            <span class="current cancelled" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                        }
                                                                        else if (item.StatusValue == "No Show(Candidate)")
                                                                        {
                                                                            <span class="current noshowcandidate" style="font-size:12px;font-weight: 500;">@item.StatusValue</span>
                                                                        }

                                                                        else if (item.StatusValue == "Irrelevant")
                                                                        {
                                                                            <span class="current irrelevant" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                        }
                                                                        else if (item.StatusValue == "Duplicate")
                                                                        {
                                                                            <span style=" color: hotpink;font-weight: 500;font-size:12px">
                                                                                @item.StatusValue
                                                                            </span>
                                                                        }
                                                                        else if (item.StatusValue == "Not Interested")
                                                                        {
                                                                            <span style=" color: purple;font-weight: 500;font-size:12px">
                                                                                @item.StatusValue
                                                                            </span>
                                                                        }
                                                                        else if (item.StatusValue == "Got Another Offer")
                                                                        {
                                                                            <span style=" color: darkgreen;font-weight: 500;font-size:12px;    background: #c1e9c1;padding:3px 5px;">
                                                                                @item.StatusValue
                                                                            </span>
                                                                        }
                                                                        else if (item.StatusValue == "Hold")
                                                                        {
                                                                            <span style="color: orangered;font-weight: 500;font-size:12px; padding:3px 5px;   background: #e9b85e30;">
                                                                                @item.StatusValue
                                                                            </span>
                                                                        }
                                                                        else if (item.StatusValue == "Not Reachable")
                                                                        {
                                                                            <span class="current notreachable" style="font-size:13px;"> @item.StatusValue</span>
                                                                        }
                                                                        else if (item.StatusValue == "Wrong Number/Out of service")
                                                                        {
                                                                            <span class="current wrongnumber" style="font-size:13px;"> @item.StatusValue</span>
                                                                        }
                                                                        else if (item.StatusValue == "Will schedule by themselves")
                                                                        {
                                                                            <span class="current self-schedule" style="font-size:13px;"> @item.StatusValue</span>
                                                                        }
                                                                        else if (item.StatusValue == "Meeting Status")
                                                                        {
                                                                            <div style="color: #c572ac;font-weight: 500; padding:2px; font-size: 12px;background: #e892c652;display: inline;">
                                                                                @if (item.LatestComment != null && item.LatestComment != "")
                                                                                {
                                                                                    @if (item.LatestComment.Length > 20)
                                                                                    {
                                                                                        <div class="article">
                                                                                            <p style="margin-bottom:0px;">
                                                                                                @item.LatestComment.Substring(0, 20)
                                                                                            </p>
                                                                                            <p class="moretext_@item.id moretext">
                                                                                                @item.LatestComment.Substring(20, @item.LatestComment.Length - 20)
                                                                                            </p>
                                                                                        </div>
                                                                                        <a onclick="moreless('@item.id')" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <div class="article" style="overflow:hidden;display:inline-flex">
                                                                                            <p>
                                                                                                @item.LatestComment.Substring(0, @item.LatestComment.Length)
                                                                                            </p>
                                                                                        </div>
                                                                                    }
                                                                                }
                                                                            </div>
                                                                        }
                                                                        else if (item.StatusValue == "Invitation Sent")
                                                                        {
                                                                            <span style="color:#7d7079;font-weight: 500; padding:2px; font-size: 12px;background: #77838345;">
                                                                                @item.StatusValue
                                                                            </span>
                                                                        }
                                                                        else if (item.StatusValue == "Interview Status")
                                                                        {
                                                                            <div style="color:#4832d4ab;font-weight: 500; padding:2px; font-size: 12px;background:#d9d6ef94;display: inline;">
                                                                                @if (item.LatestComment != null && item.LatestComment != "")
                                                                                {
                                                                                    @if (item.LatestComment.Length > 20)
                                                                                    {
                                                                                        <div class="article">
                                                                                            <p style="margin-bottom:0px;">
