    function bindPages(pagecount, startpage, endpage, totalcount) {
        var id = $("#hidirfid").val();
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/Candidate/GetCandidates/' + id + '?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/Candidate/GetCandidates/' + id + '?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/Candidate/GetCandidates/' + id + '?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/Candidate/GetCandidates/' + id + '?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/Candidate/GetCandidates/' + id + '?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
    function closemyCallRecords() {
        var modal = document.getElementById("myCallRecords");
        modal.style.display = "none";
    }
    function FetchRecording(candidateEmailid) {
        $.ajax({
            type: "POST",
            url: "/User/FetchRecordings",
            data: { 'candidateEmailid': candidateEmailid, 'irfid': $("#hidirfid").val() },
            success: function (data) {
                bindCallData(data);
                var modal = document.getElementById("myCallRecords");
                modal.style.display = "block";
            }
        });
    }
    function bindCallData(data) {
        var html = '';
        debugger;
        for (var i = 0; i < data.length; i++) {
            html += '<tr>';
            html += '<td>' + data[i].whoCalled + '</td>';
            html += '<td>' + data[i].calledOn.replace("T", " ").replace(".000", "") + '</td>';
