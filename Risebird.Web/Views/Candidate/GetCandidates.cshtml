@model IEnumerable<Risebird.Entities.ViewModel.Candidate>
@using Risebird.Entities.Enum
@{
    ViewData["Title"] = "Candidates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Candidates for <strong>@ViewBag.IRFName</strong></a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->


    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Candidates for <strong>'@ViewBag.IRFName'</strong></h4></div>
                </div>

                <div class="pull-right">
                    <div>

                        @*<button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Click here to add Candidates from an excel file." onclick="ModalButtonClick()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Add Candidates</font></span>
                            </button>*@

                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add a Candidate." onclick="location.href='@Url.Action("Add", "Candidate", new { irfId = ViewBag.IRFId, irfName = ViewBag.IRFName})'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Add Candidate</font></span>
                        </button>



                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Candidate List" onclick="location.href='@Url.Action("ExportCandidateList", "Candidate", new { irfId = ViewBag.IRFId, irfName = ViewBag.IRFName})'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Export Candidate</font></span>
                        </button>

                        @Html.ActionLink("Back to List", "Index", "IRF", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>

                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>RB Attempts Count</th>
                                                <th>Resume</th>
                                                <th>Coded Resume</th>
                                                <th>Invite Sent</th>
                                                <th>Invite Confirmation</th>

                                                <th>Client HR</th>
                                                <th>Joinability Score</th>
                                                <th>Selectability Score</th>
                                                <th> Actions </th>
                                                <th style="text-align:center">Call</th>
                                                <th>Type</th>
                                                <th>Location(Applied for)</th>
                                                <th>Skill</th>
                                                <th>Work Auth</th>
                                                <th>Current Location</th>
                                                <th>Current Employer</th>
                                                <th>Total Experience</th>
                                                <th>Current Salary</th>
                                                <th>Expected Salary</th>
                                                <th>Notice</th>
                                                <th>Confirmation Status</th>
                                                <th>Video Link</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Interview Date</th>
                                                <th>Cost Estimate</th>
                                                <th>Profile Type</th>
                                                <th>Available for Full-time</th>
                                                <th>Available for Freelancing</th>


                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>RB Attempts Count</th>
                                                <th>Resume</th>
                                                <th>Coded Resume</th>
                                                <th>Invite Sent</th>
                                                <th>Invite Confirmation</th>

                                                <th>Client HR</th>
                                                <th>Joinability Score</th>
                                                <th>Selectability Score</th>
                                                <th> Actions </th>
                                                <th style="text-align:center">Call</th>
                                                <th>Type</th>
                                                <th>Location(Applied for)</th>
                                                <th>Skill</th>
                                                <th>Work Auth</th>
                                                <th>Current Location</th>
                                                <th>Current Employer</th>
                                                <th>Total Experience</th>
                                                <th>Current Salary</th>
                                                <th>Expected Salary</th>
                                                <th>Notice</th>
                                                <th>Confirmation Status</th>
                                                <th>Video Link</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Interview Date</th>
                                                <th>Cost Estimate</th>
                                                <th>Profile Type</th>
                                                <th>Available for Full-time</th>
                                                <th>Available for Freelancing</th>

                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                string joinabilityColor;
                                                string selectabilityColor;
                                                if (item.JoinabilityScore >= 70)
                                                {
                                                    joinabilityColor = "green";
                                                }
                                                else if (item.JoinabilityScore >= 40 && item.JoinabilityScore < 70)
                                                {
                                                    joinabilityColor = "orange";
                                                }
                                                else
                                                {
                                                    joinabilityColor = "red";
                                                }
                                                if (item.SelectabilityScore >= 70)
                                                {
                                                    selectabilityColor = "green";
                                                }
                                                else if (item.SelectabilityScore >= 40 && item.SelectabilityScore < 70)
                                                {
                                                    selectabilityColor = "orange";
                                                }
                                                else
                                                {
                                                    selectabilityColor = "red";
                                                }
                                                <tr id=@item.id>

                                                    <td> @item.Name</td>
                                                    <td> @item.EmailId</td>
                                                    <td class="text-center">@item.AttemptsCount</td>
                                                    @if (item.ResumeLink != null && item.ResumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.EncodedResumeLink != null && item.EncodedResumeLink != "")
                                                    {
                                                        <td> <a id="codedresumeId" target="_blank" title="Coded Resume" href=@item.EncodedResumeLink>Coded Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Coded Resume</td>
                                                    }
                                                    <td class="text-center">@item.TotalInvites</td>
                                                    <td class="text-center">@item.InviteConfirmation</td>
                                                    @if (item.ClientHRAttemptContact != null)
                                                    {
                                                        <td class="text-center">@item.ClientHRAttemptContact</td>

                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    <td class="text-center" style="color:@joinabilityColor;">
                                                        <b>@item.JoinabilityScore</b>
                                                    </td>
                                                    <td class="text-center" style="color:@selectabilityColor; ">
                                                        <b>@item.SelectabilityScore</b>
                                                    </td>



                                                    <td class="text-right action">

                                                        @if (ViewBag.Profile != "Recruiter")

                                                        {

                                                            if (!string.IsNullOrEmpty(item.ClientHRAttemptContact))
                                                            {
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Send Invite">
                                                                    <span onclick="location.href = '@Url.Action("SendInvite", "Candidate", new { IRFName = ViewBag.IRFName, irfId = ViewBag.IRFId, emailId = item.EmailId, endDate = item.EndDate })'" title="Send Invite" class="mdc-fab__icon material-icons">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                                                                    </span>
                                                                </button>
                                                            }

                                                            else
                                                            {
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Kindly enter Client HR's EmailId to send invite!">
                                                                    <span title="Kindly enter Client HR's EmailId to send invite!" class="mdc-fab__icon material-icons">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg>
                                                                    </span>
                                                                </button>

                                                            }




                                                            <span onclick="location.href = '@Url.Action("CancelInvite", "Candidate", new { IRFName = ViewBag.IRFName, irfId = ViewBag.IRFId, emailId = item.EmailId })'" title="Cancel Invite" class="mdc-fab app-fab--absolute trash-btn">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
                                                            </span>



                                                            <button class="mdc-fab app-fab--absolute mdc-fab-secondary" aria-label="Audio files">
                                                                <span onclick="location.href = '@Url.Action("UploadAudio", "IRF", new { candidateId = item.CandidateMasterId, irfId= item.IRFId, rfName=ViewBag.IRFName})'" title="Audio files" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M12 3v9.28c-.47-.17-.97-.28-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z" /></svg>
                                                                </span>
                                                            </button>

                                                            @*<button class="mdc-fab app-fab--absolute" aria-label="Candidate Status">
                                                                    <span onclick="OpenStatusModal('@item.id', '@item.Name','@item.Status')" class="mdc-fab__icon material-icons" title="Candidate Status"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.67-5.33-4-8-4z" /></svg></span>
                                                                </button>*@


                                                        }



                                                        <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                            <span onclick="location.href = '@Url.Action("Edit", "Candidate", new { id = item.id, irfName = ViewBag.IRFName, irfId = ViewBag.IRFId })'" title="Edit" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg>
                                                            </span>
                                                        </button>


                                                        <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                            <span onclick="javascript:DeleteCandidate('@item.id');" title="Delete" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg>
                                                            </span>
                                                        </button>



                                                        <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                            <span onclick="location.href = '@Url.Action("CandidateReport", "IRF", new { candidateId = item.CandidateMasterId, irfId= item.IRFId})'" title="Report" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg>
                                                            </span>
                                                        </button>



                                                        <button class="mdc-fab app-fab--absolute" aria-label="Candidate Status">
                                                            <span onclick="location.href = '@Url.Action("CandidateStatusList", "IRF", new { irfId= item.IRFId, candidateId = item.CandidateMasterId,  irfName=ViewBag.IRFName, candidateName=item.Name})'" title="Candidate Status" class="mdc-fab__icon material-icons">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>
                                                            </span>
                                                        </button>

                                                    </td>
                                                    <td>
                                                        @if (item.Phone != null && item.Phone != string.Empty)
                                                        {


                                                            <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CallButtonClick(@jsonObject)" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt"> Call Candidate</span></span>

                                                        }

                                                    </td>
                                                    <td>@item.Type</td>
                                                    <td>@item.Location</td>
                                                    <td>@item.Skill</td>
                                                    <td>@item.WorkAuth</td>
                                                    <td>@item.CurrentLocation</td>
                                                    <td>@item.CurrentEmployer</td>
                                                    @*<td>@item.Phone</td>*@
                                                    <td>@item.TotalExperience</td>
                                                    <td>@item.CurrentSalary</td>
                                                    <td>@item.ExpectedSalary</td>
                                                    <td>@item.Notice</td>
                                                    @if (item.confirmationStatusDesc != "0")
                                                    {
                                                        <td>@item.confirmationStatusDesc</td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    @if (item.VideoLink != null && item.VideoLink != "")
                                                    {
                                                        <td> <a id="videoId" target="_blank" title="Video" href=@item.VideoLink>Video</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Video</td>
                                                    }
                                                    @if (item.MeetingStatusDesc != "0")
                                                    {
                                                        <td>@item.MeetingStatusDesc</td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    @if (item.InterviewStatusDesc != "0")
                                                    {
                                                        <td>@item.InterviewStatusDesc</td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    @if (item.interviewDate != null)
                                                    {
                                                        <td>@item.interviewDate</td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    @if (item.CostEstimate != null)
                                                    {
                                                        <td>@item.CostEstimate</td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    <td>@item.HeuristicsscoreDesc</td>

                                                    @if (item.AvailableFullTime)
                                                    {
                                                        <td>Yes</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No</td>
                                                    }
                                                    @if (item.AvailableFreeLancing)
                                                    {
                                                        <td>Yes</td>

                                                    }
                                                    else
                                                    {
                                                        <td>No</td>
                                                    }


                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>

        <div id="myModal" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">



                        <div class="filheader">
                            <div class="filavatar">
                                <span class="publicsharing-icon">


                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg>
                                </span>
                            </div>
                            <h5 class="modal-title pull-left"> Import Candidates</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                        </button>





                        <div class="modal-body">
                            <div class="form-group text-center">
                                <h5 style="font-size:20px;"> Download the template  <span onclick="location.href='@Url.Action("DownloadTemplate", "IRF")'"><svg style="fill:#53a5f5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg></span></h5>

                                <!-- <button class="btn default" onclick="location.href='@Url.Action("DownloadTemplate", "IRF")'">Download Template</button-->

                            </div>

                            @using (Html.BeginForm("ImportCandidates", "IRF", FormMethod.Post, new { enctype = "multipart/form-data" }))
                            {
                                <div class="form-group">

                                    <!--   <label class="uploadfile" for="UploadedFile">
                                        <b>
                                            <i class="fas fa-file"></i>
                                            Click here to choose file
                                        </b>
                                    </label>-->


                                    <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" for="UploadedFile" style="margin:0px auto; display:block;">

                                        <span class="mdc-button__label"><span class="fa fa-file"><font style=" font-family: Roboto, sans-serif; font-size:12px;">   Click here to choose file</font></span></span>
                                        <div class="mdc-button__ripple"></div>
                                    </button>







                                    <input type="file" accept=".xls, .xlsx" name="UploadedFile" />
                                </div>
                                <div class="">
                                    <input type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 0px auto;
    display: block;" id="btnImport" value="Import">
                                </div>
                                <input type="hidden" id="IRFId" name="IRFId" value='@ViewBag.IRFId'>
                                <input type="hidden" id="IRFName" name="IRFName" value='@ViewBag.IRFName'>

                            }


                        </div>

                    </div>

                </div>
            </div>
        </div>


        <div id="myCallModal" class="modal modal-wrap modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">




                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">


                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Call Candidate !</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                    </button>




                    <div class="modal-body">

                        <h5 class="modal-title text-center mt-20" id="callingLabel"></h5>

                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 0px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">

                    </div>

                </div>

            </div>
        </div>


        <div id="statusModal" class="modal modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">


                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon fas fa-question fa-2x"></span>
                        </div>
                        <h5 class="modal-title pull-left" id="statusHeading"> Filter</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="statusPopUp" style="cursor:pointer;">&times;</span>
                    </button>


                    <div class="modal-body">

                        <div class="col-md-12 col-sm-12 ">
                            <div class="form-group">

                                <label class="control-labeled">
                                    Status
                                </label>

                                <select class="select-css form-control" id="statusDrpDwn" asp-items="Html.GetEnumSelectList<CandidateStatusOptions>()"></select>
                            </div>

                        </div>

                        <div class="form-group">
                            <div>
                                <div class="col-md-12 col-sm-12">
                                    <input type="button" onclick="SaveStatusPopUp()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnUpload" value="Save">
                                </div>
                            </div>



                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- end row -->
    </div>

</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/IRF/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //location.reload(true);
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        //window.location.href = '/IRF/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //location.reload(true);

                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


