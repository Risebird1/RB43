<script>
    var spanImport = document.getElementById("importResultPopUp");
    // When the user clicks on <span> (x), close the modal
    spanImport.onclick = function () {
        var modal = document.getElementById("importResultModal");
        modal.style.display = "none";
        location.reload();
    }
    function ImportQuickCandidates() {
        document.getElementById("btnImport").disabled = true;
        var irfExcelId = '@ViewBag.IRFId';
        var irfExcelName = '@ViewBag.IRFName';
        var excel_file = $("#idExcelFile")[0].files[0];
        var isSendInvite = document.getElementById("IsSendInvite").value;


        var formdata = new FormData();
        formdata.append('IRFId', irfExcelId);
        formdata.append('IsSendInvite', isSendInvite);
        formdata.append('excel_file', excel_file);
        formdata.append('IRFName', irfExcelName);

        $.ajax({
            type: "POST",
            url: "/Candidate/ImportQuickCandidates",
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {

                document.getElementById('myModal').style.display = "none";
                var importMsg = data.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
                document.getElementById('importResultModal').style.display = "block";
                $('#importResultTableBody').html('');
                $('#importResultTableBody').html(importMsg);
            }
        });
    }
</script>

@if (ViewBag.Message != null && ViewBag.Message2 != null)//&& Model.Message3 != null
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {

                    Swal.fire({

                        title: '<strong>Successful</u></strong>',
                        icon: 'info',
                        html:
                            '@ViewBag.Message' +
                        '<br/> Scheduling Link : <a target="_blank" href="@ViewBag.Message2">Scheduling Link</a>',
                        confirmButtonText: "Close",
                        allowOutsideClick: false

                    }).then((result) => {

                    });
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
else if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";

                    }
                )
            }

        }

        window.onload = my_code();
    </script>
}


