                if (data[i].confirmationStatusDesc != "0") {
                    html += '  <td>' + data[i].confirmationStatusDesc + '</td>';
                }
                else {
                    html += ' <td></td>';
                }
                if (data[i].videoLink != null && data[i].videoLink != "") {
                    html += '    <td> <a id="videoId" target="_blank" title="Video" href=' + data[i].videoLink + '>Video</a> </td>';
                }
                else {
                    html += '  <td>No Video</td>';
                }
                if (data[i].meetingStatusDesc != "0") {
                    html += '  <td>' + data[i].meetingStatusDesc + '</td>';
                }
                else {
                    html += '    <td></td>';
                }
                if (data[i].interviewStatusDesc != "0") {
                    html += '   <td>' + data[i].interviewStatusDesc + '</td>';
                }
                else {
                    html += '   <td></td>';
                }
                if (data[i].interviewDate != null) {
                    html += '   <td>' + data[i].interviewDate + '</td>';
                }
                else {
                    html += '     <td></td>';
                }
                if (data[i].costEstimate != null) {
                    html += '       <td>' + data[i].costEstimate + '</td>';
                }
                else {
                    html += '   <td></td>';
                }
                html += '   <td>' + data[i].heuristicsscoreDesc + '</td>';
                if (data[i].availableFullTime) {
                    html += '  <td>Yes</td>';

                }
                else {
                    html += '  <td>No</td>';


                }
                if (data[i].availableFreeLancing) {
                    html += '    <td>Yes</td>';

                }
                else {
                    html += '  <td>No</td>';
                }

                html += '    </tr>';
                html += '  </table>';

                html += '  </td>';
                html += '   </tr>';



            }
            $("#tblbodyCandidate").empty().html(html);
        }
        function bindPages(pagecount, startpage, endpage, totalcount) {
            var html = '';
            html += '<div class="pagination-container">';
            html += '<ul class="pagination">';
            for (var i = 1; i <= pagecount; i++) {
                if (i == 1) {
                    html += '   <li class="active"><span>1</span></li>';
                } else if (i <= 10) {
                    html += '<li><a href="/Candidate/GetCandidates?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
                } else if (i == 11) {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a href="/Candidate/GetCandidates?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a href="/Candidate/GetCandidates?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
                } else {
                    break;
                }
                if (pagecount <= 10 && i == pagecount && i != 1) {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a href="/Candidate/GetCandidates?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a href="/Candidate/GetCandidates?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
                }
            }
            html += '</ul>';
            html += '</div>';
            $("#divmeetingpages").empty().html(html);
            var pagestartdetails = '';
            pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
            $("#divmeetingentries").empty().html(pagestartdetails);

        }
    </script>

    <script>
        var candidate = "";
        var span = document.getElementById("callPopUp");
        // When the user clicks on <span> (x), close the modal
        span.onclick = function () {
            hangUp();
            var modal = document.getElementById("myCallModal");
            modal.style.display = "none";
        }
        $(document).ready(function () {
            $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
                // Set up the Twilio Client Device with the token
                Twilio.Device.setup(data.token);
            });
        });

        /* Callback to let us know Twilio Client is ready */
        Twilio.Device.ready(function (device) {

        });

        function callCandidate(phoneNumber) {
            var params = { "phoneNumber": phoneNumber };
            Twilio.Device.connect(params);
        }
        function hangUp() {
            Twilio.Device.disconnectAll();
        }

        Twilio.Device.connect(function (connection) {
            var appendText = "In call with " + "<b>" + candidate + "</b>";
            document.getElementById("callingLabel").innerHTML = appendText;
        });

        function afterTimeOut() {
            var modal = document.getElementById("myCallModal");
            modal.style.display = "none";
        }

        Twilio.Device.disconnect(function (connection) {
            var appendText = "Call disconnected! ";
            document.getElementById("callingLabel").innerHTML = appendText;
            setTimeout(afterTimeOut, 2000);

        });

        function CallButtonClick(candidateObj, indexid) {
            if (indexid == 1) {
                candidate = candidateObj.Name;
            }
            else {
                candidate = candidateObj.name;
            }
            // Get the modal
            var modal = document.getElementById("myCallModal");
            // When the user clicks the button, open the modal
            modal.style.display = "block";
            var appendText = "Calling... " + "<b>" + candidate + "</b>";
            document.getElementById("callingLabel").innerHTML = appendText;
            if (indexid == 1) {
                callCandidate(candidateObj.Phone);
            }

            else {
                callCandidate(candidateObj.phone);
            }
        }
        function closeCallPopUp() {
            hangUp();
            var modal = document.getElementById("myCallModal");
            modal.style.display = "none";
        }


    </script>
