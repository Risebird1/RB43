@model Risebird.Entities.ViewModel.CandidateStatus
@using Risebird.Entities.Enum; 

@{
    ViewData["Title"] = "Add Candidate Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="main-panel" id="main-panel">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    Add Candidate Status
                </a>
            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="mt50">
    </div>
    <div style="height:20px;"></div>
    <div class="content client">

        <div class="bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <form action="/Candidate/AddStatus" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                            @Html.AntiForgeryToken()
                            <div class="canvas_div_pdf col-md-8" style=" margin: 0px auto;">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="card-content-holder border card-blue">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group" style="margin-bottom:10px;">
                                                    @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group" style="margin-bottom:10px;">
                                                    @Html.LabelFor(model => model.IRFName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    @Html.TextBoxFor(m => m.IRFName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                </div>
                                            </div>

                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 col-sm-6">

                                                @Html.LabelFor(model => model.AudioFile, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label" })
                                                @Html.TextBoxFor(model => model.AudioFile, new { type = "file", @class = "form-control", @accept = ".mp3, .wav, .m4a" })

                                            </div>
                                            <div class="col-md-6 col-sm-6">

                                                <div class="form-group" style="margin-bottom:10px;">
                                                    @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    @Html.TextBoxFor(m => m.Comments, new { @class = "form-control text-box single-line", @style = " height:45px" })
                                                </div>

                                            </div>

                                        </div>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group " id="descDrop">
                                                    @Html.LabelFor(model => model.Status, htmlAttributes: new { @class = "control-label  desp-label" })
                                                    <select class="select-css form-control" asp-for="Status" asp-items="Html.GetEnumSelectList<CandidateStatusOptions>()" style="margin-top: 10px; height: 45px;"></select>
                                                </div>

                                            </div>


                                        </div>




                                        @Html.HiddenFor(m => m.IRFId)
                                        @Html.HiddenFor(m => m.CandidateId)
                                        @Html.HiddenFor(m => m.IRFName)
                                        @Html.HiddenFor(m => m.CandidateName)
                                        </div>
                                        <div class="card-footer">
                                            <div class="row">

                                                <div class="col-md-12 mc-button-area text-right">

                                                    @Html.ActionLink("Back", "StatusList", "Candidate", new { irfId = Model.IRFId, candidateId = Model.CandidateId, irfName = Model.IRFName, candidateName = Model.CandidateName }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })

                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnSubmit" value="Submit">Submit</button>


                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
</form>




                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->

    </div>

</div>










