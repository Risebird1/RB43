

<script>

    function OpenUploadResumeModal(irfid, Irfname, type = null,profiletype=null) {
    var modalBct = document.getElementById("uploadResumesModal");
    modalBct.style.display = "block";
    $('#IRFId').val(irfid);
    $('#IRFName').val(Irfname);
    $('#IRFType').val(type);
    $('#IRFprofiletype').val(profiletype);
        if(profiletype=="Client Admin"){
            $.ajax({
                type: "POST",
                url: "/Candidate/GetClientUsersByIRFandAdmin",
                data: {'irfid':irfid},
                success: function (result) {
                    var s = '';
                    for (var i = 0; i < result.length; i++) {
                        s += '<option value="' + result[i].value + '">' + result[i].description + '</option>';
                    }
                    $("#drpClienthruser").html(s);
                    $("#drpClienthruser").val($("#hiddemailid").val());
                }
            });
        }
    }

    function closeUploadResumeModal() {
    var modalBct = document.getElementById("uploadResumesModal");
    modalBct.style.display = "none"
    }
</script>

<div id="uploadResumesModal" class="modal modal-bg" style="z-index:999">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="upload_resume">
                <div class="uploadavatar">
                    <span class="fa fa-upload"></span>
                </div>
                <h5 class="modal-title pull-left" id="UploadResumesModalLabel"> Upload Resume(s)</h5>
            </div>

            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" style="cursor:pointer;" onclick="closeUploadResumeModal()">&times;</span>
            </button>
            <!--form-->

            <form action="/Candidate/UploadResumes" id="form_id" multiple enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form">
                @Html.AntiForgeryToken()
                <div class="upload_resume">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="col-md-12 col-sm-12">
                        <div class="form-group">
                            <div class="col-sm-12">
                                @if (ViewBag.ClientRole == "Client Admin")
                                {
                                    <div style="text-align: center; margin-bottom: 20px;">
                                        <h5 style="margin-bottom: 10px; font-weight: 600;">Select Client HR User</h5>
                                        <select id="drpClienthruser" style="margin: 0 auto; display: block; width: 50%; min-width: 200px; padding: 8px; border: 2px solid #bbb9b9; border-radius: 4px;">
                                        </select>
                                    </div>
                                }
                                <div class="drop-box">
                                    <header>
                                        <h4>Select File here</h4>
                                    </header>
                                    <p>Files Supported: PDF, DOC , DOCX</p>
                                    <label for="ResumeFiles">
                                        <a class="drop-btn text-light" role="button" aria-disabled="false">Drop your files or <span class="filepond--label-action" tabindex="0">Browse</span></a>

                                    </label>
                                    <input type="file" name="ResumeFiles" accept=".pdf, .docx, .doc" id="ResumeFiles" style="visibility: hidden; position: absolute;" multiple />

                                    <div id="files-area">
                                        <span id="filesList">
                                            <span id="files-names"></span>
                                        </span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <input type="hidden" name="IRFId" id="IRFId" />
                <input type="hidden" name="IRFName" id="IRFName" />
                <input type="hidden" name="IRFType" id="IRFType" />
                <input type="hidden" name="IRFprofiletype" id="IRFprofiletype" />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="card-footer">


                    <div class="col-md-12 mc-button-area text-right">

                        <button style="margin:3px 10px;" type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save" onclick="uploadResume();">
                            <i style="font-size:14px; padding-right:10px;" class="fa fa-cloud-upload" aria-hidden="true"></i>
                            Upload
                        </button>



                    </div>

                </div>


            </form>

        </div>
    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
<script>

    const dt = new DataTransfer();

    $("#ResumeFiles").on('change', function (e)
    {
        for (var i = 0; i < this.files.length; i++) {
            let fileBloc = $('<span/>', { class: 'file-block' }),
                fileName = $('<span/>', { class: 'name', text: this.files.item(i).name });
            fileBloc.append('<span class="file-delete"><span>+</span></span>')
                .append(fileName);
            $("#filesList > #files-names").append(fileBloc);
        };
        // Ajout des fichiers dans l'objet DataTransfer
        for (let file of this.files) {
            dt.items.add(file);
        }
        // Mise à jour des fichiers de l'input file après ajout
        this.files = dt.files;

        // EventListener pour le bouton de suppression créé
        $('span.file-delete').click(function () {
            let name = $(this).next('span.name').text();
            // Supprimer l'affichage du nom de fichier
            $(this).parent().remove();
            for (let i = 0; i < dt.items.length; i++) {
                // Correspondance du fichier et du nom
                if (name === dt.items[i].getAsFile().name) {
                    // Suppression du fichier dans l'objet DataTransfer
                    dt.items.remove(i);
                    continue;
                }
            }
            // Mise à jour des fichiers de l'input file après suppression
            document.getElementById('ResumeFiles').files = dt.files;
        });
    });

</script>
<script>
    function uploadResume() {
        var IRFId=  $('#IRFId').val();
        var IRFName= $('#IRFName').val();
        var IRFType = $('#IRFType').val();
        var clienthr = $('#drpClienthruser').val();
        var IRFprofiletype = $('#IRFprofiletype').val();
        var form_data = new FormData();
        var filesInput = document.getElementsByName('ResumeFiles')[0];
        for (var i = 0; i < filesInput.files.length; i++) {
            form_data.append('ResumeFiles',filesInput.files[i]);
        }
        form_data.append("IRFId", IRFId);
        form_data.append("IRFName", IRFName);
        if(IRFprofiletype=="Client Admin"){
        form_data.append("ClientHREmailId", clienthr);
        }
        if (IRFType != null && IRFType.toLowerCase() == 'public') {
            $.ajax({
                type: "POST",
                url: "/Candidate/UploadResumesPublicly",
                data: form_data,
                contentType: false,
                enctype: 'multipart/form-data',
                processData: false,
                success: function (result) {
                    // swal.fire(result).then(function () {
                    //     location.reload(true);
                    // });
                    swal.fire(result);
                    closeUploadResumeModal();

                },
                error: function (error) {
                    console.error(error);
                }
            });
        }
        else {
            $('#form_id').submit();
        }
    }
</script>
