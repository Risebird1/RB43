@model Risebird.Entities.ViewModel.CandidateDetailsForWhatsApp
@{
    ViewData["Title"] = "CancelInterview";
    ViewBag.PageHeader = "Cancel Interview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />


<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Cancel Interview</h4></div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            @if (Model != null)
                            {
                                <input type="hidden" id="txtinterviewid" value="@Model.id" />
                                <div class="row">
                                    <div class="col-md-6">
                                        Name <label class="form-control" style="padding:10px">@Model.CandidateName</label>
                                    </div>
                                    <div class="col-md-6">
                                        Interview Date<label class="form-control" style="padding:10px">@Model.interviewDate</label>
                                    </div>
                                    <div class="col-md-6" style="padding-top:20px">
                                        Email Address
                                        <input type="text" id="txtCandidateEmail" class="form-control" placeholder="Please Enter your Emailid" />
                                    </div>
                                </div>
                                <div class="pull-right">
                                    <button onclick="CancelInterview()" class="btn">Cancel Interview</button>
                                </div>
                            }
                            else
                            {
                                <div>No Record found.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function CancelInterview() {
        var candidateEmail = $("#txtCandidateEmail").val().trim();
        if (candidateEmail != "") {
            $.ajax({
                url: '/Candidate/CancelInterviewProcess',
                data: { 'id': $("#txtinterviewid").val(), 'CandidateEmail': candidateEmail },
                type: 'POST',
                success: function (data) {
                    swal.fire(data);
                }
            });
        } else {
            swal.fire("Please Enter EmailAddress.");
        }
    }
</script>