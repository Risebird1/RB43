<script>
    var spanImport = document.getElementById("importResultPopUp");
    // When the user clicks on <span> (x), close the modal
    spanImport.onclick = function () {
        var modal = document.getElementById("importResultModal");
        modal.style.display = "none";
        location.reload();
    }
    function ImportQuickCandidates() {
        document.getElementById("btnImport").disabled = true;
        var irfExcelId = '@ViewBag.IRFId';
        var irfExcelName = '@ViewBag.IRFName';
        var excel_file = $("#idExcelFile")[0].files[0];
        var isSendInvite = document.getElementById("IsSendInvite").value;


        var formdata = new FormData();
        formdata.append('IRFId', irfExcelId);
        formdata.append('IsSendInvite', isSendInvite);
        formdata.append('excel_file', excel_file);
        formdata.append('IRFName', irfExcelName);

        $.ajax({
            type: "POST",
            url: "/Candidate/ImportQuickCandidates",
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {

                document.getElementById('myModal').style.display = "none";
                var importMsg = data.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
                document.getElementById('importResultModal').style.display = "block";
                $('#importResultTableBody').html('');
                $('#importResultTableBody').html(importMsg);
            }
        });
    }
</script>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/IRF/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //location.reload(true);
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function () {
                        //window.location.href = '/IRF/Index';
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //location.reload(true);

                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}
<script>
    function CopyPublicUrl(EmailId, IRFId, type) {
        $.ajax({
            url: '/Candidate/GetPublicURLCandidate',
            data: { 'Emailid': EmailId, 'IRFId': IRFId, 'type': type },
            type: 'POST',
            success: function (result) {
                var modal = document.getElementById("PublicUrlShareModel");
                modal.style.display = "block";
                $("#txtUrl").text(result);
            }
        });
    }

    function closePublicUrlShareModel() {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "none";
    }

    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }

</script>


<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#candidateTableId").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#candidateTableId").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#candidateTableId").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
