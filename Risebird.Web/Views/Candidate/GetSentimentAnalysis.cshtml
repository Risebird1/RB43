@using Risebird.Entities.ViewModel
@using System.Linq
@model VideoSentimentAnalysis
@{
    ViewData["Title"] = "Sentiment Analysis";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: #fff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        margin: 0;
        padding: 20px;
        min-height: 100vh;
    }

    .sentiment-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
        position: relative;
    }

        /* Background decorative element */
        .sentiment-container::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 165, 0, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(30%, -30%);
            pointer-events: none;
            z-index: 0;
        }

    .sentiment-content {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 30px;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    /* Sentiment Score Card */
    .sentiment-score-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px 20px 30px 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        min-width: 350px;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .sentiment-score-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        }

    .sentiment-score-header {
        color: #000;
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .sentiment-gauge-container {
        position: relative;
        height: 225px;
        margin: 0 auto;
    }

    .sentiment-gauge {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        position: relative;
        transform: rotate(-90deg);
    }

    .sentiment-gauge-circle {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: #f0f0f0;
        stroke-width: 12;
    }

    .sentiment-gauge-fill {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: #FF6B35;
        stroke-width: 12;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.5s ease-out;
        stroke-dasharray: 565.48;
    }

    .sentiment-score-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(90deg);
        font-size: 3rem;
        font-weight: 700;
        color: #FF6B35;
        line-height: 1;
    }

    /* Main Content Card */
    .sentiment-main-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        overflow: visible;
        flex: 1;
        min-width: 500px;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .sentiment-main-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        }

    .sentiment-card-header {
        background: linear-gradient(135deg, #97caf4 0%, #5a9bd4 100%);
        padding: 14px 24px;
        color: #fff;
        font-weight: 600;
        font-size: 17px;
    }

    .sentiment-card-body {
        padding: 30px;
        display: flex;
        gap: 24px;
        align-items: flex-start;
        overflow: visible;
        position: relative;
    }

    .sentiment-avatar {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #fcfcfc 0%, #dbeaf7bd 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 2px solid #afd1ee;
        transition: transform 0.3s ease;
    }

        .sentiment-avatar:hover {
            transform: scale(1.05);
        }

    .sentiment-avatar-icon {
        width: 50px;
        height: 50px;
        stroke: #9abad6;
        fill: none;
        stroke-width: 2;
    }

    .sentiment-details {
        flex: 1;
        min-width: 0;
    }

    .sentiment-stars {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 20px;
    }

    .sentiment-candidate-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .sentiment-candidate-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        letter-spacing: -0.3px;
    }

    .sentiment-candidate-details {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 0.875rem;
        color: #666;
    }

    .sentiment-candidate-detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .sentiment-candidate-detail-item svg {
            width: 16px;
            height: 16px;
            color: #999;
            flex-shrink: 0;
        }

    .sentiment-star {
        width: 24px;
        height: 24px;
        color: #FF6B35;
        transition: transform 0.2s ease;
    }

        .sentiment-star.empty {
            color: #E0E0E0;
        }

        .sentiment-star:hover {
            transform: scale(1.2);
        }

    .sentiment-rating-container {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Sentiment Metrics Section */
    .sentiment-metrics {
        background: #fff;
        border-radius: 8px;
        margin-top: 10px;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        align-items: start;
        padding: 6px;
    }

    .sentiment-metric-section {
        display: flex;
        flex-direction: column;
    }

    .top-modifiers-section {
        grid-column: 1 / -1;
        margin-top: 8px;
    }

    .sentiment-metric-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: #6eaade;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 8px;
    }

    .sentiment-metric-value {
        font-size: 2rem;
        font-weight: 600;
        color: #333;
        line-height: 1.2;
        letter-spacing: -0.3px;
    }

    /* Sentiment gauge in metric section */
    .sentiment-metric-gauge {
        position: relative;
        width: 80px;
        height: 80px;
        margin-bottom: 8px;
    }

        .sentiment-metric-gauge svg {
            width: 80px;
            height: 80px;
            transform: rotate(-90deg);
        }

    .sentiment-metric-gauge-circle {
        fill: none;
        stroke: #F0F0F0;
        stroke-width: 5;
    }

    .sentiment-metric-gauge-fill {
        fill: none;
        stroke: #FF6B35;
        stroke-width: 5;
        stroke-linecap: round;
        transition: stroke-dashoffset 1s ease-out;
        stroke-dasharray: 251.33; /* 2 * π * 40 */
    }

    .sentiment-metric-gauge-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(0deg);
        font-size: 1.5rem;
        font-weight: 700;
        color: #FF6B35;
    }

    .sentiment-metric-value.rating {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 2rem;
        justify-content: flex-end;
    }

        .sentiment-metric-value.rating svg {
            width: 20px;
            height: 20px;
            fill: #FFB300;
            color: #FFB300;
            flex-shrink: 0;
        }

    .modifiers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 0px;
    }

    .modifier-tag {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        color: #333;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.8125rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        border: 2px solid transparent;
        flex-shrink: 0;
        white-space: normal;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        min-width: 100px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

        .modifier-tag::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #e0e0e0, #f5f5f5);
            transition: all 0.3s ease;
        }

        .modifier-tag:hover {
            background: linear-gradient(135deg, #d1e9fe 0%, #bad6ee99 100%);
            color: #78a1c5;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(120, 161, 197, 0.25);
            border-color: #87b2d7;
        }

        .modifier-tag.active {
            background: linear-gradient(135deg, #FF6B35 0%, #ff8c52 100%);
            color: #fff;
            border-color: #FF6B35;
            box-shadow: 0 4px 16px rgba(255, 107, 53, 0.3);
        }

    /* Tag Content Structure */
    .modifier-tag-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .modifier-tag-name {
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        text-transform: capitalize;
    }

    /* Circular Progress Indicator */
    .modifier-tag-gauge {
        width: 50px;
        height: 50px;
        position: relative;
        margin: 4px 0;
    }

        .modifier-tag-gauge svg {
            width: 50px;
            height: 50px;
            transform: rotate(-90deg);
        }

    .modifier-tag-gauge-circle {
        fill: none;
        stroke: #e0e0e0;
        stroke-width: 4;
    }

    .modifier-tag-gauge-fill {
        fill: none;
        stroke-linecap: round;
        stroke-width: 4;
        transition: stroke-dashoffset 1s ease-out, stroke 0.3s ease;
    }

    .modifier-tag-gauge-value {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(0deg);
        font-size: 0.7rem;
        font-weight: 700;
        color: #333;
        line-height: 1;
    }

    .modifier-tag.active .modifier-tag-gauge-value {
        color: #fff;
    }

    .modifier-tag.active .modifier-tag-gauge-circle {
        stroke: rgba(255, 255, 255, 0.3);
    }

    /* Mini Progress Bar */
    .modifier-tag-progress {
        width: 100%;
        height: 4px;
        background: rgba(0, 0, 0, 0.1);
        border-radius: 2px;
        overflow: hidden;
        margin-top: 4px;
        position: relative;
    }

    .modifier-tag.active .modifier-tag-progress {
        background: rgba(255, 255, 255, 0.3);
    }

    .modifier-tag-progress-fill {
        height: 100%;
        border-radius: 2px;
        transition: width 1s ease-out, background 0.3s ease;
        background: linear-gradient(90deg, #4a90e2, #5ba3f5);
        position: relative;
        overflow: hidden;
    }

        .modifier-tag-progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            animation: shimmer 2s infinite;
        }

    @@keyframes shimmer {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    /* Confidence Badge */
    .modifier-tag-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.9);
        color: #666;
        margin-top: 2px;
    }

    .modifier-tag.active .modifier-tag-badge {
        background: rgba(255, 255, 255, 0.25);
        color: #fff;
    }

    .modifier-tag-badge-icon {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4a90e2;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.7;
            transform: scale(1.2);
        }
    }

    .modifier-tag.active .modifier-tag-badge-icon {
        background: #fff;
    }

    /* Color Variations based on confidence */
    .modifier-tag.confidence-high .modifier-tag-gauge-fill {
        stroke: #28a745;
    }

    .modifier-tag.confidence-high .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #28a745, #34ce57);
    }

    .modifier-tag.confidence-medium .modifier-tag-gauge-fill {
        stroke: #ffc107;
    }

    .modifier-tag.confidence-medium .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #ffc107, #ffca2c);
    }

    .modifier-tag.confidence-low .modifier-tag-gauge-fill {
        stroke: #dc3545;
    }

    .modifier-tag.confidence-low .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #dc3545, #e4606d);
    }

    .modifier-tag.confidence-normal .modifier-tag-gauge-fill {
        stroke: #4a90e2;
    }

    .modifier-tag.confidence-normal .modifier-tag-progress-fill {
        background: linear-gradient(90deg, #4a90e2, #5ba3f5);
    }

    /* Modifier Detail Popup */
    .modifier-popup {
        position: absolute;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        padding: 16px;
        min-width: 300px;
        max-width: 380px;
        opacity: 0;
        visibility: hidden;
        display: none;
        pointer-events: none;
        border: 1px solid #E0E0E0;
        text-align: left;
    }

    /* Active popup that's moved to body */
    .modifier-popup-active {
        position: fixed !important;
        z-index: 999999 !important;
    }

    /* Popup visibility is handled by JavaScript - CSS hover removed to prevent conflicts */

    /* Connecting line between tag and popup */
    .modifier-popup::before {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 24px;
        width: 1px;
        height: 8px;
        background: #E0E0E0;
    }

    .modifier-popup::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 160px;
        width: 0;
        height: 0;
        border-left: 6px solid transparent;
        border-right: 6px solid transparent;
        border-top: 6px solid #fff;
    }

    .modifier-popup-header {
        font-size: 0.8rem;
        color: #666;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid #E0E0E0;
        line-height: 1.4;
    }

    .modifier-popup-content {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        white-space: normal;
    }

    .modifier-popup-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #F5F5F5;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid #E0E0E0;
    }

        .modifier-popup-avatar svg {
            width: 24px;
            height: 24px;
            stroke: #999;
            fill: none;
            stroke-width: 1.5;
        }

    .modifier-popup-details {
        flex: 1;
        min-width: 0;
        line-height: 16px;
    }

    .modifier-popup-user {
        font-weight: 600;
        color: #333;
        margin-bottom: 4px;
        font-size: 0.9375rem;
    }

    .modifier-popup-date {
        font-size: 0.75rem;
        color: #999;
        margin-bottom: 12px;
    }

    .modifier-popup-comment {
        font-size: 0.8rem;
        color: #666;
        line-height: 1.3;
    }

        .modifier-popup-comment .highlight {
            color: #949b97;
            font-weight: 700;
        }

    /* Confidence Level Progress Bar */
    .modifier-popup-confidence-level {
        margin-bottom: 12px;
        font-size: 0.8125rem;
        color: #666;
    }

    .confidence-level-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        font-size: 0.85rem;
        color: #999;
        padding-top:
        position: relative;
    }
    .confidence-level-label {
       display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0px;
    font-size: 0.85rem;
    color: #958080;
    position: relative;
    text-transform: lowercase;
    }

    /* Up-arrow pointing to the gauge above */
    .confidence-level-label::before {
            content: '';
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 8px solid rgb(224 224 224);
            pointer-events: none;
    }

    .confidence-level-value {
        font-weight: 700;
        color: #949b97; font-size: 0.875rem;
    }

    .confidence-progress-bar-container {
        width: 100%;
        height: 4px;
        background-color: #F0F0F0;
        border-radius: 4px;
        overflow: hidden;
        position: relative;
    }

    .confidence-progress-bar {
        height: 100%;
        background: linear-gradient(135deg, #4eda92 60%, #56e0cb 100%);
        border-radius: 4px;
        transition: width 0.8s ease-out;
        position: relative;
        overflow: hidden;
    }

    /* Popup confidence bar colors by level */
    .confidence-progress-bar.confidence-high {
        background: linear-gradient(90deg, #28a745, #34ce57);
    }
    .confidence-progress-bar.confidence-medium {
        background: linear-gradient(90deg, #ffc107, #ffca2c);
    }
    .confidence-progress-bar.confidence-low {
        background: linear-gradient(90deg, #dc3545, #e4606d);
    }
    .confidence-progress-bar.confidence-normal {
        background: linear-gradient(90deg, #4a90e2, #5ba3f5);
    }

        .confidence-progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            animation: shimmer 2s infinite;
        }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    /* Responsive Design */
    @@media (max-width: 968px) {
        .sentiment-metrics {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .sentiment-content {
            flex-direction: column;
        }

        .sentiment-score-card {
            width: 100%;
            min-width: unset;
        }

        .sentiment-main-card {
            width: 100%;
            min-width: unset;
        }

        .sentiment-card-body {
            flex-direction: column;
        }

        .sentiment-container::before {
            width: 300px;
            height: 300px;
        }

        .sentiment-metrics {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .sentiment-metric-value {
            font-size: 2rem;
        }

        .sentiment-candidate-name {
            font-size: 1.125rem;
        }

        .sentiment-candidate-details {
            font-size: 0.8125rem;
        }

        .sentiment-stars {
            gap: 10px;
        }
    }
</style>

<div class="sentiment-container">
    <div class="sentiment-content">
        <!-- Sentiment Score Card -->
        <div class="sentiment-score-card">
            <div class="sentiment-score-header">Candidate Answer</div>
            <div class="sentiment-gauge-container">
                <video controls="" style="width:300px;" class="rb-video-element">
                    <source src="https://risebirdportal.blob.core.windows.net/botinterviewvideo/9d9b8ead-b25a-4852-9b73-69f6eec79744202507231648449713.mp4?sv=2024-11-04&amp;spr=https&amp;st=2025-07-23T11%3A18%3A45Z&amp;se=2026-02-23T11%3A18%3A45Z&amp;sr=c&amp;sp=r&amp;sig=ga5oJ9bC3qvMp9JYtWDxM3azsNFdXe3qn9EjFK5BOU8%3D" type="video/mp4">
                    <source src="https://risebirdportal.blob.core.windows.net/botinterviewvideo/9d9b8ead-b25a-4852-9b73-69f6eec79744202507231648449713.mp4?sv=2024-11-04&amp;spr=https&amp;st=2025-07-23T11%3A18%3A45Z&amp;se=2026-02-23T11%3A18%3A45Z&amp;sr=c&amp;sp=r&amp;sig=ga5oJ9bC3qvMp9JYtWDxM3azsNFdXe3qn9EjFK5BOU8%3D" type="video/webm">
                    Your browser does not support the video element.
                </video>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="sentiment-main-card">
            <div class="sentiment-card-header">
                Interview Sentiment Analysis
            </div>
            <div class="sentiment-card-body">
                <div class="sentiment-avatar">
                    <svg class="sentiment-avatar-icon" viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                    </svg>
                </div>
                <div class="sentiment-details">
                    <div class="sentiment-stars">
                        <div class="sentiment-candidate-info">
                            <div class="sentiment-candidate-name">@(Model.CandidateName ?? "Candidate")</div>
                            <div class="sentiment-candidate-details">
                                <div class="sentiment-candidate-detail-item">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                        <polyline points="22,6 12,13 2,6" />
                                    </svg>
                                    <span>@(Model.CandidateEmail ?? "N/A")</span>
                                </div>
                                <div class="sentiment-candidate-detail-item">
