<script>
    function ChangeTab(type) {
        var currentUrl = window.location.href;

        // Find the index of the substring after which substitution should occur
        var originalString = currentUrl;
        var substringToFind = "candidateType=";
        var indexOfSubstring = originalString.indexOf(substringToFind);
        var newString;
        // Check if the substring is found
        if (indexOfSubstring !== -1) {
            // Define the new substring to replace the original part
            //var newSubstring = "modified";

            // Create the new string by substituting the part after the substring
            newString = originalString.substring(0, indexOfSubstring + substringToFind.length) + type;//+ originalString.substring(indexOfSubstring + substringToFind.length);


        }
        else {
            newString = originalString + '&candidateType=' + type;
        }


        window.location.href = newString;
    }
</script>
