                                                                                <th style="text-align:left"></th>
                                                                            </tr>
                                                                        </tfoot>
                                                                        <tbody id="tblbodyTimeline">

                                                                            @foreach (var item in Model)
                                                                            {
                                                                                var colorcode = "";

                                                                                if (item.HasEmailDroppedOrBounced == true)
                                                                                {
                                                                                    colorcode = "#fa77775e";
                                                                                }
                                                                                else
                                                                                {
                                                                                    colorcode = "#fff";
                                                                                }
                                                                                //var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);
                                                                                <tr data-changes="1" style="background:@colorcode">
                                                                                    <td class="cadName text-left pl15" style="padding-top:20px;" valign="top">
                                                                                        <div class="col-md-9">
                                                                                            @if (item.HasEmailDroppedOrBounced == true)
                                                                                            {
                                                                                                <div class="absCenter">
                                                                                                    <button class="infoButton" style="top:-5px;left:0px;">
                                                                                                        <div class="infoButton-btn">
                                                                                                            <span class="infoButton-btn-text">i</span>
                                                                                                        </div>
                                                                                                        <div class="infoButton-container">
                                                                                                            <div class="infoButton-container-message"><b style="color:red">Bounce/Dropped :</b> emails indicates a temporary delivery failure</div>
                                                                                                        </div>
                                                                                                    </button>
                                                                                                </div>
                                                                                            }
                                                                                            <div class="candidate-field">
                                                                                                <span class="pull-left">
                                                                                                    @if (item.CandidateName != null && item.CandidateName != "")
                                                                                                    {
                                                                                                        @if (item.CandidateName.Length > 35)
                                                                                                        {
                                                                                                            @if (item.reportcount > 1)
                                                                                                            {
                                                                                                                <p class="name-field" title="@item.CandidateName"><span title="Multiple Interviews" class="fas fa-exclamation-triangle" style="font-size:14px;color:red;float:left;padding-right:5px;"></span> <span class="pull-left">@item.CandidateName.Substring(0, 35) ...</span> <span class="contact-fill"><img src="~/Newassets/img/contacts-fill-user-icon.png" /></span></p>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <p class="name-field" title="@item.CandidateName"> <span class="pull-left">@item.CandidateName.Substring(0, 35) ...</span><span class="contact-fill"><img src="~/Newassets/img/contacts-fill-user-icon.png" /></span></p>
                                                                                                            }
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            @if (item.reportcount > 1)
                                                                                                            {
                                                                                                                <p class="name-field"><span title="Multiple Interviews" class="fas fa-exclamation-triangle" style="font-size:14px;color:red;float:left;padding-right:5px;"></span><span class="pull-left"> @item.CandidateName</span> <span class="contact-fill"><img src="~/Newassets/img/contacts-fill-user-icon.png" /></span></p>
                                                                                                            }
                                                                                                            else
                                                                                                            {
                                                                                                                <p class="name-field"><span class="pull-left">@item.CandidateName</span> <span class="contact-fill"><img src="~/Newassets/img/contacts-fill-user-icon.png" /></span></p>
                                                                                                            }
                                                                                                        }
                                                                                                    }
                                                                                                </span><span class="pull-left">
                                                                                                    @if (item.RedoInterview == true)
                                                                                                    {
                                                                                                        <p>Redo Interview</p>
                                                                                                    }
                                                                                                    else if (item.IsColdCandidate || item.InterviewId == 0)
                                                                                                    {
                                                                                                        @if (item.StatusValue == "In Progress")
                                                                                                        {
                                                                                                            <span class="current progress" style="font-size:12px; height:19px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "New")
                                                                                                        {
                                                                                                            <span class="current new" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Added")
                                                                                                        {
                                                                                                            <span class="current added" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Waiting For Response")
                                                                                                        {
                                                                                                            <span class="current waiting" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Scheduled")
                                                                                                        {
                                                                                                            <span class="current scheduled" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Cancelled")
                                                                                                        {
                                                                                                            <span class="current cancelled" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "No Show(Candidate)")
                                                                                                        {
                                                                                                            <span class="current noshowcandidate" style="font-size:12px;font-weight: 500;">@item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Irrelevant")
                                                                                                        {
                                                                                                            <span class="current irrelevant" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Duplicate")
                                                                                                        {
                                                                                                            <span style=" color: hotpink;font-weight: 500;font-size:12px">
                                                                                                                @item.StatusValue
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Not Interested")
                                                                                                        {
                                                                                                            <span style=" color: purple;font-weight: 500;font-size:12px">
                                                                                                                @item.StatusValue
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Got Another Offer")
                                                                                                        {
                                                                                                            <span style=" color: darkgreen;font-weight: 500;font-size:12px">
                                                                                                                @item.StatusValue
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Hold")
                                                                                                        {
                                                                                                            <span style="color: orangered;font-weight: 500;font-size:12px;padding:1px 10px;background: #fad89b;">
                                                                                                                @item.StatusValue
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Meeting Status")
                                                                                                        {
                                                                                                            <div style="color: #c572ac;font-weight: 500; padding:2px; font-size: 12px;background: #e892c652;display: inline;">
                                                                                                                @if (item.LatestComment != null && item.LatestComment != "")
                                                                                                                {
                                                                                                                    @if (item.LatestComment.Length > 20)
                                                                                                                    {
                                                                                                                        <div class="article">
                                                                                                                            <p style="margin-bottom:0px;">
                                                                                                                                @item.LatestComment.Substring(0, 20)
                                                                                                                            </p>
                                                                                                                            <p class="moretext_@item.CandidateId moretext">
                                                                                                                                @item.LatestComment.Substring(20, @item.LatestComment.Length - 20)
                                                                                                                            </p>
                                                                                                                        </div>
                                                                                                                        <a onclick="moreless('@item.CandidateId')" class="moreless-button" value="Readmore" id="read_@item.imid" href="#">Read more</a>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <div class="article" style="overflow:hidden;display:inline-flex">
                                                                                                                            <p>
                                                                                                                                @item.LatestComment.Substring(0, @item.LatestComment.Length)
                                                                                                                            </p>
                                                                                                                        </div>
                                                                                                                    }
                                                                                                                }
                                                                                                            </div>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Invitation Sent")
                                                                                                        {
                                                                                                            <span style="color:#7d7079;font-weight: 500; padding:2px; font-size: 12px;background: #77838345;">
                                                                                                                @item.StatusValue
                                                                                                            </span>
                                                                                                        }
                                                                                                        else if (item.StatusValue == "Interview Status")
                                                                                                        {
                                                                                                            <div style="color:#4832d4ab;font-weight: 500; padding:2px; font-size: 12px;background:#d9d6ef94;display: inline;">
                                                                                                                @if (item.LatestComment != null && item.LatestComment != "")
                                                                                                                {
                                                                                                                    @if (item.LatestComment.Length > 20)
                                                                                                                    {
                                                                                                                        <div class="article">
                                                                                                                            <p style="margin-bottom:0px;">
                                                                                                                                @item.LatestComment.Substring(0, 20)
                                                                                                                            </p>
                                                                                                                            <p class="moretext_@item.CandidateId moretext">
                                                                                                                                @item.LatestComment.Substring(20, @item.LatestComment.Length - 20)
                                                                                                                            </p>
                                                                                                                        </div>
                                                                                                                        <a onclick="moreless('@item.CandidateId')" class="moreless-button" value="Readmore" id="read_@item.CandidateId" href="#">Read more</a>
                                                                                                                    }
                                                                                                                    else
                                                                                                                    {
                                                                                                                        <div class="article" style="overflow:hidden;display:inline-flex">
                                                                                                                            <p>
                                                                                                                                @item.LatestComment.Substring(0, @item.LatestComment.Length)
                                                                                                                            </p>
                                                                                                                        </div>
                                                                                                                    }
                                                                                                                }
                                                                                                                else
                                                                                                                {
                                                                                                                    <span> @item.StatusValue</span>
                                                                                                                }
                                                                                                            </div>

                                                                                                        }
                                                                                                        else if (item.StatusValue == "Reminder Call")
                                                                                                        {
                                                                                                            <span style="color:#7d7079;font-weight: 500; padding:2px; font-size: 12px;background: #77838345;">
