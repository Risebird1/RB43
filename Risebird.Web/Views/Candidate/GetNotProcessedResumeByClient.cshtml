@model List<Risebird.Entities.Data.CandidateResume>
@using Risebird.Entities.Enum
@{
    ViewData["Title"] = "Not Processed Resume";
    ViewBag.PageHeader = "Not Processed Resume";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
}
<link href="~/Newassets/css/interviewer.css?v=2024" rel="stylesheet" type="text/css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css?v=2024" />
<script defer src="https://use.fontawesome.com/releases/v5.15.4/js/all.js" integrity="sha384-rOA1PnstxnOBLzCLMcre8ybwbTmemjzdNlILg8O7z1lUkLXozs4DHonlDtnE7fpc" crossorigin="anonymous"></script>

<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div id="main-panel">
    <div class="content  client">
        <div class="pt30">
            <div class="col-md-12 nopad">
            </div>
            <div class="row">
                <div class="mdc-card card" style="background:#fff;padding-top: 15px;">
                    <div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="table-responsive scrollbar style-2" style="overflow-x:scroll">
                                    <table id="mailsTable1" class="table table-striped table-bordered table-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th>Resume</th>
                                                <th>Email Missing</th>
                                                <th>AddedOn</th>
                                                <th style="text-align:center">Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th>Resume</th>
                                                <th>Email Missing</th>
                                                <th>AddedOn</th>
                                                <th>Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.IRFName</td>
                                                    <td><a href="@item.ResumeLink">Resume</a></td>
                                                    <td>
                                                        @if (item.IsEmailMissing.HasValue && item.IsEmailMissing.Value)
                                                        {
                                                            <span>Yes</span>
                                                        }
                                                        else
                                                        {
                                                            <span></span>
                                                        }
                                                    </td>
                                                    <td>@item.AddedOn</td>
                                                    <td style="text-align:center">
                                                        @{
                                                            var fileName = string.Empty;
                                                            if (item.ResumeLink.Split('/')?.Last().Split('?') != null)
                                                            {
                                                                fileName = item.ResumeLink.Split('/')?.Last().Split('?')?.First();
                                                            }
                                                            else
                                                            {
                                                                fileName = item.ResumeLink.Split('/')?.Last();

                                                            }
                                                        }
                                                        @if (!item.IsProcessed)
                                                        {
                                                            @* <button class="mdc-fab app-fab--absolute" aria-label="Processed">
                                                    <span onclick="javascript:ProcessedResume('@item.id', '@fileName');" title="Processed" class="mdc-fab__icon material-icons">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cpu-fill" viewBox="0 0 16 16">
                                                    <path d="M6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z" />
                                                    <path d="M5.5.5a.5.5 0 0 0-1 0V2A2.5 2.5 0 0 0 2 4.5H.5a.5.5 0 0 0 0 1H2v1H.5a.5.5 0 0 0 0 1H2v1H.5a.5.5 0 0 0 0 1H2v1H.5a.5.5 0 0 0 0 1H2A2.5 2.5 0 0 0 4.5 14v1.5a.5.5 0 0 0 1 0V14h1v1.5a.5.5 0 0 0 1 0V14h1v1.5a.5.5 0 0 0 1 0V14h1v1.5a.5.5 0 0 0 1 0V14a2.5 2.5 0 0 0 2.5-2.5h1.5a.5.5 0 0 0 0-1H14v-1h1.5a.5.5 0 0 0 0-1H14v-1h1.5a.5.5 0 0 0 0-1H14v-1h1.5a.5.5 0 0 0 0-1H14A2.5 2.5 0 0 0 11.5 2V.5a.5.5 0 0 0-1 0V2h-1V.5a.5.5 0 0 0-1 0V2h-1V.5a.5.5 0 0 0-1 0V2h-1V.5zm1 4.5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5v-3A1.5 1.5 0 0 1 6.5 5z" />
                                                    </svg>
                                                    </span>
                                                    </button> *@
                                                            <button class="btn btn-primary shadow btn-xs sharp me-1 " aria-label="Candidate Resumes" title="Add Candidate" style="background:#8dbe9c !important;border-color:#8dbe9c !important;">
                                                                <span title="Add Candidate" onclick="AddClientCandidate('@item.IRFId', '@item.IRFName','@ViewBag.emailid', '@ViewBag.id','@ViewBag.Type','@item.id','@item.ClientHREmailId')">  <span style="color:#fff;font-size: 12px;" class="fa fa-user-plus"></span></span>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <!-- end content-->
                                <!-- end col-md-12 -->
                            </div>
                            <!-- end row -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Common/_AddCandidateDetails.cshtml")
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                Swal.fire({
                    title: '<strong>Successful</u></strong>',
                    icon: 'info',
                    html:'@ViewBag.Message' ,
                    confirmButtonText: "Close",
                    allowOutsideClick: false
                });
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
<script src="~/js/BsMultiSelect.min.js"></script>

<link rel="stylesheet" type="text/css" href="~/Newassets/css/jquery.mCustomScrollbar.css?v=2024" />

<script type="text/javascript" src="~/js/plugins/mcustomscrollbar/jquery.mCustomScrollbar.js" asp-append-version="true"></script>

<script src="~/Newassets/js/scrollBar.js" asp-append-version="true"></script>

<script src="~/js/ModalFormServerValidation.js" asp-append-version="true"></script>

<script src="~/js/common.js" asp-append-version="true"></script>
<script src="~/js/markcoldcandidate.js" asp-append-version="true"></script>
<script src="~/js/TwilioCallMaker.js" asp-append-version="true"></script>
<script>
    function searchResult() {
        $('#mailsTable1').DataTable();
    }
    function RefreshSearch() {
        $('#mailsTable1').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        var table = $('#mailsTable1').DataTable({
            order: [],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });
    };
</script>
