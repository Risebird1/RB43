@model IEnumerable<Risebird.Entities.ViewModel.CandidateTimelineVM>
@using Risebird.Entities.Enum
@using Risebird.CommonHelper

@*@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.CandidateTimelineVM>*@
@using X.PagedList.Mvc.Core;
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Candidates Status";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] ScheduleStatus = new string[] { };
    string[] HREmail = new string[] { };
    string[] ProfileSource = new string[] { };

}
@if (HttpContextAccessor.HttpContext.Session.GetString("CandidateTimelinefilters") != null)
{
    filter = JsonConvert.DeserializeObject<CandidateTimelineFilter>(HttpContextAccessor.HttpContext.Session.GetString("CandidateTimelinefilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;

    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    ScheduleStatus = filter.ScheduleStatus != null ? filter.ScheduleStatus : new string[] { };
    HREmail = filter.HREmail != null ? filter.HREmail : new string[] { };
    ProfileSource = filter.ProfileSource != null ? filter.ProfileSource : new string[] { };

}
<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" type="text/css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
@*<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />*@
<link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css" />

@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"Client\"")
{
    @if (HttpContextAccessor.HttpContext.Session.GetString("NCandidateTimeline") != null)
    {

    }
    else
    {
        <script src="https://code.jquery.com/jquery-1.9.1.min.js"></script>
        <script src="~/Newassets/js/chardinjs.js"></script>
        <script src="~/Newassets/js/demo.js"></script>
        HttpContextAccessor.HttpContext.Session.SetString("NCandidateTimeline", "1");

    }


}


