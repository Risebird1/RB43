<script>
    function searchResult() {
        window.location.href = "/Candidate/CandidateTimeline?searchValue=" + $('#txtmeeting_filter').val();
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
        $(".dataTables_filter").keyup(function (e) {
            if ($("#txtmeeting_filter").val() == "") { $("#x").hide(); }
            else { $("#x").show(); }
        });
    });
</script>