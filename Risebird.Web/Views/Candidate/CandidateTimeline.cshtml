<script type="text/javascript">

    $(document).ready(function () {


        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

        $("#HREmail").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#MeetingStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#InterviewStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ScheduleStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ProfileSource").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

    })


    function ResetFilter() {

        window.location.href = "/Candidate/ResetCandidateTimelineFilter";

    }
    function ApplySessionFilter() {

        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var hrEmail=  @Html.Raw(Json.Serialize(HREmail));
        var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
        var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
        var scheduleStatus =  @Html.Raw(Json.Serialize(ScheduleStatus));
        var profileSource =  @Html.Raw(Json.Serialize(ProfileSource));
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#HREmail").val(hrEmail);
        $("#MeetingStatus").val(meetingStatus);
        $("#InterviewStatus").val(interviewStatus);
        $("#ScheduleStatus").val(scheduleStatus);
        $("#ProfileSource").val(profileSource);
        var form = $("#form").serialize();

    }

</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#candidateTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#candidateTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#candidateTable").show();
        }, 2000);
    };
  

    //// script for loader ends here
</script>
<script>
    function searchResult() {
        $('#candidateTable').DataTable();
    }
    function RefreshSearch() {
        $('#candidateTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {

        var table = $('#candidateTable').DataTable({
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records",
                }
            });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };



