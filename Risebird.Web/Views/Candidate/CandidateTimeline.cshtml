                                                                                    }
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                        <div class="timeline-section-tl" style="background:none; border:none">
                                                                            <div class="tl-round round1" style="background-color:#35353599;"></div>
                                                                        </div>
                                                                    </td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>

                                                                }
                                                                <td>
                                                                    @if (item.CurrentStatus == "Selected")
                                                                    {
                                                                        <p class="select">@item.CurrentStatus</p>
                                                                    }

                                                                    else if (item.CurrentStatus == "Rejected")
                                                                    {
                                                                        <p class="reject">@item.CurrentStatus</p>
                                                                    }
                                                                    else
                                                                    {
                                                                        <p>@item.CurrentStatus</p>
                                                                    }
                                                                </td>

                                                                <td>
                                                                    @if ((item.CurrentMeetingStatus == 4) && (item.confirmationStatus.HasValue && item.confirmationStatus == 1) && ((item.CurrentInterviewStatus != 4 && item.CurrentInterviewStatus != 2) || (item.QCStatus == 1 && (item.CurrentInterviewStatus == 4 || item.CurrentInterviewStatus == 2))))
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                            <span onclick="location.href = '@Url.Action("AddReport", "Interview", new {  interviewId = item.InterviewId, irfId= item.IRFId, isClient = true})'" title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill="#fff" d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z"></path></svg></span>
                                                                        </button>

                                                                    }
                                                                    else
                                                                    {
                                                                        <p></p>
                                                                    }
                                                                </td>

                                                            </tr>

                                                        }


                                                    </tbody>
                                                </table>

                                            </div>

                                        </div>


                                    </div>
                                </div>


                            </div>
                        </div>


                    </div>
                </div>

            </div>
        </div>


    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {


        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

        $("#HREmail").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#MeetingStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#InterviewStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#ScheduleStatus").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

    })


    function ResetFilter() {

        window.location.href = "/Candidate/ResetCandidateTimelineFilter";

    }
    function ApplySessionFilter() {

        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var hrEmail=  @Html.Raw(Json.Serialize(HREmail));
        var meetingStatus =  @Html.Raw(Json.Serialize(MeetingStatus));
        var interviewStatus =  @Html.Raw(Json.Serialize(InterviewStatus));
        var scheduleStatus =  @Html.Raw(Json.Serialize(ScheduleStatus));
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#HREmail").val(hrEmail);
        $("#MeetingStatus").val(meetingStatus);
        $("#InterviewStatus").val(interviewStatus);
        $("#ScheduleStatus").val(scheduleStatus);
        var form = $("#form").serialize();

    }

</script>

