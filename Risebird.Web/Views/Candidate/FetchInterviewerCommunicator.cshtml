@model IEnumerable<Risebird.Entities.ViewModel.SchedulingLinkVM>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Manage Interviews";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    //@if (!(bool)(ViewBag.IsClientLogin ?? false))
    //{
    //    Layout = "~/Views/Shared/_PublicLayout.cshtml";

    //}
    //else
    //{
    //    Layout = "~/Views/Shared/_Layout.cshtml";

    //}
}
<script>
    var Header = "<div id='myinterview_1'>Manage Interviews</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 7.9rem;
        right: -.3rem;
    }

    .sidebar-mini .sidebar:hover {
        width: 80px !important;
    }

    .navbar {
        position: fixed;
    }

    /*.mob_h {
                                                                                                                                                   display: none !important
                                                                                                                                            }*/

    .tox-notifications-container {
        display: none
    }
</style>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=2024" />

<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<div id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad mob-top" style="margin:25px;">
            <div class="row card-header bg-w clearfix" style="height:80px;padding: 8px 0px 20px 0px;">
                <div class="col-md-8  m-w-60 pull-left">
                    <div class="pull-left myinterview">
                        <div class="mobile-view"> <h4 class="card-title"> Manage Interviews</h4></div>
                    </div>

                </div>
                <div class="col-md-4 m-w-40 pull-left mob-ht">
                    <div class="pull-right">
                        <input type="hidden" value="@ViewBag.emailid" id="hiddemailid" />
                        <input type="hidden" value="@ViewBag.id" id="hidduniqueid" />
                        <input type="hidden" value="@ViewBag.IsClientLogin" id="hiddIsClientLogin" />



                    </div>
                </div>
                <div class="col-md-8  m-w-60 pull-left" style="padding-top:30px;">
                    @if (ViewBag.Type == "SkillChannel")
                    {
                        <div class="feedback-tab-ac" onclick="Changeurldetails('SkillChannel','@ViewBag.emailid','@ViewBag.id')"><strong>Skill Channel Interviews</strong></div>
                        <div class="feedback-tab" onclick="Changeurldetails('Project','@ViewBag.emailid','@ViewBag.id')"><strong>Project Interviews</strong></div>
                    }
                    else
                    {
                        <div class="feedback-tab" onclick="Changeurldetails('SkillChannel','@ViewBag.emailid','@ViewBag.id')"><strong>Skill Channel Interviews</strong></div>
                        <div class="feedback-tab-ac" onclick="Changeurldetails('Project','@ViewBag.emailid','@ViewBag.id')"><strong>Project Interviews</strong></div>
                    }
                </div>
                <div class="col-md-4 m-w-40 pull-left mob-ht">
                    @if (ViewBag.ClientRole != "HRs" && ViewBag.ClientRole != "Staffing Agency")
                    {
                        <div>
                            <div class="desktop-view">
                                <div class="topheader-link-wrap">
                                    <button class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space  calibrationbtn-mob" type="button" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("CalibrationMeetings", "IRF", new { emailid = ViewBag.emailid, id = ViewBag.id })'" style="margin:5px 4px 0px 3px; top:25px;position: relative;right: -95px;">
                                        <span style="float:left"><i class="far fa-user" aria-hidden="true" style="color:#fff;font-size: 13px;"></i><i class="far fa-comment-alt" style="color:#fff;font-size: 10px;position: relative;top: -4px;"></i></span>
                                        <div class="d-lg-inline-flex">
                                            Calibration Meetings
                                        </div>
                                    </button>
                                </div>
                            </div>

                            <div class="mobile-view">
                                <div class="topheader-link-wrap calibration-btn">
                                    <button class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space  calibrationbtn-mob" type="button" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("CalibrationMeetings", "IRF", new { emailid = ViewBag.emailid, id = ViewBag.id })'" style="margin:5px 4px 0px 3px; top:25px;right: -95px; position: relative;">
                                        <span><i class="far fa-user" aria-hidden="true" style="color:#fff;font-size: 13px;"></i><i class="far fa-comment-alt" style="color:#fff;font-size: 10px;position: relative;top: -4px;"></i></span>

                                    </button>
                                </div>
                            </div>


                            @*  @Html.ActionLink("Back", "PublicCandidateStatus", "Candidate", new { emailid = ViewBag.emailid, id = ViewBag.id }, htmlAttributes: new { @class = "pull-right mob-ht mdc-button mdc-button--raised mdc-ripple-upgraded mob-backbtn", @role = "button", @style = "position:relative;top:30px;right:30px;" }) *@

                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="content client ">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div>
                                <div id="tableID" class="second">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="pull-right client-ms" style="margin:0px 10px 10px 10px;">
                                            <div id="meeting_filter" class="dataTables_filter">
                                                <div class="searchbox">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="InterviewerCommunicatorList" class="table table-striped table-bordered dataTable" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            @if (ViewBag.Type == "SkillChannel")
                                                            {
                                                                <th style="border-right: 0px !important;">Skill Channel</th>
                                                                <th style="border-right: 0px !important;">Project Id</th>
                                                                <th style="border-right: 0px !important;">Job Country</th>
                                                                <th style="border-left: 0px !important;">Candidate Submission Link</th>
                                                                <th style="text-align:left">JD-Skills</th>
                                                                <th>JD</th>
                                                                <th class="text-center">Candidate Submission</th>
                                                                @if (ViewBag.ClientRole != "HRs" && ViewBag.ClientRole != "Staffing Agency")
                                                                {
                                                                    <th class="disabled-sorting text-center">Actions</th>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <th>Project</th>
                                                                <th>Project ID</th>
                                                                <th>Project Title</th>
                                                                <th>Skill Channels</th>
                                                                <th class="text-center">Candidate Submission</th>
                                                            }
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            @if (ViewBag.Type == "SkillChannel")
                                                            {
                                                                <th style="border-right: 0px !important;">Skill Channel</th>
                                                                <th style="border-right: 0px !important;">Project Id</th>
                                                                <th style="border-right: 0px !important;">Job Country</th>
                                                                <th style="border-left: 0px !important;">Candidate Submission Link</th>
                                                                <th style="text-align:left">JD-Skills</th>
                                                                <th>JD</th>
                                                                <th class="text-center">Candidate Submission</th>
                                                                @if (ViewBag.ClientRole != "HRs" && ViewBag.ClientRole != "Staffing Agency")
                                                                {
                                                                    <th class="disabled-sorting text-center">Actions</th>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <th>Project</th>
                                                                <th>Project ID</th>
                                                                <th>Project Title</th>
                                                                <th>Skill Channels</th>
                                                                <th class="text-center">Candidate Submission</th>
                                                            }
                                                        </tr>

                                                    </tfoot>
                                                    <tbody id="tblbodyMyInterview">
