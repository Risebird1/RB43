<script>
    function openSkillpopup(id) {
        $.ajax({
            type: "POST",
            url: "/IRF/FetchSkillDetails",
            data: { id: id },
            success: function (data) {
                var modal = document.getElementById("IRFSkillModel");
                var skill_id_pop = $("#skill_id_" + id).val();
                $("#skill_id_pop").text(skill_id_pop);
                modal.style.display = "block";
                bindSkillData(data);
            }
        });
    }
    function closeIRFSkillModel() {
        var model = document.getElementById("IRFSkillModel");
        model.style.display = "none";
    }
    function bindSkillData(data) {
        var html = '';
        html += ' <div class="table-responsive scrollbar style-2" style="overflow-x:scroll"><table class="table table-bordered mbn" id="SkillTable" cellpadding="0" cellspacing="0">';
        html += '  <thead>';
        html += '  <tr>';
        html += '  <th width="20%" class="table_heading">Level<span class="red">*</span></th>';
        html += '  <th width="70%" class="table_heading">Skill Name<span class="red">*</span></th>';
        html += '  <th width="10%" class="table_heading">Weightage <span class="red">*</span></th>';
        html += '  </tr>';
        html += '  </thead>';
        html += '  <tbody>';
        for (i = 0; i < data.length; i++) {
            html += '   <tr>';
            html += '  <td>' + data[i].levelName + '</td>';
            html += '    <td>' + data[i].skillName + '</td>';
            html += '  <td>' + data[i].weightage + '</td>';
            html += '  </tr>';
        }
        html += '</tbody>';
        html += ' </table></div>';
        $("#divcandidateskills").empty().html(html);
    }

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#InterviewerCommunicatorList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#InterviewerCommunicatorList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#InterviewerCommunicatorList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}
<script>
    function closeBroadcastModal() {
        var modal = document.getElementById("broadcastModal");
        tinymce.remove('#bcMessage');
        modal.style.display = "none";
    }
    function OpenBroadcastModal(irfid, Irfname) {
        var modalBct = document.getElementById("broadcastModal");
        modalBct.style.display = "block";
        tinymce.init({
            selector: "#bcMessage",
            menubar: false,
            statusbar: false,
            plugins: 'link',
            height: "300",
            toolbar: 'undo redo | bold italic underline strikethrough | fontfamily fontsize blocks | alignleft aligncenter alignright alignjustify | outdent indent |  numlist bullist checklist | forecolor backcolor casechange permanentpen formatpainter removeformat | pagebreak | charmap emoticons | fullscreen  preview save | insertfile image media pageembed template link anchor codesample | a11ycheck ltr rtl | showcomments addcomment'
            //toolbar: 'undo redo | bold italic underline strikethrough | fontfamily fontsize blocks | alignleft aligncenter alignright alignjustify | outdent indent |  numlist bullist checklist | forecolor backcolor casechange permanentpen formatpainter removeformat | pagebreak | charmap emoticons | fullscreen  preview save print | insertfile image media pageembed template link anchor codesample | a11ycheck ltr rtl | showcomments addcomment', //with print option

        });
        $("#hid_irfid_broadcast").val(irfid);
        //$("#boradcastIrfName").text(Irfname);
        $("#filterModalLabel").text('');
        $("#filterModalLabel").text('Broadcast (' + Irfname + ')');
        return;
    }

    function SendBroadcast() {
        //var message = document.getElementById("bcMessage").value;
        var message = tinymce.activeEditor.getContent();
        var subject = document.getElementById("bcSubject").value;
        var irfid = document.getElementById("hid_irfid_broadcast").value;
        $.ajax({
            type: "POST",
            url: "/IRF/BroadcastIRFmembers",
            data: { 'message': message, 'subject': subject, 'irfid': irfid },
            success: function (data) {
                window.location.href = '/IRF/Index';
            }
        });
    }
    function closeVoiceRecordingModal() {
        var modalBct = document.getElementById("VoiceRecordingModal");
        modalBct.style.display = "none";
        cancelRecording();
    }
    function OpenVoiceRecordingModal(irfid, Irfname) {
        $.ajax({
            type: "POST",
            url: "/IRF/FetchIRFAudioLink",
            data: { 'irfid': irfid },
            success: function (data) {
                document.getElementById('anchorAudioId').href = data;
                splitData = data.split("/");
                document.getElementById('anchorAudioId').innerHTML = splitData[splitData.length - 1];
                document.getElementById('controlAudioId').src = data;
            }
        });
        var modalBct = document.getElementById("VoiceRecordingModal");
        modalBct.style.display = "block";
        var html = '';
        html += '<div class="col-lg-5 col-md-5 col-sm-4 col-xs-5">';
        html += '<div class="pull-left"><button id="startRecButton" onclick="startRecording()" title="Start Recording"><i class="fa fa-play" ></i></button></div>';
        html += '<div class="pull-left"><button id="stopRecButton" type="button" onclick="stopIRFRecording(' + irfid + ')" title="Stop Recording" disabled><i class="fa fa-stop"></i></button></div>';
        html += '<div class="pull-left"><button id="cancelRecButton" type="button" onclick="cancelRecording()" title="Cancel Recording" disabled><i class="fa fa-close"></i></button></div>';
        html += '   </div>';
        html += '<div class="col-lg-7 col-md-7 col-sm-7 col-xs-7">';
        html += '<div class="row">';
        html += '   <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:center">';
        html += '       <p style="font-size:18px" id="recordingStatus"></p>';
        html += '   </div>';
        html += '</div>';
        html += '<div class="row" id="recordingRow" style="display:none">';
        html += '   <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" style="text-align:center">';
        html += '       <div id="recordingsList"></div>';
        html += '   </div>';
        html += '</div>';
        html += '</div>';
        $("#divIRFaudioRecording").empty().html(html);
    }
    function closeuploadResumesModal() {
        var modalBct = document.getElementById("uploadResumesModal");
        modalBct.style.display = "none";
    }
    function OpenuploadResumesModal(irfid, Irfname) {
        var modalBct = document.getElementById("uploadResumesModal");
        modalBct.style.display = "block";
        $("#txtIRFId").val(irfid);
        $("#txtIRFName").val(Irfname);
    }
    function UploadCandidateResume() {
        if ($("#txtIRFId").val().trim() != "" && $("#txtIRFName").val().trim() != "" && document.getElementById("ResumeFiles").files.length > 0) {
            $(".loader").show();
            var files = $("#ResumeFiles").prop("files");
            var form_data = new FormData();
            for (var i = 0; i < files.length; i++) {
                form_data.append(files[i].name, files[i]);
            }
            form_data.append("IRFId", $("#txtIRFId").val());
            form_data.append("IRFName", $("#txtIRFName").val());

            $.ajax({
                type: "POST",
                url: "/Candidate/UploadResumesPublicly",
                data: form_data,
                contentType: false,
                enctype: 'multipart/form-data',
                processData: false,
                success: function (data) {
                    $(".loader").hide();
                    alert(data);
                    closeuploadResumesModal();
                }
            });
        } else {
            alert("Please fill all the fields.");
        }
    }
</script>
<script>
    function searchResult() {
        $('#InterviewerCommunicatorList').DataTable();
    }
    function RefreshSearch() {
        $('#InterviewerCommunicatorList').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#InterviewerCommunicatorList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
    function CopySchedulinglink(schedulinglink) {
        var modal = document.getElementById("CopySchedulinglinkModel");
        modal.style.display = "block";
        $("#txtschedulinglink").text(schedulinglink);
    }
    function closeCopySchedulinglink() {
        var modal = document.getElementById("CopySchedulinglinkModel");
        modal.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
    function PlayIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The IRF will be enabled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, play it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PlayIRF?irfId=' + irfId + '&irfName=' + irfName,
                        type: 'POST',
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Played!',
                    type: 'success',
                    html: '<p>IRF has been enabled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been enabled! :)',
                    'error'
                )
            }
        })
        changeColor("yellow");
    }
    function PauseIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The IRF will be paused!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, pause it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PauseIRF?irfId=' + irfId + '&irfName=' + irfName,
                        type: 'POST',
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Paused!',
                    type: 'success',
                    html: '<p>IRF has been paused.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been paused!',
                    'error'
                )
            }
        })
        changeColor('red');
    }
    function changeColor(tileColor) {
        localStorage.removeItem("localStorageforColorName");
        localStorage.setItem('localStorageforColorName', 'localStorageforColor');
        let value = localStorage.getItem('localStorageforColorName');
        if (value) {
            $(document).ready(function () {
                $("#divTile").css({ "backgroundColor": tileColor });
            });
        }
    }
    //Candidates
    function Candidates(id, IRFid) {

        var url = '/Candidate/GetCandidates?id=' + id + '&irfName=' + IRFid;
        window.location.href = url;
    };
</script>



