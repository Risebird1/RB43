                                                                            <span title="Scheduling Link" onclick="javascript:CopySchedulinglink('@item.CalendlyLink');"><i class='fa fa-clone' style="font-size:11px;position:relative;left:0px;top:0px;"></i></span>
                                                                        </div>
                                                                    </td>
                                                                    @*<td> @item.BillingOwner </td>*@
                                                                    <td>
