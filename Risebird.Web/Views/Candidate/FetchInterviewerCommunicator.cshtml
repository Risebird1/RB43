<script>
    function searchResult() {
        $('#InterviewerCommunicatorList').DataTable();
    }
    function RefreshSearch() {
        $('#InterviewerCommunicatorList').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();
    });

    function applyDataTable() {
        $('#InterviewerCommunicatorList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span style='right:20px;top:9px;' id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
    function CopySchedulinglink(schedulinglink) {
        var modal = document.getElementById("CopySchedulinglinkModel");
        modal.style.display = "block";
        $("#txtschedulinglink").text(schedulinglink);
    }
    function closeCopySchedulinglink() {
        var modal = document.getElementById("CopySchedulinglinkModel");
        modal.style.display = "none";
    }

    function PlayIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The IRF will be enabled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, play it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PlayIRF?irfId=' + irfId + '&irfName=' + irfName,
                        type: 'POST',
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Played!',
                    type: 'success',
                    html: '<p>IRF has been enabled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been enabled! :)',
                    'error'
                )
            }
        })
        changeColor("yellow");
    }
    function PauseIRF(irfId, irfName) {
        swal.fire({
            title: 'Are you sure?',
            text: "The IRF will be paused!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, pause it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PauseIRF?irfId=' + irfId + '&irfName=' + irfName,
                        type: 'POST',
                        success: function (result) {
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Paused!',
                    type: 'success',
                    html: '<p>IRF has been paused.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been paused!',
                    'error'
                )
            }
        })
        changeColor('red');
    }
    function changeColor(tileColor) {
        localStorage.removeItem("localStorageforColorName");
        localStorage.setItem('localStorageforColorName', 'localStorageforColor');
        let value = localStorage.getItem('localStorageforColorName');
        if (value) {
            $(document).ready(function () {
                $("#divTile").css({ "backgroundColor": tileColor });
            });
        }
    }
    //Candidates
    function Candidates(id, IRFid) {
        var url = '/Candidate/GetCandidates?id=' + id + '&irfName=' + IRFid;
        window.location.href = url;
    }
    function Changeurldetails(type, emailid, id) {
        window.location.href = "/Candidate/FetchInterviewerCommunicator?emailid=" + emailid + "&type=" + type + "&isClientLogin=true&id=" + id;
    }
</script>



