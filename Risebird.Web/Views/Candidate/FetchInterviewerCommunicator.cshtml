                                                                        <button class="btn btn-upload shadow btn-xs sharp me-1" aria-label="Upload Resumes">
                                                                            <span onclick="javascript:OpenUploadResumeModal('@item.id', '@item.IRFId', 'public');" title="Upload Resumes">
                                                                                <span class="fas fa-upload"></span>
                                                                            </span>
                                                                        </button>
                                                                      
                                                                        <button id="skill_16" class="btn btn-success shadow btn-xs sharp me-1" aria-label="Import Candidates" style="background:#42a5f5;">
                                                                            <span onclick="OpenImportModal('@item.id', '@item.IRFId', '@ViewBag.emailid','@item.JDTiltle')" title="Import Candidates"><i class='fas fa-file-import' style="font-size:13px;position:relative;left:-1px;"></i></span>
                                                                        </button>

                                                                          @* @if (!(bool)(ViewBag.IsClientLogin ?? false))
                                                                      {*@
                                                                        <button class="btn btn-primary shadow btn-xs sharp me-1 " aria-label="Candidate Resumes" title="Candidate Resumes">
                                                                            <a data-tooltip="Check resume upload status here" target="_blank" title="" href="javascript:void"> <span title="Candidate Resumes" onclick="location.href='@Url.Action("ResumesPublicly", "Candidate",  new { irfId = item.id, irfName = item.IRFId,emailid = ViewBag.emailid, id = ViewBag.id })'">  <span style="color:#fff" class="fas fa-file"></span></span></a>
                                                                        </button>
                                                                        @*  }*@

                                                                        @if (ViewBag.ClientRole != "HRs" && ViewBag.ClientRole != "Staffing Agency")
                                                                        {
                                                                            <a target="_blank" style="position:relative;top:0px;text-decoration:none;" href="@Url.Action("SkillChannelMeetingsDetails", "IRF" , new { uniqueid = ViewBag.id , IRFName = item.IRFId,meetingtype="Select",irfId=item.id})" title="Selected Meetings">
                                                                                <div class="btn  shadow btn-xs sharp me-1 item1" aria-label="Selected Meetings" style="background:#30a73099;">
                                                                                    <span title="Selected Meetings"><span class="fa fa-user-check" style="color:#fff;font-size:11px;color:#fff;font-size: 13px;position: relative;left: -2px;"></span></span>
                                                                                </div>
                                                                            </a>
                                                                            <a target="_blank" style="position:relative;top:0px;text-decoration:none;" href="@Url.Action("SkillChannelMeetingsDetails", "IRF" , new { uniqueid = ViewBag.id , IRFName = item.IRFId,meetingtype="Reject",irfId=item.id})" title="Rejected Meetings">
                                                                                <div class="btn btn-candlist shadow btn-xs sharp me-1 item1" aria-label="Rejected Meetings" style="background: #cb2b18a1;">
                                                                                    <span title="Rejected Meetings"><span class="fa fa-user" style="color:#fff;position:relative;left: -2px;top:0px;font-size:12px;"></span><span class="fa fa-times" style="color:#fff;font-size: 11px;position:relative;left: -6px;top:0px;animation:auto;"></span></span>
                                                                                </div>
                                                                            </a>
                                                                        }


                                                                

                                                                        @* @if (!(bool)(ViewBag.IsClientLogin ?? false))
                                                                {*@
                                                                        <a target="_blank" style="position:relative;top:0px;" href="@Url.Action("GetPublicCandidates", "Candidate" , new { id = item.id, irfName = item.IRFId, profileName = "Client", emailid = ViewBag.emailid})" title="Candidate List">
                                                                            <div class="btn btn-candlist shadow btn-xs sharp me-1 item1" aria-label="Candidate List">
                                                                                <span title="Candidate List"><span class="fas fa-list" style="color:#fff"></span></span>
                                                                            </div>
                                                                        </a>
                                                                        @* }*@
                                                                    </td>
                                                                    @if (ViewBag.ClientRole != "HRs" && ViewBag.ClientRole != "Staffing Agency")
                                                                    {
                                                                        <td class="text-center">
                                                                            <button id="skill_10" class="btn shadow btn-xs sharp me-1 item1" aria-label="Calibration Meeting" style="width:25px!important;height:25px!important;background: #1a9b477d;border-color:#bedcc99e">
                                                                                <span onclick="javascript:opencalibrationModel('@item.id', '@item.IRFId','@item.JDTiltle','');" title="Calibration Meeting">
                                                                                    <i class="fa fa-users" aria-hidden="true" style="color: #fff;position: relative; left: -2px;"></i>
                                                                                </span>
                                                                            </button>
                                                                            <button class="btn btn-primary shadow btn-xs sharp me-1" aria-label="HM Instruction">
                                                                                <span onclick="javascript:CopyHMInstructionsLink('@item.id', '@item.IRFId');" title="HM Instruction">
                                                                                    <svg style="color: white;position: relative;top:-2px;" xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="bi bi-list-check" viewBox="0 0 16 16"> <path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3.854 2.146a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 3.293l1.146-1.147a.5.5 0 0 1 .708 0zm0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 7.293l1.146-1.147a.5.5 0 0 1 .708 0zm0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0z" fill="white"></path> </svg>
                                                                                    <svg fill="#fff" style="position:relative;top:2px;right:10px;" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path></svg>

                                                                                </span>
                                                                            </button>

                                                                            @if (item.IsPaused)
                                                                            {
                                                                                <button id="skill_16" class="btn btn-success shadow btn-xs sharp me-1" aria-label="Play">
                                                                                    <span onclick="PlayIRF('@item.id', '@item.IRFId');" title="Play"><svg xmlns="http://www.w3.org/2000/svg" fill="#fff" width="16" height="16" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
                                                                                </button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button id="skill_16" class="btn shadow btn-xs sharp me-1  trash-btn" aria-label="Pause">
                                                                                    <span onclick="PauseIRF('@item.id', '@item.IRFId');" title="Pause" style="position:relative;left:-1px;top:-1px"><svg fill="#fff" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg></span>
                                                                                </button>
                                                                            }
                                                                            <button id="skill_16" class="btn btn-success shadow btn-xs sharp me-1" aria-label="Download Candidate Reports" style="background:#42a5f5;">
                                                                                <span onclick="location.href='@Url.Action("CandidateDataExporttoExcel", "Candidate",new { irfId =item.id, irfName =item.IRFId})'" title="Download Candidate Reports"><svg style="color: white;position: relative;top:-2px;left:-1px;" xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" class="bi bi-file-earmark-excel" viewBox="0 0 16 16"> <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219l-2.116-2.54z" fill="white"></path> <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z" fill="white"></path> </svg></span>
                                                                            </button>
                                                                        </td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td>@item.ProjectName</td>
                                                                    <td>@item.ProjectUniqueid</td>
                                                                    <td>@item.JDTiltle</td>
                                                                    <td>@item.IRFCount</td>
                                                                    <td class="text-center">
                                                                        @* <button class="btn btn-upload shadow btn-xs sharp me-1" aria-label="Upload Resumes">
                                                                <span onclick="javascript:OpenUploadResumeModal('@item.id', '@item.ProjectUniqueid', 'public');" title="Upload Resumes">
                                                                <span class="fas fa-upload"></span>
                                                                </span>
                                                                </button>*@

                                                                        <button id="skill_16" class="btn btn-success shadow btn-xs sharp me-1" aria-label="Import Candidates" style="background:#42a5f5;">
                                                                            <span onclick="OpenProjectImportModal('@item.id', '@item.ProjectUniqueid', '@ViewBag.emailid','@item.ProjectName')" title="Import Candidates"><i class='fas fa-file-import' style="font-size:13px;position:relative;left:-1px;"></i></span>
                                                                        </button>
                                                                        <a target="_blank" style="position:relative;top:0px;text-decoration:none;" href="@Url.Action("ProjectMeetingsDetails", "IRF" , new { uniqueid = ViewBag.id , ProjectUniqueid = item.ProjectUniqueid,meetingtype="Select",projectid=item.id})" title="Selected Meetings">
                                                                            <div class="btn  shadow btn-xs sharp me-1 item1" aria-label="Selected Meetings" style="background:#30a73099;">
                                                                                <span title="Selected Meetings"><span class="fa fa-user-check" style="color:#fff;font-size:11px;color:#fff;font-size: 13px;position: relative;left: -2px;"></span></span>
                                                                            </div>
                                                                        </a>
                                                                        <a target="_blank" style="position:relative;top:0px;text-decoration:none;" href="@Url.Action("ProjectMeetingsDetails", "IRF" , new { uniqueid = ViewBag.id , ProjectUniqueid = item.ProjectUniqueid,meetingtype="Reject",projectid=item.id})" title="Rejected Meetings">
                                                                            <div class="btn btn-candlist shadow btn-xs sharp me-1 item1" aria-label="Rejected Meetings" style="background: #cb2b18a1;">
                                                                                <span title="Rejected Meetings"><span class="fa fa-user" style="color:#fff;position:relative;left: -2px;top:0px;font-size:12px;"></span><span class="fa fa-times" style="color:#fff;font-size: 11px;position:relative;left: -6px;top:0px;animation:auto;"></span></span>
                                                                            </div>
                                                                        </a>
                                                                        <a target="_blank" style="position:relative;top:0px;" href="@Url.Action("GetProjectPublicCandidates", "Candidate" , new { id = item.id, projectName = item.ProjectName, emailid = ViewBag.emailid,uniqueid = ViewBag.id})" title="Candidate List">
                                                                            <div class="btn btn-candlist shadow btn-xs sharp me-1 item1" aria-label="Candidate List">
                                                                                <span title="Candidate List"><span class="fas fa-list" style="color:#fff"></span></span>
                                                                            </div>
                                                                        </a>
                                                                    </td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->
        </div>

    </div>
</div>


<div id="IRFSkillModel" class="modal modal-bg" style="z-index:100">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Tech Skills <span class="popup-text" id="skill_id_pop"></span></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeIRFSkillModel()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <input type="text" hidden id="txtinterviewid" />
            <div class="modal-body">
                <div style="padding:10px" id="divcandidateskills">
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeIRFSkillModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div id="broadcastModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
