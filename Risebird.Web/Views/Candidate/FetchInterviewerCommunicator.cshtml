    //    //$("#txtIRFId").val(irfid);
    //    //$("#txtIRFName").val(Irfname);
    //}
    function UploadCandidateResume() {

        if (irfId != 0 && irfName.trim() != "" && document.getElementById("ResumeFiles").files.length > 0) {
            $(".loader").show();
            var files = $("#ResumeFiles").prop("files");
            var form_data = new FormData();
            for (var i = 0; i < files.length; i++) {
                form_data.append(files[i].name, files[i]);
            }
            form_data.append("IRFId", irfId);
            form_data.append("IRFName", irfName);

            $.ajax({
                type: "POST",
                url: "/Candidate/UploadResumesPublicly",
                data: form_data,
                contentType: false,
                enctype: 'multipart/form-data',
                processData: false,
                success: function (data) {
                    $(".loader").hide();
                    swal.fire(data);
                    closeuploadResumesModal();
                }
            });
        } else {
            alert("Please fill all the fields.");
        }
    }
    function openHMInstruction(irfid, Irfname) {
        var url = "/IRF/DeliveryHeadInstruction?irfid=" + irfid;
        window.open(url, '_blank');
    }
