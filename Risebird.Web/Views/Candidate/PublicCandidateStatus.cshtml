<style>
    .star-rating {
        border: solid 1px white;
        display: flex;
        direction: rtl;
        font-size: 2.0em;
        justify-content: space-around;
        padding: 0 .2em;
        text-align: center;
        width: 100%;
        margin-bottom: 10px;
        background-color: lightgray;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            /*color: #ccc;*/
            color: #e4e4e4;
            cursor: pointer;
        }

        .star-rating :checked ~ label {
            color: #f90;
        }

        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: #fc0;
        }

    .card-title-space {
        margin: 20px 0px;
        float: right
    }

    .mb10 {
        margin-bottom: 10px
    }

    .topheader-header [data-tooltip]:before {
        background: #92938b !important;
        color: #fff !important;
        box-shadow: none;
        top: 42px;
        width: 455px;
        height: 27px;
        clear: both;
        text-transform: initial;
        position: absolute;
        z-index: 100;
        border: none !important;
        font-size: 11px;
    }

    .dataTables_wrapper div#candidateTable_length label {
        /*display: none !important;*/
    }

    .topheader-header [data-tooltip]:after {
        border-top: 8px solid #92938b !important;
        border-right: 7px solid transparent !important;
        border-left: 7px solid transparent !important;
        top: 35px;
        transform: rotate(180deg);
    }
</style>

<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 7.9rem;
        right: -.3rem;
    }

    .sidebar-mini .sidebar:hover {
        width: 80px !important;
    }

    /*.mob_h {
                                display: none !important
                                  }*/
    .modal-backdrop {
        visibility: hidden !important;
    }

    .modal.in {
        background-color: rgba(0,0,0,0.5);
    }

    .navbar {
        position: fixed;
    }
</style>

