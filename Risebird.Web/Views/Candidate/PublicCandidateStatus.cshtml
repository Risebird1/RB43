                .btn-act.btn-act-cold,
                .act-btns .btn-act.btn-act-cold {
                    background: #fef3c7;
                    color: #d97706;
                }
                .btn-act.btn-act-cold:hover,
                .act-btns .btn-act.btn-act-cold:hover {
                    background: #fde68a;
                    color: #b45309;
                }
