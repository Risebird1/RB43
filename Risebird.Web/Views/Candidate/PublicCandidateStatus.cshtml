<script>
    $(document).on('hidden.bs.modal', function (event) {
        if ($('.modal:visible').length) {
            $('body').addClass('modal-open');
        }
    });
    $(document).ready(function () {
        if ($("#txtVideostatus").val() == "Public") {
            var modal = document.getElementById("PublicShareVideo");
            modal.style.display = "block";
        }
        //var emailiud = window.localStorage.getItem('PublicEmailid');
        //if (emailiud != "" && emailiud != null) {
        //    $("#txtvideoemailid").val(emailiud);
        //    SubmitEmail();
        //}
    });
    function SubmitEmail() {
        if ($("#txtvideoemailid").val().trim() != "") {
            localStorage.setItem('PublicEmailid', $("#txtvideoemailid").val());
            $.ajax({
                type: "POST",
                url: "/Candidate/PublicAllMeetings",
                data: { id: $("#hidtxtid").val(), Emailid: $("#txtvideoemailid").val().trim() },
                success: function (data) {
                    if (data == "success") {
                        window.location = "/Candidate/PublicCandidateStatus?emailid=" + $("#txtvideoemailid").val() + "&id=" + $("#hidtxtid").val();
                    } else {
                        swal.fire(data);
                    }
                }
            });
        }
    }
    function SubmitEmailAdmin() {
        if ($("#txtvideoemailid").val().trim() != "") {
            localStorage.setItem('PublicEmailid', $("#txtvideoemailid").val());
            $.ajax({
                type: "POST",
                url: "/Candidate/PublicAllMeetingsAdmin",
                data: { Emailid: $("#txtvideoemailid").val().trim() },
                success: function (data) {
                    if (data == "success") {
                        window.location = "/Candidate/PublicCandidateStatus?emailid=" + $("#txtvideoemailid").val();
                    } else {
                        swal.fire(data);
                    }
                }
            });
        }
    }
</script>
