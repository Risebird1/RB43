    function bindstatusListdata(data) {
        var html = '';
        for (var i = 0; i < data.length; i++) {
            html += '<tr><td>' + data[i].date.replace("T", " ") + '</td>';
            if (data[i].redoInterview == true && data[i].statusValue == "Meeting Status" && (data[i].meetingStatus == 4 || data[i].meetingStatus == 6 || data[i].meetingStatus == 7 || data[i].meetingStatus == 8) && (data[i].confirmationStatus == 1)) {
                html += '<td><p>Redo Interview</p></td>';
            }
            else {
                if (data[i].statusValue == "In Progress") {
                    html += '    <td>span class="current progress"> ' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "New") {
                    html += '<td><span class="current new">' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "Waiting For Response") {
                    html += '<td style="color: orange;font-weight: 500"> ' + data[i].statusValue + '</td>';
                }
                else if (data[i].statusValue == "Scheduled") {
                    html += '<td><span class="current scheduled">' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "Added") {
                    html += '<td><span class="current added">' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "Cancelled") {
                    html += '<td><span class="current cancelled">' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "No Show(Candidate)") {
                    html += '<td><span class="current noshowcandidate">' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "Irrelevant") {
                    html += '<td><span class="current irrelevant"> ' + data[i].statusValue + '</span></td>';
                }
                else if (data[i].statusValue == "Duplicate") {
                    html += '<td style=" color: hotpink;font-weight: 500">' + data[i].statusValue + '</td>';
                }
                else if (data[i].statusValue == "Not Interested") {
                    html += '<td style=" color:purple;font-weight: 500">' + data[i].statusValue + '</td>';
                }
                else if (data[i].statusValue == "Got Another Offer") {
                    html += '<td style=" color: darkgreen;font-weight: 500"> ' + data[i].statusValue + '</td>';
                }
                else if (data[i].statusValue == "Hold") {
                    html += '<td style="color: orangered;font-weight: 500"> ' + data[i].statusValue + '</td>';
                }

                else {
                    html += '<td>' + data[i].statusValue + '</td>';
                }
            }
            html += '<td><div>';
            if (data[i].comments != null && data[i].comments.Length > 18) {

                html += '  <a href="#" data-tooltip="' + data[i].comments + '"><textarea style=" height: 50px; background:none; border:0px; font-size: 13px!important;width: 100%;resize: none;">' + data[i].comments + '</textarea></a>';
            }
            else {
                html += ' <textarea style=" height: 50px;width: 100%;font-size: 13px!important;resize: none; background:none; border:0px;">' + data[i].comments + '</textarea>';
            }
            html += '</div></td>';

            if ($("#hidhr").val() != "HRs") {
                html += '<td>';
                if (data[i].statusValue == "Meeting Status") {
                    if (!data[i].isReportBlocked && ((data[i].meetingStatus == 4 || data[i].meetingStatus == 6 || data[i].meetingStatus == 7 || data[i].meetingStatus == 8) && (data[i].confirmationStatus == 1))) {
                        if (data[i].redoInterview == true) {
                            html += '<p>No Report</p>';
                        }
                        else {
                            html += '<a class="btn-act" target="_blank" href="/Interview/PublicAddReport?interviewId=' + data[i].interviewId + '&irfId=' + data[i].irfId + '&currentUser=@currentUser&isClient=true&actiontype=Candidate" title="Feedback Report"><svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg></a>';
                            html += '<a class="btn-act btn-act-edit" target="_blank" href="/Interview/ClientReportV2?interviewId=' + data[i].interviewId + '&irfId=' + data[i].irfId + '&currentUser=@currentUser&isClient=true" title="Client Report" style="margin-left:4px;"><svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg></a>';
                        }
                    }
                    else {
                        html += '<p></p>';
                    }
                }
                html += '</td>';
            }
            html += '</tr>';
        }
        $("#divStatusListlink").empty().html(html);
    }
