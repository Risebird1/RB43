        <script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#candidateTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#candidateTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#candidateTable").show();

        }, 2000);
    };


    //// script for loader ends here
        </script>
        <script>
    function searchResult() {
        $('#candidateTable').DataTable();
    }
    function RefreshSearch() {
        $('#candidateTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }
    function ClearCandidateSearch() {
        var $inp = $('#txtcandidate_filter');
        $inp.val('');
        $('#candidate_search_wrap').removeClass('has-value');
        if ($.fn.DataTable.isDataTable('#candidateTable')) {
            $('#candidateTable').DataTable().search('').draw();
        }
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        var table = $('#candidateTable').DataTable({
            order: [],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            fnInitComplete: function () {
                var $wrapper = $('#candidateTable_wrapper');
                var $dtRow = $wrapper.find('.row').has('.dataTables_length').first();
                var $length = $dtRow.find('.dataTables_length');
                if ($length.length) {
                    var $lengthWrap = $('#pcs-dt-length-wrap');
                    if ($lengthWrap.length) {
                        $length.appendTo($lengthWrap);
                    }
                    $dtRow.remove();
                }
                $wrapper.find('.dataTables_filter').addClass('d-none');
                var $headerSearch = $('#txtcandidate_filter');
                $headerSearch.off('input keyup').on('input keyup', function () {
                    var v = this.value;
                    $('#candidate_search_wrap').toggleClass('has-value', v.length > 0);
                    table.search(v).draw();
                });
            }
        });
    };




