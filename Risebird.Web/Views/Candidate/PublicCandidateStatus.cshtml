        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>
<script>
    var candidate = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };

        if (phoneNumber != null && phoneNumber.length >= 9) {
            Twilio.Device.connect(params);
        }
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function ModalButtonClick(candidateName, mobileNumber) {
        candidate = candidateName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(mobileNumber);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    function Sendinvite(id, IRFId, CandidateEmail) {
        $.ajax({
            url: '/Candidate/PublicSendInvite',
            type: 'POST',
            data: { 'irfId': id, 'IRFName': IRFId, 'emailId': CandidateEmail, 'logiduser': $("#hidtxtemailid").val() },
            success: function (data) {
                swal.fire(data);
            }
        });
    }
    function Cancelinvite(id, interviewdate, CandidateEmail, IRFid) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Interview for " + CandidateEmail + " scheduled for date: " + interviewdate + " will be cancelled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel it!',
            cancelButtonText: 'No',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PublicCancelInterview',
                        type: 'POST',
                        data: { 'id': id, 'interviewDate': interviewdate, 'candidateEmail': CandidateEmail, 'emailId': $("#hidtxtemailid").val(), 'IRFId': IRFid },
                        success: function (data) {
                            if (data != null && data.toLowerCase().includes('success')) {
                                resolve(true);
                            }
                            else {
                                swal.fire("Error cancelling!", "Please try again", "error");

                            }

                        },
                        error: function () {

                            swal.fire("Error cancelling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Cancelled!',
                    type: 'success',
                    html: '<p>Interview cancelled successfully.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location.href = "/Candidate/PublicCandidateStatus?emailid=" + $("#hidtxtemailid").val() + "&id=" + $("#hidtxtid").val();
                    //location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Not cancelled',
                    'The Interview has not been cancelled! :)',
                    'error'
                )
            }
        })


    }
    function openSchedulingLinks(emailid) {
        $.ajax({
            url: '/Candidate/FetchSchedulingLinks',
            type: 'POST',
            data: { 'emailid': emailid },
            success: function (data) {
                var modal = document.getElementById("mySchedulingLinkpopup");
                modal.style.display = "block";
                bindschedulingdata(data);
            }
        });
    }
    function FetchInterviewerCommunicator(emailid) {
        window.location.href = "/Candidate/FetchInterviewerCommunicator?emailid=" + emailid + "&id=" + $("#hidtxtid").val();
    }
    function bindschedulingdata(data) {
        var html = '';
        for (var i = 0; i < data.length; i++) {
            html += '<tr><td>' + data[i].irfId + '</td>';
            html += '<td>' + data[i].jdTiltle + '</td>';
            html += '<td><a class="schedule-linktxt" id="calendlyLink_' + i + '" target="_blank" title="Candidate Submission Form Link" href="' + data[i].calendlyLink + '">CSF Link</a>';
            html += '<button class="copy-btn schedule-linkbtn" onclick="copyToClipboard(' + i + ')">';
            html += ' <p class="special-text">';
            html += '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>';
            html += '<span id="special_text_' + i + '" class="special-text__tooltip">';
            html += 'Copy Link';
            html += '</span>';
            html += '</p>';
            html += '</button></td></tr>';
        }
        $("#divschedulinglink").empty().html(html);
    }
    function closemySchedulingLinkpopup() {
        var modal = document.getElementById("mySchedulingLinkpopup");
        modal.style.display = "none";
    }

    function copyToClipboard(elementId) {
        var element = document.getElementById("calendlyLink_" + elementId);
        var href = element.href;
        var temp = $("<input>");
        $("body").append(temp);
        //temp.val($(element).href).select();
        temp.val(href).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text_' + elementId).text('Copied');
    }
    function closemyStatusListpopup() {
        var modal = document.getElementById("myStatusListpopup");
        modal.style.display = "none";
    }
    function PublicStatusList(irfId, candidateId, irfName, candidateName) {
        $("#txtIRFID").text(irfName);
        $("#txtcandidatename").text(candidateName);
        $.ajax({
            url: '/Candidate/PublicStatusList',
            type: 'POST',
            data: { 'irfId': irfId, 'candidateId': candidateId },
            success: function (data) {
                var modal = document.getElementById("myStatusListpopup");
                modal.style.display = "block";
                bindstatusListdata(data.candidateStatusList);
            }
        });
    }
    function bindstatusListdata(data) {
        var html = '';
        for (var i = 0; i < data.length; i++) {
            html += '<tr><td>' + data[i].date.replace("T", " ") + '</td>';
            if (data[i].statusValue == "In Progress") {
                html += '    <td style="color:green;font-weight:500"> ' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "New") {
                html += '<td style="color: dodgerblue;font-weight: 500">' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Waiting For Response") {
                html += '<td style="color: orange;font-weight: 500"> ' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Scheduled") {
                html += '<td style="color: deepskyblue;font-weight: 500">' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Irrelevant") {
                html += '<td style="color:orange"> ' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Duplicate") {
                html += '<td style=" color: hotpink;font-weight: 500">' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Not Interested") {
                html += '<td style=" color:purple;font-weight: 500">' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Got Another Offer") {
                html += '<td style=" color: darkgreen;font-weight: 500"> ' + data[i].statusValue + '</td>';
            }
            else if (data[i].statusValue == "Hold") {
                html += '<td style="color: orangered;font-weight: 500"> ' + data[i].statusValue + '</td>';
            }
            else {
                html += '<td>' + data[i].statusValue + '</td>';
            }
            html += '<td><div>';
            if (data[i].comments != null && data[i].comments.Length > 18) {

                html += '  <a href="#" data-tooltip="' + data[i].comments + '"><textarea style=" height: 50px;border: 0px; font-size: 14px;width: 100%;resize: none;">' + data[i].comments + '</textarea></a>';
            }
            else {
                html += ' <textarea style=" height: 50px;width: 100%;font-size: 14px;resize: none;">' + data[i].comments + '</textarea>';
            }
            html += '</div></td>';
            html += '<td>';
            if (data[i].statusValue == "Meeting Status") {
                if (!data[i].isReportBlocked && ((data[i].meetingStatus == 4 || data[i].meetingStatus == 6 || data[i].meetingStatus == 7 || data[i].meetingStatus == 8) && (data[i].confirmationStatus == 1))) {
                    html += '<a target="_blank" href="/Interview/PublicAddReport?interviewId= ' + data[i].interviewId + '&irfId=' + data[i].irfId + '&currentUser=' + '@currentUser' + '&isClient=true&actiontype=Candidate" title="Feedback Report">';
                    html += '<button class="mdc-fab app-fab--absolute" aria-label="Feedback Report">';
                    html += '<span title="Feedback Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>';
                    html += '</button></a>';
                    html += '<a target="_blank" href="/Interview/ClientReport?interviewId= ' + data[i].interviewId + '&irfId=' + data[i].irfId + '&currentUser=' + '@currentUser' + '&isClient=true">';
                    html += '<button class="mdc-fab app-fab--absolute" aria - label="Client Interview Report" >';
                    html += '<span title="Client Interview Report" class="mdc-fab__icon material-icons" > <svg xmlns="http://www.w3.org/2000/svg" width = "16" height = "16" fill = "currentColor" class="bi bi-file-earmark-ruled" viewBox = "0 0 16 16" > <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /> </svg></span>';
                    html += '</button></a>';
                }
                else {
                    html += '<p></p>';
                }
            }
            html += '</td></tr>';
        }
        $("#divStatusListlink").empty().html(html);
    }
