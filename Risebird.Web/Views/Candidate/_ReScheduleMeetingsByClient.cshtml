@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;
    ViewData["Title"] = "Reschedule Meetings ";
}
<script>
    var Header = "<div>Reschedule Meetings</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<style>
    /* Reschedule tab: match Future Schedule tab (font-size, alignment, action buttons) - applied for both #reschedule_table and #notschedule_table */
    #reschedule_table #meeting,
    #notschedule_table #meeting {
        font-family: 'Roboto', sans-serif;
        font-size: 12px;
        border-collapse: collapse;
    }
    #reschedule_table #meeting thead th,
    #notschedule_table #meeting thead th {
        font-size: 11px;
        font-weight: 700;
        color: #475569;
        background: #f1f5f9;
        border-bottom: 2px solid #cbd5e1;
        white-space: nowrap;
        padding: 7px 10px;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        text-align: left;
    }
    #reschedule_table #meeting thead th:last-child,
    #notschedule_table #meeting thead th:last-child {
        text-align: center;
    }
    #reschedule_table #meeting tbody td,
    #notschedule_table #meeting tbody td {
        font-size: 11.5px;
        color: #334155;
        vertical-align: middle;
        padding: 5px 10px;
        border-color: #f1f5f9;
        line-height: 1.35;
    }
    #reschedule_table #meeting tbody tr:hover td,
    #notschedule_table #meeting tbody tr:hover td {
        background-color: #f8fafc !important;
    }
    #reschedule_table #meeting tbody td p,
    #notschedule_table #meeting tbody td p {
        margin: 0;
        padding: 0;
        line-height: 1.3;
    }
    #reschedule_table #meeting .candidate-details .name-field,
    #notschedule_table #meeting .candidate-details .name-field {
        font-size: 12.5px;
        font-weight: 600;
        color: #1e3a5f;
        font-family: 'Roboto', sans-serif;
        margin: 0;
        line-height: 1.35;
    }
    #reschedule_table #meeting .candidate-details .pskill,
    #notschedule_table #meeting .candidate-details .pskill,
    #reschedule_table #meeting .candidate-details .cadEmail a,
    #notschedule_table #meeting .candidate-details .cadEmail a,
    #reschedule_table #meeting .candidate-details .hrname,
    #notschedule_table #meeting .candidate-details .hrname,
    #reschedule_table #meeting .candidate-details .hremail,
    #notschedule_table #meeting .candidate-details .hremail {
        font-size: 10.5px;
        color: #64748b;
        font-family: 'Roboto', sans-serif;
    }
    #reschedule_table #meeting .candidate-details .clearfix,
    #notschedule_table #meeting .candidate-details .clearfix {
        font-size: 11px;
        color: #334155;
        line-height: 1.35;
    }
    #reschedule_table #meeting td.candidate-details,
    #notschedule_table #meeting td.candidate-details {
        padding-top: 5px !important;
        vertical-align: middle;
        text-align: left;
    }
    #reschedule_table #meeting .candidate-hr,
    #notschedule_table #meeting .candidate-hr {
        font-size: 11.5px;
        color: #334155;
        font-family: 'Roboto', sans-serif;
    }
    #reschedule_table #meeting .status,
    #notschedule_table #meeting .status {
        font-size: 10.5px;
        padding: 1px 5px;
        border-radius: 3px;
        font-weight: 600;
        display: inline-block;
        font-family: 'Roboto', sans-serif;
    }
    #reschedule_table #meeting td.action-cell.act-btns,
    #notschedule_table #meeting td.action-cell.act-btns {
        text-align: center;
        min-width: 90px;
        display: flex !important;
        flex-wrap: wrap;
        gap: 4px;
        justify-content: center;
        align-items: center;
        padding: 4px 6px !important;
    }
    #reschedule_table .action-cell.act-btns,
    #notschedule_table .action-cell.act-btns {
        display: flex !important;
        flex-wrap: wrap;
        gap: 4px;
        justify-content: center;
        align-items: center;
        padding: 4px 6px !important;
    }
    #reschedule_table .btn-act.btn-act-cold,
    #notschedule_table .btn-act.btn-act-cold {
        background: #fef3c7;
        color: #d97706;
    }
    #reschedule_table .btn-act.btn-act-cold:hover,
    #notschedule_table .btn-act.btn-act-cold:hover {
        background: #fde68a;
        color: #b45309;
    }
    #reschedule_table #meeting_wrapper .row:has(.dataTables_length),
    #notschedule_table #meeting_wrapper .row:has(.dataTables_filter) {
        display: none !important;
    }
</style>
@if (ViewBag.ClientRole == ClientRoleEnum.RestrictedIRFowner.GetDescription())
{
<div id="reschedule_table" data-intro="<span style='font-size:16px;'>Overview the summary of ReScheduled Meeting details:</span><hr class='btop' />1. Jd Title<br/> 2. Candidate Details (Name, Email, Skill Channel Id) <br/> 3. Resume <br/>4. Client HR  <br/>5. Click on Schedule Meeting button to schedule meeting & Call button to Call the Candidate.<br/><a id='toggleHelp' href='javascript:void;' class='btn btn-primary staffclose-btn'>CLOSE</a>" data-position="top">
        <div class="dataloading">
            <div class="toolbar">
                <div id="tableID">
                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <div class="row pcs-dt-toolbar align-items-center mb-2">
                            <div class="pcs-dt-toolbar-right d-flex flex-nowrap align-items-center gap-3">
                                <div class="pcs-dt-length-wrap" id="reschedule-dt-length-wrap"></div>
                                <div id="reschedule_search_wrap" class="interviewer-search-wrap flex-shrink-0">
                                    <div class="interviewer-search-box">
                                        <span class="interviewer-search-ico" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                                        </span>
                                        <input type="search" class="interviewer-search-inp" id="txtreschedule_filter" placeholder="Search reschedule..." autocomplete="off" />
                                        <button type="button" class="interviewer-search-reset" onclick="ClearRescheduleSearch()" title="Clear search" aria-label="Clear search">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"></div>
                        <div class="col-sm-12 nopad">
                            <div class="table-responsive int-table">
                                <div class="notschedulemeeting">
                                    <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th id='start'>Interview Date</th>
                                                <th style="text-align:left;">Candidate Details</th>
                                                <th>Status</th>
                                                @*<th style="border-left: 0px !important;">JD Title</th>*@
                                                @* <th>Resume</th>*@
                                                <th>Client HR</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th id='start'>Interview Date</th>
                                                <th>Candidate Detail</th>
                                                <th>Status</th>
                                                @*<th style="border-left: 0px !important;">JD Title</th>*@

                                                @* <th>Resume</th>*@
                                                <th class="candidate-hr">Client HR</th>
                                                <th>Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            @foreach (var item in Model)
                                            {
                                                <tr data-changes="1">
                                                    <td>@item.IRFId</td>
                                                    <td>@item.dtCreatedOn</td>
                                                    <td class="candidate-details">
                                                        <div class="clearfix" style="display:block;margin:0px auto">
                                                            @if (item.candidateName != null && item.candidateName != "")
                                                            {
                                                                <div class="mtop-5 name-field">@item.candidateName </div>

                                                            }
                                                            @if (item.JDTiltle != null && item.JDTiltle != "")
                                                            {

                                                                @if (item.JDTiltle.Length > 22)
                                                                {
                                                                    <div class="cadEmail pull-left">
                                                                        <a style="position:relative;top:-7px;" class="pskill" data-tooltip="@item.JDTiltle">( @item.JDTiltle.Substring(0, 22) ...)</a>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="pull-left">
                                                                        <a style="position:relative;top:-7px;" class="pskill">(@item.JDTiltle)</a>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div></div>
                                                            }

                                                        </div>
                                                        <div class="clearfix">
                                                            <span class="call-area">
                                                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                {
                                                                    @* <span data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CommonCallButtonClick('@item.candidateName', '@item.MobileNumber','@item.candidateEmail', null, '@item.IRFId', 'Candidate')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="15" height="15" /></span> *@
                                                                    <span class="call" data-toggle="tooltip" data-placement="top" onclick="ModalButtonClick('@item.candidateName', '@item.MobileNumber')" data-original-title="Tooltip on top"><span style=" cursor:pointer; " title="Click here to call the candidate."><img src="/img/calling.png" width="18"></span>@item.MobileNumber</span>

                                                                }
                                                            </span>
                                                            @item.MobileNumber

                                                        </div>
                                                        <div class="clearfix">
                                                            @if (item.candidateEmail != null && item.candidateEmail != "")
                                                            {
                                                                @if (item.candidateEmail.Length > 10)
                                                                {
                                                                    <a onclick="" data-tooltip="@item.candidateEmail">
                                                                        <span class="hrname hremail" style="margin-bottom: 6px;"><i class="fa fa-envelope" style="color:#ffa000bd;font-size:15px;position:relative;top:2px;"></i> @item.candidateEmail</span>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <a onclick=""> @item.candidateEmail </a>
                                                                }
                                                            }
                                                        </div>
                                                        <div class="clearfix">
                                                            Aging Details: @item.interviewtimedifference Day(s)
                                                        </div>
                                                    </td>



                                                    @if (item.MeetingStatusStatusDesc == "Status Pending")
                                                    {
                                                        <td>
                                                            <span class="status mpending" style="display:inline-block">@item.MeetingStatusStatusDesc</span>
                                                        </td>
                                                    }
                                                    else if (item.MeetingStatusStatusDesc == "Completed")
                                                    {

                                                        <td>
                                                            <span class="status mcomplete">@item.MeetingStatusStatusDesc</span>
                                                        </td>
                                                    }
                                                    else if (item.confirmationStatus == "2")
                                                    {

                                                        <td>
                                                            <span class="status mcancel" style="display:inline-block">Cancelled</span>
                                                        </td>
                                                    }

                                                    else if (item.MeetingStatusStatusDesc == "Dropped")
                                                    {

                                                        <td>
                                                            <span class="status mdropped" style="display:inline-block">@item.MeetingStatusStatusDesc</span>
                                                        </td>
                                                    }
                                                    else if (item.MeetingStatusStatusDesc == "No Show(Candidate)")
                                                    {

                                                        <td>
                                                            <span class="status mnoshow" style="display:inline-block">@item.MeetingStatusStatusDesc</span>
                                                        </td>
                                                    }

                                                    else if (item.MeetingStatusStatusDesc == "No Show(Interviewer)")
                                                    {

                                                        <td>
                                                            <span class="status mnoshow-int" style="display:inline-block">@item.MeetingStatusStatusDesc</span>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td> <span class="status mdropped" style="display:inline-block">@item.MeetingStatusStatusDesc</span></td>

                                                    }

                                                    @* <td class="candidate-details">
                                            @if (item.JDTiltle != null && item.JDTiltle != "")
                                            {
                                            <div class="mtop-5">@item.JDTiltle</div>
                                            }
                                            </td>*@

                                                    @* @if (!string.IsNullOrEmpty(item.resumeLink))
                                            {
                                            <td><a target="_blank" href=@item.resumeLink><img style="position:relative;left:-1px;" src="/img/resume-icon.png" width="21"> Resume</a></td>
                                            }
                                            else
                                            {
                                            <td></td>
                                            }*@
                                                    <td class="candidate-hr">
                                                        @if (item.ClientHrContact != null && item.ClientHrContact != "")
                                                        {
                                                            @if (item.ClientHrContact.Length > 13)
                                                            {
                                                                <a onclick="" data-tooltip="@item.ClientHrContact"><span class="hrname"> @item.ClientHrContact</span> </a>
                                                            }
                                                            else
                                                            {
                                                                <a onclick=""> @item.ClientHrContact </a>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="text-center action-cell act-btns">
                                                        <a class="btn-act" target="_blank" href="@Url.Action("CandidateScheduleEvent", "InterviewScheduler", new { id = item.CalendlyLink.Split("=").LastOrDefault(), CandidateEmail = item.candidateEmail })" title="Schedule Meeting">
                                                            <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                                                        </a>
                                                        <button type="button" class="btn-act" title="Send Invite" onclick="Sendinvite(@item.imid,'@item.IRFId','@item.candidateEmail')">
                                                            <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                                                        </button>
                                                        <button type="button" class="btn-act" title="Candidate Status" onclick="PublicStatusList('@item.imid','@item.CandidateMasterId', '@item.IRFId','@item.candidateName')">
                                                            <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}
