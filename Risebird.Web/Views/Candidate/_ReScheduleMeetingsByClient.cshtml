<script>
    function Sendinvite(id, IRFId, CandidateEmail) {
        $.ajax({
            url: '/Client/SendInviteForClient',
            type: 'POST',
            data: { 'irfId': id, 'IRFName': IRFId, 'emailId': CandidateEmail },
            success: function (data) {
                swal.fire(data);
            }
        });
    }
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function ClearRescheduleSearch() {
        var $inp = $('#txtreschedule_filter');
        if ($inp.length) {
            $inp.val('');
            $('#reschedule_search_wrap').removeClass('has-value');
            var table = $('#meeting').DataTable();
            if (table) table.search('').draw();
        }
    }

    function applyDataTable() {
        var table = $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                var $wrapper = $('#meeting_wrapper');
                var $lengthWrap = $('#reschedule-dt-length-wrap');
                /* Move length into our toolbar and remove the default DataTables row so we don't get two "sorting" controls */
                var $dtRow = $wrapper.find('.row').has('.dataTables_length').first();
                var $length = $dtRow.length ? $dtRow.find('.dataTables_length') : $wrapper.find('.dataTables_length');
                if ($length.length && $lengthWrap.length) {
                    $lengthWrap.empty().append($length);
                    if ($dtRow.length) $dtRow.remove();
                }
                var $filter = $wrapper.find('.dataTables_filter');
                if ($filter.length) $filter.addClass('d-none');
                var $searchWrap = $('#reschedule_search_wrap');
                var $searchInp = $('#txtreschedule_filter');
                if ($searchInp.length) {
                    $searchInp.off('input keyup').on('input keyup', function () {
                        var v = $(this).val();
                        if (v && v.length) $searchWrap.addClass('has-value'); else $searchWrap.removeClass('has-value');
                        table.search(v).draw();
                    });
                }
                $searchWrap.find('.interviewer-search-reset').off('click').on('click', function () { ClearRescheduleSearch(); });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>


<script>
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>

<script>



    $('#meeting tbody').on('click', 'td.detail-control', function () {
        var tr = $(this).closest('tr');
        var row = table.row(tr);
        if (row.child.isShown()) {
            // This row is already open - close it
            row.child.hide();
            tr.removeClass('show');
        }
        else {
            // Open this row
            row.child(format(row.data())).show();
            tr.addClass('show');
        }
    });


</script>
