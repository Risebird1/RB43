                                                                <a onclick="" data-tooltip="@item.ClientHrContact"><span class="hrname"> @item.ClientHrContact</span> </a>
                                                            }
                                                            else
                                                            {
                                                                <a onclick=""> @item.ClientHrContact </a>
                                                            }
                                                        }
                                                    </td>
                                                    @* <td>@item.ChannelOwner</td>*@

                                                    <td class="text-center action-cell act-btns">
                                                        @if (ViewBag.ClientRole != ClientRoleEnum.RestrictedIRFowner.GetDescription())
                                                        {
                                                            <a class="btn-act" target="_blank" href="@Url.Action("CandidateScheduleEvent", "InterviewScheduler", new { id = item.CalendlyLink.Split("=").LastOrDefault(), CandidateEmail = item.candidateEmail })" title="Schedule Meeting">
                                                                <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                                                            </a>
                                                        }
                                                        <button type="button" class="btn-act" title="Send Invite" onclick="Sendinvite(@item.imid,'@item.IRFId','@item.candidateEmail')">
                                                            <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                                                        </button>
                                                        <button type="button" class="btn-act btn-act-cold" title="Mark Cold Candidate" onclick="MarkedColdCandidateForClient('@item.CandidateId','@item.IRFId', '@item.candidateEmail','@item.Interviewid','@item.imid','@ViewBag.ClientEmail',2);">
                                                            <img class="icon-m icon-img" src="~/img/approve-blk.png" alt="Cold"/>
                                                        </button>
                                                        <button type="button" class="btn-act" title="Candidate Status" onclick="PublicStatusList('@item.imid','@item.CandidateMasterId', '@item.IRFId','@item.candidateName')">
                                                            <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}
