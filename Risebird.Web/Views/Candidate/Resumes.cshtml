@model Risebird.Entities.ViewModel.ResumeListViewModel
@{
    ViewData["Title"] = "Candidate Resume List";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "Resume(s) for <strong>@(Model.IRFName)</strong>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Resume(s) for <strong>@(Model.IRFName)</strong></h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @if (ViewBag.backbutton)
                        {
                            @if (Model.Profile == "Admin" || Model.Profile == "HR" || Model.Profile == "Client" || Model.Profile == "SeniorHR")
                            {
                                <span class="interview_2"> <i type="submit" class="far fa-file-excel excel-file card-title-space " data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("CandidateResumesExporttoExcel", "Candidate",  new { irfId = Model.IRFId, irfName = Model.IRFName })'" style=" position: relative; top: 10px; }"></i></span>
                                @*@Html.ActionLink("Upload Resume(s)", "UploadResumes", "Candidate", new { irfId = Model.IRFId, irfName = Model.IRFName }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })*@
                                <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#uploadResumesModal">
                                    <span class="mdc-button__label"><span class="fa fa-file" data-toggle="tooltip" data-placement="top" title="Upload Resume(s)" data-original-title="Upload Resume(s)"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Upload Resume(s)</font></span></span>
                                    <div class="mdc-button__ripple"></div>
                                </button>
                            }
                            @Html.ActionLink("Back", "GetCandidates", "Candidate", new { id = Model.IRFId, irfName = Model.IRFName }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="modal fade" id="uploadResumesModal" tabindex="-1" role="dialog" aria-labelledby="UploadResumesModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="upload_resume">
                                            <div class="uploadavatar">
                                                <span class="fa fa-upload"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="UploadResumesModalLabel"> Upload Resume(s)</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="/Candidate/UploadResumes" multiple enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form" onsubmit="return CheckIfFileSelected()">
                                            @Html.AntiForgeryToken()
                                            <div class="canvas_div_pdf">
                                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                <div>
                                                    @*<div class="col-md-6 col-sm-6">
                                                            <div class="form-group" style="margin-bottom:10px;">
                                                                @Html.LabelFor(model => model.CandidateName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                                @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })

                                                            </div>
                                                        </div>*@
                                                    @*<div class="col-md-6 col-sm-6">
                                                            <div class="form-group" style="margin-bottom:10px;">
                                                                @Html.LabelFor(model => model.IRFName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                                @Html.TextBoxFor(m => m.IRFName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                            </div>
                                                        </div>*@
                                                    <div class="col-md-12 col-sm-12">
                                                        <div class="form-group">
                                                            <label asp-for="ResumeFiles" class="form-label"></label>
                                                            <div class="col-sm-12">
                                                                <div class="custom-file">
                                                                    <input asp-for="ResumeFiles" multiple class="form-control custom-file-input" accept=".pdf, .docx, .doc">
                                                                    <label class="custom-file-label">Choose File(s)...</label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>



                                                <div asp-validation-summary="All" class="text-danger"></div>



                                                @Html.HiddenFor(m => m.IRFId)
                                                @Html.HiddenFor(m => m.IRFName)

                                                <div class="card-footer ">
                                                    <div class="row">

                                                        <div class="col-md-12 mc-button-area text-right">


                                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save">Upload</button>


                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </form>

                                    </div>
                                </div>

                            </div>

                            <div class="candidate_resume">

                                <div id="tableID">
                                    <table id="resumeTable" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>

                                                <th>Date</th>
                                                <th>File Name</th>
                                                <th class="text-center">Actions</th>

                                            </tr>
                                        </thead>
                                        <tfoot>

                                            <tr>
                                                <th>Date</th>
                                                <th>File Name</th>
                                                <th class="text-center">Actions</th>
                                            </tr>

                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model.ResumeList)
                                            {
                                                <tr id=@item.id>

                                                    <td> @item.AddedOn</td>

                                                    <td>
                                                        @{
                                                            var fileName = string.Empty;
                                                            if (item.ResumeLink.Split('/')?.Last().Split('?') != null)
                                                            {
                                                                fileName = item.ResumeLink.Split('/')?.Last().Split('?')?.First();
                                                            }
                                                            else
                                                            {
                                                                fileName = item.ResumeLink.Split('/')?.Last();

                                                            }
                                                        }
                                                        <a id="resumeLink_@item.id" target="_blank" title="Resume" href=@item.ResumeLink.ToString().Replace(" ","%20")>@fileName</a>
                                                        <button class="copy-btn" onclick="copyToClipboard('resumeLink_@item.id', 'special_text_@item.id')">
                                                            <p class="special-text">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                                                <span id="special_text_@item.id" class="special-text__tooltip">
                                                                    Copy Link
                                                                </span>
                                                            </p>
                                                        </button>
                                                    </td>



                                                    <td class="text-center action">

                                                        @if (Model.Profile == "Admin" || Model.Profile == "HR" || Model.Profile == "SeniorHR" || Model.Profile == "Client")
                                                        {
                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                                <span onclick="javascript:Delete('@item.id', '@fileName');" title="Delete" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg>
                                                                </span>
                                                            </button>
                                                        }
                                                        @if (Model.Profile == "Admin" || Model.Profile == "HR" || Model.Profile == "Client"|| Model.Profile == "SeniorHR")
                                                        {
                                                            @if (!item.IsProcessed)
                                                            {
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Processed">
                                                                    <span onclick="javascript:Processed('@item.id', '@fileName');" title="Processed" class="mdc-fab__icon material-icons">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cpu-fill" viewBox="0 0 16 16">
                                                                            <path d="M6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z" />
                                                                            <path d="M5.5.5a.5.5 0 0 0-1 0V2A2.5 2.5 0 0 0 2 4.5H.5a.5.5 0 0 0 0 1H2v1H.5a.5.5 0 0 0 0 1H2v1H.5a.5.5 0 0 0 0 1H2v1H.5a.5.5 0 0 0 0 1H2A2.5 2.5 0 0 0 4.5 14v1.5a.5.5 0 0 0 1 0V14h1v1.5a.5.5 0 0 0 1 0V14h1v1.5a.5.5 0 0 0 1 0V14h1v1.5a.5.5 0 0 0 1 0V14a2.5 2.5 0 0 0 2.5-2.5h1.5a.5.5 0 0 0 0-1H14v-1h1.5a.5.5 0 0 0 0-1H14v-1h1.5a.5.5 0 0 0 0-1H14v-1h1.5a.5.5 0 0 0 0-1H14A2.5 2.5 0 0 0 11.5 2V.5a.5.5 0 0 0-1 0V2h-1V.5a.5.5 0 0 0-1 0V2h-1V.5a.5.5 0 0 0-1 0V2h-1V.5zm1 4.5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5v-3A1.5 1.5 0 0 1 6.5 5z" />
                                                                        </svg>
                                                                    </span>
                                                                </button>
                                                            }
                                                        }

                                                    </td>

                                                </tr>


                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>



        <!-- end row -->
    </div>

</div>



@if (Model.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@Model.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("successful",'@Model.Message', "success");
            }
            else {
                swal.fire("Failed", '@Model.Message', "error");
            }

        }

    </script>
}
<script>
    function SetUploadInputFileName() {
        $('.custom-file-input').on("change", function () {
            var fileLabel = $(this).next('.custom-file-label');
            var files = $(this)[0].files;
            if (files.length > 1) {
                fileLabel.html(files.length + ' files selected');
            }
            else if (files.length == 1) {
                fileLabel.html(files[0].name);
            }
        });
    }

    function CheckIfFileSelected() {
        var files = document.getElementById("ResumeFiles").value;
        if (files == null || files == "") {
            swal.fire("Error!", "Kindly select atleast one file to upload!", "error");
            return false;
        }
        return true;
    }

</script>
<script>

    function RefreshSearch() {
        $('#resumeTable').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();
        SetUploadInputFileName();

    });

    function applyDataTable() {
        $('#resumeTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }



</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#resumeTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#resumeTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#resumeTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>




<script>
    function Delete(id, fileName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The resume (" + fileName + ") will be deleted permanently!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/DeleteResume',
                        method: 'POST',
                        data: { 'id': id },
                        success: function (result) {
                            if (result) {
                                resolve(result)

                            }
                            else {
                                swal.fire("Error deleting!", "Please try again", "error");

                            }
                        },
                        error: function () {
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The resume has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Delete cancelled!',
                    'error'
                )
            }
        })
    }
    function Processed(id, fileName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The resume (" + fileName + ") will be processed!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Process it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/ProcessingResume',
                        method: 'POST',
                        data: { 'id': id },
                        success: function (result) {
                            if (result) {
                                resolve(result)
                            }
                            else {
                                swal.fire("Error Processing!", "Please try again", "error");
                            }
                        },
                        error: function () {
                            swal.fire("Error Processing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Processed!',
                    type: 'success',
                    html: '<p>The resume has been processed.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Processing cancelled!',
                    'error'
                )
            }
        })
    }
</script>
<script>
    function copyToClipboard(elementId, indicatorId) {
        var element = document.getElementById(elementId);
        var href = element.href;
        var temp = $("<input>");
        $("body").append(temp);
        //temp.val($(element).href).select();
        temp.val(href).select();
        document.execCommand("copy");
        temp.remove();
        $('#' + indicatorId).text('Copied');
    }
</script>


