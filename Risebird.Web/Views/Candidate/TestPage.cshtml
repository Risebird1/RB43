@model Risebird.Entities.ViewModel.CandidateIRFDetailsVM
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Http;
@using Risebird.Entities.Enum
@using Microsoft.Extensions.Configuration;
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration configuration

@{
    ViewData["Title"] = "Skill Channel Details";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}
<style>
    body {
        font-size: 1.3vw !important;
        /*background: linear-gradient(to left, rgb(91, 161, 227), rgb(81, 228, 86)) !important;*/
        background: linear-gradient(to left, rgb(7 74 138 / 76%), rgb(92 228 81 / 0%)) !important;
    }

    .main-panel {
        background: transparent !important;
    }

    .tab {
        padding-top: 80px;
        float: left;
        background: transparent;
        width: 25%;
    }

        .tab button {
            display: block;
            /*background-color: inherit;*/
            color: white;
            padding: 22px 16px;
            width: 100%;
            border: none;
            outline: none;
            text-align: left;
            cursor: pointer;
            transition: 0.3s;
            /*background-color: #6aab7d;*/
            /*background-color: #6aab7d54;*/
            background-color: #2a5788;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
                border-radius: 10px;
                font-weight: bold;
            }

            /* Create an active/current "tab button" class */
            .tab button.active {
                /*background-color: #a7e8ba;*/
                background-color: #2e71ba;
                border-radius: 10px;
            }

        .tab .arrow {
            /*color: #a7e8ba;*/
            color: #2e71ba;
            float: right;
            font-size: 26px;
            position: relative;
            left: 25px;
        }
    /* Style the tab content */
    .tabcontent {
        float: left;
        padding: 20px;
        width: 75%;
        border-left: none;
    }

    .triangle-right {
        width: 0;
        height: 0;
        border-top: 25px solid transparent;
        border-left: 50px solid #555;
        border-bottom: 25px solid transparent;
    }

    .interviewresponsebtn {
        text-decoration: none;
        padding: 10px 20px;
        position: relative;
        clear: both;
        border-radius: 3px;
        /*font-size: 1.2vw;*/
        color: #fff;
    }

    .fix {
        position: fixed;
        bottom: 0px;
        /*left: 50%;*/
        width: 22%;
        margin-left: 1%;
    }
</style>
<img class="fix" src="~/img/candidateportal/interview.png" />
<input type="text" hidden id="hidtxtid" value="@ViewBag.Id" />
<input type="text" hidden id="hidtxtIRFid" value=@Model.CandidateDetails.IRFId />
<input type="text" hidden id="txtMailstatus" value="@ViewBag.PageType" />

<div class="main-panel" id="main-panel">

    <div class="loader text-center">
        <img src="~/Newassets/img/lazyload.gif" />
    </div>
    <div id="PublicShareMail" class="modal modal-bg">
        @if (ViewBag.PageType == "Public")
        {
            <div class="blk-bg"></div>
        }
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="filheader">
                    <div class="filavatar">
                        <span><svg class="publicsharing-icon" width="25" height="25" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z" /></svg></span>
                    </div>
                    <h5 class="modal-title pull-left">Your Email Id</h5>
                </div>
                <div class="modal-body">
                    <div class="col-md-12">
                        <label class="label-field desp-label col-md-12" for="Please Enter Your Email"> Please Enter Email</label>
                        <div class="text-areadiv">
                            <input type="text" id="txtcandidateEmailid" class="form-control" />
                        </div>
                        <div class="mt-10 text-right">

                            <input type="button" onclick="SubmitEmail()" id="btnSubmit" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" value="Submit">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div style="height:20%">
        <div class="container">
            <div class="row">
                <div class="col-sm-12" style="text-align:center" height="50%">
                    @if (string.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("LogoSet")))
                    {
                        <img style="max-height:80px" class="img-responsive" src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" />
                    }
                    else
                    {
                        <img style="max-height:80px" class="img-responsive" src="@HttpContextAccessor.HttpContext.Session.GetString("LogoSet")" />
                    }
                </div>
            </div>
            <div class="tab">
                <button class="tablinks" onclick="openCity(event, 'Employer','arrow1')" id="defaultOpen">
                    Know Your Employer<span id="arrow1" class="arrow fas fa-caret-right"></span>
                </button>
                <button class="tablinks" onclick="openCity(event, 'Interviews','arrow2')">
                    Interviews details<span id="arrow2" class="arrow fas fa-caret-right"></span>
                </button>
                <button class="tablinks" onclick="openCity(event, 'Conditions','arrow3')">
                    Do/Don't<span id="arrow3" class="arrow fas fa-caret-right"></span>
                </button>
            </div>
            <div>
                <div id="Employer" class="tabcontent">
                    <p>Company Website : <a href="@Model.CandidateDetails.CompanyLink" target="_blank">@Model.CandidateDetails.ClientName</a></p>
                    <p>Job Description : <a href="@Model.CandidateDetails.JDLink" target="_blank">@Model.CandidateDetails.JDTiltle</a></p>
                    <p>Primary Skill : @Model.CandidateDetails.PrimarySkillInvite</p>
                    <p>HR Contact : @Model.CandidateDetails.ClientHRAttemptContact</p>
                    @if (!String.IsNullOrWhiteSpace(Model.CandidateDetails.CompanyVideoLink))
                    {
                        <div style="max-width:auto">
                            <video data-position='top' id="risetubevideo_3" controls class="vjs-tech video-width" controlsList="nodownload" autoplay>
                                <source src="@Model.CandidateDetails.CompanyVideoLink" type="video/mp4" autoplay>
                                <source src="@Model.CandidateDetails.CompanyVideoLink" type="video/mp4">
                            </video>
                        </div>
                    }
                </div>
                <div id="Interviews" class="tabcontent">
                    @foreach (var item in Model.Meetings)
                    {
                        @if (item.interviewDate >= DateTime.Now)
                        {
                            <p style="text-decoration:underline;color:black">Upcoming Interview</p>
                            <p></p>
                            <p>@item.interviewDate &nbsp; <a href="@item.zoomLink" target="_blank">Meeting Link</a></p>
                            <p>
                                @if (item.confirmationStatus == "Confirmed")
                                {
                                    <div class="row" style="text-align: center;">
                                        <div class="col-md-3 col-lg-3 col-sm-12" style="padding-left:0px;padding-right:0px;margin-bottom: 20px;">
                                            <a class="interviewresponsebtn" style="background:#289f28;" target="_blank" href='@Url.Action("CandidateMeetingsStatus", "Interview", new { meetingid = item.Interviewid,status=1,uniqueid="",Irfid=Model.CandidateDetails.IRFId,candidateId="" })'>Yes! Im Available</a>
                                        </div>
                                        <div class="col-md-3 col-lg-3 col-sm-12" style="padding-left:0px;padding-right:0px;margin-bottom: 20px;">
                                            <a class="interviewresponsebtn" style="background:#cd362b;" href={4}>Reschedule</a>
                                        </div>
                                        <div class="col-md-3 col-lg-3 col-sm-12" style="padding-left:0px;padding-right:0px;margin-bottom: 20px;">
                                            <a class="interviewresponsebtn" style="background:#cd362b;" href={3}>No! I am not Available</a>
                                        </div>
                                        <div class="col-md-3 col-lg-3 col-sm-12" style="padding-left:0px;padding-right:0px;margin-bottom: 20px;">
                                            <a class="interviewresponsebtn" style="background:#cd362b;" href={5}>Need More clarity</a>
                                        </div>
                                    </div>
                                }
                            </p>
                        }
                        else
                        {
                            <p style="text-decoration:underline;color:black">Completed Interview</p>
                            <p></p>
                            @if (item.confirmationStatus == "Cancelled")
                            {
                                <p>@item.interviewDate &nbsp; <d style="color:red">Cancelled</d></p>
                            }
                            else
                            {
                                <p>@item.interviewDate &nbsp; <b>@item.MeetingStatusStatusDesc</b></p>
                            }
                            <p></p>
                        }
                    }
                </div>
                <div id="Conditions" class="tabcontent">
                    <ul>
                        <li>I confirm and authorize Risebird, (Arhat Talent Solutions Private Limited) and its partners and customers to use my ID proof data for verifying my identity to appear for an interview.</li>
                        <li>I am aware and agree that this interview will be recorded and will be shared only with my employer in fully secured and encrypted format. It will be permanently deleted from all records in 2-3 weeks’ time.</li>
                        <li>I am also aware that if I feel my interview is not up to the mark, I cancel my candidature anytime during or after the interview. My recordings will be deleted immediately.</li>
                        <li>I agree that my voice signature shall be used for authenticating my profile at the time of interview and on-boarding (if I get selected).</li>
                        <li>I will ensure that my webcam will be switched on and audio settings is done before the start of the meeting. I will not use Audio Splitter or speaker for voice communication.</li>
                        <li>I will not appear for the interview using mobile or tablet.</li>
                        <li>I will ensure to use Chrome (preferably) and download zoom plugin. I will join the meeting by clicking on the meeting link using my laptop.</li>
                        <li>I will share my desktop during the interview and will have my desktop and browser clean and close all the apps before the start of the interview.</li>
                        <li>I will not be late for my scheduled interview, and will join 5 minutes before time.</li>
                        <li>I will ensure that I will be in the silent place where there is no background noise and with appropriate light during the interview. If required I will choose a clean uncluttered background.</li>
                        <li>I am aware that this will be a hands-on interview, so I will have the editor open.</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>



</div>

<script>
    $(document).ready(function () {
        if ($("#txtMailstatus").val() == "Public") {
            var modal = document.getElementById("PublicShareMail");
            modal.style.display = "block";
        }
    });
    function SubmitEmail() {
        if ($("#txtcandidateEmailid").val().trim() != "") {
            localStorage.setItem('PublicEmailid', $("#txtcandidateEmailid").val());
            $.ajax({
                type: "POST",
                url: "/Candidate/CandidatePublicdetails",
                data: { id: $("#hidtxtid").val(), Emailid: $("#txtcandidateEmailid").val().trim(), irfId: $("#hidtxtIRFid").val() },
                success: function (data) {
                    if (data == "success") {
                        window.location = "/Candidate/VerifiedTestPage?emailid=" + $("#txtcandidateEmailid").val() + "&id=" + $("#hidtxtid").val() + "&IRFid=" + $("#hidtxtIRFid").val();
                    } else {
                        swal.fire(data);
                    }
                }
            });
        }
    }
</script>
<script>
    function openCity(evt, tabid, arrowsid) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tabArrow = document.getElementsByClassName("arrow");
        for (i = 0; i < tabArrow.length; i++) {
            tabArrow[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(tabid).style.display = "block";
        document.getElementById(arrowsid).style.display = "block";
        evt.currentTarget.className += " active";
    }
    document.getElementById("defaultOpen").click();
</script>
