@model Risebird.Entities.ViewModel.CandidateStatusListVM
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />
    <div id="style-2" class="scrollers" style="overflow-y:auto">

        <div id="tableID">
            <table id="statusTable" class="table table-striped table-bordered" cellspacing="0" width="100%">
                <thead>
                    <tr>

                        <th>Date</th>
                        <th>Status</th>
                        <th>Comments</th>
                        <th>Play</th>

                    </tr>
                </thead>
                <tfoot>
                    <tr>

                        <th>Date</th>
                        <th>Status</th>
                        <th>Comments</th>
                        <th>Play</th>

                    </tr>
                </tfoot>
                <tbody>
                    @foreach (var item in Model.CandidateStatusList)
                    {
                        <tr id=@item.id>

                            <td> @item.Date</td>
                            @if (item.StatusValue == "In Progress")
                            {
                            <td><span class="current progress" style="font-size:13px;"> @item.StatusValue</span></td>
                            }
                            else if (item.StatusValue == "New")
                            {
                                <td>
                                <span class="current new" style="font-size:13px;"> @item.StatusValue</span>
                                </td>
                            }

                        else if (item.StatusValue == "Added")
                        {
                            <td><span class="current added" style="font-size:13px;"> @item.StatusValue</span></td>
                        }

                            else if (item.StatusValue == "Waiting For Response")
                            {
                                <td>
                                <span class="current waiting" style="font-size:13px;">    @item.StatusValue</span>
                                </td>
                            }
                            else if (item.StatusValue == "Scheduled")
                            {
                                <td>
                                <span class="current scheduled" style="font-size:13px;"> @item.StatusValue</span>
                                </td>
                            }
                        else if (item.StatusValue == "Cancelled")
                        {
                            <td><span class="current cancelled" style="font-size:13px;"> @item.StatusValue</span></td>
                        }
                        else if (item.StatusValue == "No Show(Candidate)")
                        {
                            <td><span class="current noshowcandidate" style="font-size:13px;">@item.StatusValue</span></td>
                        }
                        
                         else if (item.StatusValue == "Irrelevant")
                           {
                                                        <td><span class="current irrelevant" style="font-size:13px;"> @item.StatusValue</span></td>
                            }
                            else if (item.StatusValue == "Duplicate")
                            {
                                <td style=" color: hotpink;font-weight: 500">
                                    @item.StatusValue
                                </td>
                            }
                            else if (item.StatusValue == "Not Interested")
                            {
                                <td style=" color: purple;font-weight: 500">
                                    @item.StatusValue
                                </td>
                            }
                            else if (item.StatusValue == "Got Another Offer")
                            {
                                <td style=" color: darkgreen;font-weight: 500">
                                    @item.StatusValue
                                </td>
                            }
                            else if (item.StatusValue == "Hold")
                            {
                                <td style="color: orangered;font-weight: 500">
                                    @item.StatusValue
                                </td>
                            }
                            else
                            {
                                <td> @item.StatusValue</td>
                            }

                            <td>
                                <div>
                                    <div>
                                        @if (item.Comments != null && item.Comments.Length > 18)
                                        {

                                            <a href="#" data-tooltip="@item.Comments">
                                            <textarea style="  height: 50px;width: 100%;font-size: 13px!important;resize: none; background:none; border:0px;">@item.Comments</textarea>
                                            </a>
                                        }

                                        else
                                        {
                                        <textarea style="height: height: 50px;width: 100%;font-size: 13px!important;resize: none; background:none; border:0px;">@item.Comments</textarea>
                                        }
                                    </div>
                                </div>

                            </td>



                            @if (item.AudioFileLink != null && item.AudioFileLink != "")
                            {
                                <td style="padding:10px;">
                                    <audio src='@item.AudioFileLink' asp-append-version="true" controls></audio>
                                </td>

                            }
                            else
                            {
                                <td> </td>
                            }



                        </tr>


                    }
                </tbody>
            </table>
        </div>

    </div>
    <script src="~/Newassets/js/scrollBar.js"></script>
    <script type="text/javascript">
    $(".sb-container").scrollBox();
    </script>

    <script>
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });
    </script>