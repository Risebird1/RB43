<script>
    // Biometric Verification Modal Functions
    let cameraStream = null;
    let capturedPhotoData = null;
    let aadhaarPhotoData = null;
    let isAadhaarVerified = false;
    var aadhaarinterviewid = 0;


    function openBiometricpopup(interviewid) {
        // Show the modal first
        aadhaarinterviewid=interviewid;
        var modal = document.getElementById("BiometricVerificationModal");
        if (modal) {
            modal.style.display = "block";
            // Reset the modal state after a small delay to ensure DOM is ready
            setTimeout(function() {
                resetBiometricModal();
                updateVerificationStatus();
            }, 100);
        } else {
            console.error("BiometricVerificationModal not found!");
            alert("Modal not found. Please refresh the page and try again.");
        }
    }

    function closeBiometricVerificationModal() {
        // Stop camera if running
        stopCamera();

        // Close the modal
        var modal = document.getElementById("BiometricVerificationModal");
        modal.style.display = "none";

        // Reset state
        resetBiometricModal();
    }

    function resetBiometricModal() {
        // Reset camera state
        capturedPhotoData = null;
        isAadhaarVerified = false;

        // Reset UI elements
        document.getElementById("cameraPlaceholder").style.display = "block";
        document.getElementById("cameraPreview").style.display = "none";
        document.getElementById("capturedImage").style.display = "none";
        document.getElementById("cameraControls").style.display = "none";
        document.getElementById("startCameraBtn").style.display = "inline-block";
        document.getElementById("captureBtn").style.display = "inline-block";
        document.getElementById("retakeBtn").style.display = "none";

        // Reset Aadhaar verification
        document.getElementById("divSubmit").style.display = "none";
        document.getElementById("divValidate").style.display = "inline-block";
        document.getElementById("divotpvalidation").style.display = "none";
        $("#aadhaarnumber").val('');
        $("#txtAadhaarOtp").val('');

        // Reset verification button
        document.getElementById("completeVerificationBtn").disabled = true;

        // Update status
        updateVerificationStatus();
    }

    function startCamera() {
        navigator.mediaDevices.getUserMedia({
            video: {
                width: { ideal: 640 },
                height: { ideal: 480 },
                facingMode: 'user' // Front camera
            }
        })
        .then(function(stream) {
            cameraStream = stream;
            const video = document.getElementById("cameraPreview");
            video.srcObject = stream;
            video.style.display = "block";

            // Hide placeholder and show controls
            document.getElementById("cameraPlaceholder").style.display = "none";
            document.getElementById("cameraControls").style.display = "flex";
            document.getElementById("startCameraBtn").style.display = "none";

            // Update status
            document.querySelector("#cameraContainer .camera-status").textContent = "Camera ready - Position candidate's face in frame";
        })
        .catch(function(error) {
            console.error("Error accessing camera:", error);
            alert("Unable to access camera. Please ensure camera permissions are granted and try again.");
        });
    }

    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }
    }

    function capturePhoto() {
        const video = document.getElementById("cameraPreview");
        const canvas = document.getElementById("captureCanvas");
        const context = canvas.getContext("2d");

        // Set canvas dimensions to match video
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;

        // Draw video frame to canvas
        context.drawImage(video, 0, 0, canvas.width, canvas.height);

        // Convert to base64
        capturedPhotoData = canvas.toDataURL("image/jpeg", 0.8);

        // Show captured image
        const capturedImage = document.getElementById("capturedImage");
        capturedImage.src = capturedPhotoData;
        capturedImage.style.display = "block";

        // Hide video and show retake button
        video.style.display = "none";
        document.getElementById("captureBtn").style.display = "none";
        document.getElementById("retakeBtn").style.display = "inline-block";

        // Update status
        document.querySelector("#cameraContainer .camera-status").textContent = "Photo captured successfully";

        // Update verification status
        updateVerificationStatus();

        // Stop camera
        stopCamera();
    }

    function retakePhoto() {
        // Reset captured photo
        capturedPhotoData = null;
        document.getElementById("capturedImage").style.display = "none";
        document.getElementById("captureBtn").style.display = "inline-block";
        document.getElementById("retakeBtn").style.display = "none";

        // Restart camera
        startCamera();
    }

    function updateVerificationStatus() {
        const photoCaptured = capturedPhotoData !== null;
        const aadhaarVerified = isAadhaarVerified;
        const statusDiv = document.getElementById("verificationStatus");
        const statusText = document.getElementById("verificationStatusText");
        const completeBtn = document.getElementById("completeVerificationBtn");

        if (photoCaptured && aadhaarVerified) {
            statusDiv.className = "alert alert-success";
            statusText.innerHTML = '<i class="fa fa-check-circle" style="margin-right: 5px;"></i>Verification complete! Both photo and Aadhaar verification are done.';
            completeBtn.disabled = false;
        } else if (photoCaptured && !aadhaarVerified) {
            statusDiv.className = "alert alert-warning";
            statusText.innerHTML = '<i class="fa fa-exclamation-triangle" style="margin-right: 5px;"></i>Photo captured. Please complete Aadhaar verification.';
            completeBtn.disabled = true;
        } else if (!photoCaptured && aadhaarVerified) {
            statusDiv.className = "alert alert-warning";
            statusText.innerHTML = '<i class="fa fa-exclamation-triangle" style="margin-right: 5px;"></i>Aadhaar verified. Please capture candidate photo.';
            completeBtn.disabled = true;
        } else {
            statusDiv.className = "alert alert-info";
            statusText.innerHTML = '<i class="fa fa-info-circle" style="margin-right: 5px;"></i>Please complete both photo capture and Aadhaar verification.';
            completeBtn.disabled = true;
        }

        statusDiv.style.display = "block";
    }

    // Function to update meeting link styling based on verification status
    function updateMeetingLinkStyling() {
        debugger;
        var aiInterviewButton = document.getElementById('btn_ai_Interview');
        if(aiInterviewButton != null)
        {
            aiInterviewButton.disabled = false;  // enable it
            //aiInterviewButton.classList.remove("disabled-link"); // optional: remove custom disabled styling
        }
    @* const meetingLinks = document.querySelectorAll('.meeting-link');
        meetingLinks.forEach(function(link) {
            if (isAadhaarVerified && capturedPhotoData) {
                link.style.color = '#007bff';
                link.style.fontWeight = '600';

                const meetingButton = link.querySelector('.click_herebtn');
                if (meetingButton) {
                    meetingButton.style.backgroundColor = '#87CEEB';
                    meetingButton.style.color = '#000';
                    meetingButton.style.fontWeight = '600';
                    meetingButton.style.border = '1px solid rgb(204 218 233)';
                }
            } else {
                // Reset to default styling
                link.style.color = '';
                link.style.fontWeight = '';

                const meetingButton = link.querySelector('.click_herebtn');
                if (meetingButton) {
                    meetingButton.style.backgroundColor = '';
                    meetingButton.style.color = '';
                    meetingButton.style.fontWeight = '';
                    meetingButton.style.border = '';
                }
            }
        }); *@
    }

    // Update the completeVerification function to call updateMeetingLinkStyling
    function completeVerification() {
        console.log("=== completeVerification Debug ===");
        console.log("capturedPhotoData:", capturedPhotoData ? "Present (Length: " + capturedPhotoData.length + ")" : "Missing");
        console.log("isAadhaarVerified:", isAadhaarVerified);
        console.log("typeof capturedPhotoData:", typeof capturedPhotoData);
        console.log("typeof isAadhaarVerified:", typeof isAadhaarVerified);

        // Check if SweetAlert is available
        console.log("SweetAlert available:", typeof swal !== 'undefined');

        if (capturedPhotoData && isAadhaarVerified) {
            console.log("All conditions met - showing success message");

            // Update meeting link styling to blue
            updateMeetingLinkStyling();

            //closeBiometricVerificationModal();

            // Test if SweetAlert works
            try {
                swal.fire({
                    title: "Verification Complete!",
                    text: "Candidate verification has been completed successfully.",
                    type: "success",
                    confirmButtonText: "OK",
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(function(result) {
                     $.ajax({
                    type: "POST",
                    url: "/Aadhaar/SaveVerificationData",
                    data: { interviewId: aadhaarinterviewid, capturedPhotoData: capturedPhotoData ,aadhaarPhotoData:aadhaarPhotoData,Name:aadhaarname,Address:aadhaaraddress,gender:aadhaargender,dob:aadhaardob,email:$("#txtcandidateEmailid").val()},
                    success: function (data) {
                            closeBiometricVerificationModal();
                    }
                    });
                }).catch(function(error) {
                    console.error("SweetAlert error:", error);
                    console.log("Fallback: calling closeBiometricVerificationModal directly...");
                    closeBiometricVerificationModal();
                });
            } catch (error) {
                console.error("Error showing SweetAlert:", error);
                console.log("Fallback: calling closeBiometricVerificationModal directly...");
                closeBiometricVerificationModal();
            }
        } else {
            console.log("Conditions NOT met:");
            console.log("- capturedPhotoData:", capturedPhotoData ? "✓ Present" : "✗ Missing");
            console.log("- isAadhaarVerified:", isAadhaarVerified ? "✓ True" : "✗ False");

            swal.fire({
                title: "Incomplete Verification",
                text: "Please complete both photo capture and Aadhaar verification.",
                type: "warning",
                confirmButtonText: "OK"
            });
        }
    }

    // Also update the AJAX interceptor to call updateMeetingLinkStyling when Aadhaar verification completes
    $(document).ready(function() {
        const originalAjax = $.ajax;
        $.ajax = function(options) {
            if (options.url === "/Aadhaar/SubmitOTPNumber" && options.type === "POST") {
                const originalSuccess = options.success;
                options.success = function(dataKYC) {
                    console.log("Intercepted Aadhaar verification response:", dataKYC);

                    // Set our verification variables for biometric modal
                    isAadhaarVerified = true;

                    // Update verification status for biometric modal
                    updateVerificationStatus();

                    // Update meeting link styling if photo is also captured
                    if (capturedPhotoData) {
                        updateMeetingLinkStyling();
                    }

                    // IMPORTANT: Call the original success callback to preserve all Aadhaar.js functionality
                    if (originalSuccess) {
                        originalSuccess(dataKYC);
                    }
                };
            }
            return originalAjax.call(this, options);
        };
    });

    // Clean up camera when modal is closed
    document.addEventListener('DOMContentLoaded', function() {
        // Close camera when clicking outside modal
        window.addEventListener('click', function(event) {
            const modal = document.getElementById("BiometricVerificationModal");
            if (event.target === modal) {
                closeBiometricVerificationModal();
            }
        });
    });

    // AJAX interceptor for Aadhaar verification - preserves all original functionality
    $(document).ready(function() {
        const originalAjax = $.ajax;
        $.ajax = function(options) {
            if (options.url === "/Aadhaar/SubmitOTPNumber" && options.type === "POST") {
                const originalSuccess = options.success;
                options.success = function(dataKYC) {
                    console.log("Intercepted Aadhaar verification response:", dataKYC);

                    // Set our verification variables for biometric modal
                    isAadhaarVerified = true;

                    // Update verification status for biometric modal
                    updateVerificationStatus();

                    // IMPORTANT: Call the original success callback to preserve all Aadhaar.js functionality
                    if (originalSuccess) {
                        originalSuccess(dataKYC);
                    }
                };
            }
            return originalAjax.call(this, options);
        };
    });
</script>
