        </div>
    </div>
    <div>
        <div class="content-wrapper">
            <div class="row">
                <div class="text-center">
                    @if (string.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("LogoSet")))
                    {
                        <img style="max-height:80px" class="img-responsive company-logo" src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" />
                    }
                    else
                    {
                        <img style="max-height:80px" class="img-responsive company-logo" src="@HttpContextAccessor.HttpContext.Session.GetString("LogoSet")" />
                    }
                </div>
                <div class="col-md-12 col-xl-12 col-sm-12">
                    @if (Model.Timer > 0)
                    {
                        <div class="time_tab"> <span style="top:0px" class="time-left-txt">Time left to start the interview(In Mins):</span><div class="time-clock"><span class="timer">@Model.Timer</span></div></div>
                    }


                </div>

            </div>
            <div class="row">
                <div class="candidate-tab">
                    <div class="tablinks card-block" onclick="openCity(event, 'Employer')">
                        <div class="step">1</div>
                        <img src="~/img/int-img-1.png" /><h1>Job and Contacts Details</h1>
                    </div>
                    <div class="tablinks card-block" onclick="openCity(event, 'Interviews')" id="defaultOpen">
                        <div class="step">2</div>
                        <img src="~/img/int-img-2.png" />  <h1>Interviews</h1>
                    </div>
                    <div class="tablinks card-block" onclick="openCity(event, 'Conditions')">
                        <div class="step">3</div>
                        <img src="~/img/int-img-3.png" /><h1>Do's / Dont's</h1>
                    </div>
                    <div>
                        <div id="Employer" class="tabcontent">
                            <div class="row">
                                <div class="col-md-12">
                                    <p><b>Company Website :</b> <a href="@Model.CandidateDetails.CompanyLink" target="_blank">@Model.CandidateDetails.ClientName</a></p>
                                    <p><b>Job Description Link :</b><c onclick="captureclick('JobDescription','Jd Link')"> <a class="click_herebtn" href="@Model.CandidateDetails.JDLink" target="_blank"><span>Click Here</span></a></c></p>
                                    <p><b>Primary Skill :</b> @Model.CandidateDetails.PrimarySkillInvite </p>
                                    <p><b>HR Contact :&nbsp;</b>@Model.CandidateDetails.ClientHRAttemptContact &nbsp;<c onclick="captureclick('Call','Hr Contact')"><span onclick="CommonCallButtonClick('@Model.CandidateDetails.ClientHRAttemptContact','@Model.CandidateDetails.ClientHRAttemptContactMobile','@Model.CandidateDetails.ClientHRAttemptContact', null, 'Candidate')"><svg style="color: rgb(44, 139, 24);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-telephone-plus-fill" viewBox="0 0 16 16"> <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511zM12.5 1a.5.5 0 0 1 .5.5V3h1.5a.5.5 0 0 1 0 1H13v1.5a.5.5 0 0 1-1 0V4h-1.5a.5.5 0 0 1 0-1H12V1.5a.5.5 0 0 1 .5-.5z" fill="#2c8b18"></path> </svg></span></c></p>
                                    <p><b>Risebird Contact :&nbsp;</b>@Model.CandidateDetails.ChannelOwnerEmail &nbsp;<c onclick="captureclick('Call','Risebird Contact')"><span onclick="CommonCallButtonClick('@Model.CandidateDetails.ChannelOwnerEmail','@Model.CandidateDetails.ChannelOwnerMobile','@Model.CandidateDetails.ChannelOwnerEmail', null, 'Candidate')"><svg style="color: rgb(44, 139, 24);" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-telephone-plus-fill" viewBox="0 0 16 16"> <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511zM12.5 1a.5.5 0 0 1 .5.5V3h1.5a.5.5 0 0 1 0 1H13v1.5a.5.5 0 0 1-1 0V4h-1.5a.5.5 0 0 1 0-1H12V1.5a.5.5 0 0 1 .5-.5z" fill="#2c8b18"></path> </svg></span></c></p>

                                </div>
                            </div>

                            @if (!String.IsNullOrWhiteSpace(Model.CandidateDetails.CompanyVideoLink))
                            {
                                <div style="max-width:auto">
                                    <video data-position='top' id="risetubevideo_3" controls class="vjs-tech video-width" controlsList="nodownload" autoplay>
                                        <source src="@Model.CandidateDetails.CompanyVideoLink" type="video/mp4" autoplay>
                                        <source src="@Model.CandidateDetails.CompanyVideoLink" type="video/mp4">
                                    </video>
                                </div>
                            }
                        </div>
                        <div id="Interviews" class="tabcontent">
                            @foreach (var item in Model.Meetings)
                            {
                                @if (item.interviewDate >= DateTime.Now && item.confirmationStatus == "Confirmed")
                                {
                                    <b>Scheduled Interview</b>
                                    <br />
                                    <b style="color:grey;font-weight:normal;font-size:16px;"> Interview Time:</b>  @item.interviewDate
                                    <p class="meeting-link" onclick="captureclick('ZoomMeeting','JoinMeeting')"> Click here to join the meeting <a class="click_herebtn" href="@item.zoomLink" target="_blank"><span>Meeting Link</span></a></p>
                                    <p>
                                        <div class="interview">
                                            <div class="click_herebtn pull-left" onclick="captureclick('Interview availability', 'Yes')">
                                                <span class="interviewresponsebtn" style="background:#289f28;" target="_blank" onclick="ComfirmMeeting(@item.Interviewid,'@ViewBag.Id',@Model.CandidateDetails.IRFId)">Yes! I am Available</span>
                                            </div>
                                            <div class="click_herebtn pull-left" onclick="captureclick('Interview availability', 'Reschedule')">
                                                @*<a href="@Model.SchedulingLink" target="_blank"> <span class="interviewresponsebtn" style="background:#cd362b;">Reschedule</span></a>*@
                                                <span class="interviewresponsebtn" style="background:#cd362b;" onclick="ReschuduleMeeting(@item.Interviewid,'@Model.Uniqueid',@Model.CandidateDetails.IRFId,'@Model.CandidateDetails.EmailId')">Reschedule</span>
                                            </div>
                                            <div class="click_herebtn pull-left" onclick="captureclick('Interview availability', 'No')">
                                                <span class="interviewresponsebtn" style="background:#cd362b;" onclick="NotAttendMeeting(@item.Interviewid,'@ViewBag.Id',@Model.CandidateDetails.IRFId)">No! I am not Available</span>
                                            </div>
                                            <div class="click_herebtn pull-left" onclick="captureclick('Interview availability', 'Yes')">
                                                <span class="interviewresponsebtn" style="background:#cd362b;" onclick="OpenSendmailModal(@item.Interviewid,'@Model.CandidateDetails.ClientHRAttemptContact','@Model.CandidateDetails.Name','@Model.CandidateDetails.EmailId')">Need More Clarity</span>
                                            </div>
                                        </div>
                                    </p>
                                }
                                else
                                {
                                    <b>Interview</b>
                                    <br />
                                    <p><b style="color:grey;font-weight:normal;font-size:16px;"> Interview Time:</b>  @item.interviewDate</p>

                                    @if (Model.IsReschedule)
                                    {
                                        <p class="meeting-link">Reschedule Interview Link : <a class="click_herebtn" href="@Model.SchedulingLink" target="_blank"><span>Click Here</span></a></p>
                                    }
                                }
                            }
                        </div>
                        <div id="Conditions" class="tabcontent follow">
                            <div class="row">
                                <div class="col-md-12">
                                    <ul>
                                        <li>I confirm and authorize Risebird, (Arhat Talent Solutions Private Limited) and its partners and customers to use my ID proof data for verifying my identity to appear for an interview.</li>
                                        <li>I am aware and agree that this interview will be recorded and will be shared only with my employer in fully secured and encrypted format. It will be permanently deleted from all records in 2-3 weeks’ time.</li>
                                        <li>I am also aware that if I feel my interview is not up to the mark, I cancel my candidature anytime during or after the interview. My recordings will be deleted immediately.</li>
                                        <li>I agree that my voice signature shall be used for authenticating my profile at the time of interview and on-boarding (if I get selected).</li>
                                        <li>I will ensure that my webcam will be switched on and audio settings is done before the start of the meeting. I will not use Audio Splitter or speaker for voice communication.</li>
                                        <li>I will not appear for the interview using mobile or tablet.</li>
                                        <li>I will ensure to use Chrome (preferably) and download zoom plugin. I will join the meeting by clicking on the meeting link using my laptop.</li>
                                        <li>I will share my desktop during the interview and will have my desktop and browser clean and close all the apps before the start of the interview.</li>
                                        <li>I will not be late for my scheduled interview, and will join 5 minutes before time.</li>
                                        <li>I will ensure that I will be in the silent place where there is no background noise and with appropriate light during the interview. If required I will choose a clean uncluttered background.</li>
                                        <li>I am aware that this will be a hands-on interview, so I will have the editor open.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Interview/BroadcastModal.cshtml")
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

