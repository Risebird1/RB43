/* Candidate Advisory Popup Styles */
#rb-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    font-family: "Segoe UI", Arial, sans-serif;
    animation: fadeIn 0.3s ease;
}

#rb-popup {
    background: #ffffff;
    width: 92%;
    max-width: 460px;
    padding: 28px;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    animation: slideUp 0.35s ease-out;
    border-top: 6px solid #42a5f5; /* Risebird Blue */
}

#rb-popup-title {
    font-size: 20px;
    font-weight: 700;
    color: #42a5f5;
    margin-bottom: 14px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.rb-highlight-box {
    background: #E8F1FF; /* Soft Risebird Blue */
    border-left: 5px solid #42a5f5;
    padding: 14px;
    border-radius: 6px;
    margin-bottom: 18px;
}

#rb-popup-text {
    font-size: 15px;
    color: #333;
    line-height: 1.55;
}

        .vertical-mdl-tabs .panel-default > .panel-heading + .panel-collapse > .panel-body {
    border-top-color: #fff;
}


        .vertical-mdl-tabs .panel-default>.panel-heading {
            background: none !important;
            
            border: none !important;

        }

        #accordion .panel-body {
            padding: 0px 14px 14px 16px;
            background: #fff;
        }

        .panel-group, #accordion .panel, .panel-group .panel+.panel {

         margin-bottom:0px;
        }
a.rb-link {
    color: #0066FF;
    font-weight: 600;
    text-decoration: none;
}

a.rb-link:hover {
    text-decoration: underline;
}

#rb-popup-ok {
    width: 100%;
    margin-top: 22px;
    background: #42a5f5;
    border: none;
    color: #ffffff;
    padding: 12px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: 0.2s ease-in-out;
}

#rb-popup-ok:hover {
    background: #0047B3;
    transform: translateY(-1px);
}
#risebirdProctoringExtStatus.alert:before{
     border-color: #d33f3f;
}

#risebirdProctoringExtStatus.alert{
    background: #fac2c27a;
    border-color: #fac2c27a;
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@@keyframes slideUp {
    from { transform: translateY(25px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
.follow ul li, .follow p {
      font-size: 13px;
      line-height: 20px;
}
