    function AcceptInterviewerAlert(){
        var result = $('input[name="InterviewCheckshow"]:checked');
        var resultString = '';

        // Button is disabled when not all checkboxes are checked, so no additional validation needed

        if (result.length > 0) {
            result.each(function () {
                if (resultString == '') {
                    resultString += $(this).val();
                } else {
                    resultString += "," + $(this).val();
                }
            });
        }
        $.ajax({
            type: "POST",
            url: "/Candidate/CandidateAcknowledge",
            data: { 'interviewid': @ViewBag.Interviewid, interviewchecks: resultString },
            success: function (data) {
                closeInterviewerAlert();
            }
        });
    }
    // Custom override of SendNeedClearitymail function to return to appropriate location
    // This overrides the function from BroadcastMessage.js for this page only
    function SendNeedClearitymail() {
        var message = tinymce.activeEditor.getContent();
        var subject = document.getElementById("needClearitybcSubject").value;
        var interviewId = document.getElementById("hid_needClearityinterviewId").value;
        var clienthr = document.getElementById("hid_needClearityclienthr").value;
        var candidateemail = document.getElementById("hid_needClearitycandidateEmail").value;
        var Irfid = document.getElementById("hid_needClearityirfid").value;
        var uniqueid = document.getElementById("hid_needClearityuniqueid").value;
        $.ajax({
            type: "POST",
            url: "/Candidate/NeedClearityMail",
            data: { 'message': message, 'subject': subject, 'interviewId': interviewId, 'clienthr': clienthr, 'candidateemail': candidateemail, 'uniqueid': uniqueid, 'Irfid': Irfid },
            success: function (data) {
                swal.fire({
                    title: "Information shared to contact person, HR will Connect you soon.",
                    type: 'success',
                    confirmButtonText: "Close",
                    allowOutsideClick: false
                }).then(function () {
                    // Close the SendmailModal
                    closeSendmailModal();

                    // Return to appropriate location based on source
                    if (needClaritySource === 'InterviewAlert') {
                        // Return to the original InterviewerAlert popup with checkboxes
                        openInterviewerAlert();
                    } else {
                        // Return to the interview detail page (default behavior)
                        // This happens when called from other Need Clarity buttons on the page
                        // The page stays as is, no redirection needed
                    }

                    // Reset the source tracking
                    needClaritySource = null;
                });
            }
        });
    }

    // Wrapper function for direct OpenSendmailModal calls from other parts of the page
    function openNeedClarityFromPage(interviewId, clienthr, candidateName, candidateEmail, irfId, uniqueid) {
        $.ajax({
            url: '/Interview/CandidateMeetingsStatus',
            method: 'GET',
            data: {
                'meetingid': interviewId,
                'status': 4,
                'uniqueid': uniqueid,
                'Irfid': irfId
            },
            success: function (result) {
            }
        })
        // Set the source to indicate this came from the main page (not InterviewAlert popup)
        needClaritySource = 'Page';

        // Call the original OpenSendmailModal function
        OpenSendmailModal(interviewId, clienthr, candidateName, candidateEmail, irfId, uniqueid);
    }
</script>
