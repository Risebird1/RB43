<script>
(function () {
    var RISEBIRD_PROCTORING_EXT_ID = 'lpbnpcnkhmknkgfnnnecahkmpkihglgg';
    window.risebirdProctoringExtensionInstalled = false;
    window.risebirdUserConfirmedProctoringExtension = false;
    window.risebirdInstallFlowStarted = false;
    window.risebirdAadharJoinOk = false;
    var risebirdExtWasMissingAfterProbe = false;
    var risebirdInstallToastShown = false;
    var risebirdProctoringVerifyIdentityPrompt = false;

    function risebirdShouldEnforceExtensionInstall() {
        var ua = navigator.userAgent || '';
        if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua)) return false;
        return /Chrome\//i.test(ua) || /Edg\//i.test(ua) || /OPR\//i.test(ua) || /Brave/i.test(ua) || /Chromium/i.test(ua);
    }

    function risebirdDomSignalsExtensionPresent() {
        try {
            if (window.__RISEBIRD_PROCTORING_EXTENSION__ === true) return true;
            var el = document.documentElement;
            if (el && el.getAttribute('data-risebird-proctoring-extension') === '1') return true;
        } catch (ex) { }
        return false;
    }

    window.risebirdGetAiJoinButton = function () {
        return document.getElementById('btn_ai_Interview');
    };

    window.risebirdApplyAiJoinButtonState = function () {
        var btn = window.risebirdGetAiJoinButton();
        var statusEl = document.getElementById('risebirdProctoringExtStatus');
        var okEl = document.getElementById('risebirdProctoringExtOk');
        var recheckBtn = document.getElementById('risebirdRecheckExtBtn');
        if (!btn) return;

        var verified = window.risebirdAadharJoinOk === true;
        if (verified && risebirdDomSignalsExtensionPresent()) {
            window.risebirdProctoringExtensionInstalled = true;
        }

        var needExt = risebirdShouldEnforceExtensionInstall();
        var userAttested = window.risebirdUserConfirmedProctoringExtension === true;
        var extInstalled = window.risebirdProctoringExtensionInstalled === true;
        var extOk = !needExt || extInstalled || userAttested;
        var noProctoring = btn.getAttribute('data-no-proctoring') === '1';
        var inInterviewWindow = btn.getAttribute('data-in-interview-window') === 'true';
        var canJoin = verified && inInterviewWindow && (noProctoring || extOk);
        var aadhaarRequired = btn.getAttribute('data-aadhaar-required') === 'true';

        if (recheckBtn) {
            // Aadhaar off: show only after the Chrome Web Store icon is clicked (previous install flow).
            // Aadhaar on: keep existing verified flow (store click or extension already detected).
            var showRecheck = aadhaarRequired
                ? (extInstalled || window.risebirdInstallFlowStarted === true)
                : (window.risebirdInstallFlowStarted === true);
            recheckBtn.style.display = showRecheck ? 'inline-block' : 'none';
        }

        if (statusEl) {
            if (verified) {
                risebirdProctoringVerifyIdentityPrompt = false;
            }
            if (!verified) {
                if (risebirdProctoringVerifyIdentityPrompt) {
                    statusEl.style.display = 'block';
                    statusEl.className = 'alert alert-info';
                    statusEl.innerHTML = 'Complete <strong>Verify Your Identity</strong> first then you may install the extension after verification.';
                } else {
                    statusEl.style.display = 'none';
                    statusEl.innerHTML = '';
                }
            } else if (!needExt) {
                statusEl.style.display = 'block';
                statusEl.className = 'alert alert-info';
                statusEl.innerHTML = 'For full proctoring, use Google Chrome with the Risebird Proctoring Assistant. You can join from this browser now.';
            } else if (window.risebirdProctoringExtensionInstalled) {
                statusEl.style.display = 'none';
            } else if (userAttested) {
                statusEl.style.display = 'block';
                statusEl.className = 'alert alert-info';
                statusEl.innerHTML = 'Extension install confirmed. Use <strong>Click here to join the meeting</strong> when you are ready.';
            } else {
                statusEl.style.display = 'block';
                statusEl.className = 'alert alert-warning';
                    statusEl.innerHTML = 'Install the extension from the Chrome Web Store by clicking the icon in the top-right corner.';
            }
        }
        if (okEl) {
            okEl.style.display = (verified && needExt && (extInstalled || userAttested)) ? 'block' : 'none';
        }

        var joinUrl = btn.getAttribute('data-join-url') || '';
        if (canJoin && joinUrl) {
            btn.setAttribute('href', joinUrl);
            btn.setAttribute('aria-disabled', 'false');
            btn.classList.remove('disabled');
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
            btn.style.pointerEvents = '';
        } else {
            btn.setAttribute('href', '#');
            btn.setAttribute('aria-disabled', 'true');
            btn.classList.add('disabled');
            btn.style.opacity = '0.55';
            btn.style.cursor = 'not-allowed';
            btn.style.pointerEvents = 'none';
        }
    };

    // Join uses a real anchor (target=_blank, rel=opener) so Chrome keeps user activation and the Proctoring extension reliably attaches to the interview tab.
    window.risebirdAiInterviewJoinAnchorClick = function (ev) {
        var btn = window.risebirdGetAiJoinButton();
        if (!btn || btn.getAttribute('aria-disabled') === 'true') {
            if (ev) ev.preventDefault();
            return false;
        }
        var url = btn.getAttribute('data-join-url');
        if (!url) {
            if (ev) ev.preventDefault();
            return false;
        }
        try {
            var iid = parseInt(btn.getAttribute('data-interview-id'), 10);
            if (!isNaN(iid) && typeof captureclick === 'function') {
                captureclick('AIInterview', 'JoinMeeting', iid);
            }
        } catch (ex) { }
        btn.setAttribute('href', url);
        return true;
    };

    window.risebirdOpenAiInterviewJoin = function () {
        var a = window.risebirdGetAiJoinButton();
        if (!a || a.getAttribute('aria-disabled') === 'true') return;
        if (typeof a.click === 'function') a.click();
    };

    window.risebirdShowVerifyIdentityBeforeExtensionMessage = function () {
        risebirdProctoringVerifyIdentityPrompt = true;
        var statusEl = document.getElementById('risebirdProctoringExtStatus');
        if (statusEl) {
            statusEl.style.display = 'block';
            statusEl.className = 'alert alert-info';
            statusEl.innerHTML = 'Complete <strong>Verify Your Identity</strong> first then you may install the extension after verification.';
        }
    };

    window.risebirdOpenProctoringStoreWindow = function (ev) {
        if (ev && typeof ev.preventDefault === 'function') ev.preventDefault();
        if (window.risebirdAadharJoinOk !== true) {
            window.risebirdShowVerifyIdentityBeforeExtensionMessage();
            return false;
        }
            var installUrl = 'https://chromewebstore.google.com/detail/risebird-proctoring-assis/nhjdihkojakanjldmdlddfppoamjkonh?authuser=0&hl=en';
            window.open(installUrl, '_blank', 'noopener,noreferrer');
        window.risebirdInstallFlowStarted = true;
        window.risebirdApplyAiJoinButtonState();
        return false;
    };

    function risebirdProbeExtImg(path) {
        return new Promise(function (resolve) {
            var img = new Image();
            var t = setTimeout(function () {
                img.onload = img.onerror = null;
                resolve(false);
            }, 1200);
            img.onload = function () {
                clearTimeout(t);
                img.onload = img.onerror = null;
                resolve(true);
            };
            img.onerror = function () {
                clearTimeout(t);
                img.onload = img.onerror = null;
                resolve(false);
            };
            img.src = 'chrome-extension://' + RISEBIRD_PROCTORING_EXT_ID + '/' + path;
        });
    }

    window.risebirdDetectProctoringExtension = async function () {
        if (!risebirdShouldEnforceExtensionInstall()) return false;
        if (risebirdDomSignalsExtensionPresent()) return true;
        var paths = [
            'icons/icon16.png', 'icons/icon32.png', 'icons/icon48.png', 'icons/icon128.png',
            'icon16.png', 'icon32.png', 'icon48.png', 'icon128.png',
            'images/icon16.png', 'images/icon48.png', 'images/icon128.png',
            'assets/icon16.png', 'assets/icon48.png', 'assets/icon128.png',
            'img/icon16.png', 'img/icon48.png',
            'favicon.ico', 'favicon.png'
        ];
        var results = await Promise.all(paths.map(function (p) { return risebirdProbeExtImg(p); }));
        return results.some(Boolean);
    };

    function risebirdNotifyExtensionReady() {
        if (risebirdInstallToastShown) return;
        risebirdInstallToastShown = true;
        if (typeof swal !== 'undefined' && swal.fire) {
            swal.fire({
                title: 'Proctoring extension ready',
                text: 'Risebird Proctoring Assistant was detected. You can join the meeting.',
                type: 'success',
                confirmButtonText: 'OK'
            });
        } else {
            alert('Risebird Proctoring Assistant was detected. You can join the meeting.');
        }
    }

    window.risebirdRefreshProctoringExtensionPresence = async function (allowInstallTransitionToast) {
        var btn = window.risebirdGetAiJoinButton();
        if (!btn) return;
        var prev = window.risebirdProctoringExtensionInstalled === true;
        var detected = await window.risebirdDetectProctoringExtension();
        window.risebirdProctoringExtensionInstalled = prev || detected || risebirdDomSignalsExtensionPresent();
        if (!window.risebirdProctoringExtensionInstalled) risebirdExtWasMissingAfterProbe = true;
        window.risebirdApplyAiJoinButtonState();
        if (allowInstallTransitionToast && window.risebirdProctoringExtensionInstalled && !prev && risebirdExtWasMissingAfterProbe) {
            risebirdNotifyExtensionReady();
        }
    };

    window.addEventListener('message', function (e) {
        try {
            var d = e.data;
            if (d && d.source === 'risebird-proctoring-extension' && d.installed) {
                var prev = window.risebirdProctoringExtensionInstalled === true;
                window.risebirdProctoringExtensionInstalled = true;
                window.risebirdApplyAiJoinButtonState();
                if (window.risebirdAadharJoinOk && !prev) risebirdNotifyExtensionReady();
            }
        } catch (ex) { }
    });

    window.addEventListener('risebird-proctoring-extension-ready', function () {
        var prev = window.risebirdProctoringExtensionInstalled === true;
        window.risebirdProctoringExtensionInstalled = true;
        window.risebirdApplyAiJoinButtonState();
        if (window.risebirdAadharJoinOk && !prev) risebirdNotifyExtensionReady();
    });

    function risebirdInitProctoringJoinGate() {
        var btn = window.risebirdGetAiJoinButton();
        if (!btn) return;
        window.risebirdAadharJoinOk = btn.getAttribute('data-aadhar-ok') === 'true';
        var aadhaarRequiredOnInit = btn.getAttribute('data-aadhaar-required') === 'true';
        // Only auto-start the recheck row for Aadhaar-on channels that already verified.
        // Aadhaar-off must wait for the Chrome Web Store icon click, same as the previous install flow.
        if (aadhaarRequiredOnInit && window.risebirdAadharJoinOk === true && risebirdShouldEnforceExtensionInstall()) {
            window.risebirdInstallFlowStarted = true;
        }
        window.risebirdApplyAiJoinButtonState();
        window.risebirdRefreshProctoringExtensionPresence(false).then(function () {
            if (window.risebirdProctoringExtensionInstalled) risebirdExtWasMissingAfterProbe = false;
        });
        var recheck = function () { window.risebirdRefreshProctoringExtensionPresence(true); };
        window.addEventListener('focus', recheck);
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') recheck();
        });
        setInterval(function () {
            if (!window.risebirdUserConfirmedProctoringExtension && !window.risebirdProctoringExtensionInstalled && risebirdShouldEnforceExtensionInstall()) {
                window.risebirdRefreshProctoringExtensionPresence(true);
            }
        }, 4000);

        var recheckBtn = document.getElementById('risebirdRecheckExtBtn');
        if (recheckBtn && !recheckBtn._risebirdWired) {
            recheckBtn._risebirdWired = true;
            recheckBtn.addEventListener('click', function () {
                if (window.risebirdAadharJoinOk !== true) {
                    window.risebirdShowVerifyIdentityBeforeExtensionMessage();
                    return;
                }
                recheckBtn.style.background = 'rgb(97 172 231)';
                window.risebirdUserConfirmedProctoringExtension = true;
                window.risebirdApplyAiJoinButtonState();
                window.risebirdRefreshProctoringExtensionPresence(true);
            });
        }

        var installBtn = document.getElementById('btnInstallRisebirdProctoringExt');
        if (installBtn && !installBtn._risebirdWired) {
            installBtn._risebirdWired = true;
            installBtn.addEventListener('click', function (ev) {
                if (window.risebirdAadharJoinOk !== true) {
                    return;
                }
                window.risebirdInstallFlowStarted = true;
                window.risebirdApplyAiJoinButtonState();
                if (typeof window.risebirdRefreshProctoringExtensionPresence === 'function') {
                    setTimeout(function () { window.risebirdRefreshProctoringExtensionPresence(false); }, 1500);
                }
            });
        }

        var step3Toggle = document.getElementById('risebirdProctoringStep3Toggle');
        var step3Body = document.getElementById('risebirdProctoringStep3Body');
        var step3Chevron = document.getElementById('risebirdProctoringStep3Chevron');
        if (step3Toggle && step3Body && step3Chevron && !step3Toggle._risebirdWired) {
            step3Toggle._risebirdWired = true;
            var toggleStep3 = function () {
                var isOpen = step3Body.style.display !== 'none';
                step3Body.style.display = isOpen ? 'none' : 'block';
                step3Chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
                step3Toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
            };
            step3Toggle.addEventListener('click', toggleStep3);
            step3Toggle.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    toggleStep3();
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', risebirdInitProctoringJoinGate);
    } else {
        risebirdInitProctoringJoinGate();
    }
})();
</script>
<script>
    // Biometric Verification Modal Functions
    let cameraStream = null;
    let capturedPhotoData = null;
    let aadhaarPhotoData = null;
    let isAadhaarVerified = false;
    var aadhaarinterviewid = 0;


    function openBiometricpopup(interviewid) {
        // Show the modal first
        aadhaarinterviewid=interviewid;
        var modal = document.getElementById("BiometricVerificationModal");
        if (modal) {
            modal.style.display = "block";
            // Reset the modal state after a small delay to ensure DOM is ready
            setTimeout(function() {
                resetBiometricModal();
                updateVerificationStatus();
            }, 100);
        } else {
            console.error("BiometricVerificationModal not found!");
            alert("Modal not found. Please refresh the page and try again.");
        }
    }

    function closeBiometricVerificationModal() {
        // Stop camera if running
        stopCamera();

        // Close the modal
        var modal = document.getElementById("BiometricVerificationModal");
        modal.style.display = "none";

        // Reset state
        resetBiometricModal();
    }

    function resetBiometricModal() {
        // Reset camera state
        capturedPhotoData = null;
        isAadhaarVerified = false;

        // Reset UI elements
        document.getElementById("cameraPlaceholder").style.display = "block";
        document.getElementById("cameraPreview").style.display = "none";
        document.getElementById("capturedImage").style.display = "none";
        document.getElementById("cameraControls").style.display = "none";
        document.getElementById("startCameraBtn").style.display = "inline-block";
        document.getElementById("captureBtn").style.display = "inline-block";
        document.getElementById("retakeBtn").style.display = "none";

        // Reset Aadhaar verification
        document.getElementById("divSubmit").style.display = "none";
        document.getElementById("divValidate").style.display = "inline-block";
        document.getElementById("divotpvalidation").style.display = "none";
        $("#aadhaarnumber").val('');
        $("#txtAadhaarOtp").val('');

        // Reset verification button
        document.getElementById("completeVerificationBtn").disabled = true;

        // Hide skip button on reset
        document.getElementById("skipVerificationBtn").style.display = "none";

        // Update status
        updateVerificationStatus();
    }

    function startCamera() {
        navigator.mediaDevices.getUserMedia({
            video: {
                width: { ideal: 640 },
                height: { ideal: 480 },
                facingMode: 'user' // Front camera
            }
        })
        .then(function(stream) {
            cameraStream = stream;
            const video = document.getElementById("cameraPreview");
            video.srcObject = stream;
            video.style.display = "block";

            // Hide placeholder and show controls
            document.getElementById("cameraPlaceholder").style.display = "none";
            document.getElementById("cameraControls").style.display = "flex";
            document.getElementById("startCameraBtn").style.display = "none";

            // Update status
            document.querySelector("#cameraContainer .camera-status").textContent = "Camera ready - Position candidate's face in frame";
        })
        .catch(function(error) {
            console.error("Error accessing camera:", error);
            alert("Unable to access camera. Please ensure camera permissions are granted and try again.");
        });
    }

    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }
    }

    function capturePhoto() {
        const video = document.getElementById("cameraPreview");
        const canvas = document.getElementById("captureCanvas");
        const context = canvas.getContext("2d");

        // Set canvas dimensions to match video
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;

        // Draw video frame to canvas
        context.drawImage(video, 0, 0, canvas.width, canvas.height);

        // Convert to base64
        capturedPhotoData = canvas.toDataURL("image/jpeg", 0.8);

        // Show captured image
        const capturedImage = document.getElementById("capturedImage");
        capturedImage.src = capturedPhotoData;
        capturedImage.style.display = "block";

        // Hide video and show retake button
        video.style.display = "none";
        document.getElementById("captureBtn").style.display = "none";
        document.getElementById("retakeBtn").style.display = "inline-block";

        // Update status
        document.querySelector("#cameraContainer .camera-status").textContent = "Photo captured successfully";

        // Update verification status
        updateVerificationStatus();

        // Stop camera
        stopCamera();
    }

    function retakePhoto() {
        // Reset captured photo
        capturedPhotoData = null;
        document.getElementById("capturedImage").style.display = "none";
        document.getElementById("captureBtn").style.display = "inline-block";
        document.getElementById("retakeBtn").style.display = "none";

        // Restart camera
        startCamera();
    }

    function updateVerificationStatus() {
        const photoCaptured = capturedPhotoData !== null;
        const aadhaarVerified = isAadhaarVerified;
        const statusDiv = document.getElementById("verificationStatus");
        const statusText = document.getElementById("verificationStatusText");
        const completeBtn = document.getElementById("completeVerificationBtn");

        if (photoCaptured && aadhaarVerified) {
            statusDiv.className = "alert alert-success";
            statusText.innerHTML = '<i class="fa fa-check-circle" style="margin-right: 5px;"></i>Verification complete! Both photo and Aadhaar verification are done.';
            completeBtn.disabled = false;
        } else if (photoCaptured && !aadhaarVerified) {
            statusDiv.className = "alert alert-warning";
            statusText.innerHTML = '<i class="fa fa-exclamation-triangle" style="margin-right: 5px;"></i>Photo captured. Please complete Aadhaar verification.';
            completeBtn.disabled = true;
        } else if (!photoCaptured && aadhaarVerified) {
            statusDiv.className = "alert alert-warning";
            statusText.innerHTML = '<i class="fa fa-exclamation-triangle" style="margin-right: 5px;"></i>Aadhaar verified. Please capture candidate photo.';
            completeBtn.disabled = true;
        } else {
            statusDiv.className = "alert alert-info";
            statusText.innerHTML = '<i class="fa fa-info-circle" style="margin-right: 5px;"></i>Please complete both photo capture and Aadhaar verification.';
            completeBtn.disabled = true;
        }

        statusDiv.style.display = "block";
    }

    // Function to update meeting link styling based on verification status
    function updateMeetingLinkStyling() {
        if (typeof window.risebirdAadharJoinOk !== 'undefined') {
            window.risebirdAadharJoinOk = true;
        }
        if (typeof window.risebirdApplyAiJoinButtonState === 'function') {
            window.risebirdApplyAiJoinButtonState();
        }
        if (typeof window.risebirdRefreshProctoringExtensionPresence === 'function') {
            window.risebirdRefreshProctoringExtensionPresence(false);
        }
        var aiInterviewButton = document.getElementById('btn_ai_Interview');
        if (aiInterviewButton != null && typeof window.risebirdApplyAiJoinButtonState !== 'function') {
            var ju = aiInterviewButton.getAttribute('data-join-url');
            if (ju) aiInterviewButton.setAttribute('href', ju);
            aiInterviewButton.setAttribute('aria-disabled', 'false');
            aiInterviewButton.classList.remove('disabled');
            aiInterviewButton.style.opacity = '1';
            aiInterviewButton.style.cursor = 'pointer';
            aiInterviewButton.style.pointerEvents = '';
        }
    @* const meetingLinks = document.querySelectorAll('.meeting-link');
        meetingLinks.forEach(function(link) {
            if (isAadhaarVerified && capturedPhotoData) {
                link.style.color = '#007bff';
                link.style.fontWeight = '600';

                const meetingButton = link.querySelector('.click_herebtn');
                if (meetingButton) {
                    meetingButton.style.backgroundColor = '#87CEEB';
                    meetingButton.style.color = '#000';
                    meetingButton.style.fontWeight = '600';
                    meetingButton.style.border = '1px solid rgb(204 218 233)';
                }
            } else {
                // Reset to default styling
                link.style.color = '';
                link.style.fontWeight = '';

                const meetingButton = link.querySelector('.click_herebtn');
                if (meetingButton) {
                    meetingButton.style.backgroundColor = '';
                    meetingButton.style.color = '';
                    meetingButton.style.fontWeight = '';
                    meetingButton.style.border = '';
                }
            }
        }); *@
    }

    // Update the completeVerification function to call updateMeetingLinkStyling
    function completeVerification() {
        console.log("=== completeVerification Debug ===");
        console.log("capturedPhotoData:", capturedPhotoData ? "Present (Length: " + capturedPhotoData.length + ")" : "Missing");
        console.log("isAadhaarVerified:", isAadhaarVerified);
        console.log("typeof capturedPhotoData:", typeof capturedPhotoData);
        console.log("typeof isAadhaarVerified:", typeof isAadhaarVerified);

        // Check if SweetAlert is available
        console.log("SweetAlert available:", typeof swal !== 'undefined');

        if (capturedPhotoData && isAadhaarVerified) {
            console.log("All conditions met - showing success message");

            // Update meeting link styling to blue
            updateMeetingLinkStyling();

            // Hide skip button if verification is successful
            document.getElementById("skipVerificationBtn").style.display = "none";

            //closeBiometricVerificationModal();

            // Show loading message and save verification data
            try {
                // Show loading indicator
                swal.fire({
                    title: "Saving Verification...",
                    text: "Please wait while we save your verification details.",
                    type: "info",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        swal.showLoading();
                    }
                });

                // Make AJAX call to save verification data
                $.ajax({
                    type: "POST",
                    url: "/Aadhaar/SaveVerificationData",
                    data: { interviewId: aadhaarinterviewid, capturedPhotoData: capturedPhotoData ,aadhaarPhotoData:aadhaarPhotoData,Name:aadhaarname,Address:aadhaaraddress,gender:aadhaargender,dob:aadhaardob,email:$("#txtcandidateEmailid").val()},
                    success: function (data) {
                        if (data.success) {
                            // Close SweetAlert and show success message briefly
                            swal.fire({
                                title: "Verification Complete!",
                                text: "Candidate verification has been completed successfully.",
                                type: "success",
                                confirmButtonText: "OK",
                                timer: 2000,
                                timerProgressBar: true
                            }).then(function(result) {
                                // Close the biometric verification modal
                                closeBiometricVerificationModal();
                            });
                        } else {
                            // Close loading alert first
                            swal.close();
                            // Verification failed - show skip button
                            showSkipButton(data.message || "Verification failed. You can skip and proceed.");
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("AJAX error:", error);
                        // Close loading alert
                        swal.close();
                        // Show skip button on AJAX error
                        showSkipButton("Network error occurred. You can skip verification and proceed.");
                    }
                });
            } catch (error) {
                console.error("Error in verification process:", error);
                swal.close();
                // Show skip button on error
                showSkipButton("An error occurred during verification. You can skip and proceed.");
            }
        } else {
            console.log("Conditions NOT met:");
            console.log("- capturedPhotoData:", capturedPhotoData ? "✓ Present" : "✗ Missing");
            console.log("- isAadhaarVerified:", isAadhaarVerified ? "✓ True" : "✗ False");

            swal.fire({
                title: "Incomplete Verification",
                text: "Please complete both photo capture and Aadhaar verification.",
                type: "warning",
                confirmButtonText: "OK"
            });
        }
    }

    // Function to show skip button when verification fails
    function showSkipButton(errorMessage) {
        document.getElementById("skipVerificationBtn").style.display = "inline-block";
        
        // Show error message with option to skip
        swal.fire({
            title: "Verification Failed",
            text: errorMessage + " Would you like to skip verification and proceed?",
            type: "error",
            showCancelButton: true,
            confirmButtonText: "Skip & Proceed",
            cancelButtonText: "Try Again",
            confirmButtonColor: "#ffc107"
        }).then(function(result) {
            if (result.value) {
                skipVerification();
            }
        });
    }

    // Function to skip verification and proceed
    function skipVerification() {
        swal.fire({
            title: "Skip Verification?",
            text: "Are you sure you want to skip verification? You will be able to proceed to the interview without verification.",
            type: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Skip",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#ffc107"
        }).then(function(result) {
            if (result.value) {
                updateMeetingLinkStyling();
                
                // Close the modal
                closeBiometricVerificationModal();
                
                // Show success message
                swal.fire({
                    title: "Verification Skipped",
                    text: "You can now proceed to join the interview.",
                    type: "info",
                    confirmButtonText: "OK"
                });
            }
        });
    }

    // Also update the AJAX interceptor to call updateMeetingLinkStyling when Aadhaar verification completes
    $(document).ready(function() {
        const originalAjax = $.ajax;
        $.ajax = function(options) {
            if (options.url === "/Aadhaar/SubmitOTPNumber" && options.type === "POST") {
                const originalSuccess = options.success;
                options.success = function(dataKYC) {
                    console.log("Intercepted Aadhaar verification response:", dataKYC);

                    // Set our verification variables for biometric modal
                    isAadhaarVerified = true;

                    // Update verification status for biometric modal
                    updateVerificationStatus();

                    // Update meeting link styling if photo is also captured
                    if (capturedPhotoData) {
                        updateMeetingLinkStyling();
                    }

                    // IMPORTANT: Call the original success callback to preserve all Aadhaar.js functionality
                    if (originalSuccess) {
                        originalSuccess(dataKYC);
                    }
                };
            }
            return originalAjax.call(this, options);
        };
    });

    // Clean up camera when modal is closed
    document.addEventListener('DOMContentLoaded', function() {
        // Close camera when clicking outside modal
        window.addEventListener('click', function(event) {
            const modal = document.getElementById("BiometricVerificationModal");
            if (event.target === modal) {
                closeBiometricVerificationModal();
            }
        });
    });

    // AJAX interceptor for Aadhaar verification - preserves all original functionality
    $(document).ready(function() {
        const originalAjax = $.ajax;
        $.ajax = function(options) {
            if (options.url === "/Aadhaar/SubmitOTPNumber" && options.type === "POST") {
                const originalSuccess = options.success;
                options.success = function(dataKYC) {
                    console.log("Intercepted Aadhaar verification response:", dataKYC);

                    // Set our verification variables for biometric modal
                    isAadhaarVerified = true;

                    // Update verification status for biometric modal
                    updateVerificationStatus();

                    // IMPORTANT: Call the original success callback to preserve all Aadhaar.js functionality
                    if (originalSuccess) {
                        originalSuccess(dataKYC);
                    }
                };
            }
            return originalAjax.call(this, options);
        };
    });
</script>
