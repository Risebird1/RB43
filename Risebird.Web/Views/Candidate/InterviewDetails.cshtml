@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            swal.fire("Successful", '@ViewBag.Message', "success");
        }
    </script>
}
<script>
    $(document).ready(function () {
        if ($("#txtMailstatus").val() == "Public") {
            var modal = document.getElementById("PublicShareMail");
            modal.style.display = "block";
        }
    });
    function SubmitEmail() {
        if ($("#txtcandidateEmailid").val().trim() != "") {
            localStorage.setItem('PublicEmailid', $("#txtcandidateEmailid").val());
            $.ajax({
                type: "POST",
                url: "/Candidate/CandidatePublicdetails",
                data: { id: $("#hidtxtid").val(), Emailid: $("#txtcandidateEmailid").val().trim(), irfId: $("#hidtxtIRFid").val() },
                success: function (data) {
                    if (data == "success") {
                        window.location = "/Candidate/VerifiedInterviewDetails?emailid=" + $("#txtcandidateEmailid").val() + "&id=" + $("#hidtxtid").val() + "&IRFid=" + $("#hidtxtIRFid").val();
                    } else {
                        swal.fire(data);
                    }
                }
            });
        }
    }
</script>
<script>
     $(function() {
        $(this).bind("contextmenu", function(e) {
            e.preventDefault();
        });
    }); 

    function openCity(evt, tabid) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tabcontent");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }

        tablinks = document.getElementsByClassName("tablinks");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(tabid).style.display = "block";
        evt.currentTarget.className += " active";
    }
    document.getElementById("defaultOpen").click();

    function ReschuduleMeeting(interviewid, uniqueid, irfid, candidateEmailid) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to cancel this meeting and reschedule?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Reschedule!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interview/GenerateRescheuleLink',
                        method: 'POST',
                        data: {
                            'CandidateEmailid': candidateEmailid,
                            'interviewid': interviewid,
                            'uniqueid': uniqueid,
                            'Irfid': irfid
                        },
                        success: function (result) {
                            location.href = result;
                            //window.open(result, '_blank');
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error rescheduling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                //location.reload(true);
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'reschedule cancelled! :)',
                    'error'
                )
            }
        })
    }

    function ComfirmMeeting(interviewid, uniqueid, irfid) {
        $.ajax({
            url: '/Interview/CandidateMeetingsStatus',
            method: 'GET',
            data: {
                'meetingid': interviewid,
                'status': 1,
                'uniqueid': uniqueid,
                'Irfid': irfid
            },
            success: function (result) {
                swal.fire("", "Thank you for confirming your availability!", "success");
            }
        })
    }
    function NotAttendMeeting(interviewid, uniqueid, irfid) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to cancel this meeting?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Cancel!',
            cancelButtonText: 'No',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interview/CandidateMeetingsStatus',
                        method: 'GET',
                        data: {
                            'meetingid': interviewid,
                            'status': 2,
                            'uniqueid': uniqueid,
                            'Irfid': irfid
                        },
                        success: function (result) {
                            swal.fire(result);
                            location.reload();
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error Cancelling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                //location.reload(true);
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'cancel aborted! :)',
                    'error'
                )
            }
        })
    }
</script>
<script>
    startTimer();
    function startTimer() {
        var presentTime1 = document.getElementsByClassName('timer');
        var presentTab = document.getElementsByClassName('time_tab');
        for (var i = 0; i < presentTime1.length; i++) {
            var presentTime = presentTime1[i].innerHTML + ':00';
            var timeArray = presentTime.split(/[:]+/);
            var m = timeArray[0];
            var s = checkSecond((timeArray[1] - 1));
            if (s == 59) { m = m - 1 }
            if (m < 0) {
                return
            }
            if (m >= 120) {
                presentTime1[i].style.display = 'none';
                presentTab[i].style.display = 'none';
            }
            else {
                presentTime1[i].style.display = 'block';
                presentTab[i].style.display = 'block';
            }
            presentTime1[i].innerHTML = m + ":" + s;
        }
        setTimeout(startTimer, 1000);
    }
    function checkSecond(sec) {
        if (sec < 10 && sec >= 0) { sec = "0" + sec };
        if (sec < 0) { sec = "59" };
        return sec;
    }
</script>
<script>
    var actionclick = 1;
    function captureclick(type, buttonaction) {
        var currenturl = window.location.href;
        if (actionclick == 1) {
            actionclick = 0;
            $.ajax({
                url: '/ActivityTracker/CapturePageClick',
                method: 'POST',
                async: true,
                data: {
                    'type': type,
                    'currenturl': currenturl,
                    'buttonaction': buttonaction
                },
                success: function (result) {
                    actionclick = 1;
                }
            });
        }
    }
</script>