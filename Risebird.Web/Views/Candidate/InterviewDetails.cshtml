        flex-direction: column;
        margin-bottom: 35px;
        height: inherit;
        border-bottom: none;
        /*    border-right: 1px solid rgba(10, 11, 49, 0.20);*/
    }

    .vertical-mdl-tabs .mdl-tabs__tab {
        width: 100%;
        height: 100px;
        line-height: 27px;
        box-sizing: border-box;
        letter-spacing: 2px;
        background: #f3f3f3;
    }

    .none {
        display: none;
    }

    .vertical-mdl-tabs.mdl-tabs.is-upgraded a.mdl-tabs__tab.is-active {
        border-left: 5px solid #ED462F;
        background: #fff;
    }

    .vertical-mdl-tabs.mdl-tabs.is-upgraded .mdl-tabs__tab.is-active:after {
        content: inherit;
        height: 0;
    }

    .vertical-mdl-tabs.mdl-tabs.is-upgraded .mdl-tabs__panel.is-active, .mdl-tabs__panel {
        padding: 0 0px;
    }

    .vertical-mdl-tabs.mdl-tabs .mdl-tabs__tab {
        text-align: left;
    }

    .small-txt {
        font-size: 11px;
    }

    .tab-div {
        position: relative;
        top: 19px;
    }

    .tab-txt {
        font-size: 14px;
    }

    header {
        font-family: 'Lobster', cursive;
        text-align: center;
        font-size: 25px;
    }

    #info {
        font-size: 18px;
        color: #555;
        text-align: center;
        margin-bottom: 25px;
    }

    a {
        color: #074E8C;
    }

    .scrollbar {
        width: 100%;
        float: left;
        height: 300px;
        /*background: #F5F5F5;*/
        overflow-y: scroll;
        margin-bottom: 25px;
    }

    .force-overflow {
        margin: 0px 10px 0px 0px;
        /*min-height: 450px;*/
    }



    /*
                                            *  STYLE 1
                                            */


    #style-4::-webkit-scrollbar {
        width: 5px;
        background-color: #F5F5F5;
    }

    #style-4::-webkit-scrollbar-thumb {
        background-color: #000000;
        border: 2px solid #555555;
    }



    .mdl-tabs__panel h1 {
        color: #000;
        font-weight: 500;
        font-size: 16px;
        text-transform: uppercase;
        float: left;
    }

    .panel-heading {
        padding: 0;
        border: 0;
    }

    .panel .panel-title {
        float: none !important;
        display: inline;
    }

    .panel-title > a, .panel-title > a:active {
        display: block;
        padding: 15px;
        color: #998e8e !important;
        font-size: 17px;
        font-weight: 500;
        padding: 0px;
        text-transform: uppercase;
        letter-spacing: 1px;
        word-spacing: 3px;
        text-decoration: none !important;
    }

    .panel-heading a:before {
        font-family: 'Glyphicons Halflings';
        content: "\e114";
        float: right;
        transition: all 0.5s;
        position: relative;
        right: 10px;
    }

    .panel-heading.active a:before {
        -webkit-transform: rotate(180deg);
        -moz-transform: rotate(180deg);
        transform: rotate(180deg);
    }
</style>
