<script>
    // Function to check if all InterviewCheckshowDisplay checkboxes are checked
    function checkAllCheckboxesStatus() {
        var allCheckboxes = $('input[name="InterviewCheckshowDisplay"]');
        var checkedCheckboxes = $('input[name="InterviewCheckshowDisplay"]:checked');
        var joinButton = $('#btnJoinInterview');
        var errorMsg = $('#checkboxErrorMsg');

        // Check if all checkboxes are checked
        if (allCheckboxes.length === checkedCheckboxes.length) {
            // All checkboxes checked - enable button and hide error
            joinButton.prop('disabled', false).removeClass('btn-disabled').addClass('btn-enabled');
            errorMsg.hide();
        } else {
            // Not all checkboxes checked - disable button and show error
            joinButton.prop('disabled', true).removeClass('btn-enabled').addClass('btn-disabled');
            errorMsg.show();
        }
    }

    // Add event listeners for InterviewCheckshowDisplay checkboxes
    $(document).ready(function() {
        // Initialize button state
        checkAllCheckboxesStatus();

        // Add change event handlers for InterviewCheckshowDisplay checkboxes
        $('input[name="InterviewCheckshowDisplay"]').off('change').on('change', function() {
            checkAllCheckboxesStatus();
        });
    })
</script>

<script>
    // Global variable to track which checkbox was unchecked
    var uncheckedCheckboxId = null;
    // Global variable to track where Need Clarity was called from
    var needClaritySource = null;

    function openInterviewerAlert() {
        var model = document.getElementById("InterviewerAlert");
        model.style.display = "block";

        // Uncheck all InterviewCheckshowDisplay checkboxes by default
        $('input[name="InterviewCheckshowDisplay"]').prop('checked', false);

        // Check all InterviewCheckshow checkboxes by default (existing behavior)
        $('input[name="InterviewCheckshow"]').prop('checked', true);

        // Add change event handlers for InterviewCheckshow checkboxes (existing behavior)
        $('input[name="InterviewCheckshow"]').off('change').on('change', function() {
            if (!$(this).is(':checked')) {
                // Store the unchecked checkbox ID
    @*uncheckedCheckboxId = $(this).ctx('id'); *@ 
                 uncheckedCheckboxId = $(this).attr('id');
                // Show confirmation modal
                openConsentConfirmationModal();
                // Prevent the checkbox from being unchecked until user confirms
                $(this).prop('checked', true);
            }
        });
        // Initialize button state for InterviewCheckshowDisplay checkboxes
        checkAllCheckboxesStatus();

        // Show error message initially since all checkboxes start unchecked
        $('#checkboxErrorMsg').show();
    }

    function closeInterviewerAlert() {
        var model = document.getElementById("InterviewerAlert");
        model.style.display = "none";
    }

    function openConsentConfirmationModal() {
        var modal = document.getElementById("ConsentConfirmationModal");
        modal.style.display = "block";
    }

    function closeConsentConfirmationModal() {
        var modal = document.getElementById("ConsentConfirmationModal");
        modal.style.display = "none";
    }

    function openFinalConfirmationModal() {
        var modal = document.getElementById("FinalConfirmationModal");
        modal.style.display = "block";
    }

    function closeFinalConfirmationModal() {
        var modal = document.getElementById("FinalConfirmationModal");
        modal.style.display = "none";
    }

    function proceedWithoutConsent() {
        closeConsentConfirmationModal();
        openFinalConfirmationModal();
    }

    function undoConsentUncheck() {
        closeConsentConfirmationModal();
        // Keep the checkbox checked (it's already checked due to the change handler)
    }

    function cancelInterview() {
        closeFinalConfirmationModal();

        // Use the same cancel functionality as Interview Controller Index page
        swal.fire({
            title: 'Are you sure?',
            text: "The Interview for @Model.CandidateDetails.Name under skill channel @Model.CandidateDetails.IRFName dated @Model.Meetings.FirstOrDefault()?.interviewDate will be cancelled! Cancelled meetings cannot be confirmed back.",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel it!',
            cancelButtonText: "Don't",
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/PublicCancelInterview',
                        type: 'POST',
                        data: {
                            'id': @ViewBag.Interviewid,
                            'interviewDate': '@Model.Meetings.FirstOrDefault()?.interviewDate',
                            'candidateEmail': '@Model.CandidateDetails.EmailId',
                            'emailId': '@Model.CandidateDetails.EmailId',
                            'IRFId': @Model.CandidateDetails.IRFId,
                            'zoomMeetingId': null
                        },
                        success: function (data) {
                            if (data != null && data.toLowerCase().includes('success')) {
                                resolve(data);
                            }
                            else {
                                swal.fire("Error cancelling!", "Please try again", "error");
                            }
                        },
                        error: function () {
                            swal.fire("Error cancelling!", "Please try again", "error");
                        }
                    });
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Cancelled!',
                    type: 'success',
                    html: '<p>Interview cancelled successfully.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    // Return to the original InterviewerAlert popup instead of redirecting
                    closeInterviewerAlert(); // Close any remaining modals
                    openInterviewerAlert(); // Reopen the original popup with checkboxes
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Not cancelled',
                    'The Interview has not been cancelled! :)',
                    'error'
                ).then(function () {
                    // Return to the original InterviewerAlert popup even if cancelled
                    closeInterviewerAlert(); // Close any remaining modals
                    openInterviewerAlert(); // Reopen the original popup with checkboxes
                })
            }
        });
    }

    function needClarity() {
        closeFinalConfirmationModal();
        closeInterviewerAlert();

        // Set the source to indicate this came from the InterviewAlert popup
        needClaritySource = 'InterviewAlert';

        // Use the existing Need Clarity functionality from the project
        // This opens the SendmailModal with pre-filled information for clarity request
        OpenSendmailModal(
    @ViewBag.Interviewid,
            '@Model.CandidateDetails.ClientHRAttemptContact',
            '@Model.CandidateDetails.Name',
            '@Model.CandidateDetails.EmailId',
    @Model.CandidateDetails.IRFId,
            '@Model.Uniqueid'
        );
    }
    function AcceptAIInterviewerAlert(){
        var result = $('input[name="InterviewCheckshowDisplay"]:checked');
        var resultString = '';

        // Button is disabled when not all checkboxes are checked, so no additional validation needed

        if (result.length > 0) {
            result.each(function () {
                if (resultString == '') {
                    resultString += $(this).val();
                } else {
                    resultString += "," + $(this).val();
                }
            });
        }
        $.ajax({
            type: "POST",
            url: "/Candidate/CandidateAcknowledge",
            data: { 'interviewid': @ViewBag.Interviewid, interviewchecks: resultString },
            success: function (data) {
                closeInterviewerAlert();
            }
        });
    }
    function AcceptInterviewerAlert(){
        var result = $('input[name="InterviewCheckshow"]:checked');
        var resultString = '';

        // Button is disabled when not all checkboxes are checked, so no additional validation needed

        if (result.length > 0) {
            result.each(function () {
                if (resultString == '') {
                    resultString += $(this).val();
                } else {
                    resultString += "," + $(this).val();
                }
            });
        }
        $.ajax({
            type: "POST",
            url: "/Candidate/CandidateAcknowledge",
            data: { 'interviewid': @ViewBag.Interviewid, interviewchecks: resultString },
            success: function (data) {
                closeInterviewerAlert();
            }
        });
    }
    // Custom override of SendNeedClearitymail function to return to appropriate location
    // This overrides the function from BroadcastMessage.js for this page only
    function SendNeedClearitymail() {
        var message = tinymce.activeEditor.getContent();
        var subject = document.getElementById("needClearitybcSubject").value;
        var interviewId = document.getElementById("hid_needClearityinterviewId").value;
        var clienthr = document.getElementById("hid_needClearityclienthr").value;
        var candidateemail = document.getElementById("hid_needClearitycandidateEmail").value;
        var Irfid = document.getElementById("hid_needClearityirfid").value;
        var uniqueid = document.getElementById("hid_needClearityuniqueid").value;
        $.ajax({
            type: "POST",
            url: "/Candidate/NeedClearityMail",
            data: { 'message': message, 'subject': subject, 'interviewId': interviewId, 'clienthr': clienthr, 'candidateemail': candidateemail, 'uniqueid': uniqueid, 'Irfid': Irfid },
            success: function (data) {
                swal.fire({
                    title: "Information shared to contact person, HR will Connect you soon.",
                    type: 'success',
                    confirmButtonText: "Close",
                    allowOutsideClick: false
                }).then(function () {
                    // Close the SendmailModal
                    closeSendmailModal();

                    // Return to appropriate location based on source
                    if (needClaritySource === 'InterviewAlert') {
                        // Return to the original InterviewerAlert popup with checkboxes
                        openInterviewerAlert();
                    } else {
                        // Return to the interview detail page (default behavior)
                        // This happens when called from other Need Clarity buttons on the page
                        // The page stays as is, no redirection needed
                    }

                    // Reset the source tracking
                    needClaritySource = null;
                });
            }
        });
    }

    // Wrapper function for direct OpenSendmailModal calls from other parts of the page
    function openNeedClarityFromPage(interviewId, clienthr, candidateName, candidateEmail, irfId, uniqueid) {
        $.ajax({
            url: '/Interview/CandidateMeetingsStatus',
            method: 'GET',
            data: {
                'meetingid': interviewId,
                'status': 4,
                'uniqueid': uniqueid,
                'Irfid': irfId
            },
            success: function (result) {
            }
        })
        // Set the source to indicate this came from the main page (not InterviewAlert popup)
        needClaritySource = 'Page';

        // Call the original OpenSendmailModal function
        OpenSendmailModal(interviewId, clienthr, candidateName, candidateEmail, irfId, uniqueid);
    }
</script>
