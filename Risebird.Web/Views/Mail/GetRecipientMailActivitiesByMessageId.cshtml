@model List<Risebird.Entities.ViewModel.MailRecipientActivityDetailsVM>
@using Newtonsoft.Json
@using Risebird.Entities.ViewModel
<style>
    
    .modal-xl {
        width: 80%;
        max-width:1200px;
    }
    /*table.fixedSize {
            table-layout: fixed;
            width: 100%;
        }*/
</style>
@{
    bool isNestedPopUp = ((bool)(ViewBag.isNestedPopUp ?? false));
}
@*@if(!isNestedPopUp)
{
    <style>
        .modal-backdrop {
            /* bug fix - no overlay */
            display: none;
        }
    </style>
}*@
@*<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css'>*@

<!-- Modal -->
<div class="modal fade" style="height:1000px" id="modalRecipientActivity" tabindex="-1" role="dialog" aria-labelledby="modalRecipientLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRecipientLabel">Activity Details for '@ViewBag.RecipientEmail'</h5>
                
                @if (!isNestedPopUp)
                {
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" style="margin-top: 5px; margin-right: -17px;">
                        <span aria-hidden="true">×</span>
                    </button>
                }
                
            </div>
            <div class="modal-body" id="recipientActivity_modal_body" style="max-height:400px; overflow:auto">


                @if (Model != null && Model.Count() > 0)
                {
                    <div class="scrollers" style="overflow-y:auto">
                        <table class="table table-bordered table-striped" cellpadding="0" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Mail Subject</th>
                                    <th>Mail Content</th>
                                    <th>Event/Activity</th>
                                    <th>Date</th>
                                    <th>Skill Channel</th>
                                    <th>Interview Date</th>
                                    <th>Url(In mail content)</th>
                                    <th>Sent By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowSpan = Model.Count();
                                    int maxCount = rowSpan - 1;
                                    for (int i = 0; i <= maxCount; i++)
                                    {
                                        var jsonObj = JsonConvert.SerializeObject(Model[i].MailBody);
                                                <tr>
                                                    @if (i == 0)
                                                    {
                                                        <td rowspan="@rowSpan" title="@Html.Raw(Model[i].MailSubject)">@Model[i].MailSubject</td>
                                                        <td rowspan="@rowSpan" >
                                                            <a onclick="OpenHtmlDocument(@jsonObj)" style="color:blue; cursor:pointer"><u>Content</u></a>
                                                        </td>
                                                    }
                                                    <td>@Model[i].eventType</td>
                                                    <td>@Model[i].CreatedAt</td>
                                                    @if (i == 0)
                                                    {
                                                        <td rowspan="@rowSpan">@Model[i].SkillChannelName</td>
                                                        <td rowspan="@rowSpan">@Model[i].interviewDate</td>
                                                    }
                                                    
                                                    @if (!string.IsNullOrEmpty(Model[i].url))
                                                    {
                                                        <td title="@Model[i].url">URL</td>

                                                    }
                                                    else
                                                    {
                                                        <td>NA</td>
                                                    }
                                                    @if (i == 0)
                                                    {
                                                        <td rowspan="@rowSpan">@Model[i].SentBy</td>
                                                    }
                                                </tr>
                                    }
                                }

                                    
                                    
                                    
                            </tbody>
                            
                        </table>
                    </div>

                }
            </div>
            @if (isNestedPopUp)
            {
                <div class="modal-footer">
                    <button class="btn btn-primary" data-bs-target="#modalCommunicationDetails" data-bs-toggle="modal" data-bs-dismiss="modal">Back</button>

                </div>
            }
            
        </div>
    </div>
</div>

