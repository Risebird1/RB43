                                    <div class="col-md-12">
                                        <div class="form-group second">
                                            <label>    <b>SUBJECT</b></label>
                                            @Html.TextBoxFor(model => model.Subject,
                                         htmlAttributes: new { @class = "form-control", maxlength = 100, placeholder = "Mail Subject", required = "required" })
                                        </div>

                                    </div>
                                </div>
                                <div class="row">
                                    @*<label class="col-md-3 control-label">BODY :</label>*@
                                    <div class="col-md-12">
                                        <div class="form-group three" style="margin-bottom:10px;">
                                            <label>   <b>BODY</b></label>
                                            @Html.TextAreaFor(model => model.Body,
                                            htmlAttributes: new { @class = "form-control", maxlength = 5000, style = "height: 200px", placeholder = "Mail Body", required = "required" })
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="card-footer ">
                            <div class="row">

                                <div class="col-md-12 mc-button-area four">
                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Send">Send</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>




}
