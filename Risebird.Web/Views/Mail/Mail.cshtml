@model Risebird.Entities.ViewModel.Mail
@{
    ViewData["Title"] = "Mail";
    ViewBag.PageHeader = "Mail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<script src="~/js/CustomValidation/EmailValidation.js?v=2024"></script>
@using (Html.BeginForm("Mail", "Mail", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return validateEmail()" }))
{

    @Html.AntiForgeryToken()

    <div class="main-panel" id="main-panel">

        <div class="panel-header panel-header-sm">
        </div>
        <div class="content mail">
            <div class="row">
                <div class="col-md-8">
                    <div class="mdc-card card">

                        <div class="mdc-card-wrapper__text-section">

                            <form>

                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    @*<label class="col-md-3 control-label">BODY :</label>*@

                                    <div class="card-header">
                                        <h5>Mail</h5>
                                    </div>
                                    <div style="width:100%; float:left; height:10px;"></div>
                                    <div class="col-md-12">

                                        <div class="form-group first">
                                            <label> <b>TO</b></label>

                                            @Html.EditorFor(model => model.TO, new { htmlAttributes = new { @class = "form-control", placeholder = "Use ';' for multiple sender", required = "required" } })
                                            @Html.ValidationMessageFor(model => model.TO, "", new { @class = "text-danger" })
                                            <label class="text-danger" id="checkTo" style="color:red"></label>

                                        </div>

                                    </div>
                                </div>
                                <div class="row">
                                    @*<label class="col-md-3 control-label">BODY :</label>*@
                                    <div class="col-md-12">
                                        <div class="form-group second">
                                            <label>    <b>SUBJECT</b></label>
                                            @Html.TextBoxFor(model => model.Subject,
                                         htmlAttributes: new { @class = "form-control", maxlength = 100, style = "width:100%", placeholder = "Mail Subject", required = "required" })
                                        </div>

                                    </div>
                                </div>
                                <div class="row">
                                    @*<label class="col-md-3 control-label">BODY :</label>*@
                                    <div class="col-md-12">
                                        <div class="form-group three" style="margin-bottom:10px;">
                                            <label>   <b>BODY</b></label>
                                            @Html.TextAreaFor(model => model.Body,
                                            htmlAttributes: new { @class = "form-control", maxlength = 5000, style = "height: 200px;width:100%", placeholder = "Mail Body", required = "required" })
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="card-footer ">
                            <div class="row">

                                <div class="col-md-12 mc-button-area four">
                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Send">Send</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>




}
<!-- PAGE CONTENT WRAPPER -->
<loading></loading>
