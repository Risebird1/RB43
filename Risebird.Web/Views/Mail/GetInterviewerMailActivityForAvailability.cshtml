<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#mailsTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#mailsTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#mailsTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>


<script>
    function closeinterviewerFlagDetailsModal() {
        var modal = document.getElementById("interviewerFlagDetailsModal");
        modal.style.display = "none";
    }
    function OpenInterviewerFlagDetails(Emailid) {
        $.ajax({
            url: '/Interviewer/FetchInterviewerFlagDetails',
            data: { 'InterviewerEmailid': Emailid },
            success: function (data) {
                var modal = document.getElementById("interviewerFlagDetailsModal");
                modal.style.display = "block";
                $('#FlagDetailsTablebody').html('');
                $('#FlagDetailsTablebody').html(data);
            }
        });
    }

</script>









