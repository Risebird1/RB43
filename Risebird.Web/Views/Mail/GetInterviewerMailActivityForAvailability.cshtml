    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Interviewer Mail Activity For Availability (@ViewBag.IrfName) </h4></div>
                </div>

                @*<div class="pull-right">
                    <div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>

                    </div>
                </div>*@
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">


                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="mailsTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th style="width:20%">Mail Subject</th>
                                                    <th>Mail Body</th>
                                                    <th>Sent On</th>
                                                    <th>Sent By</th>
                                                    <th>Opened By</th>
                                                    <th>Call</th>
                                                    <th>Mobile Number</th>
                                                    <th>Company Name</th>
                                                    <th>Resume</th>
                                                    <th>Video Confirmation</th>
                                                    

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th style="width:20%">Mail Subject</th>
                                                    <th>Mail Body</th>
                                                    <th>Sent On</th>
                                                    <th>Sent By</th>
                                                    <th>Opened By</th>
                                                    <th>Call</th>
                                                    <th>Mobile Number</th>
                                                    <th>Company Name</th>
                                                    <th>Resume</th>
                                                    <th>Video Confirmation</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    //var finalList = new List<MailRecipientActivityDetailsVM>();
                                                    var workingModel = Model.ToList();
                                                    foreach (var entry in workingModel)
                                                    {
                                                        var firstValue = workingModel?.FirstOrDefault()?.CreatedAt;
                                                        if(firstValue !=null && workingModel !=null && workingModel.Count() > 0)
                                                        {
                                                            var first = firstValue.Value;
                                                            var sameGroupOfMails = workingModel.Where(x => Convert.ToInt32((x.CreatedAt - first).TotalMinutes) <= 2 && Convert.ToInt32((x.CreatedAt - first).TotalMinutes) >= -1).ToList();
                                                            var subModel = sameGroupOfMails.Select(x => new { MailSubject = x.MailSubject, MailBody = x.MailBody, SentBy = x.SentBy, email = x.email, MobileNumber = x.MobileNumber, RecipientName = x.RecipientName, ResumeLink =  x.ResumeLink, CompanyName = x.CompanyName, VideoConfirmation = x.VideoConfirmation}).Distinct().ToList();
                                                            int rowSpan = subModel.Count();
                                                            int maxCount = rowSpan - 1;
                                                            for (int i = 0; i <= maxCount; i++)
                                                            {
                                                                var jsonObj = JsonConvert.SerializeObject(subModel[i].MailBody);
                                                                <tr>
                                                                    @if (i == 0)
                                                                    {
                                                                        <td rowspan="@rowSpan">
                                                                            @if (subModel[i].MailSubject != null && subModel[i].MailSubject != "")
                                                                            {
                                                                                @if (subModel[i].MailSubject.Length > 30)
                                                                                {
                                                                                    <div class="article">
                                                                                        <p style="margin-bottom:0px;">
                                                                                            @subModel[i].MailSubject.Substring(0, 30)
                                                                                        </p>
                                                                                        <p class="moretext_@i moretext">
                                                                                            @subModel[i].MailSubject.Substring(30, @subModel[i].MailSubject.Length - 30)
                                                                                        </p>
                                                                                    </div>
                                                                                    <a onclick="moreless('@i')" class="moreless-button" value="Readmore" id="read_@i" href="#">Read more</a>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="article">
                                                                                        <p>
                                                                                            @subModel[i].MailSubject.Substring(0, @subModel[i].MailSubject.Length)
                                                                                        </p>
                                                                                    </div>
                                                                                }
                                                                            }
                                                                        </td>
                                                                        <td rowspan="@rowSpan">
                                                                            <a onclick="OpenHtmlDocument(@jsonObj)" style="color:blue; cursor:pointer"><u>Content</u></a>
                                                                        </td>

                                                                        <td rowspan="@rowSpan">@first</td>

                                                                        <td rowspan="@rowSpan" title="@subModel[i].SentBy">@subModel[i].SentBy</td>

                                                                    }
                                                                    <td title="@subModel[i].email">@subModel[i].email</td>

                                                                    <td>
                                                                        @if (subModel[i].MobileNumber != null && subModel[i].MobileNumber != string.Empty)
                                                                        {
                                                                            <span class="interviewer_14"><span class="call" data-toggle="tooltip" data-placement="top" onclick="CallButtonClickInterviewer('@subModel[i].RecipientName', '@subModel[i].MobileNumber','@subModel[i].email')" data-original-title="Tooltip on top"><span title="Click here to call the interviewer" class="mdc-fab app-fab--absolute" style="top: -3px;left:1px;"><span class="fa fa-phone-alt"></span></span></span></span>

                                                                        }

                                                                    </td>
                                                                    @if (subModel[i].MobileNumber != null && subModel[i].MobileNumber != string.Empty)
                                                                    {
                                                                        <td> @subModel[i].MobileNumber</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td></td>

                                                                    }
                                                                    @if (subModel[i].CompanyName != null && subModel[i].CompanyName != string.Empty)
                                                                    {
                                                                        <td>

                                                                            @if (subModel[i].CompanyName.Length > 20)
                                                                            {
                                                                                <div class="article">
                                                                                    <p style="margin-bottom:0px;">
                                                                                        @subModel[i].CompanyName.Substring(0, 20)
                                                                                    </p>
                                                                                    <p class="moretext_@i moretext">
                                                                                        @subModel[i].CompanyName.Substring(20, @subModel[i].CompanyName.Length - 20)
                                                                                    </p>
                                                                                </div>
                                                                                <a onclick="moreless('@i')" class="moreless-button" value="Readmore" id="read_@i" href="#">Read more</a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="article">
                                                                                    <p>
                                                                                        @subModel[i].CompanyName.Substring(0, @subModel[i].CompanyName.Length)
                                                                                    </p>
                                                                                </div>
                                                                            }

                                                                        </td>

                                                                    }
                                                                    else
                                                                    {
                                                                        <td>
                                                                        </td>
                                                                    }
                                                                    @if (subModel[i].VideoConfirmation.HasValue)
                                                                    {
                                                                        @if (subModel[i].VideoConfirmation == 1)
                                                                        {
                                                                            <td>Yes</td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td>No</td>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Response</td>
                                                                    }
                                                                    @if (subModel[i].ResumeLink != null && subModel[i].ResumeLink != "")
                                                                    {
                                                                        <td>

                                                                            <a style="background:none!important;border:0px!important; text-decoration: underline; color: #039BE5!important;" id="resumeId" target="_blank" title="Resume" href=@subModel[i].ResumeLink><img style="position:relative;left:-5px;" src="/img/resume-icon.png" width="21">Resume</a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Resume</td>
                                                                    }

                                                                </tr>

                                                            }
                                                            workingModel = workingModel.Except(sameGroupOfMails).ToList();
                                                        }
                                                        
                                                    }


                                                    
                                                }

                                            </tbody>

                                        </table>

                                    </div>
                                </div>

                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

                    @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")


            </div>
        </div>


    </div>

</div>

</div>

