    //string[] TemplateName = new string[] { };
    //string[] CompetencyLevel = new string[] { };
    //string[] SeniorityLevel = new string[] { };
    //string[] CountryType = new string[] { };
    //string[] CompanyType = new string[] { };
    //string[] EmploymentType = new string[] { };
    //string[] DifficultyLevel = new string[] { };
    string AssessmentGroupTemplate = string.Empty;
    string SeniorityLevel = string.Empty;
    string CountryType = string.Empty;
    string CompanyType = string.Empty;
    string EmploymentType = string.Empty;
    string DifficultyLevel = string.Empty;
    string Category = string.Empty;
    string[] PrimarySkills = new string[] { };
