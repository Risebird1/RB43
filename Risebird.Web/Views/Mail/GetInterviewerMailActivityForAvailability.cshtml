@model IEnumerable<Risebird.Entities.ViewModel.MailRecipientActivityDetailsVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Interviewer Mail Activity For Availability";
    ViewBag.PageHeader = "Interviewer Mail Activity For Availability";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    //string[] TemplateName = new string[] { };
    //string[] CompetencyLevel = new string[] { };
    //string[] SeniorityLevel = new string[] { };
    //string[] CountryType = new string[] { };
    //string[] CompanyType = new string[] { };
    //string[] EmploymentType = new string[] { };
    //string[] DifficultyLevel = new string[] { };
    string AssessmentGroupTemplate = string.Empty;
    string SeniorityLevel = string.Empty;
    string CountryType = string.Empty;
    string CompanyType = string.Empty;
    string EmploymentType = string.Empty;
    string DifficultyLevel = string.Empty;
    string Category = string.Empty;
    string[] PrimarySkills = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("ClonableTemplatesFilters") != null)
{
    filter = JsonConvert.DeserializeObject<ClonableTemplatesFilter>(HttpContextAccessor.HttpContext.Session.GetString("ClonableTemplatesFilters"));
    //TemplateName = filter.TemplateName != null ? filter.TemplateName : new string[] { };
    //CompetencyLevel = filter.CompetencyLevel != null ? filter.CompetencyLevel : new string[] { };
    SeniorityLevel = filter.SeniorityLevel != null ? filter.SeniorityLevel : string.Empty;
    CountryType = filter.CountryType != null ? filter.CountryType : string.Empty;
    CompanyType = filter.CompanyType != null ? filter.CompanyType : string.Empty;
    EmploymentType = filter.EmploymentType != null ? filter.EmploymentType : string.Empty;
    DifficultyLevel = filter.DifficultyLevel != null ? filter.DifficultyLevel : string.Empty;
    AssessmentGroupTemplate = filter.AssessmentGroupTemplate != null ? filter.AssessmentGroupTemplate : string.Empty;
    Category = filter.Category != null ? filter.Category : string.Empty;
    PrimarySkills = filter.PrimarySkills != null ? filter.PrimarySkills : string.Empty;
}

