@model IEnumerable<Risebird.Entities.ViewModel.MailRecipientActivityDetailsVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.Data
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Mail Recipients";
    ViewBag.PageHeader = "Mail Recipients";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] SkillChannel = new string[] { };
    string[] Activity = new string[] { };
    string[] SentBy = new string[] { };
    string[] Recipient = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("MailActivityFilters") != null)
{
    filter = JsonConvert.DeserializeObject<MailActivityFilter>(HttpContextAccessor.HttpContext.Session.GetString("MailActivityFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
    SkillChannel = filter.SkillChannel != null ? filter.SkillChannel : new string[] { };
    Activity = filter.Activity != null ? filter.Activity : new string[] { };
    SentBy = filter.SentBy != null ? filter.SentBy : new string[] { };
    Recipient = filter.Recipient != null ? filter.Recipient : new string[] { };
}
<script>
    var Header = "<div>Mail Recipients</div>";
    $('#txtpageHeader').empty().html(Header);
</script>


