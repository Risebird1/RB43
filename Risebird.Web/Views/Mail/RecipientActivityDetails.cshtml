                                            <tr>
                                                <th>Recipient</th>
                                                <th style="width:20%">Mail Subject</th>
                                                <th>Mail Content</th>
                                                <th>Sent On</th>
                                                <th>Sent By</th>
                                                <th>Latest Activity/Status</th>
                                                <th>Activity/Status Date</th>
                                                <th>Skill Channel Name</th>
                                                <th>Interview Date</th>
                                                <th style="text-align:center">Activity Details</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Recipient</th>
                                                <th style="width:20%">Mail Subject</th>
                                                <th>Mail Content</th>
                                                <th>Sent On</th>
                                                <th>Sent By</th>
                                                <th>Latest Activity/Status</th>
                                                <th>Activity/Status Date</th>
                                                <th>Skill Channel Name</th>
                                                <th>Interview Date</th>
                                                <th style="text-align:center">Activity Details</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @if (Model != null && Model.Count() > 0)
                                            {
                                                int i = 1;
                                                foreach (var item in Model)
                                                {
                                                    var jsonObj = JsonConvert.SerializeObject(item.MailBody);
                                                    <tr>

                                                        <td>@item.email</td>
@*                                                        <td  style="white-space: break-spaces;word-break:break-word" title="@item.MailSubject">@item.MailSubject</td>
*@                                                        <td>
                                                            @if (item.MailSubject != null && item.MailSubject != "")
                                                            {
                                                                @if (item.MailSubject.Length > 40)
                                                                {
                                                                    <div class="article">
                                                                        <p style="margin-bottom:0px;">
                                                                            @item.MailSubject.Substring(0, 40)
                                                                        </p>
                                                                        <p class="moretext_@i moretext">
                                                                            @item.MailSubject.Substring(40, @item.MailSubject.Length - 40)
                                                                        </p>
                                                                    </div>
                                                                    <a onclick="moreless('@i')" class="moreless-button" value="Readmore" id="read_@i" href="#">Read more</a>
                                                                }
                                                                else
                                                                {
                                                                    <div class="article">
                                                                        <p>
                                                                            @item.MailSubject.Substring(0, @item.MailSubject.Length)
                                                                        </p>
                                                                    </div>
                                                                }
                                                            }
                                                        </td>
                                                        <td>
                                                            <a onclick="OpenHtmlDocument(@jsonObj)" style="color:blue; cursor:pointer"><u>Content</u></a>
                                                        </td>
                                                        <td>@item.SentOn</td>
                                                        <td>@item.SentBy</td>
                                                        <td>@item.latestEvent</td>
                                                        <td>@item.ActivityDate</td>
                                                        <td>@item.SkillChannelName</td>
                                                        <td>@item.interviewDate</td>
                                                        <td>

                                                            <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Click here to view recipient activity upon recieving email." style="position:relative;top:-1px;left:2px;" data-toggle="ajax-modal-recipientActivity" data-target="#modalRecipientActivity" data-url="@Url.Action("GetRecipientMailActivitiesByMessageId","Mail", new { recipientEmail = item.email, messageId = item.sg_message_id})">
                                                                <span title="Click here to view recipient activity upon recieving email." class="mdc-fab__icon material-icons"><i style="font-size:16px;" class="fa fa-envelope-open"></i></span>
                                                            </button>

                                                        </td>
                                                    </tr>
                                                    i = i + 1;
                                                }
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->
        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
<!-- end row -->

<div id="modal_recipientActivity_placeholder"></div>

<script src="~/js/ModalFormServerValidation.js"></script>

<script type="text/javascript">

    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

    });
    function ResetFilter() {
        window.location.href = "/Mail/ResetRecipientActivityDetails";
    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var skillChannel = @Html.Raw(Json.Serialize(SkillChannel));
        var activity = @Html.Raw(Json.Serialize(Activity));
        var sentBy = @Html.Raw(Json.Serialize(SentBy));
        var recipient = @Html.Raw(Json.Serialize(Recipient));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#SkillChannel").val(skillChannel);
        $("#Activity").val(activity);
        $("#SentBy").val(sentBy);
        $("#Recipient").val(recipient);

    }

</script>
