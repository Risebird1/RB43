                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("RecipientActivityDetails","Mail", new { recipientType = ViewBag.recipientType})" method="post" id="form">
                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SkillChannel">
                                                                Skill Channel
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="SkillChannel" name="SkillChannel" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                    @foreach (var item in Model.Select(x => x.SkillChannelName).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">Latest Activity</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Activity" name="Activity" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                    @foreach (var item in Model.Select(x => x.latestEvent).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SentBy">
                                                                Sent By
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="SentBy" name="SentBy" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                    @foreach (var item in Model.Select(x => x.SentBy).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Recipient">Recipient</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Recipient" name="Recipient" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                    @foreach (var item in Model.Select(x => x.email).Distinct().ToList())
                                                                    {
