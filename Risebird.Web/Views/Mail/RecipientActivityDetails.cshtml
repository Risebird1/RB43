@*                                                    <input id="RecipientType" value="@ViewBag.recipientType" type="hidden"/>
*@                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 10px 0px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>
                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 10px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
