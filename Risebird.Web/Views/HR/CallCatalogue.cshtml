<script>
    function closemyCallRecords() {
        var modal = document.getElementById("myCallRecords");
        modal.style.display = "none";
    }
    function FetchRecording(candidateEmailid, Irfid) {
        $.ajax({
            type: "POST",
            url: "/User/FetchRecordings",
            data: { 'candidateEmailid': candidateEmailid, 'irfid': Irfid },
            success: function (data) {
                bindCallData(data);
                var modal = document.getElementById("myCallRecords");
                modal.style.display = "block";
                $("#candidate_email_pop").text(candidateEmailid);
            }
        });
    }
    function bindCallData(data) {
        var html = '';
        for (var i = 0; i < data.length; i++) {
            html += '<tr>';
            html += '<td>' + data[i].whoCalled + '</td>';
            html += '<td>' + data[i].calledOn.replace("T", " ").replace(".000", "") + '</td>';
            html += '<td><audio controls><source src = "' + data[i].recordingUrl + '" type = "audio/ogg" ><source src="' + data[i].recordingUrl + '" type="audio/mpeg"></audio></td>';
            html += '</tr>';
        }
        if (data.length == 0) {
            html = '<td colspan="3" style="text-align:center">No call records founds.</td>';
        }
        $("#tblcallrecdetails").empty().html(html);
    }
</script>

