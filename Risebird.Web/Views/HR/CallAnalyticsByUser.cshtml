@model IEnumerable<Risebird.Entities.ViewModel.CallRecordingDataVM>
@{
    ViewData["Title"] = "Call Analytics — " + (ViewBag.caller as string);
    ViewBag.PageHeader = "Call Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var caller = ViewBag.caller as string;
    var type = ViewBag.type as string;
    var from = ViewBag.from as string;
    var to = ViewBag.to as string;
}
<script>
    var Header = "<div>Call Analytics</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        <h4 class="card-title">Calls by @caller</h4>
                    </div>
                    <div class="pull-right client-ms">
                        <button type="button" class="mdc-button mdc-button--outlined mdc-ripple-upgraded card-title-space" onclick="location.href='@Url.Action("CallAnalytics", "HR", new { type, from, to })'">
                            <span class="mdc-button__label"><font style="font-family: Roboto, sans-serif; font-size:12px;">Back to summary</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <p>Date range: @from to @to @(string.IsNullOrEmpty(type) ? "" : " · " + type)</p>
                            <div id="tableID" class="second interview">
                                <table id="analyticsByUserTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Call recipient</th>
                                            <th>Type</th>
                                            <th>Called at</th>
                                            <th>Duration (s)</th>
                                            <th>Recording</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.CallRecipient</td>
                                                    <td>@item.RecipientProfileType</td>
                                                    <td>@item.DateCreated</td>
                                                    <td>@item.Duration</td>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(item.RecordingUri))
                                                        {
                                                            <audio controls preload="none" src="@item.RecordingUri"></audio>
                                                        }
                                                        else
                                                        {
                                                            <span>—</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#analyticsByUserTable').DataTable();
    });
</script>
