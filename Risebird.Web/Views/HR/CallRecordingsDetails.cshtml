@model IEnumerable<Risebird.Entities.ViewModel.CallRecordingDataVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.ViewModel
@using Risebird.Web.Controllers
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Call Recordings Details";
    ViewBag.PageHeader = "Call Recordings Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;

    string currentType = ViewBag.type ?? "Candidate";
    bool showPricing = ViewBag.Profile == "Admin" || ViewBag.Profile == "SupportAdmin";
    var calls = (Model ?? Enumerable.Empty<CallRecordingDataVM>()).ToList();

    int totalCalls = calls.Count;
    int recordedCalls = calls.Count(x => !string.IsNullOrWhiteSpace(x.RecordingUri));
    int talkSeconds = calls.Sum(x => HRController.ParseDurationSeconds(x.Duration));
    int callers = calls.Select(x => (x.Caller ?? string.Empty).Trim().ToLower()).Distinct().Count();

    Func<int, string> fmt = s => s >= 3600
        ? string.Format("{0}h {1:00}m", s / 3600, (s % 3600) / 60)
        : string.Format("{0}m {1:00}s", s / 60, s % 60);
    Func<int, string> clock = s => string.Format("{0}:{1:00}", s / 60, s % 60);
    Func<string, string> initial = s => string.IsNullOrWhiteSpace(s) ? "?" : s.Trim().Substring(0, 1).ToUpper();
}
@if (HttpContextAccessor.HttpContext.Session.GetString("CallRecordingsfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("CallRecordingsfilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
@{
    string rangeLabel = (!string.IsNullOrEmpty(strtDte) || !string.IsNullOrEmpty(endDte))
        ? ((string.IsNullOrEmpty(strtDte) ? "…" : strtDte) + " to " + (string.IsNullOrEmpty(endDte) ? "today" : endDte))
        : "Last 7 days";
}
<script>
    var Header = "<div>Call Recordings Details</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<style>
    /* All rules scoped to .cax-page so site-wide table styles cannot interfere (same look as Call Analytics) */
    .cax-page { --cax-blue: #2196f3; --cax-blue-soft: #e3f2fd; --cax-green: #2e7d32; --cax-green-soft: #e8f5e9;
                --cax-grey: #5f6b7a; --cax-grey-soft: #eef1f5; --cax-border: #e4e8ee; --cax-text: #1f2a37; --cax-muted: #6b7686;
                font-family: Roboto, sans-serif; color: var(--cax-text); }

    .cax-page .cax-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; justify-content: space-between; margin-bottom: 16px; }
    .cax-page .cax-tabs { display: inline-flex; background: #fff; border: 1px solid var(--cax-border); border-radius: 8px; padding: 3px; }
    .cax-page .cax-tab { border: 0; background: transparent; padding: 7px 16px; border-radius: 6px; font-size: 13px; font-weight: 500; color: var(--cax-muted); cursor: pointer; }
    .cax-page .cax-tab:hover { color: var(--cax-text); }
    .cax-page .cax-tab.active { background: var(--cax-blue); color: #fff; }
    .cax-page .cax-filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin: 0; }
    .cax-page .cax-filters label { display: block; font-size: 11px; font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: var(--cax-muted); margin: 4px 0px; }
    .cax-page .cax-filters .form-control { height: 36px; min-width: 150px; border: 1px solid var(--cax-border); border-radius: 6px; background: #fff; font-size: 13px; }
    .cax-page .cax-hint { font-size: 11px; color: var(--cax-muted); margin-top: 4px; }

    .cax-page .cax-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 18px; }
    .cax-page .cax-tile { background: #fff; border: 1px solid var(--cax-border); border-radius: 8px; padding: 12px 14px; }
    .cax-page .cax-tile-label { font-size: 12px; color: var(--cax-muted); }
    .cax-page .cax-tile-value { font-size: 24px; font-weight: 600; margin-top: 2px; font-variant-numeric: tabular-nums; }
    .cax-page .cax-tile-sub { font-size: 11px; color: var(--cax-muted); margin-top: 2px; }

    .cax-page .cax-card { background: #fff; border: 1px solid var(--cax-border); border-radius: 8px; overflow: hidden; }
    .cax-page .cax-card-head { padding: 12px 16px; border-bottom: 1px solid var(--cax-border); }
    .cax-page .cax-card-title { font-size: 15px; font-weight: 600; margin: 0; }
    .cax-page .cax-card-sub { font-size: 12px; color: var(--cax-muted); }
    .cax-page .cax-table-wrap { padding: 4px 12px 12px; overflow-x: auto; }

    .cax-page table.cax-table { width: 100% !important; border: 0 !important; border-collapse: separate; border-spacing: 0; font-size: 13px; }
    .cax-page table.cax-table thead th { background: #f7f9fb !important; color: var(--cax-muted); font-size: 11px; font-weight: 600 !important; letter-spacing: .04em;
                                         text-transform: uppercase; padding: 10px 12px !important; border: 0 !important; border-bottom: 1px solid var(--cax-border) !important; white-space: nowrap; }
    .cax-page table.cax-table tbody td { padding: 12px !important; border: 0 !important; border-bottom: 1px solid #f0f2f5 !important; vertical-align: middle !important; background: #fff; }
    .cax-page table.cax-table tbody tr:hover td { background: #f7fbff; }
    .cax-page table.cax-table .cax-right { text-align: right; }

    .cax-page .cax-person { display: flex; align-items: center; gap: 10px; min-width: 190px; }
    .cax-page .cax-avatar { flex: 0 0 30px; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 13px; }
    .cax-page .cax-avatar-caller { background: var(--cax-blue-soft); color: #1565c0; }
    .cax-page .cax-avatar-recipient { background: var(--cax-grey-soft); color: var(--cax-grey); }
    .cax-page .cax-name { word-break: break-all; }
    .cax-page .cax-date { font-weight: 500; white-space: nowrap; }
    .cax-page .cax-sub { font-size: 11px; color: var(--cax-muted); margin-top: 2px; }
    .cax-page .cax-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .cax-page audio.cax-audio { height: 34px; width: 250px; max-width: 100%; }
    .cax-page .cax-norec { font-size: 12px; color: #9aa4b2; white-space: nowrap; }
    .cax-page .cax-empty { text-align: center; padding: 40px 16px; color: var(--cax-muted); }
    .cax-page .cax-empty i { font-size: 28px; color: #c5ccd6; display: block; margin-bottom: 8px; }
</style>

<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        <div class="mobile-view"> <h4 class="card-title">Call Recordings Details</h4></div>
                    </div>
                    <div class="pull-right client-ms">
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" onclick="location.href='@Url.Action("CallCatalogue", "HR", new { type = "Candidate" })'">
                            <font style="font-family: Roboto, sans-serif; font-size:12px;">Archived Data</font>
                        </button>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" onclick="location.href='/HR/CallAnalytics'">
                            <font style="font-family: Roboto, sans-serif; font-size:12px;">Call Analytics</font>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="cax-page">

                        <div class="cax-toolbar">
                            <div class="cax-tabs" role="tablist">
                                <button type="button" class="cax-tab @(currentType == "Candidate" ? "active" : "")" onclick="Changeurldetails('Candidate')">Candidate</button>
                                <button type="button" class="cax-tab @(currentType == "Interviewer" ? "active" : "")" onclick="Changeurldetails('Interviewer')">Interviewer</button>
                                <button type="button" class="cax-tab @(currentType != "Candidate" && currentType != "Interviewer" ? "active" : "")" onclick="Changeurldetails('Other')">Others</button>
                            </div>

                            <form action="@Url.Action("CallRecordingsDetails", "HR", new { type = currentType })" method="post" id="form" class="cax-filters" onsubmit="return checkfilterDate();">
                                <div>
                                    <label for="StartDate">Start date</label>
                                    <input id="StartDate" name="StartDate" type="date" class="form-control" value="@strtDte" />
                                </div>
                                <div>
                                    <label for="EndDate">End date</label>
                                    <input id="EndDate" name="EndDate" type="date" class="form-control" value="@endDte" />
                                </div>
                                <div>
                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded"><font style="font-size:12px;">Apply</font></button>
                                    <button type="button" class="mdc-button mdc-button--outlined mdc-ripple-upgraded" onclick="ResetFilter('@currentType')"><font style="font-size:12px;">Reset</font></button>
                                    <div class="cax-hint">Maximum range: 45 days</div>
                                </div>
                            </form>
                        </div>

                        <div class="cax-tiles">
                            <div class="cax-tile"><div class="cax-tile-label">Calls</div><div class="cax-tile-value">@totalCalls</div><div class="cax-tile-sub">@rangeLabel</div></div>
                            <div class="cax-tile"><div class="cax-tile-label">Callers</div><div class="cax-tile-value">@callers</div></div>
                            <div class="cax-tile"><div class="cax-tile-label">With recording</div><div class="cax-tile-value">@recordedCalls</div><div class="cax-tile-sub">@(totalCalls == 0 ? 0 : (int)Math.Round(recordedCalls * 100.0 / totalCalls))% of calls</div></div>
                            <div class="cax-tile"><div class="cax-tile-label">Talk time</div><div class="cax-tile-value">@fmt(talkSeconds)</div></div>
                        </div>

                        <div class="cax-card">
                            <div class="cax-card-head">
                                <h5 class="cax-card-title">@(currentType == "Candidate" ? "Calls to candidates" : currentType == "Interviewer" ? "Calls to interviewers" : "Calls to others")</h5>
                                <div class="cax-card-sub">@rangeLabel</div>
                            </div>

                            @if (totalCalls > 0)
                            {
                                <div class="cax-table-wrap">
                                    <table id="recordingsTable" class="cax-table" cellspacing="0">
                                        <thead>
                                            <tr>
                                                <th>Caller</th>
                                                <th>Call recipient</th>
                                                <th>Called at</th>
                                                <th class="cax-right">Duration</th>
                                                @if (showPricing)
                                                {
                                                    <th class="cax-right">Price</th>
                                                    <th>Price unit</th>
                                                    <th>Recipient phone</th>
                                                }
                                                <th>Recording</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in calls)
                                            {
                                                var seconds = HRController.ParseDurationSeconds(item.Duration);
                                                string price = item.Price;
                                                if (!string.IsNullOrEmpty(price) && price.IndexOf("-") == 0)
                                                {
                                                    price = price.Remove(0, 1);
                                                }
                                                <tr>
                                                    <td data-order="@item.Caller">
                                                        <div class="cax-person">
                                                            <div class="cax-avatar cax-avatar-caller">@initial(item.Caller)</div>
                                                            <div class="cax-name">@item.Caller</div>
                                                        </div>
                                                    </td>
                                                    <td data-order="@item.CallRecipient">
                                                        <div class="cax-person">
                                                            <div class="cax-avatar cax-avatar-recipient">@initial(item.CallRecipient)</div>
                                                            <div class="cax-name">@item.CallRecipient</div>
                                                        </div>
                                                    </td>
                                                    <td data-order="@item.DateCreated.ToString("yyyyMMddHHmmss")">
                                                        <div class="cax-date">@item.DateCreated.ToString("dd MMM yyyy")</div>
                                                        <div class="cax-sub">@item.DateCreated.ToString("HH:mm")</div>
                                                    </td>
                                                    <td class="cax-right cax-num" data-order="@seconds">@(seconds > 0 ? clock(seconds) : "—")</td>
                                                    @if (showPricing)
                                                    {
                                                        <td class="cax-right cax-num">@price</td>
                                                        <td>@item.PriceUnit</td>
                                                        <td class="cax-num">@item.RecipientPhoneNumber</td>
                                                    }
                                                    <td data-order="@(string.IsNullOrWhiteSpace(item.RecordingUri) ? 0 : 1)">
                                                        @if (!string.IsNullOrWhiteSpace(item.RecordingUri))
                                                        {
                                                            <audio class="cax-audio" controls preload="none">
                                                                <source src="@item.RecordingUri" type="audio/ogg" />
                                                                <source src="@item.RecordingUri" type="audio/mpeg" />
                                                            </audio>
                                                        }
                                                        else
                                                        {
                                                            <span class="cax-norec"><i class="fas fa-microphone-slash"></i> No recording</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="cax-empty">
                                    <i class="fas fa-phone-slash"></i>
                                    No calls in this period.
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable && $('#recordingsTable tbody tr').length > 0) {
            $('#recordingsTable').DataTable({
                order: [[2, 'desc']],
                pageLength: 25,
                language: { search: "", searchPlaceholder: "Search caller or recipient" }
            });
        }
    });

    function ResetFilter(type) {
        window.location.href = "/HR/ResetCallRecordingsDetails?type=" + type;
    }

    function Changeurldetails(type) {
        window.location.href = "/HR/CallRecordingsDetails?type=" + type;
    }
</script>
<script src="~/js/filtervalidation.js?v=2024"></script>
