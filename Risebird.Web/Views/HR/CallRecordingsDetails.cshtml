@*                <h5 class="modal-title pull-left">Call Details <span class="popup-text" id="candidate_email_pop"></span> </h5>
*@            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closemyCallRecords()" aria-hidden="true"  style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" style="padding: 2px 16px;">
                <div class="row">
                    <div class="table-responsive style-2" style="height:150px;margin-top:20px;">
                        <table class="table table-striped table-bordered" style="width:100%;" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Called By</th>
                                    <th>Call Recipient</th>
                                    <th>Recording</th>
                                </tr>
                            </thead>
                            <tbody id="tblcallrecdetails">
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
                        <input style="color: #fff;line-height: 13px;margin-bottom:10px;" type="button" onclick="closemyCallRecords()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function closemyCallRecords() {
        var modal = document.getElementById("myCallRecords");
        modal.style.display = "none";
    }
    function FetchRecording(caller, callRecipient, recordingUrl) {
        
        bindCallData(caller, callRecipient, recordingUrl);
        var modal = document.getElementById("myCallRecords");
        modal.style.display = "block";
    }
    function bindCallData(caller, callRecipient, recordingUrl) {
        var html = '';
        
        html += '<tr>';
        html += '<td>' + caller + '</td>';
        html += '<td>' + callRecipient + '</td>';
        html += '<td><audio controls><source src = "' + recordingUrl + '" type = "audio/ogg" ><source src="' + recordingUrl + '" type="audio/mpeg"></audio></td>';
        html += '</tr>';
        
        $("#tblcallrecdetails").empty().html(html);
    }
    
</script>


