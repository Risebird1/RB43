@model IEnumerable<Risebird.Entities.ViewModel.CallAnalyticsSummaryVM>
@using System
@using Risebird.Entities.ViewModel
@{
    ViewData["Title"] = "Call Analytics";
    ViewBag.PageHeader = "Call Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totals = ViewBag.Totals as CallAnalyticsSummaryVM ?? new CallAnalyticsSummaryVM();
    var type = ViewBag.type as string;
    var from = ViewBag.from as string;
    var to = ViewBag.to as string;
}
@functions {
    string FormatDuration(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1 ? ts.ToString(@"h\:mm\:ss") : ts.ToString(@"m\:ss") + " (" + seconds + "s)";
    }
}
<script>
    var Header = "<div>Call Analytics</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        <div class="mobile-view"><h4 class="card-title">Call Analytics</h4></div>
                    </div>
                    <div class="pull-left">
                        <div class="@(string.IsNullOrEmpty(type) ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangeAnalyticsType('')"><strong>All</strong></div>
                        <div class="@(type == "Candidate" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangeAnalyticsType('Candidate')"><strong>Candidate</strong></div>
                        <div class="@(type == "Interviewer" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangeAnalyticsType('Interviewer')"><strong>Interviewer</strong></div>
                        <div class="@(type == "Other" ? "feedback-tab-ac" : "feedback-tab")" onclick="ChangeAnalyticsType('Other')"><strong>Others</strong></div>
                    </div>
                    <div class="pull-right client-ms">
                        <button type="button" class="mdc-button mdc-button--outlined mdc-ripple-upgraded card-title-space" onclick="location.href='@Url.Action("CallCatalogue", "HR", new { type = "Candidate" })'">
                            <span class="mdc-button__label"><font style="font-family: Roboto, sans-serif; font-size:12px;">Call Catalogue</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <form method="get" action="@Url.Action("CallAnalytics", "HR")" class="row" style="margin: 12px 0 20px 0;">
                                <input type="hidden" name="type" value="@type" />
                                <div class="col-md-3 col-sm-6">
                                    <label class="control-label">From</label>
                                    <input type="date" name="from" class="form-control" value="@from" />
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="control-label">To</label>
                                    <input type="date" name="to" class="form-control" value="@to" />
                                </div>
                                <div class="col-md-3 col-sm-6" style="padding-top: 24px;">
                                    <button type="submit" class="mdc-button mdc-button--raised">Apply</button>
                                    <a class="mdc-button mdc-button--outlined" href="@Url.Action("CallAnalytics", "HR", new { type })">Last 30 days</a>
                                </div>
                            </form>

                            <div class="row" style="margin-bottom: 20px;">
                                <div class="col-md-2 col-sm-4"><strong>Total calls</strong><div>@totals.TotalCalls</div></div>
                                <div class="col-md-2 col-sm-4"><strong>Candidate</strong><div>@totals.CandidateCalls</div></div>
                                <div class="col-md-2 col-sm-4"><strong>Interviewer</strong><div>@totals.InterviewerCalls</div></div>
                                <div class="col-md-2 col-sm-4"><strong>Other</strong><div>@totals.OtherCalls</div></div>
                                <div class="col-md-2 col-sm-4"><strong>With recording</strong><div>@totals.CallsWithRecording</div></div>
                                <div class="col-md-2 col-sm-4"><strong>Duration</strong><div>@FormatDuration(totals.TotalDurationSeconds)</div></div>
                            </div>

                            <div id="tableID" class="second interview">
                                <table id="analyticsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Caller</th>
                                            <th>Total calls</th>
                                            <th>Candidate</th>
                                            <th>Interviewer</th>
                                            <th>Other</th>
                                            <th>With recording</th>
                                            <th>Duration</th>
                                            <th>Last call</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.Caller</td>
                                                    <td>@item.TotalCalls</td>
                                                    <td>@item.CandidateCalls</td>
                                                    <td>@item.InterviewerCalls</td>
                                                    <td>@item.OtherCalls</td>
                                                    <td>@item.CallsWithRecording</td>
                                                    <td>@FormatDuration(item.TotalDurationSeconds)</td>
                                                    <td>@(item.LastCallAt.HasValue ? item.LastCallAt.Value.ToString() : "—")</td>
                                                    <td>
                                                        <a href="@Url.Action("CallAnalyticsByUser", "HR", new { caller = item.Caller, type, from, to })">View calls</a>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function ChangeAnalyticsType(type) {
        var from = '@from';
        var to = '@to';
        var url = "/HR/CallAnalytics?from=" + encodeURIComponent(from) + "&to=" + encodeURIComponent(to);
        if (type) {
            url += "&type=" + encodeURIComponent(type);
        }
        window.location.href = url;
    }
    $(document).ready(function () {
        $('#analyticsTable').DataTable();
    });
</script>
