                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.JDTiltle).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item.Split("|")[0]">@item.Split("|")[0]</option>
                                                                            }
                                                                        }
                                                                    </select>


                                                                </div>
                                                            </div>
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHR">
                                                                    Client
                                                                    HR
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ClientHR" name="ClientHR" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.CandidateClientHR).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Client">
                                                                    Client
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Client" name="Client" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.ClientCompName).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                        </div>
