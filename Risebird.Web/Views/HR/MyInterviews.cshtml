    function bindPages(pagecount, startpage, endpage, totalcount) {
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/HR/MyInterviews?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/HR/MyInterviews?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/HR/MyInterviews?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/HR/MyInterviews?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/HR/MyInterviews?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>




<script type="text/javascript">

    $(".dataloading").hide();
    $("#MyInterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#MyInterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#MyInterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    var receiver = "";
    var caninterviewid = 0;
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function call(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + receiver + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        startCallRecording(connection.parameters.CallSid);
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function startCallRecording(sid) {
        console.log("sid:" + sid);
        $.ajax({
            url: '/User/makecall',
            type: "GET",
            data: { 'sid': sid, 'interviewid': caninterviewid },
            success: function (data) {
                console.log("rsid:" + data);
            }
        });
    }
    function ModalButtonClickJson(phone, id, type) {
        if (type == 1) {
            var name = $('#hidinterviewer' + id).val();
            ModalButtonClick(phone, name, 'Interviewer', id);
        }
        else if (type == 2) {

            var name = $('#hidcandidate' + id).val();
            ModalButtonClick(phone, name, 'Candidate', id);

        }
        else if (type == 3) {

            var name = $('#hidclienthr' + id).val();
            ModalButtonClick(phone, name, 'Client HR', id);
        }

        else if (type == 4) {

            var name = $('#hidstaff' + id).val();
            ModalButtonClick(phone, name, 'StaffingAgency', id);

        }
    }

    function CallButtonClick(EmailId, MobileNumber, myCallModal, callingLabel) {
        ModalButtonClick(MobileNumber, myCallModal, callingLabel);
    }

    function ModalButtonClick(phone, receiverName, type, interviewid) {

        receiver = receiverName;
        caninterviewid = interviewid;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
