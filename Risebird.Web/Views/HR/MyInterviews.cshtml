<script type="text/javascript">


    function UnAssignInterviewer(meetingId) {


        //var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: 'You will be unassigned.',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Unassign Me!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/HR/HRUnassignYourself?id=' + meetingId,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error unassigning!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Unassigned!',
                    type: 'success',
                    html: '<p>You have been unassigned.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/HR/MyInterviews";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your were not unassigned.',
                    'error'
                )
            }
        })
    }

</script>

