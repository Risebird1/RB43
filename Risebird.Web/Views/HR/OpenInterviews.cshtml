@if (ViewBag.Message != null)
{

    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

    </script>
    
}
        }


<script type="text/javascript">

    $(document).ready(function () {
            $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
              }

            $("#PrimarySkill").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
                });


            $("#Interviewer").multiselect({
                    includeSelectAllOption: true,
                    selectedClass: 'active1',
                    buttonWidth: '100%',
                    maxHeight: 200
            });

            $("#RFID").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#ClientHR").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });

            $("#ClientName").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#Client").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });




    });
    function ResetFilter() {
        window.location.href = "/HR/ResetHROpenInterviewFilter";
    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var primarySkillsArr = @Html.Raw(Json.Serialize(primarySkills));
        var interviewer =  @Html.Raw(Json.Serialize(Interviewer));
        var rFID =  @Html.Raw(Json.Serialize(RFID));
        var clientHR =  @Html.Raw(Json.Serialize(ClientHR));
        var clientName =  @Html.Raw(Json.Serialize(ClientName));
        var client =  @Html.Raw(Json.Serialize(Client));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#PrimarySkill").val(primarySkillsArr);
        $("#Interviewer").val(interviewer);
        $("#RFID").val(rFID);
        $("#ClientHR").val(clientHR);
        $("#ClientName").val(clientName);
        $("#Client").val(client);
        var form = $("#form").serialize();
    }

</script>

<script>
    var closeMember = document.getElementById("membersPopUp");
    // When the user clicks on <span> (x), close the modal
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewerMemberModal");
        modal.style.display = "none";
    }
    function getIRFMembers(id) {

        $.ajax({
            url: '/IRF/GetIRFInterviewerMembers',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);


            }
        });
    }

</script>

<script type="text/javascript">
    $(document).ready(function () {

        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
