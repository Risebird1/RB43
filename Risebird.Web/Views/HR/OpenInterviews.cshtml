    });
</script>



<script>

    function searchResult() {

        $.ajax({
            type: "POST",
            url: "/HR/HROpenInterviewJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }
    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="9" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {
            html += ' <tr id=' + data[i].id + ' data-changes="1">';
            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].id + '" data-target=".' + data[i].id + '" class="detail-row" onclick="changeicon(' + data[i].id + ')">&nbsp;</td>'
            html += '   <td>' + data[i].interviewDate + '</td>';
            if (data[i].interviewSlot == "Morning") {
                html += '<td><a style="color:darkorange;font-weight: bold">' + data[i].interviewSlot + '</a></td>';

            }
            else {
                html += '<td><a style="color:darkblue;font-weight: bold">' + data[i].interviewSlot + '</a></td>';

            }
            html += '<td style="text-align: center"> ' + data[i].irfid + ' </td>';
            if (data[i].candidateName != null && data[i].candidateName != "") {
                if (data[i].candidateName.length > 30) {


                    html += ' <td class="cadName"><a onclick="" data-tooltip="' + data[i].candidateName + '"> ' + data[i].candidateName.substring(0, 30) + '... </a> </td>';

                }


                else {
                    html += '  <td class="cadName"><a onclick="">' + data[i].candidateName + ' </a> </td>';

                }

            }
            else {
                html += '<td></td>';
            }
            if (data[i].resumeLink != null && data[i].resumeLink != "") {
                html += '   <td> <a target="_blank" title="Resume" href=' + data[i].resumeLink + '>Resume</a></td>';
            }
            else {
                html += '   <td>No Resume</td>';
            }
            if (data[i].jdLink != null && data[i].jdLink != "") {
                html += '  <td>  <a target="_blank" title="JDLink" href=' + data[i].jdLink + '>JDLink</a></td>';
            }
            else {
                html += '    <td>No JD</td>';
            }

            html += '  <th>' + data[i].clientCompName + '</th>';
            html += '  <th>' + data[i].clientName + '</th>';

            if (data[i].candidateClientHR != null && data[i].candidateClientHR != "") {

                if (data[i].candidateClientHR.length > 15) {

                    html += ' <td class="cadEmail"><a onclick="" data-tooltip="' + data[i].candidateClientHR + '">' + data[i].candidateClientHR.substring(0, 15) + '... </a> </td>';


                }


                else {
                    html += '  <td class="cadEmail"> <a onclick="">' + data[i].candidateClientHR + '</a></td>';


                }

            }
            else {
                html += '    <td></td>';
            }



            if (data[i].interviewer != null && data[i].interviewer != "") {
                if (data[i].interviewer.length > 15) {
                    html += '<td class="cadEmail"><a onclick="" data-tooltip="' + data[i].interviewer + '">' + data[i].interviewer.substring(0, 15) + '... </a></td>';
                }
                else {
                    html += '<td class="cadEmail"><a onclick="">' + data[i].interviewer + '</a></td>';
                }
            }
            else {
                html += '<td></td>';
            }

            html += '  <td class="text-center four">';

            html += '   <a href ="/HR/HRAssignYourself?id=' + data[i].id + ' & InterviewDate=' + data[i].interviewDate + '" title="Assign Yourself" class="mdc-fab app-fab--absolute"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41L6 19l1.41-1.41L1.83 12 .41 13.41z" /></svg></a>';

            html += '   </td>';
            html += '  </tr>';
            html += '  <tr class="collapse ' + data[i].id + '">';

            html += '<td colspan="999" class="child-section">';
            html += ' <table class="table table-striped">';
            html += '  <tr>';
            html += ' <th>Quality Controller</th>';
            html += '<th>Slot</th>';
            html += ' <th>Duration</th>';
            html += ' </tr>';
            html += '  <tr>';
            if (data[i].qcInterviewer != null && data[i].qcInterviewer != "") {
                html += '  <td> ' + data[i].qcInterviewer + '</td>';
            }
            else {
                html += '  <td></td>';
            }

            if (data[i].interviewSlot != null && data[i].interviewSlot != "") {
                html += '   <td>' + data[i].interviewSlot + ' </td>';
            }
            else {
                html += '    <td></td>';
            }

            if (data[i].interviewDuration != null && data[i].interviewDuration != "") {
                html += '     <td>' + data[i].interviewDuration + ' </td>';
            }
            else {
                html += '   <td></td>';
            }

            html += '  </tr>';
            html += '   </table>';
            html += '   </td>';
            html += '   </tr>';
        }
        $("#tblbodyHROpenInterview").empty().html(html);
    }
    function bindPages(pagecount, startpage, endpage, totalcount) {
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/HR/OpenInterviews?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/HR/OpenInterviews?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/HR/OpenInterviews?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/HR/OpenInterviews?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/HR/OpenInterviews?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>

<script>

    function changeicon(id) {
        if ($("#" + id).attr("data-changes") == "1") {
            $("#" + id).addClass("shows");
            $("#" + id).attr("data-changes", "2");
        }
        else {
            $("#" + id).removeClass("shows");
            $("#" + id).attr("data-changes", "1");
        }
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#OpeninterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#OpeninterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#OpeninterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>


<script>

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }
    
</script>

