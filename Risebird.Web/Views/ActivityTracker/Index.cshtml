@model IEnumerable<Risebird.Entities.ViewModel.ActivityTrackerVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.Data
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Activity Tracker";
    ViewBag.PageHeader = "Activity Tracker";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] activityType = new string[] { };
    string[] performedBy = new string[] { };

}

@if (HttpContextAccessor.HttpContext.Session.GetString("ActivityTrackerFilters") != null)
{
    filter = JsonConvert.DeserializeObject<ActivityTrackerFilter>(HttpContextAccessor.HttpContext.Session.GetString("ActivityTrackerFilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    activityType = filter.ActivityType != null ? filter.ActivityType : new string[] { };
    performedBy = filter.PerformedBy != null ? filter.PerformedBy : new string[] { };

}


<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=234567" />

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    @*<nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Activity Tracker</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>*@
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Activity Tracker</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                         <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                         <div class="mdc-button__ripple"></div>
                        </button>
                        <i type="submit" class="far fa-file-excel excel-file card-title-space" data-toggle="tooltip" data-placement="bottom" title="Excel Export" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("ActivitiesExporttoExcel", "ActivityTracker")'"></i>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                         <span data-toggle="tooltip" data-placement="top" title="" onclick="location.href='/Dashboard'" data-original-title="Back to Dashboard"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back to List</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("Index","ActivityTracker")" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="PerformedBy">Performed By</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="PerformedBy" name="PerformedBy" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">

                                                                        @foreach (var item in Model.Select(x => x.PerformedBy).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>


                                                                </div>
                                                            </div>


                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="ActivityType">
                                                                    Activity Type
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ActivityType" name="ActivityType" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                        @foreach (var item in Model.Select(x => x.ActivityTypeDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>


                                                                    </div>

                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div>

                                    <div id="tableID" class="second">
                                        <table id="activityTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th id='start'>Activity Type</th>
                                                    <th>Particulars</th>
                                                    <th>Summary</th>
                                                    <th>Performed At</th>
                                                    <th>Performed By</th>
                                                    <th>Uploaded File</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Activity Type</th>
                                                    <th>Name</th>
                                                    <th>Summary</th>
                                                    <th>Performed At</th>
                                                    <th>Performed By</th>
                                                    <th>Uploaded File</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                <tr>
                                                    <td> @item.ActivityTypeDesc </td>


                                                    @if (item.Particulars.Length > 40)
                                                    {
                                                        @if (!string.IsNullOrEmpty(item.ResourceUrl))
                                                        {
                                                            <td class="cadName">
                                                                <a href="@item.ResourceUrl" target="_blank" data-tooltip="@item.Particulars"> @item.Particulars.Substring(0, 40)... </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="cadName">
                                                                <a onclick="" data-tooltip="@item.Particulars"> @item.Particulars.Substring(0, 40)... </a>
                                                            </td>
                                                        }

                                                    }


                                                    else
                                                    {
                                                        @if (!string.IsNullOrEmpty(item.ResourceUrl))
                                                        {
                                                            <td class="cadName">
                                                                <a href="@item.ResourceUrl" target="_blank"> @item.Particulars </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="cadName">
                                                                <a onclick=""> @item.Particulars </a>
                                                            </td>
                                                        }

                                                    }
                                                    @*<td> @item.Summary </td>*@

                                                    <td class="interview-com">
                                                        <div id="section">

                                                            @if (item.Summary.Length > 35)
                                                            {
                                                                <div class="article">
                                                                    <p style="margin-bottom:0px;">
                                                                        @item.Summary.Substring(0, 35)
                                                                    </p>
                                                                    <p class="moretext_@item.id moretext">
                                                                        @item.Summary.Substring(35, @item.Summary.Length - 35)
                                                                    </p>
                                                                </div>
                                                                <a onclick="moreless(@item.id)" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                            }
                                                            else
                                                            {
                                                                <div class="article">

                                                                    <p>
                                                                        @item.Summary.Substring(0, @item.Summary.Length)
                                                                    </p>
                                                                </div>
                                                            }









                                                        </div>

                                                    </td>


                                                    <td> @item.PerformedAt </td>
                                                    <td> @item.PerformedBy </td>
                                                    @if (item.FileUrl != null && item.FileUrl != "")
                                                    {
                                                        <td>

                                                            <a data-toggle="modal" data-target="#FileUrlId_@item.id" target="_blank" title="Uploaded File" href=@item.FileUrl>Uploaded File</a>


                                                            <div class="modal modal-wrap fade" id="FileUrlId_@item.id" tabindex="-1" role="dialog" aria-labelledby="FileUrlIdModalLabel" aria-hidden="true">
                                                                <div class="modal-dialog modal-lg" role="document">
                                                                    <div class="modal-content">


                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="z-index: 100;position: absolute;top: 26px; right: 26px;">
                                                                            <span aria-hidden="true">&times;</span>
                                                                        </button>


                                                                        <div class="modal-body">
                                                                            <div class="row">
                                                                                <div class="col-md-12 col-sm-12">
                                                                                    <div class="form-group">
                                                                                        <img src="@item.FileUrl" />



                                                                                    </div>
                                                                                </div>




                                                                            </div>
                                                                        </div>

                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </td>


                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }

                                                </tr>


                                                }
                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>





<script type="text/javascript">

    $(document).ready(function () {

        $("#ResetFilter").click(function () {
            ResetFilter();
        })

        if ('@filter' != "") {

            ApplySessionFilter();
        }
        //$("#ActivityType").multiselect({
           // includeSelectAllOption: true,
           // selectedClass: 'active1',
            //buttonWidth: '100%',
           // maxHeight: 200
       // });

        //$("#PerformedBy").multiselect({
           // includeSelectAllOption: true,
           // selectedClass: 'active1',
            //buttonWidth: '100%',
           // maxHeight: 200
        //});


    });

    function ResetFilter() {
        window.location.href = "/ActivityTracker/ResetActivityTrackerFilter";

    }
    function ApplySessionFilter() {

        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var performedByArr = @Html.Raw(Json.Serialize(performedBy));
        var activityTypeArr =  @Html.Raw(Json.Serialize(activityType));


        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#PerformedBy").val(performedByArr);
        $("#ActivityType").val(activityTypeArr);

        var form = $("#form").serialize();

    }




</script>
<script>
    function RefreshSearch() {
        $('#activityTable').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#activityTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top:11px;' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

</script>

