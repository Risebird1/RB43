@model Risebird.Entities.Data.Profile
@{
    ViewData["Title"] = "ProfileUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/Profile/Index'>Profile</a>&nbsp;/&nbsp;Update Profile";
    $('#txtpageHeader').empty().html(Header);
</script>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">

    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row bg-white">
            <div class="col-md-12">
                <div class="mdc-card card bg-white">


                    <div class="mdc-card-wrapper__text-section">
                        @using (Html.BeginForm("EditProfile", "Profile", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            @Html.AntiForgeryToken()

                            <div class="row">

                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Update Profile</h4></div>
                                </div>
                                <div style="width: 100%;">&nbsp;</div>
                                <div class="form-horizontal w-full">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="col-md-6 col-sm-6 pr-1 pull-left">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 pl-1 pull-left">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                            @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 pr-1 pull-left">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.IsAdmin, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label",@style = "padding-left:25px;" })

                                            @Html.CheckBoxFor(model => model.IsAdmin, new { @class = "checkbox-margin", @style = "position:relative;top:-25px;" })
                                            @Html.ValidationMessageFor(model => model.IsAdmin, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                    <div class="col-md-6 col-sm-6 pl-1 pull-left">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label",@style="padding-left:25px;" })

                                            @Html.CheckBoxFor(model => model.IsActive, new { @class = "checkbox-margin", @style = "position:relative;top:-25px;" })
                                            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })

                                        </div>

                                    </div>
                                </div>

                            </div>
                            <div class="card-footer ">
                                <div class="row">


                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "Index", "Profile", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Save</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>


