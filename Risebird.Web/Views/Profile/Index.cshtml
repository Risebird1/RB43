    <!-- PAGE CONTENT WRAPPER -->
    <loading></loading>
    @if (ViewBag.Message != null && ViewBag.Message.Contains("Successfully"))
    {
        <script type="text/javascript">
            window.onload = function ()
            {
                                    sweetAlert({
                                        title: "Risebird Profiles",
                                        text:'@ViewBag.Message',
                                        type: "success"
                                    });
             };
        </script>
    }
    @if (ViewBag.Message != null && (ViewBag.Message.Contains("Failed")))
    {
        <script type="text/javascript">
                window.onload = function ()
                {
                        sweetAlert({
                            title: "Risebird Profiles",
                        text: '@ViewBag.Message',
                       type: "error"
                       });
               };
        </script>
    }
    <script type="text/javascript">
        $(document).ready(function () {
            $('#idenvironment').DataTable({
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [-1] /*sort false 1st one, start by the right */
                }],
                "order": []   /* Disable initial sort */
            });
        });

        function DeleteEntityfromEnvironment(profileId) {

            var confirmMessageBox = confirm('Are you sure you want to delete "profile name"?');
            if (confirmMessageBox) {
                if (profileId != '') {
                    $.ajax({
                        url: '/Profile/DeleteProfile',
                        data: { 'id': profileId },
                        type: 'get',
                        success: function (data) {
                            window.location = data.url;
                        }
                    });
                }
            }
