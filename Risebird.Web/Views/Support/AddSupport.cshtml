@model Risebird.Entities.ViewModel.Support
@{
    ViewData["Title"] = "Add Support HR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>
<link href="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />

<script src="https://unpkg.com/material-components-web@v4.0.0/dist/material-components-web.min.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link href="~/Newassets/css/support.css" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/Support/Index">All Support HRs</a>
                <a class="navbar-brand">/ &nbsp; Add Support HR</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                   
                    <div class="mdc-card-wrapper__text-section">
                        @using (Html.BeginForm("AddSupport", "Support", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="card-header">
                                <h4 class="card-title">/ &nbsp; Add Support HR</h4>
                            </div>
                            <div class="form-horizontal">
                                <div class="col-md-4 col-sm-4 pr-1 pull-left">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

                                    </div>
                                </div>



                                <div class="col-md-4 col-sm-4 px-1 pull-left">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-md-4 col-sm-4 pl-1 pull-left">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1 pull-left">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WhatsappNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.WhatsappNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.WhatsappNumber, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-md-4 col-sm-4 px-1 pull-left">

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.AvailabilityHours, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.EditorFor(model => model.AvailabilityHours, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AvailabilityHours, "", new { @class = "text-danger" })

                                    </div>

                                </div>

                                <div class="col-md-4 col-sm-4 pl-1 pull-left">
                                    <div class="form-group pull-left mt-20">
                                       
                                        <div class="mdc-form-field">
                                            <div class="mdc-checkbox">

                                                @Html.CheckBoxFor(m => m.OnVoiceCall, new { @class = "mdc-checkbox__native-control" })
                                                <div class="mdc-checkbox__background">
                                                    <svg class="mdc-checkbox__checkmark"
                                                         viewBox="0 0 24 24">
                                                        <path class="mdc-checkbox__checkmark-path"
                                                              fill="none"
                                                              d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                    </svg>
                                                    <div class="mdc-checkbox__mixedmark"></div>
                                                </div>
                                                <div class="mdc-checkbox__ripple"></div>


                                            </div>
                                            @Html.LabelFor(model => model.OnVoiceCall, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        </div>

                                    </div>




                                    <div class="form-group pull-left mt-20">
                                        <div class="mdc-form-field">
                                            <div class="mdc-checkbox">
                                                @Html.CheckBoxFor(m => m.OnWhatsapp, new { @class = "mdc-checkbox__native-control" })
                                                <div class="mdc-checkbox__background">
                                                    <svg class="mdc-checkbox__checkmark"
                                                         viewBox="0 0 24 24">
                                                        <path class="mdc-checkbox__checkmark-path"
                                                              fill="none"
                                                              d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                    </svg>
                                                    <div class="mdc-checkbox__mixedmark"></div>
                                                </div>
                                                <div class="mdc-checkbox__ripple"></div>


                                            </div>
                                            @Html.LabelFor(model => model.OnWhatsapp, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        </div>


                                    </div>


                                    <div class="form-group pull-left mt-20">
                                        <div class="mdc-form-field">
                                            <div class="mdc-checkbox">
                                                @Html.CheckBoxFor(m => m.OnEmail, new { @class = "mdc-checkbox__native-control" })

                                                <div class="mdc-checkbox__background">
                                                    <svg class="mdc-checkbox__checkmark"
                                                         viewBox="0 0 24 24">
                                                        <path class="mdc-checkbox__checkmark-path"
                                                              fill="none"
                                                              d="M1.73,12.91 8.1,19.28 22.79,4.59" />
                                                    </svg>
                                                    <div class="mdc-checkbox__mixedmark"></div>
                                                </div>
                                                <div class="mdc-checkbox__ripple"></div>


                                            </div>
                                            @Html.LabelFor(model => model.OnEmail, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                            <div class="card-footer">
                                <div class="row">

                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back to List", "Index", "Support", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>

                        }


                    </div>



                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>
<style>
    .fa-spinner {
        font-size: 18px;
        position: relative;
        top: 6px;
        left: 4px;
    }

    .webkitEnabled {
        -webkit-appearance: menulist;
    }

    .dropdown-menu > .active > a, .dropdown-menu > .active > a:hover, .dropdown-menu > .active > a:focus {
        color: #000 !important;
        text-decoration: none;
        background-color: #fff !important;
        outline: 0;
    }
</style>




