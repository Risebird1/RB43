@model Risebird.Entities.ViewModel.Support
@{
    ViewData["Title"] = "Update Support HR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/Support/Index">All Support HRs</a>
                <a class="navbar-brand">Update Support HR</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Update Support HR</h4>
                    </div>
                    <div class="card-body">
                        @using (Html.BeginForm("Edit", "Support", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {

                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-horizontal">
                                        <div class="col-md-6 col-sm-6 pr-1">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                                @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })

                                            </div>

                                            <div class="form-group">
                                                @Html.LabelFor(model => model.WhatsappNumber, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.WhatsappNumber, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                                @Html.ValidationMessageFor(model => model.WhatsappNumber, "", new { @class = "text-danger" })

                                            </div>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.AvailabilityHours, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                                @Html.EditorFor(model => model.AvailabilityHours, new { htmlAttributes = new { @class = "form-control", @type = "text" } })
                                                @Html.ValidationMessageFor(model => model.AvailabilityHours, "", new { @class = "text-danger" })

                                            </div>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OnVoiceCall, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                @Html.CheckBoxFor(m => m.OnVoiceCall, new { @class = "form-control text-box single-line", @style = "margin-top:-21px;margin-bottom:21px; height:18px; margin-left:-23px" })

                                            </div>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OnWhatsapp, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                @Html.CheckBoxFor(m => m.OnWhatsapp, new { @class = "form-control text-box single-line", @style = "margin-top:-21px;margin-bottom:21px; height:18px; margin-left:-23px" })

                                            </div>
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.OnEmail, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                @Html.CheckBoxFor(m => m.OnEmail, new { @class = "form-control text-box single-line", @style = "margin-top:-21px;margin-bottom:21px; height:18px; margin-left:-23px" })

                                            </div>
                                            @Html.HiddenFor(m => m.id)

                                        </div>
                                        <div class="card-footer ">
                                            <div class="row">
                                                <label class="col-md-2"></label>
                                                <div class="col-md-9">
                                                    @Html.ActionLink("Back to List", "Index", "Support", htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button" })
                                                    <button type="submit" class="btn btn-fill btn-primary" id="btnUpload" value="Save">Save</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>



                        }
                    </div>



                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
    
</div>
<style>
    .fa-spinner {
        font-size: 18px;
        position: relative;
        top: 6px;
        left: 4px;
    }

    .webkitEnabled {
        -webkit-appearance: menulist;
    }

    .dropdown-menu > .active > a, .dropdown-menu > .active > a:hover, .dropdown-menu > .active > a:focus {
        color: #000 !important;
        text-decoration: none;
        background-color: #fff !important;
        outline: 0;
    }
</style>




