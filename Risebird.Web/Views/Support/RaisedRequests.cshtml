@model IEnumerable<Risebird.Entities.ViewModel.RaiseBugsVM>

@{
    ViewData["Title"] = "RaisedRequests";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div>Raised Requests</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css?v=2024" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                </div>
                <div class="pull-left">
                    @if (ViewBag.Type == "Open")
                    {
                        <div class="feedback-tab-ac" onclick="ChangeIssueListdetails('Open','@ViewBag.ReturnBack')"><strong>Open Issue</strong></div>
                        <div class="feedback-tab" onclick="ChangeIssueListdetails('Close','@ViewBag.ReturnBack')"><strong>Closed Issue</strong></div>
                    }
                    else
                    {
                        <div class="feedback-tab" onclick="ChangeIssueListdetails('Open','@ViewBag.ReturnBack')"><strong>Open Issue</strong></div>
                        <div class="feedback-tab-ac" onclick="ChangeIssueListdetails('Close','@ViewBag.ReturnBack')"><strong>Closed Issue</strong></div>
                    }
                </div>
                <div class="pull-right">
                    @if (ViewBag.ReturnBack == 1)
                    {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center" style="display:block;">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading mtop-10">
                            <div class="toolbar">
                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="supportList" class="table table-striped table-bordered firstsupport" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th class="disabled-sorting text-center">Actions</th>
                                                <th>Requested By</th>
                                                <th>Requester</th>
                                                <th>Request Date</th>
                                                <th>Request Type</th>
                                                <th>Issue Details</th>
                                                <th>Attachments</th>
                                                <th>Status</th>
                                                
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th class="disabled-sorting text-center">Actions</th>
                                                <th>Requested By</th>
                                                <th>Requester</th>
                                                <th>Request Date</th>
                                                <th>Request Type</th>
                                                <th>Issue Details</th>
                                                <th>Attachments</th>
                                                <th>Status</th>
                                                
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>
                                                       

                                                        @if (item.Status?.ToLower() == "open")
                                                        {
                                                            <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Close Request">
                                                                <span onclick="openRaisedBugClosepopup('@item.id','@item.RequestedBy','@item.RequestedOn')" title="Close Request" class="mdc-fab__icon material-icons">
                                                                    <svg style="color: white" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"> <circle cy="12.5" cx="12.5" r="1.75"></circle> <circle cy="12.5" cx="3.5" r="1.75"></circle> <circle cy="3.5" cx="3.5" r="1.75"></circle> <path d="m12.25 7.25v3m-8.5-4.5v4.5" fill="white"></path> <path d="m14.25 1.75-3.5 3.5m0-3.5 3.5 3.5" fill="white"></path> </svg>
                                                                </span>
                                                            </button>
                                                        }

                                                    </td>
                                                    <td> @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                        {
                                                           
                                                                <span onclick="CommonCallButtonClick('@item.Name','@item.MobileNumber', '@item.RequestedBy',null, null, '@item.Requester')" data-original-title="Tooltip on top" title="Click here to call."><img src="/img/calling.png" width="18"></span>
                                                           
                                                        }@item.RequestedBy</td>
                                                    <td>@item.Requester</td>
                                                    <td>@item.RequestedOn</td>
                                                    <td>@item.RequestType</td>
                                                    <td>
                                                        @if (item.Comment != null && item.Comment != "")
                                                        {
                                                            @if (item.Comment.Length > 40)
                                                            {
                                                                <div class="article">
                                                                    <p style="margin-bottom:0px;">
                                                                        @item.Comment.Substring(0, 40)
                                                                    </p>
                                                                    <p class="moretext_@item.id moretext">
                                                                        @item.Comment.Substring(40, @item.Comment.Length - 40)
                                                                    </p>
                                                                </div>
                                                                <a onclick="moreless('@item.id')" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                            }
                                                            else
                                                            {
                                                                <div class="article">
                                                                    <p>
                                                                        @item.Comment
                                                                    </p>
                                                                </div>
                                                            }
                                                        }
                                                    </td>
                                                    @if (!string.IsNullOrWhiteSpace(item.AttachmentURL))
                                                    {
                                                        <td>
                                                            <button  onclick="openRaisedBugImagepup('@item.AttachmentURL')" style="text-shadow:none; border:0px; font-weight: 500; padding: 1px 4px; font-size: 12px; color: #fff;background: #8fb2e4;"> Show issue Image</button>
                                                             <a href="@item.AttachmentURL" target="_blank">Download issue Image</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    <td>@item.Status</td>
                                                    
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="RaisedBugClosePopup" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Close Request <span class="popup-text" id="skill_id_pop"></span></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeRaisedBugClosepopup()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <input type="hidden" id="txtrequestid" />
          
            <div class="modal-body" style="color:black">
                  <div class="col-md-12" style="padding:10px;">
                Requested By:  <label style="color:green" id="ShowRequestedBy"></label> on <label id="ShowRequestedDate"></label>
                
            </div>
              <div>  <input type="text" placeholder="Please enter comment" id="txtRaisedBugCloseComment" class="form-control" maxlength="1000" /></div>
            </div>
            <div class="card-footer ">
                <div class="row">
                    <div class="col-md-12 mc-button-area">
                        <input type="button" value="Submit" onclick="CloseRaisedBugRequest()" class="mdc-button mdc-button--raised mdc-ripple-upgraded" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="RaisedBugImage" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Close<span class="popup-text" id="skill_id_pop"></span></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="CloseRaisedBugImagepopup()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body" style="color:black">
                <img src="" id="imgBug" />
            </div>
           @*  <div class="card-footer ">
                <div class="row">
                    <div class="col-md-12 mc-button-area">
                        <input type="button" value="Submit" onclick="CloseRaisedBugImage()" class="mdc-button mdc-button--raised mdc-ripple-upgraded" />
                    </div>
                </div>
            </div> *@
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
<script type="text/javascript">
    function searchResult() {
        $('#supportList').DataTable();
    }
    function RefreshSearch() {
        $('#supportList').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#supportList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top:18px'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#supportList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#supportList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#supportList").show();
        }, 2000);
    };
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
    function openRaisedBugClosepopup(requestid,RequestedBy,RequestedDate) {
       // var data = $("#ShowRequestedBy").val(RequestedBy);
        var modal = document.getElementById("RaisedBugClosePopup");
        modal.style.display = "block";
        $("#ShowRequestedBy").html('');
        $("#ShowRequestedBy").html(RequestedBy);
        $("#ShowRequestedDate").html('');
        $("#ShowRequestedDate").html(RequestedDate);
        $("#txtrequestid").val(requestid);
    }
    function closeRaisedBugClosepopup() {
        var modal = document.getElementById("RaisedBugClosePopup");
        modal.style.display = "none";
    }
    function CloseRaisedBugRequest() {
        var comment = $("#txtRaisedBugCloseComment").val();
        var requestid = $("#txtrequestid").val();
        if (comment.trim() != '') {
            $.ajax({
                url: "/Support/UpdateRaisedRequestsStatus",
                type: "POST",
                data: { requestid: requestid, comment: comment },
                success: function (message) {
                    closeRaisedBugClosepopup();
                    location.reload();
                }
            });
        } else {
            alert('Comment is required.');
        }
    }
    function ChangeIssueListdetails(type,returnBack) {
        window.location.href = "/Support/RaisedRequests?type=" + type + "&returnBack=" + returnBack;
    }

    function openRaisedBugImagepup(imgUrl) {
        var modal = document.getElementById("RaisedBugImage");
        modal.style.display = "block";
        document.getElementById("imgBug").src = imgUrl;
    }
    function CloseRaisedBugImagepopup() {
        var modal = document.getElementById("RaisedBugImage");
        modal.style.display = "none";
    }

</script>
<script src="~/js/twiliocallmaker.js?v=2024"></script>