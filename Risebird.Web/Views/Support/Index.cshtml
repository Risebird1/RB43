<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Support</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Support</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                            <div class="row">

                                <div @*class="col-md-6 ml-md-auto" *@>
                                    @if (ViewBag.Profile == "Admin")
                                    {
                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;margin-left:1231px"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add Support." onclick="location.href='@Url.Action("AddSupport", "Support")'" data-original-title="Tooltip on top"> Add Support</span></button>
                                    }
                                    @if (Model.BackController != null && Model.BackMethod != null)
                                    {
                                        @Html.ActionLink("Back", Model.BackMethod ,Model.BackController,null, htmlAttributes: new { @class = "btn btn-fill btn-label", @role = "button", @style ="margin-left:1252px" })
                                    }
                                </div>


                            </div>
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="supportList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>EmailId</th>
                                                <!-- <th>Mobile Number</th>-->
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>
                                                <th style="text-align:center">Call</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Name</th>
                                                <th>EmailId</th>
                                                <!--<th>Mobile Number</th-->
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>
                                                <th style="text-align:center">Call</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                            </tr>
                                         </tfoot>
                                         <tbody>
                                             @foreach (var item in Model.Supports)
                                             {

                                             <tr id="@item.id">
                                                 <td> @item.Name</td>
                                                 @if (item.EmailId != null && item.EmailId != "")
                                                 {
                                                     <td>@item.EmailId</td>
                                                 }
                                                 else
                                                 {
                                                     <td>Not available</td>
                                                 }


                                              











                                                 @if (item.WhatsappNumber != null && item.WhatsappNumber != "")
                                                 {
                                                     <td>@item.WhatsappNumber</td>
                                                 }
                                                 else
                                                 {
                                                     <td>Not available</td>
                                                 }


                                                 @if (item.OnVoiceCall)
                                                 {
                                                     <td>Yes</td>
                                                 }
                                                 else
                                                 {
                                                     <td>No</td>
                                                 }
                                                 @if (item.OnWhatsapp)
                                                 {
                                                     <td>Yes</td>
                                                 }
                                                 else
                                                 {
                                                     <td>No</td>
                                                 }
                                                 @if (item.OnEmail)
                                                 {
                                                     <td>Yes</td>
                                                 }
                                                 else
                                                 {
                                                     <td>No</td>
                                                 }
                                                 @if (item.AvailabilityHours != null && item.AvailabilityHours != "")
                                                 {
                                                     <td>
                                                         <span style="font-size:12px;">  @item.AvailabilityHours </span>
                                                     </td>
                                                 }
                                                 else
                                                 {
                                                     <td> </td>
                                                 }

                                                 <td>
                                                     @if (item.MobileNumber != null && item.MobileNumber != string.Empty && item.OnVoiceCall)
                                                     {
                                                         <!--<button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')" data-original-title="Tooltip on top"> Call HR</span></button>-->



                                                         <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt">Call HR</span></span>


                                                     }

                                                 </td>
                                                 <td class="text-center">
                                                     @if (ViewBag.Profile == "Admin")
                                                     {
                                                         <span onclick="location.href = '@Url.Action("Edit", "Support", new { id = item.id})'" title="Edit" class="btn btn-round btn-warning btn-icon btn-sm edit"><i class="fas fa-edit"></i></span>
                                                         <span onclick="javascript:Delete('@item.id');" title="Delete" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-trash"></i></span>

                                                     }

                                                 </td>
                                             </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal  modal-wrap" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
