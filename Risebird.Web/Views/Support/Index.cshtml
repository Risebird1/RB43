    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Keep the Page Content Here.-->
<script>
    var Header = "<div id='support_1'>Support</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/support.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<style>
    .hopscotch-arrow.down {
