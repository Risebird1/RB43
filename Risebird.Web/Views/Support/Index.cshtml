    .btn {
        border: none;
        font-family: inherit;
        font-size: inherit;
        color: inherit;
        background: none;
        cursor: pointer;
        padding: 8px 16px;
        display: inline-block;
        margin: 0px 5px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        outline: none;
        position: relative;
        -webkit-transition: all 0.3s;
        -moz-transition: all 0.3s;
        transition: all 0.3s;
        font-family: Arial, sans-serif;
    }

        .btn:after {
            content: '';
            position: absolute;
            z-index: -1;
            -webkit-transition: all 0.3s;
            -moz-transition: all 0.3s;
            transition: all 0.3s;
        }

    .btn-primary, .btn-fill {
        background: #4fa4fb !important;
        color: #fff;
        -webkit-box-shadow: 0 3px #3884d2 !important;
        -moz-box-shadow: 0 3px #3884d2 !important;
        box-shadow: 0 3px #3884d2 !important;
        -webkit-transition: none;
        -moz-transition: none;
        transition: none;
        border-radius: 5px 5px 5px 5px;
        box-shadow: 0 3px #3884d2;
    }


        .btn-primary:hover, .btn-fill:hover {
            background: #4fa4fb;
            box-shadow: 0 4px #3884d2 !important;
            top: 0px;
        }

    .action .btn-info, .action .btn-info:not([data-action]):not([class*="btn-outline-"]):hover {
        background: #84c0ff;
        color: #fff;
        font-weight: bold;
        box-shadow: 0 3px #5794d4;
    }


    .action .btn-warning, .action .btn-warning:not([data-action]):not([class*="btn-outline-"]):hover {
        background: #fff;
        color: #56a9ff;
        font-weight: bold;
        border: 1px #deedfd solid;
        box-shadow: 0 3px #5794d4;
    }


    .action .btn {
        width: 32px !important;
        height: 30px !important;
    }

    .action span {
        -webkit-transition: -webkit-transform .8s ease-in-out;
        transition: transform .8s ease-in-out;
        font-weight: bold;
    }

        .action span:hover {
            -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
        }


