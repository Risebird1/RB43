                    <h4 class="card-title"></h4>
                </div>

                <div class="pull-right">
                    <div>
                        @if (ViewBag.Profile == "Admin")
                        {
                            <button type="button" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded  card-title-space">
                                <span class="fa fa-envelope" data-toggle="tooltip" data-placement="top" title="Mail" onclick="location.href='@Url.Action("Mail", "Mail")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Mail</font></span>
                            </button>

                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add Support" onclick="location.href='@Url.Action("AddSupport", "Support")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Support</font></span>
                            </button>


                        }
                        @if (Model.BackController != null && Model.BackMethod != null)
                        {
                            @Html.ActionLink("Back", Model.BackMethod, Model.BackController, null, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>






    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center" style="display:block;">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="supportList" class="table table-striped table-bordered firstsupport" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th id='start'>Name</th>
                                                <th id="support_2">Email Id</th>
                                                <!-- <th>Mobile Number</th>-->
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>
                                                <th style="text-align:center">Call</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email Id</th>
                                                <!--<th>Mobile Number</th-->
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>
                                                <th style="text-align:center">Call</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model.Supports)
                                            {

                                                <tr id="@item.id">
                                                    <td width="30%">
                                                        @if (item.IsOnline == 1)
                                                        {
                                                            <span class="dot dot-p" style="background-color:green"></span><a onclick="directopenChat('@item.EmailId')"><span> @item.Name </span></a>
                                                        }
                                                        else
                                                        {<span class="dot  dot-p"></span>
                                                            @item.Name

                                                        }
                                                    </td>
                                                    @if (item.EmailId != null && item.EmailId != "")
                                                    {
                                                        <td>@item.EmailId</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Not available</td>
                                                    }

                                                    @if (item.WhatsappNumber != null && item.WhatsappNumber != "")
                                                    {
                                                        <td>@item.WhatsappNumber</td>
                                                    }
                                                    else
                                                    {
                                                        <td>Not available</td>
                                                    }


                                                    @if (item.OnVoiceCall)
                                                    {
                                                        <td>Yes</td>
                                                    }
                                                    else
                                                    {
                                                        <td>No</td>
                                                    }
                                                    @if (item.OnWhatsapp)
                                                    {
                                                        <td>Yes</td>
                                                    }
                                                    else
                                                    {
                                                        <td>No</td>
                                                    }
                                                    @if (item.OnEmail)
                                                    {
                                                        <td>Yes</td>
                                                    }
                                                    else
                                                    {
                                                        <td>No</td>
                                                    }
                                                    @if (item.AvailabilityHours != null && item.AvailabilityHours != "")
                                                    {
                                                        <td>
                                                            <span style="font-size:12px;">  @item.AvailabilityHours </span>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td> </td>
                                                    }

                                                    <td>

                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty && item.OnVoiceCall)
                                                        {
                                                            <!--<button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')" data-original-title="Tooltip on top"> Call HR</span></button>-->



                                                            <span id="support_3" class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt">Call HR</span></span>


                                                        }

                                                    </td>
                                                    <td class="text-right action">
                                                        @if (ViewBag.Profile == "Admin")
                                                        {
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit Recruiter">
                                                                <span onclick="location.href = '@Url.Action("Edit", "Support", new { id = item.id})'" title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                            </button>



                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete risebird user">
                                                                <span onclick="javascript:Delete('@item.id');" title="Delete" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                            </button>




                                                        }

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">

                <div class="modal-content">



                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">


                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                            </span>
