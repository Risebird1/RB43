    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Support</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                            <div class="row">

                                <div @*class="col-md-6 ml-md-auto"*@>
                                    @if (ViewBag.Profile == "Admin")
                                    {
                                        <button type="button" class="btn btn-primary " style="margin-top: 2px;margin-left:1231px"><span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add Support." onclick="location.href='@Url.Action("AddSupport", "Support")'" data-original-title="Tooltip on top"> Add Support</span></button>
                                    }
                                </div>


                            </div>
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="supportList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>EmailId</th>
                                                <th>Mobile Number</th>
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>
                                                <th style="text-align:center">Call</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Name</th>
                                                <th>EmailId</th>
                                                <th>Mobile Number</th>
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>
                                                <th style="text-align:center">Call</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                               
                                            <tr id="@item.id">
                                                <td> @item.Name</td>
                                                @if (item.EmailId != null && item.EmailId != "")
                                                {
                                                    <td>@item.EmailId</td>
                                                }
                                                else
                                                {
                                                    <td>Not available</td>
                                                }

                                                @if (item.MobileNumber != null && item.MobileNumber != "")
                                                {
                                                    <td>@item.MobileNumber</td>
                                                }
                                                else
                                                {
                                                    <td>Not available</td>
                                                }
                                                @if (item.WhatsappNumber != null && item.WhatsappNumber != "")
                                                {
                                                    <td>@item.WhatsappNumber</td>
                                                }
                                                else
                                                {
                                                    <td>Not available</td>
                                                }


                                                @if (item.OnVoiceCall)
                                                {
                                                    <td>Yes</td>
                                                }
                                                else
                                                {
                                                    <td>No</td>
                                                }
                                                @if (item.OnWhatsapp)
                                                {
                                                    <td>Yes</td>
                                                }
                                                else
                                                {
                                                    <td>No</td>
                                                }
                                                @if (item.OnEmail)
                                                {
                                                    <td>Yes</td>
                                                }
                                                else
                                                {
                                                    <td>No</td>
                                                }
                                                @if (item.AvailabilityHours != null && item.AvailabilityHours != "")
                                                {
                                                    <td>@item.AvailabilityHours</td>
                                                }
                                                else
                                                {
                                                    <td> </td>
                                                }

                                                <td>
                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty && item.OnVoiceCall)
                                                    {
                                                        <button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')" data-original-title="Tooltip on top"> Call HR</span></button>
                                                    }

                                                </td>
                                                <td class="text-center">
                                                    @if (ViewBag.Profile == "Admin")
                                                    {
                                                        <span onclick="location.href = '@Url.Action("Edit", "Support", new { id = item.id})'" title="Edit" class="btn btn-round btn-warning btn-icon btn-sm edit"><i class="fas fa-edit"></i></span>
                                                        <span onclick="javascript:Delete('@item.id');" title="Delete" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-trash"></i></span>

                                                    }

                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */">
            <!-- Modal content -->
            <div class="modal-content" style="width:70%;position: relative; background-color: #fefefe; margin: auto; padding: 0;border: 1px solid #888;box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2),0 6px 20px 0 rgba(0,0,0,0.19);font-size: 12px;margin-top:-53px">
                <div class="modal-header" style="padding: 2px 16px;background-color: #14406e;color: white;font-size: 10px;">
                    <h5 style="margin-left:40%;font-size:20px">Call HR!</h5>
                    <span class="close" id="callPopUp">&times;</span>
                </div>
                <div class="modal-body" style="padding: 2px 16px;">
                    <div class="row">
                        <label id="callingLabel" style="margin-top:23px;margin-left:38%; font-size:20px"><b>Calling...</b></label>

                    </div>

                    <div class="">
                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin-left:43%" class="btn btn-fill btn-danger" value="Hang Up">
                    </div>
                </div>
                <div class="modal-footer" style="padding: 2px 16px;
        background-color: #14406e;
        color: white;">

                </div>
            </div>

        </div>
        <!-- end row -->
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>

