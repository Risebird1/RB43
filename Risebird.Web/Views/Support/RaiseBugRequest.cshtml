@model Risebird.Entities.ViewModel.RaiseBugsVM

@using (Html.BeginForm("RaiseBugRequest", "Support", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        @Html.HiddenFor(model=>model.RequestedBy)
        <div class="row col-md-12 col-sm-12" style="padding-bottom:2%">
            <div class="col-md-6 col-sm-6">
                @Html.RadioButtonFor(model=>model.RequestType,"Technical") Technical Issue
            </div>
            <div class="col-md-6 col-sm-6">
                @Html.RadioButtonFor(model=>model.RequestType,"Support") Support Issue
            </div>
        </div>
        <div class="col-md-12 col-sm-12" style="padding-bottom:2%">
            @Html.TextAreaFor(model=>model.Comment,new {@class = "form-control",@placeholder="Please write your issue",@required="required",@maxlength="1000"})
        </div>
        <div class="col-md-12 col-sm-12" style="padding-bottom:2%">
            <div class="col-md-6">Attachment</div>
            @Html.TextBoxFor(model=>model.Attachment, new { @type = "file", @class = "form-control", @accept = ".png,.jpeg,.jpg" })
        </div>
    </div>
    <div>
        <div class="col-md-12 text-right">
            <input type="submit" value="Submit request" />
        </div>
    </div>
}
<script>
    $('form').submit(function () {
        var $self = $(this);
        if ($(this).valid()) {
            $.ajax({
                url: this.action,
                type: this.method,
                dataType: "JSON",
                data: new FormData(this),
                processData: false,
                contentType: false,
                success: function (message) {
                    if (message.includes("successfully")) {
                        $('#raiseRequest_Bugs').html('');
                        $('#raiseRequest_Bugs').html(message);
                    } else {
                        alert(message);
                    }
                }
            });
        }
        return false;
    });
</script>
