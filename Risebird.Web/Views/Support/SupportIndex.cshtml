@model Risebird.Entities.ViewModel.SupportList
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor

<!-- Keep the Page Content Here.-->

<link href="~/Newassets/css/support.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />

<div  id="main-panel">

    <!--  <div class="panel-header panel-header-sm"> </div>-->



    


    <div class="content client">
        <div class="row bl-bg">

            <div class="col-md-12">
                <div>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space mbtop-10">
                        <span class="fa fa-envelope" data-toggle="tooltip" data-placement="top" title="Mail" onclick="GetSupportmailModal()" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Mail</font></span>
                    </button>


                </div>
            </div>
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div>
                       
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="supportList" class="table table-striped table-bordered firstsupport" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th id='start'>Name</th>
                                                <th id="support_2">Email Id</th>
                                                <th style="text-align:center">Call</th>
                                                 <th>Mobile Number</th>
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>


                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email Id</th>
                                                <th style="text-align:center">Call</th>
                                                <th>Mobile Number</th>
                                                <th>Whatsapp Number</th>
                                                <th>Voice Call</th>
                                                <th>Whatsapp Voice Call</th>
                                                <th>Email Support</th>
                                                <th>Availability Hours</th>


                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model.Supports)
                                            {

                                            <tr id="@item.id">
                                                <td width="30%">
                                                    @*@if (item.IsOnline == 1)
                                                    {
                                                        <span class="dot dot-p" style="background-color:green"></span><a onclick="directopenChat('@item.EmailId')"><span> @item.Name </span></a>
                                                    }
                                                    else
                                                    {<span class="dot  dot-p"></span>
                                                        @item.Name

                                                    }*@
                                                    @item.Name
                                                </td>
                                                @if (item.EmailId != null && item.EmailId != "")
                                                {
                                                    <td>@item.EmailId</td>
                                                }
                                                else
                                                {
                                                    <td>Not available</td>
                                                }
                                                <td>

                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty && item.OnVoiceCall)
                                                    {
                                                        <!--<button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')" data-original-title="Tooltip on top"> Call HR</span></button>-->



                                                        <span id="support_3" class="call" data-toggle="tooltip" data-placement="top" title="Click here to call the HR." onclick="ModalButtonClick('@item.MobileNumber','@item.Name')"><span class="btn-call"><span class="fa fa-phone"></span></span><span class="call-txt">Call HR</span></span>


                                                    }

                                                </td>
                                                @if (item.applicableToProfileId != null && item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                {
                                                    <td>@item.MobileNumber</td>
                                                }
                                                else
                                                {
                                                    <td>Not available</td>
                                                } 
                                                @if (item.WhatsappNumber != null && item.WhatsappNumber != "")
                                                {
                                                    <td>@item.WhatsappNumber</td>
                                                }
                                                else
                                                {
                                                    <td>Not available</td>
                                                }


                                                @if (item.OnVoiceCall)
                                                {
                                                    <td>Yes</td>
                                                }
                                                else
                                                {
                                                    <td>No</td>
                                                }
                                                @if (item.OnWhatsapp)
                                                {
                                                    <td>Yes</td>
                                                }
                                                else
                                                {
                                                    <td>No</td>
                                                }
                                                @if (item.OnEmail)
                                                {
                                                    <td>Yes</td>
                                                }
                                                else
                                                {
                                                    <td>No</td>
                                                }
                                                @if (item.AvailabilityHours != null && item.AvailabilityHours != "")
                                                {
                                                    <td>
                                                        <span style="font-size:12px;">  @item.AvailabilityHours </span>
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td> </td>
                                                }


                                            </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal modal-bg">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">

                <div class="modal-content">



                    <div class="filheader">
                        <div class="filavatar">
                            <span class="publicsharing-icon">


                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Call HR !</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true" id="callPopUp" style="cursor:pointer;">&times;</span>
                    </button>




                    <div class="modal-body">

                        <h5 class="modal-title text-center mt-20" id="callingLabel"><b>Calling...</b></h5>
                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin: 10px auto;
    display: block;" class="btn btn-fill btn-danger" value="Hang Up">


                    </div>

                </div>
            </div>

        </div>
        <!-- end row -->
    </div>

</div>






<script>
    var name = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callHR(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + name + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });

    function ModalButtonClick(mobileNumber, hrName) {
        name = hrName;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + name + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callHR(mobileNumber);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }


</script>








