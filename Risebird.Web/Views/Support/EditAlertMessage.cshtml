@model Risebird.Entities.ViewModel.AlterMessage


@using (Html.BeginForm("EditAlertMessage", "Support", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()


    <div class="form-horizontal w-full">
        <div class="clearfix">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        </div>
        @Html.HiddenFor(model => model.ID)
        <div class="clearfix row">
            
            <div class="form-group col-lg-6  col-md-6 col-sm-6 pull-left">
                <div class="mandate">
                    @Html.LabelFor(model => model.StartTime, htmlAttributes: new { @class = "control-label col-lg-6 col-md-6 col-sm-6 col-xs-6 desp-label" })<span class="red"> * </span>
                </div>
                @Html.EditorFor(model => model.StartTime, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local", @required = "required" } })
            </div>
            <div class="form-group col-lg-6  col-md-6 col-sm-6 pull-left">
                <div class="mandate">
                    @Html.LabelFor(model => model.EndTime, htmlAttributes: new { @class = "control-label col-lg-6 col-md-6 col-sm-6 col-xs-6 desp-label" })<span class="red"> * </span>
                </div>
                @Html.EditorFor(model => model.EndTime, new { htmlAttributes = new { @class = "form-control", @type = "datetime-local", @required = "required" } })
               
            </div>
            <div class="form-group col-lg-12  col-md-12 col-sm-12  pull-left">

                <div class="mandate">
                    @Html.LabelFor(model => model.Announcement, htmlAttributes: new { @class = "control-label col-lg-6 col-md-6 col-sm-6 col-xs-6 desp-label" })<span class="red">* </span>
                </div>
                @Html.TextAreaFor(model => model.Announcement, new { @class = "form-control",@required = "required",@rowspan="3",@style = "height: 100px;" })
                @Html.ValidationMessageFor(model => model.Announcement, "", new { @class = "text-danger" })

            </div>
            <div class="form-group col-lg-6  col-md-6 col-sm-6 pull-left">
                <div class="mandate">
                    
                </div>
                @Html.CheckBoxFor(model => model.IsActive) IsActive
               
            </div>
        </div>
        <div>
            <div class="card-footer" style="margin-top: 15px;">
                <div class="row">
                    <div class="col-md-12 mc-button-area">
                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Save">Save</button>
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="closeAssessmentgroupModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>

}
<script src="ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>
<script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery("#zskilldetails_SelectedSkillIds, #zskilldetails_ProfileTypeArray, #zskilldetails_SeniorityLevelArray, #zskilldetails_EmploymentTypeArray").select2({ multiple: true });
    });
</script>
