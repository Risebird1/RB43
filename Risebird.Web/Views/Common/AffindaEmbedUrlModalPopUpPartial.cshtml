@model Risebird.Entities.ViewModel.IRFViewModel

<div id="AffindaEmbedUrlModel" class="modal modal-bg" style="z-index:3">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                    <i class="fa fa-user" style="color: white;font-size: 20px;position: relative;left: -5px;"></i> <i class="fa fa-search" style="color: white;font-size: 13px;position: relative;top: -30px;left: 11px;"></i>
                    </span>

                </div>

                <h5 class="modal-title pull-left" style="text-transform:none;">Search And Match Link for <span style="color:#159241" id="embed_id_title"></span></h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeAffindaEmbedUrlModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body">
                <div style="padding: 0px 0px 10px 0px;text-align: center;margin-top: 10px;" id="divEmbedUrlBody">
                 @*   <a id="embed_Anchor_Id" target="_blank" class="approve">
               <span class="fa fa-check approve-icon"></span><span class="approve-txt">CLICK HERE</span>
            </a>*@

                 <a id="embed_Anchor_Id" target="_blank" style="background: #a69187eb; padding: 8px 20px;display: inline-block; width: auto;  margin: 0px auto; border-radius: 3px;text-decoration: none;font-size: 14px;color:#fff!important"> <span class="fa fa-check approve-icon"></span><span class="approve-txt"> <i class="fa fa-user" style="color: white;font-size: 20px;position: relative;left: -5px;"></i>CLICK TO FIND CANDIDATE MATCH</span></a>
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div style=" border-top: 1px #cccccc91 solid;padding: 10px 0px; margin: 10px 0px 0px 0px;">
                            <div style="display: inline-block !important;margin-bottom: 0px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeAffindaEmbedUrlModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="hidden_EmbedUrl_Id"/>
                <input type="hidden" id="hidden_SkillChannel_Id"/>
            </div>

        </div>
    </div>
</div>

<script>

    function openEmbedUrlPopUp(id, skillChannelName, existingEmbedUrl = null, urlCreationTimeElapsed = null) {
        //document.getElementById('embed_Anchor_Id').href = "";
        document.getElementById('embed_Anchor_Id').innerHTML = "";
        document.getElementById('embed_id_title').innerHTML = ': ' + skillChannelName;
        var alreadyProgrammaticallyGeneratedUrl = document.getElementById('hidden_EmbedUrl_Id').value;
        var alreadyGeneratedForIRFId = document.getElementById('hidden_SkillChannel_Id').value;
        var embedUrl='';
        if (existingEmbedUrl != null && existingEmbedUrl != '') { 
            if ((alreadyProgrammaticallyGeneratedUrl != null && alreadyProgrammaticallyGeneratedUrl != '') && (alreadyGeneratedForIRFId != id) && urlCreationTimeElapsed > 50) { 
                //generate for this
                $.ajax({
                    type: "POST",
                    async: true,
                    url: "/IRF/GenerateEmbeddableResumeSearchUrl",
                    data: { irfId: skillChannelName },
                    success: function (data) {
                        if (data != null) {
                            embedUrl = data;
                            document.getElementById('hidden_EmbedUrl_Id').value = embedUrl;
                            document.getElementById('hidden_SkillChannel_Id').value = id;
                            document.getElementById('embed_Anchor_Id').href = embedUrl;



                        }
                        else {
                            document.getElementById('embed_Anchor_Id').innerHTML = "Link not available for this Skill Channel!";
                            return;
                        }
                    }
                });
            
            }
            if ((alreadyProgrammaticallyGeneratedUrl == null || alreadyProgrammaticallyGeneratedUrl == '') && urlCreationTimeElapsed > 50) {
                //generate for this
                $.ajax({
                    type: "POST",
                    async: true,
                    url: "/IRF/GenerateEmbeddableResumeSearchUrl",
                    data: { irfId: skillChannelName },
                    success: function (data) {
                        if (data != null) {
                            embedUrl = data;
                            document.getElementById('hidden_EmbedUrl_Id').value = embedUrl;
                            document.getElementById('hidden_SkillChannel_Id').value = id;
                            document.getElementById('embed_Anchor_Id').href = embedUrl;



                        }
                        else {
                            document.getElementById('embed_Anchor_Id').innerHTML = "Link not available for this Skill Channel!";
                            return;
                        }
                    }
                });

            }
        }
        else if (existingEmbedUrl != null && existingEmbedUrl != '' ) {
            embedUrl = existingEmbedUrl;
        }
        else if (alreadyProgrammaticallyGeneratedUrl != null && alreadyProgrammaticallyGeneratedUrl != '' && (alreadyGeneratedForIRFId == id) && (urlCreationTimeElapsed)) {
            embedUrl = document.getElementById('hidden_EmbedUrl_Id').value;
        }
        else {
            $.ajax({
                type: "POST",
                async:true,
                url: "/IRF/GenerateEmbeddableResumeSearchUrl",
                data: { irfId: skillChannelName },
                success: function (data) {
                    if(data != null)
                    {
                        embedUrl = data;
                        document.getElementById('hidden_EmbedUrl_Id').value = embedUrl;
                        document.getElementById('hidden_SkillChannel_Id').value = id;
                        document.getElementById('embed_Anchor_Id').href = embedUrl;

                        

                    }
                    else
                    {
                        document.getElementById('embed_Anchor_Id').innerHTML = "Link not available for this Skill Channel!";
                        return;
                    }
                }
            });
        }

        var modal = document.getElementById("AffindaEmbedUrlModel");
        //$("#embed_id_title").text('Search And Match Link for ' + skillChannelName);
        modal.style.display = "block";
        document.getElementById('embed_Anchor_Id').innerHTML = "Click to find Candidate Match";
        document.getElementById('embed_Anchor_Id').href = embedUrl;
        
        

        
    }
    function closeAffindaEmbedUrlModel() {
        var model = document.getElementById("AffindaEmbedUrlModel");
        model.style.display = "none";
    }

</script>