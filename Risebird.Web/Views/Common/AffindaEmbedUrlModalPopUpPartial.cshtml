@model Risebird.Entities.ViewModel.IRFViewModel

<div id="AffindaEmbedUrlModel" class="modal modal-bg" style="z-index:3">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-lines-fill" viewBox="0 0 16 16">
                            <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zM11 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5zm.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4zm2 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2z" />
                        </svg>
                    </span>

                </div>

                <h5 class="modal-title pull-left"><span class="popup-text" id="embed_id_title"></span></h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeAffindaEmbedUrlModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body">
                <div style="padding:10px" id="divEmbedUrlBody">
                    <a id="embed_Anchor_Id" target="_blank">Click here</a>
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeAffindaEmbedUrlModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
                <input type="hidden" id="hidden_EmbedUrl_Id"/>
                <input type="hidden" id="hidden_SkillChannel_Id"/>
            </div>

        </div>
    </div>
</div>

<script>

    function openEmbedUrlPopUp(id, skillChannelName, existingEmbedUrl = null, urlCreationTimeElapsed = null) {
        //document.getElementById('embed_Anchor_Id').href = "";
        document.getElementById('embed_Anchor_Id').innerHTML = "";
        document.getElementById('embed_id_title').innerHTML = 'Search And Match Link for ' + skillChannelName;
        var alreadyProgrammaticallyGeneratedUrl = document.getElementById('hidden_EmbedUrl_Id').value;
        var alreadyGeneratedForIRFId = document.getElementById('hidden_SkillChannel_Id').value;
        var embedUrl='';
        if (existingEmbedUrl != null && existingEmbedUrl != '') { 
            if ((alreadyProgrammaticallyGeneratedUrl != null && alreadyProgrammaticallyGeneratedUrl != '') && (alreadyGeneratedForIRFId != id) && urlCreationTimeElapsed > 50) { 
                //generate for this
                $.ajax({
                    type: "POST",
                    async: true,
                    url: "/IRF/GenerateEmbeddableResumeSearchUrl",
                    data: { irfId: skillChannelName },
                    success: function (data) {
                        if (data != null) {
                            embedUrl = data;
                            document.getElementById('hidden_EmbedUrl_Id').value = embedUrl;
                            document.getElementById('hidden_SkillChannel_Id').value = id;
                            document.getElementById('embed_Anchor_Id').href = embedUrl;



                        }
                        else {
                            document.getElementById('embed_Anchor_Id').innerHTML = "Link not available for this Skill Channel!";
                            return;
                        }
                    }
                });
            
            }
            else if ((alreadyProgrammaticallyGeneratedUrl == null || alreadyProgrammaticallyGeneratedUrl == '') && urlCreationTimeElapsed > 50) {
                //generate for this
                $.ajax({
                    type: "POST",
                    async: true,
                    url: "/IRF/GenerateEmbeddableResumeSearchUrl",
                    data: { irfId: skillChannelName },
                    success: function (data) {
                        if (data != null) {
                            embedUrl = data;
                            document.getElementById('hidden_EmbedUrl_Id').value = embedUrl;
                            document.getElementById('hidden_SkillChannel_Id').value = id;
                            document.getElementById('embed_Anchor_Id').href = embedUrl;



                        }
                        else {
                            document.getElementById('embed_Anchor_Id').innerHTML = "Link not available for this Skill Channel!";
                            return;
                        }
                    }
                });

            }
            else if ((alreadyProgrammaticallyGeneratedUrl != null && alreadyProgrammaticallyGeneratedUrl != '') && (alreadyGeneratedForIRFId == id) && urlCreationTimeElapsed == null) {
                //generate for this
                embedUrl = document.getElementById('hidden_EmbedUrl_Id').value

            }
            else { 
                embedUrl = existingEmbedUrl;
            }
        }
        else if (existingEmbedUrl != null && existingEmbedUrl != '' ) {
            embedUrl = existingEmbedUrl;
        }
        else if (alreadyProgrammaticallyGeneratedUrl != null && alreadyProgrammaticallyGeneratedUrl != '' && (alreadyGeneratedForIRFId == id) && (urlCreationTimeElapsed)) {
            embedUrl = document.getElementById('hidden_EmbedUrl_Id').value;
        }
        else {
            $.ajax({
                type: "POST",
                async:true,
                url: "/IRF/GenerateEmbeddableResumeSearchUrl",
                data: { irfId: skillChannelName },
                success: function (data) {
                    if(data != null)
                    {
                        embedUrl = data;
                        document.getElementById('hidden_EmbedUrl_Id').value = embedUrl;
                        document.getElementById('hidden_SkillChannel_Id').value = id;
                        document.getElementById('embed_Anchor_Id').href = embedUrl;

                        

                    }
                    else
                    {
                        document.getElementById('embed_Anchor_Id').innerHTML = "Link not available for this Skill Channel!";
                        return;
                    }
                }
            });
        }

        var modal = document.getElementById("AffindaEmbedUrlModel");
        //$("#embed_id_title").text('Search And Match Link for ' + skillChannelName);
        modal.style.display = "block";
        document.getElementById('embed_Anchor_Id').innerHTML = "Click here";
        document.getElementById('embed_Anchor_Id').href = embedUrl;
        
        

        
    }
    function closeAffindaEmbedUrlModel() {
        var model = document.getElementById("AffindaEmbedUrlModel");
        model.style.display = "none";
    }

</script>