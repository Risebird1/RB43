<div class="cd-panel cd-panel--from-right js-tr-window-main">
    <header class="cd-panel__header">
        <pra style="font-weight: bold !important;font-size: 16px !important;">Need Assistance?</pra>
        <a href="#0" class="cd-panel__close js-tr-close">Close</a>
    </header>

    <div class="cd-panel__container">
        <div class="cd-panel__content" id="raiseRequest_Bugs">
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // Delegated so triggers inside DataTables (pagination, responsive child rows, AJAX refresh) keep working
        $(document).off('click.rbRaiseBugOpen', '.js-tr-window-trigger').on('click.rbRaiseBugOpen', '.js-tr-window-trigger', function (event) {
            event.preventDefault();
            var $trigger = $(event.target).closest('.js-tr-window-trigger');
            if (!$trigger.length) return;
            var url = $trigger.data('url');
            var panelAttr = $trigger.attr('data-panel') || 'main';
            var raiseBugClass = 'js-tr-window-' + panelAttr;
            var raiseBugpanel = document.getElementsByClassName(raiseBugClass)[0];
            if (!raiseBugpanel || !url) return;
            addClass(raiseBugpanel, 'cd-panel--is-visible');
            $.get(url).done(function (data) {
                $('#raiseRequest_Bugs').html(data);
            });
        });

        var raiseBugpanel = document.getElementsByClassName('js-tr-window-main')[0];
        if (raiseBugpanel) {
            $(raiseBugpanel).off('click.rbRaiseBugClose').on('click.rbRaiseBugClose', function (event) {
                if (hasClass(event.target, 'js-tr-close') || hasClass(event.target, 'js-tr-window-main')) {
                    event.preventDefault();
                    removeClass(raiseBugpanel, 'cd-panel--is-visible');
                }
            });
        }
    })
    function hasClass(el, className) {
        if (el.classList) return el.classList.contains(className);
        else return !!el.className.match(new RegExp('(\\s|^)' + className + '(\\s|$)'));
    }
    function addClass(el, className) {
        if (el.classList) el.classList.add(className);
        else if (!hasClass(el, className)) el.className += " " + className;
    }
    function removeClass(el, className) {
        if (el.classList) el.classList.remove(className);
        else if (hasClass(el, className)) {
            var reg = new RegExp('(\\s|^)' + className + '(\\s|$)');
            el.className = el.className.replace(reg, ' ');
        }
    }
</script>