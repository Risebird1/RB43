
<!-- WhatsApp Invite Modal -->
<div id="whatsappInviteModal" class="modal modal-bg" style="z-index: 1060;">
    <div class="modal-dialog modal-lg" role="document" style="z-index: 1061;">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <img src="~/img/whatsapp.png" />
                    </span>
                </div>
                <h5 class="modal-title pull-left">Send WhatsApp Invite</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" onclick="CloseWhatsAppInviteModal()" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" style="padding: 20px;">
                <div class="form-group" style="margin-bottom: 15px;">
                    <label style="font-weight: bold; margin-bottom: 10px; display: block;font-size:13px;color:#000">
                        <input type="checkbox" id="selectAllCandidates" onchange="ToggleSelectAll()" style="margin-right: 8px;" />
                        Select All Candidates
                    </label>
                </div>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-striped table-bordered" style="width:100%;">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Select</th>
                                <th>Name</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody id="whatsappInviteCandidateList">
                            <!-- Candidate list will be populated here -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #dee2e6; padding: 15px;">
                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded whatspp-btn" onclick="SendBulkWhatsAppInvites()" style="background: #2c8d2cb8!important;">
                    <img src="~/img/whatsapp.png" style="max-width:18px; vertical-align: middle; margin-right: 5px;" />
                    Send Invite
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // WhatsApp Invite Modal Functions
    function OpenWhatsAppInviteModal() {
        // Ensure candidatesData is available
        if (typeof candidatesData === 'undefined' || !candidatesData) {
            swal.fire({
                title: 'Error',
                html: '<p>Candidate data is not available. Please refresh the page.</p>',
                type: 'error',
                confirmButtonText: 'OK'
            });
            return;
        }

        // Support both data structures: GetCandidates (Name, EmailId, ClientHRAttemptContact) 
        // and NotScheduledMeetingsCO (candidateName, candidateEmail, ClientHrContact)
        var eligibleCandidates = candidatesData.filter(function(candidate) {
            var hasClientHR = candidate.ClientHRAttemptContact || candidate.ClientHrContact;
            var isNotCold = candidate.IsColdCandidate === false || candidate.IsColdCandidate === undefined;
            return hasClientHR && isNotCold;
        });

        if (eligibleCandidates.length === 0) {
            swal.fire({
                title: 'No Eligible Candidates',
                html: '<p>There are no candidates eligible to receive WhatsApp invites. Candidates must have Client HR contact information and not be marked as cold candidates.</p>',
                type: 'info',
                confirmButtonText: 'OK'
            });
            return;
        }

        // Populate candidate list
        var tbody = document.getElementById('whatsappInviteCandidateList');
        tbody.innerHTML = '';

        eligibleCandidates.forEach(function(candidate) {
            var row = document.createElement('tr');
            
            // Support both data structures
            var candidateName = candidate.Name || candidate.candidateName || 'N/A';
            var candidateEmail = candidate.EmailId || candidate.candidateEmail || 'N/A';
            var irfId = candidate.IRFId || candidate.irfId || '';
            var irfName = candidate.IRFName || candidate.irfName || irfId;
            var imid = candidate.imid || '';
            
            // Format EndDate properly for URL (if available)
            var endDateFormatted = '';
            if (candidate.EndDate) {
                var endDate = new Date(candidate.EndDate);
                endDateFormatted = endDate.toISOString();
            } else {
                // Default to 1 year from now if EndDate is not available
                var defaultEndDate = new Date();
                defaultEndDate.setFullYear(defaultEndDate.getFullYear() + 1);
                endDateFormatted = defaultEndDate.toISOString();
            }

            // Escape HTML to prevent XSS
            candidateName = candidateName.replace(/</g, '&lt;').replace(/>/g, '&gt;');
            candidateEmail = candidateEmail.replace(/</g, '&lt;').replace(/>/g, '&gt;');

            // Opted out of WhatsApp for the role, or at the 3-per-IRF limit: shown, but cannot be ticked.
            var blockedReason = candidate.WhatsAppOptedOut ? 'Unsubscribed from WhatsApp for this role'
                : (candidate.WhatsAppLimit && candidate.WhatsAppSendsUsed >= candidate.WhatsAppLimit)
                    ? 'WhatsApp limit reached (' + candidate.WhatsAppSendsUsed + '/' + candidate.WhatsAppLimit + ')' : '';
            if (blockedReason) candidateEmail += ' <span style="color:#6b7280;font-size:11px;">· ' + blockedReason + '</span>';

            row.innerHTML =
                '<td style="text-align: center;">' +
                    '<input type="checkbox" class="candidate-checkbox" ' + (blockedReason ? 'disabled title="' + blockedReason + '" ' : '') + 'value="' + (candidate.EmailId || candidate.candidateEmail || '').replace(/"/g, '&quot;') + '" ' +
                    'data-irfid="' + irfId + '" ' +
                    'data-irfname="' + (irfName || '').replace(/"/g, '&quot;') + '" ' +
                    'data-enddate="' + endDateFormatted.replace(/"/g, '&quot;') + '" ' +
                    (imid ? 'data-imid="' + imid + '" ' : '') +
                    '/>' +
                '</td>' +
                '<td>' + candidateName + '</td>' +
                '<td>' + candidateEmail + '</td>';
            tbody.appendChild(row);
        });

        // Reset select all checkbox
        document.getElementById('selectAllCandidates').checked = false;

        // Show modal - support both Bootstrap 3 and 4
        if (typeof $.fn.modal === 'function') {
            $('#whatsappInviteModal').modal('show');
        } else {
            document.getElementById('whatsappInviteModal').style.display = 'block';
        }
    }

    function CloseWhatsAppInviteModal() {
        // Support both Bootstrap 3 and 4
        if (typeof $.fn.modal === 'function') {
            $('#whatsappInviteModal').modal('hide');
        } else {
            document.getElementById('whatsappInviteModal').style.display = 'none';
        }
        // Clear checkboxes
        document.querySelectorAll('.candidate-checkbox').forEach(function(cb) {
            cb.checked = false;
        });
        document.getElementById('selectAllCandidates').checked = false;
    }

    function ToggleSelectAll() {
        var selectAll = document.getElementById('selectAllCandidates');
        var checkboxes = document.querySelectorAll('.candidate-checkbox:not(:disabled)');

        checkboxes.forEach(function(checkbox) {
            checkbox.checked = selectAll.checked;
        });
    }

    function SendBulkWhatsAppInvites() {
        var selectedCheckboxes = document.querySelectorAll('.candidate-checkbox:checked');
        if (selectedCheckboxes.length === 0) {
            swal.fire({
                title: 'No Selection',
                html: '<p>Please select at least one candidate to send WhatsApp invite.</p>',
                type: 'warning',
                confirmButtonText: 'OK'
            });
            return;
        }

        var selectedCandidates = [];
        selectedCheckboxes.forEach(function(checkbox) {
            var candidate = {
                candidateEmail: checkbox.value,
                IRFId: checkbox.getAttribute('data-irfid'),
                IRFName: checkbox.getAttribute('data-irfname'),
                endDate: checkbox.getAttribute('data-enddate')
            };
            // Include imid if available (for NotScheduledMeetingsCO)
            var imid = checkbox.getAttribute('data-imid');
            if (imid) {
                candidate.imid = imid;
            }
            selectedCandidates.push(candidate);
        });

        // Show confirmation
        swal.fire({
            title: 'Send WhatsApp Invites?',
            html: '<p>You are about to send WhatsApp invites to <strong>' + selectedCandidates.length + '</strong> candidate(s).</p><p>Do you want to continue?</p>',
            type: 'question',
            showCancelButton: true,
            confirmButtonColor: '#2c8d2c',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Send Invites',
            cancelButtonText: 'Cancel',
            allowOutsideClick: false
        }).then(function(result) {
            if (result.value) {
                 $.ajax({
                            url: '/Candidate/SendWhatsAppInvite',
                            method: 'POST',
                            data: { 'CandidateList': selectedCandidates },
                            success: function (data) {
                                 swal.fire({
                                    title: 'Invites Sent!',
                                    html: $('<p>').text(data || 'WhatsApp invites have been sent to candidate(s).').prop('outerHTML'),
                                    type: 'success',
                                    confirmButtonText: 'OK',
                                    allowOutsideClick: false
                                }).then(function() {
                                    CloseWhatsAppInviteModal();
                                    // Reload page if needed (for NotScheduledMeetingsCO)
                                    if (typeof pageUrl !== 'undefined' && pageUrl === 'NotScheduledMeetingsCO') {
                                        location.reload();
                                    }
                                });
                            },
                            error: function() {
                                swal.fire({
                                    title: 'Error',
                                    html: '<p>An error occurred while sending invites. Please try again.</p>',
                                    type: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                 });
            }
        });
    }

    // Update select all checkbox when individual checkboxes change
    $(document).on('change', '.candidate-checkbox', function() {
        var totalCheckboxes = document.querySelectorAll('.candidate-checkbox:not(:disabled)').length;
        var checkedCheckboxes = document.querySelectorAll('.candidate-checkbox:checked').length;
        document.getElementById('selectAllCandidates').checked = (totalCheckboxes === checkedCheckboxes);
    });
</script>


<style>
    .whatspp-btn{
        position:relative;
        right:-80%;

    }
    @@media only screen and (max-width: 480px) {
        .whatspp-btn {
            position: relative;
            right: -63%;
        }
    }
</style>