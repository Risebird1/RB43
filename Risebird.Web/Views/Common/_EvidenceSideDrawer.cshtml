<div id="ivEvidenceDrawerBackdrop" class="iv-evidence-drawer-backdrop" aria-hidden="true"></div>
<aside id="ivEvidenceDrawer" class="iv-evidence-drawer" role="dialog" aria-modal="true" aria-labelledby="ivEvidenceDrawerTitle" aria-hidden="true">
    <div class="iv-evidence-drawer__header">
        <div>
            <h2 id="ivEvidenceDrawerTitle" class="iv-evidence-drawer__title">Evidence</h2>
            <p id="ivEvidenceDrawerSubtitle" class="iv-evidence-drawer__subtitle"></p>
        </div>
        <button type="button" id="ivEvidenceDrawerClose" class="iv-evidence-drawer__close" aria-label="Close drawer">&times;</button>
    </div>
    <div class="iv-evidence-drawer__frame-wrap">
        <iframe id="ivEvidenceDrawerIframe" class="iv-evidence-drawer__iframe" title="Evidence content"></iframe>
    </div>
</aside>
