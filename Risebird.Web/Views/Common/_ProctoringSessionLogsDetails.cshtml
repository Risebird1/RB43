<div id="ProctoringLogsModal" class="modal modal-bg" style="z-index:3;overflow:auto;">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16"><path fill="white" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.66 7.66 0 0 0 1.048-.625 11.777 11.777 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Proctoring Session Logs</h5><span class="candidatename-sla" id="headProctoringLogs"></span>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeProctoringLogsModal()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="divProctoringLogs">
            </div>
        </div>
    </div>
</div>

<script>
    function ProctoringSessionLogsDetails(id) {
        $.ajax({
            url: '/Dashboard/GetProctoringSessionLogs',
            data: { 'id': id },
            type: "GET",
            success: function (data) {
                openProctoringLogsModal();
                $('#divProctoringLogs').html('');
                $('#divProctoringLogs').html(data);
            }
        });
    }
    function closeProctoringLogsModal() {
        var modal = document.getElementById("ProctoringLogsModal");
        modal.style.display = "none";
    }
    function openProctoringLogsModal() {
        var modal = document.getElementById("ProctoringLogsModal");
        modal.style.display = "block";
    }
</script>
