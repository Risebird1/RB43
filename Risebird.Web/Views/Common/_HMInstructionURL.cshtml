<div id="CopyHMInstructionsLinkModel" class="modal modal-bg" style="z-index:99;">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left"> Securely Share HM Instructions Link </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeCopyHMInstructionsLinkModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label class="label-field desp-label"> HM Instructions Link:  <b id="txtHMInstructionLink"> </b></label><button class="copy-btn" onclick="copyHMToClipboard('#txtHMInstructionLink')">
                            <p class="special-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                <span id="special_text_HMInstructions" class="special-text__tooltip">
                                    Copy Link
                                </span>
                            </p>
                        </button>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closeCopyHMInstructionsLinkModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openHMLink(irfId) {
        var currentPort = window.location.port;
        var url = window.location.protocol + '//' + window.location.hostname + (currentPort ? ":" + currentPort : "") + "/IRF/DeliveryHeadInstruction?irfid=" + irfId;
        window.open(url, '_blank');
    }
    function CopyHMInstructionsLink(irfId, irfName) {
        var modal = document.getElementById("CopyHMInstructionsLinkModel");
        modal.style.display = "block";
        var currentPort = window.location.port;
        var url = window.location.protocol + '//' + window.location.hostname + (currentPort ? ":" + currentPort : "") + "/IRF/DeliveryHeadInstruction?irfid=" + irfId + "&Type=ublc";
        $("#txtHMInstructionLink").text(url);
    }
    function closeCopyHMInstructionsLinkModel() {
        var modal = document.getElementById("CopyHMInstructionsLinkModel");
        modal.style.display = "none";
    }
    function copyHMToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        if (element == '#txtHMInstructionLink') {
            $('#special_text_HMInstructions').text('Copied');
        }
        else {
            $('#special_text').text('Copied');
        }
    }
</script>