<div id="ClientInterviewRatingModel" class="modal modal-bg" style="z-index:3;overflow:auto;">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document" style="max-width:750px !important">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <img class="rating-star" src="~/img/rating-star-icon.png" />
                    </span>
                </div>
                <h5 class="modal-title pull-left">Rate Interview</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeClientInterviewRating()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" style="padding: 2px 16px;" id="divClientInterviewRating">
            </div>
        </div>
    </div>
</div>

<script>
    function ClientInterviewRating(interviewid, Reportsnippet) {
        $.ajax({
            url: '/Interview/ClientInterviewReview',
            data: { 'id': interviewid, 'actionType': Reportsnippet },
            type: "GET",
            success: function (data) {
                if (document.getElementById("ClientInterviewRatingModel").style.display != "block") {
                    openClientInterviewRating();
                    $('#divClientInterviewRating').html('');
                    $('#divClientInterviewRating').html(data);
                }
            }
        });
    }
    function closeClientInterviewRating() {
        var modal = document.getElementById("ClientInterviewRatingModel");
        modal.style.display = "none";
    }
    function openClientInterviewRating() {
        var modal = document.getElementById("ClientInterviewRatingModel");
        modal.style.display = "block";
    }
</script>