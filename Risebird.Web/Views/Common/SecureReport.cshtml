<div id="SecureUrlModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Secure Share Url</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeSecureUrlModelModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <input type="hidden" id="hidmodelinterviewid" />
                    <input type="hidden" id="hidmodelirfId" />
                    <input type="email" id="SecuremodelEmailid" placeholder="Enter Email Address to whom you want to share secure Url." class="form-control" />
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="CopyPublicUrl()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Submit">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="SecureUrlShareModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Secure Share Url</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeSecureUrlShareModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label class="label-field desp-label"> Video Url:  <b id="txtsecurevideoUrls"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtsecurevideoUrls')">
                            <p class="special-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                <span id="Securespecial_text" class="special-text__tooltip">
                                    Copy Link
                                </span>
                            </p>
                        </button>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closeSecureUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="SecureReportNotificationModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img width="30" class="publicsharing-icon" src="~/Newassets/img/quality.png"></span>
                </div>
                <h5 class="modal-title pull-left">Quality Issue</h5>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="quality-con">
                    <label>If you have any concerns with quality, use the above <strong>'Report Quality Issue'</strong> button to leave feedback.</label>
                    <ul>
                        <li>Rate Interviewer</li>
                        <li>Audio Feedback</li>
                        <li>Mass Communication</li>
                        <li>Report red flags</li>
                        <li>Redo Interview</li>
                    </ul>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="background: #53a5f5!important;line-height: 13px;" type="button" onclick="closeSecureReportNotificationModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="OK">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="SecureRedoInterviewModel" class="modal modal-bg" style="z-index:5">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Redo Interview</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeSecureRedoInterviewModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" id="divredoInterview">
            </div>
        </div>
    </div>
</div>
<script>
    function GenerateSecureUrl(interviewid, irfid) {
        $("#hidmodelinterviewid").val(interviewid);
        $("#hidmodelirfId").val(irfid);
        var modal = document.getElementById("SecureUrlModel");
        modal.style.display = "block";
    }
    function CopyPublicUrl() {
        var interviewId = $("#hidmodelinterviewid").val();
        var EmailId = $("#SecuremodelEmailid").val();
        var irfid = $("#hidmodelirfId").val();
        if (EmailId.trim() != "") {
            $.ajax({
                url: '/Interview/ShareSecureReport',
                data: { 'Emailid': EmailId, interviewId: interviewId, irfid: irfid },
                type: 'POST',
                success: function (result) {
                    var modal = document.getElementById("SecureUrlShareModel");
                    modal.style.display = "block";
                    closeSecureUrlModelModel();
                    $("#txtsecurevideoUrls").text(result);
                }
            });
        } else {
            alert("Please Enter a emailaddess");
        }
    }
    function closeSecureUrlShareModel() {
        var modal = document.getElementById("SecureUrlShareModel");
        modal.style.display = "none";
    }
    function closeSecureUrlModelModel() {
        var modal = document.getElementById("SecureUrlModel");
        modal.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#Securespecial_text').text('Copied');
    }
    function closeSecureReportNotificationModel() {
        var modal = document.getElementById("SecureReportNotificationModel");
        modal.style.display = "none";
    }
    function openSecureReportNotificationModel() {
        var modal = document.getElementById("SecureReportNotificationModel");
        modal.style.display = "block";
    }
    function OpenSecureRedoFormModel(interviewid, interviewstatus, type, uniqueid) {
        var interviewstatusdetails = '';
        if (interviewstatus == 2 || interviewstatus == 4) {
            interviewstatusdetails = 'Selected';
        }else {
            interviewstatusdetails = 'Reject';
        }
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { 'interviewid': interviewid, 'interviewstatus': interviewstatusdetails, 'type': type, 'uniqueid': uniqueid },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openSecureRedoInterviewModel();
            }
        });
    }
    function openSecureRedoInterviewModel() {
        var modal = document.getElementById("SecureRedoInterviewModel");
        modal.style.display = "block";
    }
    function closeSecureRedoInterviewModel() {
        var modal = document.getElementById("SecureRedoInterviewModel");
        modal.style.display = "none";
    }
</script>
