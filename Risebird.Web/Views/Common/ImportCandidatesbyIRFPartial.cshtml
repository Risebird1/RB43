<script>
    var projectspan = document.getElementById("importprojectPopUp");
    // When the user clicks on <span> (x), close the modal
    projectspan.onclick = function () {
        var modal = document.getElementById("id_projectimport_myModal");
        modal.style.display = "none";
    }

    function OpenProjectImportModal(irfId, irfName, emailid,JDTiltle) {
        //document.getElementById("id_import_IsSendInvite").value = value;
        clientEmailId = emailid;
        // Get the modal
        var modal = document.getElementById("id_projectimport_myModal");

        // When the user clicks the button, open the modal
        modal.style.display = "block";
        document.getElementById("id_projectimport_IRFId").value = irfId;
        document.getElementById("id_projectimport_IRFName").value = irfName;
        document.getElementById("id_projectimport_JDTiltle").value = JDTiltle;
        document.getElementById("id_projectimport_Title").innerHTML = '';
        document.getElementById("id_projectimport_Title").innerHTML = 'Import Candidates for ' + irfName + '<span style="padding:0px 5px;color:green;text-transform: capitalize;display: block;font-size: 18px;"> (' +JDTiltle+ ')</span>';

    }
    function ImportQuickProjectCandidates() {
        document.getElementById("btnProjectImport").disabled = true;
        var irfExcelId = document.getElementById("id_projectimport_IRFId").value;
        var irfExcelName = document.getElementById("id_projectimport_IRFName").value;
        var jdtitleName = document.getElementById("id_projectimport_JDTiltle").value;

        var excel_file = $("#idProjectExcelFile")[0].files[0];
        var isSendInvite = document.getElementById("id_projectimport_IsSendInvite").value;


        var formdata = new FormData();
        formdata.append('IRFId', irfExcelId);
        formdata.append('IsSendInvite', isSendInvite);
        formdata.append('excel_file', excel_file);
        formdata.append('IRFName', irfExcelName);
        formdata.append('clientEmailId', clientEmailId);

        $.ajax({
            type: "POST",
            url: "/Candidate/ImportQuickProjectCandidates",
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {
                bindresultdata(data);
                document.getElementById("btnProjectImport").disabled = false;
                document.getElementById('importResultModal').style.display = "block";
            }
        });
    }
    function bindresultdata(data){
        if(data.message=="success"){
            var html='<table class="table table-striped table-bordered dataTable dtr-inline" cellspacing="0" cellpadding="0" width="100%"><tr><td>Candidate</td><td>Status</td></tr>';
            for(i=0;i<data.list.length;i++){
                html+='<tr><td>'+data.list[i].emailId+'</td><td>'+data.list[i].onboardingStatus+'</td></tr>';
            }
            html+='</table>';
            $('#importResultTableBody').empty().html(html);
        }
        else{
             var importMsg = data.message.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
                $('#importResultTableBody').html('');
                $('#importResultTableBody').html(importMsg);
        }
    }

</script>