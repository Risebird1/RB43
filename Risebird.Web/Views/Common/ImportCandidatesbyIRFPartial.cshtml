

<div id="id_import_myModal" class="modal">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                <div class="filheader">
                    <div class="filavatar">
                        <span>

                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg>
                        </span>
                    </div>
                    <h5 class="modal-title" id="id_import_Title"> Import Candidates</h5>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                </button>


                <div class="modal-body">
                    <div class="form-group text-center">
                        <h5 style="font-size:20px;"> Download the template  <span onclick="location.href='@Url.Action("DownloadTemplate", "Candidate")'"><svg style="fill:#53a5f5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg></span></h5>


                    </div>

                    @using (Html.BeginForm("ImportQuickCandidates", "Candidate", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-group">

                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded upload-wrap" for="UploadedFile" style="margin:0px auto; display:block;height:40px!important;background: #65cbcb3d;border:0px;width:330px">
                                <div class="file-upload-wrapper" data-text="CLICK HERE TO CHOOSE FILE">
                                    <input type="file" class="file-upload-field" accept=".xls, .xlsx" name="UploadedFile" id="idExcelFile" />

                                </div>
                            </button>

                        </div>

                        <div class="">
                            <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 0px auto;display: block;" id="btnImport" value="Import" onclick="ImportQuickCandidates()">

                        </div>
                        <input type="hidden" id="id_import_IRFId" name="IRFId">
                        <input type="hidden" id="id_import_IRFName" name="IRFName">
                        <input type="hidden" id="id_import_JDTiltle" name="JDTiltle">
                        <input type="hidden" id="id_import_IsSendInvite" name="IsSendInvite" value="true">

                    }


                </div>

            </div>

        </div>
    </div>
</div>

<div id="importResultModal" class="modal modal-bg" style="z-index:1060">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">


            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-file-import" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="importResultHeading">Import status</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="importResultPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body" id="importResultTableBody" style=" overflow: auto; height: 300px">
            </div>
        </div>

    </div>
</div>
