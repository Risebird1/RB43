<div id="AddCandidateModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                            <path fill="rgb(255, 255, 255)" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
                        </svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Add Candidate <label id="txtmodelheader"></label></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeAddCandidateModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" style="padding-bottom:0px" id="addCandidatelist">
            </div>
        </div>
    </div>
</div>
<script>
    function AddClientCandidate(requestid, name, emailid, uniqueid, type) {
        $.ajax({
            url: '/Candidate/AddCandidateByClient',
            data: { 'requestid': requestid, 'requestname': name, 'type': type, 'uniqueid': uniqueid, 'emailids': emailid },
            success: function (data) {
                $('#addCandidatelist').html('');
                $('#addCandidatelist').html(data);
                openAddCandidateModel();
            }
        });
    }
    function openAddCandidateModel() {
        var modal = document.getElementById("AddCandidateModel");
        modal.style.display = "block";
    }
    function closeAddCandidateModel() {
        var modal = document.getElementById("AddCandidateModel");
        modal.style.display = "none";
    }
</script>