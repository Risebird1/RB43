<div id="ProxyReportModel" class="modal modal-bg" style="z-index:3;overflow:auto;">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg>

                    </span>
                </div>
                <h5 class="modal-title pull-left">Proxy Details</h5><span class="candidatename-sla" id="headProxyReport"></span>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeProxyReportModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="divProxyReport">
            </div>
        </div>
    </div>
</div>


<script>
    function ProxyReportDetails(id) {
        $.ajax({
            url: '/Dashboard/GetProxyReportCountDetails',
            data: { 'id': id},
            type: "GET",
            success: function (data) {
                openProxyReportModel();
                $('#divProxyReport').html('');
                $('#divProxyReport').html(data);
               
            }
        });
    }
    function closeProxyReportModel() {
        var modal = document.getElementById("ProxyReportModel");
        modal.style.display = "none";
    }
    function openProxyReportModel() {
        var modal = document.getElementById("ProxyReportModel");
        modal.style.display = "block";
    }
</script>
