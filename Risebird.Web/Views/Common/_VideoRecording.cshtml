</script>
 <script>

var width = 165,
  height = 165,
  timePassed = 0,
  timeLimit = 94

var fields = [{
  value: timeLimit,
  size: timeLimit,
  update: function() {
    return timePassed = timePassed + 1;
  }
}];

var nilArc = d3.svg.arc()
  .innerRadius(width / 3 - 120)
  .outerRadius(width / 3 - 120)
  .startAngle(0)
  .endAngle(2 * Math.PI);

var arc = d3.svg.arc()
  .innerRadius(width / 3 - 28)
  .outerRadius(width / 3 - 20)
  .startAngle(0)
  .endAngle(function(d) {
    return ((d.value / d.size) * 2 * Math.PI);
  });

var svg = d3.select("#timer-clock").append("svg")
  .attr("width", width)
  .attr("height", height);

var field = svg.selectAll(".field")
  .data(fields)
  .enter().append("g")
  .attr("transform", "translate(" + width / 2 + "," + height / 2 + ")")
  .attr("class", "field");

var back = field.append("path")
  .attr("class", "path path--background")
  .attr("d", arc);

var path = field.append("path")
  .attr("class", "path path--foreground");

var label = field.append("text")
  .attr("class", "label")
  .attr("dy", ".35em");

(function update() {

  field
    .each(function(d) {
      d.previous = d.value, d.value = d.update(timePassed);
    });

  path.transition()
    .ease("elastic")
    .duration(500)
    .attrTween("d", arcTween);

  if ((timeLimit - timePassed) <= 10)
    pulseText();
  else
    label
    .text(function(d) {
      return d.size - d.value;
    });

  if (timePassed <= timeLimit)
  {
       setTimeout(update, 1000 - (timePassed % 1000));
  }
  else
  {
    destroyTimer();
    document.getElementById('btnStop').click();
  }
})();

function pulseText() {
  back.classed("pulse", true);
  label.classed("pulse", true);

  if ((timeLimit - timePassed) >= 0) {
    label.style("font-size", "35px")
      .attr("transform", "translate(0," + +4 + ")")
      .text(function(d) {
        return d.size - d.value;
      });
  }

  label.transition()
    .ease("elastic")
    .duration(900)
    .style("font-size", "35px")
    .attr("transform", "translate(0," + -10 + ")");
}

function destroyTimer() {
  label.transition()
    .ease("back")
    .duration(700)
    .style("opacity", "0")
    .style("font-size", "5")
    .attr("transform", "translate(0," + -40 + ")")
    .each("end", function() {
      field.selectAll("text").remove()

    });

  path.transition()
    .ease("back")
    .duration(700)
    .attr("d", nilArc);

  back.transition()
    .ease("back")
    .duration(700)
    .attr("d", nilArc)
    .each("end", function() {
      field.selectAll("path").remove()
       document.getElementById('timer-clock-txt').style.display = 'none';
    });
}

function arcTween(b) {
  var i = d3.interpolate({
    value: b.previous
  }, b);
  return function(t) {
    return arc(i(t));
  };
}

 </script>
<script>
    let constraintObj = {
            audio: true,
            video: true
        };
    
        if (navigator.mediaDevices === undefined) {
            navigator.mediaDevices = {};
            navigator.mediaDevices.getUserMedia = function (constraintObj) {
                let getUserMedia = navigator.webkitGetUserMedia || navigator.mozGetUserMedia;
                if (!getUserMedia) {
                    return Promise.reject(new Error('getUserMedia is not implemented in this browser'));
                }
                return new Promise(function (resolve, reject) {
                    getUserMedia.call(navigator, constraintObj, resolve, reject);
                });
            }
        } else {
            navigator.mediaDevices.enumerateDevices()
                .then(devices => {
                    devices.forEach(device => {
                        console.log(device.kind.toUpperCase(), device.label);
                    })
                })
                .catch(err => {
                    console.log(err.name, err.message);
                })
        }

        navigator.mediaDevices.getUserMedia(constraintObj)
            .then(function (mediaStreamObj) {
                console.log('test')
                let video=document.getElementById('video');
                
                let camara = document.getElementById('btncamara');
                let offcamara = document.getElementById('btnoffcamara');

                let start = document.getElementById('btnStart');
                let stop = document.getElementById('btnStop');
                let save = document.getElementById('btnSave');
                let vidSave = document.getElementById('vid2');
                let mediaRecorder = new MediaRecorder(mediaStreamObj);
                let chunks = [];
                let blobtransfer;
                document.getElementById('btnStart').disabled = true;
                document.getElementById('btnStop').disabled = true;
                camara.addEventListener('click', (ev) => {
                    video.srcObject=mediaStreamObj;
                    console.log(mediaRecorder.state);
                })
                offcamara.addEventListener('click', (ev) => {
                    video.srcObject = null;
                    console.log(mediaRecorder.state);
                })
                start.addEventListener('click', (ev) => {
                    mediaRecorder.start();
                    document.getElementById('btnStart').disabled = true;
                     //   stop button enable disable false
                    document.getElementById('btnStop').disabled = false;
                    console.log(mediaRecorder.state);
                })
                stop.addEventListener('click', (ev) => {
                    mediaRecorder.stop();
                    document.getElementById('btnStart').disabled = false;
                    //   stop button enable disable false
                    document.getElementById('btnStop').disabled = true;
                    console.log(mediaRecorder.state);
                });
                save.addEventListener('click', (ev) => {
                    var form_data = new FormData();
                    form_data.append("file", blobtransfer);
                    $.ajax({
                            type: "POST",
                            url: "/Interviewer/UploadVideoKYC",
                            data: form_data,
                            contentType: false,
                            enctype: 'multipart/form-data',
                            processData: false,
                            success: function (data) {
                                  alert(data);
                                  closeVideoKYCModel();
                            }
                        });
                });
                mediaRecorder.ondataavailable = function (ev) {
                    chunks.push(ev.data);
                }
                mediaRecorder.onstop = (ev) => {
                    let blob = new Blob(chunks, { 'type': 'video/mp4;' });
                    chunks = [];
                    let videoURL = window.URL.createObjectURL(blob);
                    vidSave.src = videoURL;
                    console.log(videoURL);
                    blobtransfer=blob;
                }
            })
            .catch(function (err) {
                console.log(err.name, err.message);
            });
</script>

