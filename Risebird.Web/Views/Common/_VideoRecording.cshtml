<div id="VideoKYCModel" class="modal modal-bg" style="z-index:3">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document" style="max-width: 1050px !important;">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-lightbulb" viewBox="0 0 16 16"> <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z" fill="white"></path> </svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Video KYC </h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeVideoKYCModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="divVideoKycmodel">
                <video id="video" autoplay="true" muted></video>
                <hr />Preview<hr />
                <video id="vid2" controls></video>
                <button id="btncamara">Start camara</button>
                <button id="btnStart">Record</button>
                <button id="btnStop">Stop</button>
                <button id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    function closeVideoKYCModel() {
        var model = document.getElementById("VideoKYCModel");
        model.style.display = "none";
    }
    function openVideoKYCModel() {
        var model = document.getElementById("VideoKYCModel");
        model.style.display = "block";
    }
</script>
<script>
    let constraintObj = {
            audio: true,
            video: true
        };
    
        if (navigator.mediaDevices === undefined) {
            navigator.mediaDevices = {};
            navigator.mediaDevices.getUserMedia = function (constraintObj) {
                let getUserMedia = navigator.webkitGetUserMedia || navigator.mozGetUserMedia;
                if (!getUserMedia) {
                    return Promise.reject(new Error('getUserMedia is not implemented in this browser'));
                }
                return new Promise(function (resolve, reject) {
                    getUserMedia.call(navigator, constraintObj, resolve, reject);
                });
            }
        } else {
            navigator.mediaDevices.enumerateDevices()
                .then(devices => {
                    devices.forEach(device => {
                        console.log(device.kind.toUpperCase(), device.label);
                    })
                })
                .catch(err => {
                    console.log(err.name, err.message);
                })
        }

        navigator.mediaDevices.getUserMedia(constraintObj)
            .then(function (mediaStreamObj) {
                let video=document.getElementById('video');
                
                let camara = document.getElementById('btncamara');
                let start = document.getElementById('btnStart');
                let stop = document.getElementById('btnStop');
                let save = document.getElementById('btnSave');
                let vidSave = document.getElementById('vid2');
                let mediaRecorder = new MediaRecorder(mediaStreamObj);
                let chunks = [];
                let blobtransfer;

                camara.addEventListener('click', (ev) => {
                    video.srcObject=mediaStreamObj;
                    console.log(mediaRecorder.state);
                })
                start.addEventListener('click', (ev) => {
                    mediaRecorder.start();
                    console.log(mediaRecorder.state);
                })
                stop.addEventListener('click', (ev) => {
                    mediaRecorder.stop();
                    console.log(mediaRecorder.state);
                });
                save.addEventListener('click', (ev) => {
                    var form_data = new FormData();
                    form_data.append("file", blobtransfer);
                    $.ajax({
                            type: "POST",
                            //url: "/MCQ/CandidateQuestionsD",
                            data: form_data,
                            contentType: false,
                            enctype: 'multipart/form-data',
                            processData: false,
                            success: function (data) {
                                  console.log("save successully");
                            }
                        });
                });
                mediaRecorder.ondataavailable = function (ev) {
                    chunks.push(ev.data);
                }
                mediaRecorder.onstop = (ev) => {
                    let blob = new Blob(chunks, { 'type': 'video/mp4;' });
                    chunks = [];
                    let videoURL = window.URL.createObjectURL(blob);
                    vidSave.src = videoURL;
                    console.log(videoURL);
                    blobtransfer=blob;
                }
            })
            .catch(function (err) {
                console.log(err.name, err.message);
            });
</script>