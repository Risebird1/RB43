                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete client">
                                                                <span onclick="javascript:DeleteCandidateFromTest('@item.PartitionKey','@item.Id','@item.SameID');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                            </button>
                                                        }
                                                        <a target="_blank" href='@Url.Action("CandidateMCQReport", "MCQ", new { MCQId = item.SameID, CMCQId = item.Id,SMCQId=item.SMCQId })'>
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                <span title="Questions Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                            </button>
                                                        </a>
                                                        <button class="mdc-fab app-fab--absolute " aria-label="Generate URL">
                                                            <span title="Generate URL" onclick="javascript:GeneratePublicUrl('@item.SameID','@item.Id');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg></span>
                                                        </button>
                                                        @if (item.AadhaarVerification)
                                                        {
                                                            <button class="mdc-fab app-fab--absolute " aria-label="Candidate Verified Data">
                                                                <span title="Candidate Verified Data" onclick="javascript:FetchAadhaarDetails('@item.SameID','@item.CandidateEmail');" class="mdc-fab__icon material-icons">
                                                                    <img width="16" height="16" fill="currentColor" class="bi bi-person-check" viewBox="0 0 16 16" style="border-radius:50%" src="~/img/Aadhaar/verificationlogo.png" title="Candidate Verified Data" onclick="javascript:FetchAadhaarDetails('@item.SameID','@item.CandidateEmail');" />
                                                                </span>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

