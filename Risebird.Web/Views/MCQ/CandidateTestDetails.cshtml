                                                                    </p>
                                                                </div>
                                                                <a onclick="moreless('@item.Id')" class="moreless-button" value="Readmore" id="read_@item.Id" href="#">Read more</a>
                                                            }
                                                            else
                                                            {
                                                                <div class="article">
                                                                    <p>
                                                                        @item.FeedbackComment.Substring(0, @item.FeedbackComment.Length)
                                                                    </p>
                                                                </div>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="text-right" style="padding-right:30px;">
                                                        @if (ViewBag.Isclient == false)
