    function ResetFilter() {
        var id = $("#txtCanidateListId").val();
        window.location.href = "/MCQ/ResetMCQCandidateFilter/" + id;
    }
    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var skillsset = @Html.Raw(Json.Serialize(ClientHR));
        var levelset = @Html.Raw(Json.Serialize(SelectionStatus));
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#SelectionStatus").val(levelset);
        $("#ClientHR").val(skillsset);
    }
    function GeneratePublicUrl(mcqid, CMCQID) {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "block";
        var urlcurrent = window.location.href;
        urlcurrent = urlcurrent.replace("CandidateTestDetails", "CandidateMCQReport");
        urlcurrent = urlcurrent.replace("?id", "?MCQId");
        urlcurrent = urlcurrent + "&CMCQId=" + CMCQID;
        $("#txtvideoUrls").text(urlcurrent);
    }
    function closePublicUrlShareModel() {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
</script>
