@model Risebird.Entities.ViewModel.CandidateDetailsForTestDuplicate

@{
    ViewData["Title"] = "Recruiter Interview Candidate Report";
    if (ViewBag.PublicLayout)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_PublicLayout.cshtml";
    }
}
<script>
    var Header = "<div>MCQ Candidate Report</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=987654" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=987654" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<script>
    document.getElementById('theme').href = '../Newassets/css/blue-theme.css';
</script>
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Recruiter Interview Candidate Report</h4></div>
                </div>
                <div class="pull-right">
                    <div>
                        @*<a href="/MCQ/Index" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">Back</a>*@
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content dataloading client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="ng-pristine ng-valid form" id="reportForm">
                            <div class="canvas_div_pdf">
                                <form action="/MCQ/CandidateMCQReport" enctype="multipart/form-data" method="post" class="ng-pristine ng-valid form" id="reportForm">
                                    <div class="report-full-wrap">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h3 class="mb-0"><span>Candidate Details</span></h3>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-wrap">
                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv pull-left">
                                                    <div class="form-group">
                                                        @Html.HiddenFor(m => m.Id)
                                                        @Html.HiddenFor(m => m.SameID)
                                                        @Html.HiddenFor(m => m.ApplyingCompany)
                                                        @Html.LabelFor(model => model.CandidateEmail, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @Html.TextBoxFor(m => m.CandidateEmail, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.CandidateScore, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @Html.TextBoxFor(m => m.CandidateScore, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv pull-left">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.Skills, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @Html.TextBoxFor(m => m.Skills, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div class="form-group">
                                                        @Html.LabelFor(model => model.TotalQuestions, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                        @Html.TextBoxFor(m => m.TotalQuestions, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                @if (!string.IsNullOrWhiteSpace(Model.AadhaarVerificationDone))
                                                {
                                                    <div class="col-md-6 col-sm-6 border-rv pull-left">
                                                        <div class="form-group" style="padding-left:10px">
                                                            <a href="#" onclick="javascript:FetchAadhaarDetails('@Model.SameID','@Model.CandidateEmail');">Click Here For Candidate Verified Data</a>
                                                        </div>
                                                    </div>
                                                }
                                                @Html.HiddenFor(m=>m.ShareType)
                                                @if (Model.ShareType)
                                                {
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            @Html.CheckBoxFor(m => m.IsInterviewerVerified) Interviewer Verified
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="report-full-wrap">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h3 class="mb-0"><span>MCQ Video</span></h3>
                                                </div>
                                            </div>
                                        </div>
                                        <div style=" box-shadow: 0 1px 15px 1px rgb(39 39 39 / 10%); padding: 10px; margin-bottom: 25px; background: #fff;">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="videoConplayer">
                                                    @if (Model.VideoLink != null && Url.Content(Model.VideoLink) != null)
                                                    {
                                                    //string appendTime = "0";
                                                    //var src = Model.VideoLink + "#t=" + appendTime;
                                                        <video width="600" controls="controls" preload="metadata" class="vjs-tech">
                                                            @*<source src='@src' type="video/mp4">*@
                                                            <source src='@Model.VideoLink' type="video/mp4">
                                                        </video>
                                                    }
                                                    else
                                                    {
                                                        <label>No Video found</label>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="multiple_row">
                                                <h3 class="mb-0"><span>Report Details</span></h3>
                                            </div><!--end of multiple location-->
                                        </div>
                                    </div>
                                    <div class="report-full-wrap">
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h3 class="mb-0"><span>Questions Report</span></h3>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-wrap">
                                            <div class="col-md-8 offset-md-2">
                                                <div class="mdc-card card  bl-bg">
                                                    <div class="mdc-card-wrapper__text-section">
                                                        @foreach (var item in Model.QuestionDetails)
                                                        {
                                                            <div>
                                                                <div class="x-text">
                                                                    <!--button: Start-->
                                                                </div>
                                                                <div class="man">@item.QuestionNumber ) @item.Question </div>
                                                                <div>
                                                                    @if (item.QuestionType == "Multiple")
                                                                    {
                                                                        <p class="calloption"><input type="checkbox" /> @item.Option1</p>
                                                                        <p class="calloption"><input type="checkbox" /> @item.Option2</p>
                                                                        <p class="calloption"><input type="checkbox" /> @item.Option3</p>
                                                                        <p class="calloption"><input type="checkbox" /> @item.Option4</p>
                                                                        <hr />
                                                                    }
                                                                    else
                                                                    {
                                                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option1</p>
                                                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option2</p>
                                                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option3</p>
                                                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option4</p>
                                                                    }
                                                                    <p class="calloption">Answer: <c style="color:green">@item.Answer</c></p>
                                                                    @if (item.Rating == 1)
                                                                    {
                                                                        <p class="calloption">Candidate Answer: <c style="color:green">@item.QuestionAnswer</c></p>
                                                                    }
                                                                    else
                                                                    {
                                                                        <p class="calloption">Candidate Answer: <c style="color:red">@item.QuestionAnswer</c></p>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="AadhaarKYCpopup" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document" style="max-width:850px !important">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="mdc-fab__icon material-icons">
                        <img src="~/img/Aadhaar/aadhaar-logo-png.jpg" />
                    </span>
                </div>
                <h5 class="modal-title pull-left">Candidate Verified Data</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeAadhaarKYCpopup()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body">
                <div style="padding:10px" id="divAadhaarKYC">
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/Aadhaar.js"></script>
