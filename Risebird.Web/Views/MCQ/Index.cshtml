@model Risebird.Entities.ViewModel.MCQDropdowndetails
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Phone Screen+";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string[] PrimarySkill = new string[] { };
    string[] SelectionStatus = new string[] { };
    string[] SecondarySkill = new string[] { };
    string[] CompentencyLevel = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("MCQSetList") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("MCQSetList"));
    SelectionStatus = filter.SelectionStatus != null ? filter.SelectionStatus : new string[] { };
    PrimarySkill = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    SecondarySkill = filter.SecondarySkill != null ? filter.SecondarySkill : new string[] { };
    CompentencyLevel = filter.CompentencyLevel != null ? filter.CompentencyLevel : new string[] { };

}
<style>
    [type="datetime-local"] {
        background: #ececee !important;
    }

    .mdc-card .modal .form-control[type="datetime-local"], .modal .form-control[type="datetime-local"] {
        background: #ececee !important;
    }
</style>
<script>
    var Header = "Phone Screen+";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<link href="~/Newassets/css/select2.css?v7" defer rel="stylesheet" />
<div class="main-panel" id="main-panel">

    <!--  <div class="panel-header panel-header-sm"></div>-->



    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Phone Screen+</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded btn4 card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>

                        @if (@HttpContextAccessor.HttpContext.Session.GetString("profileName") != null)
                        {
                            var profileName = @HttpContextAccessor.HttpContext.Session.GetString("profileName")?.Trim();
                            profileName = profileName.Replace("\"", "");
                            if (profileName == "Admin" || profileName == "HR")
                            {
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                    <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="openCreatePopUp()" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Add Phone Screen+</font></span>
                                </button>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>

                        <div class="modal modal-wrap fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg" role="document">
                                <div class="modal-content">
                                    <div class="filheader">
                                        <div class="filavatar">
                                            <span class="fa fa-filter"></span>
                                        </div>
                                        <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                    </div>
                                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                    <form action="@Url.Action("Index","MCQ")" method="post" id="form">

                                        <div class="modal-body">
                                            <div class="row">
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="SelectionStatus">
                                                            Profile Level
                                                        </label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <select id="SelectionStatus" name="SelectionStatus" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                @foreach (var item in ViewBag.ProfileType)
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="PrimarySkill">
                                                            Primary Skills
                                                        </label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <select id="PrimarySkill" name="PrimarySkill" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                @foreach (var item in ViewBag.Skills)
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6 border-rv">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="CompentencyLevel">
                                                            Compentency Level
                                                        </label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <select id="CompentencyLevel" name="CompentencyLevel" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                @foreach (var item in ViewBag.CompentencyLevel)
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 col-sm-6">
                                                    <div class="form-group">
                                                        <label class="control-label col-md-12 col-sm-12 desp-label" for="SecondarySkill">
                                                            Secondary Skills
                                                        </label>
                                                        <div class="col-md-12 col-sm-12">
                                                            <select id="SecondarySkill" name="SecondarySkill" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                @foreach (var item in ViewBag.SecondarySkills)
                                                                {
                                                                    @if (item != null && item != "")
                                                                    {
                                                                        <option value="@item">@item</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group col-md-12 col-sm-12">
                                                    <div>
                                                        <div class="col-md-12 col-sm-12 mc-button-area text-right">
                                                            <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn4  reset-filter">
                                                                Reset Filter
                                                            </button>
                                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn5 apply-filter">
                                                                Apply Filter
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </form>
                                </div>
                            </div>

                        </div>
                        <!-- Start Card -->
                        <div class="row">
                            @foreach (var item in Model._MCQVMset)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                    <div class="card-content-holder border card-blue">
                                        <div class="card-header">
                                            <div class="row">
                                                <div class=" col-md-12 col-sm-12 first">
                                                    <h6 style=" padding-top: 10px;">@item.Title</h6>
                                                    <input type="hidden" value="@item.Title" id="txttitlevalue_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.Timer" id="txttimevalue_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.ProfileType" id="txtProfilevalue_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.PrimarySkills" id="txtPrimarySkill_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.SecondarySkill" id="txtSecondarySkill_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.CompentencyLevel" id="txtCompentencyLevel_@item.PartitionKey" />

                                                </div>
                                            </div>
                                        </div>
                                        <!-- irf body-->
                                        <div class="card-body">
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 1px; width: 100%; float: left">
                                                <div class="client-field">Questions:</div> <div class="clientName" style="width:180px !important"> @item.QuestionCount</div>
                                            </div>
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 1px; width: 100%; float: left">
                                                <div class="client-field">Time:</div> <div class="client-name" style="width:180px !important">@item.Timer Mins</div>
                                            </div>
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 1px; width: 100%; float: left">
                                                <div class="client-field">Profile Level:</div> <div class="clientName" style="width:180px !important"> @item.ProfileTypeName</div>
                                            </div>
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 1px; width: 100%; float: left">
                                                <div class="client-field">Compentency:</div> <div class="clientName" style="width:180px !important"> @item.CompentencyLevelName</div>
                                            </div>
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 1px; width: 100%; float: left">
                                                <div class="client-field">Primary Skill:</div> <div class="clientName" style="width:180px !important"> @item.PrimarySkills </div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                @if (!String.IsNullOrEmpty(item.SecondarySkill))
                                                {
                                                    @if (item.SecondarySkill.Length > 25)
                                                    {
                                                        <div class="client-field">Secondary Skill: </div> <div class="clientName" style="width:180px" title="@item.SecondarySkill"> @item.SecondarySkill.Substring(0, 25)...</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="client-field">Secondary Skill:</div> <div class="clientName" style="width:180px"> @item.SecondarySkill</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="client-field">Secondary Skill:</div> <div class="clientName" style="width:180px"> @item.SecondarySkill</div>
                                                }
                                            </div>
                                        </div>
                                        <div class="card-footer action">
                                            <div class="col-md-12">

                                                <div class="text-right card-header-buttons action">
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="Share MCQ Set" style="background: #59b259 !important" title="Share MCQ Set">
                                                        <span onclick="javascript:ShareMCQ('@item.PartitionKey');" title="Share MCQ Set" class=" mdc-fab__icon material-icons">									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" /></svg>								</span>
                                                    </button>
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="View" title="View Questions">
                                                        <span onclick="javascript:ViewDetails('@item.PartitionKey');" title="View Questions" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg></span>
                                                    </button>
                                                    @if (ViewBag.Profile != "Client")
                                                    {
                                                        <button class="mdc-fab app-fab--absolute priority" aria-label="Edit" title="Edit">
                                                            <span onclick="javascript:EditMcqSet('@item.PartitionKey');" title="Edit" class=" mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                        </button>
                                                    }
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="List" title="Candidate List">
                                                        <span onclick="javascript:CandidateTestDetails('@item.PartitionKey');" title="Candidate List" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg></span>
                                                    </button>
                                                    <button class="mdc-fab app-fab--absolute " aria-label="Generate URL">
                                                        <span onclick="javascript:GeneratePublicUrl('@item.PartitionKey');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg></span>
                                                    </button>
                                                    @if (ViewBag.Profile == "Admin")
                                                    {
                                                        <button class="mdc-fab app-fab--absolute trash-btn" title="Click here to delete MCQ">
                                                            <span title="Click here to delete MCQ" onclick="javascript:DeleteEntityMCQ('@item.PartitionKey');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- End Card-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="CreateMCQPopUp" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i class="fa fa-file" aria-hidden="true" style="font-size:21px"></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Phone Screen+ Set </h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeCreatePopUp()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" style="padding: 2px 16px;">
                <div class="row" style="padding:10px">
                    @*<div class="col-md-12"><a class="text-right" href="@Url.Action("Download","MCQ",new { filename="MCQSet.xlsx"})"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="rgb(103, 99, 99, 1)" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg> <span style=" font-size: 17px; margin-bottom: 10px; display: inline-block; color: #676363;">Download Template</span></a></div>*@
                    <div class="col-md-12"><a class="text-right mcq-dnbutton" href="@ViewBag.TemplateUrl" target="_blank"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255, 1)" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg> <span style=" font-size: 17px; margin-bottom: 10px; display: inline-block; color: #fff;">Download Template</span></a></div>
                    <input type="hidden" id="txtpartialid" />
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SecondarySkill">
                                Primary Skills
                            </label>
                            <div class="col-md-12 col-sm-12">
                                <select class="form-control" id="ddlPrimarySkills" style="width:100% !important">
                                    @foreach (var item in Model._ProfileTypeSkills.PrimarySkillsList)
                                    {
                                        <option value="@item.Text">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SecondarySkill">
                                Secondary Skills
                            </label>
                            <div class="col-md-12 col-sm-12">
                                <select class="form-control" id="ddlSecondarySkills" style="width:100% !important">
                                    @foreach (var item in Model._ProfileTypeSkills.PrimarySkillsList)
                                    {
                                        <option value="@item.Text">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SecondarySkill" style="margin-bottom:0px;">
                                Profile Type
                            </label>
                            <div class="col-md-12 col-sm-12">
                                <select class="form-control" id="ddlProfileType" style="margin-bottom: 10px;margin-top:10px">
                                    @foreach (var item in Model._ProfileTypeSkills.ProfileTypeList)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-12 col-sm-12 desp-label" for="SecondarySkill" style="margin-bottom:0px;">
                                Compentency Level
                            </label>
                            <div class="col-md-12 col-sm-12">
                                <select class="form-control" id="ddlCompentencyLevel" style="margin-bottom: 10px;margin-top:10px">
                                    @foreach (var item in Model._ProfileTypeSkills.CompentencyLevelList)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12"> <input type="text" class="form-control" placeholder="Phone Screen+ Set Title" id="txtMCQTitle" style="margin-top: 10px;margin-bottom: 10px;" /></div>
                    <div class="col-md-12">
                        <input type="number" class="form-control" placeholder="Test time(in Min.)" id="txtTime" style="margin-bottom: 10px;" />
                    </div>
                    <div class="col-md-12">   <input type="file" class="choose-file" accept=".xlsx,xls" id="Mcqfile" style="margin-bottom: 10px;" /></div>
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
                        <input style="color: #fff;line-height: 13px;margin-bottom:10px;" type="button" onclick="CreateMCQ()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Upload">
                        <input style="color: #fff;line-height: 13px; margin:0px 10px 10px 0px;" type="button" onclick="closeCreatePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="MyShareModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" fill="rgb(255, 255, 255)" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Share Test Link</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeSharePopUp()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    @*<div class="sharing">
                            <label class="label-field desp-label" for="Video Recording" style="font-weight:normal;"> Please Select Video Recording Option</label>
                            <select id="txtvideorecording" class="form-control " style="margin-bottom:10px;">
                                <option value="0">None</option>
                                <option value="1">Recording Only</option>
                                <option value="2">Recording and Uploading</option>
                            </select>
                        </div>*@
                    <div class="sharing">
                        <label class="label-field desp-label" for="Please enter Meeting Date Time" style="font-weight:normal;"> Meeting Date Time</label>
                        <input type="datetime-local" placeholder="Meeting Date Time" id="txtmeetingdatetime" class="form-control" style="margin-bottom:10px;" />
                    </div>
                    @if (ViewBag.Profile != "Client")
                    {
                        <div class="sharing">
                            <label class="label-field desp-label" for="Please enter Client Name" style="font-weight:normal;"> Please Enter Client's Name</label>
                            <input type="text" placeholder="Client Name" id="txtclientsharename" class="form-control " style="margin-bottom:10px;" />
                        </div>
                    }
                    else
                    {
                        <div class="sharing" style="display:none">
                            <label class="label-field desp-label" for="Please enter Client Name" style="font-weight:normal;"> Please Enter Client's Name</label>
