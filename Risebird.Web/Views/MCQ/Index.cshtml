@model Risebird.Entities.ViewModel.MCQDropdowndetails

@{
    ViewData["Title"] = "MCQ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    MCQ
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <!--  <div class="panel-header panel-header-sm"></div>-->



    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">  MCQ</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @*//add validation*@
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to Add MCQ Set" onclick="openCreatePopUp()" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Add MCQ</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <!-- Start Card -->
                        <div class="row">
                            @foreach (var item in Model._MCQVMset)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                    <div class="card-content-holder border card-blue">
                                        <div class="card-header">
                                            <div class="row">
                                                <div class=" col-md-12 col-sm-12 first">
                                                    <h6 style=" padding-top: 10px;">@item.Title</h6>
                                                    <input type="hidden" value="@item.Title" id="txttitlevalue_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.Timer" id="txttimevalue_@item.PartitionKey" />
                                                    <input type="hidden" value="@item.ProfileType" id="txtProfilevalue_@item.PartitionKey" />
                                                </div>
                                            </div>
                                        </div>
                                        <!-- irf body-->
                                        <div class="card-body">
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 10px; width: 100%; float: left">
                                                <div class="client-field">Questions:</div> <div class="clientName"> @item.QuestionCount</div>
                                            </div>
                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 10px; width: 100%; float: left">
                                                <div class="client-field">Time:</div> <div class="client-name">@item.Timer</div>
                                            </div>
                                            <div class="col-md-12 col-sm-12">
                                                <div class="client-field">Profile Type:</div> <div class="clientName"> @item.ProfileTypeName</div>
                                            </div>
                                        </div>
                                        <div class="card-footer action">
                                            <div class="col-md-12">

                                                <div class="text-right card-header-buttons action">
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="Share MCQ Set" style="background: #59b259 !important">
                                                        <span onclick="javascript:ShareMCQ('@item.PartitionKey');" title="Share MCQ Set" class=" mdc-fab__icon material-icons">									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" /></svg>								</span>
                                                    </button>
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="View">
                                                        <span onclick="javascript:ViewDetails('@item.PartitionKey');" title="View" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg></span>
                                                    </button>
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="Edit">
                                                        <span onclick="javascript:EditMcqSet('@item.PartitionKey');" title="Edit" class=" mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                    </button>
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="List">
                                                        <span onclick="javascript:CandidateTestDetails('@item.PartitionKey');" title="Candidate List" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg></span>
                                                    </button>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- End Card-->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="CreateMCQPopUp" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">
                        <i class="fa fa-file" aria-hidden="true" style="font-size:21px"></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left">MCQ Set </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeCreatePopUp()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" style="padding: 2px 16px;">
                <div class="row" style="padding:10px">
                    <div class="col-md-12"><a class="text-right" href="@Url.Action("Download","MCQ",new { filename="MCQSet.xlsx"})"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="rgb(103, 99, 99, 1)" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg> <span style=" font-size: 17px; margin-bottom: 10px; display: inline-block; color: #676363;">Download Template</span></a></div>
                    <input type="hidden" id="txtpartialid" />

                    <select class="form-control" id="ddlPrimarySkills" style="margin-bottom: 10px;" multiple>
                        @foreach (var item in Model._ProfileTypeSkills.PrimarySkillsList)
                        {
                            <option>@item.Text</option>
                        }
                    </select>
                    <select class="form-control" id="ddlProfileType" style="margin-bottom: 10px;">
                        @foreach (var item in Model._ProfileTypeSkills.ProfileTypeList)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <input type="text" class="form-control" placeholder="MCQ Set Title" id="txtMCQTitle" style="margin-bottom: 10px;" />
                    <input type="number" class="form-control" placeholder="Test time(in Min.)" id="txtTime" style="margin-bottom: 10px;" />
                    <input type="file" class="form-control" accept=".xlsx,xls" id="Mcqfile" style="margin-bottom: 10px;" />
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
                        <input style="color: #fff;line-height: 13px;" type="button" onclick="CreateMCQ()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Upload">
                        <input style="color: #fff;line-height: 13px;" type="button" onclick="closeCreatePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="MyShareModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" fill="rgb(255, 255, 255)" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Share Test Link</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeSharePopUp()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="sharing">
                        <label class="label-field desp-label" for="Please enter Client Name" style="font-weight:normal;"> Please Enter Client's Name</label>
                        <input type="text" placeholder="Client Name" id="txtclientsharename" class="form-control " style="margin-bottom:10px;" />
                    </div>
                    <label class="label-field desp-label" for="Please enter EmailIds" style="font-weight:normal;"> Please Enter Email Id's</label>
                    <input type="hidden" id="txtsharePartialid" />
                    <div class="sharing">
                        <textarea spellcheck="true" class="form-control " rows="2" id="txtsharetext" placeholder="Please enter EmailIds ';' seprated" style="width:100%;overflow:hidden;margin-bottom:10px;"></textarea>
                        <div id="words"></div>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input type="button" onclick="shareTestLink()" id="btnintrested" class="mdc-button mdc-button--raised mdc-ripple-upgraded" value="Share">
                        <input style="color:#fff;line-height: 13px;" type="button" onclick="closeSharePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

