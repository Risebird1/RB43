<script>
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

        //$("#PrimarySkill").multiselect({
        //    includeSelectAllOption: true,
        //    selectedClass: 'active1',
        //    buttonWidth: '100%',
        //    maxHeight: 200
        //});
        //$("#SelectionStatus").multiselect({
        //    includeSelectAllOption: true,
        //    selectedClass: 'active1',
        //    buttonWidth: '100%',
        //    maxHeight: 200
        //});
        //$("#SecondarySkill").multiselect({
        //    includeSelectAllOption: true,
        //    selectedClass: 'active1',
        //    buttonWidth: '100%',
        //    maxHeight: 200
        //});
        //$("#CompentencyLevel").multiselect({
        //    includeSelectAllOption: true,
        //    selectedClass: 'active1',
        //    buttonWidth: '100%',
        //    maxHeight: 200
        //});
    });
    function closeCreatePopUp() {
        var modal = document.getElementById("CreateMCQPopUp");
        modal.style.display = "none";
        $("#txtpartialid").val('');
        $("#txtMCQTitle").val('');
        $("#txtTime").val('');
        document.getElementById("ddlProfileType").value = 0;
        document.getElementById("ddlCompentencyLevel").value = 0;
        document.getElementById("ddlPrimarySkills").value = 0;
        $("#ddlSecondarySkills").val('');
        $("#ddlSecondarySkills").select2().trigger('change');
    }
    function openCreatePopUp() {
        var modal = document.getElementById("CreateMCQPopUp");
        modal.style.display = "block";
    }
    function CreateMCQ() {
        if ($("#txtMCQTitle").val().trim() != "" && $("#txtTime").val().trim() != "" && document.getElementById("Mcqfile").files.length > 0 && $("#ddlPrimarySkills").val() != null) {
            $(".loader").show();
            var file_data = $("#Mcqfile").prop("files")[0];
            var form_data = new FormData();
            form_data.append("file", file_data);
            form_data.append("title", $("#txtMCQTitle").val());
            form_data.append("time", $("#txtTime").val());
            form_data.append("PartialId", $("#txtpartialid").val());
            form_data.append("ProfileType", $("#ddlProfileType").val());
            form_data.append("PrimarySkill", $("#ddlPrimarySkills").val());
            form_data.append("SecondarySkill", $("#ddlSecondarySkills").val());
            form_data.append("CompentencyLevel", $("#ddlCompentencyLevel").val());
            if ($("#txtpartialid").val().trim() != "") {
                form_data.append("status", "Edit");
            } else {
                form_data.append("status", "Create");
            }
            $.ajax({
                type: "POST",
                url: "/MCQ/UploadQuestions",
                data: form_data,
                contentType: false,
                enctype: 'multipart/form-data',
                processData: false,
                success: function (data) {
                    $(".loader").hide();
                    alert(data);
                    closeCreatePopUp();
                    window.location.href = 'Index';
                }
            });
        } else {
            alert("Please fill all the fields.");
        }
    }
    function CandidateTestDetails(id) {
        var url = '/MCQ/CandidateTestDetails?id=' + id;
        window.location.href = url;
    }
    function EditMcqSet(id) {
        openCreatePopUp();
        $("#txtpartialid").val(id);
        $("#txtMCQTitle").val($("#txttitlevalue_" + id).val());
        $("#txtTime").val($("#txttimevalue_" + id).val());
        document.getElementById("ddlProfileType").value = $("#txtProfilevalue_" + id).val();
        document.getElementById("ddlPrimarySkills").value = $("#txtPrimarySkill_" + id).val();
        document.getElementById("ddlCompentencyLevel").value = $("#txtCompentencyLevel_" + id).val();
        var values = ($("#txtSecondarySkill_" + id).val()).split(",");
        $("#ddlSecondarySkills").val(values);
        $("#ddlSecondarySkills").select2().trigger('change');

    }

    function closeSharePopUp() {
        var modal = document.getElementById("MyShareModel");
        modal.style.display = "none";
        $("#txtsharePartialid").val('');
    }
    function ShareMCQ(id) {
        var modal = document.getElementById("MyShareModel");
        modal.style.display = "block";
        $("#txtsharePartialid").val(id);
        mindatefield();
    }
    function mindatefield() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1;
        var yyyy = today.getFullYear();
        if (dd < 10) {
            dd = '0' + dd
        }
        if (mm < 10) {
            mm = '0' + mm
        }
        today = yyyy + '-' + mm + '-' + dd;
        document.getElementById("txtmeetingdatetime").setAttribute("min", today);
    }
    function shareTestLink() {
        if ($("#txtsharetext").val().trim() != "" && $("#txtclientshareEmail").val().trim() != "") {
            var date1 = new Date($("#txtmeetingdatetime").val());
            var date2 = new Date();
            if (date1 > date2) {
            $.ajax({
                type: "POST",
                url: "/MCQ/ShareTestLink",
                data: { Emailids: $("#txtsharetext").val(), Id: $("#txtsharePartialid").val(), ClientName: $("#txtclientsharename").val(), ClientEmail: $("#txtclientshareEmail").val(), MeetingDate: $("#txtmeetingdatetime").val() },
                success: function (data) {
                    if (data == "success") {
                        alert("Successfully share the Phone Screen+ set.");
                        closeSharePopUp();

                    } else {
                        alert("Error to share the test");
                    }
                }
            });
            }
            else {
                alert("Please enter future meeting date.");
            }
        } else {
            alert("Please enter the emailids.");
        }
    }
    function ViewDetails(id) {
        window.location.href = "Questionpage?Id=" + id;
    }
    function ResetFilter() {
           window.location.href = "/MCQ/ResetMCQFilter";
    }
    function ApplySessionFilter() {
            var skillsset = @Html.Raw(Json.Serialize(PrimarySkill));
            var levelset =  @Html.Raw(Json.Serialize(SelectionStatus));
            var Secondaryskills =  @Html.Raw(Json.Serialize(SecondarySkill));
            var CompentencyLevels=  @Html.Raw(Json.Serialize(CompentencyLevel));

            $("#SelectionStatus").val(levelset);
            $("#PrimarySkill").val(skillsset);
            $("#SecondarySkill").val(Secondaryskills);
            $("#CompentencyLevel").val(CompentencyLevels);
    }
    function GeneratePublicUrl(index) {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "block";
        var urlcurrent = window.location.href;
        urlcurrent = urlcurrent.replace("Index", "SkillTest");
        urlcurrent = urlcurrent + "?Id=" + index;
        $("#txtvideoUrls").text(urlcurrent);
    }
    function closePublicUrlShareModel() {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
    function DeleteEntityMCQ(Id) {
        swal.fire({
            title: 'Are you sure you want to delete Phone Screen+?',
            text: "It will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/MCQ/DeleteMCQ',
                        data: { 'Id': Id },
                        type: 'Delete',
                        method: 'POST',
                        success: function (result) {
                            if (result == "Successfully deleted") {
                                resolve(result);
                            }
                            else {
                                swal.fire("Error deleting!", "Please try again", "error");
                            }
                        },
                        error: function () {
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The Phone Screen+ has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/MCQ/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>


