@model IEnumerable<Risebird.Entities.ViewModel.MCQVMset>

@{
    ViewData["Title"] = "MCQ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">
                    MCQ
                </a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <!--  <div class="panel-header panel-header-sm"></div>-->



    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">  MCQ</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @*//add validation*@
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to Add MCQ Set" onclick="openCreatePopUp()" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Add MCQ</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>






    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">
                    <div class="mdc-card-wrapper__text-section">


                        <!-- Start Card -->
                        <div class="row">
                            @foreach (var item in Model)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                    <div class="card-content-holder border card-blue">
                                        <div class="card-header">
                                            <div class="row">
                                                <div class=" col-md-5 col-sm-5 first">
                                                    <h6 style=" padding-top: 10px;"> <a style="        color: #0c2642
" href="@Url.Action("Questionpage","MCQ",new { Id=item.PartitionKey})">@item.Title</a></h6>
                                                </div>

                                                <div class="col-md-7 col-sm-7 card-header-buttons action">
                                                    <button class="mdc-fab app-fab--absolute priority" aria-label="Edit">
                                                        <span onclick="" title="" class=" mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>

                                                        </button>



                                                        <button class="mdc-fab app-fab--absolute priority" aria-label="List">
                                                            <span onclick="javascript:CandidateTestDetails('@item.PartitionKey');" title="" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" /></svg></span>
                                                        </button>

                                                </div>
                                            </div>
                                        </div>

                                        <!-- irf body-->
                                        <div class="card-body">

                                            <div class="col-md-12 col-sm-12" style=" margin-bottom: 10px; width: 100%; float: left">
                                                <div class="client-field">Questions:</div> <div class="clientName"> @item.QuestionCount</div>
                                               
                                            </div>
                                            <div class="col-md-12 col-sm-12">

                                                <div class="client-field">Time:</div>
                                                <div class="client-name">
                                                    @item.Timer
                                                </div>
                                            </div>


                                        </div>

                                       

                                    </div>
                                </div>

                            }
                        </div>
                        <!-- End Card-->


                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div id="CreateMCQPopUp" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">



            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon">


                        <i class="fa fa-file" aria-hidden="true" style="font-size:21px"></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left">MCQ Set </h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeCreatePopUp()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>


            <div class="modal-body" style="padding: 2px 16px;">
                <div class="row" style="padding:10px">
                    <div class="col-md-12"><a class="text-right" href="@Url.Action("Download","MCQ",new { filename="MCQSet.xlsx"})"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><path fill="rgb(103, 99, 99, 1)" d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg> <span style=" font-size: 17px; margin-bottom: 10px; display: inline-block; color: #676363;">Download Template</span></a></div>
       
                
                            <input type="text" class="form-control" placeholder="MCQ Set Title" id="txtMCQTitle"  style="margin-bottom: 10px;"/>
                            <input type="number" class="form-control" placeholder="Test time(in Sec.)" id="txtTime" style="margin-bottom: 10px;" />
                            <input type="file" class="form-control" accept=".xlsx,xls" id="Mcqfile" style="margin-bottom: 10px;" />
                 
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
    
                        <input style="color: #fff;line-height: 13px;" type="button" onclick="closeCreatePopUp()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

