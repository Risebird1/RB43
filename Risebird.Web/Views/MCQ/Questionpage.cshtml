@model IEnumerable<Risebird.Entities.ViewModel.MCQVM>

@{
    ViewData["Title"] = "Recruiter Interview Questions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div>Recruiter Interview Questions</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=8" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    @*<nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
    <div class="container-fluid">
    <div class="navbar-wrapper">
    <div class="navbar-toggle">
    <button type="button" class="navbar-toggler">
    <span class="navbar-toggler-bar bar1"></span>
    <span class="navbar-toggler-bar bar2"></span>
    <span class="navbar-toggler-bar bar3"></span>
    </button>
    </div>
    <a class="navbar-brand">
    MCQ Questions
    </a>
    </div>
    </div>
    </nav>*@
    <!-- End Navbar -->
    <!--  <div class="panel-header panel-header-sm"></div>-->



    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Recruiter Interview Questions</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @if (ViewBag.Type == "16183")
                        {
                            <a href="/MCQ/RecruiterInterview" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">Back</a>
                        }
                        else
                        {
                            <a href="/MCQ/Index" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">Back</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-8 offset-md-2">
                <div class="mdc-card card  bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        @foreach (var item in Model)
                        {
                            <div>

                                <div class="x-text">

                                    <!--button: Start-->

                                </div>
                                <div class="man">@item.QuestionNumber ) @item.Question </div>
                                <div>
                                    @if (item.QuestionType == "Multiple")
                                    {
                                        <p class="calloption"><input type="checkbox" /> @item.Option1</p>
                                        <p class="calloption"><input type="checkbox" /> @item.Option2</p>
                                        <p class="calloption"><input type="checkbox" /> @item.Option3</p>
                                        <p class="calloption"><input type="checkbox" /> @item.Option4</p>
                                        <hr />
                                    }

                                    else
                                    {
                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option1</p>
                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option2</p>
                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option3</p>
                                        <p class="calloption"><input type="radio" name="option_@item.QuestionNumber" /> @item.Option4</p>
                                    }
                                    <p class="calloption">Answer: <c style="color:green">@item.Answer</c></p>
                                    <p class="calloption">Explanation: @item.Explanation</p>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



