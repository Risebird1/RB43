@model Risebird.Entities.ViewModel.CandidateDetailsForTest
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Newassets/css/bootstrap.min.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=10" />
    @*<link rel="stylesheet" type="text/css" id="theme" href="~/Newassets/css/blue-theme.css" />*@
    <title>Skill Test</title>
</head>
<body>

    @*<video controls hidden></video>
        <video id="vid2" hidden controls></video>*@
    @*<div class="text-center" style="background-color: #363c43;padding: 15px 5px 5px 10px;width: 100%;display: inline-block;position: relative;">
            <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" style="width:180px;" /></div>
        </div>*@
    <div class="text-center" style="background: linear-gradient(to right, #0c2646 0%, #204065 60%, #2a5788 100%);padding: 15px 5px 5px 10px;width: 100%;display: inline-block;position: relative;">
        <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" style="width:180px;" /></div>
    </div>
    <div class="container">
        @using (Html.BeginForm("CandidateQuestionpage", "MCQ", FormMethod.Post))
        {
            <div class="row">
                <div class="col-md-8 offset-md-2">
                    <div class="callno" style="margin-bottom:10px;">
                        <h2>Fill up the details</h2>
                    </div>
                    <div class="col-md-6 col-sm-12" style="float:left">
                        <div>
                            @Html.LabelFor(model => model.CandidateEmail, htmlAttributes: new { @class = "call-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                            @Html.TextBoxFor(m => m.CandidateEmail, new { @class = "calloption text-box single-line", @required = "required" })
                            @Html.ValidationMessageFor(m => m.CandidateEmail, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12" style="float:left">
                        <div>
                            @Html.LabelFor(model => model.Skills, htmlAttributes: new { @class = "call-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                            @Html.TextBoxFor(m => m.Skills, new { @class = "calloption text-box single-line", @required = "required" })
                            @Html.ValidationMessageFor(m => m.Skills, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-12" style="float:left">
                        <div class="form-group">
                            @Html.LabelFor(model => model.TotalExprience, htmlAttributes: new { @class = "call-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                            @Html.TextBoxFor(m => m.TotalExprience, new { @class = "calloption text-box single-line", @type = "number", @required = "required" })
                            @Html.ValidationMessageFor(m => m.TotalExprience, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @Html.HiddenFor(m => m.Name)
                    @Html.HiddenFor(m => m.Address)
                    @Html.HiddenFor(m => m.Gender)
                    @Html.HiddenFor(m => m.DOB)
                    @Html.HiddenFor(m => m.CandidateImage)
                    <input type="hidden" id="MCQId" name="MCQId" value="@ViewBag.Questionsetid" />
                    @if (Model.AadhaarVerification)
                    {
                        <button type="button" class="clickhere_btn callsubmit" style="float:left;width:150px">
                            <span data-toggle="tooltip" data-placement="top" title="" onclick="openAadhaarpopup()" data-original-title="Validate Aadhar Details"><font style="font-family: Roboto, sans-serif; font-size:12px;">Verify Candidate</font></span>
                        </button>
                    }
                    <div>
                        @if (Model.AadhaarVerification)
                        {
                            <input type="submit" disabled id="btnSubmitDetails" style="width:120px !important" value="Start Test >>" class="callsubmit" />
                        }
                        else
                        {
                            <input type="submit" id="btnSubmitDetails" style="width:120px !important" value="Start Test >>" class="callsubmit" />
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
<div id="Aadhaarpopup" class="modal modal-bg" style="z-index:3">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="mdc-fab__icon material-icons">
                        <img src="~/img/Aadhaar/aadhaar-logo-png.jpg" style="width:45px" />
                    </span>
                </div>
                <h5 class="modal-title pull-left">Aadhaar Verification</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeAadhaarpopup()" aria-hidden="true" id="CommentPopUp" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body">
                <div class="loader text-center">
                    <img src="~/Newassets/img/lazyload.gif" />
                </div>
                <div class="row" style="padding:10px" id="divcandidateskills">
                    <div class="col-md-12 col-lg-12">
                        <input type="hidden" id="aadhaaruuid" />
                        <input type="password" placeholder="Aadhaar Number" id="aadhaarnumber" class="form-control" />
                    </div>
                    <div class="col-md-5 col-lg-5 col-sm-11" style="padding-top:10px">
                        <img alt="Captcha" id="aadharimagecaptcha" class="form-control" />
                    </div>
                    <div class="col-md-1 col-lg-1 col-sm-1" style="padding-top:10px">
                        <span onclick="NewgenerateCaptcha()" style="font-size:24px;cursor:pointer" title="Reload Captcha">&#x21bb;</span>
                    </div>
                    <div class="col-md-6 col-lg-6 col-sm-12" style="padding-top:10px">
                        <input type="text" placeholder="Captcha" id="aadhaarcaptcha" class="form-control" />
                    </div>
                    <div class="col-md-6 col-lg-6 col-sm-12" style="padding: 10px;display:none" id="divotpvalidation">
                        <input type="number" placeholder="Enter OTP" id="txtAadhaarOtp" class="form-control" />
                    </div>
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div id="divValidate" style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="validateAadhaarnumber()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Validate"></div>
                            <div id="divSubmit" style="display: none;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="submitOtpnumber()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Submit"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="model-footer">
                <div class="col-md-12 col-lg-12 col-sm-12" style="padding: 10px;font-size:12px;padding-left:20px">
                    Verification from this link or user interface means your consent to Risebird Clients and it's customers to use output of Aadhaar verification to confirm your identity.
                </div>
            </div>
        </div>
    </div>
</div>
<div id="AadhaarKYCpopup" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document" style="max-width:850px !important">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="mdc-fab__icon material-icons">
                        <img src="~/img/Aadhaar/aadhaar-logo-png.jpg" style="width:45px" />
                    </span>
                </div>
                <h5 class="modal-title pull-left">Aadhaar Verified Data</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeAadhaarKYCpopup()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body">
                <div style="padding:10px" id="divAadhaarKYC">

                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            @*<div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeAadhaarKYCpopup()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Newassets/js/core/jquery.min.js?v=7"></script>
<script src="~/js/Aadhaar.js"></script>
<script>
    function BindData(data) {
        $("#Name").val(data.name);
        $("#Address").val(data.address);
        $("#Gender").val(data.gender);
        $("#DOB").val(data.dob);
        $("#CandidateImage").val(data.doc_face);
    }
</script>

