@model Risebird.Entities.ViewModel.QuestionDetailsList
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Newassets/css/bootstrap.min.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/interview.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />
    <title>MCQ Questions</title>
    <style>
    </style>
</head>
<body>
    <div class="text-center" style="        background-color: #363c43;
        padding: 15px 5px 5px 10px;
        width: 100%;
        display: inline-block;
        position: relative;">
        <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.ico" style="width:180px;" /></div>
        <div style="float:right">
            <div id="countdown">
                <div id='tiles'></div>
                <div class="labels">

                    @*<input id="ztimmerdetails_Timer" name="_timmerdetails.Timer" value="@Model._timmerdetails.Timer" type="hidden" />*@
                    <li>Hours</li>
                    <li>Mins</li>
                    <li>Secs</li>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="callno ">
                    <div class="sb-container ">
                        <input type="hidden" id="textcallno" value="@Model._questionlist.Count()" />
                        @foreach (var item in Model._questionlist)
                        {
                            @if (item.QuestionAnswered == true)
                            {
                                <div class="callbox" style="background-color: #ff5800; color: #fff;" onclick="QuestionSelect(@item.QuestionNumber)">@item.QuestionNumber</div> @*Answered*@
                            }
                            else
                            {
                                <div class="callbox" style="background-color:white" onclick="QuestionSelect(@item.QuestionNumber)">@item.QuestionNumber</div> @*Unanswered*@
                            }
                        }
                    </div>
                </div>
                <div class="mobpad" style="float:left;width:100%">

                    @using (Html.BeginForm("CandidateQuestions", "MCQ", FormMethod.Post, new { currentpage = Model._question.QuestionNumber }))
                    {<div class="callouts">
                            <div>
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input id="zquestion_QuestionType" name="_question.QuestionType" value="@Model._question.QuestionType" type="hidden" />
                                <div>

                                    <!--button: END-->



                                    <div>   <span style="color: #ff5800; font-weight: 600; font-size: 2.3rem; margin: 0 5px 0px 0px;"> @Model._question.QuestionNumber.</span>  <span class="man"> @Model._question.Question</span></div>



                                    <input id="zquestion_QuestionNumber" name="_question.QuestionNumber" value="@Model._question.QuestionNumber" type="hidden" />
                                    <div>
                                        @if (Model._question.QuestionType == "Multiple")
                                        {
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption1, "1") @Model._question.Option1</p>
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption2, "2") @Model._question.Option2</p>
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption3, "3") @Model._question.Option3</p>
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption4, "4") @Model._question.Option4</p>
                                        }
                                        else
                                        {
                                            <p class="calloption">@Html.RadioButtonFor(Model => Model._question.SingleAnswer, "1") @Model._question.Option1</p>
                                            <p class="calloption">@Html.RadioButtonFor(Model => Model._question.SingleAnswer, "2") @Model._question.Option2</p>
                                            <p class="calloption">@Html.RadioButtonFor(Model => Model._question.SingleAnswer, "3") @Model._question.Option3</p>
                                            <p class="calloption">@Html.RadioButtonFor(Model => Model._question.SingleAnswer, "4") @Model._question.Option4</p>
                                        }
                                    </div>
                                </div>
                                <input id="zquestion_final" name="_question.final" value="@Model._question.final" type="hidden" />
                                <input id="ztimmerdetails_Timer" name="_timmerdetails.Timer" value="@Model._timmerdetails.Timer" type="hidden" />
                            </div>

                        </div>
                        <div>
                            @if (Model._question.final == "true")
                            {
                                <input type="submit" value="Submit" class="callsubmit" id="btnsubmit" />
                            }
                            else
                            {
                                <input type="submit" value="NEXT" class="callsubmit" id="btnsubmit" />
                            }
                        </div>
                    }

                </div>




                <div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="~/Newassets/js/core/jquery.min.js?v=7"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script>
    var target_date = new Date().getTime() + (1000 * parseInt($("#ztimmerdetails_Timer").val()));
    var days, hours, minutes, seconds;

    var countdown = document.getElementById("tiles");
    getCountdown();
    var myVar = setInterval(function () { getCountdown(); }, 1000);
    function getCountdown() {
        var current_date = new Date().getTime();
        var seconds_left = (target_date - current_date) / 1000;
        days = pad(parseInt(seconds_left / 86400));
        seconds_left = seconds_left % 86400;

        hours = pad(parseInt(seconds_left / 3600));
        seconds_left = seconds_left % 3600;

        minutes = pad(parseInt(seconds_left / 60));
        seconds = pad(parseInt(seconds_left % 60));

        countdown.innerHTML = "<span>" + hours + "</span><span>" + minutes + "</span><span>" + seconds + "</span>";

        var timmertime = parseInt(hours) * 3600 + parseInt(minutes) * 60 + parseInt(seconds);
        if (parseInt(timmertime) == 0) {
            //submit finally
            $("#zquestion_final").val("true");
            clearInterval(myVar);
            $("#btnsubmit").click();
        }
        $("#ztimmerdetails_Timer").val(timmertime);
    }

    function pad(n) {
        return (n < 10 ? '0' : '') + n;
    }

</script>
<script src="~/Newassets/js/scrollBar.js"></script>



<script type="text/javascript">
    function QuestionSelect(questionnumber) {
        var timew = $("#ztimmerdetails_Timer").val();
        window.location.href = "/MCQ/CandidateSelectQuestions/" + questionnumber + "?presence=" + timew;
    }


    if (parseInt($("#textcallno").val()) > 20)
        $(".sb-container").scrollBox();
</script>