@model Risebird.Entities.ViewModel.QuestionDetailsList
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Newassets/css/bootstrap.min.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/interview.css" rel="stylesheet" />
   
    <title>MCQ Questions</title>
    <style>
    </style>
</head>
<body>
    <div class="text-center" style="        background-color: #363c43;
        padding: 15px 5px 5px 10px;
        width: 100%;
        display: inline-block;
        position: relative;">
        <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.ico" style="width:180px;" /></div>
        <div style="float:right">
            <div id="countdown">
                <div id='tiles'></div>
                <div class="labels">

                    <li>Hours</li>
                    <li>Mins</li>
                    <li>Secs</li>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="callno">
                    @foreach (var item in Model._questionlist)
                    {
                        @if (item.QuestionAnswered == true)
                        {
                            <div class="callbox" style=" background-color: #ff5800; color: #fff;">@item.QuestionNumber</div> @*Answered*@
                        }
                        else
                        {
                            <div class="callbox" style="background-color:white">@item.QuestionNumber</div> @*Unanswered*@
                        }
                    }
                </div>
                <div class="mobpad" style="float:left;width:100%">

                    @using (Html.BeginForm("CandidateQuestions", "MCQ", FormMethod.Post, new { currentpage = Model._question.QuestionNumber }))
                    {<div class="callouts">
                            <div>
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <input id="zquestion_QuestionType" name="_question.QuestionType" value="@Model._question.QuestionType" type="hidden" />
                                <div>
                                    <div class="x-text">
                                        <div style="float:left;width:100%">
                                            <h4 style="float:left">01</h4>

                                            <!--button: Start-->

                                        </div>
                                    </div>
                                    <!--button: END-->


                                    <div class="man">@Model._question.QuestionNumber ) @Model._question.Question</div>




                                    <input id="zquestion_QuestionNumber" name="_question.QuestionNumber" value="@Model._question.QuestionNumber" type="hidden" />
                                    <div>
                                        @if (Model._question.QuestionType == "Multiple")
                                        {
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption1, "1") @Model._question.Option1</p>
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption2, "2") @Model._question.Option2</p>
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption3, "3") @Model._question.Option3</p>
                                            <p class="calloption">@Html.CheckBoxFor(m => m._question.MultiAnswerOption4, "4") @Model._question.Option4</p>
                                        }
                                        else
                                        {
                                            <div class="mdc-touch-target-wrapper" style="top: 4px;position: relative;">
                                                <div class="mdc-radio mdc-radio--touch">
                                                    <p class="calloption">@Html.RadioButtonFor(m => m._question.SingleAnswer, "1", new { @class = "mdc-radio__native-control" }) @Model._question.Option1</p>
                                                    <div class="mdc-radio__background">
                                                        <div class="mdc-radio__outer-circle"></div>
                                                        <div class="mdc-radio__inner-circle"></div>
                                                    </div>
                                                    <div class="mdc-radio__ripple"></div>
                                                </div>
                                            </div>
                                            <p class="calloption">@Html.RadioButtonFor(m => m._question.SingleAnswer, "2") @Model._question.Option2</p>
                                            <p class="calloption">@Html.RadioButtonFor(m => m._question.SingleAnswer, "3") @Model._question.Option3</p>
                                            <p class="calloption">@Html.RadioButtonFor(m => m._question.SingleAnswer, "4") @Model._question.Option4</p>
                                        }
                                    </div>
                                </div>
                                <input id="zquestion_final" name="_question.final" value="@Model._question.final" type="hidden" />
                            </div>

                        </div>
                        <div>
                            @if (Model._question.final == "true")
                            {
                                <input type="submit" value="Submit" class="callsubmit" />
                            }
                            else
                            {
                                <input type="submit" value="NEXT" class="callsubmit" />
                            }
                        </div>
                    }

                </div>




                <div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="~/Newassets/js/core/jquery.min.js?v=7"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
<script>
    var target_date = new Date().getTime() + (1000 * 3600 * 48); // set the countdown date
    var days, hours, minutes, seconds; // variables for time units

    var countdown = document.getElementById("tiles"); // get tag element

    getCountdown();

    setInterval(function () { getCountdown(); }, 1000);

    function getCountdown() {

        // find the amount of "seconds" between now and target
        var current_date = new Date().getTime();
        var seconds_left = (target_date - current_date) / 1000;

        days = pad(parseInt(seconds_left / 86400));
        seconds_left = seconds_left % 86400;

        hours = pad(parseInt(seconds_left / 3600));
        seconds_left = seconds_left % 3600;

        minutes = pad(parseInt(seconds_left / 60));
        seconds = pad(parseInt(seconds_left % 60));

        // format countdown string + set tag value
        countdown.innerHTML = "<span>" + hours + "</span><span>" + minutes + "</span><span>" + seconds + "</span>";
    }

    function pad(n) {
        return (n < 10 ? '0' : '') + n;
    }

</script>
