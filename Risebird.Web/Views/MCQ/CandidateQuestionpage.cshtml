<script>
    var target_date = new Date().getTime() + (1000 * parseInt($("#ztimmerdetails_Timer").val()));
    var days, hours, minutes, seconds;

    var countdown = document.getElementById("tiles");
    getCountdown();
    var myVar = setInterval(function () { getCountdown(); }, 1000);
    var timehave = 0;
    function getCountdown() {
        var current_date = new Date().getTime();
        var seconds_left = (target_date - current_date) / 1000;
        days = pad(parseInt(seconds_left / 86400));
        seconds_left = seconds_left % 86400;

        hours = pad(parseInt(seconds_left / 3600));
        seconds_left = seconds_left % 3600;

        minutes = pad(parseInt(seconds_left / 60));
        seconds = pad(parseInt(seconds_left % 60));

        countdown.innerHTML = "<span>" + hours + "</span><span>" + minutes + "</span><span>" + seconds + "</span>";

        var timmertime = parseInt(hours) * 3600 + parseInt(minutes) * 60 + parseInt(seconds);
        timehave = parseInt(timehave) + 1;
        if (parseInt(timmertime) == 0) {
            //submit finally
            $("#zquestion_final").val("true");
            clearInterval(myVar);
            $("#btnsubmit").click();
        }
        if (parseInt(timehave) == 60) {
            document.getElementById('btnStop').click();
        }
        $("#ztimmerdetails_Timer").val(timmertime);
    }
    function pad(n) {
        return (n < 10 ? '0' : '') + n;
    }

</script>
<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    function QuestionSelect(questionnumber) {
        $.ajax({
            type: "POST",
            url: "/MCQ/CandidateSelectQuestionsD",
            data: { id: questionnumber },
            success: function (data) {
                if (data == "TestSubmit") {
                    window.location.href = "/MCQ/TestComplete?status=" + data;
                } else {
                    binddata(data);
                }
            }
        });
    }
    if (parseInt($("#textcallno").val()) > 20)
        $(".sb-container").scrollBox();
</script>
<script>
    $(document).ready(function () {
        document.addEventListener('click', () => {
            document.documentElement.requestFullscreen();
        });

        InitialLoad();
    });
    var file;
    function InitialLoad() {
        $.ajax({
            type: "POST",
            url: "/MCQ/CandidateSelectQuestionsD",
            data: { id: "1" },
            success: function (data) {
                if (data == "TestSubmit") {
                    window.location.href = "/MCQ/TestComplete?status=" + data;
                } else {
                    binddata(data);
                }
            }
        });
    }
    function SubmitTest() {
        var form_data = new FormData();
        form_data.append("rating", $("#txtfeedbackreting").val());
        form_data.append("comments", $("#txtfeedbackComment").val());
        form_data.append("file", file);
        $(".loader").show();
        $.ajax({
            type: "POST",
            url: "/MCQ/SubmitTest",
            data: form_data,
            contentType: false,
            enctype: 'multipart/form-data',
            processData: false,
            success: function (data) {
                $(".loader").hide();
                if (data == "TestSubmit") {
                    window.location.href = "/MCQ/TestComplete?status=" + data;
                } else {
                    binddata(data);
                }
            }
        });
    }
    function FetchQuestion() {
        var Singleanswer = "";
        var option1 = false;
        var option2 = false;
        var option3 = false;
        var option4 = false;
        if ($("#zquestion_QuestionType").val() == "Single") {
            if (document.getElementById("SingleAnswer1").checked) {
                Singleanswer = "1";
            } else if (document.getElementById("SingleAnswer2").checked) {
                Singleanswer = "2";
            } else if (document.getElementById("SingleAnswer3").checked) {
                Singleanswer = "3";
            } else if (document.getElementById("SingleAnswer4").checked) {
                Singleanswer = "4";
            }
        } else {
            if ($("#MultiAnswerOption1").is(':checked')) {
                option1 = true;
            }
            if ($("#MultiAnswerOption2").is(':checked')) {
                option2 = true;
            }
            if ($("#MultiAnswerOption3").is(':checked')) {
                option3 = true;
            }
            if ($("#MultiAnswerOption4").is(':checked')) {
                option4 = true;
            }
        }
        if ($("#zquestion_final").val() == "true") {
            document.getElementById('btnStop').click();
            //if ($("#txtrecordingvideo").val() == "1" || $("#txtrecordingvideo").val() == "0" || $("#txtrecordingvideo").val() == "") {
            callquestions(option1, option2, option3, option4, Singleanswer);
            // }
        } else {
            callquestions(option1, option2, option3, option4, Singleanswer);
        }
    }
    function callquestions(option1, option2, option3, option4, Singleanswer) {
        var form_data = new FormData();
        form_data.append("Option1", option1);
        form_data.append("Option2", option2);
        form_data.append("Option3", option3);
        form_data.append("Option4", option4);
        form_data.append("SingleAnswer", Singleanswer);
        form_data.append("QuestionNumber", $("#zquestion_QuestionNumber").val());
        form_data.append("final", $("#zquestion_final").val());
        form_data.append("QuestionType", $("#zquestion_QuestionType").val());
        if ($("#zquestion_final").val() == "true") {
            form_data.append("file", file);
        }
        $(".loader").show();
        $.ajax({
            type: "POST",
            url: "/MCQ/CandidateQuestionsD",
            data: form_data,
            contentType: false,
            enctype: 'multipart/form-data',
            processData: false,
            success: function (data) {
                $(".loader").hide();
                if ($("#zquestion_final").val() == "true") {
                    if (window.confirm("Are you sure, do you want to submit the test?")) {
                        document.getElementById("divfeedback").style.display = "block";
                        document.getElementById("divMCQSetdetails").style.display = "none";
                        clearInterval(myVar);
                    } else {
                        binddata(data);
                    }
                } else {
                    if (data == "TestSubmit") {
                        window.location.href = "/MCQ/TestComplete?status=" + data;
                    } else {
                        binddata(data);
                    }
                }
            }
        });
    }

