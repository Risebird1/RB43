@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Newassets/css/bootstrap.min.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
    <title>Skill Test</title>
</head>
<body>
    <div class="text-center" style="        background-color: #363c43;
        padding: 15px 5px 5px 10px;
        width: 100%;
        display: inline-block;
        position: relative;">
        <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" style="width:180px;" /></div>

    </div>
    <div class="container">
        @if (ViewBag.Action == "TestSubmit")
        {
            <img style=" width: 180px; margin: 0px auto; text-align: center; display: block; padding: 50px 0px;" src="../../img/thanks.png" />
            <h1 style="text-align:center; font-weight:400;line-height:50px;"><b>THANK YOU</b><br />for attempting the test.</h1>
        }
        else if (ViewBag.Action == "Unauthorized")
        {
            <div style="display:table;height:400px;width:100%"> <h1 style="text-align: center; font-weight: 500; height: 100%; vertical-align: middle; display: table-cell;">You are not authorized to take this test.</h1></div>
        }
        else
        {
            <div style="display:table;height:400px;width:100%"> <h1 style="text-align: center; font-weight: 500; height: 100%; vertical-align: middle; display: table-cell;">You have already attempted this test.</h1></div>
        }
    </div>
</body>
</html>
