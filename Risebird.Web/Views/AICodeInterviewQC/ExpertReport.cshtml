@using System.Globalization
@using System.Linq
@using Risebird.Entities.ViewModel
@model Risebird.Entities.ViewModel.AICodeInterviewAuditReportVM
@{
    ViewData["Title"] = "Expert Review of AI Report";

    var aiReport = Model.AIReport;
    var expertReport = Model.ExpertReport;

    var current = expertReport ?? aiReport;
    var readOnly = !Model.CanEdit;

    var aiRows = (aiReport.QuestionRatings ?? new List<AICodeInterviewReportQuestionRatingVM>())
        .OrderBy(r => r.DisplayOrder).ToList();
    var currentRows = (current.QuestionRatings ?? new List<AICodeInterviewReportQuestionRatingVM>())
        .OrderBy(r => r.DisplayOrder).ToList();

    var aiRubric = aiReport.RubricRatings ?? new List<AICodeInterviewRubricRatingVM>();
    var currentRubric = current.RubricRatings ?? new List<AICodeInterviewRubricRatingVM>();

    var rubricDimensions = aiRubric
        .Where(r => !string.IsNullOrWhiteSpace(r.Dimension))
        .ToList();
    var hasRubric = rubricDimensions.Count > 0;

    var changedRows = (Model.Discrepancies ?? new List<AICodeInterviewReportDiscrepancyVM>())
        .Where(d => d.IsDiscrepancy).ToList();

    Func<decimal?, string> num = value => value?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;

    Func<int, AICodeInterviewReportQuestionRatingVM> aiRowAt = order =>
        aiRows.FirstOrDefault(r => r.DisplayOrder == order);

    Func<List<AICodeInterviewRubricRatingVM>, string, AICodeInterviewRubricRatingVM> rubricEntry = (list, dimension) =>
        list.FirstOrDefault(r => string.Equals(r.Dimension, dimension, StringComparison.OrdinalIgnoreCase));

    Func<int, string> severityLabel = severity =>
        severity == 3 ? "Critical" : severity == 2 ? "Major" : severity == 1 ? "Minor" : "Informational";

    Func<AICodeInterviewReportQuestionRatingVM, decimal?> questionMax = row =>
    {
        if (row == null) return null;
        var prop = row.GetType().GetProperty("MaxScore");
        if (prop == null) return null;
        var raw = prop.GetValue(row);
        return raw == null ? (decimal?)null : Convert.ToDecimal(raw, CultureInfo.InvariantCulture);
    };

    var questionCount = currentRows.Count;
    var overallTech = rubricDimensions.FirstOrDefault(r =>
        string.Equals(r.Dimension, "Overall Technical Score", StringComparison.OrdinalIgnoreCase));
    var skillRubricItems = rubricDimensions
        .Where(r => r.IsTechSkill && !string.Equals(r.Dimension, "Overall Technical Score", StringComparison.OrdinalIgnoreCase))
        .ToList();
    decimal skillSum = 0;
    decimal skillMaxSum = 0;
    var anyMax = false;
    foreach (var item in skillRubricItems)
    {
        var entry = rubricEntry(currentRubric, item.Dimension) ?? item;
        skillSum += entry.Rating ?? 0;
        if (item.MaxScore.HasValue)
        {
            anyMax = true;
            skillMaxSum += item.MaxScore.Value;
        }
    }
    if (skillRubricItems.Count == 0 && overallTech != null)
    {
        var entry = rubricEntry(currentRubric, overallTech.Dimension) ?? overallTech;
        skillSum = entry.Rating ?? 0;
    }

    var mappedOverallVerdict = AIInterviewVerdict.Normalize(current.OverallVerdict);
    var mappedAiVerdict = AIInterviewVerdict.Normalize(aiReport.OverallVerdict);
    var llm = Model.LlmDetection;
    var rejectFamily = AIInterviewVerdict.IsRejectFamily(mappedOverallVerdict);
    var selectFamily = AIInterviewVerdict.IsSelectFamily(mappedOverallVerdict);
    var verdictIsCanonical = false;
    foreach (var option in AIInterviewVerdict.Options)
    {
        if (string.Equals(option, mappedOverallVerdict, StringComparison.OrdinalIgnoreCase))
        {
            verdictIsCanonical = true;
            break;
        }
    }
    var roAttr = readOnly ? "readonly" : null;
    var titleLine = (string.IsNullOrWhiteSpace(Model.JDTitle) ? "AI Interview" : Model.JDTitle)
        + " · "
        + (string.IsNullOrWhiteSpace(Model.CandidateName) ? "Candidate" : Model.CandidateName);
}

