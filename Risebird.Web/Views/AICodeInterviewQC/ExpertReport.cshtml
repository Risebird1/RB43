    .rb-er .er-rubric-chip.is-tech { background: rgba(44,168,255,0.12); }
    .rb-er .er-stage[data-er-type="rubric"] .col-max,
    .rb-er .er-stage[data-er-type="rubric"] th.col-max { font-variant-numeric: tabular-nums; font-weight: 600; color: #475569; }
    .rb-er .er-rubric-actual {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }
    .rb-er .er-stage[data-er-type="rubric"] input.num {
        width: 68px;
        height: 30px;
        padding: 3px 6px;
        font-size: 12.5px;
        font-weight: 600;
        background: #fff;
        border: 1px solid #E3E3E3;
        color: #2c2c2c;
    }
    .rb-er .er-stage[data-er-type="rubric"] .hint { font-size: 11px; white-space: nowrap; }
    .rb-er .er-stage[data-er-type="rubric"] textarea.obs {
        min-height: 38px;
        height: 38px;
        max-height: 90px;
        font-size: 12px;
        line-height: 1.4;
        padding: 6px 8px;
        background: #fff;
        color: #2c2c2c;
        border: 1px solid #E3E3E3;
        resize: vertical;
    }
    .rb-er .er-stage[data-er-type="rubric"] tr.totals td {
        background: #f0f8ff !important;
        border-top: 1px solid #d7ebf8;
        border-bottom: none;
        font-weight: 700;
        color: #1e293b;
        padding: 8px 10px;
        font-size: 12.5px;
    }
    .rb-er .er-stage[data-er-type="rubric"] tr.totals td[data-skill-sum-total-actual] {
        color: #2CA8FF;
        font-variant-numeric: tabular-nums;
    }
    .rb-er .er-scroll { overflow: visible; min-height: 0; }
    .rb-er table.grid { border-collapse: collapse; width: 100%; font-size: 12.5px; }
    .rb-er table.grid th { text-align: left; color: var(--dim); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.8px; padding: 8px 10px; border-bottom: 1px solid var(--border); }
    .rb-er table.grid td { padding: 9px 10px; border-bottom: 1px solid var(--border); vertical-align: middle; color: var(--text); }
    .rb-er table.grid tr:last-child td { border-bottom: none; }
    .rb-er .tscroll { overflow-x: auto; }
    .rb-er .bignum { font-size: 24px; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text); }
    .rb-er .overall { display: grid; grid-template-columns: repeat(3, minmax(140px, 1fr)) 2fr; gap: 14px; align-items: start; }
    .rb-er .llm {
        margin-top: 18px;
        padding: 14px 16px;
        border-radius: 10px;
        background: #f8f5fb;
        border: 1px dashed #c4b5d9;
        color: #5b4b73;
        pointer-events: none;
    }
    .rb-er .llm-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; color: #7c6a99; }
    .rb-er .llm-sub { font-size: 11.5px; color: #9A9A9A; margin-bottom: 10px; }
    .rb-er .llm table.grid th, .rb-er .llm table.grid td { color: #5b4b73; border-bottom-color: #e6def0; }
    .rb-er .llm table.grid { pointer-events: auto; }
    .rb-er .totals td { font-weight: 700; background: var(--panel2); }
    .rb-er .er-page { max-width: 1240px; margin: 0 auto; padding: 22px 20px 70px; transform: none !important; position: relative !important; top: auto !important; left: auto !important; width: 100% !important; background: transparent !important; color: inherit !important; }
    .rb-er .er-page-head { display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
    .rb-er .er-page-head h1 { font-size: 19px; font-weight: 700; margin: 0; color: var(--text); }
    .rb-er .er-page-head .sub { color: var(--dim); font-size: 12.5px; margin-top: 4px; max-width: 72ch; }
    .rb-er .er-page .er-card { display: block !important; flex: none; margin-top: 16px; overflow: visible; }

    .rb-er .er-toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #fff; border: 1px solid var(--accent); border-radius: 10px; padding: 10px 20px; font-size: 13px; z-index: 99; display: none; color: #2c2c2c; box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
    .rb-er .er-toast.is-on { display: block; }
    .rb-er .clienttabs { display: inline-flex; border: 1px solid var(--border); border-radius: 9px; overflow: hidden; margin-bottom: 4px; }
    .rb-er .clienttabs button { border: 0; background: var(--panel2); color: var(--dim); padding: 8px 18px; font-size: 12.5px; font-weight: 600; }
    .rb-er .clienttabs button.is-on { background: var(--accent); color: #fff; }
    .rb-er .clipane { display: none; }
    .rb-er .clipane.is-on { display: block; }
    .rb-er .pill { display: inline-block; border-radius: 20px; padding: 2px 11px; font-size: 11px; font-weight: 600; white-space: nowrap; }
    .rb-er .pill.blue { background: var(--accent-soft); color: var(--accent); }
    .rb-er .pill.green { background: rgba(24,206,15,0.12); color: #148c0d; }
    .rb-er .pill.amber { background: rgba(255,178,54,0.18); color: #b78100; }
    .rb-er .pill.red { background: rgba(255,54,54,0.12); color: #d32f2f; }
    .rb-er .pill.grey { background: var(--panel2); color: var(--dim); }

    @@media (max-width: 1100px) {
        .rb-er .er-media { grid-template-columns: 1fr 1fr; }
        .rb-er .overall { grid-template-columns: 1fr 1fr; }
    }
</style>

<script>
    var Header = "<div>Expert Review of AI Report</div>";
    if (typeof $ !== "undefined") {
        $("#txtpageHeader").empty().html(Header);
    }
</script>

<div class="main-panel" id="main-panel">
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12" style="padding:0;">
                <div class="rb-er" id="rbErRoot">
                    <div class="er-topbar">
                        <div class="er-progress" id="erProgress">
                            <button type="button" class="er-prog is-now" id="progQuestions" data-jump="q">
                                1 · Questions
                                @if (questionCount > 0)
                                {
                                    <span class="er-dots">
                                        @for (var d = 0; d < questionCount; d++)
                                        {
                                            <span class="er-dot@(d == 0 ? " is-now" : "")" data-jump-q="@d" title="Question @(d + 1)"></span>
                                        }
                                    </span>
                                    <span class="er-qcount" id="qReviewedLabel">0/@questionCount reviewed</span>
                                }
                            </button>
                            @if (hasRubric)
                            {
                                <button type="button" class="er-prog" id="progRubric" data-jump="rubric">2 · Rubric review</button>
                                <button type="button" class="er-prog" id="progFinal" data-jump="final">3 · Final review</button>
                            }
                            else
                            {
                                <button type="button" class="er-prog" id="progFinal" data-jump="final">2 · Final review</button>
                            }
                        </div>
                        <span class="hint" id="changecount"></span>
                        @if (!readOnly)
                        {
                            <button type="button" class="er-btn" id="regenBtn">↻ Regenerate</button>
                        }
                        <div class="viewtabs">
                            <button type="button" class="is-on" id="tabReviewer">Reviewer view</button>
                            <button type="button" id="tabClient">Client view</button>
                        </div>
                    </div>

                    <div class="screenv" id="v-reviewer">
                        <form method="post" action="@Url.Action("SubmitAICodeInterviewExpertAudit", "AICodeInterviewQC")" id="expertAuditForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SessionId" value="@Model.SessionId" />

                            @if (ViewBag.Message != null || TempData["SuccessErrorMessage"] != null)
                            {
                                <div class="er-alert">@(ViewBag.Message ?? TempData["SuccessErrorMessage"])</div>
                            }

                            <div class="nudge" id="nudge">
                                <span>⚠️</span>
                                <span><b>Transcripts changed</b> — regenerate the report before reviewing so the AI scores the corrected answers.</span>
                                <span class="spacer"></span>
                                @if (!readOnly)
                                {
                                    <button type="button" class="er-btn warn" id="regenNowBtn">Regenerate now</button>
                                }
                            </div>

                            <div class="er-flip-shell">
                                <div class="er-live-card">
                                    <div class="er-live-meta">
                                        <h1>@titleLine</h1>
                                        <div class="sub">
                                            Skill channel <span style="font-family:Consolas,monospace">@Model.IRFId</span>
                                            · <a href="@Url.Action("Report", "AIInterview", new { seId = Model.SessionId })" target="_blank" style="color:#2CA8FF;">open original</a>
                                        </div>
                                    </div>

                                    @for (var i = 0; i < currentRows.Count; i++)
                                    {
                                        var row = currentRows[i];
                                        var baseline = aiRowAt(row.DisplayOrder) ?? row;
                                        <div class="er-stage@(i == 0 ? " is-on" : "")" data-er-type="q" data-er-index="@i">
                                            <div class="er-card er-qcard">
                                                <input type="hidden" name="QuestionRatings[@i].DisplayOrder" value="@row.DisplayOrder" />
                                                <input type="hidden" name="QuestionRatings[@i].QuestionId" value="@row.QuestionId" />
                                                <input type="hidden" name="QuestionRatings[@i].BotInterviewQuestionVideoId" value="@row.BotInterviewQuestionVideoId" />
                                                <input type="hidden" name="QuestionRatings[@i].QuestionText" value="@row.QuestionText" />

                                                <div class="qhead"><span class="qn">@(i + 1)</span>@row.QuestionText</div>
                                                <div class="er-media">
                                                    <div class="player q">
                                                        @if (!string.IsNullOrWhiteSpace(row.QuestionVideoLink))
                                                        {
                                                            <video controls preload="none" src="@row.QuestionVideoLink"></video>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="playbtn">▶</button>
                                                        }
                                                        <span class="who">AI question</span>
                                                    </div>
                                                    <div class="player a">
                                                        @if (!string.IsNullOrWhiteSpace(row.VideoLink))
                                                        {
                                                            <video controls preload="none" src="@row.VideoLink"></video>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="playbtn">▶</button>
                                                        }
                                                        <span class="who">Candidate answer</span>
                                                    </div>
                                                    <div class="tr">
                                                        <div class="er-tr-head">
                                                            <div class="fl">Speech-to-text response (verbal + code explanation) — read-only until Edit</div>
                                                            @if (!readOnly)
                                                            {
                                                                <div class="er-tr-actions">
                                                                    <button type="button" class="er-btn er-btn-sm" data-tr-edit>Edit</button>
                                                                    <button type="button" class="er-btn er-btn-sm primary" data-tr-save style="display:none">Save</button>
                                                                </div>
                                                            }
                                                        </div>
                                                        <textarea class="aud" name="QuestionRatings[@i].TranscriptText"
                                                                  data-ai-value="@baseline.TranscriptText"
                                                                  data-committed="@row.TranscriptText"
                                                                  data-track="transcript"
                                                                  readonly="readonly">@row.TranscriptText</textarea>
                                                    </div>
                                                </div>
                                                <div class="er-quiet">
                                                    <span>Word rate</span>
                                                    <div class="wordrate">—<small>no speech</small></div>
                                                </div>
                                                <div class="er-judge">
                                                    <div class="er-panel er-panel-skill">
                                                        <div class="er-panel-kicker">Skill</div>
                                                        <div class="er-panel-metrics">
                                                            <div class="cell">
                                                                <div class="fl">Skill rating <span class="hint">(AI: @(string.IsNullOrWhiteSpace(baseline.Verdict) ? "—" : baseline.Verdict))</span></div>
                                                                <input type="text" class="er-in" name="QuestionRatings[@i].Verdict"
                                                                       value="@row.Verdict" data-ai-value="@baseline.Verdict" data-track="text" readonly="@roAttr" />
                                                                <span class="diff s2" data-diff-for="QuestionRatings[@i].Verdict"><s>@baseline.Verdict</s></span>
                                                            </div>
                                                            <div class="cell">
                                                                <div class="fl">Skill score <span class="hint">(AI: @(string.IsNullOrWhiteSpace(num(baseline.Rating)) ? "—" : num(baseline.Rating)))</span></div>
                                                                <input class="num" type="number" step="0.01" min="0" name="QuestionRatings[@i].Rating"
                                                                       value="@num(row.Rating)" data-ai-value="@num(baseline.Rating)" data-track="num" data-q-score="1" readonly="@roAttr" />
                                                                <span class="maxlbl">@((questionMax(row) ?? questionMax(baseline)).HasValue ? "/ " + num(questionMax(row) ?? questionMax(baseline)) : "")</span>
                                                                <span class="diff s1" data-diff-for="QuestionRatings[@i].Rating"><s>@num(baseline.Rating)</s></span>
                                                            </div>
                                                        </div>
                                                        <div class="cell">
                                                            <div class="fl">Skill observation</div>
                                                            <textarea class="obs" name="QuestionRatings[@i].Comment"
                                                                      data-ai-value="@baseline.Comment" data-track="text" readonly="@roAttr">@row.Comment</textarea>
                                                            <span class="diff s1" data-diff-for="QuestionRatings[@i].Comment"><s>@baseline.Comment</s></span>
                                                        </div>
                                                    </div>
                                                    <div class="er-panel er-panel-comm">
                                                        <div class="er-panel-kicker">Communication</div>
                                                        <div class="cell">
                                                            <div class="fl">Communication score <span class="hint">(AI: @(string.IsNullOrWhiteSpace(num(baseline.CommunicationRating)) ? "—" : num(baseline.CommunicationRating)))</span></div>
                                                            <input class="num" type="number" step="0.01" min="0" name="QuestionRatings[@i].CommunicationRating"
                                                                   value="@num(row.CommunicationRating)" data-ai-value="@num(baseline.CommunicationRating)" data-track="num" readonly="@roAttr" />
                                                            <span class="diff s1" data-diff-for="QuestionRatings[@i].CommunicationRating"><s>@num(baseline.CommunicationRating)</s></span>
                                                        </div>
                                                        <div class="cell">
                                                            <div class="fl">Communication observation</div>
                                                            <textarea class="obs" name="QuestionRatings[@i].CommunicationComment"
                                                                      data-ai-value="@baseline.CommunicationComment" data-track="text" readonly="@roAttr">@row.CommunicationComment</textarea>
                                                            <span class="diff s1" data-diff-for="QuestionRatings[@i].CommunicationComment"><s>@baseline.CommunicationComment</s></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (hasRubric)
                                    {
                                        <div class="er-stage@(questionCount == 0 ? " is-on" : "")" data-er-type="rubric">
                                            <div class="er-card">
                                                <div class="er-rubric-head">
                                                    <div>
                                                        <h2>Score Rubric</h2>
                                                        <div class="sub">HM / Delivery Manager Instructions skills. Overall skill score = sum of skill-score actuals.</div>
                                                    </div>
                                                    <div class="er-rubric-sum">
                                                        <div class="fl">Overall skill</div>
                                                        <div class="er-rubric-sum-val" data-skill-sum-display="1" data-skill-max="@(anyMax ? num(skillMaxSum) : "")">@skillSum.ToString("0.##", CultureInfo.InvariantCulture)@(anyMax ? " / " + skillMaxSum.ToString("0.##", CultureInfo.InvariantCulture) : "")</div>
                                                    </div>
                                                </div>
                                                <div class="er-scroll">
                                                <div class="tscroll">
                                                    <table class="grid">
                                                        <thead>
                                                            <tr>
                                                                <th class="col-item">Rubric item</th>
                                                                <th class="col-max">Max</th>
                                                                <th class="col-actual">Actual</th>
                                                                <th class="col-obs">Observation</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @for (var i = 0; i < rubricDimensions.Count; i++)
                                                            {
                                                                var dimension = rubricDimensions[i];
                                                                var aiValue = dimension.Rating;
                                                                var currentEntry = rubricEntry(currentRubric, dimension.Dimension);
                                                                var currentValue = currentEntry != null ? currentEntry.Rating : aiValue;
                                                                var observation = currentEntry?.ObservedLevel ?? dimension.ObservedLevel;
                                                                var isOverallTech = string.Equals(dimension.Dimension, "Overall Technical Score", StringComparison.OrdinalIgnoreCase);
                                                                var includeInSkillSum = skillRubricItems.Count > 0
                                                                    ? (dimension.IsTechSkill && !isOverallTech)
                                                                    : isOverallTech;
                                                                <tr>
                                                                    <td class="col-item">
                                                                        <span class="er-rubric-name">@dimension.Dimension</span>
                                                                        <div class="er-rubric-meta">
                                                                            @if (dimension.IsTechSkill)
                                                                            {
                                                                                <span class="er-rubric-chip is-tech">Skill</span>
                                                                            }
                                                                            @if (!string.IsNullOrWhiteSpace(dimension.ExpectedLevel))
                                                                            {
                                                                                <span class="er-rubric-chip">Expected @dimension.ExpectedLevel</span>
                                                                            }
                                                                        </div>
                                                                        <input type="hidden" name="RubricRatings[@i].Dimension" value="@dimension.Dimension" />
                                                                        <input type="hidden" name="RubricRatings[@i].IsTechSkill" value="@dimension.IsTechSkill.ToString().ToLowerInvariant()" />
                                                                        <input type="hidden" name="RubricRatings[@i].ExpectedLevel" value="@dimension.ExpectedLevel" />
                                                                        @if (dimension.MaxScore.HasValue)
                                                                        {
                                                                            <input type="hidden" name="RubricRatings[@i].MaxScore" value="@num(dimension.MaxScore)" />
                                                                        }
                                                                    </td>
                                                                    <td class="col-max">@(dimension.MaxScore.HasValue ? num(dimension.MaxScore) : "—")</td>
                                                                    <td class="col-actual">
                                                                        <div class="er-rubric-actual">
                                                                            <input class="num" type="number" step="0.01" min="0" name="RubricRatings[@i].Rating"
                                                                                   value="@num(currentValue)" data-ai-value="@num(aiValue)" data-track="num"
                                                                                   data-skill-sum="@(includeInSkillSum ? "1" : null)" readonly="@roAttr" />
                                                                            <span class="hint">/ @(dimension.MaxScore.HasValue ? num(dimension.MaxScore) : "—")</span>
                                                                        </div>
                                                                    </td>
                                                                    <td class="col-obs">
                                                                        <textarea class="obs" name="RubricRatings[@i].ObservedLevel"
                                                                                  data-ai-value="@dimension.ObservedLevel" data-track="text" readonly="@roAttr">@observation</textarea>
                                                                    </td>
                                                                </tr>
                                                            }
                                                            <tr class="totals">
                                                                <td class="col-item">Total (skill-score rubric)</td>
                                                                <td class="col-max">@(anyMax ? num(skillMaxSum) : "—")</td>
                                                                <td class="col-actual" data-skill-sum-total-actual="1">@skillSum.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                                                <td class="col-obs"></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="er-stage@(questionCount == 0 && !hasRubric ? " is-on" : "")" data-er-type="final">
                                        <div class="er-card">
                                            <h2>💬 Overall</h2>
                                            <div class="er-scroll">
                                            <div class="overall">
                                                <div>
                                                    <div class="fl">Overall skill score</div>
                                                    <div class="bignum" id="skillTotal" data-skill-sum-display="1" data-skill-max="@(anyMax ? num(skillMaxSum) : "")">@skillSum.ToString("0.##", CultureInfo.InvariantCulture)@(anyMax ? " / " + skillMaxSum.ToString("0.##", CultureInfo.InvariantCulture) : "")</div>
                                                    <div class="hint" id="skillMax">Overall skill score = sum of skill-score rubric scores</div>
                                                </div>
                                                <div>
                                                    <div class="fl">Overall communication</div>
                                                    <div class="bignum" id="commTotal">@(string.IsNullOrWhiteSpace(num(current.OverallCommunicationRating)) ? "—" : num(current.OverallCommunicationRating))</div>
                                                    <div class="hint">out of 100</div>
                                                    <input class="num" type="number" step="0.01" min="0" max="100" name="OverallCommunicationRating"
                                                           value="@num(current.OverallCommunicationRating)"
                                                           data-ai-value="@num(aiReport.OverallCommunicationRating)" data-track="num" data-comm-overall="1" readonly="@roAttr" style="margin-top:8px;" />
                                                    <input type="hidden" name="OverallCommunicationComment" value="@current.OverallCommunicationComment" />
                                                </div>
                                                <div>
                                                    <div class="fl">Final verdict (AI: @(string.IsNullOrWhiteSpace(mappedAiVerdict) ? "—" : mappedAiVerdict))</div>
                                                    @if (readOnly)
                                                    {
                                                        <input type="text" class="er-in" name="OverallVerdict" value="@mappedOverallVerdict" data-ai-value="@mappedAiVerdict" data-track="text" readonly="readonly" />
                                                    }
                                                    else
                                                    {
                                                        <select name="OverallVerdict" data-ai-value="@mappedAiVerdict" data-track="text" id="verdictSel">
                                                            @if (string.IsNullOrWhiteSpace(mappedOverallVerdict))
                                                            {
                                                                <option value="">Select verdict</option>
                                                            }
                                                            else if (!verdictIsCanonical)
                                                            {
                                                                <option value="@mappedOverallVerdict" selected="selected">@mappedOverallVerdict</option>
                                                            }
                                                            @foreach (var option in AIInterviewVerdict.Options)
                                                            {
                                                                <option value="@option" selected="@(string.Equals(option, mappedOverallVerdict, StringComparison.OrdinalIgnoreCase))">@option</option>
                                                            }
                                                        </select>
                                                    }
                                                    <div id="verdictDiff" class="diff s2" data-diff-for="OverallVerdict"><s>@mappedAiVerdict</s></div>
                                                </div>
                                                <div>
                                                    <div class="fl">AI overall comment (read-only)</div>
                                                    <div class="aud" style="min-height:48px;margin-bottom:8px;flex:none;">@(string.IsNullOrWhiteSpace(aiReport.OverallComment) ? "—" : aiReport.OverallComment)</div>
                                                    <div class="fl">Interviewer / final comments</div>
                                                    <textarea class="aud" name="OverallComment" data-ai-value="@aiReport.OverallComment" data-track="text" readonly="@roAttr" style="min-height:72px;flex:none;">@current.OverallComment</textarea>
                                                </div>
                                            </div>
                                            <div class="llm">
                                                <div class="llm-title">LLM detection</div>
                                                <div class="llm-sub">Informational only — not a skill or communication score. Read-only.</div>
                                                @if (llm != null)
                                                {
                                                    <div>Suspected: <span class="pill @(llm.LlmResponseSuspected ? "red" : "green")">@(llm.LlmResponseSuspected ? "Yes" : "No")</span></div>
                                                    @if (!string.IsNullOrWhiteSpace(llm.EvidenceComment))
                                                    {
                                                        <div class="fl" style="margin-top:10px;">Evidence summary</div>
                                                        <div>@llm.EvidenceComment</div>
                                                    }
                                                    @if (llm.SuspiciousInstances != null && llm.SuspiciousInstances.Count > 0)
                                                    {
                                                        <div class="fl" style="margin-top:12px;">Per-question suspicious instances</div>
                                                        <table class="grid">
                                                            <thead>
                                                                <tr>
                                                                    <th>Question</th>
                                                                    <th>Evidence</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var instance in llm.SuspiciousInstances)
                                                                {
                                                                    var splitAt = instance == null ? -1 : instance.IndexOf(": ", StringComparison.Ordinal);
                                                                    var questionPart = splitAt > 0 ? instance.Substring(0, splitAt) : "—";
                                                                    var evidencePart = splitAt > 0 ? instance.Substring(splitAt + 2) : instance;
                                                                    <tr>
                                                                        <td>@questionPart</td>
                                                                        <td>@evidencePart</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }
                                                }
                                                else
                                                {
                                                    <div>No LLM detection data for this interview.</div>
                                                }
                                            </div>
                                            <div style="margin-top:14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                                                @if (!readOnly)
                                                {
                                                    <button type="submit" class="er-btn good">Submit expert audit</button>
                                                    <span class="hint">On submit: discrepancy report stored, assignment stamped, final published report generated for the client view.</span>
                                                }
                                                else
                                                {
                                                    <span class="hint">You are viewing this review in read only mode.</span>
                                                }
                                            </div>
                                        </div>
                                        </div>
                                    </div>

                                    <div class="er-nav">
                                        <button type="button" class="er-btn" id="erBackBtn">Back</button>
                                        <span class="er-nav-label" id="erNavLabel"></span>
                                        <button type="button" class="er-btn primary" id="erFlipBtn">Mark reviewed &amp; flip</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="screenv is-hidden" id="v-client">
                        <div class="er-page">
                            <div class="er-page-head">
                                <div>
                                    <h1>@titleLine</h1>
                                    <div class="sub">Client view — the final published report reflects the expert's changes. The AI original and the SME-edited copy stay available as tabs.</div>
                                </div>
                            </div>
                            <div class="er-card">
                                <div class="clienttabs">
                                    <button type="button" class="is-on" data-cli="final">Final decision</button>
                                    <button type="button" data-cli="ai">AI report</button>
                                    <button type="button" data-cli="sme">SME-edited report</button>
                                </div>
                                <div class="clipane is-on" id="cli-final">
                                    <div style="display:flex; gap:26px; flex-wrap:wrap; align-items:center; margin:14px 0">
                                        <div>
                                            <div class="fl">Verdict</div>
                                            <span class="pill @(rejectFamily ? "red" : selectFamily ? "green" : "grey")" style="font-size:13px; padding:6px 16px">@(string.IsNullOrWhiteSpace(mappedOverallVerdict) ? "—" : mappedOverallVerdict.ToUpperInvariant())</span>
                                        </div>
                                        <div>
                                            <div class="fl">Skill score</div>
                                            <div class="bignum">@skillSum.ToString("0.##", CultureInfo.InvariantCulture) <span class="hint" style="font-size:13px">@(anyMax ? "/ " + skillMaxSum.ToString("0.##", CultureInfo.InvariantCulture) : "")</span></div>
                                        </div>
                                        <div>
                                            <div class="fl">Communication</div>
                                            <div class="bignum">@(string.IsNullOrWhiteSpace(num(current.OverallCommunicationRating)) ? "—" : num(current.OverallCommunicationRating)) <span class="hint" style="font-size:13px">/ 100</span></div>
                                        </div>
                                        <div>
                                            <div class="fl">Expert review</div>
                                            @if (Model.IsSubmitted)
                                            {
                                                <span class="pill amber">Reviewed · @changedRows.Count change@(changedRows.Count == 1 ? "" : "s") · Max severity @(severityLabel(Model.Assignment?.MaxSeverity ?? 0))</span>
                                            }
                                            else
                                            {
                                                <span class="pill grey">Not submitted</span>
                                            }
                                        </div>
                                        <div>
                                            <div class="fl">Integrity</div>
                                            @if (llm != null && llm.LlmResponseSuspected)
                                            {
                                                <span class="pill red">LLM suspected</span>
                                            }
                                            else
                                            {
                                                <span class="pill green">No LLM suspicion</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="hint" style="line-height:1.7">
                                        Final comment (expert-approved): @(string.IsNullOrWhiteSpace(current.OverallComment) ? "—" : current.OverallComment)
                                    </div>
                                </div>
                                <div class="clipane" id="cli-ai">
                                    <p class="hint" style="margin-top:14px; line-height:1.8">
                                        The unmodified AI report.
                                        Verdict: <b>@(string.IsNullOrWhiteSpace(mappedAiVerdict) ? "—" : mappedAiVerdict)</b>.
                                        <a href="@Url.Action("Report", "AIInterview", new { seId = Model.SessionId })" target="_blank" style="color:#2CA8FF;">Open original report</a>
                                    </p>
                                </div>
                                <div class="clipane" id="cli-sme">
                                    @if (changedRows.Count == 0)
                                    {
                                        <p class="hint" style="margin-top:14px; line-height:1.8">No tracked discrepancies yet. Submit the expert audit to store the SME-edited copy.</p>
                                    }
                                    else
                                    {
                                        <div class="tscroll" style="margin-top:14px;">
                                            <table class="grid">
                                                <thead>
                                                    <tr>
                                                        <th>Field</th>
                                                        <th>Question</th>
                                                        <th>AI value</th>
                                                        <th>Expert value</th>
                                                        <th>Severity</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var drow in changedRows)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @drow.FieldType
                                                                @if (!string.IsNullOrWhiteSpace(drow.FieldKey))
                                                                {
                                                                    <div class="hint">@drow.FieldKey</div>
                                                                }
                                                            </td>
                                                            <td>@(drow.DisplayOrder.HasValue ? "Q" + (drow.DisplayOrder.Value + 1) : "—")</td>
                                                            <td><s style="opacity:.75">@drow.AIValue</s></td>
                                                            <td>@drow.ExpertValue</td>
                                                            <td><span class="pill @(drow.Severity >= 3 ? "red" : drow.Severity == 2 ? "amber" : "grey")">@severityLabel(drow.Severity)</span></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="er-toast" id="toast"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.rbErUnlockPage = function () {
        var panel = document.getElementById('main-panel');
        if (panel) {
            panel.classList.remove('ps', 'ps--active-x', 'ps--active-y', 'ps--scrolling-x', 'ps--scrolling-y');
            var kids = panel.children;
            for (var i = kids.length - 1; i >= 0; i--) {
                var cls = kids[i].className || '';
                if (String(cls).indexOf('ps__rail') !== -1 && kids[i].parentNode) {
                    kids[i].parentNode.removeChild(kids[i]);
                }
            }
            panel.style.height = 'auto';
            panel.style.maxHeight = 'none';
            panel.style.overflow = 'visible';
        }
        document.documentElement.style.overflowY = 'auto';
        document.documentElement.style.height = 'auto';
        if (document.body) {
            document.body.style.position = 'relative';
            document.body.style.height = 'auto';
            document.body.style.overflow = 'visible';
            document.body.style.maxHeight = 'none';
        }
    };
    window.rbErUnlockPage();

    (function () {
        var qCount = @questionCount;
        var hasRubric = @(hasRubric ? "true" : "false");
        var stageType = qCount > 0 ? 'q' : (hasRubric ? 'rubric' : 'final');
        var stageIndex = 0;
        var reviewedQ = {};
        var reviewedRubric = false;
        var reviewedFinal = false;

        function normalize(value) {
            return (value === null || value === undefined) ? '' : String(value).trim();
        }
        function transcriptCommitted(el) {
            var committed = el.getAttribute('data-committed');
            return committed === null ? el.value : committed;
        }
        function hasChanged(el) {
            var baseline = normalize(el.getAttribute('data-ai-value'));
            if (el.getAttribute('data-track') === 'transcript') {
                return normalize(transcriptCommitted(el)) !== baseline;
            }
            var actual = normalize(el.value);
            if (el.getAttribute('data-track') === 'num' || el.getAttribute('type') === 'number') {
                var a = parseFloat(baseline);
                var b = parseFloat(actual);
                var aEmpty = baseline === '' || isNaN(a);
                var bEmpty = actual === '' || isNaN(b);
                if (aEmpty && bEmpty) return false;
                if (aEmpty !== bEmpty) return true;
                return Math.abs(a - b) > 0.0001;
            }
            return baseline !== actual;
        }
        function setTranscriptMode(wrap, editing) {
            if (!wrap) return;
            var ta = wrap.querySelector('textarea.aud');
            var edit = wrap.querySelector('[data-tr-edit]');
            var save = wrap.querySelector('[data-tr-save]');
            if (!ta) return;
            if (editing) {
                ta.removeAttribute('readonly');
                ta.classList.add('is-editing');
                ta.focus();
                if (edit) edit.style.display = 'none';
                if (save) save.style.display = '';
            } else {
                ta.setAttribute('readonly', 'readonly');
                ta.classList.remove('is-editing');
                if (edit) edit.style.display = '';
                if (save) save.style.display = 'none';
            }
        }
        function abandonUnsavedTranscripts() {
            Array.prototype.forEach.call(document.querySelectorAll('textarea.aud[data-track="transcript"]'), function (ta) {
                var committed = ta.getAttribute('data-committed');
                if (committed !== null) ta.value = committed;
                setTranscriptMode(ta.closest('.tr'), false);
            });
        }
        function refreshDiffs() {
            var controls = document.querySelectorAll('#expertAuditForm [data-ai-value]');
            var changes = 0;
            var transcriptChanged = false;
            Array.prototype.forEach.call(controls, function (el) {
                var changed = hasChanged(el);
                if (changed) changes += 1;
                el.classList.toggle('changed', changed && el.classList.contains('aud'));
                var name = el.getAttribute('name');
                var diff = name ? document.querySelector('[data-diff-for="' + name + '"]') : null;
                if (diff) diff.classList.toggle('is-on', changed);
                if (el.getAttribute('data-track') === 'transcript' && changed) transcriptChanged = true;
            });
            var countEl = document.getElementById('changecount');
            if (countEl) countEl.textContent = changes ? (changes + ' tracked change' + (changes > 1 ? 's' : '')) : 'no changes vs AI';
            var nudge = document.getElementById('nudge');
            if (nudge) nudge.classList.toggle('is-on', transcriptChanged);
        }
        function formatScore(n) {
            if (!isFinite(n)) return '0';
            return String(Math.round(n * 100) / 100);
        }
        function refreshSkillSum() {
            var inputs = document.querySelectorAll('[data-skill-sum="1"]');
            if (!inputs.length) return;
            var sum = 0;
            Array.prototype.forEach.call(inputs, function (el) {
                var v = parseFloat(el.value);
                if (!isNaN(v)) sum += v;
            });
            var formatted = formatScore(sum);
            var heroes = document.querySelectorAll('[data-skill-sum-display]');
            Array.prototype.forEach.call(heroes, function (el) {
                var max = el.getAttribute('data-skill-max');
                el.textContent = max ? (formatted + ' / ' + max) : formatted;
            });
            var totalActual = document.querySelector('[data-skill-sum-total-actual]');
            if (totalActual) totalActual.textContent = formatted;
        }
        function refreshComm() {
            var el = document.querySelector('[data-comm-overall]');
            var out = document.getElementById('commTotal');
            if (el && out) out.textContent = el.value === '' ? '—' : el.value;
        }
        function toastMsg(t) {
            var e = document.getElementById('toast');
            if (!e) return;
            e.textContent = t;
            e.classList.add('is-on');
            setTimeout(function () { e.classList.remove('is-on'); }, 2600);
        }
        function pauseVideos() {
            Array.prototype.forEach.call(document.querySelectorAll('#v-reviewer video'), function (v) {
                try { v.pause(); } catch (e) { }
            });
        }
        function reviewedCount() {
            var n = 0;
            for (var i = 0; i < qCount; i++) if (reviewedQ[i]) n += 1;
            return n;
        }
        function updateProgress() {
            var qLabel = document.getElementById('qReviewedLabel');
            if (qLabel) qLabel.textContent = reviewedCount() + '/' + qCount + ' reviewed';

            var dots = document.querySelectorAll('.er-dot[data-jump-q]');
            Array.prototype.forEach.call(dots, function (dot) {
                var idx = parseInt(dot.getAttribute('data-jump-q'), 10);
                dot.classList.toggle('is-done', !!reviewedQ[idx]);
                dot.classList.toggle('is-now', stageType === 'q' && stageIndex === idx);
            });

            var pQ = document.getElementById('progQuestions');
            var pR = document.getElementById('progRubric');
            var pF = document.getElementById('progFinal');
            if (pQ) {
                pQ.classList.toggle('is-now', stageType === 'q');
                pQ.classList.toggle('is-done', qCount > 0 && reviewedCount() === qCount && stageType !== 'q');
            }
            if (pR) {
                pR.classList.toggle('is-now', stageType === 'rubric');
                pR.classList.toggle('is-done', reviewedRubric && stageType !== 'rubric');
            }
            if (pF) {
                pF.classList.toggle('is-now', stageType === 'final');
                pF.classList.toggle('is-done', reviewedFinal && stageType !== 'final');
            }
        }
        function updateNav() {
            var back = document.getElementById('erBackBtn');
            var flip = document.getElementById('erFlipBtn');
            var label = document.getElementById('erNavLabel');
            var canBack = !(stageType === 'q' && stageIndex === 0) && !(stageType === 'q' && qCount === 0) && !(stageType !== 'q' && qCount === 0 && !hasRubric && stageType === 'final' && !hasRubric);
            if (stageType === 'q') canBack = stageIndex > 0;
            if (stageType === 'rubric') canBack = qCount > 0;
            if (stageType === 'final') canBack = qCount > 0 || hasRubric;
            if (back) back.disabled = !canBack;

            if (flip) {
                if (stageType === 'final') {
                    flip.style.display = 'none';
                } else {
                    flip.style.display = '';
                    flip.textContent = 'Mark reviewed & flip';
                }
            }
            if (label) {
                if (stageType === 'q') label.textContent = 'Question ' + (stageIndex + 1) + ' of ' + qCount;
                else if (stageType === 'rubric') label.textContent = 'Rubric review';
                else label.textContent = 'Final review';
            }
        }
        function showStage(type, index) {
            abandonUnsavedTranscripts();
            pauseVideos();
            stageType = type;
            stageIndex = type === 'q' ? (index || 0) : 0;
            var stages = document.querySelectorAll('.er-stage');
            Array.prototype.forEach.call(stages, function (el) {
                var t = el.getAttribute('data-er-type');
                var i = parseInt(el.getAttribute('data-er-index') || '0', 10);
                var on = t === type && (t !== 'q' || i === stageIndex);
                el.classList.toggle('is-on', on);
            });
            updateProgress();
            updateNav();
        }
        function markAndFlip() {
            if (stageType === 'q') {
                reviewedQ[stageIndex] = true;
                if (stageIndex < qCount - 1) showStage('q', stageIndex + 1);
                else if (hasRubric) showStage('rubric', 0);
                else showStage('final', 0);
                return;
            }
            if (stageType === 'rubric') {
                reviewedRubric = true;
                showStage('final', 0);
                return;
            }
            reviewedFinal = true;
            updateProgress();
        }
        function goBack() {
            if (stageType === 'q' && stageIndex > 0) {
                showStage('q', stageIndex - 1);
                return;
            }
            if (stageType === 'rubric') {
                if (qCount > 0) showStage('q', qCount - 1);
                return;
            }
            if (stageType === 'final') {
                if (hasRubric) showStage('rubric', 0);
                else if (qCount > 0) showStage('q', qCount - 1);
            }
        }

        var form = document.getElementById('expertAuditForm');
        if (form) {
            form.addEventListener('input', function () { refreshDiffs(); refreshSkillSum(); refreshComm(); });
            form.addEventListener('change', function () { refreshDiffs(); refreshSkillSum(); refreshComm(); });
        }
        function regen() {
            abandonUnsavedTranscripts();
            var b = document.getElementById('regenBtn');
            var now = document.getElementById('regenNowBtn');
            if (b) { b.disabled = true; b.textContent = 'Regenerating…'; }
            if (now) now.disabled = true;
            Array.prototype.forEach.call(document.querySelectorAll('textarea.aud[data-track="transcript"]'), function (ta) {
                var committed = transcriptCommitted(ta);
                ta.value = committed;
                ta.setAttribute('data-committed', committed);
                ta.setAttribute('data-ai-value', committed);
                ta.classList.remove('changed');
            });
            setTimeout(function () {
                refreshDiffs();
                if (b) { b.disabled = false; b.textContent = '↻ Regenerate'; }
                if (now) now.disabled = false;
                toastMsg('Corrected transcripts are now the baseline. Re-check skill scores against the corrected answers.');
            }, 400);
        }
        var regenBtn = document.getElementById('regenBtn');
        var regenNow = document.getElementById('regenNowBtn');
        if (regenBtn) regenBtn.addEventListener('click', regen);
        if (regenNow) regenNow.addEventListener('click', regen);

        Array.prototype.forEach.call(document.querySelectorAll('[data-tr-edit]'), function (btn) {
            btn.addEventListener('click', function () {
                setTranscriptMode(btn.closest('.tr'), true);
            });
        });
        Array.prototype.forEach.call(document.querySelectorAll('[data-tr-save]'), function (btn) {
            btn.addEventListener('click', function () {
                var wrap = btn.closest('.tr');
                var ta = wrap ? wrap.querySelector('textarea.aud') : null;
                if (ta) ta.setAttribute('data-committed', ta.value);
                setTranscriptMode(wrap, false);
                refreshDiffs();
            });
        });

        var backBtn = document.getElementById('erBackBtn');
        var flipBtn = document.getElementById('erFlipBtn');
        if (backBtn) backBtn.addEventListener('click', goBack);
        if (flipBtn) flipBtn.addEventListener('click', markAndFlip);

        var progQ = document.getElementById('progQuestions');
        var progR = document.getElementById('progRubric');
        var progF = document.getElementById('progFinal');
        if (progQ) progQ.addEventListener('click', function (e) {
            var dot = e.target.closest ? e.target.closest('[data-jump-q]') : null;
            if (dot) {
                showStage('q', parseInt(dot.getAttribute('data-jump-q'), 10));
                e.stopPropagation();
                return;
            }
            if (qCount > 0) showStage('q', stageType === 'q' ? stageIndex : 0);
        });
        if (progR) progR.addEventListener('click', function () { showStage('rubric', 0); });
        if (progF) progF.addEventListener('click', function () { showStage('final', 0); });
        Array.prototype.forEach.call(document.querySelectorAll('[data-jump-q]'), function (dot) {
            dot.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                showStage('q', parseInt(dot.getAttribute('data-jump-q'), 10));
            });
        });

        var root = document.getElementById('rbErRoot');
        document.getElementById('tabReviewer').addEventListener('click', function () {
            document.getElementById('tabReviewer').classList.add('is-on');
            document.getElementById('tabClient').classList.remove('is-on');
            document.getElementById('v-reviewer').classList.remove('is-hidden');
            document.getElementById('v-client').classList.add('is-hidden');
            if (root) root.classList.remove('is-client');
        });
        document.getElementById('tabClient').addEventListener('click', function () {
            document.getElementById('tabClient').classList.add('is-on');
            document.getElementById('tabReviewer').classList.remove('is-on');
            document.getElementById('v-client').classList.remove('is-hidden');
            document.getElementById('v-reviewer').classList.add('is-hidden');
            if (root) root.classList.add('is-client');
        });
        Array.prototype.forEach.call(document.querySelectorAll('.clienttabs button'), function (btn) {
            btn.addEventListener('click', function () {
                Array.prototype.forEach.call(document.querySelectorAll('.clienttabs button'), function (b) { b.classList.remove('is-on'); });
                btn.classList.add('is-on');
                Array.prototype.forEach.call(document.querySelectorAll('.clipane'), function (p) { p.classList.remove('is-on'); });
                var pane = document.getElementById('cli-' + btn.getAttribute('data-cli'));
                if (pane) pane.classList.add('is-on');
            });
        });

        refreshDiffs();
        refreshSkillSum();
        refreshComm();
        showStage(stageType, 0);
    })();
</script>

@section Scripts {
    <script>
        if (typeof window.rbErUnlockPage === 'function') {
            window.rbErUnlockPage();
            setTimeout(window.rbErUnlockPage, 0);
        }
    </script>
}
