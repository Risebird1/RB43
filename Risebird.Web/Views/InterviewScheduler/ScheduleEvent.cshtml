<script src="~/js/InterviewCalender.js"></script>
<script>
    $(document).ready(function () {
        setvalues();
    });
    function setvalues() {
        var slotdays = $("#txthiddenSlotdays").val();
        for (var i = 0; i < parseInt(slotdays); i++) {
            const now1 = new Date();
            const todayDay1 = now1.getDate(),
                todayMonth1 = now1.getMonth(),
                todayYear1 = now1.getFullYear();
            const now = new Date().addDays(i);
            const todayDay = now.getDate(),
                todayMonth = now.getMonth(),
                todayYear = now.getFullYear();
            if (todayDay1 <= todayDay) {
                var relativemonth = $("#cal-month").text();
                var relativeyear = $("#cal-year").text();
                var comparemonth = monthsStr[new Date().getMonth()];
                var compareyear = new Date().getFullYear();
                if (relativemonth == comparemonth && relativeyear == compareyear)
                    document.getElementsByClassName("currMonth")[todayDay - 1].setAttribute("style", "background-color:#cae2fb73!important;color:#56a9ff!important;font-weight: bold;opacity: 1 !important;border-radius: 50%;width:44px;height:44px;color:#fff; padding:0px 5px;");
                //document.getElementById("current-day").setAttribute("style", "background-color:#ffffff!important;font-weight:normal;color:black!important;opacity: 1 !important;border-radius: 50%;width:44px;height:44px;padding:0px 5px;");
            }
        }
    }
    var countrydetails;

    $(document).ready(function () {
        var timezonevalue = Intl.DateTimeFormat().resolvedOptions().timeZone;
        //$("#txttimezone").text(timezonevalue);
        //$("#txttimezoneform").text(timezonevalue);
        if ($("#txthiddenPageStatus").val() == 2) {
            document.getElementById("divCandidateDetails").style.display = "block";
            document.getElementById("divcalenderdetails").style.display = "none";
            $("#telnumber").intlTelInput({
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/8.4.6/js/utils.js",
                initialCountry: "in"
            });
        } else if ($("#txthiddenPageStatus").val() == 3) {
            document.getElementById("divCandidateDetails").style.display = "none";
            document.getElementById("divcalenderdetails").style.display = "none";
            document.getElementById("divExpire").style.display = "block";
        } else if ($("#txthiddenPageStatus").val() == 4) {
            document.getElementById("divCandidateDetails").style.display = "none";
            document.getElementById("divcalenderdetails").style.display = "none";
            document.getElementById("divconfirm").style.display = "block";
        }
        $('.currMonth').click(function () {
            $(".currMonth").removeClass('active-slot');
            setvalues();
            $(this).removeAttr('style', '');
            $(this).addClass('active-slot');
        });

    });
    Date.prototype.addDays = function (days) {
        var date = new Date(this.valueOf());
        date.setDate(date.getDate() + days);
        return date;
    }
    var SelectDateValue = "";
    function fetchTimeslots(selectdate) {
        var slotdays = $("#txthiddenSlotdays").val();
        var timeZonevalue = $("#ddlselecttimezone option:selected").text();
        var flag = true;
        for (var i = 0; i < parseInt(slotdays); i++) {
            //var offset = (new Date()).getTimezoneOffset();
            var valuesutc = $("#ddlselecttimezone").val();
            var offset = -(parseFloat(valuesutc) * 60);
            const now1 = new Date().addDays(i);
            const todayDay1 = now1.getDay(),
                todayDate1 = now1.getDate(),
                todayMonth1 = now1.getMonth(),
                todayYear1 = now1.getFullYear();
            if (selectdate == todayDate1 && todayMonth1 == state.todayMonth && todayYear1 == state.todayYear) {
                SelectDateValue = selectdate;
                $.ajax({
                    type: "POST",
                    url: "/InterviewScheduler/FetchSlots",
                    data: { day: selectdate, month: (state.todayMonth + 1), year: state.todayYear, id: $("#txthiddenid").val(), offset: offset, TimeZonevalue: timeZonevalue },
                    success: function (data) {
                        bindslots(data);
                    }
                });
                flag = true
                break;
            }
            else {
                flag = false;
            }
        }
        if (flag == false) {
            bindslots("");
            swal.fire('No slots available on', +selectdate + 'th ' + '' + monthsStr[state.todayMonth] + '&nbsp;' + state.todayYear + '<br/>' + '<span>Please select another date</span>');
            $(".currMonth").removeClass('active-slot');
            setvalues();
        }
    }
    function bindslots(data) {
        var html = '';
        html += '<table><tbody>';
        for (var i = 0; i < data.length; i++) {
            html += '<tr><td><input type="hidden" id="txtslotid_' + i + '" value="' + data[i] + '"><button class="button time-btn" onclick="submitDate(' + i + ')"><span>' + data[i] + '</span></button></td></tr>';
        }
        html += '</tbody></table>';
        $("#calenderTimeslot").empty().html(html);
    }
    function submitDate(i) {
        //var offset = (new Date()).getTimezoneOffset();
        var valuesutc = $("#ddlselecttimezone").val();
        var offset = -(parseFloat(valuesutc) * 60);
        var timeZonesValue = $("#ddlselecttimezone option:selected").text();
        var timezonetext = document.querySelector("Select option[value='" + valuesutc + "']").innerHTML;
        var timeslot = $("#txtslotid_" + i).val();
        var datevalue = SelectDateValue + " " + (state.todayMonth + 1) + " " + state.todayYear + " " + timeslot;
        var datevalueformate = timeslot + ", " + monthsStr[state.todayMonth] + " " + SelectDateValue + ", " + state.todayYear;
        $("#InterviewDate").val(datevalue);
        $("#offset").val(offset);
        $("#InterviewDateform").text(datevalueformate);
        $("#txttimezoneform").text(timeZonesValue);
        $("#TimeZonesValue").val(timeZonesValue);
        document.getElementById("divCandidateDetails").style.display = "block";
        document.getElementById("divcalenderdetails").style.display = "none";
        $(".calendly-inline-widget").attr('style', 'height:1100px')
        $("#telnumber").intlTelInput({
            utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/8.4.6/js/utils.js",
            initialCountry: "in"
        });
    }
    function checkvalidation() {
        var code_value = $(".selected-flag").attr("title").split(":")[1].trim();
        $("#CountryCode").val(code_value);
        return true;
    }
    function setoffsettime() {
        var valuesutc = $("#ddlselecttimezone").val();
        bindslots("");
        $(".currMonth").removeClass('active-slot');
        setvalues();
    }
    $(document).ready(function () {
        let element = document.getElementById("ddlselecttimezone");
        var offset = (new Date()).getTimezoneOffset();
        var selectedvalue = (-parseFloat(offset) / 60);
        element.value = selectedvalue;
    });
</script>


