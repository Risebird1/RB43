<style>
    .required::after {
        content: "*";
        font-weight: bold;
        color: red;
    }

    .button {
        position: relative !important;
        padding: 13px 10px !important;
        background: none !important;
        font-weight: bold !important;
        vertical-align: top !important;
        border-radius: 4px !important;
        transition: all 0.3s ease;
        transition-property: width, transform;
        width: 250px;
        height: 52px;
        margin-bottom: 8px;
        color: var(--primary-color, rgb(0, 107, 255));
        /* border: 1px solid #c0c1c3c2 !important;
                                                                                                                                                    color: #9b9393;*/
        font-size: 17px;
        /* background: #e5e5e5 !important*/
    }

        .button span {
            cursor: pointer;
            display: inline-block;
            position: relative;
            transition: 0.5s;
        }

            .button span:after {
                content: '\00bb';
                position: absolute;
                opacity: 0;
                top: 0;
                right: -20px;
                transition: 0.5s;
            }

        .button:hover:before {
            content: "Confirm!";
            background-color: #fff;
            color: green;
        }

        .button:hover span {
            padding-right: 25px;
            display: none;
        }

            .button:hover span:after {
                opacity: 1;
                right: 0;
            }

    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: capitalize !important;
        font-weight: 500 !important;
        margin-bottom: 12px !important;
        text-transform: none !important;
    }

    .swal2-popup #swal2-content {
        text-align: center;
        font-size: 25px;
        font-weight: 600;
    }

        .swal2-popup #swal2-content span {
            padding-top: 10px;
            display: block;
            color: grey;
            font-size: 19px;
            font-weight: normal;
        }

    .navbar {
        display: none;
    }

    .sidebar {
        display: none !important;
    }
</style>

