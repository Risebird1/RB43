@model Risebird.Entities.ViewModel.AadhaarData
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Newassets/css/bootstrap.min.css?v=7" rel="stylesheet" />
    <link href="~/Newassets/css/interview.css?v=6" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=10" />
    @*<link rel="stylesheet" type="text/css" id="theme" href="~/Newassets/css/blue-theme.css" />*@
    <title>Candidate Verification</title>
</head>
<body>
    <div class="text-center" style="background: linear-gradient(to right, #0c2646 0%, #204065 60%, #2a5788 100%);padding: 15px 5px 5px 10px;width: 100%;display: inline-block;position: relative;">
        <div style="float:left"><img src="https://risebirdportal.blob.core.windows.net/logo/risebird.png" style="width:180px;" /></div>
    </div>
    <div class="container">
        @if (Model.status == "InvalidEmail")
        {
            <div style="display:table;height:400px;width:100%"> <h1 style="text-align: center; font-weight: 500; height: 100%; vertical-align: middle; display: table-cell;">You are not authorized to verify aadhaar details using this link.</h1></div>
        }
        else if (Model.status == "Unauthorized")
        {
            <div style="display:table;height:400px;width:100%"> <h1 style="text-align: center; font-weight: 500; height: 100%; vertical-align: middle; display: table-cell;">Your link has been expired or aadhaar details are already verified, please contact to HR for further information.</h1></div>
        }
        else
        {
            <div class="row" id="divdetails">
                <div class="col-md-8 offset-md-2">
                    <div class="loader text-center">
                        <img src="~/Newassets/img/lazyload.gif" />
                    </div>
                    <div class="filheader callno">
                        <h2 style="margin-bottom:10px;">Candidate Verification</h2>
                    </div>

                    <div class="row" style="padding:10px" id="divcandidateskills">
                        <div class="offset-md-2 col-md-8 col-lg-8 col-sm-8" style="padding-top:10px">
                            <input type="text" id="Candidatename" placeholder="Name" class="form-control" />
                        </div>
                        <div class="offset-md-2 col-md-8 col-lg-8 col-sm-8" style="padding-top:10px">
                            <input type="text" placeholder="Mobile Number with country code(+)" id="mobileNumber" class="form-control" />
                        </div>
                        <div class="offset-md-2 col-md-8 col-lg-8 col-sm-8" style="padding-top:10px">
                            <input type="text" id="CandidateEmailid" placeholder="Email Address" class="form-control" />
                        </div>
                    </div>
                    <div>
                        <div class="col-md-12 text-right">
                            <div>
                                <div id="divSubmit" style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="submitform()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded form-control" value="Submit"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }


    </div>
</body>
</html>
<div id="AadhaarKYCpopup" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document" style="max-width:850px !important">
        <div class="modal-content">
            <div class="filheader">
                <h5 class="modal-title pull-left">Verifying Data</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeAadhaarKYCpopup()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body">
                <iframe allow="camera; microphone" id="verificationframe" style="width:100%;height:37VW"></iframe>
            </div>
        </div>
    </div>
</div>
<script src="~/Newassets/js/core/jquery.min.js?v=7"></script>
<script>
    function submitform() {
        if ($("#Candidatename").val().trim() != '' && $("#mobileNumber").val().trim() != '' && $("#CandidateEmailid").val().trim() != '') {
            $.ajax({
                type: "POST",
                url: "/Aadhaar/FetchVerificationURL",
                data: { Name: $("#Candidatename").val(), PhoneNumber: $("#mobileNumber").val(), Emailid: $("#CandidateEmailid").val() },
                success: function (data) {
                    $("#verificationframe").attr("src", data);
                    document.getElementById("AadhaarKYCpopup").style.display = "block";
                }
            });
        } else {
            alert("Please Fill all the fields.");
        }
    }
    function closeAadhaarKYCpopup() {
        document.getElementById("AadhaarKYCpopup").style.display = "none";
    }
</script>
