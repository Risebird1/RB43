@model IEnumerable<Risebird.Entities.Data.EmploymentDetailsDM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum

@{
    ViewData["Title"] = "Employment Details";
    ViewBag.PageHeader = "Employment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-right">
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("Index", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family:arial;">Back</font></span>
                        </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="openEmploymentPopup()" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Employment Verification</font></span>
                    </button>
                </div>
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Employment Details</h4></div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card  bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                    <div id="tableID">
                                        <table id="dupmeeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Mobile Number</th>
                                                    <th>Candidate Email</th>
                                                    <th>Name</th>
                                                    <th>Company Name</th>
                                                    <th>UAN</th>
                                                    <th>Currently Working</th>
                                                    <th>DOB</th>
                                                    <th>Joining Date</th>
                                                    <th>Exit Date</th>
                                                    <th>UAN Count</th>
                                                    <th>UAN Numbers</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Mobile Number</th>
                                                    <th>Candidate Email</th>
                                                    <th>Name</th>
                                                    <th>Company Name</th>
                                                    <th>UAN</th>
                                                    <th>Currently Working</th>
                                                    <th>DOB</th>
                                                    <th>Joining Date</th>
                                                    <th>Exit Date</th>
                                                    <th>UAN Count</th>
                                                    <th>UAN Numbers</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.MobileNumber</td>
                                                        <td>@item.CandidateEmail</td>
                                                        @if (string.IsNullOrWhiteSpace(item.message))
                                                        {
                                                            <td> @item.Name </td>
                                                            <td>
                                                                @if (item.CompanyName != null && item.CompanyName != "")
                                                                {
                                                                    @if (item.CompanyName.Length > 35)
                                                                    {
                                                                        <div class="article">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.CompanyName.Substring(0, 35)
                                                                            </p>
                                                                            <p class="moretext_@item.id moretext">
                                                                                @item.CompanyName.Substring(35, @item.CompanyName.Length - 35)
                                                                            </p>
                                                                        </div>
                                                                        <a onclick="moreless('@item.id')" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article">
                                                                            <p>
                                                                                @item.CompanyName.Substring(0, @item.CompanyName.Length)
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                }
                                                            </td>

                                                            <td>@item.UAN</td>
                                                            @if (item.Isemployed)
                                                            {
                                                                <td>Yes</td>
                                                            }
                                                            else
                                                            {
                                                                <td>No</td>
                                                            }
                                                            <td>@item.DOB</td>
                                                            <td>@item.JoiningDate</td>
                                                            <td>@item.ExitDate</td>
                                                            <td>@item.TotalUAN</td>
                                                            <td>@item.UANNumbers</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.message</td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                            <td></td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->
        </div>
    </div>
</div>
<div id="EmploymentVerifiationPopUp" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <i class="fa fa-file" aria-hidden="true" style="font-size:21px"></i>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Employment Verification </h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeEmploymentVerifiationPopUp()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" style="padding: 2px 16px;">
                <div class="row" style="padding:10px">
                    <div class="col-md-12">
                        <input type="text" class="form-control" placeholder="Candidate Email Address" id="txteCandidateEmail" style="margin-top: 10px;margin-bottom: 10px;" />
                    </div>
                    <div class="col-md-12" style="padding-top:16px;">
                        <input type="number" class="form-control" placeholder="Mobile number (10 digit)" maxlength="10" id="txteMobilenumber" style="margin-bottom: 10px;" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 text-right">
                        <input style="color: #fff;line-height: 13px;margin-bottom:10px;" type="button" onclick="VerifyEmployment()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Verify">
                        <input style="color: #fff;line-height: 13px; margin:0px 10px 10px 0px;" type="button" onclick="closeEmploymentVerifiationPopUp()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function RefreshSearch() {
        $('#dupmeeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#dupmeeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top:11px;' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#dupmeeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#dupmeeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#dupmeeting").show();
        }, 2000);
    };
    //// script for loader ends here
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
</script>
<script>
    function openEmploymentPopup() {
        var modal = document.getElementById("EmploymentVerifiationPopUp");
        modal.style.display = "block";
    }
    function closeEmploymentVerifiationPopUp() {
        var modal = document.getElementById("EmploymentVerifiationPopUp");
        modal.style.display = "none";
    }
    function VerifyEmployment() {
        var candidateemail = $("#txteCandidateEmail").val().trim();
        var mobilenumber = $("#txteMobilenumber").val().trim();
        if ($("#txteMobilenumber").val().length == 10) {
            if (candidateemail != '') {
                $.ajax({
                    type: "POST",
                    url: "/Aadhaar/VerifyEmployment",
                    data: { candidateemail: candidateemail, mobilenumber: mobilenumber },
                    success: function (data) {
                        alert(data);
                        closeEmploymentVerifiationPopUp();
                        location.reload();
                    }
                });
            } else {
                alert("Please enter the candidate Emailid.");
            }
        } else {
            alert("Please enter the valid mobile number.");
        }
    }
</script>