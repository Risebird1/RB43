@using Risebird.Entities.ViewModel
@{
    ViewData["Title"] = "QC Activity";
    var isManager = ViewBag.IsManager is bool b && b;
    var defaultRangeDays = ViewBag.DefaultRangeDays is int d ? d : QCActivityMetrics.DefaultRangeDays;
    var maxRangeDays = ViewBag.MaxRangeDays is int m ? m : QCActivityMetrics.MaxRangeDays;

    // URL templates from the shared drill-down helpers; JS fills __INTERVIEW_ID__ / __IRF_ID__.
    var tplReport = TrialFlagDrillDownUrls.ReportQuality(111111111).Replace("111111111", "__INTERVIEW_ID__");
    var tplTranscript = TrialFlagDrillDownUrls.TranscriptQuality(111111111, 222222222)
        .Replace("111111111", "__INTERVIEW_ID__").Replace("222222222", "__IRF_ID__");
    var tplContradiction = TrialFlagDrillDownUrls.ContradictionReport(111111111).Replace("111111111", "__INTERVIEW_ID__");
    var tplQcMerge = TrialFlagDrillDownUrls.QcMergedAiDetails(111111111).Replace("111111111", "__INTERVIEW_ID__");
}

<script>
    $('#txtpageHeader').empty().html("<div>QC Activity Dashboard</div>");
</script>

<style>
    .qca, .qca-head-actions, .qca-modal { --qca-ink: #0f172a; --qca-muted: #64748b; --qca-faint: #94a3b8; --qca-line: #e2e8f0; --qca-bg: #f8fafc;
           --qca-card: #ffffff; --qca-blue: #2563eb; --qca-blue-soft: #eff6ff; --qca-red: #b91c1c; --qca-red-soft: #fee2e2;
           --qca-amber: #92400e; --qca-amber-soft: #fef3c7; --qca-amber-line: #fcd34d; --qca-green: #15803d; }
    .qca { padding: 16px; color: var(--qca-ink); font-size: 14px; max-width: 100%; box-sizing: border-box; }
    .qca *, .qca *::before, .qca *::after, .qca-modal * { box-sizing: border-box; }
    .qca-back { background: #fff; border: 1px solid var(--qca-line); border-radius: 6px; padding: 5px 14px; font-size: 14px; color: var(--qca-ink); cursor: pointer; }
    .qca-head-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .qca-head-actions .qca-back { text-decoration: none; display: inline-block; line-height: 1.4; }
    .qca-head-actions .qca-back:hover { background: #f8fafc; text-decoration: none; }
    .qca-title { display: flex; align-items: center; gap: 12px; margin: 12px 0 4px; flex-wrap: wrap; }
    .qca-title h2 { margin: 0; font-size: 24px; font-weight: 700; color: var(--qca-ink); }
    .qca-own-badge { background: var(--qca-blue-soft); color: var(--qca-blue); border-radius: 999px; padding: 2px 10px; font-size: 12px; font-weight: 600; }
    .qca-intro { margin: 0 0 14px; color: var(--qca-muted); line-height: 1.5; max-width: 1100px; }

    .qca-filters { background: var(--qca-card); border: 1px solid var(--qca-line); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px; }
    .qca-filters__row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
    .qca-field { display: flex; flex-direction: column; gap: 4px; }
    .qca-field label, .qca-label { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--qca-muted); margin: 0; }
    .qca-presets { display: flex; gap: 6px; }
    .qca-btn { border: 1px solid var(--qca-line); background: #fff; color: var(--qca-ink); border-radius: 6px; padding: 6px 14px; font-size: 14px; cursor: pointer; line-height: 1.4; }
    .qca-btn:hover { border-color: #cbd5e1; background: var(--qca-bg); }
    .qca-btn.is-active, .qca-btn--primary { background: var(--qca-blue); border-color: var(--qca-blue); color: #fff; }
    .qca-btn--primary:hover, .qca-btn.is-active:hover { background: #1d4ed8; border-color: #1d4ed8; }
    .qca-btn:disabled { opacity: .6; cursor: default; }
    .qca-date { border: 1px solid var(--qca-line); border-radius: 6px; padding: 5px 8px; font-size: 14px; color: var(--qca-ink); background: #fff; height: 34px; }
    .qca-check { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; margin: 0 0 6px; cursor: pointer; }
    .qca-check input { width: 16px; height: 16px; margin: 0; }
    .qca-hint { margin: 10px 0 0; font-size: 13px; color: var(--qca-faint); }

    .qca-alert { padding: 10px 14px; border-radius: 8px; margin-bottom: 12px; font-size: 13px; }
    .qca-alert--error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .qca-alert--info { background: var(--qca-blue-soft); border: 1px solid #bfdbfe; color: #1e3a8a; }

    .qca-backlog { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 14px; }
    .qca-pill { background: var(--qca-amber-soft); border: 1px solid var(--qca-amber-line); color: var(--qca-amber); border-radius: 999px; padding: 4px 14px; font-size: 13px; text-decoration: none; }
    .qca-pill:hover { color: var(--qca-amber); text-decoration: none; filter: brightness(.97); }
    .qca-pill b { font-weight: 700; }

    .qca-tiles { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
    .qca-tile { background: var(--qca-card); border: 1px solid var(--qca-line); border-radius: 10px; padding: 12px 14px; min-width: 0; }
    .qca-tile__label { font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--qca-muted); line-height: 1.3; }
    .qca-tile__value { font-size: 26px; font-weight: 700; margin-top: 2px; font-variant-numeric: tabular-nums; }
    .qca-tile__sub { font-size: 12px; color: var(--qca-faint); }

    .qca-table-wrap { background: var(--qca-card); border: 1px solid var(--qca-line); border-radius: 10px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .qca-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
    .qca-table th { font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #334155; padding: 8px 10px; white-space: nowrap; background: #fff; border-bottom: 1px solid var(--qca-line); }
    .qca-table thead tr:first-child th { text-align: center; color: var(--qca-ink); font-size: 12px; }
    .qca-table th.qca-group, .qca-table td.qca-group { border-left: 1px solid var(--qca-line); }
    .qca-table th.qca-user-h { text-align: left; vertical-align: middle; position: sticky; left: 0; z-index: 2; }
    .qca-table td { padding: 9px 10px; border-bottom: 1px solid #f1f5f9; text-align: right; white-space: nowrap; }
    .qca-table td.qca-user { text-align: left; position: sticky; left: 0; background: #fff; z-index: 1; border-right: 1px solid var(--qca-line); min-width: 210px; }
    .qca-table tbody tr:hover td { background: #f8fafc; }
    .qca-table tr.qca-section td { background: var(--qca-bg); text-align: left; font-size: 12px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--qca-muted); }
    .qca-name { font-weight: 600; font-size: 15px; }
    .qca-email { color: var(--qca-muted); font-size: 13px; }
    .qca-badge-none { background: var(--qca-red-soft); color: var(--qca-red); border-radius: 4px; padding: 1px 6px; font-size: 11px; font-weight: 600; margin-left: 6px; }
    .qca-badge-inactive { background: #f1f5f9; color: var(--qca-muted); border-radius: 4px; padding: 1px 6px; font-size: 11px; font-weight: 600; margin-left: 6px; }
    .qca-num { color: var(--qca-blue); text-decoration: underline; cursor: pointer; background: none; border: 0; padding: 0; font: inherit; }
    .qca-num:hover { color: #1d4ed8; }
    .qca-zero { color: #cbd5e1; }
    .qca-sub { color: var(--qca-faint); }
    .qca-empty { padding: 28px; text-align: center; color: var(--qca-muted); }
    .qca-loading { padding: 28px; text-align: center; color: var(--qca-muted); }

    .qca-modal { position: fixed; inset: 0; background: rgba(15, 23, 42, .55); z-index: 2000; display: none; align-items: flex-start; justify-content: center; padding: 3vh 12px; }
    .qca-modal.is-open { display: flex; }
    .qca-modal__box { background: #fff; border-radius: 10px; width: min(1500px, 100%); max-height: 94vh; display: flex; flex-direction: column; box-shadow: 0 20px 50px rgba(0, 0, 0, .3); }
    .qca-modal__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 14px 18px 10px; border-bottom: 1px solid var(--qca-line); }
    .qca-modal__head h3 { margin: 0; font-size: 20px; font-weight: 700; color: var(--qca-ink); }
    .qca-modal__sub { color: var(--qca-muted); font-size: 13px; margin-top: 2px; word-break: break-all; }
    .qca-modal__body { overflow: auto; }
    .qca-dt { width: 100%; border-collapse: collapse; font-size: 14px; }
    .qca-dt th { position: sticky; top: 0; background: #f8fafc; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #334155; padding: 8px 10px; border-bottom: 1px solid var(--qca-line); white-space: nowrap; z-index: 1; }
    .qca-dt td { padding: 8px 10px; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    .qca-dt tr:hover td { background: #f8fafc; }
    .qca-dt .qca-small { color: var(--qca-muted); font-size: 13px; }
    .qca-dt a { color: var(--qca-blue); margin-right: 8px; white-space: nowrap; }
    .qca-penalty { color: var(--qca-red); font-weight: 600; }
    .qca-ok { color: var(--qca-green); font-weight: 600; }
    .qca-dt audio { height: 32px; max-width: 260px; vertical-align: middle; }
    .qca-detail-text { max-width: 420px; white-space: normal; word-break: break-word; }
    .qca-undo { color: var(--qca-muted); font-size: 12px; margin-left: 3px; text-decoration: none; display: inline-block; }
    .qca-edit-link { font-size: 13px; margin-top: 2px; }

    .qca-modal--top { z-index: 2010; }
    .qca-modal__box--narrow { width: min(1100px, 100%); }
    .qca-edit-body { padding: 14px 18px 18px; }
    .qca-edit-body h4 { font-size: 12px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--qca-muted); margin: 14px 0 6px; }
    .qca-edit-body h4:first-child { margin-top: 0; }
    .qca-edit-actions a { color: var(--qca-blue); }
    .qca-edit-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .qca-diff { white-space: pre-wrap; word-break: break-word; line-height: 1.6; background: var(--qca-bg); border: 1px solid var(--qca-line); border-radius: 8px; padding: 10px 12px; max-height: 40vh; overflow: auto; }
    .qca-del { background: var(--qca-red-soft); color: var(--qca-red); text-decoration: line-through; }
    .qca-ins { background: #dcfce7; color: var(--qca-green); text-decoration: none; }

    @@media (max-width: 1600px) { .qca-tiles { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
    @@media (max-width: 1280px) { .qca-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @@media (max-width: 768px) {
        .qca { padding: 12px 16px; }
        .qca-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .qca-filters__row { gap: 10px; }
        .qca-field--date { flex: 1 1 140px; }
        .qca-date { width: 100%; }
        .qca-table td.qca-user { min-width: 170px; }
        .qca-modal { padding: 0; }
        .qca-modal__box { max-height: 100vh; height: 100vh; border-radius: 0; }
        .qca-edit-cols { grid-template-columns: minmax(0, 1fr); }
    }
</style>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"><h4 class="card-title">QC Activity</h4></div>
                </div>
                <div class="pull-right qca-head-actions">
                    <button type="button" class="qca-back" onclick="if (history.length > 1) { history.back(); } else { location.href='/Dashboard/EmergencyDashboard'; }">Back</button>
                    <a class="qca-back" href="@Url.Action("Interviewers", "QCActivity")">Interviewer QC View</a>
                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
<div class="qca" id="qcaRoot"
     data-manager="@(isManager ? "1" : "0")"
     data-default-days="@defaultRangeDays"
     data-max-days="@maxRangeDays"
     data-tpl-report="@tplReport"
     data-tpl-transcript="@tplTranscript"
     data-tpl-contradiction="@tplContradiction"
     data-tpl-qcmerge="@tplQcMerge">

    <div class="qca-title">
        <h2>QC Activity</h2>
        @if (!isManager)
        {
            <span class="qca-own-badge">Your activity</span>
        }
    </div>
    <p class="qca-intro">
        What each Quality Controller actually did: interview reports reviewed and penalties applied (Payment SLA / QC Reject / QC Select),
        reports edited, trial interviewers kept or removed, IRF audits, Total Red Marker and Total Interview actions, interviewer status
        changes (suspicious, blocked, portal access, inactive, payment hold; &#8634; counts undos) and Plivo calls to interviewers.
        Click any number to see the records behind it. Dates are IST.
    </p>

    <div class="qca-filters">
        <div class="qca-filters__row">
            <div class="qca-field">
                <span class="qca-label">Period</span>
                <div class="qca-presets" role="group" aria-label="Period">
                    <button type="button" class="qca-btn" data-preset="1">Today</button>
                    <button type="button" class="qca-btn" data-preset="7">7 days</button>
                    <button type="button" class="qca-btn" data-preset="30">30 days</button>
                </div>
            </div>
            <div class="qca-field qca-field--date">
                <label for="qcaFrom">From (IST)</label>
                <input type="date" id="qcaFrom" class="qca-date" />
            </div>
            <div class="qca-field qca-field--date">
                <label for="qcaTo">To (IST)</label>
                <input type="date" id="qcaTo" class="qca-date" />
            </div>
            <button type="button" class="qca-btn qca-btn--primary" id="qcaApply">Apply</button>
            <button type="button" class="qca-btn" id="qcaExport">Export CSV</button>
            @if (isManager)
            {
                <label class="qca-check"><input type="checkbox" id="qcaOnlyQc" checked /> Quality Controllers only</label>
            }
        </div>
        <p class="qca-hint">
            Range is capped at @maxRangeDays days.
            @if (isManager)
            {
                <text>Untick "Quality Controllers only" to include anyone else who took these actions (HR, Admin, etc.).</text>
            }
            else
            {
                <text>You see your own activity only.</text>
            }
        </p>
    </div>

    <div id="qcaAlert"></div>

    <div class="qca-backlog" id="qcaBacklog" aria-live="polite"></div>

    <div class="qca-tiles" id="qcaTiles"></div>

    <div class="qca-table-wrap">
        <table class="qca-table" id="qcaTable">
            <thead>
                <tr>
                    <th rowspan="2" class="qca-user-h">Quality Controller</th>
                    <th colspan="7" class="qca-group">Interview reports &amp; penalties</th>
                    <th colspan="2" class="qca-group">Trial interviews</th>
                    <th colspan="4" class="qca-group">IRF audit</th>
                    <th colspan="3" class="qca-group">Total Red Marker</th>
                    <th colspan="3" class="qca-group">Total Interviews</th>
                    <th colspan="5" class="qca-group">Interviewer status</th>
                    <th colspan="4" class="qca-group">Plivo calls</th>
                    <th rowspan="2" class="qca-group" style="vertical-align:middle" title="Coaching sessions logged or emailed (Interviewer QC View)">Coaching</th>
                    <th rowspan="2" class="qca-group" style="vertical-align:middle">Last action</th>
                </tr>
                <tr>
                    <th class="qca-group" title="Interviews whose Payment SLA the user saved (once per interview)">Reviewed</th>
                    <th title="Reviewed reports whose latest deduction by this user is above 0%">Penalised</th>
                    <th title="Average deduction across penalised reports">Avg %</th>
                    <th title="Payment SLA marked Approved">Approved</th>
                    <th title="Payment SLA marked Not approved">Not appr.</th>
                    <th title="QC forms filled (red flags in brackets)">QC forms</th>
                    <th title="Submitted reports whose interviewer comment the user changed">Edited</th>
                    <th class="qca-group">Kept</th>
                    <th>Removed</th>
                    <th class="qca-group" title="Distinct IRFs backfilled or decided">IRFs</th>
                    <th title="Audit backfill runs">Backfills</th>
                    <th>Kept</th>
                    <th>Removed</th>
                    <th class="qca-group">Under rev.</th>
                    <th>Reviewed</th>
                    <th>Removed</th>
                    <th class="qca-group">Under rev.</th>
                    <th>Reviewed</th>
                    <th>Removed</th>
                    <th class="qca-group" title="Interviewers marked suspicious (&#8634; = marks undone)">Suspicious</th>
                    <th title="Interviewers blocked (&#8634; = unblocked)">Blocked</th>
                    <th title="Portal access turned off (&#8634; = turned back on)">Access off</th>
                    <th title="Interviewers made inactive (&#8634; = made active again)">Inactive</th>
                    <th title="Payments put on hold (&#8634; = holds released)">Pay hold</th>
                    <th class="qca-group">Calls</th>
                    <th>Interviewers</th>
                    <th>Talk time</th>
                    <th title="Average over calls with talk-time data">Avg call</th>
                </tr>
            </thead>
            <tbody id="qcaBody">
                <tr><td colspan="31" class="qca-loading">Loading…</td></tr>
            </tbody>
        </table>
    </div>
</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="qca-modal" id="qcaModal" role="dialog" aria-modal="true" aria-labelledby="qcaModalTitle">
    <div class="qca-modal__box">
        <div class="qca-modal__head">
            <div>
                <h3 id="qcaModalTitle">Details</h3>
                <div class="qca-modal__sub" id="qcaModalSub"></div>
            </div>
            <button type="button" class="qca-btn" id="qcaModalClose">Close</button>
        </div>
        <div class="qca-modal__body" id="qcaModalBody"></div>
    </div>
</div>

<div class="qca-modal qca-modal--top" id="qcaEditModal" role="dialog" aria-modal="true" aria-labelledby="qcaEditTitle">
    <div class="qca-modal__box qca-modal__box--narrow">
        <div class="qca-modal__head">
            <div>
                <h3 id="qcaEditTitle">Report edit</h3>
                <div class="qca-modal__sub" id="qcaEditSub"></div>
            </div>
            <button type="button" class="qca-btn" id="qcaEditClose">Close</button>
        </div>
        <div class="qca-modal__body qca-edit-body" id="qcaEditBody"></div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        var root = document.getElementById('qcaRoot');
        var isManager = root.getAttribute('data-manager') === '1';
        var defaultDays = parseInt(root.getAttribute('data-default-days'), 10) || 7;
        var maxDays = parseInt(root.getAttribute('data-max-days'), 10) || 92;
        var tpl = {
            report: root.getAttribute('data-tpl-report'),
            transcript: root.getAttribute('data-tpl-transcript'),
            contradiction: root.getAttribute('data-tpl-contradiction'),
            qcmerge: root.getAttribute('data-tpl-qcmerge')
        };

        var state = { from: '', to: '', onlyQc: true, data: null };

        // ---------- helpers ----------
        function esc(v) {
            if (v === null || v === undefined) return '';
            return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function istToday() {
            return new Date(Date.now() + 330 * 60000).toISOString().slice(0, 10);
        }
        function addDays(ymd, days) {
            var p = ymd.split('-');
            var dt = new Date(Date.UTC(+p[0], +p[1] - 1, +p[2]));
            dt.setUTCDate(dt.getUTCDate() + days);
            return dt.toISOString().slice(0, 10);
        }
        function daysBetween(a, b) {
            var pa = a.split('-'), pb = b.split('-');
            return Math.round((Date.UTC(+pb[0], +pb[1] - 1, +pb[2]) - Date.UTC(+pa[0], +pa[1] - 1, +pa[2])) / 86400000);
        }
        // Server times are IST wall-clock ("2026-10-01T18:33:00"); show them as-is, no browser time-zone shift.
        function fmtIst(v) {
            if (!v) return '—';
            var s = String(v).replace('T', ' ');
            return s.length >= 16 ? s.slice(0, 16) : s;
        }
        function fmtDuration(sec) {
            if (sec === null || sec === undefined) return 'n/a';
            sec = Math.max(0, Math.round(sec));
            var h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
            if (h > 0) return h + 'h ' + (m < 10 ? '0' : '') + m + 'm';
            if (m > 0) return m + 'm ' + (s < 10 ? '0' : '') + s + 's';
            return s + 's';
        }
        function fmtTalk(sec) {
            if (!sec) return '0m';
            var h = Math.floor(sec / 3600), m = Math.round((sec % 3600) / 60);
            return h > 0 ? h + 'h ' + m + 'm' : m + 'm';
        }
        function num(v) { return v ? Number(v) : 0; }
        function fill(t, interviewId, irfId) {
            return t.replace('__INTERVIEW_ID__', encodeURIComponent(interviewId)).replace('__IRF_ID__', encodeURIComponent(irfId || 0));
        }
        function safeUrl(u) {
            return /^https?:\/\//i.test(u || '') ? u : null;
        }

        // A clickable number (opens the drill-down) or a grey zero.
        function cell(value, actor, metric, cls) {
            var v = num(value);
            var c = cls ? ' class="' + cls + '"' : '';
            if (v <= 0) return '<td' + c + '><span class="qca-zero">0</span></td>';
            return '<td' + c + '><button type="button" class="qca-num" data-actor="' + esc(actor) + '" data-metric="' + esc(metric) + '">' + v + '</button></td>';
        }

        // Interviewer status cell: the action count plus "↺ n" for its undos; opens the action-with-undo group.
        function statusCell(count, undo, actor, metric, cls) {
            var v = num(count), u = num(undo);
            var c = cls ? ' class="' + cls + '"' : '';
            if (v <= 0 && u <= 0) return '<td' + c + '><span class="qca-zero">0</span></td>';
            var title = v + ' action' + (v === 1 ? '' : 's') + (u > 0 ? ', ' + u + ' undone' : '');
            return '<td' + c + '><button type="button" class="qca-num" title="' + esc(title) + '" data-actor="' + esc(actor) + '" data-metric="' + esc(metric) + '">' + v +
                (u > 0 ? '<span class="qca-undo">↺ ' + u + '</span>' : '') + '</button></td>';
        }

        // ---------- filters ----------
        function readQuery() {
            var q = new URLSearchParams(window.location.search);
            var re = /^\d{4}-\d{2}-\d{2}$/;
            if (re.test(q.get('from') || '')) state.from = q.get('from');
            if (re.test(q.get('to') || '')) state.to = q.get('to');
            if (q.get('onlyQc') === 'false') state.onlyQc = false;
        }
        function writeQuery() {
            try {
                var q = new URLSearchParams();
                if (state.from) q.set('from', state.from);
                if (state.to) q.set('to', state.to);
                if (isManager && !state.onlyQc) q.set('onlyQc', 'false');
                history.replaceState(null, '', window.location.pathname + '?' + q.toString());
            } catch (e) { /* ignore */ }
        }
        function syncInputs() {
            $('#qcaFrom').val(state.from);
            $('#qcaTo').val(state.to);
            $('#qcaFrom, #qcaTo').attr('max', istToday());
            if (isManager) $('#qcaOnlyQc').prop('checked', state.onlyQc);
            var span = state.from && state.to ? daysBetween(state.from, state.to) + 1 : -1;
            var isToday = state.to === istToday();
            $('.qca-presets .qca-btn').each(function () {
                var p = parseInt($(this).attr('data-preset'), 10);
                $(this).toggleClass('is-active', isToday && span === p);
            });
        }
        function setPreset(days) {
            state.to = istToday();
            state.from = addDays(state.to, -(days - 1));
            load();
        }

        // ---------- summary ----------
        function load() {
            syncInputs();
            $('#qcaApply').prop('disabled', true);
            $('#qcaAlert').empty();
            $('#qcaBody').html('<tr><td colspan="31" class="qca-loading">Loading…</td></tr>');
            $.ajax({
                url: '/QCActivity/Summary',
                type: 'GET',
                cache: false,
                data: { from: state.from || null, to: state.to || null, onlyQc: isManager ? state.onlyQc : true },
                success: function (data) {
                    state.data = data || {};
                    state.from = state.data.fromIst || state.from;
                    state.to = state.data.toIst || state.to;
                    syncInputs();
                    writeQuery();
                    if (state.data.rangeWasCapped) {
                        $('#qcaAlert').html('<div class="qca-alert qca-alert--info">The range was cut to the last ' + maxDays + ' days of the period you picked.</div>');
                    }
                    if (state.data.error) {
                        $('#qcaAlert').append('<div class="qca-alert qca-alert--error">' + esc(state.data.error) + (state.data.errorDetail ? '<br/><small>' + esc(state.data.errorDetail) + '</small>' : '') + '</div>');
                    }
                    render();
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) { window.location.href = '/Session/SignOut'; return; }
                    $('#qcaAlert').html('<div class="qca-alert qca-alert--error">Could not load QC activity (' + esc(xhr.status) + '). Please try again.</div>');
                    $('#qcaBody').html('<tr><td colspan="31" class="qca-empty">No data.</td></tr>');
                },
                complete: function () { $('#qcaApply').prop('disabled', false); }
            });
        }

        function render() {
            var d = state.data || {};
            var rows = d.rows || [];
            var b = d.backlog || {};
            var t = d.totals || {};

            // Backlog strip (not date-filtered).
            $('#qcaBacklog').html(
                '<span class="qca-label">Open right now</span>' +
                '<a class="qca-pill" href="/Interview/PaymentSlaDetails" target="_blank" rel="noopener"><b>' + num(b.pendingReports) + '</b> reports awaiting QC (Payment SLA)</a>' +
                '<a class="qca-pill" href="/Dashboard/TrialFlagReview" target="_blank" rel="noopener"><b>' + num(b.pendingTrialFlags) + '</b> trial flags pending</a>' +
                '<a class="qca-pill" href="/Dashboard/AutoRemovalMonitor" target="_blank" rel="noopener"><b>' + num(b.pendingAuditInterviewers) + '</b> interviewers with pending audit flags</a>' +
                '<a class="qca-pill" href="/Dashboard/TotalRedMarkeredInterviewers?type=UnderReview" target="_blank" rel="noopener"><b>' + num(b.trmUnderReview) + '</b> Total Red Marker under review</a>');

            // Tiles.
            function tile(label, value, sub) {
                return '<div class="qca-tile"><div class="qca-tile__label">' + label + '</div><div class="qca-tile__value">' + value + '</div>' +
                    (sub ? '<div class="qca-tile__sub">' + sub + '</div>' : '') + '</div>';
            }
            $('#qcaTiles').html(
                tile('Reports reviewed', num(t.reportsReviewed), num(t.penaltiesApplied) + ' penalised') +
                tile('Reports edited', num(t.reportsEdited), 'interviewer comments changed') +
                tile('Trial interviewers removed', num(t.trialRemoved), num(t.trialKept) + ' kept') +
                tile('IRFs audited', num(t.auditIrfs), num(t.auditRemoved) + ' interviewers removed') +
                tile('Removed from Total Red Marker', num(t.trmRemoved), '') +
                tile('Removed from Total Interviews', num(t.tiRemoved), '') +
                tile('Interviewer status changes', num(t.statusChanges), '↺ ' + num(t.statusUndos) + ' undone') +
                tile('Plivo calls', num(t.plivoCalls), num(t.plivoInterviewers) + ' interviewers · ' + fmtTalk(num(t.plivoTalkSeconds))) +
                tile('Users with no activity', num(t.usersWithNoActivity), 'of ' + num(t.usersListed) + ' listed'));

            // Table, grouped by profile when more than one profile is listed.
            if (!rows.length) {
                $('#qcaBody').html('<tr><td colspan="31" class="qca-empty">No Quality Controllers or actions in this range.</td></tr>');
                return;
            }
            var groups = [];
            rows.forEach(function (r) {
                var g = r.profileName || 'Unknown';
                if (groups.indexOf(g) < 0) groups.push(g);
            });
            var html = '';
            groups.forEach(function (g) {
                if (groups.length > 1) html += '<tr class="qca-section"><td colspan="31">' + esc(g) + '</td></tr>';
                rows.filter(function (r) { return (r.profileName || 'Unknown') === g; }).forEach(function (r) {
                    var a = r.actorEmail;
                    var badge = num(r.totalActions) === 0 ? '<span class="qca-badge-none">No activity</span>' : '';
                    if (!r.isActive) badge += '<span class="qca-badge-inactive">Inactive</span>';
                    var avg = r.avgPenaltyPercent === null || r.avgPenaltyPercent === undefined ? '<span class="qca-zero">—</span>' : Math.round(r.avgPenaltyPercent) + '%';
                    var qcForms = num(r.qcForms) > 0
                        ? '<td><button type="button" class="qca-num" data-actor="' + esc(a) + '" data-metric="QCForm">' + num(r.qcForms) + '</button> <span class="qca-sub">(' + num(r.qcFormRedFlags) + ')</span></td>'
                        : '<td><span class="qca-zero">0</span></td>';
                    var irfs = num(r.auditIrfs) > 0 ? '<td class="qca-group">' + num(r.auditIrfs) + '</td>' : '<td class="qca-group"><span class="qca-zero">0</span></td>';
                    var talk = num(r.plivoCalls) > 0 ? '<td>' + fmtTalk(num(r.plivoTalkSeconds)) + '</td>' : '<td><span class="qca-zero">—</span></td>';
                    var avgCall = r.plivoAvgCallSeconds !== null && r.plivoAvgCallSeconds !== undefined ? '<td>' + fmtDuration(r.plivoAvgCallSeconds) + '</td>' : '<td><span class="qca-zero">—</span></td>';
                    var last = r.lastActionAtIst
                        ? '<td class="qca-group"><button type="button" class="qca-num" data-actor="' + esc(a) + '" data-metric="All">' + esc(fmtIst(r.lastActionAtIst)) + '</button></td>'
                        : '<td class="qca-group"><span class="qca-zero">—</span></td>';

                    html += '<tr>' +
                        '<td class="qca-user"><div class="qca-name">' + esc(r.actorName || a) + badge + '</div><div class="qca-email">' + esc(a) + '</div></td>' +
                        cell(r.reportsReviewed, a, 'ReportReviewed', 'qca-group') +
                        cell(r.penaltiesApplied, a, 'PenaltyApplied') +
                        '<td>' + avg + '</td>' +
                        cell(r.slaApproved, a, 'SlaApproved') +
                        cell(r.slaNotApproved, a, 'SlaNotApproved') +
                        qcForms +
                        cell(r.reportsEdited, a, 'ReportEdited') +
                        cell(r.trialKept, a, 'TrialKept', 'qca-group') +
                        cell(r.trialRemoved, a, 'TrialRemoved') +
                        irfs +
                        cell(r.auditBackfills, a, 'AuditBackfill') +
                        cell(r.auditKept, a, 'AuditKept') +
                        cell(r.auditRemoved, a, 'AuditRemoved') +
                        cell(r.trmUnderReview, a, 'TrmUnderReview', 'qca-group') +
                        cell(r.trmReviewed, a, 'TrmReviewed') +
                        cell(r.trmRemoved, a, 'TrmRemoved') +
                        cell(r.tiUnderReview, a, 'TiUnderReview', 'qca-group') +
                        cell(r.tiReviewed, a, 'TiReviewed') +
                        cell(r.tiRemoved, a, 'TiRemoved') +
                        statusCell(r.markedSuspicious, r.suspiciousUndone, a, 'SuspiciousAll', 'qca-group') +
                        statusCell(r.blocked, r.unblocked, a, 'BlockedAll') +
                        statusCell(r.accessRevoked, r.accessRestored, a, 'AccessAll') +
                        statusCell(r.inactivated, r.reactivated, a, 'ActiveAll') +
                        statusCell(r.paymentHolds, r.paymentHoldsReleased, a, 'PaymentHoldAll') +
                        cell(r.plivoCalls, a, 'PlivoCall', 'qca-group') +
                        '<td>' + (num(r.plivoInterviewers) > 0 ? num(r.plivoInterviewers) : '<span class="qca-zero">0</span>') + '</td>' +
                        talk + avgCall + cell(r.coachingSessions, a, 'Coaching', 'qca-group') + last +
                        '</tr>';
                });
            });
            $('#qcaBody').html(html);
        }

        // ---------- drill-down ----------
        var reportMetrics = ['ReportReviewed', 'PenaltyApplied', 'SlaApproved', 'SlaNotApproved', 'QCForm', 'ReportEdited'];
        // Interviewer status changes: the five actions, their undos, and the group keys that return both.
        var statusActionMetrics = ['Suspicious', 'Blocked', 'AccessRevoked', 'Inactivated', 'PaymentHold'];
        var statusUndoMetrics = ['SuspiciousUndone', 'Unblocked', 'AccessRestored', 'Reactivated', 'PaymentHoldReleased'];
        var statusGroupMetrics = ['StatusActions', 'SuspiciousAll', 'BlockedAll', 'AccessAll', 'ActiveAll', 'PaymentHoldAll'];
        function isStatusMetric(m) { return statusActionMetrics.indexOf(m) >= 0 || statusUndoMetrics.indexOf(m) >= 0; }
        var actionLabels = {
            ReportReviewed: 'Report reviewed', SlaApproved: 'SLA approved', SlaNotApproved: 'SLA not approved', QCForm: 'QC form',
            TrialKept: 'Trial kept', TrialRemoved: 'Trial removed', AuditBackfill: 'Audit backfill', AuditKept: 'Audit: kept',
            AuditRemoved: 'Audit: removed', TrmUnderReview: 'TRM: under review', TrmReviewed: 'TRM: reviewed', TrmRemoved: 'TRM: removed',
            TiUnderReview: 'Total Interviews: under review', TiReviewed: 'Total Interviews: reviewed', TiRemoved: 'Total Interviews: removed',
            PlivoCall: 'Plivo call', Coaching: 'Coaching session', ReportEdited: 'Report edited',
            Suspicious: 'Marked suspicious', SuspiciousUndone: 'Suspicious mark undone', Blocked: 'Blocked', Unblocked: 'Unblocked',
            AccessRevoked: 'Portal access turned off', AccessRestored: 'Portal access turned on', Inactivated: 'Made inactive',
            Reactivated: 'Made active', PaymentHold: 'Payment put on hold', PaymentHoldReleased: 'Payment hold released'
        };

        // Report text is stored HTML-encoded; decode it to plain text (a textarea never runs markup), then esc() it for the DOM.
        function decodeHtml(v) {
            if (v === null || v === undefined || v === '') return '';
            var t = document.createElement('textarea');
            t.innerHTML = String(v);
            return t.value;
        }
        function detailText(r) {
            return r.metric === 'ReportEdited' ? decodeHtml(r.detail) : (r.detail || '');
        }
        function editLink(r) {
            return r.refId ? '<br/><button type="button" class="qca-num qca-edit-link" data-edit-id="' + esc(r.refId) + '">View change</button>' : '';
        }

        function interviewerCell(r) {
            var name = r.interviewerName ? '<div>' + esc(r.interviewerName) + '</div>' : '';
            var mail = r.interviewerEmail ? '<div class="qca-small">' + esc(r.interviewerEmail) + '</div>' : '';
            return '<td>' + (name || mail ? name + mail : '<span class="qca-small">—</span>') + '</td>';
        }
        function interviewLinks(r) {
            if (!r.interviewId) return '<td><span class="qca-small">—</span></td>';
            var id = r.interviewId;
            return '<td>#' + esc(id) + '<br/>' +
                '<a href="' + esc(fill(tpl.report, id, r.irfId)) + '" target="_blank" rel="noopener">Report</a>' +
                '<a href="' + esc(fill(tpl.transcript, id, r.irfId)) + '" target="_blank" rel="noopener">Transcript</a>' +
                '<a href="' + esc(fill(tpl.contradiction, id, r.irfId)) + '" target="_blank" rel="noopener">Contradiction</a>' +
                '<a href="' + esc(fill(tpl.qcmerge, id, r.irfId)) + '" target="_blank" rel="noopener">QC Merge</a></td>';
        }
        function actionText(r) {
            var amt = r.amount === null || r.amount === undefined ? null : Number(r.amount);
            switch (r.metric) {
                case 'ReportReviewed':
                case 'SlaApproved':
                case 'SlaNotApproved':
                    var prefix = r.metric === 'ReportReviewed' ? '' : (r.metric === 'SlaApproved' ? 'Approved · ' : 'Not approved · ');
                    return amt > 0 ? '<span class="qca-penalty">' + prefix + 'Penalty ' + amt + '%</span>' : '<span class="qca-ok">' + prefix + 'No penalty</span>';
                case 'QCForm':
                    return amt > 0 ? '<span class="qca-penalty">' + amt + ' red flag' + (amt === 1 ? '' : 's') + '</span>' : '<span class="qca-ok">No red flags</span>';
                case 'TrialRemoved': case 'AuditRemoved': case 'TrmRemoved': case 'TiRemoved':
                    return '<span class="qca-penalty">' + esc(actionLabels[r.metric]) + '</span>';
                case 'ReportEdited':
                    return esc(r.status || actionLabels.ReportEdited) + editLink(r);
                case 'Suspicious': case 'Blocked': case 'AccessRevoked': case 'Inactivated': case 'PaymentHold':
                    return '<span class="qca-penalty">' + esc(actionLabels[r.metric]) + '</span>';
                case 'SuspiciousUndone': case 'Unblocked': case 'AccessRestored': case 'Reactivated': case 'PaymentHoldReleased':
                    return '<span class="qca-ok">↺ ' + esc(actionLabels[r.metric]) + '</span>';
                default:
                    return esc(actionLabels[r.metric] || r.metric);
            }
        }

        function renderReports(rows) {
            var h = '<table class="qca-dt"><thead><tr><th>When (IST)</th><th>Interviewer</th><th>IRF</th><th>Action</th><th>Detail</th><th>Interview</th></tr></thead><tbody>';
            rows.forEach(function (r) {
                h += '<tr><td>' + esc(fmtIst(r.actionAtIst)) + '</td>' + interviewerCell(r) +
                    '<td>' + esc(r.irfName || '—') + '</td><td>' + actionText(r) + '</td>' +
                    '<td class="qca-detail-text">' + esc(detailText(r) || '—') + '</td>' + interviewLinks(r) + '</tr>';
            });
            return h + '</tbody></table>';
        }

        // Status changes; the grouped keys (an action with its undo) also show the Type column.
        function renderStatus(rows, grouped) {
            var h = '<table class="qca-dt"><thead><tr><th>When (IST)</th>' + (grouped ? '<th>Type</th>' : '') +
                '<th>Interviewer</th><th>Detail</th></tr></thead><tbody>';
            rows.forEach(function (r) {
                h += '<tr><td>' + esc(fmtIst(r.actionAtIst)) + '</td>' + (grouped ? '<td>' + actionText(r) + '</td>' : '') +
                    interviewerCell(r) + '<td class="qca-detail-text">' + esc(detailText(r) || '—') + '</td></tr>';
            });
            return h + '</tbody></table>';
        }

        function renderCalls(rows) {
            var h = '<table class="qca-dt"><thead><tr><th>Called at (IST)</th><th>Interviewer</th><th>Phone</th><th>IRF</th><th>Talk time</th><th>Status</th><th>Recording</th></tr></thead><tbody>';
            rows.forEach(function (r) {
                var talk = r.amount === null || r.amount === undefined ? '<span class="qca-small">n/a</span>' : esc(fmtDuration(r.amount));
                var url = safeUrl(r.recordingUrl);
                var rec = url
                    ? '<audio controls preload="none" src="' + esc(url) + '"></audio> <a href="' + esc(url) + '" target="_blank" rel="noopener">Open</a>'
                    : '<span class="qca-small">—</span>';
                h += '<tr><td>' + esc(fmtIst(r.actionAtIst)) + '</td>' + interviewerCell(r) +
                    '<td>' + esc(r.phone || '—') + '</td><td>' + esc(r.irfName || '—') + '</td><td>' + talk + '</td>' +
                    '<td>' + esc(r.status || '—') + '</td><td>' + rec + '</td></tr>';
            });
            return h + '</tbody></table>';
        }

        function renderGeneric(rows) {
            var h = '<table class="qca-dt"><thead><tr><th>When (IST)</th><th>Action</th><th>Interviewer</th><th>IRF</th><th>Detail</th><th>Interview / recording</th></tr></thead><tbody>';
            rows.forEach(function (r) {
                var detail = detailText(r);
                // Status changes and report edits carry their action label in status: already shown as the action.
                if (r.status && r.metric !== 'PlivoCall' && r.metric !== 'ReportEdited' && !isStatusMetric(r.metric)) {
                    detail = detail ? detail + ' · ' + r.status : r.status;
                }
                if (r.metric === 'PlivoCall') {
                    detail = 'Talk time ' + (r.amount === null || r.amount === undefined ? 'n/a' : fmtDuration(r.amount)) + (r.status ? ' · ' + r.status : '');
                }
                var last;
                var url = safeUrl(r.recordingUrl);
                if (r.metric === 'PlivoCall' || r.metric === 'Coaching') {
                    last = url ? '<td><a href="' + esc(url) + '" target="_blank" rel="noopener">Recording</a></td>' : '<td><span class="qca-small">—</span></td>';
                } else {
                    last = interviewLinks(r);
                }
                h += '<tr><td>' + esc(fmtIst(r.actionAtIst)) + '</td><td>' + actionText(r) + '</td>' + interviewerCell(r) +
                    '<td>' + esc(r.irfName || (r.irfId ? '#' + r.irfId : '—')) + '</td>' +
                    '<td class="qca-detail-text">' + esc(detail || '—') + '</td>' + last + '</tr>';
            });
            return h + '</tbody></table>';
        }

        function openModal() { $('#qcaModal').addClass('is-open'); $('body').css('overflow', 'hidden'); }
        function closeModal() { $('#qcaModal').removeClass('is-open'); $('body').css('overflow', ''); }

        function openDetails(actor, metric) {
            $('#qcaModalTitle').text('Loading…');
            $('#qcaModalSub').text(actor + ' · ' + state.from + ' to ' + state.to + ' (IST)');
            $('#qcaModalBody').html('<div class="qca-loading">Loading…</div>');
            openModal();
            $.ajax({
                url: '/QCActivity/Details',
                type: 'GET',
                cache: false,
                data: { actor: actor, metric: metric, from: state.from, to: state.to },
                success: function (res) {
                    res = res || {};
                    var rows = res.rows || [];
                    $('#qcaModalTitle').text(res.metricLabel || metric);
                    $('#qcaModalSub').text((res.actorEmail || actor) + ' · ' + (res.fromIst || state.from) + ' to ' + (res.toIst || state.to) +
                        ' (IST) · ' + rows.length + ' record' + (rows.length === 1 ? '' : 's') + (res.truncated ? ' (first ' + rows.length + ' only, narrow the range to see all)' : ''));
                    if (res.error) {
                        $('#qcaModalBody').html('<div class="qca-alert qca-alert--error" style="margin:12px">' + esc(res.error) + (res.errorDetail ? '<br/><small>' + esc(res.errorDetail) + '</small>' : '') + '</div>');
                        return;
                    }
                    if (!rows.length) {
                        $('#qcaModalBody').html('<div class="qca-empty">No records.</div>');
                        return;
                    }
                    var m = res.metric || metric;
                    var html = reportMetrics.indexOf(m) >= 0 ? renderReports(rows)
                        : m === 'PlivoCall' ? renderCalls(rows)
                        : statusGroupMetrics.indexOf(m) >= 0 ? renderStatus(rows, true)
                        : isStatusMetric(m) ? renderStatus(rows, false)
                        : renderGeneric(rows);
                    $('#qcaModalBody').html(html);
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) { window.location.href = '/Session/SignOut'; return; }
                    $('#qcaModalTitle').text('Details');
                    $('#qcaModalBody').html('<div class="qca-alert qca-alert--error" style="margin:12px">Could not load the records (' + esc(xhr.status) + ').</div>');
                }
            });
        }

        // ---------- report edit: before / after ----------
        var maxDiffPairs = 4000000;

        // Word-level diff (whitespace kept as its own token). Returns [{ k: '=' | '-' | '+', t: text }],
        // or null when the changed middle is over maxDiffPairs word pairs (both texts are then shown as they are).
        function wordDiff(a, b) {
            var x = String(a || '').match(/\s+|[^\s]+/g) || [];
            var y = String(b || '').match(/\s+|[^\s]+/g) || [];
            var pre = 0;
            while (pre < x.length && pre < y.length && x[pre] === y[pre]) pre++;
            var suf = 0;
            while (suf < x.length - pre && suf < y.length - pre && x[x.length - 1 - suf] === y[y.length - 1 - suf]) suf++;
            var xs = x.slice(pre, x.length - suf), ys = y.slice(pre, y.length - suf);
            var n = xs.length, m = ys.length;
            if (n * m > maxDiffPairs) return null;

            // lcs[i * w + j] = longest common subsequence of xs[i..] and ys[j..].
            var w = m + 1, lcs = new Uint32Array((n + 1) * w), i, j;
            for (i = n - 1; i >= 0; i--) {
                for (j = m - 1; j >= 0; j--) {
                    lcs[i * w + j] = xs[i] === ys[j] ? lcs[(i + 1) * w + j + 1] + 1 : Math.max(lcs[(i + 1) * w + j], lcs[i * w + j + 1]);
                }
            }

            var out = [];
            function push(k, t) {
                if (out.length && out[out.length - 1].k === k) out[out.length - 1].t += t;
                else out.push({ k: k, t: t });
            }
            for (i = 0; i < pre; i++) push('=', x[i]);
            i = 0; j = 0;
            while (i < n && j < m) {
                if (xs[i] === ys[j]) { push('=', xs[i]); i++; j++; }
                else if (lcs[(i + 1) * w + j] >= lcs[i * w + j + 1]) { push('-', xs[i]); i++; }
                else { push('+', ys[j]); j++; }
            }
            while (i < n) push('-', xs[i++]);
            while (j < m) push('+', ys[j++]);
            for (i = x.length - suf; i < x.length; i++) push('=', x[i]);
            return out;
        }
        function renderDiff(parts) {
            return parts.map(function (p) {
                if (p.k === '-') return '<del class="qca-del">' + esc(p.t) + '</del>';
                if (p.k === '+') return '<ins class="qca-ins">' + esc(p.t) + '</ins>';
                return esc(p.t);
            }).join('');
        }

        function openEditModal() { $('#qcaEditModal').addClass('is-open'); $('body').css('overflow', 'hidden'); }
        function closeEditModal() {
            $('#qcaEditModal').removeClass('is-open');
            if (!$('#qcaModal').hasClass('is-open')) $('body').css('overflow', '');
        }

        function openReportEdit(id) {
            $('#qcaEditTitle').text('Loading…');
            $('#qcaEditSub').text('');
            $('#qcaEditBody').html('<div class="qca-loading">Loading…</div>');
            openEditModal();
            $.ajax({
                url: '/QCActivity/ReportEdit',
                type: 'GET',
                cache: false,
                data: { id: id },
                success: function (e) {
                    e = e || {};
                    if (e.error) {
                        $('#qcaEditTitle').text('Report edit');
                        $('#qcaEditBody').html('<div class="qca-alert qca-alert--error">' + esc(e.error) + '</div>');
                        return;
                    }
                    var before = decodeHtml(e.oldValue), after = decodeHtml(e.newValue);
                    var field = e.fieldName === 'InterviewerComment' ? 'Interviewer comment' : (e.fieldName || 'Report');
                    $('#qcaEditTitle').text(field + ' edited');
                    $('#qcaEditSub').text([
                        'By ' + (e.editorName ? e.editorName + ' (' + (e.editedBy || '') + ')' : (e.editedBy || 'unknown')),
                        fmtIst(e.editedAtIst) + ' IST',
                        e.interviewerName || e.interviewerEmail ? 'Interviewer ' + (e.interviewerName || e.interviewerEmail) : '',
                        e.irfName ? 'IRF ' + e.irfName : '',
                        e.interviewId ? 'Interview #' + e.interviewId : ''
                    ].filter(Boolean).join(' · '));

                    var parts = wordDiff(before, after);
                    var diff = parts
                        ? '<div class="qca-diff">' + (renderDiff(parts) || '<span class="qca-sub">(empty)</span>') + '</div>'
                        : '<div class="qca-alert qca-alert--info">The texts are too long to compare word by word; both are shown in full below.</div>';
                    var open = e.interviewId
                        ? '<div class="qca-edit-actions"><a href="' + esc(fill(tpl.report, e.interviewId, e.irfId)) + '" target="_blank" rel="noopener">Open report</a></div>'
                        : '';
                    $('#qcaEditBody').html(open +
                        '<h4>Changes <span class="qca-sub">(removed words in red, added words in green)</span></h4>' + diff +
                        '<div class="qca-edit-cols">' +
                        '<div><h4>Before (' + before.length + ' chars)</h4><div class="qca-diff">' + (before ? esc(before) : '<span class="qca-sub">(empty)</span>') + '</div></div>' +
                        '<div><h4>After (' + after.length + ' chars)</h4><div class="qca-diff">' + (after ? esc(after) : '<span class="qca-sub">(empty)</span>') + '</div></div>' +
                        '</div>');
                },
                error: function (xhr) {
                    if (xhr.status === 401 || xhr.status === 403) { window.location.href = '/Session/SignOut'; return; }
                    $('#qcaEditTitle').text('Report edit');
                    $('#qcaEditBody').html('<div class="qca-alert qca-alert--error">Could not load the edit (' + esc(xhr.status) + ').</div>');
                }
            });
        }

        // ---------- CSV ----------
        function csvCell(v) {
            if (v === null || v === undefined) return '';
            var s = String(v);
            if (/^[=+\-@@]/.test(s)) s = "'" + s; // keep spreadsheet formulas out (Razor writes the doubled at-sign as one)
            return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
        }
        function exportCsv() {
            var rows = (state.data && state.data.rows) || [];
            var cols = [
                ['Name', 'actorName'], ['Email', 'actorEmail'], ['Profile', 'profileName'],
                ['Reports reviewed', 'reportsReviewed'], ['Penalised', 'penaltiesApplied'], ['Avg penalty %', 'avgPenaltyPercent'],
                ['SLA approved', 'slaApproved'], ['SLA not approved', 'slaNotApproved'], ['QC forms', 'qcForms'], ['QC form red flags', 'qcFormRedFlags'],
                ['Reports edited', 'reportsEdited'],
                ['Trial kept', 'trialKept'], ['Trial removed', 'trialRemoved'],
                ['Audit IRFs', 'auditIrfs'], ['Audit backfills', 'auditBackfills'], ['Audit kept', 'auditKept'], ['Audit removed', 'auditRemoved'],
                ['TRM under review', 'trmUnderReview'], ['TRM reviewed', 'trmReviewed'], ['TRM removed', 'trmRemoved'],
                ['Total Interviews under review', 'tiUnderReview'], ['Total Interviews reviewed', 'tiReviewed'], ['Total Interviews removed', 'tiRemoved'],
                ['Marked suspicious', 'markedSuspicious'], ['Suspicious undone', 'suspiciousUndone'],
                ['Blocked', 'blocked'], ['Unblocked', 'unblocked'],
                ['Access revoked', 'accessRevoked'], ['Access restored', 'accessRestored'],
                ['Inactivated', 'inactivated'], ['Reactivated', 'reactivated'],
                ['Payment holds', 'paymentHolds'], ['Payment holds released', 'paymentHoldsReleased'],
                ['Plivo calls', 'plivoCalls'], ['Plivo interviewers', 'plivoInterviewers'], ['Plivo talk seconds', 'plivoTalkSeconds'], ['Plivo avg call seconds', 'plivoAvgCallSeconds'], ['Coaching sessions', 'coachingSessions'],
                ['Total actions', 'totalActions'], ['Last action (IST)', 'lastActionAtIst']
            ];
            var lines = [cols.map(function (c) { return csvCell(c[0]); }).join(',')];
            rows.forEach(function (r) {
                lines.push(cols.map(function (c) {
                    var v = r[c[1]];
                    if (c[1] === 'lastActionAtIst' && v) v = fmtIst(v);
                    return csvCell(v);
                }).join(','));
            });
            var blob = new Blob([String.fromCharCode(0xFEFF) + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'qc-activity_' + state.from + '_to_' + state.to + '.csv';
            document.body.appendChild(a);
            a.click();
            setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
        }

        // ---------- wiring ----------
        $(document).on('click', '.qca-presets .qca-btn', function () {
            setPreset(parseInt($(this).attr('data-preset'), 10) || defaultDays);
        });
        $('#qcaApply').on('click', function () {
            var f = $('#qcaFrom').val(), t = $('#qcaTo').val();
            if (f && t && f > t) { var x = f; f = t; t = x; }
            if (f && t && daysBetween(f, t) + 1 > maxDays) f = addDays(t, -(maxDays - 1));
            state.from = f || '';
            state.to = t || '';
            if (isManager) state.onlyQc = $('#qcaOnlyQc').is(':checked');
            load();
        });
        $('#qcaOnlyQc').on('change', function () {
            state.onlyQc = $(this).is(':checked');
            load();
        });
        $('#qcaExport').on('click', exportCsv);
        $(document).on('click', '#qcaTable .qca-num', function () {
            openDetails($(this).attr('data-actor'), $(this).attr('data-metric'));
        });
        $(document).on('click', '#qcaModalBody .qca-edit-link', function () {
            openReportEdit($(this).attr('data-edit-id'));
        });
        $('#qcaModalClose').on('click', closeModal);
        $('#qcaModal').on('click', function (e) { if (e.target === this) closeModal(); });
        $('#qcaEditClose').on('click', closeEditModal);
        $('#qcaEditModal').on('click', function (e) { if (e.target === this) closeEditModal(); });
        // Escape closes the top-most dialog first.
        $(document).on('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if ($('#qcaEditModal').hasClass('is-open')) closeEditModal(); else closeModal();
        });

        readQuery();
        if (!state.to) state.to = istToday();
        if (!state.from) state.from = addDays(state.to, -(defaultDays - 1));
        load();
    })();
</script>
