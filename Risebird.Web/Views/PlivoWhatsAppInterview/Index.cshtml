@model List<Risebird.Entities.ViewModel.PlivoWhatsAppLogDetailVM>
@{
    ViewData["Title"] = "Plivo WhatsApp Interview Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int page        = ViewBag.Page        != null ? (int)ViewBag.Page        : 1;
    int pageSize    = ViewBag.PageSize    != null ? (int)ViewBag.PageSize    : 50;
    int totalCount  = ViewBag.TotalCount  != null ? (int)ViewBag.TotalCount  : 0;
    int totalPages  = ViewBag.TotalPages  != null ? (int)ViewBag.TotalPages  : 1;
    string selStatus      = ViewBag.Status      as string ?? string.Empty;
    string selPurpose     = ViewBag.Purpose     as string ?? string.Empty;
    string selMeeting     = ViewBag.Meeting     as string ?? string.Empty;
    string selDisposition = ViewBag.Disposition as string ?? string.Empty;

    var first        = Model.FirstOrDefault();
    int totalReplied = first?.OverallReplied        ?? 0;
    int totalMeeting = first?.OverallMeetingCreated ?? 0;
    int totalFailed  = first?.OverallFailed         ?? 0;
    double rate      = totalCount > 0 ? Math.Round((double)totalMeeting / totalCount * 100, 1) : 0;

    string pageUrl(int p, int ps = 0)
    {
        var ps2 = ps > 0 ? ps : pageSize;
        var q   = $"?page={p}&pageSize={ps2}";
        if (!string.IsNullOrEmpty(selStatus))      q += $"&status={Uri.EscapeDataString(selStatus)}";
        if (!string.IsNullOrEmpty(selPurpose))     q += $"&purpose={Uri.EscapeDataString(selPurpose)}";
        if (!string.IsNullOrEmpty(selMeeting))     q += $"&meeting={Uri.EscapeDataString(selMeeting)}";
        if (!string.IsNullOrEmpty(selDisposition)) q += $"&disposition={Uri.EscapeDataString(selDisposition)}";
        return Url.Action("Index", "PlivoWhatsAppInterview") + q;
    }
}

<style>
    #msgTable .badge { width: auto; font-size: 11px !important; padding: 0.35em 0.65em; font-weight: 500; }
    .wa-stat .stat-value { font-size: 1.5rem; font-weight: 700; }
    .wa-stat .stat-label  { font-size: 13px; font-weight: 500; color: #495057; }
    .cx-filter-control { min-height: 30px; font-size: 12.7px !important; }
    .cx-filter-control.form-select { min-width: 150px; }
    .cx-value-yes { display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:500;color:#198754; }
    .cx-value-no  { display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:500;color:#dc3545; }
    .bg-success { --bs-bg-opacity:1; background-color:rgb(31 160 100/85%)!important; font-size:10px!important; }
    .bg-secondary { --bs-bg-opacity:1; background-color:rgb(112 118 124/83%)!important; }
    .bg-warning  { --bs-bg-opacity:1; background-color:rgb(241 198 70/66%)!important; border:0; font-size:11px!important; }
    .table>thead>tr>th { font-size:13px; }
    .btn.btn-sm { font-size:11px; padding:3px 5px; background:#d4cece85; }
    .cx-meeting-confirmed { background:#d4edda!important;color:#155724;font-size:12px;border:1px solid #c3e6cb; }
</style>

<div class="main-panel" id="main-panel">
<div class="pt30">
<div class="content client">
<div class="container-fluid py-4">

    <!-- Header -->
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h4 class="fw-bold mb-0">
                <i class="fab fa-whatsapp text-success me-2"></i>Plivo WhatsApp Interview Logs
            </h4>
            <p class="text-muted mb-0 mt-1">
                Outbound scheduling &amp; rescheduling via
                <a href="https://cx.plivo.com" target="_blank">Plivo CX WhatsApp</a>.
            </p>
        </div>
        <div class="col-auto d-flex gap-2 flex-wrap">
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#scheduleModal">
                <i class="fas fa-calendar-plus me-1"></i>New Schedule Message
            </button>
            <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#rescheduleModal">
                <i class="fas fa-calendar-alt me-1"></i>New Reschedule Message
            </button>
            <a asp-action="WebhookInfo" class="btn btn-outline-info" target="_blank">
                <i class="fas fa-stethoscope me-1"></i>Webhook Info
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 wa-stat">
                <div class="stat-value text-primary">@totalCount</div>
                <div class="stat-label">Total Sent</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 wa-stat">
                <div class="stat-value text-success">@totalReplied</div>
                <div class="stat-label">Completed</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 wa-stat">
                <div class="stat-value text-info">@totalMeeting</div>
                <div class="stat-label">Meeting Created</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 wa-stat">
                <div class="stat-value text-danger">@totalFailed</div>
                <div class="stat-label">Failed / Trigger Failed</div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-2">
            <div class="card border-0 shadow-sm text-center py-3 wa-stat">
                <div class="stat-value text-warning">@rate%</div>
                <div class="stat-label">Conversion Rate</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" asp-action="Index" id="filterForm">
        <input type="hidden" name="page"     value="1" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-center">
                    <div class="col-auto">
                        <select name="status" class="form-select cx-filter-control" onchange="this.form.submit()">
                            <option value="">All statuses</option>
                            @foreach (var s in new[] { "initiated","triggered","trigger-failed","completed" })
                            {
                                if (selStatus == s) { <option value="@s" selected>@s</option> }
                                else                { <option value="@s">@s</option> }
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select name="purpose" class="form-select cx-filter-control" onchange="this.form.submit()">
                            <option value="">All purposes</option>
                            @if (selPurpose == "schedule")   { <option value="schedule"   selected>Schedule</option>   } else { <option value="schedule">Schedule</option>   }
                            @if (selPurpose == "reschedule") { <option value="reschedule" selected>Reschedule</option> } else { <option value="reschedule">Reschedule</option> }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select name="meeting" class="form-select cx-filter-control" onchange="this.form.submit()">
                            <option value="">All meetings</option>
                            @if (selMeeting == "YES") { <option value="YES" selected>Meeting Created</option> } else { <option value="YES">Meeting Created</option> }
                            @if (selMeeting == "NO")  { <option value="NO"  selected>No Meeting</option>      } else { <option value="NO">No Meeting</option>      }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select name="disposition" class="form-select cx-filter-control" onchange="this.form.submit()">
                            <option value="">All dispositions</option>
                            @if (selDisposition == "interested")   { <option value="interested"   selected>Interested</option>   } else { <option value="interested">Interested</option>   }
                            @if (selDisposition == "uninterested") { <option value="uninterested" selected>Uninterested</option> } else { <option value="uninterested">Uninterested</option> }
                            @if (selDisposition == "cant_say")     { <option value="cant_say"     selected>Can't Say</option>    } else { <option value="cant_say">Can't Say</option>    }
                        </select>
                    </div>
                    <div class="col-auto ms-auto">
                        <span class="text-muted small">@totalCount rows (page @(page) of @totalPages)</span>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0 align-middle" id="msgTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Candidate</th>
                            <th>Phone</th>
                            <th>IRF / Role</th>
                            <th>Purpose</th>
                            <th>Status</th>
                            <th>Disposition</th>
                            <th>AI Booked</th>
                            <th>Booking API</th>
                            <th>Meeting Created</th>
                            <th>Meeting Date</th>
                            <th>Meeting Status</th>
                            <th>Sent At</th>
                            <th>Triggered By</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var statusBadge = r.Status switch
                            {
                                "completed"     => "bg-success",
                                "triggered"     => "bg-info",
                                "initiated"     => "bg-secondary",
                                "trigger-failed" => "bg-danger",
                                _               => "bg-light text-dark border"
                            };
                            var purposeBadge = r.MessagePurpose == "reschedule" ? "bg-warning text-dark" : "bg-success";
                            var dispBadge    = r.CandidateDisposition switch
                            {
                                "interested"   => "bg-success",
                                "uninterested" => "bg-danger",
                                "cant_say"     => "bg-secondary",
                                _              => "bg-light text-dark border"
                            };
                            var bookingBadge = r.BookingApiSuccess ? "bg-success" : (r.AIReportedBooked ? "bg-danger" : "bg-light text-dark border");
                            var confirmLabel = r.MeetingConfirmationStatus switch
                            {
                                "1" => "Confirmed",
                                "2" => "Cancelled",
                                "0" => "Pending",
                                _   => r.MeetingConfirmationStatus ?? "—"
                            };

                            <tr>
                                <td class="ps-3 text-muted small">@r.LogId</td>
                                <td>
                                    <div class="fw-semibold">@(r.CandidateName ?? "—")</div>
                                    <small class="text-muted">@(r.CandidateEmail ?? "—")</small>
                                </td>
                                <td class="small">@(r.RecipientPhone ?? "—")</td>
                                <td>
                                    <div class="small fw-semibold">@(r.IRFId ?? "—")</div>
                                    <small class="text-muted" title="@r.JDTiltle">
                                        @(r.JDTiltle?.Length > 22 ? r.JDTiltle.Substring(0, 22) + "…" : r.JDTiltle ?? "—")
                                    </small>
                                </td>
                                <td><span class="badge @purposeBadge">@(r.MessagePurpose ?? "schedule")</span></td>
                                <td>
                                    <span class="badge @statusBadge">@(r.Status ?? "—")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.CandidateDisposition))
                                    {
                                        <span class="badge @dispBadge">@r.CandidateDisposition</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (r.AIReportedBooked)
                                    {
                                        <span class="cx-value-yes"><i class="fas fa-check"></i> Yes</span>
                                        <br /><small class="text-muted">@r.AIReportedInterviewDate @r.AIReportedInterviewTime</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (r.AIReportedBooked)
                                    {
                                        <span class="badge @bookingBadge">@(r.BookingApiSuccess ? "OK" : "Failed")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.MeetingCreated == "YES")
                                    {
                                        <span class="cx-value-yes"><i class="fas fa-check"></i> Yes</span>
                                    }
                                    else
                                    {
                                        <span class="cx-value-no"><i class="fas fa-times"></i> No</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (r.MeetingScheduledAt.HasValue)
                                    {
                                        @r.MeetingScheduledAt.Value.ToString("dd MMM yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (r.MeetingId.HasValue)
                                    {
                                        <span class="badge @(r.MeetingConfirmationStatus == "1" ? "cx-meeting-confirmed" : r.MeetingConfirmationStatus == "2" ? "bg-danger" : "bg-warning text-dark")">
                                            @confirmLabel
                                        </span>
                                        if (r.IsAutoCancelled == true)
                                        {
                                            <br /><small class="text-danger">Auto-cancelled</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small">@r.MessageSentAt.ToString("dd MMM HH:mm")</td>
                                <td class="small text-muted">@(r.TriggeredBy?.Replace("PlivoWhatsApp", "WA"))</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm" onclick="showDetail(@r.LogId)" title="View details">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted py-5">
                                    <i class="fab fa-whatsapp fa-2x mb-2 d-block"></i>
                                    No WhatsApp logs yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center flex-wrap">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@pageUrl(page - 1)">«</a>
                </li>
                @for (int p = Math.Max(1, page - 3); p <= Math.Min(totalPages, page + 3); p++)
                {
                    <li class="page-item @(p == page ? "active" : "")">
                        <a class="page-link" href="@pageUrl(p)">@p</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@pageUrl(page + 1)">»</a>
                </li>
            </ul>
        </nav>
    }

</div></div></div></div>

<!-- ── Schedule Message Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="scheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fab fa-whatsapp me-2 text-success"></i>Initiate Schedule Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="InitiateScheduleMessage" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Candidate Name</label>
                        <input type="text" name="recipientName" class="form-control" placeholder="Full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">WhatsApp Number <span class="text-danger">*</span></label>
                        <input type="text" name="recipientPhone" class="form-control" required placeholder="+91XXXXXXXXXX" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="recipientEmail" class="form-control" placeholder="candidate@email.com" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold">IRF ID</label>
                            <input type="number" name="irfId" class="form-control" placeholder="12345" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Candidate ID</label>
                            <input type="number" name="candidateId" class="form-control" placeholder="optional" />
                        </div>
                    </div>
                    <div class="mb-3 mt-2">
                        <label class="form-label fw-semibold">Job Title</label>
                        <input type="text" name="jobTitle" class="form-control" placeholder="optional" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Client Name</label>
                        <input type="text" name="clientName" class="form-control" placeholder="optional" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fab fa-whatsapp me-1"></i>Send Message</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Reschedule Message Modal ────────────────────────────────────────── -->
<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-calendar-alt me-2 text-warning"></i>Initiate Reschedule Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="InitiateRescheduleMessage" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Candidate Name</label>
                        <input type="text" name="recipientName" class="form-control" placeholder="Full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">WhatsApp Number <span class="text-danger">*</span></label>
                        <input type="text" name="recipientPhone" class="form-control" required placeholder="+91XXXXXXXXXX" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="recipientEmail" class="form-control" placeholder="candidate@email.com" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold">IRF ID</label>
                            <input type="number" name="irfId" class="form-control" placeholder="12345" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Candidate ID</label>
                            <input type="number" name="candidateId" class="form-control" placeholder="optional" />
                        </div>
                    </div>
                    <div class="mb-3 mt-2">
                        <label class="form-label fw-semibold">Original Interview Date <small class="text-muted">(for AI context)</small></label>
                        <input type="text" name="originalInterviewDate" class="form-control" placeholder="e.g. 07 Mar 2026" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="fab fa-whatsapp me-1"></i>Send Reschedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Detail Modal ────────────────────────────────────────────────────── -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-search me-2"></i>WhatsApp Detail — <span id="detailTitle"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailBody">
                <div class="text-center py-4"><div class="spinner-border text-success"></div></div>
            </div>
        </div>
    </div>
</div>

@{
    var jsonData = System.Text.Json.JsonSerializer.Serialize(Model.Select(r => new
    {
        r.LogId,
        r.CandidateName,
        r.CandidateEmail,
        r.RecipientPhone,
        r.IRFId,
        r.JDTiltle,
        r.ClientName,
        r.TriggeredBy,
        r.MessagePurpose,
        r.Status,
        r.MessageStatus,
        r.CandidateDisposition,
        r.PlivoCXConversationId,
        r.OriginalInterviewDate,
        MessageSentAt           = r.MessageSentAt.ToString("dd MMM yyyy HH:mm"),
        ConversationEndedAt     = r.ConversationEndedAt?.ToString("dd MMM yyyy HH:mm"),
        r.AIReportedBooked,
        r.AIReportedInterviewDate,
        r.AIReportedInterviewTime,
        r.ConversationTranscript,
        r.ConversationSummary,
        r.InterviewBooked,
        r.BookingApiSuccess,
        r.BookingApiResponse,
        r.BookedInterviewDate,
        r.BookedInterviewTime,
        BookedInterviewDateTime = r.BookedInterviewDateTime?.ToString("dd MMM yyyy HH:mm"),
        r.MeetingCreated,
        r.MeetingId,
        MeetingScheduledAt      = r.MeetingScheduledAt?.ToString("dd MMM yyyy HH:mm"),
        r.InterviewSlot,
        r.InterviewDuration,
        r.MeetingConfirmationStatus,
        r.Interviewer,
        r.RisebirdHR,
        r.ClientHrContact,
        r.IsAutoCancelled,
        r.CancellationReason,
        r.IsCandidateResponsed,
        r.CandidateResponse,
        MeetingCreatedOn        = r.MeetingCreatedOn?.ToString("dd MMM yyyy HH:mm")
    }));
}

@section Scripts {
<script>
    var allRows = @Html.Raw(jsonData);

    function showDetail(id) {
        var r = allRows.find(function(x) { return x.logId === id; });
        if (!r) return;
        document.getElementById('detailTitle').textContent = (r.candidateName || '—') + ' (' + (r.candidateEmail || '—') + ')';

        var conf = { '1': 'Confirmed', '2': 'Cancelled', '0': 'Pending' };
        var html = '<div class="row g-3">';

        // Message info
        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fab fa-whatsapp me-2 text-success"></i>Message Info</h6>';
        html += row('Log ID',          r.logId);
        html += row('Purpose',         badge(r.messagePurpose, r.messagePurpose === 'reschedule' ? 'warning' : 'success'));
        html += row('Status',          badge(r.status, statusColour(r.status)));
        html += row('Sent At',         r.messageSentAt || '—');
        html += row('Ended At',        r.conversationEndedAt || '—');
        html += row('Conversation ID', r.plivoCXConversationId || '—');
        html += row('Triggered By',    r.triggeredBy || '—');
        html += row('Original Date',   r.originalInterviewDate || '—');
        html += '</div></div></div>';

        // Candidate
        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-user me-2 text-info"></i>Candidate</h6>';
        html += row('Name',        r.candidateName || '—');
        html += row('Email',       r.candidateEmail || '—');
        html += row('Phone',       r.recipientPhone || '—');
        html += row('IRF',         (r.irfId || '—') + ' — ' + (r.jdTiltle || ''));
        html += row('Client',      r.clientName || '—');
        html += row('Disposition', badge(r.candidateDisposition || '—', dispColour(r.candidateDisposition)));
        html += '</div></div></div>';

        // AI extraction
        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-robot me-2 text-primary"></i>AI Extraction</h6>';
        html += row('AI Reported Booked', badge(r.aIReportedBooked ? 'YES' : 'NO', r.aIReportedBooked ? 'success' : 'secondary'));
        html += row('Interview Date',     r.aIReportedInterviewDate || '—');
        html += row('Interview Time',     r.aIReportedInterviewTime || '—');
        html += '</div></div></div>';

        // Booking
        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-calendar-check me-2 text-success"></i>Booking</h6>';
        html += row('Interview Booked', badge(r.interviewBooked ? 'YES' : 'NO', r.interviewBooked ? 'success' : 'secondary'));
        html += row('Booked Date',      r.bookedInterviewDate || '—');
        html += row('Booked Time',      r.bookedInterviewTime || '—');
        html += row('DateTime',         r.bookedInterviewDateTime || '—');
        html += row('API Success',      badge(r.bookingApiSuccess ? 'YES' : 'NO', r.bookingApiSuccess ? 'success' : 'danger'));
        html += row('API Response',     '<small class="text-muted font-monospace" style="word-break:break-all">' + (r.bookingApiResponse || '—') + '</small>');
        html += '</div></div></div>';

        // Meeting
        html += '<div class="col-md-6"><div class="card border-0 bg-light h-100"><div class="card-body">';
        html += '<h6 class="fw-bold mb-3"><i class="fas fa-calendar me-2 text-warning"></i>Interview Meeting</h6>';
        html += row('Meeting Created', badge(r.meetingCreated, r.meetingCreated === 'YES' ? 'success' : 'secondary'));
        html += row('Meeting ID',      r.meetingId || '—');
        html += row('Scheduled At',    r.meetingScheduledAt || '—');
        html += row('Slot',            r.interviewSlot || '—');
        html += row('Duration',        r.interviewDuration ? r.interviewDuration + ' min' : '—');
        html += row('Confirmation',    badge(conf[r.meetingConfirmationStatus] || r.meetingConfirmationStatus || '—',
                                            r.meetingConfirmationStatus === '1' ? 'success' : r.meetingConfirmationStatus === '2' ? 'danger' : 'warning'));
        html += row('Interviewer',     r.interviewer || '—');
        html += row('Risebird HR',     r.risebirdHR  || '—');
        html += row('Auto-Cancelled',  r.isAutoCancelled ? badge('YES', 'danger') : 'No');
        html += row('Cancel Reason',   r.cancellationReason || '—');
        html += row('Meeting Created On', r.meetingCreatedOn || '—');
        html += '</div></div></div>';

        // Conversation summary
        if (r.conversationSummary) {
            html += '<div class="col-12"><div class="card border-0 bg-light"><div class="card-body">';
            html += '<h6 class="fw-bold mb-2"><i class="fas fa-align-left me-2 text-secondary"></i>Conversation Summary</h6>';
            html += '<pre class="mb-0" style="white-space:pre-wrap;font-size:0.85rem;max-height:200px;overflow-y:auto">' + escHtml(r.conversationSummary) + '</pre>';
            html += '</div></div></div>';
        }

        // Transcript
        if (r.conversationTranscript) {
            html += '<div class="col-12"><div class="card border-0 bg-light"><div class="card-body">';
            html += '<h6 class="fw-bold mb-2"><i class="fas fa-file-alt me-2 text-secondary"></i>Conversation Transcript</h6>';
            html += '<pre class="mb-0" style="white-space:pre-wrap;font-size:0.82rem;max-height:300px;overflow-y:auto">' + escHtml(r.conversationTranscript) + '</pre>';
            html += '</div></div></div>';
        }

        html += '</div>';
        document.getElementById('detailBody').innerHTML = html;
        new bootstrap.Modal(document.getElementById('detailModal')).show();
    }

    function row(label, value) {
        return '<div class="d-flex justify-content-between mb-1 small">' +
            '<span class="text-muted">' + label + '</span>' +
            '<span class="text-end" style="max-width:60%">' + (value ?? '—') + '</span></div>';
    }
    function badge(text, colour) { return '<span class="badge bg-' + colour + '">' + text + '</span>'; }
    function statusColour(s) {
        var m = { completed: 'success', triggered: 'info', initiated: 'secondary', 'trigger-failed': 'danger' };
        return m[s] || 'secondary';
    }
    function dispColour(d) {
        return d === 'interested' ? 'success' : d === 'uninterested' ? 'danger' : 'secondary';
    }
    function escHtml(t) {
        return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
</script>
}
