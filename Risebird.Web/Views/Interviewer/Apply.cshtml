<script>

    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("ResumeLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("File").value = '';

        }

    }

</script>

<script>
    function checkEmailidExist() {
        debugger;
        if (validateForm()) {
            var interviewer = $("#EmailId").val().trim();
            $.ajax({
                url: '/Interviewer/GetInterviwerExists',
                type: 'POST',
                async: false,
                data: { 'interviewer': interviewer },
                success: function (result) {
                    if (result) {
                        swal.fire(result);
                        return false;
                    }
                    else {
                        return true;
                    }
                }
            });
        }
        else {
            // Prevent form submission if validation fails
            alert("Validation failed.");
            return false;
        }
    }

    // Function to validate phone number and email
    function validateForm() {
        const phoneNumber = document.getElementById("Phone").value;
        const emailId = document.getElementById("EmailId").value;

        // Regular expression for 10-digit phone number without spaces or special characters
        const phoneRegex = /^[0-9]{10}$/;
        // Regular expression for valid email format
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        let isValid = true;

        // Validate phone number
        if (!phoneRegex.test(phoneNumber)) {
            alert("Please enter a valid 10-digit mobile number without spaces, country code, or special characters.");
            isValid = false;
        }

        // Validate email
        if (!emailRegex.test(emailId)) {
            alert("Please enter a valid email address.");
            isValid = false;
        }
        var fileInput = document.getElementById("ResumeFile");

        // Check if a file has been selected
        if (!(fileInput.files.length > 0)) {
            alert("Resume File not selected. Please choose a file to upload.");
            isValid = false;
        }

        return isValid;
    }
</script>
