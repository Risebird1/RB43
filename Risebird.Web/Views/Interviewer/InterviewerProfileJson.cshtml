
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.InterviewerProfileVM>
@using X.PagedList.Mvc.Core;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel

<div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
    <div class="col-md-12 nopad">
        <div class="table-responsive">
            <table id="interviewer" class="table table-striped table-bordered interviewertable" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th style="border-right: 0px !important;"></th>
                        <th id="start">First Name</th>
                        <th>Last Name</th>
                        <th class="interviewer_4">Email Id</th>
                        <th>Mobile No.</th>
                        <th class="interviewer_5">Insta Interviewer</th>
                        <th class="interviewer_6">Assessment Group</th>
                        <th class="interviewer_7">Resume Link</th>
                        <th class="interviewer_8">Coded Name</th>
                        <th>Available</th>
                        <th class="disabled-sorting text-center">Actions</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th style="border-right: 0px !important;"></th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email Id</th>
                        <th>Mobile No.</th>
                        <th>Insta Interviewer</th>
                        <th>Assessment Group</th>
                        <th>Resume Link</th>
                        <th>Coded Name</th>
                        <th>Available</th>
                        <th class="disabled-sorting text-center">Actions</th>
                    </tr>
                </tfoot>
                <tbody id="tblbodyInterviewerProfile">
                    @foreach (var item in Model)
                    {
                        <tr id=@item.id data-changes="1">
                            <td style="width:10px;" data-toggle="collapse" id="@item.id" data-target=".@item.id" class="detail-row" onclick="changeicon('@item.id')">&nbsp;</td>
                            @if (item.FirstName != null && item.FirstName != "")
                            {
                                <td class="cadName intwname">
                                    <a onclick="" data-tooltip="@item.FirstName"><span class="intName"> @item.FirstName</span></a>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }

                            @if (item.LastName != null && item.LastName != "")
                            {
                                @if (item.LastName.Length > 10)
                                {
                                    <td class="cadLast">
                                        <a onclick="" data-tooltip="@item.LastName"> @item.LastName.Substring(0, 10)... </a>
                                    </td>
                                }
                                else
                                {
                                    <td class="cadLast">
                                        <a onclick=""> @item.LastName </a>
                                    </td>
                                }
                            }
                            else
                            {
                                <td></td>
                            }

                            @if (item.EmailId != null && item.EmailId != "")
                            {
                                <td class="cadEmail">
                                    <a onclick="" data-tooltip="@item.EmailId"><span class="intEmail"> @item.EmailId</span> </a>
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            <td>@item.MobileNumber</td>
                            @if (item.Isinstaavailable)
                            {
                                <td>Yes</td>
                            }
                            else
                            {
                                <td>No</td>
                            }
                            <td class="interview-com">
                                <div id="section">
                                    @if (item.AssessmentGroupId != null && item.AssessmentGroupId != "")
                                    {
                                        @if (item.AssessmentGroupId.Length > 20)
                                        {
                                            <div class="article">
                                                <p style="margin-bottom:0px;">
                                                    @item.AssessmentGroupId.Substring(0, 20)
                                                </p>
                                                <p class="moretext1_@item.id moretext">
                                                    @item.AssessmentGroupId.Substring(20, @item.AssessmentGroupId.Length - 20)
                                                </p>
                                            </div>
                                            <a onclick="moreless1(@item.id)" class="moreless-button" value="Readmore" id="read1_@item.id" href="#">Read more</a>
                                        }
                                        else
                                        {
                                            <div class="article">

                                                <p>
                                                    @item.AssessmentGroupId.Substring(0, @item.AssessmentGroupId.Length)
                                                </p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div></div>
                                    }


                                </div>




                            </td>



                            @if (item.ResumeLink != null && item.ResumeLink != "")
                            {
                                <td>

                                    <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink.Replace(" ","%20")>Resume</a>
                                </td>
                            }
                            else
                            {
                                <td>No Resume</td>
                            }


                            <td><b>@item.NickName</b></td>
                            <td>@item.AvailableDetails</td>
                            <td class="text-left action">
                                <span class="interviewer_9">
                                    <button class="mdc-fab app-fab--absolute mb-40" aria-label="Recommendation">
                                        <span onclick="location.href = '@Url.Action("InterviewerRecommendation", "Interviewer", new {  id = item.UserId })'" title="Recommendation" class="mdc-fab__icon material-icons">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" style="top: -1px;position: relative;">
                                                <path d="M9 11.24V7.5C9 6.12 10.12 5 11.5 5S14 6.12 14 7.5v3.74c1.21-.81 2-2.18 2-3.74C16 5.01 13.99 3 11.5 3S7 5.01 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63l-4.54-2.26c-.17-.07-.35-.11-.54-.11H13v-6c0-.83-.67-1.5-1.5-1.5S10 6.67 10 7.5v10.74l-3.43-.72c-.08-.01-.15-.03-.24-.03-.31 0-.59.13-.79.33l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.91-1.38z"></path>
                                            </svg>
                                        </span>
                                    </button>
                                </span>


                                <span class="interviewer_10">
                                    <button title="Availability Details" class="mdc-fab app-fab--absolute mb-40" data-toggle="modal" onclick="openAvailDetailsModel(@item.id)">

                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" /></svg>
                                    </button>
                                </span>

                                <span class="interviewer_11">
                                    <button title="Bank Details" class="mdc-fab app-fab--absolute mb-40" data-toggle="modal" onclick="openBankDetailsModel(@item.id)">

                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z" /></svg>
                                    </button>
                                </span>

                                @if (ViewBag.profile != "Finance")
                                {
                                    <span class="interviewer_12">
                                        <button class="mdc-fab app-fab--absolute mb-40" aria-label="Click here to edit Interviewer Profile">
                                            <span onclick="location.href = '@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId })'" title="Click here to edit Interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                        </button>
                                    </span>
                                }
                                else
                                {
                                    <span class="interviewer_12">
                                        <button disabled class="mdc-fab app-fab--absolute mb-40" aria-label="Click here to edit Interviewer Profile">
                                            <span onclick="location.href = '@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId })'" title="Click here to edit Interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                        </button>
                                    </span>
                                }

                                <span class="interviewer_13">
                                    <button class="mdc-fab app-fab--absolute" aria-label="Click here to add Interviewer Employer Details">
                                        <span onclick="location.href = '@Url.Action("IndexEmployer", "Interviewer", new { id = item.id})'" title="Click here to add Interviewer Employer Details" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><path d="M10 8c1.66 0 2.99-1.34 2.99-3S11.66 2 10 2 7 3.34 7 5s1.34 3 3 3zm-6 2V8h2V6H4V4H2v2H0v2h2v2h2zm6 0c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg></span>
                                    </button>
                                </span>
                                <br />
                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                {
                                    <span class="interviewer_14"><span class="call" data-toggle="tooltip" data-placement="top" onclick="CallButtonClickInterviewer('@item.FirstName', '@item.MobileNumber','@item.EmailId')" data-original-title="Tooltip on top"><span title="Click here to call the candidate" class="mdc-fab app-fab--absolute" style="top: -3px;left:1px;"><span class="fa fa-phone-alt"></span></span></span></span>

                                }
                                @if (ViewBag.profile != "Finance")
                                {
                                    <span class="interviewer_15">
                                        <button class="mdc-fab app-fab--absolute trash-btn" title="Click here to delete Interviewer Profile">
                                            <span title="Click here to delete Interviewer Profile" onclick="javascript:DeleteEntityfromEnvironment('@item.UserId','@item.FirstName');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                        </button>
                                    </span>
                                }
                                else
                                {
                                    <span class="interviewer_15">
                                        <button disabled class="mdc-fab app-fab--absolute trash-btn" title="Click here to delete Interviewer Profile">
                                            <span title="Click here to delete Interviewer Profile" onclick="javascript:DeleteEntityfromEnvironment('@item.UserId','@item.FirstName');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                        </button>
                                    </span>
                                }

                                <span class="interviewer_16">
                                    <button class="mdc-fab app-fab--absolute" aria-label="Assessments">
                                        <span onclick="location.href = '@Url.Action("AssessmentForApproval", "Interviewer", new { EmailAddress = item.EmailId , id = item.id })'" title="Assessments" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" /></svg></span>
                                    </button>
                                </span>
                                <button class="mdc-fab app-fab--absolute" style="margin:0px 3px;" aria-label="Share Public URL">
                                    <span onclick="javascript:SendPublicURL('@item.EmailId');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-share" viewBox="0 0 16 16"><path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5zm-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" /></svg></span>
                                </button>
                                <button class="mdc-fab app-fab--absolute " aria-label="Copy Public URL">
                                    <span onclick="javascript:CopyPublicUrl('@item.EmailId');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg></span>
                                </button>
                                <button class="mdc-fab app-fab--absolute " aria-label="Tds Certificates">
                                    <span onclick="javascript:OpenTdsCertificates('@item.EmailId');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"><path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" /><path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" /></svg></span>
                                </button>
                            </td>
                        </tr>


                        <tr class="collapse @item.id">

                            <td colspan="999" class="child-section">
                                <table class="table table-striped" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <th>Lead Interviewer</th>
                                        <th>Coded Resume </th>
                                        <th>Password</th>
                                        <th>Approved</th>
                                        <th>City</th>
                                        <th>Current Role</th>
                                        <th>Experience</th>
                                        <th>Preffered Domain</th>
                                        <th>GitHub</th>
                                        <th>Linkedin </th>
                                        <th>Stack Overflow</th>
                                        <th>Blog</th>

                                    </tr>

                                    <tr>

                                        @if (item.IsLeadInterviewer)
                                        {
                                            <td class="text-center">Yes</td>
                                        }
                                        else
                                        {
                                            <td class="text-center">No</td>
                                        }
                                        @if (item.CodedResumeLink != null && item.CodedResumeLink != "")
                                        {
                                            <td>

                                                <a id="codedResumeId" target="_blank" title="Coded Resume" href=@item.CodedResumeLink.Replace(" ","%20")>Coded Resume</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No Coded Resume</td>
                                        }

                                        <td>
                                            <div style="position:relative">
                                                <div class="secret-pass passshow" id="password-field_@item.id" type="password">@item.UserPassword</div>
                                                @if (item.UserPassword != null && item.UserPassword != "")
                                                {
                                                    <span class="secret" id="secret_@item.id" style="top:0px;">********</span>
                                                    <span toggle="#password-field_@item.id" class="fa fa-fw fa-eye field-icon toggle-password" id="toggle-password_@item.id" onclick="showhidepass(@item.id)"></span>
                                                }
                                                else
                                                {
                                                    <span toggle="#password-field_@item.id" class=" toggle-password" id="toggle-password_@item.id"></span>
                                                }
                                            </div>


                                        </td>





                                        @if (item.IsApproved == true)
                                        {
                                            <td>Approved</td>
                                        }
                                        else
                                        {
                                            <td>Not Approved</td>
                                        }
                                        @if (item.City != null && item.City != "")
                                        {
                                            <td>@item.City</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        @if (item.CurrentRole != null && item.CurrentRole != "")
                                        {
                                            <td>@item.CurrentRole</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td>@item.Experience</td>
                                        <td>@item.PreferredDomain</td>

                                        @if (item.GitHubLink != null && item.GitHubLink != "")
                                        {
                                            <td>

                                                <a id="githubId" target="_blank" title="Github" href=@item.GitHubLink>Github</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No Github</td>
                                        }
                                        @if (item.LinkedinLink != null && item.LinkedinLink != "")
                                        {
                                            <td>

                                                <a id="linkedInId" target="_blank" title="LinkedIn" href=@item.LinkedinLink>LinkedIn</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No LinkedIn</td>
                                        }

                                        @if (item.StackOverflowLink != null && item.StackOverflowLink != "")
                                        {
                                            <td>

                                                <a id="stackOverFlowId" target="_blank" title="Stackoverflow" href=@item.StackOverflowLink>Stackoverflow</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No Stackoverflow</td>
                                        }
                                        @if (item.Blog != null && item.Blog != "")
                                        {
                                            <td>

                                                <a id="blogId" target="_blank" title="Blog" href=@item.Blog>Blog</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>No Blog</td>
                                        }
                                    </tr>

                                </table>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>


    <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
        Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
    </div>

    <div class="col-sm-12 col-md-7 dataTables_paginate pull-right" id="divmeetingpages">
        @Html.PagedListPager(Model, Page => Url.Action("Index", new { Page = Page }))
    </div>
</div>