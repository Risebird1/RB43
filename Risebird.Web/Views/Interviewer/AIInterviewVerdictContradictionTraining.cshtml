<form id="contradictionTrainingAntiForgery" style="display:none">@Html.AntiForgeryToken()</form>
<div class="topbar">
  <div class="topbar-left">
    <a href="/Dashboard/InterviewerIndex" style="text-decoration:none"><button type="button" class="topbar-back">← Dashboard</button></a>
