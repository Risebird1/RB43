function saveContradictionChecklistProgress(){const url=window.__contradictionTrainingSubmitUrl;const tokenInput=document.querySelector('#contradictionTrainingAntiForgery input[name="__RequestVerificationToken"]');if(!tokenInput||!tokenInput.value){alert('Security token missing. Refresh the page and try again.');return;}if(!url){alert('Save is not configured.');return;}const built=buildFullChecklistState();localStorage.setItem(STORAGE_KEY,JSON.stringify(state));const payload=JSON.stringify({trainingModuleCode:TRAINING_MODULE_CODE,checklistState:built.checklistState,totalItems:built.totalItems,totalChecked:built.totalChecked});const fd=new FormData();fd.append('__RequestVerificationToken',tokenInput.value);fd.append('payload',payload);const btn=document.getElementById('btnSaveContradictionChecklist');if(btn){btn.disabled=true;btn.style.opacity='0.7';}fetch(url,{method:'POST',body:fd,credentials:'same-origin'}).then(r=>r.text().then(t=>{try{return t?JSON.parse(t):{};}catch(e){throw new Error('Unexpected response');}})).then(data=>{const st=document.getElementById('checklistSaveStatus');if(data&&data.success){const savedAt=new Date().toLocaleString();localStorage.setItem(STORAGE_KEY+'-savedAt',savedAt);if(st)st.textContent=(data.message||'Saved.')+' · '+savedAt;}else{if(st)st.textContent='';alert((data&&data.message)||'Could not save the checklist. Please try again.');}}).catch(()=>alert('Could not reach the server. Check your connection and try again.')).finally(()=>{if(btn){btn.disabled=false;btn.style.opacity='';}});}
function syncContradictionChecklistFromServer(){const url=window.__contradictionTrainingLoadUrl;if(!url)return Promise.resolve();return fetch(url+'?moduleCode='+encodeURIComponent(TRAINING_MODULE_CODE),{credentials:'same-origin'}).then(r=>r.json()).then(data=>{if(!data||!data.success||!data.record||!data.record.checklistState)return;const server=data.record.checklistState;Object.keys(server).forEach(k=>{state[k]=!!server[k];});localStorage.setItem(STORAGE_KEY,JSON.stringify(state));if(data.record.createdOn){try{localStorage.setItem(STORAGE_KEY+'-savedAt',new Date(data.record.createdOn).toLocaleString());}catch(e){}}});}
function renderChecklist(){checklistRoot.innerHTML='';let total=0,checked=0;CHECKLIST.forEach((group,gi)=>{const groupEl=document.createElement('div');groupEl.className='checklist-group';const titleEl=document.createElement('div');titleEl.className='checklist-group-title';titleEl.textContent=group.title;groupEl.appendChild(titleEl);const itemsEl=document.createElement('div');itemsEl.className='items';group.items.forEach((item,i)=>{total++;const key='g'+gi+'-i'+i;const isChecked=!!state[key];if(isChecked)checked++;const itemEl=document.createElement('div');itemEl.className='item'+(isChecked?' checked':'');itemEl.dataset.key=key;itemEl.innerHTML='<div class="item-checkbox"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div><div class="item-body"><div class="item-label"></div><div class="item-note"></div></div>';itemEl.querySelector('.item-label').textContent=item.label;itemEl.querySelector('.item-note').textContent=item.note;itemEl.addEventListener('click',()=>{state[key]=!state[key];localStorage.setItem(STORAGE_KEY,JSON.stringify(state));renderChecklist();});itemsEl.appendChild(itemEl);});groupEl.appendChild(itemsEl);checklistRoot.appendChild(groupEl);});document.getElementById('globalFill').style.width=(total?(checked/total*100):0)+'%';document.getElementById('globalCount').textContent=checked+' / '+total;}
syncContradictionChecklistFromServer().catch(()=>{}).finally(()=>{renderChecklist();const savedAt=localStorage.getItem(STORAGE_KEY+'-savedAt');const st=document.getElementById('checklistSaveStatus');if(savedAt&&st)st.textContent='Last saved at '+savedAt;});
