function onScroll(){const y=window.scrollY+180;let active=sections[0].id;for(const sec of sections){if(sec.offsetTop<=y)active=sec.id;}navBtns.forEach(b=>b.classList.toggle('active',b.dataset.target===active));const activeBtn=navBtns.find(b=>b.classList.contains('active'));if(activeBtn){const navRect=navInner.parentElement.getBoundingClientRect();const btnRect=activeBtn.getBoundingClientRect();if(btnRect.right>navRect.right||btnRect.left<navRect.left)activeBtn.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});}}
window.addEventListener('scroll',onScroll,{passive:true});onScroll();
const CHECKLIST=[{title:'Scores',items:[{label:'TechSkillScore matches the depth you actually observed',note:'Re-read your interview notes — does the number reflect probing depth, not just answer correctness?'},{label:'ScoreRubricScore is logically aligned with TechSkillScore',note:'A 3 on the rubric and an 8 on tech skills will be flagged immediately.'},{label:'QuestionDiscussedRating reflects how thoroughly answers were discussed',note:'Low rating only if discussion truly was shallow — and call out why in the comment.'},{label:'CommunicationScore avoids direct opposites of the AI read',note:'Strict is fine. "Incoherent" when AI says "clear and confident" is a direct contradiction.'},{label:'Every score below 5 is explicitly justified in the comment',note:'A low score with no narrative reason is the #1 contradiction trigger.'},{label:'No score sits at an extreme (0 or 10) without strong evidence',note:'Extremes draw extra scrutiny — back them up with multiple observations.'}]},{title:'Status',items:[{label:'Final status logically follows from your comment',note:'Reject must follow from documented weakness; Select from documented strength.'},{label:'Status is not contradicted by any positive language in the comment',note:'"Performed well" + Reject is the easiest way to spike contradiction severity.'},{label:'Borderline calls explicitly say "borderline" or "mixed"',note:'Borderline carries the most contradiction risk — name the mixed read directly.'},{label:'Reject decisions cite at least 3 weakness signals',note:'Fundamentals · reasoning · debugging · explanation depth · authenticity concerns.'}]},{title:'Comment coverage — suppression triggers',items:[{label:'Mentioned weak fundamentals or shallow understanding',note:'Activates FundamentalsFailure = true — strongest single protection.'},{label:'Mentioned reasoning depth or follow-up probing failure',note:'Distinguishes shallow correctness from real understanding.'},{label:'Mentioned debugging ability or edge-case handling',note:'A core signal the rubric expects you to evaluate.'},{label:'Mentioned optimization / tradeoff understanding',note:'Critical when the candidate produced working code — explains why score is still low.'},{label:'Mentioned communication clarity / structure',note:'Use calibrated language — explanations "lacked structure" not "were incoherent".'},{label:'Mentioned confidence consistency across topics',note:'Inconsistent confidence is a soft proxy / authenticity signal.'},{label:'Documented authenticity / proxy concerns (if any)',note:'Activates ProxyOverride = true across scores and status.'},{label:'Used specific observable language, not vague labels',note:'"Struggled in conceptual probing" — not "weak" or "average".'},{label:'Comment is at least 3–4 sentences',note:'Single-line comments cannot defend a harsh score, even when the score is correct.'}]},{title:'Four-part comment structure',items:[{label:'Part 1 — Technical capability covered',note:'Depth, correctness, fundamentals, debugging, reasoning quality.'},{label:'Part 2 — Communication covered',note:'Clarity, confidence, structured explanation, quality under probing.'},{label:'Part 3 — Behavioral / authenticity covered',note:'Independence, consistency, suspicious patterns, confidence mismatch.'},{label:'Part 4 — Final recommendation logic stated',note:'One sentence: why select / reject / borderline and which signals weighed most.'}]},{title:'Internal consistency',items:[{label:'Score ↔ Comment agree on the same story',note:'Score and written assessment must point in the same direction.'},{label:'Status ↔ Comment agree',note:'No "performed well" with a Reject status, ever.'},{label:'Score ↔ Status agree',note:'3/10 + Select, or 9/10 + Reject, will trigger immediately.'},{label:'Comment does not directly oppose any AI observation',note:'Strict variance is allowed; direct opposites are not.'},{label:'No filler phrases ("not good", "average", "weak") left in',note:'These provide no justification and amplify any disagreement.'}]},{title:'Final pass before submit',items:[{label:'Re-read the full comment as if you were the auditor',note:'Could a reviewer reconstruct your decision from the comment alone?'},{label:'No score, status, or comment fields left blank',note:'Empty fields are treated as unjustified — easiest contradiction to avoid.'},{label:'Spot-check: would a candidate appeal succeed against this write-up?',note:'If your reasoning would not hold up to candidate review, tighten it now.'}]}];
