*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}:root{--bg:#0d1520;--bg2:#131f32;--bg3:#1a2a42;--border:rgba(255,255,255,0.08);--border-strong:rgba(255,255,255,0.14);--blue:oklch(0.60 0.18 230);--blue-light:oklch(0.72 0.16 225);--amber:oklch(0.74 0.17 55);--red:oklch(0.64 0.19 22);--green:oklch(0.68 0.16 148);--white:#eef2f9;--dim:rgba(238,242,249,0.55);--faint:rgba(238,242,249,0.1);--font:'DM Sans',Helvetica,sans-serif;--mono:'DM Mono',monospace;--radius:12px}html{scroll-behavior:smooth}body{font-family:var(--font);background:var(--bg);color:var(--white);min-height:100vh;line-height:1.5;-webkit-font-smoothing:antialiased}a{color:var(--blue-light);text-decoration:none}a:hover{text-decoration:underline}.topbar{position:sticky;top:0;z-index:100;background:rgba(13,21,32,0.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:0 40px;display:flex;align-items:center;justify-content:space-between;height:64px;gap:24px}.topbar-left{display:flex;align-items:center;gap:20px}.topbar-back{font-size:13px;color:var(--dim);background:none;border:1px solid var(--border);border-radius:8px;padding:6px 12px;cursor:pointer;font-family:var(--font);display:inline-flex;align-items:center;gap:6px;transition:color .18s,border-color .18s}.topbar-back:hover{color:var(--white);border-color:var(--border-strong)}.topbar img{height:32px;width:auto;object-fit:contain}.topbar-progress-wrap{flex:1;max-width:380px;display:flex;align-items:center;gap:14px}.topbar-bar-bg{flex:1;height:6px;background:var(--faint);border-radius:99px;overflow:hidden}.topbar-bar-fill{height:100%;background:var(--blue);border-radius:99px;transition:width .35s ease}.topbar-count{font-size:13px;font-family:var(--mono);color:var(--dim);white-space:nowrap}.section-nav{position:sticky;top:64px;z-index:90;background:rgba(13,21,32,0.88);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}.section-nav::-webkit-scrollbar{display:none}.section-nav-inner{display:flex;align-items:center;gap:2px;padding:0 32px;height:48px;min-width:max-content}.nav-btn{font-size:13px;font-weight:500;color:var(--dim);background:none;border:none;cursor:pointer;padding:6px 14px;border-radius:8px;font-family:var(--font);white-space:nowrap;transition:color .2s,background .2s}.nav-btn:hover{color:var(--white);background:var(--faint)}.nav-btn.active{color:var(--blue-light);background:oklch(0.60 0.18 230 / 0.12)}.hero{padding:72px 40px 40px;max-width:920px;margin:0 auto;text-align:center}.hero img{height:48px;width:auto;object-fit:contain;margin-bottom:24px;opacity:.95}.hero-eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-light);margin-bottom:16px}.hero-title{font-size:clamp(32px,4vw,52px);font-weight:700;line-height:1.08;margin-bottom:18px;letter-spacing:-.02em}.hero-sub{font-size:17px;color:var(--dim);max-width:700px;margin:0 auto 32px;line-height:1.65}.hero-badges{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.badge{display:inline-flex;align-items:center;gap:7px;background:var(--bg2);border:1px solid var(--border);border-radius:99px;padding:6px 14px;font-size:13px;font-weight:500;color:var(--dim)}.badge-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;background:var(--blue)}.key-callout-wrap{max-width:960px;margin:0 auto;padding:0 24px 24px}.key-callout{background:linear-gradient(135deg,oklch(0.60 0.18 230 / 0.12) 0%,oklch(0.60 0.18 230 / 0.04) 100%);border:1px solid oklch(0.60 0.18 230 / 0.25);border-radius:16px;padding:28px 32px;display:flex;align-items:flex-start;gap:18px}.key-callout-icon{font-size:26px;flex-shrink:0;line-height:1.4}.key-callout-title{font-size:18px;font-weight:700;color:var(--white);margin-bottom:8px;letter-spacing:-.01em}.key-callout-body{font-size:15px;color:rgba(238,242,249,.78);line-height:1.65;max-width:740px}.key-callout-body strong{color:var(--white);font-weight:600}.main{max-width:960px;margin:0 auto;padding:32px 24px 80px}.section{margin-bottom:64px;scroll-margin-top:130px}.section-header{display:flex;align-items:flex-start;gap:18px;margin-bottom:24px;padding-bottom:18px;border-bottom:1px solid var(--border)}.section-icon{width:44px;height:44px;border-radius:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:20px;background:var(--bg3);border:1px solid var(--border);font-family:var(--mono);font-weight:500;color:var(--blue-light)}.section-meta{flex:1}.section-num{font-family:var(--mono);font-size:11px;color:var(--dim);letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px}.section-title{font-size:22px;font-weight:700;color:var(--white);margin-bottom:4px;letter-spacing:-.01em}.section-subtitle{font-size:14.5px;color:var(--dim);line-height:1.55}.section p{font-size:15.5px;line-height:1.7;color:rgba(238,242,249,.78);margin-bottom:14px}.section p strong{color:var(--white);font-weight:600}.section h3{font-size:16px;font-weight:700;color:var(--white);margin:22px 0 10px;letter-spacing:-.005em}.section ul{margin:4px 0 18px;list-style:none}.section ul li{font-size:15px;line-height:1.6;color:rgba(238,242,249,.78);position:relative;padding-left:20px;margin-bottom:6px}.section ul li::before{content:'';position:absolute;left:4px;top:10px;width:5px;height:5px;border-radius:50%;background:var(--dim)}.callout{display:flex;gap:14px;align-items:flex-start;padding:18px 22px;border-radius:12px;margin:22px 0}.callout-icon{font-size:18px;flex-shrink:0;line-height:1.4}.callout-body{flex:1;font-size:15px;line-height:1.6}.callout-body strong{display:block;margin-bottom:4px;font-size:13px;letter-spacing:.01em;text-transform:uppercase}.callout.tip{background:oklch(0.60 0.18 230 / 0.08);border:1px solid oklch(0.60 0.18 230 / 0.25);color:rgba(238,242,249,.85)}.callout.tip strong{color:var(--blue-light)}.callout.warn{background:oklch(0.74 0.17 55 / 0.08);border:1px solid oklch(0.74 0.17 55 / 0.25);color:rgba(238,242,249,.85)}.callout.warn strong{color:var(--amber)}.callout.danger{background:oklch(0.64 0.19 22 / 0.08);border:1px solid oklch(0.64 0.19 22 / 0.25);color:rgba(238,242,249,.85)}.callout.danger strong{color:var(--red)}.callout.success{background:oklch(0.68 0.16 148 / 0.08);border:1px solid oklch(0.68 0.16 148 / 0.25);color:rgba(238,242,249,.85)}.callout.success strong{color:var(--green)}.param-table{width:100%;border-collapse:separate;border-spacing:0;margin:16px 0 8px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;overflow:hidden;font-size:14px}.param-table thead th{text-align:left;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);padding:14px 18px;border-bottom:1px solid var(--border);background:rgba(255,255,255,.02);font-family:var(--mono)}.param-table tbody td{padding:14px 18px;border-bottom:1px solid var(--border);vertical-align:top;line-height:1.55;color:rgba(238,242,249,.82)}.param-table tbody tr:last-child td{border-bottom:none}.param-table .param-name{font-family:var(--mono);color:var(--blue-light);font-size:13.5px;font-weight:500;white-space:nowrap}.param-table .param-most{background:oklch(0.60 0.18 230 / 0.06)}.param-table .param-most .param-name{color:var(--white);font-weight:700}.compare{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0 22px}@@media(max-width:680px){.compare{grid-template-columns:1fr}}.compare-card{border-radius:12px;padding:18px 20px;border:1px solid var(--border);background:var(--bg2)}.compare-card.good{border-color:oklch(0.68 0.16 148 / 0.35);background:oklch(0.68 0.16 148 / 0.05)}.compare-card.bad{border-color:oklch(0.64 0.19 22 / 0.35);background:oklch(0.64 0.19 22 / 0.05)}.compare-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:12px;display:inline-flex;align-items:center;gap:6px}.compare-card.good .compare-label{color:var(--green)}.compare-card.bad .compare-label{color:var(--red)}.compare-label-dot{width:6px;height:6px;border-radius:50%}.compare-card.good .compare-label-dot{background:var(--green)}.compare-card.bad .compare-label-dot{background:var(--red)}.compare-list{display:flex;flex-direction:column;gap:8px}.compare-list .ex{font-size:14px;color:rgba(238,242,249,.85);line-height:1.55;padding:8px 12px;background:rgba(255,255,255,.025);border-radius:6px;font-style:italic}.eval-card{border:1px solid var(--border);border-radius:12px;margin:14px 0 18px;overflow:hidden;background:var(--bg2)}.eval-card.bad{border-color:oklch(0.64 0.19 22 / 0.35)}.eval-card.good{border-color:oklch(0.68 0.16 148 / 0.35)}.eval-header{padding:12px 18px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border)}.eval-card.bad .eval-header{background:oklch(0.64 0.19 22 / 0.1);color:var(--red)}.eval-card.good .eval-header{background:oklch(0.68 0.16 148 / 0.1);color:var(--green)}.eval-row{display:grid;grid-template-columns:180px 1fr;gap:16px;padding:12px 18px;border-bottom:1px solid var(--border);font-size:14.5px}.eval-row:last-child{border-bottom:none}.eval-row .eval-key{font-family:var(--mono);font-size:13px;color:var(--dim)}.eval-row .eval-val{color:var(--white);line-height:1.55}.result-chip{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;padding:6px 12px;border-radius:99px;margin-top:8px;font-family:var(--mono);letter-spacing:.02em}.result-chip.valid{background:oklch(0.68 0.16 148 / 0.12);color:var(--green);border:1px solid oklch(0.68 0.16 148 / 0.3)}.result-chip.contra{background:oklch(0.64 0.19 22 / 0.12);color:var(--red);border:1px solid oklch(0.64 0.19 22 / 0.3)}.trigger{display:inline-flex;align-items:center;gap:8px;background:oklch(0.60 0.18 230 / 0.1);border:1px solid oklch(0.60 0.18 230 / 0.3);color:var(--blue-light);font-family:var(--mono);font-size:13px;font-weight:500;padding:6px 12px;border-radius:6px;margin:4px 0}.template-block{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 22px}@@media(max-width