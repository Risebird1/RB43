-items:center;gap:12px}.checklist-group-title::after{content:'';flex:1;height:1px;background:var(--border)}.items{display:flex;flex-direction:column;gap:10px}.item{display:flex;align-items:flex-start;gap:18px;padding:20px 22px;border-radius:var(--radius);border:1px solid var(--border);background:var(--bg2);cursor:pointer;transition:background .18s,border-color .18s,opacity .18s,transform .12s;user-select:none;-webkit-tap-highlight-color:transparent}.item:hover{background:var(--bg3);border-color:var(--border-strong);transform:translateX(2px)}.item.checked{background:oklch(0.60 0.18 230 / 0.07);border-color:oklch(0.60 0.18 230 / 0.3);opacity:.72}.item-checkbox{width:26px;height:26px;border-radius:7px;flex-shrink:0;margin-top:2px;border:2px solid var(--border-strong);background:transparent;display:flex;align-items:center;justify-content:center;transition:background .18s,border-color .18s;pointer-events:none}.item.checked .item-checkbox{background:var(--blue);border-color:var(--blue)}.item-checkbox svg{opacity:0;transition:opacity .15s;width:14px;height:14px}.item.checked .item-checkbox svg{opacity:1}.item-body{flex:1}.item-label{font-size:16.5px;font-weight:600;color:var(--white);line-height:1.45;margin-bottom:6px;letter-spacing:-.005em}.item.checked .item-label{text-decoration:line-through;color:var(--dim)}.item-note{font-size:14.5px;color:rgba(238,242,249,.7);line-height:1.6}.takeaway{margin-top:56px;padding:36px;background:linear-gradient(135deg,var(--bg2) 0%,var(--bg3) 100%);border:1px solid var(--border-strong);border-radius:16px}.takeaway-eyebrow{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-light);margin-bottom:14px}.takeaway-title{font-size:26px;font-weight:700;color:var(--white);margin-bottom:18px;line-height:1.25;letter-spacing:-.01em}.takeaway-body{font-size:15.5px;color:rgba(238,242,249,.78);line-height:1.7;margin-bottom:22px}.takeaway-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}@@media(max-width:680px){.takeaway-row{grid-template-columns:1fr}}.takeaway-col{padding:18px 20px;border-radius:10px;border:1px solid var(--border);background:rgba(0,0,0,.18)}.takeaway-col-label{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px}.takeaway-col.valid .takeaway-col-label{color:var(--green)}.takeaway-col.contra .takeaway-col-label{color:var(--red)}.takeaway-col-text{font-size:14px;color:rgba(238,242,249,.78);line-height:1.6}footer{border-top:1px solid var(--border);padding:32px 40px;text-align:center;font-size:13px;color:var(--dim)}footer img{height:28px;width:auto;opacity:.55;margin-bottom:10px}@@media(max-width:600px){.topbar{padding:0 16px}.topbar-progress-wrap{display:none}.main{padding:24px 16px 60px}.hero{padding:48px 16px 32px}.key-callout{padding:22px 20px}.eval-row{grid-template-columns:1fr;gap:4px}.eval-row .eval-key{font-size:11px;letter-spacing:.08em;text-transform:uppercase}}
</style>
