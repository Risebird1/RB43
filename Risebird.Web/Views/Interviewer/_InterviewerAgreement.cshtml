@* Interviewer service agreement (My Profile → SERVICE AGREEMENT tab): read the agreement, fill in details, sign. *@
@inject Microsoft.Extensions.Options.IOptions<Risebird.Entities.Data.ServiceAgreementOptions> AgreementOptions
@{
    var agreementDocumentUrl = AgreementOptions.Value.DocumentUrl;
}
<style>
    #agreementSignaturePad { width: 100%; max-width: 520px; height: 160px; border: 1px dashed #9e9e9e; border-radius: 4px; background: #fff; touch-action: none; cursor: crosshair; display: block; }
    .agreement-sig-modes { display: flex; margin-bottom: 8px; }
    .agreement-sig-mode { position: relative; z-index: 2; border: 1px solid #2196f3; background: #fff; color: #2196f3; padding: 6px 14px; font-size: 13px; cursor: pointer; }
    .agreement-sig-mode:first-child { border-radius: 4px 0 0 4px; }
    .agreement-sig-mode:last-child { border-radius: 0 4px 4px 0; border-left: 0; }
    .agreement-sig-mode.active { background: #2196f3; color: #fff; }
    .agreement-sig-upload-box { width: 100%; max-width: 520px; height: 160px; border: 1px dashed #9e9e9e; border-radius: 4px; background: #fff;
        display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .agreement-sig-upload-box img { max-width: 90%; max-height: 140px; }
    /* The site theme hides / overlays native checkboxes and file inputs; show the checkbox, keep the file input out of layout. */
    #agreementSigFile { display: none !important; }
    .agreement-agree { display: flex; align-items: flex-start; gap: 10px; font-weight: normal; cursor: pointer; margin-bottom: 12px; padding: 10px 12px; border: 1px solid #dcdcdc; border-radius: 4px; }
    .agreement-agree.is-checked { border-color: #43a047; background: #f1f8f1; }
    .agreement-agree input#agreementAgree {
        position: static !important; display: inline-block !important; opacity: 1 !important; visibility: visible !important;
        width: 20px !important; height: 20px !important; min-width: 20px; margin: 2px 0 0 0 !important;
        -webkit-appearance: checkbox !important; appearance: auto !important; accent-color: #43a047; cursor: pointer;
    }
</style>
<div class="tab-box" id="tab-4">
    <div class="row">
        <div class="col-md-12">
            <h4 class="info-text" style="text-align:left;">Service Agreement for Interviewer Onboarding</h4>
            <div id="agreementStatusBox"><p class="text-muted">Loading...</p></div>

            @* Shown after signing (an agreement is signed only once): the agreement and the signature details, read-only. *@
            <div id="agreementSignedSection" style="display:none;">
                <div style="border:1px solid #dcdcdc; border-radius:4px;">
                    <iframe id="agreementSignedDocument" title="Signed Service Agreement" style="width:100%; height:70vh; border:0; background:#fff;"></iframe>
                </div>
                <small><a href="@agreementDocumentUrl" target="_blank" rel="noopener">Open the agreement in a new tab</a></small>

                <div style="margin-top:16px; padding:14px 16px; border:1px solid #c8e6c9; border-radius:4px; background:#f6fbf6;">
                    <h5 style="margin-top:0;">Signature details</h5>
                    <table class="table table-sm" style="margin-bottom:10px; background:transparent;">
                        <tbody>
                            <tr><th style="width:220px;">Interviewer Full Name</th><td id="signedName"></td></tr>
                            <tr><th>Father's / Guardian's Name</th><td id="signedFatherName"></td></tr>
                            <tr><th>Residential Address</th><td id="signedAddress"></td></tr>
                            <tr><th>Agreement Version</th><td id="signedVersion"></td></tr>
                            <tr><th>Signed On</th><td id="signedOn"></td></tr>
                            <tr>
                                <th>Signature</th>
                                <td><img id="signedSignature" alt="Signature" style="display:none; max-width:260px; max-height:90px; background:#fff; border:1px solid #e0e0e0; padding:4px;" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <a id="signedProofLink" href="@Url.Action("Proof", "InterviewerAgreement")" target="_blank" rel="noopener" style="display:none;">View the screenshot taken when you signed</a>
                </div>
            </div>

            <div id="agreementSignSection" style="display:none;">
                <p class="text-muted">Please read the agreement below, fill in your details and sign it.</p>
                <div id="agreementDocumentBox">
                    <div style="border:1px solid #dcdcdc; border-radius:4px;">
                        <iframe id="agreementDocument" title="Service Agreement" style="width:100%; height:70vh; border:0; background:#fff;"></iframe>
                    </div>
                    <small><a href="@agreementDocumentUrl" target="_blank" rel="noopener">Open the agreement in a new tab</a></small>
                </div>
                @* Shown only in the proof screenshot, in place of the agreement viewer (which cannot be captured). *@
                <div id="agreementProofCaption" style="display:none; padding:10px 12px; border:1px solid #dcdcdc; border-radius:4px; background:#fafafa;"></div>

                <div class="row" style="margin-top:16px;">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="agreementFullName">Interviewer Full Name <span class="text-danger">*</span></label>
                            <input type="text" id="agreementFullName" class="form-control" maxlength="150" autocomplete="name" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="agreementFatherName">Father's / Guardian's Name <span class="text-danger">*</span></label>
                            <input type="text" id="agreementFatherName" class="form-control" maxlength="150" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="agreementAddressLine1">House / Flat No. &amp; Street <span class="text-danger">*</span></label>
                            <input type="text" id="agreementAddressLine1" class="form-control" maxlength="80" autocomplete="address-line1" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="agreementAddressLine2">Area / Locality</label>
                            <input type="text" id="agreementAddressLine2" class="form-control" maxlength="60" autocomplete="address-line2" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="agreementCity">City <span class="text-danger">*</span></label>
                            <input type="text" id="agreementCity" class="form-control" maxlength="40" autocomplete="address-level2" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="agreementState">State <span class="text-danger">*</span></label>
                            <select id="agreementState" class="form-control">
                                <option value="">-- Select State --</option>
                                @foreach (var state in Risebird.Entities.Data.IndianStates.All)
                                {
                                    <option value="@state">@state</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="agreementPinCode">PIN Code <span class="text-danger">*</span></label>
                            <input type="text" id="agreementPinCode" class="form-control" maxlength="6" inputmode="numeric" autocomplete="postal-code" placeholder="6 digits" />
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Signature <span class="text-danger">*</span></label>
                            <div class="agreement-sig-modes">
                                <button type="button" class="agreement-sig-mode active" data-mode="draw">Draw signature</button>
                                <button type="button" class="agreement-sig-mode" data-mode="upload">Upload signature</button>
                            </div>
                            <div id="agreementSigDraw">
                                <canvas id="agreementSignaturePad"></canvas>
                                <small class="text-muted">Draw your signature with the mouse or your finger.</small>
                                <button type="button" id="btnClearSignature" class="mdc-button mdc-ripple-upgraded" style="margin-left:8px;">Clear</button>
                            </div>
                            <div id="agreementSigUpload" style="display:none;">
                                <div class="agreement-sig-upload-box" id="agreementSigUploadBox">
                                    <img id="agreementSigPreview" alt="Uploaded signature" style="display:none;" />
                                    <span id="agreementSigPlaceholder" class="text-muted">Click here to upload your signature (PNG or JPG, up to 2 MB)</span>
                                </div>
                                <input type="file" id="agreementSigFile" accept="image/png,image/jpeg" tabindex="-1" aria-hidden="true" data-bfi-disabled />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="agreement-agree" for="agreementAgree">
                            <input type="checkbox" id="agreementAgree" />
                            <span>
                                I have read and understood the Service Agreement and agree to be bound by its terms. I confirm that
                                the details above are correct and that the signature above is my signature.
                            </span>
                        </label>
                        <button type="button" id="btnSignAgreement" class="mdc-button mdc-button--raised mdc-ripple-upgraded">Sign Agreement</button>
                        <span id="agreementSignStatus" class="ml-2"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ── Service agreement ───────────────────────────────────────────────
    (function ($) {
        var statusUrl = '@Url.Action("Status", "InterviewerAgreement")';
        var signUrl = '@Url.Action("Sign", "InterviewerAgreement")';
        var documentUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(agreementDocumentUrl));
        var signatureImageUrl = '@Url.Action("Signature", "InterviewerAgreement")';
        var agreementVersion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AgreementOptions.Value.Version));
        var loaded = false;

        function esc(value) { return $('<div/>').text(value == null ? '' : value).html(); }

        function render(a) {
            if (a && a.isSigned) {
                // Signed once: no form any more, only the agreement and the signature details.
                $('#agreementSignSection').hide();
                $('#agreementStatusBox').html('<p class="text-success"><strong>You have signed this agreement</strong>'
                    + (a.signedOn ? ' on ' + esc(a.signedOn) + ' IST' : '') + '.</p>');
                var $signedDoc = $('#agreementSignedDocument');
                if (!$signedDoc.attr('src')) $signedDoc.attr('src', documentUrl);
                $('#signedName').text(a.signerName || '');
                $('#signedFatherName').text(a.fatherName || '');
                $('#signedAddress').text(a.address || '');
                $('#signedVersion').text(a.version || '');
                $('#signedOn').text(a.signedOn ? a.signedOn + ' IST' : '');
                if (a.hasSignature) $('#signedSignature').attr('src', signatureImageUrl + '?t=' + Date.now()).show();
                $('#signedProofLink').toggle(!!a.hasProof);
                $('#agreementSignedSection').show();
                return;
            }
            $('#agreementStatusBox').html('<p class="text-warning">Agreement not signed yet.</p>');
            var $doc = $('#agreementDocument');
            if (!$doc.attr('src')) $doc.attr('src', documentUrl);
            $('#agreementSignSection').show();
            resizeSignaturePad();
        }

        function load() {
            loaded = true;
            $.get(statusUrl).done(function (res) {
                if (res && res.success) render(res.agreement);
                else $('#agreementStatusBox').html('<p class="text-danger">' + esc(res && res.message || 'Could not load the agreement.') + '</p>');
            }).fail(function () {
                $('#agreementStatusBox').html('<p class="text-danger">Could not load the agreement. Please refresh the page.</p>');
            });
        }

        // ── Signature: draw ──
        var pad = document.getElementById('agreementSignaturePad');
        var ctx = pad.getContext('2d');
        var drawing = false, hasInk = false, last = null, bounds = null;

        function resizeSignaturePad() {
            var ratio = window.devicePixelRatio || 1;
            var width = pad.clientWidth || 520;
            if (pad.width === Math.round(width * ratio)) return;
            pad.width = Math.round(width * ratio);
            pad.height = Math.round(160 * ratio);
            ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
            clearSignature();
        }
        function clearSignature() { ctx.clearRect(0, 0, pad.width, pad.height); hasInk = false; bounds = null; }
        function point(e) { var r = pad.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
        function extend(p) {
            var ratio = window.devicePixelRatio || 1, x = p.x * ratio, y = p.y * ratio;
            bounds = bounds ? { minX: Math.min(bounds.minX, x), minY: Math.min(bounds.minY, y), maxX: Math.max(bounds.maxX, x), maxY: Math.max(bounds.maxY, y) }
                            : { minX: x, minY: y, maxX: x, maxY: y };
        }
        pad.addEventListener('pointerdown', function (e) { drawing = true; last = point(e); extend(last); pad.setPointerCapture(e.pointerId); });
        pad.addEventListener('pointermove', function (e) {
            if (!drawing) return;
            var p = point(e);
            ctx.strokeStyle = '#0b1f5c'; ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            ctx.beginPath(); ctx.moveTo(last.x, last.y); ctx.lineTo(p.x, p.y); ctx.stroke();
            last = p; extend(p); hasInk = true;
        });
        ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (n) { pad.addEventListener(n, function () { drawing = false; }); });
        $('#btnClearSignature').on('click', clearSignature);

        // PNG of the drawn area only.
        function drawnSignature() {
            if (!hasInk || !bounds || (bounds.maxX - bounds.minX) < 20) return null;
            var m = 8, x = Math.max(0, Math.floor(bounds.minX - m)), y = Math.max(0, Math.floor(bounds.minY - m));
            var w = Math.min(pad.width, Math.ceil(bounds.maxX + m)) - x, h = Math.min(pad.height, Math.ceil(bounds.maxY + m)) - y;
            var out = document.createElement('canvas'); out.width = w; out.height = h;
            out.getContext('2d').drawImage(pad, x, y, w, h, 0, 0, w, h);
            return out.toDataURL('image/png');
        }

        // ── Signature: upload ──
        var signatureMode = 'draw', uploadedSignature = null;
        $('.agreement-sig-mode').on('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            signatureMode = $(this).data('mode');
            $('.agreement-sig-mode').removeClass('active'); $(this).addClass('active');
            $('#agreementSigDraw').toggle(signatureMode === 'draw');
            $('#agreementSigUpload').toggle(signatureMode === 'upload');
            if (signatureMode === 'draw') resizeSignaturePad();
        });
        $('#agreementSigUploadBox').on('click', function (e) { e.preventDefault(); document.getElementById('agreementSigFile').click(); });
        $('#agreementSigFile').on('change', function () {
            var file = this.files && this.files[0];
            var $status = $('#agreementSignStatus').removeClass('text-danger text-success').text('');
            if (!file) return;
            if (!/^image\/(png|jpeg)$/.test(file.type)) { $status.addClass('text-danger').text('Please upload a PNG or JPG image.'); return; }
            if (file.size > 2 * 1024 * 1024) { $status.addClass('text-danger').text('The signature image must be 2 MB or smaller.'); return; }
            var reader = new FileReader();
            reader.onload = function () {
                var img = new Image();
                img.onload = function () {
                    // Convert to PNG, at most 600 x 200.
                    var scale = Math.min(1, 600 / img.width, 200 / img.height);
                    var c = document.createElement('canvas');
                    c.width = Math.max(1, Math.round(img.width * scale)); c.height = Math.max(1, Math.round(img.height * scale));
                    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                    uploadedSignature = c.toDataURL('image/png');
                    $('#agreementSigPreview').attr('src', uploadedSignature).show();
                    $('#agreementSigPlaceholder').hide();
                };
                img.onerror = function () { $status.addClass('text-danger').text('The image could not be read. Please try another file.'); };
                img.src = reader.result;
            };
            reader.readAsDataURL(file);
        });

        // ── Sign ──
        $('#agreementAgree').on('change', function () { $(this).closest('.agreement-agree').toggleClass('is-checked', this.checked); });
        $('#agreementPinCode').on('input', function () { this.value = this.value.replace(/\D/g, '').slice(0, 6); });
        $('#agreementSignSection input[type=text]').on('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });

        $('#btnSignAgreement').on('click', function () {
            var data = {
                fullName: $.trim($('#agreementFullName').val()),
                fatherName: $.trim($('#agreementFatherName').val()),
                addressLine1: $.trim($('#agreementAddressLine1').val()),
                addressLine2: $.trim($('#agreementAddressLine2').val()),
                city: $.trim($('#agreementCity').val()),
                state: $('#agreementState').val(),
                pinCode: $.trim($('#agreementPinCode').val()),
                signature: signatureMode === 'upload' ? uploadedSignature : drawnSignature(),
                agree: $('#agreementAgree').is(':checked'),
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
            };
            var $status = $('#agreementSignStatus').removeClass('text-danger text-success');
            var fail = function (msg) { $status.addClass('text-danger').text(msg); };
            if (data.fullName.length < 2) return fail('Please enter your full name.');
            if (data.fatherName.length < 2) return fail("Please enter your father's / guardian's name.");
            if (data.addressLine1.length < 3) return fail('Please enter your house / flat number and street.');
            if (data.city.length < 2) return fail('Please enter your city.');
            if (!data.state) return fail('Please select your state.');
            if (!/^[1-9][0-9]{5}$/.test(data.pinCode)) return fail('Please enter a valid 6-digit PIN code.');
            if (!data.signature) return fail('Please draw or upload your signature.');
            if (!data.agree) return fail('Please confirm that you have read and agree to the agreement.');

            var $btn = $(this).prop('disabled', true);
            $status.text('Saving...');
            captureProof(function (screenshot) {
                data.screenshot = screenshot || '';
                submitSignature(data, $btn, fail);
            });
        });

        // ── Proof screenshot of the signing page (best effort: signing never waits on or fails because of it) ──
        function loadHtml2Canvas(done) {
            if (window.html2canvas) return done(true);
            var s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
            s.onload = function () { done(!!window.html2canvas); };
            s.onerror = function () { done(false); };
            document.head.appendChild(s);
        }

        function captureProof(done) {
            var finished = false;
            var finish = function (image) {
                if (finished) return;
                finished = true;
                $('#agreementProofCaption').hide();
                $('#agreementDocumentBox').show();
                done(image);
            };
            setTimeout(function () { finish(null); }, 15000);
            loadHtml2Canvas(function (ok) {
                if (!ok) return finish(null);
                try {
                    // The agreement viewer (an iframe from Azure Blob) cannot be captured; name the document instead.
                    $('#agreementProofCaption').html('<strong>Service Agreement ' + esc(agreementVersion) + '</strong><br/>'
                        + esc(documentUrl) + '<br/>Signed on this page on ' + esc(new Date().toString()));
                    $('#agreementDocumentBox').hide();
                    $('#agreementProofCaption').show();
                    window.html2canvas(document.getElementById('agreementSignSection'), { scale: 1, backgroundColor: '#ffffff', logging: false })
                        .then(function (canvas) {
                            try { finish(canvas.toDataURL('image/jpeg', 0.8)); } catch (e) { finish(null); }
                        })
                        .catch(function () { finish(null); });
                } catch (e) {
                    finish(null);
                }
            });
        }

        function submitSignature(data, $btn, fail) {
            $.post(signUrl, data).done(function (res) {
                if (res && res.success) {
                    render(res.agreement);
                    if (window.swal && swal.fire) swal.fire('Service Agreement', res.message, 'success');
                    return;
                }
                fail(res && res.message || 'The agreement could not be signed.');
                $btn.prop('disabled', false);
            }).fail(function () {
                fail('The agreement could not be signed. Please try again later.');
                $btn.prop('disabled', false);
            });
        }

        $('.tab-menu li a[data-rel="tab-4"]').on('click', function () { if (!loaded) load(); });
    })(window.jQuery);
</script>
