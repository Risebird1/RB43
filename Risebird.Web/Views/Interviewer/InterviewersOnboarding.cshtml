<script>
    function InterviewerVideoConfirmationStatus(response) {
              $.ajax({
                    url: '/Interviewer/UpdateVideoConfirmationStatus',
                    type: 'POST',
                    data: { responsestatus: response },
                    success: function (data) {
                    document.getElementById("myintrestConfirmAccept").style.display = "none";
                    document.getElementById("videos").style.display = "none";
                    document.getElementById("questions").style.display = "block";
                    document.getElementById("questions").style.opacity = "1";
                    document.getElementById("video-btn").style.display = "block";
                    document.getElementById("video-btn").style.opacity = "1";
               }
               });
         }



    function AcceptIntrest() {
        var modal = document.getElementById("myintrestConfirmAccept");
        modal.style.display = "block";
        var modal1 = document.getElementById("continue-skip");
        modal1.style.display = "block";
   

    }
    function closeConfirmAccept() {
        var modal = document.getElementById("myintrestConfirmAccept");
        modal.style.display = "none";
    }
