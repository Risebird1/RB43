@model IEnumerable<Risebird.Entities.ViewModel.CodeInviteVM>
@using X.PagedList.Mvc.Core;
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "InviteCode List";
    ViewBag.PageHeader = "InviteCode List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<input type="hidden" id="txtrate" value="@Model.Count()" />*@

<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/demo.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/chardinjs.css" />

<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 6.9rem;
        right: -.3rem;
    }
</style>
<div class="main-panel" id="main-panel">
    <div class="jumbotron">
        <div class="pt30">
            <div class="col-md-12 nopad">
                <div class="card-header bg-w clearfix">
                    <img style="visibility:hidden" src="" data-position="right" />
                    <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                    <div class="pull-left">
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title"> InviteCode</h4></div>
                    </div>
                    <div class="pull-right">
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="SendInviteCodeBtn()" data-original-title="Tooltip on top"> <font style="font-family: Roboto, sans-serif; font-size:12px;">Send InviteCode</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div id="candidatefeedback_table" data-intro="<span style='font-size:16px;'>Overview the summary of Client Feedbacks</span><hr class='btop' />1. Candidate Name<br/> 2. JD Title<br/> 3. Rating <br/> 4. Comment <br/><a href='/CommonPool/Index' class='btn btn-primary allmeetingnext-btn'>NEXT</a>" data-position="top">
                                <div class="dataloading">
                                    <div style="overflow-x:scroll;overflow-y:hidden" class="scrollbar survey" id="style-2">
                                        <table id="codeinviteList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Candidate</th>
                                                    <th>Experience</th>
                                                    <th>Programming Language</th>
                                                    <th>Difficulty Level</th>
                                                    <th>Invite StartTime</th>
                                                    <th>Invite EndTime</th>
                                                    <th>Created At</th>
                                                    <th>Created By</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Candidate</th>
                                                    <th>Experience</th>
                                                    <th>Programming Language</th>
                                                    <th>Difficulty Level</th>
                                                    <th>Invite StartTime</th>
                                                    <th>Invite EndTime</th>
                                                    <th>Created At</th>
                                                    <th>Created By</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.candidateEmail</td>
                                                        <td class="candidate-details">@item.experience</td>
                                                        <td>@item.programmingLanguage</td>
                                                        <td>@item.difficultyLevel</td>
                                                        <td>@item.inviteStartTime</td>
                                                        <td>@item.inviteEndTime</td>
                                                        <td>@item.CreatedAt</td>s
                                                        <td>@item.CreatedBy</td>
                                                        <td>
                                                            <a target="_blank" href='@Url.Action("CodeInviteReport", "Interviewer", new { inviteid = item.inviteId, Id = item.Id })'>
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Report">
                                                                    <span title="Questions Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-7 12h-2v-2h2v2zm0-4h-2V6h2v4z" /></svg></span>
                                                                </button>
                                                            </a>
                                                            <button class="mdc-fab app-fab--absolute " aria-label="Generate URL">
                                                                <span title="Generate URL" onclick="javascript:GenerateCodeInviteUrl('@item.botURL');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg></span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!-- end content-->
                    </div>
                    <!--  end card  -->
                </div>
                <!-- end col-md-12 -->
            </div>
            <!-- end row -->



        </div>

    </div>
</div>

<div id="codeinviteModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                            <path fill="rgb(255, 255, 255)" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
                        </svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Code Invite</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closecodeinviteModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" style="padding-bottom:0px" id="divcodeinviteModel">
            </div>
        </div>
    </div>
</div>
<div id="PublicUrlShareModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><img class="publicsharing-icon" src="~/Newassets/img/share-1w.png"></span>
                </div>
                <h5 class="modal-title pull-left">Code Invite Url</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closePublicUrlShareModel()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="video-url">
                        <label class="label-field desp-label">Code Invite:  <b id="txtvideoUrls"> </b></label><button class="copy-btn" onclick="copyToClipboard('#txtvideoUrls')">
                            <p class="special-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                                <span id="special_text" class="special-text__tooltip">
                                    Copy Link
                                </span>
                            </p>
                        </button>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color: #fff; line-height: 13px;" type="button" onclick="closePublicUrlShareModel()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
<script>
    function searchResult() {
        $('#codeinviteList').DataTable();
    }
    function RefreshSearch() {
        $('#codeinviteList').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();

    });

    function applyDataTable() {
        $('#codeinviteList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

    $(document).ready(function () {
        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#codeinviteList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#codeinviteList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#codeinviteList").show();
        }, 2000);
    };

</script>

<script>
    function SendInviteCodeBtn() {
        $.ajax({
            url: '/Interviewer/SendInviteCode',
            success: function (data) {
                $('#divcodeinviteModel').html('');
                $('#divcodeinviteModel').html(data);
                OpenSendCodeInvite();
            }
        });
    }
    function OpenSendCodeInvite() {
        var modal = document.getElementById("codeinviteModel");
        modal.style.display = "block";
    }
    function closecodeinviteModel() {
        var modal = document.getElementById("codeinviteModel");
        modal.style.display = "none";
    }
    function GenerateCodeInviteUrl(inviteurl) {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "block";
        $("#txtvideoUrls").text(inviteurl);
    }
    function closePublicUrlShareModel() {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "none";
    }
    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }
</script>