<div id="RedoInterviewModel" class="modal modal-bg" style="z-index:5">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Redo Interview</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeRedoInterviewModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" id="divredoInterview">
            </div>
        </div>
    </div>
</div>
<script>
    function confirmAndOpenRedoInterview(trigger) {
        var interviewid = trigger && trigger.getAttribute ? trigger.getAttribute('data-interview-id') : trigger;
        var interviewstatus = trigger && trigger.getAttribute ? (trigger.getAttribute('data-interview-status') || '') : (arguments[1] || '');
        if (!interviewid) return;

        if (typeof swal === 'undefined' || !swal.fire) {
            OpenRedoFormModel(interviewid, interviewstatus);
            return;
        }
        swal.fire({
            title: 'Redo this interview?',
            html: 'This opens the existing redo request form. After you submit it, the redo details are saved and the interview is queued for the standard redo workflow (same as Completed Interviews today).',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Continue to redo form',
            cancelButtonText: 'Cancel',
            reverseButtons: true
        }).then(function (result) {
            if (result.isConfirmed) {
                OpenRedoFormModel(interviewid, interviewstatus);
            }
        });
    }

    function OpenRedoFormModel(interviewid, interviewstatus) {
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { interviewid: interviewid, interviewstatus: interviewstatus },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }

    function openRedoInterviewModel() {
        var modal = document.getElementById('RedoInterviewModel');
        if (modal) modal.style.display = 'block';
    }

    function closeRedoInterviewModel() {
        var modal = document.getElementById('RedoInterviewModel');
        if (modal) modal.style.display = 'none';
    }
</script>
