@model IEnumerable<Risebird.Entities.ViewModel.InterviewerProfessional>
@{
    ViewData["Title"] = "Employers";
    ViewBag.PageHeader = "Employers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=12345" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=12345" />
<div class="main-panel" id="main-panel">
  
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Employers</h4></div>
                </div>

                <div class="pull-right">
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interviewer" onclick="location.href='@Url.Action("AddEmployerDetails", "Interviewer", new { IProfileId = ViewBag.IProfileId})'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Employer</font></span>
                    </button>

                    @Html.ActionLink("Back To List", "Index", "Interviewer", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button", @style="margin-right:10px;" })

                </div>
            </div>
        </div>
    </div>

    <div class="content employee client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div style="overflow-x:scroll" class="scrollbar indexemp" id="style-2">
                                <table id="interviewer" class="table table-striped table-bordered" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Company Name</th>
                                            <th>Company Type</th>
                                            <th>Company Stage</th>
                                            <th>Company Size</th>
                                            <th>JobFunction</th>
                                            <th>Industry</th>
                                            <th>Headquarters</th>
                                            <th>Role</th>
                                            <th>Domain</th>
                                            <th>Seniority Level</th>
                                            <th>Experience</th>
                                            <th>Work Nature</th>
                                            <th>Primary Responsibility</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>Company Name</th>
                                            <th>Company Type</th>
                                            <th>Company Stage</th>
                                            <th>Company Size</th>
                                            <th>JobFunction</th>
                                            <th>Industry</th>
                                            <th>Headquarters</th>
                                            <th>Role</th>
                                            <th>Domain</th>
                                            <th>Seniority Level</th>
                                            <th>Experience</th>
                                            <th>Work Nature</th>
                                            <th>Primary Responsibility</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr id=@item.id>
                                                <td><span class="control-label">@item.CompanyName</span></td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().Type, (SelectList)ViewBag.CompanyTypeList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().CompanyStage, (SelectList)ViewBag.CompanyStageList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().Size, (SelectList)ViewBag.CompanySizeList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().JobFunctionId, (SelectList)ViewBag.JobFunction, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().IndustryId, (SelectList)ViewBag.Industry, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().Headquarters, (SelectList)ViewBag.CountryList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().Role, (SelectList)ViewBag.RoleList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "width:auto;cursor:default" })</td>
                                                <td>@item.Domain</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().SeniorityLevel, (SelectList)ViewBag.SeniorityLevelList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().ExperienceId, (SelectList)ViewBag.ExperienceRange, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().WorkNature, (SelectList)ViewBag.WorkNatureList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "width:auto;cursor:default" })</td>
                                                <td>@Html.DropDownListFor(m => m.Where(x => x.id == item.id).FirstOrDefault().PrimaryResponsibility, (SelectList)ViewBag.PrimaryResponsibilityList, new { id = "drp_CompanyType", @class = "form-control text-box single-line", @disabled = "disabled", @style = "width:auto;cursor:default" })</td>

                                                <td class="text-right">
                                                    <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit Interviewer">
                                                        <span onclick="location.href = '@Url.Action("EditEmployerDetails", "Interviewer", new { id = item.id, IProfileId = @ViewBag.IProfileId })'" title="Click here to edit Interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                    </button>
                                                    <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete Interviewer">
                                                        <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.CompanyName');" title="Click here to delete Interviewer" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>

                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                            </div>
                            @*<div>
            @Html.HiddenFor("InterviewerProfileId", Model.Where)
        </div>*@

                        </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>




@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        location.reload();

                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        location.reload();

                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script>
    function searchResult() {
        $('#interviewer').DataTable();
    }
    function RefreshSearch() {
        $('#interviewer').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {

        var table = $('#interviewer').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };
 
      function DeleteEntityfromEnvironment(id, CompanyName) {
        swal.fire({
            title: 'Are you sure you want to delete ' + CompanyName + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeleteEmployerDetails',
                        //data: { 'id': id },
                        data: { 'id': id, 'IProfileId': @ViewBag.IProfileId },
                        type: 'Delete',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The Employer has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                })
                    .then(function () {
                    window.location = "/Interviewer/IndexEmployer/" + @ViewBag.IProfileId;
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
      }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>