@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        location.reload();
                       
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        location.reload();

                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script>
    $(document).ready(function () {




        $('#interviewer').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: false,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });


        var table = $('#interviewer').DataTable();


    });

   
      function DeleteEntityfromEnvironment(id, CompanyName) {
        swal.fire({
            title: 'Are you sure you want to delete ' + CompanyName + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeleteEmployerDetails',
                        //data: { 'id': id },
                        data: { 'id': id, 'IProfileId': @ViewBag.IProfileId },
                        type: 'Delete',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The Employer has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                })
                    .then(function () {
                    window.location = "/Interviewer/IndexEmployer/" + @ViewBag.IProfileId;
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
      }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>