                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group" style="display:none">
                                        @Html.Hidden("UserId", Model.UserId, htmlAttributes: new { id = "hdn_UserId" })
                                    </div>

                                    <div class="form-group">
                                        @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { id = "txt_FirstName", @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DOB, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.DOB, new { htmlAttributes = new { id = "DOB", placeholder = "MM/dd/yyyy", @class = "form-control text-box single-line", type = "date" } })
                                        @Html.ValidationMessageFor(model => model.DOB, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { id = "txt_EmailId", @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.EmailId, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.MobileNumber, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { id = "txt_MobileNumber", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.MobileNumber, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Experience, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.Experience, new { htmlAttributes = new { id = "txt_Experience", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.Experience, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.GitHubLink, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.GitHubLink, new { htmlAttributes = new { id = "txt_GitHubLink", @class = "form-control text-box single-line", @type = "text" } })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Blog, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.Blog, new { htmlAttributes = new { id = "txt_Blog", @class = "form-control text-box single-line", @type = "text" } })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsLeadInterviewer, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.IsLeadInterviewer, new { htmlAttributes = new { id = "txt_IsLeadInterviewer", @class = "form-control text-box single-line", @type = "text", @Value = "false" } })
                                        @Html.ValidationMessageFor(model => model.IsLeadInterviewer, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { id = "txt_LastName", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.Label("DOB", "Age", htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.TextBox("txt_Age", null, new { id = "txt_Age", @class = "form-control" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.AltEmailId, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.AltEmailId, new { htmlAttributes = new { id = "txt_AltEmailId", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AltEmailId, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.AltMobileNumber, htmlAttributes: new { @class = "control-label col-md-8 col-sm-8 col-lg-8 desp-label" })
                                        @Html.EditorFor(model => model.AltMobileNumber, new { htmlAttributes = new { id = "txt_AltMobileNumber", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.AltMobileNumber, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PreferredDomain, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.PreferredDomain, new { htmlAttributes = new { id = "txt_PreferredDomain", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.PreferredDomain, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.StackOverflowLink, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.StackOverflowLink, new { htmlAttributes = new { id = "txt_StackOverflowLink", @class = "form-control text-box single-line", @type = "text" } })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Country, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.DropDownListFor(model => model.Country, (SelectList)Model.CountryList, new { id = "drp_Country", @class = "form-control text-box single-line" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { id = "txt_IsActive", @class = "form-control text-box single-line", @type = "text", @Value = "false" } })
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-4 col-sm-4 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NickName, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.NickName, new { htmlAttributes = new { id = "txt_NickName", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.NickName, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.DropDownListFor(model => model.Gender, (SelectList)Model.GenderList, new { id = "drp_Gender", @class = "form-control text-box single-line" })
                                        @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CurrentRole, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.CurrentRole, new { htmlAttributes = new { id = "txt_CurrentRole", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.CurrentRole, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsApproved, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label" })
                                        @Html.EditorFor(model => model.IsApproved, new { htmlAttributes = new { id = "txt_IsApproved", @class = "form-control text-box single-line", @type = "text", @Value = "false" } })
                                        @Html.ValidationMessageFor(model => model.IsApproved, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LinkedinLink, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.LinkedinLink, new { htmlAttributes = new { id = "txt_LinkedinLink", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.LinkedinLink, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.City, htmlAttributes: new { @class = "control-label col-md-4 col-sm-2 desp-label " })
                                        @Html.EditorFor(model => model.City, new { htmlAttributes = new { id = "txt_City", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        Upload Resume
                                        <input id="Resume" name="Resume" value="Upload" type="radio" checked="checked" onclick="RadioChanged(this.value)">
                                        |  Coded Resume
                                        <input id="Resume" name="Resume" value="Link" type="radio" onclick="RadioChanged(this.value)">
                                    </div>
                                    <div style="display:none" id="linkDiv">
                                        @Html.LabelFor(model => model.CodedResumeFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.CodedResumeFile, new { id = "txt_CodedResumeFile", type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                    </div>
                                    <div class="" id="uploadDiv">
                                        @Html.LabelFor(model => model.ResumeFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.TextBoxFor(model => model.ResumeFile, new { id = "txt_ResumeFile", type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                    </div>
                                    <div>
                                            @if (Model.ResumeLink != null)
                                            {
                                                <a id="resumeId" target="_blank" title="Resume" href=@Model.ResumeLink>Resume  </a>
                                            }
                                        </div>
                                        <div>
                                            @if (Model.CodedResumeLink != null)
                                            {
                                                <a id="codedResumeId" target="_blank" title="CodedResume" href=@Model.CodedResumeLink>Coded Resume</a>
                                            }
                                        </div>
                                    @Html.Hidden("ResumeLink", Model.ResumeLink, htmlAttributes: new { id = "hdn_ResumeLink" })
                                        @Html.Hidden("CodedResumeLink", Model.CodedResumeLink, htmlAttributes: new { id = "hdn_CodedResumeLink" })
                                    @*@Html.HiddenFor(m => m.ResumeLink, Model.ResumeLink)
                                        @Html.HiddenFor(m => m.CodedResumeLink, Model.CodedResumeLink)*@
                                </div>
                            </div>
                            <!-- INterviewer personal Details End-->
                            <!-- Availability Details start-->
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Availability Details</h2>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="table-responsive">
                                        <table class="table table-bordered mbn" id="availabilityDetailsTable">
                                            <thead class="tableHeaderClass">
                                                <tr>
                                                    <th width="20%" class="table_heading">Week Day</th>
                                                    <th width="20%" class="table_heading">Week End</th>
                                                    <th width="5%" class="table_heading">Is Available On Public Holidays</th>
                                                    <th width="10%" class="table_heading">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.InterviewerAvailabilityDetails == null || Model.InterviewerAvailabilityDetails.Count() == 0)
                                                {
                                                    <tr>
                                                        <td>
                                                            @Html.DropDownList("InterviewerAvailabilityDetails[0].Weekday", (SelectList)Model.WeekDayList, new { id = "drp_Weekday", @class = "form-control text-box single-line" })
                                                        </td>
                                                        <td>
                                                            @Html.DropDownList("InterviewerAvailabilityDetails[0].Weekend", (SelectList)Model.WeekEndList, new { id = "drp_Weekend", @class = "form-control text-box single-line" })
                                                        </td>
                                                        <td>
                                                            <div class="checkbox checkbox-danger">
                                                                @Html.CheckBox("InterviewerAvailabilityDetails[0].IsAvailableOnPublicHolidays", new { id = Html.Name("InterviewerAvailabilityDetails[0].IsAvailableOnPublicHolidays") })
                                                                <label for="@Html.Name("InterviewerAvailabilityDetails[0].IsAvailableOnPublicHolidays")">Is Available On Public Holidays</label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <span id="btnPlus" onclick="addAvailabilityDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                            <span id="btnMinus" onclick="deleteRowAvailabilityDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    for (int i = 0; i < Model.InterviewerAvailabilityDetails.Count(); i++)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @Html.DropDownListFor(m => m.InterviewerAvailabilityDetails[i].Weekday, (SelectList)Model.WeekDayList, new { id = "drp_Weekday", @class = "form-control text-box single-line" })
                                                            </td>
                                                            <td>
                                                                @Html.DropDownListFor(m => m.InterviewerAvailabilityDetails[i].Weekend, (SelectList)Model.WeekEndList, new { id = "drp_Weekend", @class = "form-control text-box single-line" })
                                                            </td>
                                                            <td>
                                                                <div class="checkbox checkbox-danger">
                                                                    @Html.CheckBoxFor(x => x.InterviewerAvailabilityDetails[i].IsAvailableOnPublicHolidays, new { id = Html.NameFor(x => x.InterviewerAvailabilityDetails[i].IsAvailableOnPublicHolidays) })
                                                                    <label for="@Html.NameFor(x => x.InterviewerAvailabilityDetails[i].IsAvailableOnPublicHolidays)">Is Available On Public Holidays</label>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <span id="btnPlus" onclick="addAvailabilityDetails()" class="btn btn-round btn-primary btn-icon btn-sm "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="deleteRowAvailabilityDetails(this, 'SkillCollection','LevelId','SkillId','Weightage','','TechDelete')" class="btn btn-round btn-danger btn-icon btn-sm delete-row"><i class="far fa  fa-trash"></i></span>
                                                            </td>
                                                        </tr>
                                                    }
                                                }


                                            </tbody>
                                        </table>
                                        <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:815px"></label>

                                    </div>
                                </div>

                            </div>
                            <!-- Availabality Details end-->
                            <!-- Account Details start-->
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Account Details</h2>
                                    </div>
                                </div>
