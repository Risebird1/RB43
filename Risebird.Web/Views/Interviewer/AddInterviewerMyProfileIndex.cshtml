                                            <div class="form-group">
                                                <label class="control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" for="accountNum"> UPI ID</label>
                                                @Html.TextBoxFor(m => m.InterviewerAccDetails[i].UPIId, null, new { id = "txt_UPIId", @class = "form-control text-box single-line" })
                                            </div>
                                        </div>
                                        <div class="col-md-2 col-sm-2pr-1">
