    <script>

        $(document).ready(function () {
            $("#txt_ConfirmAccountNumber").change(function () {
                var firstInput = document.getElementById("txt_AccountNumber").value;
                var secondInput = document.getElementById("txt_ConfirmAccountNumber").value;
                if (firstInput !== secondInput)
                    alert("Account Number Not match!");
            });
        });

        function addAvailabilityDetails() {
            var x = document.getElementById('availabilityDetailsTable');
            var rowLen = x.rows.length;
            console.log("Row Length:: " + rowLen);
            if (rowLen > 14) {
                alert("Cannot add more than 14 Availability Detaiils.");
                return;
            }
            else {
                var new_row = x.rows[1].cloneNode(true);
                x.appendChild(new_row);
            }
        }

        function deleteRowAvailabilityDetails(row) {
            var x = document.getElementById('availabilityDetailsTable');
            // get the total number of rows
            var rowLen = x.rows.length;
            console.log("Row Length to delete:: " + rowLen);
            if (rowLen == 2) {
                alert('Must have atleast one Row');
                return false;
            }
            else {
                var i = row.parentNode.parentNode.rowIndex;
                document.getElementById('availabilityDetailsTable').deleteRow(i);
            }
        }

    </script>
