@model Risebird.Entities.ViewModel.InterviewerProfileVM

@{
    ViewData["Title"] = "Add Interviewer Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/Validations/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/assets/Validations/jquery.validate.min.js"></script>
<script src="~/assets/Validations/jquery.validate.unobtrusive.min.js"></script>


<script src="sweetalert2.all.min.js"></script>
<script src="sweetalert2.min.js"></script>
<link rel="stylesheet" href="sweetalert2.min.css">

<style>
    .multiple_row > h2 {
        font-size: 18px;
        background-color: #013855;
        padding: 8px 10px;
        text-align: left;
        color: #ffffff;
        margin-top: 45px;
    }

    #btnPlus, #btnMinus {
        padding: 2px;
    }

    #btnMinus {
        position: absolute;
        margin-left: 12px;
    }

    #btnPlus {
        background-color: #4a89dc;
    }

    .glyphicon {
        top: -1px;
        right: -2px;
        vertical-align: middle;
        line-height: 0;
    }

    .table-responsive {
        overflow: hidden;
    }
</style>
<!-- Style added by Vishwanath for AddInterviewerProfile-->>
<style>
    .table-responsive {
        width: 98%;
    }

    .tableHeaderClass {
        text-align: center;
    }

    .fieldHeader {
        text-align: center;
    }

    .myTextArea-form-control {
        resize: vertical;
        border: none;
        border-radius: 0;
        line-height: 2;
    }
</style>
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand breadcrumscolor" href="/IRF/Index">Add Interviewer Profile form</a>
                <a class="navbar-brand">Add Interviewer My Profile </a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>

    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">

                        @using (Html.BeginForm("AddInterviewerMyProfile", "Interviewer", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <!-- Add Interviewer personal Details Start-->
