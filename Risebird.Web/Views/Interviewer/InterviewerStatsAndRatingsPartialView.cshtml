@model IEnumerable<Risebird.Entities.ViewModel.InterviewerStatsVM>

<div id="tableID" class="second" style="overflow-x:scroll">
    <table id="listTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>Interviewer</th>
                <th>Total Penalties</th>
                <th>Total Meetings</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Pending</th>
                @*<th>Actions</th>*@
            </tr>
        </thead>
        <tfoot>
            <tr>
                <th>Interviewer</th>
                <th>Total Penalties</th>
                <th>Total Meetings</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Pending</th>
                @*<th>Actions</th>*@
            </tr>
        </tfoot>
        <tbody>

            @if (Model != null && Model.Count() > 0)
            {
                foreach (var item in Model)
                {

                    <tr>
                        @if (!string.IsNullOrEmpty(item.InterviewerEmailId))
                        {
                            <td> @item.InterviewerEmailId </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>@item.TotalPenalties</td>
                        <td>@item.TotalMeetings</td>
                        <td>@item.TotalSelected</td>
                        <td>@item.TotalBorderLine</td>
                        <td>@item.TotalRejected</td>
                        <td>@item.TotalProxy</td>
                        <td>@item.TotalDropped</td>
                        <td>@item.TotalSelfNoShow</td>
                        <td>@item.TotalNoShowCandidate</td>
                        <td>@item.TotalPending</td>
                        @*<td></td>*@


                    </tr>


                }
            }

        </tbody>

    </table>





</div>
