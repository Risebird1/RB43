@model IEnumerable<Risebird.Entities.ViewModel.InterviewerStatsVM>
@{
    string customHeight = "none";
    if (ViewBag.DisplayType == "popup")
    {
        customHeight = "450px";
    }
    int irfId = 0;
    if (ViewBag.irfId != null)
    {
        irfId = Convert.ToInt32(ViewBag.irfId);
    }
}
<div id="tableID" class="second" style="overflow-x:scroll; max-height: @customHeight" ">
    <table id="listTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>Interviewer</th>
                <th>Resume</th>
                <th>Penalty Count</th>
                <th>Client Rating</th>
                <th>Total Meetings</th>
                <th>Total Completed</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Scheduled</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tfoot>
            <tr>
                <th>Interviewer</th>
                <th>Resume</th>
                <th>Penalty Count</th>
                <th>Client Rating</th>
                <th>Total Meetings</th>
                <th>Total Completed</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Scheduled</th>
                <th>Actions</th>
            </tr>
        </tfoot>
        <tbody>

            @if (Model != null && Model.Count() > 0)
            {   
                int i = 0;
                foreach (var item in Model)
                {

                    <tr>
                        @if (!string.IsNullOrEmpty(item.InterviewerEmailId))
                        {
                            <td> @item.InterviewerEmailId </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (item.ResumeLink != null && item.ResumeLink != "")
                        {
                            <td class="text-center">
                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                            </td>
                        }
                        else
                        {
                            <td class="text-center">No Resume</td>
                        }
                        <td>@item.TotalPenalties</td>
                        <td>@(!string.IsNullOrEmpty(item.AverageClientRating) ? item.AverageClientRating : string.Empty)</td>
                        <td>@item.TotalMeetings </td>
                        <td>@item.TotalCompletedMeetings </td>
                        <td>@item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalSelected { @(item.TotalCompletedMeetings != 0 ? (item.TotalSelected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalBorderLine { @(item.TotalCompletedMeetings != 0 ? (item.TotalBorderLine * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalRejected { @(item.TotalCompletedMeetings != 0 ? (item.TotalRejected * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalProxy { @(item.TotalCompletedMeetings != 0 ? (item.TotalProxy * 100 / item.TotalCompletedMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalSelfNoShow { @(item.TotalMeetings != 0 ? (item.TotalSelfNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalNoShowCandidate { @(item.TotalMeetings != 0 ? (item.TotalNoShowCandidate * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td class="text-center">
                        @if (item.InterviewerPhone != null && item.InterviewerPhone != string.Empty)
                        {
                            <span class="interviewer_14"><span class="call" data-toggle="tooltip" data-placement="top" onclick="CommonCallButtonClick('@item.InterviewerEmailId', '@item.InterviewerPhone', '@item.InterviewerEmailId')" data-original-title="Tooltip on top"><span title="Click here to call the interviewer" class="mdc-fab app-fab--absolute" style="top: -3px;left:1px;"><span class="fa fa-phone-alt"></span></span></span></span>

                        }
                        @if (irfId > 0)
                        {
                            <span>
                                <button  class="mdc-fab app-fab--absolute trash-btn" title="Click here to deactivate interviewer">
                                    <span title="Click here to deactivate Interviewer Profile" onclick="javascript:DeactivateInterviewer('@irfId', '@item.InterviewerEmailId', this.id);" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                </button>
                            </span>
                        }
                        
                        </td>


                    </tr>
                    i++;

                }
            }

        </tbody>

    </table>


    @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")




</div>
<script>
    function DeactivateInterviewer(irfId, interviewerEmail, elementId) {
        debugger;
        swal.fire({
            title: 'Are you sure?',
            text: "The interviewer (" + interviewerEmail + ") will be deactivated from this skill channel!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, deactivate!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeactivateSkillChannelInterviewer?irfId=' + irfId + '&interviewerEmail=' + interviewerEmail,
                        type: "POST",
                        success: function (result) {
                            if (result == true) {
                                
                                resolve(result)

                            }
                            else {
                                swal.fire("Error while deactivating!", "Please try again", "error");

                            }

                        },
                        error: function () {

                            swal.fire("Error archiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deactivated!',
                    type: 'success',
                    html: '<p>The interviewer '  + interviewerEmail + ' has been deactivated.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {

                    //var element = document.getElementById(elementId);
                    //if(element != null)
                    //{
                    //    $(element).closest('tr').remove();
                        
                    //}
                    

                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled!:)',
                    'error'
                )
            }
        })


    }

</script>
