@model IEnumerable<Risebird.Entities.ViewModel.InterviewerStatsVM>
@{
    string customHeight = "none";
    if (ViewBag.DisplayType == "popup")
    {
        customHeight = "450px";
    }
}
<div id="tableID" class="second" style="overflow-x:scroll; max-height: @customHeight" ">
    <table id="listTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>Interviewer</th>
                <th>Resume</th>
                <th>Penalty Count</th>
                <th>Client Rating</th>
                <th>Total Meetings</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Scheduled</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tfoot>
            <tr>
                <th>Interviewer</th>
                <th>Resume</th>
                <th>Penalty Count</th>
                <th>Client Rating</th>
                <th>Total Meetings</th>
                <th>Status Pending</th>
                <th>Selected</th>
                <th>Borderline</th>
                <th>Rejected</th>
                <th>Proxy</th>
                <th>Dropped</th>
                <th>No Show(Interviewer)</th>
                <th>No Show(Candidate)</th>
                <th>Scheduled</th>
                <th>Actions</th>
            </tr>
        </tfoot>
        <tbody>

            @if (Model != null && Model.Count() > 0)
            {
                foreach (var item in Model)
                {

                    <tr>
                        @if (!string.IsNullOrEmpty(item.InterviewerEmailId))
                        {
                            <td> @item.InterviewerEmailId </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        @if (item.ResumeLink != null && item.ResumeLink != "")
                        {
                            <td class="text-center">
                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                            </td>
                        }
                        else
                        {
                            <td class="text-center">No Resume</td>
                        }
                        <td>@item.TotalPenalties</td>
                        <td>@(!string.IsNullOrEmpty(item.AverageClientRating) ? item.AverageClientRating : string.Empty)</td>
                        <td>@item.TotalMeetings </td>
                        <td>@item.StatusPending { @(item.TotalMeetings != 0 ? (item.StatusPending * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalSelected { @(item.TotalMeetings != 0 ? (item.TotalSelected * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalBorderLine { @(item.TotalMeetings != 0 ? (item.TotalBorderLine * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalRejected { @(item.TotalMeetings != 0 ? (item.TotalRejected * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalProxy { @(item.TotalMeetings != 0 ? (item.TotalProxy * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalDropped { @(item.TotalMeetings != 0 ? (item.TotalDropped * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalSelfNoShow { @(item.TotalMeetings != 0 ? (item.TotalSelfNoShow * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.TotalNoShowCandidate { @(item.TotalMeetings != 0 ? (item.TotalNoShowCandidate * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td>@item.Scheduled { @(item.TotalMeetings != 0 ? (item.Scheduled * 100 / item.TotalMeetings).ToString() : "NA")% }</td>
                        <td class="text-center">
                        @if (item.InterviewerPhone != null && item.InterviewerPhone != string.Empty)
                        {
                            <span class="call" data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@item.InterviewerEmailId', '@item.InterviewerPhone', '@item.InterviewerEmailId')" data-original-title="Tooltip on top"><span class="btn-call"><span class="fa fa-phone-alt"></span></span></span>
                        }
                          
                        </td>


                    </tr>


                }
            }

        </tbody>

    </table>


    @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")




</div>
<script src="~/js/twiliocallmaker.js"></script>