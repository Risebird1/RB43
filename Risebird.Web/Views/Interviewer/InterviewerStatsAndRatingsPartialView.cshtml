<div id="interviewerFlagDetailsModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="memberHeading">Interviewer Details</h5>
            </div>
            <button onclick="closeinterviewerFlagDetailsModal()" type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="FlagDetailsTablebody" style="overflow:auto;max-height:30vw">
            </div>
        </div>
    </div>
</div>
<script>
    function DeactivateInterviewer(irfId, interviewerEmail, elementId) {
        swal.fire({
            title: 'Are you sure?',
            text: "The interviewer (" + interviewerEmail + ") will be deactivated from this skill channel!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, deactivate!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeactivateSkillChannelInterviewer?irfId=' + irfId + '&interviewerEmail=' + interviewerEmail,
                        type: "POST",
                        success: function (result) {
                            if (result == true) {

                                resolve(result)

                            }
                            else {
                                swal.fire("Error while deactivating!", "Please try again", "error");

                            }

                        },
                        error: function () {

                            swal.fire("Error archiving!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deactivated!',
                    type: 'success',
                    html: '<p>The interviewer ' + interviewerEmail + ' has been deactivated.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {

                    //var element = document.getElementById(elementId);
                    //if(element != null)
                    //{
                    //    $(element).closest('tr').remove();

                    //}


                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled!:)',
                    'error'
                )
            }
        })


    }

</script>
<script>
    function closeinterviewerFlagDetailsModal() {
        var modal = document.getElementById("interviewerFlagDetailsModal");
        modal.style.display = "none";
    }
    function OpenInterviewerFlagDetails(Emailid) {
        $.ajax({
            url: '/Interviewer/FetchInterviewerFlagDetails',
            data: { 'InterviewerEmailid': Emailid },
            success: function (data) {
                var modal = document.getElementById("interviewerFlagDetailsModal");
                modal.style.display = "block";
                $('#FlagDetailsTablebody').html('');
                $('#FlagDetailsTablebody').html(data);
            }
        });
    }
</script>