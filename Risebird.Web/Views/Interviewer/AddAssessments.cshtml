
@model Risebird.Entities.ViewModel.AssignmentVM

@{
    ViewData["Title"] = "Interviewers Assessment";
    ViewBag.PageHeader = "Add Interviewers Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">

    <div class="mt50">
    </div>
    <div class="content client assesment">
        <div class="row bg-white">
            <div class="col-md-12">
                <div class="mdc-card card bg-white">

                    <div class="mdc-card-wrapper__text-section">



                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>
                            <div class="row">


                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Interviewers Assessment</h4></div>
                                </div>



                            </div>
                            <div style="clear:both;padding:10px"></div>
                            <div class="row">
                                @using (Html.BeginForm("AddAssessments", "Interviewer", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                {

                                    @Html.AntiForgeryToken()

                                    <div class="form-horizontal w-full">
                                        <div class="clearfix">
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.AssessmentGroup, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.AssessmentGroup, Model.AssessmentGrouplist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.AssessmentGroup, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.AssessmentType, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.AssessmentType, Model.AssessmentTypelist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.AssessmentType, "", new { @class = "text-danger" })
                                        </div>





                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.Senioritylevel, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.Senioritylevel, Model.Senioritylevellist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.Senioritylevel, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.YearsofExprience, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.YearsofExprience, Model.YearsofExpriencelist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.YearsofExprience, "", new { @class = "text-danger" })
                                        </div>


                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.TestedSkill, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.TestedSkill, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.TestedSkill, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.Evaluation, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.Evaluation, Model.Evaluationlist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.Evaluation, "", new { @class = "text-danger" })
                                        </div>


                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.Environment, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.Environment, new { placeholder = "Skill related IDE i.e. Visual Studio/Code or Java Development", @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Environment, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.Difficultylevel, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.Difficultylevel, new { placeholder = "Example 90 Percentile", @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Difficultylevel, "", new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.EmployerType, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.EmployerType, new { placeholder = "Service Based or Product Based", @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.EmployerType, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.EmployerStage, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.EmployerStage, Model.EmployerStagelist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.EmployerStage, "", new { @class = "text-danger" })
                                        </div>


                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.EmployerSize, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.DropDownListFor(m => m.EmployerSize, Model.EmployerSizelist, htmlAttributes: new { @class = "select-css form-control webkitEnabled" })
                                            @Html.ValidationMessageFor(model => model.EmployerSize, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-4  col-md-4 col-sm-4  pull-left">
                                            @Html.LabelFor(model => model.Delivery, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.Delivery, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Delivery, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-lg-12  col-md-12 col-sm-12  pull-left">
                                            @Html.LabelFor(model => model.Overview, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                            @Html.TextBoxFor(m => m.Overview, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Overview, "", new { @class = "text-danger" })
                                        </div>
                                        @*Questions*@
                                        <div class="clearfix"></div>
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            <div class="table-responsive-sm">
                                                <table class="table table-bordered mbn" id="QuestionsTable">
                                                    <thead>
                                                        <tr>
                                                            <th>Question Covered</th>
                                                            <th>Skills</th>
                                                            <th width="15%">Level</th>
                                                            <th>Time(In Mins)</th>
                                                            <th>VideoLink</th>
                                                            <th class="action text-center">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                @Html.TextBox("Questionslist[0].QuestionCovered", null, new { @class = "form-control text-box single-line" })
                                                            </td>
                                                            <td>
                                                                @Html.TextBox("Questionslist[0].Skills", null, new { @class = "form-control", @style = "background: #f5f5f5" })

                                                            </td>
                                                            <td>
                                                                @Html.DropDownList("Questionslist[0].Level", (SelectList)Model.AssessmentLevellist, new { @class = "select-css form-control" })

                                                            </td>
                                                            <td>
                                                                <input class="form-control text-box single-line" id="Questionslist_0__Time" name="Questionslist[0].Time" type="number" min="1" style="background: #f5f5f5;">
                                                            </td>
                                                            <td>
                                                                @Html.TextBox("Questionslist[0].VideoLink", null, new { @class = "form-control" })
                                                            </td>
                                                            <td class="action text-center">
                                                                <span id="btnPlus" onclick="AddRow()" class="mdc-fab app-fab--absolute "><i class="fas  fa fa-plus"></i></span>
                                                                <span id="btnMinus" onclick="DeleteRow(0)" class="mdc-fab app-fab--absolute trash-btn"><i class="far fa  fa-trash"></i></span>

                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-md-12">
                                            <div class="card-footer" style="margin-top: 15px;">
                                                <div class="row">
                                                    <div class="col-md-12 mc-button-area">
                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                }
                            </div>
                            <div style="clear:both"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>
<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#btnSearch").on('click', function () {
            var value = $("#searchinput").val();
            window.location.href = "/IRF/InterviewerDetail?Searchvalue=" + value;
        });
    });
    var flag = true;
    function callingfunction(value) {
        if (flag == true) {
            window.location.href = "/IRF/InterviewerDetailById?Id=" + value;
        } else {
            flag = true;
        }
    }
    function callatag() {
        flag = false;
    }
    function AddIRF() {
        var array = [];

        $("input:checkbox[name=chkinterviewer]:checked").each(function () {
            array.push($(this).val());
        });
        if (array.length > 0) {
            window.location.href = "/IRF/Add?IntrviewerId=" + array.toString();

        }
        else {
            alert("Please Select atleast one Interviewer.");
        }
    }
    function AddRow() {
        var $ttc = $("#QuestionsTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#QuestionsTable tr").length - 1;
        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })

        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");
        $tr.find("a").val("");
        // add cloned row as last row
        $("#QuestionsTable").find("tbody tr:last").after($tr);
        // Find the affected form
        var $form = $tr.closest("FORM");
        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);
        // Check document for changes
        $.validator.unobtrusive.parse(document);

    }
</script>
