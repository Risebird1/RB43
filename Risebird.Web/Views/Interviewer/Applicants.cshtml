@model IEnumerable<Risebird.Entities.ViewModel.InterviewerDirectApplicationVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Applicants";
    ViewBag.PageHeader = "Applicants";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;

}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Applicants</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @* <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                        <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                        <div class="mdc-button__ripple"></div>
                        </button> *@

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="flnTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Applicant EmailId</th>
                                                    <th>Resume</th>
                                                    <th>Applied On</th>
                                                    <th>Skill Channel</th>
                                                    <th>JD Title</th>
                                                    <th>Assessment Group</th>
                                                    <th>Channel Owner</th>
                                                    <th>Channel Created On</th>
                                                    <th>Is Employment Verified</th>
                                                    <th>Is Employed</th>
                                                    <th>Company Name</th>
                                                    <th>EV Generated On</th>
                                                    <th>EV Generated By</th>
                                                    <th>AI Verdict</th>
                                                    <th>AI Verdict Generated On</th>
                                                    <th>AI Verdict Url</th>
                                                    <th>Acknowledgement Status</th>
                                                    <th>Referred By</th>
                                                    <th>Phone</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Applicant EmailId</th>
                                                    <th>Resume</th>
                                                    <th>Applied On</th>
                                                    <th>Skill Channel</th>
                                                    <th>JD Title</th>
                                                    <th>Assessment Group</th>
                                                    <th>Channel Owner</th>
                                                    <th>Channel Created On</th>
                                                    <th>Is Employment Verified</th>
                                                    <th>Is Employed</th>
                                                    <th>Company Name</th>
                                                    <th>EV Generated On</th>
                                                    <th>EV Generated By</th>
                                                    <th>AI Verdict</th>
                                                    <th>AI Verdict Generated On</th>
                                                    <th>AI Verdict Url</th>
                                                    <th>Acknowledgement Status</th>
                                                    <th>Referred By</th>
                                                    <th>Phone</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {

                                                        <tr>

                                                            <td>@item.EmailId</td>
                                                            @if (item.ResumeLink != null && item.ResumeLink != "")
                                                            {
                                                                @if (item.ResumeLink != null && item.ResumeLink != "")
                                                                {
                                                                    <td> <a style="padding:0px;" id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink><img style="position:relative;left:-4px;" src="/img/resume-icon.png" width="16">Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                            <td>@item.CreatedAt</td>
                                                            <td>@item.SkillChannelName</td>
                                                            <td>@item.JDTiltle</td>
                                                            <td>@item.AssessmentGroup</td>
                                                            <td>@item.ChannelOwner</td>
                                                            <td>@item.ChannelCreationDate</td>
                                                            @if(item.isVerified)
                                                            {
                                                                <td id="id_isVerified_@item.id">Yes</td>

                                                            }
                                                            else
                                                            {
                                                                <td id="id_isVerified_@item.id"></td>
                                                            }
                                                            @if (item.IsEmployed)
                                                            {
                                                                <td id="id_IsEmployed_@item.id">Yes</td>

                                                            }
                                                            else
                                                            {
                                                                <td id="id_IsEmployed_@item.id"></td>
                                                            }
                                                            <td id="id_CompanyName_@item.id">@item.CompanyName</td>
                                                            <td>@item.EVGeneratedAt</td>
                                                            <td>@item.EVGeneratedBy</td>
                                                            <td id="id_aiVerdict_@item.id">@item.AIVerdict</td>
                                                            @if (item.AIEvaluationGeneratedAt.HasValue)
                                                            {
                                                                <td>
                                                                    @item.AIEvaluationGeneratedAt.Value)
                                                                </td>
                                                                <td>
                                                                    <a id="id_aiUrl_@item.id" target="_blank" href="@Url.Action("ApplicantAIEvaluation", "AIScreener", new { id = item.id })">Click</a>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                                <td>
                                                                    <a style="display:none" id="id_aiUrl_@item.id" target="_blank" href="@Url.Action("ApplicantAIEvaluation", "AIScreener", new { id = item.id })">Click</a>
                                                                </td>
                                                            }
                                                            <td>@item.AcknowledgementStatus</td>
                                                            <td>@item.ReferredBy</td>
                                                            <td>@item.Phone</td>
                                                            <td>
                                                                @if(!item.isVerified)
                                                                {
                                                                    <button id="btn_ev_@item.id" class="btn shadow btn-xs sharp me-1 trash-btn" aria-label="Verify Employment" style="width:23px!important;height:23px!important;background: #ee6f6f !important;position:relative;left:-6px;border-color:#ee6f6f!important">
                                                                        <span onclick="javascript:VerifyEVandNext('@item.Phone','@item.EmailId', '@item.SkillChannelName', '@item.id');" title="Verify Employment" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" style="position:relative;left:-1px;top:-2px;"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" style="position:relative;left:-2px;top:-2px;" /></svg>
                                                                        </span>
                                                                    </button>
                                                                }
                                                                

                                                                <button id="btn_aiVerdict_@item.id" class="btn shadow btn-xs sharp me-1" aria-label="Generate AI Verdict" style="width:23px!important;height:23px!important;background:#d18fec94;border:#d18fec94;position:relative;left:-6px;" disabled>

                                                                    <span onclick="javascript:GenerateAIVerdict('@item.id','@item.EmailId', '@item.JDTiltle', '@item.SkillChannelName');" title="Generate AI Verdict" class="mdc-fab__icon material-icons">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" style="position:relative;left:-1px;top:-2px;"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" style="position:relative;left:-2px;top:-2px;" /></svg>
                                                                    </span>
                                                                    
                                                                </button>

                                                            </td>

                                                        </tr>


                                                    }
                                                }

                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>

                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>


</div>











<script>

    function searchResult() {
        $('#flnTable').DataTable();
    }
    function RefreshSearch() {
        $('#flnTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#flnTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            order: [[1, 'desc']]
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#flnTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#flnTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#flnTable").show();
        }, 2000);
    };
        //// script for loader ends here
</script>

<script>
    function VerifyEVandNext(mobilenumber, candidateEmailid, skillChannel, id) {
        debugger;
        var buttonEV = document.getElementById("btn_ev_" + id);
        buttonEV.disabled = true;

        var buttonAI = document.getElementById("btn_aiVerdict_" + id);

        if (mobilenumber.trim() != '' && candidateEmailid.trim() != '') {
            $.ajax({
                url: '/Aadhaar/EvVerification',
                type: 'POST',
                data: { mobilenumber: mobilenumber, candidateemail: candidateEmailid, applicantId: id },
                success: function (result) {
                    if (result.message == null) {
                        
                        swal.fire('EV for ' + candidateEmailid + ' against skill channel ' + skillChannel + ' is successful. You may proceed with AI Verdict generation.');
                        document.getElementById('id_isVerified_' + id).innerHTML = 'Yes';
                        document.getElementById('id_IsEmployed_' + id).innerHTML = 'Yes';
                        document.getElementById('id_CompanyName_' + id).innerHTML = result.companyName;
                        buttonAI.disabled = false;
                    } else {
                        swal.fire(result.message);
                        document.getElementById('id_isVerified_' + id).innerHTML = 'Yes';
                        document.getElementById('id_IsEmployed_' + id).innerHTML = 'No';
                        //buttonEV.disabled = true;
                    }
                }
            });

        } else {
            swal.fire("Please enter Mobile Number and Email Address.");
        }

    }
</script>

<script>
    function GenerateAIVerdict(id, emailId, jdTitle, skillChannelName) {
        debugger;
        var buttonAI = document.getElementById("btn_aiVerdict_" + id);

        buttonAI.disabled = true;

        // Change the button text to "Processing...may take upto 30s! Please wait!"
        alert('AI Verdict for ' + emailId + ' against skill channel ' + skillChannelName + ' is under process...may take upto 30s! Please wait!');
        //button.innerHTML = "Processing...may take upto 30s! Please wait!";
        

        $.ajax({
            type: "POST",
            url: "/AIScreener/ApplicantAIScreening",
            data: { id: id },
            success: function (data) {
                debugger;
                if (data != null && (data.errorMessage == '' || data.errorMessage.includes('bypassed'))) {
                    if (data.isfavourableVerdict) {
                        document.getElementById("id_aiVerdict_" + id).innerHTML = 'Yes';

                        document.getElementById('id_aiUrl_' + id).style.display = "block";

                        swal.fire("Processed with favourable verdict! Acknowledgement sent to the interviewer: " + emailId + ' against skill channel: ' + skillChannelName + '.');
                        //buttonAI.disabled = false;
                    }
                    else if (!data.isfavourableVerdict && data.errorMessage.includes('bypassed')) {
                        document.getElementById("id_aiVerdict_" + id).innerHTML = 'Bypassed';

                        //document.getElementById('id_aiUrl_' + id).style.display = "block";

                        swal.fire("API Failure! Verdict bypassed! Acknowledgement sent to the interviewer: " + emailId + ' against skill channel: ' + skillChannelName + '.');
                        //buttonAI.disabled = false;
                    }
                    else {
                        
                        document.getElementById("id_aiVerdict_" + id).innerHTML = 'No';
                        swal.fire("Not a suitable Panel for this specialization. Not to be processed further.");
                        document.getElementById('id_aiUrl_' + id).style.display = "block";

                    }
                }
                else if (data != null && data.errorMessage != '') {
                    swal.fire(data.errorMessage);
                    buttonAI.disabled = false;
                }
                else {
                    swal.fire("Error generating verdict. Please try again later.");
                    buttonAI.disabled = false;
                }

            }
        });
    }
</script>


