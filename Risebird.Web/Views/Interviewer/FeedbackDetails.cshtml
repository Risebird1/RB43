<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true
                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/User/Interviewers';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/User/Interviewers';
                    }
                )
            }
        }
        window.onload = my_code();
    </script>
}


<script>

    function RefreshSearch() {
        $('#interviewer').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#interviewer').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search' style='right:50px;'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='right:30px;'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });
    $(document).ready(function () {
        $('#dataTables_filter').keyup(function () {
            oTable.fnFilter($(this).val());
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });


</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
