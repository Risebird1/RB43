@model Risebird.Entities.ViewModel.InterviewerProfileVM
<style>
    .paddingclass {
        padding-bottom: 10px !important;
    }
</style>

@Html.HiddenFor(m=>m.EmailId)
<div class="col-md-12 col-lg-12 paddingclass">
  
    <div class="col-md-6 col-lg-6">
        @Model.EmailId
    </div>
    @if (Model.LastLogin != null)
    {
            <div class="col-md-6 col-lg-6">
                @if (string.IsNullOrEmpty(Model.CreatedBy))
                {
                    @Model.LastLogin
                }
                else
                {
                    @(Model.LastLogin + " Added By - " + Model.CreatedBy)
                }
            </div>
   
    }
</div>


