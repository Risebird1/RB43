<table id="" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
    <thead>
        <tr>
             @if (Model.LastLogin != null)
            {
                <th> Last Login</th>
            }
            <th>Lead Interviewer</th>
            <th> Approved</th>
            <th> Active</th>
            <th> Interested</th>
            </tr>
            </thead>
    <tfoot>
        <tr>
              @if (Model.LastLogin != null)
{
            <th> Last Login</th>
}
            <th>Lead Interviewer</th>
            <th> Approved</th>
            <th> Active</th>
            <th> Interested</th>
            </tr>
            </tfoot>
    <tbody>
        <tr>
           
                @if (Model.LastLogin != null)
            {
                <td>
                @if (string.IsNullOrEmpty(Model.CreatedBy))
                {
                    @Model.LastLogin
                }
                else
                {
                    @(Model.LastLogin + " Added By - " + Model.CreatedBy)
                }
                </td>
}
          
            <td>
                <div class="custom-select">
                @Html.DropDownListFor(model => model.IsLeadInterviewer, new[]{   new SelectListItem { Text = "No", Value = "false" },
                new SelectListItem { Text = "Yes", Value = "true"} },new { @class = "text-box single-line",@onchange="changeIsLeadInterviewer()" })
                </div>
            </td>
            <td>
                <div class="custom-select">
                @Html.DropDownListFor(model => model.IsApproved, new[]{   new SelectListItem { Text = "No", Value = "false" },
                new SelectListItem { Text = "Yes", Value = "true"} },new { @class = "text-box single-line",@onchange="changeIsApproved()" })
           </div>
            </td>
            <td>
                <div class="custom-select">
                @Html.DropDownListFor(model => model.IsActive, new[]{   new SelectListItem { Text = "No", Value = "false" },
                new SelectListItem { Text = "Yes", Value = "true"} },new { @class = "text-box single-line",@onchange="changeIsActive()" })
           </div>
            </td>
            <td class="text-center"> @Model.IsInterested</td>
        </tr>
        </tbody>
</table>
<script>
    function changeIsLeadInterviewer() {
        var Emailid = $("#EmailId").val();
        var isLeadInterviewer = $("#IsLeadInterviewer").val();
        $.ajax({
            url: '/Interviewer/InterviewerFlagUpdate',
            data: { 'Emailid': Emailid, 'LeadInterviewer': isLeadInterviewer },
            success: function (data) {
                swal.fire("Lead Interviewer status updated successfully.");
            }
        });
    }
    function changeIsApproved() {
        var Emailid = $("#EmailId").val();
        var isaproved = $("#IsApproved").val();
        $.ajax({
            url: '/Interviewer/InterviewerFlagUpdate',
            data: { 'Emailid': Emailid, 'IsApproved': isaproved },
            success: function (data) {
                swal.fire("Approved status updated successfully.");
            }
        });
    }
    function changeIsActive() {
        var Emailid = $("#EmailId").val();
        var isActive = $("#IsActive").val();
        $.ajax({
            url: '/Interviewer/InterviewerFlagUpdate',
            data: { 'Emailid': Emailid, 'IsActive': isActive },
            success: function (data) {
                swal.fire("Interviewer active status updated successfully.");
            }
        });
    }
</script>

<style>
    .custom-select {
        position: relative;
    }


        .custom-select select {
        width: 95px;
        font-size: 1.2rem;
        padding: 10px 30px 10px 10px;
        border: 1px silver solid;
            background-color: #e9e8e840;
        color: grey;
        outline: none;
    }

    .custom-select span {
        position: absolute;
        width: 40px;
        height: 100%;
        background-color: #1e1e26;
        right: 0;
        top: 0;
        pointer-events: none;
    }

        .custom-select span::before {
            position: absolute;
            content: "";
            border-style: solid;
            border-width: 7px;
            border-color: transparent transparent #5b6287 transparent;
            top: 14%;
            left: 35%;
        }

    .custom-select span::after {
            position: absolute;
            content: "";
            border-style: solid;
            border-width: 7px;
            border-color: #5b6287 transparent transparent transparent;
            top: 56%;
            left: 35%;
        }
        option{
        left: 0;
        z-index: 999;
        margin: 0 0;
        padding: 10px;
        list-style: none;
        border: 1px solid #ccc;
        background-color: #eee;
        -webkit-box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        -moz-box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
    </style>
