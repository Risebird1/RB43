                                        @Html.EditorFor(model => model.StackOverflowLink, new { htmlAttributes = new { id = "txt_StackOverflowLink", @class = "form-control text-box single-line", @type = "text" } })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Country, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownListFor(model => model.Country, (SelectList)Model.CountryList, new { id = "drp_Country", @class = "select-css form-control text-box single-line" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @*@Html.EditorFor(model => model.IsActive, new { htmlAttributes = new { id = "txt_IsActive", @class = "form-control text-box single-line", @type = "text", @Value = "false" } })*@
                                        @Html.DropDownListFor(model => model.IsActive, new[]
                                                        {   new SelectListItem { Text = "No", Value = "false" },
                                                            new SelectListItem { Text = "Yes", Value = "true"} },
                                                          new { id = "drp_IsActive", @class = "select-css form-control text-box single-line" })
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                    </div>
                                </div>
