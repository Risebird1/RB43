                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NickName, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.NickName, new { htmlAttributes = new { id = "txt_NickName", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.NickName, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.DropDownListFor(model => model.Gender, (SelectList)Model.GenderList, new { id = "drp_Gender", @class = "select-css form-control text-box single-line" })
                                        @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CurrentRole, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.CurrentRole, new { htmlAttributes = new { id = "txt_CurrentRole", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.CurrentRole, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IsApproved, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @*@Html.EditorFor(model => model.IsApproved, new { htmlAttributes = new { id = "txt_IsApproved", @class = "form-control text-box single-line", @type = "text", @Value = "false" } })*@
                                        @Html.DropDownListFor(model => model.IsApproved, new[]
                                                        {   new SelectListItem { Text = "No", Value = "false" },
                                                            new SelectListItem { Text = "Yes", Value = "true"} },
                                                          new { id = "drp_IsAppr", @class = "select-css form-control text-box single-line" })
                                        @Html.ValidationMessageFor(model => model.IsApproved, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.LinkedinLink, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.LinkedinLink, new { htmlAttributes = new { id = "txt_LinkedinLink", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.LinkedinLink, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.City, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.EditorFor(model => model.City, new { htmlAttributes = new { id = "txt_City", @class = "form-control text-box single-line", @type = "text" } })
                                        @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group">
                                        
                                            Upload Resume
                                    


                                        <div class="mdc-touch-target-wrapper" style="top: 4px;
    position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" type="radio" id="Resume" name="Resume" value="Upload" checked="checked" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>

                                        <!-- <input id="Resume" name="Resume" value="Upload" type="radio" checked="checked" onclick="RadioChanged(this.value)">-->
                                        |  
                                            Coded Resume
                                     

                                        <div class="mdc-touch-target-wrapper" style="top: 4px;
    position: relative;">
                                            <div class="mdc-radio mdc-radio--touch">
                                                <input class="mdc-radio__native-control" id="Resume" name="Resume" value="Link" type="radio" onclick="RadioChanged(this.value)">
                                                <div class="mdc-radio__background">
                                                    <div class="mdc-radio__outer-circle"></div>
                                                    <div class="mdc-radio__inner-circle"></div>
                                                </div>
                                                <div class="mdc-radio__ripple"></div>
                                            </div>
                                        </div>



                                        <!-- <input id="Resume" name="Resume" value="Link" type="radio" onclick="RadioChanged(this.value)">-->
                                    </div>
                                    <div style="display:none" id="linkDiv">
                                        @Html.LabelFor(model => model.CodedResumeFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })

                                        @Html.TextBoxFor(model => model.CodedResumeFile, new { id = "txt_CodedResumeFile", type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                    </div>
                                    <div class="" id="uploadDiv">
                                        @Html.LabelFor(model => model.ResumeFile, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                        @Html.TextBoxFor(model => model.ResumeFile, new { id = "txt_ResumeFile", type = "file", @class = "form-control", @accept = ".doc, .docx, .pdf, .txt" })
                                    </div>
                                    <div>
                                        @if (Model.ResumeLink != null)
                                        {
                                            <div class="upload">  <a class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded  col-lg-12" id="resumeId" target="_blank" title="Resume" href=@Model.ResumeLink>Upload Resume  </a></div>
                                        }
                                    </div>
                                    <div>
                                        @if (Model.CodedResumeLink != null)
                                        {
                                            <a id="codedResumeId" target="_blank" title="CodedResume" href=@Model.CodedResumeLink>Coded Resume</a>
                                        }
                                    </div>
                                    @Html.Hidden("ResumeLink", Model.ResumeLink, htmlAttributes: new { id = "hdn_ResumeLink" })
                                    @Html.Hidden("CodedResumeLink", Model.CodedResumeLink, htmlAttributes: new { id = "hdn_CodedResumeLink" })
                                    @*@Html.HiddenFor(m => m.ResumeLink, Model.ResumeLink)
                    @Html.HiddenFor(m => m.CodedResumeLink, Model.CodedResumeLink)*@
                                </div>

                            </div>

                            <!-- INterviewer personal Details End-->
                                        <!-- Interviewer Skill Details Start-->
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h2>Interviewer Skill Details </h2>
                                                </div>
                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="table-responsive">
                                                    <table class="table table-bordered mbn" id="skillTable">
                                                        <thead class="tableHeaderClass">
                                                            <tr>
                                                                <th width="20%" class="table_heading">Skill Name </th>
                                                                <th width="15%" class="table_heading">Category </th>
                                                                <th width="15%" class="table_heading">IP</th>
                                                                <th width="15%" class="table_heading">Level</th>
                                                                <th width="5%" class="table_heading">Year of Experince </th>
                                                                <th width="20%" class="table_heading">Nature</th>
                                                                <th width="10%" class="table_heading text-center "> Action</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="tableBody">

                                                            @if (Model.InterviewerSkill == null || Model.InterviewerSkill.Count() == 0)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @Html.DropDownList("InterviewerSkill[0].SkillId", (SelectList)Model.SkillTypeList, new { @class = "select-css form-control text-box single-line" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("InterviewerSkill[0].Category", (SelectList)Model.SkillCategoryList, new { @class = "select-css form-control text-box single-line" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("InterviewerSkill[0].Ip", (SelectList)Model.SkillIPList, new { @class = "select-css form-control text-box single-line" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("InterviewerSkill[0].Level", (SelectList)Model.SkillExpertiseLevelList, new { @class = "select-css form-control text-box single-line" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("InterviewerSkill[0].SkillExperience", (SelectList)Model.SkillYearsOfExperienceList, new { @class = "select-css form-control text-box single-line" })
                                                                    </td>
                                                                    <td>
                                                                        @Html.DropDownList("InterviewerSkill[0].Nature", (SelectList)Model.SkillNatureList, new { @class = "select-css form-control text-box single-line" })
                                                                    </td>
                                                                    <td class="action text-center">
                                                                        <span id="btnPlus" onclick="addRowSkillDetails()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                        <span id="btnMinus" onclick="deleteRowSkillDetails(this, 'InterviewerSkill','SkillId','Category','Ip','Level','SkillExperience', 'Nature')" class="mdc-fab app-fab--absolute trash-btn"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                for (int i = 0; i < Model.InterviewerSkill.Count(); i++)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.InterviewerSkill[i].SkillId, (SelectList)Model.SkillTypeList, new { @class = "select-css form-control text-box single-line" })
                                                                        </td>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.InterviewerSkill[i].Category, (SelectList)Model.SkillCategoryList, new { @class = "select-css form-control text-box single-line" })
                                                                        </td>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.InterviewerSkill[i].Ip, (SelectList)Model.SkillIPList, new { @class = "select-css form-control text-box single-line" })
                                                                        </td>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.InterviewerSkill[i].Level, (SelectList)Model.SkillExpertiseLevelList, new { @class = "select-css form-control text-box single-line" })
                                                                        </td>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.InterviewerSkill[i].SkillExperience, (SelectList)Model.SkillYearsOfExperienceList, new { @class = "select-css form-control text-box single-line" })
                                                                        </td>
                                                                        <td>
                                                                            @Html.DropDownListFor(m => m.InterviewerSkill[i].Nature, (SelectList)Model.SkillNatureList, new { @class = "select-css form-control text-box single-line" })
                                                                        </td>
                                                                        <td class="action text-center">
                                                                            <span id="btnPlus" onclick="addRowSkillDetails()" class="mdc-fab app-fab--absolute"><i class="fas  fa fa-plus"></i></span>
                                                                            <span id="btnMinus" onclick="deleteRowSkillDetails(this, 'InterviewerSkill','SkillId','Category','Ip','Level','SkillExperience', 'Nature')" class="mdc-fab app-fab--absolute trash-btn"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                    <label class="text-danger" id="SkillCollection_WeightageError" style="color:red; margin-left:815px"></label>
                                                </div>
                                            </div>
                                        </div>
                                        <!--Interviewer Skill Details end -->
                                        <!-- Interviewer Certificate Details Start-->
                                        <div class="row">
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="multiple_row">
                                                    <h2>Interviewer Certificate Details</h2>
                                                </div>
                                            </div>
                                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                <div class="table-responsive">
                                                    <table class="table table-bordered mbn" id="certificateTable">
