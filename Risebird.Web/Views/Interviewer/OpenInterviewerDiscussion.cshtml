@model IEnumerable<Risebird.Entities.ViewModel.InterviewerInvites>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Open Discussions";
    Layout = "~/Views/Shared/_Layout.cshtml";

}


<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<!-- Bleow New Style added by Vishwanath for IRF Chanbge -->


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <div id="opendiscinterview_1">
                    <a class="navbar-brand">Open Discussions</a></div>
                </div>
            </div>
    </nav>
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Open Discussions</h4></div>
                </div>

                <div class="pull-right">
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">

                        <div class="row">
                            @foreach (var item in Model)
                            {
                                <div class="col-lg-4 col-sm-6" style="margin-top: 15px;">
                                    <div class="card card-stats border card-blue">


                                        <div class="statistics statistics-horizontal">
                                            <div class="info info-horizontal">
                                                <div class="card-header">
                                                    <div class="row">


                                                        <div class=" col-md-9 col-sm-9 first">
                                                            <h6> @item.InterviewerSkillId </h6>
                                                        </div>

                                                        <div class="col-md-3 col-sm-3 card-header-buttons action text-right">

                                                            <button id="opendiscinterview_4" class="mdc-fab app-fab--absolute itemques" aria-label="Edit">
                                                                <span onclick="window.open('@item.CalendlyLink')" title="Schedule Meeting" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" /></svg></span>
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>


                                                <div class="card-body ">
                                                    <div class="row" style="font-size:smaller;">

                                                        <div class="col-12">
                                                            <div class="group inner list-group-item-text">
                                                                <div id="opendiscinterview_2" class="can-details three">  <b>Primary Skill:</b> <span>@item.PrimarySkill  </span></div>
                                                                <div id="opendiscinterview_3" class="can-details four">  <b>Job Ends on :</b> <span>@item.EndDate.ToString("dd MMM yyyy")  </span></div>

                                                            </div>
                                                        </div>

                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                        <!-- end row -->

                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

    </div>

</div>



@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"Interviewer\"")
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/js/hopscotch.min.js" type="text/javascript"></script>

    <script type="text/javascript">
        hopscotch.registerHelper('addOverlay', function () {
            $('body').append('<div class="overlay"></div>');
        });

        hopscotch.registerHelper('removeOverlay', function () {
            $('.overlay').fadeOut(function () {
                $(this).remove();
                $('.helper').remove();
            });
        });

        hopscotch.listen('show', function () {
            var elementObject = $(hopscotch.getCurrTarget(tour));
            var element = $('#' + elementObject[0].id);

            element.prev().removeClass('overlay-relative');
            element.addClass('overlay-relative');

            if ($('.helper').length !== 0) {

                // Use Helper Layer for hilight target element.
                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });

            } else {

                // Add Helper Layer for highlight target element.
                var newHelper = '<div class="helper"></div>';
                $('body').append(newHelper);

                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });
            }

        });

        var tour = {
            id: "hello-hopscotch",
            showCloseButton: false,
            steps: [
                {
                    title: "Open Discussions",
                    content: "View all Open Discussions here and click on next button to know its features",
                    target: "opendiscinterview_1",
                    placement: "bottom",
                    showPrevButton: true,

                    highlight: true,
                    zindex: 999999,
                    yOffset: 10,

                    onCTA: function () {
                        hopscotch.showStep(2);
                        $('#opendiscinterview_1').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {
                        $('#opendiscinterview_1').removeClass('overlay-relative');
                        $('.helper').remove();

                    }
                },



                {
                    title: "Primary Skill",
                    content: "Showing Primary Skill here",
                    target: "opendiscinterview_2",
                    showPrevButton: true,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    zindex: 999999,

                    onPrev: function () {

                        $('#opendiscinterview_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {

                        $('#opendiscinterview_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                },

                {
                    title: "Job End Date",
                    content: "Showing Job End Date here",
                    target: "opendiscinterview_3",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    onNext: function () {
                        $('#opendiscinterview_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#opendiscinterview_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

                {
                    title: "Schedule Meeting",
                    content: "Click here to schedule meeting for discussion",
                    target: "opendiscinterview_4",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    onNext: function () {
                        $('#opendiscinterview_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#opendiscinterview_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },



                {
                    title: "My Scheduled Discussions",
                    content: "Click on My Scheduled Discussions menu to see its features",
                    target: "opendiscinterview_5",
                    placement: "bottom",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: -20,
                    xOffset: 10,
                    onNext: function () {
                        $('#opendiscinterview_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#opendiscinterview_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

            ],
            onStart: ["addOverlay"],
            onEnd: ["removeOverlay"],
        };

        hopscotch.startTour(tour);

    </script>
}