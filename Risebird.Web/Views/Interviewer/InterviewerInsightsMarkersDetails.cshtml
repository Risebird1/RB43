@model IEnumerable<Risebird.Entities.ViewModel.InterviewerInsightsMarkersDetailsVM>

<div class="col-md-12 pull-left">
    <div id="tableID" class="second">
        <table class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="text-left" style="width:50%">Comment</th>
                    <th class="text-center">Marked by</th>
                    <th class="text-center">Marked Date</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                       @* <td>@item.Comments</td>*@
                        <td>
                            @if (item.Comments != null && item.Comments != "")
                            {
                                @if (item.Comments.Length > 35)
                                {
                                    <div class="article">
                                        <p style="margin-bottom:0px;">
                                            @item.Comments.Substring(0, 35)
                                        </p>
                                        <p class="moretext_@item.id moretext">
                                            @item.Comments.Substring(35, @item.Comments.Length - 35)
                                        </p>
                                    </div>
                                    <a onclick="moreless('@item.id')" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                }
                                else
                                {
                                    <div class="article">
                                        <p>
                                            @item.Comments.Substring(0, @item.Comments.Length)
                                        </p>
                                    </div>
                                }
                            }
                        </td>
                        <td>@item.CreatedBy</td>
                        <td>@item.Createdon</td>
                        <td>@item.MeetingStatus</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>


    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }

</script>