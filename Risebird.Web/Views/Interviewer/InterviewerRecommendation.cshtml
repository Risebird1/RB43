<script src="~/js/FeedbackRecorder/Record.js"></script>
<script>

    $(document).ready(function () {
        $("#CompanySizeArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#SenioritylevelArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#YearsofexperienceArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

        $("#CompanyStageArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        $("#AssessmentGroupIdArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });

    });


    $(document).ready(function () {
        $("#SkillCategoryArray").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
        Checkdoaminvalue();
    });
    function CheckRecommendationValues() {
        var elementId = '';
        //if (document.getElementById("SkillCategoryArray").value == null || document.getElementById("SkillCategoryArray").value == '') {
        //    document.getElementById("SkillCategory_Error").innerHTML = "This field is required.";
        //    elementId = 'SkillCategoryArray';
        //}
        //else {
        //    document.getElementById("SkillCategory_Error").innerHTML = "";
        //}
        if ($("#Domain").val() == "Other") {
            if ($("#DomainName").val().trim() == "") {
                $("#err_DomainName").text("This field is required.");
                elementId = 'DomainName';
            }
        }

        if ($("#AssessmentGroupIdArray").val() == null) {
             $("#err_AssessmentGroupIdArray").text("This field is required.");
             elementId = 'AssessmentGroupIdArray';
           
        }
        if ($("#txt_CodedResumeFile").val() == "" && $("#codedResumeId_1").val() == "" ){
            $("#err_txt_CodedResumeFile").text("This field is required.");
            elementId = 'txt_CodedResumeFile';
           
        }
        if ($("#YearsofexperienceArray").val() == null) {
            $("#err_YearsofexperienceArray").text("This field is required.");
            elementId = 'YearsofexperienceArray';
            
        }

        if ($("#SenioritylevelArray").val() == null) {
           $("#err_SenioritylevelArray").text("This field is required.");
           elementId = 'SenioritylevelArray';
           
        }
        if (elementId != '') {
            document.getElementById(elementId).focus();
            return false;
        }
        else {
            return true;
        }
    }
    function Checkdoaminvalue() {
        var selectvalue = $("#Domain").val();
        if (selectvalue == "Other") {
            document.getElementById("divdomainvalue").style.display = "block";
        } else {
            document.getElementById("divdomainvalue").style.display = "none";
        }
    }
</script>
