@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"Interviewer\"")
{


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/js/hopscotch.min.js" type="text/javascript"></script>

    <script type="text/javascript">

        hopscotch.registerHelper('addOverlay', function () {
            $('body').append('<div class="overlay"></div>');
        });

        hopscotch.registerHelper('removeOverlay', function () {
            $('.overlay').fadeOut(function () {
                $(this).remove();
                $('.helper').remove();
            });
        });

        hopscotch.listen('show', function () {
            var elementObject = $(hopscotch.getCurrTarget(tour));
            var element = $('#' + elementObject[0].id);

            element.prev().removeClass('overlay-relative');
            element.addClass('overlay-relative');

            if ($('.helper').length !== 0) {

                // Use Helper Layer for hilight target element.
                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });

            } else {

                // Add Helper Layer for highlight target element.
                var newHelper = '<div class="helper"></div>';
                $('body').append(newHelper);

                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });
            }

        });

        var tour = {
            id: "hello-hopscotch",
            showCloseButton: false,
            steps: [
                {
                    title: "Open Interviewer Assessment",
                    content: "View Open Interviewer Assessment details here",
                    target: "openinterviewermenu_1",
                    placement: "bottom",
                    showPrevButton: true,

                    highlight: true,
                    zindex: 999999,
                    yOffset: 10,

                    onCTA: function () {
                        hopscotch.showStep(2);
                        $('#openinterviewermenu_1').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {
                        $('#openinterviewermenu_1').removeClass('overlay-relative');
                        $('.helper').remove();

                    }
                },
                {
                    title: "Resume",
                    content: "Showing Resume here",
                    target: "openinterviewermenu_2",
                    placement: "bottom",
                    showPrevButton: true,

                    zindex: 999999,
                    xOffset: 10,
                    onPrev: function () {

                        $('#openinterviewermenu_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                    onNext: function () {

                        $('#openinterviewermenu_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },


                },

                {
                    title: "Primary Skill",
                    content: "Showing Primary Skill here",
                    target: "openinterviewermenu_3",
                    placement: "left",
                    showPrevButton: true,

                    zindex: 999999,
                    xOffset: 10,
                    onPrev: function () {

                        $('#openinterviewermenu_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                    onNext: function () {

                        $('#openinterviewermenu_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },


                },



                {
                    title: "JD Link",
                    content: "Showing JD Link here",
                    target: "openinterviewermenu_4",
                    placement: "left",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: -35,
                    xOffset: 10,
                    onNext: function () {
                        $('#openinterviewermenu_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#openinterviewermenu_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },


        
                {
                    title: "Assign",
                    content: "Click here to assign an interview based on your availability",
                    target: "openinterviewermenu_5",
                    placement: "left",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: -10,
                    xOffset: 10,
                    onNext: function () {
                        $('#openinterviewermenu_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#openinterviewermenu_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },


        
                {
                    title: "My Interviewer Assessment",
                    content: "Click on My Interviewer Assessment menu to see its features",
                    target: "myintassessmentmenu",
                    placement: "top",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: 0,
                    xOffset: 10,
                    onNext: function () {
                        $('#myintassessmentmenu').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#myintassessmentmenu').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },


            ],
            onStart: ["addOverlay"],
            onEnd: ["removeOverlay"],
        };

        hopscotch.startTour(tour);

    </script>

}
