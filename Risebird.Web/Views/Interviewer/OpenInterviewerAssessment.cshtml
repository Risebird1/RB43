@model IEnumerable<Risebird.Entities.Data.Meeting>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Open Interviewer Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Keep the Page Content Here.-->


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>

            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="row">
                                    <div class="card-header">
                                        <div class="pull-left">
                                            <h4 class="card-title">Open Interviewer Assessment</h4>
                                        </div>
                                        <div class="pull-right">
                                            <div>

                                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                    <span class="fa fa-life-ring" data-toggle="tooltip" data-placement="top" title="Support" onclick="location.href='@Url.Action("Index", "Support", new { controllerName = "Interviewer", actMethod ="OpenInterviewerAssessment" } )'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Support</font></span>
                                                </button>

                                            </div>
                                        </div>


                                    </div>

                                </div>


                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID" class="second">
                                    <table id="OpeninterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Interviewer Email</th>
                                                <th>Resume</th>
                                                <th>Primary Skill</th>
                                                <th>Risebird HR</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Interviewer Email</th>
                                                <th>Resume</th>
                                                <th>Primary Skill</th>
                                                <th>Risebird HR</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.id>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.interviewSlot </td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.candidateEmail</td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    <td>@item.PrimarySkill</td>

                                                    <td> @item.risebirdHR</td>
                                                    <td class="text-right four">
                                                        <span onclick="location.href='@Url.Action("AssignYourself", "Interviewer", new { id = item.id, InterviewDate=item.interviewDate})'" title="Assign Yourself" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-edit"></i></span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Interviewer/OpenInterviewerAssessment';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/Interviewer/OpenInterviewerAssessment';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script type="text/javascript">
    $(document).ready(function () {

        $('#OpeninterviewList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#OpeninterviewList').DataTable();
    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#OpeninterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#OpeninterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#OpeninterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true")
{
    <script src="~/Newassets/js/enjoyhint.min.js"></script>
    <link href="~/Newassets/css/enjoyhint.css" rel="stylesheet" />
    <script>
        localStorage.setItem('openinterview', true)
        var enjoyhint_instance = new EnjoyHint({});

        var enjoyhint_script_steps = [
            {
                'next .card-title': 'Open interviews and click on continue to know its features',
                'nextButton': { className: "myNext", text: "Continue" },
                'skipButton': { className: "mySkip", text: "Skip" }
            },
            {
                'next .first': 'Filter based on day(s) to see available interviews',
                'nextButton': { className: "myNext", text: "Next" },
                'skipButton': { className: "mySkip", text: "Skip" }
            },
            {
                'next .second': 'Unassinged Scheduled Interviews details',
                'nextButton': { className: "myNext", text: "Next" },
                'skipButton': { className: "mySkip", text: "Skip" }
            },
            {
                'next .four': 'Click here to assign an interview based on your availability',
                'nextButton': { className: "myNext", text: "Next" },
                'skipButton': { className: "mySkip", text: "Skip" }
            },
            {
                'click .myint': 'Click on My Interviews menu to see its features',

            }

        ];
        setTimeout(function () {
            enjoyhint_instance.set(enjoyhint_script_steps);
            enjoyhint_instance.run();
        }, 10000)

    </script>
}
