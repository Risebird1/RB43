@model IEnumerable<Risebird.Entities.Data.Meeting>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Open Interviewer Assessment";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div id='openinterviewermenu_1'>Open Interviewer Assessment</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<!-- Keep the Page Content Here-->

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interviewer.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<div class="main-panel" id="main-panel">
  
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="mobile-view">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">
                        <h4 class="card-title"></h4>
                        <h4 class="card-title"> Open Interviewer Assessment</h4>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div>
                                <div id="tableID" class="second">
                                    <table id="OpeninterviewList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Coded Name</th>
                                                <th id="openinterviewermenu_2">Resume</th>
                                                <th id="openinterviewermenu_3">Primary Skill</th>
                                                <th>Risebird HR</th>
                                                <th>Profile Type</th>
                                                <th id="openinterviewermenu_4">JD Link</th>

                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Date</th>
                                                <th>Slot</th>
                                                <th>Duration</th>
                                                <th>Coded Name</th>
                                                <th>Resume</th>
                                                <th>Primary Skill</th>
                                                <th>Risebird HR</th>
                                                <th>Profile Type</th>
                                                <th>JD Link</th>
                                                <th class="disabled-sorting text-right">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr id=@item.id>
                                                    <td> @item.interviewDate </td>
                                                    <td> @item.interviewSlot </td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.NickName</td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    <td>@item.PrimarySkill</td>

                                                    <td> @item.risebirdHR</td>
                                                    <td> @item.HeuristicProfileTypeDesc</td>
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td> <a target="_blank" title="JD Link" href=@item.JDLink.Replace(" ","%20")>JD Link</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    <td  class="text-center">
                                                        <button id="openinterviewermenu_5" class="mdc-fab app-fab--absolute" aria-label="Edit">  <span class="mdc-fab__icon material-icons " onclick="location.href='@Url.Action("AssignYourself", "Interviewer", new { id = item.id, InterviewDate=item.interviewDate})'" title="Assign Yourself"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path></svg></span></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Interviewer/OpenInterviewerAssessment';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/Interviewer/OpenInterviewerAssessment';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script type="text/javascript">
    function RefreshSearch() {
        $('#OpeninterviewList').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#OpeninterviewList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top: 11px;right:30px;'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });
    }
