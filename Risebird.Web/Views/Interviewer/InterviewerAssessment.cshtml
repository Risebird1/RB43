@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVM>*@
@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.AssignmentVM>
@using X.PagedList.Mvc.Core;
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@*@model Risebird.Entities.ViewModel.Assessment*@


@{
    ViewData["Title"] = "Interviewers Assessment";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div id='interviewerassessment_1'>Interviewers Assessment</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<link rel="stylesheet" type="text/css" href="~/Newassets/css/interviewer.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/risetube.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Interviewers Assessment</h4></div>
                </div>

                <div class="pull-right">
                    <div id="interviewerassessment_6" >
                        <a href="/Interviewer/AddAssessments" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space"><span class="fa fa-chevron-left"></span> Create Assessment</a>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client assesment">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">

                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>

                            <div style="clear:both;padding:10px"></div>
                            <div class="row">
                                @foreach (var item in Model)
                                {
                                    var jsonObject = Newtonsoft.Json.JsonConvert.SerializeObject(item);

                                    <div class="col-lg-4 col-md-6 col-sm-6 col-xs-6" style="margin-top: 15px;">
                                        <div class="card-content-holder border card-blue">
                                            <div class="card-header">
                                                <div class="row">

                                                    <div class="col-md-12 col-sm-12 card-header-buttons action text-right">
                                                        <span class="seniority" id="interviewerassessment_5"> @item.Seniority</span> 
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- irf body-->
                                            <div class="card-body">

                                                <div class="statusImg">

                                                </div>
                                                <div class="statusInfo">
                                                    <h6 id="interviewerassessment_2" class="assessment-grp"><a href="@Url.Action("EditAssessment","Interviewer",new { id=item.id})">@item.AssessmentGroup</a></h6>
                                                    <div class="group inner list-group-item-text">
                                                        <p>@item.Overview</p>
                                                        <p><b id="interviewerassessment_3" >Skills:</b> @item.TestedSkill</p>
                                                        <p><b id="interviewerassessment_4">Difficulty Level:</b> @item.Difficultylevel</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>


                            @Html.PagedListPager(Model, Page => Url.Action("InterviewerAssessment", new { Page = Page }))
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"Interviewer\"")
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js?v=2024" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/js/hopscotch.min.js?v=2024" type="text/javascript"></script>

    <script type="text/javascript">
        hopscotch.registerHelper('addOverlay', function () {
            $('body').append('<div class="overlay"></div>');
        });

        hopscotch.registerHelper('removeOverlay', function () {
            $('.overlay').fadeOut(function () {
                $(this).remove();
                $('.helper').remove();
            });
        });

        hopscotch.listen('show', function () {
            var elementObject = $(hopscotch.getCurrTarget(tour));
            var element = $('#' + elementObject[0].id);

            element.prev().removeClass('overlay-relative');
            element.addClass('overlay-relative');

            if ($('.helper').length !== 0) {

                // Use Helper Layer for hilight target element.
                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });

            } else {

                // Add Helper Layer for highlight target element.
                var newHelper = '<div class="helper"></div>';
                $('body').append(newHelper);

                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });
            }

        });

        var tour = {
            id: "hello-hopscotch",
            showCloseButton: false,
            steps: [
                {
                    title: "Interviewer Assessment",
                    content: "View all Interviewer Assessment details here and click on next button to know its features",
                    target: "interviewerassessment_1",
                    placement: "bottom",
                    showPrevButton: true,

                    highlight: true,
                    zindex: 999999,
                    yOffset: 10,

                    onCTA: function () {
                        hopscotch.showStep(2);
                        $('#interviewerassessment_1').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {
                        $('#interviewerassessment_1').removeClass('overlay-relative');
                        $('.helper').remove();

                    }
                },



                {
                    title: "Assessment Group Name",
                    content: "Showing Assessment Group Name here",
                    target: "interviewerassessment_2",
                    showPrevButton: true,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    zindex: 999999,

                    onPrev: function () {

                        $('#interviewerassessment_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {

                        $('#interviewerassessment_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                },

                {
                    title: "Skill",
                    content: "Showing Skill here",
                    target: "interviewerassessment_3",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    onNext: function () {
                        $('#interviewerassessment_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#interviewerassessment_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

                {
                    title: "Difficulty Level",
                    content: "Showing Difficulty Level here",
                    target: "interviewerassessment_4",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "right",
                    showPrevButton: true,

                    zindex: 999999,
                    xOffset: 0,
                    yOffset: -10,
                    onNext: function () {
                        $('#interviewerassessment_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#interviewerassessment_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

                {
                    title: "Seniority Level",
                    content: "Showing Seniority Level here",
                    target: "interviewerassessment_5",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "bottom",
                    xOffset: 'center',
                    arrowOffset: 'center',
                    onNext: function () {
                        $('#interviewerassessment_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#interviewerassessment_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },




                {
                    title: "Create Assessment",
                    content: "Click here to create assessment",
                    target: "interviewerassessment_6",
                    showPrevButton: true,
                    zindex: 999999,
                    placement: "bottom",
                    xOffset: '-130',
                    arrowOffset: 'center',
                    onNext: function () {
                        $('#interviewerassessment_6').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#interviewerassessment_6').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },
              

                {
                    title: "My Profile",
                    content: "Click on My Profile menu to see its features",
                    target: "interviewerassessment_7",
                    placement: "bottom",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: -20,
                    xOffset: 10,
                    onNext: function () {
                        $('#interviewerassessment_7').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#interviewerassessment_7').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

            ],
            onStart: ["addOverlay"],
            onEnd: ["removeOverlay"],
        };

        hopscotch.startTour(tour);

    </script>

}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
