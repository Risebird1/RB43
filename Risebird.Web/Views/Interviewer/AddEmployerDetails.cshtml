@model Risebird.Entities.ViewModel.InterviewerProfessional
@{
    ViewData["Title"] = "Add Employer Details";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/IRF/Index'>Interviewers</a>&nbsp;/&nbsp;Add Employer Details";
    $('#txtpageHeader').empty().html(Header);
</script>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">
   
    <div class="mt50">
    </div>
    <div class="content client">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">

                        @using (Html.BeginForm("AddEmployerDetails", "Interviewer", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.AntiForgeryToken()

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2 style="margin-top:20px;">Employer Details</h2>
                                    </div>
                                </div>


                                <div class="form-group" style="display:none">

                                    @*@Html.Hidden("Id", Model.id)*@
                                    @Html.Hidden("InterviewerProfileId", Model.InterviewerProfileId)

                                </div>




                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        <div class="mandate">   @Html.LabelFor(model => model.CompanyName, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })<span class="red">*</span></div>
                                        @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                                    </div>
                                </div>




                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Type, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.Type, (SelectList)ViewBag.CompanyTypeList,"Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CompanyStage, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.CompanyStage, (SelectList)ViewBag.CompanyStageList,"Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Size, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.Size, (SelectList)ViewBag.CompanySizeList,"Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>




                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.JobFunctionId, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(model => model.JobFunctionId, (SelectList)ViewBag.JobFunction, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.IndustryId, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(model => model.IndustryId, (SelectList)ViewBag.Industry, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>


                                @*--company Head quarter*@
                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Headquarters, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.Headquarters, (SelectList)ViewBag.CountryList, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>


                                </div>

                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.Role, (SelectList)ViewBag.RoleList, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>

                                </div>


                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        <div class="mandate">   @Html.LabelFor(model => model.Domain, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })<span class="red">*</span></div>
                                        @Html.EditorFor(model => model.Domain, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.Domain, "", new { @class = "text-danger" })
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.SeniorityLevel, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.SeniorityLevel, (SelectList)ViewBag.SeniorityLevelList, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>



                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.ExperienceId, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.ExperienceId, (SelectList)ViewBag.ExperienceRange, "Select", new { @class = "select-css form-control text-box single-line" })
                                        @Html.ValidationMessageFor(model => model.ExperienceId, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WorkNature, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.WorkNature, (SelectList)ViewBag.WorkNatureList, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PrimaryResponsibility, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.DropDownListFor(m => m.PrimaryResponsibility, (SelectList)ViewBag.PrimaryResponsibilityList, "Select", new { @class = "select-css form-control text-box single-line" })
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CompanyLinkedinPage, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.EditorFor(model => model.CompanyLinkedinPage, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @*@Html.ValidationMessageFor(model => model.CompanyLinkedinPage, "", new { @class = "text-danger" })*@
                                    </div>
                                </div>


                                <div class="col-md-6 col-sm-6 pr-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.CompanyWebsite, htmlAttributes: new { @class = "control-label col-md-12 col-sm-12 desp-label " })
                                        @Html.EditorFor(model => model.CompanyWebsite, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @*@Html.ValidationMessageFor(model => model.CompanyWebsite, "", new { @class = "text-danger" })*@
                                    </div>



                                </div>
                            </div>


                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Cancel", "IndexEmployer", "Interviewer", new { id = Model.InterviewerProfileId }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>


                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>