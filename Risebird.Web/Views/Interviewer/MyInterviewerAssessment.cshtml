<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>

<script>
    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }
    var interviewUnassignedMinutes;
    $(document).ready(function () {
        $.ajax({
            type: "GET",
            url: "/Interview/GetInterviewUnassignedMinutes",
            success: function (data) {
                interviewUnassignedMinutes = data;
            }
        });


    });

</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#MyInterviewList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#MyInterviewList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#MyInterviewList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script>
    var interviewer = "";
    var caninterviewid = 0;
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callInterviewer(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        Twilio.Device.connect(params);
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + interviewer + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        startCallRecording(connection.parameters.CallSid);
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function startCallRecording(sid) {
        console.log("sid:" + sid);
        $.ajax({
            url: '/User/makecall',
            type: "GET",
            data: { 'sid': sid, 'interviewid': caninterviewid },
            success: function (data) {
                console.log("rsid:" + data);
            }
        });
    }
    function ModalButtonClickJson(phoneNumber, id) {
        var emailId = $('#hidemail_' + id).val();
        ModalButtonClick(phoneNumber, emailId, id);

    }

    function ModalButtonClick(phoneNumber, interviewerMail, interviewid) {
        interviewer = interviewerMail;
        caninterviewid = interviewid;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + interviewer + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callInterviewer(phoneNumber);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }


</script>



<script type="text/javascript">


    function CheckTimeDifference(meetingId, interviewDate) {
        $.ajax({
            type: "GET",
            url: "/Interview/GetTimeDifference",
            data: { 'interviewDate': interviewDate, 'interviewUnassignedMinutes': interviewUnassignedMinutes },
            success: function (response) {
                UnAssignInterviewer(meetingId, response)
            }
        });
    }
    function UnAssignInterviewer(meetingId, isPenalty) {

        var textMsg;
        if (isPenalty) {
            textMsg = "Unassigning at this hour will lead to a penalty. Note: Update Risebird HR, before unassigning interview."
        }
        else {
            textMsg = "The Interview will be unassigned! Note: Update Risebird HR, before unassigning interview.";
        }


        //var IdIRF = dataID;
        swal.fire({
            title: 'Are you sure?',
            text: textMsg,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Unassign Me!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Interviewer/UnassignYourself?id=' + meetingId,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error unassigning!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Unassigned!',
                    type: 'success',
                    html: '<p>You have been unassigned.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interviewer/MyInterviewerAssessment";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Your were not unassigned.',
                    'error'
                )
            }
        })
    }

</script>

<script>
    function checkStartDate(val) {

        if (val == "") {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var StartDate = new Date(year, month, date);

        var endDateValue = document.getElementById("EndDate").value;
        var yearEnd = endDateValue.substring(0, 4);
        var monthEnd = parseInt(endDateValue.substring(5, 7)) - 1;
        var dateEnd = endDateValue.substring(8, 10);
        var EndDate = new Date(yearEnd, monthEnd, dateEnd);


        if (StartDate > EndDate) {
            document.getElementById("submitFilter").disabled = true;
            document.getElementById("startDateCheck").style.display = "block";
            document.getElementById("startDateCheck").innerHTML = "Start Date should be less than or equal to End Date";
            document.getElementById("StartDate").focus();
            return;
        }
        else {
            document.getElementById("startDateCheck").style.display = "none";
            document.getElementById("startDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;

        }
        //if (document.getElementById("EndDate").value != "") {
        //    checkEndDate(document.getElementById("EndDate").value);
        //}

    }

    function checkEndDate(val) {

        if (val == "") {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }
        var startDateValue = document.getElementById("StartDate").value;
        if (startDateValue == null || startDateValue == "") {
            return;
        }

        //end Date object creation
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var endDate = new Date(year, month, date);

        //start Date object creation

        //if (startDateValue == "") {
        //    document.getElementById("endDateCheck").style.display = "block";
        //    document.getElementById("endDateCheck").innerHTML = "Kindly fill the Start Date field.";
        //    document.getElementById("StartDate").focus();
        //    return;
        //}
        var yearStart = startDateValue.substring(0, 4);
        var monthStart = parseInt(startDateValue.substring(5, 7)) - 1;
        var dateStart = startDateValue.substring(8, 10);
        var startDate = new Date(yearStart, monthStart, dateStart);


        if (endDate <= startDate) {
            document.getElementById("submitFilter").disabled = true;
            document.getElementById("endDateCheck").style.display = "block";
            document.getElementById("endDateCheck").innerHTML = "End Date should be greater than Start Date";
            document.getElementById("EndDate").focus();
            return;
        }
        else {
            document.getElementById("endDateCheck").style.display = "none";
            document.getElementById("endDateCheck").innerHTML = "";
            document.getElementById("submitFilter").disabled = false;
            return;
        }

    }
</script>
<script>
    function FilterInterviews(filterValue) {

        $.ajax({
            type: "GET",
            url: "/Interview/GetFilteredMyInterviews",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#MyInterviewList').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#MyInterviewList').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }
</script>

<script>
    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });




    });
</script>
<script>

    function searchResult() {

        $.ajax({
            type: "POST",
            url: "/Interviewer/InterviewerAssessmentJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }
    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="9" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {

            html += '<tr id=' + data[i].id + ' data-changes="1">';

            html += '  <td style="width:10px;" data-toggle="collapse" id="' + data[i].id + '" data-target=".' + data[i].id + '" class="detail-row" onclick="changeicon(' + data[i].id + ')">&nbsp;</td>';

            html += '  <td> ' + new Date(data[i].interviewDate).toLocaleString() + ' </td>';

            html += '  <td> ' + data[i].interviewSlot + ' </td>';
            html += '  <td> ' + data[i].interviewDuration + ' </td>';
            html += ' <td> ' + data[i].zoomId + '</td>';
            html += '                                       <td>' + data[i].nickName + '</td>';

            if (data[i].resumeLink != null && data[i].resumeLink != "") {

                html += ' <td> <a id="resumeId" target="_blank" title="Resume" href=' + data[i].resumeLink + '>Resume</a></td> ';
            }
            else {
                html += '  <td>No Resume</td>';
            }



            if (data[i].primarySkill != null && data[i].primarySkill != "") {
