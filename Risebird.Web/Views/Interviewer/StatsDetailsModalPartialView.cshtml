
<div id="StatsDetailsModel" class="modal modal-bg" style="z-index:3">

    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-lines-fill" viewBox="0 0 16 16">
                            <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zM11 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5zm.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4zm2 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2z" />
                        </svg>
                    </span>

                </div>

                <h5 class="modal-title pull-left">Stats Details for <strong id="idDetailsFor"></strong> <span class="popup-text" id="idStatsType" style="font-size:9px"></span></h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body">
                <div style="padding:10px" id="divStatsBody">
                </div>
                <div>
                    <div class="col-md-12 text-right">
                        <div>
                            <div style="display: inline-block !important;margin-bottom: 10px;"><input style="color: #fff;line-height: 13px;" type="button" onclick="closeModel()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

