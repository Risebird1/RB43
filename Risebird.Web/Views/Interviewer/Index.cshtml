@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerProfileVM>*@

@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.InterviewerProfileVM>
@using X.PagedList.Mvc.Core;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interviewers";
    ViewBag.PageHeader = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string[] AssessmentGroups = new string[] { };
    string[] Senioritylevel = new string[] { };
    string[] ProfileType = new string[] { };
    string[] CompentencyLevel = new string[] { };
    string[] IndianRate = new string[] { };
    string[] OutSideIndiaRate = new string[] { };
    string[] CompanyType = new string[] { };
    string[] Domain = new string[] { };
    string[] AssessmentGroup = new string[] { };
    string[] IsLeadInterviewer = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("InterviewerIndexfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("InterviewerIndexfilters"));
    AssessmentGroups = filter.AssessmentGroup != null ? filter.AssessmentGroup : new string[] { };
    Senioritylevel = filter.Senioritylevel != null ? filter.Senioritylevel : new string[] { };
    ProfileType = filter.ProfileType != null ? filter.ProfileType : new string[] { };
    CompentencyLevel = filter.CompentencyLevel != null ? filter.CompentencyLevel : new string[] { };
    IndianRate = filter.IndianRate != null ? filter.IndianRate : new string[] { };
    OutSideIndiaRate = filter.OutSideIndiaRate != null ? filter.OutSideIndiaRate : new string[] { };
    CompanyType = filter.CompanyType != null ? filter.CompanyType : new string[] { };
    Domain = filter.Domain != null ? filter.Domain : new string[] { };
    AssessmentGroup = filter.AssessmentGroup != null ? filter.AssessmentGroup : new string[] { };
    IsLeadInterviewer = filter.IsLeadInterviewer != null ? filter.IsLeadInterviewer : new string[] { };

}

<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<div class="main-panel" id="main-panel">



    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interviewers</h4></div>
                </div>

                <div class="pull-right client-ms">



                    <div id="meeting_filter" class="dataTables_filter  pull-left ">


                        <div class="interviewer_2">
                            <div class="searchCon mb-10" style="margin-right:10px;">

                                <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.Searchvalue">

                                <span class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>

                                @*<button style="display:none;" type="button" id="x">x</button>*@


                            </div>
                        </div>
                    </div>

                    <div class="pull-left" style="margin-right:10px;">
                        @if (ViewBag.profile == "Admin")
                        {
                            <span class="interviewer_3">
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                    <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Check Interviewer availability using Email" onclick="SendIntervieweravailability()" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Interviewer availability</font></span>
                                </button>
                            </span>
                        }
                        <span class="interviewer_3">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded  card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">

                                <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        </span>
                    </div>
                    <div class="pull-left">
                        @if (ViewBag.profile != "Finance")
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("AddInterviewerProfile", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Interviewer</font></span>
                            </button>
                        }
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("LeadInterviewer", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family:arial;">Lead Interviewers</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>




    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading interviewer">
                            <div class="modal modal-wrap fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("Index","Interviewer")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">


                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Senioritylevel">
                                                                Seniority level
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Senioritylevel" name="Senioritylevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.Senioritylevel)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }

                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ProfileType">Profile Type</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ProfileType" name="ProfileType" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.ProfileType)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @*<div class="col-md-6 col-sm-6 border-rv">

                                                <div class="form-group">
                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="CompentencyLevel">Compentency Level</label>
                                                <div class="col-md-12 col-sm-12">
                                                <select id="CompentencyLevel" name="CompentencyLevel" class="form-control multiselect" multiple="multiple">

                                                @foreach (var item in ViewBag.CompentencyLevel)
                                                {
                                                @if (item != null && item != "")
                                                {
                                                <option value="@item">@item</option>
                                                }
                                                }
                                                </select>
                                                </div>
                                                </div>
                                                </div>*@
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IndianRate">India Price</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IndianRate" name="IndianRate" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.IndianRate)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="OutSideIndiaRate">Out Side India Price</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="OutSideIndiaRate" name="OutSideIndiaRate" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.OutSideIndiaRate)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="CompanyType">Company Type</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="CompanyType" name="CompanyType" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.CompanyType)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Domain">Country</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Domain" name="Domain" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.Country)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="AssessmentGroup">Assessment Group</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="AssessmentGroup" name="AssessmentGroup" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.AssessmentGroup)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IsLeadInterviewer">Is Lead Interviewer</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IsLeadInterviewer" name="IsLeadInterviewer" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.IsLeadInterviewer)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-12 col-sm-12" style="position: relative;">


                                                        <div>
                                                            <div class="col-md-12 col-sm-12 mc-button-area text-right">

                                                                <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn4  reset-filter">
                                                                    Reset Filter
                                                                </button>

                                                                <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn5 apply-filter">
                                                                    Apply Filter
                                                                </button>
                                                            </div>

                                                        </div>


                                                    </div>

                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>

                            <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="col-md-12 nopad">
                                    <div class="table-responsive">
                                        <table id="interviewer" class="table table-striped table-bordered interviewertable" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th style="border-right: 0px !important;"></th>
                                                    <th id="start">First Name</th>
                                                    <th>Last Name</th>
                                                    <th class="interviewer_4">Email Id</th>
                                                    <th>Mobile No.</th>
                                                    <th class="interviewer_5">Insta Interviewer</th>
                                                    <th class="interviewer_6">Assessment Group</th>
                                                    <th class="interviewer_7">Resume Link</th>
                                                    <th class="interviewer_8">Coded Name</th>
                                                    <th>Available</th>
                                                    <th class="disabled-sorting text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th style="border-right: 0px !important;"></th>
                                                    <th>First Name</th>
                                                    <th>Last Name</th>
                                                    <th>Email Id</th>
                                                    <th>Mobile No.</th>
                                                    <th>Insta Interviewer</th>
                                                    <th>Assessment Group</th>
                                                    <th>Resume Link</th>
                                                    <th>Coded Name</th>
                                                    <th>Available</th>
                                                    <th class="disabled-sorting text-center">Actions</th>
                                                </tr>
                                            </tfoot>
                                            <tbody id="tblbodyInterviewerProfile">
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.id data-changes="1">
                                                        <td style="width:10px;" data-toggle="collapse" id="@item.id" data-target=".@item.id" class="detail-row" onclick="changeicon('@item.id')">&nbsp;</td>
                                                        @if (item.FirstName != null && item.FirstName != "")
                                                        {
                                                            <td class="cadName intwname">
                                                                <a onclick="" data-tooltip="@item.FirstName"><span class="intName"> @item.FirstName</span></a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.LastName != null && item.LastName != "")
                                                        {
                                                            @if (item.LastName.Length > 10)
                                                            {
                                                                <td class="cadLast">
                                                                    <a onclick="" data-tooltip="@item.LastName"> @item.LastName.Substring(0, 10)... </a>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td class="cadLast">
                                                                    <a onclick=""> @item.LastName </a>
                                                                </td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.EmailId != null && item.EmailId != "")
                                                        {
                                                            <td class="cadEmail">
                                                                <a onclick="" data-tooltip="@item.EmailId"><span class="intEmail"> @item.EmailId</span> </a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        <td>@item.MobileNumber</td>
                                                        @if (item.Isinstaavailable)
                                                        {
                                                            <td>Yes</td>
                                                        }
                                                        else
                                                        {
                                                            <td>No</td>
                                                        }
                                                        <td class="interview-com">
                                                            <div id="section">
                                                                @if (item.AssessmentGroupId != null && item.AssessmentGroupId != "")
                                                                {
                                                                    @if (item.AssessmentGroupId.Length > 20)
                                                                    {
                                                                        <div class="article">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.AssessmentGroupId.Substring(0, 20)
                                                                            </p>
                                                                            <p class="moretext1_@item.id moretext">
                                                                                @item.AssessmentGroupId.Substring(20, @item.AssessmentGroupId.Length - 20)
                                                                            </p>
                                                                        </div>
                                                                        <a onclick="moreless1(@item.id)" class="moreless-button" value="Readmore" id="read1_@item.id" href="#">Read more</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article">

                                                                            <p>
                                                                                @item.AssessmentGroupId.Substring(0, @item.AssessmentGroupId.Length)
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div></div>
                                                                }


                                                            </div>




                                                        </td>



                                                        @if (item.ResumeLink != null && item.ResumeLink != "")
                                                        {
                                                            <td>

                                                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink.Replace(" ","%20")>Resume</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }


                                                        <td><b>@item.NickName</b></td>
                                                        <td>@item.AvailableDetails</td>
                                                        <td class="text-left action">
                                                            <span class="interviewer_9">
                                                                <button class="mdc-fab app-fab--absolute mb-40" aria-label="Recommendation">
                                                                    <span onclick="location.href = '@Url.Action("InterviewerRecommendation", "Interviewer", new {  id = item.UserId })'" title="Recommendation" class="mdc-fab__icon material-icons">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" style="top: -1px;position: relative;">
                                                                            <path d="M9 11.24V7.5C9 6.12 10.12 5 11.5 5S14 6.12 14 7.5v3.74c1.21-.81 2-2.18 2-3.74C16 5.01 13.99 3 11.5 3S7 5.01 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63l-4.54-2.26c-.17-.07-.35-.11-.54-.11H13v-6c0-.83-.67-1.5-1.5-1.5S10 6.67 10 7.5v10.74l-3.43-.72c-.08-.01-.15-.03-.24-.03-.31 0-.59.13-.79.33l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.91-1.38z"></path>
                                                                        </svg>
                                                                    </span>
                                                                </button>
                                                            </span>


                                                            <span class="interviewer_10">
                                                                <button title="Availability Details" class="mdc-fab app-fab--absolute mb-40" data-toggle="modal" onclick="openAvailDetailsModel(@item.id)">

                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" /></svg>
                                                                </button>
                                                            </span>

                                                            <span class="interviewer_11">
                                                                <button title="Bank Details" class="mdc-fab app-fab--absolute mb-40" data-toggle="modal" onclick="openBankDetailsModel(@item.id)">

                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z" /></svg>
                                                                </button>
                                                            </span>

                                                            @if (ViewBag.profile != "Finance")
                                                            {
                                                                <span class="interviewer_12">
                                                                    <button class="mdc-fab app-fab--absolute mb-40" aria-label="Click here to edit Interviewer Profile">
                                                                        <span onclick="location.href = '@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId })'" title="Click here to edit Interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                                    </button>
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="interviewer_12">
                                                                    <button disabled class="mdc-fab app-fab--absolute mb-40" aria-label="Click here to edit Interviewer Profile">
                                                                        <span onclick="location.href = '@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId })'" title="Click here to edit Interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                                    </button>
                                                                </span>
                                                            }

                                                            <span class="interviewer_13">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Click here to add Interviewer Employer Details">
                                                                    <span onclick="location.href = '@Url.Action("IndexEmployer", "Interviewer", new { id = item.id})'" title="Click here to add Interviewer Employer Details" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><path d="M10 8c1.66 0 2.99-1.34 2.99-3S11.66 2 10 2 7 3.34 7 5s1.34 3 3 3zm-6 2V8h2V6H4V4H2v2H0v2h2v2h2zm6 0c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg></span>
                                                                </button>
