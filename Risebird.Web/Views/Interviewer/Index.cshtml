<script>

    function RefreshSearch() {
        if (_srXHR) { _srXHR.abort(); _srXHR = null; }
        if (_srTimeout) { clearTimeout(_srTimeout); _srTimeout = null; }
        $('#txtmeeting_filter').val('');
        $('#meeting_filter').removeClass('has-value searching');
        searchResult();
    }
    $(document).ready(function () {

        $("#x").click(function (e) {
            RefreshSearch();
        });




    });
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
<script>
    function closeBankDetailsModel() {
        var modal = document.getElementById("bankModal");
        modal.style.display = "none";
    }

    function bindbankDetailsData(data) {

        $('#txt_accname').val(data.accountName);
        $('#txt_accno').val(data.accountNumber);
        $('#txt_accifsc').val(data.ifscCode);
        $('#txt_accupi').val(data.upiId);
        $('#txt_accpan').val(data.pan);

    }
    function openBankDetailsModel(interviewerid) {
        $.ajax({
            type: "POST",
            url: "/Interviewer/BankDetailsJson",
            data: { interviewerid: interviewerid },
            success: function (data) {
                var modal = document.getElementById("bankModal");
                modal.style.display = "block";
                bindbankDetailsData(data);
            }
        });
    }



    function closeAvailDetailsModel() {
        var modal = document.getElementById("availModal");
        modal.style.display = "none";
    }
    var _srTimeout = null;   // debounce timer
    var _srXHR     = null;   // in-flight request handle
    var _srCache   = {};     // keyed by lowercase search term

    function searchResult() {
        var term    = ($('#txtmeeting_filter').val() || '').trim();
        var key     = term.toLowerCase();
        var isEnter = window.event && (window.event.key === 'Enter' || window.event.keyCode === 13);

        // update clear-button visibility
        $('#meeting_filter').toggleClass('has-value', term.length > 0);

        // abort any stale in-flight request (prevents race conditions)
        if (_srXHR) { _srXHR.abort(); _srXHR = null; }
        if (_srTimeout) { clearTimeout(_srTimeout); _srTimeout = null; }
        $('#meeting_filter').removeClass('searching');

        // skip single-character queries (too broad, costly on DB)
        if (term.length === 1) { return; }

        // serve identical searches instantly from cache (zero DB hit)
        if (_srCache.hasOwnProperty(key)) {
            var c = _srCache[key];
            bindtableData(c.result);
            bindPages(c.totalPage, c.startPage, c.endPage, c.totalentry);
            return;
        }

        // fire immediately on Enter/icon-click, debounce while typing
        var delay = isEnter ? 0 : 320;
        _srTimeout = setTimeout(function () {
            $('#meeting_filter').addClass('searching');  // show spinner
            _srXHR = $.ajax({
                type: "POST",
                url: "/Interviewer/InterviewerProfileJson",
                data: { 'searchValue': term },
                success: function (data) {
                    _srXHR = null;
                    $('#meeting_filter').removeClass('searching');  // hide spinner
                    if (data && typeof data === 'object' && data.result !== undefined) {
                        _srCache[key] = data;   // store for instant reuse
                        bindtableData(data.result);
                        bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                    } else {
                        $("#tblbodyInterviewerProfile").html(
                            '<tr><td colspan="9" class="text-center text-danger">Could not load results. Please try again.</td></tr>'
                        );
                    }
                },
                error: function (xhr) {
                    _srXHR = null;
                    $('#meeting_filter').removeClass('searching');  // hide spinner
                    if (xhr.statusText !== 'abort') {
                        $("#tblbodyInterviewerProfile").html(
                            '<tr><td colspan="9" class="text-center text-danger">Search failed. Please try again.</td></tr>'
                        );
                    }
                }
            });
        }, delay);
    }
    function bindavailDetailsData(data) {
        var html = '';
        html += '  <table class="table table-bordered mbn" id="availabilityDetailsTable">';
        html += '<thead class="tableHeaderClass">';
        html += ' <tr>';
        html += '  <th width="40%" class="table_heading">Week Day</th>';
        html += '  <th width="40%" class="table_heading">Week End</th>';
        html += '  <th width="10%" class="table_heading">Is Available On Public Holidays</th>';
        html += ' </tr>';
        html += ' </thead>';
        html += '  <tbody>';
        for (var i = 0; i < data.length; i++) {

            html += ' <tr class="availbg">';
            html += ' <td><input class = "select-css form-control text-box single-line" type ="text" value="' + data[i].weekday + '"/></td>';
