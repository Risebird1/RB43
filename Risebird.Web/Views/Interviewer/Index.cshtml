    function DeleteEntityfromEnvironmentJson(userId) {
        var firstnamne = $('#hidfirstname' + userId).val();
        DeleteEntityfromEnvironment(userId, firstnamne);

    }

    function DeleteEntityfromEnvironment(UserId, FirstName) {
        swal.fire({
            title: 'Are you sure you want to delete interviewer ' + FirstName + '?',
            text: "It will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeleteInterviewerProfile',
                        data: { 'UserId': UserId },
                        type: 'Delete',
                        method: 'POST',
                        success: function (result) {
                            if (result == true) {
                                resolve(result)

                            }
                            else {
                                swal.fire("Error deleting!", "Please try again", "error");

                            }

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The interviewer has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interviewer/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>

