<script>
    function closeinterviewerAssessmentModal() {
        var modal = document.getElementById("interviewerAssessmentModal");
        modal.style.display = "none";
    }
    function getAssessmentsdetails(Emailid) {
        $.ajax({
            url: '/IRF/GetInterviewerAssessmentGroup',
            data: { 'InterviewerEmailid': Emailid },
            success: function (data) {
                var modal = document.getElementById("interviewerAssessmentModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);
            }
        });
    }
    function closeinterviewerFlagDetailsModal() {
        var modal = document.getElementById("interviewerFlagDetailsModal");
        modal.style.display = "none";
    }
    function OpenInterviewerFlagDetails(Emailid) {
        $.ajax({
            url: '/Interviewer/FetchInterviewerFlagDetails',
            data: { 'InterviewerEmailid': Emailid },
            success: function (data) {
                var modal = document.getElementById("interviewerFlagDetailsModal");
                modal.style.display = "block";
                $('#FlagDetailsTablebody').html('');
                $('#FlagDetailsTablebody').html(data);
            }
        });
    }
    
</script>
