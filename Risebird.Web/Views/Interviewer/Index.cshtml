<script>
    function closeBankDetailsModel() {
        var modal = document.getElementById("bankModal");
        modal.style.display = "none";
    }

    function bindbankDetailsData(data) {

        $('#txt_accname').val(data.accountName);
        $('#txt_accno').val(data.accountNumber);
        $('#txt_accifsc').val(data.ifscCode);
        $('#txt_accupi').val(data.upiId);
        $('#txt_accpan').val(data.pan);

    }
    function openBankDetailsModel(interviewerid) {
        $.ajax({
            type: "POST",
            url: "/Interviewer/BankDetailsJson",
            data: { interviewerid: interviewerid },
            success: function (data) {
                var modal = document.getElementById("bankModal");
                modal.style.display = "block";
                bindbankDetailsData(data);
            }
        });
    }



    function closeAvailDetailsModel() {
        var modal = document.getElementById("availModal");
        modal.style.display = "none";
    }

    function bindavailDetailsData(data) {
        var html = '';
        html += '  <table class="table table-bordered mbn" id="availabilityDetailsTable">';
        html += '<thead class="tableHeaderClass">';
        html += ' <tr>';
        html += '  <th width="40%" class="table_heading">Week Day</th>';
        html += '  <th width="40%" class="table_heading">Week End</th>';
        html += '  <th width="10%" class="table_heading">Is Available On Public Holidays</th>';
        html += ' </tr>';
        html += ' </thead>';
        html += '  <tbody>';
        for (var i = 0; i < data.length; i++) {

            html += ' <tr class="availbg">';
            html += ' <td><input class = "select-css form-control text-box single-line" type ="text" value="' + data[i].weekday + '"/></td>';
            html += '<td><input class = "select-css form-control text-box single-line" type ="text" value="' + data[i].weekend + '"/></td>';

            if (data[i].isAvailableOnPublicHolidays == 1) {
                html += '  <td style="text-align:center">Available on Public Holiday</td>';
            }
            else { html += '  <td style="text-align:center">Not Available on Public Holiday</td>'; }
            html += '  </tr>';

        }

        html += ' </tbody>';
        html += '</table>';
        $('#availDetails').empty().html(html);
    }
    function openAvailDetailsModel(interviewerid) {
        $.ajax({
            type: "POST",
            url: "/Interviewer/AvailDetailsJson",
            data: { interviewerid: interviewerid },
            success: function (data) {
                var modal = document.getElementById("availModal");
                modal.style.display = "block";
                bindavailDetailsData(data);
            }
        });
    }



    function DeleteEntityfromEnvironmentJson(userId) {
        var firstnamne = $('#hidfirstname' + userId).val();
        DeleteEntityfromEnvironment(userId, firstnamne);

    }

    function DeleteEntityfromEnvironment(UserId, FirstName) {
        swal.fire({
            title: 'Are you sure you want to delete interviewer ' + FirstName + '?',
            text: "It will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeleteInterviewerProfile',
                        data: { 'UserId': UserId },
                        type: 'Delete',
                        method: 'POST',
                        success: function (result) {
                            if (result == true) {
                                resolve(result)

                            }
                            else {
                                swal.fire("Error deleting!", "Please try again", "error");

                            }

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The interviewer has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interviewer/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
