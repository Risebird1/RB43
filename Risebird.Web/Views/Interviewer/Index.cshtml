<script>

    $(document).ready(function () {
        // restore clear-button if search was pre-filled from server
        if ($('#txtmeeting_filter').val()) {
            $('#meeting_filter').addClass('has-value');
        }

        // pre-warm the empty-search cache in the background so the first
        // refresh/clear is served instantly without any visible delay
        setTimeout(function () {
            if (!_srCache.hasOwnProperty('')) {
                $.ajax({
                    type: "POST",
                    url: "/Interviewer/InterviewerProfileJson",
                    data: { 'searchValue': '' },
                    success: function (data) {
                        if (data && typeof data === 'object' && data.result !== undefined) {
                            _srCache[''] = data;
                        }
                    }
                });
            }
        }, 800);  // small delay so it doesn't compete with the visible page load
    });

    var start = document.getElementById('start');
    if (start) start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            if (start) start.focus();
            start = sibling;
            sibling.focus();
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        // don't hijack arrow keys while typing in the search box
        if (document.activeElement && document.activeElement.id === 'txtmeeting_filter') return;
        e = e || window.event;
        if (!start) return;
        if (e.keyCode == '38') {
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) dotheneedful(nextrow.cells[start.cellIndex]);
        } else if (e.keyCode == '40') {
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) dotheneedful(nextrow.cells[start.cellIndex]);
        } else if (e.keyCode == '37') {
            dotheneedful(start.previousElementSibling);
        } else if (e.keyCode == '39') {
            dotheneedful(start.nextElementSibling);
        }
    }
</script>
