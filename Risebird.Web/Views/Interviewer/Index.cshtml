@model IEnumerable<Risebird.Entities.ViewModel.InterviewerProfileVM>
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interviewers</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="mdc-card card">
                  
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="toolbar">


                                <div class="row">
                                    <div class="card-header">
                                        <div class="pull-left">
                                            <h4 class="card-title">Interviewers</h4>
                                        </div>

                                        <div class="pull-right">

                                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 2px;">
                                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interviewer" onclick="location.href='@Url.Action("AddInterviewerProfile","Interviewer")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Interviewer Profile</font></span>
                                            </button>


                                        </div>
                                    </div>

                                </div>


                              
                            </div>
                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <table id="interviewer" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email Id</th>
                                            <th>Mobile Number</th>
                                            <th>City</th>
                                            <th>CurrentRole</th>
                                            <th>Experience</th>
                                            <th>Preffered Domain</th>
                                            <th>Primary Skills</th>
                                            <th>Resume Link</th>
                                            <th>GitHub Link</th>
                                            <th>Coded Resume Link</th>
                                            <th>Linkedin Link</th>
                                            <th>StackOverflow Link</th>
                                            <th>Blog</th>
                                            <th>Approved</th>
                                            <th>IsLeadInterviewer</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>First Name</th>
                                            <th>Last Name</th>
                                            <th>Email Id</th>
                                            <th>Mobile Number</th>
                                            <th>City</th>
                                            <th>CurrentRole</th>
                                            <th>Experience</th>
                                            <th>Preffered Domain</th>
                                            <th>Primary Skills</th>
                                            <th>Resume Link</th>
                                            <th>GitHub Link</th>
                                            <th>Coded Resume Link</th>
                                            <th>Linkedin Link</th>
                                            <th>StackOverflow Link</th>
                                            <th>Blog</th>
                                            <th>Approved</th>
                                            <th>Lead Interviewer</th>
                                            <th class="disabled-sorting text-right">Actions</th>
                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                        <tr id=@item.id>
                                            <td>@item.FirstName</td>
                                            <td>@item.LastName</td>
                                            <td>@item.EmailId</td>
                                            <td>@item.MobileNumber</td>
                                            <td>@item.City</td>
                                            <td>@item.CurrentRole</td>
                                            <td>@item.Experience</td>
                                            <td>@item.PreferredDomain</td>
                                            <td>
                                                <div class="talk-bubble tri-right border-bubble right-in ">
                                                    <div class="talktext">
                                                        <a href="#" data-tooltip="@item.PrimarySkill"><textarea>@item.PrimarySkill</textarea></a>
                                                    </div>
                                                </div>
                                            </td>
                                           
                                            @if (item.ResumeLink != null && item.ResumeLink != "")
                                            {
                                                <td>

                                                    <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No Resume</td>
                                            }
                                            @if (item.GitHubLink != null && item.GitHubLink != "")
                                            {
                                                <td>

                                                    <a id="githubId" target="_blank" title="Github" href=@item.GitHubLink>Github</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No Github</td>
                                            }
                                            @if (item.CodedResumeLink != null && item.CodedResumeLink != "")
                                            {
                                                <td>

                                                    <a id="codedResumeId" target="_blank" title="Coded Resume" href=@item.CodedResumeLink>Coded Resume</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No Coded Resume</td>
                                            }
                                            @if (item.LinkedinLink != null && item.LinkedinLink != "")
                                            {
                                                <td>

                                                    <a id="linkedInId" target="_blank" title="LinkedIn" href=@item.LinkedinLink>LinkedIn</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No LinkedIn</td>
                                            }
                                            @if (item.StackOverflowLink != null && item.StackOverflowLink != "")
                                            {
                                                <td>

                                                    <a id="stackOverFlowId" target="_blank" title="Stackoverflow" href=@item.StackOverflowLink>Stackoverflow</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No Stackoverflow</td>
                                            }
                                            @if (item.Blog != null && item.Blog != "")
                                            {
                                                <td>

                                                    <a id="blogId" target="_blank" title="Blog" href=@item.Blog>Blog</a>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No Blog</td>
                                            }
                                            @if (item.IsApproved == true)
                                            {
                                                <td>Approved</td>
                                            }
                                            else
                                            {
                                                <td>Not Approved</td>
                                            }
                                            @if (item.IsLeadInterviewer)
                                            {
                                                <td>Yes</td>
                                            }
                                            else
                                            {
                                                <td>No</td>
                                            }
                                            <td class="text-right action">

                                                <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit interviewer Profile">
                                                    <span onclick="location.href = '@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId})'" title="Click here to edit interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                </button>

                                                <button class="mdc-fab app-fab--absolute" aria-label="Click here to Add interviewer Employer Details">
                                                    <span onclick="location.href = '@Url.Action("IndexEmployer", "Interviewer", new { id = item.id})'" title="Click here to Add interviewer Employer Details" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><path d="M10 8c1.66 0 2.99-1.34 2.99-3S11.66 2 10 2 7 3.34 7 5s1.34 3 3 3zm-6 2V8h2V6H4V4H2v2H0v2h2v2h2zm6 0c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg></span>
                                                </button>



                                                <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete interviewer Profile">
                                                    <span onclick="javascript:DeleteEntityfromEnvironment('@item.UserId','@item.FirstName');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                </button>


                                            </td>
                                        </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Interviewer/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/Interviewer/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script>
    $(document).ready(function () {
        $('#interviewer').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: false,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });


        var table = $('#interviewer').DataTable();


    });

    function DeleteEntityfromEnvironment(UserId, FirstName) {

        swal.fire({
            title: 'Are you sure you want to delete interviewer ' + FirstName + '?',
            text: "It will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeleteInterviewerProfile',
                        data: { 'UserId': UserId },
                        type: 'Delete',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The interviewer has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interviewer/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>