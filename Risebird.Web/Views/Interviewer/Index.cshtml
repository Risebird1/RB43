    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>

    function RefreshSearch() {
        $(".dataTables_filter input").val('');
        searchResult();
    }
    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });




    });
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
<script>

    function searchResult() {

        $.ajax({
            type: "POST",
            url: "/Interviewer/InterviewerProfileJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                {
                    $('#meeting_wrapper').html('');
                    $('#meeting_wrapper').html(data);
                }
            }
        });
    }
    
    function bindPages(pagecount, startpage, endpage, totalcount) {
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        for (var i = 1; i <= pagecount; i++) {
            if (i == 1) {
                html += '   <li class="active"><span>1</span></li>';
            } else if (i <= 10) {
                html += '<li><a href="/Interviewer/Index?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '">' + i + '</a></li>';
            } else if (i == 11) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/Interviewer/Index?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/Interviewer/Index?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                html += '<li class="PagedList-skipToNext"><a href="/Interviewer/Index?Page=2&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                html += '<li class="PagedList-skipToLast"><a href="/Interviewer/Index?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>

