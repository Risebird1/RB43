                }
                else {
                    html += '  <td class="cadName"><a onclick=""> ' + data[i].firstName + '<input id="hidfirstname' + data[i].id + '" type="hidden" value="' + data[i].firstName + '"/> </a></td>';
                }
            }
            else {
                html += '<td></td>';
            }
            if (data[i].lastName != null && data[i].lastName != "") {
                if (data[i].lastName.length > 15) {
                    html += '<td class="cadLast"><a onclick="" data-tooltip="' + data[i].lastName + '"> ' + data[i].lastName.substring(0, 15) + '... </a></td>';
                }
                else {
                    html += '  <td class="cadLast"><a onclick=""> ' + data[i].lastName + ' </a></td>';
                }
            }
            else {
                html += '<td></td>';
            }
            //html += '  <td>' + data[i].emailId + '<input id="hidemail' + data[i].id + '" type="hidden" value="' + data[i].emailId + '"/></td>';



            if (data[i].emailId != null && data[i].emailId != "") {
                if (data[i].emailId.length > 25) {
                    html += '<td class="cadEmail"><a onclick="" data-tooltip="' + data[i].emailId + '">' + data[i].emailId.substring(0, 25) + '...  </a></td>';
                }
                else {
                    html += '  <td class="cadEmail"><a onclick="">' + data[i].emailId + ' </a></td>';
                }
            }
            else {
                html += '<td></td>';
            }

            html += '  <td>' + data[i].mobileNumber + '</td>';


            html += '<td class="interview-com">';
            html += ' <div id="section">';
            if (data[i].primarySkill != null && data[i].primarySkill != "") {
                if (data[i].primarySkill.length > 45) {
                    html += '  <div class="article">';
                    html += '  <p style="margin-bottom:0px;">' + data[i].primarySkill.substring(0, 45) + '</p>';
                    html += '   <p class="moretext_' + data[i].id + ' moretext">' + data[i].primarySkill.substring(45, data[i].primarySkill.length - 45) + '</p>';
                    html += '</div>';
                }
                else {
                    html += '<div class="article"><p>' + data[i].primarySkill.substring(0, data[i].primarySkill.length) + '</p></div>';
                }
            }
            else {
                html += '<div></div>';
            }
            html += ' <a onclick="moreless(' + data[i].id + ')" class="moreless-button" value="Readmore" id="read_' + data[i].id + '" href="#">Read more</a>';
            html += '</div>';
            html += ' </td>';



            html += '  <td><a id="resumeId" target="_blank" title="Resume" href=' + data[i].resumeLink.replace(" ", "%20") + '>Resume</a></td>';
            html += '   <td class="text-center action">';
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit interviewer Profile">';
            html += ' <a href = "/Interviewer/EditInterviewerProfile/?userId=' + data[i].userId + '" title="Click here to edit interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></a>';
            html += '  </button>';
            html += '  <button class="mdc-fab app-fab--absolute" aria-label="Click here to Add interviewer Employer Details">';
            html += ' <a href = "/Interviewer/IndexEmployer?id= ' + data[i].id + '" title="Assessments" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><path d="M10 8c1.66 0 2.99-1.34 2.99-3S11.66 2 10 2 7 3.34 7 5s1.34 3 3 3zm-6 2V8h2V6H4V4H2v2H0v2h2v2h2zm6 0c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg></a>';
            html += '  </button>';
