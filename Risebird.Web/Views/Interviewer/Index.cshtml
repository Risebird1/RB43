@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerProfileVM>*@

@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.InterviewerProfileVM>
@using X.PagedList.Mvc.Core;
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Interviewers";
    ViewBag.PageHeader = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string[] AssessmentGroups = new string[] { };
    string[] Senioritylevel = new string[] { };
    string[] ProfileType = new string[] { };
    string[] CompentencyLevel = new string[] { };
    string[] IndianRate = new string[] { };
    string[] OutSideIndiaRate = new string[] { };
    string[] CompanyType = new string[] { };
    string[] Domain = new string[] { };
    string[] AssessmentGroup = new string[] { };
    string[] IsLeadInterviewer = new string[] { };
    bool[] IsActive = new bool[] { };
    bool[] IsInterested = new bool[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("InterviewerIndexfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("InterviewerIndexfilters"));
    AssessmentGroups = filter.AssessmentGroup != null ? filter.AssessmentGroup : new string[] { };
    Senioritylevel = filter.Senioritylevel != null ? filter.Senioritylevel : new string[] { };
    ProfileType = filter.ProfileType != null ? filter.ProfileType : new string[] { };
    CompentencyLevel = filter.CompentencyLevel != null ? filter.CompentencyLevel : new string[] { };
    IndianRate = filter.IndianRate != null ? filter.IndianRate : new string[] { };
    OutSideIndiaRate = filter.OutSideIndiaRate != null ? filter.OutSideIndiaRate : new string[] { };
    CompanyType = filter.CompanyType != null ? filter.CompanyType : new string[] { };
    Domain = filter.Domain != null ? filter.Domain : new string[] { };
    AssessmentGroup = filter.AssessmentGroup != null ? filter.AssessmentGroup : new string[] { };
    IsLeadInterviewer = filter.IsLeadInterviewer != null ? filter.IsLeadInterviewer : new string[] { };
    IsActive = filter.IsActive != null ? filter.IsActive : new bool[] { };
    IsInterested = filter.IsInterested != null ? filter.IsInterested : new bool[] { };

}

<link href="~/Newassets/css/interviewer.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<div class="main-panel" id="main-panel">

    <input type="hidden" id="txtprofile" value="@ViewBag.profile" />

    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix interviewer-page-header">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interviewers</h4></div>
                </div>

                <div class="pull-right client-ms">



                    <div id="meeting_filter" class="interviewer-search-wrap dataTables_filter pull-left">
                        <div class="interviewer-search-box">
                            <span onclick="searchResult()" class="interviewer-search-ico" id="search" aria-hidden="true" style="background:none">
                                <svg style="position:relative;top:13px;right:13px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                            </span>
                            <span class="interviewer-search-spin" aria-hidden="true"></span>

                            <input type="search" class="interviewer-search-inp" id="txtmeeting_filter" placeholder="Search interviewers..." aria-controls="interviewer" onkeyup="searchResult()" value="@ViewBag.Searchvalue" autocomplete="off">
                            <button type="button" class="interviewer-search-reset" onclick="RefreshSearch()" title="Clear" aria-label="Clear search">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="pull-left">
                        @if (ViewBag.profile == "Admin")
                        {
                            @* <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("SendInviteCode", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Send InviteCode</font></span>
                        </button>*@
                            @* <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("InviteCodeList", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Send InviteCode</font></span>
                        </button>*@
                            <span class="interviewer_3">
                                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" style="margin-right:5px;">
                                    <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Check Interviewer availability using Email" onclick="SendIntervieweravailability()" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Interviewer availability</font></span>
                                </button>
                            </span>
                        }
                        <span class="interviewer_3">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded  card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">

                                <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        </span>
                    </div>
                    <div class="pull-left">
                        @if (ViewBag.profile != "Finance")
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("AddInterviewerProfile", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Interviewer</font></span>
                            </button>
                        }
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("LeadInterviewer", "Interviewer")'" data-original-title="Tooltip on top"><font style="font-family:arial;">Lead Interviewers</font></span>
                        </button>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" onclick="location.href='@Url.Action("EmployementDetails", "Aadhaar")'" data-original-title="Tooltip on top"><font style="font-family:arial;">Employment Verification</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading interviewer">
                            <div class="modal modal-wrap fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("Index","Interviewer")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Senioritylevel">
                                                                Seniority level
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Senioritylevel" name="Senioritylevel" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.Senioritylevel)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="ProfileType">Profile Type</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="ProfileType" name="ProfileType" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.ProfileType)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @*<div class="col-md-6 col-sm-6 border-rv">

                                                    <div class="form-group">
                                                    <label class="control-label col-md-12 col-sm-12 desp-label" for="CompentencyLevel">Compentency Level</label>
                                                    <div class="col-md-12 col-sm-12">
                                                    <select id="CompentencyLevel" name="CompentencyLevel" class="form-control multiselect" multiple="multiple">

                                                    @foreach (var item in ViewBag.CompentencyLevel)
                                                    {
                                                    @if (item != null && item != "")
                                                    {
                                                    <option value="@item">@item</option>
                                                    }
                                                    }
                                                    </select>
                                                    </div>
                                                    </div>
                                                    </div>*@
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IndianRate">India Price</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IndianRate" name="IndianRate" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.IndianRate)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="OutSideIndiaRate">Out Side India Price</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="OutSideIndiaRate" name="OutSideIndiaRate" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.OutSideIndiaRate)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="CompanyType">Company Type</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="CompanyType" name="CompanyType" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.CompanyType)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Domain">Country</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Domain" name="Domain" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.Country)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="AssessmentGroup">Assessment Group</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="AssessmentGroup" name="AssessmentGroup" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.AssessmentGroup)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IsLeadInterviewer">Is Lead Interviewer</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IsLeadInterviewer" name="IsLeadInterviewer" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">

                                                                    @foreach (var item in ViewBag.IsLeadInterviewer)
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IsActive">Is Active Interviewer</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IsActive" name="IsActive" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                    <option value="true">True</option>
                                                                    <option value="false">False</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6 border-rv">

                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="IsInterested">Is Interested Interviewer</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="IsInterested" name="IsInterested" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple" style="display: none;">
                                                                    <option value="true">True</option>
                                                                    <option value="false">False</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-12 col-sm-12" style="position: relative;">


                                                        <div>
                                                            <div class="col-md-12 col-sm-12 mc-button-area text-right">

                                                                <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn4  reset-filter">
                                                                    Reset Filter
                                                                </button>

                                                                <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn5 apply-filter">
                                                                    Apply Filter
                                                                </button>
                                                            </div>

                                                        </div>


                                                    </div>

                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>

                            <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4 interviewer-dt-wrapper">
                                <div class="col-md-12 nopad">
                                    <div class="table-responsive interviewer-table-wrap">
                                        <table id="interviewer" class="table table-hover interviewer-table-modern" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th id="start">Personal Details</th>
                                                    <th>Assessment Group</th>
                                                    <th>Resume Link</th>
                                                    <th>Coded Resume</th>
                                                    <th>Available</th>
                                                    <th>Active</th>
                                                    <th>Video Interview</th>
                                                    <th>Approved</th>
                                                    <th class="disabled-sorting text-center no-sort">ACTIONS</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tblbodyInterviewerProfile">
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.id data-changes="1">
                                                        <td class="personal-details-cell">
                                                            <div class="pd-name-row">
                                                                <span class="pd-name">@(item.FirstName ?? "") @(item.LastName ?? "") ( <span class="pd-coded"><strong>@(item.NickName ?? "—")</strong></span> )</span>
                                                            </div>
                                                            <div class="pd-meta">
                                                               
                                                                @if (ViewBag.profile == "Admin" && item.EmailId != null && item.EmailId != "")
                                                                {
                                                                    <span class="pd-email" data-tooltip="@item.EmailId">@item.EmailId</span>
                                                                }
                                                                @if (ViewBag.profile == "Admin" && item.MobileNumber != null && item.MobileNumber != "")
                                                                {
                                                                    <span class="pd-mobile">@item.MobileNumber</span>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td class="assessment-group-cell">
                                                            @if (item.AssessmentGroupId != null && item.AssessmentGroupId != "")
                                                            {
                                                                @if (item.AssessmentGroupId.Length > 25)
                                                                {
                                                                    <span data-tooltip="@item.AssessmentGroupId">@item.AssessmentGroupId.Substring(0, 25)...</span>
                                                                }
                                                                else
                                                                {
                                                                    <span>@item.AssessmentGroupId</span>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span>—</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.ResumeLink != null && item.ResumeLink != "")
                                                            {
                                                                <a class="link-badge" target="_blank" title="Resume" href="@item.ResumeLink.Replace(" ","%20")">Resume</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">—</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.CodedResumeLink != null && item.CodedResumeLink != "")
                                                            {
                                                                <a class="link-badge" target="_blank" title="Coded Resume" href="@item.CodedResumeLink.Replace(" ","%20")">Coded Resume</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">—</span>
                                                            }
                                                        </td>
                                                        <td><span class="status-badge status-@(item.AvailabilityStatusValue?.ToLower().Replace(" ", "-") ?? "na")">@(item.AvailabilityStatusValue ?? "—")</span></td>
                                                        <td><span class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                                        <td>
                                                            @if (item.VideoConfirmation == 1) { <span class="status-badge status-yes">Yes</span> }
                                                            else if (item.VideoConfirmation == 2) { <span class="status-badge status-no">No</span> }
                                                            else { <span>—</span> }
                                                        </td>
                                                        <td><span class="status-badge @(item.IsApproved == true ? "status-approved" : "status-not-approved")">@(item.IsApproved == true ? "Approved" : "Not Approved")</span></td>
                                                        <td class="text-center action-cell act-btns">
                                                            <a href="@Url.Action("InterviewerRecommendation", "Interviewer", new { id = item.UserId })" class="btn-act" title="Recommendation">
                                                                <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"/></svg>
                                                            </a>
                                                            <button type="button" class="btn-act" title="Availability Details" onclick="openAvailDetailsModel(@item.id)">
                                                                <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
                                                            </button>
                                                            <button type="button" class="btn-act" title="Bank Details" onclick="openBankDetailsModel(@item.id)">
                                                                <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M2 17v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2"/><path d="M4 10V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3"/><path d="M2 10h20"/></svg>
                                                            </button>
                                                            @if (ViewBag.profile != "Finance")
                                                            {
                                                                <a href="@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId })" class="btn-act btn-act-edit" title="Edit Profile" onclick="captureInterviewerRelatedclick('Interviewer', 'Edit',0,@item.id)">
                                                                    <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                                                </a>
                                                            }
                                                            <a href="@Url.Action("IndexEmployer", "Interviewer", new { id = item.id })" class="btn-act" title="Employer Details">
                                                                <svg class="icon-m" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                                            </a>
