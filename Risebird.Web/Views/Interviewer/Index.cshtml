@*@model IEnumerable<Risebird.Entities.ViewModel.InterviewerProfileVM>*@

@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.InterviewerProfileVM>
@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interviewer.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Interviewers</a>
            </div>
        </div>
    </nav>
    <!-- End Navbar -->


    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Interviewers</h4></div>
                </div>

                <div class="pull-right">

                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to add interviewer" onclick="location.href='@Url.Action("AddInterviewerProfile","Interviewer")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;">  Add Interviewer</font></span>
                    </button>

                    <div id="meeting_filter" class="dataTables_filter pull-left  mt-20">

                        <div class="searchCon" style="margin-right:10px;">

                            <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                            <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeyup="searchResult()" value="@ViewBag.Searchvalue">



                            <button style="display:none;" type="button" id="x">x</button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>




    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                <div class="col-md-12">
                                    <div class="table-responsive">
                                        <table id="interviewer" class="table table-striped table-bordered interviewertable" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th style="border-right: 0px !important;"></th>
                                                    <th id="start">First Name</th>
                                                    <th>Last Name</th>
                                                    <th>Email Id</th>
                                                    <th>Mobile Number</th>

                                                    <th>Primary Skills</th>
                                                    <th>Resume Link</th>

                                                    <th class="disabled-sorting text-center">Actions</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th style="border-right: 0px !important;"></th>
                                                    <th>First Name</th>
                                                    <th>Last Name</th>
                                                    <th>Email Id</th>
                                                    <th>Mobile Number</th>

                                                    <th>Primary Skills</th>
                                                    <th>Resume Link</th>

                                                    <th class="disabled-sorting text-center">Actions</th>
                                                </tr>
                                            </tfoot>
                                            <tbody id="tblbodyInterviewerProfile">
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.id data-changes="1">
                                                        <td style="width:10px;" data-toggle="collapse" id="@item.id" data-target=".@item.id" class="detail-row" onclick="changeicon('@item.id')">&nbsp;</td>
                                                        @if (item.FirstName != null && item.FirstName != "")
                                                        {


                                                            @if (item.FirstName.Length > 20)
                                                            {


                                                                <td class="cadName">
                                                                    <a onclick="" data-tooltip="@item.FirstName"> @item.FirstName.Substring(0, 20)... </a>
                                                                </td>
                                                            }


                                                            else
                                                            {
                                                                <td class="cadName">
                                                                    <a onclick=""> @item.FirstName </a>
                                                                </td>
                                                            }

                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.LastName != null && item.LastName != "")
                                                        {


                                                            @if (item.LastName.Length > 15)
                                                            {


                                                                <td class="cadLast">
                                                                    <a onclick="" data-tooltip="@item.LastName"> @item.LastName.Substring(0, 15)... </a>
                                                                </td>
                                                            }


                                                            else
                                                            {
                                                                <td class="cadLast">
                                                                    <a onclick=""> @item.LastName </a>
                                                                </td>
                                                            }

                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.EmailId != null && item.EmailId != "")
                                                        {

                                                            @if (item.EmailId.Length > 25)
                                                            {


                                                                <td class="cadEmail">
                                                                    <a onclick="" data-tooltip="@item.EmailId"> @item.EmailId.Substring(0, 25)... </a>
                                                                </td>
                                                            }


                                                            else
                                                            {
                                                                <td class="cadEmail">
                                                                    <a onclick=""> @item.EmailId </a>
                                                                </td>
                                                            }

                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        <td>@item.MobileNumber</td>


                                                        <td class="interview-com">


                                                            <div id="section">
                                                                @if (item.PrimarySkill != null && item.PrimarySkill != "")
                                                                {
                                                                    @if (item.PrimarySkill.Length > 45)
                                                                    {
                                                                        <div class="article">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.PrimarySkill.Substring(0, 45)
                                                                            </p>
                                                                            <p class="moretext_@item.id moretext">
                                                                                @item.PrimarySkill.Substring(45, @item.PrimarySkill.Length - 45)
                                                                            </p>
                                                                        </div>
                                                                        <a onclick="moreless(@item.id)" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article">

                                                                            <p>
                                                                                @item.PrimarySkill.Substring(0, @item.PrimarySkill.Length)
                                                                            </p>
                                                                        </div>}
                                                                }
                                                                else
                                                                { <div></div>}


                                                            </div>




                                                        </td>



                                                        @if (item.ResumeLink != null && item.ResumeLink != "")
                                                        {
                                                            <td>

                                                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink.Replace(" ","%20")>Resume</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }




                                                        <td class="text-right action">

                                                            <button class="mdc-fab app-fab--absolute" aria-label="Click here to edit interviewer Profile">
                                                                <span onclick="location.href = '@Url.Action("EditInterviewerProfile", "Interviewer", new { userId = item.UserId})'" title="Click here to edit interviewer Profile" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                            </button>

                                                            <button class="mdc-fab app-fab--absolute" aria-label="Click here to Add interviewer Employer Details">
                                                                <span onclick="location.href = '@Url.Action("IndexEmployer", "Interviewer", new { id = item.id})'" title="Click here to Add interviewer Employer Details" class="mdc-fab__icon material-icons"> <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"><path d="M10 8c1.66 0 2.99-1.34 2.99-3S11.66 2 10 2 7 3.34 7 5s1.34 3 3 3zm-6 2V8h2V6H4V4H2v2H0v2h2v2h2zm6 0c-2.33 0-7 1.17-7 3.5V16h14v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg></span>
                                                            </button>



                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Click here to delete interviewer Profile">
                                                                <span onclick="javascript:DeleteEntityfromEnvironment('@item.UserId','@item.FirstName');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                            </button>


                                                        </td>
                                                    </tr>


