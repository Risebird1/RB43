                                                                    <td>@item.CurrentRole</td>
                                                                    <td>@item.Experience</td>
                                                                    <td>@item.PreferredDomain</td>

                                                                    @if (item.GitHubLink != null && item.GitHubLink != "")
                                                                    {
                                                                        <td>

                                                                            <a id="githubId" target="_blank" title="Github" href=@item.GitHubLink>Github</a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Github</td>
                                                                    }
                                                                    @if (item.LinkedinLink != null && item.LinkedinLink != "")
                                                                    {
                                                                        <td>

                                                                            <a id="linkedInId" target="_blank" title="LinkedIn" href=@item.LinkedinLink>LinkedIn</a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No LinkedIn</td>
                                                                    }

                                                                    @if (item.StackOverflowLink != null && item.StackOverflowLink != "")
                                                                    {
                                                                        <td>

                                                                            <a id="stackOverFlowId" target="_blank" title="Stackoverflow" href=@item.StackOverflowLink>Stackoverflow</a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Stackoverflow</td>
                                                                    }
                                                                    @if (item.Blog != null && item.Blog != "")
                                                                    {
                                                                        <td>

                                                                            <a id="blogId" target="_blank" title="Blog" href=@item.Blog>Blog</a>
                                                                        </td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>No Blog</td>
                                                                    }
                                                                </tr>

                                                            </table>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                                <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                    Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                </div>

                                <div class="col-sm-12 col-md-7 dataTables_paginate pull-right" id="divmeetingpages">
                                    @Html.PagedListPager(Model, Page => Url.Action("Index", new { Page = Page }))
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("Success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        window.location.href = '/Interviewer/Index';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        window.location.href = '/Interviewer/Index';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script>

    function DeleteEntityfromEnvironmentJson(userId) {
        var firstnamne = $('#hidfirstname' + userId).val();
        DeleteEntityfromEnvironment(userId, firstnamne);

    }

    function DeleteEntityfromEnvironment(UserId, FirstName) {

        swal.fire({
            title: 'Are you sure you want to delete interviewer ' + FirstName + '?',
            text: "It will be permanently deleted!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/DeleteInterviewerProfile',
                        data: { 'UserId': UserId },
                        type: 'Delete',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>The interviewer has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Interviewer/Index";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewer").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewer").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewer").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    $(document).ready(function () {

        $(".dataTables_filter").keyup(function (e) {

            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            searchResult();
        });




    });
    var start = document.getElementById('start');
    start.focus();

    function dotheneedful(sibling) {
        if (sibling != null) {
            start.focus();
            start.style.backgroundColor = '';
            start.style.color = '';
            sibling.focus();
            start = sibling;
        }
    }

    document.onkeydown = checkKey;

    function checkKey(e) {
        e = e || window.event;
        if (e.keyCode == '38') {
            // up arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.previousElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '40') {
            // down arrow
            var idx = start.cellIndex;
            var nextrow = start.parentElement.nextElementSibling;
            if (nextrow != null) {
                var sibling = nextrow.cells[idx];
                dotheneedful(sibling);
            }
        } else if (e.keyCode == '37') {
            // left arrow
            var sibling = start.previousElementSibling;
            dotheneedful(sibling);
        } else if (e.keyCode == '39') {
            // right arrow
            var sibling = start.nextElementSibling;
            dotheneedful(sibling);
        }
    }
</script>
<script>

    function searchResult() {

        $.ajax({
            type: "POST",
            url: "/Interviewer/InterviewerProfileJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {

                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry);
                }
            }
        });
    }
    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="9" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {

