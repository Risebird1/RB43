    function SetChartAndTotal() {
        var items = $('[id$="WeightageActual"]');
        var totalCount = 0;
        var techTotal = 0;
        for (i = 0; i < items.length; i++) {
            techTotal += parseFloat(items[i].value);
        }
        var profileScore = 0;
        var personalityScore = 0;
        var interviewingAbilityScore = 0;

        // get all the other scores to add to the total count
        var profileValue = document.getElementById("ProfileScore").value;
        var personalityValue = document.getElementById("OverallPersonalityScore").value;
        var interviewingAbilityValue = document.getElementById("OverallInterviewingAbilityScore").value;

        if (profileValue != null && profileValue != '') {
            profileScore = parseFloat(profileValue);
        }
        if (personalityValue != null && personalityValue != '') {
            personalityScore = parseFloat(personalityValue);
        }
        if (interviewingAbilityValue != null && interviewingAbilityValue != '') {
            interviewingAbilityScore = parseFloat(interviewingAbilityValue);
        }

        totalCount = (techTotal + profileScore + personalityScore + interviewingAbilityScore) / 4;
        if (totalCount != Math.floor(totalCount)) {
            totalCount = totalCount.toFixed(2);
        }
        $("#OverallScore").val(totalCount);

        document.getElementById("totScore").innerHTML = totalCount;

        var arr = [];
        var obj = { y: "", legendText: "", label: "" }

        obj.y = techTotal / 4;
        obj.label = "Tech Skills Score";
        obj.legendText = "Tech Skills Score";
        arr.push(obj.y);


        var objProfile = { y: "", legendText: "", label: "" }

        objProfile.y = profileScore / 4;
        objProfile.label = "Profile Score";
        objProfile.legendText = "Profile Score";
        arr.push(objProfile.y);

        var objPersonality = { y: "", legendText: "", label: "" }

        objPersonality.y = personalityScore / 4;
        objPersonality.label = "Personality Score";
        objPersonality.legendText = "Personality Score";
        arr.push(objPersonality.y);

        var objInterviewingAbility = { y: "", legendText: "", label: "" }

        objInterviewingAbility.y = interviewingAbilityScore / 4;
        objInterviewingAbility.label = "Interviewing Ability Score";
        objInterviewingAbility.legendText = "Interviewing Ability Score";
        arr.push(objInterviewingAbility.y);

        am4core.ready(function () {

            // Themes begin
            am4core.useTheme(am4themes_animated);
            // Themes end

            // Create chart instance
            var chart = am4core.create("scoreChart", am4charts.XYChart);

            // Add data
            chart.data = [{
                "country": "Tech",
                "visits": arr[0]

            }, {
                "country": "Profile",
                "visits": arr[1]
            }, {
                "country": "Personality",
                "visits": arr[2]
            }, {
                "country": "Interviewing Ability",
                "visits": arr[3]
            }];

            // Create axes
            chart.logo.disabled = true;
            var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
            categoryAxis.dataFields.category = "country";
            categoryAxis.renderer.inside = true;
            categoryAxis.renderer.labels.template.valign = 0;

            categoryAxis.renderer.grid.template.location = 0;
            categoryAxis.renderer.minGridDistance = 30;
            chart.fontSize = 13;
            categoryAxis.renderer.labels.template.fill = am4core.color("#828080");
            categoryAxis.renderer.labels.template.adapter.add("dy", function (dy, target) {
                if (target.dataItem && target.dataItem.index & 2 == 2) {
                    return dy;
                }
                return dy;
            });

            var valueAxis = chart.yAxes.push(new am4charts.ValueAxis());

            categoryAxis.renderer.grid.template.disabled = true;
            valueAxis.renderer.grid.template.disabled = true;
            valueAxis.min = 0;
            valueAxis.max = 30;
            categoryAxis.renderer.labels.template.paddingBottom = 165;

            categoryAxis.renderer.labels.template.fill = am4core.color("#828080");
            // Create series
            var series = chart.series.push(new am4charts.ColumnSeries());
            series.dataFields.valueY = "visits";
            series.dataFields.categoryX = "country";
            series.name = "Visits";
            series.colorField = "color";

            series.columns.template.tooltipText = "{valueY.percent}[/] ({valueY})";
            //series.columns.template.tooltipText = "{valueY.percent}[/] valueY.formatNumber('#.00')}";
            series.tooltip.label.adapter.add("text", function (text, target) {
                if (target.dataItem && target.dataItem.valueY == 0) {

                    return "";
                }
                else {

                    return text;
                }
            });
            series.columns.template.fillOpacity = .8;
            series.columns.template.tooltipY = 8;
            series.tooltip.background.strokeOpacity = 0
            series.tooltip.pointerOrientation = "vertical";
            series.columns.template.showTooltipOn = "always";
            series.tooltip.background.filters.clear();
            series.tooltip.getFillFromObject = false;
            series.tooltip.label.fill = am4core.color("#9a9a9a");
            series.tooltip.background.cornerRadius = 0;
            series.tooltip.label.textAlign = "middle";
            series.tooltip.background.fill = 0;
            var columnTemplate = series.columns.template;
            columnTemplate.strokeWidth = 2;
            columnTemplate.strokeOpacity = 1;
            chart.colors.list = [
                am4core.color("#07BEF3"),
                am4core.color("#00F96B"),
                am4core.color("#F64042"),
                am4core.color("#00A8B0")

            ];
            series.columns.template.events.once("inited", function (event) {
                event.target.fill = chart.colors.getIndex(event.target.dataItem.index);
            });

        });

    }
    function AddRow() {


        var $ttc = $("#QuestionsTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#QuestionsTable tr").length - 1;

        $tr.find("input,select,hidden,text").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        //$tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#QuestionsTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        // Check document for changes
        //$.validator.unobtrusive.parse(document);

    }

    function DeleteRow(element, collectionName, tdOne, tdTwo, tdThree) {

        if ($(element).parents('tbody').find('tr').length === 1) {

            alert('Must have atleast one Row');
            return false;
        }

        else {
            document.getElementById("btnUpload").disabled = false;

            //var currentvalue = $(this).attr('value');
            var closestRow = $(element).closest('tr');
            var currentIndex = closestRow[0].sectionRowIndex;
            var totalRows = $(element).parents('tbody').find('tr').length;
            var maxIndex = totalRows - 1;
            if (currentIndex == maxIndex) {
                $(element).closest('tr').remove();
            }
            else {
                $(element).closest('tr').remove();
                var startIndex = currentIndex + 1;
                var endIndex = maxIndex + 1;
                for (i = startIndex; i < endIndex; i++) {

                    var elem1 = document.getElementById(collectionName + "_" + i + "__" + tdOne);
                    elem1.id = collectionName + "_" + (i - 1) + "__" + tdOne;
                    elem1.name = collectionName + "[" + (i - 1) + "]." + tdOne;

                    var elem2 = document.getElementById(collectionName + "_" + i + "__" + tdTwo);
                    elem2.id = collectionName + "_" + (i - 1) + "__" + tdTwo;
                    elem2.name = collectionName + "[" + (i - 1) + "]." + tdTwo;

                    var elem3 = document.getElementById(collectionName + "_" + i + "__" + tdThree);
                    elem3.id = collectionName + "_" + (i - 1) + "__" + tdThree;
                    elem3.name = collectionName + "[" + (i - 1) + "]." + tdThree;


                }

            }

        }




    }



    function MeetingStatusChanged(value) {
        if (value == 1 || value == 3) {
            document.getElementById("InterviewStatus").value = '';
            document.getElementById("InterviewStatus").disabled = true;
        }
        else {
            document.getElementById("InterviewStatus").disabled = false;
        }
    }

    function CheckConditions() {
        return (CheckRecommendationValues() && CheckInterviewerComments() && CheckQuestions()) && CheckScores();
    }

    function CheckScores() {
        var profileValue = document.getElementById("ProfileScore").value;

        if (profileValue == null || profileValue == '') {
            document.getElementById("ProfileScore").focus();
            return false;
        }
        var personalityValue = document.getElementById("OverallPersonalityScore").value;

        if (personalityValue == null || personalityValue == '') {
            document.getElementById("OverallPersonalityScore").focus();
            return false;

        }

        var interviewingAbilityValue = document.getElementById("OverallInterviewingAbilityScore").value;

        if (interviewingAbilityValue == null || interviewingAbilityValue == '') {
            document.getElementById("OverallInterviewingAbilityScore").focus();
            return false;
        }
        return true;
    }

    function CheckQuestions() {
        var questionItems = $('[id^="InterviewerQuestionsCollection"][id$="Question"]');
        for (i = 0; i < questionItems.length; i++) {

            var question = $("#" + questionItems[i].id).val();
            if (question == null || question == '') {
                document.getElementById("Question_Error").innerHTML = "Kindly fill the Question(s)";
                document.getElementById(questionItems[i].id).focus();

                return false;
            }

        }
        document.getElementById("Question_Error").innerHTML = "";
        return true;

    }

    function CheckInterviewerComments() {
        var interviewStatusElem = document.getElementById("InterviewStatus");
        if (interviewStatusElem.value == 2 || interviewStatusElem.value == 4) {
            var comments = document.getElementById("InterviewerComment").value;
            if (comments.length >= 250 && comments.length <= 2000) {
                document.getElementById("interviewerComment_Error").innerHTML = "";
                return true;
            }
            else {
                //interviewerComment_Error
                document.getElementById("InterviewerComment").focus();
                document.getElementById("interviewerComment_Error").innerHTML = "The comment should be a minimum of 250 characters long and should not exceed 2000 characters.";
                return false;
            }
        }
        else
            return true;
    }



