                                                    @Html.Label("Interviewer's Name", "Interviewer's Name", htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    @if (Model.IsInterviewer && Model.CandidateName != null)
                                                    {
                                                        @Regex.Replace(@Model.CandidateName, "[a-zA-Z0-9]", "*")
                                                    }
                                                    else
                                                    {
                                                        @Html.TextBoxFor(m => m.CandidateName, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    @Html.LabelFor(model => model.interviewDate, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                                                    @Html.TextBoxFor(m => m.interviewDate, new { @class = "form-control text-box single-line", @readonly = "readonly" })
                                                </div>
                                            </div>

