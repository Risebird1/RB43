                            <div class="step-wizard-item active" data-step="1">
                                <div class="step-number">1</div>
                                <div class="step-title">Personal Info & Verification</div>
                            </div>
                            <div class="step-wizard-item" data-step="2">
                                <div class="step-number">2</div>
                                <div class="step-title">Resume Upload</div>
                            </div>
                        </div>

                        <!-- Step 1: Personal Information & Verification -->
                        <div class="form-step active" id="step1">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div style="position:relative;top:-10px;">
                                        <span class="dashboard-iconcolor" style="background-image:none!;width:30px!important;height:30px!important;background-image: none!important;">
