<script>
    // Multi-step form handling
    let currentStep = 1;
    const totalSteps = 2;

    function updateStepWizard(step) {
        // Remove active class from all steps
        document.querySelectorAll('.step-wizard-item').forEach(item => {
            item.classList.remove('active');
            item.classList.remove('completed');
        });

        // Add appropriate classes
        for (let i = 1; i <= totalSteps; i++) {
            const stepItem = document.querySelector(`.step-wizard-item[data-step="${i}"]`);
            if (i < step) {
                stepItem.classList.add('completed');
            } else if (i === step) {
                stepItem.classList.add('active');
            }
        }
    }

    function showStep(step) {
        // Hide all steps
        document.querySelectorAll('.form-step').forEach(stepElement => {
            stepElement.classList.remove('active');
        });

        // Show current step
        document.getElementById(`step${step}`).classList.add('active');
        updateStepWizard(step);
    }

    function validateStep(step) {
        switch(step) {
            case 1:
                const name = document.getElementById('NameAsMentionedByApplicant').value;
                const phone = document.getElementById('Phone').value;
                const email = document.getElementById('EmailId').value;
                const referredBy = document.getElementById('ReferredBy').value;

                if (!name || !phone || !email || !referredBy) {
                    swal.fire('Please fill in all required fields.');
                    return false;
                }
                return validateForm(); // Use existing validation
            case 2:
                const resumeFile = document.getElementById('ResumeFile').files[0];
                if (!resumeFile) {
                    swal.fire('Please upload your resume.');
                    return false;
                }
                return true;
            default:
                return true;
        }
    }

  

    // Modified checkEmailidExist function
    var clickverification = 0;
    var emailId;
    function checkEmailidExist() {
        if (validateForm()) {
            var interviewer = $("#EmailId").val().trim();
            if (clickverification == 0) {
                clickverification = 1;

                // Show loading state
                const verifyButton = document.getElementById('verifyButton');
                const verificationStatus = document.getElementById('verificationStatus');
                verifyButton.disabled = true;
                verifyButton.innerHTML = 'Verifying...';
                verificationStatus.style.display = 'none';

                $.ajax({
                    url: '/Interviewer/GetInterviwerExists',
                    type: 'POST',
                    async: false,
                    data: { 'interviewer': interviewer },
                    success: function (result) {
                        if (result) {
                            showVerificationError("Not Applicable!");
                            clickverification = 0;
                        } else {
                            var mobilenumber = $("#Phone").val();
                            emailId = $("#EmailId").val();
                            var nameAsMentionedByApplicant = $("#NameAsMentionedByApplicant").val();
                            var isApplicantRenewedVar = true;
                            var irfId = $("#IRFId").val();
                            var assessmentGroupId = $("#AssessmentGroupId").val();
                            var referredBy = $("#ReferredBy").val();

                            if (mobilenumber.trim() != '' && emailId.trim() != '') {
                                if (mobilenumber.trim().length == 10) {
                                    $.ajax({
                                        url: '/Aadhaar/EvVerification',
                                        type: 'POST',
                                        data: {
                                            mobilenumber: mobilenumber,
                                            candidateemail: emailId,
                                            isApplicantRenewed: isApplicantRenewedVar,
                                            nameAsMentionedByApplicant: nameAsMentionedByApplicant,
                                            irfId: irfId,
                                            assessmentGroupId: assessmentGroupId,
                                            referredBy: referredBy
                                        },
                                        success: function (result) {
                                            if (result.message == null) {
                                                $("#id").val(result.id);
                                                $("#AssessmentGroup").val(result.assessmentGroup);
                                                showVerificationSuccess();
                                                // Move to next step after short delay
                                                setTimeout(() => {
                                                    currentStep = 2;
                                                    showStep(2);
                                                }, 1000);
                                            } else {
                                                showVerificationError(result.message);
                                                clickverification = 0;
                                            }
                                        }
                                    });
                                } else {
                                    showVerificationError("Please enter a valid 10 digit Mobile Number.");
                                    clickverification = 0;
                                }
                            } else {
                                showVerificationError("Please enter a Mobile Number and Email Address.");
                                clickverification = 0;
                            }
                        }
                    }
                });
            }
        }
    }

    function showVerificationSuccess() {
        const verifyButton = document.getElementById('verifyButton');
        const verificationStatus = document.getElementById('verificationStatus');

        verifyButton.disabled = true;
        verifyButton.innerHTML = 'Verified ✓';
        verifyButton.style.backgroundColor = '#28a745';

        verificationStatus.className = 'verification-status success';
        verificationStatus.innerHTML = 'Verification successful! Proceeding to resume upload...';
        verificationStatus.style.display = 'block';
    }

    function showVerificationError(message) {
        const verifyButton = document.getElementById('verifyButton');
        const verificationStatus = document.getElementById('verificationStatus');

        verifyButton.disabled = false;
        verifyButton.innerHTML = 'Verify Details';
        verifyButton.style.backgroundColor = '';

        verificationStatus.className = 'verification-status error';
        verificationStatus.innerHTML = message;
        verificationStatus.style.display = 'block';
    }

    // Existing validation function
    function validateForm() {
        const phoneNumber = document.getElementById("Phone").value;
        const emailId = document.getElementById("EmailId").value;
        const phoneRegex = /^[0-9]{10}$/;
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        let isValid = true;

        if (!phoneRegex.test(phoneNumber)) {
            swal.fire("Please enter a valid 10-digit mobile number without spaces, country code, or special characters.");
            isValid = false;
        }

        if (!emailRegex.test(emailId)) {
            swal.fire("Please enter a valid email address.");
            isValid = false;
        }

        return isValid;
    }

    // Modified GenerateAIVerdict function
    function GenerateAIVerdict() {
        if (!validateStep(2)) {
            return;
        }

        var applicantId = $("#id").val();
        var buttonAI = document.getElementById("id_btn_generateAIVerdict");

        buttonAI.disabled = true;
        buttonAI.innerHTML = "Processing...";
        swal.fire('Application is under process...may take upto 30s! Please wait!');

        var resume_file = $("#ResumeFile")[0].files[0];
        var formdata = new FormData();
        formdata.append('resume_file', resume_file);
        formdata.append('id', applicantId);

        $.ajax({
            type: "POST",
            url: "/AIScreener/ApplicantAIScreeningRenewed",
            async: true,
            contentType: false,
            processData: false,
            data: formdata,
            timeout: 300000,
            success: function (data) {
                if (data != null && typeof data === 'object' && (data.errorMessage == '' || (data.errorMessage && data.errorMessage.includes('bypassed')))) {
                    if (data.isfavourableVerdict) {
                        buttonAI.innerHTML = "Processed!";
                        swal.fire("Processed! An acknowledgement mail has been sent. Kindly confirm.");
                    } else if (!data.isfavourableVerdict && data.errorMessage && data.errorMessage.includes('bypassed')) {
                        buttonAI.innerHTML = "Error";
                        swal.fire("Error processing. Please try again later.");
                    } else {
                        buttonAI.innerHTML = "Processed";
                        swal.fire("Processed. Unfortunately, your profile does not match the current requirement. Thank you for applying!");
                    }
                } else if (data != null && typeof data === 'object' && data.errorMessage != '') {
                    buttonAI.innerHTML = "Error";
                    swal.fire(data.errorMessage);
                } else {
                    buttonAI.innerHTML = "Error";
                    swal.fire("Error processing. Please try again later.");
                }
            },
            error: function (xhr, status, error) {
                buttonAI.disabled = false;
                buttonAI.innerHTML = "Submit";
                if (status === 'timeout') {
                    swal.fire("The request timed out. Please try again.");
                } else {
                    swal.fire("Something went wrong. Please try again later.");
                }
            }
        });
    }
</script>





 <script>
    const dt = new DataTransfer();

    $("#ResumeFile").on('change', function (e) {
        // Clear previous files and UI
        dt.clearData();
        $("#filesList > #files-names").empty();

        // Get the first file (ignore others)
        const file = this.files[0];
        if (!file) return;
          // Validate file type
        if (file.type !== 'application/pdf') {
            swal.fire('Please upload a PDF file only.');
            this.value = '';
            return;
        }
        // Add file to DataTransfer object
        dt.items.add(file);
        this.files = dt.files;

        // Create display block
        let fileBloc = $('<span/>', { class: 'file-block' }),
            fileName = $('<span/>', { class: 'name', text: file.name });
        fileBloc.append('<span class="file-delete"><span>+</span></span>')
            .append(fileName);
        $("#filesList > #files-names").append(fileBloc);

        // Add delete functionality
        $('span.file-delete').click(function () {
            // Remove file display
            $(this).parent().remove();
            dt.clearData();
            document.getElementById('ResumeFile').value = '';
        });
    });
</script>