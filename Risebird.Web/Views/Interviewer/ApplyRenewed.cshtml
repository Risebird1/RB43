                                    </div>
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.Phone, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "padding:0px 5px 0px 10px" })<span class="red" style="padding-right:5px;">*</span>
                                            <span style="color:#e02929;font-size:12.9px;">Please enter your 10-digit mobile number linked to your UAN (no spaces, country code, or special characters). This is for verification only and will remain confidential.</span>
                                        </div>
                                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control text-box single-line", @maxlength = "10" } })
                                    </div>
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.EmailId, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "padding:0px 5px 0px 10px" })<span class="red" style="padding-right:10px;">*</span>
                                            <span style="color:#e02929;font-size:12.9px;">Please enter your personal email id associated with your UAN. This is for verification only and will remain confidential</span>
                                        </div>
                                        @Html.EditorFor(model => model.EmailId, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                    </div>
                                    <div class="form-group">
                                        <div class="mandate">
                                            @Html.LabelFor(model => model.ReferredBy, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "padding:0px 5px 0px 10px" })<span class="red">*</span>
                                        </div>
                                        @Html.EditorFor(model => model.ReferredBy, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                    </div>

                                    <!-- Verification Button -->
                                    <button type="button" id="verifyButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onclick="checkEmailidExist()">Verify Details</button>

                                    <!-- Verification Status -->
                                    <div class="verification-status" id="verificationStatus" style="display: none;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Resume Upload -->
                        <div class="form-step" id="step2">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div style="position:relative;top:-10px;">
                                        <span class="dashboard-iconcolor" style="width:30px!important;height:30px!important;background-image: none!important;">
                                            <i class="fa fa-upload" aria-hidden="true" style="font-size: 17px;color: #fff;position: relative;top: -7px;left: -5px;"></i>
                                        </span>
                                        <h4>Resume Upload</h4>
                                    </div>
                                    <div class="form-group">
                                        <span class="desp-label control-label" style="font-weight: 600!important;font-size: 15px!important;padding-left:30px;">Upload Resume (.pdf only)</span>
                                        <div class="" id="uploadDiv">
@*                                                                                       @Html.TextBoxFor(model => model.ResumeFile, new { type = "file", @class = "choose-file", @accept = ".pdf", @style = "margin: 0px 0px 10px 0px !important;" })
 *@                                          
                                       <div class="drop-box">
                                                <header>
                                                    <h4>Select File here</h4>
                                                </header>
                                                <p>Files Supported: PDF</p>

                                                @Html.TextBoxFor(model => model.ResumeFile, new { type = "file", @class = "choose-file", @accept = ".pdf", @id = "ResumeFile", @style = "visibility: hidden; position: absolute;" })
                                                <label for="ResumeFile" class="drop-btn text-light" role="button">
                                                    Drop your files or <span class="filepond--label-action" tabindex="0">Browse</span>
                                                </label>
                                                 <div id="files-area">
                                                    <span id="filesList">
                                                        <span id="files-names"></span>
                                                    </span>
                                                     </div>
                                               
                                            </div> 


                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="step-buttons">
   
                                <button type="button" value="generateAIVerdict" id="id_btn_generateAIVerdict" onclick="GenerateAIVerdict()" class="mdc-button mdc-button--raised mdc-ripple-upgraded">Submit</button>

                            
                            </div>
                        </div>

                        @Html.HiddenFor(Model => Model.AssessmentGroup)
                        @Html.HiddenFor(Model => Model.IRFId)
                        @Html.HiddenFor(Model => Model.AssessmentGroupId)
                        @Html.HiddenFor(Model => Model.id)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

