                                        <div class="mandate">
                                            @Html.LabelFor(model => model.NameAsMentionedByApplicant, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label", @style = "padding:0px 5px 0px 10px" })<span class="red">*</span>
                                        </div>
