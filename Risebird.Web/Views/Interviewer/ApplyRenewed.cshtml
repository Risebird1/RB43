<script>
    var clickverification = 0;
    var emailId;
    function checkEmailidExist() {
        debugger;
        if (validateForm()) {
            var interviewer = $("#EmailId").val().trim();
            if (clickverification == 0) {
                clickverification = 1;
                $.ajax({
                    url: '/Interviewer/GetInterviwerExists',
                    type: 'POST',
                    async: false,
                    data: { 'interviewer': interviewer },
                    success: function (result) {
                        if (result) {
                            swal.fire("Not Applicable!");//is already an internal panel. External links are not applicable to such panels. Should be given internal link.
                            clickverification = 0;
                        }
                        else {
                            debugger;
                            var mobilenumber = $("#Phone").val();
                            emailId = $("#EmailId").val();
                            var nameAsMentionedByApplicant = $("#NameAsMentionedByApplicant").val();
                            var isApplicantRenewedVar = true;
                            var irfId = $("#IRFId").val();
                            var referredBy = $("#ReferredBy").val();
                            if (mobilenumber.trim() != '' && emailId.trim() != '') {
                                if (mobilenumber.trim().length == 10) {
                                    $.ajax({
                                        url: '/Aadhaar/EvVerification',
                                        type: 'POST',
                                        data: { mobilenumber: mobilenumber, candidateemail: emailId, isApplicantRenewed : isApplicantRenewedVar, nameAsMentionedByApplicant : nameAsMentionedByApplicant, irfId : irfId, referredBy :referredBy },
                                        success: function (result) {
                                            debugger;
                                            if (result.message == null) {
                                                document.getElementById("divEVverification").style.display = "none";
                                                document.getElementById("divAIVerdict").style.display = "block";
                                                $("#id").val(result.id);
                                                $("#AssessmentGroup").val(result.assessmentGroup);
                                                
                                            } else {
                                                swal.fire(result.message);
                                                clickverification = 0;
                                            }
                                        }
                                    });
                                } else {
                                    swal.fire("Please enter a valid 10 digit Mobile Number.");
                                    clickverification = 0;
                                }

                            } else {
                                swal.fire("Please enter a Mobile Number and Email Address.");
                                clickverification = 0;
                            }
                        }
                    }
                });
            }
        }
        else {
            // Prevent form submission if validation fails
            alert("Validation failed.");
        }
    }

    // Function to validate phone number and email
    function validateForm() {
        const phoneNumber = document.getElementById("Phone").value;
        const emailId = document.getElementById("EmailId").value;

        // Regular expression for 10-digit phone number without spaces or special characters
        const phoneRegex = /^[0-9]{10}$/;
        // Regular expression for valid email format
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        let isValid = true;

        // Validate phone number
        if (!phoneRegex.test(phoneNumber)) {
            alert("Please enter a valid 10-digit mobile number without spaces, country code, or special characters.");
            isValid = false;
        }

        // Validate email
        if (!emailRegex.test(emailId)) {
            alert("Please enter a valid email address.");
            isValid = false;
        }

        return isValid;
    }
</script>

<script>
    function GenerateAIVerdict() {
        debugger;
        var applicantId = $("#id").val();
        var buttonAI = document.getElementById("id_btn_generateAIVerdict");

        buttonAI.disabled = true;
        buttonAI.innerHTML = "Processing...may take upto 30s! Please wait!";
        // Change the button text to "Processing...may take upto 30s! Please wait!"
        alert('Application is under process...may take upto 30s! Please wait!');
        //button.innerHTML = "Processing...may take upto 30s! Please wait!";

        var resume_file = $("#ResumeFile")[0].files[0];

        var formdata = new FormData();
        formdata.append('resume_file', resume_file);
        formdata.append('id', applicantId);

        $.ajax({
            type: "POST",
            url: "/AIScreener/ApplicantAIScreeningRenewed",
            async : true,
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {
                debugger;
                if (data != null && (data.errorMessage == '' || data.errorMessage.includes('bypassed'))) {
                    if (data.isfavourableVerdict) {
                        // document.getElementById("id_aiVerdict_" + id).innerHTML = 'Yes';
                        // document.getElementById("id_aiScore_" + id).innerHTML = data.aiAnalysisScore;

                        // document.getElementById('id_aiUrl_' + id).style.display = "block";
                        buttonAI.innerHTML = "Processed!";

                        swal.fire("Processed! An acknowledgement mail has been sent. Kindly confirm.");
                        //buttonAI.disabled = false;
                    }
                    else if (!data.isfavourableVerdict && data.errorMessage.includes('bypassed')) {

                        buttonAI.innerHTML = "Error";
                        swal.fire("Error processing. Please try again later.");
                        
                    }
                    else {

                        buttonAI.innerHTML = "Processed";
                        swal.fire("Processed. Unfortunately, your profile does not match the current requirement. Thank you for applying!");

                    }
                }
                else if (data != null && data.errorMessage != '') {
                    buttonAI.innerHTML = "Error";
                    swal.fire(data.errorMessage);
                    //buttonAI.disabled = false;
                }
                else {
                    buttonAI.innerHTML = "Error";
                    swal.fire("Error processing. Please try again later.");
                    //buttonAI.disabled = false;
                }

            }
        });
    }
</script>