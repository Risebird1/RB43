@model IEnumerable<Risebird.Entities.ViewModel.StatsDetailsVM>
@using Risebird.CommonHelper;
@using Risebird.Entities.Data
@using Risebird.Entities.Enum
<style>
    .iv-stats-candidate-coded {
        display: inline-block;
        font-family: 'IBM Plex Mono', Consolas, monospace;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #4f46e5;
        background: #eef2ff;
        border: 1px solid #dbe1ff;
        border-radius: 6px;
        padding: 3px 8px;
        line-height: 1.3;
    }
    .iv-stats-candidate-coded--empty {
        color: #94a3b8;
        background: transparent;
        border-color: transparent;
        font-weight: 500;
    }
    .iv-evidence-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
    }
    .iv-evidence-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        background: #fff;
        color: #334155;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .iv-evidence-btn:hover {
        background: #eef2ff;
        border-color: #c7d2fe;
        color: #4338ca;
        text-decoration: none;
    }
    .iv-evidence-btn .ti {
        font-size: 15px;
        line-height: 1;
    }
    .iv-qc-verdict {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        text-decoration: none;
    }
    .iv-qc-verdict--warning {
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fcd34d;
        border-radius: 6px;
        padding: 3px 8px;
    }
    .iv-qc-verdict--warning:hover {
        color: #92400e;
        background: #fef3c7;
        text-decoration: none;
    }
    .iv-qc-verdict--pending {
        color: #475569;
        text-decoration: underline;
    }
    .iv-qc-verdict--pending:hover {
        color: #1e293b;
    }
    .iv-qc-verdict--empty {
        color: #94a3b8;
        font-weight: 500;
    }
    .iv-stats-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
    }
    .iv-payment-deduction {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        max-width: 220px;
    }
    .iv-payment-deduction--active {
        cursor: pointer;
    }
    .iv-payment-deduction--active:hover .iv-payment-deduction__status {
        color: #92400e;
        background: #fef3c7;
    }
    .iv-payment-deduction--empty {
        color: #94a3b8;
        font-weight: 500;
    }
    .iv-payment-deduction__status {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.3;
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fcd34d;
        border-radius: 6px;
        padding: 3px 8px;
    }
    .iv-payment-deduction__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 3px;
    }
    .iv-payment-deduction__tag {
        display: inline-block;
        font-size: 10px;
        font-weight: 500;
        line-height: 1.2;
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        padding: 2px 5px;
        white-space: nowrap;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .iv-payment-deduction__tag--more {
        color: #64748b;
        background: #e2e8f0;
        border-color: #cbd5e1;
    }
</style>
@{
    var maskCandidateReport = ViewBag.MaskCandidate == true;
    var showEvidenceColumn = ViewBag.ShowEvidenceColumn == true;
    var showQcVerdictColumn = ViewBag.ShowQcVerdictColumn == true;
    var showPaymentDeductionColumn = ViewBag.ShowPaymentDeductionColumn == true;
    var showRedoInterviewAction = ViewBag.ShowRedoInterviewAction == true;
    //string customHeight = "none";
    //if (ViewBag.DisplayType == "popup")
    //{
    //    customHeight = "450px";
    //}
    //int irfId = 0;
    //if (ViewBag.irfId != null)
    //{
    //    irfId = Convert.ToInt32(ViewBag.irfId);
    //}
    string clientEmailId = null;
    if (ViewBag.ClientEmailId != null)
    {
        clientEmailId = ViewBag.ClientEmailId;
    }
}
<div class="scrollbar" id="style-2">
    <div id="tableID" class="second">
        <table id="listTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>Interview Date</th>
                    <th>Candidate</th>
                    <th>Skill Channel</th>
                    <th>Project ID</th>
                    @* @if (string.IsNullOrEmpty(clientEmailId))
                    {
                        <th>Client</th>

                    } *@
                    <th>Meeting Status</th>
                    <th>Interview Status</th>
                    @if (showQcVerdictColumn)
                    {
                        <th>QC Verdict</th>
                    }
                    @if (showPaymentDeductionColumn)
                    {
                        <th>Payment Deduction</th>
                    }
                    <th>Report</th>
                    @if (showEvidenceColumn)
                    {
                        <th>Evidence</th>
                    }
                    @*  <th>Interviewer Joining Time</th> *@
                    @if (ViewBag.ClientEmailId == null && ViewBag.UsePl != "Public")
                    {
                        <th>Tech QC</th>
                    }
                    <th>Action</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th>Interview Date</th>
                    <th>Candidate</th>
                    <th>Skill Channel</th>
                    <th>Project ID</th>
                    @* @if (string.IsNullOrEmpty(clientEmailId))
                    {
                        <th>Client</th>

                    } *@
                    <th>Meeting Status</th>
                    <th>Interview Status</th>
                    @if (showQcVerdictColumn)
                    {
                        <th>QC Verdict</th>
                    }
                    @if (showPaymentDeductionColumn)
                    {
                        <th>Payment Deduction</th>
                    }
                    <th>Report</th>
                    @if (showEvidenceColumn)
                    {
                        <th>Evidence</th>
                    }
                    @*  <th>Interviewer Joining Time</th> *@
                    @if (ViewBag.ClientEmailId == null && ViewBag.UsePl != "Public")
                    {
                        <th>Tech QC</th>
                    }
                    <th>Action</th>
                </tr>
            </tfoot>
            <tbody>

                @if (Model != null && Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.interviewDate</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.candidateCodedId))
                                {
                                    <span class="iv-stats-candidate-coded" title="Candidate coded ID">@item.candidateCodedId</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.candidateEmail))
                                {
                                    @* Legacy surfaces not yet pseudonymized *@
                                    <span class="iv-stats-candidate-coded">@item.candidateEmail</span>
                                }
                                else
                                {
                                    <span class="iv-stats-candidate-coded iv-stats-candidate-coded--empty">—</span>
                                }
                            </td>
                            <td>@item.SkillChannel</td>
                            <td>@item.ProjectUniqueid</td>
                            @*  @if (string.IsNullOrEmpty(clientEmailId))
                            {
                                <td>@item.Client</td>

                            } *@
                            @if (item.MeetingStatus.HasValue && ((MeetingStatus)item.MeetingStatus == MeetingStatus.NoShowInterviewer || (MeetingStatus)item.MeetingStatus == MeetingStatus.NoShow))
                            {
                                <td>No Show</td>
                            }
                            else
                            {
                                <td>@(item.MeetingStatus.HasValue && item.MeetingStatus.Value > 0 ? ((MeetingStatus)item.MeetingStatus).GetDescription() : "NA") </td>
                            }

                            @if (ViewBag.StatType == StatsTypes.Selected || ViewBag.StatType == StatsTypes.Rejected || ViewBag.StatType == StatsTypes.Borderline || ViewBag.StatType == StatsTypes.Proxy || ViewBag.StatType == StatsTypes.Completed)
                            {
                                <td>@(item.InterviewStatus.HasValue && item.InterviewStatus.Value > 0 ? ((InterviewStatus)item.InterviewStatus).GetDescription() : "NA") </td>

                            }
                            else
                            {
                                <td>NA</td>
                            }
                            @if (showQcVerdictColumn)
                            {
                                <td>
                                    @await Html.PartialAsync("~/Views/Interviewer/_StatsDetailsQcVerdictCell.cshtml", item)
                                </td>
                            }
                            @if (showPaymentDeductionColumn)
                            {
                                <td>
                                    @await Html.PartialAsync("~/Views/Interviewer/_StatsDetailsPaymentDeductionCell.cshtml", item)
                                </td>
                            }
                            <td>
                                @if (item.InterviewStatus.HasValue && item.InterviewStatus.Value == (int)InterviewStatus.Selected)
                                {
                                    <a target="_blank" title="Report Link" href='@Url.Action("ClientReport", "Interview", new { interviewId=item.interviewId, irfId = item.irfId, IsSelected = true, maskCandidate = maskCandidateReport ? "1" : null })'>
                                        Report
                                    </a>
                                }
                                else
                                {
                                    <a target="_blank" title="Report Link" href='@Url.Action("ClientReport", "Interview", new { interviewId = item.interviewId, irfId = item.irfId, IsSelected = false, maskCandidate = maskCandidateReport ? "1" : null })'>
                                        Report
                                    </a>
                                }

                            </td>
                            @if (showEvidenceColumn)
                            {
                                <td>
                                    @if (item.interviewId.HasValue && item.interviewId.Value > 0)
                                    {
                                        @await Html.PartialAsync("~/Views/Interviewer/_StatsDetailsEvidenceActions.cshtml", item)
                                    }
                                </td>
                            }
                            @*  <td>
                                @(item.InterviewerJoinTime.HasValue ? item.InterviewerJoinTime.Value.ToString() : "NA")
                            </td> *@
                            @if (ViewBag.ClientEmailId == null && ViewBag.UsePl != "Public")
                            {
                                <td>
                                    @if (item.TechQCRequired)
                                    {
                                        <div class="form-group">
                                            <div class="switch-btn">
                                                @* <span class="on-off">Off</span> *@
                                                <div class="material-toggle">
                                                    @if (item.isTechQC)
                                                    {
                                                        <input class="switch" id="MoveToCP_@item.interviewId" type="checkbox" onchange="UpdateTechQCDetails(@item.interviewId,false)" checked="checked" value="false" name="Move To Tech QC">
                                                    }
                                                    else
                                                    {
                                                        <input class="switch" id="MoveToCP_@item.interviewId" type="checkbox" onchange="UpdateTechQCDetails(@item.interviewId,true)" value="false" name="Move To Tech QC">
                                                    }
                                                    <label for="MoveToCP_@item.interviewId" class=""></label>
                                                </div>
                                                @* <span class="on-off">On</span> *@
                                            </div>
                                        </div>
                                    }
                                </td>
                            }

                            <td>
                                <div class="iv-stats-actions">
                                @if (showRedoInterviewAction && item.interviewId.HasValue && item.interviewId.Value > 0)
                                {
                                    @await Html.PartialAsync("~/Views/Interviewer/_StatsDetailsRedoInterviewAction.cshtml", item)
                                }
                                @if (ViewBag.ClientEmailId == null && ViewBag.UsePl != "Public")
                                {
                                    <span>
                                        <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Payment Deduction">
                                            <div onclick="PaymentSLADetails('@item.interviewId','@(item.candidateCodedId ?? "")','@item.interviewer',false,'CompletedInterview',true)" title="Payment Deduction" class="mdc-fab__icon material-icons">
                                                <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg>
                                            </div>
                                        </button>
                                    </span>
                                }
                                </div>
                            </td>
                        </tr>

                    }
                }

            </tbody>

        </table>

    </div>
</div>
@if (showRedoInterviewAction)
{
    @await Html.PartialAsync("~/Views/Interviewer/_StatsDetailsRedoInterviewModal.cshtml")
}
@if (showPaymentDeductionColumn)
{
    @await Html.PartialAsync("~/Views/Common/_PaymentCompliance.cshtml")
}
<script>
    function UpdateTechQCDetails(interviewid, activestatus) {
        $.ajax({
            type: "POST",
            url: "/Interview/MovetoTechQC",
            data: { 'interviewid': interviewid, 'activestatus': activestatus },
            success: function (data) {
                swal.fire(data);
            }
        });
    }
</script>
@await Html.PartialAsync("~/Views/Common/_PaymentSLA.cshtml")