    // For Project
    function addProjectTableRow() {
        var table = document.getElementById("projectTable");
        var rowCount = table.rows.length;
        if (rowCount == 4) {
            alert("Cannot add more than 3 Projects");
            return;
        }
        var $ttc = $("#projectTable").find("tbody tr:last");
        var $tr = $ttc.clone();
