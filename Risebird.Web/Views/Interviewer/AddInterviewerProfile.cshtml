                });
            }
        }
        else {
            // Prevent form submission if validation fails
            alert("Validation failed.");
        }
    }

    // Function to validate phone number and email
    function validateForm() {
        const phoneNumber = document.getElementById("txt_evmobile").value;
        const emailId = document.getElementById("txt_evEmailId").value;

        // Regular expression for 10-digit phone number without spaces or special characters
        const phoneRegex = /^[0-9]{10}$/;
        // Regular expression for valid email format
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        let isValid = true;

        // Validate phone number
        if (!phoneRegex.test(phoneNumber)) {
            alert("Please enter a valid 10-digit mobile number without spaces, country code, or special characters.");
            isValid = false;
        }

        // Validate email
        if (!emailRegex.test(emailId)) {
            alert("Please enter a valid email address.");
            isValid = false;
        }

        return isValid;
    }
</script>
<script>
    function GenerateAIVerdict() {
        document.getElementById("id_btn_generateAIVerdict").disabled = true;
        var primarySpecialization = $("#PrimarySpecializationForAIVerdict").val().trim();
        var emailId = $("#txt_EmailId").val().trim();
        
        var resume_file = $("#ResumeFile")[0].files[0];

        var formdata = new FormData();
        formdata.append('resume_file', resume_file);
        formdata.append('primarySpecialization', primarySpecialization);
        formdata.append('emailId', emailId);

        $.ajax({
            type: "POST",
            url: "/AIScreener/ScreenInterviewerBeforeOnboarding",
            contentType: false,
            processData: false,
            data: formdata,
            success: function (data) {
                debugger;
                if (data != null && data.errorMessage == '') {
                    if (data.isfavourableVerdict) {
                        document.getElementById("divAIVerdict").style.display = "none";
                        document.getElementById("divEVverified").style.display = "block";
                        $("#ResumeLink").val(data.resumeLink);
                        $("#PrimarySpecializationForAcknowledgement").val(primarySpecialization);
                        if(data.aiResponse != null)
                        {
                            $("#AIResponse").val(data.aiResponse);

                        }
                    }
                    else {
                        swal.fire("Not a suitable Panel for this specialization. Not to be processed further.");
                        //document.getElementById("id_btn_generateAIVerdict").disabled = true;
                    }
                }
                else if (data != null && data.errorMessage != '') {
                    swal.fire(data.errorMessage);
                    document.getElementById("id_btn_generateAIVerdict").disabled = false;
                }
                else {
                    swal.fire("Error generating verdict. Please try again.");
                    document.getElementById("id_btn_generateAIVerdict").disabled = false;
                }

            }
        });
    }
</script>