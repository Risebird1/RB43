@model Risebird.Entities.ViewModel.InterviewerInsightsVM
<div class="col-md-4 pull-left">
    <p class="clearfix">
        <span class="pull-left" style="margin-right:10px;"><strong>Name:</strong></span>
        <span class="pull-left" style="margin-right:10px;">@Model.interviewerName</span>
    </p>
    <p>
        <span class="pull-left" style="margin-right:10px;"><strong>Contact:</strong></span>
        @if (Model.MobileNumber != null && Model.MobileNumber != string.Empty)
        {
            <span data-toggle="tooltip" data-placement="top" title="Click here to call." onclick="CommonCallButtonClick('@Model.interviewerName','@Model.MobileNumber','@Model.Emailid')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="20" /></span>
        }
        @Model.MobileNumber
    </p>
</div>
<div class="col-md-4 pull-left">
    <p class="clearfix">
        <span class="pull-left" style="margin-right:10px;"><strong>Company:</strong></span>
        @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
        {
            <span class="pull-left" style="color:brown;font-size:12px;">@Model.CompanyName</span>
        }
        else
        {
            <span class="pull-left">@Model.EmploymentComment</span>
        }
    </p>

    <p class="clearfix">
        <span class="pull-left" style="margin-right:10px;"><strong>Employee:</strong></span>

        @if (Model.IsEmployed)
        {
            <span class="pull-left">Working</span>
        }
        else
        {
            <span class="pull-left">Not Working</span>
        }

    </p>

</div>


<div class="col-md-4 pull-left">
    <p class="clearfix">
        <span class="pull-left" style="margin-right:10px;"><strong>Video Confirmation:</strong></span>
        @if (Model.VideoConfirmation == 1)
        {
            <span class="text-center pull-left"><span class="avail">Yes</span></span>
        }
        else if (Model.VideoConfirmation == 2)
        {
            <span class="text-center pull-left"><span class="noavail">No</span></span>
        }
        else
        {
            <span></span>
        }
    </p>
    <p class="clearfix">
        <span class="pull-left" style="margin-right:10px;"><strong>Availability:</strong></span>

        @if (Model.Isavailable == 1)
        {
            <span class="text-center pull-left"><span class="avail">Yes</span></span>
        }
        else if (Model.Isavailable == 2)
        {
            <span class="text-center pull-left"><span class="noavail">Not Available</span></span>
        }
        else if (Model.Isavailable == 3)
        {
            <span class="text-center pull-left"><span class="clarity">Need more clarity</span></span>
        }
        else if (Model.Isavailable == 4)
        {
            <span class="text-center pull-left"><span class="drop">Drop my profile</span></span>
        }
        else
        {
            <span></span>
        }
    </p>
</div>

<div class="col-md-4 pull-left">
    <p class="clearfix">
        <span class="pull-left" style="margin-right:10px;"><strong>Resume Link:</strong></span>
        @if (Model.ResumeLink != null && Model.ResumeLink != "")
        {
                <span class="pull-left" style="color:brown;font-size:12px;"> <a id="resumeId" target="_blank" title="Resume" href=@Model.ResumeLink>Resume</a></span>  
        }
        else
        {
            <span class="pull-left" style="color:brown;font-size:12px;"> No Resume</span>
        }
        
    </p>
 </div>

<div class="col-md-12 pull-left">
    <div id="tableID" class="second">
        <table class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
            <thead>
                <tr>


                    <th class="text-center">Interviews</th>
                    <th class="text-center">Completed</th>
                    <th class="text-center">Selected</th>
                    <th class="text-center">Rejected</th>
                    <th class="text-center">Dropped</th>
                    <th class="text-center">NoShow</th>
                    <th class="text-center">NoShow Candidate</th>
                </tr>

            </thead>
            <tbody>
                @Html.HiddenFor(model=>model.LastLogin)
                @if (Model != null)
                {
                    <tr>
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.TotalInterviews</span></td>
                        @{
                            if (Model.TotalInterviews == 0)
                            {
                                Model.TotalInterviews = 1;
                            }
                        }
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.CompletedInterviews (@(Model.CompletedInterviews * 100 / Model.TotalInterviews)%)</span></td>
                        @{
                            if (Model.CompletedInterviews == 0)
                            {
                                Model.CompletedInterviews = 1;
                            }
                        }
                        @if ((Model.SelectedInterviews * 100 / Model.CompletedInterviews) >= 50)
                        {
                            <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.SelectedInterviews (@(Model.SelectedInterviews * 100 / Model.CompletedInterviews)%)</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.SelectedInterviews (@(Model.SelectedInterviews * 100 / Model.CompletedInterviews)%)</span></td>
                        }
                        @if ((Model.RejectedInterviews * 100 / Model.CompletedInterviews) >= 80)
                        {
                            <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.RejectedInterviews (@(Model.RejectedInterviews * 100 / Model.CompletedInterviews)%)</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.RejectedInterviews (@(Model.RejectedInterviews * 100 / Model.CompletedInterviews)%)</span></td>
                        }
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.DroppedInterviews (@(Model.DroppedInterviews * 100 / Model.CompletedInterviews)%)</span></td>
                        @if ((Model.NoShowInterviews * 100 / Model.TotalInterviews) > 5)
                        {
                            <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.NoShowInterviews (@(Model.NoShowInterviews * 100 / Model.TotalInterviews)%)</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.NoShowInterviews (@(Model.NoShowInterviews * 100 / Model.TotalInterviews)%)</span></td>
                        }
                        @if ((Model.NoShowCandidateInterviews * 100 / Model.TotalInterviews) > 40)
                        {
                            <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.NoShowCandidateInterviews (@(Model.NoShowCandidateInterviews * 100 / Model.TotalInterviews)%)</span></td>
                        }
                        else
                        {
                            <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.NoShowCandidateInterviews (@(Model.NoShowCandidateInterviews * 100 / Model.TotalInterviews)%)</span></td>
                        }
                    </tr>
                <thead>
                    <tr>
                        <th class="text-center">Reliability Score</th>
                        <th class="text-center">Payment Deduction</th>
                        <th class="text-center">Late Report Count</th>
                        <th class="text-center">Candidate Rating</th>
                        <th class="text-center">Client  Rating</th>
                        <th class="text-center">Redo requests</th>
                        <th class="text-center">Red Flag Interviews</th>
                    </tr>
                </thead>
                <tr>
                    <td class="text-center"> <span onclick="ReliabilityScoreDetails('@Model.Emailid')" style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center;cursor:pointer">@Model.ReliabilityScore</span></td>
                    <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.PaymentSLA</span></td>
                    <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.Penalty</span></td>
                    <td class="text-center"><span onclick="InsightsDetailsMarkersView('@Model.Emailid','Candidate Rating Details')" style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center;cursor:pointer">@Model.CandidateRating</span></td>
                    <td class="text-center"><span onclick="InsightsDetailsMarkersView('@Model.Emailid','Client Rating Details')" style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center;cursor:pointer">@Model.CustomerRating</span></td>
                        @if (Model.Redorequests > 0)
                        {
                        <td class="text-center"><span onclick="InsightsDetailsMarkersView('@Model.Emailid','Redo Details')" style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center;cursor:pointer">@Model.Redorequests</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span onclick="InsightsDetailsMarkersView('@Model.Emailid','Redo Details')" style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.Redorequests</span></td>
                        }
                        @if ((Model.RedFlags * 100 / Model.CompletedInterviews) > 10)
                        {
                        <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.RedFlags</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.RedFlags</span></td>
                        }
                </tr>
                <thead>
                    <tr>
                        <th class="text-center">Late Join</th>
                        <th class="text-center">Late CandidateNoshow</th>
                        <th class="text-center">Unassigned Interviews</th>
                        <th class="text-center">Suspicious</th>
                        <th class="text-center">Less Questions</th>
                        <th class="text-center">Reject small Comment</th>
                        <th class="text-center">Select small Comment</th>
                    </tr>
                </thead>
                <tr>
                        @if ((Model.JoinLateMeeting * 100 / Model.TotalInterviews) > 2)
                        {
                        <td class="text-center"> <span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.JoinLateMeeting</span></td>
                        }
                        else
                        {
                        <td class="text-center"> <span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.JoinLateMeeting</span></td>
                        }
                    <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.JoinLateCandidateNoShow</span></td>
                        @if ((Model.UnassignInterviews * 100 / Model.TotalInterviews) > 5)
                        {
                        <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.UnassignInterviews</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.UnassignInterviews</span></td>
                        }
                        @if (Model.SuspiciousCount > 0)
                        {
                        <td class="text-center"><span onclick="InsightsDetailsMarkersView('@Model.Emailid','Suspicious Details')" style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center;cursor:pointer">@Model.SuspiciousCount</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span onclick="InsightsDetailsMarkersView('@Model.Emailid','Suspicious Details')" style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.SuspiciousCount</span></td>
                        }
                        @if (Model.LessQuestions > 0)
                        {
                        <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.LessQuestions</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.LessQuestions</span></td>
                        }
                        @if (Model.RejectedComment > 0)
                        {
                        <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.RejectedComment</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.RejectedComment</span></td>
                        }
                        @if (Model.SelectedComment > 0)
                        {
                        <td class="text-center"><span style="color:red;width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.SelectedComment</span></td>
                        }
                        else
                        {
                        <td class="text-center"><span style="width: 30px !important;height: 30px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size:12px;text-align:center">@Model.SelectedComment</span></td>
                        }
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")

<script src="~/js/TwilioCallMaker.js"></script>

