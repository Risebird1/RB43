@model Risebird.Entities.ViewModel.InterviewerInsightsVM

<table border="0" cellpadding="0" cellspacing="0" width="600" style="border-spacing: 0px;border-radius: 5px; -webkit-border-radius: 5px; -moz-border-radius: 5px;    background-color: #FFFFFF;
      border-spacing: 0px;border: 1px solid #E0E1E2;border-radius: 5px;-webkit-border-radius: 5px;-moz-border-radius: 5px">
    <tr>
        <td align="center" valign="top">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="color:#6B7075; border-radius: 4px 4px 0 0">
                <tr>
                    <td align="center" valign="top">
                        <table border="0" cellpadding="0" cellspacing="0" width="600">
                            <tr>
                                <td align="center" valign="top" width="600" style="padding-top:0px;">
                                    <table border="0" cellpadding="30" cellspacing="0" width="100%">
                                        <tr>
                                            <td align="center" valign="top" style="color: #6B7075;font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica;font-size: 16px;padding-bottom:0px;line-height: 100%;text-align: left;">
                                                <div style="text-align: center; font-family: Arial, Helvetica, sans-serif; font-size: 15px; margin-bottom: 0;line-height: 145%; text-align: left">
                                                    <p style=" text-align: left; font-family: Arial, Helvetica, sans-serif; color: #003851; font-weight: bold;margin:0px;">Dear Interviewer,</p>
                                                    <p style="margin-bottom:10px;">There are areas, which we refer to as "red markers," represent aspects of your interviewing technique that will need refinement. Please take the time to review the Red Markers provided below:
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="left" valign="top" width="600" style="padding-top:0px;">
                                                <h1 style="text-align: left;  font-size: 18px; font-weight: 500; color: #FF6115;font-weight:600;"><img style="padding-right:15px;" width="20" alt="Details" src="https://risebirdportal.blob.core.windows.net/icon/list-icon.png" />Details </h1>
                                                <div class="text-align:left">
                                                    <table width="100%" border="0" cellspacing="10" cellpadding="10">
                                                        @if (Model.RedFlags > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                    Red Flag Interview:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.RedFlags</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.SuspiciousCount > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-weight: bold; text-transform: uppercase; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important;">
                                                                    Suspicious Interviewer:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; color: #0061B7;  font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.SuspiciousCount</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.PaymentSLA > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-weight: bold; text-transform: uppercase; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important;">
                                                                    Penalty:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.PaymentSLA</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.Penalty > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-weight: bold; text-transform: uppercase; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                    Late Feedback Penalty:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.Penalty</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.CandidateRating < 4)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-weight: bold; text-transform: uppercase; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important;">
                                                                    Candidate Rating:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.CandidateRating</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.CustomerRating < 4)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-weight: bold; text-transform: uppercase; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important;">
                                                                    Client Rating
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.CustomerRating</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.Redorequests > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-weight: bold; text-transform: uppercase; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                    Redo Request
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    <a style="text-decoration: none; color: #0061B7;" href="">@Model.Redorequests</a>
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.CompletedInterviews > 0)
                                                        {
                                                            @if ((Model.SelectedInterviews * 100 / Model.CompletedInterviews) >= 50)
                                                            {
                                                                <tr>
                                                                    <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                        Selected Interviews:
                                                                    </td>
                                                                    <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                        @(Model.SelectedInterviews * 100 / Model.CompletedInterviews) %
                                                                    </td>
                                                                </tr>
                                                            }
                                                            @if ((Model.RejectedInterviews * 100 / Model.CompletedInterviews) >= 80)
                                                            {
                                                                <tr>
                                                                    <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                        Rejected Interviews:
                                                                    </td>
                                                                    <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                        @(Model.RejectedInterviews * 100 / Model.CompletedInterviews) %
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                        @if (Model.TotalInterviews > 0)
                                                        {
                                                            @if ((Model.UnassignInterviews * 100 / Model.TotalInterviews) > 5)
                                                            {
                                                                <tr>
                                                                    <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                        Unassigned Interviews :
                                                                    </td>
                                                                    <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                        @(Model.UnassignInterviews * 100 / Model.TotalInterviews) %
                                                                    </td>
                                                                </tr>
                                                            }
                                                            @if ((Model.NoShowInterviews * 100 / Model.TotalInterviews) > 5)
                                                            {
                                                                <tr>
                                                                    <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important;">
                                                                        NoShow Interviewer :
                                                                    </td>
                                                                    <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                        @(Model.NoShowInterviews * 100 / Model.TotalInterviews) %
                                                                    </td>
                                                                </tr>
                                                            }
                                                            @if ((Model.JoinLateMeeting * 100 / Model.TotalInterviews) > 2)
                                                            {
                                                                <tr>
                                                                    <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                        Late Join:
                                                                    </td>
                                                                    <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                        @(Model.JoinLateMeeting * 100 / Model.TotalInterviews) %
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }

                                                        @if (Model.RejectedComment > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                    Less than 250 characters for Rejected:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    @Model.RejectedComment
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.SelectedComment > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                    Less than 500 characters for Selected:
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    @Model.SelectedComment
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (Model.LessQuestions > 0)
                                                        {
                                                            <tr>
                                                                <td align="left" valign="top" width="40%" style="border: 1px solid #D9D9D9; font-size: 13px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; text-transform: uppercase; font-weight: bold; color: #003851; font-family: 'AvenirNextLTPro-Regular', 'Avenir Next', 'HelveticaNeue', 'Helvetica Neue', 'Avenir', Helvetica, Arial, Lucida Grande, sans-serif !important; ">
                                                                    Less than 5 Questions added
                                                                </td>
                                                                <td align="left" valign="top" width="60%" style="border: 1px solid #D9D9D9; font-size: 14px; padding-top: 4px; padding-bottom: 4px; line-height: 28px; font-family: Arial;">
                                                                    @Model.LessQuestions
                                                                </td>
                                                            </tr>
                                                        }
                                                    </table>
                                                </div>
                                                <br />
                                                <div style="text-align: center; font-family: Arial, Helvetica, sans-serif; font-size: 15px; margin-bottom: 0;line-height: 145%; text-align: left">
                                                    <p style="text-align:center;margin:0px;" onclick="AckInterviewerRedMarkerReportModel('@Model.uniqueid')"><a style="text-decoration: none; background: #FF6115; padding: 4px 6px; margin-bottom: 10px; margin-left: 10px; clear: both; border-radius: 3px; color: #fff; font-size: 16px; line-height: 35px; display: inline-block; width: 225px; text-align: initial;"><img style="width: 33px; margin-left: 25px;margin-top:3px; float: left;" src="https://risebirdportal.blob.core.windows.net/icon/consent.png">Acknowledgement</a></p>
                                                    <p style="margin-bottom:10px;font-size:14px;color:grey">
                                                        I acknowledge to rectify reported errors in my next interviews. Otherwise on further repetition of such errors,  Risebird or its customers have no other option but to penalize my payout or terminate my profile permanently from the platform.
                                                    </p>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>


