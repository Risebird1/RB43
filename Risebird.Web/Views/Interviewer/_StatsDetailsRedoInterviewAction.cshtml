@model Risebird.Entities.ViewModel.StatsDetailsVM
@using Risebird.CommonHelper
@using Risebird.Entities.Enum
@{
    var interviewId = Model?.interviewId ?? 0;
    var interviewStatus = Model?.intervieweStatusStatDesc;
    if (string.IsNullOrWhiteSpace(interviewStatus) && Model?.InterviewStatus is int status && status > 0)
    {
        interviewStatus = ((InterviewStatus)status).GetDescription();
    }
    interviewStatus = interviewStatus ?? string.Empty;
}
@if (interviewId > 0)
{
    <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Redo Interview" type="button">
        <span class="mdc-fab__icon material-icons"
              data-interview-id="@interviewId"
              data-interview-status="@interviewStatus"
              onclick="confirmAndOpenRedoInterview(this)"
              title="Redo Interview">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
            </svg>
        </span>
    </button>
}
