@model IEnumerable<Risebird.Entities.ViewModel.FLNInterviewerAcknowledgementStatusVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "FLN Acknowledgement Status";
    ViewBag.PageHeader = "FLN Acknowledgement Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;

}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">FLN Acknowledgement Status</h4></div>
                </div>

                <div class="pull-right">
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <div style="display: flex; gap: 5px; align-items: center;">
                            <label style="margin: 0; white-space: nowrap;">From:</label>
                            <input type="date" id="startDate" class="form-control" style="width: 150px;" value="@ViewBag.StartDate" />
                        </div>
                        <div style="display: flex; gap: 5px; align-items: center;">
                            <label style="margin: 0; white-space: nowrap;">To:</label>
                            <input type="date" id="endDate" class="form-control" style="width: 150px;" value="@ViewBag.EndDate" />
                        </div>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" onclick="applyDateFilter()">
                            <span class="mdc-button__label">
                                <span class="fa fa-filter"></span> Apply Filter
                            </span>
                        </button>
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" onclick="clearDateFilter()">
                            <span class="mdc-button__label">
                                <span class="fa fa-times"></span> Clear
                            </span>
                        </button>
                        <button class="mdc-button mdc-button--raised inline-demo-button mdc-ripple-upgraded" onclick="exportToExcel()" style="background-color: #28a745; color: white;">
                            <span class="mdc-button__label">
                                <span class="fa fa-download"></span> Download Excel
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="flnTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>EmailId</th>
                                                    <th>Primary Specialization</th>
                                                    <th>AIVerdict</th>
                                                    <th>FLN</th>
                                                    <th>Added On</th>
                                                    <th>Company Name</th>
                                                    <th>Resume</th>
                                                    <th>Mobile Number</th>
                                                    <th>Name</th>
                                                    <th>Acknowledgement Status</th>
                                                    <th>Target Skill Channel</th>
                                                    <th>Assessment Group</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>EmailId</th>
                                                    <th>Primary Specialization</th>
                                                    <th>AIVerdict</th>
                                                    <th>FLN</th>
                                                    <th>Added On</th>
                                                    <th>Company Name</th>
                                                    <th>Resume</th>
                                                    <th>Mobile Number</th>
                                                    <th>Name</th>
                                                    <th>Acknowledgement Status</th>
                                                    <th>Target Skill Channel</th>
                                                    <th>Assessment Group</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {

                                                        <tr>

                                                            <td>@item.EmailId</td>
                                                            <td>@item.PrimarySpecialization</td>
                                                            <td>@item.AIVerdict</td>
                                                            <td>@item.FLN</td>
                                                            <td>@item.AddedOn</td>
                                                            <td>
                                                                @if (item.CompanyName != null && item.CompanyName != "")
                                                            {
                                                                @if (item.CompanyName.Length > 30)
                                                                {

                                                                    <div class="cadEmail">
                                                                        <a onclick="" data-tooltip="@item.CompanyName"><span>@item.CompanyName.Substring(0,30)... </span> </a>

                                                                    </div>
                                                                }

                                                                else
                                                                {
                                                                    <div class="cadEmail">
                                                                        <a onclick="" data-tooltip="@item.CompanyName"><span>@item.CompanyName</span> </a>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span></span>
                                                            }

                                                            </td>
                                                            @if (item.ResumeLink != null && item.ResumeLink != "")
                                                            {
                                                                @if (item.ResumeLink != null && item.ResumeLink != "")
                                                                {
                                                                    <td> <a style="padding:0px;" id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink><img style="position:relative;left:-4px;" src="/img/resume-icon.png" width="16">Resume</a> </td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No Resume</td>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                            <td>@item.MobileNumber</td>
                                                            <td>@item.Name</td>
                                                            <td>@item.AcknowledgementStatus</td>
                                                            <td>@item.TargetSkillChannel</td>
                                                            <td>@item.AssessmentGroup</td>
                                                            
                                                            
                                                            <td>
                                                                

                                                            </td>

                                                        </tr>


                                                    }
                                                }

                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>

                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>


</div>



<script>

    function searchResult() {
        $('#flnTable').DataTable();
    }
    function RefreshSearch() {
        $('#flnTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#flnTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            order: [[1, 'desc']]
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#flnTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#flnTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#flnTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function applyDateFilter() {
        var startDate = document.getElementById('startDate').value;
        var endDate = document.getElementById('endDate').value;
        
        if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
            alert('Start date cannot be greater than end date');
            return;
        }
        
        var url = '@Url.Action("FLNInterviewersAcknowledgementStatus", "Interviewer")';
        var params = [];
        
        if (startDate) {
            params.push('startDate=' + encodeURIComponent(startDate));
        }
        if (endDate) {
            params.push('endDate=' + encodeURIComponent(endDate));
        }
        
        if (params.length > 0) {
            url += '?' + params.join('&');
        }
        
        window.location.href = url;
    }
    
    function clearDateFilter() {
        window.location.href = '@Url.Action("FLNInterviewersAcknowledgementStatus", "Interviewer")';
    }
    
    function exportToExcel() {
        var startDate = document.getElementById('startDate').value;
        var endDate = document.getElementById('endDate').value;
        
        var url = '@Url.Action("ExportFLNAcknowledgementStatusToExcel", "Interviewer")';
        var params = [];
        
        if (startDate) {
            params.push('startDate=' + encodeURIComponent(startDate));
        }
        if (endDate) {
            params.push('endDate=' + encodeURIComponent(endDate));
        }
        
        if (params.length > 0) {
            url += '?' + params.join('&');
        }
        
        window.location.href = url;
    }
</script>




