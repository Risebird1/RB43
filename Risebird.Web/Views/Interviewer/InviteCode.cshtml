@model Risebird.Entities.ViewModel.CodeInviteVM
@using Risebird.Entities.Enum


<div class="mdc-card-wrapper__text-section interviewer">
    @using (Html.BeginForm("SendInviteCode", "Interviewer", FormMethod.Post, new { enctype = "multipart/form-data", @onsubmit = "return checkStartDate();", @id = "InterviewerProfileform" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <!-- Add Interviewer personal Details Start-->
        <div class="row">
            <div class="col-lg-12  col-md-12 col-sm-12 pr-1">
                <div class="form-group">
                    <div class="mandate">
                        @Html.LabelFor(model => model.candidateEmail, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                    </div>
                    @Html.EditorFor(model => model.candidateEmail, new { htmlAttributes = new { id = "txt_username", @class = "form-control text-box single-line", @type="email",@Required="Required" } })
                    @Html.ValidationMessageFor(model => model.candidateEmail, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.experience, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })
                    @Html.EditorFor(model => model.experience, new { htmlAttributes = new { id = "txt_Experience", @class = "form-control text-box single-line", @type = "number" } })
                    @Html.ValidationMessageFor(model => model.experience, "", new { @class = "text-danger" })
                </div>
                <div class="form-group dob">
                    <div class="mandate">
                        @Html.LabelFor(model => model.inviteStartTime, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                    </div>
                    @*@Html.EditorFor(model => model.inviteStartTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @Value = Model.inviteStartTime.ToString("yyyy/MM/dd") } })*@
                    @Html.EditorFor(model => model.inviteStartTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @type="datetime-local" } })
                    @Html.ValidationMessageFor(model => model.inviteStartTime, "", new { @class = "text-danger" })
                </div>
                <div class="form-group dob">
                    <div class="mandate">
                        @Html.LabelFor(model => model.inviteEndTime, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                    </div>
                    @*@Html.EditorFor(model => model.inviteEndTime, new { htmlAttributes = new { @class = "form-control text-box single-line", @Value = Model.inviteEndTime.ToString("yyyy/MM/dd") } })*@
                    @Html.EditorFor(m => m.inviteEndTime, new { htmlAttributes = new { @class = "form-control text-box single-line",@type="datetime-local" } })
                    @Html.ValidationMessageFor(model => model.inviteEndTime, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <div class="mandate">
                        @Html.LabelFor(model => model.programmingLanguage, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                    </div>
                    @Html.DropDownListFor(x => Model.programmingLanguage, (SelectList)Model.ProgrammingLanguageList, htmlAttributes: new { @class = "select-css form-control webkitEnabled",@style="padding:0px" })
                    @*@Html.EditorFor(model => model.programmingLanguage, new { htmlAttributes = new { id = "txt_ProgrammingLanguage", @class = "form-control text-box single-line", @type = "text" } })*@
                    @Html.ValidationMessageFor(model => model.programmingLanguage, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <div class="mandate">
                        @Html.LabelFor(model => model.difficultyLevel, htmlAttributes: new { @class = "control-label col-lg-12 col-md-12 col-sm-12 col-xs-12 desp-label" })<span class="red">*</span>
                    </div>
                    @Html.EditorFor(model => model.difficultyLevel, new { htmlAttributes = new { id = "txt_DifficultyLevel", @class = "form-control text-box single-line", @type = "text",@Required="Required" } })
                    @Html.ValidationMessageFor(model => model.difficultyLevel, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer ">
            <div class="row">
                <div class="col-md-12 mc-button-area">
                    <button type="submit" value="Submit" id="btnUpload" class="mdc-button mdc-button--raised mdc-ripple-upgraded">Submit</button>
                </div>
            </div>
        </div>
    }
</div>
<script>
    @*$(document).ready(function () {
        var currentdate = new Date();
        var datetime = currentdate.getFullYear() + "-" + String(currentdate.getMonth() + 1).padStart(2, '0') + "-" + String(currentdate.getDate() + 1).padStart(2, '0') + "T" +
        + currentdate.getHours() + ":"
        + currentdate.getMinutes() + ":" + currentdate.getSeconds();
        document.getElementById("inviteStartTime").setAttribute("min", datetime);
        document.getElementById("inviteEndTime").setAttribute("min", datetime);
        })*@
        function checkStartDate() {
            var val = document.getElementById("inviteStartTime").value;
            if (val == "") {
                return false;
            }
            var year = val.substring(0, 4);
            var month = parseInt(val.substring(5, 7)) - 1;
            var date = val.substring(8, 10);
            var StartDate = new Date(year, month, date);
            var d = new Date();
            var currentDate = new Date(d.getFullYear(), d.getMonth(), d.getDate());
            if (StartDate < currentDate) {
                alert("Start Date should be greater than or equal to Current Date");
                document.getElementById("inviteStartTime").focus();
                return false;
            }
            if (document.getElementById("inviteEndTime").value != "") {
                return checkEndDate();
            }
            return true;
        }
    function checkEndDate() {
        var val = document.getElementById("inviteEndTime").value;
        if (val == "") {
            return false;
        }
        var startDateValue = document.getElementById("inviteStartTime").value;
        var d = new Date();
        var currentDate = new Date(d.getFullYear(), d.getMonth(), d.getDate());
        //end Date object creation
        var year = val.substring(0, 4);
        var month = parseInt(val.substring(5, 7)) - 1;
        var date = val.substring(8, 10);
        var endDate = new Date(year, month, date);

        var yearStart = startDateValue.substring(0, 4);
        var monthStart = parseInt(startDateValue.substring(5, 7)) - 1;
        var dateStart = startDateValue.substring(8, 10);
        var startDate = new Date(yearStart, monthStart, dateStart);
        if (endDate <= startDate) {
            alert("End Date should be greater than Start Date");
            return false;
        }
        return true;
    }
</script>