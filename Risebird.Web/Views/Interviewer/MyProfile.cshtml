<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script>
    // ── PAN verification ────────────────────────────────────────────────
    (function () {
        var panSnapshot = {
            pan: '@(Model.InterviewerAccDetails?.VerifiedPAN ?? "")',
            isVerified: @(Model.InterviewerAccDetails?.IsPanVerified == true ? "true" : "false")
        };

        function normalizePan(v) { return (v || '').trim().toUpperCase(); }

        function panChanged() {
            return normalizePan($('#InterviewerAccDetails_PAN').val()) !== normalizePan(panSnapshot.pan);
        }

        function updatePanHint() {
            var $info = $('#panVerifiedInfo');
            if (panSnapshot.isVerified && panChanged()) {
                $info.removeClass('text-success text-warning text-muted').addClass('text-warning')
                    .show().text('PAN changed — please verify again.');
                $('#panVerifyStatus').removeClass('text-success').text('Re-verification required').css('color', '#e67e22');
                $('#btnVerifyPan').text('Verify PAN');
            } else if (panSnapshot.isVerified) {
                $('#panVerifyStatus').html('<strong>PAN verified</strong>').removeClass('text-warning').addClass('text-success').css('color', '');
                $('#panVerifiedInfo').removeClass('text-warning text-muted').addClass('text-success')
                    .show().html('Your PAN is already verified.');
                $('#btnVerifyPan').text('Re-verify PAN');
            }
        }

        $('#InterviewerAccDetails_PAN').on('input change', function () {
            this.value = this.value.toUpperCase();
            updatePanHint();
        });

        $('#btnVerifyPan').on('click', function () {
            var pan = normalizePan($('#InterviewerAccDetails_PAN').val());
            var name = normalizePan($('#InterviewerAccDetails_AccountName').val());
            var interviewerProfileId = $('#id').val();

            if (!pan) {
                swal.fire('Required', 'Please enter a PAN number before verifying.', 'warning');
                return;
            }

            var panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]$/;
            if (!panPattern.test(pan)) {
                swal.fire('Invalid PAN', 'Please enter a valid 10-character PAN (e.g. ABCDE1234F).', 'warning');
                return;
            }

            if (panSnapshot.isVerified && !panChanged()) {
                swal.fire('PAN verified', 'Your PAN is already verified. Change the PAN number only if you need to verify a different one.', 'info');
                return;
            }

            var $btn = $(this);
            var $status = $('#panVerifyStatus');
            $btn.prop('disabled', true);
            $status.show().text('Verifying…').css('color', '#666');

            $.ajax({
                url: '@Url.Action("VerifyPanNumber", "Interviewer")',
                type: 'POST',
                data: {
                    interviewerProfileId: interviewerProfileId,
                    pan: pan,
                    name: name
                },
                success: function (res) {
                    if (res.success) {
                        if (res.alreadyVerified) {
                            swal.fire('PAN verified', res.message || 'Your PAN is already verified.', 'info');
                            updatePanHint();
                            return;
                        }
                        panSnapshot.pan = pan;
                        panSnapshot.isVerified = true;
                        var detail = res.nameAtPan ? ' Name at PAN: ' + res.nameAtPan + '.' : '';
                        $status.html('<strong>PAN verified</strong>').removeClass('text-warning').addClass('text-success').css('color', '');
                        $('#btnVerifyPan').text('Re-verify PAN');
                        $('#panVerifiedInfo').removeClass('text-warning text-muted').addClass('text-success')
                            .show().html('Your PAN is already verified. Verified on ' + (res.panVerifiedOn || 'now') + (res.nameAtPan ? ' — Name at PAN: ' + res.nameAtPan : ''));
                        swal.fire('Verified', res.message || 'PAN verified successfully.', 'success');
                    } else {
                        panSnapshot.isVerified = false;
                        $status.text(res.message || 'PAN verification failed').css('color', 'red');
                        $('#panVerifiedInfo').removeClass('text-success').addClass('text-warning')
                            .show().text(res.message || 'PAN verification failed.');
                        swal.fire('Not verified', res.message || 'PAN could not be verified.', 'error');
                    }
                },
                error: function () {
                    $status.text('Verification request failed').css('color', 'red');
                    swal.fire('Error', 'Could not reach the server. Please try again.', 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false);
                }
            });
        });

        updatePanHint();
    })();

    // ── Bank account verification ────────────────────────────────────────
    (function () {
        var verifiedSnapshot = {
            account: '@(Model.InterviewerAccDetails?.VerifiedAccountNumber ?? "")',
            ifsc: '@(Model.InterviewerAccDetails?.VerifiedIFSCCode ?? "")',
            name: '@(Model.InterviewerAccDetails?.VerifiedAccountName ?? "")',
            isVerified: @(Model.InterviewerAccDetails?.IsBankVerified == true ? "true" : "false")
        };

        function normalizeAccount(v) { return (v || '').trim(); }
        function normalizeIfsc(v) { return (v || '').trim().toUpperCase(); }
        function normalizeName(v) { return (v || '').trim(); }

        function bankCoreChanged() {
            return normalizeAccount($('#InterviewerAccDetails_AccountNumber').val()) !== normalizeAccount(verifiedSnapshot.account)
                || normalizeIfsc($('#InterviewerAccDetails_IFSCCode').val()) !== normalizeIfsc(verifiedSnapshot.ifsc)
                || normalizeName($('#InterviewerAccDetails_AccountName').val()) !== normalizeName(verifiedSnapshot.name);
        }

        function updateReverifyHint() {
            var $info = $('#bankVerifiedInfo');
            if (verifiedSnapshot.isVerified && bankCoreChanged()) {
                $info.removeClass('text-success text-warning text-muted').addClass('text-warning')
                    .show().text('Bank details changed — please verify again before receiving payments.');
                $('#bankVerifyStatus').removeClass('text-success').text('Re-verification required').css('color', '#e67e22');
                $('#btnVerifyBankAccount').text('Verify bank account');
            } else if (verifiedSnapshot.isVerified) {
                $('#bankVerifyStatus').html('<strong>Account verified</strong>').removeClass('text-warning').addClass('text-success').css('color', '');
                $('#bankVerifiedInfo').removeClass('text-warning text-muted').addClass('text-success')
                    .show().html('Your bank account is already verified.');
                $('#btnVerifyBankAccount').text('Re-verify bank account');
            }
        }

        $('#InterviewerAccDetails_AccountName, #InterviewerAccDetails_AccountNumber, #InterviewerAccDetails_IFSCCode')
            .on('input change', updateReverifyHint);

        $('#btnVerifyBankAccount').on('click', function () {
            var accountName = $('#InterviewerAccDetails_AccountName').val();
            var accountNumber = $('#InterviewerAccDetails_AccountNumber').val();
            var ifscCode = $('#InterviewerAccDetails_IFSCCode').val();
            var phone = $('#MobileNumber').val();
            var interviewerProfileId = $('#id').val();

            if (!accountNumber || !ifscCode) {
                swal.fire('Required', 'Please enter account number and IFSC before verifying.', 'warning');
                return;
            }

            if (verifiedSnapshot.isVerified && !bankCoreChanged()) {
                swal.fire('Account verified', 'Your bank account is already verified. Change account number, IFSC, or holder name only if you need to verify a different account.', 'info');
                return;
            }

            var $btn = $(this);
            var $status = $('#bankVerifyStatus');
            $btn.prop('disabled', true);
            $status.show().text('Verifying…').css('color', '#666');

            $.ajax({
                url: '@Url.Action("VerifyBankAccount", "Interviewer")',
                type: 'POST',
                data: {
                    interviewerProfileId: interviewerProfileId,
                    accountName: accountName,
                    accountNumber: accountNumber,
                    ifscCode: ifscCode,
                    phone: phone
                },
                success: function (res) {
                    if (res.success) {
                        if (res.alreadyVerified) {
                            swal.fire('Account verified', res.message || 'Your bank account is already verified.', 'info');
                            updateReverifyHint();
                            return;
                        }
                        verifiedSnapshot.account = normalizeAccount(accountNumber);
                        verifiedSnapshot.ifsc = normalizeIfsc(ifscCode);
                        verifiedSnapshot.name = normalizeName(accountName);
                        verifiedSnapshot.isVerified = true;
                        var detail = res.nameAtBank ? ' Name at bank: ' + res.nameAtBank + '.' : '';
                        if (res.bankName) detail += ' Bank: ' + res.bankName + '.';
                        $status.html('<strong>Account verified</strong>').removeClass('text-warning').addClass('text-success').css('color', '');
                        $('#btnVerifyBankAccount').text('Re-verify bank account');
                        $('#bankVerifiedInfo').removeClass('text-warning text-muted').addClass('text-success')
                            .show().html('Your bank account is already verified. Verified on ' + (res.verifiedOn || 'now') + (res.nameAtBank ? ' — Name at bank: ' + res.nameAtBank : ''));
                        swal.fire('Verified', res.message || 'Bank account verified successfully.', 'success');
                    } else {
                        verifiedSnapshot.isVerified = false;
                        $status.text(res.message || 'Verification failed').css('color', 'red');
                        $('#bankVerifiedInfo').removeClass('text-success').addClass('text-warning')
                            .show().text(res.message || 'Verification failed.');
                        swal.fire('Not verified', res.message || 'Bank account could not be verified.', 'error');
                    }
                },
                error: function () {
                    $status.text('Verification request failed').css('color', 'red');
                    swal.fire('Error', 'Could not reach the server. Please try again.', 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false);
                }
            });
        });

        updateReverifyHint();
    })();

    $('.tab-menu li a').on('click', function () {
        var target = $(this).attr('data-rel');
        $('.tab-menu li a').removeClass('active');
        $(this).addClass('active');
        $("#" + target).fadeIn('slow').siblings(".tab-box").hide();
        return false;
    });
</script>
