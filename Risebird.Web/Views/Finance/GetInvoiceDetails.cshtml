@model Risebird.Entities.ViewModel.InvoiceDetailsVM

@using (Html.BeginForm("GetInvoiceDetails", "Finance", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "irfForm" }))
{
    @Html.HiddenFor(m => m.id)
    @Html.HiddenFor(m => m.JobCountry)
    @Html.HiddenFor(m => m.Name)
    @Html.HiddenFor(m => m.startdate)
    @Html.HiddenFor(m => m.enddate)
    <div class="row">
        <div class="col-md-6 border-rv">
            @Html.LabelFor(m => m.Price, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control col-md-8 col-sm-8 pull-left" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.AccountNumber, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.TextBoxFor(m => m.AccountNumber, new { @class = "form-control col-md-8 col-sm-8 pull-left" })
        </div>
        <div class="col-md-6  border-rv">
            @Html.LabelFor(m => m.AccountDetails, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.TextBoxFor(m => m.AccountDetails, new { @class = "form-control col-md-8 col-sm-8 pull-left", @maxlength = "200" })
        </div>
        <div class="col-md-6 ">
            @Html.LabelFor(m => m.PaymentStatus, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.DropDownListFor(m => m.PaymentStatus, Model.PaymentStatusList, new { @class = "form-control col-md-8 col-sm-8 pull-left" })
        </div>
        <div class="col-md-6 border-rv">
            @Html.LabelFor(m => m.ReferenceNumber, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.TextBoxFor(m => m.ReferenceNumber, new { @class = "form-control col-md-8 col-sm-8 pull-left" })
        </div>
        <div class="col-md-6">
            @Html.LabelFor(m => m.fileupload, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.TextBoxFor(m => m.fileupload, new { type = "file", @class = "choose-file pull-left", @style = "background:#fff;margin:0px 0px 10px 0px!important;width:100%", @accept = ".doc, .docx, .pdf, .txt" })
        </div>
        <div class="col-md-6 border-rv">
            @Html.LabelFor(m => m.Comment, new { @class = "control-label col-md-4 col-sm-4 desp-label pull-left" })
            @Html.TextBoxFor(m => m.Comment, new { @class = "form-control col-md-8 col-sm-8 pull-left", @maxlength = "200", @style = "height:80px;" })
        </div>
    </div>
    <hr style="margin:0px 0px 5px 0px;" />
    <div class="col-md-12 nopad text-right">
        <input type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" />
    </div>
}