                                                                                                <td style="padding:5px;text-align:left;font-size:13px;background:#fff;font-weight:500">Acceptable</td>
                                                                                            </tr>


                                                                                        </table>


                                                                                    </div>
                                                                                </span>
                                                                            </a>
                                                                        </span>
                                                                    </div>
                                                                }
                                                            else if (!string.IsNullOrEmpty(@item.AIVerdict) && @item.AIVerdict.ToLower() == "no")
                                                            {
                                                                
                                                                    <div><img src="~/img/report-unaccepted.png" style="width: 20px!important;position: absolute;left: 4px;top:-1px;" /></div>

                                                                    <div class="interviewer-apt" style="position:relative;top:0px;">
