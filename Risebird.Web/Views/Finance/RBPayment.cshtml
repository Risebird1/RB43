                                                                                                <td style="padding:5px;text-align:left;font-size:13px;background:#fff;font-weight:500">Not Acceptable (Payment under review)</td>
                                                                                            </tr>

                                                                                        </table>


                                                                                    </div>
                                                                                </span>
                                                                            </a>
                                                                        </span>
