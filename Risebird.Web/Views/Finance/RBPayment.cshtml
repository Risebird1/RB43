                                                <th>Payment deductions </th>
                                                @* <th>Video Rewards</th> *@
                                                <th>Amount</th>
                                                <th>Payment Status</th>
                                                <th>Expected Payment Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
