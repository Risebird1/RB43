<script type="text/javascript">
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search' style='right:50px;'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top: 11px;right:30px;'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });
    }

</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    function ChangePaymentdetails(type) {
        window.location.href = "/Finance/RBPayment?type=" + type;
    }

    function rbPayDisplayValue(value) {
        value = (value || '').toString().trim();
        return value ? value : '—';
    }

    function openRBPaymentInfo(btn) {
        var interviewPointId = btn.getAttribute('data-interview-point-id');
        var utr = btn.getAttribute('data-utr') || '';
        var paymentDate = btn.getAttribute('data-payment-date') || '';
        var comment = btn.getAttribute('data-comment') || '';

        var modalEl = document.getElementById('rbPaymentInfoModal');
        bootstrap.Modal.getOrCreateInstance(modalEl).show();

        if (utr.trim() || paymentDate.trim() || comment.trim()) {
            $('#rbPayInfoUtr').text(rbPayDisplayValue(utr));
            $('#rbPayInfoDate').text(rbPayDisplayValue(paymentDate));
            $('#rbPayInfoComment').text(rbPayDisplayValue(comment));
            return;
        }

        $('#rbPayInfoUtr').text('Loading...');
        $('#rbPayInfoDate').text('Loading...');
        $('#rbPayInfoComment').text('Loading...');

        $.ajax({
            type: 'POST',
            url: '/Finance/GetRBPaymentInfo',
            data: { interviewPointId: interviewPointId },
            success: function (data) {
                if (!data || !data.success) {
                    var message = (data && data.message) ? data.message : 'Payment details are not available.';
                    $('#rbPayInfoUtr').text('—');
                    $('#rbPayInfoDate').text('—');
                    $('#rbPayInfoComment').text(message);
                    return;
                }

                $('#rbPayInfoUtr').text(rbPayDisplayValue(data.transferUtr));
                $('#rbPayInfoDate').text(rbPayDisplayValue(data.paymentDate));
                if (data.hasAnyDetail === false && data.message) {
                    $('#rbPayInfoComment').text(data.message);
                } else {
                    $('#rbPayInfoComment').text(rbPayDisplayValue(data.paymentComment));
                }
            },
            error: function () {
                $('#rbPayInfoUtr').text('—');
                $('#rbPayInfoDate').text('—');
                $('#rbPayInfoComment').text('Unable to load payment details.');
            }
        });
    }
    //// script for loader ends here
</script>
<script>

    function FilterInterviews(filterValue) {

        $.ajax({
            type: "GET",
            url: "/Finance/GetFilteredInterviews",
            data: { 'filterValue': filterValue },
            success: function (data) {

                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: false,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }

</script>





