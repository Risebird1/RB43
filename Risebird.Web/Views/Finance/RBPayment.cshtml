                                                <th>Payment For</th>
                                                <th>Type</th>
                                                <th>Rate</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Interviewer Issues found in the transcript</th>
                                                <th>Video Duration</th>
                                                <th>Base Pay</th>
                                                <th>Late Report Penalty</th>
                                                @*<th>QC Penalty</th>*@
                                                <th>Payment deductions </th>
                                                @* <th>Video Rewards</th> *@
                                                <th>Amount</th>
                                                <th>Payment Status</th>
                                                <th>Expected Payment Date</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                               
                                                <th>Date</th>
                                                <th>Payment For</th>
                                                <th>Type</th>
                                                <th>Rate</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>Interviewer Issues found in the transcript</th>
