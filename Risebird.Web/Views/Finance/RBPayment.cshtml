                                                                }
                                                            else
                                                            {
                                                                <span></span>
                                                            }
                                                           
                                                        </div>


                                              
                                              </td>
                                                    <td>@item.Type</td>
                                                    <td>@item.Rate</td>
                                                    @if (item.Type != "Penalty")
                                                    {
                                                        @if (item.MeetingStatusDetails == "0")
                                                        {
                                                            <td></td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.MeetingStatusDetails</td>
                                                        }

                                                        @if (item.InterviewStatusDetails == "0")
                                                        {
                                                            <td></td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.InterviewStatusDetails</td>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <td>Late Report Filled</td>
                                                        <td></td>
                                                    }
                                                    <td style="text-align:center">
                                                        @if (item.AITranscriptVerdict != null && item.AITranscriptVerdict != "")
                                                        {
                                                            @if (@item.AITranscriptVerdict == "yes")
                                                            {
                                                                <a target="_blank" href="@Url.Action("TransciptAnalysis", "AIScreener" , new { interviewId = item.InterviewId, irfId = item.IRFinid})" title="Transcript Analysis" style="text-decoration:none;">  <span style="background:#abadabe3;padding: 0px 10px 3px 10px;border-radius: 4px;color: #fff;font-size: 15px;font-weight:700;text-transform:capitalize;"> <font style="font-weight:400;text-transform:none;">check transcript quality details <svg style="color: white;width:8px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z" fill="white"></path></svg></font></span></a>
                                                            }
                                                            else
                                                            {
