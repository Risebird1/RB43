@model IEnumerable<Risebird.Entities.ViewModel.RBInterviewDetails>
@*@using Risebird.Entities.Enum*@
@{
    ViewData["Title"] = "RB Details";
    ViewBag.PageHeader = "RB Pay Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=8" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div>
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> RB Pay Details</h4></div>
                </div>
                <div class="pull-left">
                    @if (ViewBag.Type == "Pending")
                    {
                        <div class="feedback-tab-ac" onclick="ChangePaymentdetails('Pending')"><strong>Pending Payment</strong></div>
                        <div class="feedback-tab" onclick="ChangePaymentdetails('Paid')"><strong>Paid</strong></div>
                    }
                    else
                    {
                        <div class="feedback-tab" onclick="ChangePaymentdetails('Pending')"><strong>Pending Payment</strong></div>
                        <div class="feedback-tab-ac" onclick="ChangePaymentdetails('Paid')"><strong>Paid</strong></div>
                    }
                </div>
                <div class="pull-left" style="color:green;padding-left:20px">10% of Tds deducted from every payment</div>
                <div class="pull-right">
                    <div><a href="../../Newassets/paymentdes.pdf" target="_blank">Risebird Payment Description Link</a></div>
                    <div>
                        @*@if (ViewBag.submit == "true")
                        {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" title="Click here to Share with Finance Team.">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to Share with Finance Team." onclick="location.href='@Url.Action("ShareWithFN", "Finance")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Submit for Payment</font></span>
                        </button>
                        }
                        else
                        {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" title="Click here to Share with Finance Team." disabled>
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to Share with Finance Team."  data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Submit for Payment</font></span>
                        </button>
                        }*@
                        @*<button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="location.href='@Url.Action("ExportRBDetails", "Finance")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Export Excel</font></span>
                        </button>*@
                    </div>
                </div>

            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div class="table-responsive">

                                <div id="tableID">
                                    <table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Payment For</th>
                                                <th>Type</th>
                                                <th>Rate</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                @*<th>VideoLink</th>*@
                                                <th>Video Duration</th>
                                                <th>Amount</th>
                                                <th>Payment Status</th>
                                                <th>Expected Payment Date</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th>Date</th>
                                                <th>Payment For</th>
                                                <th>Type</th>
                                                <th>Rate</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                @*<th>VideoLink</th>*@
                                                <th>Video Duration</th>
                                                <th>Amount</th>
                                                <th>Payment Status</th>
                                                <th>Expected Payment Date</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.Date</td>
                                                    <td>@item.Comment</td>
                                                    <td>@item.Type</td>
                                                    <td>@item.Rate</td>
                                                    @if (item.Type != "Penalty")
                                                    {
                                                        @if (item.MeetingStatusDetails == "0")
                                                        {
                                                            <td></td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.MeetingStatusDetails</td>
                                                        }

                                                        @if (item.InterviewStatusDetails == "0")
                                                        {
                                                            <td></td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.InterviewStatusDetails</td>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <td>Late Report Filled</td>
                                                        <td></td>
                                                    }
                                                    @if (item.Date >=new DateTime(2023, 05, 01) && @item.VideoDuration > 5 && (item.MeetingStatus == 4 || item.MeetingStatus == 6 || item.MeetingStatus == 7 || item.MeetingStatus == 8))
                                                    {
                                                        <td style="width:11%; text-align: center;">@(item.VideoDuration - 5)</td>
                                                    }
                                                    else
                                                    {
                                                        <td style="width:11%; text-align: center;">@item.VideoDuration</td>
                                                    }

                                                    <td>@item.Points</td>
                                                    <td>@item.Status</td>
                                                    <td>@item.ExpectedDate</td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>


        <!-- end row -->
    </div>

</div>





<script type="text/javascript">
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search' style='right:50px;'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' style='top: 11px;right:30px;'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });
    }

</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    function ChangePaymentdetails(type) {
        window.location.href = "/Finance/RBPayment?type=" + type;
    }
    //// script for loader ends here
</script>
<script>

    function FilterInterviews(filterValue) {

        $.ajax({
            type: "GET",
            url: "/Finance/GetFilteredInterviews",
            data: { 'filterValue': filterValue },
            success: function (data) {

                if (data == '' && filterValue == 'seven') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for the next seven days.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '' && filterValue == 'all') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                if (data == '') {
                    $('#tableID').html('');
                    $('#tableID').html('No interviews for ' + filterValue + '.');
                    $('#tableID').css("margin-left", "452px");
                    return;
                }
                $('#tableID').css("margin-left", "");
                $('#tableID').html('');
                $('#tableID').html(data);

                $('#meeting').DataTable({
                    "pagingType": "full_numbers",
                    "lengthMenu": [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],
                    responsive: false,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search records",
                    }

                });
                var table = $('#meeting').DataTable();



            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }

</script>





