                                                    <td>@item.Penaltyamount</td>
                                                    @*<td>@item.QCPoints</td>*@
                                                    <td class="text-center">
                                                        @if (item.PaymentSLA > 0)
                                                        {
                                                            <span>  <a onClick="PaymentComplianceDetails('@item.InterviewId')" style="color:blue;font-weight:bold;cursor:pointer; cursor: pointer;background: #dddddd82; border-radius: 20px;padding: 6px;">@item.PaymentSLA</a></span>
                                                        }
                                                        else
                                                        {
                                                            <span> @item.PaymentSLA</span>
                                                        }
                                                        @if (item.PaymentSLA > 0)
                                                        {
                                                            <br />
