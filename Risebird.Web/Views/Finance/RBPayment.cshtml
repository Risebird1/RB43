                                                                {
                                                                    <div><img src="~/img/not-acceptable.png" style="width: 26px!important;position: absolute;left:0px;" /></div>

                                                                <div class="interviewer-apt" style="left:23px;">
                                                                        <span>Transcript unacceptable quality based on AI</span>
