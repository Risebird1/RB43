                                                                    <span title="Payment Deduction Reasoning" class="mdc-fab__icon material-icons">
                                                                       Deduction Reasoning
                                                                    </span>
                                                                </button>
                                                            </a>
                                                        }
                                                    </td>
                                                    @* <td>@item.VideoReward</td> *@
                                                    <td>@item.Points</td>
                                                    <td>@item.Status</td>
                                                    <td>@item.ExpectedDate</td>
                                                    <td style="white-space:nowrap;">
