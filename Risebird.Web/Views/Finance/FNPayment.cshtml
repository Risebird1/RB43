            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Finance/ConfirmPaymentViaCashfree",
                        type: "POST",
                        data: { id: interviewerid, index: Generateinvoiceflag, email: $("#hidcomment_" + interviewerid).val(), amount: $("#hidpoint_" + interviewerid).val(), st: St_date, se: Se_date },
                        dataType: 'json',
