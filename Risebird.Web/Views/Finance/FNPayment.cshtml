@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.RBInterviewDetails>
@using X.PagedList.Mvc.Core;
@using System;
@*@using Risebird.Entities.Enum*@
@{
    ViewData["Title"] = "RB Payment Details";
    ViewBag.PageHeader = "RB Payment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    select * {
        background-color: #42a5f5 !important;
    }

    .fn-cashfree-btn .mdc-fab__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px !important;
        height: 30px !important;
        line-height: 1 !important;
        font-size: 0 !important;
    }

    .fn-cashfree-btn svg {
        width: 17px !important;
        height: 17px !important;
        max-width: 17px !important;
        min-width: 17px !important;
        position: static !important;
        flex-shrink: 0;
    }

    /* PAN info tooltip */
    .pan-info-wrap {
        position: relative;
        display: inline-block;
    }
    .pan-info-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #1976d2;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        font-style: normal;
        cursor: pointer;
        margin-left: 4px;
        vertical-align: middle;
        line-height: 1;
    }
    .pan-tooltip-box {
        display: none;
        position: absolute;
        z-index: 9999;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        background: #263238;
        color: #fff;
        font-size: 12px;
        border-radius: 5px;
        padding: 7px 10px;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0,0,0,0.28);
        pointer-events: none;
        min-width: 160px;
    }
    .pan-tooltip-box::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid transparent;
        border-top-color: #263238;
    }
    .pan-info-wrap:hover .pan-tooltip-box {
        display: block;
    }
</style>
<link href="~/Autocomplete/jquery-ui.min.css?v=2024" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=2024" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> RB Payment Details</h4></div>
                </div>

                <div class="client-ms" style="display:flex;flex-wrap:wrap;align-items:flex-start;width:100%;">
                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:4px;">
                        <select id="ddlmonth" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onchange="Changemonth()">
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                        <select id="TdsSelectYear" name="TdsSelectYear" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onchange="Changemonth()">
                            @foreach (var item in (List<SelectListItem>)(ViewBag.TdsYears))
                            {
                                @if (item != null)
                                {
                                    @if (item.Selected)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            }
                        </select>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="1-7 of this month" onclick="Fetchinvoice(1,1)">
                            <span data-toggle="tooltip" data-placement="top" title="1-7 of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;">1-7</font></span>
                        </button>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="8-14 of this month" onclick="Fetchinvoice(2,1)">
                            <span data-toggle="tooltip" data-placement="top" title="8-14 of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;">8-14</font></span>
                        </button>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="15-21 of this month" onclick="Fetchinvoice(3,1)">
                            <span data-toggle="tooltip" data-placement="top" title="15-21 of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;">15-21</font></span>
                        </button>
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" onclick="Fetchinvoice(4,1)">
                            <span data-toggle="tooltip" data-placement="top" title="" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;">22-_</font></span>
                        </button>
                    </div>
                    <div style="display:flex;flex-direction:column;align-items:flex-end;margin-left:auto;">
                        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:4px;">
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                @*<span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="location.href='@Url.Action("ExportFNPayment", "Finance")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;"> Export Excel</font></span>*@
                                <span class="far fa-file-excel" data-toggle="tooltip" data-placement="top" onclick="ExportFNDetails()" data-original-title="Tooltip on top">
                                    <font style="font-family: Roboto, sans-serif;font-size:9px;padding-left: 3px;"> Export Excel</font>
                                </span>
                            </button>
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="background-color:#1976d2;color:#fff;" onclick="openBatchPayoutModal()">
                                <span class="fa fa-paper-plane" data-toggle="tooltip" data-placement="top" data-original-title="Batch Cashfree Payout"><font style="font-family:Roboto,sans-serif;font-size:9px;padding-left:3px;">Batch Payout</font></span>
                            </button>
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="background-color:#c62828;color:#fff;" onclick="bulkCarryForwardPayment()" title="Carry forward every interviewer whose total for the currently viewed week is below 0 to next week">
                                <span class="fa fa-level-down-alt" data-toggle="tooltip" data-placement="top" data-original-title="Bulk Carry Forward to next week"><font style="font-family:Roboto,sans-serif;font-size:9px;padding-left:3px;">Bulk Carry Forward</font></span>
                            </button>
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                <span class="fa fa-credit-card" data-toggle="tooltip" data-placement="top" onclick="openmyAdvancepaymentModel()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;padding-left:3px;">Advance Payment</font></span>
                            </button>
                            @* <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                <span class="fa fa-plus-circle" data-toggle="tooltip" data-placement="top" onclick="openmyAddpointsToolbarModel()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:9px;padding-left:3px;">Add Points</font></span>
                            </button> *@
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                <span class="fa fa-file" data-toggle="tooltip" data-placement="top" onclick="openmyinvoiceModel()" data-original-title="Tooltip on top">
                                    <font style="font-family: Roboto, sans-serif;font-size:9px;padding-left: 3px;">Generate Invoice</font>
                                </span>
                            </button>
                           
                        </div>
                        <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:4px;margin-top:8px;">
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'">
                                <span class="fa fa-tachometer-alt" data-toggle="tooltip" data-placement="top" data-original-title="Tooltip on top">
                                    <font style="font-family: Roboto, sans-serif;font-size:9px;padding-left: 3px;">New Dashboard</font>
                                </span>
                            </button>
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                                <span class="fa fa-ban" data-toggle="tooltip" data-placement="top" onclick="openPaymentLapsed()" data-original-title="Tooltip on top">
                                    <font style="font-family: Roboto, sans-serif;font-size:9px;padding-left: 3px;">Payment Lapsed</font>
                                </span>
                            </button>
                             <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span class="fa fa-history" data-toggle="tooltip" data-placement="top" onclick="openPaymentHistory()" data-original-title="Tooltip on top">
                                    <font style="font-family: Roboto, sans-serif;font-size:9px;padding-left: 3px;">Payment History</font>
                                </span>
                            </button>
                            <button type="button" id="btnProcessKycLapse" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="background-color:#c62828;color:#fff;" onclick="processKycPayoutLapseCandidates()">
                                <span class="fa fa-user-clock" data-toggle="tooltip" data-placement="top" data-original-title="Check 120+ day old payouts with incomplete KYC and start the reminder/lapse tracking"><font style="font-family:Roboto,sans-serif;font-size:9px;padding-left:3px;">Check KYC Lapses</font></span>
                            </button>
                        </div>
                        <div>
                            <div id="meeting_filter" class="dataTables_filter">
                                <div class="searchCon mt-20">
                                    <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                                    <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeypress="searchResultEnter(event)" value="@ViewBag.Searchvalue">
                                    <span id="trigger-update-search" class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">

                                        <div class="clearfix"></div>
                                        <div>
                                            <label id="txtAmount" style="padding:0 0 0 0">Amount: @ViewBag.totalAmount </label> |
                                            <label id="txtTdsdeducted" style="padding:0 0 0 0">Tds: @ViewBag.Tds</label> |
                                            <label id="txtPayableAmount" style="padding:0 0 0 0">Payable Amount: @ViewBag.payableAmount</label> |
                                            <label id="txtpaidamount" style="padding:0 0 0 0">Paid Amount: 0</label> |
                                            <label id="txtinterviewamount" style="padding:0 0 0 0">Interview Amount: 0</label> |
                                            <label id="txtnoshowamount" style="padding:0 0 0 0">No Show Amount: 0</label> |
                                            <label id="txtdroppedamount" style="padding:0 0 0 0">Dropped Amount: 0</label> |
                                            <label id="txtpendingamount" style="padding:0 0 0 0">Pending Amount: 0</label>
                                        </div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Status</th>
                                                            <th>Blocked</th>
                                                            <th>Mobile</th>
                                                            <th>Account Verified</th>
                                                            <th>PAN Verified</th>
                                                            <th style="text-align:right;">Amount</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Status</th>
                                                            <th>Blocked</th>
                                                            <th>Mobile</th>
                                                            <th>Account Verified</th>
                                                            <th>PAN Verified</th>
                                                            <th style="text-align:right;">Amount</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count == 0)
                                                        {
                                                            <tr><td colspan="8" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {

                                                            <tr>
                                                                <td>@item.Comment<input type="hidden" id="hidcomment_@item.id" value="@item.Comment" /></td>
                                                                <td>
                                                                    @if (item.IsActive)
                                                                    {
                                                                        <span class="text-success" title="Active interviewer">Active</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-danger" title="Inactive interviewer">Inactive</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.IsBlocked)
                                                                    {
                                                                        <span class="text-danger" title="Interviewer is blocked">Blocked</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-success" title="Interviewer is not blocked">Unblocked</span>
                                                                    }
                                                                </td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.MobileNumber) ? "?" : item.MobileNumber)</td>
                                                                <td>
                                                                    @if (item.IsBankVerified)
                                                                    {
                                                                        <span class="text-success" title="Bank account verified">Yes</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-danger" title="Bank account not verified">No</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.IsPanVerified)
                                                                    {
                                                                        <span class="text-success">Yes</span>
                                                                        <span class="pan-info-wrap">
                                                                            <i class="pan-info-icon">i</i>
                                                                            <span class="pan-tooltip-box">
                                                                                PAN: @(item.VerifiedPAN ?? "—")<br />
                                                                                Name: @(item.NameAtPan ?? "—")<br />
                                                                                On: @(item.PanVerifiedOn?.ToString("dd MMM yyyy") ?? "—")
                                                                            </span>
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-danger" title="PAN not verified">No</span>
                                                                    }
                                                                </td>
                                                                <td style="text-align:right;">@item.Points<input type="hidden" id="hidpoint_@item.id" value="@item.Points" /></td>
                                                                <td>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Detailed View">
                                                                        <span onclick="DetailedView(@item.id)" title="Detailed View" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                            </svg>
                                                                        </span>
                                                                    </button>
                                                                    @* <button class="mdc-fab app-fab--absolute" aria-label="Add Points">
                                                                        <span onclick="openPointspopup(@item.id)" title="Add Points" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
                                                                        </span>
                                                                    </button> *@
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Query">
                                                                        <span onclick="openmyQueryModel('@item.Comment')" title="Ask Query" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>
                                                                        </span>
                                                                    </button>
                                                                    @if (item.Points > 0)
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Confirm">
                                                                            <span title="Confirm" onclick="confirmpayment(@item.id)" class="mdc-fab__icon material-icons">
                                                                                <svg style=" top: 3px; position: relative; left: 3px;" xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 24 24">
                                                                                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                        <button class="mdc-fab app-fab--absolute fn-cashfree-btn" aria-label="Confirm cashfree">
                                                                            <span title="Confirm cashfree" onclick="confirmpaymentCashfree(@item.id)" class="mdc-fab__icon material-icons">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" class="bi bi-credit-card-2-front-fill" viewBox="0 0 16 16">
                                                                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2.5 1a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1z" />
                                                                                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1H0z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right" id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("FNPayment", new { Page = Page }))
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>

        <div class="rbpay">
            <div id="myModal" class="modal" style="z-index:1100">
                <!-- Modal content -->
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="filheader">
                                <div class="filavatar">
                                    <span>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg>

                                    </span>
                                </div>
                                <h5 class="modal-title pull-left"> Detailed View ( <label id="txtInterviewerEmailid"></label> )</h5>
                            </div>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="CloseMyModelPopup()">
                                <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                            </button>
                            <div class="modal-body">
                                <div class="col-md-12">

                                    <div id="divDetailedView" style="max-height:250px;overflow-y:auto"></div>
                                    <div style="text-align:center">
                                        <label id="txtAmountD">Amount: @ViewBag.totalAmount </label> |
                                        <label id="txtTdsdeductedD">Tds deducted: @ViewBag.Tds</label> |
                                        <label id="txtPayableAmountD">Payable Amount: @ViewBag.payableAmount</label>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end row -->
        <div id="myAddpointsModel" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="filheader">
                            <div class="filavatar">
                                <span>
                                    <svg fill="rgb(255,255,255)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
                                </span>
                            </div>
                            <h5 class="modal-title pull-left"> Add Points</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closemyAddpointsModel()">
                            <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                        </button>
