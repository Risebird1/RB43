    function confirmpayment(interviewerid) {
        if (confirmationpayment == 0) {
            confirmationpayment = 1;
            var paymentamount = $("#hidpoint_" + interviewerid).val();
            Swal.fire({
                title: 'Are you sure?',
                text: 'Do you want to confirm this payment of ' + paymentamount + '? ',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Yes',
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Finance/ConfirmPayment",
                        type: "POST",
                        data: { id: interviewerid, index: Generateinvoiceflag, email: $("#hidcomment_" + interviewerid).val(), amount: $("#hidpoint_" + interviewerid).val(), st: St_date, se: Se_date },
                        dataType: 'json',
                        success: function (data) {
                            swal.fire(data);
                            FinacneChangePage(_Currentpage);
