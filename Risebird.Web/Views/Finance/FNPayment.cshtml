@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
<script>

    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/finance/FNPaymentJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {
                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry, 1);
                }
            }
        });
    }
    function fnPaymentBoolValue(row, camelKey, pascalKey) {
        var value = row[camelKey];
        if (value === undefined || value === null) {
            value = row[pascalKey];
        }
        return value === true || value === 'true' || value === 1 || value === '1';
    }
    function fnPaymentActiveLabel(row) {
        return fnPaymentBoolValue(row, 'isActive', 'IsActive')
            ? '<span class="text-success" title="Active interviewer">Active</span>'
            : '<span class="text-danger" title="Inactive interviewer">Inactive</span>';
    }
    function fnPaymentBlockedLabel(row) {
        return fnPaymentBoolValue(row, 'isBlocked', 'IsBlocked')
            ? '<span class="text-danger" title="Interviewer is blocked">Blocked</span>'
            : '<span class="text-success" title="Interviewer is not blocked">Unblocked</span>';
    }
    function fnPaymentMobileValue(row) {
        var mobile = row.mobileNumber;
        if (mobile === undefined || mobile === null) {
            mobile = row.MobileNumber;
        }
        if (mobile === undefined || mobile === null || mobile === '') {
            return '?';
        }
        return mobile.toString().trim();
    }
    function bindtableData(data) {
        currentTableData = data;
        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="8" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {
            var pointdetails = data[i].points;
            var isVerified = data[i].isBankVerified === true || data[i].isBankVerified === 'true' || data[i].IsBankVerified === true;
            var verifiedLabel = isVerified
                ? '<span class="text-success" title="Bank account verified via Cashfree">Yes</span>'
                : '<span class="text-danger" title="Bank account not verified">No</span>';

            // PAN verified column with hover-info icon
            var isPanVerified = data[i].isPanVerified === true || data[i].isPanVerified === 'true' || data[i].IsPanVerified === true;
            var panLabel;
            if (isPanVerified) {
                var panNum  = data[i].verifiedPAN  || data[i].VerifiedPAN  || '—';
                var panName = data[i].nameAtPan    || data[i].NameAtPan    || '—';
                var panDate = data[i].panVerifiedOn || data[i].PanVerifiedOn || '';
                if (panDate && panDate.toString().length >= 10) {
                    var d = new Date(panDate);
                    panDate = isNaN(d.getTime()) ? panDate : d.getDate() + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()] + ' ' + d.getFullYear();
                }
                panLabel = '<span class="text-success">Yes</span>'
                    + '<span class="pan-info-wrap">'
                    +   '<i class="pan-info-icon">i</i>'
                    +   '<span class="pan-tooltip-box">'
                    +     'PAN: '  + panNum  + '<br/>'
                    +     'Name: ' + panName + '<br/>'
                    +     'On: '   + (panDate || '—')
                    +   '</span>'
                    + '</span>';
            } else {
                panLabel = '<span class="text-danger" title="PAN not verified">No</span>';
            }

            html += '  <tr>';
            html += '  <td>' + data[i].comment + '</td>';
            html += '  <td>' + fnPaymentActiveLabel(data[i]) + '</td>';
            html += '  <td>' + fnPaymentBlockedLabel(data[i]) + '</td>';
            html += '  <td>' + fnPaymentMobileValue(data[i]) + '</td>';
            html += '  <td>' + verifiedLabel + '</td>';
            html += '  <td>' + panLabel + '</td>';
            html += ' <td style="text-align:right;">' + pointdetails + '</td> ';
            html += '  <td>';
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Detail View">';
            html += '   <span onclick = "DetailedView(' + data[i].id + ')" title = "Detail View" class="mdc-fab__icon material-icons">';
            html += '     <svg xmlns = "http://www.w3.org/2000/svg" width = "16" height = "16" fill = "currentColor" class="bi bi-eye-fill" viewBox = "0 0 16 16" >';
            html += '   <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />';
            html += '     <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />';
            html += '    </svg>';
            html += '    </span>';
            html += '    </button>';
            html += '  <button class="mdc-fab app-fab--absolute" aria-label="Add Points">';
            html += '   <span onclick="openPointspopup(' + data[i].id + ')" title="Add Points" class="mdc-fab__icon material-icons">';
            html += '  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>';
            html += '   </span>';
            /**/
            html += '   </button><input type="hidden" value="' + data[i].comment + '" id="hidcomment_' + data[i].id + '" /><input type="hidden" id="hidpoint_' + data[i].id + '" value="' + pointdetails + '" />';
            /**/
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Query">';
            html += '   <span onclick="openmyQueryModeljson(' + data[i].id + ')" title="Ask Query" class="mdc-fab__icon material-icons">';
