    function bulkCarryForwardPayment() {
        if (Generateinvoiceflag != 2 || !St_date || !Se_date) {
            Swal.fire('Select a week (1-7 / 8-14 / 15-21 / 22-_) first.');
            return;
        }
        openCarryForwardModal();
    }
    // ??? Bulk Carry Forward (Batch Payout-style multiselect popup) ????????????????
    function openCarryForwardModal() {
        var negativeRows = (currentTableData || []).filter(function (row) {
            return parseInt(row.points) < 0;
        });
        var tbody = document.getElementById('tblCarryForwardBody');
        document.getElementById('chkSelectAllCarryForward').checked = false;
        document.getElementById('spnCarryForwardSelected').textContent = '0 interviewer(s) selected';
        document.getElementById('divCarryForwardResult').style.display = 'none';
        document.getElementById('divCarryForwardResult').innerHTML = '';
        document.getElementById('btnProceedCarryForward').disabled = false;

        if (negativeRows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center">No interviewer has a negative total for this week.</td></tr>';
        } else {
            var html = '';
            for (var i = 0; i < negativeRows.length; i++) {
                var row = negativeRows[i];
                html += '<tr>';
                html += '<td style="text-align:center;"><input type="checkbox" class="chkCarryForwardInterviewer" data-id="' + row.id + '" data-points="' + row.points + '" onchange="updateCarryForwardCount()" /></td>';
                html += '<td>' + (row.comment || '') + '</td>';
                html += '<td style="text-align:right;color:#c62828;">' + row.points + '</td>';
                html += '</tr>';
            }
            tbody.innerHTML = html;
        }
        document.getElementById('myCarryForwardModel').style.display = 'block';
    }

    function closeCarryForwardModal() {
        document.getElementById('myCarryForwardModel').style.display = 'none';
    }

    function toggleSelectAllCarryForward(chk) {
        var boxes = document.querySelectorAll('.chkCarryForwardInterviewer');
        for (var i = 0; i < boxes.length; i++) {
            boxes[i].checked = chk.checked;
        }
        updateCarryForwardCount();
    }

    function updateCarryForwardCount() {
        var checked = document.querySelectorAll('.chkCarryForwardInterviewer:checked');
        var allBoxes = document.querySelectorAll('.chkCarryForwardInterviewer');
        document.getElementById('spnCarryForwardSelected').textContent = checked.length + ' interviewer(s) selected';
        document.getElementById('chkSelectAllCarryForward').checked = allBoxes.length > 0 && checked.length === allBoxes.length;
    }

    function confirmBulkCarryForward() {
        var selected = document.querySelectorAll('.chkCarryForwardInterviewer:checked');
        if (selected.length === 0) {
            Swal.fire('Please select at least one interviewer.');
            return;
        }
        var ids = [];
        for (var i = 0; i < selected.length; i++) {
            ids.push(selected[i].getAttribute('data-id'));
        }
        Swal.fire({
            title: 'Carry Forward',
            text: 'Carry forward ' + ids.length + ' interviewer(s) with a negative total this week to next week?',
            showDenyButton: true,
            showCancelButton: false,
            confirmButtonText: 'Yes, Carry Forward',
            denyButtonText: 'Cancel'
        }).then(function (result) {
            if (!result.value) return;

            document.getElementById('btnProceedCarryForward').disabled = true;
            $.ajax({
                url: "/Finance/BulkCarryForwardPayment",
                type: "POST",
                data: { ids: ids.join(','), st: St_date, se: Se_date },
                dataType: 'json',
                success: function (data) {
                    document.getElementById('btnProceedCarryForward').disabled = false;
                    var failed = (data.results || []).filter(function (r) { return !r.success; }).length;
                    var successCount = (data.results ? data.results.length : ids.length) - failed;
                    var msg = successCount + ' interviewer(s) carried forward to ' + (data.nextWeekLabel || 'next week') + '.';
                    if (failed > 0) msg += ' ' + failed + ' failed.';
                    Swal.fire({
                        icon: failed > 0 ? 'warning' : 'success',
                        title: 'Bulk Carry Forward',
                        text: msg,
                        confirmButtonText: 'OK'
                    }).then(function () {
                        closeCarryForwardModal();
                        FinacneChangePage(_Currentpage);
                    });
                },
                error: function () {
                    document.getElementById('btnProceedCarryForward').disabled = false;
                    Swal.fire({ icon: 'error', title: 'Bulk Carry Forward Failed', text: 'The request could not be completed. Please try again.' });
                }
            });
        });
    }
