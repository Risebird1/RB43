<script>

    function searchResult() {
        $.ajax({
            type: "POST",
            url: "/finance/FNPaymentJson",
            data: { 'searchValue': $('#txtmeeting_filter').val() },
            success: function (data) {
                if (data != "failed") {
                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry, 1);
                }
            }
        });
    }
    function bindtableData(data) {

        var html = '';
        if (data.length == 0) {
            html += '  <tr>';
            html += ' <td colspan="9" class="text-center">No data available in table</td>';
            html += ' </tr>';
        }

        for (var i = 0; i < data.length; i++) {
            var pointdetails = data[i].points;
            html += '  <tr>';
            html += '  <td>' + data[i].comment + '</td>';
            html += ' <td>' + pointdetails + '</td> ';
            html += '  <td>';
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Detail View">';
            html += '   <span onclick = "DetailedView(' + data[i].id + ')" title = "Detail View" class="mdc-fab__icon material-icons">';
            html += '     <svg xmlns = "http://www.w3.org/2000/svg" width = "16" height = "16" fill = "currentColor" class="bi bi-eye-fill" viewBox = "0 0 16 16" >';
            html += '   <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />';
            html += '     <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />';
            html += '    </svg>';
            html += '    </span>';
            html += '    </button>';
            html += '  <button class="mdc-fab app-fab--absolute" aria-label="Add Points">';
            html += '   <span onclick="openPointspopup(' + data[i].id + ')" title="Add Points" class="mdc-fab__icon material-icons">';
            html += '  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>';
            html += '   </span>';
            /**/
            html += '   </button><input type="hidden" value="' + data[i].comment + '" id="hidcomment_' + data[i].id + '" /><input type="hidden" id="hidpoint_' + data[i].id + '" value="' + pointdetails + '" />';
            /**/
            html += ' <button class="mdc-fab app-fab--absolute" aria-label="Query">';
            html += '   <span onclick="openmyQueryModeljson(' + data[i].id + ')" title="Ask Query" class="mdc-fab__icon material-icons">';
            html += ' <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>';
            html += '   </span>';
            html += ' </button>';
            if (parseInt(pointdetails) > 0) {
                html += ' <button class="mdc-fab app-fab--absolute" aria-label="Confirm">';
                html += ' <span title="Confirm" onclick="confirmpayment(' + data[i].id + ')" class="mdc-fab__icon material-icons">';
                html += '   <svg style=" top: 3px; position: relative; left: 3px;" xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 24 24">';
                html += '  <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />';
                html += '  </svg>';
                html += ' </span>';
                html += ' </button>';
            }
            html += '</td>';
            html += ' </tr>';

        }
        $("#tblbodyPayment").empty().html(html);
    }
    function bindPages(pagecount, startpage, endpage, totalcount, currentpage) {
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        var abc = currentpage - 5;
        var pagevale = pagecount - currentpage;
        if (pagevale < 9) {
            abc = pagecount - 9;
        }
        if (abc < 0) {
            abc = 1;
        } else {
            abc = currentpage - 1;
        }

        var next = abc + 2;
        var nextset = abc + 10;
        var previousset = abc + 9;
        if (next = pagecount) {
            next = pagecount;
        }
        if (nextset >= pagecount) {
            nextset = pagecount;
        }
        for (var i = abc; i <= pagecount; i++) {
            if (i == currentpage) {
                html += '   <li class="active"><span>' + i + '</span></li>';
            } else if (i <= previousset) {
                if (Generateinvoiceflag == 2) {
                    html += '<li><a onclick="FinacneChangePage(' + i + ')">' + i + '</a></li> ';
                } else {
                    html += '<li><a href="/Finance/FNPayment?Page=' + i + '&searchValue=' + $('#txtmeeting_filter').val() + '&st=' + St_date + '&se=' + Se_date + '">' + i + '</a></li>';
                }
            } else if (i == nextset) {
                if (Generateinvoiceflag == 2) {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a onclick="FinacneChangePage(' + next + ')" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a onclick="FinacneChangePage(' + pagecount + ')">&gt;&gt;</a></li>';
                }
                else {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a href="/Finance/FNPayment?Page=' + next + '&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a href="/Finance/FNPayment?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
                }
            } else {
                break;
            }
            if (pagecount <= 10 && i == pagecount && i != 1) {
                if (Generateinvoiceflag == 2) {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a onclick="FinacneChangePage(' + next + ')" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a onclick="FinacneChangePage(' + pagecount + ')">&gt;&gt;</a></li>';
                } else {
                    html += '<li class="disabled PagedList-ellipses"><a>…</a></li>';
                    html += '<li class="PagedList-skipToNext"><a href="/Finance/FNPayment?Page=' + next + '&searchValue=' + $('#txtmeeting_filter').val() + '" rel="next">&gt;</a></li>';
                    html += '<li class="PagedList-skipToLast"><a href="/Finance/FNPayment?Page=' + pagecount + '&searchValue=' + $('#txtmeeting_filter').val() + '">&gt;&gt;</a></li>';
                }
            }
        }
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing ' + startpage + ' to ' + endpage + ' of ' + totalcount + ' entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>
<script>
    function DetailedView(interviewerid) {
        $.ajax({
            type: "POST",
            url: "/Finance/GetInterviewerPaymentDetails",
            data: { 'id': interviewerid, 'flag': Generateinvoiceflag, 'st': St_date, 'se': Se_date },
            success: function (data) {
                binddata(data.result);
                $("#txtInterviewerEmailid").text($("#hidcomment_" + interviewerid).val());
                $("#txtAmountD").text("Amount: " + data.totalAmount);
                $("#txtPayableAmountD").text("Payable Amount: " + data.payableAmount);
                $("#txtTdsdeductedD").text("Tds deducted: " + data.tds);
            }
        });
    }
    function openPointspopup(interviewerid) {
        var model = document.getElementById("myAddpointsModel");
        model.style.display = "block";
        $("#txtInterviewerid").val(interviewerid);
        $("#txtPoints").val("");
        $("#txtComments").val("");
        $("#addPointDate").val("");
    }
    function openmyQueryModeljson(interviewerid) {
        openmyQueryModel($("#hidcomment_" + interviewerid).val());
    }
    function openmyQueryModel(Emailid) {
        var model = document.getElementById("myQueryModel");
        model.style.display = "block";
        $("#txtqueryEmailid").val(Emailid);
        $("#txtquery").val("");
    }
    function AddPoints() {
        var addpointdate = $("#addPointDate").val();
        if (addpointdate.trim() != "") {
            var add_pointdate = new Date(addpointdate);
            var today = new Date();
            if (add_pointdate <= today) {
                $(".loader").show();
                if ($("#txtPoints").val().trim() != "" && $("#txtComments").val().trim() != "") {
                    $.ajax({
                        type: "POST",
                        url: "/Finance/AddPointsforInterviewer",
                        data: { 'id': $("#txtInterviewerid").val(), 'Points': $("#txtPoints").val(), 'Comment': $("#txtComments").val(), 'PointDate': addpointdate },
                        success: function (data) {
                            $(".loader").hide();
                            if (data == "Success") {
                                Swal.fire("Points are added successfully.");
                            } else {
                                Swal.fire("Fail to add Points.");
                            }
                            if (Generateinvoiceflag == 2) {
                                closemyAddpointsModel();
                                FinacneChangePage();
                            } else {
                                window.location.href = "/Finance/FNPayment";
                            }
                        }
                    });
                } else {
                    $(".loader").hide();
                    Swal.fire("All fields are required.");
                }
            } else {
                Swal.fire("Date Should not be greater then Today date.");
            }
        }
    }
    function SendQuery() {
        if ($("#txtquery").val().trim() != "") {
            $.ajax({
                type: "POST",
                url: "/Finance/SendQuerybyFN",
                data: { 'emailid': $("#txtqueryEmailid").val(), 'query': $("#txtquery").val() },
                success: function (data) {
                    if (data == "Success") {
                        Swal.fire("Query raised successfully.");
                    } else {
                        Swal.fire("Fail to raise the query, please try again.");
                    }
                    closemyQueryModel();
                }
            });
        } else {
            Swal.fire("Please write query.");
        }
    }
    function binddata(data) {
        var model = document.getElementById("myModal");
        model.style.display = "block";
        var html = '';
        html += '<table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">';
        html += '<thead>';
        html += '<tr>';
        html += '   <th>Date</th>';
        html += '   <th>Payment For</th>';
        html += '   <th>Type</th>';
        html += '   <th>Payment Status</th>';
        html += '   <th>Rate</th>';
        html += '   <th>Amnt</th>';
        html += '   <th>Video Duration<span class="durtime">(in mins)</span></th>';
        html += '   <th>Meeting Status</th>';
        html += '   <th>Interview Status</th>';
        html += '</tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            if (parseInt(data[i].points) == 0) {
                html += '                                        <tr style="background-color:red">';
            } else {
                html += '                                        <tr>';
            }
            html += '                               <td>' + data[i].date.toString().replace("T", " ") + '</td>';
            html += '                               <td>' + data[i].comment + '</td>';
            html += '                               <td>' + data[i].type + '</td>';
            html += '                               <td>' + data[i].status + '</td>';
            html += '                               <td>' + data[i].rate + '</td>';
            html += '                               <td>' + data[i].points + '</td>';

            if (data[i].videoDuration == null) {
                html += '                               <td></td>';
            }
            else {
                html += '                               <td>' + data[i].videoDuration + '</td>';
            }

            if (data[i].meetingStatusDetails == null) {
                html += '                               <td></td>';
            } else {
                html += '                               <td>' + data[i].meetingStatusDetails + '</td>';
            }
            if (data[i].interviewStatusDetails == null) {
                html += '                               <td></td>';
            } else {
                html += '                               <td>' + data[i].interviewStatusDetails + '</td>';
            }
            html += '                           </tr>';
        }

        html += '                   </tbody>';
        html += '</table>';
        $("#divDetailedView").empty().html(html);
    }
    function confirmpayment(interviewerid) {
        Swal.fire({
            title: 'Are you sure?',
            text: 'Do you want to confirm this payment?',
            showDenyButton: true,
            showCancelButton: true,
            confirmButtonText: 'Yes',
        }).then((result) => {
            if (result.value) {
                $.ajax({
                    url: "/Finance/ConfirmPayment",
                    type: "POST",
                    data: { id: interviewerid, index: Generateinvoiceflag, email: $("#hidcomment_" + interviewerid).val(), amount: $("#hidpoint_" + interviewerid).val(), st: St_date, se: Se_date },
