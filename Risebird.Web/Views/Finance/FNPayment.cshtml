<script src="~/Autocomplete/jquery-ui.min.js"></script>
<script>
    var Generateinvoiceflag = 1;
    var St_date;
    var Se_date;
    var actionbutton;
    var actiontype = 1;
    $(document).ready(function () {
        document.getElementById('addPointDate').value = new Date().toISOString().slice(0, 10);
        $("#adtxtEmailid").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Finance/FetchInterviewer",
                    type: "POST",
                    data: { term: request.term },
                    dataType: 'json',
                    success: function (data) {
                        response($.map(data, function (item) {
                            return item;
                        }))
                    },
                    error: function (err) {
                        Swal.fire(err);
                    }
                });
            },
            select: function () {
                document.getElementById("btnpayment").style.display = "block";
            },
            minLength: 1
        });
        document.getElementById("ui-id-1").style.zIndex = "10000";
    });
    $(document).ready(function () {
        var today = new Date();
        var month = today.getMonth() + 1;
        $("#ddlmonth").val(month);
        $(".Fnactive-header").click(function () {
            $(".Fnactive-header").removeClass("Fnactive-header-button");
            $(".Fnactive-header").addClass("mdc-button--raised");
            $(this).removeClass("mdc-button--raised");
            $(this).addClass("Fnactive-header-button");
        });
    });

    function PaymentDone() {
        var interviewer = $("#adtxtEmailid").val();
        var amount = $("#adtxtPoints").val();
        var comment = $("#adtxtComments").val();
        if (interviewer.trim() != "" && amount != "" && amount != "0" && comment.trim() != "") {
            //ajax call with details and check the interviewer
            $.ajax({
                type: "POST",
                url: "/Finance/AdvancePayment",
                data: { 'Interviewer': interviewer, 'Comment': comment, 'Amount': amount },
                success: function (data) {
                    Swal.fire(data);
                    if (Generateinvoiceflag == 2) {
                        closemyAdvancepaymentModel();
                        FinacneChangePage();
                    } else {
                        window.location.href = "/Finance/FNPayment";
                    }
                }
            });
        } else {
            Swal.fire("Fill all the fields.");
        }
    }
    function FinacneChangePage(pagenumber) {
        if (actiontype == 2) {
            Fetchinvoice(actionbutton, pagenumber);
        } else {
            SearchInvoice(pagenumber);
        }
    }
    function Fetchinvoice(index, pagenumber) {
        var today = new Date();
        var month = $("#ddlmonth").val();
        var year = today.getFullYear();
        var st = '';
        var se = '';
        if (index == 1) {
            st = year + '-' + month + '-01';
            se = year + '-' + month + '-07';
        } else if (index == 2) {
            st = year + '-' + month + '-08';
            se = year + '-' + month + '-14';
        } else if (index == 3) {
            st = year + '-' + month + '-15';
            se = year + '-' + month + '-21';
        } else if (index == 4) {
            var lastdate = lastday(year, (parseInt(month) - 1));
            st = year + '-' + month + '-22';
            se = year + '-' + month + '-' + lastdate;
        }
        $.ajax({
            type: "POST",
            url: "/finance/FNGenerateInvoiceJson",
            data: { 'PageSet': pagenumber, 'st': st, 'se': se },
            success: function (data) {
                if (data != "failed") {
                    Generateinvoiceflag = 2;
                    St_date = st;
                    Se_date = se;
                    actionbutton = index;
                    actiontype = 2;
                    bindtableData(data.result);
                    bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry, data.currentpage);
                    $("#txtAmount").text("Amount: " + data.totalAmount);
                    $("#txtPayableAmount").text("Payable Amount: " + data.payableAmount);
                    $("#txtTdsdeducted").text("Tds: " + data.tds);
                    $("#txtpaidamount").text("Paid Amount: " + data.totalpaidamount);
                    $("#txtinterviewamount").text("Interview Amount: " + data.totalinterviewamount);
                    $("#txtnoshowamount").text("No Show Amount: " + data.totalNoShowamount);
                    $("#txtdroppedamount").text("Dropped Amount: " + data.totaldroppedamount);
                    $("#txtpendingamount").text("Pending Amount: " + data.pendingAmount);
                    $("#txtqcamount").text("QC Amount: " + data.qcamount);
                }
            }
        });

    }
    var lastday = function (y, m) {
        return new Date(y, m + 1, 0).getDate();
    }
    function SearchInvoice(pagenumber) {
        var st = $("#instdate").val();
        var se = $("#insedate").val();
        if (st.trim() != "" && se.trim() != "") {
            var stdate = new Date(st);
            var sedate = new Date(se);
            if (sedate < stdate) {
                Swal.fire("Start date should be less than End Date");
            } else {
                $.ajax({
                    type: "POST",
                    url: "/finance/FNGenerateInvoiceJson",
                    data: { 'PageSet': pagenumber, 'st': st, 'se': se },
                    success: function (data) {
                        if (data != "failed") {
                            Generateinvoiceflag = 2;
                            St_date = st;
                            Se_date = se;
                            actiontype = 1;
                            bindtableData(data.result);
                            bindPages(data.totalPage, data.startPage, data.endPage, data.totalentry, data.currentpage);
                            closemyinvoiceModel();
                            $(".Fnactive-header").removeClass("Fnactive-header-button");
                            $(".Fnactive-header").addClass("mdc-button--raised");
                            $("#txtAmount").text("Amount: " + data.totalAmount);
                            $("#txtPayableAmount").text("Payable Amount: " + data.payableAmount);
                            $("#txtTdsdeducted").text("Tds: " + data.tds);
                            $("#txtpaidamount").text("Paid Amount: " + data.totalpaidamount);
                            $("#txtinterviewamount").text("Interview Amount: " + data.totalinterviewamount);
                            $("#txtnoshowamount").text("No Show Amount: " + data.totalNoShowamount);
                            $("#txtdroppedamount").text("Dropped Amount: " + data.totaldroppedamount);
                            $("#txtpendingamount").text("Pending Amount: " + data.pendingAmount);
                            $("#txtqcamount").text("QC Amount: " + data.qcamount);
                        }
                    }
                });
            }
        } else {
            Swal.fire("Start date and end date both are required.");
        }
    }
    function ExportFNDetails() {
        if (Generateinvoiceflag == 2) {
            window.location.href = "/Finance/ExportGenerateFNPayment?st=" + St_date + "&se=" + Se_date;
        } else {
            window.location.href = "/Finance/ExportFNPayment";
        }
    }
    function openPaymentHistory() {
        window.location.href = "/Finance/PaymentHistory";
    }
    function Changemonth() {
        $(".Fnactive-header").removeClass("Fnactive-header-button");
        $(".Fnactive-header").addClass("mdc-button--raised");
        bindtableDataChangeMonth();
        bindPagesChangeMonth();
        $("#txtAmount").text("Amount: 0");
        $("#txtPayableAmount").text("Payable Amount: 0");
        $("#txtTdsdeducted").text("Tds: 0");
        $("#txtpaidamount").text("Paid Amount: 0");
        $("#txtinterviewamount").text("Interview Amount: 0");
        $("#txtnoshowamount").text("No Show Amount: 0");
        $("#txtdroppedamount").text("Dropped Amount: 0");
        $("#txtpendingamount").text("Pending Amount: 0");
        $("#txtqcamount").text("QC Amount: 0");
    }
    function bindtableDataChangeMonth() {
        var html = '';
        html += '  <tr>';
        html += ' <td colspan="9" class="text-center">No data available in table</td>';
        html += ' </tr>';
        $("#tblbodyPayment").empty().html(html);
    }
    function bindPagesChangeMonth() {
        St_date = '';
        Se_date = '';
        var html = '';
        html += '<div class="pagination-container">';
        html += '<ul class="pagination">';
        html += '</ul>';
        html += '</div>';
        $("#divmeetingpages").empty().html(html);
        var pagestartdetails = '';
        pagestartdetails += 'Showing 0 to 0 of 0 entries';
        $("#divmeetingentries").empty().html(pagestartdetails);

    }
</script>

