    // currentTableData is kept in sync with every bindtableData() call and also
    // seeded from the server-rendered Razor model on first page load.
    var currentTableData = [];

    function batchPanVerifiedLabel(row) {
        var isPanVerified = row.isPanVerified === true || row.isPanVerified === 'true' || row.IsPanVerified === true;
        if (!isPanVerified) {
            return '<span class="text-danger" title="PAN not verified">No</span>';
        }
        var panNum = row.verifiedPAN || row.VerifiedPAN || '—';
        var panName = row.nameAtPan || row.NameAtPan || '—';
        var panDate = row.panVerifiedOn || row.PanVerifiedOn || '';
        if (panDate && panDate.toString().length >= 10) {
            var d = new Date(panDate);
            panDate = isNaN(d.getTime()) ? panDate : d.getDate() + ' ' + ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()] + ' ' + d.getFullYear();
        }
        return '<span class="text-success">Yes</span>'
            + '<span class="pan-info-wrap">'
            +   '<i class="pan-info-icon">i</i>'
            +   '<span class="pan-tooltip-box">'
            +     'PAN: ' + panNum + '<br/>'
            +     'Name: ' + panName + '<br/>'
            +     'On: ' + (panDate || '—')
            +   '</span>'
            + '</span>';
    }

