@model X.PagedList.IPagedList<Risebird.Entities.ViewModel.RBInterviewDetails>
@using X.PagedList.Mvc.Core;
@using System;
@*@using Risebird.Entities.Enum*@
@{
    ViewData["Title"] = "RB Payment Details";
    ViewBag.PageHeader = "RB Payment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Autocomplete/jquery-ui.min.css" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=54321" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=54321" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=54321" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> RB Payment Details</h4></div>
                </div>

                <div class="pull-right client-ms">
                    <select id="ddlmonth" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onchange="Changemonth()">
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="1-7 of this month" onclick="Fetchinvoice(1,1)">
                        <span data-toggle="tooltip" data-placement="top" title="1-7 of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;">1-7</font></span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="8-14 of this month" onclick="Fetchinvoice(2,1)">
                        <span data-toggle="tooltip" data-placement="top" title="8-14 of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;">8-14</font></span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="15-21 of this month" onclick="Fetchinvoice(3,1)">
                        <span data-toggle="tooltip" data-placement="top" title="15-21 of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;">15-21</font></span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded Fnactive-header" title="22-month end of this month" onclick="Fetchinvoice(4,1)">
                        <span data-toggle="tooltip" data-placement="top" title="22-month end of this month" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;">22-_</font></span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space" title="Payment History">
                        <span class="fa fa-history" data-toggle="tooltip" data-placement="top" title="Payment History" onclick="openPaymentHistory()" data-original-title="Tooltip on top">
                            <font style="        font-family: Roboto, sans-serif;
        font-size: 12px;
        padding-left: 3px;
">Payment History</font>
                        </span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" title="Click here to generate invoice.">
                        <span class="fa fa-file" data-toggle="tooltip" data-placement="top" title="Click here to generate invoice." onclick="openmyinvoiceModel()" data-original-title="Tooltip on top">
                            <font style="        font-family: Roboto, sans-serif;
        font-size: 12px;
        padding-left: 3px;">Generate Invoice</font>
                        </span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" title="Click here to Advance Payment.">
                        <span class="fa fa-credit-card" data-toggle="tooltip" data-placement="top" title="Click here to Advance Payment." onclick="openmyAdvancepaymentModel()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;padding-left:3px;">Advance Payment</font></span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                        @*<span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="location.href='@Url.Action("ExportFNPayment", "Finance")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Export Excel</font></span>*@
                        <span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="ExportFNDetails()" data-original-title="Tooltip on top">
                            <font style="        font-family: Roboto, sans-serif;
        font-size: 12px;
        padding-left: 3px;
"> Export Excel</font>
                        </span>
                    </button>
                    <div id="meeting_filter" class="dataTables_filter pull-right" style="margin-left:5PX;">

                        <div class="searchCon mt-20">
                            <button onclick="searchResult()" type="button" id="search">&nbsp</button>
                            <input type="search" class="form-control form-control-sm" id="txtmeeting_filter" placeholder="Search records" aria-controls="meeting" onkeypress="searchResultEnter(event)" value="@ViewBag.Searchvalue">

                            <span id="trigger-update-search" class="ref-btn" onclick="RefreshSearch()"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 18 18"><path fill="#6f6f6f" d="M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z" /></svg></span>




                        </div>
                    </div>
                    <div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">


                            <div>

                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">

                                        <div class="clearfix"></div>
                                        <div>
                                            <label id="txtAmount" style="padding:0 0 0 0">Amount: @ViewBag.totalAmount </label> |
                                            <label id="txtTdsdeducted" style="padding:0 0 0 0">Tds: @ViewBag.Tds</label> |
                                            <label id="txtPayableAmount" style="padding:0 0 0 0">Payable Amount: @ViewBag.payableAmount</label> |
                                            <label id="txtpaidamount" style="padding:0 0 0 0">Paid Amount: 0</label> |
                                            <label id="txtinterviewamount" style="padding:0 0 0 0">Interview Amount: 0</label> |
                                            <label id="txtnoshowamount" style="padding:0 0 0 0">No Show Amount: 0</label> |
                                            <label id="txtdroppedamount" style="padding:0 0 0 0">Dropped Amount: 0</label> |
                                            <label id="txtpendingamount" style="padding:0 0 0 0">Pending Amount: 0</label> |
                                            <label id="txtqcamount" style="padding:0 0 0 0">QC Amount: 0</label>
                                        </div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Amount</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>

                                                            <th>Name</th>
                                                            <th>Amount</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count == 0)
                                                        {
                                                            <tr><td colspan="3" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {

                                                            <tr>
                                                                <td>@item.Comment<input type="hidden" id="hidcomment_@item.id" value="@item.Comment" /></td>
                                                                <td>@item.Points<input type="hidden" id="hidpoint_@item.id" value="@item.Points" /></td>
                                                                <td>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Detailed View">
                                                                        <span onclick="DetailedView(@item.id)" title="Detailed View" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                            </svg>
                                                                        </span>
                                                                    </button>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Add Points">
                                                                        <span onclick="openPointspopup(@item.id)" title="Add Points" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
                                                                        </span>
                                                                    </button>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Query">
                                                                        <span onclick="openmyQueryModel('@item.Comment')" title="Ask Query" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>
                                                                        </span>
                                                                    </button>
                                                                    @if (item.Points > 0)
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Confirm">
                                                                            <span title="Confirm" onclick="confirmpayment(@item.id)" class="mdc-fab__icon material-icons">
                                                                                <svg style=" top: 3px; position: relative; left: 3px;" xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 24 24">
                                                                                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-5 pull-left" id="divmeetingentries">
                                            Showing @ViewBag.PageStartCount to @ViewBag.PageEndCount of @ViewBag.TotalCount entries
                                        </div>

                                        <div class="col-sm-12 col-md-7 dataTables_paginate pull-right" id="divmeetingpages">
                                            @Html.PagedListPager(Model, Page => Url.Action("FNPayment", new { Page = Page }))
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>

        <div class="rbpay">
            <div id="myModal" class="modal">
                <!-- Modal content -->
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="filheader">
                                <div class="filavatar">
                                    <span class="publicsharing-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg>

                                    </span>
                                </div>
                                <h5 class="modal-title pull-left"> Detailed View ( <label id="txtInterviewerEmailid"></label> )</h5>
                            </div>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="CloseMyModelPopup()">
                                <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                            </button>
                            <div class="modal-body">
                                <div class="col-md-12">

                                    <div id="divDetailedView" style="max-height:250px;overflow-y:auto"></div>
                                    <div style="text-align:center">
                                        <label id="txtAmountD">Amount: @ViewBag.totalAmount </label> |
                                        <label id="txtTdsdeductedD">Tds deducted: @ViewBag.Tds</label> |
                                        <label id="txtPayableAmountD">Payable Amount: @ViewBag.payableAmount</label>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end row -->
        <div id="myAddpointsModel" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="filheader">
                            <div class="filavatar">
                                <span class="publicsharing-icon">
                                    <svg fill="rgb(255,255,255)" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
                                </span>
                            </div>
                            <h5 class="modal-title pull-left"> Add Points</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closemyAddpointsModel()">
                            <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                        </button>
                        <div class="modal-body">

                            <input type="hidden" id="txtInterviewerid" />
                            <div class="col-md-12"><p class="desp-label" style="margin-bottom: 5px; font-size: 16px;">Date</p><input type="date" id="addPointDate" class="form-control" style="margin-bottom: 10px;" /></div>
                            <div class="col-md-12"><p class="desp-label" style="margin-bottom: 5px; font-size: 16px;">Please Add Points</p><input type="number" id="txtPoints" placeholder="Please Add Points" class="form-control" style="margin-bottom: 10px;" /></div>

                            <div class="col-md-12"> <p class="desp-label" style="margin-bottom: 5px; font-size: 16px;">Please Enter Comment</p><input type="text" id="txtComments" placeholder="Please Enter Comment" class="form-control" style="margin-bottom: 10px;" /></div>
                            <div class="col-md-12">
                                <input type="button" value="Add Points" onclick="AddPoints()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right card-title-space" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="myQueryModel" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="filheader">
                            <div class="filavatar">
                                <span class="publicsharing-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg>
                                </span>
                            </div>
                            <h5 class="modal-title pull-left"> Write Query</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closemyQueryModel()">
                            <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                        </button>
                        <div class="modal-body">
                            <div class="col-md-12">
                                <input type="hidden" id="txtqueryEmailid" />
                                <textarea cols="3" id="txtquery" style="width:100%;margin-bottom:10px;"></textarea>
                            </div>
                            <div class="col-md-12">
                                <input type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right card-title-space" value="Send Query" onclick="SendQuery()" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="myAdvancepaymentModel" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="filheader">
                            <div class="filavatar">
                                <span class="publicsharing-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-wallet-fill" viewBox="0 0 16 16">
                                        <path d="M1.5 2A1.5 1.5 0 0 0 0 3.5v2h6a.5.5 0 0 1 .5.5c0 .253.08.644.306.958.207.288.557.542 1.194.542.637 0 .987-.254 1.194-.542.226-.314.306-.705.306-.958a.5.5 0 0 1 .5-.5h6v-2A1.5 1.5 0 0 0 14.5 2h-13z" />
                                        <path d="M16 6.5h-5.551a2.678 2.678 0 0 1-.443 1.042C9.613 8.088 8.963 8.5 8 8.5c-.963 0-1.613-.412-2.006-.958A2.679 2.679 0 0 1 5.551 6.5H0v6A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-6z" />
                                    </svg>
                                </span>
                            </div>
                            <h5 class="modal-title pull-left"> Advance Payment</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closemyAdvancepaymentModel()">
                            <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                        </button>
                        <div class="modal-body">

                            <input type="hidden" id="txtInterviewerid" />
                            <div class="col-md-12"><p class="desp-label" style="margin-bottom: 5px; font-size: 16px;">Please Enter Emailid</p><input type="text" id="adtxtEmailid" placeholder="Please Enter Emailid" class="form-control" style="margin-bottom: 10px;" /></div>
                            <div class="col-md-12"><p class="desp-label" style="margin-bottom: 5px; font-size: 16px;">Please Enter Amount</p><input type="number" id="adtxtPoints" placeholder="Please Enter Amount" class="form-control" style="margin-bottom: 10px;" /></div>

                            <div class="col-md-12"> <p class="desp-label" style="margin-bottom: 5px; font-size: 16px;">Please Enter Comment</p><input type="text" id="adtxtComments" placeholder="Please Enter Comment" class="form-control" style="margin-bottom: 10px;" /></div>
                            <div class="col-md-12">
                                <input type="button" value="Payment" id="btnpayment" style="display:none" onclick="PaymentDone()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right card-title-space" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="myinvoiceModel" class="modal">
            <!-- Modal content -->
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="filheader">
                            <div class="filavatar">
                                <span class="publicsharing-icon">
