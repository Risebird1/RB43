                }
                for (var i = 0; i < list.length; i++) {
                    var row = list[i];
                    html += '<tr>';
                    html += '<td style="text-align:center;"><input type="checkbox" class="chkBatchInterviewer" data-id="' + row.id + '" data-amount="' + row.amount + '" data-email="' + (row.email || '') + '" onchange="updateBatchCount()" /></td>';
                    html += '<td>' + (row.email || '') + '</td>';
                    html += '<td>' + row.amount + '</td>';
                    html += '<td><span class="text-success" title="Bank account verified">Yes</span></td>';
                    html += '<td>' + batchPanVerifiedLabel(row) + '</td>';
                    html += '<td style="text-align:center;">'
                         +    '<button onclick="viewBatchInterviewerDetails(' + row.id + ',\'' + (row.email || '') + '\')" '
                         +      'title="View payment details" '
                         +      'style="background:none;border:none;cursor:pointer;padding:2px 5px;color:#1976d2;">'
                         +      '<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" viewBox="0 0 16 16">'
