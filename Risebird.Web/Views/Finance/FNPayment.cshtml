    function carryForwardPayment(interviewerid) {
        if (carryForwardInProgress == 0) {
            carryForwardInProgress = 1;
            Swal.fire({
                title: 'Are you sure?',
                text: 'This week\'s total for this interviewer is negative. Carry it forward to next week?',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Yes',
            }).then((result) => {
                if (result.value) {
                    $.ajax({
                        url: "/Finance/CarryForwardPayment",
                        type: "POST",
                        data: { id: interviewerid, st: St_date, se: Se_date },
                        dataType: 'json',
                        success: function (data) {
                            Swal.fire(data.message);
