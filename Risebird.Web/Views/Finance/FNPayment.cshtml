    function processKycPayoutLapseCandidates() {
        Swal.fire({
            title: 'Check KYC Lapses',
            text: 'Scan for interviewers with 120+ day old pending/submitted payouts whose KYC (bank + PAN) is incomplete, and start reminder/lapse tracking for them?',
            showDenyButton: true,
            showCancelButton: false,
            confirmButtonText: 'Yes, Scan Now',
            denyButtonText: 'Cancel'
        }).then(function (result) {
            if (!result.value) return;

            var btn = document.getElementById('btnProcessKycLapse');
            btn.disabled = true;

            $.ajax({
                url: "/Finance/ProcessKycPayoutLapseCandidates",
                type: "POST",
                dataType: 'json',
                success: function (data) {
                    btn.disabled = false;
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'KYC Lapse Scan Complete',
                            text: data.added + ' interviewer/month record(s) added to the KYC lapse tracking list.',
                            confirmButtonText: 'OK'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'KYC Lapse Scan Failed',
                            text: data.message || 'The scan could not be completed. Please try again.',
                            confirmButtonText: 'OK'
                        });
                    }
                },
                error: function () {
                    btn.disabled = false;
                    Swal.fire({
                        icon: 'error',
                        title: 'KYC Lapse Scan Failed',
                        text: 'The scan could not be completed. Please try again.',
                        confirmButtonText: 'OK'
                    });
                }
            });
        });
    }

