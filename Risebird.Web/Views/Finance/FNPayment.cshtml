    function viewBatchInterviewerDetails(id, email) {
        $.ajax({
            type: 'POST',
            url: '/Finance/GetInterviewerPaymentDetails',
            data: { id: id, flag: Generateinvoiceflag, st: St_date, se: Se_date },
