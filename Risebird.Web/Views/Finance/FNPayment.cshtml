    function toggleSelectAllBatch(chk) {
        var boxes = document.querySelectorAll('.chkBatchInterviewer');
        for (var i = 0; i < boxes.length; i++) {
            boxes[i].checked = chk.checked;
        }
        updateBatchCount();
    }

    function updateBatchCount() {
        var checked = document.querySelectorAll('.chkBatchInterviewer:checked');
        var allBoxes = document.querySelectorAll('.chkBatchInterviewer');
        var totalAmt = 0;
        for (var i = 0; i < checked.length; i++) {
            totalAmt += parseInt(checked[i].getAttribute('data-amount') || 0);
        }
        var txt = checked.length + ' interviewer(s) selected';
        if (checked.length > 0) txt += ' &nbsp;|&nbsp; Total Amount: <strong>' + totalAmt + '</strong>';
        document.getElementById('spnBatchSelected').innerHTML = txt;
        document.getElementById('chkSelectAllBatch').checked = allBoxes.length > 0 && checked.length === allBoxes.length;
    }

    function confirmBatchPayout() {
        var selected = document.querySelectorAll('.chkBatchInterviewer:checked');
        if (selected.length === 0) {
            Swal.fire('Please select at least one interviewer.');
            return;
        }
        var ids = [];
        var totalAmt = 0;
        for (var i = 0; i < selected.length; i++) {
            ids.push(selected[i].getAttribute('data-id'));
            totalAmt += parseInt(selected[i].getAttribute('data-amount') || 0);
        }
        Swal.fire({
            title: 'Batch Payout',
            text: 'Proceed with Cashfree payout for ' + ids.length + ' interviewer(s) ? Total Amount: ' + totalAmt + '?',
            showDenyButton: true,
            showCancelButton: false,
            confirmButtonText: 'Yes, Proceed',
            denyButtonText: 'Cancel'
        }).then(function (result) {
            
            if (!result.value) return;

            document.getElementById('btnProceedBatch').disabled = true;

            // Full-screen blocking overlay
            var overlay = document.createElement('div');
            overlay.id = 'batchOverlay';
            overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.55);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;';
            overlay.innerHTML =
                '<div style="background:#fff;border-radius:10px;padding:36px 40px;min-width:320px;max-width:460px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.25);">' +
                    '<img src="/Newassets/img/lazyload.gif" style="height:48px;width:48px;margin-bottom:16px;" />' +
                    '<div style="font-size:17px;font-weight:700;color:#1565c0;margin-bottom:8px;">Processing Batch Payout&hellip;</div>' +
                    '<div style="font-size:13px;color:#555;margin-bottom:16px;">Sending payments to Cashfree one by one.<br><strong>Do not close or refresh this page.</strong></div>' +
                    '<div style="background:#dce9fb;border-radius:6px;height:10px;overflow:hidden;margin-bottom:10px;">' +
                        '<div id="batchOverlayBar" style="height:100%;width:0%;background:#1976d2;transition:width 0.5s ease;"></div>' +
                    '</div>' +
                    '<div id="batchOverlayLabel" style="font-size:12px;color:#1976d2;">Initiating payouts for <strong>' + ids.length + '</strong> interviewer(s)&hellip;</div>' +
                '</div>';
            document.body.appendChild(overlay);

            var divResult = document.getElementById('divBatchResult');
            divResult.innerHTML = '';
            divResult.style.display = 'none';

            // Animate overlay bar to ~80% while waiting; 100% set on completion
            var fakeProgress = 0;
            var fakeTimer = setInterval(function () {
                if (fakeProgress < 80) {
                    fakeProgress += Math.random() * 8;
                    if (fakeProgress > 80) fakeProgress = 80;
                    var pct = fakeProgress.toFixed(1) + '%';
                    var oBar = document.getElementById('batchOverlayBar');
                    if (oBar) oBar.style.width = pct;
                    var oLbl = document.getElementById('batchOverlayLabel');
                    if (oLbl) oLbl.textContent = 'Processing\u2026 please wait, this may take a few seconds per interviewer.';
                }
            }, 700);

            $.ajax({
                url: "/Finance/BatchConfirmPaymentViaCashfree",
                type: "POST",
                data: {
                    ids: ids.join(','),
                    index: Generateinvoiceflag,
                    st: St_date || '',
                    se: Se_date || ''
                },
                dataType: 'json',
                success: function (data) {
                    clearInterval(fakeTimer);
                    var oBar = document.getElementById('batchOverlayBar');
                    if (oBar) oBar.style.width = '100%';
                        var ov = document.getElementById('batchOverlay');
                        if (ov) ov.parentNode.removeChild(ov);

                        var successCount = 0, failCount = 0;
                        if (data.results && data.results.length > 0) {
                            for (var j = 0; j < data.results.length; j++) {
                                if (data.results[j].success) successCount++; else failCount++;
                            }
                        }
                        document.getElementById('btnProceedBatch').disabled = false;

                        if (failCount === 0) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Batch Payout Successful',
                                text: successCount + ' payout(s) initiated successfully.',
                                confirmButtonText: 'OK'
                            }).then(function () {
                                closeBatchPayoutModal();
                                FinacneChangePage(_Currentpage);
                            });
                        } else {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Batch Payout Completed with Errors',
                                html: '<b>' + successCount + '</b> payout(s) succeeded &nbsp;|&nbsp; <b>' + failCount + '</b> failed.<br/>Please review and retry the failed entries.',
                                confirmButtonText: 'OK'
                            }).then(function () {
                                closeBatchPayoutModal();
                                FinacneChangePage(_Currentpage);
                            });
                        }
                },
                error: function () {
                    clearInterval(fakeTimer);
                    var ov = document.getElementById('batchOverlay');
                    if (ov) ov.parentNode.removeChild(ov);
                    document.getElementById('btnProceedBatch').disabled = false;

                    setTimeout(function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Batch Payout Failed',
                            text: 'The batch payout request could not be completed. Please try again.',
                            confirmButtonText: 'OK'
                        });
                    }, 200);
                }
            });
        });
    }
