@model IEnumerable<Risebird.Entities.ViewModel.InvoiceListVM>
@using System
@using System.Linq
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Invoice List";
    ViewBag.PageHeader = "Invoice List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Active tab from server (controller sets ViewBag.ActiveTab)
    string activeTab = (ViewBag.ActiveTab ?? "monthly").ToString();

    // Monthly filter values for the filter modal
    dynamic filter = null;
    string Month        = string.Empty;
    string Year         = string.Empty;
    string[] FilterClient = new string[] { };
    string[] FilterStatus = new string[] { };

    // Monthly data (only populated when tab != "paid")
    bool monthlyLoaded   = (bool)(ViewBag.MonthlyLoaded ?? false);
    bool hasAnyRemark    = monthlyLoaded && Model.Any(m => !string.IsNullOrEmpty(m.LatestRemark));

    // Unpaid data (always populated)
    var unpaidList          = ViewBag.UnpaidList as List<InvoiceListVM> ?? new List<InvoiceListVM>();
    bool unpaidHasAnyRemark = unpaidList.Any(m => !string.IsNullOrEmpty(m.LatestRemark));

    // Per-status counts & gross for unpaid sub-tabs
    int upCountDraft              = unpaidList.Count(x => x.Status == 0);
    int upCountGenerated          = unpaidList.Count(x => x.Status == 1);
    int upCountPOPending          = unpaidList.Count(x => x.Status == 2);
    int upCountApprovalPending    = unpaidList.Count(x => x.Status == 3);
    int upCountIRP                = unpaidList.Count(x => x.Status == 4);
    decimal upGrossDraft              = unpaidList.Where(x => x.Status == 0).Sum(x => x.GrossAmount);
    decimal upGrossGenerated          = unpaidList.Where(x => x.Status == 1).Sum(x => x.GrossAmount);
    decimal upGrossPOPending          = unpaidList.Where(x => x.Status == 2).Sum(x => x.GrossAmount);
    decimal upGrossApprovalPending    = unpaidList.Where(x => x.Status == 3).Sum(x => x.GrossAmount);
    decimal upGrossIRP                = unpaidList.Where(x => x.Status == 4).Sum(x => x.GrossAmount);

    // Paid data (only populated when tab == "paid")
    bool paidLoaded         = (bool)(ViewBag.PaidLoaded ?? false);
    var paidList            = ViewBag.PaidList as List<InvoiceListVM> ?? new List<InvoiceListVM>();
    bool paidHasAnyRemark   = paidLoaded && paidList.Any(m => !string.IsNullOrEmpty(m.LatestRemark));

    int paidFromYear  = (int)(ViewBag.PaidFromYear  ?? 0);
    int paidFromMonth = (int)(ViewBag.PaidFromMonth ?? 0);
    int paidToYear    = (int)(ViewBag.PaidToYear    ?? 0);
    int paidToMonth   = (int)(ViewBag.PaidToMonth   ?? 0);
    bool paidFiltered = paidFromYear > 0 || paidToYear > 0;

    var monthNames = new[]{"","January","February","March","April","May","June","July","August","September","October","November","December"};
    var monthShort = new[]{"","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
}
@if (HttpContextAccessor.HttpContext.Session.GetString("InvoiceListFilter") != null)
{
    filter        = JsonConvert.DeserializeObject<InvoiceListFilter>(HttpContextAccessor.HttpContext.Session.GetString("InvoiceListFilter"));
    Month         = filter.Month  != null ? filter.Month  : string.Empty;
    Year          = filter.Year   != null ? filter.Year   : string.Empty;
    FilterClient  = filter.Client != null ? filter.Client : new string[] { };
    FilterStatus  = filter.Status != null ? filter.Status : new string[] { };
}

<link href="~/Newassets/css/irf.css?v=54321" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<style>
    .invoice-list-page table.journey th,
    .invoice-list-page table.journey td {
        max-width: none;
        vertical-align: middle !important;
        line-height: 1.4 !important;
        padding: 8px 10px !important;
    }
    .invoice-list-page .inv-tab-table thead th,
    .invoice-list-page .inv-tab-table tfoot th {
        background: #e0e0e0 !important;
        color: #676767 !important;
        font-weight: 500 !important;
        font-size: 13px;
        font-family: Roboto, sans-serif;
        padding: 7px 10px !important;
        vertical-align: middle !important;
        white-space: nowrap;
        border: 1px solid #dee2e65e !important;
    }
    .invoice-list-page .inv-tab-table tbody td {
        font-family: Roboto, sans-serif;
        font-size: 13px;
        color: #333;
    }
    .invoice-list-page .inv-tab-table .col-status {
        min-width: 115px;
        white-space: nowrap;
        overflow: visible;
        text-align: center;
    }
    .invoice-list-page .inv-tab-table .badge {
        display: inline-block;
        line-height: 1.25;
        padding: 5px 10px;
        margin: 0;
        white-space: nowrap;
        vertical-align: middle;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .3px;
    }
    /* Tab nav */
    .inv-nav-tabs {
        border-bottom: 2px solid #dee2e6;
        margin-bottom: 16px;
    }
    .inv-nav-tabs .nav-link {
        color: #555;
        font-size: 13px;
        font-family: Roboto, sans-serif;
        font-weight: 500;
        border: none;
        border-bottom: 3px solid transparent;
        border-radius: 0;
        padding: 9px 20px;
        margin-bottom: -2px;
        text-decoration: none;
        cursor: pointer;
    }
    .inv-nav-tabs .nav-link.active {
        color: #3949ab;
        border-bottom: 3px solid #3949ab;
        background: transparent;
    }
    .inv-nav-tabs .nav-link:hover:not(.active) {
        color: #3949ab;
        border-bottom: 3px solid #c5cae9;
        background: transparent;
    }
    .inv-tab-badge {
        display: inline-block;
        background: #ef5350;
        color: #fff;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 700;
        padding: 1px 7px;
        margin-left: 5px;
        vertical-align: middle;
    }
    .inv-summary-label {
        color: forestgreen;
        font-weight: 600;
        font-size: 13px;
    }
    .inv-not-loaded {
        text-align: center;
        padding: 40px 20px;
        color: #999;
        font-size: 13px;
    }
    /* ── Unpaid sub-tabs ── */
    .inv-sub-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e8e8e8;
    }
    .inv-sub-tabs .sub-tab {
        cursor: pointer;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-family: Roboto, sans-serif;
        font-weight: 500;
        border: 1px solid #d0d0d0;
        background: #f5f5f5;
        color: #555;
        user-select: none;
        transition: background .15s, border-color .15s, color .15s;
        white-space: nowrap;
    }
    .inv-sub-tabs .sub-tab:hover:not(.active) {
        background: #e8eaf6;
        border-color: #9fa8da;
        color: #3949ab;
    }
    .inv-sub-tabs .sub-tab.active {
        background: #3949ab;
        border-color: #3949ab;
        color: #fff;
    }
    .inv-sub-tab-badge {
        display: inline-block;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 700;
        padding: 1px 6px;
        margin-left: 4px;
        background: rgba(0,0,0,0.12);
        color: inherit;
    }
    .inv-sub-tabs .sub-tab.active .inv-sub-tab-badge {
        background: rgba(255,255,255,0.28);
    }
    #unpaid-sub-summary {
        margin-bottom: 10px;
    }
    /* Hidden integer-status column used only for DataTable column search */
    .inv-status-int-col { display: none !important; }
    /* Due Date / Expected Date / Aging columns */
    .col-duedate, .col-expecteddate, .col-aging {
        white-space: nowrap;
        min-width: 105px;
    }
    .col-aging-overdue { color: #c62828; font-weight: 600; }
    .col-aging-ok      { color: #2e7d32; }
    .inv-expdate-display {
        font-size: 12px;
        color: #333;
        white-space: nowrap;
    }
    .inv-expdate-display.not-set { color: #aaa; font-style: italic; }
    .btn-set-expdate {
        padding: 2px 7px;
        font-size: 11px;
        margin-left: 4px;
        vertical-align: middle;
    }
</style>

<div class="main-panel invoice-list-page" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad invoice-details" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"><h4 class="card-title">Invoice List</h4></div>
                </div>
                <div class="pull-right client-ms">
                    <a href="@Url.Action("GenerateInvoice", "Finance")" target="_blank"
                       class="mdc-button mdc-button--raised mdc-ripple-upgraded"
                       style="margin-right:8px; text-decoration:none;">
                        <span class="mdc-button__label">
                            <span class="fa fa-plus"></span>
                            <font style="font-family:Roboto,sans-serif;font-size:12px;"> Generate Invoice</font>
                        </span>
                        <div class="mdc-button__ripple"></div>
                    </a>
                    @if (activeTab == "monthly")
                    {
                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded"
                                id="btnFilterModal" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label">
                                <span class="fa fa-filter"></span>
                                <font style="font-family:Roboto,sans-serif;font-size:12px;"> Filter</font>
                            </span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">

                        <!-- Loader -->
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>

                        <div class="dataloading">

                            @* Filter modal — only needed for Monthly tab *@
                            @if (activeTab == "monthly")
                            {
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar"><span class="fa fa-filter"></span></div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel">Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("InvoiceList","Finance")" method="post" id="filterForm">
                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 desp-label">Month</label>
                                                                <div class="col-md-12">
                                                                    <select id="Month" name="Month" class="form-control">
                                                                        <option value="1">January</option>
                                                                        <option value="2">February</option>
                                                                        <option value="3">March</option>
                                                                        <option value="4">April</option>
                                                                        <option value="5">May</option>
                                                                        <option value="6">June</option>
                                                                        <option value="7">July</option>
                                                                        <option value="8">August</option>
                                                                        <option value="9">September</option>
                                                                        <option value="10">October</option>
                                                                        <option value="11">November</option>
                                                                        <option value="12">December</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 desp-label">Year</label>
                                                                <div class="col-md-12">
                                                                    <select id="Year" name="Year" class="form-control">
                                                                        @for (int y = DateTime.Now.Year; y >= 2020; y--)
                                                                        {
                                                                            <option value="@y">@y</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 desp-label">Client</label>
                                                                <div class="col-md-12">
                                                                    <select id="FilterClient" name="Client" data-placeholder="All Clients"
                                                                            class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in ViewBag.ClientList)
                                                                        {
                                                                            if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 desp-label">Status</label>
                                                                <div class="col-md-12">
                                                                    <select id="FilterStatus" name="Status" data-placeholder="All Statuses"
                                                                            class="form-control multiselect" multiple="multiple">
                                                                        <option value="0">Draft</option>
                                                                        <option value="1">Generated</option>
                                                                        <option value="2">PO Pending</option>
                                                                        <option value="3">Approval Pending</option>
                                                                        <option value="4">Invoice Realisation Pending</option>
                                                                        <option value="5">Paid</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="form-group" style="position:relative;top:-15px;">
                                                                <div class="col-md-12 text-right">
                                                                    <button type="button" id="ResetFilter"
                                                                            class="mdc-button mdc-button--raised mdc-ripple-upgraded"
                                                                            style="margin-top:30px;margin-left:5px;">
                                                                        <font style="font-size:12px;">Reset Filter</font>
                                                                    </button>
                                                                    <button type="submit"
                                                                            class="mdc-button mdc-button--raised mdc-ripple-upgraded"
                                                                            style="margin-top:30px;">
                                                                        <font style="font-size:12px;">Apply Filter</font>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- ══ Expected Date Modal ══ -->
                            <div class="modal fade" id="expectedDateModal" tabindex="-1" role="dialog" aria-labelledby="expectedDateModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-sm" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar"><span class="fa fa-calendar"></span></div>
                                            <h5 class="modal-title pull-left" id="expectedDateModalLabel">Set Expected Date</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <div class="modal-body" style="padding:20px 24px;">
                                            <div class="form-group">
                                                <label class="control-label desp-label" style="font-size:12px;font-weight:600;">Expected Payment Date</label>
                                                <input type="date" id="expectedDateInput" class="form-control" style="margin-top:6px;" />
                                            </div>
                                            <p id="expectedDateError" class="text-danger" style="font-size:12px;display:none;margin-top:6px;"></p>
                                        </div>
                                        <div class="modal-footer" style="padding:10px 24px 16px;">
                                            <button type="button" class="mdc-button mdc-button--outlined mdc-ripple-upgraded" data-bs-dismiss="modal" style="font-size:12px;">
                                                Cancel
                                            </button>
                                            <button type="button" id="saveExpectedDateBtn" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="font-size:12px;">
                                                <span id="saveExpDateBtnLabel">Save</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ══ Tab Navigation (page-navigation, not client-side toggle) ══ -->
                            <ul class="nav inv-nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "unpaid" ? "active" : "")"
                                       href="@Url.Action("InvoiceList","Finance", new { tab = "unpaid" })">
                                        Unpaid
                                        @if (ViewBag.UnpaidCount > 0)
                                        {
                                            <span class="inv-tab-badge">@ViewBag.UnpaidCount</span>
                                        }
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "paid" ? "active" : "")"
                                       href="@Url.Action("InvoiceList","Finance", new { tab = "paid" })">
                                        Paid
                                        @if (paidLoaded && ViewBag.PaidCount > 0)
                                        {
                                            <span class="inv-tab-badge" style="background:#43a047;">@ViewBag.PaidCount</span>
                                        }
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "monthly" ? "active" : "")"
                                       href="@Url.Action("InvoiceList","Finance", new { tab = "monthly" })">
                                        Monthly
                                    </a>
                                </li>
                            </ul>

                            <!-- ══ Tab content ══ -->

                            @* ── UNPAID TAB ── *@
                            @if (activeTab == "unpaid")
                            {
                                <div id="pane-unpaid">

                                    @* ── Unpaid sub-tabs (one per status) ── *@
                                    <div class="inv-sub-tabs" id="unpaidSubTabs">
                                        <span class="sub-tab active" data-ustatus="all"
                                              data-label="All Unpaid Invoices"
                                              data-gross="@ViewBag.UnpaidTotalGross.ToString("N2")"
                                              data-count="@unpaidList.Count">
                                            All
                                            <span class="inv-sub-tab-badge">@unpaidList.Count</span>
                                        </span>
                                        <span class="sub-tab" data-ustatus="0"
                                              data-label="Draft"
                                              data-gross="@upGrossDraft.ToString("N2")"
                                              data-count="@upCountDraft">
                                            Draft
                                            <span class="inv-sub-tab-badge">@upCountDraft</span>
                                        </span>
                                        <span class="sub-tab" data-ustatus="1"
                                              data-label="Generated"
                                              data-gross="@upGrossGenerated.ToString("N2")"
                                              data-count="@upCountGenerated">
                                            Generated
                                            <span class="inv-sub-tab-badge">@upCountGenerated</span>
                                        </span>
                                        <span class="sub-tab" data-ustatus="2"
                                              data-label="PO Pending"
                                              data-gross="@upGrossPOPending.ToString("N2")"
                                              data-count="@upCountPOPending">
                                            PO Pending
                                            <span class="inv-sub-tab-badge">@upCountPOPending</span>
                                        </span>
                                        <span class="sub-tab" data-ustatus="3"
                                              data-label="Approval Pending"
                                              data-gross="@upGrossApprovalPending.ToString("N2")"
                                              data-count="@upCountApprovalPending">
                                            Approval Pending
                                            <span class="inv-sub-tab-badge">@upCountApprovalPending</span>
                                        </span>
                                        <span class="sub-tab" data-ustatus="4"
                                              data-label="Invoice Realisation Pending"
                                              data-gross="@upGrossIRP.ToString("N2")"
                                              data-count="@upCountIRP">
                                            Invoice Realisation Pending
                                            <span class="inv-sub-tab-badge">@upCountIRP</span>
                                        </span>
                                    </div>

                                    <div id="unpaid-sub-summary">
                                        <span class="inv-summary-label" id="unpaidSummaryText">
                                            All Unpaid Invoices &nbsp;|&nbsp;
                                            Total Gross: &#8377;@ViewBag.UnpaidTotalGross.ToString("N2")
                                        </span>
                                    </div>

                                    <div class="table-responsive">
                                        <table id="tblUnpaid" class="table table-striped table-bordered journey inv-tab-table" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Client</th>
                                                    <th>Period</th>
                                                    <th>Model</th>
                                                    <th>Billing Type</th>
                                                    <th>Billing Owner</th>
                                                    <th>Invoice #</th>
                                                    <th>IRN</th>
                                                    <th>Gross (&#8377;)</th>
                                                    <th class="col-status">Status</th>
                                                    <th>Owner</th>
                                                    @if (unpaidHasAnyRemark) { <th>Latest Remark</th> }
                                                    <th>UTR / Trxn</th>
                                                    <th class="col-duedate">Due Date</th>
                                                    <th class="col-expecteddate">Expected Date</th>
                                                    <th class="col-aging">Aging</th>
                                                    <th>Actions</th>
                                                    <th class="inv-status-int-col"></th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Client</th>
                                                    <th>Period</th>
                                                    <th>Model</th>
                                                    <th>Billing Type</th>
                                                    <th>Billing Owner</th>
                                                    <th>Invoice #</th>
                                                    <th>IRN</th>
                                                    <th>Gross (&#8377;)</th>
                                                    <th class="col-status">Status</th>
                                                    <th>Owner</th>
                                                    @if (unpaidHasAnyRemark) { <th>Latest Remark</th> }
                                                    <th>UTR / Trxn</th>
                                                    <th class="col-duedate">Due Date</th>
                                                    <th class="col-expecteddate">Expected Date</th>
                                                    <th class="col-aging">Aging</th>
                                                    <th>Actions</th>
                                                    <th class="inv-status-int-col"></th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @if (!unpaidList.Any())
                                                {
                                                    <tr>
                                                        <td colspan="@(unpaidHasAnyRemark ? 18 : 17)" class="text-center">No unpaid invoices found.</td>
                                                    </tr>
                                                }
                                                @{ int unpaidRow = 1; }
                                                @foreach (var item in unpaidList)
                                                {
                                                    var uDueDate = ComputeDueDate(item.InvoiceMonth, item.InvoiceYear, item.CreditPeriod);
                                                    var uAging   = ComputeAging(uDueDate);
                                                    <tr data-ustatus="@item.Status">
                                                        <td>@unpaidRow</td>
                                                        <td>@item.ClientName</td>
                                                        <td style="white-space:nowrap;">
                                                            @(item.InvoiceMonth >= 1 && item.InvoiceMonth <= 12 ? monthShort[item.InvoiceMonth] : item.InvoiceMonth.ToString()) @item.InvoiceYear
                                                        </td>
                                                        <td>@item.InvoiceModel</td>
                                                        <td>@(item.BillingType == 1 ? "Billing Owner" : item.BillingType == 2 ? "Skill Channel" : "Client")</td>
                                                        <td>@(item.BillingType == 1 ? item.BillingOwnerEmail : "Client")</td>
                                                        <td>@item.InvoiceNumber</td>
                                                        <td>@item.IRN</td>
                                                        <td class="text-right">@item.GrossAmount.ToString("N2")</td>
                                                        <td class="col-status">
                                                            @{
                                                                string uBadge = item.Status switch
                                                                {
                                                                    0 => "<span style='width:auto;' class='badge badge-secondary'>Draft</span>",
                                                                    1 => "<span style='width:auto;' class='badge badge-info'>Generated</span>",
                                                                    2 => "<span style='width:auto;' class='badge badge-warning'>PO Pending</span>",
                                                                    3 => "<span style='width:auto;' class='badge badge-primary'>Approval Pending</span>",
