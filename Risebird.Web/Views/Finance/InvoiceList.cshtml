}

<script>
    $(document).ready(function () {
        @if (activeTab == "monthly")
        {
            <text>
            // Monthly filter modal setup
            $('#Month').val('');
            $('#Year').val('');
            $('#FilterClient').val('');
            $('#FilterStatus').val('');
            if ('@filter' != '') { ApplySessionFilter(); }
            $('#ResetFilter').click(function () {
                window.location.href = '/Finance/ResetInvoiceList';
            });
            applyMonthlyDataTable();
            </text>
        }
        else if (activeTab == "unpaid")
        {
            <text>
            applyUnpaidDataTable();
            </text>
        }
        else if (activeTab == "paid")
        {
            <text>
            applyPaidDataTable();
            </text>
        }
    });

    function ApplySessionFilter() {
        $('#Month').val('@Month');
        $('#Year').val('@Year');
        $('#FilterClient').val(@Html.Raw(Json.Serialize(FilterClient)));
        $('#FilterStatus').val(@Html.Raw(Json.Serialize(FilterStatus)));
    }

    function applyMonthlyDataTable() {
        if ($.fn.DataTable.isDataTable('#tblInvoiceList')) return;
        $('#tblInvoiceList').DataTable({
            pagingType: 'full_numbers',
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
            order: [],
            responsive: true,
            language: { search: '_INPUT_', searchPlaceholder: 'Search records' },
            fnInitComplete: function () {
                $('.dataTables_filter input:eq(0)').after(refreshBtn('tblInvoiceList'));
            }
        });
    }

    // ── Unpaid sub-tab filtering ──────────────────────────────────────────────
    var _unpaidDT = null;
    var _activeUnpaidStatus = 'all';

    function applyUnpaidDataTable() {
        if ($.fn.DataTable.isDataTable('#tblUnpaid')) return;
        _unpaidDT = $('#tblUnpaid').DataTable({
            pagingType: 'full_numbers',
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
            order: [],
            responsive: true,
            language: { search: '_INPUT_', searchPlaceholder: 'Search records' },
            // Last column holds the raw status integer — hidden from display, kept searchable
            columnDefs: [{ targets: -1, visible: false, orderable: false, searchable: true }],
            fnInitComplete: function () {
                $('.dataTables_filter input:eq(0)').after(refreshBtn('tblUnpaid'));
            }
        });

        // Sub-tab click handler
        $('#unpaidSubTabs').off('click.ustab').on('click.ustab', '.sub-tab', function () {
            var $tab = $(this);
            if ($tab.hasClass('active')) return;

            $('#unpaidSubTabs .sub-tab').removeClass('active');
            $tab.addClass('active');

            _activeUnpaidStatus = $tab.attr('data-ustatus');

            // Filter by exact integer value in the hidden last column
            if (_activeUnpaidStatus === 'all') {
                _unpaidDT.column(-1).search('').draw();
            } else {
                _unpaidDT.column(-1).search('^' + _activeUnpaidStatus + '$', true, false).draw();
            }

            var label = $tab.attr('data-label') || 'Unpaid Invoices';
            var gross = $tab.attr('data-gross') || '0.00';
            var count = $tab.attr('data-count') || '0';
            $('#unpaidSummaryText').html(
                label + ' &nbsp;|&nbsp; Count: ' + count +
                ' &nbsp;|&nbsp; Total Gross: &#8377;' + gross
            );
        });
    }

    function applyPaidDataTable() {
        if ($.fn.DataTable.isDataTable('#tblPaid')) return;
        $('#tblPaid').DataTable({
            pagingType: 'full_numbers',
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
            order: [],
            responsive: true,
            language: { search: '_INPUT_', searchPlaceholder: 'Search records' },
            fnInitComplete: function () {
                $('.dataTables_filter input:eq(0)').after(refreshBtn('tblPaid'));
            }
        });
    }

    // ── Expected Date modal ────────────────────────────────────────────────
    var _expDateInvoiceId  = null;
    var _expDateTriggerBtn = null;

    // Populate modal when a calendar button is clicked
    $(document).on('click', '.btn-set-expdate', function () {
        _expDateInvoiceId  = $(this).data('invoice-id');
        _expDateTriggerBtn = $(this);
        var currentDate    = $(this).data('current-date') || '';
        $('#expectedDateInput').val(currentDate);
        $('#expectedDateError').hide().text('');
        $('#saveExpDateBtnLabel').text('Save');
        $('#saveExpectedDateBtn').prop('disabled', false);
    });

    // Save button handler
    $('#saveExpectedDateBtn').on('click', function () {
        var dateValue = $('#expectedDateInput').val();
        $('#expectedDateError').hide().text('');
        $('#saveExpDateBtnLabel').text('Saving…');
        $('#saveExpectedDateBtn').prop('disabled', true);

        $.ajax({
            url:  '/Finance/SaveInvoiceExpectedDate',
            type: 'POST',
            data: { invoiceId: _expDateInvoiceId, expectedDate: dateValue },
            success: function (res) {
                $('#saveExpDateBtnLabel').text('Save');
                $('#saveExpectedDateBtn').prop('disabled', false);
                if (res.success) {
                    // Update the display cell and the button's data attribute
                    var displayText = dateValue
                        ? new Date(dateValue).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
                        : 'Not set';
                    var $cell = _expDateTriggerBtn.closest('tr').find('.inv-expdate-display');
                    $cell.text(displayText);
                    if (dateValue) {
                        $cell.removeClass('not-set');
                    } else {
                        $cell.addClass('not-set');
                    }
                    _expDateTriggerBtn.data('current-date', dateValue);
                    $('#expectedDateModal').modal('hide');
                } else {
                    $('#expectedDateError').text(res.message || 'Failed to save.').show();
                }
            },
            error: function () {
                $('#saveExpDateBtnLabel').text('Save');
                $('#saveExpectedDateBtn').prop('disabled', false);
                $('#expectedDateError').text('An error occurred. Please try again.').show();
            }
        });
    });

    function refreshBtn(tableId) {
        return "<span class='ref-btn' onclick='RefreshTable(\"" + tableId + "\")'>" +
            "<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'>" +
            "<path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>";
    }

    function RefreshTable(tableId) {
        if ($.fn.DataTable.isDataTable('#' + tableId)) {
            $('#' + tableId).DataTable().destroy();
            if (tableId === 'tblUnpaid') { _unpaidDT = null; _activeUnpaidStatus = 'all'; }
        }
        setTimeout(function () {
            if (tableId === 'tblInvoiceList') applyMonthlyDataTable();
            else if (tableId === 'tblUnpaid')  applyUnpaidDataTable();
            else if (tableId === 'tblPaid')    applyPaidDataTable();
        }, 800);
    }
</script>

<script type="text/javascript">
    $(".dataloading").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top  = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth  / 2 - loader.offsetWidth  / 2, 0);
        loader.style.top  = top  + "px";
        loader.style.left = left + "px";
    }
    ShowProgress();
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
        }, 1500);
    };
</script>

@functions {
    DateTime? ComputeDueDate(int invoiceMonth, int invoiceYear, string creditPeriod)
    {
        if (invoiceMonth < 1 || invoiceMonth > 12 || invoiceYear < 1) return null;
        var lastDay = new DateTime(invoiceYear, invoiceMonth, 1).AddMonths(1).AddDays(-1);
        int days = 0;
        if (!string.IsNullOrEmpty(creditPeriod))
        {
            var digits = new string(creditPeriod.Where(c => char.IsDigit(c)).ToArray());
            int.TryParse(digits, out days);
        }
        return lastDay.AddDays(days);
    }

    string ComputeAging(DateTime? dueDate)
    {
        if (!dueDate.HasValue) return "";
        if (dueDate.Value.Date < DateTime.Today)
            return (DateTime.Today - dueDate.Value.Date).Days + " days";
        return "";
    }
}
