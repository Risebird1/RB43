@model IEnumerable<Risebird.Entities.ViewModel.KycPayoutLapseTrackingRow>
@{
    ViewData["Title"] = "Payment Lapsed";
    ViewBag.PageHeader = "Payment Lapsed";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Autocomplete/jquery-ui.min.css?v=2024" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=2024" />
<style>
    .payment-history-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    .payment-history-scroll #meeting {
        min-width: 1400px;
        white-space: nowrap;
    }

    .payment-history-scroll #meeting th,
    .payment-history-scroll #meeting td {
        white-space: nowrap;
    }

    .lapse-badge {
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
    }

    .lapse-badge-active { background-color: #f0ad4e; }
    .lapse-badge-completed { background-color: #5cb85c; }
    .lapse-badge-lapsed { background-color: #d9534f; }
</style>
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Payment Lapsed</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @Html.ActionLink("Back", "FNPayment", "Finance", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                            <span class="far fa-file-excel" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="ExportPaymentLapsed()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Export Excel</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="payment-history">
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive payment-history-scroll">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Interviewer</th>
                                                            <th>Email-Id</th>
                                                            <th>PAN</th>
                                                            <th>Name as Pan</th>
                                                            <th>Name as Bank Account</th>
                                                            <th>Month</th>
                                                            <th>Pending Amount</th>
                                                            <th>Bank Verified</th>
                                                            <th>PAN Verified</th>
                                                            <th>Reminder Count</th>
                                                            <th>Status</th>
                                                            <th>Remark</th>
                                                            <th>Added On</th>
                                                            <th>Last Reminder On</th>
                                                            <th>Lapsed On</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Interviewer</th>
                                                            <th>Email-Id</th>
                                                            <th>PAN</th>
                                                            <th>Name as Pan</th>
                                                            <th>Name as Bank Account</th>
                                                            <th>Month</th>
                                                            <th>Pending Amount</th>
                                                            <th>Bank Verified</th>
                                                            <th>PAN Verified</th>
                                                            <th>Reminder Count</th>
                                                            <th>Status</th>
                                                            <th>Remark</th>
                                                            <th>Added On</th>
                                                            <th>Last Reminder On</th>
                                                            <th>Lapsed On</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count() == 0)
                                                        {
                                                            <tr><td colspan="15" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>
                                                                <td>@item.FirstName @item.LastName</td>
                                                                <td>@item.Email</td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.PAN) ? "" : item.PAN)</td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.NameAtPan) ? "" : item.NameAtPan)</td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.NameAtBank) ? "" : item.NameAtBank)</td>
                                                                <td>@item.Month</td>
                                                                <td>@item.PendingAmount</td>
                                                                <td>@(item.IsBankVerified ? "Yes" : "No")</td>
                                                                <td>@(item.IsPanVerified ? "Yes" : "No")</td>
                                                                <td>@item.ReminderCount</td>
                                                                <td>
                                                                    @{
                                                                        var badgeClass = item.TrackingStatus == "Lapsed" ? "lapse-badge-lapsed"
                                                                            : item.TrackingStatus == "Completed" ? "lapse-badge-completed"
                                                                            : "lapse-badge-active";
                                                                    }
                                                                    <span class="lapse-badge @badgeClass">@item.TrackingStatus</span>
                                                                </td>
                                                                <td>@item.Remark</td>
                                                                <td>@item.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                                                <td>@(item.LastReminderOn.HasValue ? item.LastReminderOn.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                                                <td>@(item.LapsedOn.HasValue ? item.LapsedOn.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>
</div>

<script src="~/Newassets/js/scrollBar.js?v=2024"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>
<script type="text/javascript">
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#meeting').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    };

    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here

    function ExportPaymentLapsed() {
        window.location.href = "/Finance/ExportPaymentLapsed";
    }
</script>
