@model IEnumerable<Risebird.Entities.ViewModel.KycPayoutLapseTrackingRow>
@using Risebird.Entities.ViewModel
@{
    ViewData["Title"] = "Payment Lapsed";
    ViewBag.PageHeader = "Payment Lapsed";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string activeTab = (ViewBag.ActiveTab ?? "process").ToString();
    var lapsedList = ViewBag.LapsedList as List<LapsedInterviewPointRow> ?? new List<LapsedInterviewPointRow>();
}
<link href="~/Autocomplete/jquery-ui.min.css?v=2024" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=2024" />
<style>
    .payment-history-scroll {
        overflow-x: auto;
        overflow-y: hidden;
        width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    .payment-history-scroll #meeting {
        min-width: 1400px;
        white-space: nowrap;
    }

    .payment-history-scroll #meeting th,
    .payment-history-scroll #meeting td {
        white-space: nowrap;
    }

    .payment-history-scroll #meeting th.col-remark,
    .payment-history-scroll #meeting td.col-remark {
        white-space: normal;
        word-break: break-word;
        min-width: 220px;
        max-width: 320px;
    }

    .lapse-badge {
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
    }

    .lapse-badge-active { background-color: #f0ad4e; }
    .lapse-badge-completed { background-color: #5cb85c; }
    .lapse-badge-lapsed { background-color: #d9534f; }

    /* Tab nav */
    .pl-nav-tabs {
        border-bottom: 2px solid #dee2e6;
        margin-bottom: 16px;
    }
    .pl-nav-tabs .nav-link {
        color: #555;
        font-size: 13px;
        font-family: Roboto, sans-serif;
        font-weight: 500;
        border: none;
        border-bottom: 3px solid transparent;
        border-radius: 0;
        padding: 9px 20px;
        margin-bottom: -2px;
        text-decoration: none;
        cursor: pointer;
    }
    .pl-nav-tabs .nav-link.active {
        color: #3949ab;
        border-bottom: 3px solid #3949ab;
        background: transparent;
    }
    .pl-nav-tabs .nav-link:hover:not(.active) {
        color: #3949ab;
        border-bottom: 3px solid #c5cae9;
        background: transparent;
    }
</style>
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Payment Lapsed</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @Html.ActionLink("Back", "FNPayment", "Finance", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                            <span class="far fa-file-excel" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="ExportPaymentLapsed()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Export Excel</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <ul class="nav pl-nav-tabs" role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "lapsed" ? "active" : "")"
                                       href="@Url.Action("PaymentLapsed","Finance", new { tab = "lapsed" })">
                                        Lapsed
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "process" ? "active" : "")"
                                       href="@Url.Action("PaymentLapsed","Finance", new { tab = "process" })">
                                        Process Lapsed
                                    </a>
                                </li>
                            </ul>

                            @if (activeTab == "lapsed")
                            {
                                <div id="pane-lapsed">
                                    <form action="@Url.Action("PaymentLapsed","Finance")" method="get" id="lapsedFilterForm"
                                          style="background:#f5f7fa; border:1px solid #e0e0e0; border-radius:6px; padding:12px 16px; margin-bottom:14px;">
                                        <input type="hidden" name="tab" value="lapsed" />
                                        <div class="row" style="align-items:flex-end;">
                                            <div class="col-md-3 col-sm-6">
                                                <label class="control-label desp-label" style="font-size:12px;font-weight:600;">From Date</label>
                                                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.LapsedFromDate" />
                                            </div>
                                            <div class="col-md-3 col-sm-6">
                                                <label class="control-label desp-label" style="font-size:12px;font-weight:600;">To Date</label>
                                                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.LapsedToDate" />
                                            </div>
                                            <div class="col-md-4 col-sm-8" style="display:flex;gap:8px;">
                                                <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="font-size:12px;">
                                                    <span class="fa fa-filter"></span> Apply
                                                </button>
                                                <a href="@Url.Action("PaymentLapsed","Finance", new { tab = "lapsed" })"
                                                   class="mdc-button mdc-button--outlined mdc-ripple-upgraded" style="font-size:12px;">
                                                    Reset
                                                </a>
                                            </div>
                                        </div>
                                    </form>
                                    <div class="payment-history">
                                        <div id="tableIDLapsed">
                                            <div id="lapsed_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                                <div class="clearfix"></div>
                                                <div class="col-sm-12 nopad">
                                                    <div class="table-responsive payment-history-scroll">
                                                        <table id="lapsed" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                            <thead>
                                                                <tr>
                                                                    <th>Interviewer</th>
                                                                    <th>Email-Id</th>
                                                                    <th>PAN</th>
                                                                    <th>Name as Pan</th>
                                                                    <th>Name as Bank Account</th>
                                                                    <th>Month</th>
                                                                    <th>Lapsed Amount</th>
                                                                    <th>Bank Verified</th>
                                                                    <th>PAN Verified</th>
                                                                </tr>
                                                            </thead>
                                                            <tfoot>
                                                                <tr>
                                                                    <th>Interviewer</th>
                                                                    <th>Email-Id</th>
                                                                    <th>PAN</th>
                                                                    <th>Name as Pan</th>
                                                                    <th>Name as Bank Account</th>
                                                                    <th>Month</th>
                                                                    <th>Lapsed Amount</th>
                                                                    <th>Bank Verified</th>
                                                                    <th>PAN Verified</th>
                                                                </tr>
                                                            </tfoot>
                                                            <tbody id="tblbodyLapsed">
                                                                @if (lapsedList.Count == 0)
                                                                {
                                                                    <tr><td colspan="9" style="text-align:center">No Result found</td></tr>
                                                                }
                                                                @foreach (var item in lapsedList)
                                                                {
                                                                    <tr>
                                                                        <td>@item.FirstName @item.LastName</td>
                                                                        <td>@item.Email</td>
                                                                        <td>@(string.IsNullOrWhiteSpace(item.PAN) ? "" : item.PAN)</td>
                                                                        <td>@(string.IsNullOrWhiteSpace(item.NameAtPan) ? "" : item.NameAtPan)</td>
                                                                        <td>@(string.IsNullOrWhiteSpace(item.NameAtBank) ? "" : item.NameAtBank)</td>
                                                                        <td>@item.Month</td>
                                                                        <td>@item.LapsedAmount</td>
                                                                        <td>@(item.IsBankVerified ? "Yes" : "No")</td>
                                                                        <td>@(item.IsPanVerified ? "Yes" : "No")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (activeTab == "process")
                            {
                            <div class="payment-history">
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive payment-history-scroll">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Interviewer</th>
                                                            <th>Email-Id</th>
                                                            <th>PAN</th>
                                                            <th>Name as Pan</th>
                                                            <th>Name as Bank Account</th>
                                                            <th>Month</th>
                                                            <th>Pending Amount</th>
                                                            <th>Bank Verified</th>
                                                            <th>PAN Verified</th>
                                                            <th>Reminder Count</th>
                                                            <th>Status</th>
                                                            <th class="col-remark">Remark</th>
                                                            <th>Added On</th>
                                                            <th>Last Reminder On</th>
                                                            <th>Lapsed On</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Interviewer</th>
                                                            <th>Email-Id</th>
                                                            <th>PAN</th>
                                                            <th>Name as Pan</th>
                                                            <th>Name as Bank Account</th>
                                                            <th>Month</th>
                                                            <th>Pending Amount</th>
                                                            <th>Bank Verified</th>
                                                            <th>PAN Verified</th>
                                                            <th>Reminder Count</th>
                                                            <th>Status</th>
                                                            <th class="col-remark">Remark</th>
                                                            <th>Added On</th>
                                                            <th>Last Reminder On</th>
                                                            <th>Lapsed On</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count() == 0)
                                                        {
                                                            <tr><td colspan="15" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>
                                                                <td>@item.FirstName @item.LastName</td>
                                                                <td>@item.Email</td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.PAN) ? "" : item.PAN)</td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.NameAtPan) ? "" : item.NameAtPan)</td>
                                                                <td>@(string.IsNullOrWhiteSpace(item.NameAtBank) ? "" : item.NameAtBank)</td>
                                                                <td>@item.Month</td>
                                                                <td>@item.PendingAmount</td>
                                                                <td>@(item.IsBankVerified ? "Yes" : "No")</td>
                                                                <td>@(item.IsPanVerified ? "Yes" : "No")</td>
                                                                <td>@item.ReminderCount</td>
                                                                <td>
                                                                    @{
                                                                        var badgeClass = item.TrackingStatus == "Lapsed" ? "lapse-badge-lapsed"
                                                                            : item.TrackingStatus == "Completed" ? "lapse-badge-completed"
                                                                            : "lapse-badge-active";
                                                                    }
                                                                    <span class="lapse-badge @badgeClass">@item.TrackingStatus</span>
                                                                </td>
                                                                <td class="col-remark">@item.Remark</td>
                                                                <td>@item.CreatedOn.ToString("yyyy-MM-dd HH:mm")</td>
                                                                <td>@(item.LastReminderOn.HasValue ? item.LastReminderOn.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                                                <td>@(item.LapsedOn.HasValue ? item.LapsedOn.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            }
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>
</div>

<script src="~/Newassets/js/scrollBar.js?v=2024"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>
<script type="text/javascript">
    var activeTableId = '@(activeTab == "lapsed" ? "lapsed" : "meeting")';

    function searchResult() {
        $('#' + activeTableId).DataTable();
    }
    function RefreshSearch() {
        $('#' + activeTableId).DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#' + activeTableId).DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    };

    //// script for loader starts here
    $(".dataloading").hide();
    $("#" + activeTableId).hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#" + activeTableId).hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#" + activeTableId).show();
        }, 2000);
    };
    //// script for loader ends here

    function ExportPaymentLapsed() {
        window.location.href = "/Finance/ExportPaymentLapsed";
    }
</script>
