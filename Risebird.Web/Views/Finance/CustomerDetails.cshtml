@model IEnumerable<Risebird.Entities.ViewModel.CustomerDetailsVM>
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Customer Details";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>CustomerDetails</title>
    <link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
    <script>
        var Header = "<a id='status_1'>Customer Details</a>";
        $('#txtpageHeader').empty().html(Header);
    </script>
</head>
<body>
    <div class="main-panel" id="main-panel">
        
            @*<div class="pt30 videocon">
                <div class="col-md-12 nopad">
                    <div class="card-header bg-w clearfix">
                        <img style="visibility:hidden" src="" data-position="right" />
                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <div class="pull-left risetubeheader">
                            <h4 class="card-title"></h4>

                            <div class="mobile-view"> <h4 class="card-title risetubeid">Customer Details</h4></div>
                        </div>




                    </div>
                </div>
            </div>*@

        <div class="content client">
          
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>

                            <div>
                                <div class="dataloading">
                                    <div class="candidate-timeline">
                                        <div id="tableID" class="second">
                                            <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                                <div class="clearfix"></div>
                                                <div class="col-sm-12 nopad">
                                                    <div class="table-responsive">
                                                        <table id="meeting" class="table table-striped table-bordered dataTable" cellspacing="0" width="100%">
                                                            <thead>
                                                                <tr>
                                                                    <th class="text-left">IRF Name</th>
                                                                    <th class="text-left">Risebird Client</th>
                                                                    <th class="text-left">Location</th>
                                                                    <th>Company Type</th>

                                                                </tr>
                                                            </thead>
                                                            <tfoot>
                                                                <tr>
                                                                    <th class="text-left">IRF Name</th>
                                                                    <th class="text-left">Risebird Client</th>
                                                                    <th class="text-left">Location</th>
                                                                    <th>Company Type</th>
                                                                </tr>
                                                            </tfoot>
                                                            <tbody id="tblbodyTimeline">

                                                                @foreach (var item in Model)
                                                                {
                                                                    <tr>
                                                                        <td>@item.IRFName</td>
                                                                        <td>@item.Name</td>
                                                                        <td>@item.JobCountry</td>
                                                                        <td>@item.CompanyType</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>

                                                    </div>

                                                </div>


                                            </div>
                                        </div>


                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
        


        </div>
    
    </div>
    <script>
        function searchResult() {
            $('#meeting').DataTable();
        }
        function RefreshSearch() {
            $('#meeting').DataTable().destroy();

            setTimeout(function () {
                applyDataTable();
            }, 2000);
        }

        $(document).ready(function () {
            applyDataTable();

        });



        function applyDataTable() {
            $('#meeting').DataTable({
                "pagingType": "full_numbers",
                "lengthMenu": [
                    [10, 25, 50, -1],
                    [10, 25, 50, "All"]
                ],

                order: [],
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records",
                },
                "fnInitComplete": function () {
                    $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                    $(".dataTables_filter").keyup(function (e) {
                        if ($(this).val() != "") {
                            $("#x").show();

                        }
                        else { $("#x").show(); }
                    });
                }

            });

        }



        $(document).ready(function () {

            $("#x").click(function (e) {
                $(".dataTables_filter input").val('');
                $(this).hide();
            });

        });

    </script>

    <script type="text/javascript">
        //// script for loader starts here
        $(".dataloading").hide();
        $("#meeting").hide();
        var loader;
        function ShowProgress() {
            $(".dataloading").hide();
            $("#meeting").hide();
            loader = document.getElementsByClassName("loader")[0];
            loader.style.display = "block";
            var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
            var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
            loader.style.top = top + "px";
            loader.style.left = left + "px";
        };
        ShowProgress();

        window.onload = function () {
            setTimeout(function () {
                loader.style.display = "none";
                $(".dataloading").show();
                $("#meeting").show();
            }, 2000);
        };
        //// script for loader ends here
    </script>
</body>
</html>
