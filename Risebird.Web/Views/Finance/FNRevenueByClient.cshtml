@model IEnumerable<Risebird.Entities.ViewModel.FnRevenueVM>
@{
    ViewData["Title"] = "Revenues";
    ViewBag.PageHeader = "Revenues";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=54321" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=54321" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=54321" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Revenues</h4></div>
                </div>
                <div class="pull-right">
                    <input type="hidden" id="currentmonth" value="@ViewBag.Month" />
                    <input type="hidden" id="currentyear" value="@ViewBag.Year" />
                    <a onclick="location.href = '@Url.Action("FNRevenue", "Finance",new{year=ViewBag.Year,month=ViewBag.Month })'" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space"><span class="fa fa-chevron-left" style="color:#fff;"></span>Back To List</a>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            @if (ViewBag.BillingType == 2)
                                                            {
                                                                <th>Skill Channel</th>
                                                            }
                                                            else
                                                            {
                                                                <th>Billing Owner</th>
                                                            }
                                                            <th>Total Interviews</th>
                                                            <th>Current Status</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            @if (ViewBag.BillingType == 2)
                                                            {
                                                                <th>Skill Channel</th>
                                                            }
                                                            else
                                                            {
                                                                <th>Billing Owner</th>
                                                            }
                                                            <th>Total Interviews</th>
                                                            <th>Current Status</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count() == 0)
                                                        {
                                                            <tr><td colspan="4" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {

                                                            <tr>
                                                                @if (ViewBag.BillingType == 2)
                                                                {
                                                                    <td>@item.IRFId<input type="hidden" id="hidBillingtype_@item.id" value="@item.IRFId" /></td>
                                                                }
                                                                else
                                                                {
                                                                    <td>@item.BillingOwner<input type="hidden" id="hidBillingtype_@item.id" value="@item.BillingOwner" /></td>
                                                                }

                                                                <td>@item.TotalCount<input type="hidden" id="hidinterviewcount_@item.id" value="@item.TotalCount" /></td>
                                                                <td>@item.CurrentStatusDesc</td>
                                                                <td>
                                                                    @if (item.BillingType == 2)
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Status">
                                                                            <span onclick="DetailedView(@item.id,@ViewBag.BillingType,'@item.IRFId')" title="Status" class="mdc-fab__icon material-icons">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Status">
                                                                            <span onclick="DetailedView(@item.id,@ViewBag.BillingType,'@item.BillingOwnerid')" title="Status" class="mdc-fab__icon material-icons">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                                    <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                                    <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
</div>
<div class="rbpay">
    <div id="myModal" class="modal">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="filheader">
                        <div class="filavatar">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Detailed View ( <label id="txtClientName"></label> )</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="CloseMyModelPopup()">
                        <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                    </button>
                    <input type="hidden" id="revenue_clientid" />
                    <input type="hidden" id="revenue_detailid" />
                    <input type="hidden" id="revenue_billingtype" />
                    <div class="modal-body">
                        <div class="row">
                            <div class="form-group">
                                <label class="control-label col-md-12 col-sm-12 desp-label">
                                    Current Status
                                </label>
                                <div class="col-md-12 col-sm-12 form-control">
                                    <select id="revenue_status" style="border:none;width:100%">
                                        @foreach (var item in (SelectList)ViewBag.CurrentStatus)
                                        {
                                            @if (item.Text != null && item.Text != "")
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label">
                                        Invoice Amount
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <input type="text" id="revenue_invoice" style="width:100%" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label">
                                        PO Pending Amount
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <input type="text" id="revenue_popending" style="width:100%" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="col-md-12 text-right nopad">
                                <div>
                                    <div style="display: inline-block!important;margin-bottom:10px;">
                                        <input style="color: #fff;line-height: 13px;" type="button" onclick="SaveRevenueStatus()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Save">
                                    </div>
                                    <div style="display: inline-block !important;margin-bottom: 10px;">
                                        <input style="color: #fff;line-height: 13px;" type="button" onclick="CloseMyModelPopup()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}
<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>
<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();

    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    function DetailedView(clientid, billingtype, detailid) {
        var month = $("#currentmonth").val();
        var year = $("#currentyear").val();
        $.ajax({
            type: "POST",
            url: "/Finance/FNRevenueStatusDetails",
            data: { 'id': clientid, 'year': year, 'month': month, 'billingType': billingtype, 'Detailid': detailid },
            success: function (data) {
                $("#txtClientName").text($("#hidBillingtype_" + clientid).val());
                $("#revenue_invoice").val(data.invoiceamount);
                $("#revenue_popending").val(data.poPending);
                $("#revenue_status").val(data.currentStatus);
                $("#revenue_clientid").val(clientid);
                $("#revenue_detailid").val(detailid);
                $("#revenue_billingtype").val(billingtype);
                var model = document.getElementById("myModal");
                model.style.display = "block";
            }
        });
    }
    function CloseMyModelPopup() {
        var model = document.getElementById("myModal");
        model.style.display = "none";
    }
    function SaveRevenueStatus() {
        var month = $("#currentmonth").val();
        var year = $("#currentyear").val();
        var invoiceamount = $("#revenue_invoice").val();
        var poPending = $("#revenue_popending").val();
        var currentStatus = $("#revenue_status").val();
        var clientid = $("#revenue_clientid").val();
        var detailid = $("#revenue_detailid").val();
        var billingtype = $("#revenue_billingtype").val();
        if (currentStatus != '' && currentStatus != null) {
            $.ajax({
                type: "POST",
                url: "/Finance/SaveRevenueStatusDetails",
                data: { 'id': clientid, 'year': year, 'month': month, 'billingType': billingtype, 'Detailid': detailid, 'currentStatus': currentStatus, 'invoiceamount': invoiceamount, 'poPending': poPending },
                success: function (data) {
                    $("#txtClientName").text($("#hidBillingtype_" + clientid).val());
                    $("#revenue_invoice").val(data.invoiceamount);
                    $("#revenue_popending").val(data.poPending);
                    $("#revenue_status").val(data.currentStatus);
                    $("#revenue_clientid").val(clientid);
                    $("#revenue_detailid").val(detailid);
                    $("#revenue_billingtype").val(billingtype);
                    var model = document.getElementById("myModal");
                    model.style.display = "block";
                }
            });
            CloseMyModelPopup();
            swal.fire("Save Successfully!").then(() => {
                location.reload();
            });
        } else {
            swal.fire("Please fill the status.");
        }
    }
</script>
