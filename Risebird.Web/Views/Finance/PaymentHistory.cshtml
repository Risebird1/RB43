<script type="text/javascript">

    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    var paymentRows = @Html.Raw(JsonConvert.SerializeObject(paymentRows, new JsonSerializerSettings { StringEscapeHandling = StringEscapeHandling.EscapeHtml }));
    var paymentEmailById = {};
    for (var r = 0; r < paymentRows.length; r++) {
        paymentEmailById[paymentRows[r].id] = paymentRows[r].email;
    }

    var eyeIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16"><path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" /><path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" /></svg>';
    var retryIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16"><path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41zm-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9z"/><path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5.002 5.002 0 0 0 8 3zM3.1 9a5.002 5.002 0 0 0 7.757 2.997a.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9H3.1z"/></svg>';
    var textCol = $.fn.dataTable.render.text();

    function renderActions(data, type, row) {
        if (type !== 'display') return '';
        var html = '<button class="mdc-fab app-fab--absolute" aria-label="Detailed View">'
            + '<span onclick="DetailedView(' + row.id + ')" title="Detailed View" class="mdc-fab__icon material-icons">' + eyeIcon + '</span></button>';
        if (row.payoutStatus === 'TRANSFER_FAILED') {
            html += '<button class="mdc-fab app-fab--absolute" aria-label="Retry Payment" style="background-color:#e53935;" title="Retry Payment">'
                + '<span onclick="RetryPayment(' + row.id + ')" title="Retry Payment" class="mdc-fab__icon material-icons">' + retryIcon + '</span></button>';
        }
        return html;
    }

    function applyDataTable() {
        var table = $('#meeting').DataTable({
            data: paymentRows,
            deferRender: true,
            order: [],
            columns: [
                { data: null, defaultContent: '', visible: false, orderable: false, searchable: false },
                { data: 'name', render: textCol },
                { data: 'email', render: textCol },
                { data: 'pan', render: textCol },
                { data: 'nameAtPan', render: textCol },
                { data: 'nameAtBank', render: textCol },
                { data: 'total' },
                { data: 'paid' },
                { data: 'tds' },
                { data: 'status', render: textCol },
                { data: 'comment', render: textCol },
                { data: 'date', render: textCol },
                { data: 'transferId', render: textCol },
                { data: 'utr', render: textCol },
                { data: 'transactionDate', render: textCol },
                { data: 'cfTransferId', render: textCol },
                { data: 'payoutStatus', render: textCol },
                { data: null, orderable: false, searchable: false, render: renderActions }
            ],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
                emptyTable: "No Result found"
            },
            initComplete: HideProgress
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };




    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    // Hide the loader as soon as DataTables has bound the data (was window.onload + fixed 2s delay)
    function HideProgress() {
        loader.style.display = "none";
        $(".dataloading").show();
        $("#meeting").show();
        $('#meeting').DataTable().columns.adjust();
    }
    //// script for loader ends here
</script>
<script type="text/javascript">

    $(document).ready(function () {


        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

        //$("#HREmail").multiselect({
        //    includeSelectAllOption: true,
        //    selectedClass: 'active1',
        //    buttonWidth: '100%',
        //    maxHeight: 200
        //});
    })


    function ResetFilter() {

        window.location.href = "/Finance/ResetFinaceHistoryFilter";

    }
    function ApplySessionFilter() {

        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var hrEmail=  @Html.Raw(Json.Serialize(HREmail));
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#HREmail").val(hrEmail);
        var form = $("#form").serialize();

    }
    function ExportFNDetails() {
        window.location.href = "/Finance/ExportPaymentHistory";
    }
</script>