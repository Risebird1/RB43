@model IEnumerable<Risebird.Entities.ViewModel.RBInterviewDetails>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "RB Payment History";
    ViewBag.PageHeader = "RB Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] HREmail = new string[] { };
    // Rows are bound client-side by DataTables (deferRender) instead of rendering
    // thousands of <tr> elements server-side; values are pre-formatted to match the old display.
    var paymentRows = Model.Select(item => new
    {
        id = item.id,
        name = item.FirstName ?? "",
        email = item.InterviewerEmailid ?? "",
        pan = item.PAN ?? "",
        nameAtPan = item.NameAtPan ?? "",
        nameAtBank = item.NameAtBank ?? "",
        total = item.TotalAmount,
        paid = item.Points,
        tds = item.Status == "Advance" ? 0 : item.TotalAmount - item.Points,
        status = item.Status ?? "",
        comment = item.Comment ?? "",
        date = item.Date.ToString(),
        transferId = item.TransferId ?? "",
        utr = item.TransferUtr ?? "",
        transactionDate = item.TransactionDate.HasValue ? item.TransactionDate.Value.ToString("yyyy-MM-dd HH:mm:ss") : "",
        cfTransferId = item.CfTransferId ?? "",
        payoutStatus = item.PayoutStatus ?? ""
    });
}
@if (HttpContextAccessor.HttpContext.Session.GetString("PaymentHistoryfilters") != null)
{
    filter = JsonConvert.DeserializeObject<CandidateTimelineFilter>(HttpContextAccessor.HttpContext.Session.GetString("PaymentHistoryfilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
    HREmail = filter.HREmail != null ? filter.HREmail : new string[] { };

}
