                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Detailed View ( <label id="txtInterviewerEmailid"></label> )</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="CloseMyModelPopup()">
                        <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                    </button>
                    <div class="modal-body">
                        <div class="col-md-12">

                            <div id="divDetailedView" style="max-height:250px;overflow-y:auto"></div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function CloseMyModelPopup() {
        var model = document.getElementById("myModal");
        model.style.display = "none";
    }
    function DetailedView(interviewerid) {
        $.ajax({
            type: "POST",
            url: "/Finance/GetPaymentHistoryDetailsView",
            data: { 'id': interviewerid },
            success: function (data) {
                binddata(data.result);
                $("#txtInterviewerEmailid").text(paymentEmailById[interviewerid] || "");
                //$("#txtAmountD").text("Amount: " + data.totalAmount);
                //$("#txtPayableAmountD").text("Payable Amount: " + data.payableAmount);
                //$("#txtTdsdeductedD").text("Tds deducted: " + data.tds);
            }
        });
    }
    function RetryPayment(paymentHistoryId) {
        if (!confirm('Are you sure you want to retry the payment for this failed transaction?')) return;
        var btn = event.currentTarget;
        btn.disabled = true;
        btn.style.opacity = '0.6';
        $.ajax({
            type: "POST",
            url: "/Finance/RetryPaymentViaCashfree",
            data: { paymentHistoryId: paymentHistoryId },
            success: function (data) {
                if (data.success) {
                    alert('Payment retry initiated successfully.\nReference: ' + (data.payoutId || 'N/A'));
                    location.reload();
                } else {
                    alert('Retry failed: ' + (data.message || 'Unknown error'));
                    btn.disabled = false;
                    btn.style.opacity = '1';
                }
            },
            error: function () {
                alert('An error occurred while retrying the payment. Please try again.');
                btn.disabled = false;
                btn.style.opacity = '1';
            }
        });
    }

    function binddata(data) {
        var model = document.getElementById("myModal");
        model.style.display = "block";
        var html = '';
        html += '<table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">';
        html += '<thead>';
        html += '<tr>';
        html += '   <th>Date</th>';
        html += '   <th>Payment For</th>';
        html += '   <th>Type</th>';
        html += '   <th>Payment Status</th>';
        html += '   <th>Base Pay</th>';
        html += '   <th>Late Report Penalty</th>';
        html += '   <th>Surcharge</th>';
        html += '   <th>Variable Pay</th>';
        html += '   <th>Payment SLA</th>';
        html += '   <th>QC Amnt</th>';
        html += '   <th>Amnt</th>';
        html += '   <th>Video Duration<span class="durtime">(in mins)</span></th>';
        html += '   <th>Meeting Status</th>';
        html += '   <th>Interview Status</th>';
        html += '</tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            if (parseInt(data[i].points) == 0) {
                html += '                                        <tr style="background-color:red">';
            } else {
                html += '                                        <tr>';
            }
            html += '                               <td>' + data[i].date.toString().replace("T", " ") + '</td>';
            html += '                               <td>' + data[i].comment + '</td>';
            html += '                               <td>' + data[i].type + '</td>';
            html += '                               <td>' + data[i].status + '</td>';
            html += '                               <td>' + data[i].prePoints + '</td>';
            html += '                               <td>' + data[i].penaltyamount + '</td>';
            html += '                               <td>' + data[i].surcharge + '</td>';
            html += '                               <td>' + data[i].candidateRatingAmount + '</td>';
            html += '                               <td>' + data[i].paymentSLA + '</td>';
            html += '                               <td>' + data[i].qcPoints + '</td>';
            html += '                               <td>' + data[i].points + '</td>';

            if (data[i].videoDuration == null) {
                html += '                               <td></td>';
            }
            else {
                html += '                               <td>' + data[i].videoDuration + '</td>';
            }

            if (data[i].meetingStatusDetails == null) {
                html += '                               <td></td>';
            } else {
                html += '                               <td>' + data[i].meetingStatusDetails + '</td>';
            }
            if (data[i].interviewStatusDetails == null) {
                html += '                               <td></td>';
            } else {
                html += '                               <td>' + data[i].interviewStatusDetails + '</td>';
            }
            html += '                           </tr>';
        }

        html += '                   </tbody>';
        html += '</table>';
        $("#divDetailedView").empty().html(html);
    }
</script>

