@model IEnumerable<Risebird.Entities.ViewModel.RBInterviewDetails>
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "RB Payment History";
    ViewBag.PageHeader = "RB Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = String.Empty;
    string endDte = String.Empty;
    string[] HREmail = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("PaymentHistoryfilters") != null)
{
    filter = JsonConvert.DeserializeObject<CandidateTimelineFilter>(HttpContextAccessor.HttpContext.Session.GetString("PaymentHistoryfilters"));
    strtDte = filter.StartDate != null ? String.Format("{0:yyyy-MM-dd}", filter.StartDate) : String.Empty;
    endDte = filter.EndDate != null ? String.Format("{0:yyyy-MM-dd}", filter.EndDate) : String.Empty;
    HREmail = filter.HREmail != null ? filter.HREmail : new string[] { };

}
<link href="~/Autocomplete/jquery-ui.min.css" rel="stylesheet" />
<link href="~/Newassets/css/irf.css?v=54321" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=54321" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=54321" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> RB Payment History</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        <button id="status_2" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded" data-toggle="modal" data-target="#filterModal" style="vertical-align:top">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button>
                        @Html.ActionLink("Back to List", "FNPayment", "Finance", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                            <span class="fa fa-file-excel-o" data-toggle="tooltip" data-placement="top" title="Export Excel" onclick="ExportFNDetails()" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Export Excel</font></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("PaymentHistory","Finance")" method="post" id="form">

                                            <div class="modal-body">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label  col-md-12 col-sm-12 desp-label" for="HREmail">
                                                                Interviewer
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="HREmail" name="HREmail" class="form-control multiselect" multiple="multiple">
                                                                    @foreach (var item in Model.Select(x => x.InterviewerEmailid).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>
                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                            </div>

                            <div class="payment-history">

                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">

                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class=" table-responsive-sm">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Interviewer</th>
                                                            <th>Email-Id</th>
                                                            <th>Total Amount</th>
                                                            <th>Paid Amount</th>
                                                            <th>TDS deduction</th>
                                                            <th>Payment Status</th>
                                                            <th>Payment Date</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Interviewer</th>
                                                            <th>Email-Id</th>
                                                            <th>Total Amount</th>
                                                            <th>Paid Amount</th>
                                                            <th>TDS deduction</th>
                                                            <th>Payment Status</th>
                                                            <th>Payment Date</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count() == 0)
                                                        {
                                                            <tr><td colspan="5" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {
                                                            <tr>
                                                                <td>@item.FirstName</td>
                                                                <td>@item.InterviewerEmailid<input type="hidden" id="hidcomment_@item.id" value="@item.InterviewerEmailid" /></td>
                                                                <td>@item.TotalAmount</td>
                                                                <td>@item.Points</td>
                                                                @if (item.Status == "Advance")
                                                                {
                                                                    <td>0</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>@(item.TotalAmount - item.Points)</td>
                                                                }
                                                                <td>@item.Status</td>
                                                                <td>@item.Date</td>
                                                                <td>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Detailed View">
                                                                        <span onclick="DetailedView(@item.id)" title="Detailed View" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                            </svg>
                                                                        </span>
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
    </div>
</div>
<div class="rbpay">
    <div id="myModal" class="modal">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="filheader">
                        <div class="filavatar">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg>

                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Detailed View ( <label id="txtInterviewerEmailid"></label> )</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="CloseMyModelPopup()">
                        <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                    </button>
                    <div class="modal-body">
                        <div class="col-md-12">

                            <div id="divDetailedView" style="max-height:250px;overflow-y:auto"></div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function CloseMyModelPopup() {
        var model = document.getElementById("myModal");
        model.style.display = "none";
    }
    function DetailedView(interviewerid) {
        $.ajax({
            type: "POST",
            url: "/Finance/GetPaymentHistoryDetailsView",
            data: { 'id': interviewerid },
            success: function (data) {
                binddata(data.result);
                $("#txtInterviewerEmailid").text($("#hidcomment_" + interviewerid).val());
                //$("#txtAmountD").text("Amount: " + data.totalAmount);
                //$("#txtPayableAmountD").text("Payable Amount: " + data.payableAmount);
                //$("#txtTdsdeductedD").text("Tds deducted: " + data.tds);
            }
        });
    }
    function binddata(data) {
        var model = document.getElementById("myModal");
        model.style.display = "block";
        var html = '';
        html += '<table id="meeting" class="table table-striped table-bordered" cellspacing="0" width="100%">';
        html += '<thead>';
        html += '<tr>';
        html += '   <th>Date</th>';
        html += '   <th>Payment For</th>';
        html += '   <th>Type</th>';
        html += '   <th>Payment Status</th>';
        html += '   <th>Amnt</th>';
        html += '   <th>Video Duration<span class="durtime">(in mins)</span></th>';
        html += '   <th>Meeting Status</th>';
        html += '   <th>Interview Status</th>';
        html += '</tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            if (parseInt(data[i].points) == 0) {
                html += '                                        <tr style="background-color:red">';
            } else {
                html += '                                        <tr>';
            }
            html += '                               <td>' + data[i].date.toString().replace("T", " ") + '</td>';
            html += '                               <td>' + data[i].comment + '</td>';
            html += '                               <td>' + data[i].type + '</td>';
            html += '                               <td>' + data[i].status + '</td>';
            html += '                               <td>' + data[i].points + '</td>';

            if (data[i].videoDuration == null) {
                html += '                               <td></td>';
            }
            else {
                html += '                               <td>' + data[i].videoDuration + '</td>';
            }

            if (data[i].meetingStatusDetails == null) {
                html += '                               <td></td>';
            } else {
                html += '                               <td>' + data[i].meetingStatusDetails + '</td>';
            }
            if (data[i].interviewStatusDetails == null) {
                html += '                               <td></td>';
            } else {
                html += '                               <td>' + data[i].interviewStatusDetails + '</td>';
            }
            html += '                           </tr>';
        }

        html += '                   </tbody>';
        html += '</table>';
        $("#divDetailedView").empty().html(html);
    }
</script>

<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>

<script type="text/javascript">

    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        var table = $('#meeting').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };




    //// script for loader starts here
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
<script type="text/javascript">

    $(document).ready(function () {


        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

        $("#HREmail").multiselect({
            includeSelectAllOption: true,
            selectedClass: 'active1',
            buttonWidth: '100%',
            maxHeight: 200
        });
    })


    function ResetFilter() {

        window.location.href = "/Finance/ResetFinaceHistoryFilter";

    }
    function ApplySessionFilter() {

        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var hrEmail=  @Html.Raw(Json.Serialize(HREmail));
        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#HREmail").val(hrEmail);
        var form = $("#form").serialize();

    }
    function ExportFNDetails() {
        window.location.href = "/Finance/ExportPaymentHistory";
    }
</script>