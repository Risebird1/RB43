@model IEnumerable<Risebird.Entities.ViewModel.FnRevenueVM>
@{
    ViewData["Title"] = "Revenue";
    ViewBag.PageHeader = "Revenue";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/irf.css?v=54321" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=54321" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=54321" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Revenue</h4></div>
                    <div>
                        <label id="txtAmount" style="padding:0 0 0 0">Total Revenue: @ViewBag.TotalRevenue </label> |
                        <label id="txtTdsdeducted" style="padding:0 0 0 0">Total Pending PO Amount: @ViewBag.PendingPOAmount</label> |
                        <label id="txtPayableAmount" style="padding:0 0 0 0">Total Invoice Raised Amount: @ViewBag.InvoiceAmount</label>
                    </div>
                </div>
                <input type="hidden" value="@ViewBag.RevenueMonth" id="hiddrevenuemonth" />
                <div class="pull-right client-ms">
                    <select id="ddlmonth" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onchange="Changemonth()">
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                    <select id="TdsSelectYear" name="TdsSelectYear" class="mdc-button mdc-button--raised mdc-ripple-upgraded" onchange="Changemonth()">
                        @foreach (var item in (List<SelectListItem>)(ViewBag.RevenueYears))
                        {
                            @if (item != null)
                            {
                                @if (item.Selected)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        }
                    </select>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded">
                        <span class="far fa-file-excel" data-toggle="tooltip" data-placement="top" onclick="ExportRevenueDetails()" data-original-title="Tooltip on top">
                            <font style="font-family: Roboto, sans-serif;font-size: 12px;padding-left: 3px;"> Export Excel</font>
                        </span>
                    </button>
                    <div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="content client candidate">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div>
                                <div id="tableID">
                                    <div id="meeting_wrapper" class="dataTables_wrapper dt-bootstrap4">
                                        <div class="clearfix"></div>
                                        <div class="col-sm-12 nopad">
                                            <div class="table-responsive">
                                                <table id="meeting" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Total Interviews</th>
                                                            <th>Per Interview Rate</th>
                                                            <th>Amount</th>
                                                            <th>GST</th>
                                                            <th>GST Amount</th>
                                                            <th>System Invoice Amount</th>
                                                            <th>PO Pending Amount</th>
                                                            <th>Invoice Amount</th>
                                                            <th>Invoice Submitted</th>
                                                            <th>Invoice Submission</th>
                                                            <th>Invoice Due Date</th>
                                                            <th>Payment Status</th>
                                                            <th>Payment Date</th>
                                                            <th>TDS</th>
                                                            <th>Pending</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Total Interviews</th>
                                                            <th>Per Interview Rate</th>
                                                            <th>Amount</th>
                                                            <th>GST</th>
                                                            <th>GST Amount</th>
                                                            <th>System Invoice Amount</th>
                                                            <th>PO Pending Amount</th>
                                                            <th>Invoice Amount</th>
                                                            <th>Invoice Submitted</th>
                                                            <th>Invoice Submission</th>
                                                            <th>Invoice Due Date</th>
                                                            <th>Payment Status</th>
                                                            <th>Payment Date</th>
                                                            <th>TDS</th>
                                                            <th>Pending</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody id="tblbodyPayment">
                                                        @if (Model.Count() == 0)
                                                        {
                                                            <tr><td colspan="4" style="text-align:center">No Result found</td></tr>
                                                        }
                                                        @foreach (var item in Model)
                                                        {

                                                            <tr>
                                                                <td>@item.Name<input type="hidden" id="hidclient_@item.id" value="@item.Name" /></td>
                                                                <td>@item.TotalCount<input type="hidden" id="hidinterviewcount_@item.id" value="@item.TotalCount" /></td>
                                                                <td>@item.PerInterviewRate<input type="hidden" id="hidrate_@item.id" value="@item.PerInterviewRate" /></td>
                                                                <td>@(item.TotalCount * item.PerInterviewRate)</td>
                                                                <td>@item.GST</td>
                                                                <td>@item.GSTAmount</td>
                                                                <td>@item.SystemInvoiceAmount</td>
                                                                <td>@item.POPendingAmount</td>
                                                                <td>@item.InvoiceAmount</td>
                                                                @if (item.invoiceSubmitted)
                                                                {
                                                                    <td>Yes</td>
                                                                    <td>@item.invoiceSubmission</td>
                                                                    <td>@(item.invoiceSubmission?.AddMonths(item.PaymentTerm))</td>
                                                                }
                                                                else
                                                                {
                                                                    <td>No</td>
                                                                    <td></td>
                                                                    <td></td>
                                                                }
                                                                <td>@item.PaymentStatus</td>
                                                                @if (item.PaymentStatus == "Received")
                                                                {
                                                                    <td>@item.invoiceDate</td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                                <td>@item.TDSAmount</td>
                                                                <td>0</td>
                                                                <td>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Download Completed Interview List">
                                                                        <span title="Download Completed Interview List" onclick="CompletedInterviewsExcel(@item.id)" class="mdc-fab__icon material-icons">
                                                                            <i class="far fa-file-excel excel-file card-title-space" data-toggle="tooltip" data-placement="bottom" style="font-size: 16px !important;color: white;" title="Download Completed Interview List" data-original-title="Tooltip on bottom"></i>
                                                                        </span>
                                                                    </button>
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Detailed View">
                                                                        <span onclick="Details(@item.id)" title="Detailed View" class="mdc-fab__icon material-icons">
                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                                                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                                                            </svg>
                                                                        </span>
                                                                    </button>
                                                                    @if (item.BillingType == 3)
                                                                    {
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Status">
                                                                            <span onclick="DetailedView(@item.id,@item.BillingType)" title="Status" class="mdc-fab__icon material-icons">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-receipt" viewBox="0 0 16 16">
                                                                                    <path d="M1.92.506a.5.5 0 0 1 .434.14L3 1.293l.646-.647a.5.5 0 0 1 .708 0L5 1.293l.646-.647a.5.5 0 0 1 .708 0L7 1.293l.646-.647a.5.5 0 0 1 .708 0L9 1.293l.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .801.13l.5 1A.5.5 0 0 1 15 2v12a.5.5 0 0 1-.053.224l-.5 1a.5.5 0 0 1-.8.13L13 14.707l-.646.647a.5.5 0 0 1-.708 0L11 14.707l-.646.647a.5.5 0 0 1-.708 0L9 14.707l-.646.647a.5.5 0 0 1-.708 0L7 14.707l-.646.647a.5.5 0 0 1-.708 0L5 14.707l-.646.647a.5.5 0 0 1-.708 0L3 14.707l-.646.647a.5.5 0 0 1-.801-.13l-.5-1A.5.5 0 0 1 1 14V2a.5.5 0 0 1 .053-.224l.5-1a.5.5 0 0 1 .367-.27zm.217 1.338L2 2.118v11.764l.137.274.51-.51a.5.5 0 0 1 .707 0l.646.647.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.509.509.137-.274V2.118l-.137-.274-.51.51a.5.5 0 0 1-.707 0L12 1.707l-.646.647a.5.5 0 0 1-.708 0L10 1.707l-.646.647a.5.5 0 0 1-.708 0L8 1.707l-.646.647a.5.5 0 0 1-.708 0L6 1.707l-.646.647a.5.5 0 0 1-.708 0L4 1.707l-.646.647a.5.5 0 0 1-.708 0l-.509-.51z" />
                                                                                    <path d="M3 4.5a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5zm8-6a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>

            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>
</div>
<div class="rbpay">
    <div id="myModal" class="modal">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="filheader">
                        <div class="filavatar">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="rgb(255,255,255)" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" /></svg>
                            </span>
                        </div>
                        <h5 class="modal-title pull-left"> Detailed View ( <label id="txtClientName"></label> )</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="CloseMyModelPopup()">
                        <span aria-hidden="true" id="importPopUp" style="cursor:pointer;">&times;</span>
                    </button>
                    <input type="hidden" id="revenue_clientid" />
                    <input type="hidden" id="revenue_billingtype" />
                    <div class="modal-body">
                        <div class="row">
                            <div class="form-group">
                                <label class="control-label col-md-12 col-sm-12 desp-label">
                                    Current Status
                                </label>
                                <div class="col-md-12 col-sm-12 form-control">
                                    <input type="radio" value="1" name="revenue_status" onchange="ChangeAmount(1);" id="revenue_txtinvoice" /> Invoice Raised
                                    <input type="radio" value="2" name="revenue_status" onchange="ChangeAmount(2);" id="revenue_txtPo" /> PO Pending
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-sm-12 border-rv">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label">
                                        Amount
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <input type="text" id="revenue_invoice" style="width:100%;display:none" />
                                        <input type="text" id="revenue_popending" style="width:100%;display:none" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-sm-12 border-rv">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label">
                                        Invoice Submited to client
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <select id="revenue_invoicesubmit" style="border:none;width:100%">
                                            @foreach (var item in (SelectList)ViewBag.SubmitionStatus)
                                            {
                                                @if (item.Text != null && item.Text != "")
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 col-sm-12 border-rv">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label">
                                        Invoice realized
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <select id="revenue_invoicerealization" style="border:none;width:100%">
                                            @foreach (var item in (SelectList)ViewBag.RelizationStatus)
                                            {
                                                @if (item.Text != null && item.Text != "")
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <div class="col-md-12 text-right nopad">
                                <div>
                                    <div style="display: inline-block!important;margin-bottom:10px;">
                                        <input style="color: #fff;line-height: 13px;" type="button" onclick="SaveRevenueStatus()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Save">
                                    </div>
                                    <div style="display: inline-block !important;margin-bottom: 10px;">
                                        <input style="color: #fff;line-height: 13px;" type="button" onclick="CloseMyModelPopup()" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }
        }
    </script>
}

<script src="~/Newassets/js/scrollBar.js"></script>
<script type="text/javascript">
    $(".sb-container").scrollBox();
</script>

<script>
    $(document).ready(function () {
        var month = $("#hiddrevenuemonth").val();
        $("#ddlmonth").val(month);
    });

    function ExportRevenueDetails() {
        var month = $("#ddlmonth").val();
        var year = $("#TdsSelectYear").val();
        window.location.href = "/Finance/ExportGenerateFNRevenue?year=" + year + "&month=" + month;
    }
    function Changemonth() {
        var month = $("#ddlmonth").val();
        var year = $("#TdsSelectYear").val();
        window.location.href = "/Finance/FNRevenue?year=" + year + "&month=" + month;
    }
</script>

<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();

    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [[1, 'desc']],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    function Details(clientid) {
        var month = $("#ddlmonth").val();
        var year = $("#TdsSelectYear").val();
        window.location.href = "/Finance/FNRevenueByClient?id=" + clientid + "&year=" + year + "&month=" + month;
    }
    function CompletedInterviewsExcel(clientid) {
        var month = $("#ddlmonth").val();
        var year = $("#TdsSelectYear").val();
        window.location.href = "/Finance/CompletedInterviewExcelById?id=" + clientid + "&year=" + year + "&month=" + month;
    }
</script>
<script>
    function DetailedView(clientid, billingtype) {
        var month = $("#ddlmonth").val();
        var year = $("#TdsSelectYear").val();
        $.ajax({
            type: "POST",
            url: "/Finance/FNRevenueStatusDetails",
            data: { 'id': clientid, 'year': year, 'month': month, 'billingType': billingtype, 'Detailid': 0 },
            success: function (data) {
                $("#txtClientName").text($("#hidclient_" + clientid).val());
                $("#revenue_invoice").val(data.invoiceamount);
                $("#revenue_popending").val(data.poPending);
                $("#revenue_invoicerealization").val(data.invoicerealization);
                $("#revenue_clientid").val(clientid);
                $("#revenue_billingtype").val(billingtype);
                $("#revenue_invoicesubmit").val(data.invoiceSubmitted);
                var model = document.getElementById("myModal");
                model.style.display = "block";
                if (data.currentStatus == "2") {
                    document.getElementById("revenue_txtPo").checked = true;
                    document.getElementById("revenue_popending").style.display = "block";
                    document.getElementById("revenue_invoice").style.display = "none";
                } else {
                    document.getElementById("revenue_txtinvoice").checked = true;
                    document.getElementById("revenue_invoice").style.display = "block";
                    document.getElementById("revenue_popending").style.display = "none";
                }
            }
        });
    }
    function CloseMyModelPopup() {
        var model = document.getElementById("myModal");
        model.style.display = "none";
    }
    function SaveRevenueStatus() {
        var month = $("#ddlmonth").val();
        var year = $("#TdsSelectYear").val();
        var invoiceamount = $("#revenue_invoice").val();
        var poPending = $("#revenue_popending").val();
        var invoicerealization = $("#revenue_invoicerealization").val();
        var invoicesubmit = $("#revenue_invoicesubmit").val();
        if (document.getElementById("revenue_txtinvoice").checked) {
            var currentStatus = 1;
        } else if (document.getElementById("revenue_txtPo").checked) {
            var currentStatus = 2;
        }
        var clientid = $("#revenue_clientid").val();
        var billingtype = $("#revenue_billingtype").val();
        if (currentStatus != '' && currentStatus != null) {
            $.ajax({
                type: "POST",
                url: "/Finance/SaveRevenueStatusDetails",
                data: { 'id': clientid, 'year': year, 'month': month, 'billingType': billingtype, 'Detailid': 0, 'currentStatus': currentStatus, 'invoiceamount': invoiceamount, 'poPending': poPending, 'invoicerealization': invoicerealization, 'invoicesubmit': invoicesubmit },
                success: function (data) {
                    CloseMyModelPopup();
                    swal.fire("Save Successfully!").then(() => {
                        location.reload();
                    });
                }
            });

        } else {
            swal.fire("Please fill the status.");
        }
    }
    function ChangeAmount(index) {
        if (index == 1) {
            document.getElementById("revenue_txtinvoice").checked = true;
            document.getElementById("revenue_invoice").style.display = "block";
            document.getElementById("revenue_popending").style.display = "none";
        } else {
            document.getElementById("revenue_txtPo").checked = true;
            document.getElementById("revenue_popending").style.display = "block";
            document.getElementById("revenue_invoice").style.display = "none";
        }
    }
</script>