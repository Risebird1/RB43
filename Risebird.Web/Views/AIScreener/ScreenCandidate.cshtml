 <script>
        document.addEventListener("DOMContentLoaded", () => {
            const paragraphs = document.querySelectorAll("p");
            paragraphs.forEach(paragraph => {
                let html = paragraph.innerHTML;
                // Adjusted regex to match two <br> tags followed by any text
                html = html.replace(/(<br>\s*<br>\s*)(.*?)(?=<br>|$)/g, '<span class="highlight-text">$2</span>');
               

                 html = html.replace(/<br>\s*(\S)/g, '<br><span class="black-text">$1</span>')

                     html = html.replace(/\b\d+\b/g, '<span class="black-text">$&</span>');
                   
                paragraph.innerHTML = html;
                
            });
        });
    </script>
   <script>
        document.addEventListener("DOMContentLoaded", () => {
            const spans = document.querySelectorAll("span.highlight-text");

            spans.forEach(span => {
                // Get the text content of the span
                let textContent = span.innerHTML;

                // Check if the span starts with '###'
                if (textContent.startsWith('###')) {
                   
                    // Replace the class of the span
                    span.classList.remove('highlight-text');
                    span.classList.add('heading-text');
                    
                }
                
            });
            document.querySelectorAll('.heading-text').forEach(element => {
    element.textContent = element.textContent.replace(/###/g, '');
});
        });

    </script>


