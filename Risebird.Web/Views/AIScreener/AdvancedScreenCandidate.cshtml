@model Risebird.Entities.ViewModel.AdvancedScreening.CandidateAdvancedScreeningVM
@using Risebird.Entities.ViewModel.AdvancedScreening
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Screening report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    AdvancedScreeningResult result = null;
    VerifiedFacts facts = null;
    try { result = string.IsNullOrWhiteSpace(Model.ResponseJson) ? null : JsonConvert.DeserializeObject<AdvancedScreeningResult>(Model.ResponseJson); } catch { }
    try { facts = string.IsNullOrWhiteSpace(Model.FactsJson) ? null : JsonConvert.DeserializeObject<VerifiedFacts>(Model.FactsJson); } catch { }

    var computed = result?.Computed;
    var pct = computed?.OverallPercentage ?? Model.OverallPercentage ?? 0m;
    var total = computed?.TotalScore ?? Model.TotalScore ?? 0m;
    var verdict = computed?.Verdict ?? Model.Verdict;
    var rating = computed?.AuthenticityRating ?? Model.AuthenticityRating;
    var inProgress = Model.Status == AdvancedScreeningStatus.Pending || Model.Status == AdvancedScreeningStatus.Processing;
    var scoresByKey = (result?.Criteria ?? new List<CriterionScore>())
        .GroupBy(c => c.Key, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);
    var circumference = 2 * Math.PI * 62;
    var dash = circumference * (double)Math.Min(100m, Math.Max(0m, pct)) / 100.0;

    string Band(decimal p) => p >= 80 ? "b80" : p >= 60 ? "b60" : p >= 40 ? "b40" : p >= 20 ? "b20" : "b0";
    string RatingClass(string r) => r == AuthenticityRatings.HighRisk ? "high" : r == AuthenticityRatings.Review ? "review" : "clean";
}
<script>
    var Header = "Screening report";
    $('#txtpageHeader').empty().text(Header);
</script>

@await Html.PartialAsync("_AdvancedScreeningStyles")

<div class="main-panel" id="main-panel">
    <div class="content client candidate ars-page">
        <div class="container-fluid">
            @Html.AntiForgeryToken()

            <div class="ars-card ars-card-b ars-head">
                <div>
                    <h4>@(string.IsNullOrWhiteSpace(Model.CandidateName) ? Model.CandidateEmail : Model.CandidateName)</h4>
                    <p>
                        @Model.JDTiltle · @Model.IRFName
                        @if (Model.RubricVersion.HasValue)
                        {
                            @(" · Scored on rubric v" + Model.RubricVersion + ", instructions v" + (Model.InstructionsVersion ?? 0))
                        }
                        @if (Model.ScreenedOn.HasValue)
                        {
                            @(" · " + Model.ScreenedOn.Value.ToString("dd MMM yyyy, HH:mm") + " UTC")
                        }
                    </p>
                </div>
                <div class="ars-actions">
                    @if (!string.IsNullOrWhiteSpace(Model.ResumeLink))
                    {
                        <a class="ars-btn" href="@Model.ResumeLink" target="_blank"><i class="fa fa-file-alt"></i> View resume</a>
                    }
                    <button type="button" class="ars-btn primary" id="btnRescreen" @(inProgress ? "disabled" : "")><i class="fa fa-redo"></i> Re-screen</button>
                </div>
            </div>

            @if (inProgress)
            {
                <div class="ars-alert warn"><i class="fa fa-spinner fa-spin"></i> Screening is in progress. This page refreshes itself when it is done.</div>
            }
            else if (Model.Status == AdvancedScreeningStatus.Failed)
            {
                <div class="ars-alert err"><i class="fa fa-exclamation-triangle"></i> The last screening failed (attempt @Model.AttemptCount of 3): @Model.ErrorMessage</div>
            }
            else if (Model.Status == AdvancedScreeningStatus.Skipped)
            {
                <div class="ars-alert warn"><i class="fa fa-info-circle"></i> Skipped: @Model.ErrorMessage</div>
            }
            @if (Model.IsStale && result != null)
            {
                <div class="ars-alert warn">This result was scored on an older rubric or older instructions @("(current: rubric v" + (Model.CurrentRubricVersion ?? 0) + ", instructions v" + (Model.CurrentInstructionsVersion ?? 0) + ")"). Re-screen to update it.</div>
            }

            @if (result == null)
            {
                <div class="ars-card ars-card-b ars-empty">
                    <h4>No screening result yet</h4>
                    <p class="ars-muted">
                        @(Model.IsAdvancedResumeScreening
                            ? "Use Re-screen to score this candidate against the IRF's approved rubric."
                            : "Advanced Resume Screening is switched off for this skill channel.")
                    </p>
                </div>
            }
            else
            {
                <div class="ars-report">
                    @* ------------------------------------------------ left column *@
                    <div>
                        <div class="ars-card ars-card-b" style="text-align:center;">
                            <div class="ars-donut">
                                <svg width="150" height="150" viewBox="0 0 150 150" aria-hidden="true">
                                    <circle cx="75" cy="75" r="62" fill="none" stroke="#e7edf3" stroke-width="14" />
                                    <circle cx="75" cy="75" r="62" fill="none" stroke="#0f766e" stroke-width="14" stroke-linecap="round"
                                            stroke-dasharray="@dash.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) @circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                </svg>
                                <div class="val"><b>@pct.ToString("0")%</b><span class="ars-muted">@total.ToString("0.#") / 300</span></div>
                            </div>
                            <span class="ars-score @Band(pct)" style="font-size:14px;padding:5px 14px;">@verdict</span>
                            @if (computed?.DealbreakerOverride == true)
                            {
                                <div class="ars-muted" style="margin-top:6px;">Set to Not a Fit by a failed dealbreaker.</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(result.Summary))
                            {
                                <p style="text-align:left;margin-top:12px;">@result.Summary</p>
                            }
                        </div>

                        <div class="ars-card ars-card-b">
                            <strong>Section scores</strong>
                            @foreach (var s in computed?.Sections ?? new List<SectionTotal>())
                            {
                                var sp = s.MaxScore > 0 ? s.Score * 100m / s.MaxScore : 0m;
                                <div style="display:flex;justify-content:space-between;margin-top:8px;"><span>@RubricCriteria.SectionTitle(s.Section)</span><span>@s.Score.ToString("0.#") / @s.MaxScore.ToString("0")</span></div>
                                <div class="ars-bar @(sp < 60 ? "amber" : "")"><span style="width:@sp.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                            }
                        </div>

                        <div class="ars-card ars-card-b">
                            @if (result.DealbreakersFailed?.Count > 0)
                            {
                                <strong style="color:#991b1b;">Dealbreakers failed</strong>
                                <ul class="ars-list">
                                    @foreach (var d in result.DealbreakersFailed)
                                    {
                                        <li><b>@d.Dealbreaker</b> &mdash; @d.Reason</li>
                                    }
                                </ul>
                            }
                            <strong style="color:#0f766e;">Strengths</strong>
                            <ul class="ars-list">
                                @foreach (var s in result.Strengths ?? new List<string>()) { <li>@s</li> }
                            </ul>
                            <strong style="color:#9a3412;">Concerns</strong>
                            <ul class="ars-list">
                                @foreach (var s in result.Concerns ?? new List<string>()) { <li>@s</li> }
                            </ul>
                        </div>

                        @* ---------------------------------------- authenticity *@
                        <div class="ars-card ars-card-b">
                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                <strong>Authenticity</strong>
                                <span class="ars-auth @RatingClass(rating)">@(rating ?? AuthenticityRatings.Clean)</span>
                            </div>
                            <p class="ars-muted" style="margin:6px 0 10px;">Separate from the score: it never changes the Fit Score and never rejects anyone. Use the probe questions in the interview.</p>
                            @foreach (var f in result.Authenticity?.Flags ?? new List<AuthenticityFlag>())
                            {
                                <div class="ars-flag">
                                    <span class="ars-sev @f.Severity">@f.Severity</span> <b>@f.Check</b>
                                    <span class="ars-muted" style="float:right;font-size:11px;">@(f.Source ?? "Resume")</span>
                                    <div style="margin-top:4px;">@f.Evidence</div>
                                </div>
                            }
                            @if (facts != null)
                            {
                                <table class="ars-facts" style="margin-top:6px;">
                                    @if (facts.Stability != null)
                                    {
                                        <tr><td class="ars-muted">Average tenure</td><td>@facts.Stability.AvgTenureMonths months</td></tr>
                                        <tr><td class="ars-muted">Jobs in last 3 / 5 years</td><td>@facts.Stability.JobsLast3Years / @facts.Stability.JobsLast5Years</td></tr>
                                        <tr><td class="ars-muted">Shortest stint</td><td>@facts.Stability.ShortestStintMonths months</td></tr>
                                        <tr><td class="ars-muted">Longest gap</td><td>@facts.Stability.MaxGapMonths months</td></tr>
                                        <tr><td class="ars-muted">Overlapping full-time roles</td><td>@facts.Stability.OverlappingFullTimeRoles</td></tr>
                                        @if (facts.Stability.CurrentTenureMonths.HasValue)
                                        {
                                            <tr><td class="ars-muted">Current tenure</td><td>@facts.Stability.CurrentTenureMonths months</td></tr>
                                        }
                                    }
                                    @if (facts.Duplicates != null && facts.Duplicates.MaxProjectSimilarity > 0)
                                    {
                                        <tr><td class="ars-muted">Closest match in other resumes</td><td>@facts.Duplicates.MaxProjectSimilarity.ToString("P0") (@facts.Duplicates.MatchingResumes at 80%+)</td></tr>
                                    }
                                    @if (facts.JdOverlap.HasValue)
                                    {
                                        <tr><td class="ars-muted">Text shared with the JD</td><td>@facts.JdOverlap.Value.ToString("P0")</td></tr>
                                    }
                                </table>
                                @if (facts.Companies?.Count > 0)
                                {
                                    <div style="margin-top:8px;"><b>Employers</b></div>
                                    <ul class="ars-list">
                                        @foreach (var co in facts.Companies)
                                        {
                                            <li>@co.Name &mdash; @(co.Blocklisted ? "on the internal blocklist" : co.Found == true ? co.Status + (string.IsNullOrWhiteSpace(co.Incorporated) ? "" : ", incorporated " + co.Incorporated) : co.Found == false ? "not found in the registry" : "not verified")</li>
                                        }
                                    </ul>
                                }
                                @foreach (var issue in facts.DateIssues ?? new List<string>())
                                {
                                    <div class="ars-muted">&bull; @issue</div>
                                }
                                @foreach (var v in facts.PreviousVersions ?? new List<PreviousVersionFact>())
                                {
                                    foreach (var d in v.Differences)
                                    {
                                        <div class="ars-muted">&bull; @("Earlier application" + (v.IrfId.HasValue ? " (IRF " + v.IrfId + ")" : "") + ": " + d)</div>
                                    }
                                }
                                @if (facts.NotVerified?.Count > 0)
                                {
                                    <div class="ars-muted" style="margin-top:6px;font-size:11.5px;">Not verified: @string.Join("; ", facts.NotVerified)</div>
                                }
                            }
                        </div>

                        @if (result.ProbeQuestions?.Count > 0)
                        {
                            <div class="ars-card ars-card-b">
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <strong>Interview probe questions</strong>
                                    <button type="button" class="ars-btn" id="btnCopyProbes" style="padding:4px 10px;">Copy to interviewer notes</button>
                                </div>
                                <ol class="ars-list" id="probeList">
                                    @foreach (var q in result.ProbeQuestions) { <li>@q</li> }
                                </ol>
                            </div>
                        }
                    </div>

                    @* ----------------------------------------------- right column *@
                    <div>
                        @foreach (var sec in RubricCriteria.Sections)
                        {
                            var st = computed?.Sections?.FirstOrDefault(s => s.Section == sec);
                            var rows = RubricCriteria.All.Where(d => d.Section == sec && scoresByKey.ContainsKey(d.Key)).ToList();
                            if (rows.Count == 0) { continue; }
                            <div class="ars-card">
                                <div class="ars-card-b" style="display:flex;justify-content:space-between;border-bottom:1px solid #e3e8ef;padding-bottom:10px;">
                                    <strong>@RubricCriteria.SectionTitle(sec)</strong>
                                    <strong>@(st == null ? "" : st.Score.ToString("0.#") + " / " + st.MaxScore.ToString("0"))</strong>
                                </div>
                                <table class="ars-table">
                                    @foreach (var def in rows)
                                    {
                                        var s = scoresByKey[def.Key];
                                        <tr>
                                            <td style="width:230px;"><b>@def.Label</b></td>
                                            <td style="width:80px;white-space:nowrap;"><b>@s.Score.ToString("0.#") / @s.MaxScore.ToString("0")</b></td>
                                            <td style="width:90px;"><span class="ars-tag @(s.Matched ? "match" : "gap")">@(s.Matched ? "Matched" : "Gap")</span></td>
                                            <td>@s.Observation</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#btnRescreen').on('click', function () {
            if (!confirm('Screen this resume again against the current rubric and instructions?')) { return; }
            var btn = $(this).prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Queuing…');
            $.post('@Url.Action("RescreenCandidate", "AIScreener")',
                { candidateId: @Model.CandidateId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                function (res) {
                    if (res.success) { location.reload(); } else { alert(res.message); btn.prop('disabled', false).html('<i class="fa fa-redo"></i> Re-screen'); }
                }).fail(function () { alert('Re-screening could not be started.'); btn.prop('disabled', false).html('<i class="fa fa-redo"></i> Re-screen'); });
        });

        $('#btnCopyProbes').on('click', function () {
            var text = $('#probeList li').map(function (i) { return (i + 1) + '. ' + $(this).text(); }).get().join('\n');
            var done = function () { $('#btnCopyProbes').text('Copied'); setTimeout(function () { $('#btnCopyProbes').text('Copy to interviewer notes'); }, 2000); };
            if (navigator.clipboard) { navigator.clipboard.writeText(text).then(done); }
            else { var t = $('<textarea>').val(text).appendTo('body').select(); document.execCommand('copy'); t.remove(); done(); }
        });

        @if (inProgress)
        {
            <text>setTimeout(function () { location.reload(); }, 15000);</text>
        }
    });
</script>
