@model Risebird.Entities.ViewModel.AdvancedScreening.IRFScreeningRubricVM
@using Risebird.Entities.ViewModel.AdvancedScreening
@{
    ViewData["Title"] = "Screening Rubric";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var counts = ViewBag.Counts as AdvancedScreeningCounts ?? new AdvancedScreeningCounts();
    var statusClass = Model.Status == RubricStatus.Approved ? "ok" : Model.Status == RubricStatus.Failed ? "bad" : "warn";
    var statusText = Model.Status == RubricStatus.Approved ? $"Approved · v{Model.RubricVersion}"
        : Model.Status == RubricStatus.Generated ? "Generated · not approved"
        : Model.Status == RubricStatus.Failed ? "Generation failed"
        : Model.Status == RubricStatus.Generating ? "Generating…"
        : Model.HasRubric && Model.Rubric != null ? "Draft · not approved" : "Not generated";
    var instructionsLength = (Model.Instructions ?? string.Empty).Length;
}
<script>
    var Header = "SCREENING RUBRIC FOR @Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((Model.IRFName ?? string.Empty).ToUpperInvariant()))";
    $('#txtpageHeader').empty().text(Header);
</script>

@await Html.PartialAsync("_AdvancedScreeningStyles")

<div class="main-panel" id="main-panel">
    <div class="content client candidate ars-page">
        <div class="container-fluid">
            @Html.AntiForgeryToken()
            <input type="hidden" id="arsIrfId" value="@Model.IRFId" />

            <div class="ars-card ars-card-b ars-head">
                <div>
                    <h4>Screening Rubric &mdash; @Model.IRFName</h4>
                    <p>@Model.JDTiltle</p>
                </div>
                <div class="ars-actions">
                    <span class="ars-chip @statusClass">@statusText</span>
                    <a class="ars-btn" href="@Url.Action("GetCandidates", "Candidate", new { id = Model.IRFId, irfName = Model.IRFName })"><i class="fa fa-arrow-left"></i> Candidates</a>
                </div>
            </div>

            @if (TempData["AdvScreeningMessage"] != null)
            {
                <div class="ars-alert ok"><i class="fa fa-check"></i> @TempData["AdvScreeningMessage"]</div>
            }
            @if (TempData["AdvScreeningError"] != null)
            {
                <div class="ars-alert err"><i class="fa fa-exclamation-triangle"></i> @TempData["AdvScreeningError"]</div>
            }
            @if (!Model.IsAdvancedResumeScreening)
            {
                <div class="ars-alert warn">
                    <i class="fa fa-info-circle"></i>
                    Advanced Resume Screening is switched off for this skill channel. You can prepare and approve the rubric now; nobody is screened until it is switched on in
                    <a href="@Url.Action("EditIRF", "IRF", new { id = Model.IRFId })" target="_blank">Edit IRF</a>.
                </div>
            }

            @* ---------------------------------------------------- recruiter instructions *@
            <div class="ars-card ars-card-b ars-instructions">
                <div class="ars-instr-head">
                    <h5><i class="fa fa-align-left"></i> Recruiter instructions <span class="ars-new">NEW</span></h5>
                    <span class="ars-muted" id="instrMeta">
                        @if (Model.InstructionsVersion > 0)
                        {
                            @("v" + Model.InstructionsVersion + " · edited by " + Model.InstructionsUpdatedBy + " · " + Model.InstructionsUpdatedOn?.ToString("dd MMM yyyy, HH:mm") + " UTC")
                        }
                        else
                        {
                            <text>No instructions saved yet</text>
                        }
                    </span>
                </div>
                <p class="ars-muted">Plain-English rules the AI follows for <strong>every</strong> candidate in this IRF, on top of the criteria below. Use them for dealbreakers, preferences and things to ignore. They override the JD and the ideal profile where they conflict.</p>
                <div class="ars-insert">
                    <span>Insert:</span>
                    <button type="button" class="ars-pill red" data-insert="Dealbreaker: ">+ Dealbreaker</button>
                    <button type="button" class="ars-pill blue" data-insert="Must have: ">+ Must have</button>
                    <button type="button" class="ars-pill green" data-insert="Prefer: ">+ Prefer</button>
                    <button type="button" class="ars-pill grey" data-insert="Ignore: ">+ Ignore</button>
                </div>
                <textarea id="arsInstructions" class="ars-input" rows="6" maxlength="2000" placeholder="Dealbreaker: no hands-on Vue.js (2 or 3) in the last 2 years.&#10;Must have: Vue 3 Composition API used in the current or previous project, not just listed.&#10;Prefer: product companies over IT services.&#10;Ignore: certifications and college tier for this role.">@Model.Instructions</textarea>
                <div class="ars-instr-foot">
                    <div>
                        <span class="ars-muted">Apply to:</span>
                        <label><input type="checkbox" id="applyToRubric" @(Model.ApplyInstructionsToRubric ? "checked" : "") /> Rubric generation</label>
                        <label><input type="checkbox" id="applyToScoring" @(Model.ApplyInstructionsToScoring ? "checked" : "") /> Resume scoring</label>
                    </div>
                    <span class="ars-muted"><span id="instrCount">@instructionsLength</span> / 2000 characters</span>
                </div>
                <div class="ars-instr-actions">
                    <button type="button" class="ars-btn" id="btnSaveInstructions">Save instructions</button>
                    <button type="button" class="ars-btn primary" id="btnSaveAndRegenerate">Save &amp; regenerate criteria</button>
                    <div id="staleBanner" class="ars-stale" style="@(counts.StaleInstructions > 0 ? "" : "display:none;")">
                        <span id="staleText">@counts.StaleInstructions candidate(s) were scored on older instructions.</span>
                        <a href="javascript:void(0)" class="js-open-screen-all">Re-screen</a>
                    </div>
                </div>
            </div>

            @* -------------------------------------------------------------- JD text *@
            <details class="ars-card ars-card-b ars-jd" @(string.IsNullOrWhiteSpace(Model.JDText) ? "open" : "")>
                <summary><strong>Job description text</strong> <span class="ars-muted">&mdash; extracted from the JD file when the rubric is generated. Edit it if the extraction is wrong; it is saved with the rubric.</span></summary>
                <textarea id="arsJdText" class="ars-input" rows="8" form="rubricForm" name="JDText" placeholder="@(string.IsNullOrWhiteSpace(Model.JDLink) ? "This IRF has no JD file. Paste the job description here, then generate." : "Filled in automatically from the JD file on first generation.")">@Model.JDText</textarea>
                @if (!string.IsNullOrWhiteSpace(Model.JDLink))
                {
                    <a href="@Model.JDLink" target="_blank" class="ars-muted">Open the JD file</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.IdealCandidateProfile))
                {
                    <div style="margin-top:10px;"><strong>Ideal candidate profile</strong> <span class="ars-muted">(from Edit IRF)</span><div class="ars-quote">@Model.IdealCandidateProfile</div></div>
                }
            </details>

            @* ------------------------------------------------------- points summary *@
            <div class="ars-card ars-card-b ars-budget">
                <div><span class="ars-ring" id="allocatedTotal">0</span> Allocated of 300 points</div>
                <div><span class="ars-ring" id="activeCount">0</span> Criteria in use of 27</div>
                <div id="budgetHint" class="ars-muted"></div>
                <div class="ars-muted" id="sectionTotals"></div>
            </div>

            <form id="rubricForm" method="post" action="@Url.Action("SaveScreeningRubric", "AIScreener")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Approve" id="approveField" value="false" />
                <div id="rubricEditorHost">
                    @await Html.PartialAsync("_ScreeningRubricEditor", Model)
                </div>

                <div class="ars-card ars-card-b ars-foot">
                    <button type="button" class="ars-btn js-generate" id="btnRegenerate"><i class="fa fa-sync-alt"></i> Regenerate</button>
                    <div>
                        <button type="submit" class="ars-btn" id="btnSaveDraft">Save draft</button>
                        <button type="submit" class="ars-btn primary" id="btnApprove" disabled title="Approve stays disabled until the weights total exactly 300">Approve rubric</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="screenAllHost"></div>

<script>
    $(function () {
        var irfId = $('#arsIrfId').val();
        var token = function () { return $('input[name="__RequestVerificationToken"]').first().val(); };

        // ---- points summary: advisory while editing, enforced on Approve
        function recalc() {
            var total = 0, active = 0, sections = {};
            $('#rubricEditor .ars-row').each(function () {
                var w = parseInt($(this).find('.ars-weight').val(), 10) || 0;
                var s = $(this).data('section');
                total += w;
                sections[s] = (sections[s] || 0) + w;
                if (w > 0) { active++; }
                $(this).toggleClass('off', w <= 0);
            });
            $('#rubricEditor .ars-section-pts').each(function () {
                $(this).text((sections[$(this).data('section')] || 0) + ' pts');
            });
            var hasRubric = $('#rubricEditor').data('has-rubric') == 1;
            $('#allocatedTotal').text(total).toggleClass('over', total > 300).toggleClass('exact', total === 300);
            $('#activeCount').text(active);
            $('#budgetHint').text(!hasRubric ? '' : total > 300 ? 'Over budget by ' + (total - 300) + '.' : total === 300 ? 'Ready to approve.' : (300 - total) + ' points unallocated.');
            $('#sectionTotals').text(hasRubric ? 'Skills ' + (sections['Skills'] || 0) + ' · Work ' + (sections['Work'] || 0) + ' · Education ' + (sections['Education'] || 0) : '');
            $('#btnApprove').prop('disabled', !hasRubric || total !== 300);
            $('#btnSaveDraft').prop('disabled', !hasRubric);
        }
        $(document).on('input change', '#rubricEditor .ars-weight', recalc);
        recalc();

        $('#btnApprove').on('click', function () { $('#approveField').val('true'); });
        $('#btnSaveDraft').on('click', function () { $('#approveField').val('false'); });

        // ---- generation
        function generate(button) {
            var $b = $(button);
            var label = $b.html();
            $('.js-generate, #btnSaveAndRegenerate').prop('disabled', true);
            $b.html('<i class="fa fa-spinner fa-spin"></i> Generating… (10–40 s)');
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GenerateScreeningRubric", "AIScreener")',
                data: { irfId: irfId, jdText: $('#arsJdText').val(), __RequestVerificationToken: token() },
                success: function (html) {
                    if (typeof html === 'object' && html.message) { alert(html.message); return; }
                    $('#rubricEditorHost').html(html);
                    recalc();
                },
                error: function () { alert('Generation failed. Try again in a moment.'); },
                complete: function () {
                    $('.js-generate, #btnSaveAndRegenerate').prop('disabled', false);
                    $b.html(label);
                }
            });
        }
        $(document).on('click', '.js-generate', function () {
            if ($('#rubricEditor').data('has-rubric') == 1
                && !confirm('Generate a fresh rubric? It replaces the current criteria and weights, and an approved rubric has to be approved again.')) {
                return;
            }
            generate(this);
        });

        // ---- instructions
        $('#arsInstructions').on('input', function () { $('#instrCount').text($(this).val().length); });
        $('.ars-pill[data-insert]').on('click', function () {
            var ta = document.getElementById('arsInstructions');
            var text = $(this).data('insert');
            var start = ta.selectionStart, value = ta.value;
            var prefix = start > 0 && value.charAt(start - 1) !== '\n' ? '\n' : '';
            ta.value = value.slice(0, start) + prefix + text + value.slice(ta.selectionEnd);
            ta.focus();
            ta.selectionStart = ta.selectionEnd = start + prefix.length + text.length;
            $('#instrCount').text(ta.value.length);
        });

        function saveInstructions(done) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SaveScreeningInstructions", "AIScreener")',
                data: {
                    irfId: irfId,
                    instructions: $('#arsInstructions').val(),
                    applyToRubric: $('#applyToRubric').is(':checked'),
                    applyToScoring: $('#applyToScoring').is(':checked'),
                    __RequestVerificationToken: token()
                },
                success: function (res) {
                    if (!res.success) { alert(res.message || 'The instructions could not be saved.'); return; }
                    $('#instrMeta').text('v' + res.instructionsVersion + ' · edited by ' + res.editedBy + ' · ' + res.editedOn);
                    if (res.staleCount > 0) {
                        $('#staleText').text(res.staleCount + ' candidate(s) were scored on older instructions.');
                        $('#staleBanner').show();
                    } else {
                        $('#staleBanner').hide();
                    }
                    if (done) { done(); }
                },
                error: function () { alert('The instructions could not be saved.'); }
            });
        }
        $('#btnSaveInstructions').on('click', function () { saveInstructions(); });
        $('#btnSaveAndRegenerate').on('click', function () {
            var btn = this;
            saveInstructions(function () { generate(btn); });
        });

        // ---- Screen All dialog (also opened from the candidate list)
        $(document).on('click', '.js-open-screen-all', function () {
            $.get('@Url.Action("ScreenAllSummary", "AIScreener")', { irfId: irfId }, function (html) {
                if (typeof html === 'object' && html.message) { alert(html.message); return; }
                $('#screenAllHost').html(html);
            });
        });
    });
</script>
