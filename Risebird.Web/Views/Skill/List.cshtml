@model IEnumerable<Risebird.Entities.Data.Skill>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Skill";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    var Header = "<div id='adskill_1'>Skill</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<style>
    .hopscotch-arrow.down {
        transform: rotate( 1deg );
        top: 6.9rem;
        right: -.3rem;
    }
</style>
<div class="main-panel" id="main-panel">
    
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Skill</h4></div>
                </div>

                <div class="pull-right">


                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top"  onclick="location.href='@Url.Action("AddSkill","Skill")'" data-original-title="Tooltip on top"><font style="font-family: Roboto, sans-serif; font-size:12px;"> Add Skill</font></span>
                    </button>



                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <table id="skill" class="table table-striped table-bordered w-full" cellspacing="0" width="100%">
                                <thead>
                                    <tr>
                                        <th hidden></th>
                                        <th id="adskill_2">Name</th>
                                        <th id="adskill_3">Description</th>
                                        <th id="disabled-sorting" class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tfoot>
                                    <tr>
                                        <th hidden></th>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th class="disabled-sorting text-center">Actions</th>
                                    </tr>
                                </tfoot>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id=@item.id>
                                            <td hidden>@item.id</td>
                                            <td style="white-space:normal;">@item.Name</td>
                                            <td  style="white-space:normal;">@item.Description</td>
                                            <td class="text-center">
                                                    <button id="adskill_4" class="mdc-fab app-fab--absolute" aria-label="Click here to edit skill">
                                                        <span onclick="location.href = '@Url.Action("EditSkill", "Skill", new { id = item.id})'" title="Click here to edit skill" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                    </button>
                                              

                                              
                                                    <button id="adskill_5" class="mdc-fab app-fab--absolute trash-btn adskill_5" aria-label="Click here to delete skill">
                                                        <span onclick="javascript:DeleteEntityfromEnvironment('@item.id','@item.Name');" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"></path></svg></span>
                                                    </button>
                                                

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>


@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.includes("Success")) {
                swal.fire("Successful",'@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}



<script>

    function RefreshSearch() {
        $('#skill').DataTable().destroy();

        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {

        applyDataTable();

    });



    function applyDataTable() {
        $('#skill').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()' ><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }




    $(document).ready(function () {


        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });
    function DeleteEntityfromEnvironment(skillId, Name) {

        //var confirmMessageBox = confirm('Are you sure you want to delete skill ' + Name + ' ?');
        //if (confirmMessageBox) {
        //    if (skillId != '') {
        //        $.ajax({
        //            url: '/Skill/DeleteSkill',
        //            data: { 'id': skillId },
        //            type: 'get',
        //            success: function (data) {
        //                window.location = data.url;
        //            }
        //        });
        //    }
        //}

        swal.fire({
            title: 'Are you sure you want to delete skill ' + Name + '?',
            text: "It will be permanently deleted !",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/Skill/DeleteSkill',
                        data: { 'id': skillId },
                        type: 'get',
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error deleting!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Deleted!',
                    type: 'success',
                    html: '<p>Your record has been deleted.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Skill/List";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Not deleted!',
                    'error'
                )
            }
        })
    }
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#skill").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#skill").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#skill").show();
        }, 2000);
    };
    //// script for loader ends here
</script>
@if (HttpContextAccessor.HttpContext.Session.GetString("NavigationShow") == "true" && HttpContextAccessor.HttpContext.Session.GetString("profileName") == "\"HR\"")
{


    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/js/hopscotch.min.js" type="text/javascript"></script>

    <script type="text/javascript">

        hopscotch.registerHelper('addOverlay', function () {
            $('body').append('<div class="overlay"></div>');
        });

        hopscotch.registerHelper('removeOverlay', function () {
            $('.overlay').fadeOut(function () {
                $(this).remove();
                $('.helper').remove();
            });
        });

        hopscotch.listen('show', function () {
            var elementObject = $(hopscotch.getCurrTarget(tour));
            var element = $('#' + elementObject[0].id);

            element.prev().removeClass('overlay-relative');
            element.addClass('overlay-relative');

            if ($('.helper').length !== 0) {

                // Use Helper Layer for hilight target element.
                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });

            } else {

                // Add Helper Layer for highlight target element.
                var newHelper = '<div class="helper"></div>';
                $('body').append(newHelper);

                var helper = $('.helper');
                var padding = 5;
                var helperPosX = element.position().left - padding;
                var helperPosY = element.position().top - padding;
                var targetWidth = element.outerWidth();
                var targetHeight = element.outerHeight();

                console.log('PositionX : ' + helperPosX + ' PositionY : ' + helperPosY);
                console.log('TargetWidth : ' + targetWidth + ' TargetHeight : ' + targetHeight);

                helper.css('width', targetWidth);
                helper.css('height', targetHeight);
                helper.offset({ left: helperPosX, top: helperPosY });
            }

        });

        var tour = {
            id: "hello-hopscotch",
            showCloseButton: false,
            steps: [
                {
                    title: "Skill",
                    content: "View the list of skill",
                    target: "adskill_1",
                    placement: "bottom",
                    showPrevButton: true,

                    highlight: true,
                    zindex: 999999,
                    yOffset: 10,

                    onCTA: function () {
                        hopscotch.showStep(2);
                        $('#adskill_1').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onNext: function () {
                        $('#adskill_1').removeClass('overlay-relative');
                        $('.helper').remove();

                    }
                },
                {
                    title: "Name",
                    content: "Reach out to HR in case any support needed",
                    target: "adskill_2",
                    placement: "bottom",
                    showPrevButton: true,

                    zindex: 999999,
                    xOffset: 10,
                    onPrev: function () {

                        $('#adskill_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                    onNext: function () {

                        $('#adskill_2').removeClass('overlay-relative');
                        $('.helper').remove();
                    },


                },

                {
                    title: "Description",
                    content: "Showing description here",
                    target: "adskill_3",
                    placement: "left",
                    showPrevButton: true,

                    zindex: 999999,
                    xOffset: 10,
                    onPrev: function () {

                        $('#adskill_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },

                    onNext: function () {

                        $('#adskill_3').removeClass('overlay-relative');
                        $('.helper').remove();
                    },


                },



                {
                    title: "Edit",
                    content: "Click here to edit skill",
                    target: "adskill_4",
                    placement: "left",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: -10,
                    xOffset: 10,
                    onNext: function () {
                        $('#adskill_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#adskill_4').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },
                {
                    title: "Delete",
                    content: "Click here to delete skill",
                    target: "adskill_5",
                    placement: "left",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: -10,
                    xOffset: 10,
                    onNext: function () {
                        $('#adskill_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#adskill_5').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },



                {
                    title: "Support",
                    content: "Click here to see its features",
                    target: "support_menu",
                    placement: "top",
                    showPrevButton: true,
                    zindex: 999999,
                    yOffset: 30,
                    xOffset: 10,
                    onNext: function () {
                        $('#support_menu').removeClass('overlay-relative');
                        $('.helper').remove();
                    },
                    onPrev: function () {
                        $('#support_menu').removeClass('overlay-relative');
                        $('.helper').remove();
                    }
                },

            ],
            onStart: ["addOverlay"],
            onEnd: ["removeOverlay"],
        };

        hopscotch.startTour(tour);

    </script>

}