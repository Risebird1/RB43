@model Risebird.Entities.ViewModel.SkillLevelVM
@{
    ViewData["Title"] = "SkillLevelUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<ul class="breadcrumb">
    <li><a href="/Meeting/Index">Skill Level</a></li>
    <li class="active"><strong>Add</strong></li>
</ul>

@using (Html.BeginForm("Edit", "Skill", FormMethod.Post, new { enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-12 edit-build nova-cont">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h2 class="panel-title">Update Skill Level</h2>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6 col-sm-6">
                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-2 col-sm-2 desp-label" })
                                    <div class="col-md-6 col-sm-6">
                                        @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group col-sm-12">
                                    <div class="pull-right">
                                        <input type="submit" id="btnUpload" value="Update Skill Level" class="btn btn btn-primary" />
                                    </div>
                                    @*<div>
                                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-link" })
                                        </div>*@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .fa-spinner {
        font-size: 18px;
        position: relative;
        top: 6px;
        left: 4px;
    }
</style>


