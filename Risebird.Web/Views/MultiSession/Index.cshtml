
@{
    ViewData["Title"] = "Multi Session Login Alert";
    Layout = null;
}
<style>
    body, html {
        height: 100%;
    }

    .bg {
        /* The image used */
        background-image: url("https://risebirdblob.blob.core.windows.net/image/BG.jpg");
        /* Full height */
        height: 100%;
        position: relative;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .block {
        display: block;
        width: 100%;
        border: none;
        font-size: 16px;
        cursor: pointer;
        text-align: center;
        height: 40px
    }

    .imgBox {
        display: block;
        width: 200px;
        height: 150px;
        text-align: center;
        margin: 50px 20px 0px 20px
    }
</style>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Risebird Portal Multi Session Login Alert</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!--===============================================================================================-->
    <link rel="icon" type="image/png" src="~/Newassets/img/favicon.ico" />
    <link rel="stylesheet" type="text/css" href="~/css/theme-default.css">
    <!--===============================================================================================-->
</head>
<body>
    <div class="bg">
        <div class="row" style="height:20%"></div>
        <div class="row" style="height:60%;">
            <div class="col-md-2"></div>
            <div class="col-md-8" style="background-color:white;">
                <div class="col-md-3">
                    <img class="imgBox" src="https://risebirdblob.blob.core.windows.net/image/Authorized_image01.png" />
                </div>
                <div class="col-md-1">
                </div>
                <div class="col-md-9">
                    <div class="row" style="height:20%;width:100%;font-size:22px;font-weight:bold;padding:5%">
                        <span>You have logged in over multiple Device/Browser.</span>
                        <br />
                        <span>If you wish to continue, click on continue else logout.</span>
                    </div>
                    <div class="row" style="height:20%;padding:10%">
                        <div class="col-md-6">
                            <button class="block" style="background-color:lawngreen" onclick="window.location.href='@Url.Action("ContinueSession", "MultiSession" )'"><span class="fa fa-check-square-o">  CONTINUE </span></button>
                        </div>
                        <div class="col-md-6">
                            <button class="block" style="background-color:orangered;color:white" onclick="window.location.href='@Url.Action("SignOut", "Session" )'"><span class="fa fa-sign-out">  LOG OUT </span></button>
                        </div>
                    </div>
                    <div class="row" style="height:20%;padding:0% 5%;color:red">
                        <span style="font-size:14px;font-weight:bold">Note:</span>
                        <br />
                        <span style="font-size:12px;">Multiple session logins can be either due to unauthorized access or not logged out during last session. To report security incident, please contact Risebird team immediately.</span>
                    </div>
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
        <div class="row" style="height:20%"></div>
    </div>
</body>
</html>

