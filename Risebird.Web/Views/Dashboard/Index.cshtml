<script>

    $(document).ready(function () {
        function RenderMeetingsResultsBreakdownChart() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: '/Dashboard/GetMeetingResultCount',
                    method: 'Get',
                    async: 'true',
                    success: function (data) {
                        resolve(data)
                    },
                    error: function (error) {
                        reject(error)
                    }
                });
            })
        }
        
        RenderMeetingsResultsBreakdownChart()
            .then((data) => {
                document.getElementById('id_totalMeetingsCount').innerHTML = data.totalMeetingsCount;
                var meetingsCountObj = [{ y: data.proxyCount, label: "Proxy" },
                { y: data.selectedCount, label: "Selected" },
                { y: data.rejectedCount, label: "Rejected" },
                { y: data.borderLineCount, label: "Border Line" },
                { y: data.noShowCount, label: "No Show" },
                { y: data.scheduledCount, label: "Scheduled" },
                { y: data.droppedCount, label: "Dropped" }];

                var chart = new CanvasJS.Chart("meetingsCountId", {
                    theme: "light2",
                    width: 350,//in pixels
                    height: 200,//in pixels
                    animationEnabled: true,
                    title: null,
                    data: [{
                        type: "pie",
                        startAngle: 60,
                        innerRadius: 55,
                        indexLabelFontSize: 15,
                        indexLabelFontColor: "#9a9a9a",
                        indexLabel: "{label}  {y}",
                        toolTipContent: "<b>{label} </b>({y})",

                        dataPoints: meetingsCountObj
                    }]
                });
                chart.render();
      
            })
            .catch((error) => {
                
            })

        setDate();

        getInterviewSlots();

    });
</script>
