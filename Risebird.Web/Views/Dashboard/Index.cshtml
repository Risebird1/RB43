            $("#MyPopup").modal("show");

    </script>*@




<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/data.js"></script>
<script src="https://code.highcharts.com/modules/drilldown.js"></script>
<script>

   window.onload = function () {
        var pending='@ViewBag.Totinvites';
       var chart = new CanvasJS.Chart("invitesPending", {
           theme: "light2",
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: {
                text: "Invite Status",
                fontColor: "#6db8bc",
                horizontalAlign: "center",
                fontWeight: "normal"
            },
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 17,
                indexLabel: "{label}  {y}%",
                toolTipContent: "<b>{label} </b>({y}%)",
                dataPoints: @Html.Raw(ViewBag.DataPoints),
                //indexLabel: "{label}  #percent%",
                //toolTipContent: "<b>{label} </b>(#percent%)",
                //dataPoints: [
                //    { y: 80, label: "Pending", color: "#6db8bc" },
                //    { y: 20, color: "#ccc" }
                //]
            }]
        });
        chart.render();


       var chart = new CanvasJS.Chart("invitesAccepted", {
           theme: "light2",
            width: 300,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: {
                text: "686",
                fontColor: "#5184c1",
                horizontalAlign: "center",
                fontWeight: "normal"
            },
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 17,
                indexLabel: "{label}  {y}%",
                toolTipContent: "<b>{label} </b>({y}%)",
                dataPoints: @Html.Raw(ViewBag.DataPoints1),
                //indexLabel: "{label}  #percent%",
                //toolTipContent: "<b>{label} </b>(#percent%)",
                //dataPoints: [
                //    { y: 30, label: "Accepted" },
                //    { y: 70, color: "#ccc" }
                //]
            }]
        });
        chart.render();

       var chart = new CanvasJS.Chart("interviewers", {
           theme: "light2",
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 15,
                indexLabel: "{label}  {y}%",
                toolTipContent: "<b>{label} </b>({y}%)",
                dataPoints: @Html.Raw(ViewBag.DataPoints2),
                //indexLabel: "{label}  #percent%",
                //toolTipContent: "<b>{label} </b>(#percent%)",
                //dataPoints: [
                //    { y: 30, label: "Scheduled", color: "#5184c1" },
                //    { y: 70, label: "Completed" }
                //]
            }]
        });
        chart.render();

        // Create the chart
        // Create the chart
        Highcharts.chart('container', {
            chart: {
                type: 'column'
            },
            title: {
                text: null
            },
            xAxis: {
                type: 'category'
            },
            yAxis: {
                title: {
                    text: 'No. Of Interviewers'
                }

            },
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    pointWidth: 15,
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.1f}%'
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.2f}%</b> of total<br/>'
            },

            series: [
                {
                    name: "Browsers",
                    colorByPoint: true,
                    data: [
                        {
                            name: "1-3",
                            y: 62.74,
                            drilldown: "1-3",
                            color: "#5c5c61"
                        },
                        {
                            name: "4-7",
                            y: 10.57,
                            drilldown: "4-7",
                            color: "#5c5c61"
                        },
                        {
                            name: "7-10",
                            y: 70,
                            drilldown: "7-10"
                        },
                        {
                            name: "10-13",
                            y: 10,
                            drilldown: "10-13",
                            color: "#5c5c61"
                        },
                        {
                            name: "13-16",
                            y: 15,
                            drilldown: "13-16",
                            color: "#5c5c61"
                        },
                        {
                            name: "16-19",
                            y: 25,
                            drilldown: "16-19",
                            color: "#5c5c61"
                        },
                        {
                            name: "20+",
                            y: 20,
                            drilldown: "20+",
                            color: "#5c5c61"
                        }
                    ]
                }
            ]
        });

    }
</script>
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>





