@model Risebird.Entities.ViewModel.MeetingVM
@{

    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>


<script src="~/Newassets/js/enjoyhint/enjoyhint.min.js"></script>
<link href="~/Newassets/css/enjoyhint.css"  rel="stylesheet"/>
<style>
    .statistics {
        margin-bottom: 10%
    }

    .card-body label {
        text-align: center;
        margin-left: 42%;
        font-weight: 700;
        font-size: 20px;
    }

    .text {
        text-align: center;
        font-size: 17px;
        color: #878889;
        font-weight: 200;
    }

    .icon-dash {
        margin-left: 44%;
        color: #ccc;
        font-size: 60px;
    }

    .interviewers {
        left: 61%;
        position: absolute;
        top: 158px;
        width: 95%;
    }

    .vl {
        border-left: 2px solid #ccc;
        height: 200px;
    }

    #invitesPending {
        float: left;
    }

    #Completed {
        float: left;
    }

    .canvasjs-chart-credit {
        display: none;
    }

    .card-text {
        font-size: 17px;
        color: #878889;
        font-weight: 500;
    }

    .page-title {
        padding-bottom: 25px;
    }

    .container h2 {
        margin-bottom: 15px;
    }

    .card {
        margin-bottom: 20px;
    }

    img {
        position: relative;
        left: 115px;
        width: 214px;
        bottom: 24px;
    }

    .class {
        position: relative;
        bottom: 83px;
        font-family: monospace
    }

    .bttn {
        position: relative;
        left: 190px;
        bottom: 43px;
    }
</style>





<div class="main-panel" id="main-panel hello-hopscotch">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Dashboard</a>
                @*<button id="startTourBtn" class="btn btn-large btn-primary">Take a tour</button>*@

            </div>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-stats">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="statistics">
                                    <div class="info">
                                        <div class="icon icon-primary">
                                            <i class="now-ui-icons fa fa-user"></i>
                                        </div>
                                        <h3 class="info-title">@ViewBag.Totcandidate</h3>
                                        <h6 class="stats-title">Candidates</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="statistics">
                                    <div class="info">
                                        <div class="icon icon-success">
                                            <i class="now-ui-icons fa fa-video-camera"></i>
                                        </div>
                                        <h3 class="info-title">
                                            @ViewBag.TotInterviewer
                                        </h3>
                                        <h6 class="stats-title">Interviewer</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="statistics">
                                    <div class="info">
                                        <div class="icon icon-info">
                                            <i class="now-ui-icons users_single-02"></i>
                                        </div>
                                        <h3 class="info-title">@ViewBag.Totinvites</h3>
                                        <h6 class="stats-title">Interview</h6>
                                    </div>
                                </div>
                            </div>
                            @*<div class="col-md-3">
                                    <div class="statistics">
                                        <div class="info">
                                            <div class="icon icon-danger">
                                                <i class="now-ui-icons objects_support-17"></i>
                                            </div>
                                            <h3 class="info-title">353</h3>
                                            <h6 class="stats-title">Support Requests</h6>
                                        </div>
                                    </div>
                                </div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6">

                <h2>Invites</h2>
                <div class="card">
                    <div class="card-body" id="second-element-introduction">
                        <p class="card-text">Total Invites : <span style="color: black">@ViewBag.Totinvites</span></p>
                        @*<h4 class="card-title">@ViewBag.Totinvites </h4>*@
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div id="invitesPending" style="height: 200px; width: 50%;"></div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6" style="display:none">
                            <div id="invitesAccepted" style="height: 200px; width: 40%;"></div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-lg-6 col-md-6 col-sm-6">

                <h2>Interviewers</h2>
                <div class="card">
                    <div class="card-body">
                        <p class="card-text">Total Interviewers : <span style="color: black">@ViewBag.TotInterviewer</span></p>
                        @*<h4 class="card-title">@ViewBag.TotInterviewer</h4>*@
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div id="interviewers" style="height: 200px; width: 40%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="display:none">
            <div class="col-md-12">
                <h2>Skillwise Distribution of Interviews</h2>
                <div class="card">
                    <div class="card-body">
                        <div id="container"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer class="footer">
        <div class=" container-fluid ">
            <nav>
                <ul>
                    <li>
                        <a href="#">
                            Risebird
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            About Us
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            Blog
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="copyright" id="copyright">
                &copy;
                <script>
                    document.getElementById('copyright').appendChild(document.createTextNode(new Date().getFullYear()))
                </script> Risebird All Rights Reserved.
            </div>
        </div>
    </footer>
</div>



<div id="MyPopup" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <img src="~/images/risebird.png" />

            </div>
            <div class="modal-body">
                <p class="class">Tap into world's largest online interviewers community and get secure, hands-on, live, video- evaluations done in few clicks.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary bttn" onclick="closed()">
                    Start
                </button>
            </div>
        </div>
    </div>
</div>





