                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Tracking</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">
                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="interviewTrackingDate" name="interviewTrackingDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li><button onclick="updateInterviewTracking()" class="panel-fullscreen"><span class="fa fa-eye"></span></button></li>

                                </ul>
                            </div>
                            <div class="panel-body">
                                <div class="chart-holder" id="area-chart" style="height: 200px;"></div>
