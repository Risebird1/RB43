@model Risebird.Entities.ViewModel.MeetingVM
@{

    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

<ul class="breadcrumb">
    <li class="active"><strong style="margin-left:11px;">Dashboard</strong></li>
</ul>
<div class="page-title">
    <h2><span class="fa fa-tachometer"></span>Dashboard</h2>
</div>
<div class="container">
    <div class="invites">
        <h2>Invites</h2>
        <div class="card" style="width:60%">
            <div class="card-body">
                <p class="card-text">Total Invites</p>
                <h4 class="card-title">@ViewBag.Totinvites </h4>
                <div id="invitesPending" style="height: 200px; width: 54%;"></div>
                <div id="invitesAccepted" style="height: 200px; width: 20%;"></div>
            </div>
        </div>
    </div>
    <div class="interviewers">
        <h2>Interviewers</h2>
        <div class="card" style="width:40%">
            <div class="card-body">
                <p class="card-text">Total Interviewers</p>
                <h4 class="card-title">@ViewBag.TotInterviewer</h4>
                <div id="interviewers" style="height: 200px; width: 54%;"></div>
            </div>
        </div>
    </div>
    <h2>Skillwise Distribution of Interviews</h2>
    <div class="card" style="width:100%">
        <div class="card-body">
            <div id="container" style="min-width: 310px; height: 400px; margin: 0 auto"></div>
        </div>
    </div>
    <div class="statistics">
        <h2>Statistics</h2>
        <div class="card" style="float:left;width:32%;">
            <div class="card-body">
                <span class="fa fa-user icon-dash"></span>
                <p class="text">Candidates</p>
                <label>@ViewBag.Totcandidate</label>
            </div>
        </div>
        <div class="card" style="float:left;width:32%;margin-left:20px;margin-right:20px">
            <div class="card-body">
                <span class="fa fa-video-camera icon-dash"></span>
                <p class="text">Interviewer</p>
                <label>@ViewBag.Totinvites</label>
            </div>
        </div>
        <div class="card" style="width:32%;">
            <div class="card-body">
                <span class="fa fa-user icon-dash"></span>
                <p class="text">Interview</p>
                <label>@ViewBag.TotInterviewer</label>
            </div>
        </div>
    </div>



</div>

<style>
    .statistics {
        margin-bottom: 10%
    }

    .card-body label {
        text-align: center;
        margin-left: 42%;
        font-weight: 700;
        font-size: 20px;
    }

    .text {
        text-align: center;
        font-size: 17px;
        color: #878889;
        font-weight: 200;
    }

    .icon-dash {
        margin-left: 44%;
        color: #ccc;
        font-size: 60px;
    }

    .interviewers {
        left: 61%;
        position: absolute;
        top: 158px;
        width: 95%;
    }

    .vl {
        border-left: 2px solid #ccc;
        height: 200px;
    }

    #invitesPending {
        float: left;
    }

    #Completed {
        float: left;
    }

    .canvasjs-chart-credit {
        display: none;
    }

    .card-text {
        font-size: 17px;
        color: #878889;
        font-weight: 500;
    }

    .page-title {
        padding-bottom: 25px;
    }

    .container h2 {
        margin-bottom: 15px;
    }

    .card {
        margin-bottom: 20px;
    }
</style>

<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/data.js"></script>
<script src="https://code.highcharts.com/modules/drilldown.js"></script>
<script>
   
    window.onload = function () {    
        var pending='@ViewBag.Totinvites';
        var chart = new CanvasJS.Chart("invitesPending", {
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: {
                text: "1,803",
                fontColor: "#6db8bc",
                horizontalAlign: "center",
                fontWeight: "normal"
            },
            data: [{
                type: "doughnut",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 17,
                indexLabel: "{label}  #percent%",
                toolTipContent: "<b>{label} </b>(#percent%)",
                dataPoints: [
                    { y: 80, label: "Pending", color: "#6db8bc" },
                    { y: 20, color: "#ccc" }
                ]
            }]
        });
        chart.render();

        var chart = new CanvasJS.Chart("invitesAccepted", {
            width: 300,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: {
                text: "686",
                fontColor: "#5184c1",
                horizontalAlign: "center",
                fontWeight: "normal"
            },
            data: [{
                type: "doughnut",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 17,
                indexLabel: "{label}  #percent%",
                toolTipContent: "<b>{label} </b>(#percent%)",
                dataPoints: [
                    { y: 30, label: "Accepted" },
                    { y: 70, color: "#ccc" }
                ]
            }]
        });
        chart.render();

        var chart = new CanvasJS.Chart("interviewers", {
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: null,
            data: [{
                type: "doughnut",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 17,
                indexLabel: "{label}  #percent%",
                toolTipContent: "<b>{label} </b>(#percent%)",
                dataPoints: [
                    { y: 30, label: "Scheduled", color: "#5184c1" },
                    { y: 70, label: "Completed" }
                ]
            }]
        });
        chart.render();

        // Create the chart
        // Create the chart
        Highcharts.chart('container', {
            chart: {
                type: 'column'
            },
            title: {
                text: null
            },
            xAxis: {
                type: 'category'
            },
            yAxis: {
                title: {
                    text: 'No. Of Interviewers'
                }

            },
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    pointWidth: 15,
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{point.y:.1f}%'
                    }
                }
            },

            tooltip: {
                headerFormat: '<span style="font-size:11px">{series.name}</span><br>',
                pointFormat: '<span style="color:{point.color}">{point.name}</span>: <b>{point.y:.2f}%</b> of total<br/>'
            },

            series: [
                {
                    name: "Browsers",
                    colorByPoint: true,
                    data: [
                        {
                            name: "1-3",
                            y: 62.74,
                            drilldown: "1-3",
                            color: "#5c5c61"
                        },
                        {
                            name: "4-7",
                            y: 10.57,
                            drilldown: "4-7",
                            color: "#5c5c61"
                        },
                        {
                            name: "7-10",
                            y: 70,
                            drilldown: "7-10"
                        },
                        {
                            name: "10-13",
                            y: 10,
                            drilldown: "10-13",
                            color: "#5c5c61"
                        },
                        {
                            name: "13-16",
                            y: 15,
                            drilldown: "13-16",
                            color: "#5c5c61"
                        },
                        {
                            name: "16-19",
                            y: 25,
                            drilldown: "16-19",
                            color: "#5c5c61"
                        },
                        {
                            name: "20+",
                            y: 20,
                            drilldown: "20+",
                            color: "#5c5c61"
                        }
                    ]
                }
            ]
        });

    }
</script>
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>

