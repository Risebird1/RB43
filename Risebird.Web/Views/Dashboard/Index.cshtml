<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingIRF").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingIRF").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingIRF").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function FilterInterviewDashboard(filterValue) {

        $('#loadingmessage').show();
        $.ajax({
            type: "GET",
            url: "/IRF/FilteredInterviewDashboard",
            data: { 'filterValue': filterValue },
            success: function (data) {
                if (data == '') {
                    $('#loadingmessage').hide();
                    $('#tableIRFID').html('');
                    $('#tableIRFID').html('No interviews for ' + filterValue + '.');
                    $('#tableIRFID').css("margin-left", "452px");
                    return;
                }
                $('#loadingmessage').hide();
                $('#tableIRFID').css("margin-left", "");
                $('#tableIRFID').html('');
                $('#tableIRFID').html(data);

                $('#meetingIRF').DataTable({
                    bFilter: false, bInfo: false, bPaginate: false,

                });
                //  var table = $('#meetingIRF').DataTable();



            },
            error: function (err) {


            }
        });
    }
</script>

