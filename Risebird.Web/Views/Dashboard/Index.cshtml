<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->
    <!-- START PAGE CONTAINER -->
    <div class="page-container">


        <div class="page-content">
            <nav class="navbar navbar-expand-lg navbar-transparent btn-primary  navbar-absolute" style="height:53px;">
                <div class="container-fluid">
                    <div class="navbar-wrapper w-full">
                        <div class="navbar-toggle">
                            <button type="button" class="navbar-toggler">
                                <span class="navbar-toggler-bar bar1"></span>
                                <span class="navbar-toggler-bar bar2"></span>
                                <span class="navbar-toggler-bar bar3"></span>
                            </button>
                        </div>
                        <a class="navbar-brand" style=" line-height: 50px;">Dashboard</a>
                    </div>

                </div>
            </nav>

            <div class="panel-header panel-header-sm">
            </div>
            <!-- PAGE CONTENT WRAPPER -->
            <div class="page-content-wrap">

                <!-- START DASHBOARD CHART -->
                <div class="row">
                    <div class="col-md-12">

                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Tracking</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">
                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="interviewTrackingDate" name="interviewTrackingDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li><button onclick="changeInterviewTracking()" class="panel-fullscreen"><span class="fa fa-eye"></span></button></li>

                                </ul>
                            </div>
                            <div class="panel-body">
                                <div class="chart-holder" id="area-chart" style="height: 200px;"></div>
                                <div class="block-full-width">
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
                <!-- END DASHBOARD CHART -->

                <div class="row" style="padding-bottom:30px">

                    <div class="skill">

                        <!-- START INTERVIEW BLOCK -->
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Skill Channel Activity</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">
                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            @*<input id="progressTrackingDate" name="progressTrackingDate" type="date" for="@Model.ProgressDate" class="form-control">*@
                                            @Html.EditorFor(model => model.ProgressDate.Date, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                        </div>
                                    </li>
                                    <li>
                                        <button onclick="getIRFProgress()" class="panel-fullscreen"><span class="fa fa-eye"></span></button>
                                    </li>
                                </ul>

                            </div>

                            <div id="progressTableId">
                                <div class="panel-body panel-body-table">
                                    @if (Model.IrfProgressList != null && Model.IrfProgressList.Count() != 0)
                                    {
                                        <div class="scrollbox">
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th width="50%">Skill Channel</th>
                                                            <th width="20%">Status</th>
                                                            <th width="30%">Activity</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @foreach (var item in Model.IrfProgressList)
                                                        {
                                                            var label = "";
                                                            var statuslabel = "";


                                                            @if (item.idProgress >= 1 && item.idProgress <= 4)
                                                            {

                                                                label = "progress-bar-danger";
                                                                statuslabel = "label-danger";


                                                            }
                                                            else if (item.idProgress >= 5 && item.idProgress <= 8)
                                                            {
                                                                label = "progress-bar-yellow";
                                                                statuslabel = "label-yellow";
                                                            }


                                                            else
                                                            {
                                                                label = "progress-bar-green";
                                                                statuslabel = "label-green";
                                                            }
                                                            <tr>
                                                                <td title="@item.Comment"><strong>@item.IRFnSkill</strong></td>
                                                                <td onclick="openProgressModal()" style="cursor: pointer;"><span class="label @statuslabel">@item.ProgressStatus</span></td>
                                                                <td>
                                                                    <div class="progress progress-small progress-striped active">
                                                                        <div class="progress-bar @label" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" title="" style="width: @((item.idProgress * 100)/11)%;"><a href="#" data-toggle="tooltip" title="@((item.idProgress * 100) / 11)%"> <span>@((item.idProgress * 100) / 11)%</span></a></div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div id="statusModal" class="modal modal-bg">
                                            <!-- Modal content -->
                                            <div class="modal-dialog modal-lg" role="document">
                                                <div class="modal-content">


                                                    <div class="filheader">
                                                        <div class="filavatar">
                                                            <span class="publicsharing-icon fas fa-question fa-2x"></span>
                                                        </div>
                                                        <h5 class="modal-title pull-left" id="statusHeading">Status</h5>
                                                    </div>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true" id="statusPopUp" style="cursor:pointer;">&times;</span>
                                                    </button>

                                                    <form action="@Url.Action("UpdateIRFProgress","Dashboard")" method="post" id="idFormProgress">
                                                        <div class="modal-body">

                                                            <table class="table table-bordered table-striped" id="progressTable" style="width:100%">
                                                                <thead>
                                                                    <tr>
                                                                        <th width="50%">Skill Channel</th>
                                                                        <th width="20%">Status</th>
                                                                        <th width="30%">Comment</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>


                                                                    @for (var i = 0; i < Model.IrfProgressList.Count(); i++)
                                                                    {
                                                                        <tr>
                                                                            <td><strong>@Model.IrfProgressList[i].IRFnSkill</strong></td>
                                                                            <td>
                                                                                @Html.DropDownListFor(m => m.IrfProgressList[i].idProgress, Model.ProgressOptions, new { @class = "form-control" })

                                                                            </td>
                                                                            <td>
                                                                                @Html.EditorFor(m => m.IrfProgressList[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                                            </td>
                                                                            @Html.HiddenFor(m => m.IrfProgressList[i].id)

                                                                        </tr>

                                                                    }
                                                                    @Html.HiddenFor(m => Model.ProgressDate)
                                                                    @*@Html.Hidden("ProgressDate", Model.ProgressDate)*@

                                                                </tbody>
                                                            </table>
                                                            <hr style="margin:10px 0px;" />
                                                            <div class="form-group clearfix">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">
                                                                        @*<input type="button" onclick="updateIRFProgress()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnUpload" value="Save">*@
                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" value="Save">Save</button>
                                                                    </div>
                                                                </div>



                                                            </div>
                                                        </div>
                                                    </form>
                                                </div>

                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>


                        </div>
                        <!-- END INTERVIEW BLOCK -->

                    </div>


                    <div class="daily-interview">

                        <!-- START IRF BLOCK -->
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Slots</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">

                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="interviewSlotsDate" name="interviewSlotsDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li>

                                        <button onclick="getInterviewSlots()" class="panel-fullscreen"><span class="fa fa-eye"></span></button>
                                    </li>
                                </ul>
                            </div>
                            <div id="slotsId">
                                <div class="panel-body panel-body-table">
                                    @if (Model.DailyInterviewSlots != null && Model.DailyInterviewSlots.Count() > 0)
                                    {
                                        <div class="sb-container scroller">
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-striped ">
                                                    <thead>
                                                        <tr>
                                                            <th width="20%">Morning Counts</th>
                                                            <th width="30%">Evening Counts</th>
                                                            <th width="50%">Skill Channel ID</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @{
                                                            foreach (var item in Model.DailyInterviewSlots)
                                                            {
                                                                <tr>
                                                                    <td class="text-center"><span class="label-num"><strong>@item.Morning</strong></span></td>
                                                                    <td class="text-center"><span class="label-num"><strong>@item.Evening</strong></span></td>
                                                                    <td><strong>@item.IRFnSkill</strong></td>
                                                                </tr>

                                                            }
                                                        }


                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>No interviews for this day!</div>
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- END IRF BLOCK -->

                    </div>

                    <div class="daily-slot">

                        <!-- START SALES BLOCK -->
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Status</h3>

                                </div>
                                <ul class="panel-controls panel-controls-title">
                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="statusTrackingDate" name="statusTrackingDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li>
                                        @*<a href="#"><span class="fa fa-cog"></span></a>*@
                                        <button onclick="getInterviewStatus()" class="panel-fullscreen"><span class="fa fa-eye"></span></button>
                                    </li>
                                </ul>

                            </div>

                            <div id="statusTrackingId">

                                <div class="panel-body">
                                    @if (Model.TotalCompletedMeetings != 0)
                                    {
                                        <div class="stacked">
                                            <div class="sb-container scroller">
                                                <div>

                                                    @{
                                                        var borderLine = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 4).Count();
                                                        <div class="progress-list">
                                                            <div class="pull-left"><strong>Border Line</strong></div>
                                                            <div class="pull-right">
                                                                @borderLine / @Model.TotalCompletedMeetings
                                                            </div>
                                                            <div class="progress progress-small progress-striped active">
                                                                <div class="progress-bar progress-bar-primary" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(borderLine * 100 / Model.TotalCompletedMeetings)%;">
                                                                    @(borderLine * 100 / Model.TotalCompletedMeetings)%
                                                                </div>
                                                            </div>
                                                        </div>

                                                        var proxy = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 1).Count();
                                                        <div class="progress-list">
                                                            <div class="pull-left"><strong>Proxy</strong></div>
                                                            <div class="pull-right">
                                                                @proxy / @Model.TotalCompletedMeetings
                                                            </div>
                                                            <div class="progress progress-small progress-striped active">
                                                                <div class="progress-bar progress-bar-primary" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(proxy * 100 / Model.TotalCompletedMeetings)%;">
                                                                    @(proxy * 100 / Model.TotalCompletedMeetings)%
                                                                </div>
                                                            </div>
                                                        </div>

                                                        var rejected = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 3).Count();
                                                        <div class="progress-list">
                                                            <div class="pull-left"><strong class="text-danger">Rejected</strong></div>
                                                            <div class="pull-right">
                                                                @rejected / @Model.TotalCompletedMeetings
                                                            </div>
                                                            <div class="progress progress-small progress-striped active">
                                                                <div class="progress-bar progress-bar-danger" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(rejected * 100 / Model.TotalCompletedMeetings)%;">
                                                                    @(rejected * 100 / Model.TotalCompletedMeetings)%
                                                                </div>
                                                            </div>
                                                        </div>

                                                        var selected = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 2).Count();
                                                        <div class="progress-list">
                                                            <div class="pull-left"><strong class="text-warning">Selected</strong></div>
                                                            <div class="pull-right">
                                                                @selected / @Model.TotalCompletedMeetings
                                                            </div>
                                                            <div class="progress progress-small progress-striped active">
                                                                <div class="progress-bar progress-bar-warning" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(selected * 100 / Model.TotalCompletedMeetings)%;">
                                                                    @(selected * 100 / Model.TotalCompletedMeetings)%
                                                                </div>
                                                            </div>
                                                        </div>

                                                    }

                                                </div>

                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>No completed interviews for this date!</div>
                                    }
                                </div>

                            </div>
                        </div>
                        <!-- END SALES BLOCK -->

                    </div>
                </div>

                <!-- START WIDGETS -->
                <div class="row">


                    <div class="col-lg-4 col-md-4 col-sm-4">

                        <div class="card">
                            <div class="card-body">
                                <p class="card-text">Total Candidates : <span><strong>@Model.CandidatesCountObj.TotalCandidates</strong></span></p>
                                <div>
                                    <div id="candidatesPieId" class="PieId"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-4">

                        <div class="card">
                            <div class="card-body">
                                <p class="card-text">Total Interviewers : <span><strong>@Model.InterviewerCountObj.InterviewerCount</strong></span></p>
                                <div>
                                    <div id="interviewers" class="PieId"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-4">

                        <div class="card">
                            <div class="card-body">
                                <p class="card-text">Total Meetings : <span><strong>@Model.MeetingResultCountObj.TotalMeetingsCount</strong></span></p>
                                <div>
                                    <div id="meetingsCountId" class="PieId"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- END WIDGETS -->


            </div>
            <!-- END PAGE CONTENT WRAPPER -->
        </div>
        <!-- END PAGE CONTENT -->
    </div>
    <!-- END PAGE CONTAINER -->





</div>

<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/data.js"></script>
<script src="https://code.highcharts.com/modules/drilldown.js"></script>


<script>
    var closeStatus = document.getElementById("statusPopUp");
    // When the user clicks on <span> (x), close the modal
    closeStatus.onclick = function () {
        var modal = document.getElementById("statusModal");
        modal.style.display = "none";
    }

    function openProgressModal() {
        var modal = document.getElementById("statusModal");
        modal.style.display = "block";
    }


</script>


<script>
    function getDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!
        var yyyy = today.getFullYear();

        if (dd < 10) {
            dd = '0' + dd
        }

        if (mm < 10) {
            mm = '0' + mm
        }

        today = yyyy + '-' + mm + '-' + dd;
        document.getElementById('interviewTrackingDate').value = today;
        document.getElementById('statusTrackingDate').value = today;
        document.getElementById('interviewSlotsDate').value = today;
        //document.getElementById('progressTrackingDate').value = today;
    }

    function setDatatable() {
        $('#progressTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [5, 10, 50, -1],
                [5, 10, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button style=display:none; type=button id=x>x</button>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").hide();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    }

</script>
<script>


    window.onload = function () {
        getDate();
        setDatatable();
        var meetingsData = '@Model.MeetingsData';
        meetingsData= JSON.parse(meetingsData.replace(/&quot;/g, '"'));
        var meetingsDataLabels = '@Model.MeetingsDataLabels';
        meetingsDataLabels = JSON.parse(meetingsDataLabels.replace(/&quot;/g, '"'));
        UpdateInterviewTrackingGraph(meetingsData, meetingsDataLabels);

        var interviewerCountObj = [{y : @Model.InterviewerCountObj.ApprovedCount, label:"Approved"},
        {y : @Model.InterviewerCountObj.UnapprovedCount, label:"Unapproved"}]

        var chart = new CanvasJS.Chart("interviewers", {
           theme: "light2",
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 15,
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",

                dataPoints: interviewerCountObj
            }]
        });
        chart.render();

        //meetingsCountId
        var meetingsCountObj = [{ y: @Model.MeetingResultCountObj.ProxyCount, label: "Proxy" },
            { y: @Model.MeetingResultCountObj.SelectedCount, label: "Selected" },
            { y: @Model.MeetingResultCountObj.RejectedCount, label: "Rejected" },
            { y: @Model.MeetingResultCountObj.BorderLineCount, label:"Border Line"},
            { y: @Model.MeetingResultCountObj.NoShowCount, label:"No Show"},
            { y: @Model.MeetingResultCountObj.ScheduledCount, label:"Scheduled"},
            { y: @Model.MeetingResultCountObj.DroppedCount, label:"Dropped"},
            @*{ y: @Model.MeetingResultCountObj.StatusPendingCount, label:"Status Pending"}*@
            @*{y : @Model.MeetingResultCountObj.NoResultCount, label:"No Results"}*@]

        var chart = new CanvasJS.Chart("meetingsCountId", {
           theme: "light2",
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 15,
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",

                dataPoints: meetingsCountObj
            }]
        });
        chart.render();

        //candidatesPieId
        var candidateCountObj = [{ y: 8, label: "Proxy" },
            { y: 31, label: "Selected" },
            { y: 27, label: "Rejected" },
            { y: 34, label:"Border Line"}]

        var chart = new CanvasJS.Chart("candidatesPieId", {
           theme: "light2",
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 15,
                indexLabel: "{label}  {y}%",
                toolTipContent: "<b>{label} </b>({y}%)",

                dataPoints: candidateCountObj
            }]
        });
        chart.render();
    }





</script>
<script>
    function changeInterviewTracking() {
        document.getElementById('area-chart').innerHTML = '';
        var date = document.getElementById('interviewTrackingDate').value;
        $.ajax({
            url: '/Dashboard/GetDateWiseInterviews',
            data: { 'date': date },
            success: function (data) {
                UpdateInterviewTrackingGraph(JSON.parse(data.meetingsData), JSON.parse(data.meetingsDataLabels));
            }
        });
    }

    function UpdateInterviewTrackingGraph(meetingsData, meetingsDataLabels) {

        config = {
            data: meetingsData,
            xkey: 'Time',
            ykeys: meetingsDataLabels,
            labels: meetingsDataLabels,
            resize: true,
            hideHover: true,
            //xLabels: 'day',
            gridTextSize: '10px',
            //lineColors: ['#1caf9a', '#33414E'],
            gridLineColor: '#E5E5E5'
        };
        config.element = 'area-chart';
        Morris.Area(config);

    }
</script>


<script>
    function getInterviewStatus() {
        var date = document.getElementById('statusTrackingDate').value;
        $.ajax({
            url: '/Dashboard/GetDateWiseInterviewStatus',
            data: { 'date': date },
            success: function (data) {
                $('#statusTrackingId').html('');
                $('#statusTrackingId').html(data);


            }
        });
    }

    function getInterviewSlots() {
        var date = document.getElementById('interviewSlotsDate').value;
        $.ajax({
            url: '/Dashboard/GetDateWiseMeetingsSlots',
            data: { 'date': date },
            success: function (data) {
                $('#slotsId').html('');
                $('#slotsId').html(data);


            }
        });
    }

    function getIRFProgress() {
        var date = document.getElementById('ProgressDate_Date').value;
        $.ajax({
            url: '/Dashboard/GetDateWiseIRFProgress',
            data: { 'date': date },
