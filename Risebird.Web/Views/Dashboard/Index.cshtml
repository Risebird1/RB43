                <!-- END DASHBOARD CHART -->
                <!--Start channel Management-->
                <div class="row" style="padding-bottom:5px">

                    <div class="col-md-4">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Interview Management</h3>
                                </div>
                            </div>
                            <div id="interviewmanagementId">
                                <div class="panel-body panel-body-table">
                                    @if (Model.InterviewManagement != null && Model.InterviewManagement.Count() != 0)
                                    {
                                        <div class="scrollbox">
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th width="30%">Date</th>
                                                            <th width="70%">Interview/Resolved/Unresolved</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.InterviewManagement.Select(x => x.interviewDate).Distinct())
                                                        {
                                                            <tr>
                                                                <td><strong>@item.ToString().Substring(0, 10)</strong></td>
                                                                <td>
                                                                    <strong>
                                                                        @Model.InterviewManagement.Where(x => x.interviewDate == item).Count() /
                                                                        <span style="color:green"> @Model.InterviewManagement.Where(x => x.interviewDate == item && x.TotalCount >= 2 && x.IsMeetingNotificationSent == 1 && x.IsRescheduleNotificationSent == 0).Count()</span> /
                                                                        <span style="color:red">@Model.InterviewManagement.Where(x => x.interviewDate == item && ((x.TotalCount == 1 && x.IsMeetingNotificationSent == 1) || (x.TotalCount >= 2 && x.IsMeetingNotificationSent == 1 && x.IsRescheduleNotificationSent == 1))).Count()</span>
                                                                    </strong>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>No Interview found</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="daily-interview col-md-8">

                        <!-- START IRF BLOCK -->
                        <div class="panel panel-default" style="margin-bottom:0px;">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Stats</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">

                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="interviewSlotsDate" name="interviewSlotsDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li>

                                        <button onclick="getInterviewSlots()" class="panel-fullscreen"><span class="fa fa-eye"></span></button>
                                    </li>
                                </ul>
                            </div>
                            <div id="slotsId">
                                @*<div class="panel-body panel-body-table">
                                    @if (Model.DailyInterviewSlots != null && Model.DailyInterviewSlots.Count() > 0)
                                    {
                                        <div class="sb-container scroller">
                                            <div class="table-responsive">
                                                <table class="table table-bordered table-striped ">
                                                    <thead>
                                                        <tr>
                                                            <th width="30%" class="text-center"><strong>Skill Channel</strong></th>
                                                            <th width="20%" class="text-center"><strong>Morning Interviews</strong></th>
                                                            <th width="20%" class="text-center"><strong>Evening Interviews</strong></th>
                                                            <th width="50%" class="text-center"><strong>Status</strong></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @{
                                                            foreach (var item in Model.DailyInterviewSlots)
                                                            {
                                                                <tr>
                                                                    <td class="text-center"><strong>@item.IRFnSkill</strong></td>
                                                                    <td class="text-center">
                                                                        <span class="label-num"><strong title="Total Interview: @item.Morning">@item.Morning</strong></span>/
                                                                        @if (item.MorningUnassinged == 0)
                                                                        {

                                                                            <span class="label-num" style="color: green"><strong title="Unassigned Interview: @item.MorningUnassinged">@item.MorningUnassinged</strong></span>

                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="label-num" style="color: red"><strong title="Unassigned Interview: @item.MorningUnassinged">@item.MorningUnassinged</strong></span>
                                                                        }


                                                                    </td>
                                                                    <td class="text-center">
                                                                        <span class="label-num"><strong title="Total Interview: @item.Evening">@item.Evening</strong></span>/
                                                                        @if (item.EveningUnassinged == 0)
                                                                        {
                                                                            <span class="label-num" style="color: green"><strong title="Unassigned Interview: @item.EveningUnassinged">@item.EveningUnassinged</strong></span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="label-num" style="color: red"><strong title="Unassigned Interview: @item.EveningUnassinged">@item.EveningUnassinged</strong></span>
                                                                        }
                                                                    </td>
