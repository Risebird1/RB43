@model IEnumerable<Risebird.Entities.Data.Surcharges>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "GetSurchargesDetails";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}
@if (HttpContextAccessor.HttpContext.Session.GetString("SurchargeFilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("SurchargeFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
<div id="main-panel" class="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">

                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Surcharge Details</h4></div>
                </div>
                @if (ViewBag.Type == 0)
                {
                    <div class="feedback-tab-ac" onclick="Changeurldetails(0)"><strong>Surcharge Requested</strong></div>
                    <div class="feedback-tab" onclick="Changeurldetails(1)"><strong>Surcharge Approved</strong></div>
                }
                else if (ViewBag.Type == 1)
                {
                    <div class="feedback-tab" onclick="Changeurldetails(0)"><strong>Surcharge Requested</strong></div>
                    <div class="feedback-tab-ac" onclick="Changeurldetails(1)"><strong>Surcharge Approved</strong></div>
                }
             
                <div class="pull-right">
                    <div>
                        <span class="interview_3">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                                <span class="mdc-button__label"><span class="fa fa-filter" data-bs-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        </span>
            </div>
        </div>

   
    <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="filheader">
                    <div class="filavatar">
                        <span class="fa fa-filter"></span>
                    </div>
                    <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                </div>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <form action="@Url.Action("GetSurchargesDetails","Dashboard",new{actionType=ViewBag.Type})" method="post" id="form" onsubmit="return checkfilterDate();">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 col-sm-6 border-rv">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                        Start Date
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <input id="StartDate" name="StartDate" type="date" class="form-control">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6">
                                <div class="form-group">
                                    <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                        End Date
                                    </label>
                                    <div class="col-md-12 col-sm-12">
                                        <input id="EndDate" name="EndDate" type="date" class="form-control">
                                    </div>
                                </div>
                            </div>
                         
                            <div class="col-md-6 col-sm-6">                                                          
                                <div class="form-group">
                                    <div>
                                        <div class="col-md-12 col-sm-12">
                                            <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 10px 0px;float:right;margin-left:5px;">
                                                <font style="font-size:12px;"> Reset Filter</font>
                                            </button>
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 10px;float:right">
                                                <font style="font-size:12px;"> Apply Filter</font>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

            <div class="content client">
        <div class="row bl-bg">
                <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                   
                            <div class="dataloading">

