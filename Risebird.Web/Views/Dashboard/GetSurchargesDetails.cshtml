                                                                                </span>
                                                                            </button>
                                                                            <button class="btn btn-candlist shadow btn-xs sharp me-1" aria-label="UnApprove Surcharge" style="width:25px!important;height:25px!important;background:#f49b81;border-color:#f49b81;position:relative;left:4px;">
                                                                                <span onclick="UnApproveSurcharge('@item.InterviewId','@item.Surcharge','@item.SurchargeComment','@item.Type','@item.IRFId',2,'@item.UserId')" title="UnApprove Surcharge">
                                                                                    <i class="fa fa-times-circle" aria-hidden="true" style="position:relative;font-size:14px;top:1px;"></i>
                                                                                </span>
                                                                            </button>
                                                                            <button class="btn btn-candlist shadow btn-xs sharp me-1" aria-label="Edit Surcharge" style="width:25px!important;height:25px!important;background:#a2ccef;border-color:#a2ccef;position:relative;left:4px;">
                                                                                <span onclick="openEditSurchargeDetailsModel('@item.InterviewId','@item.IRFId','@item.Type','@item.UserId','@item.SurchargeComment','@item.Surcharge')" title="Edit Surcharge">
                                                                                    <i style="color: white;position: relative;top:-2px;font-size: 10px;" class="fa fa-percent" aria-hidden="true"></i>
                                                                                    <svg fill="#fff" style="position:relative;top:2px;right:11px;" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path></svg>
                                                                                </span>
                                                                            </button>

                                                                            <button class="btn btn-candlist shadow btn-xs sharp me-1" aria-label="Surcharge History" style="width:25px!important;height:25px!important;background:#e0af44ba;border-color:#ebc676ba;position:relative;left:4px;">
                                                                                <span onclick="SurchargeActivityTracker('@item.InterviewId','@item.IRFId','@item.Type','@item.UserId')" title="Surcharge History">
                                                                                    <i style="color: white;position: relative;top: -3px;left: -2px;font-size: 10px;" class="fa fa-percent" aria-hidden="true"></i>
                                                                                    <i class="fa fa-history" aria-hidden="true" style="position: relative;top:2px;right:10px;font-size:11px;"></i>
                                                                                </span>
                                                                            </button>
                                                                        </td>
                                                                    }
                                                                <td>@item.SkillChannel</td>
                                                        <td>@item.interviewDate</td>
                                                                <td>@item.interviewer</td>
                                                                <td>@item.Surcharge</td>
                                                                <td>@item.SurchargeComment</td>
                                                                <td>@item.JDTiltle</td>
                                                                <td>@item.ClientName</td>
                                                        @if (item.Type == "Interview")
                                                        {
                                                            <td><div>Interview</div></td>
                                                        }
                                                        else
                                                        {
                                                            <td><div>Skill Channel</div></td>
                                                        }
                                                        <td>@item.candidateEmail</td>
                                                        @if (item.MeetingStatusStatusDesc == "Status Pending")
                                                        {
                                                            <td>
                                                                <span class="status mpending">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Completed")
                                                        {

                                                            <td>
                                                                <span class="status mcomplete">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Scheduled")
                                                        {

                                                            <td>
                                                                <span class="status mscheduled">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }

                                                        else if (item.MeetingStatusStatusDesc == "Dropped")
                                                        {

                                                            <td>
                                                                <span class="status mdropped">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "No Show(Candidate)")
                                                        {

                                                            <td>
                                                                <span class="status mnoshow">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Dropped (Rejected)")
                                                        {

                                                            <td>
                                                                <span class="status mdropped" style="width:115px;">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }

                                                        else
                                                        {
                                                            <td> <span class="status">@item.MeetingStatusStatusDesc</span></td>

                                                        }
                                                        <td>@item.ChannelOwner</td>
                                                        <td>@item.RequestBy</td>
                                                        <td>@item.RequestAt</td>

                                                               
                                                       
                                                    </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                  

                                    <!-- end content-->
                                </div>

                                <!-- end col-md-12 -->
                            </div>




                            <!-- end row -->
                        </div>

                    </div>
                </div>


            </div>
            </div>
       

    
</div>
