<script src="~/js/filtervalidation.js?v=2024"></script>
<script>
    function searchResult() {
        $('#SurcharegesTable').DataTable();
    }
    function RefreshSearch() {
        $('#SurcharegesTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }
    $(document).ready(function () {
        applyDataTable();

        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }
    });

    function applyDataTable() {

        var table = $('#SurcharegesTable').DataTable({

            order: [],
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    }
    function ApproveSurcharge(InterviewId, Surcharge, SurchargeComment, Type, IRFId, actionType,UserId) {
        swal.fire({
            title: 'Approve Surcharge!',
            text: "Are you sure you want to approve surcharge?" ,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        method: 'POST',
                        url: '/Dashboard/ApproveSurcharge',
                        data: {
                            'InterviewId': InterviewId,
                            'Surcharge': Surcharge,
                            'SurchargeComment': SurchargeComment,
                            'Type': Type,
                            'IRFId': IRFId,
                            'actionType': actionType,
                            'UserId': UserId
                        },
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            
                            swal.fire("Error Approve Surcharge!", "Please try again.", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successfully!',
                    type: 'success',                  
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    //window.location = "/IRF/CuratedIndex";
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    '',
                    'error'
                )
            }
        })

    }
    function UnApproveSurcharge(InterviewId, Surcharge, SurchargeComment, Type, IRFId, actionType, UserId) {
        swal.fire({
            title: 'Unapprove Surcharge!',
            text: "Are you sure you want to unapprove surcharge ?",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        method: 'POST',
                        url: '/Dashboard/ApproveSurcharge',
                        data: {
                            'InterviewId': InterviewId,
                            'Surcharge': Surcharge,
                            'SurchargeComment': SurchargeComment,
                            'Type': Type,
                            'IRFId': IRFId,
                            'actionType': actionType,
                            'UserId': UserId
                        },
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {

                            swal.fire("Error unapprove surcharge!", "Please try again.", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Successfully!',
                    type: 'success',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload();
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    '',
                    'error'
                )
            }
        })
    }
</script>
<script>
    function openEditSurchargeDetailsModel(InterviewId,IRFId,Type,UserId,SurchargeComment,Surchargeamt) {
        var modal = document.getElementById("EditRequestSurchargeDetailsModel");
        modal.style.display = "block";
        $("#txtInterviewId").val(InterviewId);
        $("#txtIRFId").val(IRFId);
        $("#txtType").val(Type);
        $("#txtUserId").val(UserId);
        $("#txtSurchargeComment").val(SurchargeComment);
         $("#txtSurchargeamt").val(Surchargeamt);
         $.ajax({
                type: "Post",
                url: "/Dashboard/GetPerSuccessRateDetails",
                data: { 'InterviewId': InterviewId, 'IRFId': IRFId, 'Type': Type, 'UserId': UserId },
                success: function (data) {
                    console.log(data.heuristicsscore);
                  $("#txtPlanType").val(data.heuristicsscore);
                  $("#txtPerSuccessRate").val(data.perSuccessRate);
                
                }
            });   
        if (Type == "Skill") {
            var modal = document.getElementById("txtSurchargeComment");
            modal.style.display = "none";
        }

    }
    function closeEditRequestSurchargeDetailsModel() {
        var modal = document.getElementById("EditRequestSurchargeDetailsModel");
        modal.style.display = "none";
    }
    function UpdateSurchargeDetails() {
        var InterviewId= $("#txtInterviewId").val();
        var IRFId= $("#txtIRFId").val();
        var Type= $("#txtType").val();
        var UserId= $("#txtUserId").val();
        var SurchargeComment = $("#txtSurchargeComment").val();
        var Surchargeamt = $("#txtSurchargeamt").val();
        var plantype = parseInt($("#txtPlanType").val());
           var PerSuccessRate = $("#txtPerSuccessRate").val();
        var percentageRate=(100/100)*PerSuccessRate;
        if (plantype == 2 && parseInt(surchargeamt) >= percentageRate && Type=="Interview") {
            alert("Surcharge should be between 0 to " + percentageRate);
        }
        else if (plantype == 4 && parseInt(Surchargeamt) > percentageRate && Type=="Interview") {
