@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "911 Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> 911 Dashboard</h4></div>
                </div>
                <div class="pull-right">
                    <div>
                        @if (ViewBag.Actiontype == 0)
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Index", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back" onclick="location.href='@Url.Action("MyInterviews", "HR")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">
                                <input type="hidden" value="@ViewBag.actionstatus" id="hidactionstatus" />
                                <div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Primary Skills</th>
                                                    <th>JD Title</th>
                                                    <th>Client</th>
                                                    <th>UnApproved Resumes</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Primary Skills</th>
                                                    <th>JD Title</th>
                                                    <th>Client</th>
                                                    <th>UnApproved Resumes</th>
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.PrimarySkill</td>
                                                        <td>@item.JDTiltle</td>
                                                        <td>@item.Client</td>
                                                        <td>@item.TotalView</td>
                                                        <td>
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Resumes">
                                                                <a style="color:white" target="_blank" href="@Url.Action("Resumes", "Candidate", new { irfId = item.irfIntId, irfName = item.IRFId,actiontype=1})" title="Resumes" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-person" viewBox="0 0 16 16">
                                                                        <path d="M11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" /><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2v9.255S12 12 8 12s-5 1.755-5 1.755V2a1 1 0 0 1 1-1h5.5v2z" />
                                                                    </svg>
                                                                </a>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function RefreshSearch() {
        $('#meetingTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }
    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#meetingTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter input:eq(0)").after("<span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
    }
    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    $(".dataloading").hide();
    $("#meetingTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();
    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingTable").show();
        }, 2000);
    };
</script>
<script src="https://code.jquery.com/jquery-1.12.4.min.js"></script>
