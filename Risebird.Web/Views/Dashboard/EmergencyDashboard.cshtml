<script type="text/javascript">
    var setRibbonCalledCount = 0;
    var getDeletedZoomMeetingsCount = false;
    $(document).ready(function () {
        // TimeInterval();
        setRibbon();
    });

    function TimeIntervalUrl() {
        $.ajax({
            type: 'GET',
            url: '/Dashboard/EmergencyDashboard',
            success: function () {
                location.reload(true);
            }
        });
    }
    function TimeInterval() {
        setInterval(TimeIntervalUrl, 90000);
    }
</script>

<script>
    function setRibbon() {
        if (setRibbonCalledCount == 0) {
            getDeletedZoomMeetingsCount = true;
        }
        else {
            getDeletedZoomMeetingsCount = false;
        }
        $.ajax({
            url: '/Dashboard/FetchRibbonValues',
            data: { 'section': 0, 'getDeletedZoomMeetingsCount': getDeletedZoomMeetingsCount },
            success: function (data) {
                if (parseInt(data.missedCandidateCount) != parseInt($("#ribbonMissedCandidateCount").text())) {
                    $(".flipper1").addClass("flipper");
                }
                else {
                    $(".flipper1").removeClass("flipper");
                }
            if (parseInt(data.bounceDroppedCandidateMailCount) != parseInt($("#ribbonMailCount").text())) {
                $(".flipper2").addClass("flipper");
            }
            else {
                $(".flipper2").removeClass("flipper");
            }
            if (parseInt(data.unassignedInterviewsCount) != parseInt($("#ribbonunassignedinterviewcount").text())) {
                $(".flipper3").addClass("flipper");
            }
            else {
                $(".flipper3").removeClass("flipper");
            }

            if (parseInt(data.potentialRiskInterviewCount) != parseInt($("#ribbonPotentialRiskInterviewCount").text())) {
                $(".flipper5").addClass("flipper");
            }
            else {
                $(".flipper5").removeClass("flipper");
            }

            if (parseInt(data.potentialRiskByClient) != parseInt($("#ribbonPotentialRiskByClientCount").text())) {
                $(".flipper6").addClass("flipper");
            }
            else {
                $(".flipper6").removeClass("flipper");
            }

            if (parseInt(data.dmApproveCount) != parseInt($("#ribbonDMApproveCount").text())) {
                $(".flipper7").addClass("flipper");
            }
            else {
                $(".flipper7").removeClass("flipper");
            }
