<script>
    function MissedCandidate() {
        window.location.href = "/Dashboard/InterviewManagementDetails?pagetype=" + 1;
    }

       function MialsDetails(recipientType) {
        window.location.href = "/Dashboard/GetEmailRecipientsBounceAndDropped?recipientType=" + recipientType;
    }
       function OpenRibbonDetails(actionstatus) {
        window.location.href = "/Dashboard/UnassignedInterviews?actionstatus=" + actionstatus + "&returnBack=" + 1;
    }

      function CallibrationCallsIRFDetalis(type) {
    window.location.href = "/IRF/CalibrationMeetingsDetails?type=" + type + "&returnBack=" + 1;
    }
</script>

<script type="text/javascript">
    var setRibbonCalledCount = 0;
    var getDeletedZoomMeetingsCount = false;
    $(document).ready(function () {
        // TimeInterval();
        setRibbon();
    });

    function TimeIntervalUrl() {
        $.ajax({
            type: 'GET',
            url: '/Dashboard/EmergencyDashboard',
            success: function () {
                location.reload(true);
            }
        });
    }
    function TimeInterval() {
        setInterval(TimeIntervalUrl, 90000);
    }
</script>

<script>
    function setRibbon() {
        if (setRibbonCalledCount == 0) {
            getDeletedZoomMeetingsCount = true;
        }
        else {
            getDeletedZoomMeetingsCount = false;
        }
        $.ajax({
            url: '/Dashboard/FetchRibbonValues',
            data: { 'section': 0, 'getDeletedZoomMeetingsCount': getDeletedZoomMeetingsCount },
            success: function (data) {
                if (parseInt(data.missedCandidateCount) != parseInt($("#ribbonMissedCandidateCount").text())) {
                    $(".flipper1").addClass("flipper");
                }
                else {
                    $(".flipper1").removeClass("flipper");
                }
            if (parseInt(data.bounceDroppedCandidateMailCount) != parseInt($("#ribbonMailCount").text())) {
                $(".flipper2").addClass("flipper");
            }
            else {
                $(".flipper2").removeClass("flipper");
            }
            if (parseInt(data.unassignedInterviewsCount) != parseInt($("#ribbonunassignedinterviewcount").text())) {
                $(".flipper3").addClass("flipper");
            }
            else {
                $(".flipper3").removeClass("flipper");
            }


            $("#ribbonMissedCandidateCount").text(data.missedCandidateCount);
            $("#ribbonMailCount").text(data.bounceDroppedCandidateMailCount);
            $("#ribbonunassignedinterviewcount").text(data.unassignedInterviewsCount);

            $("#ribbonMissedCandidateCount_1").text(data.missedCandidateCount);
            $("#ribbonMailCount_1").text(data.bounceDroppedCandidateMailCount);
            $("#ribbonunassignedinterviewcount_1").text(data.unassignedInterviewsCount);

                $(".flipper").toggleClass("flip");
            }
        });


        setTimeout(setRibbon, 60000);
    }

