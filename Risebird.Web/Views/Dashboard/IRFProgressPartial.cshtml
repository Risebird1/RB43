@model Risebird.Entities.ViewModel.DashboardVM


<link rel="stylesheet" type="text/css" href="~/Newassets/css/jquery.mCustomScrollbar.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=2024" />
    <div class="panel-body panel-body-table">
        @if (Model.IrfProgressList != null && Model.IrfProgressList.Count() != 0)
        {
            <div class="scrollbox">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th width="50%">Skill Channel</th>
                                <th width="20%">Status</th>
                                <th width="30%">Activity</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model.IrfProgressList)
                            {
                                var label = "";
                                var statuslabel = "";


                                @if (item.idProgress >= 1 && item.idProgress <= 4)
                                {

                                    label = "progress-bar-danger";
                                    statuslabel = "label-danger";


                                }
                                else if (item.idProgress >= 5 && item.idProgress <= 8)
                                {
                                    label = "progress-bar-yellow";
                                    statuslabel = "label-yellow";
                                }


                                else
                                {
                                    label = "progress-bar-green";
                                    statuslabel = "label-green";
                                }
                                <tr>
                                    <td title="@item.Comment"><strong>@item.IRFnSkill</strong></td>
                                    <td onclick="openProgressModal()" style="cursor: pointer;"><span class="label @statuslabel">@item.ProgressStatus</span></td>
                                    <td>
                                        <div class="progress progress-small progress-striped active">
                                            <div class="progress-bar @label" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" title="" style="width: @((item.idProgress * 100)/11)%;"><a href="#" data-toggle="tooltip" title="@((item.idProgress * 100) / 11)%"> <span>@((item.idProgress * 100) / 11)%</span></a></div>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <div id="statusModal" class="modal modal-bg">
                <!-- Modal content -->
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">


                        <div class="filheader">
                            <div class="filavatar">
                                <span class="publicsharing-icon fas fa-question fa-2x"></span>
                            </div>
                            <h5 class="modal-title pull-left" id="statusHeading">Status</h5>
                        </div>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" id="statusPopUp" style="cursor:pointer;">&times;</span>
                        </button>

                        <form action="@Url.Action("UpdateIRFProgress","Dashboard")" method="post" id="idFormProgress">
                            <div class="modal-body">

                                <table class="table table-bordered table-striped" id="progressTable" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th width="50%">Skill Channel</th>
                                            <th width="20%">Status</th>
                                            <th width="30%">Comment</th>
                                        </tr>
                                    </thead>
                                    <tbody>


                                        @for (var i = 0; i < Model.IrfProgressList.Count(); i++)
                                        {
                                            <tr>
                                                <td><strong>@Model.IrfProgressList[i].IRFnSkill</strong></td>
                                                <td>
                                                    @Html.DropDownListFor(m => m.IrfProgressList[i].idProgress, Model.ProgressOptions, new { @class = "form-control" })

                                                </td>
                                                <td>
                                                    @Html.EditorFor(m => m.IrfProgressList[i].Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" } })

                                                </td>
                                                @Html.HiddenFor(m => m.IrfProgressList[i].id)

                                            </tr>

                                        }
                                        @Html.HiddenFor(m=>m.ProgressDate)
                                    </tbody>
                                </table>
                                <hr style="margin:10px 0px;" />
                                <div class="form-group clearfix">
                                    <div>
                                        <div class="col-md-12 col-sm-12">
                                            @*<input type="button" onclick="updateIRFProgress()" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" id="btnUpload" value="Save">*@
                                            <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded pull-right" value="Save">Save</button>
                                        </div>
                                    </div>



                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        }

    </div>
    <script>
        var closeStatus = document.getElementById("statusPopUp");
        // When the user clicks on <span> (x), close the modal
        closeStatus.onclick = function () {
            var modal = document.getElementById("statusModal");
            modal.style.display = "none";
        }
        $('#progressTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [5, 10, 50, -1],
                [5, 10, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button style=display:none; type=button id=x>x</button>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").hide();

                    }
                    else { $("#x").show(); }
                });
            }

        });

    </script>
