@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Data
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Interviews";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] primarySkills = new string[] { };
    string[] RFID = new string[] { };
    string[] ClientHR = new string[] { };
    string[] ConfirmationStatus = new string[] { };
    string[] MeetingStatus = new string[] { };
    string[] InterviewStatus = new string[] { };
    string[] Interviewer = new string[] { };
    string[] ClientName = new string[] { };
    string[] Client = new string[] { };
    bool[] IsCandidateResponsed = new bool[] { };
    string[] TemplateName = new string[] { };
    bool[] AadhaarVerified = new bool[] { };
    string[] ChannelOwner = new string[] { };
}

@if (HttpContextAccessor.HttpContext.Session.GetString("Interviewfilters") != null)
{
    filter = JsonConvert.DeserializeObject<InterviewFilter>
        (HttpContextAccessor.HttpContext.Session.GetString("Interviewfilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
    primarySkills = filter.PrimarySkill != null ? filter.PrimarySkill : new string[] { };
    RFID = filter.RFID != null ? filter.RFID : new string[] { };
    ClientHR = filter.ClientHR != null ? filter.ClientHR : new string[] { };
    ConfirmationStatus = filter.ConfirmationStatus != null ? filter.ConfirmationStatus : new string[] { };
    MeetingStatus = filter.MeetingStatus != null ? filter.MeetingStatus : new string[] { };
    InterviewStatus = filter.InterviewStatus != null ? filter.InterviewStatus : new string[] { };
    Interviewer = filter.Interviewer != null ? filter.Interviewer : new string[] { };
    ClientName = filter.ClientName != null ? filter.ClientName : new string[] { };
    Client = filter.Client != null ? filter.Client : new string[] { };
    IsCandidateResponsed = filter.IsCandidateResponsed != null ? filter.IsCandidateResponsed : new bool[] { };
    TemplateName = filter.TemplateName != null ? filter.TemplateName : new string[] { };
    AadhaarVerified = filter.AadhaarVerified != null ? filter.AadhaarVerified : new bool[] { };
    ChannelOwner = filter.ChannelOwner != null ? filter.ChannelOwner : new string[] { };
}
<script>
    var Header = "Redo Interviews";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/SelectedPriorityClientMeetings.css?v=7" rel="stylesheet" />
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css" />
<input type="text" hidden id="hidtxtemailid" value="@ViewBag.emailid" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=1234" />


<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Redo Interviews</h4></div>
                </div>
                <div class="pull-left">
                </div>
                <div class="pull-right">
                    <div>
                        <span class="interview_3">
                            <button style="display:none" class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                                <span class="mdc-button__label"><span class="fa fa-filter" data-bs-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        </span>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="interviewerMemberModal" class="modal modal-bg">
        <!-- Modal content -->
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">


                <div class="filheader">
                    <div class="filavatar">
                        <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                    </div>
                    <h5 class="modal-title pull-left" id="memberHeading">Interviewer Details</h5>
                </div>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true" id="membersPopUp" style="cursor:pointer;">&times;</span>
                </button>

                <div class="modal-body" id="memberTableBody">
                </div>
            </div>

        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">

                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("Index","Interview", new { type = ViewBag.Type })" method="post" id="form" onsubmit="return checkfilterDate();">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 border-rv">


                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="MeetingStatus">
                                                                    Meeting Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="MeetingStatus" name="MeetingStatus" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Where(x => !string.IsNullOrEmpty(x.MeetingStatusStatusDesc)).Select(x => x.MeetingStatusStatusDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">

                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="RFID">Skill Channel ID</label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="RFID" name="RFID" data-placeholder="None Selected" class="form-control multiselect" multiple="multiple">

                                                                        @foreach (var item in Model.Select(x => x.IRFId).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="InterviewStatus">
                                                                    Interview Status
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="InterviewStatus" data-placeholder="None Selected" name="InterviewStatus" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.intervieweStatusStatDesc).Distinct().ToList())
                                                                        {
                                                                            @if (item != null && item != "")
                                                                            {
                                                                                <option value="@item">@item</option>
                                                                            }
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>


                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" onclick="ResetFilter('@ViewBag.Type')" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>


                                                                    </div>

                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div class="scrollbar int-table" id="style-2">

                                    <div id="tableID" class="second ">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th id='start'>Skill Channel ID</th>
                                                    <th>Interview Date</th>
                                                    @if (ViewBag.profile != "Quality Controller")
                                                    {
                                                        <th>Candidate Details</th>
                                                    }
                                                    else
                                                    {
                                                        <th>Candidate Name</th>
                                                    }

                                                    @*Hide Columns for Cancel Intervies*@
                                                    <th>JD Title</th>
                                                    <th>Company Name</th>
                                                    <th>Red Markers</th>
                                                    <th>Interveiwer</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th class="disabled-sorting" style="text-align:center">Actions</th>
                                                    <th>Skill Channel ID</th>
                                                    <th>Interview Date</th>
                                                    @if (ViewBag.profile != "Quality Controller")
                                                    {
                                                        <th>Candidate Details</th>
                                                    }
                                                    else
                                                    {
                                                        <th>Candidate Name</th>
                                                    }

                                                    <th>JD Title</th>
                                                    <th>Company Name</th>
                                                    <th>Red Markers</th>
                                                    <th>Interviewer</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>


                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    var colorcode = "#bfd2f42b";
                                                    @if (item.isVerified)
                                                    {
                                                        if (item.IsEmployed && string.IsNullOrWhiteSpace(item.EmploymentComment))
                                                        {
                                                            colorcode = "#fff";
                                                        }
                                                        else if (!item.IsEmployed && string.IsNullOrWhiteSpace(item.EmploymentComment))
                                                        {
                                                            colorcode = "#fcfccab5";
                                                        }
                                                        else if (item.EmploymentComment.Contains("No record"))
                                                        {
                                                            colorcode = "#faddbfa3";
                                                        }
                                                    }
                                                    <tr id=@item.imid style="background:@colorcode">
                                                        <td id="actionwrap" class="flex-w text-center">
                                                            <div class="action-btn">
                                                                @*For Hide All column in Cancel Intervies*@
                                                                @if (item.IsAadhaarVerificationRequired == true)
                                                                {
                                                                    <button class="mdc-fab app-fab--absolute " aria-label="Candidate Verified Data">
                                                                        <span title="Candidate Verified Data" onclick="javascript:FetchInterviewAadhaarDetails('@item.candidateEmail');" class="mdc-fab__icon material-icons">
                                                                            <img width="16" height="16" fill="currentColor" class="bi bi-person-check" viewBox="0 0 16 16" src="~/img/Aadhaar/verificationlogo.png" title="Candidate Verified Data" onclick="javascript:FetchInterviewAadhaarDetails('@item.candidateEmail');" />
                                                                        </span>
                                                                    </button>
                                                                }
                                                                @if (ViewBag.profile == "Admin" || ViewBag.profile == "SupportAdmin")
                                                                {
                                                                    @if (item.confirmationStatus.Trim() != "Cancelled" && item.MeetingStatusStatusDesc != "Status Pending" && item.MeetingStatusStatusDesc != "No Show(Candidate)" && item.MeetingStatusStatusDesc != "No Show(Interviewer)" && item.MeetingStatusStatusDesc != "No Show")
                                                                    {
                                                                        @if (item.IsAIInterview)
                                                                        {
                                                                            <span class="interview_9">
                                                                                <a style="text-decoration:none" target="_blank" href='@Url.Action("Report", "AIInterview" , new { seId = item.SessionId})'>
                                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Report" style="position:relative;top:-3px;">
                                                                                        <span>
                                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                                                                <!-- Report/document shape -->
                                                                                                <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                                                                                <path d="M15 2v5h5"></path>

                                                                                                <!-- Brain-like AI/circuit element -->
                                                                                                <path d="M10 12c0-1 .5-2 2-2s2 1 2 2-.5 2-2 2-2-1-2-2z"></path>
                                                                                                <line x1="12" y1="10" x2="12" y2="8"></line>
                                                                                                <line x1="12" y1="14" x2="12" y2="16"></line>
                                                                                                <line x1="10" y1="12" x2="8" y2="12"></line>
                                                                                                <line x1="14" y1="12" x2="16" y2="12"></line>

                                                                                                <!-- Text lines on report -->
                                                                                                <line x1="7" y1="18" x2="17" y2="18"></line>
                                                                                            </svg>
                                                                                        </span>
                                                                                    </button>
                                                                                </a>
                                                                            </span>
                                                                            //Remember : Change the report icon for an ai interview report. A normal report and an AI report should be identifiable by their distinct icons.
                                                                        }

                                                                        else
                                                                        {
                                                                            <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.imid, irfId=item.irfIntId})">
                                                                                <button class="mdc-fab app-fab--absolute" aria-label="Client Interview Report">
                                                                                    <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                                </button>
                                                                            </a>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(item.interviewer))
                                                                        {
                                                                            <span>
                                                                                <button class="mdc-fab app-fab--absolute " aria-label="Suspicious Interviwer">
                                                                                    <span onclick="javascript:SuspiciousTypeDetails('@item.interviewer');" title="Suspicious Interviwer" class="mdc-fab__icon touch"><img width="17" src="/img/suspicious.png" /></span>
                                                                                </button>
                                                                            </span>

                                                                        }
                                                                    }
                                                                    @if (item.CompanyName != null && item.CompanyName != "")
                                                                    {
                                                                        <a target="_blank" onclick="javascript:BlckListCompanyModalDetails('@item.CompanyName');">
                                                                            <button class="mdc-fab app-fab--absolute" aria-label="Blacklist Company">
                                                                                <span title="Blacklist Company" class="mdc-fab__icon material-icons"><img class="icons-blacklist" src="~/img/blacklist.png" /></span>
                                                                            </button>
                                                                        </a>
                                                                    }
                                                                }

                                                                @if ((ViewBag.profile == ProfileNames.Admin || ViewBag.profile == ProfileNames.SupportAdmin || ViewBag.profile == ProfileNames.SeniorHR) && !string.IsNullOrEmpty(item.AudioTranscriptFileLink))
                                                                {

                                                                    <a target="_blank" href="@Url.Action("TransciptAnalysis", "AIScreener" , new { interviewId = item.imid, irfId = item.irfIntId})" title="Transcript Analysis" style="text-decoration:none;">
                                                                        <span class="mdc-fab app-fab--absolute" aria-label="Transcript Analysis" style="background:#b3bce4d1;border-color:#b3bce4d1; top:3px;position:relative;left:0px; margin: 0px">
                                                                            <span title="Transcript Analysis" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z"></path></svg><i class="fas fa-search" style="color:#fff;font-size: 10px;position: relative;left: -2px;top: 2px;"></i></span>
                                                                        </span>
                                                                    </a>

                                                                    <a target="_blank" href="@Url.Action("TransciptAnalysis", "AIScreener" , new { interviewId = item.imid, irfId = item.irfIntId, isRedo = true})" title="Regenerate Transcript Analysis" style="text-decoration:none;">
                                                                        <span class="mdc-fab app-fab--absolute" aria-label="Regenerate Transcript Analysis" style="top:3px;position:relative;left:0px;margin: 0px;border:#9dcb79;background:#9dcb79;">
                                                                            <span title="Regenerate Transcript Analysis" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z"></path></svg><img src="~/img/regenerate.png" style="width:10px!important;position:relative;left:-2px" /></span>
                                                                        </span>
                                                                    </a>
                                                                }

                                                                <a target="_blank" href="@Url.Action("CandidateScheduleEvent", "InterviewScheduler", new { id = item.CalendlyLink.Split("=").LastOrDefault(), CandidateEmail = item.candidateEmail })" title="Schedule Meeting" style="top:1px;position: relative;cursor: pointer;text-decoration:none">
                                                                    <div class="mdc-fab app-fab--absolute" style="width:22px;height:22px;left:0px; top: -5px;position: relative;">
                                                                        <span title="ReSchedule Meeting"><i class="fas fa-calendar-alt" style="color:#fff;font-size:14px;position:relative;top:-2px;" aria-hidden="true"></i></span>
                                                                    </div>
                                                                </a>

                                                            </div>



                                                        </td>
                                                        <td title=@item.IRFId> @item.IRFId </td>
                                                        <td> @item.interviewDate </td>

                                                        <td style="padding-left:25px;">
                                                            @if (item.IsOnline == 1)
                                                            {
                                                                @if (item.IsVideoRequired == true)
                                                                {
                                                                    <div style="position:relative;z-index:10;">
                                                                        <div class="absCenter">
                                                                            <button class="infoButton" style="top:8px;left:-145px;">
                                                                                <div class="infoButton-btn" style="width:15px;height:15px;">
                                                                                    <span class="infoButton-btn-text" style="position: relative;font-size:13px;width: 10px;height: 21px;left:1px;top: -3px;">i</span>
                                                                                </div>
                                                                                <div class="infoButton-container" style="bottom: calc(-100% + 35px);">
                                                                                    <div class="infoButton-container-message" style="position:relative;top:-14px;padding:4px 7px 0px 7px;width:auto;">Mandate : <b style="color:red">Video On</b></div>
                                                                                </div>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                <span class="name-field"> @* <a onclick="directopenChat('@item.candidateEmail')"> *@<span class="dot" style="background-color:green"></span>@item.candidateName @* </a> *@ </span>
                                                                @if (ViewBag.profile != "Quality Controller")
                                                                {
                                                                    <div style="padding: 0px 0px 5px 7px;position: relative;left: -10px;">
                                                                        <span class="call-area">
                                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                            {
                                                                                <span data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CommonCallButtonClick('@item.candidateName', '@item.MobileNumber', '@item.candidateEmail','@item.imid')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="17" /></span>
                                                                            }
                                                                        </span>
                                                                        @item.MobileNumber
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                @if (item.IsVideoRequired == true)
                                                                {
                                                                    <div style="position:relative;width:fit-content">
                                                                        <div class="absCenter">
                                                                            <button class="infoButton" style="top:8px;left:-11px;">
                                                                                <div class="infoButton-btn" style="width:15px;height:15px;">
                                                                                    <span class="infoButton-btn-text" style="position: relative;font-size:13px;width: 10px;height: 21px;left:1px;top: -3px;">i</span>
                                                                                </div>
                                                                                <div class="infoButton-container" style="bottom: calc(-100% + 35px);">
                                                                                    <div class="infoButton-container-message" style="position:relative;top:-14px;padding:4px 7px;width:auto;"><b style="color:red">Interviewer video on</b> is mandatory by client, else 100% payment deduction</div>
                                                                                </div>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                <span class="name-field">  @item.candidateName</span>
                                                                @if (ViewBag.profile != "Quality Controller")
                                                                {
                                                                    <div style="padding: 0px 0px 5px 7px;position:relative;left:-10px;">
                                                                        <span class="call-area">
                                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                            {
