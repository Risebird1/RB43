@model IEnumerable<Risebird.Entities.ViewModel.ProctoringSessionReportVM>
@{
    ViewData["Title"] = "ProctoringReport";
}
<script>
    var Header = "<div>Proctoring Report</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .proctoring-action-btn {
        background-color: #4a8f52 !important;
        border: none !important;
        color: #fff !important;
        border-radius: 4px !important;
        padding: 4px 14px !important;
        font-size: 12px !important;
        cursor: pointer !important;
    }

        .proctoring-action-btn:hover,
        .proctoring-action-btn:focus,
        .proctoring-action-btn:active {
            background-color: #3c7443 !important;
            color: #fff !important;
        }
</style>

<div class="main-panel" id="main-panel">
    <div>
        <div class="mobile-view">
            <div class="pt30">
                <div class="col-md-12 nopad" style="margin:0px;">
                    <div class="card-header bg-w clearfix">
                        <div class="pull-left">
                            <h4 class="card-title">Proctoring Report</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Session Token</th>
                                                <th>Interview Id</th>
                                                <th>Candidate Email</th>
                                                <th>Trust</th>
                                                <th>State</th>
                                                <th>Risk Score</th>
                                                <th>Created At (UTC)</th>
                                                <th>Last Heartbeat (UTC)</th>
                                                <th>Log Count</th>
                                                <th style="width:100px">Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Session Token</th>
                                                <th>Interview Id</th>
                                                <th>Candidate Email</th>
                                                <th>Trust</th>
                                                <th>State</th>
                                                <th>Risk Score</th>
                                                <th>Created At (UTC)</th>
                                                <th>Last Heartbeat (UTC)</th>
                                                <th>Log Count</th>
                                                <th style="width:100px">Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @if (Model != null && Model.Count() > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.SessionToken</td>
                                                        <td>@item.InterviewId</td>
                                                        <td>@item.CandidateEmail</td>
                                                        <td>@item.Trust</td>
                                                        <td>@item.State</td>
                                                        <td>@item.RiskScore</td>
                                                        <td>@item.CreatedAtUtc</td>
                                                        <td>@item.LastHeartbeatAtUtc</td>
                                                        <td>@item.LogCount</td>
                                                        <td style="width:100px">
                                                            @if (item.LogCount > 0)
                                                            {
                                                                <button class="proctoring-action-btn" type="button" onclick="ProctoringSessionLogsDetails('@item.Id')">Report</button>
                                                            }
                                                            else
                                                            {
                                                                <span>No Logs</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Common/_ProctoringSessionLogsDetails.cshtml")
<script>
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>
