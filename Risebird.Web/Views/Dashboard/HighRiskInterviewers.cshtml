@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "HighRiskInterviewers";
}
<script>
    var Header = "<div>High Risk Interviewers</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
    </style>

<div class="main-panel" id="main-panel">
    <div>
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">BlackList Company</h4></div>
                    </div>
                    <div class="pull-right client-ms">
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                         <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Skill Channel ID</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Mobile Number</th>
                                                <th>Red Markers</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Resume</th>
                                            </tr>
                                           </thead>
                                           <tfoot>
                                            <tr>
                                                <th>Skill Channel ID</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Mobile Number</th>
                                                <th>Red Markers</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Resume</th>
                                            </tr>
                                           </tfoot>
                                           <tbody>

                                              @if (Model != null && Model.Count() > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        <td>@item.interviewer</td>
                                                        <td style="padding:0px 7px;">
                                                            <span class="call-area">
                                                                @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                {
                                                                    <span data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CommonCallButtonClick('@item.candidateName', '@item.MobileNumber', '@item.candidateEmail','@item.imid')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="20" /></span>
                                                                }
                                                            </span>
                                                            @item.MobileNumber
                                                        </td>
                                                        @if (@item.interviewer != null || @item.interviewer != "")
                                                        {
                                                            <td style="color:red"><d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">@item.RedMarker</d></td>
                                                        }
                                                        else
                                                        {
                                                            <td style="color:red">@item.RedMarker</td>
                                                        }

                                                        <td>@item.candidateName</td>
                                                        <td>@item.candidateEmail</td>
                                                        @if (item.ResumeLink != null && item.ResumeLink != "")
                                                            {
                                                                <td>

                                                                <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td>No Resume</td>
                                                            }
                                                    </tr>
                                                }
                                            }
                                           </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->
        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
<div id="InterviewerInsightsModel" class="modal modal-bg" style="z-index:3">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document" style="max-width: 1050px !important;">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-lightbulb" viewBox="0 0 16 16"> <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z" fill="white"></path> </svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Insights </h5><p style="float:right"><span style="position:relative;top:14px;font-size:13px;padding:5px;font-weight:bold">Last Login:</span><span class="candidatename-sla" id="hidlastlogin" style="position:relative;top:1px;font-size:14px;"></span></p><span class="candidatename-sla" id="txtheaderInsights" style="margin-right:25px;"></span>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeInterviewerInsightsModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="divInsightsmodel">
            </div>
        </div>
    </div>
</div>
<script src="~/js/TwilioCallMaker.js"></script>
<script>
    $(document).ready(function () {
        applyDataTable();
        //$('#detailsTable').DataTable();
    });

    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }

    function InsightsDetails(interviewer) {
        $.ajax({
            url: '/Interviewer/InterviewerInsights',
            data: { 'interviewer': interviewer },
            type: "GET",
            success: function (data) {
                openInterviewerInsightsModel();
                $('#divInsightsmodel').html('');
                $('#divInsightsmodel').html(data);
                $("#txtheaderInsights").text('( ' + interviewer + ' )');
                $('#hidlastlogin').text($('#LastLogin').val());
            }
        });
    }
    function closeInterviewerInsightsModel() {
        var modal = document.getElementById("InterviewerInsightsModel");
        modal.style.display = "none";
    }
    function openInterviewerInsightsModel() {
        var modal = document.getElementById("InterviewerInsightsModel");
        modal.style.display = "block";
    }
</script>
