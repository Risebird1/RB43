<script>

    function searchResult() {
        $('#unconfirmedCandidatesTable').DataTable();
    }
    function RefreshSearch() {
        $('#unconfirmedCandidatesTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
            var table = $('#unconfirmedCandidatesTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            order: [[1, 'desc']]
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#unconfirmedCandidatesTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#unconfirmedCandidatesTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    }
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#unconfirmedCandidatesTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function Cancelinvite(id, interviewdate, CandidateEmail, IRFid, skillChannelName, zoomMeetingId, elementId) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Interview for " + CandidateEmail + " under skill channel " + skillChannelName + " dated " + interviewdate + " will be cancelled! Cancelled meetings cannot be confirmed back.",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel it!',
            cancelButtonText: "Don't",
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/CancelInterviewV2',
                        type: 'POST',
                        data: { 'interviewId': id, 'interviewDate': interviewdate, 'candidateEmail': CandidateEmail, 'IRFId': IRFid, 'zoomMeetingId': zoomMeetingId },
                        success: function (data) {
                            if (data != null && data.toLowerCase().includes('success')) {
                                resolve(data);

                            }
                            else {
                                swal.fire("Error cancelling!", "Please try again", "error");

                            }

                        }
                    });

                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Cancelled!',
                    type: 'success',
                    html: '<p>Meeting cancelled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    //window.location = "/IRF/Index";
                    //location.reload(true);
                    document.getElementById(elementId).style.display = "none";
                })

            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Aborted!',
                    'Meeting remains confirmed! :)',
                    'error'
                )
            }
        })


    }
</script>
