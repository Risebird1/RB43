@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "RedoRequest";
}
<script>
    var Header = "<div>Redo Request</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
</style>
<div class="main-panel" id="main-panel">


    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">

                    <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Redo Request</h4></div>
                </div>
                <div class="pull-right client-ms">
                    @if(ViewBag.ReturnBack==1)
                    {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    }
                    else{
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                    </button>
                    }
                </div>

            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>

                        <div style="overflow-x:scroll" class="scrollbar">
                            <div id="tableID" class="second">
                                <table id="redoRequestTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                    <thead>
                                        <tr>
                                            <th>Action</th>
                                            <th>Skill Channel ID</th>
                                            <th>Interview Date</th>
                                            <th>Candidate Details</th>
                                            <th>Interviewer</th>
                                           
                                            <th>Channel Owner</th>
                                            <th>Created On</th>
                                            <th>Created By</th>
                                            <th>Channel Owner</th>
                                           
                                        </tr>
                                    </thead>
                                    <tfoot>
                                        <tr>
                                            <th>Action</th>
                                            <th>Skill Channel ID</th>
                                            <th>Interview Date</th>
                                            <th>Candidate Details</th>
                                            <th>Interviewer</th>
                                            <th>Channel Owner</th>
                                            <th>Created On</th>
                                            <th>Created By</th>
                                            <th>Channel Owner</th>
                                           
                                        </tr>
                                    </tfoot>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <button class="btn shadow btn-xs sharp me-1 feedbackreportbtn" aria-label="Payment SLA" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">

                                                        <div style="width: 30px;height: 30px;cursor:pointer; display: inline-block;border-radius: 100%;line-height: 32px;" onClick="PaymentComplianceDetails('@item.Interviewid','Candidate')"><svg style="color: white;position:relative;top:-8px;left:-1px;" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg><svg style="color: white;position:relative;top:1px;left:-11px" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M2 8C2 7.44772 2.44772 7 3 7H21C21.5523 7 22 7.44772 22 8C22 8.55228 21.5523 9 21 9H3C2.44772 9 2 8.55228 2 8Z" fill="white"></path> <path d="M2 12C2 11.4477 2.44772 11 3 11H21C21.5523 11 22 11.4477 22 12C22 12.5523 21.5523 13 21 13H3C2.44772 13 2 12.5523 2 12Z" fill="white"></path> <path d="M3 15C2.44772 15 2 15.4477 2 16C2 16.5523 2.44772 17 3 17H15C15.5523 17 16 16.5523 16 16C16 15.4477 15.5523 15 15 15H3Z" fill="white"></path> </svg></div>

                                                    </button>
                                                    <span>
                                                        <button class="btn shadow btn-xs sharp me-1" aria-label="Approve RedoInterviews" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                            <span onclick="approvedRedoInterviews('@item.id');" title="Approve RedoInterviews" class="mdc-fab__icon touch">
                                                                <img src="~/img/approve-blk.png" width="18" />
                                                            </span>
                                                        </button>
                                                    </span>
                                                    <a target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.id, irfId=item.irfIntId})" style="text-decoration:none;">
                                                        <button class="btn shadow btn-xs sharp me-1" aria-label="Client Interview Report" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                            <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg style="position:relative;left:-1px;top:-1px" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                        </button>
                                                    </a>
                                                    <button class="btn shadow btn-xs sharp me-1 feedbackreportbtn" aria-label="ReDo Reject Interview" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                        <span onclick="OpenRedoFormModel('@item.id')" title="ReDo Reject Interview" class="mdc-fab__icon material-icons">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                                                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                                                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                                            </svg>
                                                        </span>
                                                    </button>
                                                </td>

                                                <td title=@item.IRFId> @item.IRFId </td>
                                                <td> @item.interviewDate </td>
                                                <td>
                                                    <div class="name-field"><b>@item.candidateName</b></div>
                                                    <span class="email-field" style="color:#676772!important"> <i class="fa fa-envelope" style="color: #F9A825;font-size: 14px;position:relative;top: 1px;margin-righT: 5px;margin-bottom:7px;"></i>@item.candidateEmail </span>
                                                    <div>
                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                    {
                                                    
                                                        <span aria-label="Click here to call the candidate">
                                                            <span onclick="CommonCallButtonClick('@item.candidateName','@item.MobileNumber', '@item.candidateEmail','@item.imid', null, 'Candidate')" data-original-title="Tooltip on top" title="Click here to call the candidate."><img src="/img/calling.png" width="17"></span>
                                                        </span>@item.MobileNumber
                                                    
                                                    }
                                                    else
                                                    {
                                                    
                                                    }
                                                    </div>
                                                </td>
                                                @if (@item.interviewer != null || @item.interviewer != "")
                                                {
                                                    @if (item.IsInterviewerOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.interviewer')"><span class="dot" style="background-color:green"></span>    @item.interviewer </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @item.interviewer
                                                        </td>
                                                    }
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                                
                                                <td>@item.ChannelOwner</td>

                                                @if (item.Createdon.HasValue)
                                                {
                                                    <td>@item.Createdon.Value</td>
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }
                                                <td>@item.CreatedBy</td>
                                                <td>@item.ChannelOwner</td>
                                                
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="RedoInterviewModel" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Redo Reject Interview</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeRedoInterviewModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" id="divredoInterview">
            </div>
        </div>
    </div>
</div>


<div id="RedoRequestInterviewModel" class="modal modal-bg" style="z-index:5">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Redo Interview</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeRedoRequestInterviewModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" id="divredoRequestInterview">
            </div>
        </div>
    </div>
</div>
<script>
    function approvedRedoInterviews(InterviewId) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to redo interview?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Redo!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Dashboard/ApprovedRedoInterviews',
                        data: { 'InterviewId': InterviewId },
                        type: "POST",
                        success: function (data) {
                            swal.fire(data).then(function () {
                                location.reload(true);
                            });
                        },
                        error: function () {
                            swal.fire("Error Redo!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Redo cancelled! :)',
                    'error'
                )
            }
        })
        //if (InterviewId != '') {
        //    $.ajax({
        //        url: '/Dashboard/ApprovedRedoInterviews',
        //        data: { 'InterviewId': InterviewId },
        //        type: "POST",
        //        success: function (data) {
        //            swal.fire(data).then(function () {
        //                location.reload(true);
        //            });
        //        }
        //    });
        //}
        //else {
        //    swal.fire("Please approved the Redo Interview.");
        //}
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#redoRequestTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
          "order": [[1, 'desc']],//order column in descending order.
           "columnDefs": [
          { "type": "date", "targets": [1] }
           ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>
<script>
    function OpenRedoFormModel(interviewid) {
        $.ajax({
            url: '/Interview/RejectRedoInterviewDetails',
            data: { 'interviewid': interviewid },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }
    function openRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "none";
    }
</script>

<script>
    function OpenRedoRequestFormModel(interviewid, interviewstatus, type) {
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { 'interviewid': interviewid, 'interviewstatus': interviewstatus, 'type': type },
            success: function (data) {
                $('#divredoRequestInterview').html('');
                $('#divredoRequestInterview').html(data);
                openRedoRequestInterviewModel();
            }
        });
    }
    function openRedoRequestInterviewModel() {
        var modal = document.getElementById("RedoRequestInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoRequestInterviewModel() {
        var modal = document.getElementById("RedoRequestInterviewModel");
        modal.style.display = "none";
    }
</script>
@await Html.PartialAsync("~/Views/Common/_PaymentCompliance.cshtml")