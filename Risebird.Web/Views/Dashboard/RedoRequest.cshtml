@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "RedoRequest";
}
<script>
    var Header = "<div>Redo Request</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
</style>
<div class="main-panel" id="main-panel">

       
<div class="pt30">
    <div class="col-md-12 nopad" style="margin:0px;">
        <div class="card-header bg-w clearfix">
            <div class="pull-left">

                <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                <h4 class="card-title"></h4>
                <div class="mobile-view"> <h4 class="card-title">Redo Request</h4></div>
            </div>
            <div class="pull-right client-ms">
                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                    <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                </button>
            </div>

        </div>
    </div>
</div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>

                        <div style="overflow-x:scroll" class="scrollbar">
<div id="tableID" class="second">
    <table id="redoRequestTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
        <thead>
            <tr>
                <th>Skill Channel ID</th>
                <th>Interview Date</th>
                <th>Candidate Name</th>
                
                <th>Interviewer</th>
                <th>Channel Owner</th>
                <th>Action</th>
             </tr>
                </thead>
                <tfoot>
            <tr>
                <th>Skill Channel ID</th>
                <th>Interview Date</th>
                <th>Candidate Name</th>
                
                <th>Interviewer</th>
                <th>Channel Owner</th>
                <th>Action</th>
            </tr>
                </tfoot>
                <tbody>
                     @foreach (var item in Model)
                      {
                    <tr>
                 
                    <td title=@item.IRFId> @item.IRFId </td>
                    <td> @item.interviewDate </td>
                    <td>@item.candidateName</td>
                    @if (@item.interviewer != null || @item.interviewer != "")
                    {
                        @if (item.IsInterviewerOnline == 1)
                        {
                            <td>
                                <a onclick="directopenChat('@item.interviewer')"><span class="dot" style="background-color:green"></span>    @item.interviewer </a>
                            </td>
                        }
                        else
                        {
                            <td>
                                @item.interviewer
                            </td>
                        }
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>@item.ChannelOwner</td>
                    <td>
                        <span>
                            <button class="mdc-fab app-fab--absolute " aria-label="Approve RedoInterviews">
                                <span onclick="approvedRedoInterviews('@item.id');" title="Approve RedoInterviews" class="mdc-fab__icon touch">
                                    <img src="~/img/approve-blk.png" width="18" />
                                </span>
                            </button>
                        </span>
                    </td>
                    </tr>
                     }
                </tbody>
                </table>
                </div>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
<script>
    function approvedRedoInterviews(InterviewId) {

        if (InterviewId != '') {
            $.ajax({
                url: '/Dashboard/ApprovedRedoInterviews',
                data: { 'InterviewId': InterviewId },
                type: "POST",
                success: function (data) {
                    swal.fire(data).then(function () {
                        location.reload(true);
                    });
                }
            });
        }
        else {
            swal.fire("Please approved the Redo Interview.");
        }
    }
    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#redoRequestTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>

