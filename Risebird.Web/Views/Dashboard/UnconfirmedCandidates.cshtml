    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="unconfirmedCandidatesTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Interviewer</th>
                                                    <th>Client</th>
                                                    <th>Channel Owner</th>
                                                    <th>Client HR</th>
                                                    <th>Call Candidate</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Interviewer</th>
                                                    <th>Client</th>
                                                    <th>Channel Owner</th>
                                                    <th>Client HR</th>
                                                    <th>Call Candidate</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {

                                                        <tr>
                                                            @if (!string.IsNullOrEmpty(item.candidateName))
                                                            {
                                                                <td> @item.candidateName </td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }

                                                            
                                                            <td>@item.candidateEmail</td>
                                                            <td>@item.IRFId</td>
                                                            <td>@item.interviewDate</td>
                                                            @if (!string.IsNullOrEmpty(item.interviewer))
                                                            {
                                                                <td> @item.interviewer </td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                            <td>@item.Client</td>
                                                            <td>@item.ChannelOwner</td>
                                                            @if(!string.IsNullOrEmpty(item.ClientHrContact))
                                                            {
                                                                <td>@item.ClientHrContact</td>
                                                            }
                                                            else
                                                            {
                                                                 <td>@item.ClientHRAttemptContact</td>

                                                            }
                                                            
                                                            <td style="padding:0px 7px;">
                                                                <span class="call-area">
                                                                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                                    {
                                                                        <span data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="CommonCallButtonClick('@item.candidateName', '@item.MobileNumber', '@item.candidateEmail','@item.imid')" data-original-title="Tooltip on top"><img src="~/img/calling.png" width="18" /></span>
                                                                    }
                                                                </span>
                                                                @item.MobileNumber
                                                            </td>
                                                            <td>
                                                                @if (ViewBag.Profile == ProfileNames.Admin || ViewBag.Profile == ProfileNames.SupportAdmin || ViewBag.Profile == ProfileNames.SeniorHR)
                                                                {
                                                                    
                                                                    @if (item.MeetingStatusStatusDesc == "Scheduled")
                                                                    {
                                                                        <span class="call" id=@(item.imid + "_cancelInviteId") data-toggle="tooltip" data-placement="top" onclick="Cancelinvite(@item.imid,'@item.interviewDate','@item.candidateEmail','@item.irfIntId', '@item.IRFId', '@item.ZoomMeetingId', this.id)" data-original-title="Tooltip on top"><span class="btn-call trash-btn" style="cursor: pointer;position:relative;top:2px;width:25px!important;height:25px!important;" title="Cancel Interview"><span class="fal fa-times" style="font-size:14px;line-height:28px;animation: auto;"></span></span></span>

                                                                        <span class="call" data-toggle="tooltip" data-placement="top" onclick="CancelInviteAndReschedule(@item.imid,'@item.interviewDate','@item.candidateEmail','@item.irfIntId', '@item.IRFId', '@item.ZoomMeetingId', '@item.scheduleUniqueid')" data-original-title="Tooltip on top"><span class="btn-call" style="cursor: pointer;position:relative;top: -4px;width:25px!important;height:25px!important;background: #6cc6c1;" title="Cancel Interview and Schedule Interview"><i class="fas fa-calendar-alt" style="color:#fff;font-size: 12px;position:relative;top: 3px;left: 0px;" aria-hidden="true"></i><span class="fal fa-times" style="font-size: 9px;position: relative;animation:none;color: white;top: 5px;left: 1px;"></span></span></span>
                                                                    
                                                                    }
                                                                }
                                                                @if (ViewBag.Profile == ProfileNames.Admin || ViewBag.Profile == ProfileNames.SupportAdmin)
                                                                {
                                                                    <a style="text-decoration: none;" target="_blank" href="@Url.Action("Edit", "Candidate", new { id = item.CandidateId, irfName = item.IRFId, irfId = item.irfIntId })" title="Edit">
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Edit" style="position:relative;top:2px;width:24px!important;height:24px!important;">
                                                                            <span title="Edit" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" /></svg></span>
                                                                        </button>
                                                                    </a>

                                                                }

                                                                
                                                            </td>


                                                        </tr>


                                                    }
                                                }

                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>

    

   @await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
</div>

<script src="~/js/TwilioCallMaker.js"></script>
<script>

    function searchResult() {
        $('#unconfirmedCandidatesTable').DataTable();
    }
    function RefreshSearch() {
        $('#unconfirmedCandidatesTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 100);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
            var table = $('#unconfirmedCandidatesTable').DataTable({
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            order: [[1, 'desc']]
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");

        $(".dataTables_filter").keyup(function (e) {
            if ($('#txtmeeting_filter').val() == "") {
                $("#x").hide();
            }
            else {
                $("#x").show();
            }
        });
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
            //searchResult();
        });

    };

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#unconfirmedCandidatesTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#unconfirmedCandidatesTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    }
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#unconfirmedCandidatesTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    function Cancelinvite(id, interviewdate, CandidateEmail, IRFid, skillChannelName, zoomMeetingId, elementId) {

        swal.fire({
            title: 'Are you sure?',
            text: "The Interview for " + CandidateEmail + " under skill channel " + skillChannelName + " dated " + interviewdate + " will be cancelled! Cancelled meetings cannot be confirmed back.",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel it!',
            cancelButtonText: "Don't",
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Candidate/CancelInterviewV2',
                        type: 'POST',
                        data: { 'interviewId': id, 'interviewDate': interviewdate, 'candidateEmail': CandidateEmail, 'IRFId': IRFid, 'zoomMeetingId': zoomMeetingId },
                        success: function (data) {
                            if (data != null && data.toLowerCase().includes('success')) {
                                resolve(data);

                            }
                            else {
                                swal.fire("Error cancelling!", "Please try again", "error");

                            }

                        }
                    });

                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Cancelled!',
                    type: 'success',
                    html: '<p>Meeting cancelled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    //window.location = "/IRF/Index";
                    //location.reload(true);
                    document.getElementById(elementId).style.display = "none";
                })

            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Aborted!',
                    'Meeting remains confirmed! :)',
                    'error'
                )
            }
        })


    }
</script>
