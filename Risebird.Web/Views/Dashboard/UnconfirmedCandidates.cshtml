    function ReschuduleMeeting(interviewid, uniqueid, irfid, candidateEmailid) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Do you really want to cancel this meeting and reschedule?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, Reschedule!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/InterviewScheduler/GenerateCandidatescheuleLink',
                        method: 'POST',
                        data: {
                            'CandidateEmailid': candidateEmailid,
                            'interviewid': interviewid,
                            'uniqueid': uniqueid,
                            'Irfid': irfid,
                            'schedulertype': 2
                        },
                        success: function (result) {
                            window.open(result, '_blank');
                            resolve(result)
                        },
                        error: function () {
                            swal.fire("Error rescheduling!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                //location.reload(true);
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'reschedule cancelled! :)',
                    'error'
                )
            }
        })
    }

</script>
@if (new[] { "Admin", "SupportAdmin", "SeniorHR", "HR" }.Contains(Context.Session.GetString("profileName")?.Trim().Replace("\"", "")))
{
    @* Bulk send (C3 by email and / or WhatsApp) - shared modal, opened by Send reminders above. *@
    @await Html.PartialAsync("~/Views/Shared/_BulkSendModal.cshtml", new Risebird.Entities.ViewModel.BulkSendModalVM
    {
        ModalId = "sendRemindersModal",
        Title = "Send confirmation reminders",
        DateLabel = "Interview date",
        ButtonText = "Send reminders",
        ConfirmText = "Send the confirmation reminder to every candidate matching these filters?",
        Endpoint = Url.Action("SendNotConfirmedBulkReminders", "Dashboard"),
        SkillChannelIds = Model.Select(x => x.IRFId).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList()
    })
}
