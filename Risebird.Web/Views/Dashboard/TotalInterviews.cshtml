                                                    <th>Future Interviews</th>
                                                    <th>Deficit Meetings</th>
                                                    <th>Available</th>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Action</th>
                                                    <th>Interviewer</th>
                                                    <th>Resume</th>
                                                    <th>Company</th>
                                                    <th>Employed</th>
                                                    <th>Video KYC</th>
                                                    <th>Completed Interviews</th>
                                                    <th>Total Interviews</th>
                                                    <th>Total Selected Interviews</th>
                                                    <th>Total Rejected Interviews</th>
                                                    <th>Transcript Verdict</th>
                                                    <th>Future Assigned Interviews</th>
                                                    <th>Future Interviews</th>
                                                    <th>Deficit Meetings</th>
                                                    <th>Available</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @if (!string.IsNullOrWhiteSpace(item.interviewer))
                                                                {
                                                                    <span>
                                                                        <button class="mdc-fab app-fab--absolute " aria-label="Suspicious Interviwer">
                                                                            <span onclick="javascript:SuspiciousTypeDetails('@item.interviewer');" title="Suspicious Interviwer" class="mdc-fab__icon touch"><img width="17" src="/img/suspicious.png" /></span>
                                                                        </button>
                                                                    </span>

                                                                }
                                                            </td>
                                                            <td>
                                                                <c style="color:#0d6efd;text-decoration:underline;cursor:pointer" onclick="InsightsDetails('@item.interviewer')">@item.interviewer</c>
                                                            </td>
                                                            <td><a target="_blank" href="@item.ResumeLink">Resume</a></td>
                                                            <td>@item.CompanyName</td>
                                                            @if (item.IsEmployed)
                                                            {
                                                                <td>Yes</td>
                                                            }
                                                            else
                                                            {
                                                                <td>No</td>
                                                            }
                                                            <td>@item.VideoKYC</td>
                                                            <td><a target="_blank" href="@Url.Action("InterviewerStatsDetailsForClient", "Interviewer", new {userId = item.UserId, statType = StatsTypes.Completed, irfId = item.id, irfName = item.IRFId, interviewerEmailId = item.interviewer})">@item.TotalCompletedMeetings</a></td>
                                                            <td>@item.TotalInterview</td>
                                                            <td>@item.TotalSelectMeetings</td>
                                                            <td>@item.TotalRejectMeetings</td>
                                                            <td>@item.TranscriptVerdit</td>
                                                            <td>@item.SkillChannelFutureAssignedInterview</td>
                                                            <td>@item.TotalFuture</td>
                                                            <td>@item.TotalDeficitMeetings</td>
                                                            @if (item.Isavailable)
                                                            {
                                                                <td>Yes</td>
                                                            }
                                                            else
                                                            {
                                                                <td>No</td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("~/Views/Interviewer/_SuspiciousInterviewer.cshtml")
@await Html.PartialAsync("~/Views/Common/_InterviewerInsights.cshtml")
@await Html.PartialAsync("~/Views/IRF/UploadInterviewerResumePartial.cshtml")
<script src="~/js/common.js"></script>
<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>

<script>
    function ScreenInterviewer(jdTitle, irfId, irfName,userId,resumeLink, isRedo = false)
    {

       var actionUrl = "https://portal.risebird.io/AIScreener/ScreenInterviewer";

