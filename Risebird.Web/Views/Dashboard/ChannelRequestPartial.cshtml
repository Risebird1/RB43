@model Risebird.Entities.ViewModel.DashboardVM


<link rel="stylesheet" type="text/css" href="~/Newassets/css/jquery.mCustomScrollbar.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />
<div class="panel-body panel-body-table">
    @if (Model.ChannelRequest != null && Model.ChannelRequest.Count() != 0)
    {
        <div class="scrollbox">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th width="70%">Channel Request</th>
                            <th width="30%">Status</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model.ChannelRequest)
                        {
                            <tr>
                                <td title="@item.CreatedDate.ToString("dd_MM")_@item.Client _@item.PrimarySkill"><strong>@item.CreatedDate.ToString("dd_MM")_@item.Client _@item.PrimarySkill</strong></td>
                                <td onclick="location.href='@Url.Action("RequirementManagement","DashBoard")'" style="cursor: pointer;">@item.Status</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

    }

</div>

