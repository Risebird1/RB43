@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVideoKYCVM>
@{
    ViewData["Title"] = "InterviewerVideoKYC";
}
<script>
    var Header = "<div>Interviewer Video KYC</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
</style>

<div class="main-panel" id="main-panel">
    <div>
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">BlackList Company</h4></div>
                    </div>
                    <div class="pull-right client-ms">
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                @* <img src="~/Newassets/img/lazyload.gif" /> *@
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>IsActive</th>
                                                <th>Video</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>IsActive</th>
                                                <th>Video</th>
                                                <th>Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            @if (Model != null && Model.Count() > 0)
                                            {


                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            @item.Name
                                                        </td>
                                                        <td>
                                                            @item.EmailId
                                                        </td>
                                                        <td>
                                                            @if (item.IsActive)
                                                            {

                                                                <div>Yes</div>
                                                            }
                                                            else
                                                            {
                                                                <div>No</div>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.VideoLink != null && item.VideoLink != "")
                                                            {
                                                                @* @item.VideoLink *@
                                                             
                                                                    <video controls="controls" height="300px" width="300px">
                                                                    <source src="@item.VideoLink" />
                                                                    </video>
                                                                
                                                            }
                                                            else
                                                            {
                                                                <div>No Viedo  </div>

                                                            }
                                                        </td>
                                                        <td>
                                                            <span>
                                                                <button class="mdc-fab app-fab--absolute " aria-label="Approve Interviewer for video KYC">
                                                                    <span onclick="approvedVideoKYC('@item.Id','Approve');" title="Approve Interviewer for video KYC" class="mdc-fab__icon touch">
                                                                        <img src="~/img/approve-blk.png" width="18" />
                                                                    </span>
                                                                </button>
                                                                <button class="mdc-fab app-fab--absolute " aria-label="Re-Record video KYC">
                                                                    <span onclick="approvedVideoKYC('@item.Id','ReRecord');" title="Re-Record video KYC" class="mdc-fab__icon touch">
                                                                        <img src="~/img/approve-blk.png" width="18" />
                                                                    </span>
                                                                </button>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->

        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
<script>
    $(document).ready(function () {

        applyDataTable();
    });

    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }

    function approvedVideoKYC(id,type) {

        if (id != '' && type!='') {
            $.ajax({
                url: '/Dashboard/ApprovedInterviewerVideoKYC',
                data: { 'id': id,'type':type },
                type: "POST",
                success: function (data) {
                    swal.fire(data).then(function () {
                        location.reload(true);
                    });
                }
            });
        }
        else {
            swal.fire("Please approved for the interviewer video KYC.");
        }
    }
</script>