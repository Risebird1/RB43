@model IEnumerable<Risebird.Entities.ViewModel.InterviewerVideoKYCVM>
@{
    ViewData["Title"] = "InterviewerVideoKYC";
}
<script>
    var Header = "<div>Interviewer Video KYC</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
</style>

<div class="main-panel" id="main-panel">
    <div>
        <div class="mobile-view">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px 0px 10px 0px;padding:0px">
                <div class="card-header bg-w clearfix" style="padding:10px;">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <h4 class="card-title">BlackList Company</h4>
                    </div>
                   

                </div>
            </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                @* <img src="~/Newassets/img/lazyload.gif" /> *@
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Action</th>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>IsActive</th>
                                                <th>Video</th>
                                               
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Action</th>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>IsActive</th>
                                                <th>Video</th>
                                                
                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            @if (Model != null && Model.Count() > 0)
                                            {


                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <span>
                                                                <button class="btn shadow btn-xs sharp me-1" aria-label="Approve Interviewer for video KYC" style="width:24px;height:24px;background:#69d269">
                                                                    <span onclick="approvedVideoKYC('@item.Id','Approve');" title="Approve Interviewer for video KYC" class="mdc-fab__icon touch">
                                                                        <i class="fa fa-thumbs-up" style=" font-size: 12px;position: relative;top: -1px;color:#fff"></i>
                                                                    </span>
                                                                </button>
                                                                <button class="btn shadow btn-xs sharp me-1" aria-label="Re-Record video KYC" style="width:24px;height:24px;background: #e5a5a5;">
                                                                    <span onclick="approvedVideoKYC('@item.Id','ReRecord');" title="Re-Record video KYC" class="mdc-fab__icon touch">
                                                                        <svg style="color: white;position: relative;left: -2px;top: -1px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-record2" viewBox="0 0 16 16"> <path d="M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0 1A5 5 0 1 0 8 3a5 5 0 0 0 0 10z" fill="white"></path> <path d="M10 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" fill="white"></path> </svg>
                                                                    </span>
                                                                </button>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            @item.Name
                                                        </td>
                                                        <td>
                                                            @item.EmailId
                                                        </td>
                                                        <td>
                                                            @if (item.IsActive)
                                                            {

                                                                <div>Yes</div>
                                                            }
                                                            else
                                                            {
                                                                <div>No</div>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.VideoLink != null && item.VideoLink != "")
                                                            {
                                                                <a style="text-decoration:none;color:blue" target="_blank" onclick="javascript:OpenVideoKYCDetails('@item.VideoLink');">
                                                                    <button class="btn btn-link">
                                                                        <span style="font-size: 12px;">Video KYC link</span>
                                                                       </button>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <div>No Viedo  </div>

                                                            }
                                                        </td>
                                                       
                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->

        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>

<div id="VideoKYCModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span class="fa fa-video-camera" style="font-size:25px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="memberHeading">Video KYC</h5>
            </div>
            <button onclick="closeVideoKYCModal()" type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>
            <div class="modal-body" id="VideoKYCModal" style="overflow:auto;max-height:30vw">
                <video controls="controls" height="400px" width="500px" id="myVideo">
                    <source src="" />
                </video>

            </div>
           
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        applyDataTable();
        var params = new URLSearchParams(window.location.search);
        var email = params.get('email');
        if (email) {
            var table = $('#detailsTable').DataTable();
            table.search(email).draw();
        }
    });
    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }

    function approvedVideoKYC(id,type) {

        if (id != '' && type!='') {
            $.ajax({
                url: '/Dashboard/ApprovedInterviewerVideoKYC',
                data: { 'id': id,'type':type },
                type: "POST",
                success: function (data) {
                    swal.fire(data).then(function () {
                        location.reload(true);
                    });
                }
            });
        }
        else {
            swal.fire("Please approved for the interviewer video KYC.");
        }
    }
</script>
<script>
    function closeVideoKYCModal() {
        var modal = document.getElementById("VideoKYCModal");
       
        var videoElement = document.getElementById("myVideo");
        videoElement.pause();
        modal.style.display = "none";
    }

    function OpenVideoKYCDetails(VideoKYC) { 
        var modal = document.getElementById("VideoKYCModal");
       
        var videoElement = document.getElementById("myVideo");
        var sourceElement = videoElement.getElementsByTagName("source")[0];
        sourceElement.src = VideoKYC;

        // Load and play the video
        videoElement.load();
        videoElement.play();
        modal.style.display = "block";
    }
</script> 


