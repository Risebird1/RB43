@model IReadOnlyList<Risebird.Entities.ViewModel.IrfAuditDirectoryRowVm>
@{
    ViewData["Title"] = "IRF Audit Directory";
    var rows = Model ?? Array.Empty<Risebird.Entities.ViewModel.IrfAuditDirectoryRowVm>();
}
<script>
    var Header = "<div>IRF Audit Directory</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .irf-audit-dir { padding: 16px; }
    .irf-audit-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .irf-audit-table th, .irf-audit-table td { border-bottom: 1px solid #e2e8f0; padding: 8px 10px; text-align: left; }
    .irf-audit-table th { background: #f8fafc; font-size: 11px; text-transform: uppercase; color: #64748b; }
    .irf-audit-btn { appearance: none; border: 1px solid #cbd5e1; background: #fff; border-radius: 6px; padding: 4px 8px; font-size: 12px; cursor: pointer; margin-right: 4px; }
    .irf-audit-btn--primary { background: #42a5f5; border-color: #42a5f5; color: #fff; }
    #irfBackfillModal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 9999; align-items: center; justify-content: center; }
    #irfBackfillModal.is-open { display: flex; }
    .irf-backfill-card { background: #fff; border-radius: 8px; padding: 20px; width: 420px; max-width: 95vw; }
</style>

<div class="main-panel irf-audit-dir" id="main-panel">
    <div style="margin-bottom: 12px;">
        <button type="button" class="irf-audit-btn" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'">Back</button>
    </div>
    <p style="font-size: 13px; color: #475569; margin-bottom: 16px;">
        Per-IRF bad-quality flag backfill. Forward triggers set flags only (no auto-removal). Run backfill to populate historical suspicious/redo verdicts.
    </p>
    <div style="overflow-x: auto;">
        <table class="irf-audit-table">
            <thead>
                <tr>
                    <th>IRF</th>
                    <th>Completed (lifetime)</th>
                    <th>Completed (90d)</th>
                    <th>Pending flags</th>
                    <th>Last backfill</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr data-irf-id="@row.IrfId">
                        <td><strong>@row.IrfName</strong> <span style="color:#94a3b8;">(#@row.IrfId)</span></td>
                        <td>@row.TotalCompletedLifetime</td>
                        <td>@row.CompletedLast90Days</td>
                        <td class="pending-flags">@row.PendingFlagsCount</td>
                        <td>@(row.LastBackfillAtUtc?.ToString("u") ?? "—")</td>
                        <td>
                            <button type="button" class="irf-audit-btn irf-audit-btn--primary btn-backfill" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName">Backfill</button>
                            <a class="irf-audit-btn" href="/IRF/DeliveryHeadInstruction/@row.IrfId" target="_blank" rel="noopener">Open DM Approval</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="irfBackfillModal" aria-hidden="true">
    <div class="irf-backfill-card">
        <h3 style="margin-top:0;">Backfill flags — <span id="bfIrfName"></span></h3>
        <input type="hidden" id="bfIrfId" />
        <div style="margin-bottom: 10px;">
            <label>From (UTC)</label><br />
            <input type="date" id="bfFrom" />
        </div>
        <div style="margin-bottom: 10px;">
            <label>To (UTC)</label><br />
            <input type="date" id="bfTo" />
        </div>
        <p id="bfPreview" style="font-size: 13px; color: #334155; min-height: 40px;">Click Preview to see counts.</p>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button type="button" class="irf-audit-btn" id="bfPreviewBtn">Preview</button>
            <button type="button" class="irf-audit-btn irf-audit-btn--primary" id="bfRunBtn">Run backfill</button>
            <button type="button" class="irf-audit-btn" id="bfCloseBtn">Close</button>
        </div>
    </div>
</div>

<script>
    (function () {
        function defaultDates() {
            var to = new Date();
            var from = new Date();
            from.setDate(from.getDate() - 60);
            $('#bfTo').val(to.toISOString().slice(0, 10));
            $('#bfFrom').val(from.toISOString().slice(0, 10));
        }

        $('.btn-backfill').on('click', function () {
            $('#bfIrfId').val($(this).data('irf-id'));
            $('#bfIrfName').text($(this).data('irf-name'));
            $('#bfPreview').text('Click Preview to see counts.');
            defaultDates();
            $('#irfBackfillModal').addClass('is-open');
        });

        $('#bfCloseBtn').on('click', function () {
            $('#irfBackfillModal').removeClass('is-open');
        });

        $('#bfPreviewBtn').on('click', function () {
            var irfId = $('#bfIrfId').val();
            $.get('@Url.Action("GetPerIrfAutoQcBackfillPreview", "Dashboard")', {
                irfId: irfId,
                from: $('#bfFrom').val(),
                to: $('#bfTo').val()
            }).done(function (res) {
                if (!res.ok) {
                    $('#bfPreview').text(res.message || 'Preview failed.');
                    return;
                }
                $('#bfPreview').html(
                    res.verdictCount + ' suspicious/redo verdicts in this range.<br>' +
                    res.wouldFlagCount + ' interviewer-channel records would be flagged (excluding ' + res.alreadyFlaggedCount + ' already-flagged).');
            });
        });

        $('#bfRunBtn').on('click', function () {
            var irfId = $('#bfIrfId').val();
            var $btn = $(this).prop('disabled', true);
            $.post('@Url.Action("RunPerIrfAutoQcBackfill", "Dashboard")', {
                irfId: irfId,
                from: $('#bfFrom').val(),
                to: $('#bfTo').val()
            }).done(function (res) {
                alert(res.message || (res.ok ? 'Done' : 'Failed'));
                if (res.ok) {
                    var $row = $('tr[data-irf-id="' + irfId + '"]');
                    var cur = parseInt($row.find('.pending-flags').text(), 10) || 0;
                    $row.find('.pending-flags').text(cur + (res.newFlagsSet || 0));
                }
            }).always(function () { $btn.prop('disabled', false); });
        });
    })();
</script>
