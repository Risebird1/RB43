    .irf-ov-summary {
        display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center;
        margin: 0 0 12px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0;
        border-radius: 8px; font-size: 13px; color: #334155;
    }
    .irf-ov-summary__stat { font-weight: 600; color: #0f172a; }
    .irf-ov-summary__link {
        appearance: none; border: none; background: none; padding: 0; color: #2563eb;
        font-weight: 600; cursor: pointer; text-decoration: underline;
    }
    .irf-ov-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
    .irf-ov-coverage {
        display: inline-block; margin-left: 6px; padding: 1px 6px; border-radius: 4px;
        background: #fff7ed; border: 1px solid #fdba74; color: #9a3412; font-size: 10px; font-weight: 600;
    }
    .irf-ov-priority--critical { color: #b91c1c; font-weight: 700; }
    .irf-ov-priority--medium { color: #a16207; font-weight: 600; }
    .irf-ov-priority--low { color: #475569; }
    .irf-ov-priority--clear { color: #166534; }
    .irf-ov-channel-link { font-size: 11px; color: #2563eb; }
    #irfAuditInterviewersPane { display: none; }
    #irfAuditInterviewersPane.is-active { display: block; }
    #irfAuditChannelsPane.is-hidden { display: none; }

    /* ---- High-Risk interviewer cell: rules copied from wwwroot/Newassets/css/dm-approval-v4.css
       (DM colour variables resolved). The whole file is not linked because it would restyle IRF Audit. ---- */
    .dm-v4-iv-kyc { width: 24px; height: 24px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; padding: 5px; flex-shrink: 0; position: relative; box-sizing: border-box; }
    .dm-v4-iv-kyc svg { display: block; width: 100%; height: 100%; }
    .dm-v4-iv-kyc--btn { border: none; cursor: pointer; font-family: inherit; transition: box-shadow 0.12s, border-color 0.12s; text-decoration: none; }
    .dm-v4-iv-kyc--btn:hover { box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06); }
    .dm-v4-iv-kyc--ok { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .dm-v4-iv-kyc--warn { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .dm-v4-iv-kyc-badge { position: absolute; right: -3px; bottom: -3px; width: 11px; height: 11px; border-radius: 999px; background: #fff; display: inline-flex; align-items: center; justify-content: center; }
    .dm-v4-iv-kyc-badge__dot { width: 9px; height: 9px; border-radius: 999px; background: #15803d; color: #fff; display: inline-flex; align-items: center; justify-content: center; }
    .dm-v4-iv-meta { display: flex; flex-direction: column; gap: 2px; width: 100%; max-width: 260px; margin-top: 2px; }
    .dm-v4-iv-meta__line { font-size: 11px; line-height: 1.35; color: #475569; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; cursor: default; }
    .dm-v4-iv-meta__line--actions { display: inline-flex; align-items: center; gap: 4px; color: #94a3b8; font-size: 11px; line-height: 1.35; cursor: default; overflow: visible; }
    .dm-v4-iv-meta__future { font-size: 11px; color: #94a3b8; }
    .dm-v4-iv-meta__future .dm-v4-iv-future-count { font-size: 11px; font-weight: 500; color: #475569; }
    .dm-v4-iv-meta__sep { color: #94a3b8; opacity: 0.7; user-select: none; }
    .dm-v4-mono { font-family: 'IBM Plex Mono', Consolas, monospace; font-variant-numeric: tabular-nums; }
    .dm-v4-iv-insights-btn { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; padding: 0; border: 1px solid #dbe1ff; border-radius: 6px; background: #eef2ff; color: #4f46e5; cursor: pointer; line-height: 1; flex-shrink: 0; }
    .dm-v4-iv-insights-btn--inline { width: 18px; height: 18px; border-radius: 4px; }
    .dm-v4-iv-insights-btn:hover { border-color: #4f46e5; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08); }
    .dm-v4-iv-insights-btn--global .fa, .dm-v4-iv-insights-btn--channel .fa { font-size: 11px; }
    .dm-v4-iv-insights-btn--inline .fa { font-size: 10px; }
    .dm-v4-iv-cv-link { font-family: 'IBM Plex Mono', Consolas, monospace; font-size: 12px; font-weight: 600; color: #4f46e5 !important; text-decoration: none !important; }
    .dm-v4-iv-cv-link:hover { text-decoration: underline !important; }
    .dm-v4-iv-cv-link--resume { text-decoration: none; }
    .dm-v4-iv-manual-suspicious-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 6px; font-size: 10px; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; color: #92400e; background: #fffbeb; border: 1px solid #fcd34d; line-height: 1.2; }
    .dm-v4-iv-manual-suspicious-badge .fa { font-size: 11px; }
    .dm-v4-iv-outcomes { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .dm-v4-iv-outcomes__link { display: block; font-size: 11px; font-weight: 600; line-height: 1.35; color: #4f46e5; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dm-v4-iv-outcomes__link:hover { text-decoration: underline; }

    /* ---- High-Risk page additions ---- */
    .irf-ov-iv-name-row { display: flex; align-items: center; gap: 6px; }
    .irf-ov-iv-phone { font-size: 11px; color: #475569; display: flex; align-items: center; gap: 6px; margin-top: 2px; }
    .irf-ov-call { display: inline-flex; align-items: center; justify-content: center; width: 19px; height: 19px; border-radius: 50%; border: 1px solid #bfe8d2; background: #a5cfb9; color: #1f9d6b; font-size: 10px; cursor: pointer; padding: 0; }
    .irf-ov-call:hover { background: #1f9d6b; color: #fff; }
    .irf-ov-email-link { appearance: none; border: none; background: none; padding: 0; font-size: 11px; color: #2563eb; cursor: pointer; text-align: left; }
    .irf-ov-email-link:hover { text-decoration: underline; }
    .irf-ov-company { font-size: 11px; color: #475569; }
    .irf-ov-iv-links { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 3px; }
    .irf-ov-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
    .irf-ov-chip { display: inline-block; padding: 1px 6px; border-radius: 10px; font-size: 10px; font-weight: 600; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569; white-space: nowrap; }
    .irf-ov-chip--ok { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
    .irf-ov-chip--warn { background: #fffbeb; border-color: #fde68a; color: #92400e; }
    .irf-ov-chip--bad { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .irf-ov-ai { font-size: 11px; line-height: 1.4; color: #475569; white-space: nowrap; }
    .irf-ov-ai__count { font-weight: 700; color: #0f172a; font-size: 13px; }
    .irf-ov-ai__sub { color: #64748b; }
    .irf-ov-selrej { font-size: 11px; white-space: nowrap; }
    .irf-ov-ch-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 4px; }
    .irf-ov-reports-row > td { background: #f8fafc; }
    .irf-ov-verdict { font-size: 11px; font-weight: 600; }
    .irf-ov-review-checks { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
    .irf-ov-review-checks__label { font-size: 12px; color: #475569; margin-right: 4px; }

    /* ---- QC Tracking: status, coverage, three levels ---- */
    #irfAuditReportsPane { display: none; }
    #irfAuditReportsPane.is-active { display: block; }
    .irf-ov-qc { margin-top: 6px; }
    .irf-ov-qc-badge { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 10px; font-weight: 700; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569; }
    .irf-ov-qc-badge--1 { background: #fffbeb; border-color: #fde68a; color: #92400e; }
    .irf-ov-qc-badge--2 { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
    .irf-ov-qc-badge--3 { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
    .irf-ov-qc-meta { display: block; font-size: 10px; color: #64748b; margin-top: 2px; }
    .irf-ov-qc-btns { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
    .irf-ov-qc-btn { appearance: none; font-size: 10px; font-weight: 600; padding: 1px 7px; border-radius: 4px; border: 1px solid #93c5fd; background: #fff; color: #1d4ed8; cursor: pointer; }
    .irf-ov-qc-btn:hover { background: #eff6ff; }
    .irf-ov-qc-btn--danger { border-color: #fca5a5; color: #b91c1c; }
    .irf-ov-qc-btn--danger:hover { background: #fef2f2; }
    .irf-ov-cov { margin-top: 6px; padding: 5px 7px; border-radius: 6px; background: #f8fafc; border: 1px solid #e2e8f0; font-size: 11px; color: #475569; line-height: 1.45; max-width: 280px; }
    .irf-ov-cov__line { white-space: normal; }
    .irf-ov-cov__label { color: #64748b; }
    .irf-ov-cov--stale { border-color: #fecaca; background: #fef2f2; }
    .irf-ov-cov__red { color: #b91c1c; font-weight: 700; }
    .irf-ov-process { margin-top: 4px; font-size: 11px; color: #475569; white-space: normal; }
    .irf-ov-process__n { appearance: none; border: none; background: none; padding: 0 1px; font-size: 11px; font-weight: 700; color: #2563eb; cursor: pointer; text-decoration: underline; }
    .irf-ov-impact { font-weight: 700; color: #0f172a; }
    .irf-ov-impact__sub { display: block; font-size: 10px; color: #64748b; font-weight: 400; }
    .irf-ov-trend--up { color: #b91c1c; font-weight: 700; }
    .irf-ov-trend--down { color: #166534; font-weight: 700; }
    .irf-ov-trend--flat { color: #64748b; }
    .irf-ov-removed { font-size: 11px; color: #b91c1c; margin-top: 3px; }
    .irf-ov-red { color: #b91c1c; font-weight: 700; }
    .irf-ov-hl { background: #fef2f2; color: #b91c1c; font-weight: 700; padding: 0 3px; border-radius: 3px; }
    .irf-rp-filters { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 10px; }
    .irf-rp-chip { appearance: none; padding: 3px 10px; border-radius: 14px; border: 1px solid #cbd5e1; background: #fff; font-size: 12px; color: #334155; cursor: pointer; }
    .irf-rp-chip.is-on { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .irf-rp-scope { font-size: 12px; color: #475569; }
    .irf-rp-flag { display: inline-block; margin: 1px 3px 1px 0; padding: 0 6px; border-radius: 8px; font-size: 10px; font-weight: 600; background: #fffbeb; border: 1px solid #fde68a; color: #92400e; white-space: nowrap; }
    .irf-rp-status--none { color: #b91c1c; font-weight: 700; }
    .irf-rp-status--done { color: #166534; font-weight: 600; }
    .irf-rp-disagree { display: inline-block; margin-top: 3px; padding: 0 6px; border-radius: 8px; font-size: 10px; font-weight: 700; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
    .irf-rp-actions { display: flex; flex-wrap: wrap; gap: 4px; }
    .irf-rp-link { font-size: 11px; color: #2563eb; cursor: pointer; text-decoration: underline; appearance: none; border: none; background: none; padding: 0; }
</style>

<div class="main-panel irf-audit-dir" id="main-panel">

    <div class="irf-audit-header">

        <button type="button" class="irf-audit-btn" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'">Back</button>

        <h2 style="margin-top:12px;">IRF Audit</h2>

        <div class="irf-audit-tabs" role="tablist">
            <button type="button" class="irf-audit-btn@(activeAuditView != "interviewers" ? " is-active" : "")" id="tabChannels" data-view="channels">Channels</button>
            <button type="button" class="irf-audit-btn@(activeAuditView == "interviewers" ? " is-active" : "")" id="tabInterviewers" data-view="interviewers">High-Risk Interviewers</button>
            <button type="button" class="irf-audit-btn@(activeAuditView == "reports" ? " is-active" : "")" id="tabReports" data-view="reports">Reports</button>
        </div>

        <div class="irf-audit-header__row">

            <p id="irfAuditChannelsBlurb">Active skill channels with completed interviews in the selected period. Use <strong>Backfill</strong> to grade every completed interview in the page window (P0–P5), then review interviewers with Keep / Remove. Channel owners (HR / SeniorHR) see only their IRFs.</p>
            <p id="irfAuditInterviewersBlurb" style="display:none;">Interviewers with elevated risk across channels in the selected window: at least 3 completed interviews, and 25% or more bad or any P0. Tick <strong>Show all</strong> to include everyone, including interviewers with fewer than 3 interviews. Expand a person to act per channel (same Keep/Remove as the channel view). Owners see only their channels.</p>
            <p id="irfAuditReportsBlurb" style="display:none;">Every graded report (P0–P5) in the selected window across your channels: worst and not yet reviewed first, oldest first. Review each report (Payment SLA, Redo, QC form, Suspicious); an AI ≠ QC disagreement is flagged for a second look. Owners see only their channels.</p>

            @if (rows.Any())

            {

                <div class="irf-audit-search">

                    <div class="irf-audit-search__box">

                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>

                        <input type="search" id="irfAuditSearch" class="irf-audit-search__input" placeholder="Search IRF or channel owner..." autocomplete="off" />

                    </div>

                    <button type="button" class="irf-audit-btn" id="irfAuditSearchClear" style="display:none;">Clear</button>

                </div>

            }

        </div>

        <p class="irf-audit-filter__range">Showing active skill channels with completed interviews from <strong>@directoryFromIst</strong> to <strong>@directoryToIst</strong> (IST).</p>

        <form id="irfDirectoryFilter" class="irf-audit-filter" method="get" action="@Url.Action("AutoRemovalMonitor", "Dashboard")">
            <input type="hidden" name="view" id="dirViewHidden" value="@activeAuditView" />
            <input type="hidden" name="needsCall" id="dirNeedsCallHidden" value="@(ViewBag.NeedsCall == true ? "1" : "0")" />

            <div class="irf-audit-filter__presets">

                <span class="irf-audit-filter__label">Period</span>

                <button type="submit" name="preset" value="1w" class="irf-audit-btn@(directoryPreset == "1w" ? " is-active" : "")">1 week</button>

                <button type="submit" name="preset" value="1m" class="irf-audit-btn@(directoryPreset == "1m" ? " is-active" : "")">1 month</button>

                <button type="submit" name="preset" value="2m" class="irf-audit-btn@(directoryPreset == "2m" ? " is-active" : "")">2 months</button>

            </div>

            <div class="irf-audit-filter__custom">

                <div class="irf-audit-filter__field">

                    <label for="dirFrom">From (IST)</label>

                    <input type="date" id="dirFrom" name="from" value="@directoryFromIst" />

                </div>

                <div class="irf-audit-filter__field">

                    <label for="dirTo">To (IST)</label>

                    <input type="date" id="dirTo" name="to" value="@directoryToIst" />

                </div>

                <button type="submit" class="irf-audit-btn irf-audit-btn--primary" id="dirApplyCustom">Apply range</button>

            </div>

            <p class="irf-audit-filter__hint">Custom range cannot exceed 90 days. Only active skill channels (current contract) with at least one completed interview in the period are listed.</p>

        </form>

        @if (rows.Any())
        {
            var owners = rows
                .Select(r => string.IsNullOrWhiteSpace(r.ChannelOwnerDisplay) ? (r.ChannelOwnerEmail ?? "") : r.ChannelOwnerDisplay)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
            <div class="irf-audit-owner-filter">
                <label for="irfOwnerFilter">Channel Owner</label>
                <select id="irfOwnerFilter">
                    <option value="">All owners</option>
                    @foreach (var owner in owners)
                    {
                        <option value="@owner">@owner</option>
                    }
                </select>
            </div>
        }

    </div>



    <div id="irfAuditChannelsPane" class="@(activeAuditView == "interviewers" ? "is-hidden" : "")">

    @if (!string.IsNullOrWhiteSpace(directoryError))

    {

        <div class="irf-audit-alert irf-audit-alert--error">

            <strong>Could not load IRF directory.</strong> @directoryError

        </div>

    }

    else if (!rows.Any())

    {

        <div class="irf-audit-alert irf-audit-alert--info">

            No active skill channels with completed interviews were found for the selected date range.

        </div>

    }



    <div class="irf-audit-table-wrap">

        <table class="irf-audit-table">

            <thead>

                <tr>

                    <th style="width:40px;"></th>

                    <th>IRF</th>

                    <th>Channel Owner</th>

                    <th>Completed (lifetime)</th>

                    <th>Completed (window)</th>

                    <th>Suspicious/redo (window)</th>

                    <th>Pending flags</th>

                    <th>Last backfill</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var row in rows)

                {

                    var pendingClass = row.PendingFlagsCount > 0 ? "pending-flags" : "pending-flags is-zero";

                    <tr data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" data-channel-owner="@(row.ChannelOwnerDisplay ?? row.ChannelOwnerEmail ?? "")" class="irf-audit-main-row">

                        <td>

                            <button type="button" class="irf-audit-expand btn-view-interviewers" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" aria-expanded="false" title="View interviewers">View</button>

                        </td>

                        <td><strong>@row.IrfName</strong> <span style="color:#94a3b8;">(#@row.IrfId)</span></td>

                        <td>@(string.IsNullOrWhiteSpace(row.ChannelOwnerDisplay) ? (string.IsNullOrWhiteSpace(row.ChannelOwnerEmail) ? "—" : row.ChannelOwnerEmail) : row.ChannelOwnerDisplay)</td>

                        <td>@row.TotalCompletedLifetime</td>

                        <td>@row.CompletedLast90Days</td>

                        <td class="@(row.SuspiciousRedoLast90Days > 0 ? "pending-flags" : "pending-flags is-zero")">@row.SuspiciousRedoLast90Days</td>

                        <td class="@pendingClass">@row.PendingFlagsCount</td>

                        <td class="irf-last-backfill">@FormatLastBackfill(row)</td>

                        <td>

                            <button type="button" class="irf-audit-btn irf-audit-btn--primary btn-risk-backfill" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" title="Grade all completed interviews in the selected page window">Backfill</button>

                            <button type="button" class="irf-audit-btn btn-backfill" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" data-suspicious-90d="@row.SuspiciousRedoLast90Days" title="Backfill AutoQc suspicious/redo flags only">QC flags</button>

                            <a class="irf-audit-btn" href="/IRF/DeliveryHeadInstruction?irfid=@row.IrfId" target="_blank" rel="noopener">Open DM Approval</a>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

        <div id="irfAuditSearchEmpty" class="irf-audit-search-empty">No IRFs match your search.</div>

        <div id="irfAuditPagination" class="irf-audit-pagination" aria-label="IRF directory pagination">

            <span id="irfAuditPageInfo"></span>

            <div class="irf-audit-pagination__btns" id="irfAuditPageBtns"></div>

        </div>

    </div>

    </div><!-- /#irfAuditChannelsPane -->

    <div id="irfAuditInterviewersPane" class="@(activeAuditView == "interviewers" ? "is-active" : "")">
        <div class="irf-ov-toolbar">
            <label style="font-size:12px;display:flex;align-items:center;gap:6px;">
                <input type="checkbox" id="ovShowAll" /> Show all (lift default risk filter and the 3-interview minimum)
            </label>
            <label style="font-size:12px;display:flex;align-items:center;gap:6px;" title="High-Risk interviewers with no connected call (answered, at least the minimum talk time) in the window">
                <input type="checkbox" id="ovNeedsCall" @(ViewBag.NeedsCall == true ? "checked" : "") /> Needs a call
            </label>
            <label style="font-size:12px;display:flex;align-items:center;gap:6px;" title="Impact = bad interviews weighted by severity (P0 = 5, P1 = 3, P2 = 2, P3–P5 = 1)">
                Sort
                <select id="ovSortBy" style="font-size:12px;">
                    <option value="Impact">Impact (bad × severity)</option>
                    <option value="Ratio">Worst severity, then ratio</option>
                </select>
            </label>
            <button type="button" class="irf-audit-btn irf-audit-btn--primary" id="ovRefreshBtn">Refresh</button>
            <a class="irf-audit-btn" id="ovExportBtn" href="#">Export to Excel</a>
        </div>
        <div id="ovSummary" class="irf-ov-summary" style="display:none;"></div>
        <div id="ovBody" class="irf-audit-table-wrap">
            <div class="irf-risk-loading" style="padding:16px;">Loading high-risk interviewers…</div>
        </div>
        <div id="ovPagination" class="irf-audit-pagination" aria-label="Interviewer overview pagination"></div>
    </div>

    @* Report level (QC Tracking Delta 4): one row per graded report, actions on every row. *@
    <div id="irfAuditReportsPane" class="@(activeAuditView == "reports" ? "is-active" : "")">
        <div class="irf-rp-filters" id="rpFilters">
            <button type="button" class="irf-rp-chip" data-key="NotReviewed">Not reviewed</button>
            <button type="button" class="irf-rp-chip" data-key="P0P1">P0–P1 only</button>
            <button type="button" class="irf-rp-chip" data-key="AiQcDisagree" title="AI penalised but the QC save is 0%, or the reverse">AI ≠ QC</button>
            <button type="button" class="irf-rp-chip" data-key="HasProcessFlags">Has process flags</button>
            <span class="irf-rp-scope" id="rpScope"></span>
