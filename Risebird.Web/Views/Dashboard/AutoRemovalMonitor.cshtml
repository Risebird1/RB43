<div class="main-panel irf-audit-dir" id="main-panel">

    <div class="irf-audit-header">

        <button type="button" class="irf-audit-btn" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'">Back</button>

        <h2 style="margin-top:12px;">IRF Audit Directory</h2>

        <div class="irf-audit-header__row">

            <p>Active skill channels with completed interviews in the selected period. Use <strong>Backfill</strong> to grade every completed interview in the page window (P0–P5), then review interviewers with Keep / Remove. Channel owners (HR / SeniorHR) see only their IRFs.</p>

            @if (rows.Any())

            {

                <div class="irf-audit-search">

                    <div class="irf-audit-search__box">

                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>

                        <input type="search" id="irfAuditSearch" class="irf-audit-search__input" placeholder="Search IRF or channel owner..." autocomplete="off" />

                    </div>

                    <button type="button" class="irf-audit-btn" id="irfAuditSearchClear" style="display:none;">Clear</button>

                </div>

            }

        </div>

        <p class="irf-audit-filter__range">Showing active skill channels with completed interviews from <strong>@directoryFromIst</strong> to <strong>@directoryToIst</strong> (IST).</p>

        <form id="irfDirectoryFilter" class="irf-audit-filter" method="get" action="@Url.Action("AutoRemovalMonitor", "Dashboard")">

            <div class="irf-audit-filter__presets">

                <span class="irf-audit-filter__label">Period</span>

                <button type="submit" name="preset" value="1w" class="irf-audit-btn@(directoryPreset == "1w" ? " is-active" : "")">1 week</button>

                <button type="submit" name="preset" value="1m" class="irf-audit-btn@(directoryPreset == "1m" ? " is-active" : "")">1 month</button>

                <button type="submit" name="preset" value="2m" class="irf-audit-btn@(directoryPreset == "2m" ? " is-active" : "")">2 months</button>

            </div>

            <div class="irf-audit-filter__custom">

                <div class="irf-audit-filter__field">

                    <label for="dirFrom">From (IST)</label>

                    <input type="date" id="dirFrom" name="from" value="@directoryFromIst" />

                </div>

                <div class="irf-audit-filter__field">

                    <label for="dirTo">To (IST)</label>

                    <input type="date" id="dirTo" name="to" value="@directoryToIst" />

                </div>

                <button type="submit" class="irf-audit-btn irf-audit-btn--primary" id="dirApplyCustom">Apply range</button>

            </div>

            <p class="irf-audit-filter__hint">Custom range cannot exceed 90 days. Only active skill channels (current contract) with at least one completed interview in the period are listed.</p>

        </form>

        @if (rows.Any())
        {
            var owners = rows
                .Select(r => string.IsNullOrWhiteSpace(r.ChannelOwnerDisplay) ? (r.ChannelOwnerEmail ?? "") : r.ChannelOwnerDisplay)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
            <div class="irf-audit-owner-filter">
                <label for="irfOwnerFilter">Channel Owner</label>
                <select id="irfOwnerFilter">
                    <option value="">All owners</option>
                    @foreach (var owner in owners)
                    {
                        <option value="@owner">@owner</option>
                    }
                </select>
            </div>
        }

    </div>



    @if (!string.IsNullOrWhiteSpace(directoryError))

    {

        <div class="irf-audit-alert irf-audit-alert--error">

            <strong>Could not load IRF directory.</strong> @directoryError

        </div>

    }

    else if (!rows.Any())

    {

        <div class="irf-audit-alert irf-audit-alert--info">

            No active skill channels with completed interviews were found for the selected date range.

        </div>

    }



    <div class="irf-audit-table-wrap">

        <table class="irf-audit-table">

            <thead>

                <tr>

                    <th style="width:40px;"></th>

                    <th>IRF</th>

                    <th>Channel Owner</th>

                    <th>Completed (lifetime)</th>

                    <th>Completed (window)</th>

                    <th>Suspicious/redo (window)</th>

                    <th>Pending flags</th>

                    <th>Last backfill</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var row in rows)

                {

                    var pendingClass = row.PendingFlagsCount > 0 ? "pending-flags" : "pending-flags is-zero";

                    <tr data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" data-channel-owner="@(row.ChannelOwnerDisplay ?? row.ChannelOwnerEmail ?? "")" class="irf-audit-main-row">

                        <td>

                            <button type="button" class="irf-audit-expand btn-view-interviewers" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" aria-expanded="false" title="View interviewers">View</button>

                        </td>

                        <td><strong>@row.IrfName</strong> <span style="color:#94a3b8;">(#@row.IrfId)</span></td>

                        <td>@(string.IsNullOrWhiteSpace(row.ChannelOwnerDisplay) ? (string.IsNullOrWhiteSpace(row.ChannelOwnerEmail) ? "—" : row.ChannelOwnerEmail) : row.ChannelOwnerDisplay)</td>

                        <td>@row.TotalCompletedLifetime</td>

                        <td>@row.CompletedLast90Days</td>

                        <td class="@(row.SuspiciousRedoLast90Days > 0 ? "pending-flags" : "pending-flags is-zero")">@row.SuspiciousRedoLast90Days</td>

                        <td class="@pendingClass">@row.PendingFlagsCount</td>

                        <td class="irf-last-backfill">@FormatLastBackfill(row)</td>

                        <td>

                            <button type="button" class="irf-audit-btn irf-audit-btn--primary btn-risk-backfill" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" title="Grade all completed interviews in the selected page window">Backfill</button>

                            <button type="button" class="irf-audit-btn btn-backfill" data-irf-id="@row.IrfId" data-irf-name="@row.IrfName" data-suspicious-90d="@row.SuspiciousRedoLast90Days" title="Backfill AutoQc suspicious/redo flags only">QC flags</button>

                            <a class="irf-audit-btn" href="/IRF/DeliveryHeadInstruction?irfid=@row.IrfId" target="_blank" rel="noopener">Open DM Approval</a>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

        <div id="irfAuditSearchEmpty" class="irf-audit-search-empty">No IRFs match your search.</div>

        <div id="irfAuditPagination" class="irf-audit-pagination" aria-label="IRF directory pagination">

            <span id="irfAuditPageInfo"></span>

            <div class="irf-audit-pagination__btns" id="irfAuditPageBtns"></div>

        </div>

    </div>

</div>



<div id="irfBackfillModal" aria-hidden="true" role="dialog" aria-labelledby="bfModalTitle">

    <div class="irf-backfill-card">

        <div class="irf-backfill-card__head">

            <h3 id="bfModalTitle">Backfill bad-quality flags</h3>

            <div class="sub">IRF: <strong id="bfIrfName"></strong> <span id="bfIrfIdLabel"></span></div>

            <div class="sub" id="bfDirectoryHint" style="margin-top:6px;display:none;"></div>

        </div>

        <div class="irf-backfill-card__body">

            <input type="hidden" id="bfIrfId" />

            <div class="irf-backfill-dates">

                <div>

                    <label for="bfFrom">From (IST date)</label>

                    <input type="date" id="bfFrom" />

                </div>

                <div>

                    <label for="bfTo">To (IST date)</label>

                    <input type="date" id="bfTo" />

                </div>

            </div>

            <div id="bfPreview" class="irf-backfill-preview">

                Select a date range — preview loads automatically.

            </div>

        </div>

        <div class="irf-backfill-card__foot">

            <button type="button" class="irf-audit-btn" id="bfReset90Btn">Last 90 days (IST)</button>

            <button type="button" class="irf-audit-btn" id="bfPreviewBtn">Refresh preview</button>

            <button type="button" class="irf-audit-btn irf-audit-btn--primary" id="bfRunBtn" disabled>Run backfill</button>

            <button type="button" class="irf-audit-btn" id="bfCloseBtn">Close</button>

        </div>

    </div>

</div>



<div id="irfToast" class="irf-toast" role="status"></div>



<script>

    (function () {

        var previewUrl = '@Url.Action("GetPerIrfAutoQcBackfillPreview", "Dashboard")';

        var runUrl = '@Url.Action("RunPerIrfAutoQcBackfill", "Dashboard")';

        var previewTimer = null;

        var lastPreviewOk = false;

        var previewRequest = null;

        var directorySuspicious90d = 0;



        function istDateString(d) {

            return d.toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });

        }



        function defaultDates() {

            var today = new Date();

            $('#bfTo').val(istDateString(today));

            var from = new Date(today);

            from.setDate(from.getDate() - 90);

            $('#bfFrom').val(istDateString(from));

        }



        function setPreviewLoading() {

            lastPreviewOk = false;

            $('#bfRunBtn').prop('disabled', true);

            $('#bfPreview').removeClass('is-error').addClass('is-loading')

                .html('Loading preview counts…');

        }



        function renderPreview(res) {

            var $preview = $('#bfPreview');

            $preview.removeClass('is-loading');



            if (!res || !res.ok) {

                $preview.addClass('is-error');

                $preview.html((res && res.message) ? res.message : 'Preview request failed. Check network or sign in again.');

                lastPreviewOk = false;

                $('#bfRunBtn').prop('disabled', true);

                return;

            }



            lastPreviewOk = true;

            $preview.removeClass('is-error');

            var html =

                '<div class="irf-backfill-stat"><span class="irf-backfill-stat__num">' + res.verdictCount + '</span>' +

                '<span class="irf-backfill-stat__text"><strong>suspicious / redo</strong> verdicts in this date range.</span></div>' +

                '<div class="irf-backfill-stat"><span class="irf-backfill-stat__num">' + res.wouldFlagCount + '</span>' +

                '<span class="irf-backfill-stat__text"><strong>interviewer-channel records</strong> would be flagged (excluding ' + res.alreadyFlaggedCount + ' already flagged).</span></div>';



            if (res.unmappedVerdictCount > 0) {

                html += '<div class="irf-backfill-stat"><span class="irf-backfill-stat__num irf-backfill-stat__num--warn">' + res.unmappedVerdictCount + '</span>' +

                    '<span class="irf-backfill-stat__text">verdict(s) could not be mapped to a TransInterviewer on this IRF (no flag will be set for those).</span></div>';

            }



            if (res.verdictCount === 0) {

                if (res.qcMergedInRangeCount > 0) {

                    html += '<div style="margin-top:8px;font-size:12px;color:#b45309;">' + res.qcMergedInRangeCount +

                        ' merge(s) in range; none marked <strong>Suspicious</strong> or <strong>Redo</strong>. Only those verdicts qualify for backfill.</div>';

                } else if (directorySuspicious90d > 0) {

                    html += '<div style="margin-top:8px;font-size:12px;color:#b45309;">The directory shows <strong>' + directorySuspicious90d +

                        '</strong> suspicious/redo verdict(s) in the last 90 days, but your selected date range only includes <strong>0</strong> QC merges. Widen the <strong>From</strong> date (try “Last 90 days”) to match the directory window.</div>';

                } else {

                    html += '<div style="margin-top:8px;font-size:12px;color:#64748b;">No QC merges (QCDone=1) for this IRF in the selected date range. Widen the range or confirm the QC AI merge job has run for this IRF.</div>';

                }

            } else if (res.wouldFlagCount === 0 && res.verdictCount > 0 && res.unmappedVerdictCount === 0 && res.alreadyFlaggedCount > 0) {

                html += '<div style="margin-top:8px;font-size:12px;color:#64748b;">All mapped verdicts in range are already flagged.</div>';

            }



            if (res.oldestVerdictDate && res.newestVerdictDate) {

                html += '<div style="margin-top:4px;font-size:11px;color:#64748b;">Verdict dates in range: ' + res.oldestVerdictDate + ' → ' + res.newestVerdictDate + '</div>';

            }



            if (res.fromIst && res.toIst) {

                html += '<div style="margin-top:8px;font-size:11px;color:#64748b;">Range applied: ' + res.fromIst + ' → ' + res.toIst + ' (IST, inclusive)</div>';

            }



            $preview.html(html);

            $('#bfRunBtn').prop('disabled', res.verdictCount === 0);

        }



        function loadPreview() {

            var irfId = $('#bfIrfId').val();

            if (!irfId) return;



            if (previewRequest && previewRequest.readyState !== 4) {

                previewRequest.abort();

            }



            setPreviewLoading();

            previewRequest = $.ajax({

                url: previewUrl,

                method: 'GET',

                timeout: 300000,

                data: {

                    irfId: irfId,

                    from: $('#bfFrom').val(),

                    to: $('#bfTo').val()

                }

            }).done(renderPreview).fail(function (xhr, status) {

                if (status === 'abort') return;

                var message = 'Preview failed (' + (xhr.status || status || 'network error') + ').';

                if (status === 'timeout') {

                    message = 'Preview timed out after 5 minutes. Deploy the latest usp_GetPerIrfAutoQcBackfillPreview and Indexes/AutoQcBackfillPerformanceIndexes.sql on the database, then retry.';

                }

                renderPreview({ ok: false, message: message });

            });

        }



        function schedulePreview() {

            clearTimeout(previewTimer);

            previewTimer = setTimeout(loadPreview, 350);

        }



        function showToast(message, isOk) {

            var $t = $('#irfToast');

            $t.removeClass('irf-toast--ok irf-toast--err').addClass(isOk ? 'irf-toast--ok' : 'irf-toast--err')

                .text(message).addClass('is-show');

            setTimeout(function () { $t.removeClass('is-show'); }, 6000);

        }



        $('.btn-backfill').on('click', function () {

            var irfId = $(this).data('irf-id');

            var irfName = $(this).data('irf-name');

            directorySuspicious90d = Number($(this).data('suspicious-90d')) || 0;

            $('#bfIrfId').val(irfId);

            $('#bfIrfName').text(irfName);

            $('#bfIrfIdLabel').text('(#' + irfId + ')');

            if (directorySuspicious90d > 0) {

                $('#bfDirectoryHint').show().text('Directory: ' + directorySuspicious90d + ' suspicious/redo verdict(s) in the last 90 days (IST).');

            } else {

                $('#bfDirectoryHint').hide().text('');

            }

            defaultDates();

            $('#irfBackfillModal').addClass('is-open');

            loadPreview();

        });



        $('#bfReset90Btn').on('click', function () {

            defaultDates();

            loadPreview();

        });



        $('#bfCloseBtn, #irfBackfillModal').on('click', function (e) {

            if (e.target === this) $('#irfBackfillModal').removeClass('is-open');

        });

        $('.irf-backfill-card').on('click', function (e) { e.stopPropagation(); });



        $('#bfPreviewBtn').on('click', loadPreview);

        $('#bfFrom, #bfTo').on('change', schedulePreview);



        $('#bfRunBtn').on('click', function () {

            if (!lastPreviewOk) return;

            var irfId = $('#bfIrfId').val();

            var $btn = $(this).prop('disabled', true);

            $.post(runUrl, {

                irfId: irfId,

                from: $('#bfFrom').val(),

                to: $('#bfTo').val()

            }).done(function (res) {

                showToast(res.message || (res.ok ? 'Backfill complete.' : 'Backfill failed.'), !!res.ok);

                if (res.ok) {

                    setTimeout(function () { location.reload(); }, 1200);

                } else {

                    $btn.prop('disabled', false);

                }

            }).fail(function (xhr) {

                showToast('Backfill request failed (' + (xhr.status || 'network error') + ').', false);

                $btn.prop('disabled', false);

            });

        });



        var IRF_AUDIT_PAGE_SIZE = 30;

        var irfAuditCurrentPage = 1;

        var irfAuditSearchTerm = '';
        var irfOwnerFilterVal = '';

        var $irfAuditRows = $('.irf-audit-table tbody tr.irf-audit-main-row');



        function getIrfAuditMatchedRows() {

            return $irfAuditRows.filter(function () {

                var $row = $(this);

                var name = ($row.attr('data-irf-name') || '').toString().toLowerCase();

                var owner = ($row.attr('data-channel-owner') || '').toString().toLowerCase();

                if (irfOwnerFilterVal && owner !== irfOwnerFilterVal) return false;

                if (!irfAuditSearchTerm) return true;

                return name.indexOf(irfAuditSearchTerm) >= 0 || owner.indexOf(irfAuditSearchTerm) >= 0;

            });

        }



        function applyIrfAuditSearch() {

            irfAuditSearchTerm = ($('#irfAuditSearch').val() || '').trim().toLowerCase();

            irfOwnerFilterVal = ($('#irfOwnerFilter').val() || '').trim().toLowerCase();

            irfAuditCurrentPage = 1;

            $('#irfAuditSearchClear').toggle(irfAuditSearchTerm.length > 0);

            renderIrfAuditPagination();

        }



        function renderIrfAuditPagination() {

            var $matched = getIrfAuditMatchedRows();

            var total = $matched.length;

            var $bar = $('#irfAuditPagination');

            var $info = $('#irfAuditPageInfo');

            var $btns = $('#irfAuditPageBtns');

            var $empty = $('#irfAuditSearchEmpty');



            $irfAuditRows.hide();$('.irf-risk-detail-row').hide();

            $empty.toggleClass('is-visible', total === 0 && (irfAuditSearchTerm.length > 0 || irfOwnerFilterVal.length > 0) && $irfAuditRows.length > 0);



            if (total === 0) {

                $bar.removeClass('is-visible');

                return;

            }



            var totalPages = Math.max(1, Math.ceil(total / IRF_AUDIT_PAGE_SIZE));

            if (irfAuditCurrentPage > totalPages) irfAuditCurrentPage = totalPages;

            if (irfAuditCurrentPage < 1) irfAuditCurrentPage = 1;



            var start = (irfAuditCurrentPage - 1) * IRF_AUDIT_PAGE_SIZE;

            $matched.slice(start, start + IRF_AUDIT_PAGE_SIZE).show();



            if (total <= IRF_AUDIT_PAGE_SIZE) {

                $bar.removeClass('is-visible');

                return;

            }



            var first = start + 1;

            var last = Math.min(start + IRF_AUDIT_PAGE_SIZE, total);

            $info.text('Showing ' + first + '–' + last + ' of ' + total);



            var html = '';

            html += '<button type="button" class="irf-audit-btn irf-audit-pg-prev"' + (irfAuditCurrentPage <= 1 ? ' disabled' : '') + ' aria-label="Previous page">&lsaquo;</button>';



            var windowSize = 5;

            var startPage = Math.max(1, irfAuditCurrentPage - Math.floor(windowSize / 2));

            var endPage = Math.min(totalPages, startPage + windowSize - 1);

            startPage = Math.max(1, endPage - windowSize + 1);



            for (var p = startPage; p <= endPage; p++) {

                html += '<button type="button" class="irf-audit-btn irf-audit-pg' + (p === irfAuditCurrentPage ? ' is-active' : '') + '" data-page="' + p + '">' + p + '</button>';

            }



            html += '<button type="button" class="irf-audit-btn irf-audit-pg-next"' + (irfAuditCurrentPage >= totalPages ? ' disabled' : '') + ' aria-label="Next page">&rsaquo;</button>';

            $btns.html(html);

            $bar.addClass('is-visible');

        }



        $(document).on('click', '.irf-audit-pg', function () {

            var page = parseInt($(this).data('page'), 10);

            if (!page || page === irfAuditCurrentPage) return;

            irfAuditCurrentPage = page;

            renderIrfAuditPagination();

        });



        $(document).on('click', '.irf-audit-pg-prev', function () {

            if (irfAuditCurrentPage > 1) {

                irfAuditCurrentPage--;

                renderIrfAuditPagination();

            }

        });



        $(document).on('click', '.irf-audit-pg-next', function () {

            var totalPages = Math.ceil(getIrfAuditMatchedRows().length / IRF_AUDIT_PAGE_SIZE);

            if (irfAuditCurrentPage < totalPages) {

                irfAuditCurrentPage++;

                renderIrfAuditPagination();

            }

        });



        $('#irfAuditSearch').on('input', applyIrfAuditSearch);

        $('#irfOwnerFilter').on('change', applyIrfAuditSearch);



        $('#irfAuditSearchClear').on('click', function () {

            $('#irfAuditSearch').val('');

            applyIrfAuditSearch();

        });



        renderIrfAuditPagination();



        var dirMonitorUrl = '@Url.Action("AutoRemovalMonitor", "Dashboard")';



        function parseIsoDate(s) {

            if (!s) return null;

            var parts = s.split('-');

            if (parts.length !== 3) return null;

            return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));

        }



        function daysBetween(from, to) {

            return Math.round((to - from) / (24 * 60 * 60 * 1000));

        }



        $('#irfDirectoryFilter').on('submit', function (e) {

            var $form = $(this);

            var submitter = e.originalEvent && e.originalEvent.submitter;

            var isPreset = submitter && submitter.name === 'preset';



            if (isPreset) {

                $form.find('input[name=from], input[name=to]').prop('disabled', true);

                return;

            }



            e.preventDefault();

            var fromVal = $('#dirFrom').val();

            var toVal = $('#dirTo').val();

            if (!fromVal || !toVal) {

                alert('Please select both From and To dates.');

                return;

            }

            var fromDate = parseIsoDate(fromVal);

            var toDate = parseIsoDate(toVal);

            if (!fromDate || !toDate) {

                alert('Invalid date format.');

                return;

            }

            if (fromDate > toDate) {

                alert('From date cannot be after To date.');

                return;

            }

            if (daysBetween(fromDate, toDate) > 90) {

                alert('Date range cannot exceed 90 days.');

                return;

            }

            var qs = '?from=' + encodeURIComponent(fromVal) + '&to=' + encodeURIComponent(toVal);


            window.location.href = dirMonitorUrl + qs;

        });

        var riskBreakdownUrl = '@Url.Action("IrfAuditInterviewerRisk", "Dashboard")';
        var riskRefreshUrl = '@Url.Action("RefreshIrfRiskCategory", "Dashboard")';
        var riskRemoveUrl = '@Url.Action("RemoveInterviewerFromIrfRiskAudit", "Dashboard")';
        var riskKeepUrl = '@Url.Action("KeepInterviewerOnIrfRiskAudit", "Dashboard")';
        var dirFromVal = '@directoryFromIst';
        var dirToVal = '@directoryToIst';
        var tplTranscript = @Html.Raw(Json.Serialize(tplTranscript));
        var tplReport = @Html.Raw(Json.Serialize(tplReport));
        var tplContradiction = @Html.Raw(Json.Serialize(tplContradiction));
        var tplTrialStats = @Html.Raw(Json.Serialize(tplTrialStats));

        function recClass(rec) {
            var r = (rec || '').toString().toLowerCase();
            if (r === 'remove') return 'irf-rec--remove';
            if (r === 'watch') return 'irf-rec--watch';
            if (r === 'ok') return 'irf-rec--ok';
            return 'irf-rec--insufficient';
        }

        function reviewBadge(state, by, at) {
            var s = (state || 'None').toString();
            if (s === 'Removed') return '<span class="irf-review-badge irf-review--removed" title="Removed from channel">Removed</span>';
            if (s === 'Kept') {
                var tip = 'Kept' + (by ? ' by ' + by : '') + (at ? ' on ' + fmtDate(at) : '');
                return '<span class="irf-review-badge irf-review--kept" title="' + esc(tip) + '">' + esc(tip) + '</span>';
            }
            if (s === 'NeedsReReview') return '<span class="irf-review-badge irf-review--needs" title="New bad interview after Keep">Needs re-review</span>';
            if (s === 'PendingReview') return '<span class="irf-review-badge irf-review--pending">Pending review</span>';
            return '<span class="irf-review-badge irf-review--none">—</span>';
        }

        function renderWindowQuality(q) {
            if (!q) return '';
            var total = Number(prop(q, 'totalCompleted', 'TotalCompleted') || 0);
            var bad = Number(prop(q, 'badInterviews', 'BadInterviews') || 0);
            var ratio = prop(q, 'badRatio', 'BadRatio');
            var pct = (ratio === null || ratio === undefined || ratio === '') ? '—' : (Number(ratio) * 100).toFixed(0);
            return '<div class="irf-window-quality">'
                + '<span class="irf-window-quality__label">Window quality:</span>'
                + '<span>' + total + ' completed · ' + bad + ' bad (' + pct + '%)</span>'
                + '<span class="irf-window-quality__chips">'
                + 'P0 ' + pBadge(0, prop(q, 'p0Count', 'P0Count'))
                + ' P1 ' + pBadge(1, prop(q, 'p1Count', 'P1Count'))
                + ' P2 ' + pBadge(2, prop(q, 'p2Count', 'P2Count'))
                + ' P3 ' + pBadge(3, prop(q, 'p3Count', 'P3Count'))
                + ' P4 ' + pBadge(4, prop(q, 'p4Count', 'P4Count'))
                + ' P5 ' + pBadge(5, prop(q, 'p5Count', 'P5Count'))
                + '</span></div>';
        }

        function pBadge(level, count) {
            var n = Number(count) || 0;
            var zero = n === 0 ? ' is-zero' : '';
            var clickable = n > 0 ? ' is-clickable' : '';
            return '<button type="button" class="irf-p-badge irf-p-badge--p' + level + zero + clickable + '"'
                + ' data-p-level="' + level + '"'
                + ' aria-label="P' + level + ': ' + n + '">' + n + '</button>';
        }

        function prop(obj, camel, pascal) {
            if (!obj) return undefined;
            if (obj[camel] !== undefined) return obj[camel];
            return obj[pascal];
        }

        function formatRatio(v) {
            if (v === null || v === undefined || v === '') return '—';
            var n = Number(v);
            if (isNaN(n)) return '—';
            return (n * 100).toFixed(0) + '%';
        }

        function fmtDate(v) {
            if (!v) return '—';
            try {
                var d = new Date(v);
                if (isNaN(d.getTime())) return String(v);
                return d.toISOString().slice(0, 10);
            } catch (e) { return String(v); }
        }

        function esc(s) {
            return $('<div>').text(s == null ? '' : String(s)).html();
        }

        function detailsForTrans(details, transId) {
            if (!details || !details.length) return [];
            return details.filter(function (d) {
                return Number(prop(d, 'transInterviewerId', 'TransInterviewerId')) === Number(transId);
            });
        }

        function renderSeverityGroups(detailsForIv, focusLevel) {
            if (!detailsForIv || !detailsForIv.length) {
                return '<div class="irf-risk-empty">No description / breakdown for this interviewer in range.</div>';
            }
            var bySev = {};
            detailsForIv.forEach(function (d) {
                var sev = (prop(d, 'severity', 'Severity') || '').toUpperCase();
                if (!sev) return;
                if (!bySev[sev]) bySev[sev] = [];
                bySev[sev].push(d);
            });
            var order = ['P0', 'P1', 'P2', 'P3', 'P4', 'P5'];
            var totalShown = 0;
            order.forEach(function (sev) {
                var list = bySev[sev];
                if (!list || !list.length) return;
                if (focusLevel != null && ('P' + focusLevel) !== sev) return;
                totalShown += list.length;
            });
            var html = '<div class="irf-sev-panel-title">'
                + '<h4 class="irf-sev-panel-title__main">Description &amp; Severity Breakdown</h4>'
                + '</div>'
                + '<p class="irf-sev-panel-title__sub">Interview-level risk reasons and check-level P grades'
                + (totalShown ? ' · ' + totalShown + ' interview' + (totalShown === 1 ? '' : 's') : '')
                + '</p>'
                + '<div class="irf-sev-groups">';
            order.forEach(function (sev) {
                var list = bySev[sev];
                if (!list || !list.length) return;
                if (focusLevel != null && ('P' + focusLevel) !== sev) return;
                var level = sev.charAt(1);
                var n = list.length;
                html += '<div class="irf-sev-group" data-sev="' + sev + '">'
                    + '<div class="irf-sev-group__head">'
                    + '<div class="irf-sev-group__head-left">'
                    + pBadge(level, n)
                    + '<div class="irf-sev-group__title">'
                    + '<span class="irf-sev-group__title-main">Severity ' + sev + '</span>'
                    + '<span class="irf-sev-group__title-sub">Description and severity breakdown</span>'
                    + '</div></div>'
                    + '<span class="irf-sev-group__count">' + n + ' interview' + (n === 1 ? '' : 's') + '</span>'
                    + '</div>'
                    + '<table class="irf-sev-group__body"><thead><tr>'
                    + '<th style="width:90px;">Interview</th>'
                    + '<th style="width:100px;">Date</th>'
                    + '<th>Description</th>'
                    + '<th>Severity Breakdown</th>'
                    + '</tr></thead><tbody>';
                list.forEach(function (d) {
                    html += '<tr>'
                        + '<td class="irf-sev-id">#' + esc(prop(d, 'interviewId', 'InterviewId')) + '</td>'
                        + '<td class="irf-sev-date">' + esc(fmtDate(prop(d, 'interviewDate', 'InterviewDate'))) + '</td>'
                        + '<td class="irf-sev-meta">' + formatDescCell(prop(d, 'description', 'Description'), prop(d, 'severityBreakdown', 'SeverityBreakdown')) + '</td>'
                        + '<td class="irf-sev-br">' + esc(prop(d, 'severityBreakdown', 'SeverityBreakdown') || '—') + '</td>'
                        + '</tr>';
                });
                html += '</tbody></table></div>';
            });
            html += '</div>';
            return html;
        }

        function formatShortRange(fromStr, toStr) {
            function pretty(s) {
                if (!s) return '';
                var p = String(s).split('-');
                if (p.length !== 3) return s;
                var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                var m = months[parseInt(p[1], 10) - 1] || p[1];
                return String(parseInt(p[2], 10)) + ' ' + m;
            }
            return pretty(fromStr) + ' – ' + pretty(toStr);
        }

        function noShowLabel(description, breakdown) {
            var text = ((description || '') + ',' + (breakdown || '')).toLowerCase();
            var isFakeOrNoShow = text.indexOf('fake report') >= 0
                || text.indexOf('fakereport') >= 0
                || text.indexOf('no show') >= 0
                || text.indexOf('noshow') >= 0;
            if (!isFakeOrNoShow) return null;
            if (text.indexOf('interviewer no show') >= 0 || text.indexOf('interviewernoshow') >= 0) return 'Interviewer No Show';
            if (text.indexOf('candidate no show') >= 0 || text.indexOf('candidatenoshow') >= 0) return 'Candidate No Show';
            if (text.indexOf('no show') >= 0 || text.indexOf('noshow') >= 0) return 'No Show';
            return null;
        }

        function formatDescCell(description, breakdown) {
            var ns = noShowLabel(description, breakdown);
            var base = esc(description || '—');
            if (!ns) return base;
            return base + ' <span class="irf-noshow-tag" title="Fake Report detail">' + esc(ns) + '</span>';
        }

        function payReasonBadges(reasonsCsv) {
            if (!reasonsCsv) return '<span style="color:#94a3b8;font-size:11px;">—</span>';
            return String(reasonsCsv).split(',').filter(Boolean).map(function (r) {
                return '<span class="irf-pay-badge">' + esc(r.trim()) + '</span>';
            }).join(' ');
        }

        function aiLinks(worstId, irfId) {
            if (!worstId) return '<span style="color:#94a3b8;font-size:11px;">—</span>';
            var id = String(worstId);
            var irf = String(irfId || '');
            var transcript = String(tplTranscript).replace(/__INTERVIEW_ID__/g, encodeURIComponent(id)).replace(/__IRF_ID__/g, encodeURIComponent(irf));
            var report = String(tplReport).replace(/__INTERVIEW_ID__/g, encodeURIComponent(id));
            var contradiction = String(tplContradiction).replace(/__INTERVIEW_ID__/g, encodeURIComponent(id));
            return '<div class="irf-ai-links">'
                + '<a href="' + transcript + '" target="_blank" rel="noopener">Transcript</a>'
                + '<a href="' + report + '" target="_blank" rel="noopener">Report</a>'
                + '<a href="' + contradiction + '" target="_blank" rel="noopener">Contradiction</a>'
                + '</div>';
        }

        function trialStatsUrl(r, fromStr, toStr) {
            var irfId = prop(r, 'irfId', 'IrfId') || 0;
            var ivId = prop(r, 'userId', 'UserId') || prop(r, 'interviewerId', 'InterviewerId') || 0;
            var irfName = prop(r, 'irfName', 'IrfName') || '';
            var url = String(tplTrialStats)
                .replace(/__USER_ID__/g, encodeURIComponent(ivId))
                .replace(/__IRF_ID__/g, encodeURIComponent(irfId))
                .replace(/__IRF_NAME__/g, encodeURIComponent(irfName))
                .replace(/__FROM__/g, encodeURIComponent(fromStr || ''))
                .replace(/__TO__/g, encodeURIComponent(toStr || ''));
            return url;
        }

        function buildRiskSummary(row, fromStr, toStr) {
            var win = formatShortRange(fromStr || dirFromVal, toStr || dirToVal).replace(/\s/g, '');
            return 'RiskRatio=' + (prop(row,'riskRatio','RiskRatio') != null ? Number(prop(row,'riskRatio','RiskRatio')).toFixed(2) : 'n/a')
                + '; P0=' + (prop(row,'p0Count','P0Count') || 0)
                + ',P1=' + (prop(row,'p1Count','P1Count') || 0)
                + ',P2=' + (prop(row,'p2Count','P2Count') || 0)
                + ',P3=' + (prop(row,'p3Count','P3Count') || 0)
                + ',P4=' + (prop(row,'p4Count','P4Count') || 0)
                + ',P5=' + (prop(row,'p5Count','P5Count') || 0)
                + '; window ' + win;
        }

        function renderRiskTableRows(irfId, rows, details, fromStr, toStr, allowActions) {
            var html = '';
            rows.forEach(function (r) {
                var rec = prop(r,'recommendation','Recommendation') || 'InsufficientData';
                var reviewState = prop(r,'reviewState','ReviewState') || 'None';
                var canAct = allowActions && (reviewState === 'PendingReview' || reviewState === 'NeedsReReview' || rec === 'Remove' || rec === 'Watch');
                var transId = prop(r,'transInterviewerId','TransInterviewerId');
                var name = (prop(r,'interviewerCodedId','InterviewerCodedId') || prop(r,'interviewerEmail','InterviewerEmail') || ('#' + transId));
                var email = prop(r,'interviewerEmail','InterviewerEmail') || '';
                var ivDetails = detailsForTrans(details, transId);
                var completed = prop(r,'totalCompleted','TotalCompleted') || 0;
                var lifetime = prop(r,'lifetimeCompleted','LifetimeCompleted') || 0;
                var worstId = prop(r,'worstSeverityInterviewId','WorstSeverityInterviewId');
                var qcVerdict = prop(r,'qcMergeVerdict','QcMergeVerdict') || '—';
                var qcScore = prop(r,'qcMergeScore','QcMergeScore');
                var payTotal = prop(r,'paymentDeductionTotal','PaymentDeductionTotal') || 0;
                var payReasons = prop(r,'paymentDeductionReasons','PaymentDeductionReasons') || '';
                var summaryAttr = esc(buildRiskSummary(r, fromStr, toStr)).replace(/"/g, '&quot;');

                html += '<tr class="irf-risk-iv-row" data-trans-id="' + transId + '">'
                    + '<td><div class="irf-risk-iv-name">' + esc(name) + '</div>'
                    + (email ? '<div class="irf-risk-iv-email">' + esc(email) + '</div>' : '')
                    + '</td>'
                    + '<td class="col-num">'
                    + (completed > 0
                        ? '<a class="irf-completed-link" href="' + esc(trialStatsUrl(r, fromStr || dirFromVal, toStr || dirToVal)) + '" target="_blank" rel="noopener" title="Open in-window interviews">' + completed + '</a>'
                        : '0')
                    + '</td>'
                    + '<td class="col-num">' + lifetime + '</td>'
                    + '<td class="col-num">' + pBadge(0, prop(r,'p0Count','P0Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(1, prop(r,'p1Count','P1Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(2, prop(r,'p2Count','P2Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(3, prop(r,'p3Count','P3Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(4, prop(r,'p4Count','P4Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(5, prop(r,'p5Count','P5Count')) + '</td>'
                    + '<td>' + formatRatio(prop(r,'riskRatio','RiskRatio')) + '</td>'
                    + '<td><span class="irf-rec ' + recClass(rec) + '">' + esc(rec) + '</span></td>'
                    + '<td>' + reviewBadge(reviewState, prop(r,'reviewedBy','ReviewedBy'), prop(r,'reviewedAt','ReviewedAt')) + '</td>'
                    + '<td><div class="irf-qc-verdict irf-qc-' + esc(String(qcVerdict).toLowerCase()) + '">' + esc(qcVerdict) + '</div>'
                    + (qcScore != null && qcScore !== '' ? '<div class="irf-qc-score">Score ' + esc(qcScore) + '</div>' : '')
                    + '</td>'
                    + '<td>' + aiLinks(worstId, irfId) + '</td>'
                    + '<td><div class="irf-pay-total">' + (payTotal ? (payTotal + '%') : '—') + '</div>'
                    + payReasonBadges(payReasons) + '</td>'
                    + '<td class="irf-actions-cell">';
                if (canAct) {
                    html += '<button type="button" class="irf-audit-btn irf-audit-btn--danger btn-risk-remove"'
                        + ' data-trans-id="' + transId + '"'
                        + ' data-irf-id="' + irfId + '"'
                        + ' data-worst-id="' + (worstId || '') + '"'
                        + ' data-risk-summary="' + summaryAttr + '"'
                        + ' title="Remove from channel (inactivate)">Remove</button>'
                        + '<button type="button" class="irf-audit-btn btn-risk-keep"'
                        + ' data-trans-id="' + transId + '"'
                        + ' data-irf-id="' + irfId + '"'
                        + ' data-worst-id="' + (worstId || '') + '"'
                        + ' data-risk-summary="' + summaryAttr + '"'
                        + ' title="Keep — no action required">Keep</button>';
                } else {
                    html += '<span style="color:#94a3b8;font-size:11px;">—</span>';
                }
                html += '</td></tr>';
                html += '<tr class="irf-risk-sev-row" data-trans-id="' + transId + '" style="display:none;">'
                    + '<td colspan="16" class="irf-risk-detail-cell">'
                    + renderSeverityGroups(ivDetails, null)
                    + '</td></tr>';
            });
            return html;
        }

        function renderRiskRows(irfId, rows, removed, details, fromStr, toStr, quality, abortWarning) {
            var riskSum = 0;
            (rows || []).forEach(function (r) {
                riskSum += Number(prop(r,'riskInterviews','RiskInterviews') || 0);
            });
            var rangeLabel = formatShortRange(fromStr || dirFromVal, toStr || dirToVal);
            var html = '';
            if (abortWarning) {
                html += '<div class="irf-grading-abort">' + esc(abortWarning) + '</div>';
            }
            html += renderWindowQuality(quality);
            if ((!rows || !rows.length) && (!removed || !removed.length)) {
                html += '<div class="irf-risk-empty">No active interviewers on this IRF.</div>';
                return html;
            }
            if (riskSum === 0 && rows && rows.length) {
                html += '<div class="irf-risk-empty irf-risk-empty--warn">P0–P5 are 0 — no RiskCategory rows yet, or interviews are clean. Click <strong>Backfill</strong> / <strong>Refresh risk</strong> to grade the window.</div>';
            }
            if (rows && rows.length) {
                html += '<table class="irf-risk-table"><thead><tr>'
                    + '<th>Interviewer</th>'
                    + '<th class="col-num" title="Completed in selected window">Completed (' + esc(rangeLabel) + ')</th>'
                    + '<th class="col-num" title="Lifetime completed on this IRF (display only)">Lifetime</th>'
                    + '<th class="col-num">P0</th><th class="col-num">P1</th><th class="col-num">P2</th>'
                    + '<th class="col-num">P3</th><th class="col-num">P4</th><th class="col-num">P5</th>'
                    + '<th>Risk ratio</th><th>Recommendation</th><th>Review</th>'
                    + '<th>QC Merge</th><th>AI links</th><th>Payment deduction</th>'
                    + '<th>Actions</th></tr></thead><tbody>';
                html += renderRiskTableRows(irfId, rows, details, fromStr, toStr, true);
                html += '</tbody></table>';
            }
            if (removed && removed.length) {
                html += '<details class="irf-removed-section">'
                    + '<summary>Removed in this window (' + removed.length + ')</summary>'
                    + '<table class="irf-risk-table"><thead><tr>'
                    + '<th>Interviewer</th>'
                    + '<th class="col-num">Completed (' + esc(rangeLabel) + ')</th>'
                    + '<th class="col-num">Lifetime</th>'
                    + '<th class="col-num">P0</th><th class="col-num">P1</th><th class="col-num">P2</th>'
                    + '<th class="col-num">P3</th><th class="col-num">P4</th><th class="col-num">P5</th>'
                    + '<th>Risk ratio</th><th>Recommendation</th><th>Review</th>'
                    + '<th>QC Merge</th><th>AI links</th><th>Payment deduction</th>'
                    + '<th>Actions</th></tr></thead><tbody>';
                html += renderRiskTableRows(irfId, removed, details, fromStr, toStr, false);
                html += '</tbody></table></details>';
            }
            return html;
        }

        function loadRiskBreakdown($mainRow, force, abortWarning) {
            var irfId = $mainRow.data('irf-id');
            var $detail = $mainRow.next('.irf-risk-detail-row');
            if (!$detail.length) {
                $detail = $('<tr class="irf-risk-detail-row" data-parent-irf="' + irfId + '"><td colspan="9"><div class="irf-risk-panel">'
                    + '<div class="irf-risk-panel__head">'
                    + '<div class="irf-risk-panel__title">Active interviewers — risk by severity</div>'
                    + '<div>'
                    + '<button type="button" class="irf-audit-btn btn-refresh-risk" data-irf-id="' + irfId + '">Refresh risk</button>'
                    + '</div></div>'
                    + '<div class="irf-risk-body"><div class="irf-risk-loading">Loading…</div></div>'
                    + '</div></td></tr>');
                $mainRow.after($detail);
            } else {
                $detail.show();
                if (!force) {
                    if (abortWarning) {
                        var $body = $detail.find('.irf-risk-body');
                        $body.find('.irf-grading-abort').remove();
                        $body.prepend('<div class="irf-grading-abort">' + esc(abortWarning) + '</div>');
                    }
                    return;
                }
                $detail.find('.irf-risk-body').html('<div class="irf-risk-loading">Loading…</div>');
            }

            function fetchBreakdown() {
                $.getJSON(riskBreakdownUrl, { irfId: irfId, from: dirFromVal, to: dirToVal })
                    .done(function (res) {
                        if (!res || !res.ok) {
                            $detail.find('.irf-risk-body').html('<div class="irf-risk-error">' + ((res && res.message) || 'Failed to load risk breakdown.') + '</div>');
                            return;
                        }
                        $detail.find('.irf-risk-body').html(renderRiskRows(
                            irfId,
                            res.rows || [],
                            res.removed || [],
                            res.details || [],
                            res.from || dirFromVal,
                            res.to || dirToVal,
                            res.quality,
                            abortWarning || null));
                    })
                    .fail(function () {
                        $detail.find('.irf-risk-body').html('<div class="irf-risk-error">Failed to load risk breakdown.</div>');
                    });
            }
            fetchBreakdown();
        }

        $(document).on('click', '.irf-p-badge.is-clickable', function (e) {
            e.preventDefault();
            var level = $(this).data('p-level');
            var $ivRow = $(this).closest('tr.irf-risk-iv-row');
            var transId = $ivRow.data('trans-id');
            var $sev = $ivRow.nextAll('tr.irf-risk-sev-row[data-trans-id="' + transId + '"]').first();
            var opening = !$sev.is(':visible');
            $sev.toggle(opening);
            var $group = $sev.find('.irf-sev-group[data-sev="P' + level + '"]');
            $sev.find('.irf-sev-group').removeClass('is-focus');
            if (opening && $group.length) {
                $group.addClass('is-focus');
                try { $group[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (err) { }
            }
        });

        $(document).on('click', '.btn-view-interviewers', function () {
            var $btn = $(this);
            var $main = $btn.closest('tr.irf-audit-main-row');
            var open = $btn.hasClass('is-open');
            if (open) {
                $btn.removeClass('is-open').attr('aria-expanded', 'false').text('View');
                $main.next('.irf-risk-detail-row').hide();
                return;
            }
            $btn.addClass('is-open').attr('aria-expanded', 'true').text('Hide');
            loadRiskBreakdown($main, !$main.next('.irf-risk-detail-row').length);
        });

        $(document).on('click', '.btn-refresh-risk, .btn-risk-backfill', function () {
            var irfId = $(this).data('irf-id');
            var $btn = $(this);
            var isDirBackfill = $btn.hasClass('btn-risk-backfill');
            var origText = isDirBackfill ? 'Backfill' : 'Refresh risk';
            $btn.prop('disabled', true).text(isDirBackfill ? 'Backfilling…' : 'Refreshing…');
            function enableBtn() { $btn.prop('disabled', false).text(origText); }
            function postRefresh(ignoreMassFireGuard) {
                return $.post(riskRefreshUrl, {
                    irfId: irfId,
                    from: dirFromVal,
                    to: dirToVal,
                    ignoreMassFireGuard: !!ignoreMassFireGuard
                });
            }
            function toastFromResult(res) {
                if (!res) return 'Refresh failed.';
                if (res.aborted) return res.message || 'Grading aborted.';
                var parts = [];
                if (res.scanned != null) parts.push('scanned ' + res.scanned);
                if (res.insertedCount != null) parts.push('inserted ' + res.insertedCount);
                if (res.updated != null) parts.push('updated ' + res.updated);
                if (res.deleted != null) parts.push('deleted ' + res.deleted);
                if (res.skipped != null && res.skipped > 0) parts.push('skipped ' + res.skipped);
                if (res.syncUpdates != null) parts.push('sync ' + res.syncUpdates);
                return (res.message || (res.ok ? 'Risk refreshed.' : 'Refresh failed.'))
                    + (parts.length ? ' (' + parts.join(', ') + ')' : '');
            }
            function applyResult(res) {
                showToast(toastFromResult(res), !!(res && res.ok));
                if (res && res.lastBackfillLabel) {
                    $('tr.irf-audit-main-row[data-irf-id="' + irfId + '"] .irf-last-backfill').text(res.lastBackfillLabel);
                }
                var $main = $('tr.irf-audit-main-row[data-irf-id="' + irfId + '"]');
                var $view = $main.find('.btn-view-interviewers');
                if (!$view.hasClass('is-open')) {
                    $view.addClass('is-open').attr('aria-expanded', 'true').text('Hide');
                }
                loadRiskBreakdown($main, true, null);
            }
            postRefresh(false)
                .done(function (res) {
                    if (res && res.aborted) {
                        var abortMsg = 'grading aborted: ' + (res.abortedCheckName || 'check')
                            + (res.abortedFireRatePct != null ? ' fired on ' + Number(res.abortedFireRatePct).toFixed(0) + '%' : '');
                        var $main = $('tr.irf-audit-main-row[data-irf-id="' + irfId + '"]');
                        if ($main.next('.irf-risk-detail-row').length) {
                            loadRiskBreakdown($main, false, abortMsg + ' — ' + (res.message || ''));
                        }
                        var override = window.confirm(
                            (res.message || 'Mass-fire guard aborted this risk refresh.')
                            + '\n\nOverride the mass-fire guard and write anyway? Only after investigating the check.');
                        if (!override) {
                            showToast(abortMsg, false);
                            enableBtn();
                            return;
                        }
                        $btn.text('Overriding…');
                        postRefresh(true)
                            .done(applyResult)
                            .fail(function () { showToast('Risk refresh failed.', false); })
                            .always(enableBtn);
                        return;
                    }
                    applyResult(res);
                    enableBtn();
                })
                .fail(function () { showToast('Risk refresh failed.', false); enableBtn(); });
        });

        $(document).on('click', '.btn-risk-remove', function () {
            var $btn = $(this);
            var irfId = $btn.data('irf-id');
            var transId = $btn.data('trans-id');
            var worstId = $btn.data('worst-id') || null;
            var riskSummary = $btn.attr('data-risk-summary') || '';
            if (!confirm('Remove this interviewer from the channel (inactivate)? Writes RiskAuditRemoval. Recoverable — never a delete.')) return;
            var comment = prompt('Optional comment for the audit log:', '') || '';
            $btn.prop('disabled', true);
            $.post(riskRemoveUrl, {
                transInterviewerId: transId,
                irfId: irfId,
                comment: comment,
                riskSummary: riskSummary,
                worstSeverityInterviewId: worstId
            })
                .done(function (res) {
                    showToast((res && res.message) || (res && res.ok ? 'Removed.' : 'Remove failed.'), !!(res && res.ok));
                    if (res && res.ok) {
                        var $main = $('tr.irf-audit-main-row[data-irf-id="' + irfId + '"]');
                        loadRiskBreakdown($main, true);
                    } else {
                        $btn.prop('disabled', false);
                    }
                })
                .fail(function () {
                    showToast('Remove failed.', false);
                    $btn.prop('disabled', false);
                });
        });

        $(document).on('click', '.btn-risk-keep', function () {
            var $btn = $(this);
            var irfId = $btn.data('irf-id');
            var transId = $btn.data('trans-id');
            var worstId = $btn.data('worst-id') || null;
            var riskSummary = $btn.attr('data-risk-summary') || '';
            if (!confirm('Keep this interviewer — no channel change. Records RiskAuditKept for audit.')) return;
            var comment = prompt('Optional comment for the audit log:', '') || '';
            $btn.prop('disabled', true);
            $.post(riskKeepUrl, {
                transInterviewerId: transId,
                irfId: irfId,
                comment: comment,
                riskSummary: riskSummary,
                worstSeverityInterviewId: worstId
            })
                .done(function (res) {
                    showToast((res && res.message) || (res && res.ok ? 'Kept.' : 'Keep failed.'), !!(res && res.ok));
                    if (res && res.ok) {
                        var $main = $('tr.irf-audit-main-row[data-irf-id="' + irfId + '"]');
                        loadRiskBreakdown($main, true);
                    } else {
                        $btn.prop('disabled', false);
                    }
                })
                .fail(function () {
                    showToast('Keep failed.', false);
                    $btn.prop('disabled', false);
                });
        });

    })();

</script>

