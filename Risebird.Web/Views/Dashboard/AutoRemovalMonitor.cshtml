                        + (excluded ? ' Out of auto-approval.' : (suggest ? ' High upheld rate: consider taking it out of auto-approval.' : ''));
                    html += '<span class="irf-ov-chip' + (suggest ? ' irf-ov-chip--bad' : (excluded ? ' irf-ov-chip--warn' : '')) + '" title="' + esc(tip) + '">'
                        + esc(label) + ' ' + (rate != null && rate !== '' ? esc(rate + '%') : '—') + ' (' + upheld + '/' + decided + ')'
                        + (excluded ? ' · manual' : '') + '</span>';
