@model IReadOnlyList<Risebird.Entities.ViewModel.IrfAuditDirectoryRowVm>
@using Risebird.Entities.ViewModel

@{

    ViewData["Title"] = "IRF Audit Directory";

    var rows = Model ?? Array.Empty<Risebird.Entities.ViewModel.IrfAuditDirectoryRowVm>();

    var directoryError = ViewBag.DirectoryError as string;

    var directoryFromIst = ViewBag.DirectoryFromIst as string ?? "";

    var directoryToIst = ViewBag.DirectoryToIst as string ?? "";

    var directoryPreset = ViewBag.DirectoryPreset as string ?? "1m";
    // URL templates from shared helpers — JS fills __INTERVIEW_ID__ / __IRF_ID__
    var tplTranscript = TrialFlagDrillDownUrls.TranscriptQuality(111111111, 222222222)
        .Replace("111111111", "__INTERVIEW_ID__")
        .Replace("222222222", "__IRF_ID__");
    var tplReport = TrialFlagDrillDownUrls.ReportQuality(111111111)
        .Replace("111111111", "__INTERVIEW_ID__");
    var tplContradiction = TrialFlagDrillDownUrls.ContradictionReport(111111111)
        .Replace("111111111", "__INTERVIEW_ID__");
    var tplTrialStats = TrialFlagDrillDownUrls.TrialStats(111111111, 222222222, "__IRF_NAME__", "__FROM__", "__TO__")
        .Replace("111111111", "__USER_ID__")
        .Replace("222222222", "__IRF_ID__");
    string FormatIst(DateTime? utc)
    {
        if (!utc.HasValue) return "—";
        var utcDt = DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc);
        return utcDt.AddHours(5.5).ToString("yyyy-MM-dd HH:mm") + " IST";
    }

    string FormatLastBackfill(IrfAuditDirectoryRowVm row)
    {
        if (!string.IsNullOrWhiteSpace(row.LastBackfillLabel)) return row.LastBackfillLabel;
        var stamp = FormatIst(row.LastBackfillAtUtc);
        if (stamp == "—") return "—";
        if (row.LastRiskBackfillFromIst.HasValue && row.LastRiskBackfillToIst.HasValue)
            return stamp + " · " + row.LastRiskBackfillFromIst.Value.ToString("dd MMM") + "–" + row.LastRiskBackfillToIst.Value.ToString("dd MMM");
        return stamp;
    }

}

<script>

    var Header = "<div>IRF Audit Directory</div>";

    $('#txtpageHeader').empty().html(Header);

</script>



