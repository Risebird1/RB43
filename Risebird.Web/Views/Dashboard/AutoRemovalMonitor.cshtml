                + (revDecided > 0 ? ', upheld <span class="irf-ov-summary__stat">' + esc(fmtPct(revPct)) + '</span> of ' + revDecided + ' decided' : '')
                + (revAmt != null && revAmt !== '' && Number(revAmt) > 0 ? ', refunded ' + esc(fmtAmount(revAmt)) : '')
