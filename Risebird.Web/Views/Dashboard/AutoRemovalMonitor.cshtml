            // Deduction review requests from interviewers (My Quality), same window and channel scope.
            var revN = Number(prop(summary, 'reviewRequestsReceived', 'ReviewRequestsReceived') || 0);
            var revDecided = Number(prop(summary, 'reviewRequestsDecided', 'ReviewRequestsDecided') || 0);
            var revPct = prop(summary, 'reviewUpheldPct', 'ReviewUpheldPct');
            var revAmt = prop(summary, 'reviewRefundedAmount', 'ReviewRefundedAmount');
            html += '<span>·</span><span title="Interviewers\' requests to review a deduction, received in this window. Upheld = reduced or refunded, out of decided requests. Details: QC Activity → Review requests.">'
