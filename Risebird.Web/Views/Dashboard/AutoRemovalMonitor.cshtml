                if (st !== 1) html += '<button type="button" class="irf-ov-qc-btn btn-hr-status" data-iv="' + id + '" data-status="1" data-name="' + esc(name) + '">' + (st === 2 ? 'Under review again' : 'Under review') + '</button>';
                if (st !== 2) html += '<button type="button" class="irf-ov-qc-btn btn-hr-status" data-iv="' + id + '" data-status="2" data-name="' + esc(name) + '">Reviewed</button>';
                html += '<button type="button" class="irf-ov-qc-btn irf-ov-qc-btn--danger btn-hr-remove" data-iv="' + id + '" data-name="' + esc(name) + '">Remove</button>';
                var email = prop(r, 'interviewerEmail', 'InterviewerEmail') || '';
                if (email) html += '<button type="button" class="irf-ov-qc-btn btn-hr-suspicious" data-email="' + esc(email) + '" title="Mark this interviewer suspicious (recorded as a High-Risk action)">Suspicious</button>';
                html += '</div>';
            }
            return html + '</div>';
        }

        // "Removed from 1 of 3 channels" (Delta 4).
        function removedFromLine(r) {
            var removed = Number(prop(r, 'channelsRemoved', 'ChannelsRemoved') || 0);
            var total = Number(prop(r, 'channelsTotal', 'ChannelsTotal') || 0);
            if (!removed || !total) return '';
            return '<div class="irf-ov-removed" title="In-scope channels this interviewer is inactive on">Removed from ' + removed + ' of ' + total + ' channel' + (total === 1 ? '' : 's') + '</div>';
        }

        // Trend: bad % this window vs the window of the same length before it (shows whether coaching worked).
        function trendCell(r) {
            var t = prop(r, 'trend', 'Trend');
            var cur = prop(r, 'badPct', 'BadPct');
            var prev = prop(r, 'prevBadPct', 'PrevBadPct');
            if (!t) return '<span style="color:#94a3b8;font-size:11px;" title="No completed interviews in one of the two windows">—</span>';
            var arrow = t === 'up' ? '▲' : (t === 'down' ? '▼' : '▶');
            var tip = 'Bad ' + fmtPct(cur) + ' now vs ' + fmtPct(prev) + ' in the previous window of the same length'
                + (t === 'up' ? ' (worse)' : (t === 'down' ? ' (better)' : ' (no change)'));
            return '<span class="irf-ov-trend--' + t + '" title="' + esc(tip) + '">' + arrow + ' ' + esc(fmtPct(prev)) + ' → ' + esc(fmtPct(cur)) + '</span>';
        }

        // Coverage block (Delta 2): loaded once after the list renders; hidden when the procedure is missing.
        var ovCoverageUrl = '@Url.Action("InterviewerRiskCoverage", "Dashboard")';
        function coverageBlock(c) {
            var lines = [];
            var touch = prop(c, 'lastTouchAtUtc', 'LastTouchAtUtc');
            var lookback = Number(prop(c, 'lookbackDays', 'LookbackDays') || 90);
            if (touch) {
                lines.push('<div class="irf-ov-cov__line" title="' + esc(absTitle(touch)) + '"><span class="irf-ov-cov__label">Last QC touch:</span> '
                    + esc(relTime(touch) || '') + ' · ' + esc(prop(c, 'lastTouchLabel', 'LastTouchLabel') || '') + ' · ' + esc(prop(c, 'lastTouchBy', 'LastTouchBy') || '') + '</div>');
            } else {
                lines.push('<div class="irf-ov-cov__line irf-ov-cov__red">No QC touch in ' + lookback + ' days</div>');
            }
            var call = prop(c, 'lastConnectedCallAtUtc', 'LastConnectedCallAtUtc');
            if (call) {
                var secs = Number(prop(c, 'lastConnectedCallSeconds', 'LastConnectedCallSeconds') || 0);
                lines.push('<div class="irf-ov-cov__line" title="' + esc(absTitle(call)) + '"><span class="irf-ov-cov__label">Last connected call:</span> '
                    + esc(relTime(call) || '') + (secs ? ' · ' + Math.floor(secs / 60) + 'm ' + (secs % 60) + 's' : '') + ' · ' + esc(prop(c, 'lastConnectedCallBy', 'LastConnectedCallBy') || '') + '</div>');
            } else {
                lines.push('<div class="irf-ov-cov__line"><span class="irf-ov-cov__label">Last connected call:</span> none in ' + lookback + ' days</div>');
            }
            lines.push('<div class="irf-ov-cov__line"><span class="irf-ov-cov__label">Touches in 30d:</span> ' + Number(prop(c, 'touches30d', 'Touches30d') || 0) + '</div>');
            var open = [];
            function add(n, one, many) { n = Number(n || 0); if (n > 0) open.push(n + ' ' + (n === 1 ? one : many)); }
            add(prop(c, 'openTrialFlags', 'OpenTrialFlags'), 'trial flag', 'trial flags');
            add(prop(c, 'openTrmUnderReview', 'OpenTrmUnderReview'), 'red marker under review', 'red markers under review');
            add(prop(c, 'slaPending', 'SlaPending'), 'SLA pending', 'SLA pending');
            add(prop(c, 'openDeductionReviews', 'OpenDeductionReviews'), 'deduction review open', 'deduction reviews open');
            add(prop(c, 'activeSuspicious', 'ActiveSuspicious'), 'active suspicious mark', 'active suspicious marks');
            if (open.length) {
                lines.push('<div class="irf-ov-chips">' + open.map(function (o) { return '<span class="irf-ov-chip irf-ov-chip--warn">' + esc(o) + '</span>'; }).join('') + '</div>');
            }
            return '<div class="irf-ov-cov' + (touch ? '' : ' irf-ov-cov--stale') + '">' + lines.join('') + '</div>';
        }
        function loadCoverage(ids) {
            if (!ids || !ids.length) return;
            $.getJSON(ovCoverageUrl, { ids: ids.slice(0, 200).join(',') })
                .done(function (res) {
                    if (!res || !res.ok || res.available === false) return;   // block stays hidden
                    (res.rows || []).forEach(function (c) {
                        var uid = prop(c, 'userId', 'UserId');
                        $('.irf-ov-cov-slot[data-cov-iv="' + uid + '"]').html(coverageBlock(c));
                    });
                });
        }

        // Process line (Delta 4, rolled up over channels): each number opens the Reports tab filtered.
        var ovSignalsUrl = '@Url.Action("InterviewerProcessSignals", "Dashboard")';
        // camelCase or PascalCase JSON, whichever the serializer produced.
        function pv(o, camelKey) { return prop(o, camelKey, camelKey.charAt(0).toUpperCase() + camelKey.slice(1)); }
        function processLine(raw, id) {
            var s = {};
            ['shortComments', 'fewQuestions', 'shortCalls', 'lateJoins', 'selectPct', 'rejectPct', 'completed',
             'highSelection', 'highRejection', 'negativeRatings'].forEach(function (k) { s[k] = pv(raw, k); });
            function n(key, label, filter) {
                var v = Number(s[key] || 0);
                if (!v) return null;
                return label + ' <button type="button" class="irf-ov-process__n btn-ov-proc" data-iv="' + id + '" data-filter="' + filter + '">' + v + '</button>';
            }
            var parts = [
                n('shortComments', 'Short comments', 'ShortComment'),
                n('fewQuestions', '&lt;' + 5 + ' questions', 'FewQuestions'),
                n('shortCalls', 'Short calls', 'ShortCall'),
                n('lateJoins', 'Late joins', 'LateJoin')
            ].filter(Boolean);
            var sel = s.selectPct;
            if (sel !== null && sel !== undefined && Number(s.completed || 0) > 0) {
                parts.push('Select <button type="button" class="irf-ov-process__n btn-ov-proc' + (s.highSelection ? ' irf-ov-hl' : '') + '" data-iv="' + id + '" data-filter="Selected"'
                    + ' title="' + (s.highSelection ? 'High selection rate' : 'Selected / completed') + '">' + Math.round(Number(sel)) + '%</button>');
            }
            if (s.highRejection) parts.push('<span class="irf-ov-hl" title="High rejection rate">Reject ' + Math.round(Number(s.rejectPct || 0)) + '%</span>');
            if (Number(s.negativeRatings || 0) > 0) parts.push('Negative ratings ' + Number(s.negativeRatings));
            return parts.length ? '<span class="irf-ov-cov__label">Process:</span> ' + parts.join(' · ') : '';
        }
        function loadProcessSignals(ids) {
            if (!ids || !ids.length) return;
            $.getJSON(ovSignalsUrl, { ids: ids.slice(0, 200).join(','), from: dirFromVal, to: dirToVal })
                .done(function (res) {
                    if (!res || !res.ok || res.available === false) return;   // line stays blank
                    (res.interviewers || []).forEach(function (s) {
                        var uid = pv(s, 'interviewerUserId');
                        $('.irf-ov-process[data-proc-iv="' + uid + '"]').html(processLine(s, uid));
                    });
                });
        }

        // High-Risk status moves (comment required) and Remove (inactivates the interviewer), source HighRisk.
        function hrCommentPrompt(title, text, confirmText, onOk) {
            Swal.fire({
                title: title,
                text: text,
                type: 'question',
                input: 'textarea',
                inputAttributes: { maxlength: 300 },
                inputPlaceholder: 'Comment (required)',
                inputValidator: function (value) {
                    return new Promise(function (resolve) { resolve(value && value.trim() ? undefined : 'Please enter a comment'); });
                },
                showCancelButton: true,
                confirmButtonText: confirmText
            }).then(function (result) {
                if (result && result.value) onOk(result.value.trim());
            });
        }
        $(document).on('click', '.btn-hr-status', function () {
            var $b = $(this);
            var id = $b.data('iv');
            var status = parseInt($b.data('status'), 10);
            hrCommentPrompt(status === 1 ? 'Move to Under Review' : 'Mark as Reviewed', String($b.data('name') || ''), 'Save', function (comment) {
                $.post('@Url.Action("UpdateQcInterviewerStatus", "Dashboard")', { interviewerUserId: id, irfId: 0, status: status, comment: comment, source: 'HighRisk' })
                    .done(function (res) {
                        showToast((res && res.message) || 'Saved.', !!(res && res.success));
                        if (res && res.success) loadOverview(ovOffset);
                    })
                    .fail(function () { showToast('Could not save the status.', false); });
            });
        });
        $(document).on('click', '.btn-hr-remove', function () {
            var $b = $(this);
            var id = $b.data('iv');
            hrCommentPrompt('Remove Interviewer', 'Remove ' + (String($b.data('name') || '') || 'this interviewer')
                + ' from the system? They are made inactive and their upcoming interviews are unassigned.', 'Yes, remove', function (comment) {
                $.post('@Url.Action("InactivateInterviewer", "Dashboard")', { interviewerId: id, comment: comment, blockinterviewer: false, source: 'HighRisk' })
                    .done(function (res) {
                        showToast((res && res.message) || 'Done.', !!(res && res.success));
                        if (res && res.success) loadOverview(ovOffset);
                    })
                    .fail(function () { showToast('Failed to remove the interviewer.', false); });
            });
        });
        $(document).on('click', '.btn-hr-suspicious', function () {
            var email = String($(this).data('email') || '');
            if (email && typeof SuspiciousTypeDetails === 'function') SuspiciousTypeDetails(email);
        });
        // Interviewer row -> Reports tab for that person; process numbers -> Reports tab filtered by that flag.
        $(document).on('click', '.btn-ov-open-reports', function () {
            openReportsFor({ interviewerId: $(this).data('iv') || $(this).data('interviewer-id'), label: String($(this).data('label') || '') });
        });
        $(document).on('click', '.btn-ov-proc', function () {
            var id = $(this).data('iv');
            var r = ovRowsById[String(id)] || {};
            openReportsFor({
                interviewerId: id,
                label: prop(r, 'codedId', 'CodedId') || prop(r, 'interviewerName', 'InterviewerName') || prop(r, 'interviewerEmail', 'InterviewerEmail') || ('#' + id),
                flag: String($(this).data('filter') || '')
            });
        });

        function renderOverviewRows(rows) {
            ovEmails = {};
            ovRowsById = {};
            if (!rows || !rows.length) {
                return '<div class="irf-risk-empty" style="padding:16px;">No interviewers match the current filter/window.</div>';
            }
            var html = '<table class="irf-audit-table irf-ov-table"><thead><tr>'
                + '<th style="width:40px;"></th>'
                + '<th>Interviewer</th><th>Channels</th><th>Completed</th><th>Bad</th>'
                + '<th title="Bad / completed in the window; Impact = bad interviews weighted by severity (P0 = 5, P1 = 3, P2 = 2, P3–P5 = 1)">Overall risk · Impact</th>'
                + '<th title="Bad % in this window vs the window of the same length just before it">Trend</th>'
                + '<th>Worst</th><th>Priority</th>'
                + '<th>High-risk ch.</th><th>Pending review</th>'
                + '<th title="Reports the AI review penalised in this window (this interviewer, active channels)">AI penalties</th></tr></thead><tbody>';
            rows.forEach(function (r) {
                var id = prop(r, 'interviewerId', 'InterviewerId');
                var email = prop(r, 'interviewerEmail', 'InterviewerEmail') || '';
                ovEmails[String(id)] = email;
                ovRowsById[String(id)] = r;
                var impact = Number(prop(r, 'impact', 'Impact') || 0);
                html += '<tr class="irf-ov-main-row" data-interviewer-id="' + id + '">'
                    + '<td><button type="button" class="irf-audit-expand btn-ov-expand" data-interviewer-id="' + id + '">View</button>'
                    + (ovExposureUrl && email ? ' <a class="irf-ov-exposure" target="_blank" rel="noopener" title="Open the coaching brief for this interviewer" href="' + esc(ovExposureUrl + '?interviewer=' + encodeURIComponent(email)) + '">Exposure</a>' : '')
                    + '<div style="margin-top:4px;"><button type="button" class="irf-rp-link btn-ov-open-reports" data-interviewer-id="' + id + '" data-label="' + esc(prop(r, 'codedId', 'CodedId') || prop(r, 'interviewerName', 'InterviewerName') || email) + '" title="Every graded report of this interviewer in the window">Reports</button></div>'
                    + '</td>'
                    + '<td>' + renderInterviewerCell(r) + qcStatusBlock(r)
                    + '<div class="irf-ov-cov-slot" data-cov-iv="' + id + '"></div>'
                    + '<div class="irf-ov-process" data-proc-iv="' + id + '"></div>'
                    + '</td>'
                    + '<td>' + (prop(r, 'channelsActive', 'ChannelsActive') || 0) + removedFromLine(r) + '</td>'
                    + '<td>' + (prop(r, 'totalCompleted', 'TotalCompleted') || 0) + '</td>'
                    + '<td>' + (prop(r, 'totalBad', 'TotalBad') || 0) + '</td>'
                    + '<td>' + formatRatio(prop(r, 'overallRiskRatio', 'OverallRiskRatio'))
                    + ' <span class="irf-ov-impact" title="Impact = bad interviews weighted by severity">· ' + impact + '</span>'
                    + '<span class="irf-ov-impact__sub">impact</span></td>'
                    + '<td>' + trendCell(r) + '</td>'
                    + '<td>' + esc(prop(r, 'worstSeverity', 'WorstSeverity') || '—') + '</td>'
                    + '<td class="' + priorityClass(prop(r, 'priorityTier', 'PriorityTier')) + '">'
                    + esc(prop(r, 'priorityTier', 'PriorityTier') || '—') + '</td>'
                    + '<td>' + (prop(r, 'highRiskChannels', 'HighRiskChannels') || 0) + '</td>'
                    + '<td>' + (prop(r, 'pendingReviewChannels', 'PendingReviewChannels') || 0) + '</td>'
                    + '<td>' + aiPenaltyCell(r) + '</td>'
                    + '</tr>';
            });
            html += '</tbody></table>';
            return html;
        }

        function renderOverviewPagination(total) {
            var $bar = $('#ovPagination');
            var pages = Math.max(1, Math.ceil(total / ovPageSize));
            var page = Math.floor(ovOffset / ovPageSize) + 1;
            if (total <= ovPageSize) { $bar.removeClass('is-visible').empty(); return; }
            var html = '<span>Showing ' + (ovOffset + 1) + '–' + Math.min(ovOffset + ovPageSize, total) + ' of ' + total + '</span>'
                + '<div class="irf-audit-pagination__btns">'
                + '<button type="button" class="irf-audit-btn" id="ovPrev"' + (page <= 1 ? ' disabled' : '') + '>&lsaquo;</button>'
                + '<span style="padding:0 8px;">Page ' + page + ' / ' + pages + '</span>'
                + '<button type="button" class="irf-audit-btn" id="ovNext"' + (page >= pages ? ' disabled' : '') + '>&rsaquo;</button>'
                + '</div>';
            $bar.html(html).addClass('is-visible');
        }

        function loadOverview(offset) {
            ovOffset = Math.max(0, offset || 0);
            updateExportHref();
            $('#ovBody').html('<div class="irf-risk-loading" style="padding:16px;">Loading high-risk interviewers…</div>');
            $.getJSON(ovListUrl, {
                from: dirFromVal,
                to: dirToVal,
                showAll: ovShowAll(),
                pendingReviewOnly: ovPendingOnly,
                offset: ovOffset,
                pageSize: ovPageSize,
                sortBy: ovSortBy(),
                needsCall: ovNeedsCall()
            })
                .done(function (res) {
                    if (!res || !res.ok) {
                        $('#ovBody').html('<div class="irf-risk-error" style="padding:16px;">'
                            + esc((res && res.message) || 'Failed to load overview.') + '</div>');
                        return;
                    }
                    renderOverviewSummary(res.summary);
                    $('#ovBody').html(renderOverviewRows(res.rows || []));
                    renderOverviewPagination(res.totalRows || 0);
                    // The list never waits for these: coverage (Delta 2) and the process line (Delta 4) fill in after.
                    var ids = (res.rows || []).map(function (r) { return prop(r, 'interviewerId', 'InterviewerId'); }).filter(Boolean);
                    loadCoverage(ids);
                    loadProcessSignals(ids);
                })
                .fail(function () {
                    $('#ovBody').html('<div class="irf-risk-error" style="padding:16px;">Failed to load overview.</div>');
                });
        }

        function formatBackfillStamp(c) {
            var at = prop(c, 'lastBackfillAtUtc', 'LastBackfillAtUtc');
            var from = prop(c, 'lastBackfillFromIst', 'LastBackfillFromIst');
            var to = prop(c, 'lastBackfillToIst', 'LastBackfillToIst');
            if (!at) return 'No risk backfill yet';
            var stamp = fmtDate(at);
            try {
                var d = new Date(at);
                if (!isNaN(d.getTime())) {
                    var ist = new Date(d.getTime() + 330 * 60000);
                    stamp = ist.toISOString().slice(0, 16).replace('T', ' ') + ' IST';
                }
            } catch (e) { }
            if (from && to) return stamp + ' · ' + formatShortRange(String(from).slice(0, 10), String(to).slice(0, 10));
            return stamp;
        }

        function renderOverviewChannels(interviewerId, channels) {
            if (!channels || !channels.length) {
                return '<div class="irf-risk-empty">No in-window channel activity for this interviewer.</div>';
            }
            var ivEmail = ovEmailFor(interviewerId);
            var html = '<table class="irf-risk-table"><thead><tr>'
                + '<th>Channel</th><th>Owner</th><th class="col-num">Completed</th><th class="col-num">Bad</th>'
                + '<th title="Selected / Rejected in the window">Sel / Rej</th>'
                + '<th>Risk</th><th class="col-num">P0</th><th class="col-num">P1</th><th class="col-num">P2</th>'
                + '<th class="col-num">P3</th><th class="col-num">P4</th><th class="col-num">P5</th>'
                + '<th title="Reports with a Payment SLA deduction in the window (average deduction)">Penalised</th>'
                + '<th title="Reports the AI review penalised in the window">AI penalties</th>'
                + '<th title="This interviewer\'s AI verdict on the channel">AI verdict</th>'
                + '<th title="Process lapses (PLI) on this channel in the window; hover for the five kinds">Process (PLI)</th>'
                + '<th title="Select % / reject % (highlighted at the PQI thresholds) and negative candidate ratings">Outcome skew (PQI)</th>'
                + '<th title="This channel\'s share of the interviewer\'s bad reports">Share of bad</th>'
                + '<th title="Days since the row entered PendingReview / Watch / Remove; red after 7 days">Pending for</th>'
                + '<th>Rec</th><th>Review</th><th>Last backfill</th><th>Actions</th></tr></thead><tbody>';
            channels.forEach(function (c) {
                var irfId = prop(c, 'irfId', 'IrfId');
                var irfName = prop(c, 'irfName', 'IrfName') || '';
                var transId = prop(c, 'transInterviewerId', 'TransInterviewerId');
                var rec = prop(c, 'recommendation', 'Recommendation') || '';
                var review = prop(c, 'reviewState', 'ReviewState') || 'None';
                var incomplete = prop(c, 'coverageIncomplete', 'CoverageIncomplete');
                var worstId = prop(c, 'worstSeverityInterviewId', 'WorstSeverityInterviewId');
                var channelUrl = '@Url.Action("AutoRemovalMonitor", "Dashboard")'
                    + '?from=' + encodeURIComponent(dirFromVal)
                    + '&to=' + encodeURIComponent(dirToVal)
                    + '&expandIrfId=' + encodeURIComponent(irfId)
                    + '&view=channels';
                var summary = 'RiskRatio=' + (prop(c, 'riskRatio', 'RiskRatio') != null ? Number(prop(c, 'riskRatio', 'RiskRatio')).toFixed(2) : 'n/a')
                    + '; P0=' + (prop(c, 'p0Count', 'P0Count') || 0)
                    + ',P2=' + (prop(c, 'p2Count', 'P2Count') || 0)
                    + '; window ' + formatShortRange(dirFromVal, dirToVal).replace(/\s/g, '');
                var canAct = review === 'PendingReview' || review === 'NeedsReReview' || rec === 'Remove' || rec === 'Watch';
                var aiVerdict = prop(c, 'aiVerdict', 'AiVerdict') || '';
                html += '<tr class="irf-ov-ch-row" data-trans-id="' + transId + '">'
                    + '<td><strong>' + esc(irfName) + '</strong> <span style="color:#94a3b8;">(#' + irfId + ')</span><br/>'
                    + '<a class="irf-ov-channel-link" href="' + channelUrl + '">Open channel view</a>'
                    + '<div class="irf-ov-ch-actions">'
                    + '<button type="button" class="irf-audit-btn btn-ov-reports" data-trans-id="' + transId + '" data-irf-id="' + irfId + '"'
                    + ' title="Every graded interview (P0–P5) for this interviewer on this channel in the window">Reports</button>'
                    + (ivEmail ? '<button type="button" class="dm-v4-iv-insights-btn dm-v4-iv-insights-btn--channel btn-ov-insights"'
                        + ' data-email="' + esc(ivEmail) + '" data-irf-name="' + esc(irfName) + '"'
                        + ' title="Insights (this channel only)" aria-label="Insights (this channel only)"><i class="fa fa-bar-chart" aria-hidden="true"></i></button>' : '')
                    + '</div>'
                    + outcomeLinks(interviewerId, irfId, irfName, ivEmail)
                    + '</td>'
                    + '<td style="font-size:11px;">' + esc(prop(c, 'channelOwnerDisplay', 'ChannelOwnerDisplay') || prop(c, 'channelOwnerEmail', 'ChannelOwnerEmail') || '—') + '</td>'
                    + '<td class="col-num">' + (prop(c, 'completed', 'Completed') || 0) + '</td>'
                    + '<td class="col-num">' + (prop(c, 'bad', 'Bad') || 0) + '</td>'
                    + '<td>' + chSelRej(c) + '</td>'
                    + '<td>' + formatRatio(prop(c, 'riskRatio', 'RiskRatio')) + '</td>'
                    + '<td class="col-num">' + pBadge(0, prop(c, 'p0Count', 'P0Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(1, prop(c, 'p1Count', 'P1Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(2, prop(c, 'p2Count', 'P2Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(3, prop(c, 'p3Count', 'P3Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(4, prop(c, 'p4Count', 'P4Count')) + '</td>'
                    + '<td class="col-num">' + pBadge(5, prop(c, 'p5Count', 'P5Count')) + '</td>'
                    + '<td>' + chPenalised(c) + '</td>'
                    + '<td>' + aiPenaltyCell(c) + '</td>'
                    + '<td class="irf-ov-verdict">' + (aiVerdict ? esc(aiVerdict) : '<span style="color:#94a3b8;">—</span>') + '</td>'
                    + '<td>' + chProcess(c, interviewerId) + '</td>'
                    + '<td>' + chOutcomeSkew(c) + '</td>'
                    + '<td>' + chShareOfBad(c) + '</td>'
                    + '<td>' + chPendingFor(c, rec, review) + '</td>'
                    + '<td><span class="irf-rec ' + recClass(rec) + '">' + esc(rec) + '</span></td>'
                    + '<td>' + reviewBadge(review, prop(c, 'reviewedBy', 'ReviewedBy'), prop(c, 'reviewedAt', 'ReviewedAt')) + '</td>'
                    + '<td style="font-size:11px;">' + esc(formatBackfillStamp(c))
                    + (incomplete ? '<div class="irf-ov-coverage">coverage incomplete — backfill channel</div>' : '')
                    + '</td><td class="irf-actions-cell">';
                if (canAct && review !== 'Removed') {
                    html += '<button type="button" class="irf-audit-btn irf-audit-btn--danger btn-risk-remove"'
                        + ' data-source="overview" data-interviewer-id="' + interviewerId + '"'
                        + ' data-trans-id="' + transId + '" data-irf-id="' + irfId + '"'
                        + ' data-worst-id="' + (worstId || '') + '"'
                        + ' data-risk-summary="' + esc(summary).replace(/"/g, '&quot;') + '">Remove</button>'
                        + '<button type="button" class="irf-audit-btn btn-risk-keep"'
                        + ' data-source="overview" data-interviewer-id="' + interviewerId + '"'
                        + ' data-trans-id="' + transId + '" data-irf-id="' + irfId + '"'
                        + ' data-worst-id="' + (worstId || '') + '"'
                        + ' data-risk-summary="' + esc(summary).replace(/"/g, '&quot;') + '">Keep</button>';
                } else {
                    html += '<span style="color:#94a3b8;font-size:11px;">—</span>';
                }
                html += '</td></tr>';
                html += '<tr class="irf-ov-reports-row" data-trans-id="' + transId + '" style="display:none;">'
                    + '<td colspan="23" class="irf-risk-detail-cell"><div class="irf-ov-reports-body"></div></td></tr>';
            });
            html += '</tbody></table>';
            return html;
        }

        function chSelRej(c) {
            var completed = Number(prop(c, 'completed', 'Completed') || 0);
            var sel = Number(prop(c, 'selected', 'Selected') || 0);
            var rej = Number(prop(c, 'rejected', 'Rejected') || 0);
            function pct(n) { return completed > 0 ? ' (' + Math.round(n * 100 / completed) + '%)' : ''; }
            return '<span class="irf-ov-selrej" title="Selected / Rejected in the window">' + sel + pct(sel) + ' / ' + rej + pct(rej) + '</span>';
        }

        // ---- QC Tracking Delta 4: IRF-level columns ----
        function chProcess(c, interviewerId) {
            var total = Number(prop(c, 'processLapses', 'ProcessLapses') || 0);
            if (!total) return '<span style="color:#94a3b8;font-size:11px;">0</span>';
            var tip = 'Short select comments ' + Number(prop(c, 'shortSelectComments', 'ShortSelectComments') || 0)
                + ' · short reject comments ' + Number(prop(c, 'shortRejectComments', 'ShortRejectComments') || 0)
                + ' · <5 questions ' + Number(prop(c, 'fewQuestions', 'FewQuestions') || 0)
                + ' · short calls ' + Number(prop(c, 'shortCalls', 'ShortCalls') || 0)
                + ' · late joins ' + Number(prop(c, 'lateJoins', 'LateJoins') || 0);
            return '<button type="button" class="irf-ov-process__n btn-ch-reports" data-iv="' + interviewerId + '" data-irf-id="' + prop(c, 'irfId', 'IrfId')
                + '" data-irf-name="' + esc(prop(c, 'irfName', 'IrfName') || '') + '" data-filter="HasProcessFlags" title="' + esc(tip) + '">' + total + '</button>';
        }
        function chOutcomeSkew(c) {
            var completed = Number(prop(c, 'completed', 'Completed') || 0);
            if (!completed) return '<span style="color:#94a3b8;font-size:11px;">—</span>';
            var sel = Math.round(Number(prop(c, 'selected', 'Selected') || 0) * 100 / completed);
            var rej = Math.round(Number(prop(c, 'rejected', 'Rejected') || 0) * 100 / completed);
            var hiSel = !!prop(c, 'highSelection', 'HighSelection');
            var hiRej = !!prop(c, 'highRejection', 'HighRejection');
            var neg = Number(prop(c, 'negativeRatings', 'NegativeRatings') || 0);
            return '<span class="irf-ov-selrej"><span class="' + (hiSel ? 'irf-ov-hl' : '') + '" title="Select %' + (hiSel ? ' (high)' : '') + '">' + sel + '%</span> / '
                + '<span class="' + (hiRej ? 'irf-ov-hl' : '') + '" title="Reject %' + (hiRej ? ' (high)' : '') + '">' + rej + '%</span>'
                + (neg ? '<div class="irf-ov-ai__sub" title="Candidate ratings below 4">' + neg + ' negative rating' + (neg === 1 ? '' : 's') + '</div>' : '')
                + '</span>';
        }
        function chShareOfBad(c) {
            var mine = Number(prop(c, 'shareOfBad', 'ShareOfBad') || 0);
            var all = Number(prop(c, 'interviewerBadTotal', 'InterviewerBadTotal') || 0);
            if (!all) return '<span style="color:#94a3b8;font-size:11px;">—</span>';
            var strong = all > 1 && mine * 2 > all;
            return '<span class="' + (strong ? 'irf-ov-red' : '') + '" title="This channel holds ' + mine + ' of the interviewer\'s ' + all + ' bad reports">' + mine + ' of ' + all + '</span>';
        }
        function chPendingFor(c, rec, review) {
            var pending = review === 'PendingReview' || review === 'NeedsReReview' || rec === 'Watch' || rec === 'Remove';
            var days = prop(c, 'pendingDays', 'PendingDays');
            if (!pending || days === null || days === undefined) return '<span style="color:#94a3b8;font-size:11px;">—</span>';
            days = Number(days);
            var since = prop(c, 'pendingSince', 'PendingSince');
            return '<span class="' + (days > 7 ? 'irf-ov-red' : '') + '" title="Since ' + esc(absTitle(since)) + '">' + days + ' day' + (days === 1 ? '' : 's') + '</span>';
        }
        $(document).on('click', '.btn-ch-reports', function () {
            var id = $(this).data('iv');
            var r = ovRowsById[String(id)] || {};
            openReportsFor({
                interviewerId: id,
                irfId: $(this).data('irf-id'),
                label: (prop(r, 'codedId', 'CodedId') || prop(r, 'interviewerName', 'InterviewerName') || ('#' + id)) + ' on ' + String($(this).data('irf-name') || ''),
                flag: String($(this).data('filter') || '')
            });
        });

        function chPenalised(c) {
            var n = Number(prop(c, 'reportsPenalised', 'ReportsPenalised') || 0);
            if (!n) return '<span style="color:#94a3b8;font-size:11px;">—</span>';
            var avg = prop(c, 'avgPenaltyPct', 'AvgPenaltyPct');
            return '<span class="irf-ov-selrej">' + n + ' <span class="irf-ov-ai__sub">(avg ' + esc(fmtPct(avg)) + ')</span></span>';
        }

        function outcomeLinks(userId, irfId, irfName, email) {
            if (!tplOutcome || !email) return '';
            function url(stat) {
                return String(tplOutcome)
                    .replace(/__USER_ID__/g, encodeURIComponent(userId))
                    .replace(/__STAT__/g, encodeURIComponent(stat))
                    .replace(/__IRF_ID__/g, encodeURIComponent(irfId))
                    .replace(/__IRF_NAME__/g, encodeURIComponent(irfName || ''))
                    .replace(/__EMAIL__/g, encodeURIComponent(email));
            }
            var tip = ' (all time; the counts in the row cover the selected window)';
            return '<div class="dm-v4-iv-outcomes" style="margin-top:4px;">'
                + '<a class="dm-v4-iv-outcomes__link" target="_blank" rel="noopener" title="Completed interviews on this channel' + tip + '" href="' + esc(url(statCompleted)) + '">Completed ↗</a>'
                + '<a class="dm-v4-iv-outcomes__link" target="_blank" rel="noopener" title="Selected candidates on this channel' + tip + '" href="' + esc(url(statSelected)) + '">Selected ↗</a>'
                + '<a class="dm-v4-iv-outcomes__link" target="_blank" rel="noopener" title="Rejected candidates on this channel' + tip + '" href="' + esc(url(statRejected)) + '">Rejected ↗</a>'
                + '</div>';
        }

        // Report level: every graded interview for this interviewer on the channel, from the existing
        // IrfAuditInterviewerRisk action, filtered client-side to the TransInterviewerId.
        var ovReportsCache = {};
        $(document).on('click', '.btn-ov-reports', function () {
            var $btn = $(this);
            var transId = $btn.data('trans-id');
            var irfId = $btn.data('irf-id');
            var $row = $btn.closest('tr.irf-ov-ch-row').nextAll('tr.irf-ov-reports-row[data-trans-id="' + transId + '"]').first();
            if ($row.is(':visible')) {
                $row.hide();
                $btn.removeClass('is-open').text('Reports');
                return;
            }
            $row.show();
            $btn.addClass('is-open').text('Hide reports');
            var $body = $row.find('.irf-ov-reports-body');
            var key = irfId + '|' + dirFromVal + '|' + dirToVal;
            function render(details) {
                $body.html(renderSeverityGroups(detailsForTrans(details, transId), null, irfId));
            }
            if (ovReportsCache[key]) { render(ovReportsCache[key]); return; }
            $body.html('<div class="irf-risk-loading">Loading…</div>');
            $.getJSON(riskBreakdownUrl, { irfId: irfId, from: dirFromVal, to: dirToVal })
                .done(function (res) {
                    if (!res || !res.ok) {
                        $body.html('<div class="irf-risk-error">' + esc((res && res.message) || 'Failed to load reports.') + '</div>');
                        return;
                    }
                    ovReportsCache[key] = res.details || [];
                    render(ovReportsCache[key]);
                })
                .fail(function () {
                    $body.html('<div class="irf-risk-error">Failed to load reports.</div>');
                });
        });

        $(document).on('click', '.btn-ov-insights', function (e) {
            e.preventDefault();
            var email = String($(this).data('email') || '');
            var irfName = String($(this).data('irf-name') || '');
            if (!email || typeof InsightsDetails !== 'function') return;
            if (irfName) InsightsDetails(email, irfName);
            else InsightsDetails(email);
        });

        $(document).on('click', '.btn-ov-call', function (e) {
            e.preventDefault();
            var $b = $(this);
            if (typeof CommonCallButtonClick !== 'function') { showToast('Calling is not available on this page.', false); return; }
            // Logged against an interviewer, so the call counts on the QC Activity page.
            CommonCallButtonClick(String($b.data('name') || ''), String($b.data('mobile') || ''), String($b.data('email') || ''), null, null, 'Interviewer');
        });

        function loadOverviewChannels(interviewerId, force) {
            var $main = $('tr.irf-ov-main-row[data-interviewer-id="' + interviewerId + '"]');
            var $detail = $main.next('.irf-ov-detail-row');
            if (!$detail.length) {
                $detail = $('<tr class="irf-ov-detail-row" data-parent-iv="' + interviewerId + '"><td colspan="12"><div class="irf-risk-panel">'
                    + '<div class="irf-risk-panel__title">Channels for this interviewer</div>'
                    + '<div class="irf-ov-ch-body"><div class="irf-risk-loading">Loading…</div></div>'
                    + '</div></td></tr>');
                $main.after($detail);
            } else {
                $detail.show();
                if (!force) return;
                $detail.find('.irf-ov-ch-body').html('<div class="irf-risk-loading">Loading…</div>');
            }
            $.getJSON(ovChannelsUrl, { interviewerId: interviewerId, from: dirFromVal, to: dirToVal })
                .done(function (res) {
                    if (!res || !res.ok) {
                        $detail.find('.irf-ov-ch-body').html('<div class="irf-risk-error">'
                            + esc((res && res.message) || 'Failed to load channels.') + '</div>');
                        return;
                    }
                    $detail.find('.irf-ov-ch-body').html(renderOverviewChannels(interviewerId, res.rows || []));
                })
                .fail(function () {
                    $detail.find('.irf-ov-ch-body').html('<div class="irf-risk-error">Failed to load channels.</div>');
                });
        }

        $(document).on('click', '.btn-ov-expand', function () {
            var id = $(this).data('interviewer-id');
            var $btn = $(this);
            var open = $btn.hasClass('is-open');
            if (open) {
                $btn.removeClass('is-open').text('View');
                $('tr.irf-ov-main-row[data-interviewer-id="' + id + '"]').next('.irf-ov-detail-row').hide();
                return;
            }
            $btn.addClass('is-open').text('Hide');
            loadOverviewChannels(id, true);
        });

        $('#ovRefreshBtn').on('click', function () { loadOverview(ovOffset); });
        $('#ovShowAll').on('change', function () { loadOverview(0); });
        $('#ovSortBy').on('change', function () { loadOverview(0); });
        $('#ovNeedsCall').on('change', function () {
            try {
                var u = new URL(window.location.href);
                if (ovNeedsCall()) u.searchParams.set('needsCall', '1'); else u.searchParams.delete('needsCall');
                window.history.replaceState({}, '', u.toString());
            } catch (e) { }
            $('#dirNeedsCallHidden').val(ovNeedsCall() ? '1' : '0');
            loadOverview(0);
        });
        $(document).on('click', '#ovPendingFilterBtn', function () {
            ovPendingOnly = true;
            loadOverview(0);
        });
        $(document).on('click', '#ovClearPendingFilter', function () {
            ovPendingOnly = false;
            loadOverview(0);
        });
        $(document).on('click', '#ovPrev', function () {
            loadOverview(Math.max(0, ovOffset - ovPageSize));
        });
        $(document).on('click', '#ovNext', function () {
            loadOverview(ovOffset + ovPageSize);
        });

        // ---- Reports tab (QC Tracking Delta 4, report level) ----
        var rpUrl = '@Url.Action("HighRiskReports", "Dashboard")';
        var rpOffset = 0;
        var rpPageSize = 50;
        var rpFilters = {};          // chip keys that are on
        var rpScope = {};            // { interviewerId, irfId, label, flag } from the other two levels
        var rpRows = {};

        function rpFilterString() {
            var keys = Object.keys(rpFilters).filter(function (k) { return rpFilters[k]; });
            if (rpScope.flag) keys.push(rpScope.flag);
            return keys.join(',');
        }
        function renderRpScope() {
            var parts = [];
            if (rpScope.label) parts.push(esc(rpScope.label));
            else if (rpScope.interviewerId) parts.push('Interviewer #' + esc(rpScope.interviewerId));
            if (rpScope.irfId && !rpScope.label) parts.push('Channel #' + esc(rpScope.irfId));
            var flagLabels = { ShortComment: 'short comments', FewQuestions: '<5 questions', ShortCall: 'short calls', LateJoin: 'late joins', Selected: 'selected', HasProcessFlags: 'process flags' };
            if (rpScope.flag) parts.push(esc(flagLabels[rpScope.flag] || rpScope.flag));
            $('#rpScope').html(parts.length ? 'Showing: <strong>' + parts.join(' · ') + '</strong>' : '');
            $('#rpClearScope').toggle(parts.length > 0);
        }
        // Called from the Interviewers tab (row, process line) and channel rows.
        function openReportsFor(scope) {
            rpScope = scope || {};
            setAuditView('reports');
        }

        function rpStatusDesc(r) {
            return pv(r, 'interviewStatusText') || '';
        }
        function rpReportLink(r) {
            var isAi = !!pv(r, 'isAIInterview');
            var session = pv(r, 'sessionId');
            var id = pv(r, 'interviewId');
            var irf = pv(r, 'irfIntId');
            var href = isAi && session
                ? '@Url.Action("Report", "AIInterview")?seId=' + encodeURIComponent(session)
                : '@Url.Action("ClientReport", "Interview")?interviewId=' + encodeURIComponent(id) + '&irfId=' + encodeURIComponent(irf || '');
            return '<a class="irf-rp-link" target="_blank" rel="noopener" href="' + esc(href) + '">#' + esc(id) + '</a>';
        }
        function rpFlags(r) {
            if (pv(r, 'signalsLoaded') === false) return '<span style="color:#94a3b8;font-size:11px;" title="Signals procedure not deployed">—</span>';
            var out = [];
            if (pv(r, 'shortComment')) out.push('<span class="irf-rp-flag" title="Comment ' + esc(pv(r, 'commentChars') || 0) + ' chars">Short comment</span>');
            if (pv(r, 'fewQuestions')) out.push('<span class="irf-rp-flag" title="' + esc(pv(r, 'questionCount') || 0) + ' questions">&lt;5 questions</span>');
            if (pv(r, 'shortCall')) out.push('<span class="irf-rp-flag" title="' + esc(pv(r, 'videoMinutes') || 0) + ' of ' + esc(pv(r, 'plannedMinutes') || 0) + ' min">Short call</span>');
            if (pv(r, 'lateJoin')) out.push('<span class="irf-rp-flag" title="' + esc(pv(r, 'lateJoinMinutes') || 0) + ' min late">Late join</span>');
            return out.length ? out.join('') : '<span style="color:#94a3b8;font-size:11px;">none</span>';
        }
        function rpAiVerdict(r) {
            var pct = pv(r, 'aiDeductionPct');
            var rec = pv(r, 'aiRecommendation') || '';
            var tv = pv(r, 'aITranscriptVerdict') || pv(r, 'aiTranscriptVerdict') || prop(r, 'aITranscriptVerdict', 'AITranscriptVerdict') || '';
            var parts = [];
            if (pct !== null && pct !== undefined) parts.push((Number(pct) > 0 ? '<span class="irf-ov-red">Penalised ' + Number(pct) + '%</span>' : 'No penalty') + (rec ? ' · ' + esc(rec) : ''));
            if (tv) parts.push('<span class="irf-ov-ai__sub">Transcript: ' + esc(tv) + '</span>');
            return parts.length ? parts.join('<br/>') : '<span style="color:#94a3b8;font-size:11px;">—</span>';
        }
        function rpQcStatus(r) {
            var s = pv(r, 'qcStatus') || 'Not reviewed';
            var by = pv(r, 'qcReviewedBy') || '';
            var html = '<span class="' + (pv(r, 'isReviewed') ? 'irf-rp-status--done' : 'irf-rp-status--none') + '">' + esc(s) + '</span>';
            if (by) html += '<span class="irf-ov-qc-meta">' + esc(by) + '</span>';
            if (pv(r, 'aiQcDisagree')) html += '<div><span class="irf-rp-disagree" title="AI penalised but the QC save is 0%, or the reverse">AI ≠ QC</span></div>';
            return html;
        }
        function rpActions(r, canQcForm) {
            var id = pv(r, 'interviewId');
            var email = pv(r, 'interviewerEmail') || '';
            var cand = pv(r, 'candidateName') || '';
            var approved = Number(pv(r, 'isApproved') || 0) === 1;
            var html = '<div class="irf-rp-actions">'
                + '<button type="button" class="irf-ov-qc-btn btn-rp-sla" data-id="' + id + '" title="Payment SLA review (recorded as High-Risk)">Payment SLA</button>'
                + '<button type="button" class="irf-ov-qc-btn btn-rp-redo" data-id="' + id + '" title="Redo request (recorded as High-Risk)">Redo</button>';
            if (canQcForm) {
                html += '<a class="irf-ov-qc-btn" target="_blank" rel="noopener" title="QC form (recorded as High-Risk)" href="'
                    + esc('@Url.Action("QCReportForm", "Interview")?interviewid=' + encodeURIComponent(id) + '&interviewer=' + encodeURIComponent(email) + '&type=HighRisk') + '">QC form</a>';
            }
            if (email) html += '<button type="button" class="irf-ov-qc-btn btn-hr-suspicious" data-email="' + esc(email) + '">Suspicious</button>';
            html += '</div>';
            rpRows[String(id)] = { cand: cand, email: email, approved: approved, status: rpStatusDesc(r) };
            return html;
        }
        function renderReports(res) {
            var rows = res.rows || [];
            if (res.available === false) {
                return '<div class="irf-risk-empty" style="padding:16px;">The Reports tab needs usp_GetHighRiskReports. Deploy Risebird.DB/StoredProcedures/usp_GetHighRiskReports.sql.</div>';
            }
            if (!rows.length) return '<div class="irf-risk-empty" style="padding:16px;">No graded reports match the current filter/window.</div>';
            rpRows = {};
            var html = '<table class="irf-audit-table irf-ov-table"><thead><tr>'
                + '<th>Date (IST)</th><th>Interview</th><th>Candidate</th><th>Client / channel</th><th>Interviewer</th>'
                + '<th>Severity</th><th title="AISystem Payment SLA and the AI transcript verdict">AI verdict</th>'
                + '<th title="Candidate rating of the interviewer">Rating</th><th>Process flags</th><th>QC status</th><th>Actions</th>'
                + '</tr></thead><tbody>';
            rows.forEach(function (r) {
                var ivId = pv(r, 'interviewerUserId');
                var ivLabel = pv(r, 'codedId') || pv(r, 'interviewerName') || pv(r, 'interviewerEmail') || '';
                var irfId = pv(r, 'irfIntId');
                var rating = pv(r, 'candidateRating');
                html += '<tr>'
                    + '<td style="white-space:nowrap;font-size:12px;">' + esc(fmtDate(pv(r, 'interviewDateIst'))) + '</td>'
                    + '<td>' + rpReportLink(r) + '<div class="irf-ov-ai__sub">' + esc(rpStatusDesc(r)) + '</div></td>'
                    + '<td style="font-size:12px;">' + esc(pv(r, 'candidateName') || '') + '</td>'
                    + '<td style="font-size:12px;">' + esc(pv(r, 'clientName') || '') + '<div class="irf-ov-ai__sub">' + esc(prop(r, 'irfId', 'IRFId') || '') + '</div>'
                    + (irfId ? '<button type="button" class="irf-rp-link btn-rp-scope-irf" data-irf-id="' + irfId + '" data-label="' + esc(prop(r, 'irfId', 'IRFId') || '') + '">this channel</button>' : '') + '</td>'
                    + '<td style="font-size:12px;">' + esc(ivLabel)
                    + (ivId ? '<div><button type="button" class="irf-rp-link btn-rp-to-iv" data-iv="' + ivId + '" title="Open this interviewer on the Interviewers tab">overall</button>'
                        + ' · <button type="button" class="irf-rp-link btn-rp-scope-iv" data-iv="' + ivId + '" data-label="' + esc(ivLabel) + '">all reports</button></div>' : '')
                    + '</td>'
                    + '<td><span class="irf-p-badge irf-p-badge--' + esc(String(pv(r, 'severity') || '').toLowerCase()) + '" style="cursor:default;">' + esc(pv(r, 'severity') || '—') + '</span>'
                    + (pv(r, 'riskName') ? '<div class="irf-ov-ai__sub" style="max-width:220px;white-space:normal;">' + esc(String(pv(r, 'riskName')).substring(0, 120)) + '</div>' : '') + '</td>'
                    + '<td style="font-size:11px;">' + rpAiVerdict(r) + '</td>'
                    + '<td>' + (rating !== null && rating !== undefined ? '<span class="' + (Number(rating) < 4 ? 'irf-ov-red' : '') + '">' + Number(rating) + '/5</span>' : '<span style="color:#94a3b8;font-size:11px;">—</span>') + '</td>'
                    + '<td>' + rpFlags(r) + '</td>'
                    + '<td style="font-size:12px;">' + rpQcStatus(r) + '</td>'
                    + '<td>' + rpActions(r, !!res.canQcForm) + '</td>'
                    + '</tr>';
            });
            return html + '</tbody></table>';
        }
        function renderRpPagination(total) {
            var $bar = $('#rpPagination');
            var pages = Math.max(1, Math.ceil(total / rpPageSize));
            var page = Math.floor(rpOffset / rpPageSize) + 1;
            if (total <= rpPageSize) {
                $bar.html(total ? '<span>' + total + ' report' + (total === 1 ? '' : 's') + '</span>' : '').toggleClass('is-visible', total > 0);
                return;
            }
            $bar.html('<span>Showing ' + (rpOffset + 1) + '–' + Math.min(rpOffset + rpPageSize, total) + ' of ' + total + '</span>'
                + '<div class="irf-audit-pagination__btns">'
                + '<button type="button" class="irf-audit-btn" id="rpPrev"' + (page <= 1 ? ' disabled' : '') + '>&lsaquo;</button>'
                + '<span style="padding:0 8px;">Page ' + page + ' / ' + pages + '</span>'
                + '<button type="button" class="irf-audit-btn" id="rpNext"' + (page >= pages ? ' disabled' : '') + '>&rsaquo;</button>'
                + '</div>').addClass('is-visible');
        }
        function loadReports(offset) {
            rpOffset = Math.max(0, offset || 0);
            renderRpScope();
            $('#rpFilters .irf-rp-chip').each(function () { $(this).toggleClass('is-on', !!rpFilters[$(this).data('key')]); });
            $('#rpBody').html('<div class="irf-risk-loading" style="padding:16px;">Loading reports…</div>');
            $.getJSON(rpUrl, {
                from: dirFromVal,
                to: dirToVal,
                filter: rpFilterString(),
                interviewerId: rpScope.interviewerId || '',
                irfId: rpScope.irfId || '',
                offset: rpOffset,
                pageSize: rpPageSize
            })
                .done(function (res) {
                    if (!res || !res.ok) {
                        $('#rpBody').html('<div class="irf-risk-error" style="padding:16px;">' + esc((res && res.message) || 'Failed to load reports.') + '</div>');
                        $('#rpPagination').removeClass('is-visible').empty();
                        return;
                    }
                    $('#rpBody').html(renderReports(res));
                    renderRpPagination(res.totalRows || 0);
                })
                .fail(function () {
                    $('#rpBody').html('<div class="irf-risk-error" style="padding:16px;">Failed to load reports.</div>');
                });
        }
        $(document).on('click', '#rpFilters .irf-rp-chip', function () {
            var k = $(this).data('key');
            rpFilters[k] = !rpFilters[k];
            loadReports(0);
        });
        $('#rpRefreshBtn').on('click', function () { loadReports(rpOffset); });
        $('#rpClearScope').on('click', function () { rpScope = {}; loadReports(0); });
        $(document).on('click', '#rpPrev', function () { loadReports(Math.max(0, rpOffset - rpPageSize)); });
        $(document).on('click', '#rpNext', function () { loadReports(rpOffset + rpPageSize); });
        $(document).on('click', '.btn-rp-scope-iv', function () {
            rpScope = { interviewerId: $(this).data('iv'), label: String($(this).data('label') || '') };
            loadReports(0);
        });
        $(document).on('click', '.btn-rp-scope-irf', function () {
            rpScope = { irfId: $(this).data('irf-id'), label: 'Channel ' + String($(this).data('label') || '') };
            loadReports(0);
        });
        $(document).on('click', '.btn-rp-to-iv', function () {
            // Overall level: the Interviewers tab, with this person's channels open when they are on the current page.
            var id = $(this).data('iv');
            setAuditView('interviewers');
            setTimeout(function () {
                var $btn = $('.btn-ov-expand[data-interviewer-id="' + id + '"]');
                if ($btn.length) {
                    if (!$btn.hasClass('is-open')) $btn.trigger('click');
                    try { $btn[0].scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) { }
                }
            }, 1500);
        });
        // Report actions: recorded as High-Risk on QC Activity (Payment SLA Pagetype HighRisk, Redo type HighRisk).
        $(document).on('click', '.btn-rp-sla', function () {
            var id = $(this).data('id');
            var info = rpRows[String(id)] || {};
            if (typeof PaymentSLADetails !== 'function') { showToast('Payment SLA is not available on this page.', false); return; }
            window.rbReturnTab = 'reports';
            PaymentSLADetails(id, info.cand || '', info.email || '', !!info.approved, 'HighRisk', false, false, false);
        });
        $(document).on('click', '.btn-rp-redo', function () {
            var id = $(this).data('id');
            var info = rpRows[String(id)] || {};
            OpenRedoFormModel(id, info.status || '', 'HighRisk');
        });

        // Auto-expand IRF when deep-linked from overview channel link
        if (expandIrfIdOnLoad) {
            setAuditView('channels');
            var $expandBtn = $('.btn-view-interviewers[data-irf-id="' + expandIrfIdOnLoad + '"]');
            if ($expandBtn.length) {
                var $row = $expandBtn.closest('tr.irf-audit-main-row');
                $irfAuditRows.show();
                // Jump pagination to the page containing this IRF
                var idx = $irfAuditRows.index($row);
                if (idx >= 0) {
                    irfAuditCurrentPage = Math.floor(idx / IRF_AUDIT_PAGE_SIZE) + 1;
                    renderIrfAuditPagination();
                }
                $expandBtn.trigger('click');
                try { $row[0].scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) { }
            }
        } else if (initialAuditView === 'interviewers') {
            setAuditView('interviewers');
        } else if (initialAuditView === 'reports') {
            setAuditView('reports');
        } else {
            $('#irfAuditInterviewersBlurb').hide();
        }

    })();

</script>

