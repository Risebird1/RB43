        // Same rules as dmV4FormatRelativeTime (dm-v4-layout.js).
        function relTime(iso) {
            if (!iso) return null;
            var d = new Date(iso);
            if (isNaN(d.getTime())) return null;
            var sec = Math.floor((Date.now() - d.getTime()) / 1000);
            if (sec < 60) return 'just now';
            if (sec < 3600) { var mins = Math.floor(sec / 60); return mins <= 1 ? '1 min ago' : mins + ' min ago'; }
            if (sec < 86400) { var hours = Math.floor(sec / 3600); return hours < 6 ? 'a few hours ago' : hours + 'h ago'; }
            if (sec < 604800) return Math.floor(sec / 86400) + 'd ago';
            if (sec < 2592000) return Math.floor(sec / 604800) + 'w ago';
            if (sec < 31536000) return Math.floor(sec / 2592000) + 'mo ago';
            return Math.floor(sec / 31536000) + 'y ago';
        }

        // Same format as dmV4FormatAbsoluteTimestamp.
        function absTitle(iso) {
            if (!iso) return '';
            var d = new Date(iso);
            if (isNaN(d.getTime())) return '';
            return d.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        function metaLine(label, iso, emptyText) {
            if (!iso) return '<div class="dm-v4-iv-meta__line">' + esc(label + ': ' + emptyText) + '</div>';
            return '<div class="dm-v4-iv-meta__line" title="' + esc(absTitle(iso)) + '">' + esc(label + ': ' + (relTime(iso) || '—')) + '</div>';
        }

