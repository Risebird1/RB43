            return '<span class="irf-ov-chip' + (tone ? ' irf-ov-chip--' + tone : '') + '"' + (title ? ' title="' + esc(title) + '"' : '') + '>' + esc(text) + '</span>';
        }

        function profileChips(r) {
            var out = [];
            var ack = String(prop(r, 'acknowledgementStatus', 'AcknowledgementStatus') || '').toLowerCase();
            if (ack === 'yes') out.push(chip('Acknowledged', 'ok', 'Acknowledgement status: Yes'));
            else if (ack === 'no') out.push(chip('Not acknowledged', 'warn', 'Acknowledgement status: No'));
            out.push(prop(r, 'isEmployed', 'IsEmployed') ? chip('Employed', null, 'Employee: Working') : chip('Not employed', null, 'Employee: Not working'));
            var avail = Number(prop(r, 'isAvailable', 'IsAvailable') || 0);
            if (avail === 2) out.push(chip('Unavailable', 'warn', 'Availability: Not available'));
            else if (avail === 3) out.push(chip('Needs clarity', 'warn', 'Availability: Need more clarity'));
            else if (avail === 4) out.push(chip('Dropped profile', 'bad', 'Availability: Drop my profile'));
            if (!prop(r, 'hasPortalAccess', 'HasPortalAccess')) out.push(chip('No portal access', 'bad', 'Interviewer portal access is off'));
            if (prop(r, 'isHoldPayment', 'IsHoldPayment')) out.push(chip('Payment on hold', 'bad', 'Payment is on hold for this interviewer'));
            var redo = Number(prop(r, 'redoRequests', 'RedoRequests') || 0);
            if (redo > 0) out.push(chip('Redo ×' + redo, 'warn', 'Redo requests (lifetime)'));
            var aiFlag = Number(prop(r, 'aiTranscriptFlagged', 'AiTranscriptFlagged') || 0);
            if (aiFlag > 0) out.push(chip('AI transcript flags ×' + aiFlag, 'warn', 'Interviews the AI transcript review flagged (lifetime)'));
            return '<div class="irf-ov-chips">' + out.join('') + '</div>';
