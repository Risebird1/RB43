@model IEnumerable<Risebird.Entities.ViewModel.ProctoringReport>
@{
    ViewData["Title"] = "ProxyReport";
}
<script>
    var Header = "<div>Proxy Report</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
</style>

<div class="main-panel" id="main-panel">
    <div>
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">BlackList Company</h4></div>
                    </div>
                    <div class="pull-right client-ms">
                        @if (ViewBag.ReturnBack == 1)
                        {
                         <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>    
                        }
                        else
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                    </div>

                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                @* <img src="~/Newassets/img/lazyload.gif" /> *@
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Channel Id</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Candidate Number</th>
                                                <th>Channel Owner</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>
                                                <th>QC Completed</th>
                                                <th>Proxy filled by</th>
                                                <th> Proxy filledOn</th>
                                                <th>Proxy voting</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                 <th>Channel Id</th>
                                                 <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Candidate Number</th>
                                                <th>Channel Owner</th>
                                                <th>Meeting Status</th>
                                                <th>Interview Status</th>   
                                                <th>QC Completed</th>
                                                <th>Proxy filled by</th>
                                                <th> Proxy filledOn</th>
                                                <th>Proxy voting</th>
                                                <th>Action</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            @if (Model != null && Model.Count() > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                         @if (@item.interviewer != null || @item.interviewer != "")
 {
     <td>
         <d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer"> @item.interviewer</d>
     </td>
 }
 else
 {
     <td>
         <d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">
             not
         </d>
     </td>
 }
                                                        <td>@item.candidateName</td>
                                                        <td>@item.candidateEmail</td>
                                                        <td>@item.InterviewerMobileNumber</td>
                                                        <td>@item.ChannelOwner</td>
                                                       @if (@item.interviewDate > DateTime.Now && item.confirmationStatus.Trim() != "Cancelled")
                                                                    {
                                                                        <td>Scheduled</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        @if (item.MeetingStatusStatusDesc != "0")
                                                                        {
                                                                            <td> @item.MeetingStatusStatusDesc</td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td></td>
                                                                        }
                                                                    }
                                                                
                                                        @if (item.intervieweStatusStatDesc != "0")
                                                                    {
                                                                        <td> @item.intervieweStatusStatDesc</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td></td>
                                                                    }
                                                                     @if (item.QCPresent > 0)
                                                        {
                                                            <td>Yes</td>
                                                        }
                                                        else
                                                        {
                                                            <td>No</td>
                                                        }
                                                        <td>@item.CreatedBy</td>
                                                        <td>@item.CreatedOn</td>
                                                        @if (item.ProxyvotingCount>0) { 
                                                        <td>
                                                            <button class="proxy-count" type="button"  onclick="ProxyReportDetails('@item.id')"> @item.ProxyvotingCount</button>
                                                           </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                           @item.ProxyvotingCount
                                                            </td>
                                                             }
                                                        <td>
                                                            <span>
    <a style="width: 30px;height: 30px;cursor:pointer; background: #d2cece66;display: inline-block;border-radius: 100%;line-height: 32px;" onClick="ProxyFormDetails('@item.InterviewId',true,'QCPendingReport')">
        <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Proxy Form" style=" position: relative; top: -1px;">
            <i style="font-size: 16px; position: relative; top: -1px;" class="fa fa-wpforms"></i>
        </button>
    </a>
</span>
  @if (item.confirmationStatus.Trim() != "Cancelled" && item.MeetingStatusStatusDesc != "Status Pending" && item.MeetingStatusStatusDesc != "No Show(Candidate)" && item.MeetingStatusStatusDesc != "No Show(Interviewer)" && item.MeetingStatusStatusDesc != "No Show")

                                                                    {


                                                                         @if (item.IsAIInterview)
                                                                        {
                                                                            <span class="interview_9">
                                                                                <a style="text-decoration:none" target="_blank" href='@Url.Action("Report", "AIInterview" , new { seId = item.SessionId})'>
                                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Report" style="position:relative;top:-3px;">
                                                                                        <span>
                                                                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                                                                <!-- Report/document shape -->
                                                                                                <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                                                                                <path d="M15 2v5h5"></path>

                                                                                                <!-- Brain-like AI/circuit element -->
                                                                                                <path d="M10 12c0-1 .5-2 2-2s2 1 2 2-.5 2-2 2-2-1-2-2z"></path>
                                                                                                <line x1="12" y1="10" x2="12" y2="8"></line>
                                                                                                <line x1="12" y1="14" x2="12" y2="16"></line>
                                                                                                <line x1="10" y1="12" x2="8" y2="12"></line>
                                                                                                <line x1="14" y1="12" x2="16" y2="12"></line>

                                                                                                <!-- Text lines on report -->
                                                                                                <line x1="7" y1="18" x2="17" y2="18"></line>
                                                                                            </svg>
                                                                                        </span>
                                                                                    </button>
                                                                                </a>
                                                                            </span>
                                                                            //Remember : Change the report icon for an ai interview report. A normal report and an AI report should be identifiable by their distinct icons.
                                                                        }
                                                                        else{
 <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.InterviewId ,irfId=item.irfIntId})">
                                                                            <span class="mdc-fab app-fab--absolute" aria-label="Client Interview Report">
                                                                                <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                            </span>
                                                                        </a>
                                                                        }
                                                                    }
                                                                    
                                                                    
                                                                    
                                                                    
                                                                    
                                                                    
                                                                    </td>
                                                  
                                                                
                                                                
                                                                </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->

        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
@await Html.PartialAsync("~/Views/Common/_ProxyForm.cshtml")
@await Html.PartialAsync("~/Views/Common/_InterviewerInsights.cshtml")
@await Html.PartialAsync("~/Views/Common/_ProxyReportDetails.cshtml")
<script>
    $(document).ready(function () {

        applyDataTable();
    });
    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
    </Script>
