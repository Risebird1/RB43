<script>
    $(document).ready(function () {
        $.ajax({
            url: '/DashBoard/InterviewerCandidateRatingDetails',
            type: 'POST',
            success: function (data) {
                $("#divcandidaterating").text(data.candidateRating + " Out of 5");
                GeneratecandidatepaiChart(data.candidateRating);
            }
        });
        $.ajax({
            url: '/DashBoard/InterviewerClientRatingDetails',
            type: 'POST',
            success: function (data) {
                $("#divclientrating").text(data.clientRating + " Out of 5");
                GenerateclientpaiChart(data.clientRating);
            }
        });
        $.ajax({
            url: '/DashBoard/InterviewerPendingPaymentDetails',
            type: 'POST',
            success: function (data) {
                $("#divPendingPayment").text(data.payment + " / " + data.paidpayment);
            }
        });
    });
</script>
<script>
    $(document).ready(function () {
        $.ajax({
            url: '/DashBoard/FetchAlertMessage',
            type: 'POST',
            success: function (data) {
            binddata(data);
            }
        });
    });
</script>
<script>
    function GenerateclientpaiChart(client) {
        var interviewerCountObj = [{ y: client, label: "Client" }, { y: (5 - parseFloat(client)) }]
        var chart = new CanvasJS.Chart("clientrating", {
            theme: "light2",
            width: 175,
            height: 100,
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 8,
                indexLabelFontColor: "#9a9a9a",
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",
                dataPoints: interviewerCountObj
            }]
        });
        chart.render();
    }
    function GeneratecandidatepaiChart(candidate) {
        var interviewerCountObj = [{ y: candidate, label: "Candidate" }, { y: (5 - parseFloat(candidate)) }]
        var chart = new CanvasJS.Chart("candidaterating", {
            theme: "light2",
            width: 175,
            height: 100,
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 8,
                indexLabelFontColor: "#9a9a9a",
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",
                dataPoints: interviewerCountObj
            }]
        });
        chart.render();
    }
