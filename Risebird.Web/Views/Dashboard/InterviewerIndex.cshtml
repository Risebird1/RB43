<script>
    function openVideoKYCAlert() {
        var model = document.getElementById("VideoKYCAlert");
        model.style.display = "block";
    }
</script>

<script>
    function closeInterviewerPaymentDetailsModel() {
        var model = document.getElementById("InterviewerPaymentDetailsModel");
        model.style.display = "none";
    }
    function openInterviewerPaymentDetailsModel() {
        var model = document.getElementById("InterviewerPaymentDetailsModel");
        model.style.display = "block";
    }
    function GenerateclientpaiChart(client) {
        var interviewerCountObj = [{ y: client, label: "Client" }, { y: (5 - parseFloat(client)) }]
        var chart = new CanvasJS.Chart("clientrating", {
            theme: "light2",
            width: 250,
            height: 120,
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 14,
                indexLabelFontColor: "#9a9a9a",
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",
                dataPoints: interviewerCountObj
            }]
        });
        chart.render();
    }
    function GeneratecandidatepaiChart(candidate) {
        var interviewerCountObj = [{ y: candidate, label: "Candidate" }, { y: (5 - parseFloat(candidate)) }]
        var chart = new CanvasJS.Chart("candidaterating", {
            theme: "light2",
            width: 250,
            height: 120,
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 14,
                indexLabelFontColor: "#9a9a9a",
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",
                dataPoints: interviewerCountObj
            }]
        });
        chart.render();
    }
