                    </ul>
                    </div>*@

                    <div class="mobile-view"> <h4 class="card-title"> Dashboard</h4></div>
                </div>

                <div class="pull-right">
                    <div class="">Average Interview Time:<c style="color: blue;font-weight: bold;" id="txtavgInterviewTime">@Model.AvgInterviewTime Min</c></div>
                </div>
            </div>
        </div>
    </div>
</div>
