<div id="VideoKYCAlert" style="display:none;height:25px;">
    <div class="row">
<div class="col-sm-12">
    <div class="alert fade alert-simple alert-warning alert-dismissible text-left font__family-montserrat font__size-16 font__weight-light brk-library-rendered rendered show" role="alert" data-brk-library="component__alert" style="margin-top:-65px;">
        <button type="button" class="close font__size-18" data-dismiss="alert" style="right:40px;top:18px;">
            <span aria-hidden="true">
                <i class="fa fa-times warning" style="font-size:17px;"></i>
            </span>
            <span class="sr-only">Close</span>
        </button>
        <i class="start-icon fa fa-exclamation-triangle faa-flash animated"></i>
            <strong class="font__weight-semibold">Warning!</strong> Please Finish your video KYC before 15th June to continue taking interviews in Risebird platform.     <span onclick="openVideoKYCModel()" aria-hidden="true" style="cursor:pointer;color: #227622;font-weight: bold;padding-left:3px;display:inline-block;text-shadow:none;">Please Click here</span>
        </div>

    </div>
</div></div>
  

<div class="pt30">

    <div class="col-md-12 nopad" style="margin:0px;">
        <div class="card-header bg-w clearfix">
            <div class="col-md-12 pull-left">
                <div class="pull-left myinterview">
                    @*<div class="marquees">
                    <ul class="marquees-content">
