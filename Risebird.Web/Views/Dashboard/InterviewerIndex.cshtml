<div id="CodedResumeNotificationModel" class="modal modal-bg" style="z-index:3;padding-top:5vw !important">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M17 3c0-.55-.45-1-1-1H2c-.55 0-1 .45-1 1v11c0 .55.45 1 1 1h11.5l3.5 3V3z"></path></svg>
                    </span>
                </div>
                <h5 class="modal-title pull-left">Resume Upload Notification <span class="popup-text" id="skill_id_pop"></span></h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeCodedResumeNotificationModel()" aria-hidden="true" style="cursor:pointer;">&times;</span>
            </button>

            <input type="text" hidden id="txtinterviewid" />
            <div class="modal-body">
                Please Upload your latest Resume.<br />
                To upload resume please follow the navigation.<br />
                <strong>Menu --> My Profile </strong> or <strong>Click on Right top account menu -->My Profile</strong>
            </div>
        </div>
    </div>
</div>

