    function uploadresume() {
        $.ajax({
            url: '/Interviewer/InterviewerResumeupdate',
            success: function (data) {
                var modal = document.getElementById("Resumepopup");
                modal.style.display = "block";
                $('#divresumepopup').html('');
                $('#divresumepopup').html(data);
            }
        });
    }

    function closeResumeModel() {
        var model = document.getElementById("Resumepopup");
        model.style.display = "none";
    }
</script>
<script>
    function closePaymentSLADetailsModel() {
        var model = document.getElementById("PaymentSLADetailsModel");
        model.style.display = "none";
    }
    function openPaymentSLADetailsModel() {
        var model = document.getElementById("PaymentSLADetailsModel");
        model.style.display = "block";
    }
    function ConfirmAgreePaymentSLADetails() {
        $.ajax({
            url: '/Interview/AgreeToPaymentSLAConditions',
            type: 'POST',
            success: function (data) {
                closePaymentSLADetailsModel();
            }
        });
    }
    function closeInterviewerRedMarkerReportModel() {
        var model = document.getElementById("InterviewerRedMarkerReportModel");
        model.style.display = "none";
    }
    function openInterviewerRedMarkerReportModel() {
        $.ajax({
            url: '/Interviewer/InterviewerRedMarkerReport',
            type: 'POST',
            success: function (data) {
                $('#divReportRedMarker').html('');
                $('#divReportRedMarker').html(data);
                var model = document.getElementById("InterviewerRedMarkerReportModel");
                model.style.display = "block";
            }
        });
    }
    function AckInterviewerRedMarkerReportModel(uniqueid) {
        $.ajax({
            url: '/Interviewer/AcknowledgeRedmarkers',
            type: 'GET',
            data: { uniqueid: uniqueid },
            success: function (data) {
                closeInterviewerRedMarkerReportModel();
            }
        });
    }




    function InterviewerAcknowledgment() {
        window.open("/Interviewer/InterviewersOnboarding", "_blank");

    }
</script>