@model Risebird.Entities.ViewModel.InterviewerDashboardVM
@using Risebird.Entities.Enum
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{

    ViewData["Title"] = "Dashboard";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    body {
        overflow-y: hidden;
        /*min-height: 1100px !important;*/
    }

    .chardinjs-overlay {
        position: absolute !important;
    }

    .blk-bg {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8) !important;
        position: fixed;
        top: 0;
    }

    #divReportRedMarker table {
        white-space: normal !important;
        width: 100%;
        border: 0px !important;
    }

    #InterviewerRedMarkerReportModel table tr td:hover, #InterviewerRedMarkerReportModel .table-striped tbody tr:hover {
        box-shadow: none !important;
    }

    .swal2-popup .swal2-title {
        text-transform: capitalize !important;
        font-weight: 500 !important;
        padding:10px 0px 0px 0px;
        line-height:23px;

    }
</style>
<script>
    var Header = "<a  style='line-height:50px;'><span id='clientdashboard_1'>Dashboard</span></a>";
    $('#txtpageHeader').empty().html(Header);
</script>

