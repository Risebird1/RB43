<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/interview.css?v=7" />

<!-- END PLUGINS -->
<!-- START THIS PAGE PLUGINS-->

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" defer>


<!-- END THIS PAGE PLUGINS-->
<!-- START TEMPLATE -->
<!--<script type="text/javascript" src="~/js/demo_dashboard.js"></script>-->

<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <!-- End Navbar -->
    <!-- START PAGE CONTAINER -->
    <div class="page-container">


        <div class="page-content">
            <nav class="navbar navbar-expand-lg navbar-transparent btn-primary  navbar-absolute" style="height:53px;">
                <div class="container-fluid">
                    <div class="navbar-wrapper w-full">
                        <div class="navbar-toggle">
                            <button type="button" class="navbar-toggler">
                                <span class="navbar-toggler-bar bar1"></span>
                                <span class="navbar-toggler-bar bar2"></span>
                                <span class="navbar-toggler-bar bar3"></span>
                            </button>
                        </div>
                        <a class="navbar-brand" style=" line-height: 50px;">Dashboard</a>
                    </div>

                </div>
            </nav>

            <div class="panel-header panel-header-sm">
            </div>
            <!-- PAGE CONTENT WRAPPER -->
            <div class="page-content-wrap dashboard">

                <!-- START DASHBOARD CHART -->
                <div class="row">
                    <div class="col-md-12">

                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Tracking</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">
                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="interviewTrackingDate" name="interviewTrackingDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li><button onclick="changeInterviewTracking()" class="panel-fullscreen"><span class="fa fa-eye"></span></button></li>

                                </ul>
                            </div>
                            <div class="panel-body">
                                <div class="chart-holder" id="area-chart" style="height: 200px;"></div>
                                <div class="block-full-width">
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="skill">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Interview Analysis</h3>

                                </div>

                            </div>


                            <div class="panel-body">
                                <div id="myFunnelChart" class="Funnelid"></div>





                            </div>

                        </div>

                    </div>
                    <div class="daily-interview">

                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title-box">
                                    <h3>Daily Interview Stats</h3>

                                </div>
                                <ul class="panel-controls" style="margin-top: 2px;">

                                    <li>
                                        <div class="col-md-12 col-sm-12 nopad interview-date">
                                            <input id="interviewSlotsDate" name="interviewSlotsDate" type="date" class="form-control">
                                        </div>
                                    </li>
                                    <li>

                                        <button onclick="getInterviewSlots()" class="panel-fullscreen"><span class="fa fa-eye"></span></button>
                                    </li>
                                </ul>
                            </div>
                            <div id="slotsId">
                                <div class="panel-body panel-body-table">
                                    <div class="min-h">
                                        @if (Model.DailyMeetingResultsSlots != null && Model.DailyMeetingResultsSlots.Count() > 0)
                                        {

                                            <div class="sb-container scroller-height">
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-striped">
                                                        <thead>
                                                            <tr>
                                                                <th width="30%" class="text-center"><strong>Skill</strong></th>
                                                                <th width="20%" class="text-center"><strong>Morning Count(s)</strong></th>
                                                                <th width="20%" class="text-center"><strong>Evening Count(s)</strong></th>
                                                                <th width="50%" class="text-center"><strong>Result</strong></th>

                                                            </tr>
                                                        </thead>
                                                        <tbody>

                                                            @{
                                                                foreach (var item in Model.DailyMeetingResultsSlots)
                                                                {
                                                                    <tr>
                                                                        <td class="text-center"><strong>@(item.IRFnSkill.Split('(')[1].Split(')')[0])</strong></td>
                                                                        <td class="text-center"><strong>@item.Morning</strong></td>
                                                                        <td class="text-center"><strong>@item.Evening</strong></td>
                                                                        <td class="text-center"><a class="selected" href="#" data-toggle="tooltip" title="Selected : @item.Selected"><span><strong>@item.Selected</strong> </span></a> / <a class="rejected" href="#" data-toggle="tooltip" title="Rejected : @item.Rejected"><span><strong>@item.Rejected</strong></span></a> / <a class="borderline" href="#" data-toggle="tooltip" title="BorderLine : @item.BorderLine"><span><strong>@item.BorderLine</strong></span></a> / <a class="proxy" href="#" data-toggle="tooltip" title="Proxy : @item.Proxy"><span><strong>@item.Proxy</strong></span></a> /  <a class="noshow" href="#" data-toggle="tooltip" title="NoShow : @item.NoShowCount"><span><strong>@item.NoShowCount </strong> </span></a> / <a class="schedule" href="#" data-toggle="tooltip" title="Scheduled : @item.ScheduledCount"><span><strong>@item.ScheduledCount </strong> </span></a> / <a class="dropped" href="#" data-toggle="tooltip" title="Dropped : @item.DroppedCount"><span><strong>@item.DroppedCount</strong></span></a> / <a class="pending" href="#" data-toggle="tooltip" title="Pending : @item.Pending"><span><strong>@item.Pending</strong></span></a></td>

                                                                    </tr>

                                                                }
                                                            }


                                                        </tbody>
                                                    </table>
                                                </div>


                                            </div>
                                            <div class="legend">

                                                <ul>
                                                    <li><div class="g color"></div>Selected</li>
                                                    <li><div class="r color"></div>Rejected</li>
                                                    <li><div class="b color"></div>BorderLine</li>
                                                    <li><div class="pr color"></div>Proxy</li>
                                                    <li><div class="ns color"></div>NoShow</li>
                                                    <li><div class="sch color"></div>Schedule</li>
                                                    <li><div class="dr color"></div>Dropped</li>
                                                    <li><div class="pe color"></div>Pending</li>

                                                </ul>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>No interviews for this day!</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 col-lg-6 col-sm-6">
                                <div class="card">
                                    <div class="card-body">
                                        <p style="width:100%" class="card-text">Total Candidates : <span><strong>@Model.CandidatesCountObj.TotalCandidates</strong></span></p>
                                        <div>
                                            <div id="candidatesPieId" class="PieId"></div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-md-6 col-lg-6 col-sm-6">
                                <div class="card">
                                    <div class="card-body">
                                        <p class="card-text">Total Meetings : <span><strong>@Model.MeetingResultCountObj.TotalMeetingsCount</strong></span></p>
                                        <div>
                                            <div id="meetingsCountId" class="PieId"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- END DASHBOARD CHART -->



            </div>
            <!-- END PAGE CONTENT WRAPPER -->
        </div>
        <!-- END PAGE CONTENT -->
    </div>
    <!-- END PAGE CONTAINER -->





</div>

<script src="https://code.highcharts.com/highcharts.js"></script>
<script src="https://code.highcharts.com/modules/data.js"></script>
<script src="https://code.highcharts.com/modules/drilldown.js"></script>

<script src="https://www.amcharts.com/lib/4/core.js"></script>
<script src="https://www.amcharts.com/lib/4/charts.js"></script>
<script src="https://www.amcharts.com/lib/4/themes/animated.js"></script>

<script>

    var chData= JSON.parse(('@Model.FunnelData').replace(/&quot;/g, '"'));
    am4core.ready(function () {

        // Themes begin
        am4core.useTheme(am4themes_animated);
        // Themes end

        let chart = am4core.create("myFunnelChart", am4charts.SlicedChart);
        chart.data = [{
            "name": "Total Risebird Selections",
            "value": chData.TotalRisebirdSelection
        }, {
            "name": "Completed",
            "value": chData.TotalCompleted
        }, {
            "name": "Total Invites",
                "value": chData.TotalCandidates
        }, {
            "name": "Total Candidates",
            "value": chData.TotalCandidates
        }];


        chart.logo.disabled = true;
        let series = chart.series.push(new am4charts.FunnelSeries());
        series.dataFields.value = "value";
        series.dataFields.category = "name";
        series.labels.template.disabled = false;

        series.colors.step = 16;
        var fillModifier = new am4core.LinearGradientModifier();
        fillModifier.brightnesses = [-0.1, -0.1, -0.1];
        fillModifier.offsets = [0, 0.5, 1];


        series.slices.template.fillModifier = fillModifier;
        series.alignLabels = true;
    series.labels.template.fill = am4core.color("#828080");
        chart.fontSize = 13;
        series.labels.template.text = "{category}: [bold]{value}[/]";

    });
</script>
<script>
    function getDate() {
        var today = new Date();
        var dd = today.getDate();
        var mm = today.getMonth() + 1; //January is 0!
        var yyyy = today.getFullYear();

        if (dd < 10) {
            dd = '0' + dd
        }

        if (mm < 10) {
            mm = '0' + mm
        }

        today = yyyy + '-' + mm + '-' + dd;
        document.getElementById('interviewTrackingDate').value = today;
        //document.getElementById('statusTrackingDate').value = today;
        document.getElementById('interviewSlotsDate').value = today;
        //document.getElementById('progressTrackingDate').value = today;
    }

</script>
<script>

    window.onload = function () {
        getDate();
        var meetingsData = '@Model.MeetingsData';
        meetingsData= JSON.parse(meetingsData.replace(/&quot;/g, '"'));
        var meetingsDataLabels = '@Model.MeetingsDataLabels';
        meetingsDataLabels = JSON.parse(meetingsDataLabels.replace(/&quot;/g, '"'));
        UpdateInterviewTrackingGraph(meetingsData, meetingsDataLabels);
        //candidatesPieId
        if (@Model.CandidatesCountObj.TotalCandidates!= 0) {
           var candidateCountObj = [{ y: @Model.CandidatesCountObj.Proxy, label: "Proxy" },
            { y: @Model.CandidatesCountObj.Selected, label: "Selected" },
            { y: @Model.CandidatesCountObj.Rejected, label: "Rejected" },
            { y: @Model.CandidatesCountObj.BorderLine, label:"Border Line"},
            { y: @Model.CandidatesCountObj.NoShowCount, label:"No Show"},
            { y: @Model.CandidatesCountObj.ScheduledCount, label:"Scheduled"},
            { y: @Model.CandidatesCountObj.DroppedCount, label:"Dropped"},
            { y: @Model.CandidatesCountObj.QCPending, label:"Quality Check Pending"}]

            var chart = new CanvasJS.Chart("candidatesPieId", {
                theme: "light2",
                width: 350,//in pixels
                height: 200,//in pixels
                animationEnabled: true,
                title: null,
                data: [{
                    type: "pie",
                    startAngle: 60,
                    innerRadius: 55,
                    indexLabelFontSize: 15,
                    indexLabel: "{label}  {y}",
                    toolTipContent: "<b>{label} </b>({y})",

                    dataPoints: candidateCountObj
                }]
            });
            chart.render();
        }


        //meetingsCountId
        var meetingsCountObj = [{ y: @Model.MeetingResultCountObj.ProxyCount, label: "Proxy" },
            { y: @Model.MeetingResultCountObj.SelectedCount, label: "Selected" },
            { y: @Model.MeetingResultCountObj.RejectedCount, label: "Rejected" },
            { y: @Model.MeetingResultCountObj.BorderLineCount, label:"Border Line"},
            { y: @Model.MeetingResultCountObj.NoShowCount, label:"No Show"},
            { y: @Model.MeetingResultCountObj.ScheduledCount, label:"Scheduled"},
            { y: @Model.MeetingResultCountObj.DroppedCount, label: "Dropped" },
            { y: @Model.MeetingResultCountObj.Pending, label:"Pending"}
            @*{ y: @Model.MeetingResultCountObj.StatusPendingCount, label:"Status Pending"}*@
            @*{y : @Model.MeetingResultCountObj.NoResultCount, label:"No Results"}*@]

        var chart = new CanvasJS.Chart("meetingsCountId", {
           theme: "light2",
            width: 350,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: null,
            data: [{
                type: "pie",
                startAngle: 60,
                innerRadius: 55,
                indexLabelFontSize: 15,
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",

                dataPoints: meetingsCountObj
            }]
        });
        chart.render();

    }

</script>
<script>
    function changeInterviewTracking() {
        document.getElementById('area-chart').innerHTML = '';
        var date = document.getElementById('interviewTrackingDate').value;
        $.ajax({
            url: '/Dashboard/GetDateWiseClientInterviews',
            data: { 'date': date, 'emailId': '@Model.EmailId' },
            success: function (data) {
                UpdateInterviewTrackingGraph(JSON.parse(data.meetingsData), JSON.parse(data.meetingsDataLabels));
            }
        });
    }

    function UpdateInterviewTrackingGraph(meetingsData, meetingsDataLabels) {

        config = {
            data: meetingsData,
            xkey: 'Time',
            ykeys: meetingsDataLabels,
            labels: meetingsDataLabels,
            resize: true,
            hideHover: true,
            xLabels: 'hour',
            yLabelFormat: function (y) { return y != Math.round(y) ? '' : y; },
            gridTextSize: '10px',
            //lineColors: ['#1caf9a', '#33414E'],
            gridLineColor: '#E5E5E5'
        };
        config.element = 'area-chart';
        Morris.Area(config);

    }
</script>
<script>
    function getInterviewSlots() {
        var date = document.getElementById('interviewSlotsDate').value;
        $.ajax({
            url: '/Dashboard/GetDateWiseClientMeetingsSlots',
            data: { 'date': date , 'emailId': '@Model.EmailId'},
            success: function (data) {
                $('#slotsId').html('');
                $('#slotsId').html(data);


            }
        });
    }

</script>
