<script>
    function updateInterviewTracking() {
        document.getElementById('area-chart').innerHTML = '';
        var dateValue = document.getElementById('interviewTrackingDate').value;
        if (dateValue == null || dateValue == '') {
            dateValue = getDate();
        }
        $.ajax({
            url: '/Dashboard/GetDateWiseClientInterviews',
            data: { 'dateValue': dateValue, 'emailId': '@Model.EmailId' },
            success: function (data) {
                UpdateInterviewTrackingGraph(JSON.parse(data.meetingsData), JSON.parse(data.meetingsDataLabels));
            }
        });
    }

    function UpdateInterviewTrackingGraph(meetingsData, meetingsDataLabels) {

        config = {
            data: meetingsData,
            xkey: 'Time',
            ykeys: meetingsDataLabels,
            labels: meetingsDataLabels,
            resize: true,
            hideHover: true,
            xLabels: 'hour',
            yLabelFormat: function (y) { return y != Math.round(y) ? '' : y; },
            gridTextSize: '10px',
            //lineColors: ['#1caf9a', '#33414E'],
            gridLineColor: '#E5E5E5'
        };
        config.element = 'area-chart';
        Morris.Area(config);

    }
</script>


<script>

    function getInterviewSlots() {
        var dateValue = document.getElementById('interviewSlotsDate').value;
        if (dateValue == null || dateValue == '') {
            dateValue = getDate();
        }
        $.ajax({
            url: '/Dashboard/GetDateWiseClientMeetingsSlots',
            data: { 'dateValue': dateValue , 'emailId': '@Model.EmailId'},
            success: function (data) {
                $('#slotsId').html('');
                $('#slotsId').html(data);


            }
        });
    }

</script>
