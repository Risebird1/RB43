@model List<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities.Enum
@{
    ViewData["Title"] = "GetColdCandidatesList";
}
<script>
    var Header = "<div>Cold Candidate</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<style>
    .swal2-popup #swal2-content {
        font-size: 18px;
    }
</style>
<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous" />

<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<div class="main-panel" id="main-panel">

    <div class="content  client">
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">Cold Candidate</h4></div>
                    </div>

                    <div class="pull-right client-ms">
                        @if (ViewBag.ReturnBack == 1)
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                    </div>


                    <div class="pull-left">
                        @if (ViewBag.ColdCandidateValue == 0)
                        {
                            <div class="feedback-tab-ac" onclick="Changeurldetails(0,'@ViewBag.ReturnBack')"><strong>Potential Cold Candidate</strong></div>
                            <div class="feedback-tab" onclick="Changeurldetails(1,'@ViewBag.ReturnBack')"><strong>Cold Candidate</strong></div>

                        }
                        else if (ViewBag.ColdCandidateValue == 1)
                        {
                            <div class="feedback-tab" onclick="Changeurldetails(0,'@ViewBag.ReturnBack')"><strong>Potential Cold Candidate</strong></div>
                            <div class="feedback-tab-ac" onclick="Changeurldetails(1,'@ViewBag.ReturnBack')"><strong>Cold Candidate</strong></div>

                        }



                    </div>
                </div>
            </div>
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div class="dataloading">

                                <div class="toolbar">


                                    <div class="cold-candidate">

                                        <div id="tableID" class="second" style="overflow-x:scroll">
                                            <table id="mailsTable" class="table table-striped  table-bordered dt-responsive" cellspacing="0" width="100%">
                                                <thead>
                                                    <tr>
                                                        <th>Skill Channel</th>
                                                        <th>Interview Date</th>
                                                        <th>Candidate Email</th>
                                                        <th>Candidate Name</th>
                                                        <th>Mobile Number</th>
                                                        <th>Client Name</th>
                                                        <th>Channel Owner</th>
                                                        <th>Current Status</th>
                                                        <th>Total Mails</th>
                                                    @if (ViewBag.ColdCandidateValue == 1)
                                                    { 
                                                    <th>Is Cold Candidate</th>
                                                    <th>Cold Candidate Marked By</th>
                                                    <th>Cold Candidate Marked Date</th>
                                                    }
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Email</th>
                                                    <th>Candidate Name</th>
                                                    <th>Mobile Number</th>
                                                    <th>Client Name</th>
                                                    <th>Channel Owner</th>
                                                    <th>Current Status</th>
                                                 <th>Total Mails</th>
                                                    @if (ViewBag.ColdCandidateValue == 1)
                                                    {
                                                        <th>Is Cold Candidate</th>
                                                        <th>Cold Candidate Marked By</th>
                                                        <th>Cold Candidate Marked Date</th>
                                                    }
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)  
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        <td>@item.candidateEmail</td>
                                                        <td>@item.candidateName</td>
                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                            {
                                                                <td>
                                                                    <span aria-label="Click here to call the candidate">
                                                                        <span onclick="CommonCallButtonClick('@item.candidateName','@item.MobileNumber', '@item.candidateEmail','@item.imid','@item.IRFId', 'Candidate')" data-original-title="Tooltip on top" title="Click here to call the candidate."><img src="/img/calling.png" width="17"></span>
                                                                    </span>@item.MobileNumber
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                        <td>@item.ClientName</td>
                                                        <td>@item.ChannelOwner</td>
                                                            <td class="text-center">


                                                                @if (item.StatusValue == "In Progress")
                                                                {
                                                                    <span class="current progress" style="font-size:12px; height:19px;font-weight: 500;"> @item.StatusValue</span>
                                                                }
                                                                else if (item.StatusValue == "New")
                                                                {

                                                                    <span class="current new" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>

                                                                }

                                                                else if (item.StatusValue == "Added")
                                                                {
                                                                    <span class="current added" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                }

                                                                else if (item.StatusValue == "Waiting For Response")
                                                                {

                                                                    <span class="current waiting" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>

                                                                }
                                                                else if (item.StatusValue == "Scheduled")
                                                                {

                                                                    <span class="current scheduled" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>

                                                                }
                                                                else if (item.StatusValue == "Cancelled")
                                                                {
                                                                    <span class="current cancelled" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                }
                                                                else if (item.StatusValue == "No Show(Candidate)")
                                                                {
                                                                    <span class="current noshowcandidate" style="font-size:12px;font-weight: 500;">@item.StatusValue</span>
                                                                }

                                                                else if (item.StatusValue == "Irrelevant")
                                                                {
                                                                    <span class="current irrelevant" style="font-size:12px;font-weight: 500;"> @item.StatusValue</span>
                                                                }
                                                                else if (item.StatusValue == "Duplicate")
                                                                {
                                                                    <span style=" color: hotpink;font-weight: 500;font-size:12px">
                                                                        @item.StatusValue
                                                                    </span>
                                                                }
                                                                else if (item.StatusValue == "Not Interested")
                                                                {
                                                                    <span style=" color: purple;font-weight: 500;font-size:12px">
                                                                        @item.StatusValue
                                                                    </span>
                                                                }
                                                                else if (item.StatusValue == "Got Another Offer")
                                                                {
                                                                    <span style=" color: darkgreen;font-weight: 500;font-size:12px">
                                                                        @item.StatusValue
                                                                    </span>
                                                                }
                                                                else if (item.StatusValue == "Hold")
                                                                {
                                                                    <span style="color: orangered;font-weight: 500;font-size:12px">
                                                                        @item.StatusValue
                                                                    </span>
                                                                }
                                                                else if (item.StatusValue == "Meeting Status")
                                                                {
                                                                    <div style="color: #c572ac;font-weight: 500; padding:2px; font-size: 12px;background: #e892c652;display: inline;">
                                                                        @if (item.LatestComment != null && item.LatestComment != "")
                                                                        {
                                                                            @if (item.LatestComment.Length > 20)
                                                                            {
                                                                                <div class="article">
                                                                                    <p style="margin-bottom:0px;">
                                                                                        @item.LatestComment.Substring(0, 20)
                                                                                    </p>
                                                                                    <p class="moretext_@item.CandidateId moretext">
                                                                                        @item.LatestComment.Substring(20, @item.LatestComment.Length - 20)
                                                                                    </p>
                                                                                </div>
                                                                                <a onclick="moreless('@item.CandidateId')" class="moreless-button" value="Readmore" id="read_@item.CandidateId" href="#">Read more</a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="article" style="overflow:hidden;display:inline-flex">
                                                                                    <p>
                                                                                        @item.LatestComment.Substring(0, @item.LatestComment.Length)
                                                                                    </p>
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                }
                                                                else if (item.StatusValue == "Invitation Sent")
                                                                {
                                                                    <span style="color:#7d7079;font-weight: 500; padding:2px; font-size: 12px;background: #77838345;">
                                                                        @item.StatusValue
                                                                    </span>
                                                                }
                                                                else if (item.StatusValue == "Interview Status")
                                                                {
                                                                    <div style="color:#4832d4ab;font-weight: 500; padding:2px; font-size: 12px;background:#d9d6ef94;display: inline;">
                                                                        @if (item.LatestComment != null && item.LatestComment != "")
                                                                        {
                                                                            @if (item.LatestComment.Length > 20)
                                                                            {
                                                                                <div class="article">
                                                                                    <p style="margin-bottom:0px;">
                                                                                        @item.LatestComment.Substring(0, 20)
                                                                                    </p>
                                                                                    <p class="moretext_@item.CandidateId moretext">
                                                                                        @item.LatestComment.Substring(20, @item.LatestComment.Length - 20)
                                                                                    </p>
                                                                                </div>
                                                                                <a onclick="moreless('@item.CandidateId')" class="moreless-button" value="Readmore" id="read_@item.id" href="#">Read more</a>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="article" style="overflow:hidden;display:inline-flex">
                                                                                    <p>
                                                                                        @item.LatestComment.Substring(0, @item.LatestComment.Length)
                                                                                    </p>
                                                                                </div>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <span> @item.StatusValue</span>
                                                                        }

                                                                    </div>

                                                                }
                                                            </td>
                                                        <td>
                                                           
                                                                @if (item.MailCount != 0)
                                                                {
                                                                    <div class="row">
                                                                        <span class="icon-field" style="display:block;width:auto;float:left"><i class="fa fa-envelope" style="color: #F9A825;font-size:15px;position:relative;top:2px;padding: 0px 5px 0px 0px;"></i>  Emails :</span>    <span class="icon-field" style="display:block;width:auto;float:left">
                                                                            <a class="icon-link" href="#!!_@item.imid" title="Emails Sent/Delivered" style="cursor:pointer" data-toggle="ajax-modal-CommunicationDetails" data-target="#modalCommunicationDetails" data-url="@Url.Action("GetCommunicationDetails", "Candidate", new { interviewId = item.imid, communicationMedium = (int)CommunicationMedium.Email })">
                                                                                @item.MailCount
                                                                            </a>
                                                                        </span>
                                                                    </div>
                                                                }
                                                            </td>

                                                            @if (ViewBag.ColdCandidateValue == 1)
                                                            {
                                                                <td>Yes</td>
                                                                <td>@item.ColdMarkedBY</td>
                                                                <td>@item.ColdMarkedDate</td>
                                                            }

                                                            <td>
                                                                <button class="btn btn-candlist shadow btn-xs sharp me-1" aria-label="Candidate Status List" style="width:25px!important;height:25px!important;background:#f4c781;border-color:#f4c781;position:relative;left:7px;">
                                                                    <span onclick="GetCandidateStatusList('@item.irfIntId','@item.CandidateMasterId', '@item.IRFId', '@item.candidateEmail')" title="Candidate Status List">
                                                                        <svg style="position:relative;top:-1px; left:-2px" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="#fff" d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>
                                                                    </span>
                                                                </button>
                                                                @if (ViewBag.ColdCandidateValue == 1)
                                                                {
                                                                    <span>
                                                                        <button class="btn btn-candlist shadow btn-xs sharp me-1 " aria-label="Mark Cold Candidate" style="width:25px!important;height:25px!important;background:#e3ab8391;border-color:#e3ab8391;position:relative;left:10px">
                                                                            <span onclick="UndoMarkedColdCandidate('@item.CandidateId','@item.IRFId', '@item.candidateEmail','@item.irfIntId','@item.scheduleUniqueid','@item.imid','',2);" title="Undo Mark Cold Candidate" class="mdc-fab__icon touch">
                                                                                <img src="~/img/approve-blk.png" width="18" style="max-width: 18px!important;position: relative;top: -1.5px;left: -2px;" />
                                                                            </span>
                                                                        </button>
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span>
                                                                        <button class="btn btn-candlist shadow btn-xs sharp me-1 " aria-label="Mark Cold Candidate" style="width:25px!important;height:25px!important;background:#e3ab8391;border-color:#e3ab8391;position:relative;left:10px">
                                                                            <span onclick="MarkedColdCandidate('@item.CandidateId','@item.IRFId', '@item.candidateEmail','@item.imid','@item.irfIntId');" title="Mark Cold Candidate" class="mdc-fab__icon touch">
                                                                                <img src="~/img/approve-blk.png" width="18" style="max-width: 18px!important;position: relative;top: -1.5px;left: -2px;" />
                                                                            </span>
                                                                        </button>
                                                                    </span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>

                                        </div>
                                    </div>

                                    <!-- end content-->
                                </div>

                                <!-- end col-md-12 -->
                            </div>




                            <!-- end row -->
                        </div>

                    </div>
                </div>


            </div>

        </div>

    </div>
</div>
 @await Html.PartialAsync("~/Views/Candidate/AddCandidateStatusPartial.cshtml")
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
<script src="~/js/TwilioCallMaker.js" asp-append-version="true"></script>
<div id="modal_recipientActivity_placeholder"></div>
<div id="modal_candidateCommunicationDetails_placeholder"></div>
<script src="~/js/ModalFormServerValidation.js?v=2024"></script>
<script src="~/js/markcoldcandidate.js?v=2024" asp-append-version="true"></script>
<script src="~/js/common.js?v=2024"></script>

<script>

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#mailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
    }

    function Changeurldetails(type, returnBack) {
        window.location.href = "/Dashboard/GetColdCandidatesList?ColdCandidateValue=" + type + "&returnBack=" + returnBack;
    }

    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
</script>


