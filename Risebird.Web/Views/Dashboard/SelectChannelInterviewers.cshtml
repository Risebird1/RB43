@model Risebird.Entities.ViewModel.AddChannelInterviewersVM
@{
    ViewData["Title"] = "Select Interviewers";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<a href='/DashBoard/InterviewerSkills'>GetISCInterviewers</a>&nbsp;/&nbsp;Interviewer";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    @*<nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                @Html.ActionLink("GetISCInterviewers", "InterviewerSkills", new { id = @ViewBag.ISCId, InterviewerSkillidName = @ViewBag.ISCName }, htmlAttributes: new { @class = "navbar-brand breadcrumscolor" })
                <a class="navbar-brand"> / &nbsp; Interviewer</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>*@
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title col-md-12">Select interviewers for <strong>'@Model.ChannelTitle'</strong></h4>

                </div>


            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div style="width:100%;">&nbsp;</div>
                            <div>
                                <div id="tableID">
                                    @if (Model.ChannelInterviewersCollection == null || Model.ChannelInterviewersCollection.Count() == 0)
                                    {
                                        <p style="text-align:center; font-size:20px"> Interviewers with the matching skills unavailable.</p>
                                    }
                                    else
                                    {
                                        @using (Html.BeginForm("SelectChannelInterviewers", "DashBoard", FormMethod.Post, new { enctype = "multipart/form-data" }))
                                        {
                                            <div class="col-md-10 mobpad" style="margin:auto;">
                                            <div class="table-responsive-sm">
                                                <table id="meeting" class="table table-striped table-bordered" cellspacing="0" style="text-align:left">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>EmailId</th>
                                                            @*<th>Skills</th>*@
                                                            <th class="text-center">Add</th>
                                                        </tr>
                                                    </thead>
                                                    <tfoot>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>EmailId</th>
                                                            @*<th>Skills</th>*@
                                                            <th class="text-center">Add</th>
                                                        </tr>
                                                    </tfoot>
                                                    <tbody>


                                                        @for (int i = 0; i < Model.ChannelInterviewersCollection.Count(); i++)
                                                        {
                                                            <tr>
                                                                <td>@Model.ChannelInterviewersCollection[i].FirstName</td>
                                                                <td>@Model.ChannelInterviewersCollection[i].EmailId</td>
                                                                @*<td>@Model.ChannelInterviewersCollection[i].SkillName</td>*@
                                                                <td class="text-center">@Html.CheckBoxFor(m => m.ChannelInterviewersCollection[i].IsAdded)</td>
                                                                @Html.HiddenFor(m => m.ChannelInterviewersCollection[i].UserId)
                                                                @Html.HiddenFor(m => m.ChannelInterviewersCollection[i].InterviewerProfileId)

                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            </div>
                                            @Html.HiddenFor(m => m.ChannelId)
                                            @Html.HiddenFor(m => m.ChannelTitle)



                                            <div class="card-footer ">
                                                <div class="row">

                                                    <div class="col-md-11 mc-button-area">


                                                        @Html.ActionLink("Back", "AddInterviewerList", "DashBoard", new { id = Model.ChannelId, channelname = Model.ChannelTitle }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })

                                                        <input type="submit" value="Submit" id="btnSubmit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" />

                                                    </div>
                                                </div>
                                            </div>

                                        }
                                    }

                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>

        <!-- end row -->
    </div>

</div>



