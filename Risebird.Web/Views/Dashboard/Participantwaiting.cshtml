@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>

@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.Data;
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Participant Waiting";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Participant Waiting</h4></div>
                </div>
                <div class="pull-left">
                    @if (ViewBag.Type == "Interviewer")
                    {
                        <div class="feedback-tab" onclick="Changeurldetails('Candidate','@ViewBag.ReturnBack')"><strong>Candidate</strong></div>
                        <div class="feedback-tab-ac" onclick="Changeurldetails('Interviewer','@ViewBag.ReturnBack')"><strong>Interviewer</strong></div>
                    }
                    else
                    {
                        <div class="feedback-tab-ac" onclick="Changeurldetails('Candidate','@ViewBag.ReturnBack')"><strong>Candidate</strong></div>
                        <div class="feedback-tab" onclick="Changeurldetails('Interviewer','@ViewBag.ReturnBack')"><strong>Interviewer</strong></div>
                    }
                </div>
                
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">
                                <div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Who Joined</th>
                                                    <th>Meeting Link</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Contact</th>
                                                    <th>Candidate Email</th>
                                                    <th>Interviewer</th>
                                                    <th>Interviewer Contact</th>
                                                    <th>Client Name</th>
                                                    <th>Channel Owner</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Who Joined</th>
                                                    <th>Meeting Link</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Contact</th>
                                                    <th>Candidate Email</th>
                                                    <th>Interviewer</th>
                                                    <th>Interviewer Contact</th>
                                                    <th>Client Name</th>
                                                    <th>Channel Owner</th>
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr id=@item.Interviewid>
                                                        <td title=@item.IRFId> @item.IRFId </td>
                                                        <td> @item.interviewDate </td>
                                                        <td style="color: #0b8c0b;">
                                                            <div id="section">
                                                                @if (item.WhoJoined != null && item.WhoJoined != "")
                                                                {
                                                                    @if (item.WhoJoined.Length > 30)
                                                                    {
                                                                        <div class="article">
                                                                            <p style="margin-bottom:0px;">
                                                                                @item.WhoJoined.Substring(0, 30)
                                                                            </p>
                                                                            <p class="moretext_@item.Interviewid moretext">
                                                                                @item.WhoJoined.Substring(30, @item.WhoJoined.Length - 30)
                                                                            </p>
                                                                            <a onclick="moreless(@item.Interviewid)" class="moreless-button" value="Readmore" id="read_@item.Interviewid" href="#">Read more</a>

                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="article">
                                                                            <p>
                                                                                @item.WhoJoined.Substring(0, @item.WhoJoined.Length)
                                                                            </p>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div></div>
                                                                }
                                                            </div>
                                                        </td>
                                                        @if (ViewBag.Type == "Interviewer")
                                                        {
                                                         <td onclick="captureclick('Meeting','CandidatePortal','@item.imid')">
                                                                    <div class="btn btn-copy shadow btn-xs sharp-btn me-1" aria-label="Copy Public URL" style="top: 0px;position: relative;cursor: pointer; width:145px!important;height:25px!important">
                                                                        <span onclick="javascript:CopyPublicUrl('@item.candidateEmail','@item.irfIntId',1);" title="Copy Public URL">Candidate meeting link</span>
                                                                    </div>
                                                         </td>
                                                         }
                                                         else
                                                         {
                                                             <td class="cadName" onclick="captureclick('Meeting','MeetingInternal','@item.imid')">
                                                                    <div class="btn btn-copy shadow btn-xs sharp-btn me-1" aria-label="Copy Public URL" style="top: 0px;position: relative;cursor: pointer; width:145px!important;height:25px!important">
                                                                        <span onclick="javascript:InterviewerPortalUrl('@item.irfIntId','@item.imid');" title="Interviewer Portal URL">Interviewer meeting link</span>
                                                                    </div>
                                                                </td>
                                                         }
                                                        @* <td>
                                                            @if (!string.IsNullOrWhiteSpace(item.zoomLink))
                                                            {
                                                                <a target="_blank" href=@item.zoomLink>Meeting link</a>
                                                            }
                                                        </td> *@
                                                        <td>@item.candidateName</td>
                                                        <td>@item.MobileNumber </td>
                                                        <td> @item.candidateEmail<input type="text" hidden id="txtcandidateemail_@item.imid" value="@item.candidateEmail" /></td>
                                                        @if (@item.interviewer != null || @item.interviewer != "")
                                                        {
                                                            <td>
                                                                <d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer"> @item.interviewer</d>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                <d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">
                                                                    not
                                                                </d>
                                                            </td>
                                                        }
                                                        <td>
                                                            <span aria-label="Click here to call the interviewer">
                                                                <span onclick="CommonCallButtonClick('@item.InterviewerName','@item.InterviewerMobileNumber', '@item.interviewer',null, null, 'Interviewer')" data-original-title="Tooltip on top" title="Click here to call the candidate."><img src="/img/calling.png" width="20"></span>
                                                            </span>@item.InterviewerMobileNumber
                                                        </td>
                                                        <td>@item.Name</td>
                                                        <td>@item.HRCoordinatorEmailId</td>
                                                        <td class="meeting-detail-icon">
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                                <span onclick="javascript:FetchHistory('@item.ZoomMeetingId');" title="Meeting Details" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                                                                        <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1 .025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z" />
                                                                        <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0v1z" />
                                                                        <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5z" />
                                                                    </svg>
                                                                </span>
                                                            </button>

                                                            <button class="mdc-fab app-fab--absolute" aria-label="Interviewing Members" style="position:relative;top:-3px;">
                                                                <span onclick="javascript:getIRFMembers('@item.irfIntId');" title="Interviewing Members" class="mdc-fab__icon material-icons">
                                                                    <i class="fas fa-users fa-xs" style="font-size: 13px;"></i>
                                                                </span>
                                                            </button>

                                                        </td>
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <!-- end content-->
                        </div>
                        <!-- end col-md-12 -->
                    </div>
                    <!-- end row -->
                </div>
            </div>
        </div>
    </div>
</div>

