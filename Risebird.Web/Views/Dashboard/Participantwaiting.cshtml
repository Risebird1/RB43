<script type="text/javascript">
    var closeMember = document.getElementById("membersPopUp");
    // When the user clicks on <span> (x), close the modal
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewerMemberModal");
        modal.style.display = "none";
    }
    function getIRFMembers(id) {
        $.ajax({
            url: '/IRF/GetIRFInterviewerMembers',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);
            }
        });
    }
</script>

<script>
    function RefreshSearch() {
        $('#meetingTable').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }
    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#meetingTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter input:eq(0)").after("<span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();
                    }
                    else { $("#x").show(); }
                });
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingTable").show();
        }, 2000);
    };
</script>

<script>
    function moreless(id) {
        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
    function FetchHistory(meetingid) {
        $.ajax({
            type: "POST",
            url: "/DashBoard/FetchZoomMeetingHistory",
            data: { 'meetingid': meetingid },
            success: function (data) {
                var modal = document.getElementById("ZoomMeetingHistory");
                modal.style.display = "block";
                bindZoomMeetingHistoryData(data);
            }
        });
    }
    function bindZoomMeetingHistoryData(data) {
        var html = '';
        html += '';
        html += '<table class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">';
        html += '<thead>';
        html += '<tr>';
        html += '   <th>Event</th>';
        html += '   <th>Name</th>';
        html += '   <th>Date</th>';
        html += '</tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            html += '<tr>';
            html += '<td>' + data[i].event + '</td>';
            html += '<td>' + data[i].participantName + '</td>';
            html += '<td>' + data[i].actionDate + '</td>';
            html += '</tr>';
        }
        if (data.length == 0) {
            html += '<tr><td colspan ="3">No record found</td></tr>';
        }
        html += '    </tbody> ';
        html += '</table> ';
        $("#divZoomMeetingHistory").empty().html(html);
    }
    function closeZoomMeetingHistory() {
        var modal = document.getElementById("ZoomMeetingHistory");
        modal.style.display = "none";
    }
    function Changeurldetails(type,returnBack) {
        window.location.href = "/DashBoard/Participantwaiting?type=" + type + "&returnBack=" + returnBack;
    }
</script>
<script>
    function InterviewerPortalUrl(irfid,interviewid) {
         $.ajax({
            url: '/Interview/GetInterviewerPortalUrl',
            data: { 'irfid': irfid,'interviewid' :interviewid},
            type: 'POST',
            success: function (result) {
                var modal = document.getElementById("PublicUrlShareModel");
                modal.style.display = "block";
                $("#txtUrl").text(result);
            }
        });
    }
    function CopyPublicUrl(EmailId,IRFId,type) {
        $.ajax({
            url: '/Candidate/GetPublicURLCandidate',
            data: { 'Emailid': EmailId,'IRFId' :IRFId,'type':type},
            type: 'POST',
            success: function (result) {
                var modal = document.getElementById("PublicUrlShareModel");
                modal.style.display = "block";
                $("#txtUrl").text(result);
            }
        });
    }

    function closePublicUrlShareModel() {
        var modal = document.getElementById("PublicUrlShareModel");
        modal.style.display = "none";
    }

    function copyToClipboard(element) {
        var temp = $("<input>");
        $("body").append(temp);
        temp.val($(element).text()).select();
        document.execCommand("copy");
        temp.remove();
        $('#special_text').text('Copied');
    }

</script>
<script>
    var actionclick = 1;
    function captureclick(type, buttonaction, interviewid) {
        var currenturl = window.location.href;
        if (actionclick == 1) {
            actionclick = 0;
            $.ajax({
                url: '/ActivityTracker/CapturePageClick',
                method: 'POST',
                async: true,
                data: {
                    'type': type,
                    'currenturl': currenturl,
                    'buttonaction': buttonaction,
                    'interviewid': interviewid
                },
                success: function (result) {
                    actionclick = 1;
                }
            });
        }
    }
</script>

