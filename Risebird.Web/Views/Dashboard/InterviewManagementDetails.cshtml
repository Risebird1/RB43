@model IEnumerable<Risebird.Entities.ViewModel.InterviewManagementVM>
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{

    ViewData["Title"] = "Interview Management";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
}
@if (HttpContextAccessor.HttpContext.Session.GetString("InterviewManagementDetailsfilters") != null)
{
    filter = JsonConvert.DeserializeObject<MyInterviewFilter>(HttpContextAccessor.HttpContext.Session.GetString("InterviewManagementDetailsfilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
}
<script>
    var Header = "<div>Emergency Management</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Emergency Interview Management</h4></div>
                </div>
                <div class="pull-left">
                </div>
                <div class="pull-right">
                    <div>
                        <div class="pull-left" style="margin-left:10px">
                            <div class="filtercon">
                                <div id="myinterview_3">
                                    <a href='/Dashboard/Dashboard911' class='mdc-button mdc-button--raised mdc-ripple-upgraded'>Back</a>
                                    <a onclick="" data-tooltip="To visualize older data, please apply filter" data-placement="right">
                                        <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded first card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="right" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                            <div class="mdc-button__ripple"></div>
                                        </button>
                                    </a>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg" role="document">
                                    <div class="modal-content">
                                        <div class="filheader">
                                            <div class="filavatar">
                                                <span class="fa fa-filter"></span>
                                            </div>
                                            <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                        </div>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <form action="@Url.Action("InterviewManagementDetails","Dashboard")" method="post" id="form" class="myinterview_modal" onsubmit="return checkfilterDate();">
                                            <div class="modal-body ">
                                                <div class="row">
                                                    <div class="col-md-6 col-sm-6 border-rv">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12col-sm-12 desp-label" for="StartDate">
                                                                Start Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="StartDate" name="StartDate" type="date" class="form-control" onblur="checkStartDate(this.value)">
                                                            </div>
                                                            <label class="text-danger col-md-6 col-sm-6" id="startDateCheck" style="display:none;"></label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-sm-6">
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                End Date
                                                            </label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <input id="EndDate" name="EndDate" type="date" class="form-control" onblur="checkEndDate(this.value)">
                                                            </div>
                                                            <label class="text-danger col-md-6 col-sm-6" id="endDateCheck" style="display:none;"></label>
                                                        </div>
                                                    </div>
                                                    <div class="form-group">
                                                        <div>
                                                            <div class="col-md-12 col-sm-12">
                                                                <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                    <font style="font-size:12px;"> Reset Filter</font>
                                                                </button>
                                                                <button id="submitFilter" type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                    <font style="font-size:12px;"> Apply Filter</font>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="toolbar">
                                <div class="scrollbar int-table" id="style-2">
                                    <div id="tableID" class="second ">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Interviewer Joinedon</th>
                                                    <th>Candidate Joinedon</th>
                                                    <th>Interviewer</th>
                                                    <th>Candidate Email</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Mobile</th>
                                                    <th>Candidate Resume</th>
                                                    <th>JD Title</th>
                                                    <th>Client</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Meeting Status</th>
                                                    <th>Status</th>
                                                    <th>Channel Owner</th>
                                                    <th>Latest Interview</th>
                                                    <th>Latest Status</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Interviewer Joinedon</th>
                                                    <th>Candidate Joinedon</th>
                                                    <th>Interviewer</th>
                                                    <th>Candidate Email</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Mobile</th>
                                                    <th>Candidate Resume</th>
                                                    <th>JD Title</th>
                                                    <th>Client</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Meeting Status</th>
                                                    <th>Status</th>
                                                    <th>Channel Owner</th>
                                                    <th>Latest Interview</th>
                                                    <th>Latest Status</th>
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        <td class="intime-on">
                                                            <div style="float:left">@item.Joinedon </div>
                                                            @if (item.Joinedon != null)
                                                            {
                                                                <a class="infos" href="#"><span class="time"><p style="color:darkblue"><b style="color: #673AB7;">First Attempt:</b> @item.FirstJoinedon</p><p style="color:darkgreen"><b style="color: green;">Last Attempt:</b> @item.Joinedon</p></span></a>
                                                            }
                                                        </td>

                                                        <td class="ctime-on">
                                                            <div style="float:left">@item.PerformedOn </div>
                                                            @if (item.PerformedOn != null)
                                                            {
                                                                <a class="infos" href="#"><span class="candtime"><p style="color:darkblue"><b style="color: #673AB7;">First Attempt:</b> @item.FirstPerformedOn</p><p style="color:darkgreen"><b style="color: green;">Last Attempt:</b> @item.PerformedOn</p></span></a>
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (item.interviewer != null)
                                                            {
                                                                <i class="fa fa-envelope" style="color:#ffa000bd;font-size:15px;position:relative;top:2px;"></i> @item.interviewer
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.candidateEmail != null)
                                                            {

                                                                <i class="fa fa-envelope" style="color:#ffa000bd;font-size:15px;position:relative;top:2px;"></i> @item.candidateEmail
                                                            }
                                                        </td>
                                                        <td>@item.candidateName</td>
                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                        {
                                                            <td>
                                                                <span aria-label="Click here to call the candidate">
                                                                    <span onclick="CommonCallButtonClick('@item.candidateName','@item.MobileNumber', '@item.candidateEmail','@item.id', null, 'Candidate')" data-original-title="Tooltip on top" title="Click here to call the candidate."><img src="/img/calling.png" width="20"></span>
                                                                </span>@item.MobileNumber
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.resumeLink != null && item.resumeLink != "")
                                                        {
                                                            <td> <a style="padding:0px;" id="resumeId" target="_blank" title="Resume" href=@item.resumeLink><img style="position:relative;left: -3px;" src="/img/resume-icon.png" width="21">Resume</a> </td>
                                                        }
                                                        else
                                                        {
                                                            <td>No Resume</td>
                                                        }
                                                        <td>
                                                            @item.JDTiltle
                                                        </td>
                                                        <td>@item.ClientName</td>
                                                        @if (item.EIAssigned)
                                                        {
                                                            <td style="color:forestgreen;font-weight:500;"><i class="fa fa-check" style="color: #4CAF50;font-size:15px;position:relative;top:2px;padding-right: 5px;"></i>Yes</td>
                                                        }
                                                        else
                                                        {
                                                            <td style="color:#766b6b;font-weight:500;">No</td>
                                                        }
                                                        @if (item.MeetingStatusStatusDesc == "Status Pending")
                                                        {
                                                            <td>
                                                                <span class="status mpending">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Completed")
                                                        {
                                                            <td>
                                                                <span class="status mcomplete">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Scheduled")
                                                        {
                                                            <td>
                                                                <span class="status mscheduled">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Dropped")
                                                        {
                                                            <td>
                                                                <span class="status mdropped">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "No Show(Candidate)")
                                                        {
                                                            <td>
                                                                <span class="status mnoshow">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "No Show(Interviewer)")
                                                        {
                                                            <td>
                                                                <span class="status mnoshow-int">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.MeetingStatusStatusDesc == "Dropped (Rejected)")
                                                        {
                                                            <td>
                                                                <span class="status mdropped" style="width:115px;">@item.MeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td> <span class="status">@item.MeetingStatusStatusDesc</span></td>
                                                        }
                                                        @if (item.TotalCount >= 2 && item.IsMeetingNotificationSent == 1 && item.Joinedon != null && item.PerformedOn != null && item.IsRescheduleNotificationSent == 0)
                                                        {
                                                            if (item.EIAssigned)
                                                            {
                                                                <td><span style="color:forestgreen; background: #d0edd0;padding: 0px 5px 2px 5px;font-size:13px;">Resolved</span> <span style="color:#e4983c;font-weight:500;">(Emergency Interview)</span></td>
                                                            }
                                                            else if (item.Joinedon > item.PerformedOn)
                                                            {
                                                                <td><span style="color:forestgreen; background: #d0edd0;padding: 0px 5px 2px 5px;font-size:13px;">Resolved</span> <span style="color:#b550a3;font-weight:500;"> (Interviewer Late Join)</span></td>
                                                            }
                                                            else if (item.Joinedon < item.PerformedOn)
                                                            {
                                                                <td><span style="color:forestgreen; background: #d0edd0;padding: 0px 5px 2px 5px;font-size:13px;">Resolved</span> <span style="color:#d64a2f;font-weight:500;"> (Candidate Late Join)</span></td>
                                                            }
                                                            else
                                                            {
                                                                <td style="color:forestgreen; background: #d0edd0;padding: 0px 5px 2px 5px;font-size:13px;">Resolved</td>
                                                            }
                                                        }
                                                        else if ((item.TotalCount == 1 && item.IsMeetingNotificationSent == 1) || (item.TotalCount >= 2 && item.IsMeetingNotificationSent == 1 && item.IsRescheduleNotificationSent == 1) || (item.IsMeetingNotificationSent == 1 && (item.Joinedon == null || item.PerformedOn == null)))
                                                        {
                                                            if (item.Joinedon != null && item.PerformedOn == null)
                                                            {
                                                                <td><span style="color: #fff;background: #e57373cc;padding: 0px 5px 2px 5px;font-size:12px;">Not Resolved</span> <span style="font-weight:500;color: #68221dc7;">(Candidate No Show)</span></td>
                                                            }
                                                            else if (item.Joinedon == null && item.PerformedOn != null)
                                                            {
                                                                <td><span style="color: #fff;background:#e57373cc;padding: 0px 5px 2px 5px;font-size:12px;">Not Resolved</span> <span style="color: #56798b;font-weight:500">(Interviewer No Show)</span></td>
                                                            }
                                                            else
                                                            {
                                                                <td><span style="color: #fff;background:#e57373cc;padding: 0px 5px 2px 5px;font-size:12px;">Not Resolved</span></td>
                                                            }
                                                        }
                                                        else if (item.PerformedOn != null && item.IsRescheduleNotificationSent == 1)
                                                        {
                                                            <td>Not Resolved</td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        <td>@item.ChannelOwner</td>
                                                        <td>@item.LastInterviewDate</td>
                                                        @if (item.LastMeetingStatusStatusDesc == "Status Pending")
                                                        {
                                                            <td>
                                                                <span class="status mpending">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.LastMeetingStatusStatusDesc == "Completed")
                                                        {
                                                            <td>
                                                                <span class="status mcomplete">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.LastMeetingStatusStatusDesc == "Scheduled")
                                                        {
                                                            <td>
                                                                <span class="status mscheduled">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.LastMeetingStatusStatusDesc == "Dropped")
                                                        {
                                                            <td>
                                                                <span class="status mdropped">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.LastMeetingStatusStatusDesc == "No Show(Candidate)")
                                                        {
                                                            <td>
                                                                <span class="status mnoshow">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.LastMeetingStatusStatusDesc == "No Show(Interviewer)")
                                                        {
                                                            <td>
                                                                <span class="status mnoshow-int">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else if (item.LastMeetingStatusStatusDesc == "Dropped (Rejected)")
                                                        {
                                                            <td>
                                                                <span class="status mdropped" style="width:115px;">@item.LastMeetingStatusStatusDesc</span>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td> <span class="status">@item.LastMeetingStatusStatusDesc</span></td>
                                                        }
                                                        <td>
                                                            <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.id, irfId=item.irfIntId})">
                                                                <div class="btn btn-primary shadow btn-xs sharp me-1" aria-label="Client Interview Report" style="width:25px!important;height:25px!important;">
                                                                    <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg style="position:relative;top:-6px;margin: 10px 0px;" xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                </div>
                                                            </a>
                                                            <a class="icon-link" href="#!_@item.id" title="Emails Sent/Delivered" style="cursor:pointer" data-toggle="ajax-modal-CommunicationDetails" data-bs-target="#modalCommunicationDetails" data-url="@Url.Action("GetCommunicationDetails", "Candidate", new { interviewId = item.id, communicationMedium = (int)CommunicationMedium.Email })">
                                                                <div class="btn btn-primary shadow btn-xs sharp me-1" aria-label="Client Interview Report" style="width:25px!important;height:25px!important; border: 1px #ffeb3bc2 solid!important; background: #fcee698c!important;">
                                                                    <span title="Email"> <i class="fa fa-envelope" style="color: #F9A825;font-size:15px;position:relative;top:1px;padding: 0px;left:-1px;"></i></span>
                                                                </div>
                                                            </a>
                                                            <a target="_blank" class="btn shadow btn-schedule btn-xs sharp me-1 item4" href="@Url.Action("CandidateScheduleEvent", "InterviewScheduler", new { id = item.SchedulerUniqueid, CandidateEmail = item.candidateEmail })" title="Schedule Meeting" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background: #1d919f96;">
                                                                <span title="Schedule Meeting"><i class="fa fa-calendar" style="left:2px; top:-1px;font-size:12px; position: relative;"></i></span>
                                                            </a>
                                                            <a class="btn shadow btn-schedule btn-xs sharp me-1 item4" href="#" onclick="javascript:FetchHistory('@item.ZoomMeetingId');" title="Meeting Details" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#23b77696; border:1px #23b77696 solid;">
                                                                <span>
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                                                                        <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1 .025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z" />
                                                                        <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0v1z" />
                                                                        <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5z" />
                                                                    </svg>
                                                                </span>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="ZoomMeetingHistory" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="filheader">
                <div class="filavatar">
                    <svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M9 1C4.58 1 1 4.58 1 9s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm0 2.75c1.24 0 2.25 1.01 2.25 2.25S10.24 8.25 9 8.25 6.75 7.24 6.75 6 7.76 3.75 9 3.75zM9 14.5c-1.86 0-3.49-.92-4.49-2.33C4.62 10.72 7.53 10 9 10c1.47 0 4.38.72 4.49 2.17-1 1.41-2.63 2.33-4.49 2.33z" /></svg>
                </div>
                <h5 class="modal-title pull-left">Share/View Details</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeZoomMeetingHistory()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12 ">
                    <div class="zoomMeeting_scroll">
                        <div id="divZoomMeetingHistory" class="pdr-20">
                        </div>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color:#fff;line-height: 13px;" type="button" onclick="closeZoomMeetingHistory()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/common.js"></script>
<div id="modal_recipientActivity_placeholder"></div>

<div id="modal_candidateCommunicationDetails_placeholder"></div>

<script src="~/js/ModalFormServerValidation.js"></script>
<script src="~/js/TwilioCallMaker.js"></script>

<script>
    function searchResult() {
        $('#meeting').DataTable();
    }
    function RefreshSearch() {
        $('#meeting').DataTable().destroy();
        setTimeout(function () {
            applyDataTable();
        }, 2000);
    }

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#meeting').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'><svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 18 18'><path fill='#6f6f6f' d='M9 13.5c-2.49 0-4.5-2.01-4.5-4.5S6.51 4.5 9 4.5c1.24 0 2.36.52 3.17 1.33L10 8h5V3l-1.76 1.76C12.15 3.68 10.66 3 9 3 5.69 3 3.01 5.69 3.01 9S5.69 15 9 15c2.97 0 5.43-2.16 5.9-5h-1.52c-.46 2-2.24 3.5-4.38 3.5z' /></svg></span>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").show();

                    }
                    else { $("#x").show(); }
                });
            }
        });
    }

    $(document).ready(function () {
        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });
    });
</script>
<script type="text/javascript">
    $(".dataloading").hide();
    $("#meeting").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meeting").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meeting").show();
        }, 2000);
    };
</script>
<script>
    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }
    });
    function ResetFilter() {
        window.location.href = "/DashBoard/ResetInterviewManagementDetailsfilters;
    }
    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        var form = $("#form").serialize();
    }
</script>
<script>
    function FetchHistory(meetingid) {
        $.ajax({
            type: "POST",
            url: "/DashBoard/FetchZoomMeetingHistory",
            data: { 'meetingid': meetingid },
            success: function (data) {
                var modal = document.getElementById("ZoomMeetingHistory");
                modal.style.display = "block";
                bindZoomMeetingHistoryData(data);
            }
        });
    }
    function bindZoomMeetingHistoryData(data) {
        var html = '';
        html += '';
        html += '<table class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">';
        html += '<thead>';
        html += '<tr>';
        html += '   <th>Event</th>';
        html += '   <th>Name</th>';
        html += '   <th>Date</th>';
        html += '</tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            html += '<tr>';
            html += '<td>' + data[i].event + '</td>';
            html += '<td>' + data[i].participantName + '</td>';
            html += '<td>' + data[i].actionDate + '</td>';
            html += '</tr>';
        }
        if (data.length == 0) {
            html += '<tr><td colspan ="3">No record found</td></tr>';
        }
        html += '    </tbody> ';
        html += '</table> ';
        $("#divZoomMeetingHistory").empty().html(html);
    }
    function closeZoomMeetingHistory() {
        var modal = document.getElementById("ZoomMeetingHistory");
        modal.style.display = "none";
    }
</script>