@model Risebird.Entities.ViewModel.PublicChannelVM
@{
    ViewData["Title"] = "Thank you";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<style>
    .paq-wrap { max-width: 560px; margin: 48px auto; padding: 0 16px; font-family: Roboto, Arial, Helvetica, sans-serif; text-align: center; }
    .paq-card { background: #fff; border: 1px solid #e8edf2; border-radius: 12px; padding: 36px 28px; box-shadow: 0 2px 8px rgba(15,23,42,.05); }
    .paq-icon { width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 50%; background: #e7f8ee; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 24px; }
    .paq-card h1 { font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 8px; }
    .paq-card p { font-size: 14px; color: #64748b; margin: 0 0 18px; line-height: 1.5; }
    .paq-meta { font-size: 13px; color: #475569; background: #f8fafc; border-radius: 8px; padding: 10px 12px; margin-bottom: 18px; text-align: left; }
    .paq-meta strong { color: #0f172a; }
    .paq-btn { display: inline-block; height: 38px; line-height: 38px; padding: 0 20px; border-radius: 8px; font-size: 13px; font-weight: 600; background: #42a5f5; color: #fff !important; text-decoration: none; }
</style>

<div class="paq-wrap">
    <div class="paq-card">
        <div class="paq-icon"><i class="fa fa-check"></i></div>
        <h1>Requirement received</h1>
        <p>Thanks — your request is with our team as <strong>Pending</strong>. We’ll complete the mapping and follow up on the email you shared.</p>
        <div class="paq-meta">
            <div><strong>Title:</strong> @(Model?.Title ?? "—")</div>
            <div><strong>Email:</strong> @(Model?.RequesterEmailid ?? "—")</div>
        </div>
        <a class="paq-btn" href="@Url.Action("PublicAddRequirement", "DashBoard")">Submit another</a>
    </div>
</div>
