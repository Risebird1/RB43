@model Risebird.Entities.ViewModel.PublicChannelVM
@{
    ViewData["Title"] = "Requirement received";
    ViewBag.PageHeader = "";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    var title = Model?.Title;
}
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<style>
    .paq-thanks { max-width: 560px; margin: 48px auto; padding: 0 16px; text-align: center; font-family: Roboto, Arial, Helvetica, sans-serif; }
    .paq-thanks-card { background: #fff; border: 1px solid #e8edf2; border-radius: 12px; padding: 36px 28px; box-shadow: 0 2px 8px rgba(15,23,42,.05); }
    .paq-thanks-card .icon { width: 56px; height: 56px; border-radius: 50%; background: #e7f8ee; color: #15803d; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 14px; }
    .paq-thanks-card h1 { font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 8px; }
    .paq-thanks-card p { font-size: 14px; color: #64748b; margin: 0 0 20px; line-height: 1.5; }
    .paq-thanks-card a { display: inline-block; height: 38px; line-height: 38px; padding: 0 20px; border-radius: 8px; background: #42a5f5; color: #fff; font-size: 13px; font-weight: 600; text-decoration: none; }
    .paq-thanks-card a:hover { background: #2f8fe0; color: #fff; }
</style>
<div class="paq-thanks">
    <div class="paq-thanks-card">
        <div class="icon"><i class="fa fa-check"></i></div>
        <h1>Thanks — we received your requirement</h1>
        <p>
            @if (!string.IsNullOrWhiteSpace(title))
            {
                <text>Your request for <strong>@title</strong> is with our team. We’ll map it and follow up by email.</text>
            }
            else
            {
                <text>Your request is with our team. We’ll map it and follow up by email.</text>
            }
        </p>
        <a href="/Requirement/Externaluser">Submit another</a>
    </div>
</div>
