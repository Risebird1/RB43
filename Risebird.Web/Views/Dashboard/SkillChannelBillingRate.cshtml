@model IEnumerable<Risebird.Entities.Data.SkillChannelBillingRateVM>

@{
    ViewData["Title"] = "Skill Channel Billing Rate";
    ViewBag.PageHeader = "Skill Channel Billing Rate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <div class="mobile-view"><h4 class="card-title">Skill Channel Billing Rate</h4></div>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">

                @if (Model != null && Model.Any())
                {
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div class="dataloading">
                                <div class="toolbar">
                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="skillChannelBillingTable"
                                               class="table table-striped table-bordered dt-responsive journey"
                                               cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel ID</th>
                                                    <th>Client</th>
                                                    <th>JD Title</th>
                                                    <th>Job Country</th>
                                                    <th>Company Type</th>
                                                    <th>Plan Type</th>
                                                    <th>Currency</th>
                                                    <th>Default Rate</th>
                                                    @if (ViewBag.Profile == "Finance" || ViewBag.Profile == "Finance Support" || ViewBag.Profile == "Admin")
                                                    {
                                                        <th>Billing Rate</th>
                                                        <th>Rate Set?</th>
                                                    }
                                                    <th>Total Interviewers</th>
                                                    <th>Active Interviewers</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel ID</th>
                                                    <th>Client</th>
                                                    <th>JD Title</th>
                                                    <th>Job Country</th>
                                                    <th>Company Type</th>
                                                    <th>Plan Type</th>
                                                    <th>Currency</th>
                                                    <th>Default Rate</th>
                                                    @if (ViewBag.Profile == "Finance" || ViewBag.Profile == "Finance Support" || ViewBag.Profile == "Admin")
                                                    {
                                                        <th>Billing Rate</th>
                                                        <th>Rate Set?</th>
                                                    }
                                                    <th>Total Interviewers</th>
                                                    <th>Active Interviewers</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFBusinessKey</td>
                                                        <td>@item.ClientName</td>
                                                        <td>@item.JDTitle</td>
                                                        <td>@item.JobCountry</td>
                                                        <td>@item.CompanyType</td>
                                                        <td>@item.Heuristicsscore</td>
                                                        <td>@item.BillingCurrency</td>
                                                        <td class="text-right">@item.DefaultRate</td>
                                                        @if (ViewBag.Profile == "Finance" || ViewBag.Profile == "Finance Support" || ViewBag.Profile == "Admin")
                                                        {
                                                            <td>
                                                                <input type="number" min="0"
                                                                       class="form-control billing-rate-input"
                                                                       style="width:110px;"
                                                                       value="@item.BillingRate"
                                                                       data-irf-id="@item.IRFAutoId"
                                                                       data-default="@item.DefaultRate"
                                                                       onchange="saveSkillChannelRate(this)" />
                                                            </td>
                                                            <td class="text-center rate-status-cell-@item.IRFAutoId">
                                                                @if (item.IsRateSet)
                                                                {
                                                                    <span class="badge badge-success">Custom</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge badge-secondary">Default</span>
                                                                }
                                                            </td>
                                                        }
                                                        <td class="text-center">@item.TotalInterviewers</td>
                                                        <td class="text-center">@item.ActiveInterviewers</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<div id="saveToast" style="display:none; position:fixed; bottom:24px; right:24px; z-index:9999;"
     class="alert alert-success">Rate saved successfully.</div>

<script src="~/Newassets/js/jquery.dataTables.min.js"></script>
<script src="~/Newassets/js/dataTables.responsive.min.js"></script>

<script>
    $(document).ready(function () {
        $('#skillChannelBillingTable').DataTable({
            responsive: true,
            pageLength: 25,
            order: [[1, 'asc'], [2, 'asc']]
        });

        $('.loader').hide();
        $('.dataloading').show();
    });

    function saveSkillChannelRate(input) {
        var irfId      = $(input).data('irf-id');
        var billingRate = parseInt($(input).val(), 10);

        if (isNaN(billingRate) || billingRate < 0) {
            alert('Please enter a valid non-negative rate.');
            $(input).val($(input).data('default'));
            return;
        }

        $.ajax({
            type: 'POST',
            url: '/Dashboard/SaveSkillChannelBillingRate',
            data: { irfId: irfId, billingRate: billingRate },
            success: function (data) {
                if (data === 'Success') {
                    // update the badge in the same row
                    var cell = $('.rate-status-cell-' + irfId);
                    cell.html('<span class="badge badge-success">Custom</span>');
                    showToast();
                } else {
                    alert('Failed to save rate. Please try again.');
                }
            },
            error: function () {
                alert('An error occurred while saving. Please try again.');
            }
        });
    }

    function showToast() {
        $('#saveToast').fadeIn(300).delay(2500).fadeOut(500);
    }
</script>
