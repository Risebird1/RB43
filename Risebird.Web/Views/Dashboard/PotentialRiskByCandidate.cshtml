@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities.ViewModel
@{
    ViewData["Title"] = "PotentialRiskByCandidate";
    // Status tabs (QC Tracking Delta 3): counts are distinct interviewers, the tooltip shows report rows.
    var prTab = (ViewBag.PrTab as string) ?? PotentialRiskTabs.All;
    var prCounts = (ViewBag.PrTabCounts as IReadOnlyList<PotentialRiskTabCountVM>) ?? new List<PotentialRiskTabCountVM>();
}
<script>
    var Header = "<div>Potential Risk By Candidate</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
    /* QC status on each row (badge + next moves) */
    .pr-tabs { margin-left: 12px; }
    .pr-tabs .feedback-tab, .pr-tabs .feedback-tab-ac { cursor: pointer; }
    .pr-qc { margin-top: 6px; white-space: normal; }
    .pr-badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; line-height: 18px; }
    .pr-badge--pending { background: #eef2f7; color: #4a5568; }
    .pr-badge--underreview { background: #fff4e0; color: #9a5b00; }
    .pr-badge--reviewed { background: #e6f6ec; color: #1e7b45; }
    .pr-badge--removed { background: #fdecec; color: #b42318; }
    .pr-badge-meta { display: block; font-size: 11px; color: #6b7280; margin-top: 2px; }
    .pr-qc-btn { font-size: 11px; padding: 1px 7px; margin: 3px 3px 0 0; border-radius: 4px; border: 1px solid #54a5f6; background: #fff; color: #1f6fc5; cursor: pointer; }
    .pr-qc-btn:hover { background: #eaf3fe; }
    .pr-qc-btn--remove { border-color: #e5484d; color: #b42318; }
    .pr-qc-btn--remove:hover { background: #fdecec; }
</style>
<input type="hidden" id="txtrate" value="@Model.Count()" />
<div class="main-panel" id="main-panel">
    <div>
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">BlackList Company</h4></div>
                    </div>
                    <div class="pull-left pr-tabs" id="prTabs">
                        @foreach (var c in prCounts)
                        {
                            <div class="@(c.Tab == prTab ? "feedback-tab-ac" : "feedback-tab")" title="@c.Interviewers interviewer(s) · @c.Rows report row(s)" onclick="PrChangeTab('@c.Tab')"><strong>@c.Label · @c.Interviewers</strong></div>
                        }
                    </div>
                    <div class="pull-right client-ms">
                        @if (ViewBag.ReturnBack==1)
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                    </div>
                    <span class="interview_2"> <i type="submit" class="far fa-file-excel excel-file card-title-space " data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("ExportPotentialRiskByCandidate", "Dashboard", new { tab = prTab })'"></i></span>
                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                @* <img src="~/Newassets/img/lazyload.gif" /> *@
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th style="width:200px;">Action</th>
                                                <th>Skill Channel ID</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Candidate Contact</th>
                                                <th>Payment SLA Status</th>
                                                <th>Interview Status</th>
                                                <th>Client Name</th>
                                                <th>Channel Owner</th>
                                                <th>Red Marker</th>
                                                <th>Rating</th>
                                                <th>Rated On</th>
                                                
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th style="width:200px;">Action</th>
                                                <th>Skill Channel ID</th>
                                                <th>Interview Date</th>
                                                <th>Interviewer</th>
                                                <th>Candidate Name</th>
                                                <th>Candidate Email</th>
                                                <th>Candidate Contact</th>
                                                <th>Payment SLA Status</th>
                                                <th>Interview Status</th>
                                                <th>Client Name</th>
                                                <th>Channel Owner</th>
                                                <th>Red Marker</th>
                                                <th>Rating</th>
                                                <th>Rated On</th>
                                               
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @if (Model != null && Model.Count() > 0)
                                            {


                                                foreach (var item in Model)
                                                {

                                                    <tr>
                                                        <td style="width:200px;">
                                                            @if (!string.IsNullOrWhiteSpace(item.interviewer))
                                                            {
                                                                <span>
                                                                    <button class="btn shadow btn-xs sharp me-1" aria-label="Suspicious Interviwer" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                                        <span onclick="javascript:SuspiciousTypeDetails('@item.interviewer');" title="Suspicious Interviwer" class="mdc-fab__icon touch"><img width="17" src="/img/suspicious.png" /></span>
                                                                    </button>
                                                                </span>

                                                            }

                                                            @if (item.IsAIInterview)
                                                            {
                                                                <span class="interview_9">
                                                                    <a style="text-decoration:none" target="_blank" href='@Url.Action("Report", "AIInterview" , new { seId = item.SessionId})'>
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Report" style="position:relative;top:-3px;">
                                                                            <span>
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                                                                    <!-- Report/document shape -->
                                                                                    <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
                                                                                    <path d="M15 2v5h5"></path>

                                                                                    <!-- Brain-like AI/circuit element -->
                                                                                    <path d="M10 12c0-1 .5-2 2-2s2 1 2 2-.5 2-2 2-2-1-2-2z"></path>
                                                                                    <line x1="12" y1="10" x2="12" y2="8"></line>
                                                                                    <line x1="12" y1="14" x2="12" y2="16"></line>
                                                                                    <line x1="10" y1="12" x2="8" y2="12"></line>
                                                                                    <line x1="14" y1="12" x2="16" y2="12"></line>

                                                                                    <!-- Text lines on report -->
                                                                                    <line x1="7" y1="18" x2="17" y2="18"></line>
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    </a>
                                                                </span>
                                                                //Remember : Change the report icon for an ai interview report. A normal report and an AI report should be identifiable by their distinct icons.
                                                            }
                                                            else
                                                            {
                                                                <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.InterviewId, irfId=item.irfIntId})">
                                                                    <button class="btn shadow btn-xs sharp me-1" aria-label="Client Interview Report" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                                        <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg style="position:relative;top:-1px" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                                                                    </button>
                                                                </a>
                                                            }
                                                            <button class="btn shadow btn-xs sharp me-1 feedbackreportbtn" aria-label="Payment SLA" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                                <div onclick="PaymentSLADetails('@item.InterviewId','@item.candidateEmail','@item.interviewer',false,'PotentailRiskCandidate',false)" title="Palyment SLA" class="mdc-fab__icon material-icons">
                                                                    <svg style="color: white;position:relative;left:-1px;top:-2px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg>
                                                                </div>
                                                            </button>



                                                            <button class="btn shadow btn-xs sharp me-1 feedbackreportbtn" aria-label="Payment SLA" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">

                                                                <div style="width: 30px;height: 30px;cursor:pointer; display: inline-block;border-radius: 100%;line-height: 32px;" onClick="PaymentComplianceDetails('@item.InterviewId','Candidate')"><svg style="color: white;position:relative;top: -8px;left: -3px;" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg><svg style="color: white;position:relative;top: 0px;left: -10px;" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M2 8C2 7.44772 2.44772 7 3 7H21C21.5523 7 22 7.44772 22 8C22 8.55228 21.5523 9 21 9H3C2.44772 9 2 8.55228 2 8Z" fill="white"></path> <path d="M2 12C2 11.4477 2.44772 11 3 11H21C21.5523 11 22 11.4477 22 12C22 12.5523 21.5523 13 21 13H3C2.44772 13 2 12.5523 2 12Z" fill="white"></path> <path d="M3 15C2.44772 15 2 15.4477 2 16C2 16.5523 2.44772 17 3 17H15C15.5523 17 16 16.5523 16 16C16 15.4477 15.5523 15 15 15H3Z" fill="white"></path> </svg></div>

                                                            </button>

                                                            @* Redo (enabled in QC Tracking Delta 1): saved with the Potential Risk page, returns to this tab. *@
                                                            <button class="btn shadow btn-xs sharp me-1 feedbackreportbtn" aria-label="ReDo Interview" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                                <span onclick="OpenRedoFormModel('@(item.InterviewId > 0 ? item.InterviewId : item.id)','@item.intervieweStatusStatDesc','PotentialRiskRCandidate')" title="ReDo Interview" class="mdc-fab__icon material-icons">
                                                                    <svg style="position:relative;top:-1px" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                                                                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                                                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                                                    </svg>
                                                                </span>
                                                            </button>
                                                            <button  class="btn shadow btn-xs sharp me-1 itemques mb-40" aria-label="Add Candidate Status" style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6">
                                                                <span onclick="OpenStatusModal('@item.irfIntId','@item.CandidateMasterId', '@item.IRFId', '@item.candidateName')" title="Add Candidate Status" class="mdc-fab__icon material-icons">
                                                                    <img style="height:16px!important;max-height:16px!important;" src="~/Newassets/img/addlist.png" />
                                                                </span>
                                                            </button>

                                                            <button style="top: 0px;position: relative;cursor: pointer; width:25px!important;height:25px!important;background:#54a5f6;color:#fff;border-color:#54a5f6" class="btn shadow btn-xs sharp me-1 itemques mb-40" aria-label="Candidate Status List">
                                                                <span onclick="GetCandidateStatusList('@item.irfIntId','@item.CandidateMasterId', '@item.IRFId', '@item.candidateName')" title="Candidate Status List" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-list-check" viewBox="0 0 16 16" id="IconChangeColor"> <path fill-rule="evenodd" d="M5 11.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5zM3.854 2.146a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 3.293l1.146-1.147a.5.5 0 0 1 .708 0zm0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708L2 7.293l1.146-1.147a.5.5 0 0 1 .708 0zm0 4a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0z" id="mainIconPathAttribute" fill="#ffffff"></path> </svg></span>
                                                            </button>

                                                            @* QC status of the interviewer (follows the interviewer, not the report) and the next moves. *@
                                                            @{
                                                                var prRowTab = PotentialRiskTabs.TabOf(item);
                                                            }
                                                            <div class="pr-qc">
                                                                <span class="pr-badge pr-badge--@prRowTab.ToLowerInvariant()" title="@item.PotentialRiskStatusComment">@PotentialRiskTabs.StatusText(item)</span>
                                                                @if (item.PotentialRiskStatus.HasValue && !string.IsNullOrWhiteSpace(item.PotentialRiskStatusBy))
                                                                {
                                                                    <span class="pr-badge-meta">@(item.PotentialRiskStatusBy + (item.PotentialRiskStatusOn.HasValue ? " · " + item.PotentialRiskStatusOn.Value.ToString("dd MMM yyyy HH:mm") : ""))</span>
                                                                }
                                                                else if (prRowTab == PotentialRiskTabs.Removed)
                                                                {
                                                                    <span class="pr-badge-meta">Inactive (reactivate from the interviewer profile)</span>
                                                                }
                                                                @if (item.InterviewerUserId > 0 && prRowTab != PotentialRiskTabs.Removed)
                                                                {
                                                                    <div>
                                                                        @if (prRowTab != PotentialRiskTabs.UnderReview)
                                                                        {
                                                                            <button type="button" class="pr-qc-btn" data-user-id="@item.InterviewerUserId" data-irf-id="@item.irfIntId" data-status="1" data-name="@item.interviewer">@(prRowTab == PotentialRiskTabs.Reviewed ? "Under review again" : "Under review")</button>
                                                                        }
                                                                        @if (prRowTab != PotentialRiskTabs.Reviewed)
                                                                        {
                                                                            <button type="button" class="pr-qc-btn" data-user-id="@item.InterviewerUserId" data-irf-id="@item.irfIntId" data-status="2" data-name="@item.interviewer">Reviewed</button>
                                                                        }
                                                                        <button type="button" class="pr-qc-btn pr-qc-btn--remove" data-user-id="@item.InterviewerUserId" data-remove="1" data-name="@item.interviewer">Remove</button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </td>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        @if (item.interviewer != null && item.interviewer != string.Empty)
                                                        {
                                                            <td>@item.interviewer</td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @*  @if (@item.interviewer != null || @item.interviewer != "")
                                                {
                                                <td style="color:red;text-align:center"><d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">@item.RedMarker</d></td>
                                                }
                                                else
                                                {
                                                <td style="color:red;text-align:center">@item.RedMarker</td>
                                                } *@

                                                        <td>@item.candidateName</td>
                                                        @if (item.candidateEmail != null && item.candidateEmail != string.Empty)
                                                        {
                                                            <td>@item.candidateEmail</td>
                                                        }
                                                       else{ 
                                                           <td></td>
                                                       }

                                                        @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                        {
                                                            <td>
                                                                <span aria-label="Click here to call the candidate">
                                                                    <span onclick="CommonCallButtonClick('@item.candidateName','@item.MobileNumber', '@item.candidateEmail','@item.imid', null, 'Candidate')" data-original-title="Tooltip on top" title="Click here to call the candidate."><img src="/img/calling.png" width="20"></span>
                                                                </span>@item.MobileNumber
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (item.IsApproved == 1)
                                                        {
                                                        <td>Approved</td>
                                                        }
                                                        else if (item.IsApproved == 2)
                                                        {
                                                        <td>Not Approved</td>
                                                        }
                                                        else
                                                        {
                                                        <td></td>
                                                        }
                                                        @if (item.InterviewStatus == 2)
                                                        {
                                                            <td class="text-center">
                                                                <a style="color:green;font-weight: bold"> @item.intervieweStatusStatDesc</a>
                                                            </td>
                                                        }
                                                        else if (item.InterviewStatus == 3)
                                                        {
                                                            <td class="text-center">
                                                                <a style="color:red;font-weight: bold"> @item.intervieweStatusStatDesc</a>
                                                            </td>
                                                        }
                                                        else if (item.InterviewStatus == 4)
                                                        {
                                                            <td class="text-center">
                                                                <a style="color:darkorange; font-weight: bold"> @item.intervieweStatusStatDesc</a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-center">@item.intervieweStatusStatDesc</td>
                                                        }
                                                        @if (item.Name != null || item.Name != "")
                                                        {
                                                            <td> @item.Name </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        <td>@item.ChannelOwner</td>
                                                        @if (item.interviewer != null || item.interviewer != "")
                                                        {
                                                            <td style="color:red;text-align:center"><d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">@item.RedMarker</d></td>
                                                        }
                                                        else
                                                        {
                                                            <td style="color:red;text-align:center">@item.RedMarker</td>
                                                        }

                                                        <td class="interviewer">

                                                            <input type="hidden" id="Rating_@i" value="@item.Rating" />
                                                            <div class="star-rating" style="pointer-events:none;">
                                                                <input type="radio" id="Rating_5_@i" name="rating1_@i" readonly value="5" />
                                                                <label for="Rating_5_@i" class="star">&#9733;</label>
                                                                <input type="radio" id="Rating_4_@i" name="rating1_@i" readonly value="4" />
                                                                <label for="Rating_4_@i" class="star">&#9733;</label>
                                                                <input type="radio" id="Rating_3_@i" name="rating1_@i" readonly value="3" />
                                                                <label for="Rating_3_@i" class="star">&#9733;</label>
                                                                <input type="radio" id="Rating_2_@i" name="rating1_@i" readonly value="2" />
                                                                <label for="Rating_2_@i" class="star">&#9733;</label>
                                                                <input type="radio" id="Rating_1_@i" name="rating1_@i" readonly value="1" />
                                                                <label for="Rating_1_@i" class="star">&#9733;</label>
                                                            </div>

                                                        </td>
                                                        <td>@item.RatingAddedOn</td>

                                                        

                                                    </tr>
                                                    i++;
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->

        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>

<div id="RedoInterviewModel" class="modal modal-bg" style="z-index:5">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
