<div id="RedoInterviewModel" class="modal modal-bg" style="z-index:5">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="filheader">
                <div class="filavatar">
                    <span><svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24"><path fill="rgb(255, 255, 255)" d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z" /></svg></span>
                </div>
                <h5 class="modal-title pull-left">Redo Interview</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span onclick="closeRedoInterviewModel()" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body" id="divredoInterview">
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Interviewer/_SuspiciousInterviewer.cshtml")
@await Html.PartialAsync("~/Views/Common/_InterviewerInsights.cshtml")
@await Html.PartialAsync("~/Views/Common/_PaymentSLA.cshtml")
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
@await Html.PartialAsync("~/Views/Common/_PaymentCompliance.cshtml")
@await Html.PartialAsync("~/Views/Candidate/AddCandidateStatusPartial.cshtml")

<script src="~/js/TwilioCallMaker.js"></script>

<script>
    $(document).ready(function () {
        SetRating();
        applyDataTable();
    });

    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'></span>");

    }
</script>

<script>
    function SetRating() {
        var indexCount = $('#txtrate').val();
        for (var i = 0; i < indexCount; i++) {
            var Rating_Value = document.getElementById("Rating_" + i).value;
            if (Rating_Value != null && Rating_Value != "" && parseInt(Rating_Value) > 0) {
                $('#Rating_' + Rating_Value + '_' + i).attr('checked', 'checked');
            }
        }
    }
    function OpenRedoFormModel(interviewid, interviewstatus, type) {
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { 'interviewid': interviewid, 'interviewstatus': interviewstatus, 'type': type },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }
    function openRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "none";
    }
</script>