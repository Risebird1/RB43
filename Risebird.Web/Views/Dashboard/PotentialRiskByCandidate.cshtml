<script>
    $(document).ready(function () {
        SetRating();
        applyDataTable();
    });

    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
        $(".dataTables_filter input:eq(0)").after("<button onclick='searchResult()' type='button' id='search'>&nbsp</button><span id='trigger-update' class='ref-btn' onclick='RefreshSearch()'></span>");

    }
</script>

<script>
    function SetRating() {
        var indexCount = $('#txtrate').val();
        for (var i = 0; i < indexCount; i++) {
            var Rating_Value = document.getElementById("Rating_" + i).value;
            if (Rating_Value != null && Rating_Value != "" && parseInt(Rating_Value) > 0) {
                $('#Rating_' + Rating_Value + '_' + i).attr('checked', 'checked');
            }
        }
    }
    // ---- QC Tracking: status tabs and Under review / Reviewed / Remove (source = PotentialRisk) ----
    var prActiveTab = '@prTab';
    var prReturnBack = '@(ViewBag.ReturnBack ?? 0)';
    window.rbReturnTab = prActiveTab;   // Payment SLA saves come back to this tab
    function PrChangeTab(tab) {
        window.location.href = '/Dashboard/PotentialRiskByCandidate?returnBack=' + encodeURIComponent(prReturnBack) + '&tab=' + encodeURIComponent(tab);
    }
    function PrReload() { PrChangeTab(prActiveTab); }

    $(document).on('click', '.pr-qc-btn', function (e) {
        e.preventDefault();
        var $b = $(this);
        var userId = parseInt($b.data('user-id'), 10);
        var name = ($b.data('name') || '').toString();
        if (!userId) return;
        if ($b.data('remove')) PrRemove(userId, name);
        else PrSetStatus(userId, parseInt($b.data('irf-id'), 10) || 0, parseInt($b.data('status'), 10), name);
    });

    function PrCommentHtml(label) {
        return '<div class="form-group" style="text-align:left">' +
            '<label for="pr-comment" class="d-block mb-2">' + label + '</label>' +
            '<textarea id="pr-comment" class="form-control" rows="3" maxlength="300" style="margin-top:10px;"></textarea></div>';
    }
    function PrReadComment() {
        var c = (document.getElementById('pr-comment').value || '').trim();
        if (!c) { Swal.showValidationMessage('Please enter a comment'); return false; }
        return c;
    }

    function PrSetStatus(userId, irfId, status, name) {
        var title = status === 1 ? 'Move to Under Review' : 'Mark as Reviewed';
        Swal.fire({
            title: title,
            html: '<div style="margin-bottom:6px">' + $('<div>').text(name || '').html() + '</div>' +
                  PrCommentHtml('Comment (required). All of this interviewer\'s rows move together.'),
            showCancelButton: true,
            confirmButtonText: 'Save',
            cancelButtonText: 'Cancel',
            preConfirm: PrReadComment
        }).then(function (result) {
            if (!result || !result.value) return;
            $.ajax({
                url: '/Dashboard/UpdateQcInterviewerStatus',
                type: 'POST',
                data: { interviewerUserId: userId, irfId: irfId, status: status, comment: result.value, source: 'PotentialRisk' },
                success: function (res) {
                    if (res && res.success) {
                        Swal.fire('Saved', res.message, 'success').then(PrReload);
                    } else {
                        Swal.fire('Error', (res && res.message) || 'Could not save the status.', 'error');
                    }
                },
                error: function () { Swal.fire('Error', 'An error occurred while saving the status.', 'error'); }
            });
        });
    }

    function PrRemove(userId, name) {
        Swal.fire({
            title: 'Remove Interviewer',
            type: 'warning',
            html: '<div style="margin-bottom:6px">Remove ' + $('<div>').text(name || 'this interviewer').html() +
                  ' from the system? They are made inactive and their upcoming interviews are unassigned.</div>' +
                  PrCommentHtml('Please provide a reason for removal:'),
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Yes, remove',
            cancelButtonText: 'Cancel',
            preConfirm: PrReadComment
        }).then(function (result) {
            if (!result || !result.value) return;
            $.ajax({
                url: '/Dashboard/InactivateInterviewer',
                type: 'POST',
                data: { interviewerId: userId, comment: result.value, blockinterviewer: false, source: 'PotentialRisk' },
                success: function (res) {
                    if (res && res.success) {
                        Swal.fire('Removed!', res.message, 'success').then(PrReload);
                    } else {
                        Swal.fire('Error!', (res && res.message) || 'Failed to remove the interviewer.', 'error');
                    }
                },
                error: function () { Swal.fire('Error!', 'An error occurred while processing your request.', 'error'); }
            });
        });
    }

    function OpenRedoFormModel(interviewid, interviewstatus, type) {
        $.ajax({
            url: '/Interview/RedoInterviewDetails',
            data: { 'interviewid': interviewid, 'interviewstatus': interviewstatus, 'type': type, 'returnTab': prActiveTab },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }
    function openRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "none";
    }
</script>
