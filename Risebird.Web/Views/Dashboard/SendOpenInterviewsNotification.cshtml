    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                
                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="meetingsTable" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Channel Owner</th>
                                                    @*<th>Client Name</th>*@
                                                    <th>Candidate Response</th>
                                                    <th>JD Title</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Channel Owner</th>
                                                    @*<th>Client Name</th>*@
                                                    <th>Candidate Response</th>
                                                    <th>JD Title</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model.Select(x=>x.irfIntId).Distinct())
                                                    {
                                                        int rowSpan= Model.Where(x=>x.irfIntId == item).Count();
                                                        int maxCount = rowSpan - 1;
                                                        var subModel = Model.Where(x => x.irfIntId == item).ToList();
                                                        for (int i = 0; i <= maxCount; i++)
                                                        {
                                                            <tr>
                                                                <td title="@subModel[i].IRFId">@subModel[i].IRFId</td>
                                                                <td>@subModel[i].interviewDate</td>
                                                                <td title="@subModel[i].candidateName">@subModel[i].candidateName</td>
                                                                <td title="@subModel[i].candidateEmail">@subModel[i].candidateEmail</td>
                                                                <td title="@subModel[i].ChannelOwner">@subModel[i].ChannelOwner</td>
                                                                
                                                                
                                                                @if (subModel[i].IsCandidateResponsed)
                                                                {
                                                                    @if (subModel[i].CandidateResponse == 1)
                                                                    {
                                                                        <td>Responded (Yes)</td>
                                                                    }
                                                                    else if (subModel[i].CandidateResponse == 3)
                                                                    {
                                                                        <td title="Candidate Request to Reschedule">Responded (Reschedule)</td>
                                                                    }
                                                                    else if (subModel[i].CandidateResponse == 4)
                                                                    {
                                                                        <td>Responded (Need More Clarity)</td>
                                                                    }
                                                                    else
                                                                    {
                                                                        <td>Responded (No)</td>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <td>No Response</td>
                                                                }

                                                                <td>@subModel[i].JDTiltle</td>
                                                                
                                                                

                                                                @if(i == 0)
                                                                {
                                                                    <td rowspan="@rowSpan">

                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Share Email to check Interviewer availability" style="position:relative;top:3px">
                                                                                            <span onclick="javascript:CheckIntervieweravailbility('@item', '@subModel[i].IRFId', '@subModel[i].AssessmentGroupId');" title="Share Email to check Interviewer availability" class="mdc-fab__icon material-icons">
                                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-check-fill" viewBox="0 0 16 16">
                                                                                    <path fill-rule="evenodd" d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z" />
                                                                                    <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                                                                                </svg>
                                                                            </span>
                                                                        </button>
                                                                    
                                                                        <button class="mdc-fab app-fab--absolute" aria-label="Send email communication all open interviews that are available to be taken up." style="position:relative;top:3px;">
                                                                                <span onclick="javascript:SendOpenInterview('@item', '@subModel[i].IRFId');" title="Send email communication all open interviews that are available to be taken up." class="mdc-fab__icon material-icons">
                                                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16"> <g> <path fill="none" d="M0 0h24v24H0z"></path> <path d="M2 5.5V3.993A1 1 0 0 1 2.992 3h18.016c.548 0 .992.445.992.993v16.014a1 1 0 0 1-.992.993H2.992A.993.993 0 0 1 2 20.007V19h18V7.3l-8 7.2-10-9zM0 10h5v2H0v-2zm0 5h8v2H0v-2z"></path> </g> </svg>
                                                                                </span>
                                                                        </button>

                                                                    </td>
                                                                }
                                                            </tr>
                                                            
                                                        }

                                                    }
                                                }

                                            </tbody>

                                        </table>

                                    </div>
                                </div>

                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
