          { metric_name: "Recruiter Interaction Quality (Overall)", score_1_to_5: 2.8, verdict: "Marginal Misfit", observation: "Sample." }
        ],
        parameter_table_rows: [
          {
            score_area: "Role_Fitment_Score",
            parameter: "Finance Industry Experience Breadth and Depth",
            coverage_status: "Not Covered",
