  $("clearBtn").addEventListener("click", () => {
    $("jsonInput").value = "";
  });

  // Live re-render on search/toggles (if data loaded)
  ["roleSearch","motSearch","recruiterParamSearch","roleShowGuidance","motShowGuidance"].forEach(id => {
    $(id).addEventListener("input", () => {
      if (!currentData) return;
      // Re-render only affected panels (simple, safe)
      renderParamTable({
        wrapId: "roleTableWrap",
        section: currentData?.Role_Fitment_Score,
        searchId: "roleSearch",
        showGuidanceId: "roleShowGuidance",
        sectionKeyLabel: "Role_Fitment_Score"
      });
      renderParamTable({
        wrapId: "motTableWrap",
        section: currentData?.Motivation_to_join_fitment_Score,
        searchId: "motSearch",
        showGuidanceId: "motShowGuidance",
        sectionKeyLabel: "Motivation_to_join_fitment_Score"
      });
      renderRecruiter(currentData?.Recruiter_Interaction_Quality);
      // candidate tables do not depend on search in this template
    });
  });
    </script>
