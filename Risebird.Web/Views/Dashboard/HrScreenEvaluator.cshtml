            timestamps: ["Throughout"]
          }
        ]
      },
      Candidate_Interaction_Quality: {
        overall_score: 3.4,
        assistant_verdict: "Marginal Fit",
        overall_observation: "Sample candidate observation.",
        dimensions: [
          {
            dimension: "Candidate Engagement & Energy",
            score_1_to_5: 3,
            verdict: "Marginal Fit",
            notes: "Sample notes.",
            evidence_snippets: [],
            timestamps: []
          }
        ],
        behavior_flags: [
          { flag: "Low curiosity (few questions asked)", severity: "Medium", evidence_snippets: [], timestamps: ["Throughout"] }
