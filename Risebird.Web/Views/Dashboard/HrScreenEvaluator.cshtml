        section_flags: [],
        parameters: []
      },
      Overall_HR_Screen_Score: {
        overall_score_raw: 0,
        overall_score_normalized: 0,
        assistant_verdict: "Marginal Fit",
        overall_observation: "Sample overall observation.",
        overall_flags: ["Sample flag"],
        score_breakdown: { Role_Fitment_Score: 0, Motivation_to_join_fitment_Score: 0 }
      },
      Recruiter_Interaction_Quality: {
