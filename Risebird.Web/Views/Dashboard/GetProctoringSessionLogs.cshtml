@model IEnumerable<Risebird.Entities.ViewModel.ProctoringLogReportVM>
@if (Model != null && Model.Count() > 0)
{
    <div style="overflow-x:scroll" class="scrollbar">
        <table class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>Seq</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Level</th>
                    <th>Confidence</th>
                    <th>Opened At (UTC)</th>
                    <th>Resolved At (UTC)</th>
                    <th>Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Sequence</td>
                        <td>@item.Type</td>
                        <td>@item.Category</td>
                        <td>@item.Level</td>
                        <td>@item.Confidence</td>
                        <td>@item.OpenedAtUtc</td>
                        <td>@item.ResolvedAtUtc</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.RawDetail))
                            {
                                <div class="tags">@item.RawDetail</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.RedactedDetail))
                            {
                                <div class="tags">@item.RedactedDetail</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="paymentli">No logs recorded for this session.</div>
}
