@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
<script src="~/js/TwilioCallMaker.js?v=2024"></script>
<script type="text/javascript">
    var bdConfig = {
        recipientType: @Html.Raw(Json.Serialize(Model.RecipientType)),
        returnBack: @Html.Raw(Json.Serialize(returnBack)),
        pagetype: @Html.Raw(Json.Serialize(pagetype)),
        isCandidateTab: @Json.Serialize(isCandidateTab),
        isPublic: @Json.Serialize(isPublic),
        canAct: @Json.Serialize(canAct),
        canUnreachable: @Json.Serialize(canUnreachable),
        canEditInterviewer: @Json.Serialize(canEditInterviewer),
        minDate: @Html.Raw(Json.Serialize(Model.MinDate.ToString("yyyy-MM-dd"))),
        maxDate: @Html.Raw(Json.Serialize(Model.MaxDate.ToString("yyyy-MM-dd"))),
        selected: {
            SkillChannel: @Html.Raw(Json.Serialize(Model.SelectedSkillChannels)),
            Activity: @Html.Raw(Json.Serialize(Model.SelectedActivities)),
            SentBy: @Html.Raw(Json.Serialize(Model.SelectedSentBy)),
            Recipient: @Html.Raw(Json.Serialize(Model.SelectedRecipients)),
            BounceReason: @Html.Raw(Json.Serialize(Model.SelectedBounceReasons))
        },
        urls: {
            data: '@Url.Action("GetEmailRecipientsBounceAndDroppedData", "Dashboard")',
            content: '@Url.Action("GetBounceMailContent", "Dashboard")',
            fixEmail: '@Url.Action("UpdateBouncedCandidateEmail", "Dashboard")',
            resend: '@Url.Action("ResendBouncedMail", "Dashboard")',
            retry: '@Url.Action("RetrySameAddress", "Dashboard")',
            resolve: '@Url.Action("ResolveMailBounce", "Dashboard")',
            reset: '@Url.Action("ResetRecipientActivityDetails", "Dashboard")',
            page: '@Url.Action("GetEmailRecipientsBounceAndDropped", "Dashboard")'
        }
    };

    // Rows of the page currently shown, by SendgridEventId (filled on every draw).
    var bdRows = {};
    var bdTable = null;

    function bdToken() {
        return $('#__BounceAntiForgery input[name="__RequestVerificationToken"]').val() || '';
    }

    function esc(value) {
        if (value === null || value === undefined) return '';
        return String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function truncate(value, len) {
        value = value || '';
        return value.length > len ? value.substring(0, len) + '…' : value;
    }

    // Wrapping text block: the first `len` characters, with Read more / Read less for the rest.
    function readMore(value, len) {
        value = value || '';
        if (value.length <= len) {
            return '<div class="bd-text">' + esc(value) + '</div>';
        }
        return '<div class="bd-text">' + esc(value.substring(0, len))
            + '<span class="bd-ellipsis">…</span><span class="bd-more-text">' + esc(value.substring(len)) + '</span>'
            + '<a class="bd-toggle" role="button" tabindex="0">Read more</a></div>';
    }

    $(document).on('click keydown', '#recipientsTable .bd-toggle', function (e) {
        if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        var $box = $(this).closest('.bd-text').toggleClass('bd-expanded');
        $(this).text($box.hasClass('bd-expanded') ? 'Read less' : 'Read more');
    });

    function bdToast(message, ok) {
        var $t = $('#bdToast');
        $t.removeClass('ok err').addClass(ok ? 'ok' : 'err').text(message).stop(true, true).fadeIn(150);
        clearTimeout($t.data('timer'));
        $t.data('timer', setTimeout(function () { $t.fadeOut(300); }, 4000));
    }

    function bdPost(url, data) {
        return $.ajax({
            url: url,
            type: 'POST',
            data: data,
            headers: { 'RequestVerificationToken': bdToken() }
        });
    }

    function bdModal(id) {
        return bootstrap.Modal.getOrCreateInstance(document.getElementById(id));
    }

    function bdReload() {
        if (bdTable) bdTable.ajax.reload(null, false);
    }

    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        });
        ApplySessionFilter();
        initDateRange();
        applyDataTable();
    });

    // The recipient-activity popup is loaded into its placeholder; only that modal is removed on close
    // (removing every .modal would also delete the filter, Fix Email and call modals).
    $(document).on('hidden.bs.modal', '#modal_recipientActivity_placeholder .modal', function () {
        $('#modal_recipientActivity_placeholder').empty();
        $('.modal-backdrop').remove();
        $('body').removeClass("modal-open");
    });

    function ResetFilter() {
        window.location.href = bdConfig.urls.reset + "?returnBack=" + encodeURIComponent(bdConfig.returnBack)
            + "&pagetype=" + encodeURIComponent(bdConfig.pagetype)
            + "&recipientType=" + encodeURIComponent(bdConfig.recipientType);
    }

    function ApplySessionFilter() {
        $("#SkillChannel").val(bdConfig.selected.SkillChannel);
        $("#Activity").val(bdConfig.selected.Activity);
        $("#SentBy").val(bdConfig.selected.SentBy);
        $("#Recipient").val(bdConfig.selected.Recipient);
        $("#BounceReason").val(bdConfig.selected.BounceReason);
    }

    function isoDate(d) {
        var m = d.getMonth() + 1, day = d.getDate();
        return d.getFullYear() + '-' + (m < 10 ? '0' : '') + m + '-' + (day < 10 ? '0' : '') + day;
    }

    // Preset fills Start/End and locks them; Custom unlocks. The server re-computes and clamps anyway.
    function initDateRange() {
        function apply() {
            var days = $('#RangeDays').val();
            if (days) {
                var end = new Date(bdConfig.maxDate + 'T00:00:00');
                var start = new Date(end);
                start.setDate(start.getDate() - (parseInt(days, 10) - 1));
                $('#StartDate').val(isoDate(start)).prop('readonly', true);
                $('#EndDate').val(isoDate(end)).prop('readonly', true);
            } else {
                $('#StartDate, #EndDate').prop('readonly', false);
            }
            $('#dateRangeError').hide();
        }
        $('#RangeDays').on('change', apply);
        apply();

        $('#form').on('submit', function (e) {
            if ($('#RangeDays').val()) return true;
            var s = $('#StartDate').val(), en = $('#EndDate').val(), msg = '';
            if (s && s < bdConfig.minDate) msg = 'Data is available for the last 45 days only.';
            else if (en && en > bdConfig.maxDate) msg = 'End Date cannot be in the future.';
            else if (s && en && en < s) msg = 'End Date must be on or after Start Date.';
            if (msg) {
                e.preventDefault();
                $('#dateRangeError').text(msg).show();
                return false;
            }
            return true;
        });
    }

    function renderActions(row) {
        var html = '<div class="bd-actions">';
        if (row.resolutionStatus) {
            html += '<span class="bd-status ' + esc(row.resolutionStatus) + '" title="Status">' + esc(row.resolutionStatus) + '</span><br/>';
        }
        html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-activity" style="background:#dca3a3;" title="Click here to view recipient activity upon recieving email." aria-label="Recipient activity" data-url="' + esc(row.recipientActivityUrl) + '"><i class="fa fa-envelope-open"></i></button>';
        html += '<a target="_blank" class="btn shadow btn-xs sharp me-1 btn-schedule item4 bd-btn" href="' + esc(row.scheduleUrl) + '" title="Schedule Meeting" aria-label="Schedule Meeting"><i class="fa fa-calendar"></i></a>';

        if (!bdConfig.isPublic) {
            if (row.mobileNumber) {
                html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-call" title="Click here to call the candidate." aria-label="Call" data-id="' + row.sendgridEventId + '"><i class="fa fa-phone"></i></button>';
            } else {
                html += '<span class="bd-nophone">No phone</span>';
            }
        }

        if (bdConfig.isCandidateTab && bdConfig.canAct) {
            var open = !row.isResolved;
            if (open && row.candidateId) {
                html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-fix" title="Fix Email" aria-label="Fix Email" data-id="' + row.sendgridEventId + '"><i class="fa fa-edit"></i></button>';
            }
            // A row already Resent can be resent again after the cooldown; the calendar then updates the same event.
            if ((open || row.resolutionStatus === 'Resent') && row.emailCorrected && row.candidateId) {
                html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-resend" title="Resend Mail" aria-label="Resend Mail" data-id="' + row.sendgridEventId + '"><i class="fa fa-repeat"></i></button>';
            }
            // Temporary bounce (mailbox full, 4.x.x): the same address can simply be tried again.
            if (open && row.bounceKind === 'Temporary' && !row.emailCorrected && row.candidateId) {
                html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-retry" title="Retry same address" aria-label="Retry same address" data-id="' + row.sendgridEventId + '"><i class="fa fa-refresh"></i></button>';
            }
            if (open) {
                html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-resolve" title="Mark Resolved" aria-label="Mark Resolved" data-id="' + row.sendgridEventId + '"><i class="fa fa-check"></i></button>';
                if (bdConfig.canUnreachable) {
                    html += '<button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-unreachable" title="Unreachable" aria-label="Unreachable" data-id="' + row.sendgridEventId + '"><i class="fa fa-ban"></i></button>';
                }
            }
            if (row.openCandidateUrl) {
                html += '<a target="_blank" class="btn shadow btn-xs sharp me-1 bd-btn bd-open" href="' + esc(row.openCandidateUrl) + '" title="Open Candidate" aria-label="Open Candidate"><i class="fa fa-user"></i></a>';
            }
            // Send Invite would go to the same bad address until the email is fixed.
            if (row.emailCorrected && row.sendInviteUrl) {
                html += '<a class="btn shadow btn-xs sharp me-1 bd-btn bd-invite" href="' + esc(row.sendInviteUrl) + '" title="Send Invite" aria-label="Send Invite"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#fff"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg></a>';
            } else {
                html += '<span title="Fix the email first" style="display:inline-block"><button type="button" class="btn shadow btn-xs sharp me-1 bd-btn bd-invite" disabled aria-label="Send Invite (fix the email first)"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#fff"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" /></svg></button></span>';
            }
        }

        if (!bdConfig.isCandidateTab && bdConfig.canEditInterviewer && row.editInterviewerUrl) {
            html += '<a target="_blank" class="btn shadow btn-xs sharp me-1 bd-btn bd-editint" href="' + esc(row.editInterviewerUrl) + '" title="Edit Interviewer" aria-label="Edit Interviewer"><i class="fa fa-edit"></i></a>';
        }
        html += '</div>';
        return html;
    }

    function applyDataTable() {
        bdTable = $('#recipientsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [10, 25, 50, 100],
            "pageLength": 10,
            serverSide: true,
            processing: true,
            searchDelay: 500,
            order: [[4, 'desc']],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
                processing: '<img src="/Newassets/img/lazyload.gif" />'
            },
            ajax: {
                url: bdConfig.urls.data + '?recipientType=' + encodeURIComponent(bdConfig.recipientType),
                type: 'POST',
                headers: { 'RequestVerificationToken': bdToken() },
                dataSrc: function (json) {
                    bdRows = {};
                    (json.data || []).forEach(function (r) { bdRows[r.sendgridEventId] = r; });
                    if (json.error) bdToast(json.error, false);
                    return json.data || [];
                },
                error: function (xhr) {
                    bdToast(xhr.status === 401 ? 'Your session has expired. Please sign in again.' : 'Could not load the list. Please try again.', false);
                }
            },
            columns: [
                { data: 'email', name: 'email', render: function (d) { return esc(d); } },
                { data: 'candidateName', name: 'candidateName', render: function (d) { return esc(d); } },
                { data: 'mailSubject', name: 'MailSubject', render: function (d) { return readMore(d, 60); } },
                { data: null, orderable: false, render: function (d, t, row) { return '<a class="bd-content" data-id="' + row.sendgridEventId + '" style="color:blue; cursor:pointer"><u>Content</u></a>'; } },
                { data: 'sentOn', name: 'SentOn', render: function (d) { return esc(d); } },
                { data: 'sentBy', name: 'SentBy', render: function (d) { return esc(d); } },
                { data: 'latestEvent', name: 'latestEvent', render: function (d) { return esc(d); } },
                {
                    data: 'bounceReason', name: 'BounceReason', render: function (d, t, row) {
                        var full = (d || '') + (row.bounceStatus ? ' (' + row.bounceStatus + ')' : '');
                        return readMore(full, 60);
                    }
                },
                { data: 'bounceCount', name: 'BounceCount', render: function (d) { return esc(d); } },
                { data: 'activityDate', name: 'ActivityDate', render: function (d) { return esc(d); } },
                { data: 'skillChannelName', name: 'SkillChannelName', render: function (d) { return esc(d); } },
                { data: 'interviewDate', name: 'interviewDate', render: function (d) { return esc(d); } },
                { data: 'channelOwner', name: 'ChannelOwner', render: function (d) { return esc(d); } },
                { data: 'mobileNumber', name: 'MobileNumber', render: function (d) { return esc(d); } },
                {
                    data: 'resumeLink', orderable: false, render: function (d) {
                        if (!d) return 'No Resume';
                        return '<a style="background:none!important;border:0px!important; text-decoration: underline; color: #039BE5!important;" target="_blank" rel="noopener" title="Resume" href="' + esc(d) + '"><img style="position:relative;left:-5px;" src="/img/resume-icon.png" width="21">Resume</a>';
                    }
                },
                { data: null, orderable: false, className: 'text-center', render: function (d, t, row) { return renderActions(row); } }
            ]
        });
    }

    function Changeurldetails(recipientType) {
        window.location.href = bdConfig.urls.page + "?recipientType=" + encodeURIComponent(recipientType)
            + "&returnBack=" + encodeURIComponent(bdConfig.returnBack) + "&pagetype=" + encodeURIComponent(bdConfig.pagetype);
    }

    // ---- Row actions -------------------------------------------------------------------------

    // Recipient activity popup (rows are drawn after page load, so bind by delegation).
    $(document).on('click', '#recipientsTable .bd-activity', function () {
        var url = $(this).data('url');
        $.get(url).done(function (data) {
            var $ph = $('#modal_recipientActivity_placeholder');
            $ph.html(data);
            $ph.find('.modal').modal('show');
        });
    });

    // Mail body is loaded on click instead of being embedded in the page.
    $(document).on('click', '#recipientsTable .bd-content', function () {
        var row = bdRows[$(this).data('id')];
        if (!row) return;
        // Open the window inside the click so popup blockers allow it, then fill it.
        var child = window.open('about:blank', 'mailContent');
        if (child) child.document.write('<p style="font-family:sans-serif">Loading…</p>');
        $.get(bdConfig.urls.content, { sendgridEventId: row.sendgridEventId, candidateId: row.candidateId || '' })
            .done(function (r) {
                if (!r.success) {
                    if (child) child.close();
                    bdToast(r.message, false);
                    return;
                }
                if (child) {
                    child.document.open();
                    child.document.write(r.body);
                    child.document.close();
                } else {
                    OpenHtmlDocument(r.body);
                }
            })
            .fail(function () {
                if (child) child.close();
                bdToast('Could not load the mail. Please try again.', false);
            });
    });

    // Call: values come from the row data, never from inline script, so names like D'Souza are safe.
    var bdCallRowId = null;
    $(document).on('click', '#recipientsTable .bd-call', function () {
        var row = bdRows[$(this).data('id')];
        if (!row) return;
        bdCallRowId = (bdConfig.isCandidateTab && bdConfig.canAct && !row.isResolved && row.candidateId) ? row.sendgridEventId : null;
        CommonCallButtonClick(row.candidateName || row.candidateEmail || '', row.mobileNumber, row.candidateEmail || '',
            row.interviewId || null, row.irfId || null, 'Candidate');
    });

    // After the call window closes, offer to fix the email for the same row.
    (function watchCallModal() {
        var modal = document.getElementById('myCallModal');
        if (!modal || !window.MutationObserver) return;
        var wasOpen = false;
        new MutationObserver(function () {
            var open = modal.style.display === 'block';
            if (wasOpen && !open && bdCallRowId !== null) {
                var rowId = bdCallRowId;
                bdCallRowId = null;
                swal({
                    title: "Got a new email?",
                    text: "If the candidate gave you the correct address, fix it now.",
                    type: "info",
                    showCancelButton: true,
                    confirmButtonText: "Fix Email",
                    cancelButtonText: "Not now"
                }, function (isConfirm) {
                    if (isConfirm) setTimeout(function () { openFixEmail(rowId); }, 200);
                });
            }
            wasOpen = open;
        }).observe(modal, { attributes: true, attributeFilter: ['style'] });
    })();

    // Fix Email
    var bdFixRowId = null;
    function openFixEmail(rowId) {
        var row = bdRows[rowId];
        if (!row || !bdConfig.canAct) return;
        bdFixRowId = rowId;
        $('#fixCandidateName').text(row.candidateName || '-');
        $('#fixCurrentEmail').text(row.candidateEmail || row.email || '-');
        $('#fixBounceReason').text((row.bounceReason || '-') + (row.bounceStatus ? ' (' + row.bounceStatus + ')' : ''));
        $('#fixSkillChannel').text(row.skillChannelName || '-');
        $('#fixNewEmail').val('');
        $('#fixResend').prop('checked', true);
        $('#fixEmailError').hide().text('');
        $('#fixRetrySame').hide();
        $('#fixEmailSave').prop('disabled', false);
        bdModal('fixEmailModal').show();
        setTimeout(function () { $('#fixNewEmail').trigger('focus'); }, 300);
    }
    $(document).on('click', '#recipientsTable .bd-fix', function () { openFixEmail($(this).data('id')); });

    var bdEmailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
    $('#fixEmailForm').on('submit', function (e) {
        e.preventDefault();
        var row = bdRows[bdFixRowId];
        if (!row) return;
        var newEmail = ($('#fixNewEmail').val() || '').trim().toLowerCase();
        var current = (row.candidateEmail || row.email || '').trim().toLowerCase();
        var domain = newEmail.split('@@').pop();
        var err = '';
        $('#fixRetrySame').hide();
        if (!newEmail || !bdEmailPattern.test(newEmail)) err = 'Please enter a valid email address.';
        else if (newEmail === current) {
            // Same address: a temporary bounce can be retried as-is; a permanent one needs a different email.
            var reason = row.bounceReason || 'no reason given';
            if (row.bounceKind === 'Temporary' && !row.emailCorrected) {
                err = 'This address bounced temporarily (' + reason + '). Use Retry same address instead.';
                $('#fixRetrySame').show();
            } else {
                err = 'This address does not exist (' + reason + '). Enter a different email or call the candidate.';
            }
        }
        else if (domain === 'risebird.io' || (row.clientDomain && domain === row.clientDomain.toLowerCase())) err = 'Email domain is not allowed for a candidate.';
        if (err) {
            $('#fixEmailError').text(err).show();
            return;
        }
        // Same rule as Candidate Edit; the server checks it again.
        $('#fixEmailError').hide();
        $('#fixEmailSave').prop('disabled', true);
        bdPost(bdConfig.urls.fixEmail, {
            candidateId: row.candidateId,
            sendgridEventId: row.sendgridEventId,
            newEmail: newEmail,
            resend: $('#fixResend').is(':checked')
        }).done(function (r) {
            if (!r.success) {
                $('#fixEmailError').text(r.message).show();
                if (r.canRetry) $('#fixRetrySame').show();
                $('#fixEmailSave').prop('disabled', false);
                return;
            }
            bdModal('fixEmailModal').hide();
            if (r.code === 'InterviewOver') {
                bdOfferSchedule(row, r.message);
            } else {
                bdToast(r.message, true);
                if (r.resendMessage && !r.resent) {
                    setTimeout(function () { bdToast('Email updated, but the mail was not resent: ' + r.resendMessage, false); }, 1500);
                }
            }
            bdReload();
        }).fail(function () {
            $('#fixEmailError').text('Could not update email. Please try again.').show();
            $('#fixEmailSave').prop('disabled', false);
        });
    });

    // Resend Mail
    $(document).on('click', '#recipientsTable .bd-resend', function () {
        var $btn = $(this);
        var row = bdRows[$btn.data('id')];
        if (!row) return;
        swal({
            title: "Resend this mail?",
            text: "The original mail \"" + (row.mailSubject || '') + "\" will be sent again to " + (row.candidateEmail || '') + ".",
            type: "warning",
            showCancelButton: true,
            confirmButtonText: "Resend",
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) return;
            $btn.prop('disabled', true);
            bdPost(bdConfig.urls.resend, { sendgridEventId: row.sendgridEventId, candidateId: row.candidateId })
                .done(function (r) {
                    if (r.code === 'InterviewOver') bdOfferSchedule(row, r.message); else bdToast(r.message, r.success);
                    if (r.success) bdReload(); else $btn.prop('disabled', false);
                })
                .fail(function () {
                    bdToast('Could not resend the mail. Please try again.', false);
                    $btn.prop('disabled', false);
                });
        });
    });

    // The interview behind the mail has passed or was cancelled: nothing was sent; offer to schedule a new one.
    function bdOfferSchedule(row, message) {
        setTimeout(function () {
            swal({
                title: "Mail not resent",
                text: message,
                type: "info",
                showCancelButton: !!row.scheduleUrl,
                confirmButtonText: row.scheduleUrl ? "Schedule Meeting" : "OK",
                cancelButtonText: "Close"
            }, function (isConfirm) {
                if (isConfirm && row.scheduleUrl) window.open(row.scheduleUrl, '_blank');
            });
        }, 300);
    }

    // Retry same address (temporary bounce): from the row, or from the Fix Email modal.
    function bdRetrySame(rowId, $btn) {
        var row = bdRows[rowId];
        if (!row) return;
        swal({
            title: "Retry the same address?",
            text: "The original mail \"" + (row.mailSubject || '') + "\" will be sent again to " + (row.email || '') + ".",
            type: "warning",
            showCancelButton: true,
            confirmButtonText: "Retry",
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) return;
            if ($btn) $btn.prop('disabled', true);
            bdPost(bdConfig.urls.retry, { sendgridEventId: row.sendgridEventId, candidateId: row.candidateId })
                .done(function (r) {
                    if (r.success && document.getElementById('fixEmailModal')) bdModal('fixEmailModal').hide();
                    if (r.code === 'InterviewOver') bdOfferSchedule(row, r.message); else bdToast(r.message, r.success);
                    if (r.success) bdReload(); else if ($btn) $btn.prop('disabled', false);
                })
                .fail(function () {
                    bdToast('Could not resend the mail. Please try again.', false);
                    if ($btn) $btn.prop('disabled', false);
                });
        });
    }
    $(document).on('click', '#recipientsTable .bd-retry', function () { bdRetrySame($(this).data('id'), $(this)); });
    $('#fixRetrySame').on('click', function () { bdRetrySame(bdFixRowId, $(this)); });

    // Mark Resolved / Unreachable
    var bdResolve = { rowId: null, status: null };
    function openResolve(rowId, status) {
        var row = bdRows[rowId];
        if (!row) return;
        bdResolve = { rowId: rowId, status: status };
        var unreachable = status === 'Unreachable';
        $('#resolveModalLabel').text(unreachable ? 'Mark Unreachable' : 'Mark Resolved');
        $('#resolveIntro').text(unreachable
            ? 'Mark ' + (row.candidateName || row.email) + ' as unreachable? The row will leave the default view.'
            : 'Close this row for ' + (row.candidateName || row.email) + '? It will leave the default view.');
        $('#resolveNoteLabel').html(unreachable ? 'Note <span style="color:#c62828">*</span>' : 'Note (optional)');
        $('#resolveNote').val('').prop('required', unreachable);
        $('#resolveNoteCount').text('0');
        $('#resolveError').hide().text('');
        $('#resolveSave').prop('disabled', false);
        bdModal('resolveModal').show();
    }
    $(document).on('click', '#recipientsTable .bd-resolve', function () { openResolve($(this).data('id'), 'Resolved'); });
    $(document).on('click', '#recipientsTable .bd-unreachable', function () { openResolve($(this).data('id'), 'Unreachable'); });
    $('#resolveNote').on('input', function () { $('#resolveNoteCount').text(($(this).val() || '').length); });

    $('#resolveForm').on('submit', function (e) {
        e.preventDefault();
        var row = bdRows[bdResolve.rowId];
        if (!row) return;
        var note = ($('#resolveNote').val() || '').trim();
        if (bdResolve.status === 'Unreachable' && !note) {
            $('#resolveError').text('Please add a note.').show();
            return;
        }
        if (note.length > 500) {
            $('#resolveError').text('Note must be 500 characters or less.').show();
            return;
        }
        $('#resolveSave').prop('disabled', true);
        bdPost(bdConfig.urls.resolve, {
            sendgridEventId: row.sendgridEventId,
            candidateId: row.candidateId || '',
            status: bdResolve.status,
            note: note
        }).done(function (r) {
            if (!r.success) {
                $('#resolveError').text(r.message).show();
                $('#resolveSave').prop('disabled', false);
                return;
            }
            bdModal('resolveModal').hide();
            bdToast(r.message, true);
            bdReload();
        }).fail(function () {
            $('#resolveError').text('Could not save. Please try again.').show();
            $('#resolveSave').prop('disabled', false);
        });
    });
</script>
@if (isPublic)
{
    <script>
        $(document).ready(function () {
            $("#main-panel").removeClass("main-panel");
        });
    </script>
