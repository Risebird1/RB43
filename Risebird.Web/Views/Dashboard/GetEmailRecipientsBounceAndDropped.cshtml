@model IEnumerable<Risebird.Entities.ViewModel.MailRecipientActivityDetailsVM>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using Risebird.Entities.Data
@using Risebird.Entities.ViewModel
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Get Email Recipients";
    ViewBag.PageHeader = "Mail Recipients";
    if (ViewBag.pagetype == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] SkillChannel = new string[] { };
    string[] Activity = new string[] { };
    string[] SentBy = new string[] { };
    string[] Recipient = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("MailActivityFilters") != null)
{
    filter = JsonConvert.DeserializeObject<MailActivityFilter>(HttpContextAccessor.HttpContext.Session.GetString("MailActivityFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;
    SkillChannel = filter.SkillChannel != null ? filter.SkillChannel : new string[] { };
    Activity = filter.Activity != null ? filter.Activity : new string[] { };
    SentBy = filter.SentBy != null ? filter.SentBy : new string[] { };
    Recipient = filter.Recipient != null ? filter.Recipient : new string[] { };
}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />

<div class="main-panel" id="main-panel">
    <div>
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin:0px;">
                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <div class="mobile-view"> <h4 class="card-title">Mail Recipients</h4></div>
                    </div>
                    @if (ViewBag.pagetype != "Public")
                    {
                        <div class="pull-left">
                            @if (ViewBag.recipientType == "Interviewer")
                            {
                                <div class="feedback-tab" onclick="Changeurldetails('Candidate','@ViewBag.ReturnBack','@ViewBag.pagetype')"><strong>Candidate</strong></div>
                                <div class="feedback-tab-ac" onclick="Changeurldetails('Interviewer','@ViewBag.ReturnBack','@ViewBag.pagetype')"><strong>Interviewer</strong></div>
                            }
                            else if (ViewBag.recipientType == "Candidate")
                            {
                                <div class="feedback-tab-ac" onclick="Changeurldetails('Candidate','@ViewBag.ReturnBack','@ViewBag.pagetype')"><strong>Candidate</strong></div>
                                <div class="feedback-tab" onclick="Changeurldetails('Interviewer','@ViewBag.ReturnBack','@ViewBag.pagetype')"><strong>Interviewer</strong></div>
                            }
                        </div>
                    }
                    <div class="pull-right client-ms">
                        <div style="float:left">
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded three " style="float: left;margin-right: 5px;" data-bs-toggle="modal" data-bs-target="#filterModal">
                                <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        </div>
                        <div class="pull-right client-ms">
                            @if (ViewBag.pagetype != "Public")
                            {
                                @if (ViewBag.ReturnBack == 1)
                                {

                                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                        <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                        <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
