                                                                    @foreach (var item in Model.Select(x => x.SentBy).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="control-label col-md-12 col-sm-12 desp-label" for="Recipient">Recipient</label>
                                                            <div class="col-md-12 col-sm-12">
                                                                <select id="Recipient" name="Recipient" class="form-control multiselect" multiple="multiple" data-placeholder="None Selected">
                                                                    @foreach (var item in Model.Select(x => x.email).Distinct().ToList())
                                                                    {
                                                                        @if (item != null && item != "")
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    @*                                                    <input id="RecipientType" value="@ViewBag.recipientType" type="hidden"/>
                                                    *@                                                    <div class="col-md-6 col-sm-6">

                                                        <div class="form-group">
                                                            <div>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin: 10px 0px;float:right;margin-left:5px;">
                                                                        <font style="font-size:12px;"> Reset Filter</font>
                                                                    </button>
                                                                    <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 10px;float:right">
                                                                        <font style="font-size:12px;"> Apply Filter</font>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>


                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>


                            <div style="overflow-x:scroll" class="scrollbar">

                                <div id="tableID" class="second">
