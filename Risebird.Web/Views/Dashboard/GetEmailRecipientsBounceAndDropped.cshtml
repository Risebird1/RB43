<div id="modal_recipientActivity_placeholder"></div>

@if (canAct)
{
    <!-- Fix Email -->
    <div class="modal fade" id="fixEmailModal" tabindex="-1" role="dialog" aria-labelledby="fixEmailModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="fixEmailModalLabel">Fix Email</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="fixEmailForm" novalidate>
                    <div class="modal-body">
                        <dl class="bd-readonly">
                            <dt>Candidate</dt><dd id="fixCandidateName"></dd>
                            <dt>Current email</dt><dd id="fixCurrentEmail"></dd>
                            <dt>Bounce reason</dt><dd id="fixBounceReason"></dd>
                            <dt>Skill channel</dt><dd id="fixSkillChannel"></dd>
                        </dl>
                        <div class="form-group">
                            <label for="fixNewEmail" class="desp-label">Correct email <span style="color:#c62828">*</span></label>
                            <input type="email" id="fixNewEmail" class="form-control" maxlength="150" autocomplete="off" required />
                        </div>
                        <div class="form-group" style="margin-top:8px;">
                            <label style="cursor:pointer;font-size:13px;">
                                <input type="checkbox" id="fixResend" checked /> Resend this mail after saving
                            </label>
                        </div>
                        <div id="fixEmailError" class="bd-modal-error" style="display:none"></div>
                        <button type="button" id="fixRetrySame" class="mdc-button mdc-button--outlined" style="display:none;margin-top:8px;">
                            <i class="fa fa-refresh"></i>&nbsp;Retry same address
                        </button>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="mdc-button mdc-button--outlined" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="fixEmailSave" class="mdc-button mdc-button--raised">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Mark Resolved / Unreachable -->
    <div class="modal fade" id="resolveModal" tabindex="-1" role="dialog" aria-labelledby="resolveModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="resolveModalLabel">Mark Resolved</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="resolveForm" novalidate>
                    <div class="modal-body">
                        <p id="resolveIntro" style="font-size:13px;"></p>
                        <div class="form-group">
                            <label for="resolveNote" class="desp-label" id="resolveNoteLabel">Note (optional)</label>
                            <textarea id="resolveNote" class="form-control" rows="3" maxlength="500"></textarea>
                            <small class="text-muted"><span id="resolveNoteCount">0</span>/500</small>
                        </div>
                        <div id="resolveError" class="bd-modal-error" style="display:none"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="mdc-button mdc-button--outlined" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="resolveSave" class="mdc-button mdc-button--raised">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

