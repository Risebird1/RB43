<script src="~/js/ModalFormServerValidation.js?v=2024"></script>
@await Html.PartialAsync("~/Views/TwilioCalls/TwilioCallModalPartial.cshtml")
<script src="~/js/TwilioCallMaker.js" asp-append-version="true"></script>
<script type="text/javascript">

    $(document).ready(function () {
        $("#ResetFilter").click(function () {
            ResetFilter();
        })
        if ('@filter' != "") {
            ApplySessionFilter();
        }

    });
    $(document).on('hidden.bs.modal', function (event) {
        $('.modal').remove();
        $('.modal-backdrop').remove();
        $('body').removeClass("modal-open");
    });
    function ResetFilter() {
        window.location.href = "/Dashboard/ResetRecipientActivityDetails?returnBack=" + @ViewBag.ReturnBack+"&pagetype="@ViewBag.Pagetype;
    }

    function ApplySessionFilter() {
        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var skillChannel = @Html.Raw(Json.Serialize(SkillChannel));
        var activity = @Html.Raw(Json.Serialize(Activity));
        var sentBy = @Html.Raw(Json.Serialize(SentBy));
        var recipient = @Html.Raw(Json.Serialize(Recipient));

        $('input[name=StartDate]').val(strtDte);
        $('input[name=EndDate]').val(endDte);
        $("#SkillChannel").val(skillChannel);
        $("#Activity").val(activity);
        $("#SentBy").val(sentBy);
        $("#Recipient").val(recipient);

    }

</script>
<script>

    $(document).ready(function () {
        applyDataTable();
    });

    function applyDataTable() {
        $('#recipientsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>

<script>

    function Changeurldetails(recipientType, returnBack, pagetype) {
        window.location.href = "/Dashboard/GetEmailRecipientsBounceAndDropped?recipientType=" + recipientType + "&returnBack=" + returnBack + "&pagetype=" + pagetype;
    }
</script>
@if (ViewBag.Pagetype == "Public")
{
    <script>
        $(document).ready(function () {
            $("#main-panel").removeClass("main-panel");
        });
    </script>
}
<script src="~/js/common.js?v=2024"></script>


