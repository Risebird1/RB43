@model Risebird.Entities.ViewModel.BounceDroppedPageSettingsVM
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Web.Helpers
@{
    ViewData["Title"] = "Get Email Recipients";
    ViewBag.PageHeader = "Mail Recipients";
    if (ViewBag.pagetype == "Public")
    {
        Layout = "~/Views/Shared/_PublicLayout2.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    string profile = ViewBag.Profile as string ?? string.Empty;
    bool isPublic = (ViewBag.pagetype as string) == "Public";
    bool isCandidateTab = Model.RecipientType != "Interviewer";
    bool isRisebirdUser = profile == "Admin" || profile == "SupportAdmin" || profile == "HR" || profile == "SeniorHR";
    // Hiding a button is not access control: every action is re-checked on the server.
    bool canAct = !isPublic && (isRisebirdUser || profile == "Client");
    bool canUnreachable = !isPublic && isRisebirdUser;
    bool canEditInterviewer = !isPublic && isRisebirdUser;
    string notice = TempData["BounceDroppedNotice"] as string ?? Model.Notice;
    string returnBack = Convert.ToString(ViewBag.ReturnBack);
    string pagetype = ViewBag.pagetype as string ?? string.Empty;
    var rangeOptions = new[] { new { Days = "2", Text = "Last 2 days" }, new { Days = "7", Text = "Last 7 days" }, new { Days = "15", Text = "Last 15 days" },
                               new { Days = "30", Text = "Last 30 days" }, new { Days = "45", Text = "Last 45 days" } };
    string selectedRange = Model.RangeDays.HasValue ? Model.RangeDays.Value.ToString() : "custom";
}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/hopscotch/0.2.5/css/hopscotch.min.css?v=2024" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<style>
    .bd-actions { white-space: nowrap; }
    .bd-actions .bd-btn { top: 0; position: relative; cursor: pointer; width: 25px !important; height: 25px !important; color: #fff; padding: 0; border: 0; display: inline-flex; align-items: center; justify-content: center; vertical-align: middle; margin: 1px; }
    .bd-actions .bd-btn i { font-size: 13px; color: #fff; margin: 0; }
    .bd-actions .bd-btn[disabled], .bd-actions .bd-btn.disabled { opacity: .45; cursor: not-allowed; }
    .bd-fix { background: #f0ad4e !important; }
    .bd-resend { background: #5cb85c !important; }
    .bd-resolve { background: #2e7d32 !important; }
    .bd-unreachable { background: #c62828 !important; }
    .bd-open { background: #607d8b !important; }
    .bd-call { background: #1e88e5 !important; }
    .bd-invite { background: #4fb3e4 !important; }
    .bd-editint { background: #8e24aa !important; }
    .bd-retry { background: #00897b !important; }
    .bd-nophone { font-size: 11px; color: #888; margin: 0 3px; }
    .bd-status { display: inline-block; font-size: 11px; padding: 1px 6px; border-radius: 10px; margin-left: 3px; background: #eceff1; color: #37474f; }
    .bd-status.EmailCorrected { background: #fff3e0; color: #e65100; }
    .bd-status.Resent, .bd-status.Resolved { background: #e8f5e9; color: #1b5e20; }
    .bd-status.Unreachable { background: #ffebee; color: #b71c1c; }
    .bd-range-label { font-size: 13px; color: #455a64; margin: 8px 0 4px; }
    /* Long subjects / bounce reasons wrap inside their own column instead of running over the next one. */
    .bd-text { min-width: 180px; max-width: 260px; white-space: normal; word-break: break-word; overflow-wrap: anywhere; line-height: 1.4; }
    .bd-text .bd-more-text { display: none; }
    .bd-text.bd-expanded .bd-more-text { display: inline; }
    .bd-text.bd-expanded .bd-ellipsis { display: none; }
    .bd-text .bd-toggle { display: inline-block; margin-left: 4px; font-size: 12px; color: #039BE5; cursor: pointer; white-space: nowrap; }
    .bd-notice { font-size: 13px; color: #8a6d3b; background: #fcf8e3; border: 1px solid #faebcc; padding: 6px 10px; border-radius: 4px; margin: 6px 0; }
    .bd-modal-error { color: #c62828; font-size: 13px; margin-top: 8px; }
    .bd-readonly dt { font-weight: 600; font-size: 12px; color: #607d8b; }
    .bd-readonly dd { margin-bottom: 6px; word-break: break-all; }
    #bdToast { position: fixed; right: 20px; bottom: 20px; z-index: 20000; min-width: 220px; max-width: 420px; padding: 10px 16px; border-radius: 4px; color: #fff; display: none; box-shadow: 0 2px 8px rgba(0,0,0,.25); font-size: 14px; }
    #bdToast.ok { background: #2e7d32; }
    #bdToast.err { background: #c62828; }
</style>

