@using Risebird.Entities.ViewModel
@{
    ViewData["Title"] = "QC Owner Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    var Header = "<div>Founder QC Owner Dashboard</div>";
    $('#txtpageHeader').empty().html(Header);
</script>
<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<style>
    .date-filter-bar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
    }

        .date-filter-bar .control-label {
            margin: 0;
            font-weight: 500;
            color: #495057;
        }

        .date-filter-bar input[type="date"] {
            width: 130px;
            padding: 4px 8px;
            font-size: 13px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            height: 28px;
        }

            .date-filter-bar input[type="date"]:focus {
                border-color: #80bdff;
                outline: 0;
                box-shadow: 0 0 0 2px rgba(0,123,255,.2);
            }

        .date-filter-bar #btnApply {
            height: 28px;
            padding: 0 12px;
            font-size: 12px;
            font-weight: 500;
            min-width: auto;
        }

    #dateRangeLabel {
        font-size: 13px;
        font-weight: 600;
        margin: 0 0 10px 0;
        padding: 6px 10px;
        color: #212529;
        letter-spacing: 0.01em;
        background: #f1f3f5;
        border-left: 3px solid #0d6efd;
        border-radius: 0 4px 4px 0;
    }
</style>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"><h4 class="card-title">Founder QC Owner Dashboard</h4></div>
                </div>
                <div class="pull-right">
                    <div class="form-inline date-filter-bar">
                        <label class="control-label" for="dateFrom">From</label>
                        <input type="date" id="dateFrom" class="form-control" />
                        <label class="control-label" for="dateTo">To</label>
                        <input type="date" id="dateTo" class="form-control" />
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnApply">Apply</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                <img src="~/Newassets/img/lazyload.gif" />
                            </div>
                            <div class="dataloading">
                                <div id="dateRangeLabel" class="date-range-label"></div>
                                <div class="scrollbar int-table" id="style-2">
                                    <div id="tableID" class="second">
                                        <table id="meeting" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>QC Owner</th>
                                                    <th>QC Done</th>
                                                    <th>Reports With Flags</th>
                                                    <th>Reports Without Flags</th>
                                                    <th>Critical Queue – No Flags</th>
                                                    <th>Total Flags Reported</th>
                                                    <th>Total Redo Marked</th>
                                                    <th>Total Proxy Marked</th>
                                                    <th>Total Penalty %</th>
                                                    <th>Penalized Reports</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>QC Owner</th>
                                                    <th>QC Done</th>
                                                    <th>Reports With Flags</th>
                                                    <th>Reports Without Flags</th>
                                                    <th>Critical Queue – No Flags</th>
                                                    <th>Total Flags Reported</th>
                                                    <th>Total Redo Marked</th>
                                                    <th>Total Proxy Marked</th>
                                                    <th>Total Penalty %</th>
                                                    <th>Penalized Reports</th>
                                                </tr>
                                            </tfoot>
                                            <tbody id="qcOwnerTableBody">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/common.js?v=2024"></script>
<script>
    var dataTableInstance = null;

    function setDefaultDates() {
        var to = new Date();
        var from = new Date();
        from.setDate(from.getDate() - 30);
        document.getElementById('dateFrom').value = from.toISOString().slice(0, 10);
        document.getElementById('dateTo').value = to.toISOString().slice(0, 10);
    }

    function loadData() {
        var from = document.getElementById('dateFrom').value;
        var to = document.getElementById('dateTo').value;
        if (!from || !to) {
            setDefaultDates();
            from = document.getElementById('dateFrom').value;
            to = document.getElementById('dateTo').value;
        }
        var url = '/Dashboard/GetQCOwnerDashboardData?dateFrom=' + encodeURIComponent(from) + '&dateTo=' + encodeURIComponent(to);
        $(".loader").show();
        $(".dataloading").hide();
        $("#meeting").hide();
        $.getJSON(url)
            .done(function (data) {
                $(".loader").hide();
                $(".dataloading").show();
                $("#meeting").show();
                    if (dataTableInstance) {
                        dataTableInstance.destroy();
                        dataTableInstance = null;
                    }
                if (data && data.rows && data.rows.length >= 0) {
                    document.getElementById('dateRangeLabel').textContent = 'Date range: ' + (data.dateFrom || '') + ' to ' + (data.dateTo || '');
                    var tbody = document.getElementById('qcOwnerTableBody');
                    tbody.innerHTML = '';
                    data.rows.forEach(function (row) {
                        var tr = document.createElement('tr');
                        tr.innerHTML =
                            '<td>' + (row.qcOwner || '') + '</td>' +
                            '<td>' + (row.qcDone ?? '') + '</td>' +
                            '<td>' + (row.reportsWithFlags ?? '') + '</td>' +
                            '<td>' + (row.reportsWithoutFlags ?? '') + '</td>' +
                            '<td>' + (row.criticalQueue_NoFlags ?? '') + '</td>' +
                            '<td>' + (row.totalFlagsReported ?? '') + '</td>' +
                            '<td>' + (row.totalRedoMarked ?? '') + '</td>' +
                            '<td>' + (row.totalProxyMarked ?? '') + '</td>' +
                            '<td>' + (row.totalPenaltyPercent ?? '') + '</td>' +
                            '<td>' + (row.penalizedReports ?? '') + '</td>';
                        tbody.appendChild(tr);
                    });

                    dataTableInstance = $('#meeting').DataTable({
                        "pagingType": "full_numbers",
                        "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
                        order: [[1, "desc"]],
                        responsive: true,
                        language: { search: "_INPUT_", searchPlaceholder: "Search records" }
                    });
                } else {
                    document.getElementById('dateRangeLabel').textContent = 'No data for the selected range.';
                    if (dataTableInstance) {
                        dataTableInstance.destroy();
                        dataTableInstance = null;
                    }
                    $('#meeting').DataTable({
                        "pagingType": "full_numbers",
                        "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
                        order: [],
                        responsive: true,
                        language: { search: "_INPUT_", searchPlaceholder: "Search records" }
                    });
                }
            })
            .fail(function () {
                $(".loader").hide();
                $(".dataloading").show();
                $("#meeting").show();
                document.getElementById('dateRangeLabel').textContent = 'Error loading data.';
                document.getElementById('qcOwnerTableBody').innerHTML = '';
            });
    }

    $(document).ready(function () {
        setDefaultDates();
        loadData();
        $('#btnApply').on('click', function () {
            loadData();
        });
    });
</script>
