<script>

    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("JDLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("JDFile").value = '';

        }

    }
    function RadioIRFID(val) {
        if (val == 'Yes') {
            document.getElementById("divirfid").style.display = "block";
        }
        else {
            document.getElementById("divirfid").style.display = "none";
        }
    }
    if ($("#txtirfid").val() == 1) {
        RadioIRFID('Yes');
    }
    function checkeditvalues() {
        // check valididate for values which are required
        return true;
    }

    function toggleCommentsPopup(show) {
        var overlay = document.getElementById('commentsOverlay');
        if (!overlay) return;
        if (show) {
            overlay.classList.add('is-open');
        } else {
            overlay.classList.remove('is-open');
        }
    }
</script>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        location.reload();
                    }
                )
            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true
                },
                    function ()
                    {
                        location.reload();
                    }
                )
            }
        }
        window.onload = my_code();
    </script>
}

<script src="~/Autocomplete/jquery-ui.min.js?v=2024"></script>
<script>
    var savedRequesterEmail = @Html.Raw(Json.Serialize(Model.RequesterEmailid ?? ""));

    function showRequesterBadge(ok, name) {
        var $status = $('#reqEmailStatus');
        $status.show();
        if (ok) {
            $status.html('<span class="req-type-pill is-verified"><i class="fa fa-check-circle"></i> Verified requester — ' + $('<div/>').text(name || 'known client').html() + '</span>');
        } else {
            $status.html('<span class="req-type-pill is-external"><i class="fa fa-info-circle"></i> New requester</span>');
        }
    }

    function verifyRequesterEmail(email) {
        email = $.trim(email || '');
        if (!email || email.indexOf('@@') < 0) {
            $('#reqEmailStatus').hide();
            $('#RequesterType').val('');
            return;
        }
        $.getJSON('@Url.Action("VerifyRequesterEmail", "DashBoard")', { email: email })
            .done(function (res) {
                if (res && res.ok) {
                    $('#RequesterType').val('Verified');
                    showRequesterBadge(true, res.clientName);
                    var $req = $('#Requester');
                    if ($req.length && !$.trim($req.val() || '')) {
                        $req.val(res.clientName || '');
                    }
                } else {
                    $('#RequesterType').val('External');
                    showRequesterBadge(false);
                }
            })
            .fail(function () {
                $('#RequesterType').val('External');
                showRequesterBadge(false);
            });
    }

    function onClientChanged(clientId) {
        $('#ddlRequesterEmail').html('<option value="">Select requester</option>');
        var clientName = $('#ddlClient option:selected').text();
        if (clientId && clientName && clientName !== 'Select client') {
            $('input[name="Client"]').val(clientName);
        } else {
            $('input[name="Client"]').val('');
        }
        if (!clientId) return;
        $.getJSON('/DashBoard/GetRequesterEmails', { clientId: clientId }, function (res) {
            if (res && res.success && res.data) {
                res.data.forEach(function (e) {
                    $('#ddlRequesterEmail').append('<option value="' + e + '">' + e + '</option>');
                });
            }
        });
        $.getJSON('/DashBoard/GetClientDetails', { clientId: clientId }, function (res) {
            if (res && res.success) {
                if (res.planType != null) $('#ddlPlanType').val(res.planType);
                if (res.clientType != null) $('#ddlClientType').val(res.clientType);
            }
        });
    }

    var Generateinvoiceflag = 1;
    $(document).ready(function () {
        var clientId = $('#ddlClient').val();
        if (clientId) {
            onClientChanged(clientId);
            if (savedRequesterEmail) {
                $(document).one('ajaxSuccess', function (e, xhr, settings) {
                    if (settings.url && settings.url.indexOf('GetRequesterEmails') !== -1) {
                        var $sel = $('#ddlRequesterEmail');
                        if (!$sel.find('option').filter(function () { return $(this).val() === savedRequesterEmail; }).length) {
                            $sel.append('<option value="' + savedRequesterEmail + '">' + savedRequesterEmail + '</option>');
                        }
                        $sel.val(savedRequesterEmail);
                        verifyRequesterEmail(savedRequesterEmail);
                    }
                });
            }
        }

        $('#ddlRequesterEmail').on('change blur', function () {
            verifyRequesterEmail($(this).val());
        });

        $(".autofillHr").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/DashBoard/FetchHR",
                    type: "POST",
                    data: { term: request.term },
                    dataType: 'json',
                    success: function (data) {
                        response($.map(data, function (item) {
                            return item;
                        }))
                    },
                    error: function (err) {
                        Swal.fire(err);
                    }
                });
            },
            select: function () {

            },
            minLength: 1
        });
        var uiAutocomplete = document.getElementById("ui-id-1");
        if (uiAutocomplete) {
            uiAutocomplete.style.zIndex = "10000";
        }
    });
</script>