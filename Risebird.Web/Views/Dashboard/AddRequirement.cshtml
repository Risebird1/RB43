@model Risebird.Entities.ViewModel.ChannelVM

@{
    ViewData["Title"] = "Add Requirement";
    ViewBag.PageHeader = "Channel Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/select2.css?v=2024" defer rel="stylesheet" />
<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
