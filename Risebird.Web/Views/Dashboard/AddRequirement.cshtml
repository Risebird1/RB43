<style>
    #commentsOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        z-index: 10050;
        align-items: center;
        justify-content: center;
    }

    #commentsOverlay.is-open {
        display: flex;
    }

    .comments-popup {
        background: #fff;
        border-radius: 6px;
        padding: 20px;
        width: 90%;
        max-width: 520px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .comments-popup textarea {
        min-height: 140px;
        resize: vertical;
    }

    .comments-popup-actions {
        margin-top: 12px;
        text-align: right;
    }

    .req-type-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .req-type-pill.is-verified {
        background: #e7f8ee;
        color: #15803d;
    }

    .req-type-pill.is-external {
        background: #fff3e2;
        color: #c2740c;
    }
</style>
