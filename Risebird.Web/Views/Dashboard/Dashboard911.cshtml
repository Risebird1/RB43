<script type="text/javascript">
    var setRibbonCalledCount = 0;
    var getDeletedZoomMeetingsCount = false;
    $(document).ready(function () {
        // TimeInterval();
        setRibbon();
        // $('[data-toggle="tooltip"]').tooltip();
    });

    function TimeIntervalUrl() {
        $.ajax({
            type: 'GET',
            url: '/Dashboard/Dashboard911',
            success: function () {
                location.reload(true);
            }
        });
    }
    function TimeInterval() {
        setInterval(TimeIntervalUrl, 90000);
    }
</script>


<script>
    function setRibbon() {
        if (setRibbonCalledCount == 0) {
            getDeletedZoomMeetingsCount = true;
        }
        else {
            getDeletedZoomMeetingsCount = false;
        }
        $.ajax({
            url: '/Dashboard/FetchRibbonValues',
            data: { 'section': 0, 'getDeletedZoomMeetingsCount': getDeletedZoomMeetingsCount },
            success: function (data) {
                if (parseInt(data.unassignedInterviewsCount) != parseInt($("#ribbonunassignedinterviewcount").text())) {
                    $(".flipper1").addClass("flipper");
                }
                else {
                    $(".flipper1").removeClass("flipper");
                }
                   if (parseInt(data.unfilledMeetingStatusCount) != parseInt($("#ribbonunfilledmeetingstatuscount").text())) {
                    $(".flipper2").addClass("flipper");
                }
                else {
                    $(".flipper2").removeClass("flipper");
                }
                if (parseInt(data.notProcessedCandidateResume) != parseInt($("#ribbonnotprocessedcandidateresume").text())) {
                    $(".flipper3").addClass("flipper");
                }
                else {
                    $(".flipper3").removeClass("flipper");
                }
                if (parseInt(data.missingZoomLink) != parseInt($("#ribbonmissingzoomlinkcount").text())) {
                    $(".flipper4").addClass("flipper");
                }
                else {
                    $(".flipper4").removeClass("flipper");
                }
    
                if (parseInt(data.unAttendedZoomLink) != parseInt($("#ribbonUnAttendedZoomLinkcount").text())) {
                    $(".flipper5").addClass("flipper");
                }
                else {
                    $(".flipper5").removeClass("flipper");
                }
                if (parseInt(data.missingVideoLink) != parseInt($("#ribbonmissingvideolinkcount").text())) {
                    $(".flipper6").addClass("flipper");
                }
                else {
                    $(".flipper6").removeClass("flipper");
                }

                if (parseInt(data.qcPendingReportCount) != parseInt($("#ribbonQCPendingReportCount").text())) {
                    $(".flipper7").addClass("flipper");
                }
                else {
                    $(".flipper7").removeClass("flipper");
                }
                if (parseInt(data.needClarityCount) != parseInt($("#ribbonNeedClarityCount").text())) {
                    $(".flipper8").addClass("flipper");
                }
                else {
                    $(".flipper8").removeClass("flipper");
                }
                if (parseInt(data.openIssueCount) != parseInt($("#ribbonOpenIssueCount").text())) {
                    $(".flipper9").addClass("flipper");
                }
                else {
                    $(".flipper9").removeClass("flipper");
                }
                if (parseInt(data.rescheduleInterviewMeetingCount) != parseInt($("#ribbonReScheduleCount").text())) {
                    $(".flipper10").addClass("flipper");
                }
                else {
                    $(".flipper10").removeClass("flipper");
                }
                if (parseInt(data.potentialRiskInterviewCount) != parseInt($("#ribbonPotentialRiskInterviewCount").text())) {
                    $(".flipper11").addClass("flipper");
                }
                else {
                    $(".flipper11").removeClass("flipper");
                }
                if (parseInt(data.suspeciousInterviewerCount) != parseInt($("#ribbonSuspiciousInterviewerCount").text())) {
                    $(".flipper12").addClass("flipper");
                }
                else {
                    $(".flipper12").removeClass("flipper");
                }
                 if (parseInt(data.cancelledInterviewCount) != parseInt($("#ribbonCancelledInterviewsCount").text())) {
                    $(".flipper13").addClass("flipper");              
                }
                else {
                    $(".flipper13").removeClass("flipper");
                }
                 if (parseInt(data.redoInterviewCount) != parseInt($("#ribbonRedoInterviewCount").text())) {
                  
                    $(".flipper14").addClass("flipper");
               
                }
                else {
                    $(".flipper14").removeClass("flipper");
                }

                $("#ribbonunassignedinterviewcount").text(data.unassignedInterviewsCount);
                $("#ribbonunfilledmeetingstatuscount").text(data.unfilledMeetingStatusCount);
                $("#ribbonnotprocessedcandidateresume").text(data.notProcessedCandidateResume);
                $("#ribbonmissingzoomlinkcount").text(data.missingZoomLink);
                $("#ribbonmissingvideolinkcount").text(data.missingVideoLink);
                $("#ribbonUnAttendedZoomLinkcount").text(data.unAttendedZoomLink);
                $("#ribbonQCPendingReportCount").text(data.qcPendingReportCount);
                $("#ribbonNeedClarityCount").text(data.needClarityCount);
                $("#ribbonOpenIssueCount").text(data.openIssueCount);
                $("#ribbonReScheduleCount").text(data.rescheduleInterviewMeetingCount);
                $("#ribbonPotentialRiskInterviewCount").text(data.potentialRiskInterviewCount);
                $("#ribbonSuspiciousInterviewerCount").text(data.suspiciousInterviewerCount);
                $("#ribbonCancelledInterviewsCount").text(data.cancelledInterviewCount);
                $("#ribbonRedoInterviewCount").text(data.redoInterviewCount);

                $("#ribbonunassignedinterviewcount_1").text(data.unassignedInterviewsCount);
                $("#ribbonunfilledmeetingstatuscount_1").text(data.unfilledMeetingStatusCount);
                $("#ribbonnotprocessedcandidateresume_1").text(data.notProcessedCandidateResume);
                $("#ribbonmissingzoomlinkcount_1").text(data.missingZoomLink);
                $("#ribbonmissingvideolinkcount_1").text(data.missingVideoLink);
                $("#ribbonUnAttendedZoomLinkcount_1").text(data.unAttendedZoomLink);
                $("#ribbonQCPendingReportCount_1").text(data.qcPendingReportCount);
                $("#ribbonNeedClarityCount_1").text(data.needClarityCount);
                $("#ribbonOpenIssueCount_1").text(data.openIssueCount);
                $("#ribbonReScheduleCount_1").text(data.rescheduleInterviewMeetingCount);
                $("#ribbonPotentialRiskInterviewCount_1").text(data.potentialRiskInterviewCount);
                $("#ribbonSuspiciousInterviewerCount_1").text(data.suspiciousInterviewerCount);
                $("#ribbonCancelledInterviewsCount_1").text(data.cancelledInterviewCount);
                $("#ribbonRedoInterviewCount_1").text(data.redoInterviewCount);

          
                $(".flipper").toggleClass("flip");
            }
        });
      
      
        setTimeout(setRibbon, 60000);
    }

</script>