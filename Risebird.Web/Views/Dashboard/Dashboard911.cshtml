<script>
    function OpenRibbonDetails(actionstatus) {
        window.location.href = "/Dashboard/UnassignedInterviews?actionstatus=" + actionstatus;
    }
    function OpenRibbonDetailsUnProcessedResume(actionstatus) {
        window.location.href = "/Dashboard/UnProcessedResume";
    }
    function OpenRibbonDetailsRaisedIssue() {
        window.location.href = "/Support/RaisedRequests";
    }
</script>
<script type="text/javascript">
    var setRibbonCalledCount = 0;
    var getDeletedZoomMeetingsCount = false;
   $(document).ready(function () {
      
     // TimeInterval();

     setRibbon();
       // $('[data-toggle="tooltip"]').tooltip();

    });

function TimeIntervalUrl()
{
$.ajax({
            type:'GET',
            url: '/Dashboard/Dashboard911',
            success:function(){
                location.reload(true);
            }
});
}
function TimeInterval()
{
 
        setInterval(TimeIntervalUrl, 90000);
}
</script>


