        function updateCounts(res) {
            if (res.pendingCount != null) $('#tfrCountPending').text('(' + res.pendingCount + ')');
            if (res.keptCount != null) $('#tfrCountKept').text('(' + res.keptCount + ')');
            if (res.removedCount != null) $('#tfrCountRemoved').text('(' + res.removedCount + ')');
        }

        function renderPager() {
            var total = totalFiltered;
            var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE) || 1);
            if (currentPage > totalPages) currentPage = totalPages;
            var start = total === 0 ? 0 : (currentPage - 1) * PAGE_SIZE + 1;
            var end = Math.min(currentPage * PAGE_SIZE, total);
            $('#tfrPageInfo').text(total === 0 ? 'No rows' : ('Showing ' + start + '–' + end + ' of ' + total));
            var html = '<button type="button" class="tfr-btn tfr-pg-prev"' + (currentPage <= 1 ? ' disabled' : '') + '>&lsaquo;</button>';
            var startPage = Math.max(1, currentPage - 2);
            var endPage = Math.min(totalPages, startPage + 4);
            startPage = Math.max(1, endPage - 4);
            for (var p = startPage; p <= endPage; p++) {
                html += '<button type="button" class="tfr-btn tfr-pg' + (p === currentPage ? ' is-active' : '') + '" data-page="' + p + '">' + p + '</button>';
            }
            html += '<button type="button" class="tfr-btn tfr-pg-next"' + (currentPage >= totalPages ? ' disabled' : '') + '>&rsaquo;</button>';
            $('#tfrPageBtns').html(html);
            $('#tfrPagination').addClass('is-visible');
        }

        function listQuery(draw) {
            return {
                tab: activeTab,
                draw: draw,
                start: (currentPage - 1) * PAGE_SIZE,
                length: PAGE_SIZE,
                search: searchTerm,
                severity: severityFilter,
                channelOwner: channelOwnerFilter
            };
        }

        function applyListMeta(res) {
            updateCounts(res);
            renderOwnerStrip(res.ownerSummaries || res.OwnerSummaries || []);
            totalFiltered = res.recordsFiltered || 0;
            renderPager();
        }

        /** After Keep/Remove: drop the row from the current tab without a full grid flash. */
        function removeFlagRows(flagId) {
            $tbody.find('tr.tfr-main-row[data-flag-id="' + flagId + '"], tr.tfr-detail-row[data-flag-id="' + flagId + '"]').remove();
            delete detailCache[flagId];
            delete detailInflight[flagId];
            if (!$tbody.find('tr.tfr-main-row').length) {
                loadPage();
                return;
            }
            // Refresh tab counts + owner P0 strip only
            $.ajax({
                url: listUrl,
                type: 'GET',
                dataType: 'json',
                data: listQuery(++drawSeq)
            }).done(function (res) {
                if (res && !res.error) applyListMeta(res);
            });
        }

        function loadPage() {
            if (typeof $ === 'undefined' || !$tbody || !$tbody.length) {
                console.error('TrialFlagReview: jQuery or #tfrTbody missing');
                return;
            }
            var myDraw = ++drawSeq;
            $tbody.html('<tr class="tfr-loading-row"><td colspan="10" class="tfr-empty">Loading...</td></tr>');
            $.ajax({
                url: listUrl,
                type: 'GET',
                dataType: 'json',
                timeout: 60000,
                data: listQuery(myDraw)
            }).done(function (res) {
                if (myDraw !== drawSeq) return;
                try {
                    if (!res) {
                        $tbody.html('<tr><td colspan="10" class="tfr-empty" style="color:#b91c1c;">Empty list response.</td></tr>');
                        return;
                    }
                    if (res.error || res.Error) {
                        $tbody.html('<tr><td colspan="10" class="tfr-empty" style="color:#b91c1c;">' + esc(res.error || res.Error) + '</td></tr>');
                        totalFiltered = 0;
                        renderPager();
                        return;
                    }
                    var rows = res.data || res.Data || [];
                    if (!rows.length) {
                        var pending = res.pendingCount != null ? res.pendingCount : res.PendingCount;
                        var kept = res.keptCount != null ? res.keptCount : res.KeptCount;
                        var removed = res.removedCount != null ? res.removedCount : res.RemovedCount;
                        var emptyMsg = 'No ' + esc(activeTab) + ' trial flags on this page.';
                        if (activeTab === 'pending' && pending === 0 && ((kept || 0) > 0 || (removed || 0) > 0)) {
                            emptyMsg = 'No pending flags. Kept: ' + (kept || 0) + ', Removed: ' + (removed || 0) + '. Switch tabs above, or run Backfill if the queue should have new trials.';
                        } else if (activeTab === 'pending' && pending === 0 && (kept || 0) === 0 && (removed || 0) === 0) {
                            emptyMsg = 'dbo.TrialFlags has no rows yet. Use Backfill trial flags, or wait for new first-interview QC merges.';
                        } else if (activeTab === 'pending' && (pending || 0) > 0) {
                            emptyMsg = 'Pending count is ' + pending + ' but this page returned 0 rows. Redeploy usp_GetTrialFlagsForReview_List (ReviewStatus filter), then Reload.';
                        }
                        $tbody.html('<tr><td colspan="10" class="tfr-empty">' + emptyMsg + '</td></tr>');
                        $('#tfrSearchEmpty').toggleClass('is-visible', !!searchTerm);
                    } else {
                        $('#tfrSearchEmpty').removeClass('is-visible');
                        var html = '';
                        for (var i = 0; i < rows.length; i++) {
                            html += buildMainRow(rows[i]);
                        }
                        $tbody.html(html);
                    }
                    applyListMeta(res);
                } catch (ex) {
                    console.error('TrialFlagReview list render failed', ex);
                    $tbody.html('<tr><td colspan="10" class="tfr-empty" style="color:#b91c1c;">List render failed: ' + esc(ex && ex.message ? ex.message : ex) + '</td></tr>');
                }
            }).fail(function (xhr, status) {
                if (myDraw !== drawSeq) return;
                var msg = 'List request failed';
                if (status === 'timeout') msg += ' (timed out). Check usp_GetTrialFlagsForReview_List on the database.';
                else if (xhr && xhr.status) msg += ' (HTTP ' + xhr.status + '). Deploy usp_GetTrialFlagsForReview_List.';
                else msg += '. Deploy usp_GetTrialFlagsForReview_List + usp_GetTrialFlagOwnerSummary.';
                $tbody.html('<tr><td colspan="10" class="tfr-empty" style="color:#b91c1c;">' + msg + '</td></tr>');
                $('#tfrOwnerStripBody').html('<span style="color:#b91c1c;">Owner strip unavailable</span>');
            });
        }

        function showToast(message, ok) {
            var $t = $('#tfrToast');
            $t.removeClass('tfr-toast--ok tfr-toast--err').addClass(ok ? 'tfr-toast--ok' : 'tfr-toast--err').text(message).addClass('is-show');
            setTimeout(function () { $t.removeClass('is-show'); }, 6000);
        }

        var searchTimer = null;
        $('#tfrSearch').on('input', function () {
            searchTerm = ($(this).val() || '').trim();
            $('#tfrSearchClear').toggle(!!searchTerm);
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () { currentPage = 1; loadPage(); }, 280);
        });
        $('#tfrSearchClear').on('click', function () {
            $('#tfrSearch').val('');
            searchTerm = '';
            $(this).hide();
            currentPage = 1;
            loadPage();
        });
        $('#tfrSeverityFilter').on('change', function () {
            severityFilter = ($(this).val() || '').toUpperCase();
            currentPage = 1;
            loadPage();
        });
        $('#tfrOwnerFilter').on('change', function () {
            channelOwnerFilter = ($(this).val() || '').trim();
            currentPage = 1;
            loadPage();
        });
        $(document).on('click', '.tfr-owner-chip', function () {
            var email = ($(this).data('owner') || '').toString();
            channelOwnerFilter = email;
            $('#tfrOwnerFilter').val(email);
            currentPage = 1;
            loadPage();
        });
        $(document).on('click', '#tfrOwnerClear', function () {
            channelOwnerFilter = '';
            $('#tfrOwnerFilter').val('');
            currentPage = 1;
            loadPage();
        });
        $('#btnTfrReload').on('click', function () { loadPage(); });

        $(document).on('click', '.tfr-pg', function () {
            var p = parseInt($(this).data('page'), 10);
            if (p && p !== currentPage) { currentPage = p; loadPage(); }
        });
        $(document).on('click', '.tfr-pg-prev', function () { if (currentPage > 1) { currentPage--; loadPage(); } });
        $(document).on('click', '.tfr-pg-next', function () {
            var totalPages = Math.max(1, Math.ceil(totalFiltered / PAGE_SIZE));
            if (currentPage < totalPages) { currentPage++; loadPage(); }
        });

        $(document).on('click', '.btn-tfr-details', function () {
            var flagId = $(this).data('flag-id');
            var $detail = $tbody.find('tr.tfr-detail-row[data-flag-id="' + flagId + '"]');
            var $main = $tbody.find('tr.tfr-main-row[data-flag-id="' + flagId + '"]');
            var open = !$detail.data('open');
            $detail.data('open', open);
            if (!open) { $detail.hide(); return; }
            $detail.show();
            var $body = $detail.find('.tfr-detail-body');
            var interviewId = parseInt($main.data('interview-id'), 10);
            var irfId = parseInt($main.data('irf-id'), 10) || 0;

            function afterDetail(detail) {
                $body.html(renderDetailPanel(detail, interviewId, irfId));
                loadAiSummary($body.find('.tfr-ai-body'));
            }

            if (detailCache[flagId]) {
                afterDetail(detailCache[flagId]);
                return;
            }
            if (detailInflight[flagId]) return;
            detailInflight[flagId] = true;
            $body.html('<div class="tfr-empty">Loading detail…</div>');
            $.getJSON(detailUrl, { trialFlagId: flagId }).done(function (res) {
                detailInflight[flagId] = false;
                if (!res || !res.ok) {
                    $body.html('<span style="color:#b91c1c;">' + esc((res && res.message) || 'Detail failed') + '</span>');
                    return;
                }
                detailCache[flagId] = res.detail;
                afterDetail(res.detail);
            }).fail(function () {
                detailInflight[flagId] = false;
                $body.html('<span style="color:#b91c1c;">Detail request failed.</span>');
            });
        });

        function openModal(action, flagId, interviewer, irf) {
            $('#tfrModalAction').val(action);
            $('#tfrModalFlagId').val(flagId);
            $('#tfrModalComment').val('');
            $('#tfrModalTitle').text(action === 'keep' ? 'Keep on IRF' : 'Remove from IRF');
            $('#tfrModalSub').text((interviewer || '') + ' · ' + (irf || ''));
            $('#tfrActionModal').attr('aria-hidden', 'false').addClass('is-open');
        }
        $('#tfrModalCancel').on('click', function () {
            $('#tfrActionModal').attr('aria-hidden', 'true').removeClass('is-open');
        });
        $(document).on('click', '.btn-tfr-keep', function () {
            openModal('keep', $(this).data('flag-id'), $(this).data('interviewer'), $(this).data('irf'));
        });
        $(document).on('click', '.btn-tfr-remove', function () {
            openModal('remove', $(this).data('flag-id'), $(this).data('interviewer'), $(this).data('irf'));
        });
        $('#tfrModalConfirm').on('click', function () {
            var action = $('#tfrModalAction').val();
            var flagId = parseInt($('#tfrModalFlagId').val(), 10);
            var comment = ($('#tfrModalComment').val() || '').trim();
            var url = action === 'keep' ? keepUrl : removeUrl;
            var $btn = $(this).prop('disabled', true);
            $.ajax({ url: url, type: 'POST', data: { trialFlagId: flagId, comment: comment }, dataType: 'json' })
                .done(function (res) {
                    showToast((res && res.message) || (res && res.ok ? 'Done.' : 'Failed.'), !!(res && res.ok));
                    $('#tfrActionModal').attr('aria-hidden', 'true').removeClass('is-open');
                    if (res && res.ok) {
                        removeFlagRows(flagId);
                    }
                })
                .fail(function () { showToast('Action failed.', false); })
                .always(function () { $btn.prop('disabled', false); });
        });

        $('#btnTfrBackfill').on('click', function () {
            var $btn = $(this).prop('disabled', true);
            $('#tfrBackfillStatus').text('Running…');
            $.ajax({ url: backfillUrl, type: 'POST', dataType: 'json' }).done(function (res) {
                $('#tfrBackfillStatus').text(res.message || '');
                showToast(res.message || (res.ok ? 'Backfill complete.' : 'Backfill finished.'), !!res.ok);
                if (res.inserted > 0) setTimeout(function () { loadPage(); $btn.prop('disabled', false); }, 800);
                else $btn.prop('disabled', false);
            }).fail(function (xhr) {
                var msg = 'Backfill request failed';
                if (xhr.status) msg += ' (HTTP ' + xhr.status + ')';
                $('#tfrBackfillStatus').text(msg);
                showToast(msg, false);
                $btn.prop('disabled', false);
            });
        });

        $(document).on('click', '.dm-v4-iv-insights-btn--global', function (e) {
            e.preventDefault();
            var email = ($(this).data('email') || '').toString().trim();
            if (!email || typeof InsightsDetails !== 'function') return;
            InsightsDetails(email);
        });
        $(document).on('click', '.btn-tfr-mark-suspicious', function (e) {
            e.preventDefault();
            var email = ($(this).data('email') || '').toString().trim();
            if (!email) return;
            if (typeof SuspiciousTypeDetails === 'function') SuspiciousTypeDetails(email);
        });
        $(document).on('click', '.btn-tfr-undo-suspicious', function (e) {
            e.preventDefault();
            var userId = parseInt($(this).data('user-id'), 10);
            var email = ($(this).data('email') || '').toString();
            if (!userId) { showToast('Missing interviewer user id for undo.', false); return; }
            if (!window.confirm('Undo suspicious mark for ' + (email || ('user #' + userId)) + '?')) return;
            var $btn = $(this).prop('disabled', true);
            $.ajax({ url: '/Dashboard/UndoSuspiciousInterviewer', type: 'POST', data: { UserId: userId }, dataType: 'json' })
                .done(function (res) {
                    var msg = (typeof res === 'string') ? res : (res && res.message) || 'Undo complete.';
                    var ok = typeof res === 'string' ? msg.toLowerCase().indexOf('success') >= 0 : !!(res && res.ok);
                    showToast(msg, ok);
                    if (ok) setTimeout(loadPage, 600);
                    else $btn.prop('disabled', false);
                })
                .fail(function () { showToast('Undo suspicious failed.', false); $btn.prop('disabled', false); });
        });

        // DataTables-compatible server-side list (custom pager UI; same endpoint contract).
        if (typeof $ === 'undefined') {
            console.error('TrialFlagReview: jQuery not loaded — grid cannot fetch.');
            var el = document.getElementById('tfrTbody');
            if (el) el.innerHTML = '<tr><td colspan="10" class="tfr-empty" style="color:#b91c1c;">jQuery failed to load; cannot load trial flags.</td></tr>';
        } else {
            $(function () { loadPage(); });
        }
    })();
</script>
@await Html.PartialAsync("~/Views/Interviewer/_SuspiciousInterviewer.cshtml")
@await Html.PartialAsync("~/Views/Common/_InterviewerInsights.cshtml")
<script>
    // After shared partial: toast + reload instead of alert() on this page only
    (function () {
        if (typeof window.SaveSuspiciousInterViewer !== 'function') return;
        var showToast = function (message, ok) {
            var $t = $('#tfrToast');
            if (!$t.length) { alert(message); return; }
            $t.removeClass('tfr-toast--ok tfr-toast--err').addClass(ok ? 'tfr-toast--ok' : 'tfr-toast--err').text(message).addClass('is-show');
            setTimeout(function () { $t.removeClass('is-show'); }, 6000);
        };
        window.SaveSuspiciousInterViewer = function () {
            var comment = ($('#Comment').val() || '').trim();
            var emailId = $('#hdnInterviewerEmail').val();
            if (!comment) {
                showToast('Please enter a comment.', false);
                return;
            }
            $.ajax({
                url: '/Interviewer/AddSuspiciousTypeComment',
                data: { Email: emailId, Comment: comment },
                type: 'POST'
            }).done(function (data) {
                var msg = (typeof data === 'string') ? data : (data && data.message) || 'Saved.';
                var ok = msg.toLowerCase().indexOf('success') >= 0;
                showToast(msg, ok);
                if (typeof closeSuspiciousTypeModal === 'function') closeSuspiciousTypeModal();
                if (ok) setTimeout(function () { location.reload(); }, 900);
            }).fail(function () {
                showToast('Failed to mark suspicious.', false);
            });
        };
    })();
</script>
