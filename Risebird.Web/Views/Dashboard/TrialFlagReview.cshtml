                + '<td class="tfr-col-interview"><div class="tfr-cell-stack">'
                + '<a href="/Interview/ClientReport?interviewId=' + interviewId + '&irfId=' + irfId + '" target="_blank" rel="noopener">#' + interviewId + '</a>'
                + '<div class="tfr-cell-stack__secondary">' + esc(formatIst(row.triggeringInterviewDate || row.TriggeringInterviewDate)) + '</div>'
                + '<div class="tfr-cell-stack__meta">Flagged ' + esc(formatIst(row.flaggedAtUtc || row.FlaggedAtUtc)) + '</div>'
                + '<button type="button" class="tfr-detail-toggle btn-tfr-details" data-flag-id="' + flagId + '">Details</button>'
                + '</div></td>'
                + '<td class="tfr-col-priority">' + clientPriorityHtml(row) + '</td>'
