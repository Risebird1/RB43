    .tfr-qc-metric__value.is-warn { color: #a16207; }
    .tfr-qc-metric__value.is-danger { color: #b91c1c; }
    .tfr-qc-verdict { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; margin: 2px 0 4px; }
    .tfr-qc-verdict.is-redo { background: #fee2e2; color: #991b1b; }
    .tfr-qc-verdict.is-suspicious { background: #ffedd5; color: #9a3412; }
    .tfr-qc-verdict.is-ok { background: #dcfce7; color: #166534; }
    .tfr-flag-badges { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; margin-top: 2px; }
    .tfr-flag-badge {
        display: block;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        padding: 2px 6px;
        border-radius: 4px;
        background: #fef3c7;
        color: #92400e;
        font-size: 10px;
        font-weight: 600;
        white-space: normal;
        word-break: break-word;
        line-height: 1.35;
    }
    .tfr-ai-links a:hover { text-decoration: underline; }
    .tfr-rating-info {
        display: inline-flex; align-items: center; justify-content: center;
        width: 16px; height: 16px; margin-left: 4px; border-radius: 50%;
        border: 1px solid #94a3b8; color: #64748b; font-size: 10px; font-weight: 700;
        cursor: help; vertical-align: middle; background: #f8fafc;
    }
    .tfr-rating-info:hover { border-color: #2563eb; color: #1d4ed8; }
    .tfr-noshow-tag { display: inline-block; margin-left: 2px; padding: 1px 5px; border-radius: 3px; background: #fee2e2; color: #991b1b; font-size: 10px; font-weight: 600; }
    .tfr-filter { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .tfr-filter select { border: 1px solid #cbd5e1; border-radius: 6px; padding: 7px 10px; font-size: 12px; background: #fff; }
    .tfr-th-sort { cursor: pointer; user-select: none; }
    .tfr-th-sort:hover { color: #2563eb; }
    .tfr-th-sort.is-active { color: #2563eb; }
</style>

@functions {
    IHtmlContent FactorCell(bool pass, string detail, string drillUrl, string drillLabel)
    {
        var statusClass = pass ? "is-pass" : "is-fail";
        var statusText = pass ? "Pass" : "Fail";
        var html = $@"<div class=""tfr-factor-cell"">
            <div class=""tfr-factor-cell__status {statusClass}"">{statusText}</div>";
        if (!string.IsNullOrWhiteSpace(detail))
            html += $@"<div class=""tfr-factor-cell__detail"">{detail}</div>";
        if (!string.IsNullOrWhiteSpace(drillUrl))
            html += $@"<a class=""tfr-factor-cell__link"" href=""{drillUrl}"" target=""_blank"" rel=""noopener"">{drillLabel}</a>";
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    string ResolveSeverity(TrialFlagReviewRowVm row)
    {
        // Missing severity renders as empty (UI shows '—') and sorts last — never default to P0.
        if (string.IsNullOrWhiteSpace(row.Severity))
            return "";
        return row.Severity.Trim().ToUpperInvariant();
    }

    string SeverityCssClass(string severity)
    {
        var p = (severity ?? "").Trim().ToUpperInvariant();
        return p switch
        {
            "P0" => "tfr-severity--p0",
            "P1" => "tfr-severity--p1",
            "P2" => "tfr-severity--p2",
            "P3" => "tfr-severity--p3",
            "P4" => "tfr-severity--p4",
            "P5" => "tfr-severity--p5",
            _ => "tfr-severity--na"
        };
    }

    IHtmlContent SeverityBadge(TrialFlagReviewRowVm row)
    {
        var sev = ResolveSeverity(row);
        if (string.IsNullOrEmpty(sev))
        {
            return new Microsoft.AspNetCore.Html.HtmlString(
                @"<span class=""tfr-severity tfr-severity--na"" title=""No severity"">—</span>");
        }
        var rankHint = sev switch
        {
            "P0" => "P0 = highest / most severe",
            "P5" => "P5 = clean",
            _ => sev + " (P0 highest … P5 clean)"
        };
        var title = string.IsNullOrWhiteSpace(row.SeverityBreakdown) ? rankHint : rankHint + " · " + row.SeverityBreakdown;
        var html = $@"<span class=""tfr-severity {SeverityCssClass(sev)}"" title=""{System.Net.WebUtility.HtmlEncode(title)}"">{sev}</span>
            <span class=""tfr-sev-hint"">{System.Net.WebUtility.HtmlEncode(rankHint)}</span>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    IHtmlContent SeverityBreakdownPills(TrialFlagReviewRowVm row)
    {
        if (string.IsNullOrWhiteSpace(row.SeverityBreakdown))
            return Microsoft.AspNetCore.Html.HtmlString.Empty;

        var parts = row.SeverityBreakdown.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
            return Microsoft.AspNetCore.Html.HtmlString.Empty;

        var html = @"<div class=""tfr-flag-break"">";
        foreach (var part in parts)
        {
            var bits = part.Split(':');
            var flag = bits.Length > 0 ? bits[0].Trim() : part;
            var p = bits.Length > 1 ? bits[1].Trim().ToUpperInvariant() : "";
            if (string.IsNullOrWhiteSpace(p) || !p.StartsWith("P")) p = "";
            html += $@"<span class=""tfr-flag-pill {SeverityCssClass(p)}"" title=""{System.Net.WebUtility.HtmlEncode(part)} · P0 highest"">{System.Net.WebUtility.HtmlEncode(flag)}"
                + (string.IsNullOrEmpty(p) ? "" : " " + System.Net.WebUtility.HtmlEncode(p))
                + "</span>";
        }
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    string ResolveVerdict(TrialFlagReviewRowVm row)
    {
        var verdict = row.EffectiveVerdict;
        var sev = ResolveSeverity(row);
        // Invariant: P0–P3 never displays Good Trial (only when severity is present)
        if (!string.IsNullOrWhiteSpace(sev)
            && sev.Length >= 2
            && sev.StartsWith("P", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(sev.Substring(1), out var n)
            && n >= 0 && n <= 3)
        {
            return TrialFlagConstants.VerdictBadTrial;
        }
        return string.IsNullOrWhiteSpace(verdict) ? TrialFlagConstants.VerdictBadTrial : verdict;
    }

    string NoShowSpecificLabel(string reasonOrBreakdown)
    {
        var text = (reasonOrBreakdown ?? "").ToLowerInvariant();
        if (text.Contains("interviewer no show")) return "Interviewer No Show";
        if (text.Contains("candidate no show")) return "Candidate No Show";
        if (text.Contains("no show")) return "No Show";
        return null;
    }

    IHtmlContent RiskCategoryBadges(TrialFlagReviewRowVm row)
    {
        if (string.IsNullOrWhiteSpace(row.RiskCategoryLabels))
            return new Microsoft.AspNetCore.Html.HtmlString(@"<span style=""color:#94a3b8;font-size:12px;"">—</span>");

        var labels = row.RiskCategoryLabels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var reasons = (row.RiskCategoryReasons ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var html = @"<div class=""tfr-risk-badges"">";
        for (var i = 0; i < labels.Length; i++)
        {
            var label = labels[i].Trim();
            var reason = i < reasons.Length ? reasons[i].Trim() : label;
            var badgeClass = label switch
            {
                "High Severity" => "tfr-risk-badge--high",
                "Under Review" => "tfr-risk-badge--review",
                "Redo Requested" => "tfr-risk-badge--redo",
                "Fake Report" => "tfr-risk-badge--fake",
                _ => "tfr-risk-badge--default"
            };
            var display = label;
            if (string.Equals(label, "Fake Report", StringComparison.OrdinalIgnoreCase))
            {
                var specific = NoShowSpecificLabel(reason) ?? NoShowSpecificLabel(row.SeverityBreakdown);
                if (!string.IsNullOrWhiteSpace(specific))
                    display = specific;
            }
            var tip = System.Net.WebUtility.HtmlEncode(reason);
            html += $@"<span class=""tfr-risk-badge {badgeClass}"" title=""{tip}"">{System.Net.WebUtility.HtmlEncode(display)}</span>";
        }
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    IHtmlContent QcMergeCell(TrialFlagReviewRowVm row)
    {
        // Red flags = MergedAIQCDetails flags[] only (evidence-filtered). Payment amount/recommendation â†’ tooltip.
        var mergeFlags = TrialFlagEvidenceBadgeHelper.CollectMergeFlagBadges(row.QcMergeFlagsJson);

        var totalPenalty = row.QcMergeTotalPenalty ?? row.QcMergeScore;
        var qcScore = row.QcMergeQcScore;
        var hasVerdict = !string.IsNullOrWhiteSpace(row.QcMergeVerdict);
        var hasPenalty = totalPenalty.HasValue;
        var hasQcScore = qcScore.HasValue;
        var hasFlags = mergeFlags.Count > 0;
        if (!hasVerdict && !hasPenalty && !hasQcScore && !hasFlags && row.PaymentDeduction <= 0
            && string.IsNullOrWhiteSpace(row.PaymentRecommendation)
            && string.IsNullOrWhiteSpace(row.PaymentRecommendationComments))
            return new Microsoft.AspNetCore.Html.HtmlString(@"<span style=""color:#94a3b8;"">—</span>");

        var tipParts = new List<string>();
        if (row.PaymentDeduction > 0)
            tipParts.Add("Payment deduction: " + row.PaymentDeduction + "%");
        if (!string.IsNullOrWhiteSpace(row.PaymentRecommendation))
            tipParts.Add("Recommendation: " + row.PaymentRecommendation);
        if (!string.IsNullOrWhiteSpace(row.PaymentRecommendationComments))
            tipParts.Add(row.PaymentRecommendationComments);
        foreach (var payFlag in TrialFlagEvidenceBadgeHelper.CollectPaymentReasonBadgesFromJson(row.PaymentReasonValuesJson))
            tipParts.Add(payFlag);
        var tip = tipParts.Count > 0 ? System.Net.WebUtility.HtmlEncode(string.Join(" — ", tipParts)) : "";

        var tipAttr = string.IsNullOrEmpty(tip) ? string.Empty : (" title=\"" + tip + "\"");
        var html = "<div class=\"tfr-qc-cell\"" + tipAttr + ">";

        //Compact label + value (same thresholds as QCMergedAIDetails, no chips)
        if (hasPenalty || hasQcScore)
        {
            html += "<div class=\"tfr-qc-metrics\">";
            if (hasPenalty)
            {
                var pTone = totalPenalty.Value >= 10 ? "is-danger"
                    : totalPenalty.Value >= 5 ? "is-warn"
                    : "is-ok";
                html += "<div class=\"tfr-qc-metric\">"
                    + "<span class=\"tfr-qc-metric__label\">Total penalty :</span>"
                    + "<span class=\"tfr-qc-metric__value " + pTone + "\">" + totalPenalty.Value + "</span>"
                    + "</div>";
            }
            if (hasQcScore)
            {
                var sTone = qcScore.Value >= 8 ? "is-ok"
                    : qcScore.Value >= 5 ? "is-warn"
                    : "is-danger";
                html += "<div class=\"tfr-qc-metric\">"
                    + "<span class=\"tfr-qc-metric__label\">QC score :</span>"
                    + "<span class=\"tfr-qc-metric__value " + sTone + "\">" + qcScore.Value + "</span>"
                    + "</div>";
            }
            html += "</div>";
        }

        if (hasVerdict)
        {
            var v = row.QcMergeVerdict.Trim();
            var css = v.Equals("redo", StringComparison.OrdinalIgnoreCase) ? "is-redo"
                : v.Equals("suspicious", StringComparison.OrdinalIgnoreCase) ? "is-suspicious"
                : "is-ok";
            var label = char.ToUpperInvariant(v[0]) + v.Substring(1).ToLowerInvariant();
            html += "<div><span class=\"tfr-qc-verdict " + css + "\">" + System.Net.WebUtility.HtmlEncode(label) + "</span></div>";
        }

        if (hasFlags)
        {
            html += "<div class=\"tfr-flag-badges\">";
            foreach (var badge in mergeFlags)
                html += "<span class=\"tfr-flag-badge\" title=\"" + System.Net.WebUtility.HtmlEncode(badge) + "\">"
                    + System.Net.WebUtility.HtmlEncode(badge) + "</span>";
            html += "</div>";
        }

        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    IHtmlContent AiLinksCell(TrialFlagReviewRowVm row)
    {
        var id = row.TriggeringInterviewId;
        if (id <= 0)
            return new Microsoft.AspNetCore.Html.HtmlString(@"<span style=""color:#94a3b8;"">—</span>");

        var t = TrialFlagDrillDownUrls.TranscriptQuality(id, row.IrfId);
        var r = TrialFlagDrillDownUrls.ReportAiVerdict(id);
        var c = TrialFlagDrillDownUrls.ContradictionReport(id);
        var q = TrialFlagDrillDownUrls.QcMergedAiDetails(id);
        return new Microsoft.AspNetCore.Html.HtmlString(
            $@"<div class=""tfr-ai-links"">
                <a href=""{t}"" target=""_blank"" rel=""noopener"">Transcript</a>
                <a href=""{r}"" target=""_blank"" rel=""noopener"">Report</a>
                <a href=""{c}"" target=""_blank"" rel=""noopener"">Contradiction</a>
                <a href=""{q}"" target=""_blank"" rel=""noopener"">QC Merge</a>
            </div>");
    }

    IHtmlContent RatingCell(TrialFlagReviewRowVm row, string ratingDetail, string drillUrl)
    {
        var tip = TrialFlagEvidenceBadgeHelper.IsPositiveEvidence(row.CandidateFeedbackComment)
            ? System.Net.WebUtility.HtmlEncode(row.CandidateFeedbackComment.Trim())
            : "";
        var info = string.IsNullOrEmpty(tip)
            ? ""
            : $@" <span class=""tfr-rating-info"" title=""{tip}"" aria-label=""Candidate feedback comment"">ⓘ</span>";

        var statusClass = row.CandidateRatingPass ? "is-pass" : "is-fail";
        var statusText = row.CandidateRatingPass ? "Pass" : "Fail";
        var html = $@"<div class=""tfr-factor-cell"">
            <div class=""tfr-factor-cell__status {statusClass}"">{statusText}</div>";
        if (!string.IsNullOrWhiteSpace(ratingDetail))
            html += $@"<div class=""tfr-factor-cell__detail"">{ratingDetail}{info}</div>";
        else if (!string.IsNullOrEmpty(info))
            html += $@"<div class=""tfr-factor-cell__detail"">{info}</div>";
        if (!string.IsNullOrWhiteSpace(drillUrl))
            html += $@"<a class=""tfr-factor-cell__link"" href=""{drillUrl}"" target=""_blank"" rel=""noopener"">Rating</a>";
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
<div class="main-panel tfr-page" id="main-panel">
    <div class="tfr-header">
        <button type="button" class="tfr-btn" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'">Back</button>
        <h2 style="margin-top:12px;">Trial Flag Review</h2>
        <div class="tfr-header__row">
            <p>First-interview trial outcomes per interviewer–IRF pair. Light list loads instantly; expand a row for QC merge, factors, and payment detail.</p>
            <div class="tfr-filter">
                <label for="tfrSeverityFilter" style="font-size:11px;color:#64748b;white-space:nowrap;" title="P0 = highest severity … P5 = clean">Severity</label>
                <select id="tfrSeverityFilter" aria-label="Filter by severity (P0 highest … P5 clean)">
                    <option value="">All</option>
                    <option value="P0">P0 (highest)</option>
                    <option value="P1">P1</option>
                    <option value="P2">P2</option>
                    <option value="P3">P3</option>
                    <option value="P4">P4</option>
                    <option value="P5">P5 (clean)</option>
                </select>
            </div>
            
            <div class="tfr-filter">
                <label for="tfrOwnerFilter" style="font-size:11px;color:#64748b;white-space:nowrap;">Channel owner</label>
                <select id="tfrOwnerFilter" aria-label="Filter by channel owner">
                    <option value="">All owners</option>
                </select>
            </div><div class="tfr-search">
                <div class="tfr-search__box">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                    <input type="search" id="tfrSearch" class="tfr-search__input" placeholder="Search IRF, interviewer, owner…" autocomplete="off" />
                </div>
                <button type="button" class="tfr-btn" id="tfrSearchClear" style="display:none;">Clear</button>
            </div>
        </div>
    </div>

    <div class="tfr-tabs">
        <a class="tfr-tab @(activeTab == TrialFlagConstants.ReviewPending ? "is-active" : "")" href="@Url.Action("TrialFlagReview", new { tab = TrialFlagConstants.ReviewPending })" data-tab="@TrialFlagConstants.ReviewPending">Pending<span class="tfr-tab__count" id="tfrCountPending">(@Model.PendingCount)</span></a>
        <a class="tfr-tab @(activeTab == TrialFlagConstants.ReviewKept ? "is-active" : "")" href="@Url.Action("TrialFlagReview", new { tab = TrialFlagConstants.ReviewKept })" data-tab="@TrialFlagConstants.ReviewKept">Kept<span class="tfr-tab__count" id="tfrCountKept">(@Model.KeptCount)</span></a>
        <a class="tfr-tab @(activeTab == TrialFlagConstants.ReviewRemoved ? "is-active" : "")" href="@Url.Action("TrialFlagReview", new { tab = TrialFlagConstants.ReviewRemoved })" data-tab="@TrialFlagConstants.ReviewRemoved">Removed<span class="tfr-tab__count" id="tfrCountRemoved">(@Model.RemovedCount)</span></a>
        <button type="button" class="tfr-btn" style="margin-left:auto;" id="btnTfrReload" title="Reload current page">Reload</button>
    </div>

    @if (isPendingTab && Model.TrialFlagsTableExists && string.IsNullOrWhiteSpace(loadError))
    {
        <div class="tfr-backfill-bar">
            <button type="button" class="tfr-btn tfr-btn--primary" id="btnTfrBackfill">Backfill trial flags from completed QC merges</button>
            <span id="tfrBackfillStatus"></span>
            <span class="tfr-backfill-bar__hint">
                Loads historical first-interview QC merges into this queue (up to 25 inserts per click). @if (Model.TotalRowsInTable > 0) { <text>Click again to backfill more.</text> }
            </span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="tfr-alert tfr-alert--error"><strong>Could not load trial flag shell.</strong> @loadError</div>
    }
    else if (!Model.TrialFlagsTableExists)
    {
        <div class="tfr-alert tfr-alert--info"><strong>No trial flags to show.</strong> @(Model.EmptyStateHint ?? "dbo.TrialFlags missing.")</div>
    }

    <div class="tfr-owner-strip" id="tfrOwnerStrip" aria-live="polite">
        <span class="tfr-owner-strip__label">P0s by owner (active tab)</span>
        <span id="tfrOwnerStripBody" style="color:#94a3b8;">Loading...</span>
    </div>
    <div class="tfr-table-wrap">
        <table class="tfr-table" id="tfrTable" style="width:100%;">
            <thead>
                <tr>
                    @if (isPendingTab) { <th class="tfr-col-actions">Actions</th> }
                    <th class="tfr-col-interviewer">Interviewer</th>
                    <th class="tfr-col-irf">IRF</th>
                    <th class="tfr-col-owner">Channel owner</th>
                    <th class="tfr-col-interview">Trial interview</th>
                    <th class="tfr-col-priority" title="Mapped from severity P0-P5">Client priority</th>
                    <th class="tfr-col-verdict">Verdict</th>
                    <th class="tfr-col-qc">QC Merge</th>
                    <th class="tfr-col-ai">AI links</th>
                    <th class="tfr-col-risk">Risk categories</th>
                    @if (!isPendingTab) { <th class="tfr-col-reviewed">Reviewed</th> }
                </tr>
            </thead>
            <tbody id="tfrTbody">
                <tr class="tfr-loading-row"><td colspan="10" class="tfr-empty">Loading…</td></tr>
            </tbody>
        </table>
        <div id="tfrSearchEmpty" class="tfr-search-empty">No rows match.</div>
        <div id="tfrPagination" class="tfr-pagination is-visible" aria-label="Trial flag pagination">
            <span id="tfrPageInfo"></span>
            <div class="tfr-pagination__btns" id="tfrPageBtns"></div>
        </div>
    </div>
</div>

<div id="tfrActionModal" aria-hidden="true">
    <div class="tfr-modal-card">
        <div class="tfr-modal-card__head">
            <h3 id="tfrModalTitle" style="margin:0;font-size:18px;">Confirm action</h3>
            <div id="tfrModalSub" style="margin-top:6px;font-size:12px;color:#64748b;"></div>
