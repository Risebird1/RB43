        function factorLine(pass, label, detail, href) {
            var status = pass ? '<span class="tfr-factor-cell__status is-pass">Pass</span>' : '<span class="tfr-factor-cell__status is-fail">Fail</span>';
            var d = detail ? '<div class="tfr-factor-cell__detail">' + esc(detail) + '</div>' : '';
            var a = href ? '<a class="tfr-factor-cell__link" href="' + href + '" target="_blank" rel="noopener">' + esc(label) + '</a>' : '';
            return '<div class="tfr-factor-cell" style="margin-bottom:8px;"><div style="font-size:11px;color:#64748b;">' + esc(label) + '</div>' + status + d + a + '</div>';
        }

        function renderDetailPanel(detail, interviewId, irfId) {
            var d = detail || {};
            var html = '';
            html += '<div style="font-size:12px;font-weight:700;color:#0f172a;margin-bottom:6px;">AI Evaluations</div>';
            html += '<div class="tfr-ai-body" data-interview-id="' + interviewId + '" data-irf-id="' + irfId + '">Loading…</div>';

            var breakdown = d.severityBreakdown || d.SeverityBreakdown;
            var sevDetail = d.severity || d.Severity || '';
            if (sevDetail) {
                html += '<div style="margin-top:8px;font-size:12px;"><strong>Client priority:</strong> ' + clientPriorityHtml(d) + '</div>';
            }
            if (breakdown) {
                html += '<div style="margin-top:10px;font-size:12px;font-weight:700;">Severity breakdown</div><div class="tfr-candidate-comment">' + esc(breakdown) + '</div>';
            }

            html += '<div style="margin-top:12px;font-size:12px;font-weight:700;">Raw metrics</div>';
            html += '<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:12px;">';
            var tScore = d.transcriptQualityScore != null ? d.transcriptQualityScore : d.TranscriptQualityScore;
            var rScore = d.reportQualityScore != null ? d.reportQualityScore : d.ReportQualityScore;
            var rating = d.candidateRating != null ? d.candidateRating : d.CandidateRating;
            var join = d.joinTimeMinutes != null ? d.joinTimeMinutes : d.JoinTimeMinutes;
            var dur = d.interviewDurationMinutes != null ? d.interviewDurationMinutes : d.InterviewDurationMinutes;
            html += factorLine(!!(d.transcriptQualityPass || d.TranscriptQualityPass), 'Transcript score', tScore != null ? (tScore + '/10') : null, '/AIScreener/TransciptAnalysis?interviewId=' + interviewId + '&irfId=' + irfId);
            html += factorLine(!!(d.reportQualityPass || d.ReportQualityPass), 'Report score', rScore != null ? (rScore + '/100') : null, '/Interview/ReportAIDetailsReport?interviewId=' + interviewId);
            var ratingDetail = rating != null ? (rating + '/5') : null;
            var fb = d.candidateFeedbackComment || d.CandidateFeedbackComment;
            var ratingHtml = factorLine(!!(d.candidateRatingPass || d.CandidateRatingPass), 'Candidate rating', ratingDetail, '/Interview/PaymentSlaDetails?interviewId=' + interviewId + '&returnBack=0&actionstatus=SLACompleted');
            if (fb) {
                ratingHtml = ratingHtml.replace('</div></div>', ' <span class="tfr-rating-info" title="' + esc(fb) + '" aria-label="Candidate feedback comment">\u24D8</span></div></div>');
            }
            html += ratingHtml;
            html += factorLine(!!(d.joinTimePass || d.JoinTimePass), 'Join time', join != null ? (join + ' min') : null, null);
            html += factorLine(!!(d.interviewDurationPass || d.InterviewDurationPass), 'Duration', dur != null ? (dur + ' min') : null, null);
            html += '</div>';

            html += '<div style="margin-top:12px;font-size:12px;font-weight:700;">QC Merge</div>';
            var v = d.qcMergeVerdict || d.QcMergeVerdict;
            var pen = d.qcMergeTotalPenalty != null ? d.qcMergeTotalPenalty : d.QcMergeTotalPenalty;
            var qc = d.qcMergeQcScore != null ? d.qcMergeQcScore : d.QcMergeQcScore;
            html += '<div class="tfr-candidate-comment">';
            html += v ? ('<div><strong>Verdict:</strong> ' + esc(v) + '</div>') : '';
            html += pen != null ? ('<div><strong>Total penalty:</strong> ' + esc(pen) + '</div>') : '';
            html += qc != null ? ('<div><strong>QC score:</strong> ' + esc(qc) + '</div>') : '';
            if (!v && pen == null && qc == null) html += '—';
            html += '</div>';

            /* metrics already rendered above — skip legacy duplicate block */

            if (fb) {
                html += '<div style="margin-top:10px;font-size:12px;font-weight:700;">Candidate feedback</div><div class="tfr-candidate-comment">' + esc(fb) + '</div>';
            }

            var pay = d.paymentDeduction != null ? d.paymentDeduction : d.PaymentDeduction;
            var rec = d.paymentRecommendation || d.PaymentRecommendation;
            var recC = d.paymentRecommendationComments || d.PaymentRecommendationComments;
            if ((pay && pay > 0) || rec || recC) {
                html += '<div style="margin-top:10px;font-size:12px;font-weight:700;">Payment</div><div class="tfr-candidate-comment">';
                if (pay > 0) html += '<div><strong>Deduction:</strong> ' + esc(pay) + '%</div>';
                if (rec) html += '<div><strong>' + esc(rec) + '</strong></div>';
                if (recC) html += '<div>' + esc(recC) + '</div>';
                html += '</div>';
            }
            return html;
        }

        function severityCssAi(p) {
            var s = (p || '').toString().toUpperCase();
            if (/^P[0-5]$/.test(s)) return 'tfr-severity tfr-severity--' + s.toLowerCase();
            return 'tfr-severity tfr-severity--na';
        }
        function aiLink(sourceName, interviewId, irfId) {
            var id = encodeURIComponent(interviewId);
            var irf = encodeURIComponent(irfId || '');
            if (sourceName === 'Transcript AI')
                return '/AIScreener/TransciptAnalysis?interviewId=' + id + '&irfId=' + irf;
            if (sourceName === 'Report AI' || sourceName === 'Report AI Score')
                return '/Interview/ReportAIDetailsReport?interviewId=' + id;
            if (sourceName === 'Contradiction AI Score' || sourceName === 'Contradiction')
                return '/Interview/ContradictionReport?interviewId=' + id;
            return '/Interview/QCMergedAIDetails?interviewId=' + id;
        }
        function renderAiTable(rows, interviewId, irfId) {
            var html = '<table class="tfr-ai-table"><thead><tr><th>Source</th><th>Score / value</th><th>Status</th><th>Report</th></tr></thead><tbody>';
            (rows || []).forEach(function (r) {
                var score = (r.rawScore != null && r.rawScore !== '') ? r.rawScore : ((r.RawScore != null && r.RawScore !== '') ? r.RawScore : null);
                var triggered = !!(r.triggered != null ? r.triggered : r.Triggered);
                var pLevel = (r.pLevel || r.PLevel || '').toString().toUpperCase();
                var name = r.sourceName || r.SourceName || '—';
                var numericish = score != null && score !== '' && !isNaN(Number(score));
                var notScored = score == null || score === '' || (numericish && Number(score) === 0);
                var scoreHtml = notScored ? '<span class="tfr-ai-na">Not scored</span>' : esc(score);
                if (notScored && numericish) { triggered = false; pLevel = ''; }
                var statusHtml = triggered && pLevel
                    ? '<span class="' + severityCssAi(pLevel) + '">' + esc(pLevel) + '</span>'
                    : '<span class="tfr-ai-ok">OK</span>';
                html += '<tr><td>' + esc(name) + '</td><td>' + scoreHtml + '</td><td>' + statusHtml
                    + '</td><td><a href="' + aiLink(name, interviewId, irfId) + '" target="_blank" rel="noopener">Open</a></td></tr>';
            });
            return html + '</tbody></table>';
        }
        function loadAiSummary($body) {
            if ($body.data('loaded') || $body.data('loading')) return;
            $body.data('loading', true);
            var interviewId = parseInt($body.data('interview-id'), 10);
            var irfId = parseInt($body.data('irf-id'), 10) || 0;
            $.getJSON(aiSummaryUrl, { interviewId: interviewId, irfId: irfId }).done(function (res) {
                $body.data('loaded', true).data('loading', false);
                if (!res || !res.ok) { $body.html('<span style="color:#b91c1c;">' + esc((res && res.message) || 'Failed') + '</span>'); return; }
                $body.html(renderAiTable(res.rows || [], interviewId, irfId));
            }).fail(function () {
                $body.data('loading', false).html('<span style="color:#b91c1c;">Failed to load AI summary.</span>');
            });
        }


        function renderOwnerStrip(summaries) {
            ownerSummaries = summaries || [];
            var $sel = $('#tfrOwnerFilter');
            var cur = channelOwnerFilter;
            var opts = '<option value="">All owners</option>';
            ownerSummaries.forEach(function (o) {
                var email = o.channelOwnerEmail || o.ChannelOwnerEmail || '';
                var label = o.channelOwner || o.ChannelOwner || email || '(unassigned)';
                var p0 = o.p0Count != null ? o.p0Count : (o.P0Count || 0);
                var tot = o.totalCount != null ? o.totalCount : (o.TotalCount || 0);
                opts += '<option value="' + esc(email) + '"' + (email === cur ? ' selected' : '') + '>' + esc(label) + ' (' + p0 + ' P0 / ' + tot + ')</option>';
            });
            $sel.html(opts);
            var list = ownerSummaries.slice();
            if (cur) list = list.filter(function (o) { return (o.channelOwnerEmail || o.ChannelOwnerEmail || '') === cur; });
            if (!list.length) {
                $('#tfrOwnerStripBody').html('<span style="color:#94a3b8;">No owners on this tab.</span>');
                return;
            }
            var body = '';
            if (cur) {
                body += '<button type="button" class="tfr-btn" id="tfrOwnerClear" style="margin:0;font-size:11px;">Clear owner filter</button>';
            }
            list.forEach(function (o) {
                var email = o.channelOwnerEmail || o.ChannelOwnerEmail || '';
                var label = o.channelOwner || o.ChannelOwner || email || '(unassigned)';
                var p0 = o.p0Count != null ? o.p0Count : (o.P0Count || 0);
                var tot = o.totalCount != null ? o.totalCount : (o.TotalCount || 0);
                var active = email === cur ? ' is-active' : '';
                body += '<button type="button" class="tfr-owner-chip' + active + '" data-owner="' + esc(email) + '" title="Filter to this owner">'
                    + esc(label) + ' : <span class="tfr-owner-chip__p0">' + p0 + ' P0</span> · ' + tot + ' total</button>';
            });
            $('#tfrOwnerStripBody').html(body);
