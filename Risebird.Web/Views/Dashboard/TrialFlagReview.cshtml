            <textarea id="tfrModalComment" maxlength="500" placeholder="Add context for this decision..."></textarea>
        </div>
        <div class="tfr-modal-card__foot">
            <button type="button" class="tfr-btn tfr-btn--primary" id="tfrModalConfirm">Confirm</button>
            <button type="button" class="tfr-btn" id="tfrModalCancel">Cancel</button>
        </div>
    </div>
</div>

<div id="tfrToast" role="status"></div>

<script>
    (function () {
        var keepUrl = '@Url.Action("KeepTrialFlagReviewer", "Dashboard")';
        var removeUrl = '@Url.Action("RemoveTrialFlagReviewer", "Dashboard")';
        var backfillUrl = '@Url.Action("BackfillTrialFlags", "Dashboard")';
        var aiSummaryUrl = '@Url.Action("InterviewAiRiskSummary", "Dashboard")';
        var listUrl = '@Url.Action("TrialFlagReviewList", "Dashboard")';
        var detailUrl = '@Url.Action("TrialFlagReviewDetail", "Dashboard")';
        var activeTab = '@activeTab';
        var isPendingTab = @(isPendingTab ? "true" : "false");
        // Mirrors TrialFlagClientPriority (ASCII-only; keep in sync with C# helper).
        var CLIENT_PRIORITY_MAP = {
            'P0': { Tier: 'Critical', Css: 'critical', Badge: 'Critical · P0' },
            'P1': { Tier: 'Critical', Css: 'critical', Badge: 'Critical · P1' },
            'P2': { Tier: 'Medium', Css: 'medium', Badge: 'Medium · P2' },
            'P3': { Tier: 'Medium', Css: 'medium', Badge: 'Medium · P3' },
            'P4': { Tier: 'Low', Css: 'low', Badge: 'Low · P4' },
            'P5': { Tier: 'Clear', Css: 'clear', Badge: 'Clear · P5' },
            '': { Tier: 'Low', Css: 'low', Badge: 'Low' }
        };
        var PAGE_SIZE = 25;
        var currentPage = 1;
        var searchTerm = '';
        var severityFilter = '';
        var channelOwnerFilter = '';
        var ownerSummaries = [];
        var drawSeq = 0;
        var totalFiltered = 0;
        var detailCache = {};
        var detailInflight = {};
        var $tbody = $('#tfrTbody');

        function esc(s) {
            return $('<div/>').text(s == null ? '' : String(s)).html();
        }
        function formatIst(utc) {
            if (!utc) return '—';
            var d = new Date(utc);
            if (isNaN(d.getTime())) return '—';
            var ist = new Date(d.getTime() + 5.5 * 60 * 60 * 1000);
            function p(n) { return n < 10 ? '0' + n : '' + n; }
            return ist.getUTCFullYear() + '-' + p(ist.getUTCMonth() + 1) + '-' + p(ist.getUTCDate())
                + ' ' + p(ist.getUTCHours()) + ':' + p(ist.getUTCMinutes()) + ' IST';
        }
        function verdictLabel(v) {
            if ((v || '').toLowerCase() === 'good_trial') return 'Good trial';
            if ((v || '').toLowerCase() === 'bad_trial') return 'Bad trial';
            return v || '—';
        }
        function severityCss(p) {
            var s = (p || '').toString().toUpperCase();
            if (/^P[0-5]$/.test(s)) return 'tfr-severity tfr-severity--' + s.toLowerCase();
            return 'tfr-severity tfr-severity--na';
        }
        function telHref(mobile) {
            if (!mobile) return null;
            var digits = String(mobile).replace(/\D/g, '');
            if (!digits || digits === '0') return null;
            if (digits.length > 10) digits = digits.slice(-10);
            if (digits.length !== 10) return null;
            return 'tel:+91' + digits;
        }
        function displayPhone(mobile) {
