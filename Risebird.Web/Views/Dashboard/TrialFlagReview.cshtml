        /** Channel owner: name on first line, email on next (never "Name (email)" inline). */
        function channelOwnerHtml(row) {
            var display = (row.channelOwner || row.ChannelOwner || '').toString().trim();
            var email = (row.channelOwnerEmail || row.ChannelOwnerEmail || '').toString().trim();
            var name = display;
            // Razor: @@ → @ in the emitted JS regex
            var m = display.match(/^(.*?)\s*\(([^()\s@@]+@@[^()\s]+)\)\s*$/);
            if (m) {
                name = (m[1] || '').trim();
                if (!email) email = (m[2] || '').trim();
            }
            if (!name && email) name = email;
            if (!name) return '<td class="tfr-col-owner"><span class="tfr-cell-stack__meta">—</span></td>';
            var html = '<td class="tfr-col-owner"><div class="tfr-cell-stack">';
            if (email && name.toLowerCase() !== email.toLowerCase()) {
                html += '<div class="tfr-cell-stack__primary">' + esc(name) + '</div>';
                html += '<div class="tfr-cell-stack__secondary">' + esc(email) + '</div>';
            } else {
                html += '<div class="tfr-cell-stack__primary">' + esc(name) + '</div>';
            }
            html += '</div></td>';
            return html;
        }

