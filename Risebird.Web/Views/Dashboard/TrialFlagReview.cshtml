                else if (label === 'Under Review') badgeClass = 'tfr-risk-badge--review';
                else if (label === 'Redo Requested') badgeClass = 'tfr-risk-badge--redo';
                else if (label === 'Fake Report') badgeClass = 'tfr-risk-badge--fake';
