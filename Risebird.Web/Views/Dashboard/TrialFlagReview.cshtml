                badge = rowOrSev.clientPriorityBadge || rowOrSev.ClientPriorityBadge;
                mod = rowOrSev.clientPriorityCss || rowOrSev.ClientPriorityCss;
                sev = (rowOrSev.severity || rowOrSev.Severity || '').toString().toUpperCase();
            } else {
                sev = (rowOrSev || '').toString().toUpperCase();
