</style>

@functions {
    IHtmlContent FactorCell(bool pass, string detail, string drillUrl, string drillLabel)
    {
        var statusClass = pass ? "is-pass" : "is-fail";
        var statusText = pass ? "Pass" : "Fail";
        var html = $@"<div class=""tfr-factor-cell"">
            <div class=""tfr-factor-cell__status {statusClass}"">{statusText}</div>";
        if (!string.IsNullOrWhiteSpace(detail))
            html += $@"<div class=""tfr-factor-cell__detail"">{detail}</div>";
        if (!string.IsNullOrWhiteSpace(drillUrl))
            html += $@"<a class=""tfr-factor-cell__link"" href=""{drillUrl}"" target=""_blank"" rel=""noopener"">{drillLabel}</a>";
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    string ResolveSeverity(TrialFlagReviewRowVm row)
    {
        if (!string.IsNullOrWhiteSpace(row.Severity))
            return row.Severity.Trim().ToUpperInvariant();
        if (string.Equals(row.OverallVerdict, TrialFlagConstants.VerdictGoodTrial, StringComparison.OrdinalIgnoreCase))
            return TrialFlagConstants.SeverityClean;
        return TrialFlagConstants.SeverityP4;
    }

    string SeverityCssClass(string severity)
    {
        var p = (severity ?? "").Trim().ToUpperInvariant();
        return p switch
        {
            "P0" => "tfr-severity--p0",
            "P1" => "tfr-severity--p1",
            "P2" => "tfr-severity--p2",
            "P3" => "tfr-severity--p3",
            "P4" => "tfr-severity--p4",
            "P5" => "tfr-severity--p5",
            _ => "tfr-severity--na"
        };
    }

    IHtmlContent SeverityBadge(TrialFlagReviewRowVm row)
    {
        var sev = ResolveSeverity(row);
        var rankHint = sev switch
        {
            "P0" => "P0 = highest / most severe",
            "P5" => "P5 = clean",
            _ => sev + " (P0 highest … P5 clean)"
        };
        var title = string.IsNullOrWhiteSpace(row.SeverityBreakdown) ? rankHint : rankHint + " · " + row.SeverityBreakdown;
        var html = $@"<span class=""tfr-severity {SeverityCssClass(sev)}"" title=""{System.Net.WebUtility.HtmlEncode(title)}"">{sev}</span>
            <span class=""tfr-sev-hint"">{System.Net.WebUtility.HtmlEncode(rankHint)}</span>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    IHtmlContent SeverityBreakdownPills(TrialFlagReviewRowVm row)
    {
        if (string.IsNullOrWhiteSpace(row.SeverityBreakdown))
            return Microsoft.AspNetCore.Html.HtmlString.Empty;

        var parts = row.SeverityBreakdown.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
            return Microsoft.AspNetCore.Html.HtmlString.Empty;

        var html = @"<div class=""tfr-flag-break"">";
        foreach (var part in parts)
        {
            var bits = part.Split(':');
            var flag = bits.Length > 0 ? bits[0].Trim() : part;
            var p = bits.Length > 1 ? bits[1].Trim().ToUpperInvariant() : "";
            if (string.IsNullOrWhiteSpace(p) || !p.StartsWith("P")) p = "";
            html += $@"<span class=""tfr-flag-pill {SeverityCssClass(p)}"" title=""{System.Net.WebUtility.HtmlEncode(part)} · P0 highest"">{System.Net.WebUtility.HtmlEncode(flag)}"
                + (string.IsNullOrEmpty(p) ? "" : " " + System.Net.WebUtility.HtmlEncode(p))
                + "</span>";
        }
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    IHtmlContent RiskCategoryBadges(TrialFlagReviewRowVm row)
    {
        if (string.IsNullOrWhiteSpace(row.RiskCategoryLabels))
            return new Microsoft.AspNetCore.Html.HtmlString(@"<span style=""color:#94a3b8;font-size:12px;"">—</span>");

        var labels = row.RiskCategoryLabels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var reasons = (row.RiskCategoryReasons ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var html = @"<div class=""tfr-risk-badges"">";
        for (var i = 0; i < labels.Length; i++)
        {
            var label = labels[i].Trim();
            var reason = i < reasons.Length ? reasons[i].Trim() : label;
            var badgeClass = label switch
            {
                "High Severity" => "tfr-risk-badge--high",
                "Under Review" => "tfr-risk-badge--review",
                "Redo Requested" => "tfr-risk-badge--redo",
                "Fake Report" => "tfr-risk-badge--fake",
                _ => "tfr-risk-badge--default"
            };
            var tip = System.Net.WebUtility.HtmlEncode(reason);
            html += $@"<span class=""tfr-risk-badge {badgeClass}"" title=""{tip}"">{System.Net.WebUtility.HtmlEncode(label)}</span>";
        }
        html += "</div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}

<div class="main-panel tfr-page" id="main-panel">
    <div class="tfr-header">
        <button type="button" class="tfr-btn" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'">Back</button>
        <h2 style="margin-top:12px;">Trial Flag Review</h2>
        <div class="tfr-header__row">
            <p>First-interview trial outcomes per interviewer–IRF pair. Review each factor, open drill-downs for context, then keep or remove inline.</p>
            @if (rows.Any())
            {
                <div class="tfr-filter">
                    <label for="tfrSeverityFilter" style="font-size:11px;color:#64748b;white-space:nowrap;" title="P0 = highest severity … P5 = clean">Severity</label>
                    <select id="tfrSeverityFilter" aria-label="Filter by severity (P0 highest … P5 clean)">
                        <option value="">All</option>
                        <option value="P0">P0 (highest)</option>
                        <option value="P1">P1</option>
                        <option value="P2">P2</option>
                        <option value="P3">P3</option>
                        <option value="P4">P4</option>
                        <option value="P5">P5 (clean)</option>
                    </select>
                </div>
                <div class="tfr-search">
                    <div class="tfr-search__box">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                        <input type="search" id="tfrSearch" class="tfr-search__input" placeholder="Search IRF or interviewer..." autocomplete="off" />
                    </div>
                    <button type="button" class="tfr-btn" id="tfrSearchClear" style="display:none;">Clear</button>
                </div>
            }
        </div>
    </div>

    <div class="tfr-tabs">
        <a class="tfr-tab @(activeTab == TrialFlagConstants.ReviewPending ? "is-active" : "")" href="@Url.Action("TrialFlagReview", new { tab = TrialFlagConstants.ReviewPending })">Pending<span class="tfr-tab__count">(@Model.PendingCount)</span></a>
        <a class="tfr-tab @(activeTab == TrialFlagConstants.ReviewKept ? "is-active" : "")" href="@Url.Action("TrialFlagReview", new { tab = TrialFlagConstants.ReviewKept })">Kept<span class="tfr-tab__count">(@Model.KeptCount)</span></a>
        <a class="tfr-tab @(activeTab == TrialFlagConstants.ReviewRemoved ? "is-active" : "")" href="@Url.Action("TrialFlagReview", new { tab = TrialFlagConstants.ReviewRemoved })">Removed<span class="tfr-tab__count">(@Model.RemovedCount)</span></a>
        @if (rows.Any())
        {
            <a class="tfr-btn" style="margin-left:auto;" href="@Url.Action("TrialFlagReview", new { tab = activeTab, refresh = true })" title="Recompute risk categories and trial factors for rows on this tab">Refresh live metrics</a>
        }
    </div>

    @if (Model.LiveMetrics && rows.Any())
    {
        <div class="tfr-alert tfr-alert--info">Showing live risk and factor metrics for this tab. Normal page loads use stored snapshots for speed.</div>
    }

    @if (isPendingTab && Model.TrialFlagsTableExists && string.IsNullOrWhiteSpace(loadError))
    {
        <div class="tfr-backfill-bar">
            <button type="button" class="tfr-btn tfr-btn--primary" id="btnTfrBackfill">Backfill trial flags from completed QC merges</button>
            <span id="tfrBackfillStatus"></span>
            <span class="tfr-backfill-bar__hint">
                Loads historical first-interview QC merges into this queue (up to 25 inserts per click). @if (Model.TotalRowsInTable > 0) { <text>Click again to backfill more.</text> }
            </span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="tfr-alert tfr-alert--error"><strong>Could not load trial flags.</strong> @loadError</div>
    }
    else if (!rows.Any())
    {
        <div class="tfr-alert tfr-alert--info">
            @if (!string.IsNullOrWhiteSpace(Model.EmptyStateHint))
            {
                <strong>No @(activeTab) trial flags to show.</strong> @Model.EmptyStateHint
            }
            else
            {
                <strong>No @(activeTab) trial flags found.</strong>
            }
            @if (Model.TrialFlagsTableExists)
            {
                <div style="margin-top:8px;font-size:12px;color:#64748b;">Database: <code>TrialFlags</code> has @Model.TotalRowsInTable total row(s). Pending @Model.PendingCount · Kept @Model.KeptCount · Removed @Model.RemovedCount.</div>
            }
        </div>
    }

    <div class="tfr-table-wrap">
        <table class="tfr-table">
            <thead>
                <tr>
                    @if (isPendingTab) { <th>Actions</th> }
                    <th>Interviewer</th>
                    <th>IRF</th>
                    <th>Trial interview</th>
                    <th class="tfr-th-sort" id="tfrSortSeverity" title="P0 = highest severity … P5 = clean">Severity</th>
                    <th>Verdict</th>
                    <th>Risk categories</th>
                    <th>Transcript score</th>
                    <th>Report score</th>
                    <th>Candidate rating</th>
                    <th>Join time</th>
                    <th>Duration</th>
                    @if (!isPendingTab) { <th>Reviewed</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    var verdictClass = string.Equals(row.OverallVerdict, TrialFlagConstants.VerdictGoodTrial, StringComparison.OrdinalIgnoreCase)
                        ? "tfr-verdict tfr-verdict--good" : "tfr-verdict tfr-verdict--bad";
                    var searchKey = (row.IrfName + " " + row.InterviewerName + " " + row.InterviewerEmail + " " + row.InterviewerCodedId).ToLowerInvariant();
                    var interviewId = row.TriggeringInterviewId;
                    var transcriptDetail = row.TranscriptQualityScore.HasValue ? row.TranscriptQualityScore.Value.ToString("0.##") + "/10" : null;
                    var reportDetail = row.ReportQualityScore.HasValue ? row.ReportQualityScore.Value.ToString("0.##") + "/100" : null;
                    var ratingDetail = row.CandidateRating.HasValue ? row.CandidateRating.Value.ToString("0.##") + "/5" : null;
                    var joinDetail = row.JoinTimeMinutes.HasValue ? row.JoinTimeMinutes.Value.ToString("0.##") + " min" : null;
                    var durationDetail = row.InterviewDurationMinutes.HasValue ? row.InterviewDurationMinutes.Value.ToString("0.##") + " min" : null;
                    var timingUrl = TrialFlagDrillDownUrls.InterviewTiming(interviewId, row.IrfName);
                    var interviewerDisplayName = !string.IsNullOrWhiteSpace(row.InterviewerName) ? row.InterviewerName : row.InterviewerEmail;
                    var displaySeverity = ResolveSeverity(row);
                    var hasRatingRisk = !string.IsNullOrWhiteSpace(row.SeverityBreakdown)
                        && row.SeverityBreakdown.IndexOf("CandidateRating", StringComparison.OrdinalIgnoreCase) >= 0;
                    var ratingHasComment = hasRatingRisk && !string.IsNullOrWhiteSpace(row.CandidateFeedbackComment);

                    <tr class="tfr-main-row" data-search="@searchKey" data-flag-id="@row.TrialFlagId" data-severity="@displaySeverity" data-interview-id="@interviewId" data-irf-id="@row.IrfId">
                        @if (isPendingTab)
                        {
                            <td class="tfr-actions">
                                <div class="tfr-action-group">
                                    <button type="button" class="tfr-action-btn tfr-action-btn--keep btn-tfr-keep" data-flag-id="@row.TrialFlagId" data-interviewer="@row.InterviewerName" data-irf="@row.IrfName" title="Keep interviewer on this IRF">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                                        <span>Keep</span>
                                    </button>
                                    <button type="button" class="tfr-action-btn tfr-action-btn--remove btn-tfr-remove" data-flag-id="@row.TrialFlagId" data-interviewer="@row.InterviewerName" data-irf="@row.IrfName" title="Remove interviewer from this IRF">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                                        <span>Remove</span>
                                    </button>
                                </div>
                            </td>
                        }
                        <td>
                            <div class="tfr-interviewer__name">@(interviewerDisplayName ?? "—")</div>
                            <div class="tfr-interviewer__coded">
                                <span class="tfr-interviewer__coded-label">Coded</span>
                                @(string.IsNullOrWhiteSpace(row.InterviewerCodedId) ? "—" : row.InterviewerCodedId)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(row.InterviewerEmail) && !string.Equals(row.InterviewerEmail, interviewerDisplayName, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="tfr-interviewer__email">@row.InterviewerEmail</div>
                            }
                        </td>
                        <td><strong>@row.IrfName</strong> <span style="color:#94a3b8;">(#@row.IrfId)</span></td>
                        <td>
                            <a href="@TrialFlagDrillDownUrls.TranscriptQuality(interviewId, row.IrfId)" target="_blank" rel="noopener">#@interviewId</a>
                            <div style="color:#64748b;font-size:12px;">@FormatIst(row.TriggeringInterviewDate)</div>
                            <div style="color:#94a3b8;font-size:11px;">Flagged @FormatIst(row.FlaggedAtUtc)</div>
                            <button type="button" class="tfr-detail-toggle btn-tfr-details" data-flag-id="@row.TrialFlagId">Details</button>
                        </td>
                        <td>
                            @SeverityBadge(row)
                            @SeverityBreakdownPills(row)
                        </td>
                        <td><span class="@verdictClass">@VerdictLabel(row.OverallVerdict)</span></td>
                        <td class="tfr-risk-col">@RiskCategoryBadges(row)</td>
                        <td>@FactorCell(row.TranscriptQualityPass, transcriptDetail, TrialFlagDrillDownUrls.TranscriptQuality(interviewId, row.IrfId), "Transcript")</td>
                        <td>@FactorCell(row.ReportQualityPass, reportDetail, TrialFlagDrillDownUrls.ReportQuality(interviewId), "QC report")</td>
                        <td>
                            @FactorCell(row.CandidateRatingPass, ratingDetail, TrialFlagDrillDownUrls.CandidateRating(interviewId), "Rating")
                            @if (ratingHasComment)
                            {
                                <div class="tfr-candidate-comment"><strong>Candidate feedback:</strong> @row.CandidateFeedbackComment</div>
                            }
                        </td>
                        <td>@FactorCell(row.JoinTimePass, joinDetail, timingUrl, "Timing")</td>
                        <td>@FactorCell(row.InterviewDurationPass, durationDetail, timingUrl, "Timing")</td>
                        @if (!isPendingTab)
                        {
                            <td>
                                <div>@FormatIst(row.ReviewedAtUtc)</div>
                                <div style="color:#64748b;font-size:12px;">@(row.ReviewedBy ?? "—")</div>
                                @if (!string.IsNullOrWhiteSpace(row.ReviewerComment))
                                {
                                    <div style="margin-top:4px;font-size:12px;color:#475569;">@row.ReviewerComment</div>
                                }
                            </td>
                        }
                    </tr>
                    <tr class="tfr-detail-row" data-flag-id="@row.TrialFlagId" style="display:none;">
                        <td colspan="@(isPendingTab ? 12 : 12)">
                            <div style="font-size:12px;font-weight:700;color:#0f172a;margin-bottom:6px;">AI Evaluations</div>
                            <div class="tfr-ai-body" data-interview-id="@interviewId" data-irf-id="@row.IrfId">Loading…</div>
                            @if (!string.IsNullOrWhiteSpace(row.SeverityBreakdown))
                            {
                                <div style="margin-top:10px;font-size:12px;font-weight:700;color:#0f172a;">Flag breakdown</div>
                                @SeverityBreakdownPills(row)
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="tfrSearchEmpty" class="tfr-search-empty">No rows match your search.</div>
        <div id="tfrPagination" class="tfr-pagination" aria-label="Trial flag pagination">
            <span id="tfrPageInfo"></span>
            <div class="tfr-pagination__btns" id="tfrPageBtns"></div>
        </div>
    </div>
</div>

<div id="tfrActionModal" aria-hidden="true">
    <div class="tfr-modal-card">
        <div class="tfr-modal-card__head">
            <h3 id="tfrModalTitle" style="margin:0;font-size:18px;">Confirm action</h3>
            <div id="tfrModalSub" style="margin-top:6px;font-size:12px;color:#64748b;"></div>
        </div>
        <div class="tfr-modal-card__body">
            <input type="hidden" id="tfrModalFlagId" />
            <input type="hidden" id="tfrModalAction" />
            <label for="tfrModalComment" style="display:block;font-size:11px;font-weight:600;text-transform:uppercase;color:#64748b;margin-bottom:4px;">Comment (optional)</label>
            <textarea id="tfrModalComment" maxlength="500" placeholder="Add context for this decision..."></textarea>
        </div>
        <div class="tfr-modal-card__foot">
            <button type="button" class="tfr-btn tfr-btn--primary" id="tfrModalConfirm">Confirm</button>
            <button type="button" class="tfr-btn" id="tfrModalCancel">Cancel</button>
        </div>
    </div>
</div>

<div id="tfrToast" role="status"></div>

<script>
    (function () {
        var keepUrl = '@Url.Action("KeepTrialFlagReviewer", "Dashboard")';
        var removeUrl = '@Url.Action("RemoveTrialFlagReviewer", "Dashboard")';
        var backfillUrl = '@Url.Action("BackfillTrialFlags", "Dashboard")';
        var aiSummaryUrl = '@Url.Action("InterviewAiRiskSummary", "Dashboard")';
        var PAGE_SIZE = 30;
        var currentPage = 1;
        var searchTerm = '';
        var severityFilter = '';
        // Ascending numeric rank = P0 first (most severe). Sort label: ↑ = worst first.
        var severitySortAsc = true;
        var $tbody = $('.tfr-table tbody');
        var $mainRows = $tbody.find('tr.tfr-main-row');

        function severityRank(sev) {
            var m = (sev || '').match(/^P(\d)$/i);
            return m ? parseInt(m[1], 10) : 99;
        }

        function severityCss(p) {
            var s = (p || '').toString().toUpperCase();
            if (/^P[0-5]$/.test(s)) return 'tfr-severity tfr-severity--' + s.toLowerCase();
            return 'tfr-severity tfr-severity--na';
        }

        function getMatchedRows() {
            var $matched = $mainRows;
            if (searchTerm) {
                $matched = $matched.filter(function () {
                    return ($(this).attr('data-search') || '').indexOf(searchTerm) >= 0;
                });
            }
            if (severityFilter) {
                $matched = $matched.filter(function () {
                    return ($(this).attr('data-severity') || '').toUpperCase() === severityFilter;
                });
            }
            return $matched;
        }

        function applySeveritySort() {
            var rows = $mainRows.get();
            rows.sort(function (a, b) {
                var ra = severityRank($(a).attr('data-severity'));
                var rb = severityRank($(b).attr('data-severity'));
                return severitySortAsc ? (ra - rb) : (rb - ra);
            });
            $.each(rows, function (_, row) {
                var $main = $(row);
                var flagId = $main.attr('data-flag-id');
                var $detail = $tbody.find('tr.tfr-detail-row[data-flag-id="' + flagId + '"]');
                $tbody.append($main);
                if ($detail.length) $tbody.append($detail);
            });
            $mainRows = $tbody.find('tr.tfr-main-row');
        }

        function renderPagination() {
            var $matched = getMatchedRows();
            var total = $matched.length;
            var $bar = $('#tfrPagination');
            $tbody.find('tr').hide();
            $('#tfrSearchEmpty').toggleClass('is-visible', total === 0 && searchTerm.length > 0 && $mainRows.length > 0);
            if (total === 0) { $bar.removeClass('is-visible'); return; }
            var totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
            if (currentPage > totalPages) currentPage = totalPages;
            var start = (currentPage - 1) * PAGE_SIZE;
            $matched.slice(start, start + PAGE_SIZE).each(function () {
                var $main = $(this).show();
                var flagId = $main.attr('data-flag-id');
                var $detail = $tbody.find('tr.tfr-detail-row[data-flag-id="' + flagId + '"]');
                if ($detail.data('open')) $detail.show();
            });
            if (total <= PAGE_SIZE) { $bar.removeClass('is-visible'); return; }
            $('#tfrPageInfo').text('Showing ' + (start + 1) + '–' + Math.min(start + PAGE_SIZE, total) + ' of ' + total);
            var html = '<button type="button" class="tfr-btn tfr-pg-prev"' + (currentPage <= 1 ? ' disabled' : '') + '>&lsaquo;</button>';
            var startPage = Math.max(1, currentPage - 2);
            var endPage = Math.min(totalPages, startPage + 4);
            startPage = Math.max(1, endPage - 4);
            for (var p = startPage; p <= endPage; p++) {
                html += '<button type="button" class="tfr-btn tfr-pg' + (p === currentPage ? ' is-active' : '') + '" data-page="' + p + '">' + p + '</button>';
            }
            html += '<button type="button" class="tfr-btn tfr-pg-next"' + (currentPage >= totalPages ? ' disabled' : '') + '>&rsaquo;</button>';
            $('#tfrPageBtns').html(html);
            $bar.addClass('is-visible');
        }

        function aiLink(sourceName, interviewId, irfId) {
            if (sourceName === 'Transcript AI')
                return '/AIScreener/TransciptAnalysis?interviewId=' + encodeURIComponent(interviewId) + '&irfId=' + encodeURIComponent(irfId || '');
            return '/Interview/QCMergedAIDetails?interviewId=' + encodeURIComponent(interviewId);
        }

        function renderAiTable(rows, interviewId, irfId) {
            var html = '<table class="tfr-ai-table"><thead><tr><th>Source</th><th>Score / value</th><th>Status</th><th>Report</th></tr></thead><tbody>';
            (rows || []).forEach(function (r) {
                var score = (r.rawScore != null && r.rawScore !== '') ? r.rawScore : ((r.RawScore != null && r.RawScore !== '') ? r.RawScore : null);
                var triggered = !!(r.triggered != null ? r.triggered : r.Triggered);
                var pLevel = (r.pLevel || r.PLevel || '').toString().toUpperCase();
                var name = r.sourceName || r.SourceName || '—';
                var numericish = score != null && score !== '' && !isNaN(Number(score));
                var notScored = score == null || score === '' || (numericish && Number(score) === 0);
                var scoreHtml = notScored
                    ? '<span class="tfr-ai-na">Not scored</span>'
                    : $('<div/>').text(score).html();
                // Treat 0/NULL numeric scores as not scored — never Triggered
                if (notScored && numericish) {
                    triggered = false;
                    pLevel = '';
                }
                var statusHtml = triggered && pLevel
                    ? '<span class="' + severityCss(pLevel) + '" title="P0 = highest severity">' + $('<div/>').text(pLevel).html() + '</span>'
                    : '<span class="tfr-ai-ok">OK</span>';
                var href = aiLink(name, interviewId, irfId);
                html += '<tr><td>' + $('<div/>').text(name).html() + '</td><td>' + scoreHtml + '</td><td>' + statusHtml
                    + '</td><td><a href="' + href + '" target="_blank" rel="noopener">Open</a></td></tr>';
            });
            html += '</tbody></table>';
            return html;
        }

        function loadAiSummary($body) {
            if ($body.data('loaded')) return;
            var interviewId = $body.data('interview-id');
            var irfId = $body.data('irf-id');
            $.ajax({
                url: aiSummaryUrl,
                type: 'GET',
                data: { interviewId: interviewId, irfId: irfId },
                dataType: 'json'
            }).done(function (res) {
                if (!res || !res.ok) {
                    $body.html('<span class="tfr-ai-na">' + $('<div/>').text((res && res.message) || 'Failed to load.').html() + '</span>');
                    return;
                }
                $body.html(renderAiTable(res.rows || [], interviewId, irfId)).data('loaded', true);
            }).fail(function () {
                $body.html('<span class="tfr-ai-na">Failed to load AI evaluations.</span>');
            });
        }

        function applySearch() {
            searchTerm = ($('#tfrSearch').val() || '').trim().toLowerCase();
            severityFilter = ($('#tfrSeverityFilter').val() || '').trim().toUpperCase();
            currentPage = 1;
            $('#tfrSearchClear').toggle(searchTerm.length > 0);
            renderPagination();
        }

        function showToast(message, ok) {
            var $t = $('#tfrToast');
            $t.removeClass('tfr-toast--ok tfr-toast--err').addClass(ok ? 'tfr-toast--ok' : 'tfr-toast--err').text(message).addClass('is-show');
            setTimeout(function () { $t.removeClass('is-show'); }, 6000);
        }

        function openModal(action, flagId, interviewer, irf) {
            $('#tfrModalFlagId').val(flagId);
            $('#tfrModalAction').val(action);
            $('#tfrModalComment').val('');
            $('#tfrModalTitle').text(action === 'keep' ? 'Keep on IRF' : 'Remove from IRF');
            $('#tfrModalSub').text(interviewer + ' on ' + irf);
            $('#tfrActionModal').addClass('is-open');
        }

        $('.btn-tfr-keep').on('click', function () {
            openModal('keep', $(this).data('flag-id'), $(this).data('interviewer'), $(this).data('irf'));
        });
        $('.btn-tfr-remove').on('click', function () {
            openModal('remove', $(this).data('flag-id'), $(this).data('interviewer'), $(this).data('irf'));
        });
        $('#tfrModalCancel, #tfrActionModal').on('click', function (e) {
            if (e.target === this) $('#tfrActionModal').removeClass('is-open');
        });
        $('.tfr-modal-card').on('click', function (e) { e.stopPropagation(); });

        $('#tfrModalConfirm').on('click', function () {
            var action = $('#tfrModalAction').val();
            var url = action === 'keep' ? keepUrl : removeUrl;
            var $btn = $(this).prop('disabled', true);
            $.ajax({
                url: url,
                type: 'POST',
                data: {
                    trialFlagId: $('#tfrModalFlagId').val(),
                    comment: $('#tfrModalComment').val()
                },
                dataType: 'json'
            }).done(function (res) {
                showToast(res.message || (res.ok ? 'Saved.' : 'Failed.'), !!res.ok);
                if (res.ok) setTimeout(function () { location.reload(); }, 1000);
                else $btn.prop('disabled', false);
            }).fail(function (xhr) {
                var msg = 'Request failed';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                showToast(msg, false);
                $btn.prop('disabled', false);
            });
        });

        $('#tfrSearch').on('input', applySearch);
        $('#tfrSearchClear').on('click', function () { $('#tfrSearch').val(''); applySearch(); });
        $('#tfrSeverityFilter').on('change', applySearch);
        $('#tfrSortSeverity').on('click', function () {
            severitySortAsc = !severitySortAsc;
            // ↑ = P0 (highest) first; ↓ = P5 (clean) first
            $(this).toggleClass('is-active', true)
                .attr('title', severitySortAsc ? 'P0 highest first' : 'P5 clean first')
                .text(severitySortAsc ? 'Severity ↑ (P0 first)' : 'Severity ↓ (P5 first)');
            applySeveritySort();
            applySearch();
        });

        $(document).on('click', '.btn-tfr-details', function () {
            var flagId = $(this).data('flag-id');
            var $detail = $tbody.find('tr.tfr-detail-row[data-flag-id="' + flagId + '"]');
            var open = !$detail.data('open');
            $detail.data('open', open);
            $detail.toggle(open);
            $(this).text(open ? 'Hide details' : 'Details');
            if (open) loadAiSummary($detail.find('.tfr-ai-body'));
        });

        $('#btnTfrBackfill').on('click', function () {
            var $btn = $(this).prop('disabled', true);
            $('#tfrBackfillStatus').text('Running backfill...');
            $.ajax({
                url: backfillUrl,
                type: 'GET',
                dataType: 'json',
                timeout: 300000
            }).done(function (res) {
                $('#tfrBackfillStatus').text(res.message || '');
                if (res.details && res.details.length) {
                    console.log('Trial flag backfill details:', res.details);
                }
                showToast(res.message || (res.ok ? 'Backfill complete.' : 'Backfill finished.'), !!res.ok);
                if (res.inserted > 0) setTimeout(function () { location.reload(); }, 1500);
                else $btn.prop('disabled', false);
            }).fail(function (xhr) {
                var msg = 'Backfill request failed';
                if (xhr.status) msg += ' (HTTP ' + xhr.status + ')';
                if (xhr.responseJSON && xhr.responseJSON.message) msg += ': ' + xhr.responseJSON.message;
                else if (xhr.responseText && xhr.responseText.length < 500) msg += ': ' + xhr.responseText;
                $('#tfrBackfillStatus').text(msg);
                showToast(msg, false);
                $btn.prop('disabled', false);
            });
        });

        $(document).on('click', '.tfr-pg', function () {
            var p = parseInt($(this).data('page'), 10);
            if (p && p !== currentPage) { currentPage = p; renderPagination(); }
        });
        $(document).on('click', '.tfr-pg-prev', function () { if (currentPage > 1) { currentPage--; renderPagination(); } });
        $(document).on('click', '.tfr-pg-next', function () {
            var totalPages = Math.ceil(getMatchedRows().length / PAGE_SIZE);
            if (currentPage < totalPages) { currentPage++; renderPagination(); }
        });

        renderPagination();
    })();
</script>
