        function qcMergeHtml(row) {
            var v = row.qcMergeVerdict || row.QcMergeVerdict;
            var pen = row.qcMergeTotalPenalty != null ? row.qcMergeTotalPenalty : row.QcMergeTotalPenalty;
            var qc = row.qcMergeQcScore != null ? row.qcMergeQcScore : row.QcMergeQcScore;
