                    var pTone = pen >= 10 ? 'is-danger' : (pen >= 5 ? 'is-warn' : 'is-ok');
                    html += '<div class="tfr-qc-metric"><span class="tfr-qc-metric__label">Penalty</span><span class="tfr-qc-metric__value ' + pTone + '">' + esc(pen) + '</span></div>';
                }
                if (qc != null) {
                    var sTone = qc >= 8 ? 'is-ok' : (qc >= 5 ? 'is-warn' : 'is-danger');
                    html += '<div class="tfr-qc-metric"><span class="tfr-qc-metric__label">QC</span><span class="tfr-qc-metric__value ' + sTone + '">' + esc(qc) + '</span></div>';
                }
                html += '</div>';
            }
            if (v) {
                var css = (String(v).toLowerCase() === 'redo') ? 'is-redo' : (String(v).toLowerCase() === 'suspicious' ? 'is-suspicious' : 'is-ok');
                html += '<div><span class="tfr-qc-verdict ' + css + '">' + esc(v) + '</span></div>';
