@model IEnumerable<Risebird.Entities.ViewModel.ChannelManagementVM>
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Rendering
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Requirement Management";
    ViewBag.PageHeader = "Requirement Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var items = Model?.ToList() ?? new List<Risebird.Entities.ViewModel.ChannelManagementVM>();
    var received = (int)(ViewBag.SegmentAllCount ?? items.Count);
    var verifiedCount = (int)(ViewBag.SegmentVerifiedCount ?? 0);
    var externalCount = (int)(ViewBag.SegmentExternalCount ?? 0);
    var processedCount = (int)(ViewBag.ProcessedCount ?? items.Count(x => x.IsProcessed));
    var activeSegment = Convert.ToString(ViewBag.ActiveSegment) ?? "All";

    var magDict = ViewBag.MAGList as Dictionary<int, string> ?? new Dictionary<int, string>();
    var templateDict = ViewBag.TemplateList as Dictionary<int, string> ?? new Dictionary<int, string>();
    var clients = items.Select(x => x.Client).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    var isClient = ViewBag.Client == "true";
    var clientSelect = ViewBag.ClientOptions as SelectList;
    var roleSelect = ViewBag.ClientRoleOptions as SelectList;
}

<link href="~/Newassets/css/irf.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<style>
    .rm-wrap {
        padding: 0 6px 20px;
        font-family: Roboto, Arial, Helvetica, sans-serif;
    }

    /* ---- summary tiles ---- */
    .rm-tiles {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin: 10px 0 12px;
    }

    .rm-tile {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 8px;
        padding: 10px 12px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

    .rm-tile__icon {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        background: #eef2f7;
        color: #64748b;
    }

    .rm-tile__val {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.1;
    }

    .rm-tile__lbl {
        font-size: 11px;
        color: #7c8798;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 600;
        margin-top: 1px;
    }

    .rm-tile.t-proc .rm-tile__icon { background: #e7f8ee; color: #16a34a; }
    .rm-tile.t-pend .rm-tile__icon { background: #fff3e2; color: #ea8c11; }
    .rm-tile.t-week .rm-tile__icon { background: #e8f1fe; color: #2f6feb; }
    .rm-tile.t-ext .rm-tile__icon { background: #fff3e2; color: #c2740c; }
    .rm-tile.t-ver .rm-tile__icon { background: #e7f8ee; color: #15803d; }

    .rm-segments {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin: 0 0 10px;
    }
    .rm-seg {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        font-size: 12.5px;
        font-weight: 600;
        text-decoration: none !important;
    }
    .rm-seg:hover { background: #f8fafc; color: #334155; }
    .rm-seg.is-active { background: #e8f2fe; border-color: #c3e0fb; color: #1c6fc4; }
    .rm-seg__n {
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #eef2f7;
        color: #475569;
        font-size: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .rm-seg.is-active .rm-seg__n { background: #fff; color: #1c6fc4; }

    .rm-req-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 3px;
        padding: 1px 7px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .02em;
    }
    .rm-req-badge.is-ver { background: #e7f8ee; color: #15803d; }
    .rm-req-badge.is-ext { background: #fff3e2; color: #c2740c; }

    #rmTable tbody tr.is-external td { background: #fffaf3; }
    #rmTable tbody tr.is-external:hover td { background: #fff4e5; }

    .rm-ico.is-amber { border-color: #f5d0a9; background: #fff3e2; color: #c2740c; }
    .rm-ico.is-amber:hover { background: #ffe8c7; color: #9a5b08; }

    /* ---- card + toolbar ---- */
    .rm-card {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
    }

    .rm-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        padding: 10px 12px;
        border-bottom: 1px solid #eef2f6;
        background: #fbfcfd;
    }

    .rm-search {
        position: relative;
        flex: 1 1 220px;
        min-width: 180px;
    }

    .rm-search .fa {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 12px;
        color: #9aa5b4;
        pointer-events: none;
    }

    .rm-toolbar input,
    .rm-toolbar select {
        height: 32px;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 0 9px;
        font-size: 12.5px;
        color: #334155;
        background: #fff;
        outline: none;
    }

    .rm-toolbar #rmSearch {
        width: 100%;
        padding-left: 28px;
    }

    .rm-toolbar input:focus,
    .rm-toolbar select:focus {
        border-color: #56e0cb;
        box-shadow: 0 0 0 2px rgba(86, 224, 203, .18);
    }

    .rm-dates {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        color: #94a3b8;
    }

    .rm-reset {
        height: 32px;
        border: 1px solid #dde3ea;
        background: #fff;
        border-radius: 6px;
        font-size: 12.5px;
        color: #64748b;
        padding: 0 12px;
        cursor: pointer;
    }

    .rm-reset:hover { background: #f1f5f9; color: #334155; }

    /* ---- table ---- */
    #rmTable {
        width: 100% !important;
        margin: 0;
        border-collapse: collapse;
    }

    #rmTable thead th {
        background: #f6f8fa;
        color: #64748b;
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: 9px 12px;
        border: none;
        border-bottom: 1px solid #e8edf2;
        white-space: nowrap;
    }

    #rmTable tbody td {
        font-size: 12.5px;
        color: #334155;
        padding: 9px 12px;
        border: none;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        line-height: 1.35;
    }

    #rmTable tbody tr:last-child td { border-bottom: none; }
    #rmTable tbody tr:hover td { background: #f9fbfd; }

    .rm-title {
        font-weight: 600;
        color: #0f172a;
        font-size: 13px;
        display: block;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rm-sub {
        display: block;
        font-size: 11.5px;
        color: #8b97a8;
        margin-top: 1px;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rm-cell-trim {
        display: block;
        max-width: 190px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rm-muted { color: #b3bcc9; }

    .rm-map-name {
        font-weight: 600;
        color: #1e293b;
        display: block;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rm-map-irf {
        display: inline-block;
        margin-top: 3px;
        font-size: 11px;
        color: #4b5b70;
        background: #eef2f7;
        border-radius: 4px;
        padding: 1px 6px;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
    }

    .rm-map-none {
        color: #b3bcc9;
        font-style: italic;
        font-size: 12px;
    }

    .rm-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 26px;
        height: 22px;
        padding: 0 7px;
        border-radius: 5px;
        background: #eef2f7;
        color: #475569;
        font-size: 12px;
        font-weight: 600;
    }

    .rm-count.is-zero { background: #f7f8fa; color: #b3bcc9; }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .02em;
        white-space: nowrap;
    }

    .pill:before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .pill.p-proc { background: #e7f8ee; color: #15803d; }
    .pill.p-pend { background: #fff3e2; color: #c2740c; }

    .rm-date { white-space: nowrap; color: #64748b; font-size: 12px; }

    /* ---- row actions ---- */
    .rm-actions {
        display: flex;
        gap: 5px;
        justify-content: flex-end;
    }

    .rm-ico {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .15s ease;
        padding: 0;
    }

    .rm-ico:hover { background: #f1f5f9; color: #0f172a; border-color: #cbd5e1; }
    .rm-ico.is-primary { border-color: #c3e0fb; background: #e8f2fe; color: #2f7fe0; }
    .rm-ico.is-primary:hover { background: #d3e7fd; color: #1c6fc4; }

    /* ---- empty state ---- */
    .rm-empty {
        text-align: center;
        padding: 34px 16px;
        color: #94a3b8;
        font-size: 13px;
    }

    .rm-empty .fa { font-size: 24px; display: block; margin-bottom: 8px; color: #cbd5e1; }

    /* ---- pager ---- */
    .rm-card .dataTables_paginate {
        padding: 8px 12px;
        border-top: 1px solid #eef2f6;
        background: #fbfcfd;
        font-size: 12.5px;
    }

    .rm-card .dataTables_paginate .paginate_button {
        padding: 3px 9px !important;
        margin: 0 1px;
        border-radius: 5px !important;
        border: 1px solid transparent !important;
        color: #64748b !important;
    }

    .rm-card .dataTables_paginate .paginate_button.current {
        background: #eef2f7 !important;
        border-color: #dde3ea !important;
        color: #0f172a !important;
    }

    /* ---- Set Details modal ---- */
    .rmm .modal-dialog { max-width: 460px; }

    .rmm .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 18px 44px rgba(15, 23, 42, .18);
    }

    .rmm .modal-header {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px 16px;
        border-bottom: 1px solid #eef2f6;
        background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
    }

    .rmm-badge {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #e8f2fe;
        color: #2f7fe0;
        box-shadow: 0 0 0 3px rgba(66, 165, 245, .10);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .rmm-head-text { flex: 1; min-width: 0; }

    .rmm .modal-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.2;
        margin: 0;
        letter-spacing: -.01em;
    }

    .rmm-sub {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        min-width: 0;
    }

    .rmm-sub__tag {
        flex-shrink: 0;
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #7c8798;
        background: #eef2f7;
        border-radius: 4px;
        padding: 2px 6px;
        line-height: 1.4;
    }

    .rmm-sub__name {
        font-size: 12px;
        font-weight: 600;
        color: #445468;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rmm-sub__name.is-generic { font-weight: 400; color: #94a3b8; }

    .rmm .modal-body { padding: 14px 16px 4px; }

    .rmm .modal-footer {
        padding: 11px 16px;
        border-top: 1px solid #eef2f6;
        background: #fbfcfd;
        gap: 8px;
    }

    .rmm-field { margin-bottom: 14px; }

    .rmm-label {
        display: block;
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #7c8798;
        margin-bottom: 5px;
    }

    .rmm-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 5px;
    }

    .rmm-label-row .rmm-label { margin-bottom: 0; }

    .rmm-chip {
        font-size: 10.5px;
        font-weight: 700;
        color: #4b5b70;
        background: #eef2f7;
        border-radius: 999px;
        padding: 2px 8px;
    }

    .rmm-chip.is-on { background: #e8f2fe; color: #1c6fc4; }

    .rmm-input {
        width: 100%;
        height: 34px;
        border: 1px solid #dde3ea;
        border-radius: 7px;
        padding: 0 10px;
        font-size: 13px;
        color: #1e293b;
        background: #fff;
        outline: none;
    }

    .rmm-input:focus {
        border-color: #7fbdf5;
        box-shadow: 0 0 0 3px rgba(66, 165, 245, .16);
    }

    .rmm-hint { font-size: 11px; color: #94a3b8; margin-top: 5px; }

    /* segmented mode switch */
    .rmm-seg {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        background: #f1f5f9;
        border-radius: 8px;
        padding: 3px;
    }

    .rmm-seg__btn {
        border: none;
        background: transparent;
        border-radius: 6px;
        height: 30px;
        font-size: 12.5px;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all .15s ease;
    }

    .rmm-seg__btn .fa { font-size: 11px; }
    .rmm-seg__btn:hover { color: #334155; }

    .rmm-seg__btn.is-active {
        background: #fff;
        color: #0f172a;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .12);
    }

    /* IRF picker */
    .rmm-picker {
        border: 1px solid #dde3ea;
        border-radius: 8px;
        overflow: hidden;
    }

    .rmm-picker__bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 8px;
        background: #fbfcfd;
        border-bottom: 1px solid #eef2f6;
    }

    .rmm-picker__search { position: relative; flex: 1; min-width: 0; }

    .rmm-picker__search .fa {
        position: absolute;
        left: 8px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 11px;
        color: #9aa5b4;
    }

    .rmm-picker__search input {
        width: 100%;
        height: 28px;
        border: 1px solid #e6ebf1;
        border-radius: 6px;
        padding: 0 8px 0 25px;
        font-size: 12px;
        color: #334155;
        background: #fff;
        outline: none;
    }

    .rmm-picker__search input:focus { border-color: #cbd5e1; }

    .rmm-link {
        border: none;
        background: transparent;
        font-size: 11.5px;
        font-weight: 600;
        color: #2f7fe0;
        cursor: pointer;
        padding: 2px 4px;
        white-space: nowrap;
    }

    .rmm-link:hover { text-decoration: underline; }
    .rmm-link.is-muted { color: #94a3b8; }

    .rmm-picker__list {
        max-height: 178px;
        overflow-y: auto;
        background: #fff;
    }

    .rmm-picker__list::-webkit-scrollbar { width: 6px; }
    .rmm-picker__list::-webkit-scrollbar-thumb { background: #dde3ea; border-radius: 3px; }

    .rmm-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 10px;
        font-size: 12.5px;
        color: #334155;
        cursor: pointer;
        border-bottom: 1px solid #f4f7fa;
        margin: 0;
    }

    .rmm-item:last-child { border-bottom: none; }
    .rmm-item:hover { background: #f9fbfd; }
    .rmm-item input { width: 14px; height: 14px; accent-color: #42a5f5; margin: 0; flex-shrink: 0; }
    .rmm-item span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rmm-item.is-hidden { display: none; }

    .rmm-picker__empty {
        padding: 26px 12px;
        text-align: center;
        font-size: 12px;
        color: #9aa5b4;
    }

    .rmm-alert {
        display: flex;
        align-items: center;
        gap: 7px;
        background: #fef2f2;
        border: 1px solid #fecdd3;
        color: #b91c1c;
        border-radius: 7px;
        padding: 8px 10px;
        font-size: 12px;
        margin-bottom: 14px;
    }

    .rmm-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all .15s ease;
    }

    .rmm-btn--ghost { background: #fff; border-color: #dde3ea; color: #64748b; }
    .rmm-btn--ghost:hover { background: #f1f5f9; color: #334155; }

    .rmm-btn--primary {
        background: #42a5f5;
        color: #fff;
        padding: 0 20px;
        box-shadow: 0 2px 6px rgba(66, 165, 245, .32);
    }

    .rmm-btn--primary:hover { background: #2f8fe0; box-shadow: 0 3px 9px rgba(66, 165, 245, .40); }
    .rmm-btn--primary:active { background: #2a7fc9; box-shadow: none; }
    .rmm-btn--primary:disabled { background: #a8d3f7; box-shadow: none; cursor: default; }

    @@media (max-width: 991px) {
        .rm-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 575px) {
        .rm-tiles { grid-template-columns: 1fr; }
        .rm-toolbar > * { flex: 1 1 100%; }
    }
</style>

<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"><h4 class="card-title">Requirement Management</h4></div>
                </div>
                <div class="pull-right">
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='/Dashboard'">
                            <font style="font-family: Roboto, sans-serif; font-size:12px;"> Back</font>
                        </span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span data-toggle="tooltip" data-placement="top" title="Weekend Drive Planner"
                              onclick="location.href='@Url.Action("WeekendDrivePlanner", "DashBoard")'">
                            <font style="font-family: Roboto, sans-serif; font-size:12px;"> Weekend Drive</font>
                        </span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Add Requirement"
                              onclick="window.open('@Url.Action("AddRequirement", "DashBoard")', '_blank')">
                            <font style="font-family:arial;"> Add Requirement</font>
                        </span>
                    </button>
                    <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                        <span class="fa fa-external-link" data-toggle="tooltip" data-placement="top" title="Public Requirement"
                              onclick="window.open('/Requirement/Externaluser', '_blank')">
                            <font style="font-family:arial;"> Public Requirement</font>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="content client">
        <div class="rm-wrap">
            <div class="rm-tiles">
                <div class="rm-tile">
                    <span class="rm-tile__icon"><i class="fa fa-inbox"></i></span>
                    <span><span class="rm-tile__val">@received</span><span class="rm-tile__lbl">Received</span></span>
                </div>
                <div class="rm-tile t-ver">
                    <span class="rm-tile__icon"><i class="fa fa-check-circle"></i></span>
                    <span><span class="rm-tile__val">@verifiedCount</span><span class="rm-tile__lbl">From verified clients</span></span>
                </div>
                <div class="rm-tile t-ext">
                    <span class="rm-tile__icon"><i class="fa fa-user-o"></i></span>
                    <span><span class="rm-tile__val">@externalCount</span><span class="rm-tile__lbl">External / unverified</span></span>
                </div>
                <div class="rm-tile t-proc">
                    <span class="rm-tile__icon"><i class="fa fa-check"></i></span>
                    <span><span class="rm-tile__val">@processedCount</span><span class="rm-tile__lbl">Processed</span></span>
                </div>
            </div>

            <div class="rm-segments">
                <a class="rm-seg @(activeSegment == "All" ? "is-active" : "")" href="@Url.Action("RequirementManagement", "DashBoard", new { segment = "All" })">All <span class="rm-seg__n">@received</span></a>
                <a class="rm-seg @(activeSegment == "Verified" ? "is-active" : "")" href="@Url.Action("RequirementManagement", "DashBoard", new { segment = "Verified" })">Verified clients <span class="rm-seg__n">@verifiedCount</span></a>
                <a class="rm-seg @(activeSegment == "External" ? "is-active" : "")" href="@Url.Action("RequirementManagement", "DashBoard", new { segment = "External" })">External-unverified <span class="rm-seg__n">@externalCount</span></a>
            </div>

            <div class="rm-card">
                <div class="rm-toolbar">
                    <span class="rm-search">
                        <i class="fa fa-search"></i>
                        <input type="search" id="rmSearch" placeholder="Search requirement, client, requester…" />
                    </span>
                    <select id="rmStatus" title="Status">
                        <option value="">All statuses</option>
                        <option value="Processed">Processed</option>
                        <option value="Pending">Pending</option>
                    </select>
                    <select id="rmClient" title="Client">
                        <option value="">All clients</option>
                        @foreach (var c in clients)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <span class="rm-dates">
                        <input type="date" id="rmDateFrom" title="Created from" />
                        <span>to</span>
                        <input type="date" id="rmDateTo" title="Created to" />
                    </span>
                    <button type="button" class="rm-reset" id="rmReset">Reset</button>
                </div>

                <div class="table-responsive">
                    <table id="rmTable" class="table">
                        <thead>
                            <tr>
                                <th>Requirement</th>
                                <th>Client</th>
                                <th>Requester</th>
                                <th>Mapping</th>
                                <th style="text-align:center;">Interviewers</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in items)
                        {
                            string mapName = null;
                            if (i.MAGId.GetValueOrDefault() > 0 && magDict.ContainsKey(i.MAGId.Value))
                                mapName = magDict[i.MAGId.Value];
                            else if (i.TemplateId.GetValueOrDefault() > 0 && templateDict.ContainsKey(i.TemplateId.Value))
                                mapName = templateDict[i.TemplateId.Value];

                            var statusLabel = i.IsProcessed ? "Processed" : "Pending";
                            var createdIso = i.CreatedDate.ToString("yyyy-MM-dd");
                            var isVerified = string.Equals(i.RequesterType, "Verified", StringComparison.OrdinalIgnoreCase);
                            var isExternal = !isVerified;
                            <tr data-created="@createdIso" data-req-type="@(isVerified ? "Verified" : "External")" class="@(isExternal ? "is-external" : "")" data-id="@i.id">
                                <td>
                                    <span class="rm-title" title="@i.Title">@(string.IsNullOrWhiteSpace(i.Title) ? "—" : i.Title)</span>
                                    @if (!string.IsNullOrWhiteSpace(i.PrimarySkill))
                                    {
                                        <span class="rm-sub" title="@i.PrimarySkill">@i.PrimarySkill</span>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(i.Client))
                                    {
                                        <span class="rm-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="rm-cell-trim" title="@i.Client">@i.Client</span>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(i.RequesterEmailid))
                                    {
                                        <span class="rm-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="rm-cell-trim" title="@i.RequesterEmailid">@i.RequesterEmailid</span>
                                    }
                                    @if (isVerified)
                                    {
                                        <span class="rm-req-badge is-ver">Verified client</span>
                                    }
                                    else
                                    {
                                        <span class="rm-req-badge is-ext">External / unverified</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(mapName))
                                    {
                                        <span class="rm-map-name" title="@mapName">@mapName</span>
                                        @if (!string.IsNullOrWhiteSpace(i.IRFIDs))
                                        {
                                            <span class="rm-map-irf" title="@i.IRFIDs">@i.IRFIDs</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="rm-map-none">not mapped</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <span class="rm-count @(i.InterviewerCount == 0 ? "is-zero" : "")">@i.InterviewerCount</span>
                                </td>
                                <td data-search="@statusLabel">
                                    <span class="pill @(i.IsProcessed ? "p-proc" : "p-pend")">@statusLabel</span>
                                </td>
                                <td data-order="@createdIso"><span class="rm-date">@i.CreatedDate.ToString("dd MMM yyyy")</span></td>
                                <td>
                                    <div class="rm-actions">
                                        @if (!isClient)
                                        {
                                            <button type="button" class="rm-ico is-primary js-set-details" title="Set Details"
                                                    data-id="@i.id" data-mag="@(i.MAGId ?? 0)" data-template="@(i.TemplateId ?? 0)"
                                                    data-irf="@i.IRFIDs" data-name="@i.Title">
                                                <i class="fa fa-sliders"></i>
                                            </button>
                                            @if (!isVerified)
                                            {
                                                <button type="button" class="rm-ico is-amber js-add-client-user" title="Add client user"
                                                        data-id="@i.id" data-email="@i.RequesterEmailid" data-name="@i.Title">
                                                    <i class="fa fa-user-plus"></i>
                                                </button>
                                            }
                                        }
                                        <button type="button" class="rm-ico" title="Edit"
                                                onclick="location.href='@Url.Action("EditRequirement","DashBoard", new { id = i.id })'">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                        @if (!isClient)
                                        {
                                            <button type="button" class="rm-ico" title="Interviewers"
                                                    onclick="location.href='@Url.Action("Interviewer", "DashBoard", new { id = i.id })'">
                                                <i class="fa fa-users"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (!items.Any())
                {
                    <div class="rm-empty">
                        <i class="fa fa-inbox"></i>
                        No requirements yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Set Details modal *@
<div class="modal fade rmm" id="rmSetDetailsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="rmm-badge"><i class="fa fa-sliders"></i></span>
                <div class="rmm-head-text">
                    <h5 class="modal-title" style="text-align:left;">Set Details</h5>
                    <div class="rmm-sub">
                        <span class="rmm-sub__tag" id="rmReqTag">Requirement</span>
                        <span class="rmm-sub__name" id="rmReqName">—</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="rmReqId" />

                <div class="rmm-field">
                    <label class="rmm-label">Map using</label>
                    <div class="rmm-seg" id="rmModeSeg">
                        <button type="button" class="rmm-seg__btn is-active" data-mode="mag"><i class="fa fa-sitemap"></i> MAG</button>
                        <button type="button" class="rmm-seg__btn" data-mode="template"><i class="fa fa-file-text-o"></i> Template</button>
                    </div>
                </div>

                <div class="rmm-field" id="rmPaneMag">
                    <label class="rmm-label" for="rmMagId">Select MAG</label>
                    <select id="rmMagId" class="rmm-input">
                        <option value="">— Select MAG —</option>
                        @foreach (var kv in magDict.OrderBy(x => x.Value))
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    </select>
                </div>

                <div class="rmm-field" id="rmPaneTemplate" style="display:none;">
                    <label class="rmm-label" for="rmTemplateId">Select Template</label>
                    <select id="rmTemplateId" class="rmm-input">
                        <option value="">— Select Template —</option>
                        @foreach (var kv in templateDict.OrderBy(x => x.Value))
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    </select>
                </div>

                <div class="rmm-field">
                    <div class="rmm-label-row">
                        <span class="rmm-label">IRF</span>
                        <span class="rmm-chip" id="rmIrfCount">0 selected</span>
                    </div>

                    <div class="rmm-picker" id="rmIrfPicker">
                        <div class="rmm-picker__bar">
                            <span class="rmm-picker__search">
                                <i class="fa fa-search"></i>
                                <input type="text" id="rmIrfSearch" placeholder="Filter IRFs" autocomplete="off" />
                            </span>
                            <button type="button" class="rmm-link" id="rmIrfAll">Select all</button>
                            <button type="button" class="rmm-link is-muted" id="rmIrfNone">Clear</button>
                        </div>
                        <div class="rmm-picker__list" id="rmIrfList">
                            <div class="rmm-picker__empty">Select a MAG to load its IRFs.</div>
                        </div>
                    </div>

                    <div id="rmIrfManualWrap" style="display:none;">
                        <input type="text" id="rmIrfManual" class="rmm-input" placeholder="e.g. 1024, 1025" />
                        <div class="rmm-hint">Enter comma-separated IRF ids for this template.</div>
                    </div>
                </div>

                <div id="rmSetDetailsMsg" class="rmm-alert" style="display:none;"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="rmm-btn rmm-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="rmm-btn rmm-btn--primary" id="rmSaveDetailsBtn" onclick="saveSetDetails()">Save details</button>
            </div>
        </div>
    </div>
</div>

@* Add client user modal *@
<div class="modal fade rmm" id="rmAddClientUserModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <span class="rmm-badge"><i class="fa fa-user-plus"></i></span>
                <div class="rmm-head-text">
                    <h5 class="modal-title">Add client user</h5>
                    <div class="rmm-sub">
                        <span class="rmm-sub__tag">Promote</span>
                        <span class="rmm-sub__name" id="acuReqName">Register this requester</span>
