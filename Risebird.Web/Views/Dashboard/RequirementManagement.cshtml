@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {
            var msg = '@ViewBag.Message';
            swal({
                title: msg.toLowerCase().includes('success') ? 'Successful' : 'Failed',
                text: msg,
                type: msg.toLowerCase().includes('success') ? 'success' : 'error',
                showConfirmButton: true
            }, function () { location.reload(); });
        };
    </script>
}

<script src="~/Newassets/js/jquery.dataTables.min.js"></script>
<script>
    var rmTable;
    var RM_COL = { client: 1, status: 5, created: 6, actions: 7 };

    $(document).ready(function () {
        rmTable = $('#rmTable').DataTable({
            pageLength: 25,
            dom: 'tp',
            order: [[RM_COL.created, 'desc']],
            columnDefs: [{ orderable: false, targets: RM_COL.actions }],
            language: { emptyTable: 'No requirements found.', zeroRecords: 'No requirements match these filters.' }
        });

        $('#rmSearch').on('keyup', function () { rmTable.search(this.value).draw(); });
        $('#rmStatus').on('change', function () { rmTable.column(RM_COL.status).search(this.value).draw(); });
        $('#rmClient').on('change', function () {
            var v = this.value;
            rmTable.column(RM_COL.client).search(v ? '^' + $.fn.dataTable.util.escapeRegex(v) + '$' : '', true, false).draw();
        });

        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            if (settings.nTable.id !== 'rmTable') return true;
            var from = $('#rmDateFrom').val();
            var to = $('#rmDateTo').val();
            if (!from && !to) return true;
            var created = $(rmTable.row(dataIndex).node()).attr('data-created') || '';
            if (!created) return true;
            if (from && created < from) return false;
            if (to && created > to) return false;
            return true;
        });
        $('#rmDateFrom, #rmDateTo').on('change', function () { rmTable.draw(); });

        $('#rmReset').on('click', function () {
            $('#rmSearch').val('');
            $('#rmStatus').val('');
            $('#rmClient').val('');
            $('#rmDateFrom').val('');
            $('#rmDateTo').val('');
            rmTable.search('').columns().search('').draw();
        });

        $(document).on('click', '.js-set-details', function () {
            var $b = $(this);
            openSetDetails($b.data('id'), $b.data('mag') || 0, $b.data('template') || 0, $b.data('irf') || '', $b.data('name') || '');
        });

        $(document).on('click', '.js-add-client-user', function () {
            var $b = $(this);
            openAddClientUser($b.data('id'), $b.data('email') || '', $b.data('name') || '');
        });

        $('#acuClient').on('change', function () {
            $('#acuNewClientWrap').toggle(this.value === '__new__');
        });

        $('#rmModeSeg').on('click', '.rmm-seg__btn', function () {
            var mode = $(this).data('mode');
            if (mode === 'mag') {
                $('#rmTemplateId').val('');
                $('#rmIrfManual').val('');
            } else {
                $('#rmMagId').val('');
                rmRenderIrfs([]);
            }
            rmSetMode(mode);
        });

        $('#rmMagId').on('change', function () { loadIrfsByMag(this.value, []); });

        $('#rmIrfList').on('change', 'input', rmUpdateIrfCount);
        $('#rmIrfManual').on('keyup change', rmUpdateIrfCount);
        $('#rmIrfAll').on('click', function () {
            $('#rmIrfList .rmm-item:not(.is-hidden) input').prop('checked', true);
            rmUpdateIrfCount();
        });
        $('#rmIrfNone').on('click', function () {
            $('#rmIrfList input').prop('checked', false);
            rmUpdateIrfCount();
        });
        $('#rmIrfSearch').on('keyup', function () {
            var q = $.trim(this.value).toLowerCase();
            $('#rmIrfList .rmm-item').each(function () {
                var hide = q.length > 0 && $(this).text().toLowerCase().indexOf(q) < 0;
                $(this).toggleClass('is-hidden', hide);
            });
        });
    });

    function rmModal(action, modalId) {
        var el = document.getElementById(modalId || 'rmSetDetailsModal');
        if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            var inst = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
            if (action === 'hide') { inst.hide(); } else { inst.show(); }
        } else {
            $(el).modal(action);
        }
    }

    function openAddClientUser(id, email, name) {
        $('#acuReqId').val(id);
        $('#acuEmail').val(email || '');
        $('#acuReqName').text(name || email || 'Register this requester');
        $('#acuFirst').val('');
        $('#acuLast').val('');
        $('#acuMobile').val('');
        $('#acuWhatsapp').val('');
        $('#acuClient').val('');
        $('#acuNewClient').val('');
        $('#acuNewClientWrap').hide();
        $('#acuRole').val('');
        $('#acuMsg').hide().empty();
        // Prefill first/last from email local-part when possible
        var local = String(email || '').split('@@')[0] || '';
        var parts = local.replace(/[._-]+/g, ' ').trim().split(/\s+/);
        if (parts.length >= 1 && parts[0]) $('#acuFirst').val(parts[0].charAt(0).toUpperCase() + parts[0].slice(1));
        if (parts.length >= 2 && parts[1]) $('#acuLast').val(parts[1].charAt(0).toUpperCase() + parts[1].slice(1));
        rmModal('show', 'rmAddClientUserModal');
    }

    function saveAddClientUser() {
        var payload = {
            RequirementId: parseInt($('#acuReqId').val(), 10) || 0,
            EmailId: $.trim($('#acuEmail').val() || ''),
            FirstName: $.trim($('#acuFirst').val() || ''),
            LastName: $.trim($('#acuLast').val() || ''),
            MobileNumber: $.trim($('#acuMobile').val() || ''),
            WhatsappNumber: $.trim($('#acuWhatsapp').val() || ''),
            SelectedClientRole: parseInt($('#acuRole').val(), 10) || null,
            SelectedClient: null,
            NewClientName: null
        };
        var clientVal = $('#acuClient').val();
        if (clientVal === '__new__') {
            payload.NewClientName = $.trim($('#acuNewClient').val() || '');
            if (!payload.NewClientName) {
                $('#acuMsg').html('<i class="fa fa-exclamation-circle"></i><span>Enter a new client name.</span>').show();
                return;
            }
        } else {
            payload.SelectedClient = parseInt(clientVal, 10) || null;
        }
        if (!payload.RequirementId || !payload.EmailId || !payload.FirstName || !payload.LastName || !payload.SelectedClientRole) {
            $('#acuMsg').html('<i class="fa fa-exclamation-circle"></i><span>Fill first name, last name, client and role.</span>').show();
            return;
        }
        $('#acuSaveBtn').prop('disabled', true).text('Saving…');
        $.ajax({
            url: '@Url.Action("AddClientUserFromRequirement", "DashBoard")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload)
        }).done(function (res) {
            if (res && res.ok) {
                rmModal('hide', 'rmAddClientUserModal');
                // Move to Verified segment
                location.href = '@Url.Action("RequirementManagement", "DashBoard")?segment=Verified';
            } else {
                $('#acuMsg').html('<i class="fa fa-exclamation-circle"></i>').append($('<span/>').text((res && res.message) || 'Save failed.')).show();
            }
        }).fail(function () {
            $('#acuMsg').html('<i class="fa fa-exclamation-circle"></i><span>Save failed.</span>').show();
        }).always(function () {
            $('#acuSaveBtn').prop('disabled', false).text('Register & verify');
        });
    }

    function rmSetHeading(name) {
        var label = $.trim(name == null ? '' : String(name));
        $('#rmReqTag').toggle(label.length > 0);
        $('#rmReqName')
            .toggleClass('is-generic', label.length === 0)
            .attr('title', label.length > 0 ? label : null)
            .text(label.length > 0 ? label : 'Map this requirement to a MAG or Template');
    }

    function rmParseIds(value) {
        return String(value || '').split(/[,;]+/).map(function (s) { return s.trim(); }).filter(Boolean);
    }

    function rmSetMode(mode) {
        $('#rmModeSeg .rmm-seg__btn').each(function () {
            $(this).toggleClass('is-active', $(this).data('mode') === mode);
        });
        $('#rmPaneMag').toggle(mode === 'mag');
        $('#rmPaneTemplate').toggle(mode === 'template');
        $('#rmIrfPicker').toggle(mode === 'mag');
        $('#rmIrfManualWrap').toggle(mode === 'template');
        rmUpdateIrfCount();
    }

    function rmCurrentMode() {
        return $('#rmModeSeg .rmm-seg__btn.is-active').data('mode') || 'mag';
    }

    function rmUpdateIrfCount() {
        var n = rmCurrentMode() === 'template'
            ? rmParseIds($('#rmIrfManual').val()).length
            : $('#rmIrfList input:checked').length;
        $('#rmIrfCount').text(n + ' selected').toggleClass('is-on', n > 0);
    }

    function rmShowError(message) {
        $('#rmSetDetailsMsg')
            .html('<i class="fa fa-exclamation-circle"></i>')
            .append($('<span/>').text(message))
            .show();
    }

    function rmRenderIrfs(list, preselected) {
        var $list = $('#rmIrfList').empty();
        var pre = preselected || [];
        if (!list || !list.length) {
            $list.append($('<div class="rmm-picker__empty"/>')
                .text($('#rmMagId').val() ? 'No IRFs found for this MAG.' : 'Select a MAG to load its IRFs.'));
            rmUpdateIrfCount();
            return;
        }
        list.forEach(function (x) {
            var id = String(x.irfId);
            var label = x.label || id;
            var $item = $('<label class="rmm-item"/>');
            $('<input type="checkbox"/>').val(id).prop('checked', pre.indexOf(id) >= 0).appendTo($item);
            $('<span/>').text(label).attr('title', label).appendTo($item);
            $item.appendTo($list);
        });
        rmUpdateIrfCount();
    }

    function openSetDetails(id, magId, templateId, irfIds, name) {
        var pre = rmParseIds(irfIds);
        magId = parseInt(magId, 10) || 0;
        templateId = parseInt(templateId, 10) || 0;

        $('#rmReqId').val(id);
        rmSetHeading(name);
        $('#rmSetDetailsMsg').hide().empty();
        $('#rmIrfSearch').val('');
        $('#rmMagId').val(magId > 0 ? String(magId) : '');
        $('#rmTemplateId').val(templateId > 0 ? String(templateId) : '');
        $('#rmIrfManual').val('');

        var mode = (magId <= 0 && templateId > 0) ? 'template' : 'mag';
        if (mode === 'template') {
            $('#rmIrfManual').val(pre.join(', '));
            rmRenderIrfs([]);
            rmSetMode(mode);
            rmModal('show');
            return;
        }

        rmSetMode(mode);
        if (magId > 0) {
            loadIrfsByMag(magId, pre, function () { rmModal('show'); });
        } else {
            rmRenderIrfs([]);
            rmModal('show');
        }
    }

    function loadIrfsByMag(magId, preselected, cb) {
        var $list = $('#rmIrfList');
        if (!magId) { rmRenderIrfs([]); if (cb) cb(); return; }
        $list.html('<div class="rmm-picker__empty">Loading IRFs…</div>');
        $.getJSON('@Url.Action("GetIRFsByMAG", "DashBoard")', { magId: magId })
            .done(function (res) { rmRenderIrfs(res && res.data, preselected); })
            .fail(function () {
                $list.html('<div class="rmm-picker__empty">Could not load IRFs for this MAG.</div>');
                rmUpdateIrfCount();
            })
            .always(function () { if (cb) cb(); });
    }

    function saveSetDetails() {
        var mode = rmCurrentMode();
        var id = parseInt($('#rmReqId').val(), 10) || 0;
        var magId = mode === 'mag' ? (parseInt($('#rmMagId').val(), 10) || null) : null;
        var templateId = mode === 'template' ? (parseInt($('#rmTemplateId').val(), 10) || null) : null;
        var irfs = mode === 'template'
            ? rmParseIds($('#rmIrfManual').val())
            : $('#rmIrfList input:checked').map(function () { return this.value; }).get();

        if (!id) { rmShowError('This requirement could not be identified. Refresh and try again.'); return; }
        if (!(magId > 0) && !(templateId > 0)) {
            rmShowError(mode === 'template' ? 'Select a template to continue.' : 'Select a MAG to continue.');
            return;
        }
        if (!irfs.length) { rmShowError('Select at least one IRF.'); return; }

        $('#rmSetDetailsMsg').hide().empty();
        $('#rmSaveDetailsBtn').prop('disabled', true).text('Saving…');
        $.ajax({
            url: '@Url.Action("SetRequirementDetails", "DashBoard")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Id: id, MAGId: magId, TemplateId: templateId, IRFIDs: irfs.join(',') })
        }).done(function (res) {
            if (res && res.success) {
                rmModal('hide');
                location.reload();
            } else {
                rmShowError((res && res.message) || 'Save failed. Please try again.');
            }
        }).fail(function () {
            rmShowError('Save failed. Please try again.');
        }).always(function () {
            $('#rmSaveDetailsBtn').prop('disabled', false).text('Save details');
        });
    }
</script>
