@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        location.reload();
                    }
                )
            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true
                },
                    function ()
                    {
                        location.reload();
                    }
                )
            }
        }
        window.onload = my_code();
    </script>
}


<script>
        $(document).ready(function () {
            $("#stDateInvoice").val("");
            $("#EndDateInvoice").val("");
            $("#srNumberId").val("");
            $("#poNumberId").val("");
            $("#requestNumberId").val("");
            $("#currencyCodeId").val("");
            $("#projectCodeId").val("");
            $("#discountId").val("");
            $("#clientAddressId").val("");
            document.getElementById("gstCheckId").checked = false;
            $("#ResetFilter").click(function () {
                ResetFilter();
            })
            if ('@filter' != "") {
                ApplySessionFilter();
            }

            $("#RFID").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#ClientName").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#ArchiveStatus").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#SubscriptionStatus").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
            $("#ClientRole").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });
             $("#PrimarySkill").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                 buttonWidth: '100%',
                maxHeight: 200
            });
        });

        function ResetFilter() {
            window.location.href = "/IRF/ResetIRFFilter";
        }
        function ApplySessionFilter() {
            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var rFID =  @Html.Raw(Json.Serialize(RFID));
            var clientName =  @Html.Raw(Json.Serialize(ClientName));
            var archiveStatus =  @Html.Raw(Json.Serialize(ArchiveStatus));
            var subscriptionStatus =  @Html.Raw(Json.Serialize(SubscriptionStatus));
            var clientRole =  @Html.Raw(Json.Serialize(ClientRole));
            var primarySkill= @Html.Raw(Json.Serialize(PrimarySkill));

            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#RFID").val(rFID);
            $("#ClientName").val(clientName);
            $("#ArchiveStatus").val(archiveStatus);
            $("#SubscriptionStatus").val(subscriptionStatus);
            $("#ClientRole").val(clientRole);
            $("#PrimarySkill").val(primarySkill);

            var form = $("#form").serialize();

        }

</script>



