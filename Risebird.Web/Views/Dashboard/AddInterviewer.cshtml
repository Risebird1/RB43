@model Risebird.Entities.ViewModel.ChannelInterviewerVM

@{
    ViewData["Title"] = "Add Interviewer";
    ViewBag.PageHeader = "Add Interviewer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/select2.css" defer rel="stylesheet" />
<link href="~/Newassets/css/interview.css?v=134556" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=134556" />
<div class="main-panel " id="main-panel">

    <div class="mt50">
    </div>
    <div class="content client ">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">

                    <div class="mdc-card-wrapper__text-section">

                        @using (Html.BeginForm("AddInterviewer", "DashBoard", FormMethod.Post, new { enctype = "multipart/form-data", @class = "ng-pristine ng-valid", @id = "irfForm", @onclick = "return checkvalidation();" }))
                        {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="row" style="padding-top:20px">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Personal Details</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="row addIntr">
                                <div class="col-md-12">
                                    <div class="mobile-view"> <h4 class="card-title" style="margin:0px;">Interviewer</h4></div>
                                </div>
                                @Html.HiddenFor(model => model.id)
                                @Html.HiddenFor(model => model.Channelid)
                                @Html.HiddenFor(model => model.isEditable)
                                <div style="width: 100%;">&nbsp;</div>


                                <div class="col-lg-3 col-md-6 col-sm-6 pr-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label desp-label" })
                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        <label class="text-danger" id="uniqueMsg" style="color:red"></label>
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.EmailAddress, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.EditorFor(model => model.EmailAddress, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        <label class="text-danger" id="uniqueMsg" style="color:red"></label>
                                        @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.Mobile, htmlAttributes: new { @class = "control-label desp-label" })
                                        @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 pl-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.PrimarySKill, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.EditorFor(model => model.PrimarySKill, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.PrimarySKill, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 pr-1">
                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.Role, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.EditorFor(model => model.Role, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.Role, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">


                                    <div class="form-group" style="margin-bottom:0px;">
                                        @Html.LabelFor(model => model.Comment, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.EditorFor(model => model.Comment, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })

                                    </div>

                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.PerInterviewrate, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.EditorFor(model => model.PerInterviewrate, new { htmlAttributes = new { @class = "form-control text-box single-line" } })
                                        @Html.ValidationMessageFor(model => model.PerInterviewrate, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-6 col-sm-6 pl-1">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Priority, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.DropDownListFor(m => m.Priority, new SelectList(Model.Prioritylist, "Value", "Text"), new { @id = "select", @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Priority, "", new { @class = "text-danger" })

                                    </div>
                                </div>


                                <div class="col-lg-6 col-md-6 col-sm-6 pr-1">
                                    <div class="form-group col-lg-4 col-md-12 col-sm-12 nopad filebox pull-left" style="margin-top:10px;">
                                        <input type="radio" name="Jd" id="Jdlink" value="Upload" onclick="RadioChanged('Upload')" /> Upload CV
                                        <input type="radio" name="Jd" id="Jdlink" value="Filelink" checked onclick="RadioChanged('Filelink')" /> CV Link
                                    </div>
                                    <div class="form-group col-lg-8 col-md-12 col-sm-12 pr-1 mobpad pull-left">
                                        <div id="uploadDiv" style="display:none">
                                            @Html.LabelFor(model => model.CV, htmlAttributes: new { @class = "control-label  desp-label" })
                                            @Html.TextBoxFor(model => model.CV, new { type = "file", @class = "form-control btn ", @accept = ".mp4" })
                                        </div>
                                        <div id="linkDiv">
                                            @*@Html.LabelFor(model => model.CVLink, htmlAttributes: new { @class = "control-label  desp-label" })*@
                                            @Html.EditorFor(model => model.CVLink, new { htmlAttributes = new { @class = "form-control text-box single-line", @placeholder = "CV Link" } })
                                        </div>

                                    </div>
                                </div>

                                <div class="col-lg-6 col-md-6 col-sm-6 px-1">
                                    <div class="form-group col-lg-5 col-md-12 col-sm-12 nopad filebox pull-left" style="margin-top:10px;">
                                        <input type="radio" name="Codedcv" id="Codedcv" value="Upload" onclick="RadioIRFID('Upload')" /> Upload CodedCV
                                        <input type="radio" name="Codedcv" id="Codedcv" value="Filelink" checked onclick="RadioIRFID('Filelink')" /> CodedCV Link
                                    </div>

                                    <div class="form-group col-lg-7 col-md-12 col-sm-12 pl-1 mobpad pull-left">
                                        <div id="codeduploadDiv" style="display:none">
                                            @Html.LabelFor(model => model.CodedCV, htmlAttributes: new { @class = "control-label  desp-label" })
                                            @Html.TextBoxFor(model => model.CodedCV, new { type = "file", @class = "form-control btn ", @accept = ".mp4" })
                                        </div>
                                        <div id="codedlinkDiv">
                                            @*@Html.LabelFor(model => model.CodedCVLink, htmlAttributes: new { @class = "control-label  desp-label" })*@
                                            @Html.EditorFor(model => model.CodedCVLink, new { htmlAttributes = new { @class = "form-control text-box single-line", @placeholder = "Coded CV Link" } })
                                        </div>

                                    </div>
                                </div>

                            </div>

                            <div class="row" style="padding-top:20px">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="multiple_row">
                                        <h2>Additional Details</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="row addIntr">
                                <div class="col-lg-3 col-md-6 col-sm-6 pr-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.Approved, htmlAttributes: new { @class = "control-label   desp-label" })
                                        @Html.RadioButtonFor(model => model.Approved, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.Approved, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.AddedoverPortal, htmlAttributes: new { @class = "control-label   desp-label" })
                                        @Html.RadioButtonFor(model => model.AddedoverPortal, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.AddedoverPortal, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.AddedoverSKillChannel, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.AddedoverSKillChannel, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.AddedoverSKillChannel, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 pl-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.QC, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.QC, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.QC, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 pr-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.Emergency, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.Emergency, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.Emergency, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.Trainingmailsend, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.Trainingmailsend, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.Trainingmailsend, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.AdvancePayment, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.AdvancePayment, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.AdvancePayment, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 pl-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.DMCallAvailability, htmlAttributes: new { @class = "control-label   desp-label" })
                                        @Html.RadioButtonFor(model => model.DMCallAvailability, 1) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.DMCallAvailability, 0)<span class="radio-field">No</span>

                                    </div>
                                </div>


                                <div class="col-lg-3 col-md-6 col-sm-6 pr-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.Training, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.Training, 1, new { @onclick = "RadioTraining('Yes')" }) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.Training, 0, new { @onclick = "RadioTraining('No')" })<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <input type="hidden" value="@Model.Training" id="txttrainingtime" />
                                    <div id="divtraingtime" style="display:none">
                                        @Html.LabelFor(model => model.TrainingTime, htmlAttributes: new { @class = "control-label  col-lg-4 col-md-4 col-sm-12 col-xs-12 desp-label pull-left nopad tp25" })
                                        @Html.EditorFor(model => model.TrainingTime, new { htmlAttributes = new { @class = "col-md-8 pull-left form-control text-box single-line", @type = "datetime-local", @style = "margin-top: 18px!important;" } })
                                    </div>
                                    <div id="divtraingtime1" class="tp25">
                                        No Timing
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <div class="form-group radiobox">
                                        @Html.LabelFor(model => model.CallAttended, htmlAttributes: new { @class = "control-label  desp-label" })
                                        @Html.RadioButtonFor(model => model.CallAttended, 1, new { @onclick = "Radiocall('Yes')" }) <span class="radio-field">Yes</span>
                                        @Html.RadioButtonFor(model => model.CallAttended, 0, new { @onclick = "Radiocall('No')" })<span class="radio-field">No</span>

                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-6 px-1">
                                    <input type="hidden" value="@Model.CallAttended" id="txtcalltime" />
                                    <div id="divcalltime" style="display:none">
                                        @Html.LabelFor(model => model.CallTime, htmlAttributes: new { @class = "control-label  col-lg-4 col-md-4 col-sm-12 col-xs-12 desp-label pull-left nopad tp25" })
                                        @Html.EditorFor(model => model.CallTime, new { htmlAttributes = new { @class = "form-control text-box single-line col-md-8 pull-left form-control text-box single-line call-time", @type = "datetime-local", @style = "margin-top:18px!important;" } })
                                    </div>
                                    <div id="divcalltime1" class="tp25">
                                        No Call time
                                    </div>
                                </div>
                            </div>



                            <div class="card-footer ">
                                <div class="row">
                                    <div class="col-md-12 mc-button-area">
                                        @Html.ActionLink("Back", "Interviewer", "DashBoard", new { id = Model.Channelid }, htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded", @role = "button" })
                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" id="btnUpload" value="Submit">Submit</button>
                                    </div>
                                </div>
                            </div>


                        }
                        @*</form>*@

                    </div>

                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <!-- end row -->
    </div>

</div>

<script>

    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("JDLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("JDFile").value = '';

        }

    }
    function RadioIRFID(val) {
        if (val == 'Upload') {
            document.getElementById("codeduploadDiv").style.display = "block";
            document.getElementById("codedlinkDiv").style.display = "none";
            document.getElementById("Codedcv").value = '';

        }
        else {
            document.getElementById("codeduploadDiv").style.display = "none";
            document.getElementById("codedlinkDiv").style.display = "block";
            document.getElementById("Codedcv").value = '';

        }
    }
    function RadioTraining(val) {
        if (val == 'Yes') {
            document.getElementById("divtraingtime").style.display = "block";
            document.getElementById("divtraingtime1").style.display = "none";
            $("#txttrainingtime").val('1');
        }
        else {
            document.getElementById("divtraingtime").style.display = "none";
            document.getElementById("divtraingtime1").style.display = "block";
            $("#txttrainingtime").val('0');
        }
    }
    function Radiocall(val) {
        if (val == 'Yes') {
            document.getElementById("divcalltime").style.display = "block";
            document.getElementById("divcalltime1").style.display = "none";
            $("#txtcalltime").val('1');
        }
        else {
            document.getElementById("divcalltime").style.display = "none";
            document.getElementById("divcalltime1").style.display = "block";
            $("#txtcalltime").val('0');
        }
    }
    if ($("#txtcalltime").val() == 1) {
        Radiocall('Yes');
    }
    if ($("#txttrainingtime").val() == 1) {
        RadioTraining('Yes');
    }
    function checkvalidation() {
        //if ($("#txttrainingtime").val() == '1') {
        //    if ($("#TrainingTime").val().trim() == "") {
        //        Swal.fire("Please fill Training Timing field.");
        //        return false;
        //    }
        //}
        return true;
    }
</script>


