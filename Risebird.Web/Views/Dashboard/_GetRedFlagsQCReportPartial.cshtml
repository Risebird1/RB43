@model Risebird.Entities.ViewModel.QCFormVM

<div>
    <ul>
        @if (!Model.IsCodingPresent)
        {
            <li>Whether hands-on coding is present</li>
        }
        @if (!Model.IsVideoClearQuality)
        {
            <li> Whether candidate video is clearly visible</li>
        }
        @if (!Model.IsInterviewerCommunicationClear)
        {
            <li>Clarity in Interviewer’s communication</li>
        }
        @if (!Model.IsSufficientVideoDuration)
        {
            <li>Whether video duration is sufficient</li>
        }
        @if (!Model.IsInterviewStructured)
        {
            <li>Is the interview properly structured</li>
        }
        @if (!Model.IsScoringrubriccorrect)
        {
            <li>Whether scoring rubrics is filled correctly</li>
        }
        @if (!Model.IsQuestionswithtime)
        {
            <li>Whether questions are filled with timeline</li>
        }
        @if (!Model.IsCommentfilled)
        {
            <li>Whether appropriate/fitting comments are filled</li>
        }
        @if (!Model.IsMeetingStatusfilled)
        {
            <li>Whether appropriate meeting and interview status are filled</li>
        }
        @if (!Model.IsRelevancequestions)
        {
            <li>Relevance of the questions asked</li>
        }
        @if (Model.IsDelayresuminginterview)
        {
            <li>Delay in resuming an interview</li>
        }
        @if (Model.IsBackgroundnoise)
        {
            <li>Background Noise</li>
        }
        @if (Model.IsPoorinterviewerinfrastructure)
        {
            <li>Poor interviewer infrastructure</li>
        }
        @if (Model.IsPoorhandlingcandidatequery)
        {
            <li>Poor handling of candidate’s queries</li>
        }
        @if (Model.IsPersonalquestions)
        {
            <li>Asking personal questions or making personal remarks</li>
        }
        @if (Model.IsAugmenting)
        {
            <li>Getting into arguments</li>
        }
        @if (Model.IsBiasedView)
        {
            <li>Biased View</li>
        }
        @if (!Model.IsLettingcandidatespeak)
        {
            <li>Letting candidate speak</li>
        }
        @if (Model.IsSuspiciousappfound)
        {
            <li>IsSuspiciousappfound</li>
        }
        @if (Model.IsSuspiciousappfound)
        {
            <li>Lip-sync issue noticed</li>
        }
    </ul>
</div>


