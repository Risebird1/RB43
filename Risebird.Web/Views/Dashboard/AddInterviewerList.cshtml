@model IEnumerable<Risebird.Entities.ViewModel.ChannelApprovedInterviewer>
@{
    ViewData["Title"] = "Interviewers";
    ViewBag.PageHeader = "Interviewers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=7" />

<div class="main-panel" id="main-panel">
   
    <div class="pt30">
        <div class="col-md-12 nopad">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">Interviewers for <b>'@ViewBag.ChannelName'</b></h4></div>
                </div>

                <div class="pull-right">
                    @if (ViewBag.IsClient != "true")
                    {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span class="fa fa-plus-square" data-toggle="tooltip" data-placement="top" title="Click here to select Interviewers." onclick="location.href='@Url.Action("SelectChannelInterviewers", "DashBoard", new { cmId = ViewBag.ISCId, cmTitle = ViewBag.ChannelName })'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Select Interviewers</font></span>
                        </button>
                    }
                    @Html.ActionLink("Back", "RequirementManagement", "DashBoard", htmlAttributes: new { @class = "mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space", @role = "button" })
                </div>
            </div>
        </div>
    </div>

    <div class="content client interviewer">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar" style="margin-bottom:10px;">


                            </div>
                            <div>

                                <div id="tableID">
                                    <table id="interviewersTbl" class="table table-striped table-bordered journey" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>

                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Public Url</th>
                                                <th>Status</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>

                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Public Url</th>
                                                <th>Status</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                var color = "";
                                                @if (item.status == "Approved")
                                                {
                                                    color = "#05880547";
                                                }
                                                else if (item.status == "Unapproved")
                                                {
                                                    color = "#88110538";
                                                }
                                                <tr style="background-color:@color">
                                                    @if (item.FirstName != null && item.FirstName != "")
                                                    {
                                                        <td class="cadName" style="width:25%">
                                                            @item.FirstName
                                                        </td>
                                                    }


                                                    else
                                                    {
                                                        <td></td>

                                                    }
                                                    @if (item.EmailId != null && item.EmailId != "")
                                                    {


                                                        <td class="cadEmail" style="width:20%">
                                                            @item.EmailId
                                                        </td>
                                                    }


                                                    else
                                                    {
                                                        <td></td>
                                                    }


                                                    @if (item.ResumeLink != null && item.ResumeLink != "")
                                                    {
                                                        <td> <a id="videoid" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    <td>@item.status</td>
                                                    <td class="action" style="text-align:center">
                                                        @if (ViewBag.IsClient == "true")
                                                        {
                                                            <button class="mdc-fab app-fab--absolute" aria-label="Approve" style="background:#5dc35d !important">
                                                                <span onclick="location.href = '@Url.Action("ChannelInterviewerAction", "DashBoard", new { id = item.id,channelName = ViewBag.ChannelName, channelid=ViewBag.ISCId,status="Approved"})'" title="Approve" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-1.91l-.01-.01L23 10z" /></svg>
                                                                </span>
                                                            </button>

                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="UnApproved">
                                                                <span onclick="location.href = '@Url.Action("ChannelInterviewerAction", "DashBoard", new { id = item.id,channelName = ViewBag.ChannelName, channelid=ViewBag.ISCId,status="Unapproved"})'" title="UnApproved" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v1.91l.01.01L1 14c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z" /></svg>
                                                                </span>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="mdc-fab app-fab--absolute trash-btn" aria-label="Delete">
                                                                <span onclick="javascript:DeleteISCInterviewer('@item.id', '@ViewBag.ISCId', '@ViewBag.ChannelName');" title="Remove" class="mdc-fab__icon material-icons">
                                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" /></svg>
                                                                </span>
                                                            </button>
                                                        }

                                                    </td>


                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>


                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>





        <!-- end row -->
    </div>

</div>



@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.toLowerCase().includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        //window.location.href = '/IRF/Index';
                        location.reload(true);
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        //window.location.href = '/IRF/Index';
                        location.reload(true);

                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script>
    $(document).ready(function () {

        $('#interviewersTbl').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: false,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#interviewersTbl').DataTable();
    });
</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#interviewersTbl").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#interviewersTbl").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#interviewersTbl").show();
        }, 2000);
    };
    //// script for loader ends here

    function DeleteISCInterviewer(id, iscId, ChannelName) {


        swal.fire({
            title: 'Are you sure?',
            text: "The interviewer will be removed from " + ChannelName,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, remove it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    //var IdIRF = dataID;
                    $.ajax({
                        url: '/DashBoard/DeleteChannelInterviewer?id=' + id + '&iscId=' + iscId + '&iscName=' + ChannelName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {
                            //reject("error message")
                            swal.fire("Error removing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Removed!',
                    type: 'success',
                    html: '<p>The interviewer has been removed.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'The interviewer could not be removed!',
                    'error'
                )
            }
        })
    }
</script>









