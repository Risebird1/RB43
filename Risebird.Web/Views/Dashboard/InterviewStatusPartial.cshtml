@model Risebird.Entities.ViewModel.DashboardVM
<link rel="stylesheet" type="text/css" href="~/Newassets/css/scrollBar.css?v=2024" />
    <div class="panel-body">
        @if (Model.TotalCompletedMeetings != 0)
        {
            <div class=" stacked">
                <div class="sb-container scroller">
                    <div>

                        @{
                            var borderLine = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 4).Count();
                            <div class="progress-list">
                                <div class="pull-left"><strong>Border Line</strong></div>
                                <div class="pull-right">
                                    @borderLine / @Model.TotalCompletedMeetings
                                </div>
                                <div class="progress progress-small progress-striped active">
                                    <div class="progress-bar progress-bar-primary" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(borderLine * 100 / Model.TotalCompletedMeetings)%;">
                                        @(borderLine * 100 / Model.TotalCompletedMeetings)%
                                    </div>
                                </div>
                            </div>

                            var proxy = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 1).Count();
                            <div class="progress-list">
                                <div class="pull-left"><strong>Proxy</strong></div>
                                <div class="pull-right">
                                    @proxy / @Model.TotalCompletedMeetings
                                </div>
                                <div class="progress progress-small progress-striped active">
                                    <div class="progress-bar progress-bar-primary" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(proxy * 100 / Model.TotalCompletedMeetings)%;">
                                        @(proxy * 100 / Model.TotalCompletedMeetings)%
                                    </div>
                                </div>
                            </div>

                            var rejected = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 3).Count();
                            <div class="progress-list">
                                <div class="pull-left"><strong class="text-danger">Rejected</strong></div>
                                <div class="pull-right">
                                    @rejected / @Model.TotalCompletedMeetings
                                </div>
                                <div class="progress progress-small progress-striped active">
                                    <div class="progress-bar progress-bar-danger" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(rejected * 100 / Model.TotalCompletedMeetings)%;">
                                        @(rejected * 100 / Model.TotalCompletedMeetings)%
                                    </div>
                                </div>
                            </div>

                            var selected = Model.Meetings.Where(x => x.InterviewStatus.HasValue && x.InterviewStatus == 2).Count();
                            <div class="progress-list">
                                <div class="pull-left"><strong class="text-warning">Selected</strong></div>
                                <div class="pull-right">
                                    @selected / @Model.TotalCompletedMeetings
                                </div>
                                <div class="progress progress-small progress-striped active">
                                    <div class="progress-bar progress-bar-warning" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" style="width: @(selected * 100 / Model.TotalCompletedMeetings)%;">
                                        @(selected * 100 / Model.TotalCompletedMeetings)%
                                    </div>
                                </div>
                            </div>
                        }


                    </div>

                </div>
            </div>
        }
        else
        {
            <div>No completed interviews for this date!</div>

        }
    </div>
<script src="~/Newassets/js/scrollBar.js?v=2024"></script>

    <script type="text/javascript">
    $(".sb-container").scrollBox();
    </script>