                                                    <th>Approval Comments</th>

                                                    <th>Final Selection Status</th>
                                                    <th>Final Selection Comments</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th id='start'>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                    <th>Primary Skill</th>
                                                    <th>Interviewer</th>
                                                    <th>Confirmation Status</th>
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    <th>Resume</th>
                                                    <th>JD Link</th>
                                                    <th>Zoom Link</th>
                                                    <th>Zoom ID</th>
                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                    <th>Video Link</th>
                                                    <th>Interview Slot</th>
                                                    <th>QC Interviewer</th>
                                                    <th>QC Status</th>
                                                    <th>Co-ordinating HR</th>
                                                    <th>HR Comments</th>
                                                    <th>Staffing Agency</th>
                                                    <th>Interview Duration</th>
                                                    <th>Expected Joining Time</th>
                                                    <th>Preferred Location</th>
                                                    <th>Expected Salary</th>
                                                    <th>Current Employer</th>
                                                    <th>Emergency Interview</th>
                                                    <th>Aadhar Link</th>
                                                    <th>Approval Status</th>
                                                    <th>Approval Comments</th>

                                                    <th>Final Selection Status</th>
                                                    <th>Final Selection Comments</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                <tr id=@item.imid>
                                                    <td title=@item.IRFId> @item.IRFId </td>
                                                    <td> @item.interviewDate </td>
                                                    <td>@item.candidateName</td>


                                                    <td> @item.candidateEmail<input type="text" hidden id="txtcandidateemail_@item.imid" value="@item.candidateEmail" /></td>


                                                    @if (!string.IsNullOrEmpty(item.JDTiltle))
                                                    {
                                                        <td> 
                                                            @item.JDTiltle.Split("|")[0] 
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }
                                                    @if (@item.interviewer != null || @item.interviewer != "")
                                                    {
                                                        <td>
                                                            @item.interviewer
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }

                                                    @if (item.confirmationStatus.Trim() == "Cancelled")
                                                    {
                                                        <td class="text-center">

                                                            <a style="color:red"> @item.confirmationStatus</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td class="text-center"> @item.confirmationStatus</td>
                                                    }

                                                    @if (@item.interviewDate > DateTime.Now && item.confirmationStatus.Trim() != "Cancelled")
                                                    {
                                                        <td>Scheduled</td>
                                                    }
                                                    else
                                                    {
                                                        <td> @item.MeetingStatusStatusDesc</td>
                                                    }
                                                    <td> @item.intervieweStatusStatDesc</td>
                                                    @if (item.resumeLink != null && item.resumeLink != "")
                                                    {
                                                        <td>

                                                            <a id="resumeId" target="_blank" title="Resume" href=@item.resumeLink>Resume</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }

                                                    @if (item.zoomLink != null && item.zoomLink != "")
                                                    {
                                                        <td> <a id="zoomlinkId" target="_blank" title="Zoom Link" href=@item.zoomLink>Zoom Link</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Zoom Link</td>
                                                    }
                                                    <td> @item.risebirdHR</td>

                                                    @if (item.IsHrOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @item.ClientHrContact
                                                        </td>
                                                    }
                                                    <td> @item.ClientName </td>

                                                    @if (item.VideoLink != null && item.VideoLink != "")
                                                    {
                                                        <td> <a id="videoId" target="_blank" title="Resume" href=@item.VideoLink>Video</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Video</td>
                                                    }
                                                    <td>@item.interviewSlot</td>
                                                    <td>@item.QCInterviewer</td>
                                                    @if (!(string.IsNullOrEmpty(item.QCStatusStatusDesc)))
                                                    {
                                                        <td>@item.QCStatusStatusDesc</td>

                                                    }
                                                    else
                                                    {
                                                        <td></td>

                                                    }
                                                    <td>@item.HRCoordinatorEmailId</td>
                                                    <td>@item.HRComment</td>
                                                    <td>@item.staffingAgency</td>
                                                    <td> @item.interviewDuration </td>
                                                    <td> @item.joiningTime</td>
                                                    <td> @item.preferredLocation</td>
                                                    <td> @item.expectedPerHourRate</td>
                                                    <td> @item.currentEmployerName</td>
                                                    <td>
                                                        @item.IsEmergency
                                                    </td>
                                                    @if (item.AadharFileLink != null && item.AadharFileLink != "")
                                                    {
                                                        <td>

                                                            <a id="aadharLinkId" target="_blank" title="Aadhar" href=@item.AadharFileLink.ToString().Replace(" ","%20")>Aadhar</a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No document</td>
                                                    }
                                                    <td>
                                                        @item.NextLevelApprovalStat
                                                    </td>
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in ">
                                                            <div class="talktext">
                                                                @if (item.ApprovalComments != null && item.ApprovalComments.Length > 0)
                                                                {

                                                                    <a href="#" data-tooltip="@item.ApprovalComments">  <textarea class="scrollbar" style="height: 40px; width:100%;">@item.ApprovalComments</textarea></a>
                                                                }
                                                                else
                                                                {
                                                                    <textarea class="scrollbar" style="height: 40px; width:100%;">@item.ApprovalComments</textarea>
                                                                }

                                                            </div>
                                                        </div>
                                                    </td>



                                                    <td>
                                                        @item.FinalSelectionStat
                                                    </td>
                                                    <td>
                                                        <div class="talk-bubble tri-right border-bubble right-in ">
                                                            <div class="talktext">
                                                                @if (item.FinalComments != null && item.FinalComments.Length > 0)
                                                                {

                                                                    <a href="#" data-tooltip="@item.FinalComments"><textarea class="scrollbar" style="height: 40px; width:100%;">@item.FinalComments</textarea></a>
                                                                }

                                                                else
                                                                {
                                                                    <textarea class="scrollbar" style="height: 40px; width:100%;">@item.FinalComments</textarea>
                                                                }


                                                            </div>
                                                        </div>
                                                    </td>


                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>







