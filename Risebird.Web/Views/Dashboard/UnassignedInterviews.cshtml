    function ResetFilter() {
        var value = $("#hidactionstatus").val();
        window.location.href = "/Dashboard/ResetUnassignedInterviewsFilter?actionstatus=" + value;

    }
    function ApplySessionFilter() {

        var strtDte = '@strtDte';
        var endDte = '@endDte';
        var status = @Html.Raw(Json.Serialize(Status));
        var client = @Html.Raw(Json.Serialize(Client));
        var clientHREmail = @Html.Raw(Json.Serialize(ClientHREmail));



        $('input[name=StartDate]').val(strtDte);
