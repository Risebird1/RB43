@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.Data
@*@inject IHttpContextAccessor HttpContextAccessor*@

@{
    ViewData["Title"] = "Unassigned Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}




<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />


<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">Unassigned Interviews</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>

        </div>
    </nav>
    <!-- End Navbar -->
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> Unassigned Interviews</h4></div>
                </div>

                <div class="pull-right">
                    <div>

                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Index", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back to List</font></span>
                        </button>
                      
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content interview client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                               
                                <div style="overflow-x:scroll" class="scrollbar" id="style-2">

                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th id='start'>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                   
                                                    <th>Interviewer</th>
                                                   
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                    
                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                   
                                                    <th>QC Interviewer</th>
                                                    <th>QC Status</th>
                                                    <th>Co-ordinating HR</th>
                                                   
                                                  

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th id='start'>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    <th>Candidate Name</th>
                                                    <th>Candidate Email</th>
                                                  
                                                    <th>Interviewer</th>
                                                   
                                                    <th>Meeting Status</th>
                                                    <th>Interview Status</th>
                                                   
                                                    <th>Client HR</th>
                                                    <th>End Client Name</th>
                                                    
                                                    <th>QC Interviewer</th>
                                                    <th>QC Status</th>
                                                   
                                                    <th>HR Comments</th>
                                                    

                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                <tr id=@item.imid>
                                                    <td title=@item.IRFId> @item.IRFId </td>
                                                    <td> @item.interviewDate </td>
                                                    <td>@item.candidateName</td>


                                                    <td> @item.candidateEmail<input type="text" hidden id="txtcandidateemail_@item.imid" value="@item.candidateEmail" /></td>


                                                  
                                                    @if (@item.interviewer != null || @item.interviewer != "")
                                                    {
                                                        <td>
                                                            @item.interviewer
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td></td>
                                                    }

                                                    

                                                    @if (@item.interviewDate > DateTime.Now && item.confirmationStatus.Trim() != "Cancelled")
                                                    {
                                                        <td>Scheduled</td>
                                                    }
                                                    else
                                                    {
                                                        <td> @item.MeetingStatusStatusDesc</td>
                                                    }
                                                    <td> @item.intervieweStatusStatDesc</td>
                                            
                                                 

                                                    @if (item.IsHrOnline == 1)
                                                    {
                                                        <td>
                                                            <a onclick="directopenChat('@item.ClientHrContact')"><span class="dot" style="background-color:green"></span>     @item.ClientHrContact </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @item.ClientHrContact
                                                        </td>
                                                    }
                                                    <td> @item.ClientName </td>

                                                   
                                                    <td>@item.QCInterviewer</td>
                                                    @if (!(string.IsNullOrEmpty(item.QCStatusStatusDesc)))
                                                    {
                                                        <td>@item.QCStatusStatusDesc</td>

                                                    }
                                                    else
                                                    {
                                                        <td></td>

                                                    }
                                                    <td>@item.HRCoordinatorEmailId</td>
                                                    
                                                </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>







