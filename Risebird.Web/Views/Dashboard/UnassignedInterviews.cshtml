<script>
    function OpenRedoFormModel(interviewid) {
        $.ajax({
            url: '/Interview/RejectRedoInterviewDetails',
            data: { 'interviewid': interviewid },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }
    function openRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "block";
    }
    function closeRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "none";
    }
</script>

<script type="text/javascript">

    var closeMember = document.getElementById("membersPopUp");
    // When the user clicks on <span> (x), close the modal
    closeMember.onclick = function () {
        var modal = document.getElementById("interviewerMemberModal");
        modal.style.display = "none";
    }
    function getIRFMembers(id) {

        $.ajax({
            url: '/IRF/GetIRFInterviewerMembers',
            data: { 'irfId': id },
            success: function (data) {
                var modal = document.getElementById("interviewerMemberModal");
                modal.style.display = "block";
                $('#memberTableBody').html('');
                $('#memberTableBody').html(data);


            }
        });
    }

