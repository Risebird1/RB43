<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>


<script>
    function moreless(id) {

        $('.moretext_' + id).slideToggle();
        if ($('#read_' + id).val() == 'Readmore') {
            $('#read_' + id).empty().html('Read more');
            $('#read_' + id).val('Readless');
        } else {
            $('#read_' + id).empty().html('Read less');
            $('#read_' + id).val('Readmore');
        }
    }
    function FetchHistory(meetingid) {
        $.ajax({
            type: "POST",
            url: "/DashBoard/FetchZoomMeetingHistory",
            data: { 'meetingid': meetingid },
            success: function (data) {
                var modal = document.getElementById("ZoomMeetingHistory");
                modal.style.display = "block";
                bindZoomMeetingHistoryData(data);
            }
        });
    }
    function bindZoomMeetingHistoryData(data) {
        var html = '';
        html += '';
        html += '<table class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">';
        html += '<thead>';
        html += '<tr>';
        html += '   <th>Event</th>';
        html += '   <th>Name</th>';
        html += '   <th>Date</th>';
        html += '</tr>';
        html += '</thead>';
        html += '<tbody>';
        for (var i = 0; i < data.length; i++) {
            html += '<tr>';
            html += '<td>' + data[i].event + '</td>';
            html += '<td>' + data[i].participantName + '</td>';
            html += '<td>' + data[i].actionDate + '</td>';
            html += '</tr>';
        }
        if (data.length == 0) {
            html += '<tr><td cols="3">No record found<td></tr>';
        }
        html += '    </tbody> ';
        html += '</table> ';
        $("#divZoomMeetingHistory").empty().html(html);
    }
    function closeZoomMeetingHistory() {
        var modal = document.getElementById("ZoomMeetingHistory");
        modal.style.display = "none";
    }
    function Changeurldetails(type) {
        var actiontype = $("#hidactiontype").val();
        window.location.href = "/DashBoard/UnassignedInterviews?actionstatus=" + type + "&actiontype=" + actiontype;
    }



    function OpenRedoFormModel(interviewid) {
        $.ajax({
            url: '/Interview/RejectRedoInterviewDetails',
            data: { 'interviewid': interviewid },
            success: function (data) {
                $('#divredoInterview').html('');
                $('#divredoInterview').html(data);
                openRedoInterviewModel();
            }
        });
    }
    function openRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "block";
    }

    function closeRedoInterviewModel() {
        var modal = document.getElementById("RedoInterviewModel");
        modal.style.display = "none";
    }
    function Sendinvite(id, IRFId, CandidateEmail) {
        $.ajax({
            url: '/Client/SendInvite',
            type: 'POST',
            data: { 'irfId': id, 'IRFName': IRFId, 'emailId': CandidateEmail },
            success: function (data) {
                swal.fire(data);
            }
        });
    }
    function SendOpenInterview(irfId = null) {
        swal.fire({
            title: 'Are you sure you want to send open interview notification?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, send!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/Interviewer/SendOpenURLNotification',
                        type: 'POST',
                        data: { 'irfId': irfId },
                        success: function (result) {
                            if (result == "Success") {
                                swal.fire({
                                    title: 'Sent!',
                                    type: 'success',
                                    html: '<p>Mails sent successfully.</p>',
                                    showCancelButton: false,
                                    confirmButtonColor: '#3085d6',
                                    confirmButtonText: 'Close!',
                                    allowOutsideClick: false
                                });
                            } else {
                                swal.fire({
                                    title: 'Fail to sent!',
                                    type: 'error',
                                    html: '<p>Failed to send the mails, Please try again.</p>',
                                    showCancelButton: false,
                                    confirmButtonColor: '#3085d6',
                                    confirmButtonText: 'Close!',
                                    allowOutsideClick: false
                                });
                            }
                        },
                        error: function () {
                            swal.fire("Error Sending!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        })
    }
</script>

