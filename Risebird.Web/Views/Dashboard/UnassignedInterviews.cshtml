@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>

@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Risebird.CommonHelper
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "911 Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic filter = null;
    string strtDte = string.Empty;
    string endDte = string.Empty;
    string[] Status = new string[] { };
    string[] Client = new string[] { };
    string[] ClientHREmail = new string[] { };
}
@if (HttpContextAccessor.HttpContext.Session.GetString("UnassignedInterviewsFilters") != null)
{
    filter = JsonConvert.DeserializeObject<UnassignedInterviewsFilter>(HttpContextAccessor.HttpContext.Session.GetString("UnassignedInterviewsFilters"));
    strtDte = filter.StartDate != null ? string.Format("{0:yyyy-MM-dd}", filter.StartDate) : string.Empty;
    endDte = filter.EndDate != null ? string.Format("{0:yyyy-MM-dd}", filter.EndDate) : string.Empty;

    Status = filter.Status != null ? filter.Status : new string[] { };
    Client = filter.Client != null ? filter.Client : new string[] { };
    ClientHREmail = filter.ClientHREmail != null ? filter.ClientHREmail : new string[] { };

}


<link href="~/Newassets/css/interview.css?v=7" rel="stylesheet" />
<div class="main-panel" id="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title"> 911 Dashboard</h4></div>
                </div>
                <div class="pull-left">
                    @if (ViewBag.actionstatus == "QCPendingReport" || ViewBag.actionstatus == "QCReport")
                    {
                        if (ViewBag.actionstatus == "QCPendingReport")
                        {
                            <div class="feedback-tab-ac" onclick="Changeurldetails('QCPendingReport')"><strong>QC Pending Report</strong></div>
                            <div class="feedback-tab" onclick="Changeurldetails('QCReport')"><strong>QC Report</strong></div>
                        }
                        else
                        {
                            <div class="feedback-tab" onclick="Changeurldetails('QCPendingReport')"><strong>QC Pending Report</strong></div>
                            <div class="feedback-tab-ac" onclick="Changeurldetails('QCReport')"><strong>QC Report</strong></div>
                        }
                    }
                </div>
                <div class="pull-right">
                    <div>
                        @if (ViewBag.actionstatus != "NeedClarity")
                        {
                            <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                                <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                                <div class="mdc-button__ripple"></div>
                            </button>
                        }
                        @if (ViewBag.Actiontype == 0)
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                                <span data-toggle="tooltip" data-placement="top" title="Back" onclick="location.href='@Url.Action("MyInterviews", "HR")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                            </button>
                        }
                        @if (ViewBag.actionstatus == "QCPendingReport" || ViewBag.actionstatus == "QCReport")
                        {
                            <span class="interview_2 pull-right"> <i type="submit" class="far fa-file-excel excel-file card-title-space " data-toggle="tooltip" data-placement="bottom" title="Export to an Excel file." data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("UnassignedInterviewsExportToExcel", "Dashboard", new { actionstatus = ViewBag.actionstatus, actiontype = ViewBag.Actiontype })'"></i></span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">
                                <input type="hidden" value="@ViewBag.actionstatus" id="hidactionstatus" />
                                <input type="hidden" value="@ViewBag.Actiontype" id="hidactiontype" />
                                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog" aria-labelledby="filterModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg" role="document">
                                        <div class="modal-content">
                                            <div class="filheader">
                                                <div class="filavatar">
                                                    <span class="fa fa-filter"></span>
                                                </div>
                                                <h5 class="modal-title pull-left" id="filterModalLabel"> Filter</h5>
                                            </div>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <form action="@Url.Action("UnassignedInterviews","Dashboard",new { actionstatus=ViewBag.actionstatus,actiontype=ViewBag.Actiontype})" method="post" id="form">

                                                <div class="modal-body">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="StartDate">
                                                                    Start Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="StartDate" name="StartDate" type="date" class="form-control">
                                                                </div>
                                                            </div>




                                                        </div>
                                                        <div class="col-md-6 col-sm-6">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for=" End Date">
                                                                    End Date
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <input id="EndDate" name="EndDate" type="date" class="form-control">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6 col-sm-6 border-rv">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="Client">
                                                                    Client
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="Client" name="Client" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.Name).Distinct().ToList())
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>



                                                        </div>


                                                        <div class="col-md-6 col-sm-6 ">
                                                            <div class="form-group">
                                                                <label class="control-label col-md-12 col-sm-12 desp-label" for="ClientHREmail">
                                                                    Client HR
                                                                </label>
                                                                <div class="col-md-12 col-sm-12">
                                                                    <select id="ClientHREmail" name="ClientHREmail" class="form-control multiselect" multiple="multiple">
                                                                        @foreach (var item in Model.Select(x => x.ClientHrContact).Distinct().ToList())
                                                                        {
                                                                            <option value="@item">@item</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>

                                                            <div class="form-group">
                                                                <div>
                                                                    <div class="col-md-12 col-sm-12">


                                                                        <button type="button" id="ResetFilter" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right;margin-left:5px;">
                                                                            <font style="font-size:12px;"> Reset Filter</font>
                                                                        </button>


                                                                        <button type="submit" class="mdc-button mdc-button--raised mdc-ripple-upgraded" style="margin-top: 30px;float:right">
                                                                            <font style="font-size:12px;"> Apply Filter</font>
                                                                        </button>


                                                                    </div>

                                                                </div>
                                                            </div>


                                                        </div>


                                                    </div>

                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                                <div style="overflow-x:scroll" class="scrollbar unassigned-int" id="style-2">

                                    <div id="tableID" class="second">
                                        <table id="meetingTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                    {
                                                        <th>Who Joined</th>
                                                    }
                                                    <th>Candidate Name</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "NeedClarity")
                                                    {
                                                        <th>Candidate Contact</th>
                                                    }

                                                    <th>Candidate Email</th>
                                                    <th>Interviewer</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                    {
                                                        <th>Interviewer Contact</th>
                                                    }
                                                    @if (ViewBag.actionstatus != "NeedClarity")
                                                    {
                                                        <th>Meeting Status</th>
                                                    }
                                                    @if (ViewBag.actionstatus != "UnAttendedZoomLink" && ViewBag.actionstatus != "NeedClarity")
                                                    {
                                                        <th>Interview Status</th>
                                                    }
                                                    <th>Client Name</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                    {
                                                        <th>Client HR</th>
                                                        <th>Client HR Contact</th>
                                                    }
                                                    @if (ViewBag.actionstatus == "QCReport")
                                                    {
                                                        <th>Red Flags</th>
                                                    }
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "InterviewCount")
                                                    {
                                                        <th>Channel Owner</th>
                                                    }
                                                    else
                                                    {
                                                        <th>Co-ordinating HR</th>
                                                    }
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "InterviewCount")
                                                    {
                                                        <th>Action</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>IRF ID</th>
                                                    <th>Interview Date</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                    {
                                                        <th>Who Joined</th>
                                                    }
                                                    <th>Candidate Name</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "NeedClarity")
                                                    {
                                                        <th>Candidate Contact</th>
                                                    }
                                                    <th>Candidate Email</th>
                                                    <th>Interviewer</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                    {
                                                        <th>Interviewer Contact</th>
                                                    }
                                                    @if (ViewBag.actionstatus != "NeedClarity")
                                                    {
                                                        <th>Meeting Status</th>
                                                    }
                                                    @if (ViewBag.actionstatus != "UnAttendedZoomLink" && ViewBag.actionstatus != "NeedClarity")
                                                    {
                                                        <th>Interview Status</th>
                                                    }
                                                    <th>Client Name</th>
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                    {
                                                        <th>Client HR</th>
                                                        <th>Client HR Contact</th>
                                                    }
                                                    @if (ViewBag.actionstatus == "QCReport")
                                                    {
                                                        <th>Red Flags</th>
                                                    }
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "InterviewCount")
                                                    {
                                                        <th>Channel Owner</th>
                                                    }
                                                    else
                                                    {
                                                        <th>Co-ordinating HR</th>
                                                    }
                                                    @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "InterviewCount")
                                                    {
                                                        <th>Action</th>
                                                    }
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {

                                                    <tr id=@item.Interviewid>
                                                        <td title=@item.IRFId> @item.IRFId </td>
                                                        <td> @item.interviewDate </td>
                                                        @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                        {
                                                            <td style="color: #0b8c0b;">
                                                                <div id="section">
                                                                    @if (item.WhoJoined != null && item.WhoJoined != "")
                                                                    {
                                                                        @if (item.WhoJoined.Length > 30)
                                                                        {
                                                                            <div class="article">
                                                                                <p style="margin-bottom:0px;">
                                                                                    @item.WhoJoined.Substring(0, 30)
                                                                                </p>
                                                                                <p class="moretext_@item.Interviewid moretext">
                                                                                    @item.WhoJoined.Substring(30, @item.WhoJoined.Length - 30)
                                                                                </p>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="article">

                                                                                <p>
                                                                                    @item.WhoJoined.Substring(0, @item.WhoJoined.Length)
                                                                                </p>
                                                                            </div>
                                                                        }}
                                                                    else
                                                                    {
                                                                        <div></div>
                                                                    }


                                                                    <a onclick="moreless(@item.Interviewid)" class="moreless-button" value="Readmore" id="read_@item.Interviewid" href="#">Read more</a>


                                                                </div>


                                                            </td>
                                                        }
                                                        <td>@item.candidateName</td>
                                                        @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                        {
                                                            <td>@item.MobileNumber</td>
                                                        }
                                                        @if (ViewBag.actionstatus == "NeedClarity")
                                                        {
                                                            @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                                                            {
                                                                <button class="callcandidatebtn mdc-fab app-fab--absolute" aria-label="Click here to call the candidate">
                                                                    <span onclick="CommonCallButtonClick('@item.candidateName','@item.MobileNumber', '@item.candidateEmail','@item.imid', null, 'Candidate')" data-original-title="Tooltip on top" title="Click here to call the candidate." class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" /></svg></span>
                                                                </button>
                                                            }
                                                        }
                                                        <td> @item.candidateEmail<input type="text" hidden id="txtcandidateemail_@item.imid" value="@item.candidateEmail" /></td>
                                                        @if (@item.interviewer != null || @item.interviewer != "")
                                                        {
                                                            <td>
                                                                @item.interviewer
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                        {
                                                            <td>@item.InterviewerMobileNumber</td>
                                                        }
                                                        @if (ViewBag.actionstatus != "NeedClarity")
                                                        {
                                                            @if (@item.interviewDate > DateTime.Now && item.confirmationStatus.Trim() != "Cancelled")
                                                            {
                                                                <td>Scheduled</td>
                                                            }
                                                            else
                                                            {
                                                                @if (item.MeetingStatusStatusDesc != "0")
                                                                {
                                                                    <td> @item.MeetingStatusStatusDesc</td>
                                                                }
                                                                else
                                                                {
                                                                    <td></td>
                                                                }
                                                            }
                                                        }
                                                        @if (ViewBag.actionstatus != "UnAttendedZoomLink" && ViewBag.actionstatus != "NeedClarity")
                                                        {
                                                            @if (item.intervieweStatusStatDesc != "0")
                                                            {
                                                                <td> @item.intervieweStatusStatDesc</td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                        }
                                                        <td>@item.Name</td>
                                                        @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                        {
                                                            <td>@item.ClientHrContact</td>
                                                            <td>@item.ClientMobileNumber</td>
                                                        }
                                                        @if (ViewBag.actionstatus == "QCReport")
                                                        {
                                                            <td>@item.Redflags</td>
                                                        }
                                                        @if (ViewBag.actionstatus == "UnAttendedZoomLink" || ViewBag.actionstatus == "InterviewCount")
                                                        {
                                                            <td>@item.ChannelOwner</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@item.HRCoordinatorEmailId</td>
                                                        }
                                                        @if (ViewBag.actionstatus == "UnAttendedZoomLink")
                                                        {
                                                            <td class="meeting-detail-icon">
                                                                <button class="mdc-fab app-fab--absolute" aria-label="Edit">
                                                                    <span onclick="javascript:FetchHistory('@item.ZoomMeetingId');" title="Meeting Details" class="mdc-fab__icon material-icons">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-clock-history" viewBox="0 0 16 16">
                                                                            <path d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1 .025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z" />
                                                                            <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0v1z" />
                                                                            <path d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5z" />
                                                                        </svg>
                                                                    </span>
                                                                </button>
                                                            </td>
                                                        }
                                                        @if (ViewBag.actionstatus == "InterviewCount")
                                                        {
                                                            <td class="meeting-detail-icon">
                                                                <span class="interview_4">
                                                                    <button class="mdc-fab app-fab--absolute" aria-label="Interviewing Members">
                                                                        <span onclick="javascript:getIRFMembers('@item.irfIntId');" title="Interviewing Members" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M16.5 12c1.38 0 2.49-1.12 2.49-2.5S17.88 7 16.5 7C15.12 7 14 8.12 14 9.5s1.12 2.5 2.5 2.5zM9 11c1.66 0 2.99-1.34 2.99-3S10.66 5 9 5C7.34 5 6 6.34 6 8s1.34 3 3 3zm7.5 3c-1.83 0-5.5.92-5.5 2.75V19h11v-2.25c0-1.83-3.67-2.75-5.5-2.75zM9 13c-2.33 0-7 1.17-7 3.5V19h7v-2.25c0-.85.33-2.34 2.37-3.47C10.5 13.1 9.66 13 9 13z" /></svg></span>
                                                                    </button>
                                                                </span>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>
</div>

<div id="ZoomMeetingHistory" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="filheader">
                <div class="filavatar">
                    <svg class="publicsharing-icon" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 18 18"><path fill="rgb(255, 255, 255)" d="M9 1C4.58 1 1 4.58 1 9s3.58 8 8 8 8-3.58 8-8-3.58-8-8-8zm0 2.75c1.24 0 2.25 1.01 2.25 2.25S10.24 8.25 9 8.25 6.75 7.24 6.75 6 7.76 3.75 9 3.75zM9 14.5c-1.86 0-3.49-.92-4.49-2.33C4.62 10.72 7.53 10 9 10c1.47 0 4.38.72 4.49 2.17-1 1.41-2.63 2.33-4.49 2.33z" /></svg>
                </div>
                <h5 class="modal-title pull-left">Share/View Details</h5>
            </div>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span onclick="closeZoomMeetingHistory()" id="SharePopUp" style="cursor:pointer;" aria-hidden="true">&times;</span>
            </button>
            <div class="modal-body">
                <div class="col-md-12 ">
                    <div class="zoomMeeting_scroll">
                        <div id="divZoomMeetingHistory" class="pdr-20">
                        </div>
                    </div>
                </div>
                <div class="col-md-12 ">
                    <div class="text-right">
                        <input style="color:#fff;line-height: 13px;" type="button" onclick="closeZoomMeetingHistory()" id="hangUpButton" class="mdc-button mdc-button--raised mdc-ripple-upgraded btn-danger" value="Close">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="interviewerMemberModal" class="modal modal-bg">
    <!-- Modal content -->
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">


            <div class="filheader">
                <div class="filavatar">
                    <span class="publicsharing-icon  fas fa-user-friends" style="font-size:24px;"></span>
                </div>
                <h5 class="modal-title pull-left" id="memberHeading">Interviewer Details</h5>
            </div>
            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                <span aria-hidden="true" id="membersPopUp" style="cursor:pointer;">&times;</span>
            </button>

            <div class="modal-body" id="memberTableBody">
            </div>
        </div>

    </div>
</div>


