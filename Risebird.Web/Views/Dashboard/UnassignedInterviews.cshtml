<script type="text/javascript">

        $(document).ready(function () {

            $("#ResetFilter").click(function () {
                ResetFilter();
            })

            if ('@filter' != "") {

                ApplySessionFilter();
            }
            $("#Status").multiselect({
                includeSelectAllOption: true,
                selectedClass: 'active1',
                buttonWidth: '100%',
                maxHeight: 200
            });



        });

    function ResetFilter() {
        var value=$("#hidactionstatus").val();
        window.location.href = "/Dashboard/ResetUnassignedInterviewsFilter?actionstatus=" + value;

        }
        function ApplySessionFilter() {

            var strtDte = '@strtDte';
            var endDte = '@endDte';
            var status =  @Html.Raw(Json.Serialize(Status));



            $('input[name=StartDate]').val(strtDte);
            $('input[name=EndDate]').val(endDte);
            $("#Status").val(status);

            var form = $("#form").serialize();

        }




</script>


<script>
    $(document).ready(function () {
        $('#meetingTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],

            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            },
            "fnInitComplete": function () {
                $(".dataTables_filter input:eq(0)").after("<button style=display:none; type=button id=x>x</button>");
                $(".dataTables_filter").keyup(function (e) {
                    if ($(this).val() != "") {
                        $("#x").hide();

                    }
                    else { $("#x").hide(); }
                });
            }

        });


        var table = $('#meetingTable').DataTable();


    });







    $(document).ready(function () {

        $("#x").click(function (e) {
            $(".dataTables_filter input").val('');
            $(this).hide();
        });

    });

</script>

<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#meetingTable").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#meetingTable").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#meetingTable").show();
        }, 2000);
    };
    //// script for loader ends here
</script>






