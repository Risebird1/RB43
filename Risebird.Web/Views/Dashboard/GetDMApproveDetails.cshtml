@model List<Risebird.Entities.ViewModel.MeetingVM>
@{
    ViewData["Title"] = "GetDMApproveDetails";
}
<script>
    var Header = "<div>DM Approve</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<style>
    .swal2-popup .swal2-title {
        font-size: 1.5em !important;
        text-transform: none !important;
        font-weight: 400 !important;
        line-height: 28px;
    }
</style>

<div class="main-panel" id="main-panel">
    <div>
        <div class="mobile-view"> 
        <div class="pt30">
            <div class="col-md-12 nopad" style="margin: 0px 0px 10px 0px;padding: 0px 0px !important;">

                <div class="card-header bg-w clearfix">
                    <div class="pull-left">

                        <a style="visibility:hidden" data-toggle="chardinjs" data-position="left"></a>
                        <h4 class="card-title"></h4>
                        <h4 class="card-title">BlackList Company</h4>
                    </div>
                    

                </div>
            </div>
        </div>
        </div>
        <div class="content client">
            <div class="row bl-bg">
                <div class="col-md-12">
                    <div class="mdc-card card bl-bg">
                        <div class="mdc-card-wrapper__text-section">
                            <div class="loader text-center">
                                @* <img src="~/Newassets/img/lazyload.gif" /> *@
                            </div>

                            <div style="overflow-x:scroll" class="scrollbar">
                                <div id="tableID" class="second">
                                    <table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Skill Channel</th>
                                                <th>JD Title</th>
                                                <th>Channel Owner</th>
                                                <th>Client Name</th>
                                                <th>DM Approved By</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                  <th>Skill Channel</th>
                                                <th>JD Title</th>
                                                <th>Channel Owner</th>
                                                <th>Client Name</th>
                                                <th>DM Approved By</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>

                                            @if (Model != null && Model.Count() > 0)
                                            {
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.JDTiltle</td>
                                                        <td>@item.ChannelOwner</td>
                                                        <td>@item.ClientName</td>
                                                        <td>@item.DMApprovedBy</td>
                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- end content-->

        </div>
        <!--  end card  -->
    </div>
    <!-- end col-md-12 -->
</div>
<script>
    $(document).ready(function () {

        applyDataTable();
    });
    function applyDataTable() {
        $('#detailsTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
    </Script>

