@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
@using Risebird.Entities.Data;
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Potentially Pausable & Paused Skill Channel";
}
<script>
    var Header = "<div>Potentially Pause</div>";
    $('#txtpageHeader').empty().html(Header);
</script>

<div class="main-panel">
    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">

                <div class="pull-right client-ms">
                    @if (ViewBag.ReturnBack == 1)
                    {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("EmergencyDashboard", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>

                    }
                    else
                    {
                        <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                            <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                        </button>
                    }
                </div>


                <div>
                    @if (ViewBag.ColdCandidateValue == 0)
                    {
                        <div class="feedback-tab-ac" onclick="Changeurldetails(0,'@ViewBag.ReturnBack')"><strong>Potentially Pausable Skill Channel</strong></div>
                        <div class="feedback-tab" onclick="Changeurldetails(1,'@ViewBag.ReturnBack')"><strong>Paused Skill Channel</strong></div>

                    }
                    else if (ViewBag.ColdCandidateValue == 1)
                    {
                        <div class="feedback-tab" onclick="Changeurldetails(0,'@ViewBag.ReturnBack')"><strong>Potentially Pausable Skill Channel</strong></div>
                        <div class="feedback-tab-ac" onclick="Changeurldetails(1,'@ViewBag.ReturnBack')"><strong>Paused Skill Channel</strong></div>

                    }



                </div>
            </div>
        </div>
    </div>
    <div class="content client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">
                                <div class="scrollbar int-table" id="style-2">
                                    <div id="tableID" class="second ">
                                        <table id="PotentialPausedTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Last Interview Date</th>
                                                    <th>Candidate</th>
                                                    <th>Total Candidate</th>
                                                    <th>Total Completed Interview</th>
                                                 
                                                   @*  <th>Meeting Status</th>
                                                    <th>Interview Status</th> *@
                                                    <th>JD Title</th>
                                                    <th>Channel Owner</th>
                                                    <th>Billing Owner</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>Skill Channel</th>
                                                    <th>Last Interview Date</th>
                                                    <th>Candidate</th>
                                                    <th>Total Candidate</th>
                                                    <th>Total Completed Interview</th>
                                       
                                                    @* <th>Meeting Status</th>
                                                    <th>Interview Status</th> *@
                                                    <th>JD Title</th>
                                                    <th>Channel Owner</th>
                                                    <th>Billing Owner</th>
                                                    <th>Action</th>
                                                </tr>
                                            </tfoot>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@item.IRFId</td>
                                                        <td>@item.interviewDate</td>
                                                        <td>@item.candidateEmail</td>
                                                        <td class="text-center">
                                                            <span style="background: #abceea;color: #fff;width: 32px !important;height: 31px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size: 12px;text-align: center;cursor: pointer;">@item.TotalCandidate</span>
                                                        </td>
                                                        <td class="text-center"><span style="background: #aae4b9d4;color: #fff;width: 32px !important;height: 31px !important;display: inline-block;border-radius: 100%;line-height: 32px;font-size: 12px;text-align: center;cursor: pointer;">@item.TotalCompletedInterview</span></td>
                                                        
                                                        @* <td>@item.MeetingStatusStatusDesc</td>
                                                        <td>@item.intervieweStatusStatDesc</td> *@
                                                        <td>@item.JDTiltle</td>
                                                    
                                                        <td>@item.ChannelOwner</td>
                                                        <td>@item.BillingOwner</td>
                                                        <td class="text-center">
                                                          @if(item.IsPaused)
                                                            {
                                                                @if (ViewBag.Profile == "Admin")
                                                                {

                                                                    <button class="btn btn-primary shadow btn-xs sharp me-1" onclick="PlayIRF('@item.irfIntId', '@item.IRFId');" title="Play" style="width:23px!important;height:23px!important; background:#289b0b70 !important; border-color:#289b0b70 !important">
                                                                            <svg style="position:relative;top:-1px;left:-1px;" fill="#fff" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></button>
                                                                }

                                                            }
                                                            else
                                                            {
                                                                @if (ViewBag.Profile == "Admin" || ViewBag.Profile == "SupportAdmin" || ViewBag.Profile == "SeniorHR")
                                                                {
                                                                  @*  <div style="width:100%;float:left;clear:both;" class="dropdown-content-menu" onclick="PauseIRF('@item.irfIntId', '@item.IRFId');" title="Pause">
                                                                        <i class='fa-solid fa-circle-pause' style='color: red'></i>Pause
                                                                    </div>*@
                                                                    <button class="btn btn-primary shadow btn-xs sharp me-1" aria-label="Pause" style="width:23px!important;height:23px!important; background:#c8300ab8!important; border-color:#c8300ab8!important">
                                                                        <span onclick="PauseIRF('@item.irfIntId', '@item.IRFId');" title="Pause">
                                                                            <svg style="color: white;position:relative;left:-1px;top:-1px;left:-2px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pause-fill" viewBox="0 0 16 16"> <path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z" fill="white"></path> </svg>
                                                                        </span>
                                                                    </button>

                                                                }
                                                                <button class="btn shadow btn-xs sharp me-1" aria-label="Candidates List" style="width:23px!important;height:23px!important;background:#eea4349e;border-color:#f1c681">
                                                                <span onclick="javascript:Candidates('@item.irfIntId', '@item.IRFId');" title="Candidates List">
                                                                    <span class="fa fa-list" style="color:#fff;position:relative;top:0px;left:1px;font-size:12px;"></span>
                                                                </span>
                                                            </button>
   

                                                                    <button class="btn btn-primary shadow btn-xs sharp me-1" href="@Url.Action("InterviewerStatsAndRatings", "Interviewer", new {irfId = item.irfIntId, irfName = item.IRFId})" target="_blank" style="width:23px!important;height:23px!important;background-color:#c0c068b0!important;border-color:#c0c068b0!important">
                                                                    <svg fill="#fff" style="position:relative;top: -3px;left: -2px;margin-right: 7px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><path d="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" /></svg>
                                                                </button>
                                                          

                                                                <button class="btn btn-primary  shadow btn-xs sharp me-1" aria-label="Not Scheduled Candidate" style="width:23px!important;height:23px!important;">
                                                                    <span onclick="javascript:NotScheduledCandidate('@item.IRFId');" style="font-weight:400;display:flex;width:100%;transform:none;" title="Not Scheduled Candidate">

                                                                        <i class='fa fa-calendar-times-o' style="color:#fff"></i>
                                                                    </span>
                                                            </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        applyDataTable();
    });
    function applyDataTable() {
        $('#PotentialPausedTable').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
    }


    function PauseIRF(irfId, irfName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The IRF {" + irfName + "} will be paused!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, pause it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/PauseIRF?irfId=' + irfId + '&irfName=' + irfName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {

                            swal.fire("Error pausing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Paused!',
                    type: 'success',
                    html: '<p>IRF has been paused.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Dashboard/PotentialPausedDetails";
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been paused!',
                    'error'
                )
            }
        })       
    }


    function PlayIRF(irfId, irfName) {

        swal.fire({
            title: 'Are you sure?',
            text: "The IRF {"+irfName+"} will be enabled!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, play it!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        url: '/IRF/PlayIRF?irfId=' + irfId + '&irfName=' + irfName,
                        success: function (result) {
                            resolve(result)

                        },
                        error: function () {

                            swal.fire("Error playing!", "Please try again", "error");
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Played!',
                    type: 'success',
                    html: '<p>IRF {'+irfName+'} has been enabled.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    window.location = "/Dashboard/PotentialPausedDetails?type=" + 1;
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'IRF has not been enabled! :)',
                    'error'
                )
            }
        })
        
    }

    function Candidates(id, IRFid) {

        var url = '/Candidate/GetCandidates?id=' + id + '&irfName=' + IRFid;
        window.location.href = url;
    }
    function NotScheduledCandidate(IRFId) {
        window.location.href = "/IRF/NotScheduledCandidate?IRFId=" + IRFId;
    }

    function Changeurldetails(type,returnBack) {
        window.location.href = "/Dashboard/PotentialPausedDetails?type=" + type + "&returnBack=" + 1;
    }
</script>


