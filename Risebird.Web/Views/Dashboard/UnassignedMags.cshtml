<style>
    .bc-modal-overlay { position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,.45); z-index:1050; display:none; justify-content:center; align-items:flex-start; padding:40px 16px; }
    .bc-modal { background:#fff; border-radius:12px; width:100%; max-width:960px; max-height:calc(100vh - 80px); display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,.2); }
    .bc-modal-hdr { padding:16px 24px; border-bottom:1px solid #e2e8f0; display:flex; align-items:center; gap:12px; flex-shrink:0; }
    .bc-modal-hdr h5 { margin:0; font-weight:700; font-size:15px; flex:1; }
    .bc-modal-body { flex:1; overflow-y:auto; padding:20px 24px; }
    .bc-modal-close { background:none; border:none; font-size:20px; color:#94a3b8; cursor:pointer; padding:4px 8px; border-radius:6px; }
    .bc-modal-close:hover { background:#f1f5f9; color:#475569; }

    .bc-stat-row { display:flex; gap:16px; flex-wrap:wrap; margin-bottom:16px; }
    .bc-stat-card { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 16px; text-align:center; flex:1; min-width:80px; }
    .bc-stat-card .val { font-weight:700; font-size:18px; }
    .bc-stat-card .lbl { font-size:10px; text-transform:uppercase; letter-spacing:.04em; color:#64748b; }

    .bc-action-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
    .bc-btn { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; padding:7px 14px; border-radius:7px; border:1px solid #e2e8f0; background:#fff; color:#475569; cursor:pointer; transition:all .12s; }
    .bc-btn:hover { background:#f8fafc; border-color:#cbd5e1; }
    .bc-btn:disabled { opacity:.5; cursor:not-allowed; }
    .bc-btn-primary { background:#0d6efd; color:#fff; border-color:#0d6efd; }
    .bc-btn-primary:hover { background:#0b5ed7; }
    .bc-btn-outline { background:#fff; color:#475569; }
    .bc-btn-danger { background:#fff; color:#dc3545; border-color:#fecaca; }
    .bc-btn-danger:hover { background:#fef2f2; }
    .bc-btn .badge { font-size:10px; padding:2px 6px; border-radius:4px; background:rgba(255,255,255,.25); }

    .bc-tabs { display:flex; gap:4px; margin-bottom:12px; border-bottom:1px solid #e2e8f0; padding-bottom:0; }
    .bc-tab-btn { font-size:12px; font-weight:500; padding:7px 16px; border:none; background:transparent; color:#64748b; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
    .bc-tab-btn.active { color:#0d6efd; border-bottom-color:#0d6efd; font-weight:600; }
    .bc-tab-panel { display:none; }
    .bc-tab-panel.active { display:block; }

    .bc-tbl { font-size:12px; margin-bottom:0; }
    .bc-tbl th { font-size:10.5px; text-transform:uppercase; letter-spacing:.04em; color:#64748b; font-weight:600; padding:8px 10px; background:#f8fafc; position:sticky; top:0; z-index:2; white-space:nowrap; }
    .bc-tbl td { padding:7px 10px; vertical-align:middle; }
    .bc-tbl-wrap { max-height:350px; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; }

    .bc-call-dot { width:7px; height:7px; border-radius:50%; display:inline-block; margin-right:5px; }
    .bc-status-none .bc-call-dot { background:#e2e8f0; }
    .bc-status-ok .bc-call-dot { background:#22c55e; }
    .bc-status-prog .bc-call-dot { background:#3b82f6; }
    .bc-status-fail .bc-call-dot { background:#ef4444; }
    .bc-status-warn .bc-call-dot { background:#f59e0b; }

    .bc-intent { font-weight:600; font-size:11px; padding:2px 8px; border-radius:10px; display:inline-block; }
    .bc-intent-available { background:#dcfce7; color:#166534; }
    .bc-intent-not_available { background:#fee2e2; color:#991b1b; }
    .bc-intent-unsubscribe { background:#fef3c7; color:#92400e; }
    .bc-intent-no_answer { background:#e2e8f0; color:#475569; }

    .bc-progress-log { max-height:200px; overflow-y:auto; font-size:11px; font-family:Consolas,monospace; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px; margin-top:10px; }
    .bc-hist-tbl { font-size:12px; }
    .bc-hist-tbl th { font-size:10.5px; text-transform:uppercase; letter-spacing:.04em; color:#64748b; font-weight:600; padding:6px 10px; background:#f8fafc; }
    .bc-hist-tbl td { padding:6px 10px; }

    .bc-pagination { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:8px 12px; background:#f8fafc; border-top:1px solid #e2e8f0; font-size:11.5px; }

    .btn-call-single-m { font-size:11px; padding:2px 7px; border-radius:5px; white-space:nowrap; border:1px solid #e2e8f0; color:#64748b; background:#fff; cursor:pointer; }
    .btn-call-single-m:hover { background:#f8fafc; border-color:#cbd5e1; }
    .btn-call-single-m.calling { pointer-events:none; opacity:.5; }
</style>

