@model IEnumerable<Risebird.Entities.ViewModel.AssignmentVM>
@using Risebird.Entities
@using Newtonsoft.Json;
@using Microsoft.AspNetCore.Http
@using Risebird.Entities.ViewModel
@using Risebird.Entities.Enum
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "MAGs for Unassigned Interviews";
    ViewBag.PageHeader = "MAGs for Unassigned Interviews";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="~/Newassets/css/interview.css?v=2024" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/Newassets/css/dashboard-new.css?v=2024" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .select2-container--default .select2-results__option {
        padding-right: 20px;
        vertical-align: middle;
    }

        .select2-container--default .select2-results__option:before {
            content: "";
            display: inline-block;
            position: relative;
            height: 20px;
            width: 20px;
            border: 2px solid #e9e9e9;
            border-radius: 4px;
            background-color: #fff;
            margin-right: 10px;
            vertical-align: middle;
        }

        .select2-container--default .select2-results__option[aria-selected=true]:before {
            content: "✓";
            color: #fff;
            background-color: #007bff;
            border: 0;
            display: inline-block;
            padding: 0;
            line-height: 1.2;
            text-align: center;
        }

    .select2-container--default .select2-results__option--highlighted[aria-selected] {
        background-color: #eee;
        color: #000;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
    }

    .select2-container--default .select2-selection--multiple {
        border: 1px solid #ced4da;
        min-height: 38px;
    }
</style>

<div class="main-panel" id="main-panel">

    <div class="pt30">
        <div class="col-md-12 nopad" style="margin:0px;">
            <div class="card-header bg-w clearfix">
                <div class="pull-left">
                    <h4 class="card-title"></h4>
                    <div class="mobile-view"> <h4 class="card-title">MAGs for Unassigned Interviews</h4></div>
                </div>

                <div class="pull-right">
                    <div>
                        @* <button class="mdc-button mdc-button--outlined inline-demo-button mdc-ripple-upgraded card-title-space" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <span class="mdc-button__label"><span class="fa fa-filter" data-toggle="tooltip" data-placement="top" title="Filter" data-original-title="Filter"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Filter</font></span></span>
                            <div class="mdc-button__ripple"></div>
                        </button> *@

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="content  client">
        <div class="row bl-bg">
            <div class="col-md-12">
                <div class="mdc-card card bl-bg">
                    <div class="mdc-card-wrapper__text-section">
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">

                            <div class="toolbar">

                                <div>

                                    <div id="tableID" class="second" style="overflow-x:scroll">
                                        <table id="id_table_magList" class="table table-striped table-bordered dt-responsive journey" cellspacing="0" width="100%">
                                            <thead>
                                                <tr>
                                                    <th>MAG Name</th>
                                                    <th>Total Unassigned</th>
                                                    <th>Last triggered At</th>
                                                    <th>Last triggered By</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>MAG Name</th>
                                                    <th>Total Unassigned</th>
                                                    <th>Last triggered At</th>
                                                    <th>Last triggered By</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {

                                                        <tr>

                                                            <td>@item.AssessmentGroup</td>

                                                            <td>@item.NoOfUnassigned</td>

                                                            @if (item.MAGLinkEmailTriggeredOn.HasValue)
                                                            {
                                                                <td>@item.MAGLinkEmailTriggeredOn.Value</td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }

                                                            @if (!string.IsNullOrEmpty(item.MAGLinkEmailTriggeredBy))
                                                            {
                                                                <td>@item.MAGLinkEmailTriggeredBy</td>
                                                            }
                                                            else
                                                            {
                                                                <td></td>
                                                            }
                                                            <td>
                                                                <button class="btn shadow btn-xs sharp me-1" aria-label="Send Mag Application Links" style="width:23px!important;height:23px!important;background: #f6c363d9 !important;position:relative;left: 25px;border-color: #f6c363d9!important;">
                                                                    <span onclick="javascript:SendMagApplicationLinks('@item.id', '@item.AssessmentGroup');" title="Delete" class="mdc-fab__icon material-icons">
                                                                        <svg style="position:relative;left:-6px;top:-2px;" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail">
  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
  <path d="M3 7l9 6l9 -6" />
</svg>

                                                                    </span>
                                                                </button>

                                                            </td>


                                                        </tr>


                                                    }
                                                }

                                            </tbody>

                                        </table>





                                    </div>
                                </div>


                            </div>
                            <!-- end content-->
                        </div>

                        <!-- end col-md-12 -->
                    </div>




                    <!-- end row -->
                </div>

            </div>
        </div>


    </div>


</div>

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        $(document).ready(function () {
            my_code();
        });
        function my_code() {
            var msg = '@ViewBag.Message';
            if (msg.toLowerCase().includes("success")) {
                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}

<script>
    $(document).ready(function () {

        applyDataTable();
    });
    function applyDataTable() {
        $('#id_table_magList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>
<script>

    function SendMagApplicationLinks(agId, agName) {
        debugger;
        swal.fire({
            title: 'Are you sure?',
            text: 'Want to send MAG links for AG ' + agName + ' to all applicable interviewers?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, send!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        type: "POST",
                        url: "/IRF/SendMagApplicationLinks",
                        data: { 'agId' : agId, 'agName' : agName },
                        success: function (result) {
                            resolve(result);
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Sent!',
                    type: 'success',
                    html: '<p>Application links have been sent to the Interviewers.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled! :)',
                    'error'
                )
            }
        })
    }

</script>
