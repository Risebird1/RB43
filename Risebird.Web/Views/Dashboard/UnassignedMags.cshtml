                                                    <th>Total Unassigned</th>
                                                    <th>Last triggered At</th>
                                                    <th>Last triggered By</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </thead>
                                            <tfoot>
                                                <tr>
                                                    <th>MAG Name</th>
                                                    <th>Total Unassigned</th>
                                                    <th>Last triggered At</th>
                                                    <th>Last triggered By</th>
                                                    <th>Actions</th>

                                                </tr>
                                            </tfoot>
                                            <tbody>

                                                @if (Model != null && Model.Count() > 0)
                                                {
                                                    foreach (var item in Model)
                                                    {

                                                        <tr>

                                                            <td>@item.AssessmentGroup</td>

