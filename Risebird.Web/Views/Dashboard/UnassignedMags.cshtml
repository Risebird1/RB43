                                                                    <span onclick="javascript:SendMagApplicationLinks('@item.id', '@item.AssessmentGroup');" title="Send Mag Application Links" class="mdc-fab__icon material-icons">
                                                                        <svg style="position:relative;left:-6px;top:-2px;" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail">
  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
  <path d="M3 7l9 6l9 -6" />
</svg>

                                                                    </span>
                                                                </button>
                                                                
                                                                <button class="btn shadow btn-xs sharp me-1" aria-label="Interviewers List" style="width:25px!important;height:25px!important;position:relative; background: #7e97bab3!important; border: 1px #7e97bab3!important;">
