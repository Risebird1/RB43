                swal.fire("Successful", '@ViewBag.Message', "success");
            }
            else {
                swal.fire("Failed", '@ViewBag.Message', "error");
            }

        }

        //window.onload = my_code();
    </script>
}

<script>
    $(document).ready(function () {

        applyDataTable();
    });
    function applyDataTable() {
        $('#id_table_magList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            order: [],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }
        });
    }
</script>
<script>

    var bcToken = '', bcCurrentMag = '', bcStopRequested = false, bcCurrentLogId = 0;
    var bcOutcomePage = 1, bcOutcomeSize = 25, bcOutcomeTotal = 0;

    $(function () {
        bcToken = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val() || '';
    });

    function esc(s) { return $('<span>').text(s || '').html(); }

    $(document).on('click', '.btn-batch-call-mag', function (e) {
        e.stopPropagation();
        var magName = $(this).attr('data-mag-name');
        var agName = $(this).attr('data-ag-name');
        if (!magName) { alert('MAG name not available.'); return; }
        openBatchCallModal(magName, agName);
    });

    function openBatchCallModal(magName, agName) {
        bcCurrentMag = magName;
        bcStopRequested = false;
        bcCurrentLogId = 0;
        bcOutcomePage = 1;
        $('#bcModalTitle').text('Availability Batch Call — ' + (agName || magName));
        $('#bcModalOverlay').css('display', 'flex');
        $('body').css('overflow', 'hidden');
        loadModalStats(magName);
        loadModalOutcomes(magName, 1);
        loadModalHistory(magName);
        $('#bcTabs .bc-tab-btn').first().click();
    }

    $('#bcModalClose').on('click', function () {
        $('#bcModalOverlay').hide();
        $('body').css('overflow', '');
    });
    $('#bcModalOverlay').on('click', function (e) {
        if (e.target === this) { $('#bcModalOverlay').hide(); $('body').css('overflow', ''); }
    });

    $(document).on('click', '.bc-tab-btn', function () {
        var tab = $(this).attr('data-tab');
        $('.bc-tab-btn').removeClass('active');
        $(this).addClass('active');
        $('.bc-tab-panel').removeClass('active');
        $('#bcPanel' + tab.charAt(0).toUpperCase() + tab.slice(1)).addClass('active');
    });

    function loadModalStats(magName) {
        $('#bcStats').html('<div class="text-center text-muted w-100 py-2"><div class="spinner-border spinner-border-sm"></div></div>');
        $('#bcActions').empty();
        $.ajax({
            url: '/InterviewerAvailability/GetBatchCallMAGs', type: 'GET',
            data: { page: 1, pageSize: 1, search: magName },
            success: function (res) {
                if (!res.success || !res.mags || !res.mags.length) {
                    $('#bcStats').html('<div class="text-muted" style="font-size:12px;">No data found for this MAG.</div>');
                    return;
                }
                var m = res.mags[0];
                var html = '<div class="bc-stat-card"><div class="val">' + m.totalInterviewers + '</div><div class="lbl">Total</div></div>' +
                    '<div class="bc-stat-card"><div class="val text-primary">' + m.callableCount + '</div><div class="lbl">With Phone</div></div>' +
                    '<div class="bc-stat-card"><div class="val">' + m.alreadyCalled + '</div><div class="lbl">Called</div></div>' +
                    '<div class="bc-stat-card"><div class="val text-success">' + m.available + '</div><div class="lbl">Available</div></div>' +
                    '<div class="bc-stat-card"><div class="val text-danger">' + m.notAvailable + '</div><div class="lbl">Unavailable</div></div>';
                $('#bcStats').html(html);

                var uncalled = m.uncalledCount || 0;
                var btns = '';
                if (uncalled > 0)
                    btns += '<button class="bc-btn bc-btn-primary" id="bcBtnCallUncalled" data-only-uncalled="true"><i class="fas fa-phone-alt"></i> Call Uncalled <span class="badge">' + uncalled + '</span></button>';
                if (m.callableCount > 0 && m.alreadyCalled > 0)
                    btns += '<button class="bc-btn bc-btn-outline" id="bcBtnRecallAll" data-only-uncalled="false"><i class="fas fa-redo-alt"></i> Recall All <span class="badge bg-secondary text-white">' + m.callableCount + '</span></button>';
                else if (m.callableCount > 0 && uncalled === 0)
                    btns += '<button class="bc-btn bc-btn-outline" id="bcBtnRecallAll" data-only-uncalled="false"><i class="fas fa-redo-alt"></i> Call All <span class="badge bg-secondary text-white">' + m.callableCount + '</span></button>';
                if (!btns) btns = '<span class="text-muted" style="font-size:12px;"><i class="fas fa-ban me-1"></i>No callable interviewers</span>';
                $('#bcActions').html(btns);
            },
            error: function () { $('#bcStats').html('<div class="text-danger" style="font-size:12px;">Failed to load stats.</div>'); }
        });
    }

    $(document).on('click', '#bcBtnCallUncalled, #bcBtnRecallAll', function () {
        var onlyUncalled = $(this).attr('data-only-uncalled') === 'true';
        var label = onlyUncalled ? 'uncalled' : 'all callable';
        if (!confirm('Trigger availability calls to ' + label + ' interviewers under "' + bcCurrentMag + '"?')) return;
        startModalBatchCall(bcCurrentMag, onlyUncalled);
    });

    function startModalBatchCall(magName, onlyUncalled) {
        bcStopRequested = false;
        bcCurrentLogId = 0;
        $('#bcBtnCallUncalled, #bcBtnRecallAll').prop('disabled', true);
        $('#bcTabProgress').show().click();

        var $panel = $('#bcPanelProgress');
        $panel.html(
            '<div class="d-flex align-items-center justify-content-between mb-2">' +
                '<strong>' + esc(magName) + ' <span class="text-muted fw-normal" style="font-size:12px;">(' + (onlyUncalled ? 'uncalled only' : 'all callable') + ')</span></strong>' +
                '<button class="bc-btn bc-btn-danger" id="bcBtnStop"><i class="fas fa-stop"></i> Stop</button>' +
            '</div>' +
            '<div class="progress mb-2" style="height:8px;border-radius:8px;"><div class="progress-bar progress-bar-striped progress-bar-animated bg-info" id="bcPB" style="width:0%;border-radius:8px;"></div></div>' +
            '<div class="text-muted mb-1" style="font-size:12px;" id="bcPBCount">Fetching interviewers...</div>' +
            '<div class="bc-progress-log" id="bcProgressLog"></div>' +
            '<div id="bcDone" style="display:none;" class="text-center mt-3"><div class="alert alert-info py-2 px-3 mb-0" style="font-size:12.5px;border-radius:8px;"><i class="fas fa-check-circle me-1"></i><span id="bcSummary"></span></div></div>'
        );

        $('#bcBtnStop').on('click', function () { bcStopRequested = true; $(this).prop('disabled', true).text('Stopping...'); });

        $.ajax({
            url: '/InterviewerAvailability/GetCallableInterviewersForMAG', type: 'GET',
            data: { magName: magName, onlyUncalled: onlyUncalled },
            success: function (res) {
                if (!res.success || !res.interviewers || !res.interviewers.length) {
                    bcLog('No ' + (onlyUncalled ? 'uncalled ' : '') + 'callable interviewers found.', 'skip');
                    finishModalBatch(0, 0, 0, magName);
                    return;
                }
                var interviewers = res.interviewers;
                $('#bcPBCount').text('0 / ' + interviewers.length);
                bcLog('Starting batch: ' + interviewers.length + ' interviewer(s)', 'ok');
                $.ajax({
                    url: '/InterviewerAvailability/StartBatchCallLog', type: 'POST',
                    data: { __RequestVerificationToken: bcToken, magName: magName, totalInterviewers: interviewers.length },
                    success: function (lr) { bcCurrentLogId = lr.logId || 0; },
                    error: function () { bcLog('Warning: failed to create batch log', 'skip'); },
                    complete: function () { processModalBatch(interviewers, 0, 0, 0, 0, magName); }
                });
            },
            error: function () { bcLog('Failed to fetch interviewers.', 'err'); finishModalBatch(0, 0, 0, magName); }
        });
    }

    function processModalBatch(interviewers, idx, ok, err, skip, magName) {
        if (bcStopRequested || idx >= interviewers.length) { finishModalBatch(ok, err, skip, magName); return; }
        var p = interviewers[idx], total = interviewers.length;
        $('#bcPB').css('width', Math.round((idx / total) * 100) + '%');
        $('#bcPBCount').text((idx + 1) + ' / ' + total);
        var srcTag = p.source === 'Profile' ? ' [Profile]' : '';
        bcLog('<strong>#' + p.id + '</strong> ' + (p.interviewerName || 'Unknown') + srcTag + ' (' + (p.phone || '') + ') — calling...', '');
        $.ajax({
            url: '/InterviewerAvailability/BatchCallSingle', type: 'POST',
            data: { __RequestVerificationToken: bcToken, id: p.id, source: p.source || 'EA', magName: magName },
            success: function (res) {
                if (res.success) { bcLog('&nbsp;&nbsp;\u2714 Call triggered' + (res.conversationId ? ' [' + res.conversationId + ']' : ''), 'ok'); ok++; }
                else { bcLog('&nbsp;&nbsp;\u2718 Failed: ' + (res.error || ''), 'err'); err++; }
                setTimeout(function () { processModalBatch(interviewers, idx + 1, ok, err, skip, magName); }, 1200);
            },
            error: function () { bcLog('&nbsp;&nbsp;\u2718 Request failed', 'err'); err++; setTimeout(function () { processModalBatch(interviewers, idx + 1, ok, err, skip, magName); }, 1200); }
        });
    }

    function finishModalBatch(ok, err, skip, magName) {
        $('#bcPB').css('width', '100%').removeClass('progress-bar-animated');
        $('#bcBtnCallUncalled, #bcBtnRecallAll').prop('disabled', false);
        var summary = ok + ' triggered';
        if (skip > 0) summary += ', ' + skip + ' skipped';
        if (err > 0) summary += ', ' + err + ' failed';
        $('#bcSummary').text(summary);
        $('#bcDone').show();
        bcLog('Batch complete: ' + summary, 'ok');
        if (bcCurrentLogId > 0) {
            $.ajax({
                url: '/InterviewerAvailability/CompleteBatchCallLog', type: 'POST',
                data: { __RequestVerificationToken: bcToken, logId: bcCurrentLogId, succeeded: ok, failed: err, skipped: skip, status: bcStopRequested ? 'Stopped' : 'Completed' }
            });
        }
        loadModalOutcomes(magName, 1);
        loadModalHistory(magName);
        loadModalStats(magName);
    }

    function bcLog(msg, type) {
        var $log = $('#bcProgressLog');
        $log.append('<div style="padding:2px 0;border-bottom:1px solid #f1f5f9;"><span style="color:#94a3b8;margin-right:6px;">' + new Date().toLocaleTimeString() + '</span>' + msg + '</div>');
        $log.scrollTop($log[0].scrollHeight);
    }

    function loadModalOutcomes(magName, page) {
        page = page || bcOutcomePage;
        bcOutcomePage = page;
        var $panel = $('#bcPanelOutcomes');
        $panel.html('<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading outcomes...</div>');
        $.ajax({
            url: '/InterviewerAvailability/GetInterviewerCallOutcomes', type: 'GET',
            data: { magName: magName, page: page, pageSize: bcOutcomeSize },
            success: function (res) {
                if (!res.success || !res.interviewers || !res.interviewers.length) {
                    $panel.html('<div class="text-center text-muted py-3" style="font-size:12px;"><i class="fas fa-users-slash me-1"></i>No interviewers found.</div>');
                    return;
                }
                bcOutcomeTotal = res.totalCount || 0;
                var totalPages = Math.max(1, Math.ceil(bcOutcomeTotal / bcOutcomeSize));
                var first = (page - 1) * bcOutcomeSize + 1;
                var last = Math.min(page * bcOutcomeSize, bcOutcomeTotal);

                var html = '<div class="bc-tbl-wrap"><table class="table table-hover bc-tbl"><thead><tr>' +
                    '<th>Source</th><th>#</th><th>Name</th><th>Phone</th><th>Exp</th><th>Call Status</th>' +
                    '<th>Intent</th><th>Assign Help</th><th>Callback</th><th>Duration</th><th>Called At</th><th>Notes</th><th>Action</th>' +
                    '</tr></thead><tbody>';
                $.each(res.interviewers, function (_, p) {
                    html += buildOutcomeRowM(p, magName);
                });
                html += '</tbody></table></div>';
                html += '<div class="bc-pagination">' +
                    '<span style="font-size:11.5px;color:#64748b;">Showing <strong>' + first + '–' + last + '</strong> of <strong>' + bcOutcomeTotal + '</strong></span>' +
                    '<div class="d-flex align-items-center gap-2">' +
                        '<button class="btn btn-sm btn-outline-secondary bc-out-pg" data-page="' + (page - 1) + '"' + (page <= 1 ? ' disabled' : '') + '><i class="fas fa-angle-left"></i></button>' +
                        '<span style="font-size:11.5px;" class="px-1">Page ' + page + ' / ' + totalPages + '</span>' +
                        '<button class="btn btn-sm btn-outline-secondary bc-out-pg" data-page="' + (page + 1) + '"' + (page >= totalPages ? ' disabled' : '') + '><i class="fas fa-angle-right"></i></button>' +
                    '</div></div>';
                $panel.html(html);
            },
            error: function () { $panel.html('<div class="text-center text-danger py-3" style="font-size:12px;">Failed to load outcomes.</div>'); }
        });
    }

    $(document).on('click', '.bc-out-pg', function () {
        if ($(this).prop('disabled')) return;
        var pg = parseInt($(this).attr('data-page'), 10);
        if (pg > 0) loadModalOutcomes(bcCurrentMag, pg);
    });

    function buildOutcomeRowM(p, magName) {
        var src = (p.source || 'EA').toString();
        var srcBadge = src === 'Profile'
            ? '<span style="font-size:10px;font-weight:600;padding:3px 7px;border-radius:5px;background:#fafafa;color:#57534e;border:1px solid #e7e5e4;"><i class="fas fa-user" style="margin-right:3px;"></i>Profile</span>'
            : '<span style="font-size:10px;font-weight:600;padding:3px 7px;border-radius:5px;background:#f8fafc;color:#475569;border:1px solid #e2e8f0;"><i class="fas fa-envelope" style="margin-right:3px;"></i>Email</span>';

        var statusHtml = fmtCallStatus(p.plivoCallStatus);
        var intentCls = '', intentText = p.plivoIntent || '—';
        if (intentText === 'available') { intentCls = 'bc-intent-available'; intentText = 'Available'; }
        else if (intentText === 'not_available') { intentCls = 'bc-intent-not_available'; intentText = 'Not Available'; }
        else if (intentText === 'unsubscribe') { intentCls = 'bc-intent-unsubscribe'; intentText = 'Unsubscribe'; }
        else if (intentText === 'no_answer') { intentCls = 'bc-intent-no_answer'; intentText = 'No Answer'; }

        var assignHelp = p.plivoAssignmentHelp === true ? '<span style="font-size:10px;font-weight:500;padding:2px 6px;border-radius:4px;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;">Yes</span>' : '—';
        var callback = p.plivoCallbackRequested === true ? '<span style="font-size:10px;font-weight:500;padding:2px 6px;border-radius:4px;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;">Yes</span>' : '—';
        var notes = p.plivoNotes ? '<span title="' + esc(p.plivoNotes) + '" style="cursor:help;max-width:100px;display:inline-block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(p.plivoNotes) + '</span>' : '—';

        var callBtn = '<button class="btn-call-single-m" data-id="' + p.id + '" data-src="' + src + '" data-mag="' + esc(magName).replace(/"/g,'&quot;') + '" title="Call"><i class="fas fa-phone-alt"></i></button>';

        return '<tr>' +
            '<td>' + srcBadge + '</td>' +
            '<td>' + p.id + '</td>' +
            '<td><strong>' + esc(p.interviewerName) + '</strong>' + (p.currentRole ? '<br/><span style="font-size:10px;color:#64748b;">' + esc(p.currentRole) + '</span>' : '') + '</td>' +
            '<td style="white-space:nowrap;">' + esc(p.phone) + '</td>' +
            '<td>' + (p.experience || '—') + '</td>' +
            '<td>' + statusHtml + '</td>' +
            '<td><span class="bc-intent ' + intentCls + '">' + intentText + '</span></td>' +
            '<td class="text-center">' + assignHelp + '</td>' +
            '<td class="text-center">' + callback + '</td>' +
            '<td>' + (p.plivoCallDuration ? p.plivoCallDuration + 's' : '—') + '</td>' +
            '<td style="white-space:nowrap;font-size:11px;">' + (p.plivoCallAt || '—') + '</td>' +
            '<td>' + notes + '</td>' +
            '<td>' + callBtn + '</td></tr>';
    }

    function fmtCallStatus(status) {
        if (!status) return '<span class="bc-status-none" style="font-size:11px;color:#94a3b8;"><span class="bc-call-dot"></span>Not called</span>';
        var s = (status + '').toLowerCase().replace(/_/g, '-');
        if (s === 'completed' || s === 'answered') return '<span class="bc-status-ok" style="font-size:11px;color:#166534;"><span class="bc-call-dot"></span>Completed</span>';
        if (s === 'triggered' || s === 'initiated' || s === 'ringing' || s === 'in-progress') return '<span class="bc-status-prog" style="font-size:11px;color:#1d4ed8;"><span class="bc-call-dot"></span>In progress</span>';
        if (s === 'no-answer' || s === 'no answer') return '<span class="bc-status-warn" style="font-size:11px;color:#b45309;"><span class="bc-call-dot"></span>No answer</span>';
        return '<span class="bc-status-fail" style="font-size:11px;color:#b91c1c;"><span class="bc-call-dot"></span>' + esc(status) + '</span>';
    }

    $(document).on('click', '.btn-call-single-m', function (e) {
        e.stopPropagation();
        var $btn = $(this);
        if ($btn.hasClass('calling')) return;
        var id = parseInt($btn.attr('data-id'));
        var src = $btn.attr('data-src') || 'EA';
        var magName = $btn.attr('data-mag') || bcCurrentMag;
        if (!id) return;
        if (!confirm('Call interviewer #' + id + '?')) return;
        $btn.addClass('calling').html('<i class="fas fa-spinner fa-spin"></i>');
        $.ajax({
            url: '/InterviewerAvailability/BatchCallSingle', type: 'POST',
            data: { __RequestVerificationToken: bcToken, id: id, source: src, magName: magName },
            success: function (res) {
                if (res.success) {
                    $btn.removeClass('calling').html('<i class="fas fa-check text-success"></i>');
                    setTimeout(function () { $btn.html('<i class="fas fa-phone-alt"></i>').removeClass('calling'); }, 3000);
                } else {
                    $btn.removeClass('calling').html('<i class="fas fa-phone-alt"></i>');
                    alert('Failed: ' + (res.error || 'Unknown error'));
                }
            },
            error: function () { $btn.removeClass('calling').html('<i class="fas fa-phone-alt"></i>'); alert('Request failed.'); }
        });
    });

    function loadModalHistory(magName) {
        var $panel = $('#bcPanelHistory');
        $panel.html('<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading history...</div>');
        $.ajax({
            url: '/InterviewerAvailability/GetBatchCallHistory', type: 'GET',
            data: { magName: magName },
            success: function (res) {
                if (!res.success || !res.history || !res.history.length) {
                    $panel.html('<div class="text-center text-muted py-3" style="font-size:12px;">No batch call history yet.</div>');
                    return;
                }
                var html = '<div class="table-responsive"><table class="table table-sm bc-hist-tbl mb-0">' +
                    '<thead><tr><th>When</th><th>By</th><th>Attempted</th><th class="text-success">OK</th><th class="text-danger">Fail</th><th class="text-warning">Skip</th><th>Status</th></tr></thead><tbody>';
                $.each(res.history, function (_, h) {
                    var badge = h.status === 'Completed' ? '<span class="badge bg-success">Completed</span>'
                        : h.status === 'Stopped' ? '<span class="badge bg-warning text-dark">Stopped</span>'
                        : h.status === 'Running' ? '<span class="badge bg-info">Running</span>'
                        : '<span class="badge bg-secondary">' + h.status + '</span>';
                    html += '<tr><td style="white-space:nowrap;">' + h.initiatedAt + '</td><td>' + esc(h.initiatedBy) + '</td>' +
                        '<td class="text-center">' + h.interviewersAttempted + '</td>' +
                        '<td class="text-center text-success fw-bold">' + h.interviewersSucceeded + '</td>' +
                        '<td class="text-center text-danger fw-bold">' + h.interviewersFailed + '</td>' +
                        '<td class="text-center text-warning fw-bold">' + h.interviewersSkipped + '</td>' +
                        '<td>' + badge + '</td></tr>';
                });
                html += '</tbody></table></div>';
                $panel.html(html);
            },
            error: function () { $panel.html('<div class="text-center text-danger py-3">Failed to load history.</div>'); }
        });
    }

    function SendMagApplicationLinks(agId, agName) {
        swal.fire({
            title: 'Are you sure?',
            text: 'Want to send MAG links for AG ' + agName + ' to all applicable interviewers?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, send!',
            preConfirm: function () {
                return new Promise(function (resolve, reject) {
                    $.ajax({
                        type: "POST",
                        url: "/IRF/SendMagApplicationLinks",
                        data: { 'agId' : agId, 'agName' : agName },
                        success: function (result) {
                            resolve(result);
                        }
                    })
                })
            },
            allowOutsideClick: false
        }).then(function (result) {
            if (result.dismiss !== 'cancel') {
                swal.fire({
                    title: 'Sent!',
                    type: 'success',
                    html: '<p>Application links have been sent to the Interviewers.</p>',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Close!',
                    allowOutsideClick: false
                }).then(function () {
                    location.reload(true);
                })
            }
            else if (result.dismiss === 'cancel') {
                swal.fire(
                    'Cancelled',
                    'Operation cancelled! :)',
                    'error'
                )
            }
        })
    }

</script>
