@model IEnumerable<Risebird.Entities.ViewModel.MeetingVM>
<div class="pt30">
    <div class="col-md-12 nopad" style="margin:0px;">
        <div class="card-header bg-w clearfix">
            <div class="pull-right client-ms">
                <button type="button" class="mdc-button mdc-button--raised mdc-ripple-upgraded card-title-space">
                    <span data-toggle="tooltip" data-placement="top" title="Back to Dashboard" onclick="location.href='@Url.Action("Dashboard911", "Dashboard")'" data-original-title="Tooltip on top"><font style=" font-family: Roboto, sans-serif; font-size:12px;"> Back</font></span>
                </button>
            </div>
            <span class="interview_2"> <i type="submit" class="far fa-file-excel excel-file card-title-space " data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Tooltip on bottom" onclick="location.href='@Url.Action("ExportPotentialRiskByCandidate", "Dashboard")'"></i></span>

        </div>
    </div>
</div>

<table id="detailsTable" class="table table-striped table-bordered dt-responsive" cellspacing="0" width="100%">
    <thead>
        <tr>
            <th>Skill Channel ID</th>
            <th>Interview Date</th>
            <th>Interviewer</th>
            <th>Candidate Name</th>
            <th>Candidate Email</th>
            <th>Candidate Contact</th>
            <th>Interview Status</th>
            <th>Client Name</th>
            <th>Channel Owner</th>
            <th>Red Marker</th>
            <th>Rating</th>
            <th>Rated On</th>
            <th>Action</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Skill Channel ID</th>
            <th>Interview Date</th>
            <th>Interviewer</th>
            <th>Candidate Name</th>
            <th>Candidate Email</th>
            <th>Candidate Contact</th>
            <th>Interview Status</th>
            <th>Client Name</th>
            <th>Channel Owner</th>
            <th>Red Marker</th>
            <th>Rating</th>
            <th>Rated On</th>
            <th>Action</th>
        </tr>
    </tfoot>
    <tbody>
        @{
            var i = 0;
        }
        @if (Model != null && Model.Count() > 0)
        {


            foreach (var item in Model)
            {

                <tr>

                    <td>@item.IRFId</td>
                    <td>@item.interviewDate</td>
                    <td>@item.interviewer</td>
                    <td>@item.candidateName</td>
                    <td>@item.candidateEmail</td>

                    @if (item.MobileNumber != null && item.MobileNumber != string.Empty)
                    {
                        <td>
                            <span aria-label="Click here to call the candidate">
                                <span onclick="CommonCallButtonClick('@item.candidateName','@item.MobileNumber', '@item.candidateEmail','@item.imid', null, 'Candidate')" data-original-title="Tooltip on top" title="Click here to call the candidate."><img src="/img/calling.png" width="20"></span>
                            </span>@item.MobileNumber
                        </td>
                    }
                     @if (item.InterviewStatus == 2)
            {
            <td class="text-center">
            <a style="color:green;font-weight: bold"> @item.intervieweStatusStatDesc</a>
            </td>
            }
            else if (item.InterviewStatus == 3)
            {
            <td class="text-center">
            <a style="color:red;font-weight: bold"> @item.intervieweStatusStatDesc</a>
            </td>
            }
            else if (item.InterviewStatus == 4)
            {
            <td class="text-center">
            <a style="color:darkorange; font-weight: bold"> @item.intervieweStatusStatDesc</a>
            </td>
            }
            else
            {
            <td class="text-center">@item.intervieweStatusStatDesc</td>
            }
                    <td> @item.Name </td>
                    <td>@item.ChannelOwner</td>
                    @if (item.interviewer != null || item.interviewer != "")
                    {
                        <td style="color:red;text-align:center"><d onclick="InsightsDetails('@item.interviewer')" style="cursor:pointer">@item.RedMarker</d></td>
                    }
                    else
                    {
                        <td style="color:red;text-align:center">@item.RedMarker</td>
                    }

                    <td class="interviewer">

                        <input type="hidden" id="Rating_@i" value="@item.Rating" />
                        <div class="star-rating" style="pointer-events:none;">
                            <input type="radio" id="Rating_5_@i" name="rating1_@i" readonly value="5" />
                            <label for="Rating_5_@i" class="star">&#9733;</label>
                            <input type="radio" id="Rating_4_@i" name="rating1_@i" readonly value="4" />
                            <label for="Rating_4_@i" class="star">&#9733;</label>
                            <input type="radio" id="Rating_3_@i" name="rating1_@i" readonly value="3" />
                            <label for="Rating_3_@i" class="star">&#9733;</label>
                            <input type="radio" id="Rating_2_@i" name="rating1_@i" readonly value="2" />
                            <label for="Rating_2_@i" class="star">&#9733;</label>
                            <input type="radio" id="Rating_1_@i" name="rating1_@i" readonly value="1" />
                            <label for="Rating_1_@i" class="star">&#9733;</label>
                        </div>

                    </td>
                    <td>@item.RatingAddedOn</td>

                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.interviewer))
                        {
                            <span>
                                <button class="mdc-fab app-fab--absolute " aria-label="Suspicious Interviwer">
                                    <span onclick="javascript:SuspiciousTypeDetails('@item.interviewer');" title="Suspicious Interviwer" class="mdc-fab__icon touch"><img width="17" src="/img/suspicious.png" /></span>
                                </button>
                            </span>

                        }
                        <a style="text-decoration:none" target="_blank" href="@Url.Action("ClientReport", "Interview" , new { interviewId=item.Interviewid, irfId=item.irfIntId})">
                            <button class="mdc-fab app-fab--absolute" aria-label="Client Interview Report">
                                <span title="Client Interview Report" class="mdc-fab__icon material-icons"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-ruled" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V9H3V2a1 1 0 0 1 1-1h5.5v2zM3 12v-2h2v2H3zm0 1h2v2H4a1 1 0 0 1-1-1v-1zm3 2v-2h7v1a1 1 0 0 1-1 1H6zm7-3H6v-2h7v2z" /></svg></span>
                            </button>
                        </a>
                        <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Payment SLA">
                            <div onclick="PaymentSLADetails('@item.Interviewid','@item.candidateEmail','@item.interviewer',false,'PotentailRiskCandidate')" title="Palyment SLA" class="mdc-fab__icon material-icons">
                                <svg style="color: white" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg>
                            </div>
                        </button>



                        <button class="mdc-fab app-fab--absolute feedbackreportbtn" aria-label="Payment SLA">

                            <div style="width: 30px;height: 30px;cursor:pointer; display: inline-block;border-radius: 100%;line-height: 32px;" onClick="PaymentComplianceDetails('@item.Interviewid','Candidate')"><svg style="color: white;position:relative;top:-4px;left:6px;" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-cash-stack" viewBox="0 0 16 16"> <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="white"></path> <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V7a2 2 0 0 1-2-2H3z" fill="white"></path> </svg><svg style="color: white;position:relative;top:3px;" width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M2 8C2 7.44772 2.44772 7 3 7H21C21.5523 7 22 7.44772 22 8C22 8.55228 21.5523 9 21 9H3C2.44772 9 2 8.55228 2 8Z" fill="white"></path> <path d="M2 12C2 11.4477 2.44772 11 3 11H21C21.5523 11 22 11.4477 22 12C22 12.5523 21.5523 13 21 13H3C2.44772 13 2 12.5523 2 12Z" fill="white"></path> <path d="M3 15C2.44772 15 2 15.4477 2 16C2 16.5523 2.44772 17 3 17H15C15.5523 17 16 16.5523 16 16C16 15.4477 15.5523 15 15 15H3Z" fill="white"></path> </svg></div>

                        </button>
                    </td>

                </tr>
                i++;
            }

        }
    </tbody>
</table>
