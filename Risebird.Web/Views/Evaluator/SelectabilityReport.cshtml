<script>
    function getPDF() {

        var HTML_Width = $(".canvas_div_pdf").width();
        var HTML_Height = $(".canvas_div_pdf").height();
        var top_left_margin = 15;
        var PDF_Width = HTML_Width + (top_left_margin * 2);
        var PDF_Height = (PDF_Width * 1.5) + (top_left_margin * 2);
        var canvas_image_width = HTML_Width;
        var canvas_image_height = HTML_Height;

        var totalPDFPages = Math.ceil(HTML_Height / PDF_Height) - 1;


        html2canvas($(".canvas_div_pdf")[0], { allowTaint: true }).then(function (canvas) {
            canvas.getContext('2d');

            console.log(canvas.height + "  " + canvas.width);


            var imgData = canvas.toDataURL("image/jpeg", 1.0);
            var pdf = new jsPDF('p', 'pt', [PDF_Width, PDF_Height]);
            pdf.addImage(imgData, 'JPG', top_left_margin, top_left_margin, canvas_image_width, canvas_image_height);


            for (var i = 1; i <= totalPDFPages; i++) {
                pdf.addPage(PDF_Width, PDF_Height);
                pdf.addImage(imgData, 'JPG', top_left_margin, -(PDF_Height * i) + (top_left_margin * 4), canvas_image_width, canvas_image_height);
            }

            pdf.save("Feedback_Interview.pdf");
        });
    };
</script>

<script>
    $('form').submit(function () {
        if ($(this).valid()) {
            $(':submit', this).attr('disabled', 'disabled');
        }
    });
    function RadioChanged(val) {
        if (val == 'Upload') {
            document.getElementById("uploadDiv").style.display = "block";
            document.getElementById("linkDiv").style.display = "none";
            document.getElementById("PageVideoLink").value = '';

        }
        else {
            document.getElementById("uploadDiv").style.display = "none";
            document.getElementById("linkDiv").style.display = "block";
            document.getElementById("VideoFile").value = '';

        }

    }

    function CountProctoring(value) {

        if (value == "" || value == null) {
            return;
        }

        var proctoringItems = $('[id^="Proctoring_"]');
        var proctoringTotal = 0;
        for (i = 0; i < proctoringItems.length; i++) {
            proctoringTotal += parseInt(proctoringItems[i].value);
        }
        $("#ProctoringCount").val(proctoringTotal);
        if (parseInt(proctoringTotal) > 0) {
            $("#ProctoringCount").css("border-color", "red");
        }
        else {
            $("#ProctoringCount").css("border-color", "#E3E3E3");
        }
    }

    function CalculateOverAll(id, value) {

        value = parseInt(value);
        var index;
        var skillName;
        if (id.includes("Tech")) {
            index = id.charAt(26);
            skillName = "TechSkillReportCollection";
        }

        else if (id.includes("General")) {
            index = id.charAt(29);
            skillName = "SkillGeneralReportCollection";
        }
        else if (id.includes("Joinability")) {
            index = id.charAt(28);
            skillName = "JoinabilityReportCollection";
        }
        else {
            index = id.charAt(30);
            skillName = "SelectabilityReportCollection";
        }
        var reqLevelId = skillName + "_" + index + "__RequiredLevelId"; //SkillGeneralReportCollection_0__RequiredLevel
        var required = $("#" + reqLevelId).val();
        if (required <= value) {
            var reqWeightage = $("#" + skillName + "_" + index + "__WeightageRequired").val();
            $("#" + skillName + "_" + index + "__WeightageActual").val(reqWeightage);
            $("#" + skillName + "_" + index + "__ActualLevelId").css("border-color", "#008000");

        }
        else {
            $("#" + skillName + "_" + index + "__WeightageActual").val("0");
            $("#" + skillName + "_" + index + "__ActualLevelId").css("border-color", "red");
        }

        var items = $('[id$="WeightageActual"]');
        //var length = item.length;
        var totalCount = 0;

        for (i = 0; i < items.length; i++) {
            totalCount += parseInt(items[i].value);
        }
        //items.forEach(function (item) {
        //    totalCount = totalCount + item.val();
        //});
        var average = totalCount / 4;
        $("#OverallScore").val(average);

        var arr = [];
        var obj = { y: "", legendText: "", label: "" }
        //TechSkills actual weightage total
        var techItems = $('[id^="TechSkillReportCollection"][id$="WeightageActual"]');
        var techTotal = 0;
        for (i = 0; i < techItems.length; i++) {

            techTotal = parseInt(techTotal) + parseInt($("#TechSkillReportCollection_" + i + "__WeightageActual").val());

        }
        obj.y = parseInt(techTotal) / 4;
        obj.label = "Tech Skills Score";
        obj.legendText = "Tech Skills Score";
        arr.push(obj);

        //SkillsGeneral actual weightage total
        var objGen = { y: "", legendText: "", label: "" }
        var genSkillsItems = $('[id^="SkillGeneralReportCollection"][id$="WeightageActual"]');
        var genTotal = 0;
        for (i = 0; i < genSkillsItems.length; i++) {
            var weightage = $("#SkillGeneralReportCollection_" + i + "__WeightageActual").val();
            genTotal = parseInt(genTotal) + parseInt(weightage);

        }

        objGen.y = parseInt(genTotal) / 4;
        objGen.label = "General Skills Score";
        objGen.legendText = "General Skills Score";
        arr.push(objGen);

        //Joinability actual weightage total
        var objJoin = { y: "", legendText: "", label: "" }
        var joinabilityItems = $('[id^="JoinabilityReportCollection"][id$="WeightageActual"]');
        var joinabilityTotal = 0;
        for (i = 0; i < joinabilityItems.length; i++) {

            joinabilityTotal = parseInt(joinabilityTotal) + parseInt($("#JoinabilityReportCollection_" + i + "__WeightageActual").val());

        }
        objJoin.y = parseInt(joinabilityTotal) / 4;
        objJoin.label = "Joinability Score";
        objJoin.legendText = "Joinability Score";
        arr.push(objJoin);

        //Selectability actual weightage total
        var objSelect = { y: "", legendText: "", label: "" }
        var selectabilityItems = $('[id^="SelectabilityReportCollection"][id$="WeightageActual"]');
        var selectabilityTotal = 0;
        for (i = 0; i < selectabilityItems.length; i++) {

            selectabilityTotal = parseInt(selectabilityTotal) + parseInt($("#SelectabilityReportCollection_" + i + "__WeightageActual").val());

        }
        objSelect.y = parseInt(selectabilityTotal) / 4;
        objSelect.label = "Selectability Score";
        objSelect.legendText = "Selectability Score";
        arr.push(objSelect);

        //totalScore = (techTotal + genTotal + joinabilityTotal + selectabilityTotal) / 4;
        document.getElementById("totScore").innerHTML = average;

        var chart = new CanvasJS.Chart("scoreChart", {
            theme: "light2", // "light1", "light2", "dark1", "dark2"
            width: 400,//in pixels
            height: 200,//in pixels
            animationEnabled: true,
            title: {
                text: "Score Chart"
            },
            data: [{
                type: "column",
                //startAngle: 60,
                //innerRadius: 55,
                indexLabelFontSize: 8,
                indexLabel: "{label}  {y}",
                toolTipContent: "<b>{label} </b>({y})",
                dataPoints: arr

            }]
        });
        chart.render();


    }

    $(document).ready(function () {

        var proctoringItems = $('[id^="Proctoring_"]');
        var proctoringTotal = 0;
        for (i = 0; i < proctoringItems.length; i++) {
            proctoringTotal += parseInt(proctoringItems[i].value);
        }
        $("#ProctoringCount").val(proctoringTotal);
        if (parseInt(proctoringTotal) > 0) {
            $("#ProctoringCount").css("border-color", "red");
        }
        else {
            $("#ProctoringCount").css("border-color", "#E3E3E3");
        }

        //shorter/better attempt
        var weightageItems = $('[id$="WeightageActual"]');
        for (i = 0; i < weightageItems.length; i++) {
            var id = weightageItems[i].id;
            var match = id.match(/\d+/g);
            var digit = match[0];

            var index = weightageItems[i].id.indexOf(digit);
            var skillName = weightageItems[i].id.substring(0, index);
            var reqLevel = $("#" + skillName + digit + "__RequiredLevelId").val();
            var actLevel = $("#" + skillName + digit + "__ActualLevelId").val();
            if (reqLevel <= actLevel) {
                reqWeight = $("#" + skillName + digit + "__WeightageRequired").val();
                $("#" + skillName + digit + "__WeightageActual").val(reqWeight);
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "#008000");
            }
            else {
                $("#" + skillName + digit + "__WeightageActual").val("0");
                $("#" + skillName + digit + "__ActualLevelId").css("border-color", "red");

            }

        }


        var items = $('[id$="WeightageActual"]');
        var totalCount = 0;

        for (i = 0; i < items.length; i++) {
            totalCount += parseInt(items[i].value);
        }
        var average = totalCount / 4;
        $("#OverallScore").val(average);






    });

    function AddRow() {
        //var table = document.getElementById("QuestionsTable");
        //var rowCount = table.rows.length;
        //if (rowCount == 6) {
        //    alert("Cannot add more than 5 Tech Skills.");
        //    return;
        //}

        var $ttc = $("#QuestionsTable").find("tbody tr:last");
        var $tr = $ttc.clone();
        var trIndexReplaced = $("#QuestionsTable tr").length - 1;

        $tr.find("input,select,hidden").attr("name", function () { // find name in the cloned row
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts from id, including index
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new name
        }).attr("id", function () { // change id also
            var parts = this.id.match(/(\D+)_(\d+)__(\D+)$/); // extract parts
            return parts[1] + "_" + ++parts[2] + "__" + parts[3]; // build new id
        });
        $tr.find("span[data-valmsg-for]").attr("data-valmsg-for", function () { // find validation message
            var parts = $(this).attr("data-valmsg-for").match(/(\D+)\[(\d+)]\.(\D+)$/); // extract parts from the referring attribute
            return parts[1] + "[" + ++parts[2] + "]." + parts[3]; // build new value
        })



        // reset fields in the new row
        $tr.find("select").val("");
        $tr.find("input[type=text]").val("");
        $tr.find("input[type=hidden]").val("");

        $tr.find("a").val("");

        // add cloned row as last row
        $("#QuestionsTable").find("tbody tr:last").after($tr);

        // Find the affected form
        var $form = $tr.closest("FORM");

        // Unbind existing validation
        $form.unbind();
        $form.data("validator", null);

        // Check document for changes
        $.validator.unobtrusive.parse(document);

    }
