@model IEnumerable<Risebird.Entities.Data.CandidateRecruiter>
@{
    ViewData["Title"] = "My Candidates";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Keep the Page Content Here.-->
<style>
    #style-2::-webkit-scrollbar-track {
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
        border-radius: 5px;
    }

    #style-2::-webkit-scrollbar {
        width: 6px;
    }

    #style-2::-webkit-scrollbar-thumb {
        border-radius: 5px;
        -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,.3);
        background-color: darkgray;
    }

    td.wordwrap {
        display: inline-block !important;
        max-width: 250px !important;
        min-width: 250px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        vertical-align: top !important;
        white-space: nowrap !important;
    }

    table.dataTable > thead > tr > th, table.dataTable > tbody > tr > th, table.dataTable > tfoot > tr > th, table.dataTable > thead > tr > td, table.dataTable > tbody > tr > td, table.dataTable > tfoot > tr > td {
        max-width: 300px !important;
    }

    td:hover.wordwrap {
        text-overflow: clip !important;
        white-space: normal !important;
    }

    .loader {
        font-family: Arial;
        font-size: 10pt;
        /*border: 5px solid #67CFF5;*/
        /*width: 200px;
            height: 100px;*/
        display: none;
        position: center !important;
        background-color: White;
        z-index: 999;
        /*opacity: 0.5;*/
        filter: alpha(opacity = 50);
    }
</style>



<div class="main-panel" id="main-panel">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-transparent  bg-primary  navbar-absolute">
        <div class="container-fluid">
            <div class="navbar-wrapper">
                <div class="navbar-toggle">
                    <button type="button" class="navbar-toggler">
                        <span class="navbar-toggler-bar bar1"></span>
                        <span class="navbar-toggler-bar bar2"></span>
                        <span class="navbar-toggler-bar bar3"></span>
                    </button>
                </div>
                <a class="navbar-brand">My Candidates</a>
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation" aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
                <span class="navbar-toggler-bar navbar-kebab"></span>
            </button>
        </div>
    </nav>
    <!-- End Navbar -->
    <div class="panel-header panel-header-sm">
    </div>
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">My Candidates</h4>
                    </div>
                    <div class="card-body">
                        <div class="toolbar">
                            <!--        Here you can write extra buttons/actions for the toolbar              -->
                            <button type="button" class="btn btn-primary " style="margin-top: 2px;margin-left:1226px"><span class="fa fa-life-ring" data-toggle="tooltip" data-placement="top" title="Support" onclick="location.href='@Url.Action("Index", "Support", new { controllerName = "Evaluator", actMethod ="RecruiterCandidates" } )'" data-original-title="Tooltip on top"> Support</span></button>

                        </div>
                        <div class="loader text-center">
                            <img src="~/Newassets/img/lazyload.gif" />
                        </div>
                        <div class="dataloading">
                            <div class="toolbar">

                            </div>

                            <div style="overflow-x:scroll" class="scrollbar" id="style-2">
                                <div id="tableID">
                                    <table id="myCandidateList" class="table table-striped table-bordered" cellspacing="0" width="100%">
                                        <thead>
                                            <tr>
                                                <th>Candidate</th>
                                                <th>IRF ID</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Risebird HR</th>
                                                <th>Joinability Score</th>
                                                <th>Selectability Score</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                                <th style="text-align:center">Call</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                            <tr>
                                                <th>Candidate</th>
                                                <th>IRF ID</th>
                                                <th>Resume</th>
                                                <th>JD Link</th>
                                                <th>Risebird HR</th>
                                                <th>Joinability Score</th>
                                                <th>Selectability Score</th>
                                                <th class="disabled-sorting text-center">Actions</th>
                                                <th style="text-align:center">Call</th>
                                            </tr>
                                        </tfoot>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                string joinabilityColor;
                                                string selectabilityColor;
                                                if (item.JoinabilityScore >= 70)
                                                {
                                                    joinabilityColor = "green";
                                                }
                                                else if (item.JoinabilityScore >= 40 && item.JoinabilityScore < 70)
                                                {
                                                    joinabilityColor = "orange";
                                                }
                                                else
                                                {
                                                    joinabilityColor = "red";
                                                }
                                                if (item.SelectabilityScore >= 70)
                                                {
                                                    selectabilityColor = "green";
                                                }
                                                else if (item.SelectabilityScore >= 40 && item.SelectabilityScore < 70)
                                                {
                                                    selectabilityColor = "orange";
                                                }
                                                else
                                                {
                                                    selectabilityColor = "red";
                                                }
                                                <tr id="@item.id">
                                                    <td> @item.CandidateName</td>
                                                    <td> @item.IRFName</td>

                                                    @if (item.ResumeLink != null && item.ResumeLink != "")
                                                    {
                                                        <td> <a id="resumeId" target="_blank" title="Resume" href=@item.ResumeLink>Resume</a> </td>
                                                    }
                                                    else
                                                    {
                                                        <td>No Resume</td>
                                                    }
                                                    @if (item.JDLink != null && item.JDLink != "")
                                                    {
                                                        <td>  <a id="jdlinkId" target="_blank" title="JDLink" href=@item.JDLink>JDLink</a></td>
                                                    }
                                                    else
                                                    {
                                                        <td>No JD</td>
                                                    }

                                                    <td> @item.RisebirdHR</td>
                                                    <td style="color:@joinabilityColor">
                                                        <b>@item.JoinabilityScore</b>
                                                    </td>
                                                    <td style="color:@selectabilityColor">
                                                        <b>@item.SelectabilityScore</b>
                                                    </td>
                                                    <td class="text-center">
                                                        <span onclick="location.href = '@Url.Action("RecruiterReport", "Evaluator", new { candidateId = item.CandidateId, irfId= item.IRFId})'" title="Report" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-file-pdf-o"></i></span>
                                                        @if (item.IsBiometricEnabled)
                                                        {
                                                            <span onclick="location.href = '@Url.Action("UploadAudio", "Evaluator", new { candidateId = item.CandidateId, irfId= item.IRFId, actMethod="RecruiterCandidates"})'" title="Audio files" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fas fa-microphone"></i></span>
                                                            <span onclick="location.href = '@Url.Action("EnrollVoiceItUser", "Evaluator", new { candidateId = item.CandidateId, irfId= item.IRFId, actMethod ="RecruiterCandidates"})'" title="Enroll User for Biometric verification" class="btn btn-round btn-info btn-icon btn-sm like"><i class="fa fa-sign-in"></i></span>
                                                        }

                                                    </td>
                                                    <td>
                                                        @if (item.Phone != null && item.Phone != string.Empty)
                                                        {
                                                            <button type="button" class="btn btn-success"><span class="fa fa-phone" data-toggle="tooltip" data-placement="top" title="Click here to call the candidate." onclick="ModalButtonClick('@item.Phone','@item.CandidateName','@item.IRFId','@item.CandidateEmailId')" data-original-title="Tooltip on top"> Call Candidate</span></button>
                                                        }

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- end content-->
                </div>
                <!--  end card  -->
            </div>
            <!-- end col-md-12 -->
        </div>
        <div id="myModal" class="modal" style="display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */">
            <!-- Modal content -->
            <div class="modal-content" style="width:70%;position: relative; background-color: #fefefe; margin: auto; padding: 0;border: 1px solid #888;box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2),0 6px 20px 0 rgba(0,0,0,0.19);font-size: 12px;margin-top:-53px">
                <div class="modal-header" style="padding: 2px 16px;background-color: #14406e;color: white;font-size: 10px;">
                    <h5 style="margin-left:40%;font-size:20px">Call Candidate!</h5>
                    <span class="close" id="callPopUp">&times;</span>
                </div>
                <div class="modal-body" style="padding: 2px 16px;">
                    <div class="row">
                        <label id="callingLabel" style="margin-top:23px;margin-left:38%; font-size:20px"><b>Calling...</b></label>

                    </div>

                    <div class="">
                        <input type="button" onclick="closeCallPopUp()" id="hangUpButton" style="margin-left:43%" class="btn btn-fill btn-danger" value="Hang Up">
                    </div>
                </div>
                <div class="modal-footer" style="padding: 2px 16px;
        background-color: #14406e;
        color: white;">

                </div>
            </div>

        </div>
        <!-- end row -->
    </div>

</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.css" integrity="sha256-Z8TW+REiUm9zSQMGZH4bfZi52VJgMqETCbPFlGRB1P8=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.js" integrity="sha256-ZvMf9li0M5GGriGUEKn1g6lLwnj5u+ENqCbLM5ItjQ0=" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.css" integrity="sha256-zuyRv+YsWwh1XR5tsrZ7VCfGqUmmPmqBjIvJgQWoSDo=" crossorigin="anonymous" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-sweetalert/1.0.1/sweetalert.min.js" integrity="sha256-JirYRqbf+qzfqVtEE4GETyHlAbiCpC005yBTa4rj6xg=" crossorigin="anonymous"></script>
<script src="//static.twilio.com/libs/twiliojs/1.2/twilio.min.js"></script>


@if (ViewBag.Message != null)
{
    <script type="text/javascript">

        function my_code() {
            var msg = '@ViewBag.Message';



            if (msg.includes("success")) {
                swal({
                    title: 'Successful',
                    text: '@ViewBag.Message',
                    type: 'success',
                    showConfirmButton: true

                },
                    function (value) //confirm
                    {
                        //if Yes do this
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //window.location.href = '/Evaluator/RecruiterCandidates';
                    }
                )

            }
            else {
                swal({
                    title: 'Failed',
                    text: '@ViewBag.Message',
                    type: 'error',
                    showConfirmButton: true

                },
                    function ()
                    {
                        document.getElementsByClassName("sweet-overlay")[0].style.display = "none";
                        document.getElementsByClassName("sweet-alert")[0].style.display = "none";
                        //window.location.href = '/Evaluator/RecruiterCandidates';
                    }
                )
            }

        }

        window.onload = my_code();
    </script>

}


<script type="text/javascript">
    $(document).ready(function () {

        $('#myCandidateList').DataTable({
            "pagingType": "full_numbers",
            "lengthMenu": [
                [10, 25, 50, -1],
                [10, 25, 50, "All"]
            ],
            responsive: true,
            language: {
                search: "_INPUT_",
                searchPlaceholder: "Search records",
            }

        });
        var table = $('#myCandidateList').DataTable();
    });
</script>
<script type="text/javascript">
    //// script for loader starts here
    $(".dataloading").hide();
    $("#myCandidateList").hide();
    var loader;
    function ShowProgress() {
        $(".dataloading").hide();
        $("#myCandidateList").hide();
        loader = document.getElementsByClassName("loader")[0];
        loader.style.display = "block";
        var top = Math.max(window.innerHeight / 2 - loader.offsetHeight / 2, 0);
        var left = Math.max(window.innerWidth / 2 - loader.offsetWidth / 2, 0);
        loader.style.top = top + "px";
        loader.style.left = left + "px";
    };
    ShowProgress();

    window.onload = function () {
        setTimeout(function () {
            loader.style.display = "none";
            $(".dataloading").show();
            $("#myCandidateList").show();
        }, 2000);
    };
    //// script for loader ends here
</script>

<script>
    var candidate = "";
    var canIrfid = "";
    var cancandidateEmail = "";
    var span = document.getElementById("callPopUp");
    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }
    $(document).ready(function () {
        $.post("/TwilioCalls/Generate", { page: window.location.pathname }, function (data) {
            // Set up the Twilio Client Device with the token
            Twilio.Device.setup(data.token);
        });
    });

    /* Callback to let us know Twilio Client is ready */
    Twilio.Device.ready(function (device) {

    });

    function callCandidate(phoneNumber) {
        var params = { "phoneNumber": phoneNumber };
        if (phoneNumber != null && phoneNumber.length >= 9) {
            Twilio.Device.connect(params);
        }
    }
    function hangUp() {
        Twilio.Device.disconnectAll();
    }

    Twilio.Device.connect(function (connection) {
        var appendText = "In call with " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        startCallRecording(connection.parameters.CallSid);
    });

    function afterTimeOut() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    Twilio.Device.disconnect(function (connection) {
        var appendText = "Call disconnected! ";
        document.getElementById("callingLabel").innerHTML = appendText;
        setTimeout(afterTimeOut, 2000);

    });
    function startCallRecording(sid) {
        console.log("sid:" + sid);
        $.ajax({
            url: '/User/makecall',
            type: "GET",
            data: { 'sid': sid, 'IRFId': canIrfid, 'CandidateEmail': cancandidateEmail },
            success: function (data) {
                console.log("rsid:" + data);
            }
        });
    }
    function ModalButtonClick(mobileNumber, candidateName, irfid, candidateemailid) {
        candidate = candidateName;
        canIrfid = irfid;
        cancandidateEmail = candidateemailid;
        // Get the modal
        var modal = document.getElementById("myModal");
        // When the user clicks the button, open the modal
        modal.style.display = "block";
        var appendText = "Calling... " + "<b>" + candidate + "</b>";
        document.getElementById("callingLabel").innerHTML = appendText;
        callCandidate(mobileNumber);
    }
    function closeCallPopUp() {
        hangUp();
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }


</script>
