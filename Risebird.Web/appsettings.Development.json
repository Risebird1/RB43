{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "TrialFlagReview": {
    "ArtificialDelayMsList": 0,
    "ArtificialDelayMsDetail": 0
  },
  // Point local runs at a local MCQ, not production.
  //
  // appsettings.json has BaseUrl = https://screen.risebird.io, so without this override a
  // developer running the portal locally calls the live MCQ - which will not have any API added
  // since its last deployment, and every call comes back 404 with nothing created. Overriding it
  // here means the whole loop (channel link, provisioning, report) can be exercised end to end
  // against the MCQ solution open beside it.
  //
  // Port from RisebirdMCQ/Properties/launchSettings.json. Change it if yours differs, and clear
  // BaseUrl to switch the integration off locally.
  "McqAssessment": {
    "BaseUrl": "https://localhost:7252",
    // Must match RisebirdPortalApi:ServiceAccountToken in the MCQ app being run.
    "ServiceAccountToken": "130FD3A7-AA9B-4900-BA1D-404B9FE5778A",
    // MCQ client user that auto-created channels are owned by. Must exist in the MCQ database
    // being pointed at - leave empty to keep creating channels by hand locally.
    "ChannelOwnerEmail": "talent@risebird.io"
  }
}
