// Layout for Interviewer_Service_Agreement_v2.pdf (A4, 595 x 842 pt, 13 pages).
// Positions are PDF points from the TOP-LEFT of the page; pages are 1-based.
// Upload this file next to the PDF (same folder / blob container) and update it with any new PDF version.
{
  // Page 1: the parties sentence has handwriting-sized blanks. It is cleared and re-flowed with the
  // same wording so the typed fields fit:
  //   [Interviewer Full Name] S/o [Father's name]
  //   residing at [Address with PIN code]
  //   (hereinafter referred to as "Interviewer").
  // Page 13: "(Name of Interviewer)" placeholder is replaced by the signer's name.
  "clear": [
    { "page": 1, "x": 74, "y": 342, "width": 464, "height": 41 },
    { "page": 13, "x": 108, "y": 530, "width": 120, "height": 16 }
  ],
  "text": [
    { "page": 1, "x": 318, "baseline": 356, "value": "S/o" },
    { "page": 1, "x": 77, "baseline": 377, "value": "residing at" },
    { "page": 1, "x": 77, "baseline": 398, "value": "(hereinafter referred to as \"Interviewer\")." }
  ],
  "fields": [
    // Page 1: effective date = signing date; parties details typed by the interviewer
    { "signer": "Interviewer", "type": "Date", "label": "Effective Date", "page": 1, "x": 394, "y": 157, "width": 100, "height": 15 },
    { "signer": "Interviewer", "type": "Textfield", "label": "Interviewer Name", "page": 1, "x": 77, "y": 344, "width": 236, "height": 15 },
    { "signer": "Interviewer", "type": "Textfield", "label": "Father Name", "page": 1, "x": 338, "y": 344, "width": 196, "height": 15 },
    { "signer": "Interviewer", "type": "Textfield", "label": "Address", "page": 1, "x": 132, "y": 365, "width": 402, "height": 15 },

    // Page 13: Risebird's authorised signatory (only used when ZohoSign:CompanySignerEmail is set)
    { "signer": "Company", "type": "Signature", "label": "Company Signature", "page": 13, "x": 77, "y": 380, "width": 160, "height": 28 },
    { "signer": "Company", "type": "Date", "label": "Company Sign Date", "page": 13, "x": 110, "y": 447, "width": 110, "height": 15 },

    // Page 13: interviewer signature block
    { "signer": "Interviewer", "type": "Signature", "label": "Interviewer Signature", "page": 13, "x": 77, "y": 505, "width": 160, "height": 26 },
    { "signer": "Interviewer", "type": "Name", "label": "Interviewer Signer Name", "page": 13, "x": 110, "y": 529, "width": 220, "height": 15 },
    { "signer": "Interviewer", "type": "Date", "label": "Interviewer Sign Date", "page": 13, "x": 110, "y": 550, "width": 110, "height": 15 }
  ]
}
